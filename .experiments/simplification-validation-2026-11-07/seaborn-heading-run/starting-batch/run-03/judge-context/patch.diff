diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..87cc225
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,53 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": ["a", "a", "a", "b", "b", "b"],
+            "y": [1., 2., np.nan, 4., 6., 8.],
+        })
+
+    @pytest.mark.parametrize("k, expected", [
+        (3, [0, 50, 100]),
+        ([75, 25], [75, 25]),
+    ])
+    def test_percentile_levels(self, df, k, expected):
+        result = Perc(k)(df, GroupBy(["x"]), "x", {})
+        assert result.loc[result.x == "a", "percentile"].tolist() == expected
+
+    def test_integer_count(self, df):
+        result = Perc(3)(df.iloc[:2], GroupBy(["x"]), "x", {})
+        assert_frame_equal(
+            result,
+            pd.DataFrame({"x": ["a"] * 3, "y": [1., 1.5, 2.], "percentile": [0., 50., 100.]}),
+        )
+
+    def test_explicit_order_and_interpolation(self, df):
+        result = Perc([75, 25], "nearest")(df.iloc[:2], GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [75, 25]
+        assert result["y"].tolist() == [2., 1.]
+
+    def test_orientation(self, df):
+        data = df.rename(columns={"x": "y", "y": "x"})
+        result = Perc(2)(data, GroupBy(["y"]), "y", {})
+        assert result.columns.tolist() == ["y", "x", "percentile"]
+        assert result["x"].tolist() == [1., 2., 4., 8.]
+
+    def test_groups_and_missing(self, df):
+        result = Perc([0, 100])(df, GroupBy(["x"]), "x", {})
+        assert result["x"].tolist() == ["a", "a", "b", "b"]
+        assert result["y"].tolist() == [1., 2., 4., 8.]
+
+    def test_public_import_and_plot(self, df):
+        assert so.Perc is Perc
+        so.Plot(df, x="x", y="y").add(so.Range(), so.Perc()).plot()
