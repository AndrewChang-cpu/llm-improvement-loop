diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..0de3227
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,53 @@
+"""Order statistics for statistical transformations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to compute the percentile, passed to :func:`numpy.percentile`
+        to select the interpolation behavior. Defaults to "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _process(self, data: DataFrame, var: str) -> DataFrame:
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        if values.empty:
+            return pd.DataFrame(columns=[var, "percentile"])
+        try:
+            result = np.percentile(values, percentiles, method=self.method)
+        except TypeError:
+            result = np.percentile(values, percentiles, interpolation=self.method)
+        return pd.DataFrame({var: result, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._process, var).reset_index(drop=True)
