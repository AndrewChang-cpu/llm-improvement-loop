diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..87b2d51
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,50 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.mark.parametrize("k, levels", [
+        (3, [0, 50, 100]),
+        ([75, 10], [75, 10]),
+    ])
+    def test_percentiles(self, k, levels):
+        data = pd.DataFrame({"x": [1] * 4, "y": [10, 20, 30, 40]})
+        result = Perc(k)(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [1] * len(levels), "y": np.percentile(data.y, levels),
+            "percentile": np.asarray(levels, dtype=float if isinstance(k, int) else None),
+        })
+        assert_frame_equal(result, expected)
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": [1] * 4, "y": [0, 10, np.nan, 30]})
+        result = Perc([25, 50, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {},
+        )
+        expected = np.percentile([0, 10, 30], [25, 50, 75], method="nearest")
+        assert result.y.tolist() == expected.tolist()
+
+    def test_grouped_and_vertical(self):
+        data = pd.DataFrame({
+            "x": [1, 2, 3, 4], "y": ["a", "a", "b", "b"], "group": ["g"] * 4,
+        })
+        result = Perc(2)(data, GroupBy(["y", "group"]), "y", {})
+        assert result["percentile"].tolist() == [0, 100, 0, 100]
+        assert result["x"].tolist() == [1, 2, 3, 4]
+        assert result["y"].tolist() == ["a", "a", "b", "b"]
+        assert result["group"].tolist() == ["g"] * 4
+
+    def test_public_import_and_plot(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as StatsPerc
+
+        assert so.Perc is StatsPerc
+        data = pd.DataFrame({"group": ["a"] * 4, "value": [1, 2, 3, 4]})
+        plot = so.Plot(data, x="group", y="value").add(so.Range(), so.Perc(3))
+        plot.plot()
