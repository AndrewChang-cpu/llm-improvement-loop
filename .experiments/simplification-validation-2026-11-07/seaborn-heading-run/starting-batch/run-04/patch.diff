--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,55 @@
+"""Order statistics for the objects interface."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or an
+        explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate between observations, as in
+        :func:`numpy.percentile`. Defaults to "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        percentiles = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer)) else self.k
+        )
+        try:
+            values = np.percentile(values, percentiles, method=self.method)
+        except TypeError:
+            values = np.percentile(values, percentiles, interpolation=self.method)
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
