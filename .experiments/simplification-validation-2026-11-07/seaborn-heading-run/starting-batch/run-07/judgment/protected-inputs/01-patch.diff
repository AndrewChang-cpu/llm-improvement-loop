diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..d029881
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,52 @@
+"""Order-statistic transformations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+import inspect
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with their percentile values.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate between data points when computing
+        percentiles. Defaults to "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        percentile_parameters = inspect.signature(np.percentile).parameters
+        keyword = "method" if "method" in percentile_parameters else "interpolation"
+        result = np.percentile(values, levels, **{keyword: self.method})
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
