diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..011b3b3
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,44 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        res = Perc()(data, GroupBy(["x"]), "x", {})
+        assert res["percentile"].to_list() == [0, 25, 50, 75, 100]
+        np.testing.assert_allclose(res["y"], [1, 1.75, 2.5, 3.25, 4])
+
+    def test_count_and_explicit_order(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        gb = GroupBy(["x"])
+        assert len(Perc(3)(data, gb, "x", {})) == 3
+        res = Perc([75, 25, 50])(data, gb, "x", {})
+        assert res["percentile"].to_list() == [75, 25, 50]
+        np.testing.assert_allclose(res["y"], [3.25, 1.75, 2.5])
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [0, 10, 20]})
+        res = Perc([40], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert res["y"].item() == 10
+
+    def test_orient_and_groups_and_missing(self):
+        data = pd.DataFrame({"x": [1., 3., 10., np.nan], "y": [0, 0, 1, 1], "g": ["a", "a", "b", "b"]})
+        res = Perc([50])(data, GroupBy(["y", "g"]), "y", {})
+        assert res[["x", "y", "g", "percentile"]].to_dict("records") == [
+            {"x": 2., "y": 0, "g": "a", "percentile": 50},
+            {"x": 10., "y": 1, "g": "b", "percentile": 50},
+        ]
+
+    def test_public_imports_and_plot(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+        assert so.Perc is InternalPerc
+        so.Plot(pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3]}), x="x", y="y").add(
+            so.Range(), so.Perc(3)
+        ).plot()
