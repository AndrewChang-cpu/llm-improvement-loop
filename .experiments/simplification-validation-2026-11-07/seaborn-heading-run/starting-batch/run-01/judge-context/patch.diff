diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5012e9f
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,63 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+
+        df = pd.DataFrame({"x": [1, 2, 3], "y": [1, 4, 9]})
+        res = Perc()(df, GroupBy(["x"]), "x", {})
+
+        # The orientation variable is a grouping variable, so each group has
+        # five identical percentile coordinates for its single observation.
+        expected = pd.DataFrame({
+            "x": np.repeat([1, 2, 3], 5),
+            "y": np.repeat([1., 4., 9.], 5),
+            "percentile": np.tile([0., 25., 50., 75., 100.], 3),
+        })
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels_and_method(self):
+
+        df = pd.DataFrame({"x": [0, 0, 0], "y": [0, 10, 20]})
+        res = Perc([75, 25], method="lower")(
+            df, GroupBy(["x"]), "x", {},
+        )
+
+        expected = pd.DataFrame({
+            "x": [0, 0], "y": [10, 0], "percentile": [75, 25],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_orientation_grouping_and_missing(self):
+
+        df = pd.DataFrame({
+            "x": [2., np.nan, 6., 10., 14.],
+            "y": [1, 1, 1, 2, 2],
+            "group": ["a", "a", "a", "b", "b"],
+        })
+        res = Perc([0, 50, 100])(
+            df, GroupBy(["y", "group"]), "y", {},
+        )
+        expected = pd.DataFrame({
+            "x": [2., 4., 6., 10., 12., 14.],
+            "y": [1, 1, 1, 2, 2, 2],
+            "group": ["a"] * 3 + ["b"] * 3,
+            "percentile": [0, 50, 100] * 2,
+        })
+        assert_frame_equal(res, expected)
+
+    def test_public_import_and_plot_composition(self):
+
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        df = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        plot = so.Plot(df, x="x", y="y").add(so.Range(), so.Perc([25, 75]))
+        plot.plot()
