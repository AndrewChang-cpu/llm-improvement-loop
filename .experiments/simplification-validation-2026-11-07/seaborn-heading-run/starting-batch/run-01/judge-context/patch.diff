diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..57b9b4f
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,60 @@
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentile levels from 0 to 100, or the
+        percentile levels to compute directly. Defaults to 5.
+    method : str
+        Method used to interpolate between data points when the percentile
+        level falls between them. Defaults to "linear"; see
+        :func:`numpy.percentile` for the available methods.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        if isinstance(self.k, (int, np.integer)):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+
+        try:
+            result = np.percentile(values, percentiles, method=self.method)
+        except TypeError:
+            result = np.percentile(
+                values, percentiles, interpolation=self.method,
+            )
+
+        return pd.DataFrame({var: result, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
