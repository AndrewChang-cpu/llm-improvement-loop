diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..5787c01
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,53 @@
+"""Order-statistics transformations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate percentile values, following the options
+        accepted by :func:`numpy.percentile`. Defaults to "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Stat.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna().to_numpy()
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        try:
+            estimates = np.percentile(values, levels, method=self.method)
+        except TypeError:
+            estimates = np.percentile(values, levels, interpolation=self.method)
+        return pd.DataFrame({var: estimates, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
