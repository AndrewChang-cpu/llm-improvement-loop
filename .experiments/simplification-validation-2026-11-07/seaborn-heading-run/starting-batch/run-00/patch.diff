diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5aa4931
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,48 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.mark.parametrize("k, levels", [(3, [0, 50, 100]), ([75, 25], [75, 25])])
+    def test_levels(self, k, levels):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 10, 20, 30]})
+        result = Perc(k)(data, GroupBy(["x"]), "x", {})
+        levels = np.linspace(0, 100, k) if isinstance(k, int) else levels
+        expected = pd.DataFrame({"x": ["a"] * len(levels),
+                                 "y": np.percentile(data.y, levels),
+                                 "percentile": levels})
+        assert_frame_equal(result, expected)
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 1, 2, np.nan]})
+        result = Perc([25, 75], "nearest")(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({"x": ["a", "a"], "y": [0., 2.],
+                                 "percentile": [25, 75]})
+        assert_frame_equal(result, expected)
+
+    @pytest.mark.parametrize("orient, groupvar, valuevar", [("x", "x", "y"), ("y", "y", "x")])
+    def test_orientation_and_groups(self, orient, groupvar, valuevar):
+        if orient == "x":
+            data = pd.DataFrame({"x": ["a", "a", "b", "b"],
+                                 "y": [1, 3, 10, 20], "hue": ["u", "u", "v", "v"]})
+        else:
+            data = pd.DataFrame({"x": [1, 3, 10, 20],
+                                 "y": ["a", "a", "b", "b"], "hue": ["u", "u", "v", "v"]})
+        result = Perc([0, 100])(data, GroupBy([groupvar, "hue"]), orient, {})
+        assert result[valuevar].tolist() == [1, 3, 10, 20]
+        assert result["percentile"].tolist() == [0, 100, 0, 100]
+
+    def test_public_imports_and_plot(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 1, 2, 3]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=3))
+        plot.plot()
