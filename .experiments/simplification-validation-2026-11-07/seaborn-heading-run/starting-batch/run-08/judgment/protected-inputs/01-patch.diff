diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..fdfe192
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,56 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({"x": [1, 1, 1, 1, 1], "y": [2., 4, 6, 8, np.nan], "g": ["a"] * 5})
+
+    def test_default(self, df):
+        res = Perc()(df, GroupBy(["g"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [1] * 5,
+            "y": [2, 3.5, 5, 6.5, 8],
+            "g": ["a"] * 5,
+            "percentile": [0., 25, 50, 75, 100],
+        })
+        expected = expected.reindex(columns=res.columns)
+        assert_frame_equal(res, expected)
+
+    @pytest.mark.parametrize("k, expected_q", [
+        (3, [0, 50, 100]),
+        ([90, 10], [90, 10]),
+    ])
+    def test_percentile_levels(self, df, k, expected_q):
+        res = Perc(k)(df, GroupBy(["g"]), "x", {})
+        assert res["percentile"].tolist() == expected_q
+        assert res["y"].tolist() == np.percentile(df["y"].dropna(), expected_q).tolist()
+
+    def test_method(self):
+        df = pd.DataFrame({"x": [1, 2], "y": [0., 10.]})
+        res = Perc([25], method="nearest")(df.assign(g="a"), GroupBy(["g"]), "x", {})
+        assert res["y"].tolist() == [0]
+
+    def test_orientation_and_grouping(self):
+        df = pd.DataFrame({"x": [1., 3., 10., 14.], "y": [0, 0, 1, 1], "g": ["a", "a", "b", "b"]})
+        res = Perc(2)(df, GroupBy(["y", "g"]), "y", {})
+        assert res["x"].tolist() == [1, 3, 10, 14]
+        assert res["percentile"].tolist() == [0, 100, 0, 100]
+        assert res["g"].tolist() == ["a", "a", "b", "b"]
+
+    def test_import_and_plot(self):
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = so.Plot(x=["a", "a", "b", "b"], y=[1, 2, 3, 4]).add(
+            so.Range(), so.Perc(2)
+        )
+        plot.plot()
