diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..971ede2
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,49 @@
+import numpy as np
+import pandas as pd
+
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_integer_count(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["percentile"], [0, 50, 100])
+        assert_array_equal(result["y"], [1, 2.5, 4])
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [1, 1], "y": [0, 10]})
+        result = Perc(k=[75, 25], method="nearest")(
+            data, GroupBy(["x"]), "x", {},
+        )
+        assert_array_equal(result["percentile"], [75, 25])
+        assert_array_equal(result["y"], [10, 0])
+
+    def test_grouped_orientation_and_missing(self):
+        data = pd.DataFrame({
+            "x": [1, 1, 2, 2], "y": [1, np.nan, 10, 20], "group": ["a", "a", "b", "b"],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["x", "group"]), "x", {})
+        assert_array_equal(result["x"], [1, 1, 2, 2])
+        assert_array_equal(result["y"], [1, 1, 10, 20])
+        assert_array_equal(result["group"], ["a", "a", "b", "b"])
+        assert_array_equal(result["percentile"], [0, 100, 0, 100])
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"x": [1, 3], "y": [4, 4]})
+        result = Perc(k=2)(data, GroupBy(["y"]), "y", {})
+        assert_array_equal(result["x"], [1, 3])
+        assert_array_equal(result["y"], [4, 4])
+
+    def test_public_imports_and_plot_composition(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc is Perc
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4]})
+        plot = so.Plot(data, "x", "y").add(so.Range(), so.Perc(k=[25, 75]))
+        plot.plot()
