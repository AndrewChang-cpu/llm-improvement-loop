--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,52 @@
+"""Order statistics for objects plots."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with their requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or the exact percentile levels to compute. Defaults to 5.
+    method : str
+        Method used to interpolate percentile values, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    group_by_orient = True
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def __call__(self, data, groupby, orient, scales):
+        value = {"x": "y", "y": "x"}[orient]
+
+        if isinstance(self.k, (int, np.integer)):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+
+        def percentile(part):
+            values = part[value].dropna()
+            try:
+                result = np.percentile(values, percentiles, method=self.method)
+            except TypeError:
+                result = np.percentile(
+                    values, percentiles, interpolation=self.method,
+                )
+            return pd.DataFrame({value: result, "percentile": percentiles})
+
+        return groupby.apply(data, percentile)
