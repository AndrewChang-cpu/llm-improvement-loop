diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..e6754a4
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.mark.parametrize("k", [5, [100, 25, 0]])
+    def test_percentiles(self, k):
+        data = pd.DataFrame({"x": [0, 1, 2, 3], "y": [1, 2, 3, 4]})
+        result = Perc(k)(data, GroupBy(["unused"]), "x", {})
+        levels = np.linspace(0, 100, 5) if isinstance(k, int) else k
+        expected = pd.DataFrame({
+            "y": data.y.quantile(np.array(levels) / 100).to_numpy(),
+            "percentile": levels,
+        })
+        assert_frame_equal(result, expected)
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 1], "y": [1, 4]})
+        result = Perc([25, 75], method="lower")(
+            data, GroupBy(["unused"]), "x", {},
+        )
+        assert result.y.tolist() == [1, 1]
+
+    @pytest.mark.parametrize("orient", ["x", "y"])
+    def test_orientation_and_grouping(self, orient):
+        value = {"x": "y", "y": "x"}[orient]
+        data = pd.DataFrame({
+            orient: ["a", "a", "b", "b"],
+            value: [1, 3, 10, 14],
+            "group": ["u", "u", "u", "u"],
+        })
+        result = Perc([0, 100])(
+            data, GroupBy([orient, "group"]), orient, {},
+        )
+        assert result.groupby(orient)[value].agg(list).to_dict() == {
+            "a": [1, 3], "b": [10, 14],
+        }
+        assert result.percentile.tolist() == [0, 100, 0, 100]
+
+    def test_missing_values(self):
+        data = pd.DataFrame({"x": [0, 0, 1], "y": [1, np.nan, 4]})
+        result = Perc([0, 100])(data, GroupBy(["x"]), "x", {})
+        assert result.x.tolist() == [0, 0, 1, 1]
+        assert result.y.tolist() == [1, 1, 4, 4]
+
+    def test_public_imports_and_plot_composition(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        data = pd.DataFrame({"group": ["a", "a", "b", "b"], "value": [1, 3, 2, 4]})
+        plot = so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc([25, 75]),
+        )
+        assert plot.plot() is not None
