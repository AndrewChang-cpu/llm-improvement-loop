index 0000000..27b4d54
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,57 @@
+"""Order-statistics transformations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of numbers, default 5
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels.
+    method : str, default "linear"
+        Method used to interpolate between data points. See
+        :func:`numpy.percentile` for the available methods.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _process(self, data: DataFrame, var: str, levels) -> DataFrame:
+        values = data[var].dropna()
+        try:
+            percentiles = np.percentile(values, levels, method=self.method)
+        except TypeError as err:
+            if "method" not in str(err):
+                raise
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer)) else self.k
+        )
+        return groupby.apply(data, self._process, var, levels).reset_index(drop=True)
