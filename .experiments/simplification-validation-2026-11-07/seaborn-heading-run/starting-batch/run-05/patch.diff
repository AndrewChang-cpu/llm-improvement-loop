new file mode 100644
index 0000000..df07745
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,49 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0], "y": [1]})
+        res = Perc()(data, GroupBy(["x"]), "x", {})
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+
+    def test_count(self):
+        data = pd.DataFrame({"x": range(5), "y": [0, 2, 4, 6, 8]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": np.repeat(range(5), 3),
+            "y": np.repeat([0., 2., 4., 6., 8.], 3),
+            "percentile": [0., 50., 100.] * 5,
+        })
+        assert_frame_equal(res, expected)
+
+    def test_explicit_list_and_method(self):
+        data = pd.DataFrame({"x": [0, 1, 2], "y": [0, 2, 10]})
+        data["group"] = "a"
+        res = Perc([75, 25], method="nearest")(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({"x": [2, 0], "group": ["a", "a"], "percentile": [75, 25]})
+        assert_frame_equal(res, expected)
+
+    @pytest.mark.parametrize("orient,var", [("x", "y"), ("y", "x")])
+    def test_orientation_missing_and_groups(self, orient, var):
+        data = pd.DataFrame({"x": [1., 3., np.nan, 10.], "y": [2., 4., 6., 8.],
+                             "group": ["a", "a", "a", "b"]})
+        res = Perc(k=2)(data, GroupBy(["group"]), orient, {})
+        assert res.groupby("group")["percentile"].apply(list).to_dict() == {"a": [0, 100], "b": [0, 100]}
+        assert res.loc[res.group == "a", var].tolist() == ([2, 6] if var == "y" else [1, 3])
+
+    def test_public_imports_and_plot(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        data = pd.DataFrame({"x": range(5), "y": [0, 2, 4, 6, 8]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc())
+        assert plot.plot()
