@@ -0,0 +1,54 @@
+"""Order statistics for objects plots."""
+from __future__ import annotations
+from dataclasses import dataclass
+from inspect import signature
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+_PERCENTILE_METHOD = (
+    "method" if "method" in signature(np.percentile).parameters else "interpolation"
+)
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly-spaced percentile levels from 0 to 100, inclusive,
+        or the percentile levels to compute.
+    method : str
+        Method used to interpolate between data points when computing
+        percentiles. See :func:`numpy.percentile`.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        value = data[var].dropna()
+        values = np.percentile(value, percentiles, **{_PERCENTILE_METHOD: self.method})
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
