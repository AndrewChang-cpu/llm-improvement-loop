@@ -0,0 +1,22 @@
+Type aliases
+============
+
+.. py:module:: type_aliases
+
+.. py:class:: Target
+
+.. py:class:: Container
+
+   .. py:type:: Nested
+      :canonical: list[Target]
+
+      A nested alias.
+
+   .. py:type:: NestedNoExpression
+
+.. py:type:: Alias
+   :canonical: Target | list[Target]
+
+.. py:type:: AliasNoExpression
+
+:py:type:`Alias` :py:obj:`Alias` :py:type:`Container.Nested`
diff --git a/tests/test_domains/test_domain_py.py b/tests/test_domains/test_domain_py.py
index e653c80..6a33014 100644
--- a/tests/test_domains/test_domain_py.py
+++ b/tests/test_domains/test_domain_py.py
@@ -1013,3 +1013,28 @@ def test_pep_695_and_pep_696_whitespaces_in_default(app, tp_list, tptext):
     text = f'.. py:function:: f{tp_list}()'
     doctree = restructuredtext.parse(app, text)
     assert doctree.astext() == f'\n\nf{tptext}()\n\n'
+
+
+@pytest.mark.sphinx('html', testroot='domain-py')
+def test_type_aliases(app, warning):
+    app.build(force_all=True)
+
+    objects = app.env.domains['py'].data['objects']
+    assert objects['type_aliases.Alias'].objtype == 'type'
+    assert objects['type_aliases.AliasNoExpression'].objtype == 'type'
+    assert objects['type_aliases.Container.Nested'].objtype == 'type'
+    assert objects['type_aliases.Container.NestedNoExpression'].objtype == 'type'
+    assert objects['Target | list[Target]'].aliased
+
+    doctree = app.env.get_doctree('type')
+    index_entries = [entry[1] for index in doctree.findall(addnodes.index)
+                     for entry in index['entries']]
+    assert 'Alias (in module type_aliases)' in index_entries
+    assert 'Nested (type alias in type_aliases.Container)' in index_entries
+
+    html = (app.outdir / 'type.html').read_text(encoding='utf8')
+    assert 'type Nested = list[' in html
+    assert 'type Alias = ' in html
+    assert 'href="#type_aliases.Target"' in html
+    assert 'href="#type_aliases.Alias"' in html
+    assert 'href="#type_aliases.Container.Nested"' in html
