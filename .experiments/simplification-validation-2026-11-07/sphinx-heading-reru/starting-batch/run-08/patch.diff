+def test_pytype_alias(app):
+    text = (".. py:currentmodule:: package\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Thing]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            "      Nested alias description.\n"
+            "\n"
+            "      .. py:type:: BodyAlias\n"
+            "\n"
+            ".. py:type:: Bare\n"
+            "\n"
+            "Aliases: :py:type:`Alias`, :py:obj:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert domain.objects['package.Alias'] == ('index', 'package.Alias', 'type', False)
+    assert domain.objects['list[Thing]'] == ('index', 'package.Alias', 'type', True)
+    assert domain.objects['package.Container.Nested'][2:] == ('type', False)
+    assert domain.objects['package.Container.BodyAlias'][2:] == ('type', False)
+    assert domain.objects['package.Bare'][2:] == ('type', False)
+
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type package.Alias = list[Thing]'
+    assert signatures[1].astext() == 'class package.Container'
+    assert signatures[2].astext() == 'type Nested'
+    assert signatures[3].astext() == 'type BodyAlias'
+    assert signatures[4].astext() == 'type package.Bare'
+    assert [xref['reftarget'] for xref in signatures[0].findall(pending_xref)] == [
+        'list', 'Thing']
+    references = [xref for xref in doctree.findall(pending_xref)
+                  if xref['reftarget'] == 'Alias']
+    assert [xref['reftype'] for xref in references] == ['type', 'obj']
+    assert domain.find_obj(app.env, 'package', None, 'Alias', 'type', 0)
+    assert domain.find_obj(app.env, 'package', None, 'Alias', 'obj', 0)
+
+    indexes = list(doctree.findall(addnodes.index))
+    assert indexes[0]['entries'] == [('single', 'Alias (in module package)',
+                                     'package.Alias', '', None)]
+    assert indexes[2]['entries'] == [('single', 'Nested (type alias in package.Container)',
+                                     'package.Container.Nested', '', None)]
+    assert indexes[3]['entries'] == [('single', 'BodyAlias (type alias in package.Container)',
+                                     'package.Container.BodyAlias', '', None)]
+    assert indexes[4]['entries'] == [('single', 'Bare (in module package)',
+                                     'package.Bare', '', None)]
+
+
+def test_pytype_alias_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Standalone\n")
+    domain = app.env.get_domain('py')
+
+    assert domain.objects['Standalone'][2:] == ('type', False)
+    assert doctree[0]['entries'] == [('single', 'Standalone', 'Standalone', '', None)]
+
+
