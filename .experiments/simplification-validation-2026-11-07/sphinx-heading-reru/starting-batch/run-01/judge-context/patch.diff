+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n"
+            "\n"
+            ".. py:type:: EmptyAlias\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: dict[str, int]\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    descriptions = list(doctree.findall(addnodes.desc))
+    assert descriptions[0][0].astext() == 'type example.Alias = list[str]'
+    assert descriptions[0][0].findall(pending_xref)
+    assert descriptions[1][0].astext() == 'type example.EmptyAlias'
+    assert descriptions[3][0].astext() == 'type Nested = dict[str, int]'
+    assert domain.objects['example.Alias'][2:] == ('type', False)
+    assert domain.objects['example.EmptyAlias'][2:] == ('type', False)
+    assert domain.objects['example.Container.Nested'][2:] == ('type', False)
+    indices = [node['entries'][0] for node in doctree.findall(addnodes.index)
+               if node.get('entries') and node['entries'][0][2].startswith('example.')]
+    assert indices[0] == ('single', 'Alias (in module example)',
+                          'example.Alias', '', None)
+    assert indices[-1] == (
+        ('single', 'Nested (type alias in containing class example.Container)',
+         'example.Container.Nested', '', None))
+
+
+def test_pytype_alias_roles(app):
+    text = (".. py:type:: Alias\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            "See :py:type:`Alias` and :py:obj:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    assert len(list(doctree.findall(pending_xref))) == 2
+    assert all(node['reftarget'] == 'Alias' for node in doctree.findall(pending_xref))
+    assert domain.object_types['type'].roles == ('type', 'obj')
+
+
