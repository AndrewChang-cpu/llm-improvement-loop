diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..728ac23 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -54,6 +54,43 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_signature_and_object_registration(app):
+    text = (".. py:module:: example\n\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n\n"
+            "   Alias description.\n\n"
+            ".. py:type:: EmptyAlias\n")
+    doctree = restructuredtext.parse(app, text)
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias = list[str]'
+    assert signatures[1].astext() == 'type example.EmptyAlias'
+    alias = signatures[0]
+    assert list(alias.findall(pending_xref))
+    domain = app.env.domains['py']
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['list[str]'].objtype == 'type'
+    assert domain.objects['example.EmptyAlias'].objtype == 'type'
+    assert 'type' in domain.roles
+    assert domain.object_types['type'].lname == 'type alias'
+    assert {'type', 'obj'} <= set(domain.object_types['type'].roles)
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Alias (in module example)' in entries
+    assert 'EmptyAlias (in module example)' in entries
+
+
+def test_pytype_nested_index_text(app):
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n"
+        ".. py:class:: Container\n\n"
+        "   .. py:type:: Alias\n")
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Alias (type alias in containing class example.Container)' in entries
+    assert app.env.domains['py'].objects['example.Container.Alias'].objtype == 'type'
+
+
