+def test_pytype(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: NestedAlias\n"
+            "      :canonical: list[Item] | None\n"
+            "\n"
+            "References: :py:type:`Alias` and :py:obj:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    descriptions = list(doctree.findall(desc))
+    assert descriptions[0][0].astext() == 'type example.Alias'
+    assert descriptions[2][0].astext() == 'type NestedAlias = list[Item] | None'
+    assert len(list(descriptions[2].findall(pending_xref))) == 3
+    references = list(doctree.findall(pending_xref))
+    assert [reference['reftype'] for reference in references[-2:]] == ['type', 'obj']
+
+    assert domain.objects['example.Alias'][2] == 'type'
+    assert domain.objects['example.Container.NestedAlias'][2] == 'type'
+    assert domain.objects['list[Item] | None'][2] == 'type'
+    index_nodes = list(doctree.findall(addnodes.index))
+    assert index_nodes[1]['entries'] == [
+        ('single', 'Alias (in module example)', 'example.Alias', '', None)]
+    assert index_nodes[3]['entries'] == [
+        ('single', 'NestedAlias (type alias in example.Container)',
+         'example.Container.NestedAlias', '', None)]
+
+    assert domain.find_obj(app.env, 'example', None, 'Alias', 'type')
+    assert domain.find_obj(app.env, 'example', None, 'Alias', 'obj')
+    assert 'type' in domain.roles
+    for reference in references[-2:]:
+        resolved = domain.resolve_xref(app.env, 'index', app.builder,
+                                      reference['reftype'], 'Alias',
+                                      reference, nodes.Text('Alias'))
+        assert isinstance(resolved, nodes.reference)
+        assert resolved['refid'] == 'example.Alias'
+
+
+def test_pytype_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    index = next(doctree.findall(addnodes.index))
+    assert index['entries'] == [('single', 'Alias', 'Alias', '', None)]
+
+
