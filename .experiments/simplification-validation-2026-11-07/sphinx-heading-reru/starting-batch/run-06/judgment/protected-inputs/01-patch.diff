+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[int]\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Alias | str\n"
+            "\n"
+            ".. py:type:: Bare\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    signatures = list(doctree.findall(desc_signature))
+    assert [signature.astext() for signature in signatures] == [
+        'type example.Alias = list[int]', 'class example.Container',
+        'type Nested = Alias | str', 'type example.Bare',
+    ]
+    assert signatures[0].findall(pending_xref)
+    assert signatures[2].findall(pending_xref)
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.objects['list[int]'] == ('index', 'example.Alias', 'type', True)
+    assert domain.objects['example.Container.Nested'] == (
+        'index', 'example.Container.Nested', 'type', False)
+    assert app.env.get_domain('py').object_types['type'].roles == ('type', 'obj')
+    index_nodes = list(doctree.findall(addnodes.index))
+    assert index_nodes[1]['entries'][0][1] == 'Alias (in module example)'
+    assert index_nodes[3]['entries'][0][1] == (
+        'Nested (type alias in example.Container)')
+
+
+def test_pytype_alias_xref_roles(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:type:: Alias\n\n:py:type:`Alias` :py:obj:`Alias`')
+    refs = list(doctree.findall(pending_xref))
+    assert [ref['reftype'] for ref in refs] == ['type', 'obj']
+    domain = app.env.get_domain('py')
+    assert domain.find_obj(app.env, None, None, 'Alias', 'type', 0)
+    assert domain.find_obj(app.env, None, None, 'Alias', 'obj', 0)
+    assert list(doctree.findall(addnodes.index))[0]['entries'][0][1] == 'Alias'
+
+
