+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: list[str | int]\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:data:: member\n"
+            "\n"
+            ".. py:type:: PlainAlias\n"
+            "\n"
+            ":py:type:`example.Container.Alias` :py:obj:`example.PlainAlias`\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert domain.objects['example.Container.Alias'] == (
+        'index', 'example.Container.Alias', 'type', False,
+    )
+    assert domain.objects['example.PlainAlias'] == (
+        'index', 'example.PlainAlias', 'type', False,
+    )
+    assert domain.objects['example.Container.member'] == (
+        'index', 'example.Container.member', 'data', False,
+    )
+    assert domain.objects['list[str | int]'] == (
+        'index', 'example.Container.Alias', 'type', True,
+    )
+    signatures = list(doctree.findall(desc_signature))
+    signature_text = [signature.astext() for signature in signatures]
+    assert signature_text == [
+        'class example.Container', 'type Alias = list[str | int]', 'member',
+        'type example.PlainAlias',
+    ]
+    assert [xref['reftarget'] for xref in signatures[1].findall(pending_xref)] == [
+        'list', 'str', 'int',
+    ]
+    references = list(doctree.findall(pending_xref))
+    assert [(xref['reftype'], xref['reftarget']) for xref in references[-2:]] == [
+        ('type', 'example.Container.Alias'), ('obj', 'example.PlainAlias'),
+    ]
+    assert domain.role_for_objtype('type') == 'type'
+    assert domain.resolve_xref(
+        app.env, 'index', app.builder, 'type', 'example.Container.Alias',
+        references[-2], nodes.Text('Alias'),
+    ) is not None
+    assert domain.resolve_xref(
+        app.env, 'index', app.builder, 'obj', 'example.PlainAlias',
+        references[-1], nodes.Text('PlainAlias'),
+    ) is not None
+
+    index_entries = [entry[1] for index in doctree.findall(addnodes.index)
+                     for entry in index['entries']]
+    assert 'Alias (type alias in example.Container)' in index_entries
+    assert 'PlainAlias (in module example)' in index_entries
+
+
