diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..0d96b4d
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,83 @@
+from __future__ import annotations
+
+import pytest
+
+from sphinx import addnodes
+from sphinx.addnodes import desc
+from sphinx.testing import restructuredtext
+
+
+def test_py_type_alias(app):
+    text = (".. py:module:: pkg\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Thing]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Thing\n"
+            "\n"
+            "      Nested alias description.\n"
+            "\n"
+            "   .. py:type:: NestedWithoutExpression\n"
+            "\n"
+            "   .. py:attribute:: member\n"
+            "\n"
+            "References: :py:type:`Alias`, :py:obj:`Alias`.")
+    doctree = restructuredtext.parse(app, text)
+
+    domain = app.env.get_domain('py')
+    assert domain.objects['pkg.Alias'].objtype == 'type'
+    assert domain.objects['list[Thing]'].objtype == 'type'
+    assert domain.objects['list[Thing]'].aliased
+    assert domain.objects['pkg.Container.Nested'].objtype == 'type'
+    assert domain.objects['pkg.Container.NestedWithoutExpression'].objtype == 'type'
+    assert domain.objects['pkg.Container.member'].objtype == 'attribute'
+
+    aliases = [node for node in doctree.findall(desc)
+               if node.get('objtype') == 'type']
+    assert [node[0].astext() for node in aliases] == [
+        'type pkg.Alias = list[Thing]', 'type Nested = Thing',
+        'type NestedWithoutExpression',
+    ]
+    alias_expression = aliases[0][0].findall(addnodes.pending_xref)
+    assert [node['reftarget'] for node in alias_expression] == ['list', 'Thing']
+
+    references = list(doctree.findall(addnodes.pending_xref))[-2:]
+    assert [node['reftype'] for node in references] == ['type', 'obj']
+    assert [node['reftarget'] for node in references] == ['Alias', 'Alias']
+    assert domain.find_obj(app.env, 'pkg', None, 'Alias', 'type', 1)
+    assert domain.find_obj(app.env, 'pkg', None, 'Alias', None, 1)
+
+
+def test_py_type_alias_without_expression(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    signature = next(doctree.findall(addnodes.desc_signature))
+    assert signature.astext() == 'type Alias'
+
+
+@pytest.mark.sphinx(freshenv=True, confoverrides={'add_module_names': True})
+def test_py_type_alias_index_text(app):
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:module:: pkg\n"
+        "\n"
+        ".. py:type:: Alias\n"
+        "\n"
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Nested\n",
+    )
+    entries = [entry[1] for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert 'Alias (in module pkg)' in entries
+    assert 'Nested (type alias in pkg.Container)' in entries
+
+
+def test_py_type_alias_without_module_index_text(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    index = next(doctree.findall(addnodes.index))
+    assert index['entries'][0][1] == 'Alias'
