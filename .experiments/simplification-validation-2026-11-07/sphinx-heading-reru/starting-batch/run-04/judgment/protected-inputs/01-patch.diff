+def test_pytype_alias_signature_and_targets(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "   .. py:type:: Identifier\n"
+            "      :canonical: int | str\n"
+            "\n"
+            "      An identifier.\n"
+            "   .. py:type:: Empty\n"
+            "\n"
+            ".. py:type:: ModuleAlias\n"
+            "   :canonical: Container.Identifier\n"
+            "\n"
+            "References: :py:type:`Container.Identifier`, :py:obj:`ModuleAlias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    signatures = [node for node in doctree.traverse(desc_signature)]
+
+    assert signatures[1].astext() == 'type Identifier = int | str'
+    assert signatures[2].astext() == 'type Empty'
+    assert signatures[3].astext() == 'type example.ModuleAlias = Container.Identifier'
+    assert signatures[1].traverse(pending_xref)
+    assert domain.objects['example.Container.Identifier'].objtype == 'type'
+    assert domain.objects['example.Container.Empty'].objtype == 'type'
+    assert domain.objects['example.ModuleAlias'].objtype == 'type'
+    assert domain.objects['Container.Identifier'].aliased
+    refs = doctree.traverse(pending_xref)
+    assert refs[-2]['reftype'] == 'type'
+    assert refs[-1]['reftype'] == 'obj'
+    assert domain.find_obj(app.env, 'example', 'Container', 'Identifier', 'type')
+    assert domain.find_obj(app.env, 'example', '', 'ModuleAlias', 'obj')
+
+
+def test_pytype_alias_index_text(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "   .. py:type:: Nested\n"
+            ".. py:type:: ModuleAlias\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for node in doctree.traverse(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'Nested (type alias in example.Container)',
+            'example.Container.Nested', '', None) in entries
+    assert ('single', 'ModuleAlias (in module example)',
+            'example.ModuleAlias', '', None) in entries
+
+
+def test_pytype_alias_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: BareAlias")
+    entries = [entry for node in doctree.traverse(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'BareAlias', 'BareAlias', '', None) in entries
+
+
