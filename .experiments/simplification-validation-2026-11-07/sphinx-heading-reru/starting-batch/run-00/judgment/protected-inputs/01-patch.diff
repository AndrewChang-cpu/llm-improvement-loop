diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..7ac8656 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -54,6 +54,37 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_alias_signatures_and_registration(app):
+    text = (".. py:module:: example\n\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n\n"
+            ".. py:type:: Bare\n\n"
+            ".. py:class:: Container\n\n"
+            "   .. py:type:: Item\n\n"
+            "      Description.\n\n"
+            "See :py:type:`Alias` and :py:obj:`example.Bare`.\n")
+    doctree = restructuredtext.parse(app, text)
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias = list[str]'
+    assert list(signatures[0].findall(pending_xref))
+    assert signatures[1].astext() == 'type example.Bare'
+    assert signatures[2].astext() == 'class example.Container'
+    assert signatures[3].astext() == 'type Item'
+    references = list(doctree.findall(pending_xref))
+    assert [node['reftype'] for node in references[-2:]] == ['type', 'obj']
+    domain = app.env.get_domain('py')
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['list[str]'].objtype == 'type'
+    assert domain.objects['example.Container.Item'].objtype == 'type'
+    assert domain.object_types['type'].lname == 'type alias'
+
+    index_entries = [entry[1] for node in doctree.findall(addnodes.index)
+                     for entry in node['entries']]
+    assert 'Alias (in module example)' in index_entries
+    assert 'Bare (in module example)' in index_entries
+    assert 'Item (type alias in example.Container)' in index_entries
+
+
