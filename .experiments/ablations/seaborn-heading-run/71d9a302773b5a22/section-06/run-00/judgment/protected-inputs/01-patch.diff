index 0000000..9291538
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,58 @@
+"""Statistical transforms based on order statistics."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+from pandas import DataFrame
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with specified percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of percentiles to compute, evenly spaced from 0 through 100,
+        or a list of percentile levels to compute directly. Defaults to 5.
+    method : str
+        Method used to estimate percentiles, passed to :func:`numpy.percentile`.
+        Defaults to "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        try:
+            percentiles = np.percentile(values, levels, method=self.method)
+        except TypeError:
+            # NumPy < 1.22 used ``interpolation`` for this argument.
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var).reset_index(drop=True)
