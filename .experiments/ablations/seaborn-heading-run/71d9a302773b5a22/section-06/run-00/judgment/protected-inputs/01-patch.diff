diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a6d71cb
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,80 @@
+import numpy as np
+import pandas as pd
+
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [2, 4, 6, 8]})
+        groupby = GroupBy(["group"])
+
+        default = Perc()(data, groupby, "x", {})
+        assert_array_equal(default["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(default["y"], [2, 3.5, 5, 6.5, 8])
+
+        result = Perc(k=3)(data, groupby, "x", {})
+        assert_array_equal(result["percentile"], [0, 50, 100])
+        assert_array_equal(result["y"], [2, 5, 8])
+
+    def test_explicit_levels_keep_order(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [2, 4, 6, 8]})
+        result = Perc(k=[90, 10, 50])(data, GroupBy(["group"]), "x", {})
+
+        assert_array_equal(result["percentile"], [90, 10, 50])
+        assert_array_equal(result["y"], [7.4, 2.6, 5])
+
+    def test_method(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [0, 10, 20, 30]})
+        result = Perc(k=[25], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+
+        assert_array_equal(result["y"], [10])
+
+    def test_orientations_groups_and_missing_values(self):
+
+        data = pd.DataFrame({
+            "x": ["a", "a", "b", "b"],
+            "y": [1., 3., 5., np.nan],
+            "group": ["u", "u", "v", "v"],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy(["x", "group"]), "x", {}
+        )
+        assert_array_equal(result["y"], [1, 3, 5, 5])
+        assert_array_equal(result["x"], ["a", "a", "b", "b"])
+        assert_array_equal(result["group"], ["u", "u", "v", "v"])
+
+        horizontal = pd.DataFrame({
+            "x": [1., 3., 5., np.nan],
+            "y": ["a", "a", "b", "b"],
+            "group": ["u", "u", "v", "v"],
+        })
+        result = Perc(k=2)(
+            horizontal, GroupBy(["y", "group"]), "y", {}
+        )
+        assert_array_equal(result["x"], [1, 3, 5, 5])
+        assert_array_equal(result["percentile"], [0, 100, 0, 100])
+
+    def test_objects_import_and_range_composition(self):
+
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+
+        data = pd.DataFrame({
+            "group": ["a", "a", "b", "b"],
+            "value": [1, 2, 3, 4],
+        })
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc()
+        ).plot()
