diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..6affa8f
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,54 @@
+import numpy as np
+import pandas as pd
+
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": ["a"] * 3, "y": [0, 5, 10]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(result["y"], [0, 2.5, 5, 7.5, 10])
+
+    def test_integer_count(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [1, 2, 3, 4]})
+        result = Perc(k=np.int64(3))(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["percentile"], [0, 50, 100] * 4)
+
+    def test_explicit_levels(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 10, 20, 30]})
+        result = Perc(k=[75, 0, 25])(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["percentile"], [75, 0, 25])
+        assert_array_equal(result["y"], [22.5, 0, 7.5])
+
+    def test_interpolation_method(self):
+        data = pd.DataFrame({"x": ["a"] * 2, "y": [0, 10]})
+        result = Perc(k=[25], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["y"], [0])
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [0, 10], "y": ["a", "a"]})
+        result = Perc(k=[50])(data, GroupBy(["y"]), "y", {})
+        assert_array_equal(result["x"], [5])
+
+    def test_grouped_and_missing(self):
+        data = pd.DataFrame({
+            "x": ["a", "a", "b", "b"], "y": [1, np.nan, 10, 20],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["x"], ["a", "a", "b", "b"])
+        assert_array_equal(result["y"], [1, 1, 10, 20])
+
+    def test_public_api_and_plot_composition(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as StatPerc
+
+        assert so.Perc is StatPerc
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 10, 20, 30]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[10, 90]))
+        plot.plot()
