diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..94a9db4
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,54 @@
+"""Order statistics for the objects interface."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels to compute from 0 to 100,
+        inclusive, or a list of the exact percentile levels to compute.
+        Defaults to 5.
+    method : str
+        Method used to interpolate percentile values, as in
+        :func:`numpy.percentile`. Defaults to ``"linear"``.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: pd.DataFrame, var: str) -> pd.DataFrame:
+        values = data[var].dropna()
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        try:
+            percentiles = np.percentile(values, levels, method=self.method)
+        except TypeError:
+            # NumPy < 1.22 used `interpolation` in place of `method`.
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var)
