+++ b/seaborn/_stats/order.py
@@ -0,0 +1,62 @@
+"""Order-statistic transforms for the objects interface."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentiles to compute from 0 through 100,
+        inclusive, or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate between data points when computing
+        percentiles. Defaults to "linear"; see :func:`numpy.percentile`.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        if not len(values):
+            return pd.DataFrame({var: [], "percentile": []})
+
+        try:
+            result = np.percentile(values, levels, method=self.method)
+        except TypeError:
+            # NumPy < 1.22 called this argument ``interpolation``.
+            result = np.percentile(values, levels, interpolation=self.method)
+
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
