@@ -0,0 +1,66 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+@pytest.fixture
+def df():
+    return pd.DataFrame({
+        "x": [1, 2, 3, 10, 20, 30],
+        "y": [1, 2, 3, 10, 20, 30],
+        "group": ["a", "a", "a", "b", "b", "b"],
+    })
+
+
+class TestPerc:
+
+    @pytest.mark.parametrize("k,levels", [(5, [0, 25, 50, 75, 100]), (3, [0, 50, 100])])
+    def test_integer_count(self, df, k, levels):
+        res = Perc(k=k)(df, GroupBy(["group"]), "x", {})
+        assert res["percentile"].unique().tolist() == levels
+        assert len(res) == len(levels) * 2
+
+    def test_explicit_levels_and_order(self, df):
+        res = Perc(k=[75, 25, 50])(df, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "y": [2.5, 1.5, 2, 25, 15, 20],
+            "group": ["a"] * 3 + ["b"] * 3,
+            "percentile": [75, 25, 50] * 2,
+        })
+        assert_frame_equal(res, expected)
+
+    def test_method(self):
+        df = pd.DataFrame({"x": [1, 2], "y": [0, 10]})
+        res = Perc(k=[25], method="lower")(df, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [0, 10]
+
+    @pytest.mark.parametrize("orient,value_var", [("x", "y"), ("y", "x")])
+    def test_orientation(self, df, orient, value_var):
+        res = Perc(k=[50])(df, GroupBy(["group"]), orient, {})
+        assert res[value_var].tolist() == [2, 20]
+
+    def test_missing_values(self):
+        df = pd.DataFrame({"x": [1, 2, 3, 4], "y": [1, np.nan, 3, np.nan], "group": ["a", "a", "b", "b"]})
+        res = Perc(k=[0, 50, 100])(df, GroupBy(["group"]), "x", {})
+        assert res["y"].tolist() == [1, 1, 1, 3, 3, 3]
+
+    def test_empty_group_values(self):
+        df = pd.DataFrame({"x": [1, 2], "y": [np.nan, np.nan], "group": ["a", "a"]})
+        res = Perc()(df, GroupBy(["group"]), "x", {})
+        assert res.empty
+        assert {"y", "group", "percentile"} <= set(res)
+
+    def test_objects_api(self):
+        from seaborn import objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = so.Plot(
+            pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 3, 4]}),
+            x="x", y="y",
+        ).add(so.Range(), so.Perc(k=[25, 75])).plot()
+        assert plot._figure.axes
