+++ b/seaborn/_stats/order.py
@@ -0,0 +1,58 @@
+"""Statistics based on order values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from pandas import DataFrame
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels to compute. Defaults to 5.
+    method : str
+        Method used to interpolate between data points when a percentile falls
+        between observations. See :func:`numpy.percentile`. Defaults to
+        ``"linear"``.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        is_count = isinstance(self.k, (int, np.integer))
+        percentiles = np.linspace(0, 100, self.k) if is_count else self.k
+        try:
+            result = np.percentile(values, percentiles, method=self.method)
+        except TypeError:
+            result = np.percentile(values, percentiles, interpolation=self.method)
+        return pd.DataFrame({var: result, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
