diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0080eb0
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,50 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"y": [2, 4, 6, 8]})
+        result = Perc(3)(data, GroupBy(["missing"]), "x", {})
+        expected = pd.DataFrame({
+            "y": [2., 5., 8.], "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels_and_interpolation(self):
+        data = pd.DataFrame({"y": [0, 10, 20]})
+        result = Perc([75, 25], method="lower")(
+            data, GroupBy(["missing"]), "x", {},
+        )
+        expected = pd.DataFrame({
+            "y": [10., 0.], "percentile": [75, 25],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_grouped_missing_and_orientation(self):
+        data = pd.DataFrame({
+            "x": [1, 2, 3, 4, 5, 6],
+            "y": [1, 2, 3, 10, 20, np.nan],
+            "group": ["a", "a", "a", "b", "b", "b"],
+        })
+        result = Perc([0, 50, 100])(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "x": [1., 2., 3., 4., 5.],
+            "group": ["a", "a", "a", "b", "b"],
+            "percentile": [0, 50, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_public_import_and_plot_composition(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 2, 4]})
+        plot = so.Plot(data, "x", "y").add(so.Range(), so.Perc())
+        plot.plot()
