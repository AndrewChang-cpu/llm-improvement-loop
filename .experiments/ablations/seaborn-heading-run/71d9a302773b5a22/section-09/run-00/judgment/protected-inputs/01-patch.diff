diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..07bd2aa
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,48 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 0], "y": [1, 2.5, 4], "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_explicit_order_and_method(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4]})
+        result = Perc([75, 25], "lower")(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "group": ["a", "a"], "x": [3, 1], "percentile": [75, 25],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_grouped_and_missing(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a", "b"],
+            "x": [1, 10, 3, np.nan, 5],
+        })
+        result = Perc([0, 100])(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "group": ["b", "b", "a", "a"],
+            "x": [1., 5., 10., 10.],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [4, 5, 6], "group": ["a"] * 3})
+        result = Perc(k=2)(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "x": [1., 3.], "group": ["a", "a"],
+            "percentile": [0., 100.],
+        })
+        assert_frame_equal(result, expected)
