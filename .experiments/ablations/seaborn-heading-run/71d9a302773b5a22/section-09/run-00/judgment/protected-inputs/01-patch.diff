+"""Order-statistics transforms."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles along the value axis."""
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, int):
+            percentile = np.linspace(0, 100, self.k)
+        else:
+            percentile = self.k
+
+        values = data[var].dropna().to_numpy()
+        try:
+            result = np.percentile(values, percentile, method=self.method)
+        except TypeError:
+            result = np.percentile(values, percentile, interpolation=self.method)
+
+        return pd.DataFrame({var: result, "percentile": percentile})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var).reset_index(drop=True)
