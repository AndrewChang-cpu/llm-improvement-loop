new file mode 100644
index 0000000..e70b910
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,59 @@
+"""Order statistics for the objects interface."""
+from __future__ import annotations
+from dataclasses import dataclass
+from inspect import signature
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+_PERCENTILE_METHOD = (
+    "method" if "method" in signature(np.percentile).parameters else "interpolation"
+)
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentile levels from 0 through 100, or a
+        list specifying the exact percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate between data points when a percentile falls
+        between observations. Passed to :func:`numpy.percentile`; defaults to
+        "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _process(self, data: DataFrame, var: str, percentiles: list[float]) -> DataFrame:
+        values = data[var].dropna()
+        percentile_kws = {_PERCENTILE_METHOD: self.method}
+        result = np.percentile(values, percentiles, **percentile_kws)
+        return pd.DataFrame({var: result, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, (int, np.integer)):
+            percentiles = np.linspace(0, 100, self.k).tolist()
+        else:
+            percentiles = self.k
+        return groupby.apply(data, self._process, var, percentiles).reset_index(drop=True)
