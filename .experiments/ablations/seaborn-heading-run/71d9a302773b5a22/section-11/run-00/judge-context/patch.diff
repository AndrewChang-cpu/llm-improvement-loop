diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..b033f1c
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4], "group": "a"})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(result["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(result["y"], [1, 1.75, 2.5, 3.25, 4])
+
+    def test_integer_count_and_explicit_order(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4], "group": "a"})
+        groupby = GroupBy(["group"])
+
+        counted = Perc(k=3)(data, groupby, "x", {})
+        assert_array_equal(counted["percentile"], [0, 50, 100])
+        explicit = Perc(k=[75, 0, 25])(data, groupby, "x", {})
+        assert_array_equal(explicit["percentile"], [75, 0, 25])
+        assert_array_equal(explicit["y"], [3.25, 1, 1.75])
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [1, 1], "y": [0, 10], "group": "a"})
+        result = Perc(k=[25], method="lower")(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(result["y"], [0])
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"x": [0, 10], "y": [1, 1], "group": "a"})
+        result = Perc(k=[50])(data, GroupBy(["group"]), "y", {})
+        assert_array_equal(result["x"], [5])
+
+    def test_groups_and_missing(self):
+        data = pd.DataFrame({
+            "x": [1, 1, 1, 2, 2],
+            "y": [0, np.nan, 10, 4, np.nan],
+            "group": ["a", "a", "a", "b", "b"],
+        })
+        result = Perc(k=[0, 50, 100])(
+            data, GroupBy(["group"]), "x", {}
+        )
+        assert_array_equal(result["group"], ["a"] * 3 + ["b"] * 3)
+        assert_array_equal(result["y"], [0, 5, 10, 4, 4, 4])
+
+    def test_public_imports_and_plot_composition(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = (
+            so.Plot(x=["a", "a", "b", "b"], y=[1, 2, 3, 4])
+            .add(so.Range(), so.Perc(k=3))
+        )
+        plot.plot()
