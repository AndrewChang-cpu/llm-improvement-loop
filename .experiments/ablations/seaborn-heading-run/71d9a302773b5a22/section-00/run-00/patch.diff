@@ -0,0 +1,58 @@
+"""Order statistics for statistical transformations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Compute percentiles along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate between observations when computing
+        percentiles. Defaults to ``"linear"``; see :func:`numpy.percentile`.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        if isinstance(self.k, (int, np.integer)):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+
+        try:
+            result = np.percentile(values, percentiles, method=self.method)
+        except TypeError:  # NumPy < 1.22
+            result = np.percentile(values, percentiles, interpolation=self.method)
+
+        return pd.DataFrame({var: result, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
