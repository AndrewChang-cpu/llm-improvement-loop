diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..b32f370
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,57 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        df = pd.DataFrame({"x": [0, 1, 2, 3], "y": [1, 2, 3, 4]})
+        res = Perc(k=3)(df, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": np.repeat(df.x, 3),
+            "y": np.repeat(df.y, 3).astype(float),
+            "percentile": np.tile([0, 50, 100], 4).astype(float),
+        })
+        expected.index = pd.RangeIndex(len(expected))
+        assert_frame_equal(res, expected)
+
+    def test_explicit_order_and_interpolation(self):
+        df = pd.DataFrame({"x": [0] * 3, "y": [0, 10, 20]})
+        res = Perc(k=[75, 25], method="nearest")(
+            df, GroupBy(["x"]), "x", {},
+        )
+        expected = pd.DataFrame({
+            "x": [0, 0], "y": [20, 0], "percentile": [75, 25],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_orientation_and_missing(self):
+        df = pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, np.nan, 30, 40], "g": ["a"] * 4})
+        for orient, var in [("x", "y"), ("y", "x")]:
+            res = Perc(k=[0, 50, 100])(df, GroupBy(["g"]), orient, {})
+            expected = np.percentile(df[var].dropna(), [0, 50, 100])
+            assert np.allclose(res[var], expected)
+            assert res["percentile"].tolist() == [0, 50, 100]
+
+    def test_grouped(self):
+        df = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 10, 20], "g": ["a", "a", "b", "b"]})
+        res = Perc(k=[0, 100])(df, GroupBy(["x", "g"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 1, 1], "y": [1., 3., 10., 20.],
+            "g": ["a", "a", "b", "b"],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_public_import_and_range_composition(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = so.Plot(pd.DataFrame({"x": ["a", "a", "a"], "y": [1, 2, 3]}), x="x", y="y")
+        plot.add(so.Range(), so.Perc(k=[0, 100])).plot()
