diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..9772cfb
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,56 @@
+"""Order-statistics transformations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of numbers, default=5
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels.
+    method : str, default="linear"
+        Method used to interpolate between data points when computing
+        percentiles. See :func:`numpy.percentile` for the available methods.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str, levels) -> DataFrame:
+        values = data[var].dropna()
+        try:
+            percentiles = np.percentile(values, levels, method=self.method)
+        except TypeError:
+            # NumPy < 1.22 calls this argument ``interpolation``.
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+        return groupby.apply(data, self._percentiles, var, levels)
