index 0000000..c7846dc
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,67 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        df = pd.DataFrame({"x": [0, 0, 0, 0], "y": [3, 1, 5, 7]})
+        res = Perc(k=3)(df, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 0], "y": [1., 4., 7.],
+            "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_default(self):
+        df = pd.DataFrame({"x": [0] * 5, "y": [1, 2, 3, 4, 5]})
+        res = Perc()(df, GroupBy(["x"]), "x", {})
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+
+    def test_explicit_levels_and_method(self):
+        df = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        res = Perc(k=[75, 25], method="nearest")(df, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0], "y": [3, 2], "percentile": [75, 25],
+        })
+        assert_frame_equal(res, expected)
+
+    @pytest.mark.parametrize("orient", ["x", "y"])
+    def test_orientation(self, orient):
+        df = pd.DataFrame({"x": [1, 1, 1], "y": [10, 20, 30]})
+        if orient == "y":
+            df = pd.DataFrame({"x": [1, 2, 3], "y": [10, 10, 10]})
+        res = Perc(k=[0, 100])(df, GroupBy(["x"] if orient == "x" else ["y"]), orient, {})
+        value = "y" if orient == "x" else "x"
+        assert res[value].tolist() == ([10, 30] if orient == "x" else [1, 3])
+
+    def test_grouped_and_missing(self):
+        df = pd.DataFrame({
+            "x": [0, 0, 0, 1, 1],
+            "y": [1, np.nan, 3, 10, 14],
+            "group": ["a", "a", "a", "b", "b"],
+        })
+        res = Perc(k=[50])(df, GroupBy(["x", "group"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 1], "y": [2., 12.], "group": ["a", "b"],
+            "percentile": [50, 50],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_public_imports(self):
+        from seaborn._stats.order import Perc as InternalPerc
+        from seaborn.objects import Perc as ObjectsPerc
+
+        assert InternalPerc is Perc
+        assert ObjectsPerc is Perc
+
+    def test_range_composition(self):
+        from seaborn.objects import Plot, Range
+
+        df = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 3, 2, 4]})
+        Plot(df, x="x", y="y").add(Range(), Perc(k=[0, 100])).plot()
