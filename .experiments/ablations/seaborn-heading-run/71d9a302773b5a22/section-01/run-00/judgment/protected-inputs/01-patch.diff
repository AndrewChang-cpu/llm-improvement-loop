+"""Order-statistics transformations."""
+from __future__ import annotations
+from dataclasses import dataclass
+import inspect
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of numbers
+        Number of evenly spaced percentiles from 0 through 100 to compute, or
+        an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate percentile values, following the options
+        accepted by :func:`numpy.percentile`. Defaults to "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        if isinstance(self.k, (int, np.integer)):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+
+        kwargs = {"method" if "method" in inspect.signature(np.percentile).parameters
+                  else "interpolation": self.method}
+        result = np.percentile(values, percentiles, **kwargs)
+        return pd.DataFrame({var: result, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
