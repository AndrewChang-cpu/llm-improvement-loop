diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..f35ae38
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,83 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def args(self):
+
+        class Scale:
+            pass
+
+        return GroupBy(["group"]), "x", {"x": Scale()}
+
+    def test_integer_count(self, args):
+
+        data = pd.DataFrame({"x": [0, 10, 20, 30], "y": [1, 2, 3, 4]})
+        default = Perc()(data, *args)
+        assert_array_equal(default["percentile"], [0, 25, 50, 75, 100])
+
+        out = Perc(k=3)(data, *args)
+        assert_array_equal(out["y"], [1, 2.5, 4])
+        assert_array_equal(out["percentile"], [0, 50, 100])
+
+    def test_explicit_levels_keep_order(self, args):
+
+        data = pd.DataFrame({"x": [0, 10, 20, 30], "y": [1, 2, 3, 4]})
+        out = Perc(k=[75, 25])(data, *args)
+        assert_array_equal(out["y"], [3.25, 1.75])
+        assert_array_equal(out["percentile"], [75, 25])
+
+    def test_method(self, args):
+
+        data = pd.DataFrame({"x": [0, 10, 20], "y": [0, 10, 20]})
+        out = Perc(k=[40], method="nearest")(data, *args)
+        assert_array_equal(out["y"], [10])
+
+    def test_orientation_and_grouping(self):
+
+        data = pd.DataFrame({
+            "x": [1, 2, 3, 4, 5, 6],
+            "y": [10, 20, 30, 40, 50, 60],
+            "group": ["a", "a", "a", "b", "b", "b"],
+        })
+        transform = Perc(k=[0, 100])
+        groupby = GroupBy(["group"])
+
+        class Scale:
+            pass
+
+        scales = {"x": Scale(), "y": Scale()}
+        x_orient = transform(data, groupby, "x", scales)
+        assert_array_equal(x_orient["y"], [10, 30, 40, 60])
+        assert_array_equal(x_orient["group"], ["a", "a", "b", "b"])
+
+        y_orient = transform(data, groupby, "y", scales)
+        assert_array_equal(y_orient["x"], [1, 3, 4, 6])
+
+    def test_missing_values(self, args):
+
+        data = pd.DataFrame({"x": [0, 10, 20], "y": [1, np.nan, 3]})
+        out = Perc(k=[0, 50, 100])(data, *args)
+        assert_array_equal(out["y"], [1, 2, 3])
+
+    def test_public_imports(self):
+
+        from seaborn._stats.order import Perc as StatsPerc
+        from seaborn.objects import Perc as ObjectsPerc
+
+        assert StatsPerc is ObjectsPerc is Perc
+
+    def test_plot_composition(self):
+
+        import seaborn.objects as so
+
+        data = pd.DataFrame({"x": [0, 10, 20, 30], "group": ["a", "a", "b", "b"]})
+        plot = so.Plot(data, x="group", y="x").add(so.Range(), so.Perc(k=[0, 100]))
+        plot.plot()
