+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def data(self):
+        return pd.DataFrame({
+            "x": [0, 1, 2, 3, 4, 5],
+            "y": [1, 2, 3, 4, 5, 6],
+            "group": ["a", "a", "a", "b", "b", "b"],
+        })
+
+    def test_count(self, data):
+        result = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(result["y"], [1, 2, 3, 4, 5, 6])
+        assert_array_equal(result["percentile"], [0, 50, 100, 0, 50, 100])
+
+    def test_explicit_levels_and_order(self, data):
+        result = Perc(k=[75, 25])(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(result["y"], [2.5, 1.5, 5.5, 4.5])
+        assert_array_equal(result["percentile"], [75, 25, 75, 25])
+
+    def test_method(self):
+        data = pd.DataFrame({"y": [0, 10]})
+        result = Perc(k=[25], method="nearest")(
+            data, GroupBy(["unused"]), "x", {}
+        )
+        assert_array_equal(result["y"], [0])
+
+    @pytest.mark.parametrize("orient", ["x", "y"])
+    def test_orientation_and_missing(self, orient):
+        var = {"x": "y", "y": "x"}[orient]
+        data = pd.DataFrame({var: [0, 10, np.nan]})
+        result = Perc(k=3)(data, GroupBy(["unused"]), orient, {})
+        assert_array_equal(result[var], [0, 5, 10])
+
+    def test_public_import_and_plot_composition(self, data):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        plot_data = data.rename(columns={"x": "value"})
+        so.Plot(plot_data, x="value", y="group").add(
+            so.Range(), so.Perc(), orient="y"
+        ).plot()
