--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,53 @@
+"""Order statistics for the objects interface."""
+from __future__ import annotations
+from dataclasses import dataclass
+from numbers import Integral
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with their percentiles along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of numbers, default 5
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels to compute.
+    method : str, default "linear"
+        Method used to interpolate between data points, as accepted by
+        :func:`numpy.percentile`.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data, var):
+        values = data[var].dropna()
+        if isinstance(self.k, Integral):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        try:
+            result = np.percentile(values, levels, method=self.method)
+        except TypeError:
+            result = np.percentile(values, levels, interpolation=self.method)
+
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var)
