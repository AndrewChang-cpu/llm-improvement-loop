diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..b28e786
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,61 @@
+"""Order statistics for the objects interface."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to interpolate between data points when a percentile lies
+        between them. Defaults to ``"linear"``; see :func:`numpy.percentile`
+        for the available methods.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _process(self, data: DataFrame, var: str, qs: list[float]) -> DataFrame:
+        vals = data[var].dropna()
+        if vals.empty:
+            return DataFrame(columns=[var, "percentile"])
+
+        try:
+            percentiles = np.percentile(vals, qs, method=self.method)
+        except TypeError as err:
+            if "method" not in str(err):
+                raise
+            percentiles = np.percentile(vals, qs, interpolation=self.method)
+
+        return DataFrame({var: percentiles, "percentile": qs})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        qs = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer)) else self.k
+        )
+        return groupby.apply(data, self._process, var, qs).reset_index(drop=True)
