+def test_pytype_signature_and_references(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:type:: EmptyAlias\n"
+            "\n"
+            "See :py:type:`Alias` and :py:obj:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    descriptions = list(doctree.findall(desc))
+
+    assert_node(descriptions[0][0],
+                ([desc_annotation, ('type', desc_sig_space)],
+                 [desc_addname, 'example.'],
+                 [desc_name, 'Alias'],
+                 [desc_annotation, (desc_sig_space,
+                                   [desc_sig_punctuation, '='],
+                                   desc_sig_space,
+                                   [pending_xref, 'list'],
+                                   [desc_sig_punctuation, '['],
+                                   [pending_xref, 'str'],
+                                   [desc_sig_punctuation, ']'])]))
+    assert descriptions[0][1].astext() == 'Alias description.'
+    assert_node(descriptions[1][0],
+                ([desc_annotation, ('type', desc_sig_space)],
+                 [desc_addname, 'example.'],
+                 [desc_name, 'EmptyAlias']))
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.find_obj(app.env, 'example', '', 'Alias', 'type') == [
+        ('example.Alias', domain.objects['example.Alias'])]
+    assert domain.find_obj(app.env, 'example', '', 'Alias', None) == [
+        ('example.Alias', domain.objects['example.Alias'])]
+    assert domain.objects['list[str]'].objtype == 'type'
+    assert domain.objects['list[str]'].aliased is True
+    refs = list(doctree.findall(pending_xref))
+    assert [ref['reftype'] for ref in refs[-2:]] == ['type', 'obj']
+    assert [ref['reftarget'] for ref in refs[-2:]] == ['Alias', 'Alias']
+    assert domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                               refs[-2], refs[-2][0]) is not None
+    assert domain.resolve_xref(app.env, 'index', app.builder, 'obj', 'Alias',
+                               refs[-1], refs[-1][0]) is not None
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Alias (in module example)',
+            domain.objects['example.Alias'].node_id, '', None) in entries
+
+
+def test_pytype_nested_index_text(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      .. py:data:: member\n"
+            "")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert domain.objects['example.Container.Alias'].objtype == 'type'
+    assert 'example.Container.member' in domain.objects
+    assert 'example.Container.Alias.member' not in domain.objects
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Alias (type alias in example.Container)',
+            domain.objects['example.Container.Alias'].node_id, '', None) in entries
+
+
+def test_pytype_index_without_module_names(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+
+    assert ('single', 'Alias (type alias in Container)',
+            domain.objects['example.Container.Alias'].node_id, '', None) in entries
+
+
+def test_pytype_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    domain = app.env.get_domain('py')
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+
+    assert domain.objects['Alias'].objtype == 'type'
+    assert ('single', 'Alias', domain.objects['Alias'].node_id, '', None) in entries
+
+
