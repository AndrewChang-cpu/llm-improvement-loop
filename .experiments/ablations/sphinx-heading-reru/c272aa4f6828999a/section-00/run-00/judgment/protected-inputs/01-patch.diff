diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..d7c7f4d
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,70 @@
+"""Tests for Python type aliases."""
+
+from sphinx import addnodes
+from sphinx.testing import restructuredtext
+
+
+def test_pytype_alias_without_expression(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias')
+    domain = app.env.get_domain('py')
+
+    assert doctree[1].astext().strip() == 'type Alias'
+    assert domain.objects['Alias'] == ('index', 'Alias', 'type', False)
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.find_obj(app.env, None, None, 'Alias', 'type')
+    assert domain.find_obj(app.env, None, None, 'Alias', 'obj')
+
+
+def test_pytype_alias_expression_and_canonical(app):
+    text = ('.. py:class:: Container\n'
+            '\n'
+            '   .. py:type:: Alias\n'
+            '      :canonical: list[Container]\n'
+            '\n'
+            '      Alias description.\n')
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    alias = list(doctree.findall(addnodes.desc))[-1]
+    signature = alias[0]
+
+    assert signature.astext() == 'type Alias = list[Container]'
+    xrefs = list(signature.findall(addnodes.pending_xref))
+    assert [xref['reftarget'] for xref in xrefs] == ['list', 'Container']
+    node_id = domain.objects['Container.Alias'].node_id
+    assert domain.objects['Container.Alias'].objtype == 'type'
+    assert domain.objects['list[Container]'] == ('index', node_id, 'type', True)
+    assert alias[1].astext() == 'Alias description.'
+    assert domain.find_obj(app.env, None, None, 'Container.Alias', 'type')
+    assert domain.find_obj(app.env, None, None, 'Container.Alias', 'obj')
+
+
+def test_pytype_alias_indexes(app):
+    app.config.add_module_names = True
+    text = ('.. py:module:: package.module\n'
+            '.. py:type:: ModuleAlias\n'
+            '\n'
+            '.. py:class:: Container\n'
+            '\n'
+            '   .. py:type:: NestedAlias\n'
+            '\n'
+            '      .. py:type:: InnerAlias\n')
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+
+    assert any(entry[0:2] == ('single', 'ModuleAlias (in module package.module)')
+               for entry in entries)
+    assert any(entry[0:2] == ('single',
+                              'NestedAlias (type alias in package.module.Container)')
+               for entry in entries)
+    domain = app.env.get_domain('py')
+    assert 'package.module.Container.InnerAlias' in domain.objects
+    assert 'package.module.Container.NestedAlias.InnerAlias' not in domain.objects
+
+
+def test_pytype_alias_index_without_module(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias')
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+
+    assert any(entry[0:2] == ('single', 'Alias') for entry in entries)
