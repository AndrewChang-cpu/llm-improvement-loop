+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Item]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:type:: BareAlias\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Item\n"
+            "\n"
+            ".. py:class:: Item\n")
+    text += "\n:py:type:`Alias` :py:obj:`Alias`\n"
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    descriptions = list(doctree.findall(addnodes.desc))
+    alias_desc, bare_desc, _container_desc, nested_desc = descriptions[:4]
+    alias = alias_desc[0]
+    assert alias.astext() == 'type example.Alias = list[Item]'
+    assert list(alias.findall(pending_xref))
+    assert 'example.Alias' in domain.objects
+    assert domain.objects['example.Alias'][2:] == ('type', False)
+    assert domain.objects['list[Item]'][2:] == ('type', True)
+    assert alias_desc[1].astext() == 'Alias description.'
+
+    bare = bare_desc[0]
+    assert bare.astext() == 'type example.BareAlias'
+    assert 'example.BareAlias' in domain.objects
+
+    nested = nested_desc[0]
+    assert nested.astext() == 'type Nested = Item'
+    assert 'example.Container.Nested' in domain.objects
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in entries
+    assert ('single', 'Nested (type alias in example.Container)',
+            'example.Container.Nested', '', None) in entries
+
+    python_domain = app.env.domains['py']
+    assert 'type' in python_domain.directives
+    assert 'type' in python_domain.roles
+    assert python_domain.object_types['type'].roles == ('type', 'obj')
+    expression_reference = next(ref for ref in alias.findall(pending_xref)
+                                if ref['reftarget'] == 'Item')
+    assert python_domain.resolve_xref(
+        app.env, 'index', app.builder, expression_reference['reftype'], 'Item',
+        expression_reference, nodes.Text('Item')) is not None
+    references = list(doctree.findall(pending_xref))[-2:]
+    assert [reference['reftype'] for reference in references] == ['type', 'obj']
+    for reference in references:
+        assert python_domain.resolve_xref(
+            app.env, 'index', app.builder, reference['reftype'], 'Alias',
+            reference, nodes.Text('Alias')) is not None
+
+
+def test_pytype_alias_module_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    assert doctree[0]['entries'] == [('single', 'Alias', 'Alias', '', None)]
+
+
+def test_pytype_alias_does_not_nest_content(app):
+    doctree = restructuredtext.parse(
+        app, ".. py:type:: Alias\n\n   .. py:type:: Inner\n")
+    domain = app.env.get_domain('py')
+    assert 'Alias' in domain.objects
+    assert 'Inner' in domain.objects
+    assert 'Alias.Inner' not in domain.objects
+
+
+def test_pytype_alias_nested_index_without_module_name(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:class:: Container\n\n"
+        "   .. py:type:: Alias\n")
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Alias (type alias in Container)',
+            'example.Container.Alias', '', None) in entries
+
+
