index e653c80..9c18425 100644
--- a/tests/test_domains/test_domain_py.py
+++ b/tests/test_domains/test_domain_py.py
@@ -481,6 +481,71 @@ def test_no_index_entry(app):
     assert_node(doctree[2], addnodes.index, entries=[])
 
 
+@pytest.mark.sphinx(freshenv=True, confoverrides={'add_module_names': True})
+def test_type_alias_directive_and_references(app):
+    text = (".. py:module:: pkg.types\n"
+            "\n"
+            ".. py:class:: Item\n"
+            "\n"
+            ".. py:class:: Outer\n"
+            "\n"
+            "   .. py:type:: Member\n"
+            "      :canonical: list[Item]\n"
+            "\n"
+            "      A member alias.\n"
+            "\n"
+            "      .. py:data:: nested\n"
+            "\n"
+            "   References: :py:type:`Member`, :py:obj:`Outer.Member`.\n"
+            "\n"
+            ".. py:type:: Standalone\n"
+            "\n"
+            "Standalone reference: :py:type:`Standalone`.\n")
+    doctree = restructuredtext.parse(app, text)
+
+    alias_signatures = [signature for signature in doctree.findall(desc_signature)
+                        if signature.parent['objtype'] == 'type']
+    assert [signature.astext() for signature in alias_signatures] == [
+        'type Member = list[Item]', 'type pkg.types.Standalone',
+    ]
+    annotation_xrefs = [xref for xref in alias_signatures[0].findall(pending_xref)]
+    assert [(xref['reftype'], xref['reftarget']) for xref in annotation_xrefs] == [
+        ('class', 'list'), ('class', 'Item'),
+    ]
+
+    refs = list(doctree.findall(pending_xref))
+    alias_refs = [xref for xref in refs if xref['reftype'] in {'type', 'obj'}]
+    assert [(xref['reftype'], xref['reftarget']) for xref in alias_refs] == [
+        ('type', 'Member'), ('obj', 'Outer.Member'), ('type', 'Standalone'),
+    ]
+
+    domain = app.env.get_domain('py')
+    for xref in alias_refs:
+        resolved = domain.resolve_xref(
+            app.env, 'index', app.builder, xref['reftype'], xref['reftarget'], xref,
+            nodes.literal('', xref['reftarget']),
+        )
+        assert resolved is not None, (xref['reftype'], xref['reftarget'],
+                                      xref.get('py:module'), xref.get('py:class'))
+
+    objects = domain.objects
+    assert objects['pkg.types.Outer.Member'].objtype == 'type'
+    assert objects['pkg.types.Outer.Member'].aliased is False
+    assert objects['list[Item]'].objtype == 'type'
+    assert objects['list[Item]'].aliased is True
+    assert objects['pkg.types.Standalone'].objtype == 'type'
+    assert objects['pkg.types.Outer.nested'].objtype == 'data'
+    assert 'pkg.types.Outer.Member.nested' not in objects
+
+    alias_indices = [entry[1] for index in doctree.findall(addnodes.index)
+                     for entry in index['entries']
+                     if entry[1].startswith(('Member ', 'Standalone '))]
+    assert alias_indices == [
+        'Member (type alias in pkg.types.Outer)',
+        'Standalone (in module pkg.types)',
+    ]
+
+
