diff --git a/tests/test_domains/test_domain_py.py b/tests/test_domains/test_domain_py.py
index e653c80..25e3fe2 100644
--- a/tests/test_domains/test_domain_py.py
+++ b/tests/test_domains/test_domain_py.py
@@ -147,6 +147,94 @@ def test_domain_py_xrefs(app, status, warning):
     assert len(refnodes) == 2
 
 
+def test_type_alias_directive_and_lookup(app):
+    text = (".. py:currentmodule:: package.mod\n"
+            ".. py:class:: Thing\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Item\n"
+            "      :canonical: list[Thing]\n"
+            "\n"
+            "      An item alias.\n"
+            "\n"
+            "      .. py:type:: Inner\n"
+            "\n"
+            "   .. py:type:: Bare\n"
+            "\n"
+            ".. py:type:: ModuleAlias\n"
+            "\n"
+            ".. py:type:: ModuleExpression\n"
+            "   :canonical: dict[Thing]\n"
+            "\n"
+            "   :py:type:`Container.Item` and :py:obj:`ModuleAlias`\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert domain.objects['package.mod.Container.Item'][2] == 'type'
+    assert domain.objects['package.mod.Container.Bare'][2] == 'type'
+    assert domain.objects['package.mod.Container.Inner'][2] == 'type'
+    assert domain.objects['package.mod.ModuleAlias'][2] == 'type'
+    assert domain.objects['package.mod.ModuleExpression'][2] == 'type'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objtypes_for_role('type') == ['type']
+    assert domain.objtypes_for_role('obj') == list(domain.object_types)
+    assert domain.find_obj(app.env, 'package.mod', 'Container', 'Item', 'type', 1)[0][0] == \
+        'package.mod.Container.Item'
+    assert domain.find_obj(app.env, 'package.mod', '', 'ModuleAlias', 'obj', 1)[0][0] == \
+        'package.mod.ModuleAlias'
+
+    signatures = list(doctree.findall(desc_signature))
+    alias_signature = next(node for node in signatures
+                           if node.astext() == 'type Item = list[Thing]')
+    assert any(node.astext() == 'type Inner' for node in signatures)
+    assert any(node.astext() == 'type Bare' for node in signatures)
+    assert any(node.astext() == 'type package.mod.ModuleAlias' for node in signatures)
+    assert any(node.astext() == 'type package.mod.ModuleExpression = dict[Thing]'
+               for node in signatures)
+    component_refs = [node for node in alias_signature.findall(pending_xref)
+                      if node.get('reftarget') == 'list' or
+                      node.get('reftarget') == 'Thing']
+    assert [node['reftarget'] for node in component_refs] == ['list', 'Thing']
+    assert [node['reftype'] for node in component_refs] == ['class', 'class']
+
+    alias_refs = [node for node in doctree.findall(pending_xref)
+                  if node.get('reftarget') in {'Container.Item', 'ModuleAlias'}]
+    assert [node['reftype'] for node in alias_refs] == ['type', 'obj']
+    assert domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                               'Container.Item', alias_refs[0], nodes.Text('Item'))
+    assert domain.resolve_xref(app.env, 'index', app.builder, 'obj',
+                               'ModuleAlias', alias_refs[1], nodes.Text('ModuleAlias'))
+    thing_ref = next(node for node in component_refs if node.get('reftarget') == 'Thing')
+    assert domain.resolve_xref(app.env, 'index', app.builder, 'class', 'Thing',
+                               thing_ref, nodes.Text('Thing'))
+
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Item (type alias in package.mod.Container)' in entries
+    assert 'Bare (type alias in package.mod.Container)' in entries
+    assert 'Inner (type alias in package.mod.Container)' in entries
+    assert 'ModuleAlias (in module package.mod)' in entries
+
+
+def test_type_alias_index_without_module_prefix(app):
+    app.config.add_module_names = False
+    text = (".. py:currentmodule:: package.mod\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Item\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Item (type alias in Container)' in entries
+
+    app.env.ref_context.pop('py:module', None)
+    doctree = restructuredtext.parse(app, ".. py:type:: Standalone\n")
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Standalone' in entries
+
+
