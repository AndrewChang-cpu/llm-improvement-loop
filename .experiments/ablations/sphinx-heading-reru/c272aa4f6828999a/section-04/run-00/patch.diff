diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..2e924dd 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -54,6 +54,58 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_signature_and_aliases(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n"
+            "\n"
+            ".. py:type:: Bare\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Member\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:method:: method\n")
+    text += ("\n"
+             ":py:type:`Alias` and :py:obj:`Alias`\n"
+             "\n"
+             ".. py:currentmodule:: None\n"
+             ".. py:type:: Unqualified\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    alias_signature = doctree[3][0]
+    assert alias_signature.astext() == 'type example.Alias = list[str]'
+    assert [node['reftarget'] for node in alias_signature.findall(pending_xref)] == [
+        'list', 'str']
+    assert doctree[5][0].astext() == 'type example.Bare'
+    assert doctree[7][1][1][0].astext() == 'type Member'
+
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['list[str]'].objtype == 'type'
+    assert domain.objects['example.Bare'].objtype == 'type'
+    assert domain.objects['example.Container.Member'].objtype == 'type'
+    assert domain.objects['example.Container.method'].objtype == 'method'
+    assert 'example.Container.Member.method' not in domain.objects
+    assert domain.role_for_objtype('type') == 'type'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.find_obj(app.env, 'example', '', 'Alias', 'type')
+    assert domain.find_obj(app.env, 'example', '', 'Alias', 'obj')
+    assert 'type' in domain.roles
+    assert [(node['reftype'], node['reftarget'])
+            for node in doctree.findall(pending_xref)
+            if node['reftarget'] == 'Alias'] == [('type', 'Alias'), ('obj', 'Alias')]
+
+    index_entries = [entry for node in doctree.findall(addnodes.index)
+                     for entry in node['entries']]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in index_entries
+    assert ('single', 'Bare (in module example)', 'example.Bare', '', None) in index_entries
+    assert ('single', 'Member (type alias in example.Container)',
+            'example.Container.Member', '', None) in index_entries
+    assert ('single', 'Unqualified', 'Unqualified', '', None) in index_entries
+
+
