+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Other]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:type:: EmptyAlias\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Other\n"
+            "\n"
+            "References: :py:type:`Alias` and :py:obj:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    descs = list(doctree.findall(addnodes.desc))
+    alias_desc = descs[0]
+    signature = alias_desc[0]
+    assert signature.astext() == 'type example.Alias = list[Other]'
+    assert len(list(signature.findall(pending_xref))) == 2
+    assert 'example.Alias' in domain.objects
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.objects['example.EmptyAlias'] == (
+        'index', 'example.EmptyAlias', 'type', False)
+    assert domain.objects['list[Other]'] == ('index', 'example.Alias', 'type', True)
+    assert domain.objects['example.Container.Nested'] == (
+        'index', 'example.Container.Nested', 'type', False)
+    assert alias_desc[1].astext() == 'Alias description.'
+    assert descs[1][0].astext() == 'type example.EmptyAlias'
+    assert descs[3][0].astext() == 'type Nested = Other'
+    assert alias_desc['objtype'] == 'type'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert 'type' in domain.directives
+    assert 'type' in domain.roles
+    assert len(list(doctree.findall(pending_xref))) == 5
+    assert domain.find_obj(app.env, None, None, 'example.Alias', 'type')
+    assert domain.find_obj(app.env, None, None, 'example.Alias', 'obj')
+
+
+def test_pytype_alias_index_text(app):
+    app.env.config.add_module_names = True
+    doctree = restructuredtext.parse(app, (".. py:module:: example\n"
+                                           ".. py:class:: Container\n"
+                                           "\n"
+                                           "   .. py:type:: Nested\n"
+                                           ".. py:type:: ModuleAlias\n"))
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Nested (type alias in example.Container)',
+            'example.Container.Nested', '', None) in entries
+    assert ('single', 'ModuleAlias (in module example)',
+            'example.ModuleAlias', '', None) in entries
+
+    app.env.ref_context.pop('py:module', None)
+    doctree = restructuredtext.parse(app, '.. py:type:: LocalAlias')
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'LocalAlias', 'LocalAlias', '', None) in entries
+
+
