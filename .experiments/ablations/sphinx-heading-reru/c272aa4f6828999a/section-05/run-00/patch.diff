diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..61c6739 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -54,6 +54,62 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_alias_signature_and_references(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Thing]\n"
+            "\n"
+            "See :py:type:`Alias` and :py:obj:`Alias`.")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    assert doctree[3][0].astext() == 'type example.Alias = list[Thing]'
+    annotation_refs = list(doctree[3][0].findall(pending_xref))
+    assert [ref['reftarget'] for ref in annotation_refs] == ['list', 'Thing']
+    assert [ref['reftype'] for ref in doctree.findall(pending_xref)][-2:] == [
+        'type', 'obj',
+    ]
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['list[Thing]'].objtype == 'type'
+    assert domain.objects['list[Thing]'].aliased
+    assert domain.find_obj(app.env, 'example', '', 'Alias', 'type')
+    assert domain.find_obj(app.env, 'example', '', 'Alias', 'obj')
+
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Alias (in module example)' in [entry[1] for entry in entries]
+
+
+def test_pytype_alias_nested_context_and_index(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: Thing\n"
+            "\n"
+            "      .. py:data:: member\n"
+            "\n"
+            "   .. py:type:: Bare")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    assert domain.objects['example.Container.Alias'].objtype == 'type'
+    assert domain.objects['example.Container.Bare'].objtype == 'type'
+    assert any(signature.astext() == 'type Bare'
+               for signature in doctree.findall(desc_signature))
+    assert 'example.Container.Alias.member' not in domain.objects
+    assert domain.objects['example.Container.member'].objtype == 'data'
+
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    alias_entries = [entry[1] for entry in entries if 'Alias' in entry[1]
+                     or 'Bare' in entry[1]]
+    assert alias_entries == [
+        'Container.Alias (in module example)',
+        'Container.Bare (in module example)',
+    ]
+
+
