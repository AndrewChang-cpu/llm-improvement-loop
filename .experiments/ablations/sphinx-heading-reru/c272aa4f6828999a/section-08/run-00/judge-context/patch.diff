+def test_type_alias(app):
+    text = (".. py:module:: package.module\n"
+            "\n"
+            ".. py:class:: Target\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            ".. py:type:: ExprAlias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Target\n"
+            "\n"
+            ".. py:type:: RefAlias\n"
+            "\n"
+            "   :py:type:`ExprAlias` and :py:obj:`Nested`\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert domain.objects['package.module.Alias'].objtype == 'type'
+    assert domain.objects['package.module.ExprAlias'].objtype == 'type'
+    assert domain.objects['package.module.ExprAlias'].aliased is False
+    assert domain.objects['list[Target]'].objtype == 'type'
+    assert domain.objects['list[Target]'].aliased is True
+    assert domain.objects['package.module.Container.Nested'].objtype == 'type'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' in domain.objtypes_for_role('obj')
+    assert domain.find_obj(app.env, 'package.module', '', 'ExprAlias', 'type')
+    assert domain.find_obj(app.env, 'package.module', '', 'ExprAlias', 'obj')
+
+    aliases = [node for node in doctree.findall(addnodes.desc)
+               if node['objtype'] == 'type']
+    assert [node[0][0].astext() for node in aliases[:3]] == ['type ', 'type ', 'type ']
+    expr_signature = aliases[1][0]
+    assert expr_signature.astext() == 'type package.module.ExprAlias = list[Target]'
+    assert any(node.get('reftype') == 'class' and node.get('reftarget') == 'Target'
+               for node in expr_signature.findall(pending_xref))
+    assert [node.get('reftype') for node in doctree.findall(pending_xref)
+            if node.get('reftarget') in {'ExprAlias', 'Nested'}] == ['type', 'obj']
+
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'Alias (in module package.module)', 'package.module.Alias', '', None) in entries
+    assert ('single', 'Nested (type alias in package.module.Container)',
+            'package.module.Container.Nested', '', None) in entries
+
+
+def test_type_alias_index_without_module_name(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: package.module\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'Nested (type alias in Container)',
+            'package.module.Container.Nested', '', None) in entries
+
+
+def test_type_alias_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: BareAlias\n")
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'BareAlias', 'BareAlias', '', None) in entries
+
+
