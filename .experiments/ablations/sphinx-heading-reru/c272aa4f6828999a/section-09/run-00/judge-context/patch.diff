 from __future__ import annotations
 
+import pytest
 from docutils import nodes
 
 from sphinx import addnodes
@@ -54,6 +55,68 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_alias_signature_and_canonical(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Thing]\n"
+            "\n"
+            "See :py:type:`Alias` and :py:obj:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    signode = next(node for node in doctree.findall(desc_signature)
+                   if node.get('fullname') == 'Alias')
+    assert signode.astext() == 'type example.Alias = list[Thing]'
+    assert [node.astext() for node in signode.findall(pending_xref)] == ['list', 'Thing']
+    refs = [node for node in doctree.findall(pending_xref) if node['reftarget'] == 'Alias']
+    assert [node['reftype'] for node in refs] == ['type', 'obj']
+    assert 'example.Alias' in domain.objects
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.objects['list[Thing]'] == ('index', 'example.Alias', 'type', True)
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.directives['type']
+    assert not domain.directives['type'].allow_nesting
+    assert domain.roles['type']
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in entries
+
+
+def test_pytype_alias_without_canonical_and_nested_index(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    signode = next(node for node in doctree.findall(desc_signature)
+                   if node.get('fullname') == 'Container.Alias')
+    assert signode.astext() == 'type Alias'
+    assert 'example.Container.Alias' in domain.objects
+    assert domain.objects['example.Container.Alias'] == (
+        'index', 'example.Container.Alias', 'type', False)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert ('single', 'Alias (type alias in example.Container)',
+            'example.Container.Alias', '', None) in entries
+
+
+@pytest.mark.sphinx('html', testroot='root', freshenv=True)
+def test_pytype_alias_references_resolve(app):
+    (app.srcdir / 'index.txt').write_text(
+        ".. py:module:: example\n"
+        ".. py:type:: Alias\n"
+        "\n"
+        "References: :py:type:`Alias` and :py:obj:`Alias`.\n",
+        encoding='utf8',
+    )
+    app.build(force_all=True)
+
+    html = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert html.count('href="#example.Alias"') >= 2
+
