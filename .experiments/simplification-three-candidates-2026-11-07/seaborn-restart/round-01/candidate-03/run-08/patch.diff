diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..5fef897
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,73 @@
+"""Statistics that transform observations to ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from pandas import DataFrame
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, inclusive, or a
+        list of percentile levels to compute.
+    method : str
+        Method used to compute the percentile, passed to :func:`numpy.percentile`.
+        Options are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "linear", "median_unbiased", "normal_unbiased", "lower",
+        "higher", "midpoint", and "nearest". Defaults to "linear".
+
+    Returns one row per requested percentile and group, with the computed value
+    and its level in the "percentile" column.
+
+    Examples
+    --------
+    Use the default quartiles, including the endpoints::
+
+        so.Plot(data, x="value").add(so.Dot(), so.Perc())
+
+    Choose a number of evenly spaced levels or pass specific levels::
+
+        so.Plot(data, x="value").add(so.Dot(), so.Perc(k=6))
+        so.Plot(data, x="value").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Combine the percentile transform with a range mark to show an interval::
+
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc(k=[5, 95]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        vals = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            values = np.percentile(vals, levels, interpolation=self.method)
+        else:
+            values = np.percentile(vals, levels, method=self.method)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var)
