diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..37fdd0b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,67 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+from seaborn.objects import Plot, Range
+
+
+class TestPerc:
+
+    def test_import(self):
+        assert PublicPerc is Perc
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0, 0], "y": [5, 1, 4, 2, 3]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 0, 0, 0],
+            "y": [1., 2., 3., 4., 5.],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_levels(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [10, 20, 30, 40]})
+        count = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        levels = Perc(k=[20, 80])(data, GroupBy(["x"]), "x", {})
+        assert count["percentile"].tolist() == [0, 50, 100]
+        assert levels["percentile"].tolist() == [20, 80]
+        assert levels["y"].tolist() == [16, 34]
+
+    def test_orientations_and_method(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [10, 20, 30, 40]})
+        vertical = Perc(k=[25, 75])(data, GroupBy(["x"]), "x", {})
+        horizontal_data = data.assign(y=10)
+        horizontal_data["x"] = [1, 2, 3, 4]
+        horizontal = Perc(k=[25, 75])(
+            horizontal_data, GroupBy(["y"]), "y", {},
+        )
+        lower = Perc(k=[50], method="lower")(data, GroupBy(["x"]), "x", {})
+        assert vertical["y"].tolist() == [17.5, 32.5]
+        assert horizontal["x"].tolist() == [1.75, 3.25]
+        assert lower["y"].tolist() == [20]
+
+    def test_group_order_and_missing_values(self):
+        data = pd.DataFrame({
+            "x": [0, 0, 0, 0], "y": [10, np.nan, 30, 40],
+            "group": ["b", "b", "a", "a"],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["x", "group"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 0, 0], "y": [10., 10., 30., 40.],
+            "group": ["b", "b", "a", "a"],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_plot_add(self):
+        plot = Plot(
+            pd.DataFrame({"group": ["a", "a", "a"], "value": [1, 2, 3]}),
+            x="group", y="value",
+        ).add(Range(), Perc(k=[0, 100]))
+        result = plot.plot()._layers[0]["data"].frame
+        assert result["y"].tolist() == [1, 3]
