diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..faa0d1f
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,69 @@
+"""Statistics that operate on ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, inclusive, or an
+        explicit list of percentile levels.
+    method : str
+        Method used to calculate the percentile, passed to
+        :func:`numpy.percentile`. The default is ``"linear"``. Valid choices
+        are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns one row per requested percentile for each group. The computed
+    observation is stored in the value variable, and the percentile level is
+    stored in a ``percentile`` column.
+
+    Examples
+    --------
+    Default quartiles and the endpoints::
+
+        so.Plot(data, x="x").add(so.Dot(), so.Perc())
+        so.Plot(data, x="x").add(so.Dot(), so.Perc(k=2))
+
+    Choose an integer count or explicit levels::
+
+        so.Plot(data, x="x").add(so.Dot(), so.Perc(k=5))
+        so.Plot(data, x="x").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Combine percentile rows with a range mark to draw an interval::
+
+        so.Plot(data, x="x").add(so.Range(), so.Perc(k=[5, 95]))
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def __call__(self, data, groupby, orient, scales):
+        value = "y" if orient == "x" else "x"
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(part):
+            values = part[value].dropna()
+            if np.lib.NumpyVersion(np.__version__) < "1.22.0":
+                result = np.percentile(values, percentiles, interpolation=self.method)
+            else:
+                result = np.percentile(values, percentiles, method=self.method)
+            return pd.DataFrame({value: result, "percentile": percentiles})
+
+        return groupby.apply(data, percentile)
