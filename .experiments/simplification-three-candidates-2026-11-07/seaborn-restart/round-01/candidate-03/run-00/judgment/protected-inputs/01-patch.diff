diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..8ce8d48
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,34 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+
+
+class TestPerc:
+
+    def test_count_and_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["unused"]), "y", {})
+        assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert result["x"].tolist() == [1, 1.75, 2.5, 3.25, 4]
+
+        result = Perc(k=3)(data, GroupBy(["unused"]), "y", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels_grouping_and_missing(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "y": [1., np.nan, 3., 5.],
+            "unused": [1, 2, 3, 4],
+        })
+        result = Perc(k=[0, 50, 100])(data, GroupBy({"group": ["b", "a"]}), "x", {})
+        assert result.columns.tolist() == ["group", "y", "percentile"]
+        assert result["group"].tolist() == ["b"] * 3 + ["a"] * 3
+        assert result["y"].tolist() == [1, 2, 3, 5, 5, 5]
+
+    def test_method_and_public_import(self):
+        data = pd.DataFrame({"x": [0, 10, 20]})
+        result = PublicPerc(k=[25], method="lower")(data, GroupBy(["unused"]), "y", {})
+        assert result["x"].tolist() == [0]
