diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..50a112d
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,48 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3], "y": [1, 2, 3, 4]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 0, 1, 1, 1, 2, 2, 2, 3, 3, 3],
+            "y": [1., 1., 1., 2., 2., 2., 3., 3., 3., 4., 4., 4.],
+            "percentile": [0., 50., 100.] * 4,
+        })
+        # x groups each have a single observation, so each requested level
+        # maps to that observation.
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels_and_missing(self):
+        data = pd.DataFrame({"group": ["b", "a", "a", "b"], "y": [1, 2, np.nan, 9]})
+        res = Perc(k=[25, 75])(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["b", "b", "a", "a"],
+            "y": [3., 7., 2., 2.],
+            "percentile": [25, 75, 25, 75],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_method_orientation_and_exports(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        data = pd.DataFrame({"x": [0, 10], "y": [2, 4]})
+        res = Perc(k=[50], method="lower")(data, GroupBy(["y"]), "y", {})
+        assert res.columns.tolist() == ["x", "y", "percentile"]
+        assert res.loc[0, "x"] == 0
+
+    def test_plot_add(self):
+        import seaborn.objects as so
+
+        plot = so.Plot(pd.DataFrame({"value": [1, 2, 3, 4]}), y="value")
+        plot.add(so.Dots(), so.Perc(k=[0, 100]))
+        plot.plot()
