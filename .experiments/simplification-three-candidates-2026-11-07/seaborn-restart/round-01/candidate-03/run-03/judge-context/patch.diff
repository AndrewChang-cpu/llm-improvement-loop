diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..85da5d3
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,73 @@
+"""Ordering-related statistical transformations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels.
+    method : str
+        Method used by :func:`numpy.percentile`; defaults to ``"linear"``.
+        Valid choices are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile and group, with the computed value
+        and a ``percentile`` column containing its level.
+
+    Examples
+    --------
+    Use the default quartiles, or include the endpoints explicitly::
+
+        so.Plot(data, y="value").add(so.Dots(), so.Perc())
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(k=[0, 100]))
+
+    Choose a number of evenly spaced levels or specify levels directly::
+
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(k=5))
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(k=[10, 50, 90]))
+
+    Combine ``Perc`` with a range mark to show an interval::
+
+        so.Plot(data, y="value").add(so.Range(), so.Perc(k=[10, 90]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kws = {"interpolation": self.method}
+        if np.lib.NumpyVersion(np.__version__) >= "1.22.0":
+            kws = {"method": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
