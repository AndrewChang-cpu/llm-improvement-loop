diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..9801120
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,46 @@
+"""Statistics that transform observations into ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles of the value variable.
+
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        levels = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer))
+            else self.k
+        )
+        kw = "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        kws = {kw: self.method}
+        percentiles = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
