diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..e8b660c
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,39 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count_and_values(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["group"]), "y", {})
+        assert_array_equal(result.columns, ["x", "percentile"])
+        assert_array_equal(result["x"], [0, 1, 2, 3, 4])
+        assert_array_equal(result["percentile"], [0, 25, 50, 75, 100])
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 10]})
+        result = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["group"]), "y", {},
+        )
+        assert_array_equal(result["x"], [0, 10])
+        assert_array_equal(result["percentile"], [25, 75])
+
+    def test_grouping_order_and_missing(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [4, 1, np.nan, 3]})
+        result = Perc(k=2)(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(result.columns, ["group", "y", "percentile"])
+        assert_array_equal(result["group"], ["b", "b", "a", "a"])
+        assert_array_equal(result["y"], [4, 4, 1, 3])
+
+    def test_public_import_and_plot_add(self):
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": [0, 1, 2, 3], "y": [1, 2, 3, 4]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=2))
+        plot.plot()
