diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a985668
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,61 @@
+"""Statistics that order or summarize observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, inclusive, or the
+        percentile levels to compute directly. Defaults to 5 (quartiles and
+        endpoints).
+    method : str
+        Method used to compute the percentiles, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Valid choices are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    An integer ``k`` requests ``k`` equally spaced levels from 0 through 100;
+    the default therefore computes the minimum, quartiles, and maximum. A
+    value of 2 requests just the endpoints. A list supplies levels directly.
+    Returns one row per requested percentile and group, with the level in a
+    ``percentile`` column. For example::
+
+        import seaborn.objects as so
+
+        so.Plot(data, x="x").add(so.Range(), so.Perc())
+        so.Plot(data, x="x").add(so.Range(), so.Perc(k=2))
+        so.Plot(data, x="x").add(so.Range(), so.Perc(k=[10, 50, 90]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def __call__(self, data, groupby, orient, scales):
+
+        value = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        percentile_kws = {"method": self.method}
+        if np.lib.NumpyVersion(np.__version__) < "1.22.0":
+            percentile_kws = {"interpolation": self.method}
+
+        def percentile(data):
+            values = np.percentile(data[value].dropna(), levels, **percentile_kws)
+            return pd.DataFrame({value: values, "percentile": levels})
+
+        return groupby.apply(data, percentile)
