diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..28fffe1
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,83 @@
+"""Statistics that compute order statistics of the data."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels to compute.
+    method : str
+        Percentile method passed to :func:`numpy.percentile`. Defaults to
+        ``"linear"``. Valid choices are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested level and group, with the percentile value and
+        its level in the ``percentile`` column.
+
+    Examples
+    --------
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+        # The default requests endpoints and quartiles (0, 25, 50, 75, 100).
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+        # An integer requests that many evenly spaced levels, including endpoints.
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=2))
+        # A list requests levels directly.
+        so.Plot(data, x="x", y="y").add(
+            so.Dot(), so.Perc(k=[10, 50, 90])
+        )
+        # Two percentile rows can define the endpoints of a range mark.
+        so.Plot(data, x="x", y="y").add(
+            so.Range(), so.Perc(k=[10, 90])
+        )
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data, var):
+        values = data[var].dropna()
+        if isinstance(self.k, int):
+            q = np.linspace(0, 100, self.k)
+        else:
+            q = self.k
+
+        if values.empty:
+            return pd.DataFrame({var: [], "percentile": []})
+
+        kwargs = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        result = np.percentile(values, q, **kwargs)
+        return pd.DataFrame({var: result, "percentile": q})
+
+    def __call__(
+        self, data: pd.DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
