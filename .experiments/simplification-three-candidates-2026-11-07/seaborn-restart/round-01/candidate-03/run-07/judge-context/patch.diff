diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..64c2137
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,41 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count_and_levels(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3]})
+        groupby = GroupBy(["x"])
+
+        res = Perc()(data, groupby, "x", {})
+        expected = pd.DataFrame({
+            "x": [0] * 5, "y": [1, 1.5, 2, 2.5, 3],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+        res = Perc(k=[10, 90])(data, groupby, "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0], "y": [1.2, 2.8], "percentile": [10, 90],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_orientation_method_and_missing(self):
+        data = pd.DataFrame({"x": [1, 2, np.nan, 9], "y": [1, 1, 1, 2]})
+        res = Perc(k=[50], method="lower")(data, GroupBy(["y"]), "y", {})
+        expected = pd.DataFrame({"x": [1., 9.], "y": [1, 2], "percentile": [50, 50]})
+        assert_frame_equal(res, expected)
+
+    def test_group_order(self):
+        data = pd.DataFrame({"x": [2, 1, 2, 1], "y": [20, 10, 22, 12], "g": ["b", "a", "a", "b"]})
+        res = Perc(k=[0, 100])(data, GroupBy(["g", "x"]), "x", {})
+        assert list(res.columns) == ["x", "y", "g", "percentile"]
+        assert list(zip(res.g, res.x, res.percentile)) == [
+            ("b", 1, 0), ("b", 1, 100), ("b", 2, 0), ("b", 2, 100),
+            ("a", 1, 0), ("a", 1, 100), ("a", 2, 0), ("a", 2, 100),
+        ]
