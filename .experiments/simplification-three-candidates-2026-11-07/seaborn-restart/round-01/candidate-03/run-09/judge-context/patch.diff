diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..4455cea
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,93 @@
+"""Statistics that operate on ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values for each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, or explicit
+        percentile levels to compute. The default requests quartiles.
+    method : str
+        Method used to calculate the percentile. This is passed to
+        :func:`numpy.percentile` and defaults to ``"linear"``. Valid choices
+        are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    The output has one row per requested percentile and group, with the
+    computed value and its level in a ``percentile`` column.
+
+    Examples
+    --------
+    Import the public objects namespace:
+
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+    Use the default quartiles or include the endpoints:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc())
+        so.Plot(data, x="group", y="value").add(
+            so.Dot(), so.Perc(k=[0, 25, 50, 75, 100])
+        )
+
+    Request an integer number of levels or choose explicit levels:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc(k=7))
+        so.Plot(data, x="group", y="value").add(
+            so.Dot(), so.Perc(k=[10, 90])
+        )
+
+    Use the two percentile rows to draw an interval with a range mark:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[25, 75])
+        )
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+
+        if Version(np.__version__) < Version("1.22.0"):
+            percentile = np.percentile(values, levels, interpolation=self.method)
+        else:
+            percentile = np.percentile(values, levels, method=self.method)
+
+        return pd.DataFrame({var: percentile, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
