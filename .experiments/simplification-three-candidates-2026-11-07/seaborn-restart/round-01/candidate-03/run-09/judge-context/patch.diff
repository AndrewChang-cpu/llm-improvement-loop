diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..6adbd73
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,67 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "y": [1, 3, 5, 7, 9]})
+        groupby = GroupBy(["group"])
+
+        default = Perc()(data, groupby, "x", {})
+        counted = Perc(k=3)(data, groupby, "x", {})
+
+        assert default["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert counted["percentile"].tolist() == [0, 50, 100]
+        assert counted["y"].tolist() == [1, 5, 9]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 8, 9]})
+
+        res = Perc(k=[25, 75], method="lower")(data, GroupBy(["group"]), "x", {})
+
+        assert res["percentile"].tolist() == [25, 75]
+        assert res["y"].tolist() == [1, 8]
+
+    def test_orientation_and_missing(self):
+        data = pd.DataFrame({
+            "x": [10, np.nan, 30], "y": [1, 2, 3], "group": ["a"] * 3,
+        })
+
+        vertical = Perc(k=[0, 100])(data, GroupBy(["group"]), "x", {})
+        horizontal = Perc(k=[0, 100])(data, GroupBy(["group"]), "y", {})
+
+        assert vertical["y"].tolist() == [1, 3]
+        assert horizontal["x"].tolist() == [10, 30]
+        assert horizontal.columns.tolist() == ["x", "group", "percentile"]
+
+    def test_group_order_and_columns(self):
+        data = pd.DataFrame({
+            "x": [1, 3, 2, 4],
+            "y": [10, 30, 20, 40],
+            "group": pd.Categorical(["a", "a", "b", "b"], categories=["b", "a"]),
+            "unused": [0, 0, 0, 0],
+        })
+
+        res = Perc(k=[0, 100])(data, GroupBy(["group"]), "x", {})
+
+        expected = pd.DataFrame({
+            "y": [20., 40., 10., 30.],
+            "group": ["b", "b", "a", "a"],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_imports_and_plot_add(self):
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+        data = pd.DataFrame({"group": ["a", "a", "a", "a"], "value": [1, 2, 3, 4]})
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[25, 75])
+        ).plot()
