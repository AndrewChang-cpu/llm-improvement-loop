diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..b8dea66
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,74 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count_and_default(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [0, 10, 20, 30]})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+
+        expected = pd.DataFrame({
+            "group": ["b"] * 5 + ["a"] * 5,
+            "y": [0., 5., 10., 15., 20., 10., 15., 20., 25., 30.],
+            "percentile": [0., 25., 50., 75., 100.] * 2,
+        })
+        assert_frame_equal(result, expected)
+
+        result = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100] * 2
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [0, 10, 20, 30]})
+        result = Perc(k=[10, 50, 90], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        assert result["percentile"].tolist() == [10, 50, 90]
+        assert result["y"].tolist() == np.percentile(data.y, [10, 50, 90], method="nearest").tolist()
+
+    @pytest.mark.parametrize(
+        "orient,var", [("x", "y"), ("y", "x")]
+    )
+    def test_orientation_and_missing_data(self, orient, var):
+        data = pd.DataFrame({
+            "group": ["a", "a", "a"],
+            "x": [1, 3, 999],
+            "y": [2, 4, np.nan],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["group"]), orient, {})
+
+        assert result.columns.tolist() == ["group", var, "percentile"]
+        assert result[var].tolist() == ([2, 4] if var == "y" else [1, 999])
+
+    def test_group_order_and_columns(self):
+        data = pd.DataFrame({
+            "group": pd.Categorical(["b", "a", "b", "a"], ["a", "b"]),
+            "y": [1, 10, 3, 30],
+            "unused": [0, 0, 0, 0],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["group"]), "x", {})
+
+        expected = pd.DataFrame({
+            "group": ["a", "a", "b", "b"],
+            "y": [10., 30., 1., 3.],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+
+def test_public_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    so.Plot(x=["a", "a", "b", "b"], y=[1, 2, 3, 4]).add(
+        so.Dots(), so.Perc(k=[25, 75])
+    ).plot()
+    so.Plot(x=["a", "a", "b", "b"], y=[1, 2, 3, 4]).add(
+        so.Range(), so.Perc(k=[25, 75])
+    ).plot()
