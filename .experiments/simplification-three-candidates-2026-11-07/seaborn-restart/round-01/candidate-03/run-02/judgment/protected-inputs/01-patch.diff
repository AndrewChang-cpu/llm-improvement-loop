diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..d7b640e
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,72 @@
+"""Statistical transforms that change the ordering of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn.external.version import Version
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5, giving the
+        endpoints and quartiles.
+    method : str
+        Percentile method passed to :func:`numpy.percentile`. Defaults to
+        ``"linear"``. Valid choices are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns one row per requested percentile and group, with the computed value
+    and its level in the ``percentile`` column.
+
+    Examples
+    --------
+    Default quartiles and endpoints, and a count of seven levels::
+
+        so.Plot(data, x="category", y="value").add(so.Dot(), so.Perc())
+        so.Plot(data, x="category", y="value").add(so.Dot(), so.Perc(k=7))
+
+    Explicit levels and an interval formed with a range mark::
+
+        so.Plot(data, x="category", y="value").add(
+            so.Dot(), so.Perc(k=[10, 50, 90])
+        )
+        so.Plot(data, x="category", y="value").add(
+            so.Range(), so.Perc(k=[25, 75])
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+        else:
+            percentiles = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
