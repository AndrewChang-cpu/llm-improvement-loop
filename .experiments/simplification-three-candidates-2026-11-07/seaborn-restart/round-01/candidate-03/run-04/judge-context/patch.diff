diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a68d6c6
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,65 @@
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels.
+    method : str
+        Method used to compute the percentiles. One of "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher", "midpoint",
+        or "nearest". Defaults to "linear".
+
+    The output has one row per requested percentile and group, with the value
+    column replaced by its percentile value and a ``percentile`` column giving
+    the requested level.
+
+    Examples
+    --------
+    Use the public ``so`` namespace to request quartiles (the default) and
+    endpoints:
+
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+        so.Plot(data, x="value").add(so.Dot(), so.Perc())
+        so.Plot(data, x="value").add(so.Dot(), so.Perc(k=2))
+        so.Plot(data, x="value").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+        so.Plot(data, x="value").add(so.Range(), so.Perc())
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        keyword = "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        result = np.percentile(values, levels, **{keyword: self.method})
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
