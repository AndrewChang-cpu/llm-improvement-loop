diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..38d5fb7
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+
+
+class TestPerc:
+
+    def test_public_import(self):
+        assert PublicPerc is Perc
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"x": [0] * 5, "y": [1, 2, 3, 4, 5]})
+        groupby = GroupBy(["x"])
+
+        out = Perc()(data, groupby, "x", {})
+        expected = pd.DataFrame({
+            "x": [0] * 5,
+            "y": [1., 2., 3., 4., 5.],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(out, expected)
+
+        out = Perc(3)(data, groupby, "x", {})
+        assert out["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 10]})
+        out = Perc([25, 50, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {},
+        )
+        assert out["percentile"].tolist() == [25, 50, 75]
+        assert out["y"].tolist() == [1, 2, 10]
+
+    def test_grouping_order_and_missing_values(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a", "b", "a"],
+            "x": [1, 2, 3, 4, 5, 6],
+            "y": [1, 10, np.nan, 30, 5, 50],
+            "unused": list("abcdef"),
+        })
+        out = Perc([0, 100])(
+            data, GroupBy(["group"]), "x", {},
+        )
+        assert out["group"].tolist() == ["b", "b", "a", "a"]
+        assert out["y"].tolist() == [1, 5, 10, 50]
+        assert out.columns.tolist() == ["group", "y", "percentile"]
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [0, 0, 0]})
+        out = Perc([0, 100])(data, GroupBy(["y"]), "y", {})
+        assert out["x"].tolist() == [1, 3]
+        assert out["percentile"].tolist() == [0, 100]
+
+    def test_plot_add(self):
+        import seaborn.objects as so
+
+        data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 3, 4]})
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc([25, 75])).plot()
