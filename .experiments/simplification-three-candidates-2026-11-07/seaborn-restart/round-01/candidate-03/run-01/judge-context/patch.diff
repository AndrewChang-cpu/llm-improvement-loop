diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..5b11d74
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,86 @@
+"""Statistical transformations that order observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of percentile levels to compute. Defaults to 5, which
+        produces the minimum, quartiles, and maximum.
+    method : str
+        Method used to compute the percentile, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Valid choices are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile per group, with the computed value
+        and its level in the ``percentile`` column.
+
+    Examples
+    --------
+    Use the public :mod:`seaborn.objects` namespace to compute quartiles and
+    endpoints by default:
+
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc())
+
+    Request three evenly spaced levels, or provide specific levels directly:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc(3))
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc([10, 50, 90]))
+
+    Combine percentile rows with a range mark to draw an interval:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc([25, 75]))
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        kws = {"method": self.method}
+        if Version(np.__version__) < Version("1.22.0"):
+            kws = {"interpolation": self.method}
+        percentiles = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var)
