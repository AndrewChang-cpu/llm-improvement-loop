diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a0fad06
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,69 @@
+"""Statistical transformations that order or select data values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Compute percentiles for the value variable within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or a list of percentile levels to compute. Defaults to 5 (quartiles).
+    method : str
+        Method used to compute the percentile. One of "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher", "midpoint",
+        or "nearest". See :func:`numpy.percentile`.
+
+    Returns one row per requested percentile level, with the computed value in
+    the value column and the requested level in a ``percentile`` column.
+
+    Examples
+    --------
+    Compute the default quartiles and endpoints, or choose a number or list of
+    percentile levels explicitly::
+
+        p = so.Plot(data, x="x", y="y")
+        p.add(so.Dot(), so.Perc())
+        p.add(so.Dot(), so.Perc(k=3))
+        p.add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Combine ``Perc`` with a range mark to draw an interval::
+
+        p.add(so.Range(), so.Perc(k=[2.5, 97.5]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = (
+            {"interpolation": self.method}
+            if Version(np.__version__) < Version("1.22.0")
+            else {"method": self.method}
+        )
+        percentiles = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var).reset_index(drop=True)
