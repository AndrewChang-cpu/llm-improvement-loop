diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..76b85a9
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,77 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class OrderFixtures:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": [2, 1, 2, 1], "y": [20, 10, 22, 12], "g": ["b", "a", "b", "a"],
+        })
+
+    def get_groupby(self, df, orient, order=None):
+        other = {"x": "y", "y": "x"}[orient]
+        return GroupBy(order or [c for c in df if c != other])
+
+
+class TestPerc(OrderFixtures):
+
+    def test_integer_levels(self):
+        df = pd.DataFrame({"x": [1, 2, 3, 4]})
+        res = Perc(k=3)(df, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({"x": [1, 2.5, 4], "percentile": [0., 50., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels(self):
+        df = pd.DataFrame({"x": [1, 2, 3, 4]})
+        res = Perc(k=[25, 75])(df, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({"x": [1.75, 3.25], "percentile": [25, 75]})
+        assert_frame_equal(res, expected)
+
+    def test_value_variable_and_orientations(self):
+        df = pd.DataFrame({"x": [1, 2, 3], "y": [4, 5, 6]})
+        vertical = Perc(k=[50])(df, GroupBy(["group"]), "x", {})
+        horizontal = Perc(k=[50])(df, GroupBy(["group"]), "y", {})
+        assert vertical["y"].tolist() == [5]
+        assert horizontal["x"].tolist() == [2]
+
+    def test_method(self):
+        df = pd.DataFrame({"x": [0, 10]})
+        res = Perc(k=[25], method="nearest")(df, GroupBy(["group"]), "y", {})
+        assert res["x"].tolist() == [0]
+
+    def test_grouping_and_order(self, df):
+        res = Perc(k=[50])(
+            df, self.get_groupby(df, "x", {"x": [2, 1], "g": ["b", "a"]}), "x", {}
+        )
+        expected = pd.DataFrame({
+            "x": [2, 1], "y": [21., 11.], "g": ["b", "a"], "percentile": [50, 50],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_missing_observations(self):
+        df = pd.DataFrame({"x": [1., np.nan, 3.]})
+        res = Perc(k=[0, 50, 100])(df, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({"x": [1., 2., 3.], "percentile": [0, 50, 100]})
+        assert_frame_equal(res, expected)
+
+    def test_import_paths(self):
+        from seaborn.objects import Perc as ObjectsPerc
+        assert ObjectsPerc is Perc
+
+    def test_plot_add(self):
+        from seaborn.objects import Plot, Perc as ObjectsPerc, Range
+        p = Plot(x=[1, 1, 1, 1], y=[1, 2, 3, 4]).add(
+            Range(), ObjectsPerc(k=[25, 75])
+        )
+        plotter = p.plot()
+        data = plotter._layers[0]["data"].frame
+        assert data["y"].tolist() == [1.75, 3.25]
+        assert data["percentile"].tolist() == [25, 75]
