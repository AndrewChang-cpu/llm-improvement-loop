diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..be55151
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,76 @@
+"""Statistics that transform values based on their order."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with their percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of percentile levels to compute. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile`. Valid choices are
+        "inverted_cdf", "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest". Defaults to "linear".
+
+    Returns one row per requested level and group, with the computed value
+    and its level in the ``percentile`` column.
+
+    Examples
+    --------
+    Examples use a dataframe ``df`` with ``group`` and ``value`` columns.
+    The default includes the endpoints and quartiles; an integer count and
+    explicit levels can also be requested. Use a range mark to show an interval:
+
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+        # Default endpoints and quartiles
+        so.Plot(df, x="group", y="value").add(so.Range(), so.Perc())
+        # Three evenly spaced levels
+        so.Plot(df, x="group", y="value").add(so.Range(), so.Perc(3))
+        # Explicit levels
+        so.Plot(df, x="group", y="value").add(so.Range(), so.Perc([10, 90]))
+        # Use the 5th and 95th percentiles for an interval
+        so.Plot(df, x="group", y="value").add(so.Range(), so.Perc([5, 95]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        q = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(part: DataFrame) -> DataFrame:
+            values = part[var].dropna().to_numpy()
+            if not len(values):
+                return pd.DataFrame({var: np.nan, "percentile": q})
+            if Version(np.__version__) < Version("1.22.0"):
+                result = np.percentile(values, q, interpolation=self.method)
+            else:
+                result = np.percentile(values, q, method=self.method)
+            return pd.DataFrame({var: result, "percentile": q})
+
+        return groupby.apply(data, percentile).reset_index(drop=True)
