diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a520d2e
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,71 @@
+import numpy as np
+import pandas as pd
+
+import seaborn.objects as so
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class PercFixtures:
+
+    def get_data(self):
+        return pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 2, 8]})
+
+    def get_groupby(self, *variables):
+        return GroupBy(list(variables))
+
+
+class TestPerc(PercFixtures):
+
+    def test_integer_levels(self):
+        data = self.get_data()
+        result = Perc(3)(data, self.get_groupby("x"), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 0, 1, 1, 1],
+            "y": [1., 2., 3., 2., 5., 8.],
+            "percentile": [0., 50., 100.] * 2,
+        })
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels_and_default(self):
+        data = self.get_data().iloc[:2]
+        result = Perc([25, 75])(data, self.get_groupby("x"), "x", {})
+        assert result["percentile"].tolist() == [25, 75]
+        assert result["y"].tolist() == [1.5, 2.5]
+        assert Perc().k == 5
+
+    def test_value_variable_for_horizontal_orientation(self):
+        data = pd.DataFrame({"x": [1, 3, 2, 8], "y": [0, 0, 1, 1]})
+        result = Perc([0, 100])(data, self.get_groupby("y"), "y", {})
+        assert result["x"].tolist() == [1, 3, 2, 8]
+        assert result["y"].tolist() == [0, 0, 1, 1]
+        assert result["percentile"].tolist() == [0, 100, 0, 100]
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 10]})
+        result = Perc([50], method="lower")(data, self.get_groupby("x"), "x", {})
+        assert result["y"].tolist() == [2]
+
+    def test_grouping_and_order(self):
+        data = pd.DataFrame({
+            "x": [2, 1, 2, 1], "y": [20, 10, 22, 12], "group": ["b", "a", "b", "a"]
+        })
+        result = Perc([50])(data, GroupBy({"x": [1, 2], "group": ["a", "b"]}), "x", {})
+        assert result[["x", "group"]].values.tolist() == [[1, "a"], [2, "b"]]
+        assert result["y"].tolist() == [11, 21]
+
+    def test_missing_values_are_ignored(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, np.nan, 5]})
+        result = Perc([0, 50, 100])(data, self.get_groupby("x"), "x", {})
+        assert result["y"].tolist() == [1, 3, 5]
+
+    def test_import_paths(self):
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        data = self.get_data()
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc([0, 100])).plot()
