diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..e7a06d8
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,73 @@
+import numpy as np
+import pandas as pd
+
+import pytest
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class PercFixtures:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": [1, 1, 2, 2, 3, 3],
+            "y": [1, 3, 2, 4, 3, 5],
+            "group": ["b", "b", "a", "a", "b", "b"],
+        })
+
+
+class TestPerc(PercFixtures):
+
+    def test_integer_levels(self, df):
+        res = Perc(k=3)(df, GroupBy(["group"]), "x", {})
+        assert res["percentile"].tolist() == [0, 50, 100, 0, 50, 100]
+        assert res["group"].tolist() == ["b"] * 3 + ["a"] * 3
+
+    def test_explicit_levels(self, df):
+        res = Perc(k=[25, 75])(df, GroupBy(["group"]), "x", {})
+        assert res["percentile"].tolist() == [25, 75, 25, 75]
+
+    def test_values(self, df):
+        res = Perc(k=3)(df, GroupBy(["group"]), "x", {})
+        expected = np.array([1, 3, 5, 2, 3, 4])
+        np.testing.assert_allclose(res["y"], expected)
+
+    @pytest.mark.parametrize(
+        "orient,value_var,group_var",
+        [("x", "y", "x"), ("y", "x", "y")],
+    )
+    def test_orientation(self, df, orient, value_var, group_var):
+        groupby = GroupBy([group_var])
+        res = Perc(k=[50])(df, groupby, orient, {})
+        assert value_var in res
+        assert "percentile" in res
+
+    def test_method(self):
+        df = pd.DataFrame({"x": [1, 2, 3, 4], "y": [1, 2, 3, 4], "group": ["a"] * 4})
+        res = Perc(k=[50], method="lower")(df, GroupBy(["group"]), "x", {})
+        assert res["y"].tolist() == [2]
+
+    def test_group_order(self):
+        df = pd.DataFrame({"x": [1, 1, 2, 2], "y": [1, 3, 2, 4]})
+        res = Perc(k=[50])(df, GroupBy({"x": [2, 1]}), "x", {})
+        assert res["x"].tolist() == [2, 1]
+        assert res["y"].tolist() == [3, 2]
+
+    def test_missing_values(self):
+        df = pd.DataFrame({"x": [1, 2, 3], "y": [1, np.nan, 5], "group": ["a"] * 3})
+        res = Perc(k=[50])(df, GroupBy(["group"]), "x", {})
+        assert res["y"].tolist() == [3]
+
+    def test_public_imports(self):
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        from seaborn.objects import Dots, Plot
+
+        Plot(x=["a", "a", "b", "b"], y=[1, 3, 2, 4]).add(
+            Dots(), Perc(k=[25, 75])
+        ).plot()
+
