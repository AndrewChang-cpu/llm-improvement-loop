diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..9a84c4a
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,54 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class PercFixtures:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, 20, 30, 40]})
+
+class TestPerc(PercFixtures):
+
+    def test_integer_levels(self, df):
+        res = Perc(k=3)(df, GroupBy(["missing"]), "x", {})
+        assert res["percentile"].tolist() == [0, 50, 100]
+        assert res["y"].tolist() == [10, 25, 40]
+
+    def test_explicit_levels(self, df):
+        res = Perc(k=[25, 75])(df, GroupBy(["missing"]), "x", {})
+        assert res["percentile"].tolist() == [25, 75]
+        assert res["y"].tolist() == [17.5, 32.5]
+
+    def test_orientation(self, df):
+        df = pd.DataFrame({"x": [1, 1, 2, 2], "y": [10, 20, 10, 20]})
+        horizontal = Perc(k=[50])(df, GroupBy(["y"]), "y", {})
+        vertical = Perc(k=[50])(df, GroupBy(["x"]), "x", {})
+        assert horizontal["x"].tolist() == [1.5, 1.5]
+        assert vertical["y"].tolist() == [15, 15]
+
+    def test_method_and_missing(self):
+        df = pd.DataFrame({"x": [0, 1, 2, 3], "y": [1, np.nan, 3, 4]})
+        res = Perc(k=[50], method="lower")(df, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [1, 3, 4]
+        assert res["percentile"].tolist() == [50, 50, 50]
+
+    def test_grouping_order(self):
+        df = pd.DataFrame({"x": [2, 1, 2, 1], "y": [20, 10, 40, 30], "g": ["b", "a", "b", "a"]})
+        res = Perc(k=[50])(df, GroupBy({"g": ["b", "a"]}), "y", {})
+        assert res[["g", "x", "percentile"]].values.tolist() == [
+            ["b", 2, 50], ["a", 1, 50]
+        ]
+
+    def test_imports(self):
+        from seaborn.objects import Perc as PublicPerc
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        from seaborn.objects import Dot, Plot
+        p = Plot(x=[1, 2, 3], y=[2, 4, 8]).add(Dot(), Perc(k=3))
+        p.plot()
