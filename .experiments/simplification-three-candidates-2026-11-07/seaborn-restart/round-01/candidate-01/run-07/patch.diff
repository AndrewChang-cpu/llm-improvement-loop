diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..24d4e1e
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,90 @@
+"""Statistics that compute order-based values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Compute percentile values along the value axis.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced levels from 0 through 100, or explicit
+        percentile levels. Defaults to 5.
+    method : str
+        NumPy percentile method. Defaults to "linear". Valid choices are
+        "inverted_cdf", "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    Notes
+    -----
+    The output has one row per requested level, with the computed value in the
+    value column and the level in `percentile`.
+
+    Examples
+    --------
+    Default quartiles and endpoints:
+
+    .. code:: python
+
+        p = (so.Plot(tips, x="total_bill", y="day")
+             .add(so.Dot(), so.Perc()))
+
+    Request three evenly spaced levels:
+
+    .. code:: python
+
+        p = (so.Plot(tips, x="total_bill", y="day")
+             .add(so.Dot(), so.Perc(k=3)))
+
+    Request explicit levels:
+
+    .. code:: python
+
+        p = (so.Plot(tips, x="total_bill", y="day")
+             .add(so.Dot(), so.Perc(k=[10, 50, 90])))
+
+    Combine percentile rows with a range mark:
+
+    .. code:: python
+
+        p = (so.Plot(tips, x="day", y="total_bill")
+             .add(so.Range(), so.Perc(k=[25, 75])))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        if values.empty:
+            return pd.DataFrame({var: [], "percentile": []})
+        arg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kw = {arg: self.method}
+        return pd.DataFrame({
+            var: np.percentile(values, levels, **kw),
+            "percentile": levels,
+        })
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
