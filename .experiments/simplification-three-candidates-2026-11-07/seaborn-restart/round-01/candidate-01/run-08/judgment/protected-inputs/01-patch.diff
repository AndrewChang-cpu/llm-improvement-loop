diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..860d5cf
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,77 @@
+"""Statistical transformations that change the order or position of data."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels. Defaults to 5.
+    method : str
+        NumPy percentile method. One of "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen", "weibull",
+        "linear", "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", or "nearest". Defaults to "linear".
+
+    Returns one row for each requested percentile level and group, with the
+    computed value and the level in a `percentile` column.
+
+    Examples
+    --------
+    The default returns the endpoints and quartiles (0, 25, 50, 75, and 100)::
+
+        import pandas as pd
+        from seaborn.objects import Dots, Perc, Plot, Range
+
+        data = pd.DataFrame({"group": ["a", "a", "b", "b"], "value": [1, 2, 3, 4]})
+
+        p = Plot(data, x="group", y="value").add(Dots(), Perc())
+
+    An integer requests that many evenly spaced levels, while a list specifies
+    levels directly::
+
+        p = Plot(data, x="group", y="value").add(Dots(), Perc(k=3))
+        p = Plot(data, x="group", y="value").add(Dots(), Perc(k=[10, 50, 90]))
+
+    Percentile rows can be combined with a range mark to draw an interval::
+
+        p = Plot(data, x="group", y="value").add(Range(), Perc(k=[25, 75]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna().to_numpy()
+        percentile_kw = (
+            {"method": self.method}
+            if Version(np.__version__) >= Version("1.22.0")
+            else {"interpolation": self.method}
+        )
+        result = np.percentile(values, levels, **percentile_kw)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
