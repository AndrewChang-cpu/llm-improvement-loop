diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..df46c2d
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,78 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class OrderFixtures:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": ["b", "b", "a", "a"],
+            "y": [1, 3, 10, 20],
+            "group": ["u", "u", "v", "v"],
+        })
+
+    def get_groupby(self, df, orient):
+        value = {"x": "y", "y": "x"}[orient]
+        return GroupBy([col for col in df if col != value])
+
+
+class TestPerc(OrderFixtures):
+
+    def test_integer_levels_and_values(self):
+        df = pd.DataFrame({"y": [0, 10], "group": ["a", "a"]})
+        out = Perc(k=3)(df, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [0, 50, 100]
+        assert out["y"].tolist() == [0, 5, 10]
+
+    def test_explicit_levels(self):
+        df = pd.DataFrame({"y": [0, 10], "group": ["a", "a"]})
+        out = Perc(k=[25, 75])(df, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [25, 75]
+        assert out["y"].tolist() == [2.5, 7.5]
+
+    def test_default_levels(self):
+        df = pd.DataFrame({"y": [0, 10], "group": ["a", "a"]})
+        out = Perc()(df, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100]
+
+    @pytest.mark.parametrize("orient, variable", [("x", "y"), ("y", "x")])
+    def test_orientation(self, orient, variable):
+        df = pd.DataFrame({"x": [0, 10], "y": [20, 40], "group": ["a", "a"]})
+        out = Perc(k=[50])(df, GroupBy(["group"]), orient, {})
+        assert out[variable].tolist() == [30 if variable == "y" else 5]
+
+    def test_method(self):
+        df = pd.DataFrame({"y": [0, 1, 2, 3], "group": ["a"] * 4})
+        out = Perc(k=[50], method="lower")(df, GroupBy(["group"]), "x", {})
+        assert out["y"].tolist() == [1]
+
+    def test_grouping_and_order(self, df):
+        gb = GroupBy({"x": ["a", "b"], "group": ["v", "u"]})
+        out = Perc(k=[50])(df, gb, "x", {})
+        assert out[["x", "group"]].values.tolist() == [["a", "v"], ["b", "u"]]
+        assert out["y"].tolist() == [15, 2]
+
+    def test_orientation_groups(self):
+        df = pd.DataFrame({"x": [2, 2, 1, 1], "y": [0, 10, 100, 200]})
+        out = Perc(k=[50])(df, GroupBy(["x"]), "x", {})
+        assert out["x"].tolist() == [1, 2]
+        assert out["y"].tolist() == [150, 5]
+
+    def test_missing_values(self):
+        df = pd.DataFrame({"y": [1, np.nan, 3], "group": ["a"] * 3})
+        out = Perc(k=[50])(df, GroupBy(["group"]), "x", {})
+        assert out["y"].tolist() == [2]
+
+    def test_import_paths(self):
+        from seaborn.objects import Perc as PublicPerc
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        from seaborn.objects import Dots, Plot
+        df = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 3, 2, 4]})
+        Plot(df, x="x", y="y").add(Dots(), Perc(k=[0, 100])).plot()
