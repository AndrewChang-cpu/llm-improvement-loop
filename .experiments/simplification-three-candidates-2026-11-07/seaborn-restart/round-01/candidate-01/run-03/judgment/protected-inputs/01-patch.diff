diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..b70166f
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,70 @@
+import numpy as np
+import pandas as pd
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class PercFixtures:
+
+    def setup_method(self):
+        self.data = pd.DataFrame({
+            "x": ["b", "b", "a", "a"],
+            "y": [1, 3, 10, 20],
+            "group": ["one", "one", "two", "two"],
+        })
+
+    def get_groupby(self, data, orient):
+        value = {"x": "y", "y": "x"}[orient]
+        return GroupBy([var for var in data if var != value])
+
+
+class TestPerc(PercFixtures):
+
+    def test_integer_levels(self):
+        data = self.data[["x", "y"]]
+        out = Perc(3)(data, self.get_groupby(data, "x"), "x", {})
+        assert np.allclose(out["percentile"], [0, 50, 100, 0, 50, 100])
+        assert np.allclose(out["y"], [1, 2, 3, 10, 15, 20])
+
+    def test_explicit_levels(self):
+        data = self.data[["x", "y"]]
+        out = Perc([25, 75])(data, self.get_groupby(data, "x"), "x", {})
+        assert np.allclose(out["percentile"], [25, 75, 25, 75])
+        assert np.allclose(out["y"], [1.5, 2.5, 12.5, 17.5])
+
+    def test_default_levels(self):
+        data = self.data[["x", "y"]]
+        out = Perc()(data, self.get_groupby(data, "x"), "x", {})
+        assert np.allclose(out["percentile"].unique(), [0, 25, 50, 75, 100])
+
+    def test_orientation_and_method(self):
+        data = pd.DataFrame({"x": [1, 3, 10, 20], "y": ["b", "b", "a", "a"]})
+        out = Perc([50], method="lower")(data, self.get_groupby(data, "y"), "y", {})
+        assert out["x"].tolist() == [1, 10]
+        assert out["percentile"].tolist() == [50, 50]
+
+    def test_grouping_and_order(self):
+        out = Perc([50])(
+            self.data, GroupBy({"x": ["a", "b"], "group": ["two", "one"]}), "x", {}
+        )
+        assert out[["x", "group"]].values.tolist() == [["a", "two"], ["b", "one"]]
+
+    def test_orientation_groups(self):
+        data = pd.DataFrame({"x": [1, 2, 10, 20], "y": ["a", "a", "b", "b"]})
+        out = Perc([50])(data, self.get_groupby(data, "y"), "y", {})
+        assert out["y"].tolist() == ["a", "b"]
+        assert out["x"].tolist() == [1.5, 15]
+
+    def test_missing_values(self):
+        data = pd.DataFrame({"x": ["a", "a", "a"], "y": [1, np.nan, 5]})
+        out = Perc([50])(data, self.get_groupby(data, "x"), "x", {})
+        assert out["y"].tolist() == [3]
+
+    def test_import_paths(self):
+        from seaborn.objects import Perc as PublicPerc
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        import seaborn.objects as so
+        plot = so.Plot(self.data, x="x", y="y").add(so.Dots(), so.Perc(k=[25, 75]))
+        plot.plot()
