diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a9d0a77
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,85 @@
+"""Statistical transformations that operate on ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Calculate percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of percentile levels to compute. Defaults to 5, producing
+        the minimum, quartiles, and maximum.
+    method : str
+        Method passed to :func:`numpy.percentile`. Valid choices are
+        ``inverted_cdf``, ``averaged_inverted_cdf``, ``closest_observation``,
+        ``interpolated_inverted_cdf``, ``hazen``, ``weibull``, ``linear``,
+        ``median_unbiased``, ``normal_unbiased``, ``lower``, ``higher``,
+        ``midpoint``, and ``nearest``.
+
+    Returns
+    -------
+    DataFrame
+        One row for each requested percentile level and group, with the
+        computed value and level in the ``percentile`` column.
+
+    Examples
+    --------
+    The default produces percentile rows at 0, 25, 50, 75, and 100: the
+    minimum, quartiles, and maximum.
+
+    .. code:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc())
+
+    Choose a number of evenly spaced levels or specify levels directly:
+
+    .. code:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="group", y="value").add(
+            so.Dot(), so.Perc(k=[10, 50, 90])
+        )
+
+    Combine the endpoints with a range mark to show the full interval:
+
+    .. code:: python
+
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[0, 100])
+        )
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str, levels: np.ndarray) -> DataFrame:
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            values = np.percentile(values, levels, interpolation=self.method)
+        else:
+            values = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        return groupby.apply(data, self._compute, var, levels)
