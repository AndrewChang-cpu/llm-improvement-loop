diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..e4f9be7
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,75 @@
+import numpy as np
+import pandas as pd
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class PercFixtures:
+
+    def make_data(self):
+        return pd.DataFrame({
+            "x": ["b", "a", "b", "a", "b", "a"],
+            "y": [1, 10, 3, 20, 5, 30],
+            "group": ["z", "z", "y", "y", "z", "z"],
+        })
+
+
+class TestPerc(PercFixtures):
+
+    def test_integer_levels(self):
+        data = self.make_data()
+        out = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert out["percentile"].tolist() == [0, 50, 100] * 2
+        assert out.loc[out.x == "a", "y"].tolist() == [10, 20, 30]
+        assert out.loc[out.x == "b", "y"].tolist() == [1, 3, 5]
+
+    def test_default_levels(self):
+        data = self.make_data()
+        out = Perc()(data, GroupBy(["x"]), "x", {})
+        assert out.loc[out.x == "a", "percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert out.loc[out.x == "a", "y"].tolist() == [10, 15, 20, 25, 30]
+
+    def test_explicit_levels(self):
+        data = self.make_data()
+        out = Perc(k=[20, 80])(data, GroupBy(["x"]), "x", {})
+        assert out.loc[out.x == "a", "percentile"].tolist() == [20, 80]
+        assert out.loc[out.x == "a", "y"].tolist() == [14, 26]
+
+    def test_orientations_and_orientation_grouping(self):
+        data = pd.DataFrame({"x": [10, 20, 30, 40], "y": ["b", "a", "b", "a"]})
+        out = Perc(k=[0, 100])(data, GroupBy(["y"]), "y", {})
+        assert out["x"].tolist() == [10, 30, 20, 40]
+        assert out["y"].tolist() == ["b", "b", "a", "a"]
+
+    def test_method(self):
+        data = self.make_data()
+        out = Perc(k=[50], method="lower")(data, GroupBy(["x"]), "x", {})
+        assert out.loc[out.x == "a", "y"].item() == 20
+
+    def test_group_order_and_labels(self):
+        data = self.make_data()
+        out = Perc(k=[50])(
+            data, GroupBy({"x": ["b", "a"], "group": ["y", "z"]}), "x", {}
+        )
+        assert out[["x", "group"]].values.tolist() == [
+            ["b", "y"], ["b", "z"], ["a", "y"], ["a", "z"]
+        ]
+        assert out["y"].tolist() == [3, 3, 20, 20]
+
+    def test_missing_values(self):
+        data = pd.DataFrame({"x": ["a", "a", "a"], "y": [1, np.nan, 3]})
+        out = Perc(k=[0, 50, 100])(data, GroupBy(["x"]), "x", {})
+        assert out["y"].tolist() == [1, 2, 3]
+
+    def test_public_imports(self):
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        data = self.make_data()
+        so.Plot(data, x="x", y="y").add(
+            so.Range(), so.Perc(k=[0, 100])
+        ).plot()
