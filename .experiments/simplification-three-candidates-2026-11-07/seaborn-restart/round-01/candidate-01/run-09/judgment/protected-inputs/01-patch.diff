new file mode 100644
index 0000000..b4a8ca3
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,70 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class PercFixtures:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": [0, 0, 1, 1, 1],
+            "y": [1, 2, 3, 4, 5],
+            "group": ["b", "b", "a", "a", "a"],
+            "other": range(5),
+        })
+
+    def get_groupby(self, variables):
+        return GroupBy(variables)
+
+
+class TestPerc(PercFixtures):
+
+    def test_integer_levels(self, df):
+        res = Perc(k=3)(df, self.get_groupby(["x"]), "x", {})
+        assert_array_equal(res["percentile"], [0, 50, 100, 0, 50, 100])
+        assert_array_equal(res["y"], [1, 1.5, 2, 3, 4, 5])
+        assert_array_equal(res["x"], [0, 0, 0, 1, 1, 1])
+
+    def test_explicit_levels(self, df):
+        res = Perc(k=[25, 75])(df, self.get_groupby(["x"]), "x", {})
+        assert_array_equal(res["percentile"], [25, 75, 25, 75])
+        assert_array_equal(res["y"], [1.25, 1.75, 3.5, 4.5])
+
+    @pytest.mark.parametrize(
+        "orient, var, groups, expected",
+        [("x", "y", ["x"], [1, 2, 3, 5]),
+         ("y", "x", ["y"], np.repeat([0, 0, 1, 1, 1], 2))],
+    )
+    def test_orientation(self, df, orient, var, groups, expected):
+        res = Perc(k=[0, 100])(df, self.get_groupby(groups), orient, {})
+        assert_array_equal(res[var], expected)
+
+    def test_method(self, df):
+        res = Perc(k=[50], method="lower")(df, self.get_groupby(["x"]), "x", {})
+        assert_array_equal(res["y"], [1, 4])
+
+    def test_group_order_and_orientation_grouping(self, df):
+        groupby = self.get_groupby({"group": ["a", "b"], "x": [1, 0]})
+        res = Perc(k=[50])(df, groupby, "x", {})
+        assert_array_equal(res["group"], ["a", "b"])
+        assert_array_equal(res["x"], [1, 0])
+
+    def test_missing_values(self, df):
+        df.loc[1, "y"] = np.nan
+        res = Perc(k=[0, 100])(df, self.get_groupby(["x"]), "x", {})
+        assert_array_equal(res["y"], [1, 1, 3, 5])
+
+    def test_import_paths(self):
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+
+    def test_plot_add(self, df):
+        import seaborn.objects as so
+
+        so.Plot(df, x="x", y="y").add(so.Range(), so.Perc(k=[0, 100])).plot()
