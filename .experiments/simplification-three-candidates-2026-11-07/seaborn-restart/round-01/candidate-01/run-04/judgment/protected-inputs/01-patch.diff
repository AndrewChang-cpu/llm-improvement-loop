diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..9f92413
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,60 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class OrderFixtures:
+
+    def data(self):
+        return pd.DataFrame({"x": [1, 1, 2, 2], "y": [1, 3, 2, 4]})
+
+
+class TestPerc(OrderFixtures):
+
+    def test_integer_levels(self):
+        data = self.data()
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({"x": [1] * 3 + [2] * 3,
+                                 "y": [1., 2., 3., 2., 3., 4.],
+                                 "percentile": [0, 50, 100] * 2})
+        expected = expected.astype({"y": float, "percentile": float})
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels(self):
+        data = self.data()
+        result = Perc(k=[25, 75])(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [25, 75, 25, 75]
+        np.testing.assert_allclose(result["y"], [1.5, 2.5, 2.5, 3.5])
+
+    def test_opposite_orientation(self):
+        data = pd.DataFrame({"x": [0, 1, 2], "y": [5, 5, 5]})
+        result = Perc(k=[50])(data, GroupBy(["y"]), "y", {})
+        assert result["x"].tolist() == [1]
+
+    def test_method(self):
+        data = self.data()
+        result = Perc(k=[25], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert result["y"].tolist() == [1, 2]
+
+    def test_group_order_and_orientation_groups(self):
+        data = pd.DataFrame({"x": [2, 1, 2, 1], "y": [1, 1, 3, 3]})
+        result = Perc(k=[50])(data, GroupBy({"x": [1, 2], "y": [3, 1]}), "x", {})
+        assert list(zip(result.x, result.y, result.percentile)) == [
+            (1, 3, 50), (1, 1, 50), (2, 3, 50), (2, 1, 50),
+        ]
+
+    def test_missing_values(self):
+        data = pd.DataFrame({"x": [1, 1, 1], "y": [1, np.nan, 3]})
+        result = Perc(k=[50])(data, GroupBy(["x"]), "x", {})
+        assert result.y.tolist() == [2]
+
+    def test_public_imports_and_plot_add(self):
+        from seaborn.objects import Perc as PublicPerc, Plot, Range
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert PublicPerc is InternalPerc
+        plot = Plot(self.data(), x="x", y="y").add(Range(), PublicPerc())
+        assert plot._layers
