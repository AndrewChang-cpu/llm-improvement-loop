diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..466a9c6
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,54 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class OrderFixtures:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({"x": [1, 1, 1, 2, 2], "y": [1, 2, 3, 10, np.nan]})
+
+
+class TestPerc(OrderFixtures):
+
+    def test_integer_levels(self, df):
+        res = Perc(k=3)(df, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({"x": [1, 1, 1, 2, 2, 2], "y": [1., 2., 3., 10., 10., 10.],
+                                 "percentile": [0., 50., 100., 0., 50., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels(self, df):
+        res = Perc(k=[25, 75])(df, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({"x": [1, 1, 2, 2], "y": [1.5, 2.5, 10, 10],
+                                 "percentile": [25, 75, 25, 75]})
+        assert_frame_equal(res, expected)
+
+    def test_orientation_and_method(self):
+        df = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["b", "b", "a", "a"]})
+        res = Perc(k=[25, 75], method="lower")(df, GroupBy(["y"]), "y", {})
+        assert res["x"].tolist() == [1, 1, 3, 3]
+        assert res["y"].tolist() == ["b", "b", "a", "a"]
+        assert res["percentile"].tolist() == [25, 75, 25, 75]
+
+    def test_group_order(self):
+        df = pd.DataFrame({"x": ["b", "a", "b", "a"], "y": [1, 2, 3, 4]})
+        res = Perc(k=[50])(df, GroupBy({"x": ["a", "b"]}), "x", {})
+        assert res[["x", "y", "percentile"]].values.tolist() == [["a", 3, 50], ["b", 2, 50]]
+
+    def test_missing_values(self):
+        df = pd.DataFrame({"y": [1, np.nan, 3]})
+        res = Perc(k=[50])(df, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [2]
+
+    def test_imports_and_plot_add(self):
+        from seaborn.objects import Perc as ObjectsPerc, Plot, Range
+
+        assert ObjectsPerc is Perc
+        Plot(x=["a", "a", "b", "b"], y=[1, 2, 3, 4]).add(
+            Range(), Perc(k=[0, 100])
+        ).plot()
