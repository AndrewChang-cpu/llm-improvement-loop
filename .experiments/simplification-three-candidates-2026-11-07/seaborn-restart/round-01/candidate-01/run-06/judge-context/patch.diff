diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..318e9d8
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,68 @@
+"""Statistical transformations that compute order statistics."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Compute percentiles of the value variable.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or the
+        percentile levels to compute directly. Defaults to 5.
+    method : str
+        Method used by :func:`numpy.percentile`. Valid choices are
+        ``inverted_cdf``, ``averaged_inverted_cdf``, ``closest_observation``,
+        ``interpolated_inverted_cdf``, ``hazen``, ``weibull``, ``linear``,
+        ``median_unbiased``, ``normal_unbiased``, ``lower``, ``higher``,
+        ``midpoint``, and ``nearest``.
+
+    Returns one row for each requested percentile, with its computed value in
+    the value variable and its level in the ``percentile`` column.
+
+    Examples
+    --------
+    Default quartiles and endpoints::
+
+        so.Plot(penguins, y="body_mass_g").add(so.Range(), so.Perc())
+
+    Choose an integer count or explicit levels::
+
+        so.Plot(penguins, y="body_mass_g").add(so.Range(), so.Perc(k=3))
+        so.Plot(penguins, y="body_mass_g").add(so.Range(), so.Perc(k=[5, 50, 95]))
+
+    Combine percentile rows with a range mark to show an interval::
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Range(), so.Perc(k=[5, 95])
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"method" if Version(np.__version__) >= Version("1.22.0") else "interpolation": self.method}
+        values = np.nanpercentile(data[var], levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
