diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..59efbbe
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,78 @@
+"""Statistical transformations that operate on ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with their values at specified percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or a
+        list of levels to use directly. The default of 5 gives the quartiles
+        and endpoints.
+    method : str
+        Method used to compute the percentile, passed to
+        :func:`numpy.percentile`. The default is ``"linear"``. Valid methods
+        are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile in each group, with the percentile
+        level in ``percentile`` and its computed value on the value axis.
+
+    Examples
+    --------
+    The default returns quartiles and endpoints::
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc())
+
+    Request a number of evenly spaced levels or a specific list::
+
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=3))
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=[10, 50, 90]))
+
+    The endpoints can also define a range interval::
+
+        so.Plot(data, x="x", y="y").add(
+            so.Range(), so.Perc(k=[0, 100]),
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        if values.empty:
+            return DataFrame(columns=[var, "percentile"])
+        keyword = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {keyword: self.method}
+        result = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
