diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..cfe6c39
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,37 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_count_and_explicit_levels():
+    data = pd.DataFrame({"x": [1, 2, 3, 4, 5], "y": [2, 4, 6, 8, 10]})
+    result = Perc()(data, GroupBy(["group"]), "x", {})
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+    assert result["y"].tolist() == [2, 4, 6, 8, 10]
+
+    result = Perc(k=[10, 50, 90])(data, GroupBy(["group"]), "x", {})
+    assert result["percentile"].tolist() == [10, 50, 90]
+    np.testing.assert_allclose(result["y"], [2.8, 6, 9.2])
+
+
+def test_orientation_method_missing_and_group_order():
+    data = pd.DataFrame({
+        "x": [1, 3, np.nan, 10, 20],
+        "y": [5, 5, 8, 1, 1],
+        "group": ["b", "b", "b", "a", "a"],
+    })
+    result = Perc(k=[50], method="lower")(
+        data, GroupBy(["group", "y"]), "y", {},
+    )
+    assert result[["group", "y"]].values.tolist() == [["b", 5], ["a", 1]]
+    assert result["x"].tolist() == [1, 10]
+
+
+def test_public_export_and_plot_add():
+    import seaborn.objects as so
+
+    assert so.Perc is Perc
+    plot = so.Plot(pd.DataFrame({"x": [1, 2, 3], "y": [3, 2, 1]}), x="x", y="y")
+    plot.add(so.Dots(), so.Perc(k=3)).plot()
