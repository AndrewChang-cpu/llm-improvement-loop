diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..ca71bf2
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,81 @@
+"""Statistical transformations that order observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or an
+        explicit list of percentile levels. Defaults to 5, producing quartiles
+        and the endpoints.
+    method : str
+        Method used to compute the percentile, as in :func:`numpy.percentile`.
+        Defaults to ``"linear"``. Valid choices are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile level in each group, with the
+        computed value and a ``percentile`` column recording the level.
+
+    Examples
+    --------
+    Use the default quartiles and endpoints:
+
+    .. code:: python
+
+        p = so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+
+    Request an integer number of levels or supply levels directly:
+
+    .. code:: python
+
+        p = so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=3))
+        p = so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Combine percentile rows with a range mark to represent an interval:
+
+    .. code:: python
+
+        p = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[2.5, 97.5]))
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            computed = np.percentile(values, levels, interpolation=self.method)
+        else:
+            computed = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: computed, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
