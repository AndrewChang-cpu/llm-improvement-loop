diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..ad38a1d
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,45 @@
+import numpy as np
+import pandas as pd
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_perc_count_and_explicit_levels():
+    data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4]})
+    result = Perc()(data, GroupBy(["group"]), "y", {})
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+    np.testing.assert_allclose(result["x"], [1, 1.75, 2.5, 3.25, 4])
+
+    result = Perc(k=[10, 50, 90])(data, GroupBy(["group"]), "y", {})
+    assert result["percentile"].tolist() == [10, 50, 90]
+
+
+def test_perc_orientation_method_missing_and_group_order():
+    data = pd.DataFrame({
+        "group": ["b", "a", "b", "a"],
+        "x": [1, 2, 3, 4],
+        "y": [1, np.nan, 3, 4],
+    })
+    result = Perc(k=[50], method="lower")(
+        data, GroupBy({"group": ["a", "b"]}), "x", {},
+    )
+    assert result.columns.tolist() == ["group", "y", "percentile"]
+    assert result["group"].tolist() == ["a", "b"]
+    assert result["y"].tolist() == [4, 1]
+
+
+def test_perc_orientation_key_and_public_plot_add():
+    data = pd.DataFrame({"x": [1, 2, 3], "y": [2, 4, 6]})
+    result = Perc(k=[0, 100])(data, GroupBy(["x"]), "x", {})
+    assert result.columns.tolist() == ["x", "y", "percentile"]
+    assert result["x"].tolist() == [1, 1, 2, 2, 3, 3]
+    assert result["y"].tolist() == [2, 2, 4, 4, 6, 6]
+
+    assert so.Perc is Perc
+    plot = so.Plot(
+        pd.DataFrame({"group": ["a", "a", "b", "b"], "value": [1, 2, 3, 4]}),
+        x="group", y="value",
+    ).add(so.Range(), so.Perc(k=[0, 100]))
+    plot.plot()
