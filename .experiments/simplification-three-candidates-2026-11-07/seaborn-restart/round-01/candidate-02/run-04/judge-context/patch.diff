diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..0309a8a
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,84 @@
+"""Statistical transformations that operate on ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from pandas import DataFrame
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with values at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels to compute, or explicit
+        percentile levels. The default, 5, computes 0, 25, 50, 75, and 100.
+    method : str
+        Method used to compute the percentile. See :func:`numpy.percentile`
+        for details. The default is ``"linear"``. Choices include
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row for each requested percentile in each group, with the value
+        on the axis opposite the orientation and the requested level in a
+        ``percentile`` column.
+
+    Examples
+    --------
+    Compute the default quartiles and endpoints:
+
+    .. code:: python
+
+        p = so.Plot(data, x="value").add(so.Dot(), so.Perc())
+
+    Choose an integer count or specific levels:
+
+    .. code:: python
+
+        p.add(so.Dot(), so.Perc(k=3))
+        p.add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Use the endpoints with a range mark to represent an interval:
+
+    .. code:: python
+
+        p.add(so.Range(), so.Perc(k=[0, 100]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        vals = data[var].dropna()
+        kws = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.percentile(vals, levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var)
