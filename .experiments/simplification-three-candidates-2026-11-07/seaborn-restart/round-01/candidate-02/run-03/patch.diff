diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..d901b78
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,40 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_count_and_list():
+    data = pd.DataFrame({"group": ["a"] * 4, "x": [0, 1, 2, 3], "y": [0, 10, 20, 30]})
+
+    result = Perc()(data, GroupBy(["group"]), "x", {})
+    assert result["y"].tolist() == [0, 7.5, 15, 22.5, 30]
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+
+    result = Perc(k=[25, 50, 75])(data, GroupBy(["group"]), "x", {})
+    assert result["y"].tolist() == [7.5, 15, 22.5]
+
+    result = Perc(k=[25, 50, 75])(
+        data, GroupBy(["group"]), "y", {}
+    )
+    assert result["x"].tolist() == [0.75, 1.5, 2.25]
+
+
+def test_grouped_values_missing_and_method():
+    data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [0, 1, 2, 3], "y": [1, np.nan, 5, 9]})
+    result = Perc(k=[0, 50, 100], method="nearest")(
+        data, GroupBy({"group": ["a", "b"]}), "x", {}
+    )
+    assert result["group"].tolist() == ["a"] * 3 + ["b"] * 3
+    assert result["y"].tolist() == [9, 9, 9, 1, 1, 5]
+    assert result["percentile"].tolist() == [0, 50, 100] * 2
+
+
+def test_plot_add():
+    from seaborn import objects as so
+
+    data = pd.DataFrame({"x": [0, 1, 2, 3], "y": [0, 10, 20, 30]})
+    plot = so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+    plot.plot()
