diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a7b6031
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,69 @@
+"""Order-related statistical transformations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or a
+        list of levels to use directly. Defaults to 5, producing quartiles
+        and the endpoints.
+    method : str
+        Percentile method passed to :func:`numpy.percentile`. Defaults to
+        "linear". Valid choices are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "linear", "median_unbiased", "normal_unbiased", "lower",
+        "higher", "midpoint", and "nearest".
+
+    Returns
+    -------
+    DataFrame
+        One row per requested level in each group, with the computed value
+        and the requested level in a `percentile` column.
+
+    Examples
+    --------
+    The default produces quartiles and endpoints. An integer sets the number
+    of evenly spaced levels, and a list specifies levels directly::
+
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Use the endpoint percentiles with a range mark to represent an interval::
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[5, 95]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kws = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
