diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..f248154
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,56 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["y"].tolist() == [1, 2.5, 4]
+
+    def test_list_and_method(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+        result = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        assert result["percentile"].tolist() == [25, 75]
+        assert result["y"].tolist() == [2, 3]
+
+    def test_groups_order_and_missing_values(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "y": [2, 1, np.nan, 3],
+            "unused": [1, 2, 3, 4],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy({"group": ["a", "b"]}), "x", {}
+        )
+        assert result.columns.tolist() == ["group", "y", "percentile"]
+        assert result["group"].tolist() == ["a", "a", "b", "b"]
+        assert result["y"].tolist() == [1, 3, 2, 2]
+
+    def test_orientation_grouping(self):
+        stat = Perc(k=2)
+        assert stat.group_by_orient
+        data = pd.DataFrame({"group": ["a"] * 2, "x": [1, 3], "y": [10, 20]})
+        vertical = stat(
+            data, GroupBy(["group"]), "x", {},
+        )
+        horizontal = stat(
+            data, GroupBy(["group"]), "y", {},
+        )
+        assert vertical["y"].tolist() == [10, 20]
+        assert horizontal["x"].tolist() == [1, 3]
+
+    def test_public_export_and_plot_add(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        plot = so.Plot(pd.DataFrame({"x": [1, 2, 3], "y": [2, 4, 6]}), "x", "y")
+        plot.add(so.Dots(), so.Perc(k=3)).plot()
+        plot.add(so.Range(), so.Perc(k=[25, 75])).plot()
