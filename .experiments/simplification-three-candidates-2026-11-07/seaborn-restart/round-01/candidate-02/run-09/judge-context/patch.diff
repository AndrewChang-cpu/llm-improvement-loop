diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..30d794e
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,68 @@
+"""Statistics for ordering observations along a plot dimension."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced levels from 0 through 100 (default 5), or
+        explicit percentile levels to compute. Each group produces one output
+        row per level, with the requested level in a ``percentile`` column.
+    method : str
+        Method used to compute the percentile. One of ``inverted_cdf``,
+        ``averaged_inverted_cdf``, ``closest_observation``,
+        ``interpolated_inverted_cdf``, ``hazen``, ``weibull``, ``linear``,
+        ``median_unbiased``, ``normal_unbiased``, ``lower``, ``higher``,
+        ``midpoint``, or ``nearest``. Defaults to ``linear``.
+
+    Examples
+    --------
+    .. code:: python
+
+        import seaborn.objects as so
+
+    Show the default quartiles and endpoints::
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc())
+
+    Request an integer number of levels or a specific list::
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="group", y="value").add(
+            so.Dot(), so.Perc(k=[25, 75])
+        )
+
+    Combine the two quartiles with a range mark to show their interval::
+
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[25, 75])
+        )
+    """
+    group_by_orient = True
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def _compute(self, data, var):
+        values = data[var].dropna()
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        if Version(np.__version__) < Version("1.22.0"):
+            values = np.percentile(values, levels, interpolation=self.method)
+        else:
+            values = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var)
