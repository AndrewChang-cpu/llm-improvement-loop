diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..ced809d
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,57 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+@pytest.mark.parametrize("k, expected_levels", [
+    (4, [0, 100 / 3, 200 / 3, 100]),
+    ([10, 50, 90], [10, 50, 90]),
+])
+def test_percentile_levels_and_values(k, expected_levels):
+
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, 20, 30, 40]})
+    result = Perc(k=k)(data, GroupBy(["absent"]), "y", {})
+
+    assert result["percentile"].to_list() == pytest.approx(expected_levels)
+    assert result["x"].to_list() == pytest.approx(np.percentile(data.x, expected_levels))
+
+
+def test_default_percentiles_exclude_missing_and_use_method():
+
+    data = pd.DataFrame({"x": [0, 1, np.nan, 3, 4], "y": [1, 1, 1, 1, 1]})
+    result = Perc(method="nearest")(data, GroupBy(["y"]), "y", {})
+
+    assert result["percentile"].to_list() == [0, 25, 50, 75, 100]
+    assert result["x"].to_list() == [0, 1, 3, 3, 4]
+
+
+@pytest.mark.parametrize(
+    "orient, value_var",
+    [("x", "y"), ("y", "x")],
+)
+def test_orientation_and_group_order(orient, value_var):
+
+    data = pd.DataFrame({
+        "x": [2, 1, 2, 1],
+        "y": [20, 10, 40, 30],
+        "group": ["b", "a", "b", "a"],
+    })
+    groupby = GroupBy(["group"])
+    result = Perc(k=[0, 100])(data, groupby, orient, {})
+
+    assert list(result.columns) == [value_var, "group", "percentile"]
+    assert result["group"].to_list() == ["b", "b", "a", "a"]
+    assert result["percentile"].to_list() == [0, 100, 0, 100]
+    expected = [20, 40, 10, 30] if orient == "x" else [2, 2, 1, 1]
+    assert result[value_var].to_list() == expected
+
+
+def test_public_export_and_plot_add(long_df):
+
+    import seaborn.objects as so
+
+    assert so.Perc is Perc
+    so.Plot(long_df, x="x", y="y").add(so.Dots(), so.Perc()).plot()
