diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..df1c8e8
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,83 @@
+"""Statistical transformations that change the order of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at specified percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive.
+        Defaults to 5, corresponding to the minimum, quartiles, and maximum.
+        A list supplies the percentile levels directly.
+    method : str
+        Method used to calculate the percentile, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Valid methods are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile in each group, with the computed value
+        and the requested level in a ``percentile`` column.
+
+    Examples
+    --------
+    The default returns the quartiles and endpoints:
+
+    .. code:: python
+
+        so.Plot(data, y="value").add(so.Dots(), so.Perc())
+
+    Choose a number of evenly spaced levels or provide levels directly:
+
+    .. code:: python
+
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(k=3))
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(k=[10, 50, 90]))
+
+    Combine percentile output with a range mark to represent an interval:
+
+    .. code:: python
+
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[25, 75])
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data, var):
+        values = data[var].dropna()
+        levels = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer)) else self.k
+        )
+        method = (
+            "interpolation"
+            if Version(np.__version__) < Version("1.22.0")
+            else "method"
+        )
+        result = np.percentile(values, levels, **{method: self.method})
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
