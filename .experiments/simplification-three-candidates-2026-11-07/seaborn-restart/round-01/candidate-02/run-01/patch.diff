diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..b077939
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,76 @@
+"""Statistics that transform observations into ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or a
+        list of levels to use directly. Defaults to five levels (0, 25, 50,
+        75, and 100).
+    method : str
+        Method used to compute the percentile, as in :func:`numpy.percentile`.
+        Defaults to ``"linear"``. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested level in each group, with the computed value
+        and the level in a ``percentile`` column.
+
+    Examples
+    --------
+    The default returns quartiles and endpoints. Use ``k`` to choose a count
+    or explicit percentile levels::
+
+        p = so.Plot(data, x="x", y="y")
+        p.add(so.Dots(), so.Perc())
+        p.add(so.Dots(), so.Perc(k=3))
+        p.add(so.Dots(), so.Perc(k=[10, 50, 90]))
+
+    Combine the percentile rows with a range mark to show an interval::
+
+        p.add(so.Range(), so.Perc(k=[2.5, 97.5]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str, levels) -> DataFrame:
+        values = data[var].dropna()
+        if values.empty:
+            return pd.DataFrame({var: np.nan, "percentile": levels})
+        if Version(np.__version__) < Version("1.22.0"):
+            kwargs = {"interpolation": self.method}
+        else:
+            kwargs = {"method": self.method}
+        result = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        return groupby.apply(data, self._compute, var, levels).reset_index(drop=True)
