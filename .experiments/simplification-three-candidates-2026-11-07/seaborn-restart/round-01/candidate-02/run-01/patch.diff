diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..fb6f38e
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,36 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_perc_count_and_missing_values():
+    data = pd.DataFrame({"x": [0, 10, 20, np.nan], "group": ["b", "b", "b", "a"]})
+    result = Perc()(data, GroupBy({"group": ["b", "a"]}), "y", {})
+
+    assert result.columns.tolist() == ["x", "group", "percentile"]
+    assert result["group"].tolist() == ["b"] * 5 + ["a"] * 5
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+    assert result["x"].iloc[:5].tolist() == [0, 5, 10, 15, 20]
+    assert result["x"].iloc[5:].isna().all()
+
+
+def test_perc_list_method_and_orientation():
+    data = pd.DataFrame({"x": [1, 1, 1], "y": [1, 2, 3]})
+    result = Perc(k=[25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+
+    assert result.columns.tolist() == ["x", "y", "percentile"]
+    assert result["y"].tolist() == [1, 3]
+    assert result["percentile"].tolist() == [25, 75]
+    assert result["x"].tolist() == [1, 1]
+
+
+def test_perc_plot_add_and_public_export():
+    import seaborn.objects as so
+
+    data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [0, 10, 5, 15]})
+    plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[0, 100]))
+
+    assert so.Perc is Perc
+    plot.plot()
