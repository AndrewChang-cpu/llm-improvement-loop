diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..7abe323
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,95 @@
+"""Statistical transformations that order or select values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles to compute from 0 through 100,
+        inclusive. The default, 5, gives the endpoints and quartiles. A list
+        specifies the percentile levels directly.
+    method : str
+        Method used to compute the percentiles, passed to
+        :func:`numpy.percentile`. The default is ``"linear"``. Valid choices
+        are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile in each group, with the computed
+        value and a ``percentile`` column containing the requested level.
+
+    Examples
+    --------
+    The default gives the endpoints and quartiles:
+
+    .. code-block:: python
+
+        from seaborn.objects import Plot, Perc, Dots
+
+        Plot(data, x="x", y="y").add(Dots(), Perc())
+
+    Request a different count or specific levels:
+
+    .. code-block:: python
+
+        Plot(data, x="x", y="y").add(Dots(), Perc(k=3))
+        Plot(data, x="x", y="y").add(Dots(), Perc(k=[10, 50, 90]))
+
+    Use the endpoints as an interval with a range mark:
+
+    .. code-block:: python
+
+        from seaborn.objects import Plot, Perc, Range
+
+        Plot(data, x="x", y="y").add(Range(), Perc(k=[5, 95]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        values = data[var].dropna()
+        if values.empty:
+            return pd.DataFrame(columns=[var, "percentile"])
+
+        if np.lib.NumpyVersion(np.__version__) < "1.22.0":
+            percentile_values = np.percentile(
+                values, levels, interpolation=self.method,
+            )
+        else:
+            percentile_values = np.percentile(values, levels, method=self.method)
+
+        return pd.DataFrame({var: percentile_values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
