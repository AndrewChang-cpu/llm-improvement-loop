diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..b80839b
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,80 @@
+"""Statistics that operate on the order of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels to compute, including 0 and
+        100. Defaults to 5, yielding the endpoints and quartiles. A list gives
+        the levels directly.
+    method : str
+        Method used to compute the percentile, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Valid choices are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile level in each group. The output
+        contains the value variable, a ``percentile`` column, and grouping
+        variables.
+
+    Examples
+    --------
+    The default computes the endpoints and quartiles:
+
+    .. code:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc())
+
+    Set an integer count or supply percentile levels directly:
+
+    .. code:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc(k=3))
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc(k=[5, 50, 95]))
+
+    Combine percentile rows with a range mark to show the interval endpoints:
+
+    .. code:: python
+
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc(k=[2.5, 97.5]))
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def _compute(self, data, value):
+        values = data[value].dropna()
+        percentiles = (
+            np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        )
+        keyword = (
+            "method" if Version(np.__version__) >= Version("1.22.0")
+            else "interpolation"
+        )
+        kwargs = {keyword: self.method}
+        result = np.percentile(values, percentiles, **kwargs)
+        return pd.DataFrame({value: result, "percentile": percentiles})
+
+    def __call__(self, data, groupby, orient, scales):
+        value = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, value)
