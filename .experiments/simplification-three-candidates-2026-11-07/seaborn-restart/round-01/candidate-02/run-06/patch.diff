diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..06b58f4
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,49 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc, Plot, Dots
+
+
+@pytest.fixture
+def scales():
+    return {}
+
+
+def test_perc_count_and_list(scales):
+    data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4], "group": ["b", "b", "a", "a"]})
+    count = Perc(k=3)(data, GroupBy(["group"]), "x", scales)
+    assert count["percentile"].tolist() == [0, 50, 100, 0, 50, 100]
+    assert count["y"].tolist() == [1, 1.5, 2, 3, 3.5, 4]
+    assert count["group"].tolist() == ["b"] * 3 + ["a"] * 3
+
+    listed = Perc(k=[25, 75])(data, GroupBy(["group"]), "x", scales)
+    assert listed["percentile"].tolist() == [25, 75, 25, 75]
+    assert listed.columns.tolist() == ["y", "group", "percentile"]
+
+
+def test_perc_orientation_and_method(scales):
+    data = pd.DataFrame({"x": [1, 2, 3], "y": [3, 2, 1], "group": ["a"] * 3})
+    vertical = Perc(k=[50])(data, GroupBy(["group"]), "x", scales)
+    horizontal = Perc(k=[50])(data, GroupBy(["group"]), "y", scales)
+    lower = Perc(k=[50], method="lower")(data, GroupBy(["group"]), "x", scales)
+    assert vertical["y"].tolist() == [2]
+    assert horizontal["x"].tolist() == [2]
+    assert lower["y"].tolist() == [2]
+
+
+def test_perc_drops_missing(scales):
+    data = pd.DataFrame({"x": [1, 2, 3], "y": [1, np.nan, 3], "group": ["a"] * 3})
+    result = Perc(k=[50])(data, GroupBy(["group"]), "x", scales)
+    assert result["y"].tolist() == [2]
+
+
+def test_perc_public_export():
+    assert PublicPerc is Perc
+
+
+def test_perc_with_plot_add():
+    data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 3, 4]})
+    Plot(data, x="x", y="y").add(Dots(), Perc(k=3)).plot()
