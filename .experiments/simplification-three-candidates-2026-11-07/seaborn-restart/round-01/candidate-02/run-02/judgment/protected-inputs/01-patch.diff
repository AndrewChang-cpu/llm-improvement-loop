diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..11987af
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,42 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [1, 1, 2, 2], "y": [0, 10, 20, 30]})
+        res = Perc()(data, GroupBy(["x"]), "x", {})
+
+        assert res.columns.to_list() == ["x", "y", "percentile"]
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+        np.testing.assert_allclose(res["y"], [0, 2.5, 5, 7.5, 10, 20, 22.5, 25, 27.5, 30])
+
+    def test_list_method_and_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [0, 10, np.nan, 30]})
+        res = Perc(k=[0, 50, 100], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+
+        assert res.columns.to_list() == ["group", "y", "percentile"]
+        assert res["percentile"].tolist() == [0, 50, 100]
+        assert res["y"].tolist() == [0, 10, 30]
+
+    def test_horizontal_orientation(self):
+        data = pd.DataFrame({"y": [1, 1, 1], "x": [2, 4, 8]})
+        res = Perc(k=3)(data, GroupBy(["y"]), "y", {})
+
+        assert res.columns.to_list() == ["y", "x", "percentile"]
+        assert res["x"].tolist() == [2, 4, 8]
+
+    def test_plot_add(self):
+        from seaborn import objects as so
+
+        assert so.Perc is Perc
+        data = pd.DataFrame({"group": ["a"] * 4, "value": [1, 2, 3, 4]})
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[25, 75])
+        ).plot()
