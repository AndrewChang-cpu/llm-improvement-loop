index 0000000..12ae71f
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,58 @@
+"""Statistics that transform data ordering."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels in that range. The default
+        produces the minimum, quartiles, and maximum.
+    method : str
+        Method passed to :func:`numpy.percentile`. The default is ``"linear"``.
+        NumPy also supports ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row for each requested percentile in each group. The computed
+        value replaces the orientation variable, and the level is recorded
+        in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def __call__(self, data, groupby, orient, scales):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        if np.lib.NumpyVersion(np.__version__) < "1.22.0":
+            kws = {"interpolation": self.method}
+        else:
+            kws = {"method": self.method}
+
+        def percentile(part):
+            values = np.percentile(part[orient].dropna(), levels, **kws)
+            return pd.DataFrame({orient: values, "percentile": levels})
+
+        return groupby.apply(data, percentile)
