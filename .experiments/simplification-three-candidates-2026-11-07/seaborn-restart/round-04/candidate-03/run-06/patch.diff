diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..3b13cdb
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,44 @@
+import numpy as np
+import pandas as pd
+import seaborn.objects as so
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "x": [0, 10, 20, 30, 40]})
+        out = Perc()(data, GroupBy(["group"]), "x", {})
+        assert out["x"].to_list() == [0, 10, 20, 30, 40]
+        assert out["percentile"].to_list() == [0, 25, 50, 75, 100]
+
+    def test_count(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "x": [0, 10, 20, 30, 40]})
+        out = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert out["percentile"].to_list() == [0, 50, 100]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"group": ["a", "a"], "x": [0, 10]})
+        out = Perc(k=[25, 75], method="lower")(data, GroupBy(["group"]), "x", {})
+        assert out["x"].to_list() == [0, 0]
+        assert out["percentile"].to_list() == [25, 75]
+
+    def test_groups_order_and_columns(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [2, 10, 4, 20], "other": [1, 2, 3, 4]})
+        out = Perc(k=2)(data, GroupBy(["group"]), "x", {})
+        assert out.columns.to_list() == ["group", "x", "percentile"]
+        assert out["group"].to_list() == ["b", "b", "a", "a"]
+        assert out["x"].to_list() == [2, 4, 10, 20]
+
+    def test_orientation_and_missing(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [2, np.nan, 8], "orient": ["h"] * 3})
+        out = Perc(k=[0, 100])(data, GroupBy(["orient"]), "y", {})
+        assert out.columns.to_list() == ["y", "orient", "percentile"]
+        assert out["y"].to_list() == [2, 8]
+        assert out["percentile"].to_list() == [0, 100]
+
+    def test_plot_add(self):
+        plot = so.Plot().add(so.Dot(), Perc(k=3))
+        assert isinstance(plot._layers[0]["stat"], Perc)
