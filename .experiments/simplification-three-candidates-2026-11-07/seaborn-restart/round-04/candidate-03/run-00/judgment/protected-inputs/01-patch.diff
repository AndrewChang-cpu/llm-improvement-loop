diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a6c3a2b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,64 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.plot import Plotter
+from seaborn._stats.order import Perc
+from seaborn.objects import Dots, Perc as ObjectsPerc, Plot
+
+
+class TestPerc:
+
+    def test_default(self):
+
+        df = pd.DataFrame({"x": [1, 2, 3, 4, 5]})
+        out = Perc()(df, GroupBy(["group"]), "x", {})
+        assert out["percentile"].to_list() == [0, 25, 50, 75, 100]
+        assert out["x"].to_list() == [1, 2, 3, 4, 5]
+
+    def test_integer_count(self):
+
+        df = pd.DataFrame({"x": [0, 10]})
+        out = Perc(k=3)(df, GroupBy(["group"]), "x", {})
+        assert out["percentile"].to_list() == [0, 50, 100]
+        assert out["x"].to_list() == [0, 5, 10]
+
+    def test_explicit_levels_and_method(self):
+
+        df = pd.DataFrame({"x": [0, 10]})
+        out = Perc(k=[10, 90], method="nearest")(df, GroupBy(["group"]), "x", {})
+        assert out["percentile"].to_list() == [10, 90]
+        assert out["x"].to_list() == [0, 10]
+
+    def test_grouping_and_order(self):
+
+        df = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [4, 10, 8, 20]})
+        out = Perc(k=2)(df, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert out.columns.to_list() == ["group", "x", "percentile"]
+        assert out["group"].to_list() == ["a", "a", "b", "b"]
+        assert out["x"].to_list() == [10, 20, 4, 8]
+
+    def test_orientation_and_missing_data(self):
+
+        df = pd.DataFrame({"y": [1, np.nan, 3]})
+        out = Perc(k=3)(df, GroupBy(["group"]), "y", {})
+        assert out.columns.to_list() == ["y", "percentile"]
+        assert out["percentile"].to_list() == [0, 50, 100]
+        assert out["y"].to_list() == [1, 2, 3]
+
+    def test_public_import(self):
+
+        assert ObjectsPerc is Perc
+
+    def test_plot_add(self):
+
+        df = pd.DataFrame({"x": ["a", "a"], "y": [0, 10]})
+        spec = Plot(df, x="x", y="y").add(Dots(), ObjectsPerc(k=3), orient="y")
+        plotter = Plotter(pyplot=False, theme=spec._theme_with_defaults())
+        common, layers = plotter._extract_data(spec)
+        plotter._setup_figure(spec, common, layers)
+        plotter._setup_scales(spec, common, layers, ["x", "y"])
+        plotter._compute_stats(spec, layers)
+        layer, = layers
+        assert layer["data"].frame["y"].to_list() == [0, 0, 0, 10, 10, 10]
+        assert layer["data"].frame["percentile"].to_list() == [0, 50, 100, 0, 50, 100]
