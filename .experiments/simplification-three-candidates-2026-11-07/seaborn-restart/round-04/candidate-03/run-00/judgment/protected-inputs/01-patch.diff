diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..5f6f844
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,54 @@
+"""Statistics that order or rank observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels between 0 and 100.
+    method : str
+        Method used to estimate the percentile. The default is ``"linear"``.
+        See :func:`numpy.percentile` for the available methods.
+
+    The output has one row per requested percentile per group, with the
+    percentile values in the orientation-selected coordinate and the levels
+    in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    group_by_orient = True
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def __call__(self, data, groupby: GroupBy, orient, scales):
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        def percentile(data):
+            values = data[orient].dropna()
+            if Version(np.__version__) < Version("1.22.0"):
+                result = np.percentile(values, levels, interpolation=self.method)
+            else:
+                result = np.percentile(values, levels, method=self.method)
+            return pd.DataFrame({orient: result, "percentile": levels})
+
+        return groupby.apply(data, percentile)
