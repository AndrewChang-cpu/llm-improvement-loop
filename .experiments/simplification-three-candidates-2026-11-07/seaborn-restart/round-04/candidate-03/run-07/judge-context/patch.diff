diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..4ce1a1b
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,73 @@
+"""Statistical transformations that change the order of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or explicit percentile levels in that range. The default, 5, gives
+        quintiles. Use ``4`` for quartiles or ``[0, 100]`` for the endpoints.
+    method : str
+        Method used to compute the percentiles. The default is ``"linear"``.
+        Other options are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    This statistic returns one row per requested percentile per group, with
+    the computed value in the orientation-selected variable and its level in
+    the ``percentile`` column.
+
+    Examples
+    --------
+    Default quintiles and quartiles::
+
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc())
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=4))
+
+    Endpoints and selected levels::
+
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=[0, 100]))
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=[10, 50, 90]))
+
+    Use a range mark for an interval::
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[5, 95]))
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kws = {"method": self.method}
+        if Version(np.__version__) < Version("1.22.0"):
+            kws = {"interpolation": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
