diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..088729f
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,56 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [1, 2, 3, 4], "group": ["a"] * 4})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "y": [1, 1.75, 2.5, 3.25, 4], "group": ["a"] * 5,
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": [1, 2, np.nan, 4, 5], "group": ["a"] * 5})
+        result = Perc([0, 50, 100], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["y"].tolist() == [1, 4, 5]
+
+    def test_grouping_and_order(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"],
+            "y": [10, 1, 20, 3],
+            "color": ["z", "z", "z", "z"],
+        })
+        result = Perc([0, 100])(data, GroupBy(["x", "color"]), "x", {})
+        assert result[["x", "color"]].drop_duplicates().values.tolist() == [
+            ["b", "z"], ["a", "z"]
+        ]
+        assert result["y"].tolist() == [10, 20, 1, 3]
+
+    def test_orientation_and_imports(self):
+        from seaborn.objects import Perc as ObjectsPerc
+
+        assert ObjectsPerc is Perc
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [4, 5, 6]})
+        data["group"] = "a"
+        result = Perc(2)(data, GroupBy(["group"]), "y", {})
+        assert result["x"].tolist() == [1, 3]
+        assert result["percentile"].tolist() == [0, 100]
+
+    def test_plot_add(self):
+        from seaborn.objects import Dots, Plot
+
+        plot = Plot(x=["a"] * 4, y=[1, 2, 3, 4]).add(Dots(), Perc(k=2)).plot()
+        offsets = plot._figure.axes[0].collections[0].get_offsets()
+        assert offsets[:, 1].tolist() == [1, 4]
