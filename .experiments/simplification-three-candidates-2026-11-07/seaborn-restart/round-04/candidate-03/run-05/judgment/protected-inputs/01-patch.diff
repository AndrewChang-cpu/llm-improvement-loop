diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..e87bc10
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,37 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Dots, Plot
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [4, 1, 2, 3]})
+        out = Perc()(data, GroupBy(["group"]), "x", {})
+        assert out.columns.tolist() == ["group", "y", "percentile"]
+        assert out["group"].tolist() == ["b"] * 5 + ["a"] * 5
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+        np.testing.assert_allclose(out.loc[out.group == "b", "y"], [2, 2.5, 3, 3.5, 4])
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+        out = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert out.percentile.tolist() == [0, 50, 100]
+        out = Perc(k=[10, 90])(data, GroupBy(["group"]), "x", {})
+        assert out.percentile.tolist() == [10, 90]
+
+    def test_orientation_method_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [4, 2, np.nan, 0], "y": [0, 1, 2, 3]})
+        out = Perc(k=[50], method="nearest")(data, GroupBy(["group"]), "y", {})
+        assert out.columns.tolist() == ["group", "x", "percentile"]
+        assert out.x.tolist() == [2]
+
+    def test_objects_export_and_plot_add(self):
+        from seaborn.objects import Perc as ObjectsPerc
+
+        plot = Plot(pd.DataFrame({"x": [1, 2, 3]}), x="x").add(Dots(), ObjectsPerc())
+        assert isinstance(ObjectsPerc(), Perc)
+        assert len(plot._layers) == 1
