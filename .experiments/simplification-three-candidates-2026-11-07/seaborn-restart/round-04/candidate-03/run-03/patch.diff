diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5f76191
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,55 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_imports(self):
+        assert ObjectsPerc is Perc
+
+    def test_default_levels_and_values(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5]})
+        out = Perc()(data, GroupBy(["group"]), "x", {})
+        assert out.columns.to_list() == ["x", "percentile"]
+        np.testing.assert_array_equal(out["percentile"], [0, 25, 50, 75, 100])
+        np.testing.assert_array_equal(out["x"], [1, 2, 3, 4, 5])
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 10]})
+        count = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        explicit = Perc(k=[0, 100])(data, GroupBy(["group"]), "x", {})
+        np.testing.assert_array_equal(count["percentile"], [0, 50, 100])
+        np.testing.assert_array_equal(explicit["x"], [0, 10])
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": [0, 10, np.nan]})
+        out = Perc(k=[25, 50, 75], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        np.testing.assert_array_equal(out["x"], [0, 0, 10])
+
+    def test_groups_and_order(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [2, 10, 4, 20]})
+        out = Perc(k=2)(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert out.columns.to_list() == ["group", "x", "percentile"]
+        assert out["group"].to_list() == ["a", "a", "b", "b"]
+        np.testing.assert_array_equal(out["x"], [10, 20, 2, 4])
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [1, 2], "y": [10, 20]})
+        out = Perc(k=2)(data, GroupBy(["group"]), "y", {})
+        assert out.columns.to_list() == ["y", "percentile"]
+        np.testing.assert_array_equal(out["y"], [10, 20])
+
+    def test_plot_add(self):
+        from seaborn import objects as so
+
+        plot = so.Plot(pd.DataFrame({"x": [1, 2, 3, 4]}), "x").add(
+            so.Dots(), so.Perc(k=[25, 75])
+        )
+        assert isinstance(plot._layers[0]["stat"], Perc)
+
