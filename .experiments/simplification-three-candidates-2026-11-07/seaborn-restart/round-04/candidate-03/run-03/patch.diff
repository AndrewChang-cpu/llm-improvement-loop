@@ -0,0 +1,57 @@
+"""Statistical transforms that change the ordering of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels in [0, 100].
+    method : str
+        Method used to compute the percentile. Defaults to ``"linear"``. Other
+        options are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``,
+        ``"midpoint"``, and ``"nearest"``.
+
+    The output has one row per requested percentile per group, with the
+    percentile level in ``percentile`` and the computed value in the oriented
+    variable.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def __call__(self, data, groupby, orient, scales):
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        def percentile(part):
+            values = part[orient].dropna()
+            if Version(np.__version__) < Version("1.22.0"):
+                result = np.percentile(values, levels, interpolation=self.method)
+            else:
+                result = np.percentile(values, levels, method=self.method)
+            return pd.DataFrame({"percentile": levels, orient: result})
+
+        return groupby.apply(data, percentile)
