diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..55bc259
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,63 @@
+import numpy as np
+import pandas as pd
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count_and_levels(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4]})
+        result = Perc(3)(data, GroupBy(["group"]), "y", {})
+
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["x"].tolist() == [1, 2.5, 4]
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+        result = Perc([25, 75], method="lower")(
+            data, GroupBy(["group"]), "x", {}
+        )
+
+        assert result["percentile"].tolist() == [25, 75]
+        assert result["y"].tolist() == [1, 3]
+
+    def test_groups_and_order(self):
+
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "x": [1, 10, 3, 20],
+            "y": [100, 200, 300, 400],
+        })
+        result = Perc([0, 100])(
+            data, GroupBy(["group"]), "y", {}
+        )
+
+        assert result.columns.tolist() == ["group", "x", "percentile"]
+        assert result["group"].tolist() == ["b", "b", "a", "a"]
+        assert result["x"].tolist() == [1, 3, 10, 20]
+        assert result["percentile"].tolist() == [0, 100, 0, 100]
+
+    def test_orientation_and_missing(self):
+
+        data = pd.DataFrame({"group": ["a"] * 3, "x": [1, 2, 3], "y": [4, np.nan, 8]})
+        result = Perc([0, 100])(data, GroupBy(["group"]), "x", {})
+
+        assert result.columns.tolist() == ["group", "y", "percentile"]
+        assert result["y"].tolist() == [4, 8]
+        assert result["percentile"].tolist() == [0, 100]
+
+    def test_objects_import_and_plot_add(self):
+
+        assert so.Perc is Perc
+        plotter = so.Plot(x=[1, 1, 1], y=[3, 1, 2]).add(
+            so.Range(), so.Perc(3), orient="x"
+        ).plot()
+        result = plotter._layers[0]["data"].frame
+
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert np.allclose(result["y"], [1, 2, 3])
