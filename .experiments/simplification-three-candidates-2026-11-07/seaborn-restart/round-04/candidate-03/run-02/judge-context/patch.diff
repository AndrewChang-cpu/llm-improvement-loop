diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..1121db5
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,73 @@
+"""Statistical transforms that change the ordering of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of explicit percentile levels.
+    method : str
+        Method used to calculate the percentiles. The default, ``"linear"``,
+        interpolates between observations. Other choices follow NumPy's
+        ``percentile`` function: ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``, ``"hazen"``,
+        ``"weibull"``, ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns one row per requested percentile per group, with the percentile
+    value in the orientation-selected variable and its level in ``percentile``.
+
+    Examples
+    --------
+    .. code:: python
+
+        import seaborn.objects as so
+
+        # Default quartiles and endpoints
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc())
+
+        # Five evenly spaced percentile levels
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(5))
+
+        # Explicit percentile levels
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc([10, 50, 90]))
+
+        # Draw an interval spanning the 10th to 90th percentiles
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc([10, 90]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"method": self.method}
+        if Version(np.__version__) < Version("1.22.0"):
+            kwargs = {"interpolation": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
