new file mode 100644
index 0000000..62b6fb4
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,58 @@
+"""Statistical transforms that order observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, or explicit
+        percentile levels in that range.
+    method : str
+        Method used to compute percentiles, as described by
+        :func:`numpy.percentile`.
+
+    Notes
+    -----
+    The default method is ``linear``. NumPy also supports ``inverted_cdf``,
+    ``averaged_inverted_cdf``, ``closest_observation``,
+    ``interpolated_inverted_cdf``, ``hazen``, ``weibull``,
+    ``linear``, ``median_unbiased``, ``normal_unbiased``, ``lower``,
+    ``higher``, ``midpoint``, and ``nearest``.
+
+    The output has one row per requested percentile per group, with levels in
+    ``percentile`` and values in the oriented variable.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwarg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kw = {kwarg: self.method}
+
+        def percentile(part):
+            values = np.nanpercentile(part[var], levels, **kw)
+            return pd.DataFrame({"percentile": levels, var: values})
+
+        return groupby.apply(data, percentile)
