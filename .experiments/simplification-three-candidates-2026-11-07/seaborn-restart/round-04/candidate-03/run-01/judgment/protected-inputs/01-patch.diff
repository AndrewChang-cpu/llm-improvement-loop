diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0c4ad15
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,41 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Dots, Perc as ObjectsPerc, Plot
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        out = Perc()(data, GroupBy(["group"]), "x", {})
+        assert out.columns.tolist() == ["group", "y", "percentile"]
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert out["y"].tolist() == [1, 2, 3, 4, 5]
+
+    def test_count_method_and_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, np.nan]})
+        out = Perc(3, method="nearest")(data, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [0, 50, 100]
+        assert out["y"].tolist() == [1, 2, 3]
+
+    def test_groups_order_and_orientation(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [10, 1, 20, 3]})
+        out = Perc([0, 100])(data, GroupBy(["group"]), "y", {})
+        assert out.columns.tolist() == ["group", "x", "percentile"]
+        assert out["group"].tolist() == ["b", "b", "a", "a"]
+        assert out["x"].tolist() == [10, 20, 1, 3]
+
+    def test_explicit_levels_and_import(self):
+        assert ObjectsPerc is Perc
+        data = pd.DataFrame({"group": ["a", "a"], "y": [0, 10]})
+        out = Perc([25, 75])(data, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [25, 75]
+        assert out["y"].tolist() == [2.5, 7.5]
+
+    def test_plot_add(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["a"] * 4})
+        plot = Plot(data, x="x", y="y").add(Dots(), Perc())
+        assert plot.plot()._layers[0]["stat"] == Perc()
