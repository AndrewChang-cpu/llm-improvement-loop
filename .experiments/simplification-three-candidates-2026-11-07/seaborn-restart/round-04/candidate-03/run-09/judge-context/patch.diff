diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..22ea4ba
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,74 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3], "y": [1, 2, 3, 4]})
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_integer_count(self):
+        data = pd.DataFrame({"y": [0, 10]})
+        res = Perc(3)(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({"y": [0., 5., 10.], "percentile": [0., 50., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"y": [0, 10]})
+        res = Perc([25, 75], method="nearest")(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({"y": [0, 10], "percentile": [25, 75]})
+        assert_frame_equal(res, expected)
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [0, 10], "y": [1, 3]})
+        res = Perc(3)(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({"x": [0., 5., 10.], "percentile": [0., 50., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_groups_and_order(self):
+        data = pd.DataFrame({
+            "y": [1, 3, 10, 20],
+            "group": ["a", "a", "b", "b"],
+            "unused": [0, 1, 2, 3],
+        })
+        res = Perc(2)(data, GroupBy({"group": ["b", "a"]}), "x", {})
+        expected = pd.DataFrame({
+            "y": [10., 20., 1., 3.],
+            "group": ["b", "b", "a", "a"],
+            "percentile": [0., 100., 0., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_missing_data(self):
+        data = pd.DataFrame({"y": [1, np.nan, 3]})
+        res = Perc(3)(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({"y": [1., 2., 3.], "percentile": [0., 50., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_imports_and_plot_add(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as StatsPerc
+        from seaborn.objects import Perc as ObjectsPerc
+
+        assert ObjectsPerc is StatsPerc
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        plotter = so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc()).plot()
+        output = plotter._layers[0]["data"].frame
+        assert_frame_equal(
+            output[["x", "y", "percentile"]],
+            pd.DataFrame({
+                "x": [0.] * 5,
+                "y": [1., 1.75, 2.5, 3.25, 4.],
+                "percentile": [0., 25., 50., 75., 100.],
+            }),
+        )
