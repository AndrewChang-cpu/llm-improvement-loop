diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..da43fe8
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,63 @@
+"""Statistics that order observations by their values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels.
+    method : str
+        Method used to calculate the percentiles. The default, "linear", and
+        other options are described in :func:`numpy.percentile`: "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher", "midpoint",
+        and "nearest".
+
+    Notes
+    -----
+    The output has one row per requested percentile per group. The computed
+    values replace the variable on the value axis, and the corresponding levels
+    are recorded in the `percentile` column. Missing observations are ignored.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        percentile_arg = (
+            "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        )
+        percentile_kws = {percentile_arg: self.method}
+        values = np.percentile(data[var].dropna(), levels, **percentile_kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var).reset_index(drop=True)
