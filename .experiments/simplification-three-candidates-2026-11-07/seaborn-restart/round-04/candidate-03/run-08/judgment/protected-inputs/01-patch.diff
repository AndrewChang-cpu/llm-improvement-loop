diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..47574fe
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,47 @@
+import numpy as np
+import pandas as pd
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4]})
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+        assert res.columns.to_list() == ["x", "percentile"]
+        assert res["percentile"].to_list() == [0, 25, 50, 75, 100]
+        assert res["x"].to_list() == [0, 1, 2, 3, 4]
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 10]})
+        groupby = GroupBy(["group"])
+        counted = Perc(k=3)(data, groupby, "x", {})
+        explicit = Perc(k=[10, 90])(data, groupby, "x", {})
+        assert counted["percentile"].to_list() == [0, 50, 100]
+        assert counted["x"].to_list() == [0, 5, 10]
+        assert explicit["percentile"].to_list() == [10, 90]
+        assert explicit["x"].to_list() == [1, 9]
+
+    def test_group_order_and_missing(self):
+        data = pd.DataFrame({"x": [1, 3, np.nan, 10], "group": ["b", "b", "a", "a"]})
+        res = Perc(k=[0, 100])(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert res.columns.to_list() == ["x", "group", "percentile"]
+        assert res["group"].to_list() == ["a", "a", "b", "b"]
+        assert res["x"].to_list() == [10, 10, 1, 3]
+
+    def test_orientation_and_method(self):
+        data = pd.DataFrame({"y": [0, 1, 2, 3]})
+        res = Perc(k=[25, 75], method="lower")(data, GroupBy(["group"]), "y", {})
+        assert res["y"].to_list() == [0, 2]
+        assert res["percentile"].to_list() == [25, 75]
+
+    def test_public_import_and_plot_add(self):
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": [0, 1, 2, 3], "group": ["a", "a", "b", "b"]})
+        plot = so.Plot(data, x="x", color="group").add(so.Dots(), so.Perc(k=3))
+        result = plot._plot()._layers[0]["data"].frame
+        assert result.columns.to_list() == ["x", "color", "percentile"]
+        assert result["percentile"].to_list() == [0, 50, 100] * 2
