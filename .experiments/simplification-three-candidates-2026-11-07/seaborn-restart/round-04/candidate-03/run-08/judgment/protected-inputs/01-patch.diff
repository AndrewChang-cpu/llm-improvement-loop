diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..65d558d
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,46 @@
+"""Statistics that transform observations while preserving their order."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 through 100, or explicit
+        percentile levels in that range. The output has one row per level.
+    method : str
+        Method passed to :func:`numpy.percentile`. The default, ``"linear"``,
+        is one of NumPy's available choices: ``inverted_cdf``,
+        ``averaged_inverted_cdf``, ``closest_observation``,
+        ``interpolated_inverted_cdf``, ``hazen``, ``weibull``, ``linear``,
+        ``median_unbiased``, ``normal_unbiased``, ``lower``, ``higher``,
+        ``midpoint``, and ``nearest``.
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+    group_by_orient = True
+
+    def __call__(self, data, groupby, orient, scales):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(part):
+            values = part[orient]
+            param = "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+            kwargs = {param: self.method}
+            return pd.DataFrame({
+                orient: np.nanpercentile(values, levels, **kwargs),
+                "percentile": levels,
+            })
+
+        columns = [orient, *[key for key in groupby.order if key in data]]
+        return groupby.apply(data[columns], percentile)
