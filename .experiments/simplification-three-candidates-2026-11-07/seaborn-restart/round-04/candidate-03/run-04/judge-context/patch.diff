diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..b9f6f14
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,56 @@
+"""Statistics that operate on ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, or explicit
+        percentile levels in that range. The default of 5 produces quartiles.
+    method : str
+        Method used to calculate the percentile, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. NumPy supports
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Notes
+    -----
+    The output contains one row per requested percentile for each group. The
+    percentile values are in the orientation-selected variable, and the
+    corresponding levels are in the ``percentile`` column. Missing observations
+    are ignored.
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict,
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
