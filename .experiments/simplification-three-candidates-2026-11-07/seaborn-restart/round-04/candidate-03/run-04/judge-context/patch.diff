diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..b48b3ff
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,54 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Plot, Range
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_default_levels_and_values(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a"] * 5, "y": [1., 2., 3., 4., 5.],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count_levels_and_groups(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [1, 2, 3, 4]})
+        res = Perc(3)(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["b", "b", "b", "a", "a", "a"],
+            "y": [1., 2., 3., 2., 3., 4.],
+            "percentile": [0., 50., 100., 0., 50., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, np.nan, 4]})
+        res = Perc([0, 50, 100], method="nearest")(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "group": ["a"] * 3, "x": [1., 2., 4.], "percentile": [0, 50, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_orientation_and_import(self):
+        assert ObjectsPerc is Perc
+        data = pd.DataFrame({"group": ["a", "a"], "x": [2, 4]})
+        res = Perc(2)(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "group": ["a", "a"], "x": [2., 4.], "percentile": [0., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_plot_add(self):
+        data = pd.DataFrame({"group": ["a", "a", "b", "b"], "value": [1, 2, 3, 4]})
+        plot = Plot(data, x="group", y="value").add(Range(), Perc()).plot()
+        result = plot._layers[0]["data"].frame
+        assert result.columns.to_list() == ["x", "y", "percentile"]
+        assert result["percentile"].to_list() == [0, 25, 50, 75, 100] * 2
