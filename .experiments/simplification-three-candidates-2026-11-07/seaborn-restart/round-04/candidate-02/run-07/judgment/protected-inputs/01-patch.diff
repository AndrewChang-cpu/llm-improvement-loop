diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..8fada10
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,59 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn import objects as so
+
+
+class TestPerc:
+
+    def data(self):
+        return pd.DataFrame({
+            "x": ["b", "b", "b", "a", "a", "a"],
+            "y": [1, 2, 3, 10, 20, 30],
+            "group": ["z", "z", "z", "a", "a", "a"],
+        })
+
+    def test_default_levels_and_group_order(self):
+        data = self.data()
+        res = Perc()(data, GroupBy(["x", "group"]), "x", {})
+
+        assert list(res.columns) == ["x", "y", "group", "percentile"]
+        assert list(res["x"].unique()) == ["b", "a"]
+        assert list(res["percentile"].unique()) == [0, 25, 50, 75, 100]
+        assert list(res.loc[res.x == "b", "y"]) == [1, 1.5, 2, 2.5, 3]
+        assert list(res.loc[res.x == "a", "y"]) == [10, 15, 20, 25, 30]
+        assert list(res["group"].unique()) == ["z", "a"]
+
+    def test_integer_count(self):
+        data = self.data()
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert list(res["percentile"].unique()) == [0, 50, 100]
+
+    def test_explicit_levels_and_method(self):
+        data = self.data()
+        res = Perc(k=[10, 90], method="nearest")(
+            data, GroupBy(["x"]), "x", {},
+        )
+        assert list(res["percentile"].unique()) == [10, 90]
+        assert list(res.loc[res.x == "b", "y"]) == list(
+            np.percentile([1, 2, 3], [10, 90], method="nearest")
+        )
+
+    def test_horizontal_orientation(self):
+        data = self.data().rename(columns={"x": "y", "y": "x"})
+        res = Perc(k=2)(data, GroupBy(["y", "group"]), "y", {})
+        assert list(res.columns) == ["y", "x", "group", "percentile"]
+        assert list(res.loc[res.y == "b", "x"]) == [1, 3]
+
+    def test_missing_values(self):
+        data = self.data()
+        data.loc[0, "y"] = np.nan
+        res = Perc(k=2)(data, GroupBy(["x"]), "x", {})
+        assert list(res.loc[res.x == "b", "y"]) == [2, 3]
+
+    def test_objects_export_and_plot_add(self):
+        assert so.Perc is Perc
+        so.Plot(self.data(), x="x", y="y").add(so.Range(), so.Perc())
+
