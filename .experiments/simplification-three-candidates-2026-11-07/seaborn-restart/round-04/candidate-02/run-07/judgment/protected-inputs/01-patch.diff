diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..bee6f03
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,60 @@
+"""Statistics that return ordered values from observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    For each group, the output has one row per requested level. The value axis
+    contains the percentile value, and the ``percentile`` column records its
+    level.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels in that range. Defaults to five levels
+        at 0, 25, 50, 75, and 100.
+    method : str
+        Method used to calculate the percentiles. Defaults to "linear"; see
+        :func:`numpy.percentile` for the available methods: "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(self, data, groupby: GroupBy, orient: str, scales: dict[str, Scale]):
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        method = "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        var = {"x": "y", "y": "x"}[orient]
+
+        def percentile(part):
+            values = np.percentile(
+                part[var].dropna(), percentiles, **{method: self.method},
+            )
+            return pd.DataFrame({var: values, "percentile": percentiles})
+
+        return groupby.apply(data, percentile)
