diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..8216462
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,75 @@
+"""Statistics that transform observations into ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles between 0 and 100, inclusive,
+        or explicit percentile levels in that range. The default (5) gives
+        quintiles.
+    method : str
+        Method used to calculate the percentiles, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``; choices include
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    The output has one row per requested percentile per group. The computed
+    value is stored on the value axis and its level in ``percentile``.
+
+    Examples
+    --------
+    Default quintiles, and quartiles with endpoints::
+
+        import seaborn.objects as so
+        so.Plot(data, x="x").add(so.Dots(), so.Perc())
+        so.Plot(data, x="x").add(so.Dots(), so.Perc(k=[0, 25, 50, 75, 100]))
+
+    Request an integer number of levels or explicit endpoints::
+
+        so.Plot(data, x="x").add(so.Dots(), so.Perc(k=4))
+        so.Plot(data, x="x").add(so.Dots(), so.Perc(k=[0, 100]))
+
+    Combine percentile levels and a range mark to show an interval::
+
+        so.Plot(data, x="x").add(so.Range(), so.Perc(k=[25, 75]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kws = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        observations = data[var].dropna()
+        values = (
+            np.percentile(observations, percentiles, **kws)
+            if len(observations) else np.full(len(percentiles), np.nan)
+        )
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
