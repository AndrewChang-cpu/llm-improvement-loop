diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..13be7a3
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,47 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": ["b", "a", "b", "a"], "y": [4, 2, 8, 6]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": ["b"] * 5 + ["a"] * 5,
+            "y": [4., 5., 6., 7., 8., 2., 3., 4., 5., 6.],
+            "percentile": [0., 25., 50., 75., 100.] * 2,
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_method(self):
+        data = pd.DataFrame({"x": ["a", "a"], "y": [0, 10]})
+        result = Perc(k=3, method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["y"].tolist() == [0, 0, 10]
+
+    def test_explicit_levels_and_missing(self):
+        data = pd.DataFrame({"x": [1, 1, 2], "y": [np.nan, 2, np.nan]})
+        result = Perc(k=[0, 50, 100])(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100] * 2
+        assert result["y"].iloc[:3].tolist() == [2, 2, 2]
+        assert result["y"].iloc[3:].isna().all()
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"x": [1, 3], "y": ["a", "a"]})
+        result = Perc(k=[0, 100])(data, GroupBy(["y"]), "y", {})
+        assert result.columns.tolist() == ["x", "y", "percentile"]
+        assert result["x"].tolist() == [1, 3]
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = so.Plot(pd.DataFrame({"x": [1, 2]}), x="x").add(so.Dots(), so.Perc())
+        assert isinstance(plot, so.Plot)
