diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..57db7bb
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels_and_group_order(self):
+        data = pd.DataFrame({
+            "x": ["b", "b", "a", "a"],
+            "y": [1, 3, 10, 20],
+            "group": ["z", "z", "a", "a"],
+            "unused": [0, 1, 2, 3],
+        })
+        groupby = GroupBy({"x": ["a", "b"], "group": ["a", "z"]})
+
+        res = Perc()(data, groupby, "x", {})
+
+        expected = pd.DataFrame({
+            "x": ["a"] * 5 + ["b"] * 5,
+            "y": np.percentile([10, 20], np.linspace(0, 100, 5)).tolist()
+                 + np.percentile([1, 3], np.linspace(0, 100, 5)).tolist(),
+            "group": ["a"] * 5 + ["z"] * 5,
+            "percentile": np.tile(np.linspace(0, 100, 5), 2),
+        })
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1., 2., np.nan, 4.]})
+
+        res = Perc([0, 25, 100], method="nearest")(
+            data, GroupBy(["x"]), "x", {},
+        )
+
+        expected = pd.DataFrame({
+            "x": ["a"] * 3,
+            "y": [1., 1., 4.],
+            "percentile": [0, 25, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [5, 5, 5]})
+
+        res = Perc(3)(data, GroupBy(["y"]), "y", {})
+
+        expected = pd.DataFrame({
+            "x": [1., 2., 3.], "y": [5, 5, 5],
+            "percentile": np.linspace(0, 100, 3),
+        })
+        assert_frame_equal(res, expected)
+
+    def test_public_imports_and_plot_add(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = so.Plot(x=[1, 2, 3]).add(so.Dots(), so.Perc())
+        assert isinstance(plot._layers[0]["stat"], so.Perc)
