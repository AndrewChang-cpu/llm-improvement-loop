diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..2c49d67
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,62 @@
+"""Statistics that transform observations into ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or an
+        explicit list of percentile levels in the range 0 to 100.
+    method : str
+        Method used to calculate the percentile. Defaults to ``"linear"``.
+        Accepts ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        or ``"nearest"``, as in :func:`numpy.percentile`.
+
+    Notes
+    -----
+    The transform returns one row per requested percentile for each group,
+    with the percentile level in a ``percentile`` column.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data, var, levels, kws):
+        values = data[var].dropna()
+        percentiles = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer)) else self.k
+        )
+        kw = {"method": self.method}
+        if Version(np.__version__) < Version("1.22.0"):
+            kw = {"interpolation": self.method}
+        res = groupby.apply(data, self._percentile, var, levels, kw)
+        return res.reset_index(drop=True)
