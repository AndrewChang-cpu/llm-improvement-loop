diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..80f308e
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,47 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0] * 5, "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+        result = Perc(3)(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc([25, 75], "nearest")(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [25, 75]
+        assert result["y"].tolist() == [2, 3]
+
+    def test_orientation_and_missing(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [0, 0, 0]})
+        result = Perc([0, 50, 100])(data, GroupBy(["y"]), "y", {})
+        assert result["x"].tolist() == [1, 2, 3]
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, np.nan, 3, 5]})
+        result = Perc(3)(data, GroupBy(["x"]), "x", {})
+        assert result["y"].tolist() == [1, 3, 5]
+
+    def test_grouping_and_order(self):
+        data = pd.DataFrame({
+            "x": [0, 0, 0, 0], "group": ["b", "b", "a", "a"],
+            "y": [2, 4, 10, 20],
+        })
+        result = Perc([50])(data, GroupBy(["group", "x"]), "x", {})
+        assert result["group"].tolist() == ["b", "a"]
+        assert result["y"].tolist() == [3, 15]
+        assert result.columns.tolist() == ["x", "group", "y", "percentile"]
