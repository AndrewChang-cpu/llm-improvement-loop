diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..4ba12d8
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,89 @@
+"""Statistics that order or select observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        If an integer, request that many evenly spaced percentiles from 0 to
+        100. Otherwise, request the specified percentile levels.
+    method : str
+        Method used to compute the percentile, as in :func:`numpy.percentile`.
+        Choices include ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``. Defaults to ``"linear"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile in each group. The computed value is
+        stored on the orientation axis and the requested level is stored in a
+        ``percentile`` column.
+
+    Examples
+    --------
+    Use the default quartiles and endpoints:
+
+    .. plot::
+
+        from seaborn import objects as so
+        data = {"x": [1, 2, 3, 4, 5]}
+        so.Plot(data, x="x").add(so.Range(), so.Perc())
+
+    Request three percentile levels:
+
+    .. plot::
+
+        from seaborn import objects as so
+        data = {"x": [1, 2, 3, 4, 5]}
+        so.Plot(data, x="x").add(so.Range(), so.Perc(3))
+
+    Provide explicit percentile levels:
+
+    .. plot::
+
+        from seaborn import objects as so
+        data = {"x": [1, 2, 3, 4, 5]}
+        so.Plot(data, x="x").add(so.Range(), so.Perc([10, 50, 90]))
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: pd.DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        percentile_kw = {"method": self.method}
+        if Version(np.__version__) < Version("1.22.0"):
+            percentile_kw = {"interpolation": self.method}
+
+        def percentile(data: pd.DataFrame) -> pd.DataFrame:
+            values = data[var].dropna().to_numpy()
+            return pd.DataFrame({
+                var: np.percentile(values, percentiles, **percentile_kw),
+                "percentile": percentiles,
+            })
+
+        return groupby.apply(data, percentile).reset_index(drop=True)
