diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..58460f6
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,81 @@
+"""Statistical transforms that change the order of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values, one row per level.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels between 0 and 100. Defaults to 5.
+    method : str
+        Method used to calculate the percentiles. Defaults to ``"linear"``;
+        options are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    This transform returns one row for each requested level in each group,
+    with the percentile value in the orientation-selected coordinate and the
+    level in a ``percentile`` column. An integer ``k`` requests ``k`` evenly
+    spaced levels from 0 through 100, inclusive; a list gives explicit levels.
+
+    Examples
+    --------
+    Get quartiles and endpoints (the default):
+
+    .. code-block:: python
+
+        p = Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+
+    Request three equally spaced levels, or explicit levels:
+
+    .. code-block:: python
+
+        p = Plot(data, x="x", y="y").add(so.Dot(), so.Perc(3))
+        p = Plot(data, x="x", y="y").add(so.Dot(), so.Perc([10, 50, 90]))
+
+    Combine with a range mark to draw an interval:
+
+    .. code-block:: python
+
+        p = Plot(data, x="x", y="y").add(so.Range(), so.Perc([10, 90]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        kwargs = (
+            {"interpolation": self.method}
+            if Version(np.__version__) < Version("1.22.0")
+            else {"method": self.method}
+        )
+        return pd.DataFrame({
+            var: np.percentile(values, levels, **kwargs),
+            "percentile": levels,
+        })
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
