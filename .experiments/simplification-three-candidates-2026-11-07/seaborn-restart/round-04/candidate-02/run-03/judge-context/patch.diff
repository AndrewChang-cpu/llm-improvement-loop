diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0aa4c05
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+from seaborn.objects import Plot, Range
+
+
+class TestPerc:
+
+    def test_default_levels(self):
+        df = pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": [1, 2, 3, 4, 5]})
+        res = Perc()(df, GroupBy(["x"]), "x", {})
+
+        assert res.columns.to_list() == ["x", "y", "percentile"]
+        assert_array_equal(res["percentile"].unique(), [0, 25, 50, 75, 100])
+        assert_array_equal(res["y"].unique(), [1, 2, 3, 4, 5])
+
+    def test_count_and_explicit_levels(self):
+        df = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        groupby = GroupBy(["x"])
+
+        counted = Perc(3)(df, groupby, "x", {})
+        explicit = Perc([10, 50, 90])(df, groupby, "x", {})
+
+        assert_array_equal(counted["percentile"], [0, 50, 100])
+        assert_array_equal(explicit["percentile"], [10, 50, 90])
+        assert_array_equal(explicit["y"], [1.3, 2.5, 3.7])
+
+    def test_orientation_and_method(self):
+        df = pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, 20, 30, 40]})
+        df["group"] = "a"
+        groupby = GroupBy(["group"])
+
+        horizontal = Perc([25, 75], method="lower")(df, groupby, "x", {})
+        vertical = Perc([25, 75], method="higher")(df, groupby, "y", {})
+
+        assert_array_equal(horizontal["y"], [10, 30])
+        assert_array_equal(vertical["x"], [2, 4])
+
+    def test_grouping_order_and_missing_values(self):
+        df = pd.DataFrame({
+            "x": [1, 1, 1, 1], "y": [1, 2, np.nan, 4], "group": ["b", "b", "a", "a"]
+        })
+        res = Perc([0, 100])(df, GroupBy({"group": ["a", "b"]}), "x", {})
+
+        assert res.columns.to_list() == ["y", "group", "percentile"]
+        assert_array_equal(res["group"], ["a", "a", "b", "b"])
+        assert_array_equal(res["y"], [4, 4, 1, 2])
+        assert_array_equal(res["percentile"], [0, 100, 0, 100])
+
+    def test_public_import_and_plot_add(self):
+        assert ObjectsPerc is Perc
+        plot = Plot(pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3]}), x="x", y="y")
+        plot.add(Range(), Perc([10, 90]))
