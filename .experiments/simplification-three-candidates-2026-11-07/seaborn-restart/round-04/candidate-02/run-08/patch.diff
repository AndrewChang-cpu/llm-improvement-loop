diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..379f999
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,67 @@
+import numpy as np
+import pandas as pd
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+
+        data = pd.DataFrame({"group": ["b", "b", "a", "a"], "y": [0, 10, 2, 4]})
+        groupby = GroupBy({"group": ["b", "a"]})
+        res = Perc()(data, groupby, "x", {})
+
+        expected = pd.DataFrame({
+            "group": ["b"] * 5 + ["a"] * 5,
+            "y": [0, 2.5, 5, 7.5, 10, 2, 2.5, 3, 3.5, 4],
+            "percentile": [0, 25, 50, 75, 100] * 2,
+        })
+        expected["percentile"] = expected["percentile"].astype(float)
+        pd.testing.assert_frame_equal(res, expected)
+
+    def test_count(self):
+
+        data = pd.DataFrame({"group": ["a", "a"], "y": [0, 10]})
+        res = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+
+        assert res["percentile"].tolist() == [0, 50, 100]
+        assert res["y"].tolist() == [0, 5, 10]
+
+    def test_explicit_levels(self):
+
+        data = pd.DataFrame({"group": ["a", "a"], "y": [0, 10]})
+        res = Perc(k=[10, 90])(data, GroupBy(["group"]), "x", {})
+
+        assert res["percentile"].tolist() == [10, 90]
+        assert res["y"].tolist() == [1, 9]
+
+    def test_orientation(self):
+
+        data = pd.DataFrame({"x": [0, 10], "group": ["a", "a"]})
+        res = Perc(k=3)(data, GroupBy(["group"]), "y", {})
+
+        assert res.columns.tolist() == ["x", "group", "percentile"]
+        assert res["x"].tolist() == [0, 5, 10]
+
+    def test_method(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [0, 1, 2, 3]})
+        res = Perc(k=[50], method="nearest")(data, GroupBy(["group"]), "x", {})
+
+        assert res["y"].tolist() == [2]
+
+    def test_missing_values(self):
+
+        data = pd.DataFrame({"group": ["a"] * 3, "y": [0, np.nan, 10]})
+        res = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+
+        assert res["y"].tolist() == [0, 5, 10]
+
+    def test_imports_and_plot_add(self):
+
+        assert so.Perc is Perc
+        p = so.Plot(x=["a", "a", "b", "b"], y=[0, 1, 2, 3])
+        p.add(so.Dots(), so.Perc(k=3)).plot()
