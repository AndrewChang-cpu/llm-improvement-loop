diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..4d043b4
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,59 @@
+"""Statistics that return values in a specified order."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or a list of explicit percentile levels.
+    method : str
+        Method used to compute the percentiles. Defaults to ``"linear"`` and
+        accepts the methods supported by :func:`numpy.percentile`:
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns one row for each requested percentile in each group. The percentile
+    level is stored in the ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str, percentiles) -> DataFrame:
+        vals = data[var].dropna()
+        kwarg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {kwarg: self.method}
+        values = np.percentile(vals, percentiles, **kwargs)
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        return groupby.apply(data, self._compute, var, percentiles)
