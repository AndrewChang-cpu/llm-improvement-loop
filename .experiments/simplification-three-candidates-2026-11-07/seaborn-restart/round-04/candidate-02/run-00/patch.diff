diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5a966d4
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,52 @@
+
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Dots, Perc as ObjectsPerc, Plot
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5]})
+        res = Perc()(data, GroupBy(["missing"]), "y", {})
+        expected = pd.DataFrame({
+            "x": [1., 2., 3., 4., 5.],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5]})
+        res = Perc(3)(data, GroupBy(["missing"]), "y", {})
+        assert res["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5]})
+        res = Perc([10, 90])(data, GroupBy(["missing"]), "y", {})
+        assert res["percentile"].tolist() == [10, 90]
+        assert res["x"].tolist() == [1.4, 4.6]
+
+    def test_orientation_and_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3]})
+        res = Perc([50], method="lower")(data, GroupBy(["missing"]), "x", {})
+        assert res.loc[0, "y"] == 2
+        assert res.loc[0, "percentile"] == 50
+
+    def test_grouping_order_and_missing(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [2, 1, np.nan, 3]})
+        res = Perc([0, 100])(data, GroupBy({"group": ["a", "b"]}), "y", {})
+        assert res.columns.tolist() == ["group", "x", "percentile"]
+        assert res["group"].tolist() == ["a", "a", "b", "b"]
+        assert res["x"].tolist() == [1, 3, 2, 2]
+
+    def test_exports_and_plot_add(self):
+        assert ObjectsPerc is Perc
+        plot = Plot(pd.DataFrame({"x": [1, 2, 3]}), x="x").add(
+            Dots(), Perc()
+        )
+        assert isinstance(plot, Plot)
