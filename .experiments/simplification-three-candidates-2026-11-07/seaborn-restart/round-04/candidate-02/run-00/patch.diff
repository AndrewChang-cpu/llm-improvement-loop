diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..816d342
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,61 @@
+"""Statistics that transform observations into ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels.
+    method : str
+        Method used to compute the percentile, passed to :func:`numpy.percentile`.
+        Defaults to "linear". Choices include "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    Notes
+    -----
+    The result has one row per requested percentile per group. The percentile
+    level is recorded in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"interpolation": self.method}
+        if Version(np.__version__) >= Version("1.22.0"):
+            kwargs = {"method": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
