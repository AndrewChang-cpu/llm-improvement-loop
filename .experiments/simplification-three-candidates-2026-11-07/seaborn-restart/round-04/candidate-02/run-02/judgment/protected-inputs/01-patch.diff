diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..d47588b
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,66 @@
+"""Statistics that order or select observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels.
+    method : str
+        Method used to compute the percentile. Defaults to ``"linear"`` and
+        accepts ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, or ``"nearest"``.
+
+    Each output row represents one requested percentile. The percentile level
+    is stored in the ``percentile`` column, and the computed value is stored in
+    the column selected by the plot orientation.
+
+    Examples
+    --------
+    Add default quartiles to a plot::
+
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+
+    Request endpoints or a count of levels::
+
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=[0, 100]))
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=7))
+
+    Choose explicit levels, or combine with a range mark to show an interval::
+
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[10, 90]))
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def __call__(self, data, groupby, orient, scales):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(part):
+            param = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+            kwargs = {param: self.method}
+            values = np.percentile(part[orient].dropna(), levels, **kwargs)
+            return pd.DataFrame({orient: values, "percentile": levels})
+
+        return groupby.apply(data, percentile)
