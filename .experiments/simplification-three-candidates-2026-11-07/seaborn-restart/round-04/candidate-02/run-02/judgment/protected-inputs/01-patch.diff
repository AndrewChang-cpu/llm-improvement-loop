diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..88835f0
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,57 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def args(self):
+
+        class Scale:
+            scale_type = "continuous"
+
+        return GroupBy(["group"]), "x", {"x": Scale()}
+
+    def test_default_levels(self, args):
+
+        data = pd.DataFrame({"group": ["b"] * 4, "x": [1, 2, 3, 4]})
+        out = Perc()(data, *args)
+
+        assert_array_equal(out["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(out["x"], [1, 1.75, 2.5, 3.25, 4])
+        assert out.columns.tolist() == ["group", "x", "percentile"]
+
+    def test_integer_count_and_explicit_levels(self, args):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4]})
+        assert len(Perc(k=3)(data, *args)) == 3
+        out = Perc(k=[10, 50, 90])(data, *args)
+        assert_array_equal(out["percentile"], [10, 50, 90])
+
+    def test_orientation_and_method(self, args):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4], "y": [4, 3, 2, 1]})
+        out = Perc(k=[50], method="lower")(data, args[0], "y", {"y": args[2]["x"]})
+        assert out.loc[0, "y"] == 2
+        assert "x" not in out
+
+    def test_group_order_and_missing_values(self, args):
+
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [1, 10, np.nan, 20]})
+        out = Perc(k=[0, 100])(data, *args)
+        assert out["group"].tolist() == ["b", "b", "a", "a"]
+        assert_array_equal(out["x"], [1, 1, 10, 20])
+
+    def test_public_imports_and_plot_add(self):
+
+        import seaborn.objects as so
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+        plot = so.Plot(pd.DataFrame({"x": [1, 2, 3]}), x="x").add(so.Dots(), so.Perc())
+        assert isinstance(plot._layers[0]["stat"], Perc)
