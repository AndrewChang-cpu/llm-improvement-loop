diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..ea208b3
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,52 @@
+"""Statistical transformations for ordering observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, or an
+        explicit list of percentile levels.
+    method : str
+        Method used to compute the percentiles. Defaults to ``"linear"`` and
+        accepts ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Each group produces one row for each requested percentile. The value axis
+    contains the percentile value, and the ``percentile`` column contains its
+    level.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data, orient):
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kw = {"method" if Version(np.__version__) >= Version("1.22.0") else "interpolation": self.method}
+        values = np.percentile(data[orient].dropna(), percentiles, **kw)
+        return pd.DataFrame({orient: values, "percentile": percentiles})
+
+    def __call__(self, data, groupby: GroupBy, orient: str, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
