diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..bfddf65
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"y": [0, 10, 20, 30, 40]})
+        res = Perc()(data, GroupBy(["unused"]), "x", {})
+
+        assert res.columns.to_list() == ["y", "percentile"]
+        np.testing.assert_array_equal(res["percentile"], [0, 25, 50, 75, 100])
+        np.testing.assert_array_equal(res["y"], [0, 10, 20, 30, 40])
+
+    def test_integer_count_and_explicit_levels(self):
+        data = pd.DataFrame({"y": [0, 10, 20, 30, 40]})
+        gb = GroupBy(["unused"])
+
+        count = Perc(3)(data, gb, "x", {})
+        explicit = Perc([20, 80])(data, gb, "x", {})
+
+        np.testing.assert_array_equal(count["percentile"], [0, 50, 100])
+        np.testing.assert_array_equal(explicit["percentile"], [20, 80])
+        np.testing.assert_array_equal(explicit["y"], [8, 32])
+
+    def test_orientation_method_and_group_order(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"],
+            "y": [1, 2, 9, 10],
+            "group": ["g", "g", "g", "g"],
+            "unused": [1, 1, 1, 1],
+        })
+        res = Perc([50], method="lower")(data, GroupBy(["x", "group"]), "x", {})
+
+        assert res.columns.to_list() == ["x", "y", "group", "percentile"]
+        assert res[["x", "group"]].values.tolist() == [["b", "g"], ["a", "g"]]
+        np.testing.assert_array_equal(res["y"], [1, 2])
+        np.testing.assert_array_equal(res["percentile"], [50, 50])
+
+    def test_missing_data(self):
+        data = pd.DataFrame({"y": [1, np.nan, 9]})
+        res = Perc([0, 50, 100])(data, GroupBy(["unused"]), "x", {})
+
+        np.testing.assert_array_equal(res["y"], [1, 5, 9])
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"x": [3, 5], "y": ["a", "a"]})
+        res = Perc(3)(data, GroupBy(["y"]), "y", {})
+
+        assert res.columns.to_list() == ["x", "y", "percentile"]
+        np.testing.assert_array_equal(res["x"], [3, 4, 5])
+
+    def test_objects_export_and_plot_add(self):
+        from seaborn.objects import Dots, Plot
+
+        assert ObjectsPerc is Perc
+        plot = Plot(pd.DataFrame({"y": [1, 2, 3]}), y="y")
+        assert plot.add(Dots(), Perc()) is not None
