diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0398235
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,55 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5]})
+        res = Perc()(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "x": [1., 2., 3., 4., 5.], "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_integer_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 10]})
+        gb = GroupBy(["group"])
+        res = Perc(k=3)(data, gb, "y", {})
+        expected = pd.DataFrame({"x": [0., 5., 10.], "percentile": [0., 50., 100.]})
+        assert_frame_equal(res, expected)
+
+        res = Perc(k=[10, 90])(data, gb, "y", {})
+        expected = pd.DataFrame({"x": [1., 9.], "percentile": [10, 90]})
+        assert_frame_equal(res, expected)
+
+    def test_orientation_and_method(self):
+        data = pd.DataFrame({"group": ["a", "a"], "x": [0, 10], "y": [0, 3]})
+        res = Perc(k=[25, 75], method="nearest")(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a", "a"], "y": [0, 3], "percentile": [25, 75],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_grouping_order_and_missing(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"], "y": [4, 1, np.nan, 3],
+        })
+        res = Perc(k=[0, 100])(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a", "a", "b", "b"], "y": [1., 3., 4., 4.],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_imports_and_plot_add(self):
+        from seaborn import objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        assert isinstance(so.Plot({"x": [1, 2, 3, 4]}, "x").add(so.Dots(), so.Perc()), so.Plot)
