diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..f829ecc
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,67 @@
+"""Statistics that change the ordering or sampling of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, or explicit
+        percentile levels in that range. The default, 5, returns the minimum,
+        quartiles, and maximum.
+    method : str
+        Method used to calculate the percentiles. Defaults to ``"linear"``;
+        choices are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Notes
+    -----
+    The transform returns one row per requested percentile in each group,
+    with the calculated value in the orientation-selected variable and the
+    percentile level in a ``percentile`` column. An integer ``k`` requests
+    ``k`` evenly spaced levels from 0 through 100; a list gives explicit
+    levels.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        param = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {param: self.method}
+        values = np.nanpercentile(data[var], levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
