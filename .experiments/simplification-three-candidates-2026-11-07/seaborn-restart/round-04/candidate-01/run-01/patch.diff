diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..04ded58
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+from seaborn.objects import Plot, Range
+
+
+def test_imports():
+    assert PublicPerc is Perc
+
+
+def test_default_quartiles_and_group_order():
+    data = pd.DataFrame({
+        "x": ["b", "b", "a", "a"],
+        "y": [4, 8, 1, 5],
+        "group": ["first", "first", "second", "second"],
+        "unused": [1, 2, 3, 4],
+    })
+    groupby = GroupBy({"x": ["b", "a"], "group": ["first", "second"]})
+
+    result = Perc()(data, groupby, "x", {})
+
+    assert result.columns.tolist() == ["x", "y", "group", "percentile"]
+    assert result[["x", "group"]].drop_duplicates().values.tolist() == [
+        ["b", "first"], ["a", "second"],
+    ]
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+    np.testing.assert_allclose(result.loc[:4, "y"], [4, 5, 6, 7, 8])
+    np.testing.assert_allclose(result.loc[5:, "y"], [1, 2, 3, 4, 5])
+
+
+def test_count_and_explicit_levels_and_method():
+    data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [0, 1, 2, 3]})
+    groupby = GroupBy(["x"])
+
+    result = Perc(k=3)(data, groupby, "x", {})
+    assert result["percentile"].tolist() == [0, 50, 100]
+    np.testing.assert_allclose(result["y"], [0, 1.5, 3])
+
+    result = Perc(k=[25, 75], method="nearest")(data, groupby, "x", {})
+    assert result["percentile"].tolist() == [25, 75]
+    np.testing.assert_allclose(result["y"], [1, 2])
+
+
+def test_other_orientation_and_missing_values():
+    data = pd.DataFrame({"x": [1, 5, np.nan], "y": ["a", "a", "b"], "group": ["g"] * 3})
+    groupby = GroupBy(["y", "group"])
+
+    result = Perc(k=[0, 50, 100])(data, groupby, "y", {})
+
+    assert result.columns.tolist() == ["x", "y", "group", "percentile"]
+    assert result["y"].tolist() == ["a"] * 3 + ["b"] * 3
+    assert result["percentile"].tolist() == [0, 50, 100] * 2
+    np.testing.assert_allclose(result.loc[:2, "x"], [1, 3, 5])
+    assert result.loc[3:, "x"].isna().all()
+
+
+def test_plot_add_with_range_mark():
+    plot = Plot(x=["a", "a", "a", "a"], y=[1, 2, 3, 4]).add(Range(), Perc())
+    plot.plot()
