--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,65 @@
+"""Statistics that compute order statistics."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with their requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels in the range [0, 100].
+    method : str
+        Method used to calculate the percentiles. Defaults to ``"linear"``.
+        See :func:`numpy.percentile` for details. Available methods are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns one row for each requested percentile in each group. The value is
+    stored in the value-axis variable and the percentile level in a
+    ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data, var):
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+        values = data[var].dropna()
+
+        if not len(values):
+            values = [np.nan]
+
+        if Version(np.__version__) < Version("1.22.0"):
+            quantiles = np.percentile(values, levels, interpolation=self.method)
+        else:
+            quantiles = np.percentile(values, levels, method=self.method)
+
+        return pd.DataFrame({var: quantiles, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
