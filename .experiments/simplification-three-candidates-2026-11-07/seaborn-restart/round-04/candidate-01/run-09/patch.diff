diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..954f6ec
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,53 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+@pytest.fixture
+def data():
+    return pd.DataFrame({
+        "x": [1, 1, 1, 2, 2, 2],
+        "y": [1, 2, np.nan, 10, 20, 30],
+        "group": ["b", "b", "b", "a", "a", "a"],
+    })
+
+
+@pytest.mark.parametrize("orient", ["x", "y"])
+def test_percentiles(data, orient):
+    # Orientation is included in Plot's grouping variables.
+    if orient == "y":
+        data = data.assign(y=[1, 1, 1, 2, 2, 2], x=[1, 2, np.nan, 10, 20, 30])
+    groupby = GroupBy([orient, "group"])
+    res = Perc()(data, groupby, orient, {})
+
+    assert res.columns.tolist() == ["x", "y", "group", "percentile"]
+    assert res["group"].tolist() == ["b"] * 5 + ["a"] * 5
+    assert res["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+    value = {"x": "y", "y": "x"}[orient]
+    assert res[value].tolist() == [1, 1.25, 1.5, 1.75, 2, 10, 15, 20, 25, 30]
+
+
+def test_levels_and_method(data):
+    res = Perc([0, 50, 100], method="nearest")(
+        data, GroupBy(["x", "group"]), "x", {}
+    )
+    assert res["percentile"].tolist() == [0, 50, 100] * 2
+    assert res["y"].tolist() == [1, 1, 2, 10, 20, 30]
+
+
+def test_integer_count(data):
+    res = Perc(3)(data, GroupBy(["x", "group"]), "x", {})
+    assert res["percentile"].tolist() == [0, 50, 100] * 2
+
+
+def test_imports_and_plot_add(data):
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc is Perc
+    so.Plot(data, x="group", y="y").add(
+        so.Range(), so.Perc([25, 75])
+    ).plot()
