diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..2b1dfea
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,52 @@
+"""Statistical transforms that order or select observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, or explicit
+        percentile levels in that range. Defaults to 5, corresponding to the
+        minimum, quartiles, and maximum.
+    method : str
+        NumPy percentile method. Defaults to ``"linear"``. Other options are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``,
+        ``"midpoint"``, and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile and group, with the percentile value
+        in the orientation-selected column and its level in ``percentile``.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data, orient):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kw = {"method" if Version(np.__version__) >= Version("1.22.0") else "interpolation": self.method}
+        values = np.percentile(data[orient].dropna(), levels, **kw)
+        return pd.DataFrame({orient: values, "percentile": levels})
+
+    def __call__(self, data, groupby: GroupBy, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var)
