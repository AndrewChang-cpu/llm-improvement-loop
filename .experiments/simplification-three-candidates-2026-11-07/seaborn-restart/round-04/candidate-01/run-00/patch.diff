diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..c88fb81
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc, Plot, Range
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        res = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        groupby = GroupBy(["x"])
+        counted = Perc(3)(data, groupby, "x", {})
+        assert counted["percentile"].tolist() == [0, 50, 100]
+        explicit = Perc([10, 90])(data, groupby, "x", {})
+        assert explicit["percentile"].tolist() == [10, 90]
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        res = Perc([25], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [2]
+
+    def test_orientations_and_missing(self):
+        data = pd.DataFrame({"x": [0] * 3, "y": [1, np.nan, 3]})
+        vertical = Perc([0, 50, 100])(data, GroupBy(["x"]), "x", {})
+        assert vertical["y"].tolist() == [1, 2, 3]
+
+        horizontal_data = pd.DataFrame({"x": [1, np.nan, 3], "y": [0] * 3})
+        horizontal = Perc([0, 50, 100])(horizontal_data, GroupBy(["y"]), "y", {})
+        assert horizontal["x"].tolist() == [1, 2, 3]
+
+    def test_group_labels_order_and_columns(self):
+        data = pd.DataFrame({
+            "x": [2, 1, 2, 1], "y": [20, 10, 40, 30], "group": ["b", "a", "b", "a"],
+        })
+        res = Perc(2)(data, GroupBy(["x", "group"]), "x", {})
+        assert res.columns.tolist() == ["x", "y", "group", "percentile"]
+        assert list(zip(res.x, res.group, res.percentile)) == [
+            (1, "a", 0), (1, "a", 100), (2, "b", 0), (2, "b", 100),
+        ]
+
+    def test_public_import_and_plot_add(self):
+        assert PublicPerc is Perc
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        Plot(data, x="x", y="y").add(Range(), PublicPerc([25, 75])).plot()
+
