diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..7d7bf60
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,66 @@
+"""Statistics that transform data to order statistics."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn._core.scales import Scale
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 through 100, or explicit
+        percentile levels in that range.
+    method : str
+        Method used to calculate the percentiles. The default is "linear";
+        other options are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "median_unbiased", "normal_unbiased", "lower",
+        "higher", "midpoint", and "nearest".
+
+    The result has one row for each requested percentile in each group, with
+    the percentile value in the orientation-selected coordinate and the
+    requested level in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _process(self, data: DataFrame, var: str, levels) -> DataFrame:
+        values = data[var].dropna()
+        method_arg = (
+            "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        )
+        kws = {method_arg: self.method}
+        return pd.DataFrame({
+            var: np.percentile(values, levels, **kws),
+            "percentile": levels,
+        })
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+        return groupby.apply(data, self._process, var, levels).reset_index(drop=True)
