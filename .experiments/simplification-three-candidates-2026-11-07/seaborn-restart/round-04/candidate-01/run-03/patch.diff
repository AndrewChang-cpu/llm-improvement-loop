diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..c874e37
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,59 @@
+"""Statistical transforms that change the order or position of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or an
+        explicit list of percentile levels.
+    method : str
+        Method used to compute the percentile. The default, `linear`, is one
+        of the methods supported by :func:`numpy.percentile`: `inverted_cdf`,
+        `averaged_inverted_cdf`, `closest_observation`,
+        `interpolated_inverted_cdf`, `hazen`, `weibull`, `linear`,
+        `median_unbiased`, `normal_unbiased`, `lower`, `higher`, `midpoint`,
+        and `nearest`.
+
+    The output has one row per requested percentile and group, with the
+    percentile value in the orientation variable and the level in
+    `percentile`.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data, var):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kw = {"method" if Version(np.__version__) >= Version("1.22.0") else "interpolation": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kw)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: pd.DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
