diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..8d11120
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,42 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_default_percentiles():
+    data = pd.DataFrame({"y": [1, 2, 3, 4, 5]})
+    result = Perc()(data, GroupBy(["x"]), "x", {})
+    expected = pd.DataFrame({"y": [1., 2., 3., 4., 5.], "percentile": [0., 25., 50., 75., 100.]})
+    assert_frame_equal(result, expected)
+
+
+def test_percentile_count_and_method():
+    data = pd.DataFrame({"y": [0, 10]})
+    result = Perc(k=3, method="nearest")(data, GroupBy(["x"]), "x", {})
+    assert result["y"].tolist() == [0, 0, 10]
+    assert result["percentile"].tolist() == [0, 50, 100]
+
+
+def test_explicit_levels_horizontal_and_missing():
+    data = pd.DataFrame({"x": [0, 10, 20, np.nan], "group": ["b", "b", "a", "b"]})
+    result = Perc(k=[25, 75])(data, GroupBy(["group"]), "y", {})
+    expected = pd.DataFrame({
+        "x": [2.5, 7.5, 20, 20], "group": ["b", "b", "a", "a"],
+        "percentile": [25, 75, 25, 75],
+    })
+    assert_frame_equal(result, expected)
+
+
+def test_vertical_orientation_and_public_imports():
+    from seaborn.objects import Perc as PublicPerc, Plot, Range
+
+    data = pd.DataFrame({"x": [0, 10], "y": [1, 1], "group": ["a", "a"]})
+    result = Perc(k=[50])(data, GroupBy(["group"]), "y", {})
+    assert result.columns.tolist() == ["x", "group", "percentile"]
+    assert result["x"].tolist() == [5]
+    assert PublicPerc is Perc
+
+    Plot(data, x="y", y="x").add(Range(), PublicPerc(k=[25, 75])).plot()
