diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..147b33d
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,56 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels_and_groups(self):
+        data = pd.DataFrame({
+            "x": pd.Categorical(["b", "a", "b", "a"], ["a", "b"]),
+            "y": [1, 10, 3, 20],
+            "other": [0, 0, 0, 0],
+        })
+        groupby = GroupBy(["x"])
+
+        out = Perc()(data, groupby, "x", {})
+
+        assert list(out.columns) == ["x", "y", "percentile"]
+        assert out["x"].tolist() == ["a"] * 5 + ["b"] * 5
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+        np.testing.assert_allclose(out["y"], [10, 12.5, 15, 17.5, 20, 1, 1.5, 2, 2.5, 3])
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [1, 1, 1], "y": [1, 2, 5]})
+
+        count_out = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        levels_out = Perc(k=[10, 50, 90])(data, GroupBy(["x"]), "x", {})
+
+        assert count_out["percentile"].tolist() == [0, 50, 100]
+        assert levels_out["percentile"].tolist() == [10, 50, 90]
+        np.testing.assert_allclose(levels_out["y"], [1.2, 2, 4.4])
+
+    def test_method_and_missing_data(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, np.nan]})
+
+        out = Perc(k=[50], method="nearest")(data, GroupBy(["x"]), "x", {})
+
+        assert out["percentile"].tolist() == [50]
+        assert out["y"].tolist() == [2]
+
+    def test_horizontal_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": ["a", "a", "a"]})
+
+        out = Perc(k=[0, 50, 100])(data, GroupBy(["y"]), "y", {})
+
+        assert list(out.columns) == ["y", "x", "percentile"]
+        assert out["x"].tolist() == [1, 2, 3]
+
+    def test_plot_add_with_range(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        plot = so.Plot(["a", "a", "b", "b"], [1, 3, 2, 4])
+        plot.add(so.Range(), so.Perc(k=[25, 75])).plot()
