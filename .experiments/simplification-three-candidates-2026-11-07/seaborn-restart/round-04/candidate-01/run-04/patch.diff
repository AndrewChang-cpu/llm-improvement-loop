diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..b07d837
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,58 @@
+"""Statistics that replace observations with ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, or explicit
+        percentile levels in that range. Defaults to 5, which returns the
+        minimum, quartiles, and maximum.
+    method : str
+        Method used to calculate the percentiles. Defaults to "linear". See
+        :func:`numpy.percentile` for the available methods: "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher", "midpoint",
+        and "nearest".
+
+    The output contains one row for each requested percentile in each group,
+    with the value in the orientation-dependent coordinate and the level in
+    the ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    group_by_orient: ClassVar[bool] = True
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def _percentile(self, data, var, levels):
+        data = data.dropna(subset=[var])
+        key = "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        kws = {key: self.method}
+        values = np.percentile(data[var], levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        group_vars = [v for v in groupby.order if v in data]
+        data = data[group_vars + [var]]
+        return groupby.apply(data, self._percentile, var, levels)
