diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..fcdf1e5
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,84 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels_and_columns(self):
+
+        data = pd.DataFrame({
+            "x": [0, 1, 2, 3, 4],
+            "y": [8, 2, 6, 4, 0],
+            "group": "all",
+            "extra": 1,
+        })
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+
+        assert res.columns.to_list() == ["y", "group", "percentile"]
+        assert_array_equal(res["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(res["y"], [0, 2, 4, 6, 8])
+
+    def test_count_and_explicit_levels(self):
+
+        data = pd.DataFrame({
+            "x": range(5), "y": [0, 10, 20, 30, 40], "group": "all",
+        })
+        res = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(res["percentile"], [0, 50, 100])
+
+        res = Perc(k=[10, 90])(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(res["y"], [4, 36])
+        assert_array_equal(res["percentile"], [10, 90])
+
+    def test_method(self):
+
+        data = pd.DataFrame({"x": range(4), "y": [0, 10, 20, 30], "group": "all"})
+        res = Perc(k=[50], method="lower")(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(res["y"], [10])
+
+    @pytest.mark.parametrize(
+        "orient, group_var, value_var",
+        [("x", "x", "y"), ("y", "y", "x")],
+    )
+    def test_orientation_and_group_order(self, orient, group_var, value_var):
+
+        if orient == "y":
+            data = pd.DataFrame({
+                "x": [1, 3, 10, 20],
+                "y": ["b", "b", "a", "a"],
+                "label": ["B", "B", "A", "A"],
+            })
+        else:
+            data = pd.DataFrame({
+                "x": ["b", "b", "a", "a"],
+                "y": [1, 3, 10, 20],
+                "label": ["B", "B", "A", "A"],
+            })
+        groupby = GroupBy({"label": ["B", "A"], group_var: None})
+        res = Perc(k=2)(data, groupby, orient, {})
+
+        assert res.columns.to_list() == ["x", "y", "label", "percentile"]
+        assert res["label"].to_list() == ["B", "B", "A", "A"]
+        assert res[group_var].to_list() == ["b", "b", "a", "a"]
+        assert res[value_var].to_list() == [1, 3, 10, 20]
+        assert res["percentile"].to_list() == [0, 100, 0, 100]
+
+    def test_missing_observations(self):
+
+        data = pd.DataFrame({"x": [0, 1, 2], "y": [1, np.nan, 3], "group": "all"})
+        res = Perc(k=2)(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(res["y"], [1, 3])
+
+    def test_imports_and_plot_add(self):
+
+        import seaborn.objects as so
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+        data = pd.DataFrame({"group": ["a", "a", "b", "b"], "value": [1, 2, 3, 4]})
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc(k=[25, 75])).plot()
