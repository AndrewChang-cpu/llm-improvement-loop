diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..dd9a7b1
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values, retaining each level.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, or explicit
+        percentile levels in that range. Defaults to 5, producing endpoints
+        and quartiles.
+    method : str
+        Method used to calculate the percentile. Defaults to ``"linear"``.
+        The available methods are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``, ``"hazen"``,
+        ``"weibull"``, ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Notes
+    -----
+    The output has one row per requested percentile in each group, with the
+    percentile value in the orientation variable and its level in
+    ``percentile``. An integer `k` generates evenly spaced levels between 0
+    and 100 inclusive; a list specifies the levels directly.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data, var):
+
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+        param = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kws = {param: self.method}
+        values = np.percentile(data[var].dropna(), levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
