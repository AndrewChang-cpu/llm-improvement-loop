diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..c12191b
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,58 @@
+"""Statistics that replace observations with ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values computed within groups.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or an
+        explicit list of percentile levels in [0, 100]. The result contains
+        one row per requested level and group, with the level in
+        `percentile`.
+    method : str
+        Method used to compute the percentile. Defaults to `linear`. Options
+        follow :func:`numpy.percentile`: `inverted_cdf`,
+        `averaged_inverted_cdf`, `closest_observation`,
+        `interpolated_inverted_cdf`, `hazen`, `weibull`, `linear`,
+        `median_unbiased`, `normal_unbiased`, `lower`, `higher`, `midpoint`,
+        and `nearest`.
+
+    Examples
+    --------
+    .. include:: ../doc/_docstrings/objects.Perc.ipynb
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data, var):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+        else:
+            percentiles = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
