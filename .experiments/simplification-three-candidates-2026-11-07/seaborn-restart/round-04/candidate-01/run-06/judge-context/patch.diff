diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..be44b60
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,56 @@
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+
+        df = pd.DataFrame({"x": ["a"] * 4, "y": [10, 20, 30, 40]})
+        res = Perc()(df, GroupBy(["x"]), "x", {})
+
+        assert res["y"].tolist() == [10, 17.5, 25, 32.5, 40]
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert res.columns.tolist() == ["x", "y", "percentile"]
+
+    def test_count_and_method(self):
+
+        df = pd.DataFrame({"x": ["a"] * 3, "y": [0, 10, 20]})
+        res = Perc(3, "nearest")(df, GroupBy(["x"]), "x", {})
+
+        assert res["y"].tolist() == [0, 10, 20]
+        assert res["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels_and_missing(self):
+
+        df = pd.DataFrame({"x": ["a"] * 4, "y": [0, np.nan, 20, 30]})
+        res = Perc([25, 75])(df, GroupBy(["x"]), "x", {})
+
+        assert res["y"].tolist() == [10, 25]
+        assert res["percentile"].tolist() == [25, 75]
+
+    def test_groups_and_orientation(self):
+
+        df = pd.DataFrame({
+            "x": [1, 2, 3, 4], "y": [10, 10, 20, 20],
+            "group": ["b", "b", "a", "a"],
+        })
+        res = Perc([0, 100])(df, GroupBy(["y", "group"]), "y", {})
+
+        assert res.columns.tolist() == ["x", "y", "group", "percentile"]
+        assert res[["y", "group"]].drop_duplicates().values.tolist() == [
+            [10, "b"], [20, "a"],
+        ]
+        assert res["x"].tolist() == [1, 2, 3, 4]
+
+    def test_public_import_and_plot_add(self):
+
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        p = so.Plot(pd.DataFrame({"x": [1, 2, 3], "y": [3, 2, 1]}), x="x", y="y")
+        p.add(so.Range(), so.Perc([10, 90]))._plot()
