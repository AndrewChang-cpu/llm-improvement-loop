diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a6fa2e0
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,64 @@
+import numpy as np
+import pandas as pd
+
+from numpy.testing import assert_array_equal
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+
+        data = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 2, 3, 4]})
+        groupby = GroupBy(["x"])
+
+        result = Perc()(data, groupby, "x", {})
+
+        expected = pd.DataFrame({
+            "x": [0] * 5 + [1] * 5,
+            "y": [1, 1.25, 1.5, 1.75, 2, 3, 3.25, 3.5, 3.75, 4],
+            "percentile": [0., 25, 50, 75, 100] * 2,
+        })
+        assert_frame_equal(result, expected)
+
+        result = Perc(3)(data, groupby, "x", {})
+        assert_array_equal(result["percentile"], [0, 50, 100] * 2)
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [0, 1, 2, 10]})
+        groupby = GroupBy(["x"])
+
+        result = Perc([25, 75], method="nearest")(data, groupby, "x", {})
+
+        expected = pd.DataFrame({"x": [0, 0], "y": [1, 2], "percentile": [25, 75]})
+        assert_frame_equal(result, expected)
+
+    def test_vertical_orientation_and_missing(self):
+
+        data = pd.DataFrame({"x": [1, np.nan, 3], "y": [0, 0, 1], "group": ["a", "a", "b"]})
+        groupby = GroupBy(["y", "group"])
+
+        result = Perc([0, 50, 100])(data, groupby, "y", {})
+
+        expected = pd.DataFrame({
+            "x": [1., 1, 1, 3, 3, 3],
+            "y": [0, 0, 0, 1, 1, 1],
+            "group": ["a"] * 3 + ["b"] * 3,
+            "percentile": [0, 50, 100] * 2,
+        })
+        assert_frame_equal(result, expected)
+
+    def test_plot_add_with_mark(self):
+
+        import seaborn.objects as so
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+
+        data = pd.DataFrame({"x": ["a", "a", "b"], "y": [1, 2, 3]})
+        plot = so.Plot(data, x="x", y="y").add(so.Dots(), Perc())
+        plot.plot()
