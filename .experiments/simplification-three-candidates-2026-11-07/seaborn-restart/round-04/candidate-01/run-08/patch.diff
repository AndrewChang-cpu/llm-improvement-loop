diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..74ddb8b
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,65 @@
+"""Statistics that replace observations with ordered summaries."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or explicit percentile levels in that range.
+    method : str
+        Method used to calculate the percentile. The default, ``"linear"``,
+        interpolates between observations. NumPy also supports
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    The output has one row for each requested percentile and group, with the
+    percentile value on the value axis and its level in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str, levels: np.ndarray) -> DataFrame:
+        values = data[var].dropna().to_numpy()
+        kwargs = {"method": self.method}
+        if Version(np.__version__) < Version("1.22.0"):
+            kwargs = {"interpolation": self.method}
+        percentiles = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = np.asarray(self.k)
+        return groupby.apply(data, self._compute, var, levels).reset_index(drop=True)
