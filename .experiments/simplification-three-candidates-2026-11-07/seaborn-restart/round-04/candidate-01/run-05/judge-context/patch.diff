diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..510e00f
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,59 @@
+"""Statistical transforms that change the order or positions of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        An integer gives the number of evenly spaced percentile levels from 0
+        through 100. A list specifies the percentile levels directly.
+    method : str
+        Method used to compute the percentiles. The default is "linear". Other
+        options are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest". See :func:`numpy.percentile`.
+
+    Notes
+    -----
+    The transform returns one row for each requested percentile in each group.
+    The percentile value is stored in the orientation-selected coordinate and
+    the percentile level is stored in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        param = "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        kwargs = {param: self.method}
+        values = np.nanpercentile(data[var], levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var)
