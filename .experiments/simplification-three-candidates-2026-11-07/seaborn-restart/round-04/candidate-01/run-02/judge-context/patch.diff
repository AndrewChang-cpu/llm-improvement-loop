diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..e756c05
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,41 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_counts_and_values(self):
+        data = pd.DataFrame({"group": ["b", "b", "a", "a"], "x": [0, 1, 2, 3]})
+        res = Perc(k=3)(data, GroupBy(["group"]), "y", {})
+
+        assert list(res.columns) == ["group", "x", "percentile"]
+        assert list(res["group"]) == ["b"] * 3 + ["a"] * 3
+        np.testing.assert_allclose(res["x"], [0, .5, 1, 2, 2.5, 3])
+        np.testing.assert_allclose(res["percentile"], [0, 50, 100] * 2)
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3]})
+        res = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["y"]), "y", {},
+        )
+        np.testing.assert_allclose(res["x"], [1, 2])
+        np.testing.assert_allclose(res["percentile"], [25, 75])
+        assert list(res.columns) == ["x", "percentile"]
+
+    def test_horizontal_and_missing(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [4, np.nan, 8]})
+        res = Perc(k=[0, 100])(data, GroupBy(["x"]), "x", {})
+        assert list(res.columns) == ["x", "y", "percentile"]
+        assert list(res["x"]) == [1, 1, 2, 2, 3, 3]
+        np.testing.assert_allclose(res["y"], [4, 4, np.nan, np.nan, 8, 8], equal_nan=True)
+
+    def test_public_imports_and_plot_add(self):
+        from seaborn.objects import Perc as PublicPerc, Plot, Range
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert PublicPerc is InternalPerc
+        plot = Plot(pd.DataFrame({"x": [1, 2, 3]}), x="x").add(Range(), Perc())
+        assert plot._layers[0]["stat"] == Perc()
