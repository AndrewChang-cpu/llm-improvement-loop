diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..94512e0
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,80 @@
+"""Statistics that change the order or selected levels of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of explicit levels in that range. Defaults to 5.
+    method : str
+        Method used to compute the percentile, following
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Available methods
+        are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Notes
+    -----
+    The transform returns one row for each requested level in each group.
+    The selected coordinate contains the percentile value, and the
+    ``percentile`` column contains its level.
+
+    Examples
+    --------
+    Default quartiles and endpoints::
+
+        p = so.Plot(data, x="value").add(so.Range(), so.Perc())
+
+    Request an integer number of levels::
+
+        so.Plot(data, x="value").add(so.Range(), so.Perc(k=3))
+
+    Request explicit levels::
+
+        so.Plot(data, x="value").add(so.Range(), so.Perc(k=[10, 50, 90]))
+
+    Combine the endpoints with a range mark to show an interval::
+
+        so.Plot(data, x="value").add(so.Range(), so.Perc(k=[5, 95]))
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data, orient):
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        observations = data[orient].dropna()
+        if observations.empty:
+            observations = np.array([np.nan])
+        arg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {arg: self.method}
+        values = np.percentile(observations, levels, **kwargs)
+        return pd.DataFrame({orient: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
