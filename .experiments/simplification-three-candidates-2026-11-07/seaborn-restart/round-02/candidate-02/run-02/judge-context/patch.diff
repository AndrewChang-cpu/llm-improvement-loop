diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..b13ecfb
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": [1, 2, 3, 4, 5, 10, 20, 30, 40, 50],
+            "y": [5, 4, 3, 2, 1, 50, 40, 30, 20, 10],
+            "group": ["b"] * 5 + ["a"] * 5,
+        })
+
+    def test_default(self, df):
+        res = Perc()(df, GroupBy(["group"]), "x", {})
+
+        assert list(res.columns) == ["y", "group", "percentile"]
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+        assert res["group"].tolist() == ["b"] * 5 + ["a"] * 5
+        assert res.loc[:4, "y"].tolist() == [1, 2, 3, 4, 5]
+
+    @pytest.mark.parametrize("k, expected", [
+        (3, [0, 50, 100]),
+        ([10, 90], [10, 90]),
+    ])
+    def test_levels(self, df, k, expected):
+        res = Perc(k)(df, GroupBy(["group"]), "x", {})
+
+        assert res["percentile"].unique().tolist() == expected
+
+    def test_method_and_missing(self):
+        df = pd.DataFrame({"x": [0, 10, 20, np.nan], "group": "a"})
+        res = Perc([25, 50, 75], method="nearest")(
+            df, GroupBy(["group"]), "y", {},
+        )
+
+        assert res["x"].tolist() == [0, 10, 20]
+        assert res["percentile"].tolist() == [25, 50, 75]
+
+    def test_plot_add(self, df):
+        import seaborn.objects as so
+
+        plot = so.Plot(df, x="group", y="y").add(so.Dots(), so.Perc())
+        assert plot.plot() is not None
+
