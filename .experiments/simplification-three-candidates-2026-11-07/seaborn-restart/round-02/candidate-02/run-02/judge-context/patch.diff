+++ b/seaborn/_stats/order.py
@@ -0,0 +1,54 @@
+"""Statistics that reorder or select observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of percentile levels to compute. Defaults to 5.
+    method : str
+        Method used to calculate the percentile, as in :func:`numpy.percentile`.
+        Defaults to "linear". Valid choices are "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    The output has one row per requested level, with the percentile value and
+    its level in the `percentile` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: pd.DataFrame, var: str) -> pd.DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        if Version(np.__version__) < Version("1.22.0"):
+            kws = {"interpolation": self.method}
+        else:
+            kws = {"method": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
