diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..fe8a1d6
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,33 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "g": "a"})
+        result = Perc(k=3)(data, GroupBy(["g"]), "y", {})
+        assert_array_equal(result["x"], [1, 2.5, 4])
+        assert_array_equal(result["percentile"], [0, 50, 100])
+
+    def test_explicit_levels_and_missing(self):
+        data = pd.DataFrame({"x": [0, 10, np.nan, 30], "g": "a"})
+        result = Perc(k=[25, 75])(data, GroupBy(["g"]), "y", {})
+        assert_array_equal(result["x"], [5, 20])
+        assert_array_equal(result["percentile"], [25, 75])
+
+    def test_orientation_and_group_order(self):
+        data = pd.DataFrame({"x": [1, 2, 1, 2], "y": [10, 20, 30, 40], "g": ["b", "b", "a", "a"]})
+        result = Perc(k=[50])(data, GroupBy({"g": ["a", "b"]}), "x", {})
+        assert set(result.columns) == {"y", "percentile", "g"}
+        assert_array_equal(result["g"], ["a", "b"])
+        assert_array_equal(result["y"], [35, 15])
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 10, 20, 30], "g": "a"})
+        result = Perc(k=[25], method="nearest")(data, GroupBy(["g"]), "y", {})
+        assert_array_equal(result["x"], [10])
