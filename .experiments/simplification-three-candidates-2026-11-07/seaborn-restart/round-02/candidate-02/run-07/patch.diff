diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..abf4710
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,80 @@
+"""Ordering statistics."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    The output contains one row per requested level, with the percentile value
+    in the value variable and the level recorded in ``percentile``.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, or explicit
+        percentile levels. Each level produces one output row.
+    method : str
+        Method passed to :func:`numpy.percentile`. The default is ``"linear"``;
+        valid choices are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Examples
+    --------
+    Use the public ``so`` namespace to show quartiles and endpoints:
+
+    .. code-block:: python
+
+        import seaborn.objects as so
+        import pandas as pd
+
+        data = pd.DataFrame({"x": range(5), "y": [5, 1, 3, 2, 4]})
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+
+    Request a count or specific percentile levels:
+
+    .. code-block:: python
+
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Combine the transform with a range mark to show an interval:
+
+    .. code-block:: python
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[10, 90]))
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        method = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kws = {method: self.method}
+        values = np.percentile(data[var].dropna(), levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var).reset_index(drop=True)
