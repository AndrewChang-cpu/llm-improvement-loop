diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a918cee
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"group": "a", "y": [5, 1, 3, 2, 4]})
+        groupby = GroupBy(["group"])
+
+        res = Perc()(data, groupby, "x", {})
+        expected = pd.DataFrame({
+            "group": ["a"] * 5,
+            "y": np.percentile(data.y, [0, 25, 50, 75, 100]),
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+        res = Perc(k=3)(data, groupby, "x", {})
+        assert res.percentile.tolist() == [0, 50, 100]
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, np.nan, 3, 9]})
+        res = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["group"]), "x", {},
+        )
+        assert res.y.tolist() == [1, 9]
+        assert res.percentile.tolist() == [25, 75]
+
+    def test_grouping_order_and_orientation(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "x": [10, 20, 30, 40],
+            "y": [1, 2, 3, 4],
+        })
+        res = Perc(k=[0, 100])(data, GroupBy(["group"]), "y", {})
+        assert res.columns.tolist() == ["group", "x", "percentile"]
+        assert res.group.tolist() == ["b", "b", "a", "a"]
+        assert res.x.tolist() == [10, 30, 20, 40]
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [4, 3, 2, 1]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[10, 90]))
+        plot.plot()
