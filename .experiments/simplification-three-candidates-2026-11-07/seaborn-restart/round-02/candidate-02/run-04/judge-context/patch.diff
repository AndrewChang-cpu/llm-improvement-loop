diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..f13d5f6
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+
+        assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": [1, 1, 1], "y": [1, 2.5, 4], "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4]})
+        result = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {},
+        )
+
+        expected = pd.DataFrame({
+            "x": [1, 1], "y": [2, 3], "percentile": [25, 75],
+        })
+        assert_frame_equal(result, expected)
+
+    @pytest.mark.parametrize("orient,var", [("x", "y"), ("y", "x")])
+    def test_orientation_and_missing(self, orient, var):
+        data = pd.DataFrame({
+            "group": ["a", "a", "a"],
+            "x": [1, np.nan, 3],
+            "y": [10, np.nan, 30],
+        })
+        result = Perc(k=2)(data, GroupBy(["group"]), orient, {})
+
+        expected = [10, 30] if orient == "x" else [1, 3]
+        assert result[var].tolist() == expected
+        assert result["percentile"].tolist() == [0, 100]
+
+    def test_group_order(self):
+        data = pd.DataFrame({
+            "group": pd.Categorical(["b", "a", "b", "a"], ["a", "b"]),
+            "x": [1, 1, 1, 1],
+            "y": [2, 4, 6, 8],
+        })
+        result = Perc(k=2)(data, GroupBy(["group", "x"]), "x", {})
+
+        assert result["group"].tolist() == ["a", "a", "b", "b"]
+        assert result.columns.tolist() == ["group", "x", "y", "percentile"]
+
