diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..89cf81e
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,54 @@
+"""Ordering statistical transformations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of percentile levels to compute. The output has one row per
+        requested level.
+    method : str
+        Method used to calculate the percentiles, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Valid choices are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data, var, levels):
+        values = data[var].dropna()
+        kws = {"method" if Version(np.__version__) >= Version("1.22.0")
+               else "interpolation": self.method}
+        percentiles = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(self, data, groupby: GroupBy, orient: str, scales: dict[str, Scale]):
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+        return groupby.apply(data, self._percentile, var, levels)
