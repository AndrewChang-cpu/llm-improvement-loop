diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..be12bdb
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,54 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": [0] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        groupby = GroupBy(["x"])
+
+        result = Perc(3)(data, groupby, "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+        result = Perc([10, 90])(data, groupby, "x", {})
+        assert result["percentile"].tolist() == [10, 90]
+        assert result["y"].tolist() == [1.3, 3.7]
+
+    def test_method_missing_and_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, np.nan, 4], "y": [0, 0, 0, 0]})
+        result = Perc([25, 75], "nearest")(data, GroupBy(["y"]), "y", {})
+        assert result["x"].tolist() == [1, 4]
+        assert result["percentile"].tolist() == [25, 75]
+
+    def test_group_order(self):
+        data = pd.DataFrame({"x": [2, 1, 2, 1], "y": [20, 10, 40, 30]})
+        result = Perc(2)(data, GroupBy(["x"]), "x", {})
+
+        assert result["x"].tolist() == [1, 1, 2, 2]
+        assert result["y"].tolist() == [10, 30, 20, 40]
+
+
+def test_public_import_and_plot_add():
+    import seaborn.objects as so
+
+    data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+    plot = so.Plot(data, "x", "y").add(so.Range(), so.Perc([25, 75]))
+    plot.plot()
+    result = so.Perc([25, 75])(data, GroupBy(["x"]), "x", {})
+    assert np.allclose(result["y"], [1.75, 3.25])
