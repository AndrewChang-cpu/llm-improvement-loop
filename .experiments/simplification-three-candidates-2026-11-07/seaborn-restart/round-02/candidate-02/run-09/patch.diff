diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5d54f20
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,53 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 1, 2, 3]})
+        groupby = GroupBy(["x"])
+
+        default = Perc()(data, groupby, "x", {})
+        expected = pd.DataFrame({
+            "x": ["a"] * 5,
+            "y": [0, .75, 1.5, 2.25, 3],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(default, expected)
+
+        counted = Perc(k=3)(data, groupby, "x", {})
+        assert counted["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 1, np.nan, 3]})
+        result = Perc(k=[25, 50, 75], method="lower")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        assert result["y"].tolist() == [0, 1, 1]
+        assert result["percentile"].tolist() == [25, 50, 75]
+
+    def test_group_order_columns_and_orientation(self):
+        data = pd.DataFrame({
+            "group": ["a", "a", "b", "b"],
+            "x": [0, 10, 100, 110],
+            "y": [1, 2, 3, 4],
+            "unused": [1, 1, 1, 1],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy({"group": ["b", "a"]}), "y", {}
+        )
+        assert result.columns.tolist() == ["group", "x", "percentile"]
+        assert result["group"].tolist() == ["b", "b", "a", "a"]
+        assert result["x"].tolist() == [100, 110, 0, 10]
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": ["a", "a", "a"], "y": [0, 1, 2]})
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[10, 90])).plot()
