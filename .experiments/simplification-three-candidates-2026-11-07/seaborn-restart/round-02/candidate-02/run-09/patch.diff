diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..af7c039
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,61 @@
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or a list of percentile levels to compute. Defaults to 5 (quartiles and
+        endpoints).
+    method : str
+        Method used to calculate the percentiles, passed to
+        :func:`numpy.percentile`. Defaults to "linear". Valid choices are
+        "inverted_cdf", "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher", "midpoint",
+        and "nearest".
+
+    Each input group produces one row per requested percentile. The value
+    column contains the percentile value, and `percentile` contains its level.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: pd.DataFrame, var: str) -> pd.DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        param = (
+            "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        )
+        kwargs = {param: self.method}
+        result = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: pd.DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
