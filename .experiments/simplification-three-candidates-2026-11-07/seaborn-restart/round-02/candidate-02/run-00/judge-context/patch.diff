diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..3d01b62
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2.5, 4], "percentile": [0., 50., 100.]})
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 4]})
+        result = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        expected = pd.DataFrame({"x": [0, 0], "y": [1, 4], "percentile": [25, 75]})
+        assert_frame_equal(result, expected)
+
+    def test_missing_values_and_vertical_orientation(self):
+        data = pd.DataFrame({"x": [1, np.nan, 3], "y": [0, 0, 0]})
+        result = Perc(k=[0, 100])(data, GroupBy(["y"]), "y", {})
+        expected = pd.DataFrame({"x": [1., 3.], "y": [0, 0], "percentile": [0, 100]})
+        assert_frame_equal(result, expected)
+
+    def test_groups_preserve_order_and_labels(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"],
+            "y": [1, 10, 3, 30],
+            "group": ["z", "z", "a", "a"],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["group", "x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": ["b", "b", "a", "a", "b", "b", "a", "a"],
+            "y": [1., 1., 10., 10., 3., 3., 30., 30.],
+            "group": ["z", "z", "z", "z", "a", "a", "a", "a"],
+            "percentile": [0, 100, 0, 100, 0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [1, 2, 3, 4]})
+        assert isinstance(so.Perc(), Perc)
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc()).plot()
