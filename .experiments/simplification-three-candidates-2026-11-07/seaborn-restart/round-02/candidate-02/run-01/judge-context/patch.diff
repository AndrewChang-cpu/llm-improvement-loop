diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a8b4176
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,89 @@
+"""Statistics that transform observations into ordered summaries."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels to compute. Defaults to 5, yielding
+        quartiles and the endpoints.
+    method : str
+        Method used to estimate percentiles, passed to :func:`numpy.percentile`.
+        Defaults to "linear". Valid choices are "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    Returns one row per requested level, with the percentile value in the
+    value variable and the level in a ``percentile`` column.
+
+    Examples
+    --------
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+    Use the default quartiles and endpoints:
+
+    .. code-block:: python
+
+        (so.Plot(data, x="x", y="y")
+         .add(so.Dots(), so.Perc()))
+
+    Request three levels or specify them directly:
+
+    .. code-block:: python
+
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=3))
+        so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=[10, 50, 90]))
+
+    Combine ``Perc`` with a range mark to show an interval:
+
+    .. code-block:: python
+
+        (so.Plot(data, x="x", y="y")
+         .add(so.Range(), so.Perc(k=[5, 95])))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        method_kw = (
+            {"interpolation": self.method}
+            if Version(np.__version__) < Version("1.22.0")
+            else {"method": self.method}
+        )
+        values = np.percentile(values, levels, **method_kw)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
