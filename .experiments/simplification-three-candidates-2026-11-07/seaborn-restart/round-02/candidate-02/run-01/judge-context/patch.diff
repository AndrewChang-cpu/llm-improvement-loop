diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..2dd721a
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,79 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        res = Perc()(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": [0] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+        counted = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert counted["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(k=[25, 75], method="lower")(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": [0, 0], "y": [1, 3], "percentile": [25, 75],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_vertical_orientation(self):
+
+        data = pd.DataFrame({"y": [0, 0, 0], "x": [2, 4, 8]})
+        res = Perc(k=[0, 50, 100])(data, GroupBy(["y"]), "y", {})
+
+        expected = pd.DataFrame({
+            "y": [0, 0, 0], "x": [2., 4., 8.], "percentile": [0, 50, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_group_order_and_missing_values(self):
+
+        data = pd.DataFrame({
+            "x": pd.Categorical(["b", "a", "b", "a"], categories=["a", "b"]),
+            "y": [np.nan, 5, 3, 1],
+            "unused": [10, 20, 30, 40],
+        })
+        res = Perc(k=[0, 100])(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": ["a", "a", "b", "b"],
+            "y": [1, 5, 3, 3],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert res.columns.tolist() == ["x", "y", "percentile"]
+        assert res["x"].tolist() == expected["x"].tolist()
+        assert res["y"].tolist() == expected["y"].tolist()
+        assert res["percentile"].tolist() == expected["percentile"].tolist()
+
+    def test_rejects_numpy_invalid_method(self):
+
+        data = pd.DataFrame({"x": [0, 0], "y": [1, 2]})
+        with pytest.raises(ValueError):
+            Perc(method="invalid")(data, GroupBy(["x"]), "x", {})
+
+
+def test_public_import_and_plot_add():
+
+    import seaborn.objects as so
+
+    data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+    plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[5, 95]))
+    plot.plot()
