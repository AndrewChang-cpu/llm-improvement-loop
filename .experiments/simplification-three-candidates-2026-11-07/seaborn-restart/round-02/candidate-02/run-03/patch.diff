diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..2ce6808
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,76 @@
+"""Statistics for ordering and percentile transforms."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels.
+    method : str
+        Method used to calculate the percentiles. This is passed to
+        :func:`numpy.percentile`; the default is ``"linear"``. Choices include
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns one row for each requested level, with the percentile value and
+    its level in a ``percentile`` column. These rows can be used directly with
+    marks such as :class:`Range` to show an interval.
+
+    Examples
+    --------
+    Use the public ``so`` namespace to draw quartiles and endpoints (the
+    default is five levels):
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc())
+
+    Choose a number of evenly spaced levels, or specify levels directly:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc(k=10))
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Combine the transform with a range mark to show an interval:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc(k=[2.5, 97.5]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(self, data, groupby, orient, scales):
+
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        method = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+
+        def percentile(data):
+            values = data[var].dropna()
+            result = np.percentile(values, levels, **{method: self.method})
+            return pd.DataFrame({var: result, "percentile": levels})
+
+        return groupby.apply(data, percentile)
