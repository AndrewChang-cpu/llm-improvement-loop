diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..ad5fdd2
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,36 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+
+
+class TestPerc:
+
+    def test_public_import(self):
+        assert PublicPerc is Perc
+
+    def test_default_count(self):
+        data = pd.DataFrame({"y": [0, 1, 2, 3, 4]})
+        out = Perc()(data.assign(group="a"), GroupBy(["group"]), "x", {})
+        assert_array_equal(out["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(out["y"], [0, 1, 2, 3, 4])
+        assert out["group"].tolist() == ["a"] * 5
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"x": [0, 10, np.nan, 30], "group": ["a"] * 4})
+        out = Perc(k=[0, 50, 100], method="nearest")(
+            data, GroupBy(["group"]), "y", {}
+        )
+        assert_array_equal(out["percentile"], [0, 50, 100])
+        assert_array_equal(out["x"], [0, 10, 30])
+        assert out.columns.tolist() == ["x", "group", "percentile"]
+
+    def test_group_order(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [1, 10, 3, 20]})
+        out = Perc(k=2)(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert out["group"].tolist() == ["a", "a", "b", "b"]
+        assert_array_equal(out["y"], [10, 20, 1, 3])
+
