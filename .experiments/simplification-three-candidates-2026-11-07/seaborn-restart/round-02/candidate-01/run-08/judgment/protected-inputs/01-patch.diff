diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..c89e6bd
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,42 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        df = pd.DataFrame({"group": ["a"] * 4, "y": [2, 4, 6, 8]})
+        res = Perc()(df, GroupBy(["group"]), "x", {})
+        assert list(res.columns) == ["group", "y", "percentile"]
+        assert res["group"].tolist() == ["a"] * 5
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert res["y"].tolist() == [2, 3.5, 5, 6.5, 8]
+
+    def test_explicit_levels_and_group_order(self):
+        df = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [2, 1, 4, 3]})
+        res = Perc([0, 50, 100])(df, GroupBy({"group": ["a", "b"]}), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a", "a", "a", "b", "b", "b"],
+            "y": [1., 2., 3., 2., 3., 4.],
+            "percentile": [0, 50, 100, 0, 50, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count_method_missing_and_orientation(self):
+        df = pd.DataFrame({
+            "group": ["a"] * 4, "x": [1., 2., np.nan, 8.], "y": [1, 2, 3, 4],
+        })
+        res = Perc(3, method="nearest")(df, GroupBy(["group"]), "y", {})
+        assert list(res.columns) == ["group", "x", "percentile"]
+        assert res["x"].tolist() == [1, 2, 8]
+        assert res["percentile"].tolist() == [0, 50, 100]
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        so.Plot(pd.DataFrame({"y": [1, 2, 3]}), y="y").add(so.Dot(), so.Perc())
