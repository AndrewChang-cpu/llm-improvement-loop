new file mode 100644
index 0000000..0d98779
--- /dev/null
+++ b/doc/_docstrings/objects.Perc.rst
@@ -0,0 +1,23 @@
+.. plot::
+
+    import seaborn as sns
+    import seaborn.objects as so
+
+    penguins = sns.load_dataset("penguins")
+
+    # The default gives quartiles and endpoints.
+    so.Plot(penguins, x="species", y="body_mass_g").add(so.Dot(), so.Perc())
+
+    # Request a count of evenly spaced levels or explicit percentile levels.
+    so.Plot(penguins, x="species", y="body_mass_g").add(so.Dot(), so.Perc(k=3))
+    so.Plot(penguins, x="species", y="body_mass_g").add(
+        so.Dot(), so.Perc(k=[10, 50, 90])
+    )
+
+    # Combine with Range to draw the interquartile interval.
+    so.Plot(penguins, x="species", y="body_mass_g").add(
+        so.Range(), so.Perc(k=[25, 75])
+    )
+
+Percentiles are returned as rows: each row has the percentile value and its
+level in the ``percentile`` column. They are not a point estimate or interval.
