diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..34924e0
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,82 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "x": [1, 2, 3, 4, 5]})
+        result = Perc()(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "group": ["a"] * 5,
+            "x": [1., 2., 3., 4., 5.],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        count = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert count["percentile"].tolist() == [0, 50, 100]
+        assert count["y"].tolist() == [1, 3, 5]
+
+        levels = [10, 90]
+        result = Perc(k=levels)(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a", "a"], "y": [1.4, 4.6], "percentile": levels,
+        })
+        assert_frame_equal(result, expected)
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 3, "y": [1, np.nan, 4]})
+        result = Perc(k=[25, 50, 75], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        expected = pd.DataFrame({
+            "group": ["a"] * 3, "y": [1., 1., 4.], "percentile": [25, 50, 75],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_orientation(self):
+        data = pd.DataFrame({
+            "orientation": ["x", "x", "y", "y"],
+            "x": [2, 4, 2, 4],
+            "y": [10, 20, 10, 20],
+        })
+        groupby = GroupBy({"orientation": ["x", "y"]})
+
+        horizontal = Perc(k=2)(data, groupby, "x", {})
+        vertical = Perc(k=2)(data, groupby, "y", {})
+
+        assert horizontal["orientation"].tolist() == ["x", "x", "y", "y"]
+        assert horizontal["y"].tolist() == [10, 20, 10, 20]
+        assert vertical["orientation"].tolist() == ["x", "x", "y", "y"]
+        assert vertical["x"].tolist() == [2, 4, 2, 4]
+
+    def test_grouping_order_and_columns(self):
+        data = pd.DataFrame({
+            "group": ["b", "b", "a", "a"],
+            "y": [10, 20, 30, 40],
+            "unused": [0, 0, 0, 0],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy({"group": ["a", "b"]}), "x", {}
+        )
+        expected = pd.DataFrame({
+            "group": ["a", "a", "b", "b"],
+            "y": [30., 40., 10., 20.],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_public_import_and_plot_add(self):
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        plot = so.Plot(data, x="x", y="y")
+        plot.add(so.Range(), so.Perc(k=[25, 75])).plot()
