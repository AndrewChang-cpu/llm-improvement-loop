diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..9db8667
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,68 @@
+"""Statistics that compute values at selected levels of a distribution."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from pandas import DataFrame
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with values at specified percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to calculate the percentile, as in :func:`numpy.percentile`.
+        Defaults to "linear". Valid choices are "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    The result contains one row for each requested percentile in each group,
+    with the percentile value and its level. These are percentile rows, not a
+    point estimate or interval. For example::
+
+        import seaborn.objects as so
+
+        p = so.Plot(data, x="group", y="x")
+        p.add(so.Dots(), so.Perc())  # Default quartiles and endpoints
+        p.add(so.Dots(), so.Perc(k=3))  # Three evenly spaced levels
+        p.add(so.Dots(), so.Perc(k=[10, 50, 90]))  # Explicit levels
+        p.add(so.Range(), so.Perc(k=[25, 75]))  # An interval
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str, levels: list[float]) -> DataFrame:
+        values = data[var].dropna()
+        kwargs = {"interpolation": self.method}
+        if Version(np.__version__) >= Version("1.22.0"):
+            kwargs = {"method": self.method}
+        percentiles = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        return groupby.apply(data, self._compute, var, levels)
