diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..733a787
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def args(self):
+        class Scale:
+            scale_type = "continuous"
+
+        return GroupBy(["group"]), "x", {"x": Scale()}
+
+    def test_default_levels(self, args):
+        data = pd.DataFrame({"y": [1, 2, 3, 4, 5]})
+        out = Perc()(data, *args)
+        assert out.columns.tolist() == ["y", "percentile"]
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert out["y"].tolist() == [1, 2, 3, 4, 5]
+
+    def test_integer_count_and_explicit_levels(self, args):
+        data = pd.DataFrame({"y": [0, 10]})
+        assert Perc(k=3)(data, *args)["percentile"].tolist() == [0, 50, 100]
+        out = Perc(k=[10, 90])(data, *args)
+        assert out["percentile"].tolist() == [10, 90]
+        assert out["y"].tolist() == [1, 9]
+
+    def test_method_and_missing_values(self, args):
+        data = pd.DataFrame({"y": [0, 10, np.nan]})
+        out = Perc(k=[25, 75], method="nearest")(data, *args)
+        assert out["y"].tolist() == [0, 10]
+
+    def test_orientation_and_group_order(self):
+        data = pd.DataFrame({
+            "group": ["b", "b", "a", "a"],
+            "x": [1, 1, 2, 2],
+            "y": [10, 20, 30, 40],
+        })
+        groupby = GroupBy(["x", "group"])
+        out = Perc(k=[50])(data, groupby, "x", {})
+        assert out.columns.tolist() == ["group", "x", "y", "percentile"]
+        assert out["x"].tolist() == [1, 2]
+        assert out["group"].tolist() == ["b", "a"]
+        assert out["y"].tolist() == [15, 35]
+
+        vertical = Perc(k=[50])(
+            pd.DataFrame({"x": [0, 10]}), GroupBy(["group"]), "y", {},
+        )
+        assert vertical.columns.tolist() == ["x", "percentile"]
+        assert vertical["x"].tolist() == [5]
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        plot = so.Plot(x=["a"] * 4, y=[1, 2, 3, 4])
+        plot = plot.add(so.Range(), so.Perc(k=[25, 75]))
+        plot.plot()
