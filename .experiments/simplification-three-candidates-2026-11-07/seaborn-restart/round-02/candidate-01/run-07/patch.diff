diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a8e294e
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,62 @@
+"""Statistics that order or select observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100 inclusive, or
+        a list of percentile levels to compute directly. The output contains
+        one row per level, with the percentile value and its level in the
+        ``percentile`` column.
+    method : str
+        Method used to calculate the percentiles, as in
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Valid choices are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        percentiles = (
+            np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        )
+        key = (
+            "method" if Version(np.__version__) >= Version("1.22.0")
+            else "interpolation"
+        )
+        kws = {key: self.method}
+        values = np.nanpercentile(data[var], percentiles, **kws)
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
