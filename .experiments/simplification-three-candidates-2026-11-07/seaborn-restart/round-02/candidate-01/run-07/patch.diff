diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0d15093
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,73 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        res = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": ["a"] * 5,
+            "y": [1., 2., 3., 4., 5.],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count_and_levels(self):
+        data = pd.DataFrame({"x": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        groupby = GroupBy(["x"])
+
+        count = Perc(3)(data, groupby, "x", {})
+        assert count["percentile"].tolist() == [0, 50, 100]
+        assert count["y"].tolist() == [1, 3, 5]
+
+        levels = Perc([10, 90])(data, groupby, "x", {})
+        assert levels["percentile"].tolist() == [10, 90]
+        assert levels["y"].tolist() == [1.4, 4.6]
+
+    def test_method(self):
+        data = pd.DataFrame({"x": ["a"] * 2, "y": [0, 10]})
+        res = Perc([25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [0, 10]
+
+    def test_orientations_and_missing(self):
+        data = pd.DataFrame({"x": [1, 1, 1], "y": [2., np.nan, 6.]})
+        vertical = Perc(2)(data, GroupBy(["x"]), "x", {})
+        assert vertical.columns.tolist() == ["x", "y", "percentile"]
+        assert vertical["y"].tolist() == [2, 6]
+
+        data["group"] = "a"
+        horizontal = Perc(2)(data, GroupBy(["group"]), "y", {})
+        assert horizontal.columns.tolist() == ["x", "group", "percentile"]
+        assert horizontal["x"].tolist() == [1, 1]
+
+    def test_group_order_and_labels(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "x": [1, 1, 1, 1],
+            "y": [10, 1, 20, 3],
+            "unused": [0, 0, 0, 0],
+        })
+        res = Perc([50])(data, GroupBy(["group", "x"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["b", "a"], "x": [1, 1], "y": [15., 2.],
+            "percentile": [50, 50],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_public_imports_and_plot_add(self):
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        data = pd.DataFrame({"group": ["a"] * 4, "value": [1, 2, 3, 4]})
+        plot = so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc([25, 75])
+        )
+        plot.plot()
