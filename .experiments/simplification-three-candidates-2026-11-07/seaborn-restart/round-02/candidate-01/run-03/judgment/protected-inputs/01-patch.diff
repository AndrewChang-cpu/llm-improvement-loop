diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..1dd05f8
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,57 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_counts_and_levels(self):
+        data = pd.DataFrame({"x": range(5), "y": [0] * 5})
+
+        res = Perc()(data, GroupBy(["y"]), "y", {})
+
+        assert_frame_equal(
+            res,
+            pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": [0] * 5,
+                          "percentile": [0, 25, 50, 75, 100]}),
+            check_dtype=False,
+        )
+        assert len(Perc(k=3)(data, GroupBy(["y"]), "y", {})) == 3
+        res = Perc(k=[10, 50, 90])(data, GroupBy(["y"]), "y", {})
+        assert res["percentile"].tolist() == [10, 50, 90]
+
+    def test_grouping_orientation_and_missing(self):
+        data = pd.DataFrame({
+            "x": [1, 3, 5, 2, 4, 6], "y": [0, 0, 0, 1, 1, 1],
+            "group": ["b", "b", "b", "a", "a", "a"],
+            "orient": ["x"] * 6, "unused": list("abcdef"),
+        })
+        data.loc[0, "y"] = np.nan
+
+        res = Perc(k=[0, 100])(data, GroupBy(["orient", "group"]), "x", {})
+
+        assert res.columns.tolist() == ["y", "group", "orient", "percentile"]
+        assert res[["group", "percentile"]].values.tolist() == [
+            ["b", 0], ["b", 100], ["a", 0], ["a", 100],
+        ]
+        assert res.y.tolist() == [0, 0, 1, 1]
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 1], "y": [0, 0]})
+        res = Perc(k=[50], method="lower")(data, GroupBy(["y"]), "y", {})
+        assert res.x.tolist() == [0]
+
+
+class TestPercPlot:
+
+    def test_plot_add(self):
+        from seaborn.objects import Dot, Perc, Plot
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        plot = Plot(data, x="x", y="y").add(Dot(), Perc([25, 75])).plot()
+        assert len(plot._layers[0]["data"].frame) == 2
+
