diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..df65252
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,45 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+
+
+class TestPerc:
+
+    def test_imports(self):
+        assert PublicPerc is Perc
+
+    def test_counts_and_values(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({"group": ["a"] * 5, "y": [1., 2., 3., 4., 5.], "percentile": [0., 25., 50., 75., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"group": ["a", "a"], "y": [0, 10]})
+        res = Perc([25, 75], method="nearest")(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({"group": ["a", "a"], "y": [0, 10], "percentile": [25, 75]})
+        assert_frame_equal(res, expected)
+
+    def test_grouping_order_and_missing(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [2., 1., np.nan, 5.]})
+        res = Perc([0, 100])(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({"group": ["b", "b", "a", "a"], "y": [2., 2., 1., 5.], "percentile": [0, 100, 0, 100]})
+        assert_frame_equal(res, expected)
+
+    def test_orientation_groups(self):
+        data = pd.DataFrame({"x": [10, 20, 30, 40], "y": [1, 1, 2, 2], "orient": ["x", "x", "y", "y"]})
+        res = Perc(2)(data, GroupBy(["orient"]), "y", {})
+        expected = pd.DataFrame({"x": [10., 20., 30., 40.], "orient": ["x", "x", "y", "y"], "percentile": [0., 100., 0., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_plot_add(self):
+        from seaborn.objects import Dots, Plot
+
+        data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 3, 4]})
+        plot = Plot(data, "x", "y").add(Dots(), Perc([25, 75]))
+        assert plot is not None
