diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a55cbf5
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,57 @@
+"""Statistics that order observations along one axis."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, or explicit
+        percentile levels.
+    method : str
+        Method used to calculate the percentiles, as in :func:`numpy.percentile`.
+        Defaults to ``"linear"``.
+        Valid choices are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    The result contains one row per requested percentile and group, with the
+    value on the dependent axis and its level in the ``percentile`` column.
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        if values.empty:
+            result = np.full(len(levels), np.nan)
+        else:
+            kws = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+            result = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
