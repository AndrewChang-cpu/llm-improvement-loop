diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..cd5d87e
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,64 @@
+"""Statistical transforms that change the ordering or levels of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5 (quartiles and
+        endpoints).
+    method : str
+        Method used to calculate the percentiles. Passed to
+        :func:`numpy.percentile`; defaults to ``"linear"``.
+
+    Notes
+    -----
+    The result contains one row for each requested percentile in each group.
+    The computed values are in the value variable, and the corresponding level
+    is in a ``percentile`` column.
+
+    The available methods are ``inverted_cdf``, ``averaged_inverted_cdf``,
+    ``closest_observation``, ``interpolated_inverted_cdf``, ``hazen``,
+    ``weibull``, ``linear``, ``median_unbiased``, ``normal_unbiased``,
+    ``lower``, ``higher``, ``midpoint``, and ``nearest``.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(part: DataFrame) -> DataFrame:
+            kwargs = {"method": self.method}
+            if Version(np.__version__) < Version("1.22.0"):
+                kwargs = {"interpolation": self.method}
+            values = np.nanpercentile(part[var], levels, **kwargs)
+            return pd.DataFrame({var: values, "percentile": levels})
+
+        return groupby.apply(data, percentile)
