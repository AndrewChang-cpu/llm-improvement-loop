diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..fc80ccc
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,46 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "y": [2, 4, 6, 8, 10]})
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a"] * 5,
+            "y": [2., 4., 6., 8., 10.],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 10]})
+        counted = Perc(k=3)(data, GroupBy(["y"]), "y", {})
+        assert counted["percentile"].tolist() == [0, 50, 100]
+        assert counted["x"].tolist() == [0, 5, 10]
+
+        explicit = Perc(k=[20, 80])(data, GroupBy(["y"]), "y", {})
+        assert explicit["percentile"].tolist() == [20, 80]
+        assert explicit["x"].tolist() == [2, 8]
+
+    def test_grouping_order_and_missing(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [1, 10, np.nan, 20]})
+        res = Perc(k=[0, 100])(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert res["group"].tolist() == ["a", "a", "b", "b"]
+        assert res["y"].tolist() == [10, 20, 1, 1]
+        assert res.columns.tolist() == ["group", "y", "percentile"]
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 10]})
+        res = Perc(k=[25], method="lower")(data, GroupBy(["y"]), "y", {})
+        assert res["x"].tolist() == [0]
+
+    def test_public_imports(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
