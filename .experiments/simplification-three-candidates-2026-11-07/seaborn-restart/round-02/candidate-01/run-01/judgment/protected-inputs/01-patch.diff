diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..ca86840
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,56 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "unused": ["a"] * 5})
+        result = Perc()(data, GroupBy(["unused"]), "y", {})
+        expected = pd.DataFrame({
+            "x": [0., 1., 2., 3., 4.],
+            "unused": ["a"] * 5,
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"y": [0, 10], "group": ["a", "a"]})
+        grouped = GroupBy(["group"])
+        result = Perc(3)(data, grouped, "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["y"].tolist() == [0, 5, 10]
+
+        result = Perc([20, 80])(data, grouped, "x", {})
+        assert result["percentile"].tolist() == [20, 80]
+        assert result["y"].tolist() == [2, 8]
+
+    def test_method_missing_and_group_order(self):
+        data = pd.DataFrame({
+            "x": [0, np.nan, 10, 20, 30],
+            "group": ["b", "b", "b", "a", "a"],
+            "orient": ["x"] * 5,
+        })
+        result = Perc([25, 75], "lower")(
+            data, GroupBy(["orient", "group"]), "y", {}
+        )
+        expected = pd.DataFrame({
+            "x": [0., 0., 20., 20.],
+            "group": ["b", "b", "a", "a"],
+            "orient": ["x"] * 4,
+            "percentile": [25, 75, 25, 75],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_plot_add_and_exports(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as StatsPerc
+
+        assert so.Perc is StatsPerc
+        data = pd.DataFrame({"group": ["a", "a", "a"], "value": [0, 10, 20]})
+        plot = so.Plot(data, x="group", y="value").add(so.Range(), so.Perc([0, 100]))
+        plot.plot()
