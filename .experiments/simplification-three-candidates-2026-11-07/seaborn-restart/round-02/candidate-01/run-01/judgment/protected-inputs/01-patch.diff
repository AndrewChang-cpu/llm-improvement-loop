diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..240cfbb
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,75 @@
+"""Statistics for ordering and percentile transforms."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentiles of the value variable.
+
+    The output contains one row per requested percentile, with the percentile
+    value and its level in the ``percentile`` column. These are percentile rows,
+    not a point estimate or an interval.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100 (inclusive),
+        or an explicit list of percentile levels. Defaults to five levels
+        (quartiles and endpoints).
+    method : str
+        Method used to compute the percentile, passed to :func:`numpy.percentile`.
+        Defaults to ``"linear"``. Valid choices are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Examples
+    --------
+    Default quartiles and endpoints::
+
+        so.Plot(data, "x", "y").add(so.Dots(), so.Perc())
+
+    An integer requests that many levels, including endpoints::
+
+        so.Plot(data, "x", "y").add(so.Dots(), so.Perc(3))
+
+    Pass an explicit list of levels::
+
+        so.Plot(data, "x", "y").add(so.Dots(), so.Perc([10, 50, 90]))
+
+    Combine percentile rows with a range mark to show an interval::
+
+        so.Plot(data, "x", "y").add(so.Range(), so.Perc([2.5, 97.5]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str, levels: list[float]) -> DataFrame:
+        values = data[var].dropna()
+        kwargs = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k).tolist() if isinstance(self.k, int) else self.k
+        return groupby.apply(data, self._compute, var, levels)
