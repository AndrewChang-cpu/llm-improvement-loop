diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..1d87107
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn import objects as so
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5]})
+        res = Perc()(data, GroupBy(["missing"]), "y", {})
+        expected = pd.DataFrame({"x": [1, 2, 3, 4, 5], "percentile": [0, 25, 50, 75, 100]})
+        assert_frame_equal(res, expected, check_dtype=False)
+
+    def test_count_and_levels(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4]})
+        count = Perc(3)(data, GroupBy(["missing"]), "y", {})
+        levels = Perc([20, 80])(data, GroupBy(["missing"]), "y", {})
+        assert count.percentile.tolist() == [0, 50, 100]
+        assert count.x.tolist() == [1, 2.5, 4]
+        assert levels.percentile.tolist() == [20, 80]
+        np.testing.assert_allclose(levels.x, [1.6, 3.4])
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": [1, np.nan, 3]})
+        res = Perc([75], method="nearest")(data, GroupBy(["missing"]), "y", {})
+        assert res.x.tolist() == [3]
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [1, 3], "y": [10, 20]})
+        x_res = Perc([50])(data, GroupBy(["missing"]), "x", {})
+        y_res = Perc([50])(data, GroupBy(["missing"]), "y", {})
+        assert x_res.y.tolist() == [15]
+        assert y_res.x.tolist() == [2]
+
+    def test_grouping_orientation_and_order(self):
+        data = pd.DataFrame({"x": [1, 3, 2, 4], "y": [5, 7, 6, 8], "g": ["b", "b", "a", "a"]})
+        groupby = GroupBy({"g": ["a", "b"]})
+        res = Perc([0, 100])(data, groupby, "y", {})
+        assert res.columns.tolist() == ["x", "g", "percentile"]
+        assert res.g.tolist() == ["a", "a", "b", "b"]
+        assert res.x.tolist() == [2, 4, 1, 3]
+
+    def test_public_imports_and_plot_add(self):
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": ["a", "a", "a"], "y": [1, 2, 3]})
+        plot = so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+        plot._plot()
