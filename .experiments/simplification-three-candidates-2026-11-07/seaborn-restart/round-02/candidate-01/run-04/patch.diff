diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..ebcb8c6
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,70 @@
+"""Statistics that transform observations into ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of percentile levels to compute.
+    method : str
+        Method used to calculate the percentile, as in :func:`numpy.percentile`.
+        The default is ``"linear"``. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    The output has one row for each requested percentile in each group. The
+    computed value is in the value variable and the level is in ``percentile``.
+
+    Examples
+    --------
+    Plot default quartiles and endpoints::
+
+        import seaborn.objects as so
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+
+    Request five evenly spaced percentiles or explicit levels::
+
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(5))
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc([10, 50, 90]))
+
+    Combine percentiles with a range mark to draw an interval::
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc([5, 95]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"interpolation": self.method}
+        if Version(np.__version__) >= Version("1.22.0"):
+            kwargs = {"method": self.method}
+        values = np.nanpercentile(data[var], levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
