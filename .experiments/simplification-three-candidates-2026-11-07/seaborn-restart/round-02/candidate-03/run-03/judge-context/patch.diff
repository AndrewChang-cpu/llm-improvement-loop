diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..13ea490
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0, 0, 0], "y": [1, 2.5, 4],
+            "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        result = Perc(k=[25, 75], method="lower")(
+            data, GroupBy(["x"]), "x", {},
+        )
+        expected = pd.DataFrame({
+            "x": [0, 0], "y": [1, 3], "percentile": [25, 75],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_grouping_order_missing_and_columns(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"],
+            "y": [1, 2, np.nan, 4],
+            "group": ["z", "z", "z", "a"],
+            "unused": [0, 1, 2, 3],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy(["x", "group"]), "x", {},
+        )
+        expected = pd.DataFrame({
+            "x": ["b", "b", "a", "a", "a", "a"],
+            "y": [1., 1., 2., 2., 4., 4.],
+            "group": ["z", "z", "z", "z", "a", "a"],
+            "percentile": [0, 100, 0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_orientation_and_public_import(self):
+        import seaborn.objects as so
+
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [0, 0, 0, 0]})
+        result = so.Perc(k=2)(data, GroupBy(["y"]), "y", {})
+        assert result["x"].tolist() == [1, 4]
+        assert result["percentile"].tolist() == [0, 100]
+
+    def test_plot_add_with_range(self):
+        import seaborn.objects as so
+
+        data = pd.DataFrame({"x": ["a", "a", "a", "a"], "y": [1, 2, 3, 4]})
+        so.Plot(data, x="x", y="y").add(
+            so.Range(), so.Perc(k=[25, 75]),
+        ).plot()
