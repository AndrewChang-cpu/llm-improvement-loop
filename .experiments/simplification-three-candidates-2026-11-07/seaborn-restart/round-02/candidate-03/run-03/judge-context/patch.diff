diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..897faec
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,88 @@
+"""Statistics that change the order or representational level of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, or explicit
+        percentile levels. Defaults to 5, producing the endpoints and quartiles.
+    method : str
+        Method used to compute the percentiles, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Valid choices are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    The output has one row for each requested level in each group, with the
+    level recorded in a ``percentile`` column.
+
+    Examples
+    --------
+    Use the default endpoints and quartiles:
+
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc())
+
+    Choose the number or levels explicitly:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="group", y="value").add(
+            so.Dot(), so.Perc(k=[10, 50, 90]),
+        )
+
+    Combine the endpoints with a range mark to draw an interval:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[2.5, 97.5]),
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        levels = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer)) else self.k
+        )
+        keyword = (
+            "interpolation"
+            if Version(np.__version__) < Version("1.22.0")
+            else "method"
+        )
+        kwargs = {keyword: self.method}
+        percentiles = np.percentile(values, levels, **kwargs)
+        return DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
