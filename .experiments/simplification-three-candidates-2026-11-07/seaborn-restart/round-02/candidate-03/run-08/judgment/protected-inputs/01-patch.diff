diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..6c93404
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0, 0], "y": [0, 1, 2, 3, 4]})
+        groupby = GroupBy(["x"])
+
+        res = Perc()(data, groupby, "x", {})
+        assert_array_equal(res["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(res["y"], [0, 1, 2, 3, 4])
+
+        res = Perc(k=3)(data, groupby, "x", {})
+        assert_array_equal(res["percentile"], [0, 50, 100])
+        assert_array_equal(res["y"], [0, 2, 4])
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 3, 8]})
+        res = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        assert_array_equal(res["percentile"], [25, 75])
+        assert_array_equal(res["y"], [1, 8])
+        assert res.columns.to_list() == ["x", "y", "percentile"]
+
+    def test_orientation_group_order_and_missing(self):
+        data = pd.DataFrame({
+            "x": [10, 20, 30, 40, 50],
+            "y": [1, 1, 1, 2, 2],
+            "group": ["b", "a", "b", "a", "b"],
+            "extra": list("uvwxy"),
+        })
+        data.loc[0, "x"] = np.nan
+        groupby = GroupBy({"y": None, "group": ["a", "b"]})
+        res = Perc(k=[0, 100])(data, groupby, "y", {})
+
+        assert res[["y", "group"]].drop_duplicates().values.tolist() == [
+            [1, "a"], [1, "b"], [2, "a"], [2, "b"],
+        ]
+        assert res.columns.to_list() == ["x", "y", "group", "percentile"]
+        assert_array_equal(res.loc[res["y"] == 1, "x"], [20, 20, 30, 30])
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        data = pd.DataFrame({"group": ["a", "a", "a"], "value": [1, 2, 3]})
+        plot = so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc(k=3))
+        plotter = plot._plot()
+        frame = plotter._layers[0]["data"].frame
+        assert frame.columns.to_list() == [
+            "x", "y", "percentile",
+        ]
+        assert_array_equal(frame["y"], [1, 2, 3])
