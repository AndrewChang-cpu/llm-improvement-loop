diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..7f019cf
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [0], "y": [0,]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["percentile"], [0, 50, 100])
+        assert_array_equal(result["y"], [0, 0, 0])
+
+    def test_explicit_levels_and_columns(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3], "unused": [4, 5, 6]})
+        result = Perc(k=[25, 75])(data, GroupBy(["x"]), "x", {})
+        assert list(result.columns) == ["x", "y", "percentile"]
+        assert_array_equal(result["percentile"], [25, 75])
+        assert_array_equal(result["y"], [1.5, 2.5])
+
+    def test_method_and_missing_values(self):
+        data = pd.DataFrame({
+            "x": [0, 0, 1, 1], "y": [1, np.nan, np.nan, np.nan],
+        })
+        result = Perc(k=[50], method="lower")(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(result["x"], [0])
+        assert_array_equal(result["y"], [1])
+
+    def test_orientation_group_labels_and_order(self):
+        data = pd.DataFrame({
+            "x": [2, 2, 1, 1], "y": [0, 2, 10, 14],
+            "group": ["b", "b", "a", "a"],
+        })
+        result = Perc(k=[50])(data, GroupBy(["x", "group"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [1, 2], "y": [12., 1.], "group": ["a", "b"],
+            "percentile": [50, 50],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_horizontal_orientation(self):
+        data = pd.DataFrame({"x": [1, 3], "y": [0, 0]})
+        result = Perc(k=[50])(data, GroupBy(["y"]), "y", {})
+        assert_array_equal(result["x"], [2])
+
+
+def test_public_import_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    so.Plot(x=[0, 0, 0], y=[1, 2, 3]).add(
+        so.Range(), so.Perc(k=[25, 75]),
+    ).plot()
