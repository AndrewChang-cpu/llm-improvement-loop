diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..f408df1
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,67 @@
+"""Statistical transformations that return ordered data values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced levels from 0 to 100, inclusive, or a list of
+        explicit percentile levels. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile`. Defaults to "linear".
+        Valid choices are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "linear", "median_unbiased", "normal_unbiased",
+        "lower", "higher", "midpoint", and "nearest".
+
+    Returns one row per requested level in each group, with the computed value
+    and a ``percentile`` column containing its level.
+
+    Examples
+    --------
+    Use :class:`seaborn.objects.Perc` with :class:`seaborn.objects.Plot`::
+
+        import seaborn.objects as so
+
+        p = so.Plot(data, x="group", y="value")
+        p.add(so.Dot(), so.Perc())  # Quartiles and endpoints
+        p.add(so.Dot(), so.Perc(k=3))  # Three evenly spaced levels
+        p.add(so.Dot(), so.Perc(k=[10, 50, 90]))  # Explicit levels
+        p.add(so.Range(), so.Perc(k=[25, 75]))  # Interquartile range
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str, levels: list[float]) -> DataFrame:
+        values = data[var]
+        if Version(np.__version__) < Version("1.22.0"):
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+        else:
+            percentiles = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        data = data.dropna(subset=[var])
+        return groupby.apply(data, self._percentile, var, levels)
