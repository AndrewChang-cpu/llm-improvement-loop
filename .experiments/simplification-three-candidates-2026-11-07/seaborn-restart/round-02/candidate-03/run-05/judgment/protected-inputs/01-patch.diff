diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..973d1e9
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [0, 1, 2, 3]})
+        groupby = GroupBy(["x"])
+
+        quartiles = Perc()(data, groupby, "x", {})
+        np.testing.assert_allclose(quartiles["y"], [0, .75, 1.5, 2.25, 3])
+        np.testing.assert_allclose(quartiles["percentile"], [0, 25, 50, 75, 100])
+
+        count = Perc(k=3)(data, groupby, "x", {})
+        np.testing.assert_allclose(count["percentile"], [0, 50, 100])
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"x": [0] * 5, "y": [0, 1, np.nan, 2, 100]})
+        result = Perc(k=[10, 50, 90], method="nearest")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        np.testing.assert_allclose(result["y"], [0, 2, 100])
+        np.testing.assert_allclose(result["percentile"], [10, 50, 90])
+
+    def test_group_labels_and_order(self):
+        data = pd.DataFrame({
+            "x": [1, 1, 2, 2], "y": [10, 20, 30, 40],
+            "group": ["b", "b", "a", "a"], "extra": [1, 2, 3, 4],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["group"]), "x", {})
+
+        expected = pd.DataFrame({
+            "y": [10., 20., 30., 40.], "group": ["b", "b", "a", "a"],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_orientation_and_public_imports(self):
+        import seaborn.objects as so
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [4, 5, 6], "group": ["a"] * 3})
+        result = Perc(k=2)(data, GroupBy(["group"]), "y", {})
+        np.testing.assert_allclose(result["x"], [1, 3])
+
+        plot = so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+        compiled = plot.plot()
+        result = compiled._layers[0]["data"].frame
+        assert list(result) == ["x", "y", "percentile"]
+        assert len(result) == 15
+
+    def test_bad_method_propagates(self):
+        data = pd.DataFrame({"x": [0], "y": [1]})
+        with pytest.raises(ValueError, match="method"):
+            Perc(method="invalid")(data, GroupBy(["x"]), "x", {})
