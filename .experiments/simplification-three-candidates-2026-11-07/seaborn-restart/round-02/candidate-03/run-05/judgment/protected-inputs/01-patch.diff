diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..5565665
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,69 @@
+"""Statistical transformations that operate on the ordering variable."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values computed within groups.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of explicit levels. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile`. Defaults to ``"linear"``.
+        Valid choices are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns one row per requested percentile level and group, with the level
+    recorded in the ``percentile`` column.
+
+    Examples
+    --------
+    Default quartiles and endpoints::
+
+        import seaborn.objects as so
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc())
+
+    Choose an integer number of levels or explicit levels::
+
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="x", y="y").add(so.Dot(), so.Perc(k=[10, 50, 90]))
+
+    Combine with a range mark to show an interval::
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[5, 95]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        kw = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kws = {kw: self.method}
+        percentiles = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var).reset_index(drop=True)
