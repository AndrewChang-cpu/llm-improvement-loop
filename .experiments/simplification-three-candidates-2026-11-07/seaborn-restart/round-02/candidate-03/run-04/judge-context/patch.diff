diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a078906
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,49 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        out = Perc()(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(out["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(out["y"], [1, 1.75, 2.5, 3.25, 4])
+        assert list(out) == ["x", "y", "percentile"]
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        groupby = GroupBy(["x"])
+        count = Perc(k=3)(data, groupby, "x", {})
+        explicit = Perc(k=[10, 90])(data, groupby, "x", {})
+        assert_array_equal(count["percentile"], [0, 50, 100])
+        assert_array_equal(explicit["percentile"], [10, 90])
+        assert_array_equal(explicit["y"], [1.3, 3.7])
+
+    def test_method_and_missing_values(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, np.nan, 4]})
+        out = Perc(k=[25, 50, 75], method="lower")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        assert_array_equal(out["y"], [1, 2, 2])
+
+    def test_orientation_grouping_and_order(self):
+        data = pd.DataFrame({
+            "x": [1, 2, 3, 4], "group": ["b", "b", "a", "a"],
+            "y": [10, 10, 20, 20], "unused": [0, 0, 0, 0],
+        })
+        out = Perc(k=2)(data, GroupBy(["y", "group"]), "y", {})
+        assert list(out) == ["x", "group", "y", "percentile"]
+        assert_array_equal(out["group"], ["b", "b", "a", "a"])
+        assert_array_equal(out["x"], [1, 2, 3, 4])
+
+    def test_public_import_and_plot_add(self):
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[25, 75]))
+        plot.plot()
