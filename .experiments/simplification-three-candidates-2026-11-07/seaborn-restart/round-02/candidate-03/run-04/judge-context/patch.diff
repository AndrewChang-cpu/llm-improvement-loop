diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..c0a1ffa
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,80 @@
+"""Statistics that change the order of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, or a list
+        of specific percentile levels. Defaults to 5, producing quartiles and
+        the endpoints.
+    method : str
+        Method used to calculate the percentiles, as in :func:`numpy.percentile`.
+        Defaults to ``"linear"``. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns one row per requested percentile level in each group. The computed
+    value is in the value variable and the level is in ``percentile``.
+
+    Examples
+    --------
+    Default quartiles and endpoints::
+
+        import seaborn.objects as so
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc())
+
+    Request three evenly spaced levels or explicit levels::
+
+        so.Plot(data, x="group", y="value").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="group", y="value").add(
+            so.Dot(), so.Perc(k=[10, 50, 90]),
+        )
+
+    Draw an interval between selected percentiles::
+
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc(k=[25, 75]),
+        )
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+        method_arg = (
+            "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        )
+        kws = {method_arg: self.method}
+        values = np.percentile(data[var].dropna(), levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
