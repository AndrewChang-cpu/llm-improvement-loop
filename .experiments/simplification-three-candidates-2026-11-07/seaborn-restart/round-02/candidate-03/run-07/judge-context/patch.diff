diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..1158cca
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,76 @@
+"""Statistical transforms that order or select observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values computed within groups.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of explicit percentile levels. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile`. Defaults to "linear".
+        Valid choices are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "linear", "median_unbiased", "normal_unbiased",
+        "lower", "higher", "midpoint", and "nearest".
+
+    Returns one row per requested level per group, with the computed value in
+    the value variable and the level in ``percentile``.
+
+    Examples
+    --------
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+        # The default five levels include quartiles and endpoints.
+        so.Plot(tips, x="day", y="total_bill").add(so.Dot(), so.Perc())
+
+        # Request three evenly spaced levels, or explicit levels.
+        so.Plot(tips, x="day", y="total_bill").add(so.Dot(), so.Perc(3))
+        so.Plot(tips, x="day", y="total_bill").add(
+            so.Dot(), so.Perc([10, 50, 90]),
+        )
+
+        # Draw a range spanning the 25th and 75th percentiles.
+        so.Plot(tips, x="day", y="total_bill").add(
+            so.Range(), so.Perc([25, 75]),
+        )
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna().to_numpy()
+        keyword = (
+            "method" if Version(np.__version__) >= Version("1.22.0") else "interpolation"
+        )
+        kwargs = {keyword: self.method}
+        percentiles = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
