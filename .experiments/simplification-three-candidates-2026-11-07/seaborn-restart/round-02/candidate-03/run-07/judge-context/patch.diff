diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..9d3c668
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,49 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_default_and_count():
+    data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+    res = Perc()(data, GroupBy(["x"]), "x", {})
+
+    assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+    assert res["y"].tolist() == [1, 1.75, 2.5, 3.25, 4]
+    assert Perc(3)(data, GroupBy(["x"]), "x", {})["percentile"].tolist() == [0, 50, 100]
+
+
+def test_explicit_levels_and_method():
+    data = pd.DataFrame({"x": ["a"] * 3, "y": [1, 2, 10]})
+    res = Perc([25, 50, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+
+    expected = np.percentile(data["y"], [25, 50, 75], method="nearest")
+    assert res["y"].tolist() == expected.tolist()
+    assert res["percentile"].tolist() == [25, 50, 75]
+
+
+def test_grouping_orientation_and_missing_values():
+    data = pd.DataFrame({
+        "x": [1., 10., np.nan, 20.],
+        "y": ["b", "a", "b", "a"],
+        "group": ["g", "g", "g", "g"],
+    })
+    res = Perc([0, 100])(data, GroupBy(["y", "group"]), "y", {})
+
+    assert res.columns.tolist() == ["x", "y", "group", "percentile"]
+    assert res[["y", "group", "percentile", "x"]].values.tolist() == [
+        ["b", "g", 0, 1.], ["b", "g", 100, 1.],
+        ["a", "g", 0, 10.], ["a", "g", 100, 20.],
+    ]
+
+
+def test_public_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    plotter = so.Plot(x=["a", "a", "a"], y=[1, 2, 10]).add(
+        so.Range(), so.Perc([25, 75]),
+    ).plot()
+    assert plotter._layers[0]["data"].frame["y"].tolist() == [1.5, 6.0]
