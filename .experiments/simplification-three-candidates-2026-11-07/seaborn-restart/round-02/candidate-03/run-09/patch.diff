diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..bcfe826
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,41 @@
+import numpy as np
+import pandas as pd
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"group": ["a"] * 5, "x": [1, 2, 3, 4, 5]})
+        res = Perc()(data, GroupBy(["group"]), "y", {})
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert res["x"].tolist() == [1, 2, 3, 4, 5]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4]})
+        res = Perc(k=[10, 50, 90], method="nearest")(
+            data, GroupBy(["group"]), "y", {}
+        )
+        assert res["percentile"].tolist() == [10, 50, 90]
+        np.testing.assert_array_equal(res["x"], [1, 3, 4])
+
+    def test_orientation_missing_and_group_order(self):
+        data = pd.DataFrame({
+            "group": ["b", "b", "a", "a"],
+            "x": [1, 3, 10, np.nan],
+            "y": [10, 20, 30, np.nan],
+            "unused": [1, 2, 3, 4],
+        })
+        res = Perc(k=[0, 100])(data, GroupBy(["group"]), "x", {})
+        assert res.columns.tolist() == ["group", "y", "percentile"]
+        assert res["group"].tolist() == ["b", "b", "a", "a"]
+        np.testing.assert_array_equal(res["y"], [10, 20, 30, 30])
+
+    def test_public_imports_and_plot_add(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = so.Plot(x=["a", "a", "a", "a"], y=[1, 2, 3, 4])
+        plot.add(so.Range(), so.Perc(k=[25, 75])).plot()
