diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..12a79da
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,49 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert res["percentile"].tolist() == [0, 50, 100]
+        assert res["y"].tolist() == [1, 2, 3]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [0, 1, 2, 10]})
+        res = Perc(k=[25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert res["percentile"].tolist() == [25, 75]
+        assert res["y"].tolist() == [1, 2]
+
+    def test_orientation_group_labels_order_and_missing(self):
+        data = pd.DataFrame({
+            "y": ["b", "a", "b", "a"],
+            "x": [1, 10, 3, np.nan],
+            "group": ["g", "g", "g", "g"],
+            "extra": [1, 2, 3, 4],
+        })
+        res = Perc(k=[0, 100])(
+            data, GroupBy(["y", "group"]), "y", {},
+        )
+        assert res.columns.tolist() == ["y", "x", "group", "percentile"]
+        assert res[["y", "group", "percentile", "x"]].values.tolist() == [
+            ["b", "g", 0, 1], ["b", "g", 100, 3],
+            ["a", "g", 0, 10], ["a", "g", 100, 10],
+        ]
+
+
+def test_plot_add():
+    import seaborn.objects as so
+
+    data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+    plotter = so.Plot(data, x="x", y="y").add(
+        so.Range(), so.Perc(k=[25, 75]),
+    ).plot()
+    layer, = plotter._layers
+    assert layer["data"].frame[["x", "y", "percentile"]].values.tolist() == [
+        [0, 1.75, 25], [0, 3.25, 75],
+    ]
