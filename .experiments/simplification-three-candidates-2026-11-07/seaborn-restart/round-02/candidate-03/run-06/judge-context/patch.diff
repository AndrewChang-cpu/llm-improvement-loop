diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..9514d95
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,68 @@
+"""Statistical transforms that change the ordering of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile` (default ``"linear"``).
+        Choices are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile level and group, with the calculated
+        value and a ``percentile`` column.
+
+    Examples
+    --------
+    .. code:: python
+
+        p = so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc())
+        p = so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=4))
+        p = so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=[25, 50, 75]))
+        p = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc())
+    """
+
+    group_by_orient = True
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def __call__(self, data, groupby: GroupBy, orient: str, scales: dict) -> pd.DataFrame:
+        value = "y" if orient == "x" else "x"
+        keep = [key for key in groupby.order if key in data]
+        if value not in keep:
+            keep.append(value)
+        data = data[keep]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(part):
+            vals = part[value].dropna()
+            if Version(np.__version__) < Version("1.22.0"):
+                values = np.percentile(vals, levels, interpolation=self.method)
+            else:
+                values = np.percentile(vals, levels, method=self.method)
+            return pd.DataFrame({value: values, "percentile": levels})
+
+        return groupby.apply(data, percentile)
