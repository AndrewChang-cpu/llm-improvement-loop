diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..f81a642
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+from seaborn.objects import Plot, Range
+
+
+class TestPerc:
+
+    def test_count(self):
+        data = pd.DataFrame({"y": [1, 2, 3, 4, 5]})
+        out = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert out["percentile"].tolist() == [0, 50, 100]
+        np.testing.assert_array_equal(out["y"], [1, 3, 5])
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"y": [1, 2, 3, 4]})
+        out = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        assert out["percentile"].tolist() == [25, 75]
+        np.testing.assert_array_equal(out["y"], [2, 3])
+
+    def test_default_levels_and_horizontal_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5], "y": [0] * 5})
+        out = Perc()(data, GroupBy(["y"]), "y", {})
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100]
+        np.testing.assert_array_equal(out["x"], [1, 2, 3, 4, 5])
+
+    def test_grouping_missing_and_orientation(self):
+        data = pd.DataFrame({
+            "x": [0, 0, 1, 1], "y": [1, np.nan, 5, 9], "group": ["b", "b", "a", "a"],
+            "unused": [1, 2, 3, 4],
+        })
+        out = Perc(k=[0, 100])(
+            data, GroupBy(["x", "group"]), "x", {}
+        )
+        assert out.columns.tolist() == ["x", "group", "y", "percentile"]
+        assert out[["x", "group"]].drop_duplicates().values.tolist() == [
+            [0, "b"], [1, "a"]
+        ]
+        np.testing.assert_array_equal(out["y"], [1, 1, 5, 9])
+
+    def test_public_import(self):
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        data = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 5, 9]})
+        Plot(data, x="x", y="y").add(Range(), Perc()).plot()
