diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0c63c0b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,68 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_counts(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({"x": ["a"] * 3, "y": [1, 2.5, 4], "percentile": [0., 50., 100.]})
+        assert_frame_equal(res, expected)
+
+    def test_explicit_levels(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(k=[25, 75])(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({"x": ["a"] * 2, "y": [1.75, 3.25], "percentile": [25, 75]})
+        assert_frame_equal(res, expected)
+
+    def test_method(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(k=[25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [2, 3]
+
+    def test_orientation_and_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, np.nan, 3, 4], "y": [1, 1, 1, 1]})
+        res = Perc(k=3)(data, GroupBy(["group"]), "y", {})
+
+        expected = pd.DataFrame({
+            "group": ["a"] * 3,
+            "x": [1., 3., 4.],
+            "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_group_order_and_labels(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"],
+            "color": ["blue", "red", "blue", "red"],
+            "y": [1, 10, 3, 20],
+        })
+        res = Perc(k=[0, 100])(data, GroupBy(["x", "color"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": ["b", "b", "a", "a"],
+            "color": ["blue", "blue", "red", "red"],
+            "y": [1., 3., 10., 20.],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_plot_add(self):
+        from seaborn.objects import Dots, Plot
+
+        data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 3, 4]})
+        Plot(data, x="x", y="y").add(Dots(), Perc()).plot()
+
+    def test_public_imports(self):
+        from seaborn._stats.order import Perc as InternalPerc
+        from seaborn.objects import Perc as PublicPerc
+
+        assert InternalPerc is Perc
+        assert PublicPerc is Perc
