diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..7e9b1f1
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,57 @@
+"""Statistics that replace observations with ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100 (default 5), or
+        explicit percentile levels in the range [0, 100].
+    method : str
+        Method used to calculate the percentiles (default ``"linear"``).
+
+    Each group produces one row per requested percentile, with its value in
+    the orientation-selected variable and its level in ``percentile``.
+
+    NumPy supports ``inverted_cdf``, ``averaged_inverted_cdf``,
+    ``closest_observation``, ``interpolated_inverted_cdf``, ``hazen``,
+    ``weibull``, ``linear``, ``median_unbiased``, ``normal_unbiased``,
+    ``lower``, ``higher``, ``midpoint``, and ``nearest`` methods.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        key = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kws = {key: self.method}
+        percentiles = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
