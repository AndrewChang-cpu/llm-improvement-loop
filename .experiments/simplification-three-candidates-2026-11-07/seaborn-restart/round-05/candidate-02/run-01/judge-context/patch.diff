diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..24f12d3
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,34 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+@pytest.mark.parametrize("orient, var", [("x", "y"), ("y", "x")])
+def test_perc(orient, var):
+    data = pd.DataFrame({
+        "x": [0, 0, 0, 0, 0, 0] if orient == "x" else [1, 3, 2, 4, 5, 6],
+        "y": [10, 30, 20, 40, 50, 60] if orient == "x" else [0, 0, 0, 0, 0, 0],
+        "group": ["b", "b", "a", "a", "b", "a"],
+        "extra": list("abcdef"),
+    })
+    groupby = GroupBy([orient, "group"])
+    result = Perc([0, 50, 100])(data, groupby, orient, {})
+
+    assert list(result.columns) == ["x", "y", "group", "percentile"]
+    assert result[[orient, "group"]].drop_duplicates().values.tolist() == [[0, "b"], [0, "a"]]
+    assert result["percentile"].tolist() == [0, 50, 100] * 2
+    values = [10, 30, 50, 20, 40, 60] if orient == "x" else [1, 3, 5, 2, 4, 6]
+    expected = [min(values[:3]), np.median(values[:3]), max(values[:3]), min(values[3:]), np.median(values[3:]), max(values[3:])]
+    assert result[var].tolist() == pytest.approx(expected)
+
+
+def test_perc_counts_methods_and_missing():
+    data = pd.DataFrame({"x": [1, 2, np.nan, 4], "y": [0, 0, 0, 0]})
+    default = Perc()(data, GroupBy(["y"]), "y", {})
+    assert default["percentile"].tolist() == [0, 25, 50, 75, 100]
+    assert default["x"].tolist() == [1, 1.5, 2, 3, 4]
+    nearest = Perc([25, 50, 75], method="nearest")(data, GroupBy(["y"]), "y", {})
+    assert nearest["x"].tolist() == [1, 2, 4]
