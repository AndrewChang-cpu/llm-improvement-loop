diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0a932e1
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,92 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_counts(self):
+        data = pd.DataFrame({"x": [0] * 5, "y": [5, 1, 4, 2, 3]})
+        groupby = GroupBy(["x"])
+
+        result = Perc()(data, groupby, "x", {})
+        assert result.columns.to_list() == ["x", "y", "percentile"]
+        assert_array_equal(result["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(result["y"], [1, 2, 3, 4, 5])
+
+        result = Perc(3)(data, groupby, "x", {})
+        assert_array_equal(result["percentile"], [0, 50, 100])
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0] * 3, "y": [1, 2, 10]})
+        result = Perc([10, 50, 90], method="nearest")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        expected = np.percentile(data["y"], [10, 50, 90], method="nearest")
+        assert_array_equal(result["percentile"], [10, 50, 90])
+        assert_array_equal(result["y"], expected)
+
+    @pytest.mark.parametrize(
+        "method", [
+            "inverted_cdf", "averaged_inverted_cdf", "closest_observation",
+            "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+            "median_unbiased", "normal_unbiased", "lower", "higher", "midpoint",
+            "nearest",
+        ]
+    )
+    def test_methods(self, method):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 5, 9]})
+        levels = [25, 50, 75]
+        result = Perc(levels, method)(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(
+            result["y"], np.percentile(data["y"], levels, method=method)
+        )
+
+    @pytest.mark.parametrize(
+        "orient, value_var", [("x", "y"), ("y", "x")]
+    )
+    def test_orientation_and_missing(self, orient, value_var):
+        if orient == "x":
+            data = pd.DataFrame({"x": ["b", "a", "b"], "y": [1, 10, np.nan]})
+            labels = ["b", "b", "b", "a", "a", "a"]
+        else:
+            data = pd.DataFrame({"x": [1, np.nan, 2], "y": ["b", "a", "b"]})
+            labels = ["b", "b", "b", "a", "a", "a"]
+        result = Perc([0, 50, 100])(
+            data, GroupBy([orient]), orient, {}
+        )
+        if orient == "x":
+            expected_columns = [orient, value_var, "percentile"]
+        else:
+            expected_columns = [value_var, orient, "percentile"]
+        assert result.columns.to_list() == expected_columns
+        assert result[orient].to_list() == labels
+        assert_array_equal(result["percentile"], [0, 50, 100] * 2)
+        if orient == "x":
+            expected = [1, 1, 1, 10, 10, 10]
+        else:
+            expected = [1, 1.5, 2, np.nan, np.nan, np.nan]
+        np.testing.assert_allclose(result[value_var], expected, equal_nan=True)
+
+    def test_group_labels_and_order(self):
+        data = pd.DataFrame({
+            "x": pd.Categorical(["b", "a", "b", "a"], categories=["a", "b"]),
+            "y": [1, 10, 3, 20],
+            "color": pd.Categorical(["z", "m", "z", "m"], categories=["m", "z"]),
+            "unrelated": [1, 2, 3, 4],
+        })
+        result = Perc([50])(data, GroupBy(["x", "color"]), "x", {})
+        assert result.columns.to_list() == ["x", "y", "color", "percentile"]
+        assert list(zip(result["x"], result["color"])) == [
+            ("a", "m"), ("b", "z")
+        ]
+        assert_array_equal(result["y"], [15, 2])
+
+    def test_imports(self):
+        from seaborn.objects import Perc as ObjectsPerc
+
+        assert ObjectsPerc is Perc
