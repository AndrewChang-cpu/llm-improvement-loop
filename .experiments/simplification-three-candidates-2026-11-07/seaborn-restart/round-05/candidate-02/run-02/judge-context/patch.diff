diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5e9a68b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,67 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_default_count_and_import():
+    import seaborn.objects as so
+
+    assert so.Perc is Perc
+    data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+    result = Perc()(data, GroupBy(["x"]), "x", {})
+
+    assert result.columns.tolist() == ["x", "y", "percentile"]
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+    np.testing.assert_allclose(result["y"], [1, 1.75, 2.5, 3.25, 4])
+
+
+def test_count_and_explicit_levels():
+    data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+
+    result = Perc(3)(data, GroupBy(["x"]), "x", {})
+    assert result["percentile"].tolist() == [0, 50, 100]
+
+    result = Perc([10, 90])(data, GroupBy(["x"]), "x", {})
+    np.testing.assert_allclose(result["y"], [1.3, 3.7])
+
+
+def test_methods_and_missing_values():
+    data = pd.DataFrame({"x": ["a"] * 3, "y": [1, np.nan, 4]})
+    result = Perc([25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+
+    assert result["percentile"].tolist() == [25, 75]
+    expected = np.percentile([1, 4], [25, 75], method="nearest")
+    np.testing.assert_allclose(result["y"], expected)
+
+
+def test_vertical_orientation_groups_and_column_order():
+    data = pd.DataFrame({
+        "y": pd.Categorical(
+            ["second"] * 2 + ["first"] * 2,
+            categories=["second", "first"], ordered=True,
+        ),
+        "x": [10, 20, 1, 3],
+        "group": ["b", "b", "a", "a"],
+        "unused": [0, 0, 0, 0],
+    })
+    result = Perc([0, 100])(data, GroupBy(["y", "group"]), "y", {})
+
+    assert result.columns.tolist() == ["y", "x", "group", "percentile"]
+    assert result[["y", "group"]].drop_duplicates().values.tolist() == [
+        ["second", "b"], ["first", "a"]
+    ]
+    assert result["x"].tolist() == [10, 20, 1, 3]
+    assert "unused" not in result
+
+
+def test_horizontal_orientation_and_plot_add():
+    import seaborn.objects as so
+
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["a"] * 4})
+    result = Perc([25, 75])(data, GroupBy(["y"]), "y", {})
+    np.testing.assert_allclose(result["x"], [1.75, 3.25])
+
+    plot = so.Plot(data, x="y", y="x").add(so.Range(), so.Perc([25, 75]))
+    plot.plot()
