diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..4a745d0
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_percentile_counts_and_explicit_levels():
+    data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+    groupby = GroupBy(["x"])
+
+    res = Perc()(data, groupby, "x", {})
+    expected = pd.DataFrame({
+        "x": ["a"] * 5,
+        "y": np.percentile(data.y, [0, 25, 50, 75, 100]),
+        "percentile": np.linspace(0, 100, 5),
+    })
+    assert_frame_equal(res, expected)
+
+    res = Perc(3)(data, groupby, "x", {})
+    assert res.percentile.tolist() == [0, 50, 100]
+    np.testing.assert_allclose(res.y, np.percentile(data.y, [0, 50, 100]))
+
+    res = Perc([10, 50, 90])(data, groupby, "x", {})
+    assert res.percentile.tolist() == [10, 50, 90]
+    np.testing.assert_allclose(res.y, np.percentile(data.y, [10, 50, 90]))
+
+
+def test_percentile_methods_and_orientation():
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["b"] * 4})
+    res = Perc([25, 50, 75], method="lower")(data, GroupBy(["y"]), "y", {})
+    assert res.columns.tolist() == ["x", "y", "percentile"]
+    assert res.x.tolist() == [1, 2, 3]
+    assert res.y.tolist() == ["b"] * 3
+
+
+def test_percentile_groups_missing_and_order():
+    data = pd.DataFrame({
+        "x": pd.Categorical(["a", "b", "a", "b"], ["b", "a"], ordered=True),
+        "y": [1, np.nan, 3, 5],
+        "group": pd.Categorical(["one", "two", "one", "two"], ["two", "one"], ordered=True),
+        "unused": [10, 20, 30, 40],
+    })
+    res = Perc([0, 50, 100])(data, GroupBy(["x", "group"]), "x", {})
+
+    assert res.columns.tolist() == ["x", "y", "group", "percentile"]
+    assert list(zip(res.x, res.group, res.percentile)) == [
+        ("b", "two", 0), ("b", "two", 50), ("b", "two", 100),
+        ("a", "one", 0), ("a", "one", 50), ("a", "one", 100),
+    ]
+    np.testing.assert_allclose(res.y, [5, 5, 5, 1, 2, 3])
+
+
+def test_percentile_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    plot = so.Plot(pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 3, 4]}), "x", "y")
+    plot.add(so.Range(), so.Perc([10, 90])).plot()
