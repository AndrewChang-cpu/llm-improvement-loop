diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..012ca3c
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,52 @@
+"""Ordering statistics for the objects interface."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or a list of explicit percentile levels in the range [0, 100].
+    method : str
+        Method used to estimate percentiles. Defaults to ``"linear"``. See
+        :func:`numpy.percentile` for the available methods.
+
+    The output has one row for each requested percentile in each group, with
+    the percentile value in the orientation-selected variable and its level in
+    the ``percentile`` column.
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        arg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {arg: self.method}
+
+        def percentile(part):
+            values = np.nanpercentile(part[var], levels, **kwargs)
+            return pd.DataFrame({var: values, "percentile": levels})
+
+        return groupby.apply(data, percentile).reset_index(drop=True)
