diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..1b8e436
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc, Plot, Range
+
+
+def test_imports():
+    assert ObjectsPerc is Perc
+
+
+@pytest.mark.parametrize("k, expected", [
+    (3, [0, 50, 100]),
+    ([25, 75], [25, 75]),
+])
+def test_percentile_levels(k, expected):
+    data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+    out = Perc(k)(data, GroupBy(["group"]), "x", {})
+    assert out["percentile"].tolist() == expected
+    np.testing.assert_array_equal(out["y"], np.percentile(data.y, expected))
+    assert out.columns.tolist() == ["group", "y", "percentile"]
+
+
+def test_methods():
+    data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4]})
+    out = Perc([25, 75], method="lower")(data, GroupBy(["group"]), "y", {})
+    assert out.x.tolist() == [1, 3]
+
+
+@pytest.mark.parametrize("orient, variable", [("x", "y"), ("y", "x")])
+def test_orientation_and_group_order(orient, variable):
+    data = pd.DataFrame({"group": ["b", "b", "a", "a"], "x": [1, 2, 3, 4], "y": [4, 3, 2, 1]})
+    groupby = GroupBy(["group", orient])
+    out = Perc(2)(data, groupby, orient, {})
+    assert out.columns.tolist() == ["group", "x", "y", "percentile"]
+    assert out.group.tolist() == ["b"] * 4 + ["a"] * 4
+    levels = [sorted(data.loc[data.group == group, orient]) for group in ["b", "a"]]
+    assert out[orient].tolist() == [v for group in levels for v in group for _ in range(2)]
+
+
+def test_missing_values():
+    data = pd.DataFrame({"group": ["a"] * 3, "y": [np.nan, 2, 4]})
+    out = Perc(3)(data, GroupBy(["group"]), "x", {})
+    assert out.y.tolist() == [2, 3, 4]
+
+
+def test_plot_add_with_range_mark():
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [3, 1, 4, 2]})
+    Plot(data, x="x", y="y").add(Range(), Perc([25, 75])).plot()
