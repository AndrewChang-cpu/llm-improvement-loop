diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..08e5a94
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,62 @@
+"""Ordering statistical transformations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels, or explicit percentile levels.
+        The default, 5, returns quartiles and the endpoints.
+    method : str
+        Method used to estimate percentiles, passed through to
+        :func:`numpy.percentile`. The default is ``"linear"``. NumPy supports
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile in each group, with the percentile
+        value in the orientation-selected coordinate and the level in a
+        ``percentile`` column.
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        method = (
+            "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        )
+        return pd.DataFrame({
+            var: np.percentile(values, levels, **{method: self.method}),
+            "percentile": levels,
+        })
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
