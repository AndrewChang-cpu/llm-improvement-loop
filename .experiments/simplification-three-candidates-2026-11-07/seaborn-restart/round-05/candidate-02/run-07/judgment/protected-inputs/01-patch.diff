diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a491983
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,60 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_perc_count_and_group_order():
+    df = pd.DataFrame({
+        "x": [1., 2., 3., 10., 20., 30.],
+        "y": ["b"] * 3 + ["a"] * 3,
+        "group": pd.Categorical(["g"] * 6, categories=["g"]),
+        "unrelated": range(6),
+    })
+    res = Perc(k=3)(df, GroupBy(["y", "group"]), "y", {})
+    expected = pd.DataFrame({
+        "x": [1., 2., 3., 10., 20., 30.],
+        "y": ["b"] * 3 + ["a"] * 3,
+        "group": ["g"] * 6,
+        "percentile": [0., 50., 100.] * 2,
+    })
+    assert_frame_equal(res, expected)
+
+
+def test_perc_explicit_levels_and_method():
+    df = pd.DataFrame({"x": [0, 1, 2, 3], "y": ["a"] * 4})
+    res = Perc([25, 75], method="nearest")(df, GroupBy(["y"]), "y", {})
+    expected = pd.DataFrame({
+        "x": np.percentile(df.x, [25, 75], method="nearest"),
+        "y": ["a", "a"],
+        "percentile": [25, 75],
+    })
+    assert_frame_equal(res, expected)
+
+
+def test_perc_default_levels_and_missing_data():
+    df = pd.DataFrame({"x": [0, np.nan, 10], "y": ["a"] * 3})
+    res = Perc()(df, GroupBy(["y"]), "y", {})
+    assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+    assert res["x"].tolist() == [0, 2.5, 5, 7.5, 10]
+
+
+def test_perc_vertical_orientation():
+    df = pd.DataFrame({"x": ["b"] * 3 + ["a"] * 3, "y": [1, 2, 3, 10, 20, 30]})
+    res = Perc(k=2)(df, GroupBy(["x"]), "x", {})
+    assert res["x"].tolist() == ["b", "b", "a", "a"]
+    assert res["y"].tolist() == [1, 3, 10, 30]
+    assert res["percentile"].tolist() == [0, 100, 0, 100]
+
+
+def test_perc_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn.objects import Perc as PublicPerc
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert PublicPerc is InternalPerc
+    df = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["a"] * 4})
+    plot = so.Plot(df, x="x", y="y").add(so.Range(), so.Perc(k=[25, 75]))
+    plot.plot()
