diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..ee890d6
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,55 @@
+"""Statistics that return ordered values from observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of explicit percentile levels.
+    method : str
+        Method used to calculate the percentiles. The default, `"linear"`,
+        interpolates between observations. See :func:`numpy.percentile` for
+        details.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile in each group, with the percentile
+        value in the orientation-selected coordinate and the level in
+        ``percentile``.
+
+    Notes
+    -----
+    Methods supported by NumPy are `"inverted_cdf"`, `"averaged_inverted_cdf"`,
+    `"closest_observation"`, `"interpolated_inverted_cdf"`, `"hazen"`,
+    `"weibull"`, `"linear"`, `"median_unbiased"`, `"normal_unbiased"`,
+    `"lower"`, `"higher"`, `"midpoint"`, and `"nearest"`.
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+    group_by_orient = True
+
+    def _percentile(self, data, orient):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        vals = data[orient].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            values = np.percentile(vals, levels, interpolation=self.method)
+        else:
+            values = np.percentile(vals, levels, method=self.method)
+        return pd.DataFrame({orient: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        return groupby.apply(data, self._percentile, orient)
