diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0660514
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,43 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal, assert_array_almost_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_counts_and_groups():
+    data = pd.DataFrame({
+        "x": [1, 2, 3, 4, 10, 20, 30, 40],
+        "group": ["b"] * 4 + ["a"] * 4,
+        "unused": range(8),
+    })
+    res = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+    assert res.columns.to_list() == ["x", "group", "percentile"]
+    assert res["group"].to_list() == ["b"] * 3 + ["a"] * 3
+    assert_array_equal(res["percentile"], [0, 50, 100] * 2)
+    assert_array_equal(res["x"], [1, 2.5, 4, 10, 25, 40])
+
+
+def test_explicit_levels_methods_and_missing():
+    data = pd.DataFrame({"x": [1., np.nan, 3., 5.]})
+    res = Perc(k=[25, 50, 75], method="nearest")(
+        data, GroupBy(["missing"]), "x", {}
+    )
+    assert_array_equal(res["percentile"], [25, 50, 75])
+    assert_array_equal(res["x"], [1, 3, 5])
+    linear = Perc(k=[25, 50, 75])(data, GroupBy(["missing"]), "x", {})
+    assert_array_almost_equal(linear["x"], [2, 3, 4])
+
+
+def test_horizontal_and_orientation_groups():
+    data = pd.DataFrame({
+        "y": [1, 1, 2, 2],
+        "x": [10, 30, 10, 30],
+        "group": ["a", "a", "a", "a"],
+    })
+    res = Perc(k=2)(data, GroupBy(["y", "group"]), "y", {})
+    assert res.columns.to_list() == ["y", "group", "percentile"]
+    assert res["y"].to_list() == [1, 1, 2, 2]
+    assert res["group"].to_list() == ["a"] * 4
+    assert res["percentile"].to_list() == [0, 100, 0, 100]
