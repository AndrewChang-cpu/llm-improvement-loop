diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..70c2a00
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,55 @@
+"""Statistics that return ordered values from a distribution."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list
+        Number of evenly spaced percentiles from 0 to 100, or explicit
+        percentile levels in that range. Defaults to 5.
+    method : str
+        Method used to calculate the percentiles. Defaults to "linear".
+        One of ``inverted_cdf``, ``averaged_inverted_cdf``,
+        ``closest_observation``, ``interpolated_inverted_cdf``, ``hazen``,
+        ``weibull``, ``linear``, ``median_unbiased``, ``normal_unbiased``,
+        ``lower``, ``higher``, ``midpoint``, or ``nearest``.
+
+    The output has one row per requested percentile in each group, with the
+    value in the orientation-selected column and the level in ``percentile``.
+    Missing observations are ignored.
+    """
+    k: int | list = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _transform(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"interpolation": self.method} if Version(np.__version__) < Version("1.22.0") else {"method": self.method}
+        observations = data[var].dropna()
+        if observations.empty:
+            observations = [np.nan]
+        values = np.percentile(observations, levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._transform, var)
