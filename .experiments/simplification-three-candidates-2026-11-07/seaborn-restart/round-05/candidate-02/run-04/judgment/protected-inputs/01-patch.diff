diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..384627b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,50 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+@pytest.mark.parametrize("k, levels", [(3, [0, 50, 100]), ([10, 90], [10, 90])])
+def test_levels_and_group_order(k, levels):
+    data = pd.DataFrame({"x": [2, 1, 2, 1], "y": [4, 1, 8, 3], "group": ["b", "b", "a", "a"], "unused": 0})
+    result = Perc(k)(data, GroupBy(["x", "group"]), "x", {})
+
+    assert list(result.columns) == ["x", "y", "group", "percentile"]
+    assert result[["x", "group"]].drop_duplicates().values.tolist() == [[1, "b"], [1, "a"], [2, "b"], [2, "a"]]
+    assert result.percentile.unique().tolist() == levels
+    for (_, group), part in result.groupby(["x", "group"], sort=False):
+        source = data.loc[(data.x == _) & (data.group == group), "y"]
+        np.testing.assert_allclose(part.y, np.percentile(source, levels))
+
+
+def test_explicit_values_and_method():
+    data = pd.DataFrame({"x": [0, 0], "y": [0, 10]})
+    result = Perc([25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+    assert result.y.tolist() == [0, 10]
+    assert result.percentile.tolist() == [25, 75]
+
+
+def test_vertical_orientation_and_missing_values():
+    data = pd.DataFrame({"x": [1, np.nan, 5], "y": [0, 0, 0]})
+    result = Perc([0, 50, 100])(data, GroupBy(["y"]), "y", {})
+    assert list(result.columns) == ["x", "y", "percentile"]
+    assert result.x.tolist() == [1, 3, 5]
+
+
+def test_all_missing_group_retains_levels():
+    data = pd.DataFrame({"x": [np.nan, np.nan], "y": [0, 0]})
+    result = Perc([0, 50, 100])(data, GroupBy(["y"]), "y", {})
+    assert result.x.isna().all()
+    assert result.percentile.tolist() == [0, 50, 100]
+
+
+def test_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["a", "a", "b", "b"]})
+    plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc([25, 75]))
+    plot.plot()
