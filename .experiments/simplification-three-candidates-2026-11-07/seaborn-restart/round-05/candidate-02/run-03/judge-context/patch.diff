diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..23889d8
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,59 @@
+import numpy as np
+import pandas as pd
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+@pytest.mark.parametrize("orient, value", [("x", "y"), ("y", "x")])
+def test_percentile_values_and_group_order(orient, value):
+    discrete = ["b", "b", "a", "a"]
+    numeric = [1, 3, 10, 20]
+    data = pd.DataFrame({
+        "x": discrete if orient == "x" else numeric,
+        "y": numeric if orient == "x" else discrete,
+        "group": ["second", "second", "first", "first"],
+        "unused": [0, 0, 0, 0],
+    })
+    groupvar = "x" if orient == "x" else "y"
+    groupby = GroupBy({groupvar: ["b", "a"], "group": ["second", "first"]})
+
+    result = Perc(k=3)(data, groupby, orient, {})
+
+    assert result.columns.tolist() == ["x", "y", "group", "percentile"]
+    assert result["group"].tolist() == ["second"] * 3 + ["first"] * 3
+    assert_array_equal(result["percentile"], [0, 50, 100] * 2)
+    assert_array_equal(result[value], [1, 2, 3, 10, 15, 20])
+
+
+def test_explicit_percentiles_and_method():
+    data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+    result = Perc(k=[25, 75], method="lower")(
+        data, GroupBy(["x"]), "x", {}
+    )
+
+    assert result.columns.tolist() == ["x", "y", "percentile"]
+    assert_array_equal(result["percentile"], [25, 75])
+    assert_array_equal(result["y"], [1, 3])
+
+
+def test_missing_values_are_ignored():
+    data = pd.DataFrame({"x": ["a"] * 4, "y": [1, np.nan, 3, 4]})
+    result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+    assert_array_equal(result["y"], [1, 3, 4])
+
+
+def test_imports_and_plot_add():
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    data = pd.DataFrame({"x": ["a", "a", "a"], "y": [0, 10, 20]})
+    plotter = so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=3))._plot()
+    result = plotter._layers[0]["data"].frame
+
+    assert result.columns.tolist() == ["x", "y", "percentile"]
+    assert_array_equal(result["y"], [0, 10, 20])
