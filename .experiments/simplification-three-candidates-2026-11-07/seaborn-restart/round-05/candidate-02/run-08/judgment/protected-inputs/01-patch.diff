diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..8693e90
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,49 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+def test_imports():
+    assert ObjectsPerc is Perc
+
+
+def test_percentile_count_and_columns():
+    data = pd.DataFrame({"x": [5, 1, 3, 2, 4], "group": ["a"] * 5, "other": 1})
+    result = Perc(k=3)(data, GroupBy(["group"]), "y", {})
+    assert result.columns.to_list() == ["x", "group", "percentile"]
+    assert result["x"].to_list() == [1, 3, 5]
+    assert result["percentile"].to_list() == [0, 50, 100]
+
+
+def test_explicit_levels_methods_and_missing():
+    data = pd.DataFrame({"x": [1, np.nan, 3, 7], "group": ["a"] * 4})
+    result = Perc(k=[25, 75], method="nearest")(data, GroupBy(["group"]), "y", {})
+    assert result.columns.to_list() == ["x", "group", "percentile"]
+    assert result["x"].to_list() == [1, 7]
+    assert result["percentile"].to_list() == [25, 75]
+
+
+def test_orientation_and_group_order():
+    data = pd.DataFrame({"x": ["b", "b", "a", "a"], "y": [10, 20, 30, 40], "group": [1, 1, 2, 2]})
+    result = Perc(k=2)(data, GroupBy(["x", "group"]), "x", {})
+    assert result.columns.to_list() == ["x", "y", "group", "percentile"]
+    assert result["x"].to_list() == ["b", "b", "a", "a"]
+    assert result["group"].to_list() == [1, 1, 2, 2]
+    assert result["y"].to_list() == [10, 20, 30, 40]
+
+
+def test_plot_add_with_range_mark():
+    import seaborn.objects as so
+
+    plot = so.Plot(
+        pd.DataFrame({"x": ["a", "a", "a", "a"], "y": [1, 2, 3, 4]}),
+        x="x", y="y",
+    ).add(
+        so.Range(), so.Perc(k=[25, 75]),
+    )
+    plot.plot()
