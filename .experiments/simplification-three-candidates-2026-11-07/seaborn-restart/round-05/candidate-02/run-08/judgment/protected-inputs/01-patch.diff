diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..26c9740
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,46 @@
+"""Statistical transforms that change the order or representation of data."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of int
+        Number of evenly spaced percentiles from 0 to 100, or explicit
+        percentile levels in [0, 100]. Defaults to 5.
+    method : str
+        Method used to estimate percentiles. Defaults to "linear". See
+        :func:`numpy.percentile` for the available methods.
+
+    """
+    k: int | list[int] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data, var):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.nanpercentile(data[var], levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: pd.DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
