diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..98b48d2
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,45 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+from seaborn.objects import Plot, Dots
+
+
+def test_imports():
+    assert ObjectsPerc is Perc
+
+
+def test_default_and_levels():
+    data = pd.DataFrame({"x": [1, 1, 1], "y": [1., 2., 3.]})
+    groupby = GroupBy(["x"])
+    result = Perc()(data, groupby, "x", {})
+    assert list(result.columns) == ["x", "y", "percentile"]
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+    np.testing.assert_allclose(result["y"], [1, 1.5, 2, 2.5, 3])
+
+    result = Perc(3)(data, groupby, "x", {})
+    assert result["percentile"].tolist() == [0, 50, 100]
+    result = Perc([10, 90])(data, groupby, "x", {})
+    np.testing.assert_allclose(result["y"], [1.2, 2.8])
+
+
+def test_method_and_missing_values():
+    data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1., 2., 3., np.nan]})
+    result = Perc([25, 75], "lower")(data, GroupBy(["x"]), "x", {})
+    assert result["y"].tolist() == [1, 2]
+
+
+def test_horizontal_and_group_order():
+    data = pd.DataFrame({"x": [1., 2., 3., 4.], "y": ["b", "b", "a", "a"]})
+    result = Perc(2)(data, GroupBy({"y": ["a", "b"]}), "y", {})
+    assert result["y"].tolist() == ["a", "a", "b", "b"]
+    assert result["percentile"].tolist() == [0, 100, 0, 100]
+    assert result["x"].tolist() == [3, 4, 1, 2]
+
+
+def test_plot_add():
+    data = pd.DataFrame({"x": [1, 1, 1], "y": [1., 2., 3.]})
+    plot = Plot(data, x="x", y="y").add(Dots(), Perc(3))
+    assert plot._layers[0]["stat"] == Perc(3)
