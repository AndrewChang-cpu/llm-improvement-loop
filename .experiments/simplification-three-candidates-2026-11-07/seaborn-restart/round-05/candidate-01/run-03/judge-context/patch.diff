diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..686882b
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,63 @@
+"""Statistics that change the order of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels in that range. Defaults to 5, producing
+        quartiles and endpoints.
+    method : str
+        Method used to calculate percentiles. Defaults to "linear". Available
+        methods are inverted_cdf, averaged_inverted_cdf, closest_observation,
+        interpolated_inverted_cdf, hazen, weibull, linear, median_unbiased,
+        normal_unbiased, lower, higher, midpoint, and nearest.
+
+    Returns one row per requested percentile per group, with the percentile
+    value in the orientation-selected coordinate and its level in `percentile`.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        kws = {"interpolation": self.method}
+        if Version(np.__version__) >= Version("1.22.0"):
+            kws = {"method": self.method}
+
+        values = np.nanpercentile(data[var], levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
