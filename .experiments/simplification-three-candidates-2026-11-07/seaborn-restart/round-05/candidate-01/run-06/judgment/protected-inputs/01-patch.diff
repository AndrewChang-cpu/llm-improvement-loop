diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..20c131c
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,44 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc, Plot, Dots
+
+
+def test_imports():
+    assert ObjectsPerc is Perc
+
+
+def test_counts_and_output_columns():
+    data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4], "unused": [9, 8, 7, 6]})
+    result = Perc()(data, GroupBy(["x"]), "x", {})
+    assert list(result.columns) == ["x", "y", "percentile"]
+    assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+    assert result["y"].tolist() == [1, 1.75, 2.5, 3.25, 4]
+    assert len(Perc(k=3)(data, GroupBy(["x"]), "x", {})) == 3
+
+
+def test_explicit_levels_and_method():
+    data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 9]})
+    result = Perc(k=[0, 50, 100], method="nearest")(data, GroupBy(["x"]), "x", {})
+    assert result["percentile"].tolist() == [0, 50, 100]
+    assert result["y"].tolist() == [1, 2, 9]
+
+
+def test_orientation_missing_and_group_order():
+    data = pd.DataFrame({"x": [1, np.nan, 3, 8], "y": [10, 10, 20, 20], "g": ["a", "a", "b", "b"]})
+    result = Perc(k=[0, 100])(data, GroupBy({"y": [10, 20], "g": ["a", "b"]}), "y", {})
+    assert list(result.columns) == ["x", "y", "g", "percentile"]
+    assert result[["x", "y", "g", "percentile"]].to_dict("records") == [
+        {"x": 1.0, "y": 10, "g": "a", "percentile": 0},
+        {"x": 1.0, "y": 10, "g": "a", "percentile": 100},
+        {"x": 3.0, "y": 20, "g": "b", "percentile": 0},
+        {"x": 8.0, "y": 20, "g": "b", "percentile": 100},
+    ]
+
+
+def test_plot_add_with_mark():
+    plot = Plot(pd.DataFrame({"x": [1, 2, 3], "y": [2, 4, 8]}), x="x", y="y")
+    plot = plot.add(Dots(), Perc(k=3))
+    plot.plot()
