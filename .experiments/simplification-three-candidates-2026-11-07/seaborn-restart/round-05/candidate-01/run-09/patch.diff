diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..4b4b17b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,36 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count_and_output(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [2, 4, 6, 8], "label": list("aabb")})
+        groupby = GroupBy(["label"])
+
+        res = Perc(3)(data, groupby, "x", {})
+
+        assert list(res.columns) == ["y", "label", "percentile"]
+        assert res["percentile"].tolist() == [0, 50, 100] * 2
+        np.testing.assert_allclose(res["y"], [2, 3, 4, 6, 7, 8])
+        assert res["label"].tolist() == ["a"] * 3 + ["b"] * 3
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"x": [0, 10, 20, np.nan], "y": ["a"] * 4})
+        res = Perc([25, 75], method="nearest")(data, GroupBy(["y"]), "y", {})
+
+        assert res["percentile"].tolist() == [25, 75]
+        np.testing.assert_allclose(res["x"], [0, 20])
+        assert res["y"].tolist() == ["a", "a"]
+
+    def test_import_aliases_and_plot_add(self):
+        from seaborn.objects import Perc as PublicPerc
+        from seaborn.objects import Plot, Range
+
+        assert PublicPerc is Perc
+        data = pd.DataFrame({"x": list("aabb"), "y": [1, 2, 3, 4]})
+        plot = Plot(data, x="x", y="y").add(Range(), Perc([5, 95]))
+        plot.plot()
