diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..f4c8cb1
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,74 @@
+"""Statistics that order observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels between 0 and 100.
+    method : str
+        Method used to compute the percentiles. One of ``inverted_cdf``,
+        ``averaged_inverted_cdf``, ``closest_observation``,
+        ``interpolated_inverted_cdf``, ``hazen``, ``weibull``, ``linear``,
+        ``median_unbiased``, ``normal_unbiased``, ``lower``, ``higher``,
+        ``midpoint``, or ``nearest``. The default is ``linear``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile and group, with the percentile value
+        in the orientation-selected coordinate and its level in ``percentile``.
+
+    Examples
+    --------
+    The default computes the minimum, quartiles, and maximum:
+
+    .. code-block:: python
+
+        so.Plot(data, y="value").add(so.Dots(), so.Perc())
+
+    Request a count of seven levels or specify levels explicitly:
+
+    .. code-block:: python
+
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(7))
+        so.Plot(data, y="value").add(so.Dots(), so.Perc([10, 50, 90]))
+
+    Combine `Perc` with a range mark to show a percentile interval:
+
+    .. code-block:: python
+
+        so.Plot(data, y="value").add(so.Range(), so.Perc([5, 95]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.percentile(data[var].dropna(), levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
