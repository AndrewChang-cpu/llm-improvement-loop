diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..962c8c8
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_objects_import(self):
+
+        assert ObjectsPerc is Perc
+
+    def test_default_levels_and_values(self):
+
+        data = pd.DataFrame({"x": ["b", "a", "b", "a"], "y": [4, 1, 8, 5]})
+        groupby = GroupBy({"x": ["a", "b"]})
+        out = Perc()(data, groupby, "x", {})
+
+        assert out.columns.tolist() == ["x", "y", "percentile"]
+        assert out["x"].tolist() == ["a"] * 5 + ["b"] * 5
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+        np.testing.assert_array_equal(out["y"], [1, 2, 3, 4, 5, 4, 5, 6, 7, 8])
+
+    def test_integer_levels(self):
+
+        data = pd.DataFrame({"x": ["a", "a"], "y": [1, 3]})
+        out = Perc(3)(data, GroupBy(["x"]), "x", {})
+
+        assert out["percentile"].tolist() == [0, 50, 100]
+        assert out["y"].tolist() == [1, 2, 3]
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 9, 10]})
+        out = Perc([25, 50, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+
+        assert out["percentile"].tolist() == [25, 50, 75]
+        np.testing.assert_array_equal(out["y"], np.percentile(data["y"], [25, 50, 75], method="nearest"))
+
+    def test_horizontal_orientation_and_missing_values(self):
+
+        data = pd.DataFrame({"x": [1, np.nan, 5], "y": [2, 2, 2], "unused": [1, 2, 3]})
+        out = Perc([0, 50, 100])(data, GroupBy(["y"]), "y", {})
+
+        assert out.columns.tolist() == ["x", "y", "percentile"]
+        assert out["x"].tolist() == [1, 3, 5]
+        assert out["percentile"].tolist() == [0, 50, 100]
+        assert out["y"].tolist() == [2, 2, 2]
+
+    def test_plot_add_with_range(self, long_df):
+
+        import seaborn.objects as so
+
+        plot = so.Plot(long_df, x="a", y="y").add(so.Range(), so.Perc([25, 75]))
+        plot.plot()
+
