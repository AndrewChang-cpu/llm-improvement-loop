diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..4430857
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,59 @@
+"""Statistical transformations that order observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels to compute, including 0 and
+        100, or an explicit list of percentile levels in [0, 100].
+    method : str
+        Method used to calculate the percentiles. The default is ``"linear"``.
+        Options are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Notes
+    -----
+    The output has one row per requested level and group. The percentile value
+    is placed on the value axis perpendicular to the orientation grouping axis,
+    and the level is recorded in a ``percentile`` column. Missing observations
+    are ignored.
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def _percentiles(self, data, orient):
+        value_axis = {"x": "y", "y": "x"}[orient]
+        values = data[value_axis].dropna()
+        if values.empty:
+            values = [np.nan]
+        if isinstance(self.k, int):
+            q = np.linspace(0, 100, self.k)
+        else:
+            q = self.k
+
+        method_arg = (
+            "method" if Version(np.__version__) >= Version("1.22.0")
+            else "interpolation"
+        )
+        result = np.percentile(values, q, **{method_arg: self.method})
+        return pd.DataFrame({value_axis: result, "percentile": q})
+
+    def __call__(self, data, groupby, orient, scales):
+        return groupby.apply(data, self._percentiles, orient)
