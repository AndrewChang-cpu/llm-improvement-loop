diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..09d7284
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,72 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+def test_default_levels_and_imports():
+    assert ObjectsPerc is Perc
+    df = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+    res = Perc()(df, GroupBy(["x"]), "x", {})
+    expected = pd.DataFrame({
+        "x": [0] * 5,
+        "y": np.percentile(df["y"], [0, 25, 50, 75, 100]),
+        "percentile": [0., 25., 50., 75., 100.],
+    })
+    assert_frame_equal(res, expected)
+
+
+def test_integer_count_and_method():
+    df = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+    res = Perc(3, "nearest")(df, GroupBy(["x"]), "x", {})
+    expected = pd.DataFrame({
+        "x": [0] * 3,
+        "y": np.percentile(df["y"], [0, 50, 100], method="nearest"),
+        "percentile": [0., 50., 100.],
+    })
+    assert_frame_equal(res, expected)
+
+
+def test_explicit_levels_vertical_orientation_and_missing_values():
+    df = pd.DataFrame({"y": [0, 0, 0, 0], "x": [1, np.nan, 3, 5]})
+    res = Perc([10, 50, 90])(df, GroupBy(["y"]), "y", {})
+    expected = pd.DataFrame({
+        "y": [0] * 3,
+        "x": np.percentile([1, 3, 5], [10, 50, 90]),
+        "percentile": [10, 50, 90],
+    })
+    assert_frame_equal(res, expected)
+
+
+def test_all_missing_values_retain_requested_levels():
+    df = pd.DataFrame({"x": [0, 0], "y": [np.nan, np.nan]})
+    res = Perc([25, 75])(df, GroupBy(["x"]), "x", {})
+    assert res["percentile"].tolist() == [25, 75]
+    assert res["y"].isna().all()
+
+
+def test_group_labels_order_and_columns():
+    df = pd.DataFrame({
+        "x": [2, 1, 2, 1], "y": [10, 2, 20, 4], "group": ["b", "a", "a", "b"],
+        "unused": [0, 1, 2, 3],
+    })
+    gb = GroupBy({"x": [1, 2], "group": ["a", "b"]})
+    res = Perc([0, 100])(df, gb, "x", {})
+    expected = pd.DataFrame({
+        "x": [1, 1, 1, 1, 2, 2, 2, 2],
+        "y": [2., 2., 4., 4., 20., 20., 10., 10.],
+        "group": ["a", "a", "b", "b", "a", "a", "b", "b"],
+        "percentile": [0, 100] * 4,
+    })
+    assert_frame_equal(res, expected)
+
+
+def test_plot_add_with_marks():
+    from seaborn.objects import Plot, Range
+
+    df = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+    plot = Plot(df, x="x", y="y").add(Range(), Perc([0, 100]))
+    assert plot.plot()
