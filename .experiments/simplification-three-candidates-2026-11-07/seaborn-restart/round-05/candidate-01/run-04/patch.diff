diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..e5a3448
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,55 @@
+"""Statistics that replace observations with ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels in that range. Defaults to 5, producing
+        the endpoints and quartiles.
+    method : str
+        Method used to compute the percentiles. Defaults to ``"linear"``.
+        See :func:`numpy.nanquantile` for the available methods:
+        ``inverted_cdf``, ``averaged_inverted_cdf``, ``closest_observation``,
+        ``interpolated_inverted_cdf``, ``hazen``, ``weibull``, ``linear``,
+        ``median_unbiased``, ``normal_unbiased``, ``lower``, ``higher``,
+        ``midpoint``, and ``nearest``.
+
+    Notes
+    -----
+    The output contains one row per requested percentile per group. The
+    percentile level is recorded in the ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data, orient):
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kws = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.nanquantile(data[var], np.asarray(levels) / 100, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        return groupby.apply(data, self._compute, orient)
