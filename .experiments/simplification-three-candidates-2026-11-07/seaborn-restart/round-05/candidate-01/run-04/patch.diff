diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5c1b425
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,70 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels(self):
+
+        data = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 2, 6], "label": ["a", "a", "b", "b"]})
+        groupby = GroupBy(["x", "label"])
+        result = Perc()(data, groupby, "x", {})
+
+        expected = pd.DataFrame({
+            "x": [0] * 5 + [1] * 5,
+            "y": [1, 1.5, 2, 2.5, 3, 2, 3, 4, 5, 6],
+            "label": ["a"] * 5 + ["b"] * 5,
+            "percentile": list(np.linspace(0, 100, 5)) * 2,
+        })
+        assert_frame_equal(result, expected)
+
+    def test_integer_count_and_explicit_levels(self):
+
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [0, 10, 20]})
+        groupby = GroupBy(["x"])
+        result = Perc(3)(data, groupby, "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["y"].tolist() == [0, 10, 20]
+
+        result = Perc([25, 75])(data, groupby, "x", {})
+        assert result["percentile"].tolist() == [25, 75]
+        assert result["y"].tolist() == [5, 15]
+
+    def test_method(self):
+
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [0, 10, 20]})
+        result = Perc([25], method="lower")(data, GroupBy(["x"]), "x", {})
+        assert result["y"].tolist() == [0]
+
+    def test_horizontal_and_missing_data(self):
+
+        data = pd.DataFrame({"x": [1, 3, np.nan, 5], "y": [0, 0, 0, 0], "extra": [1, 2, 3, 4]})
+        result = Perc([0, 50, 100])(data, GroupBy(["y"]), "y", {})
+
+        assert result.columns.tolist() == ["x", "y", "percentile"]
+        assert result["x"].tolist() == [1, 3, 5]
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+    def test_preserves_group_order_and_labels(self):
+
+        data = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 2, 6], "group": ["b", "b", "a", "a"]})
+        result = Perc(2)(data, GroupBy({"x": [1, 0], "group": ["a", "b"]}), "x", {})
+
+        assert result[["x", "group"]].drop_duplicates().values.tolist() == [[1, "a"], [0, "b"]]
+
+    def test_imports_and_plot_add(self):
+
+        import seaborn.objects as so
+        from seaborn.objects import Perc as PublicPerc
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert PublicPerc is InternalPerc
+        data = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 2, 6]})
+        plotter = so.Plot(data, "x", "y").add(so.Dots(), so.Perc(3)).plot()
+        result = plotter._layers[0]["data"].frame
+        assert result["percentile"].tolist() == [0, 50, 100] * 2
