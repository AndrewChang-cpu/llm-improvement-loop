diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..ecbe818
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,66 @@
+"""Statistical transformations that change the order of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels between 0 and 100.
+    method : str
+        Method used to calculate the percentiles. The default is ``"linear"``.
+        NumPy methods include ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns one row for each requested percentile in each group, with the value
+    on the value axis and the percentile level in a ``percentile`` column.
+
+    Examples
+    --------
+    The default computes quartiles and endpoints. Set ``k`` to an integer for
+    a different number of evenly spaced levels, or pass explicit levels::
+
+        so.Plot(data, x="value").add(so.Dots(), so.Perc())
+        so.Plot(data, x="value").add(so.Dots(), so.Perc(10))
+        so.Plot(data, x="value").add(so.Dots(), so.Perc([5, 25, 50, 75, 95]))
+
+    Combine ``Perc`` with a range mark to show an interval::
+
+        so.Plot(data, x="value").add(so.Range(), so.Perc([5, 95]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: pd.DataFrame, var: str) -> pd.DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        param = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {param: self.method}
+        result = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: pd.DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
