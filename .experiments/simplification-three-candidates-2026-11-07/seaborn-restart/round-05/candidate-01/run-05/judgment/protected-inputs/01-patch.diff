diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..80c889a
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,67 @@
+import numpy as np
+import pandas as pd
+
+import pytest
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def data(self):
+        return pd.DataFrame({
+            "x": [1, 1, 1, 2, 2, 2],
+            "y": [0, 10, 20, 100, 110, 120],
+            "group": pd.Categorical(
+                ["b", "b", "b", "a", "a", "a"], categories=["b", "a"]
+            ),
+            "other": list("abcdef"),
+        })
+
+    @pytest.mark.parametrize("k, expected", [(3, [0, 50, 100]), (5, [0, 25, 50, 75, 100])])
+    def test_count(self, data, k, expected):
+        groupby = GroupBy(["x", "group"])
+        result = Perc(k)(data, groupby, "x", {})
+        assert_array_equal(result["percentile"].unique(), expected)
+
+    def test_explicit_levels(self, data):
+        result = Perc([10, 90])(data, GroupBy(["x", "group"]), "x", {})
+        assert_array_equal(result["percentile"].unique(), [10, 90])
+
+    def test_default_levels_and_linear_method(self, data):
+        result = Perc()(data, GroupBy(["x", "group"]), "x", {})
+        assert_array_equal(result["percentile"].unique(), [0, 25, 50, 75, 100])
+        assert result.loc[result.x == 1, "y"].tolist() == [0, 5, 10, 15, 20]
+
+    def test_values_and_method(self, data):
+        result = Perc([25, 50, 75], method="nearest")(
+            data, GroupBy(["x", "group"]), "x", {}
+        )
+        assert_array_equal(result.loc[result.x == 1, "y"], [0, 10, 20])
+        assert_array_equal(result.loc[result.x == 2, "y"], [100, 110, 120])
+
+    @pytest.mark.parametrize(
+        "orient, group_vars",
+        [("x", ["x", "group"]), ("y", ["y", "group"])],
+    )
+    def test_orientation_and_columns(self, data, orient, group_vars):
+        result = Perc(3)(data, GroupBy(group_vars), orient, {})
+        assert list(result.columns) == ["x", "y", "group", "percentile"]
+        assert "other" not in result
+        assert result["group"].unique().tolist() == ["b", "a"]
+
+    def test_missing_values(self, data):
+        data.loc[1, "y"] = np.nan
+        result = Perc(3)(data, GroupBy(["x", "group"]), "x", {})
+        assert len(result) == 6
+        assert_array_equal(result.loc[result.x == 1, "y"], [0, 10, 20])
+
+    def test_imports_and_plot_add(self, data):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as OrderPerc
+
+        assert OrderPerc is so.Perc
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc([25, 75])).plot()
