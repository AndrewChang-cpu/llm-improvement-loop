diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..8bb1348
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,79 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": ["b", "a", "b", "a", "b", "a"],
+            "y": [1, 2, 3, 4, np.nan, 8],
+            "group": ["second", "first", "second", "first", "second", "first"],
+            "unused": [10, 11, 12, 13, 14, 15],
+        })
+
+    def test_default_and_count(self, df):
+        groupby = GroupBy({"x": ["a", "b"], "group": ["first", "second"]})
+        res = Perc()(df, groupby, "x", {})
+
+        assert res.columns.tolist() == ["x", "y", "group", "percentile"]
+        assert res[["x", "group"]].drop_duplicates().values.tolist() == [
+            ["a", "first"], ["b", "second"]
+        ]
+        assert res.groupby(["x", "group"], sort=False).size().tolist() == [5, 5]
+        assert res.loc[res.x == "a", "y"].tolist() == [2, 3, 4, 6, 8]
+        assert res.loc[res.x == "b", "y"].tolist() == [1, 1.5, 2, 2.5, 3]
+        assert res.percentile.unique().tolist() == [0, 25, 50, 75, 100]
+
+    def test_explicit_levels_and_method(self):
+        df = pd.DataFrame({"x": range(5), "y": [0, 10, 20, 30, 40], "group": "all"})
+        groupby = GroupBy(["group"])
+
+        res = Perc([10, 50, 90], method="nearest")(df, groupby, "x", {})
+
+        assert res.y.tolist() == [0, 20, 40]
+        assert res.percentile.tolist() == [10, 50, 90]
+
+    @pytest.mark.parametrize(
+        "orient, value",
+        [("x", "y"), ("y", "x")],
+    )
+    def test_orientation_and_columns(self, orient, value):
+        data = pd.DataFrame({
+            "x": [1, 1] if orient == "x" else [2, 4],
+            "y": [2, 4] if orient == "x" else [1, 1],
+            "group": ["g", "g"],
+        })
+        orient_group = "x" if orient == "x" else "y"
+        groupby = GroupBy([orient_group, "group"])
+        res = Perc(2)(data, groupby, orient, {})
+
+        expected_columns = ["x", "y", "group", "percentile"]
+        assert res.columns.tolist() == expected_columns
+        assert res[value].tolist() == [2, 4]
+        assert res["percentile"].tolist() == [0, 100]
+
+    def test_missing_values_and_imports(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as StatsPerc
+
+        assert so.Perc is StatsPerc
+        df = pd.DataFrame({"x": ["a", "a", "a"], "y": [1, np.nan, 3]})
+        res = Perc(3)(df, GroupBy(["x"]), "x", {})
+        assert res.y.tolist() == [1, 2, 3]
+
+    def test_plot_add_with_mark(self):
+        import seaborn.objects as so
+
+        plotter = so.Plot(x=["a", "a", "a"], y=[1, 2, 3]).add(
+            so.Dots(), so.Perc(3)
+        ).plot()
+
+        frame = plotter._layers[0]["data"].frame
+        assert frame["y"].tolist() == [1, 2, 3]
+        assert frame["percentile"].tolist() == [0, 50, 100]
