diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..4f4a97c
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,65 @@
+"""Statistics that order observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of floats
+        Number of evenly spaced percentile levels to compute between 0 and 100,
+        or explicit percentile levels in that range.
+    method : str
+        Method used to estimate percentiles. One of "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", or "nearest".
+
+    Notes
+    -----
+    The output has one row for each requested percentile in each group, with
+    the percentile value in the value coordinate and its level in
+    ``percentile``. By default, five levels give the minimum, quartiles, and
+    maximum. The default method is "linear".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        method_arg = (
+            "interpolation" if Version(np.__version__) < Version("1.22.0")
+            else "method"
+        )
+        values = np.nanpercentile(
+            data[var], levels, **{method_arg: self.method}
+        )
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
