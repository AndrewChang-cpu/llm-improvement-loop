diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..0f3cf2d
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,58 @@
+"""Statistics that replace observations with ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles to compute from 0 to 100, or an
+        explicit list of percentile levels between 0 and 100.
+    method : str
+        Method used to compute the percentiles. Defaults to ``"linear"``.
+
+        The available methods are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``, ``"hazen"``,
+        ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Notes
+    -----
+    The transform returns one row for each requested percentile in each group.
+    The percentile level is recorded in the ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    group_by_orient = True
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def __call__(self, data, groupby, orient, scales):
+        value = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        def percentile(part):
+            param = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+            kwargs = {param: self.method}
+            values = np.percentile(part[value].dropna(), levels, **kwargs)
+            return pd.DataFrame({value: values, "percentile": levels})
+
+        return groupby.apply(data, percentile)
