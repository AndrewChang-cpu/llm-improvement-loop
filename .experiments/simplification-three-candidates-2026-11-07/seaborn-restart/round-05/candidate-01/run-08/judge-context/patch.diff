diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..3ddcedf
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,75 @@
+import numpy as np
+import pandas as pd
+
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels_and_values(self):
+
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": 0, "group": "a"})
+        result = Perc()(data, GroupBy(["y", "group"]), "y", {})
+
+        assert_array_equal(result["x"], [0, 1, 2, 3, 4])
+        assert_array_equal(result["percentile"], [0, 25, 50, 75, 100])
+        assert result.columns.to_list() == ["x", "y", "group", "percentile"]
+
+    def test_integer_count(self):
+
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": 0})
+        result = Perc(k=3)(data, GroupBy(["y"]), "y", {})
+
+        assert_array_equal(result["percentile"], [0, 50, 100])
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": 0})
+        result = Perc(k=[10, 90], method="nearest")(
+            data, GroupBy(["y"]), "y", {},
+        )
+
+        assert_array_equal(result["percentile"], [10, 90])
+        assert_array_equal(result["x"], [0, 4])
+
+    def test_horizontal_orientation(self):
+
+        data = pd.DataFrame({"x": 0, "y": [0, 1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+        assert result.columns.to_list() == ["x", "y", "percentile"]
+        assert_array_equal(result["y"], [0, 2, 4])
+        assert_array_equal(result["percentile"], [0, 50, 100])
+
+    def test_group_labels_order_and_missing_data(self):
+
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a", "b", "a"],
+            "x": [1, 10, np.nan, 20, 3, 30],
+            "y": [0, 0, 0, 0, 0, 0],
+            "unused": [0, 1, 2, 3, 4, 5],
+        })
+        result = Perc(k=[0, 50, 100])(
+            data, GroupBy({"y": [0], "group": ["a", "b"]}), "y", {},
+        )
+
+        assert result.columns.to_list() == ["group", "x", "y", "percentile"]
+        assert result["group"].to_list() == ["a"] * 3 + ["b"] * 3
+        assert_array_equal(result["percentile"], [0, 50, 100] * 2)
+        assert_array_equal(result["x"], [10, 20, 30, 1, 2, 3])
+
+    def test_imports(self):
+
+        from seaborn.objects import Perc as ObjectsPerc
+
+        assert ObjectsPerc is Perc
+
+    def test_plot_add(self):
+
+        from seaborn.objects import Dots, Plot
+
+        plot = Plot(x=["a", "a", "a", "a"], y=[1, 2, 3, 4])
+        plot.add(Dots(), Perc()).plot()
