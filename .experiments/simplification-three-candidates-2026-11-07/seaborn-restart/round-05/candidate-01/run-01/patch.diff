diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..7d7cb89
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,54 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"y": [1, 2, 3, 4, 5]})
+        result = Perc()(data, GroupBy(["missing"]), "x", {})
+        assert result["y"].tolist() == [1, 2, 3, 4, 5]
+        assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert result.columns.tolist() == ["y", "percentile"]
+
+    def test_count(self):
+        data = pd.DataFrame({"y": [0, 10, 20, 30]})
+        result = Perc(k=3)(data, GroupBy(["missing"]), "x", {})
+        assert result["y"].tolist() == [0, 15, 30]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"y": [0, 10, 20, 30]})
+        result = Perc([25, 50, 75], method="nearest")(
+            data, GroupBy(["missing"]), "x", {}
+        )
+        assert result["y"].tolist() == [10, 20, 20]
+        assert result["percentile"].tolist() == [25, 50, 75]
+
+    def test_horizontal_orientation_and_missing(self):
+        data = pd.DataFrame({"x": [1, np.nan, 3], "y": ["a", "a", "a"]})
+        result = Perc(k=2)(data, GroupBy(["y"]), "y", {})
+        assert result["x"].tolist() == [1, 3]
+        assert result["percentile"].tolist() == [0, 100]
+        assert result["y"].tolist() == ["a", "a"]
+        assert result.columns.tolist() == ["x", "y", "percentile"]
+
+    def test_groups_follow_groupby_order(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [2, 10, 4, 20]})
+        result = Perc(k=2)(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert result["group"].tolist() == ["a", "a", "b", "b"]
+        assert result["y"].tolist() == [10, 20, 2, 4]
+
+
+def test_public_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    plot = so.Plot(
+        pd.DataFrame({"group": ["a"] * 4, "value": [1, 2, 3, 4]}),
+        x="group", y="value",
+    )
+    plot.add(so.Range(), so.Perc([5, 95])).plot()
