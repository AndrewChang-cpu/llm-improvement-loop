diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..db1f4d5
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,72 @@
+"""Statistical transformations that change the order of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels to compute between 0 and 100,
+        inclusive, or an explicit list of levels.
+    method : str
+        Method used to calculate the percentile. Options are
+        "inverted_cdf", "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    The output has one row per requested percentile level and group. The
+    percentile level is recorded in the ``percentile`` column. By default,
+    five levels are computed, corresponding to the minimum, quartiles, and
+    maximum.
+
+    Examples
+    --------
+    The default transform computes quartiles and endpoints. Set ``k`` to
+    request a different number of evenly spaced levels, or provide the levels
+    directly::
+
+        so.Plot(data, x="value").add(so.Dot(), so.Perc())
+        so.Plot(data, x="value").add(so.Dot(), so.Perc(k=3))
+        so.Plot(data, x="value").add(so.Dot(), so.Perc([10, 50, 90]))
+
+    Combine :class:`Perc` with a range mark to show an interval::
+
+        so.Plot(data, x="value").add(so.Range(), so.Perc([5, 95]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        method = (
+            {"method": self.method}
+            if Version(np.__version__) >= Version("1.22.0")
+            else {"interpolation": self.method}
+        )
+        result = np.percentile(values, levels, **method)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
