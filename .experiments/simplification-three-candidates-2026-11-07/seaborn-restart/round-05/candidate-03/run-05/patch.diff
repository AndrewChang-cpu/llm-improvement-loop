diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..beacea3
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,52 @@
+"""Statistical transforms related to ordering observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        An integer requests that many evenly spaced percentiles from 0 to 100;
+        a list specifies the percentiles explicitly.
+    method : str
+        Method used to calculate the percentiles. The default is "linear".
+        Available methods are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "linear", "median_unbiased", "normal_unbiased",
+        "lower", "higher", "midpoint", and "nearest".
+
+    The output has one row for each requested percentile in each group, with
+    the percentile level in a ``percentile`` column. Missing observations are
+    ignored.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kw = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        values = np.nanpercentile(data[var], levels, **kw)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
