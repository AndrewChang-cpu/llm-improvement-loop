diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..02740ee
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,70 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+@pytest.fixture
+def df():
+    return pd.DataFrame({
+        "x": [1, 2, 3, 4, 10, 20, 30, 40],
+        "y": pd.Categorical(["b", "b", "a", "a", "b", "b", "a", "a"],
+                            categories=["b", "a"], ordered=True),
+        "label": ["first"] * 4 + ["second"] * 4,
+    })
+
+
+@pytest.mark.parametrize(
+    "orient, var, grouping",
+    [("y", "x", "y"), ("x", "y", "x")],
+)
+def test_counts_and_groups(df, orient, var, grouping):
+    if orient == "x":
+        df["y"] = df["x"]
+        df["x"] = pd.Categorical(
+            ["b", "b", "a", "a", "b", "b", "a", "a"],
+            categories=["b", "a"], ordered=True,
+        )
+    groupby = GroupBy([grouping, "label"])
+    result = Perc(3)(df, groupby, orient, {})
+
+    expected = []
+    for group, label in [("b", "first"), ("b", "second"),
+                         ("a", "first"), ("a", "second")]:
+        mask = (df[grouping] == group) & (df["label"] == label)
+        values = df.loc[mask, var].dropna()
+        expected.extend({grouping: group, "label": label,
+                         var: np.percentile(values, [0, 50, 100])[i],
+                         "percentile": level}
+                        for i, level in enumerate([0, 50, 100]))
+    result = result[[grouping, "label", var, "percentile"]]
+    assert result.to_dict("records") == expected
+
+
+def test_explicit_levels_and_method(df):
+    result = Perc([25, 75], method="nearest")(
+        df, GroupBy(["y", "label"]), "y", {}
+    )
+    values = df.loc[(df.y == "b") & (df.label == "first"), "x"]
+    expected_values = np.percentile(values, [25, 75], method="nearest")
+    rows = result.query("y == 'b' and label == 'first'")
+    assert rows["x"].tolist() == expected_values.tolist()
+    assert rows["percentile"].tolist() == [25, 75]
+
+
+def test_missing_values_and_columns():
+    data = pd.DataFrame({"x": [1., np.nan, np.nan], "y": ["a", "a", "b"]})
+    result = Perc([0, 50, 100])(data, GroupBy(["y"]), "y", {})
+    assert result.columns.tolist() == ["x", "y", "percentile"]
+    assert result["y"].tolist() == ["a"] * 3 + ["b"] * 3
+    assert result["x"].tolist()[:3] == [1, 1, 1]
+    assert result["x"].iloc[3:].isna().all()
+
+
+def test_imports():
+    from seaborn._stats.order import Perc as InternalPerc
+    from seaborn.objects import Perc as ObjectsPerc
+
+    assert InternalPerc is ObjectsPerc is Perc
