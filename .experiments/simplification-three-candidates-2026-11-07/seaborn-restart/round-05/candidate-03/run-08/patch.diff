diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5b73169
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_imports(self):
+        assert ObjectsPerc is Perc
+
+    def test_default_levels(self):
+        data = pd.DataFrame({"x": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+
+        np.testing.assert_allclose(result["percentile"], [0, 25, 50, 75, 100])
+        np.testing.assert_allclose(result["y"], [1, 2, 3, 4, 5])
+
+    def test_integer_levels_and_group_order(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"],
+            "y": [4, 1, 2, 3],
+            "label": ["z", "a", "z", "a"],
+        })
+        groupby = GroupBy({"x": ["a", "b"], "label": ["a", "z"]})
+
+        result = Perc(k=3)(data, groupby, "x", {})
+
+        assert result.columns.tolist() == ["x", "y", "label", "percentile"]
+        assert result[["x", "label"]].values.tolist() == [
+            ["a", "a"], ["a", "a"], ["a", "a"],
+            ["b", "z"], ["b", "z"], ["b", "z"],
+        ]
+        np.testing.assert_allclose(result["percentile"], [0, 50, 100] * 2)
+        np.testing.assert_allclose(result["y"], [1, 2, 3, 2, 3, 4])
+
+    def test_explicit_levels_method_and_missing_data(self):
+        data = pd.DataFrame({"x": ["a", "a", "a"], "y": [0, np.nan, 10]})
+        result = Perc(k=[25, 75], method="lower")(
+            data, GroupBy(["x"]), "x", {},
+        )
+
+        assert result.columns.tolist() == ["x", "y", "percentile"]
+        np.testing.assert_allclose(result["percentile"], [25, 75])
+        np.testing.assert_allclose(result["y"], [0, 0])
+
+    def test_horizontal_orientation(self):
+        data = pd.DataFrame({"x": [1, 3, 5], "y": ["a"] * 3, "label": ["g"] * 3})
+        result = Perc(k=[0, 100])(data, GroupBy(["y", "label"]), "y", {})
+
+        assert result.columns.tolist() == ["x", "y", "label", "percentile"]
+        np.testing.assert_allclose(result["x"], [1, 5])
+        assert result[["y", "label"]].values.tolist() == [["a", "g"], ["a", "g"]]
+
+    def test_plot_add_with_dots_and_range(self):
+        from seaborn.objects import Dots, Plot, Range
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        Plot(data, x="x", y="y").add(Dots(), Perc(k=3)).plot()
+        Plot(data, x="x", y="y").add(Range(), Perc(k=[10, 90])).plot()
