diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..6292446
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,65 @@
+"""Statistical transformations that change the order of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentiles computed from the data.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, or an
+        explicit list of percentile levels.
+    method : str
+        Method used to estimate the percentiles. The default is "linear".
+        Options are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "linear", "median_unbiased", "normal_unbiased",
+        "lower", "higher", "midpoint", and "nearest".
+
+    Notes
+    -----
+    The result has one row per percentile level and a `percentile` column.
+    Missing observations are ignored.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        param = (
+            "interpolation"
+            if Version(np.__version__) < Version("1.22.0") else "method"
+        )
+        kws = {param: self.method}
+        values = np.nanpercentile(data[var], levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
