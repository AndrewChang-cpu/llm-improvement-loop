new file mode 100644
index 0000000..6d48bcc
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,54 @@
+"""Statistical transformations that order observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with selected percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels in that interval.
+    method : str
+        Method used to calculate the percentiles. The default, ``"linear"``,
+        interpolates between observations. NumPy also supports
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested percentile and group, with the value in the
+        oriented coordinate and the percentile level in ``percentile``.
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def _percentiles(self, data, orient):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        var = "y" if orient == "x" else "x"
+        values = data[var].dropna()
+        if np.lib.NumpyVersion(np.__version__) < "1.22.0":
+            kwargs = {"interpolation": self.method}
+        else:
+            kwargs = {"method": self.method}
+        result = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        return groupby.apply(data, self._percentiles, orient)
