diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..aeca199
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,48 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_percentile_counts(self):
+        data = pd.DataFrame({"x": ["a"] * 5, "y": [1, 2, 3, 4, 5]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(res["percentile"], [0, 50, 100])
+        assert_array_equal(res["y"], [1, 3, 5])
+        assert res.columns.to_list() == ["x", "y", "percentile"]
+
+    def test_explicit_percentiles_and_method(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(k=[25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert_array_equal(res["percentile"], [25, 75])
+        assert_array_equal(res["y"], [2, 3])
+
+    def test_orientation_groups_missing_and_order(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"], "y": [1, 10, np.nan, 30],
+            "group": ["first", "second", "first", "second"],
+        })
+        res = Perc(k=2)(data, GroupBy(["x", "group"]), "x", {})
+        assert res.columns.to_list() == ["x", "y", "group", "percentile"]
+        assert res[["x", "group"]].drop_duplicates().values.tolist() == [
+            ["b", "first"], ["a", "second"]
+        ]
+        assert_array_equal(res["y"], [1, 1, 10, 30])
+
+    def test_horizontal_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": ["a"] * 3})
+        res = Perc(k=3)(data, GroupBy(["y"]), "y", {})
+        assert_array_equal(res["x"], [1, 2, 3])
+
+    def test_public_imports_and_plot_add(self):
+        from seaborn.objects import Perc as ObjectsPerc, Plot, Range
+        from seaborn._stats.order import Perc as StatsPerc
+
+        assert ObjectsPerc is StatsPerc
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        plot = Plot(data, x="x", y="y").add(Range(), Perc(k=[25, 75]))
+        plot.plot()
