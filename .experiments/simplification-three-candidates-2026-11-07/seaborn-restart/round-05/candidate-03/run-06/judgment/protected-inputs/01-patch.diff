diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..48c5d55
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,45 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_imports():
+    assert so.Perc is Perc
+
+
+def test_percentile_count_and_default():
+    data = pd.DataFrame({"x": ["b"] * 4 + ["a"] * 4, "y": [1, 2, 3, 4, 5, 6, 7, 8]})
+    res = Perc()(data, GroupBy(["x"]), "x", {})
+    assert list(res.columns) == ["x", "y", "percentile"]
+    assert res["x"].tolist() == ["b"] * 5 + ["a"] * 5
+    assert res["percentile"].tolist() == [0, 25, 50, 75, 100] * 2
+    np.testing.assert_allclose(res["y"], [1, 1.75, 2.5, 3.25, 4, 5, 5.75, 6.5, 7.25, 8])
+
+
+def test_explicit_levels_and_method():
+    data = pd.DataFrame({"x": [0, 10], "y": [0, 0]})
+    res = Perc([10, 90], method="nearest")(data, GroupBy(["y"]), "y", {})
+    assert res["percentile"].tolist() == [10, 90]
+    np.testing.assert_allclose(res["x"], [0, 10])
+
+
+def test_orientations_missing_and_columns():
+    data = pd.DataFrame({"x": [0, 10, 20], "y": [1, np.nan, 3], "label": ["a"] * 3})
+    res_x = Perc(3)(data, GroupBy(["x", "label"]), "x", {})
+    assert list(res_x.columns) == ["x", "y", "label", "percentile"]
+    assert res_x["x"].tolist() == [0, 0, 0, 10, 10, 10, 20, 20, 20]
+    np.testing.assert_allclose(res_x["y"], [1] * 3 + [np.nan] * 3 + [3] * 3)
+
+    res_y = Perc([0, 50, 100])(data, GroupBy(["y", "label"]), "y", {})
+    assert list(res_y.columns) == ["x", "y", "label", "percentile"]
+    assert res_y["percentile"].tolist() == [0, 50, 100] * 2
+
+
+def test_plot_add_with_range_mark():
+    data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+    plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc())
+    plot.plot()
