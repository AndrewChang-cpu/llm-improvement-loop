diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..99629ac
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,61 @@
+"""Statistical transforms that change the ordering of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentiles computed within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, inclusive, or an
+        explicit list of percentile levels in the range [0, 100].
+    method : str
+        Method used to compute the percentiles. The default is ``"linear"``.
+        See :func:`numpy.nanpercentile` for the available methods:
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    The output has one row for each requested percentile in each group. The
+    value is stored in the orientation-selected coordinate, and the
+    corresponding percentile level is stored in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kwargs = {"interpolation": self.method}
+        if Version(np.__version__) >= Version("1.22.0"):
+            kwargs = {"method": self.method}
+        values = np.nanpercentile(data[var], percentiles, **kwargs)
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
