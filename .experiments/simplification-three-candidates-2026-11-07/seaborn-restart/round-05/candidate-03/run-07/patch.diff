diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..98e2cb5
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,81 @@
+import numpy as np
+import pandas as pd
+
+import seaborn.objects as so
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+
+        data = pd.DataFrame({
+            "x": ["b", "b", "a", "a"],
+            "y": [1, 3, 10, 20],
+            "group": ["z", "z", "y", "y"],
+            "unused": [0, 0, 0, 0],
+        })
+        groupby = GroupBy(["x", "group"])
+        result = Perc()(data, groupby, "x", {})
+
+        expected = pd.DataFrame({
+            "x": ["b"] * 5 + ["a"] * 5,
+            "y": [1, 1.5, 2, 2.5, 3, 10, 12.5, 15, 17.5, 20],
+            "group": ["z"] * 5 + ["y"] * 5,
+            "percentile": [0., 25., 50., 75., 100.] * 2,
+        })
+        pd.testing.assert_frame_equal(result, expected)
+
+    def test_integer_count_and_explicit_levels(self):
+
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["a"] * 4})
+        groupby = GroupBy(["y"])
+
+        result = Perc(k=3)(data, groupby, "y", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["x"].tolist() == [1, 2.5, 4]
+
+        levels = [10, 90]
+        result = Perc(k=levels)(data, groupby, "y", {})
+        assert result["percentile"].tolist() == levels
+        assert result["x"].tolist() == np.percentile(data["x"], levels).tolist()
+
+    def test_method(self):
+
+        data = pd.DataFrame({"x": [0, 10], "y": ["a", "a"]})
+        groupby = GroupBy(["y"])
+        result = Perc(k=[25], method="lower")(data, groupby, "y", {})
+        assert result.loc[0, "x"] == 0
+
+    def test_vertical_orientation(self):
+
+        data = pd.DataFrame({"x": [1, 3, 5], "y": ["b", "b", "a"]})
+        result = Perc(k=2)(data, GroupBy(["y"]), "y", {})
+
+        expected = pd.DataFrame({
+            "x": [1., 3., 5., 5.],
+            "y": ["b", "b", "a", "a"],
+            "percentile": [0., 100., 0., 100.],
+        })
+        pd.testing.assert_frame_equal(result, expected)
+
+    def test_missing_values(self):
+
+        data = pd.DataFrame({"x": ["a"] * 3, "y": [1, np.nan, 3]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert result["y"].tolist() == [1, 2, 3]
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+    def test_imports(self):
+
+        assert so.Perc is Perc
+
+    def test_plot_add_with_range_mark(self):
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        plot = so.Plot(data, x="x", y="y").add(
+            so.Range(), so.Perc(k=[25, 75]),
+        )
+        plot.plot()
