@@ -0,0 +1,67 @@
+"""Statistics that transform observations into order-based values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentiles computed within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of equally spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels in [0, 100]. The output has one row per
+        requested level, with the percentile level in the ``percentile`` column.
+    method : str
+        Method used to estimate the percentile. Defaults to ``"linear"``.
+        Available methods are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``. See :func:`numpy.percentile` for details.
+
+    Examples
+    --------
+    By default, ``Perc`` computes quartiles and endpoints:
+
+    .. code:: python
+
+        so.Plot(data, y="value").add(so.Range(), so.Perc())
+
+    Set ``k`` to request another number of evenly spaced levels, or pass an
+    explicit list:
+
+    .. code:: python
+
+        so.Perc(k=3)
+        so.Perc(k=[10, 50, 90])
+
+    Combine ``Perc`` with a range mark to show a percentile interval:
+
+    .. code:: python
+
+        so.Plot(data, y="value").add(so.Range(), so.Perc(k=[5, 95]))
+    """
+
+    group_by_orient: ClassVar[bool] = True
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def _percentile(self, data, orient):
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        param = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {param: self.method}
+        values = np.nanpercentile(data[orient], levels, **kwargs)
+        return pd.DataFrame({orient: values, "percentile": levels})
+
+    def __call__(self, data, groupby, orient, scales):
+        return groupby.apply(data, self._percentile, orient)
