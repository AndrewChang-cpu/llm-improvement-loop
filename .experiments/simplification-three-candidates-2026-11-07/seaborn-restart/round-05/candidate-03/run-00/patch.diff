diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..871272b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,75 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels(self):
+
+        data = pd.DataFrame({"x": [0, 10, 20, 30]})
+        out = Perc()(data, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert out["x"].tolist() == [0, 7.5, 15, 22.5, 30]
+        assert out.columns.tolist() == ["x", "percentile"]
+
+    def test_integer_levels(self):
+
+        data = pd.DataFrame({"x": [0, 10]})
+        out = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [0, 50, 100]
+        assert out["x"].tolist() == [0, 5, 10]
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"x": [0, 10, 20, 30]})
+        out = Perc(k=[10, 50, 90], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        assert out["percentile"].tolist() == [10, 50, 90]
+        assert out["x"].tolist() == [0, 20, 30]
+
+    def test_orientations(self):
+
+        data = pd.DataFrame({"x": [0, 10, 20], "y": [1, 2, 3]})
+        stat = Perc(k=3)
+        horizontal = stat(data, GroupBy(["group"]), "y", {})
+        vertical = stat(data, GroupBy(["group"]), "x", {})
+        assert horizontal["y"].tolist() == [1, 2, 3]
+        assert vertical["x"].tolist() == [0, 10, 20]
+
+    def test_missing_and_group_order(self):
+
+        data = pd.DataFrame({
+            "group": ["b", "b", "a", "a"],
+            "x": [1, np.nan, 10, 20],
+            "label": ["B", "B", "A", "A"],
+        })
+        out = Perc(k=3)(
+            data, GroupBy({"group": ["a", "b"], "label": ["A", "B"]}), "x", {}
+        )
+        assert out["group"].tolist() == ["a"] * 3 + ["b"] * 3
+        assert out["label"].tolist() == ["A"] * 3 + ["B"] * 3
+        assert out["x"].tolist() == [10, 15, 20, 1, 1, 1]
+        assert out.columns.tolist() == ["group", "x", "label", "percentile"]
+
+    def test_orientation_grouping(self):
+
+        data = pd.DataFrame({"group": ["b", "a"], "x": [2, 1]})
+        out = Perc(k=2)(data, GroupBy(["x", "group"]), "x", {})
+        assert out["x"].tolist() == [1, 1, 2, 2]
+        assert out["group"].tolist() == ["a", "a", "b", "b"]
+        assert out.columns.tolist() == ["group", "x", "percentile"]
+
+
+def test_perc_imports_and_plot_add(monkeypatch):
+
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as StatsPerc
+
+    assert so.Perc is StatsPerc
+    monkeypatch.setattr(so.Dots, "_plot", lambda *args: None)
+    plot = so.Plot(pd.DataFrame({"x": [1, 2, 3]}), x="x")
+    plot.add(so.Dots(), so.Perc(k=[25, 75])).plot()
