diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..00b899d
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,67 @@
+"""Statistics for ordering observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels in [0, 100]. The default produces
+        quartiles and endpoints (0, 25, 50, 75, and 100).
+    method : str
+        Method used to compute the percentiles. Defaults to "linear". See
+        :func:`numpy.percentile` for the available methods: "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    Returns
+    -------
+    DataFrame
+        One row for each requested percentile in each group, with the
+        percentile level in ``percentile`` and its value in the oriented
+        variable. Missing observations are ignored.
+
+    Examples
+    --------
+    ``Perc()`` computes the quartiles and endpoints. ``Perc(k=3)`` requests
+    three evenly spaced levels, and ``Perc(k=[10, 50, 90])`` requests explicit
+    levels. Combine it with a range mark to draw an interval::
+
+        Plot(data, x="x", y="y").add(Range(), Perc(k=[5, 95]))
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: pd.DataFrame, var: str) -> pd.DataFrame:
+        values = data[var].dropna()
+        qs = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        kw = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        result = np.percentile(values if len(values) else [np.nan], qs, **{kw: self.method})
+        return pd.DataFrame({var: result, "percentile": qs})
+
+    def __call__(
+        self, data: pd.DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> pd.DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
