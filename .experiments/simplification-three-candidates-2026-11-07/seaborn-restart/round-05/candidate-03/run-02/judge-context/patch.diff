diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..2963b3a
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,50 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+def test_perc_levels_and_values():
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, 20, 30, 40], "group": ["a"] * 4})
+    res = Perc()(data, GroupBy(["group"]), "x", {})
+    assert res.columns.tolist() == ["y", "group", "percentile"]
+    assert res["percentile"].tolist() == [0, 25, 50, 75, 100]
+    assert res["y"].tolist() == [10, 17.5, 25, 32.5, 40]
+
+
+def test_perc_count_and_explicit_levels():
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, 20, 30, 40], "group": ["a"] * 4})
+    groupby = GroupBy(["group"])
+    count = Perc(k=3)(data, groupby, "x", {})
+    explicit = Perc(k=[10, 90])(data, groupby, "x", {})
+    assert count["percentile"].tolist() == [0, 50, 100]
+    assert explicit["percentile"].tolist() == [10, 90]
+    assert explicit["y"].tolist() == [13, 37]
+
+
+def test_perc_method_and_orientation():
+    data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, 20, 30, 40], "group": ["a"] * 4})
+    x_res = Perc(k=[50], method="nearest")(data, GroupBy(["group"]), "y", {})
+    y_res = Perc(k=[50], method="nearest")(data, GroupBy(["group"]), "x", {})
+    assert x_res["x"].tolist() == [3]
+    assert y_res["y"].tolist() == [30]
+
+
+def test_perc_missing_and_ordered_groups():
+    data = pd.DataFrame({"x": [1, 2, 3, 4, 5], "y": [1, np.nan, 3, 4, 5],
+                         "group": ["b", "b", "a", "a", "a"]})
+    res = Perc(k=[0, 100])(data, GroupBy(["group"]), "x", {})
+    assert res.columns.tolist() == ["y", "group", "percentile"]
+    assert res["group"].tolist() == ["b", "b", "a", "a"]
+    assert res["y"].tolist() == [1, 1, 3, 5]
+
+
+def test_perc_plot_add_and_imports():
+    from seaborn.objects import Perc as PublicPerc, Plot, Range
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert PublicPerc is InternalPerc
+    data = pd.DataFrame({"x": [1, 2, 3, 4]})
+    plot = Plot(data, x="x").add(Range(), PublicPerc(k=[5, 95]))
+    assert plot._layers
