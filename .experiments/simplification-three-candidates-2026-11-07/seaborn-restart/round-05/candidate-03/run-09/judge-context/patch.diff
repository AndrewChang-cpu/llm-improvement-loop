diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..d73dbf7
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,57 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_imports(self):
+        assert ObjectsPerc is Perc
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5], "y": [9, 8, 7, 6, 5], "group": "a"})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+        assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert result["y"].tolist() == [5, 6, 7, 8, 9]
+        assert list(result.columns) == ["y", "group", "percentile"]
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "group": "a"})
+        result = Perc(k=3)(data, GroupBy(["group"]), "y", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+        result = Perc(k=[10, 90])(data, GroupBy(["group"]), "y", {})
+        np.testing.assert_allclose(result["x"], [0.4, 3.6])
+        assert result["percentile"].tolist() == [10, 90]
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 10], "group": "a"})
+        result = Perc(k=[25], method="lower")(data, GroupBy(["group"]), "y", {})
+        assert result["x"].tolist() == [0]
+
+    def test_group_labels_order_and_missing(self):
+        data = pd.DataFrame({
+            "y": ["b", "a", "b", "a"],
+            "x": [1, 2, np.nan, 4],
+            "label": ["B", "A", "B", "A"],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy(["y", "label"]), "y", {},
+        )
+        assert result[["y", "label"]].values.tolist() == [
+            ["b", "B"], ["b", "B"], ["a", "A"], ["a", "A"],
+        ]
+        assert result["x"].tolist() == [1, 1, 2, 4]
+        assert list(result.columns) == ["y", "x", "label", "percentile"]
+
+    def test_orientation_and_plot_add(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [5, 6, 7, 8], "group": "a"})
+        vertical = Perc(k=2)(data, GroupBy(["group"]), "y", {})
+        horizontal = Perc(k=2)(data, GroupBy(["group"]), "x", {})
+        assert "x" in vertical and "y" in horizontal
+
+        import seaborn.objects as so
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[25, 75]))
+        plot.plot()
