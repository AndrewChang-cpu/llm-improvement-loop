diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..9425133
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        out = Perc()(data, GroupBy(["x"]), "x", {})
+
+        assert out.columns.tolist() == ["x", "y", "percentile"]
+        assert out["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert out["y"].tolist() == [1, 1.75, 2.5, 3.25, 4]
+
+    def test_count_and_levels(self):
+        data = pd.DataFrame({"x": ["a"] * 3, "y": [1, 2, 3]})
+
+        count = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        explicit = Perc(k=[10, 90])(data, GroupBy(["x"]), "x", {})
+
+        assert count["percentile"].tolist() == [0, 50, 100]
+        assert explicit["percentile"].tolist() == [10, 90]
+        assert explicit["y"].tolist() == [1.2, 2.8]
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, np.nan, 4]})
+        out = Perc(k=[50], method="lower")(data, GroupBy(["x"]), "x", {})
+
+        assert out["percentile"].tolist() == [50]
+        assert out["y"].tolist() == [2]
+
+    def test_orientation_group_labels_and_order(self):
+        data = pd.DataFrame({
+            "x": [1, 3, 10, 20],
+            "y": pd.Categorical(["a", "a", "b", "b"], categories=["b", "a"]),
+            "label": ["first", "first", "second", "second"],
+            "unused": [0, 1, 2, 3],
+        })
+        out = Perc(k=[0, 100])(data, GroupBy(["y", "label"]), "y", {})
+
+        assert out.columns.tolist() == ["x", "y", "label", "percentile"]
+        assert out["y"].tolist() == ["b", "b", "a", "a"]
+        assert out["label"].tolist() == ["second", "second", "first", "first"]
+        assert out["x"].tolist() == [10, 20, 1, 3]
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": ["a"] * 3})
+        out = Perc(k=[50])(data, GroupBy(["y"]), "y", {})
+
+        assert out.columns.tolist() == ["x", "y", "percentile"]
+        assert out["x"].tolist() == [2]
+
+
+def test_plot_add_with_range():
+    from seaborn.objects import Perc, Plot, Range
+
+    data = pd.DataFrame({"group": ["a"] * 4, "value": [1, 2, 3, 4]})
+    Plot(data, x="group", y="value").add(Range(), Perc([25, 75])).plot()
