diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..60b29c1
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,83 @@
+import numpy as np
+import pandas as pd
+
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels(self):
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4], "unused": 0})
+        res = Perc()(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": ["a"] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count(self):
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+        assert res["percentile"].tolist() == [0, 50, 100]
+        assert res["y"].tolist() == [1, 2.5, 4]
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(k=[10, 90], method="nearest")(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": ["a", "a"], "y": [1, 4], "percentile": [10, 90],
+        })
+        assert_frame_equal(res, expected)
+
+    def test_horizontal_orientation(self):
+
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": ["a"] * 4})
+        res = Perc(k=3)(data, GroupBy(["y"]), "y", {})
+
+        assert res.columns.tolist() == ["x", "y", "percentile"]
+        assert res["x"].tolist() == [1, 2.5, 4]
+        assert res["y"].tolist() == ["a"] * 3
+
+    def test_missing_data(self):
+
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, np.nan, 3, 4]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+        assert res["y"].tolist() == [1, 3, 4]
+        assert res["percentile"].tolist() == [0, 50, 100]
+
+    def test_group_labels_and_order(self):
+
+        data = pd.DataFrame({
+            "x": pd.Categorical(["b", "b", "a", "a"], ["b", "a"], ordered=True),
+            "group": pd.Categorical(["z", "z", "y", "y"], ["z", "y"], ordered=True),
+            "y": [1, 3, 5, 7],
+            "unused": [1, 2, 3, 4],
+        })
+        res = Perc(k=2)(data, GroupBy(["x", "group"]), "x", {})
+
+        assert res.columns.tolist() == ["x", "group", "y", "percentile"]
+        assert list(zip(res.x.astype(str), res.group.astype(str))) == [
+            ("b", "z"), ("b", "z"), ("a", "y"), ("a", "y"),
+        ]
+        assert res.y.tolist() == [1, 3, 5, 7]
+
+    def test_public_imports_and_plot_add(self):
+
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as StatsPerc
+
+        assert so.Perc is StatsPerc
+        so.Plot(pd.DataFrame({"x": ["a", "a"], "y": [1, 2]}), "x", "y").add(
+            so.Range(), so.Perc(k=[25, 75]),
+        ).plot()
