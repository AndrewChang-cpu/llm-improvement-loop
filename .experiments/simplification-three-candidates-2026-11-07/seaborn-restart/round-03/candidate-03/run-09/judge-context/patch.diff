diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..947abed
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+import seaborn.objects as so
+
+
+class TestPerc:
+
+    def test_imports(self):
+        assert PublicPerc is Perc
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1, 1], "y": [1, 2, 3, 4, 5]})
+        gb = GroupBy(["x"])
+        default = Perc()(data, gb, "x", {})
+        assert_frame_equal(default, pd.DataFrame({
+            "x": [1] * 5, "y": [1., 2., 3., 4., 5.], "percentile": [0., 25., 50., 75., 100.],
+        }))
+        assert len(Perc(3)(data, gb, "x", {})) == 3
+
+    def test_levels_method_groups_and_missing(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a", "b", "a"],
+            "x": [1, 1, 2, 2, 3, 3],
+            "y": [1., 2., 3., np.nan, 5., 6.],
+        })
+        res = Perc([50, 100], method="lower")(
+            data, GroupBy(["group", "x"]), "x", {},
+        )
+        expected = pd.DataFrame({
+            "group": ["b", "b", "b", "b", "b", "b", "a", "a", "a", "a"],
+            "x": [1, 1, 2, 2, 3, 3, 1, 1, 3, 3],
+            "y": [1., 1., 3., 3., 5., 5., 2., 2., 6., 6.],
+            "percentile": [50, 100] * 5,
+        })
+        assert_frame_equal(res, expected)
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [1, 1, 1]})
+        res = Perc([0, 100])(data, GroupBy(["y"]), "y", {})
+        assert res.columns.tolist() == ["x", "y", "percentile"]
+        assert res["x"].tolist() == [1, 3]
+
+    def test_plot_add(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [4, 1, 3, 2]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc())
+        assert plot.plot()._figure is not None
