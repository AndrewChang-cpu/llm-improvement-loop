diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a3cf438
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,57 @@
+"""Statistics that order or select observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values within each group.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, or explicit
+        percentile levels. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile` (default ``"linear"``).
+
+    The output contains one row per requested percentile, with the level in
+    the ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna().to_numpy()
+        if not len(values):
+            return pd.DataFrame({
+                var: pd.Series(dtype=float),
+                "percentile": pd.Series(dtype=np.asarray(levels).dtype),
+            })
+        kws = {"interpolation": self.method}
+        if np.lib.NumpyVersion(np.__version__) >= "1.22.0":
+            kws = {"method": self.method}
+        percentiles = np.percentile(values, levels, **kws)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
