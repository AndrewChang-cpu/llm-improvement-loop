diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..c5a7f0f
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,99 @@
+"""Statistical transforms that change the ordering of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels. The default produces quartiles.
+    method : str
+        Method used to calculate the percentiles, as in :func:`numpy.percentile`.
+        The default is ``"linear"``. Choices are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Each requested level produces one row per group, with the computed value
+    and the level in a ``percentile`` column. These rows describe percentile
+    values; they are not point estimates or intervals.
+
+    Examples
+    --------
+    .. code-block:: python
+
+        import seaborn as sns
+        import seaborn.objects as so
+        penguins = sns.load_dataset("penguins")
+
+    Use the default quartile levels:
+
+    .. code-block:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(so.Dot(), so.Perc())
+
+    Request the endpoints, a count of levels, or specific levels:
+
+    .. code-block:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Dot(), so.Perc([0, 100])
+        )
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Dot(), so.Perc(5)
+        )
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Dot(), so.Perc([10, 50, 90])
+        )
+
+    Combine ``Perc`` with a range mark to draw a percentile interval:
+
+    .. code-block:: python
+
+        (
+            so.Plot(penguins, x="species", y="body_mass_g")
+            .add(so.Range(), so.Perc([10, 90]))
+        )
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    @staticmethod
+    def _compute(data: DataFrame, var: str, percentiles, method: str) -> DataFrame:
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            result = np.nanpercentile(values, percentiles, interpolation=method)
+        else:
+            result = np.nanpercentile(values, percentiles, method=method)
+        return pd.DataFrame({var: result, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, int):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+        return groupby.apply(data, self._compute, var, percentiles, self.method)
