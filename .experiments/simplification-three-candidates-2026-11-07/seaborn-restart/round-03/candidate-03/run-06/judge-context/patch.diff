diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..c6dac3d
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,56 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc, Plot, Dots, Range
+
+
+class TestPerc:
+
+    def test_public_import_and_plot_add(self):
+        assert PublicPerc is Perc
+        data = pd.DataFrame({"group": ["a", "a", "a"], "value": [1, 2, 3]})
+        plot = Plot(data, x="group", y="value").add(Dots(), Perc(k=3))
+        plotter = plot.plot()
+        result = plotter._layers[0]["data"].frame
+        assert result["y"].tolist() == [1, 2, 3]
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+    def test_range_mark(self):
+        data = pd.DataFrame({"group": ["a", "a", "a"], "value": [1, 2, 3]})
+        Plot(data, x="group", y="value").add(Range(), Perc(k=[0, 100])).plot()
+
+    def test_count(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [0, 10, 20, 30]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert_frame_equal(result, pd.DataFrame({
+            "x": [1, 1, 1], "y": [0., 15., 30.], "percentile": [0., 50., 100.],
+        }))
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [1, 1, 1], "y": [0, 10, 20]})
+        result = Perc([25, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {},
+        )
+        assert result["y"].tolist() == [0, 20]
+        assert result["percentile"].tolist() == [25, 75]
+
+    def test_groups_missing_and_order(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"], "y": [10, 1, np.nan, 3],
+            "unused": [0, 0, 0, 0],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy(["x"]), "x", {},
+        )
+        assert result.columns.tolist() == ["x", "y", "percentile"]
+        assert result["x"].tolist() == ["b", "b", "a", "a"]
+        assert result["y"].tolist() == [10, 10, 1, 3]
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [0, 10, 20], "y": [1, 1, 1]})
+        result = Perc(k=2)(data, GroupBy(["y"]), "y", {})
+        assert result.columns.tolist() == ["x", "y", "percentile"]
+        assert result["x"].tolist() == [0, 20]
