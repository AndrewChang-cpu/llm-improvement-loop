diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..48bbe82
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,69 @@
+"""Statistics that transform observations while preserving their order."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, inclusive, or an
+        explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile` (default ``"linear"``).
+        Choices are ``inverted_cdf``, ``averaged_inverted_cdf``,
+        ``closest_observation``, ``interpolated_inverted_cdf``, ``hazen``,
+        ``weibull``, ``linear``, ``median_unbiased``, ``normal_unbiased``,
+        ``lower``, ``higher``, ``midpoint``, and ``nearest``.
+
+    Returns one row for each percentile level, with the computed value and
+    level in the ``percentile`` column. These are percentile rows, not a point
+    estimate or interval.
+
+    Examples
+    --------
+    Default quartiles and endpoints, an integer count, explicit levels, and
+    an interval drawn with a range mark::
+
+        import seaborn.objects as so
+
+        data = {"group": ["a", "a", "a", "a"], "value": [1, 2, 3, 4]}
+        p = so.Plot(data, x="group", y="value")
+        p.add(so.Dots(), so.Perc())  # 0, 25, 50, 75, 100
+        p.add(so.Dots(), so.Perc(k=3))  # 0, 50, 100
+        p.add(so.Dots(), so.Perc(k=[10, 50, 90]))
+        p.add(so.Range(), so.Perc(k=[10, 90]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        q = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        if Version(np.__version__) < Version("1.22.0"):
+            kw = {"interpolation": self.method}
+        else:
+            kw = {"method": self.method}
+        return pd.DataFrame({var: np.percentile(values, q, **kw), "percentile": q})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
