diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..aa3cd26
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,88 @@
+"""Statistics that transform data ordering or distribution."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """
+    Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method passed to :func:`numpy.percentile`. Defaults to "linear". Options
+        are "inverted_cdf", "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher", "midpoint",
+        and "nearest".
+
+    The result contains one row for each requested percentile and group, with
+    the computed value and its percentile level. It represents percentile rows,
+    not a point estimate or interval.
+
+    Examples
+    --------
+    Load example data and import the objects interface:
+
+    .. code-block:: python
+
+        import seaborn.objects as so
+        from seaborn import load_dataset
+        penguins = load_dataset("penguins")
+
+    Default quartiles, including the endpoints, can be plotted with:
+
+    .. code-block:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(so.Dot(), so.Perc())
+
+    Choose an integer number of levels or explicit levels:
+
+    .. code-block:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(so.Dot(), so.Perc(k=10))
+        so.Plot(penguins, x="species", y="body_mass_g").add(so.Dot(), so.Perc(k=[25, 50, 75]))
+
+    Combine percentiles with a range mark to show an interval:
+
+    .. code-block:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(so.Range(), so.Perc(k=[5, 95]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+
+        var = {"x": "y", "y": "x"}[orient]
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(data):
+            vals = data[var].dropna()
+            if Version(np.__version__) < Version("1.22.0"):
+                values = np.percentile(vals, percentiles, interpolation=self.method)
+            else:
+                values = np.percentile(vals, percentiles, method=self.method)
+            return pd.DataFrame({var: values, "percentile": percentiles})
+
+        return groupby.apply(data, percentile).reset_index(drop=True)
