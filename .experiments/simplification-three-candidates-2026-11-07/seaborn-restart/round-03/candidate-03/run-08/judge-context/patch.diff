diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..062a920
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,42 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Dots, Perc as PublicPerc, Plot
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "y": [4, 1, 2, 3]})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["b"] * 5 + ["a"] * 5,
+            "y": [2, 2.5, 3, 3.5, 4, 1, 1.5, 2, 2.5, 3],
+            "percentile": [0., 25, 50, 75, 100] * 2,
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"group": ["a"] * 3, "x": [9, 1, 3]})
+        args = data, GroupBy(["group"]), "y", {}
+        result = Perc(3)(*args)
+        assert result["percentile"].tolist() == [0, 50, 100]
+        assert result["x"].tolist() == [1, 3, 9]
+        explicit = Perc([10, 90])(*args)
+        assert explicit["percentile"].tolist() == [10, 90]
+        np.testing.assert_allclose(explicit["x"], [1.4, 7.8])
+
+    def test_method_missing_and_exports(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1., np.nan, 2., 8.]})
+        result = Perc([25, 50], method="nearest")(data, GroupBy(["group"]), "x", {})
+        assert result["group"].tolist() == ["a", "a"]
+        assert result["y"].tolist() == [1, 2]
+        assert PublicPerc is Perc
+
+    def test_plot_add(self):
+        data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 2, 3, 4]})
+        plot = Plot(data, x="x", y="y").add(Dots(), Perc())
+        plot.plot()
