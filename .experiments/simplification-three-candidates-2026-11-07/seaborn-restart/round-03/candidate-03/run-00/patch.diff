diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..e44458c
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,82 @@
+"""Statistical transforms related to ordering observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from pandas import DataFrame
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or the
+        levels to compute directly. Defaults to 5.
+    method : str
+        Method used to calculate the percentiles, passed to
+        :func:`numpy.percentile`. Defaults to ``"linear"``. Choices are
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    The output has one row per requested percentile and group, with the
+    computed value and its percentile level. These are percentile rows, not a
+    point estimate or interval.
+
+    Examples
+    --------
+    Default quartiles and endpoints:
+
+    .. code-block:: python
+
+        p = so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc())
+
+    Request three levels or specify them directly:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc(3))
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc([10, 50, 90]))
+
+    Combine percentile rows with a range mark to draw an interval:
+
+    .. code-block:: python
+
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc([2.5, 97.5]))
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _process(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, int):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+        param = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {param: self.method}
+        values = np.percentile(data[var].dropna(), percentiles, **kwargs)
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._process, var).reset_index(drop=True)
