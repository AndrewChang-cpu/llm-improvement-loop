diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a5b2b03
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_integer_count(self):
+        data = pd.DataFrame({"y": [0, 0, 0, 0], "x": [1, 2, 3, 4]})
+        out = Perc(k=3)(data, GroupBy(["y"]), "y", {})
+        assert_array_equal(out["percentile"], [0, 50, 100])
+        assert_array_equal(out["x"], [1, 2.5, 4])
+        assert list(out) == ["y", "x", "percentile"]
+        out = Perc()(data, GroupBy(["y"]), "y", {})
+        assert_array_equal(out["percentile"], [0, 25, 50, 75, 100])
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"y": [0, 0, 0, 0], "x": [1, 2, 3, 4]})
+        out = Perc(k=[25, 50, 75], method="lower")(
+            data, GroupBy(["y"]), "y", {},
+        )
+        assert_array_equal(out["percentile"], [25, 50, 75])
+        assert_array_equal(out["x"], [1, 2, 3])
+
+    def test_groups_order_and_missing_values(self):
+        data = pd.DataFrame({
+            "x": [2, 2, 1, 1, 2, 1],
+            "group": ["b", "b", "b", "b", "a", "a"],
+            "y": [4, np.nan, 2, 6, 8, 10],
+            "extra": [0, 1, 2, 3, 4, 5],
+        })
+        groupby = GroupBy({"x": [2, 1], "group": ["a", "b"]})
+        out = Perc(k=[0, 100])(data, groupby, "x", {})
+        assert list(out) == ["x", "group", "y", "percentile"]
+        assert list(zip(out["x"], out["group"], out["percentile"])) == [
+            (2, "a", 0), (2, "a", 100),
+            (2, "b", 0), (2, "b", 100),
+            (1, "a", 0), (1, "a", 100),
+            (1, "b", 0), (1, "b", 100),
+        ]
+        assert_array_equal(out["y"], [8, 8, 4, 4, 10, 10, 2, 6])
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"x": [1, 3, 5], "y": [0, 0, 0]})
+        out = Perc(k=[50])(data, GroupBy(["y"]), "y", {})
+        assert list(out) == ["x", "y", "percentile"]
+        assert_array_equal(out["x"], [3])
+
+    def test_imports_and_plot_add(self):
+        from seaborn import objects
+
+        assert objects.Perc is Perc
+        data = pd.DataFrame({"x": ["a", "a", "b", "b"], "y": [1, 3, 2, 4]})
+        plotter = so.Plot(data, x="x", y="y").add(so.Dots(), so.Perc(k=3)).plot()
+        out = plotter._layers[0]["data"].frame
+        assert list(out) == ["x", "y", "percentile"]
+        assert list(out["percentile"]) == [0, 50, 100] * 2
+        assert_array_equal(out.loc[out.x == 0, "y"], [1, 2, 3])
