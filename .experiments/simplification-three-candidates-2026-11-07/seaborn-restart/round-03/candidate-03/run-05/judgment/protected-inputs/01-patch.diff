diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..71027fe
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,55 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_default_and_integer_count(self):
+        data = pd.DataFrame({"x": ["b", "a", "b", "a"], "y": [1, 2, 3, 4]})
+        groupby = GroupBy(["x"])
+
+        result = Perc()(data, groupby, "x", {})
+        expected = pd.DataFrame({
+            "x": ["b"] * 5 + ["a"] * 5,
+            "y": [1, 1.5, 2, 2.5, 3, 2, 2.5, 3, 3.5, 4],
+            "percentile": [0., 25., 50., 75., 100.] * 2,
+        })
+        assert_frame_equal(result, expected)
+
+        result = Perc(3)(data, groupby, "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100] * 2
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [0, 2, 10, np.nan]})
+        result = Perc([25, 75], method="nearest")(
+            data, GroupBy(["x"]), "x", {}
+        )
+        expected = pd.DataFrame({
+            "x": ["a", "a"], "y": [0., 10.], "percentile": [25, 75],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_orientation_and_group_order(self):
+        data = pd.DataFrame({
+            "y": [2, 1, 4, 3], "x": [10, 20, 10, 20],
+            "group": ["b", "b", "a", "a"],
+        })
+        result = Perc([0, 100])(data, GroupBy(["y", "group"]), "y", {})
+        assert result.columns.tolist() == ["y", "x", "group", "percentile"]
+        assert result[["y", "group"]].drop_duplicates().values.tolist() == [
+            [1, "b"], [2, "b"], [3, "a"], [4, "a"],
+        ]
+        assert result["x"].tolist() == [20, 20, 10, 10, 20, 20, 10, 10]
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+
+        assert ObjectsPerc is Perc
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), so.Perc([25, 75]))
+        plot.plot()
