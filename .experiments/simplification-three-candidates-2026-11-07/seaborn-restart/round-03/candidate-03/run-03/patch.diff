diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..115d0e6
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,87 @@
+"""Statistics that order observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of percentile levels to compute. Defaults to 5, which returns
+        the endpoints and quartiles.
+    method : str
+        Method used to estimate percentiles, as in :func:`numpy.percentile`.
+        Defaults to ``"linear"``. Choices are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    The output contains one row for each requested percentile in each group.
+    The computed value is stored in the value variable and its level in a
+    ``percentile`` column. These rows describe percentile values, not a point
+    estimate or interval.
+
+    Examples
+    --------
+    .. code:: python
+
+        import seaborn.objects as so
+        from seaborn import load_dataset
+        penguins = load_dataset("penguins")
+
+    The default returns the endpoints and quartiles::
+
+        so.Plot(penguins, y="body_mass_g").add(so.Dot(), so.Perc())
+
+    Set an integer count to request that many evenly spaced levels::
+
+        so.Plot(penguins, y="body_mass_g").add(so.Dot(), so.Perc(k=3))
+
+    Or pass a list of levels directly::
+
+        so.Plot(penguins, y="body_mass_g").add(
+            so.Dot(), so.Perc(k=[10, 50, 90])
+        )
+
+    Combine the endpoints with a range mark to draw an interval::
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Range(), so.Perc(k=[2.5, 97.5])
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        if Version(np.__version__) >= Version("1.22.0"):
+            kwarg = "method"
+        else:
+            kwarg = "interpolation"
+        kwargs = {kwarg: self.method}
+        values = np.percentile(data[var].dropna(), levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var)
