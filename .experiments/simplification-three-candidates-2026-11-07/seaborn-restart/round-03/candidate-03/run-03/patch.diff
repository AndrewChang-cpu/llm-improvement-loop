diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..a8b4b79
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,61 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [2, 4, 6, 8], "group": ["a"] * 4})
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+
+        assert res.columns.to_list() == ["y", "group", "percentile"]
+        assert res["percentile"].to_list() == [0, 25, 50, 75, 100]
+        assert res["y"].to_list() == [2, 3.5, 5, 6.5, 8]
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 10, 20]})
+        counted = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert counted.groupby("x")["percentile"].apply(list).to_dict() == {
+            0: [0, 50, 100], 1: [0, 50, 100],
+        }
+
+        selected = Perc(k=[10, 90])(data, GroupBy(["x"]), "x", {})
+        assert selected.groupby("x")["y"].apply(list).to_dict() == {
+            0: [1.2, 2.8], 1: [11, 19],
+        }
+
+    def test_method_missing_and_orientation(self):
+        data = pd.DataFrame({
+            "x": [1, np.nan, 3, 5], "y": [1, 2, 3, 4],
+            "group": ["a", "a", "a", "a"],
+        })
+        res = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["group"]), "y", {},
+        )
+        assert res.columns.to_list() == ["x", "group", "percentile"]
+        assert res["x"].to_list() == [1, 5]
+        assert res["group"].to_list() == ["a", "a"]
+        assert res["percentile"].to_list() == [25, 75]
+
+    def test_group_order_and_labels(self):
+        data = pd.DataFrame({
+            "group": pd.Categorical(["b", "a", "b", "a"], categories=["a", "b"]),
+            "y": [2, 10, 4, 20],
+        })
+        res = Perc(k=[50])(data, GroupBy(["group"]), "x", {})
+        assert res.columns.to_list() == ["group", "y", "percentile"]
+        assert res["group"].to_list() == ["a", "b"]
+        assert res["y"].to_list() == [15, 3]
+
+    def test_plot_add_and_public_import(self):
+        from seaborn.objects import Plot, Range
+
+        assert PublicPerc is Perc
+        plot = Plot(x=[1, 1, 1], y=[2, 4, 8]).add(Range(), Perc(k=[0, 100]))
+        plotter = plot.plot()
+        data = plotter._layers[0]["data"].frame
+        assert data["percentile"].to_list() == [0, 100]
