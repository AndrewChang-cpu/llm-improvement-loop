diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..6187f66
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,59 @@
+"""Ordering-related statistical transformations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, or an
+        explicit list of percentile levels. Defaults to 5.
+    method : str
+        Method used to calculate the percentiles, as in :func:`numpy.percentile`.
+        Choices are ``inverted_cdf``, ``averaged_inverted_cdf``,
+        ``closest_observation``, ``interpolated_inverted_cdf``, ``hazen``,
+        ``weibull``, ``linear`` (the default), ``median_unbiased``,
+        ``normal_unbiased``, ``lower``, ``higher``, ``midpoint``, and ``nearest``.
+
+    Notes
+    -----
+    The output contains one row per requested percentile level, with the
+    computed value and its level in the ``percentile`` column. These rows
+    represent percentile values, not a point estimate or interval.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile(data: DataFrame) -> DataFrame:
+            values = data[var].dropna()
+            if values.empty:
+                return pd.DataFrame(columns=[var, "percentile"])
+            kwargs = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+            result = np.percentile(values, levels, **kwargs)
+            return pd.DataFrame({var: result, "percentile": levels})
+
+        return groupby.apply(data, percentile).reset_index(drop=True)
