diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..57347cf
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,47 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+
+
+class TestPerc:
+
+    def test_imports(self):
+        assert PublicPerc is Perc
+
+    def test_default_levels_and_group_order(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "y": [1, 2, 3, 4],
+        })
+        res = Perc()(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a"] * 5 + ["b"] * 5,
+            "y": [2, 2.5, 3, 3.5, 4, 1, 1.5, 2, 2.5, 3],
+            "percentile": [0., 25., 50., 75., 100.] * 2,
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count_levels(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+        res = Perc(3)(data, GroupBy(["group"]), "x", {})
+        assert res["percentile"].tolist() == [0, 50, 100]
+        assert res["y"].tolist() == [1, 2.5, 4]
+
+    def test_explicit_levels_method_and_missing(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, np.nan, 3, 4]})
+        res = Perc([25, 75], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        assert res["percentile"].tolist() == [25, 75]
+        assert res["y"].tolist() == [1, 4]
+
+    def test_orientation(self):
+        data = pd.DataFrame({"group": ["a", "a", "a"], "x": [1, 2, 3]})
+        res = Perc(3)(data, GroupBy(["group"]), "y", {})
+        assert res.columns.tolist() == ["group", "x", "percentile"]
+        assert res["x"].tolist() == [1, 2, 3]
+
