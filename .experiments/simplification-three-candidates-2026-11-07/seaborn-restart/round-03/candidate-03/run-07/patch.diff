+++ b/tests/_stats/test_order.py
@@ -0,0 +1,70 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count_and_default_levels(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": ["a"] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_explicit_values_and_method(self):
+        data = pd.DataFrame({"x": ["a"] * 4, "y": [1, 2, 3, 4]})
+        result = Perc(k=3, method="nearest")(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": ["a"] * 3,
+            "y": [1, 3, 4],
+            "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+        result = Perc(k=[10, 90])(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": ["a"] * 2,
+            "y": [1.3, 3.7],
+            "percentile": [10, 90],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_grouping_order_and_missing(self):
+        data = pd.DataFrame({
+            "x": ["b", "a", "b", "a"],
+            "y": [2, 10, np.nan, 20],
+            "group": ["g", "g", "g", "g"],
+        })
+        result = Perc(k=[0, 100])(data, GroupBy(["x", "group"]), "x", {})
+        expected = pd.DataFrame({
+            "x": ["b", "b", "a", "a"],
+            "y": [2., 2., 10., 20.],
+            "group": ["g"] * 4,
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [1, 3, 2, 6], "y": [4, 4, 5, 5]})
+        result = Perc(k=2)(data, GroupBy(["y"]), "y", {})
+        assert_frame_equal(result, pd.DataFrame({
+            "x": [1., 3., 2., 6.], "y": [4, 4, 5, 5],
+            "percentile": [0., 100., 0., 100.],
+        }))
+
+    def test_plot_add(self):
+        plot = so.Plot(x=["a", "a", "a"], y=[1, 2, 3]).add(
+            so.Range(), so.Perc(k=[5, 95]),
+        )
+        plot.plot()
+
+    def test_public_import(self):
+        assert so.Perc is Perc
