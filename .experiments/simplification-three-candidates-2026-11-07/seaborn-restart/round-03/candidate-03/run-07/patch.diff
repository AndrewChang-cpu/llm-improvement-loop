diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a05b93f
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,60 @@
+"""Statistics that order or transform observations along an axis."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles between 0 and 100 (inclusive), or
+        a list of explicit percentile levels. Defaults to 5. The result has
+        one row per requested percentile and records the level in a
+        ``percentile`` column.
+    method : str
+        Percentile method as in :func:`numpy.percentile`. Defaults to
+        "linear". Choices are "inverted_cdf", "averaged_inverted_cdf",
+        "closest_observation", "interpolated_inverted_cdf", "hazen",
+        "weibull", "linear", "median_unbiased", "normal_unbiased",
+        "lower", "higher", "midpoint", and "nearest".
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        method_arg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {method_arg: self.method}
+        values = np.nanpercentile(data[var], levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
