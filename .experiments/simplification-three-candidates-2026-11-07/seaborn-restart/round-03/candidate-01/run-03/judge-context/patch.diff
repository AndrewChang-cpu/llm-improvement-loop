--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,66 @@
+"""Statistical transformations that operate on ordered observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels, or specific levels between
+        0 and 100. The default is 5, which returns quartiles and endpoints.
+    method : str
+        Method used to estimate percentiles, as passed to
+        :func:`numpy.percentile`. The default, ``"linear"``, interpolates
+        between observations. Other options are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Notes
+    -----
+    The output contains one row for each requested percentile level and group.
+    The percentile values are on the dependent axis, and the requested levels
+    are recorded in a ``percentile`` column. These are percentile rows, not an
+    estimate or interval.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        kwarg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {kwarg: self.method}
+        return pd.DataFrame({
+            var: np.percentile(values, levels, **kwargs),
+            "percentile": levels,
+        })
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
