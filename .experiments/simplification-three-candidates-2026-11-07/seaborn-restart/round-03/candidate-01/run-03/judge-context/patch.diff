+++ b/tests/_stats/test_order.py
@@ -0,0 +1,67 @@
+import numpy as np
+import pandas as pd
+import pytest
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25, 50, 75, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    @pytest.mark.parametrize("k, levels", [(3, [0, 50, 100]), ([10, 90], [10, 90])])
+    def test_levels(self, k, levels):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 9]})
+        result = Perc(k)(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == levels
+        np.testing.assert_array_equal(result["y"].to_numpy(), np.percentile([1, 2, 9], levels))
+
+    def test_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 9]})
+        result = Perc([25, 50, 75], "nearest")(data, GroupBy(["x"]), "x", {})
+        expected = np.percentile([1, 2, 9], [25, 50, 75], method="nearest")
+        assert result["y"].tolist() == expected.tolist()
+
+    def test_orientation_and_missing(self):
+        data = pd.DataFrame({"x": [1, 2, np.nan], "y": [0, 0, 0]})
+        result = Perc(3)(data, GroupBy(["y"]), "y", {})
+        assert result["x"].tolist() == [1, 1.5, 2]
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+    def test_orientation_groups(self):
+        data = pd.DataFrame({
+            "x": [0, 0, 0, 0], "y": [1, 3, 10, 30],
+            "orient": ["x", "x", "y", "y"],
+        })
+        result = Perc(2)(data, GroupBy(["orient", "x"]), "x", {})
+        assert result[["orient", "x"]].drop_duplicates().values.tolist() == [
+            ["x", 0], ["y", 0],
+        ]
+        assert result["y"].tolist() == [1, 3, 10, 30]
+
+    def test_grouping_and_order(self):
+        data = pd.DataFrame({
+            "x": [2, 2, 1, 1], "y": [20, 40, 10, 30], "group": ["b", "b", "a", "a"]
+        })
+        result = Perc(2)(data, GroupBy({"x": [1, 2], "group": ["a", "b"]}), "x", {})
+        assert result.columns.tolist() == ["x", "y", "group", "percentile"]
+        assert result[["x", "group"]].drop_duplicates().values.tolist() == [[1, "a"], [2, "b"]]
+        assert result["y"].tolist() == [10, 30, 20, 40]
+
+    def test_public_import_and_plot_add(self):
+        import seaborn.objects as so
+
+        assert so.Perc is Perc
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        plot = so.Plot(data, "x", "y").add(so.Range(), so.Perc([25, 75]))
+        plot.plot()
