diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..642c6c5
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,37 @@
+import numpy as np
+import pandas as pd
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_count_and_levels(self):
+        data = pd.DataFrame({"x": [1, 1, 1], "y": [1, 2, 3]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert result["y"].tolist() == [1, 1.5, 2, 2.5, 3]
+
+        result = Perc([10, 90])(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [10, 90]
+
+    def test_orientation_grouping_and_order(self):
+        data = pd.DataFrame({"x": [2, 1, 2, 1], "y": [3, 4, 1, 2], "g": ["b", "a", "b", "a"]})
+        result = Perc(2)(data, GroupBy(["x", "g"]), "x", {})
+        assert result[["x", "g"]].values.tolist() == [[1, "a"], [1, "a"], [2, "b"], [2, "b"]]
+        assert result.columns.tolist() == ["x", "y", "g", "percentile"]
+
+        horizontal = Perc(2)(data, GroupBy(["y", "g"]), "y", {})
+        assert horizontal.columns.tolist() == ["x", "y", "g", "percentile"]
+        assert horizontal.groupby(["y", "g"], sort=False).size().tolist() == [2, 2, 2, 2]
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": [1, 1, 1], "y": [1, np.nan, 3]})
+        result = Perc([50], "lower")(data, GroupBy(["x"]), "x", {})
+        assert result.loc[0, "y"] == 1
+
+    def test_public_imports_and_plot_add(self):
+        assert so.Perc is Perc
+        plot = so.Plot(pd.DataFrame({"y": [1, 2, 3]}), y="y").add(so.Dots(), so.Perc())
+        assert isinstance(plot, so.Plot)
