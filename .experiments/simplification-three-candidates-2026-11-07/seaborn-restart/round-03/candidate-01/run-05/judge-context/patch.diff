diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..aebd387
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,70 @@
+"""Statistical transforms that operate on ordered observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with rows at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels.
+    method : str
+        Method used to calculate the percentiles, as in :func:`numpy.percentile`.
+        The default is ``"linear"``. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    The output contains one percentile row per group and requested level, with
+    the percentile value on the dependent axis and its level in ``percentile``.
+    These are percentile rows, not an estimate or interval.
+
+    Examples
+    --------
+    Use the default quartiles and endpoints, request a count, or specify levels::
+
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc())
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(k=5))
+        so.Plot(data, y="value").add(so.Dots(), so.Perc(k=[10, 50, 90]))
+
+    Use percentile rows with a range mark to show an interval::
+
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc(k=[5, 95]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        keyword = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kws = {keyword: self.method}
+        values = np.nanpercentile(data[var], levels, **kws)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
