diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..84753e0
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,42 @@
+import numpy as np
+import pandas as pd
+import pytest
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels_and_public_import(self):
+        assert so.Perc is Perc
+        data = pd.DataFrame({"group": ["a", "a"], "y": [0, 10]})
+        out = so.Perc()(data, GroupBy(["group"]), "y", {})
+        assert list(out["percentile"]) == [0, 25, 50, 75, 100]
+        assert list(out["y"]) == [0, 2.5, 5, 7.5, 10]
+
+    def test_levels_and_group_order(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [4, 1, 2, 3]})
+        out = Perc(k=3)(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert list(out.columns) == ["group", "x", "percentile"]
+        assert list(out["group"]) == ["a", "a", "a", "b", "b", "b"]
+        assert list(out["x"]) == [1, 2, 3, 2, 3, 4]
+        assert list(out["percentile"]) == [0, 50, 100] * 2
+
+    def test_explicit_levels_missing_and_method(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, np.nan, 2, 8]})
+        out = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["group"]), "y", {}
+        )
+        assert list(out["percentile"]) == [25, 75]
+        assert list(out["y"]) == [1, 8]
+
+    def test_plot_add(self):
+        plot = so.Plot(pd.DataFrame({"x": [1, 2, 3]}), x="x").add(so.Dots(), Perc())
+        assert plot._layers[-1]["stat"] == Perc()
+
+    def test_orientation(self):
+        data = pd.DataFrame({"group": ["a"] * 3, "x": [1, 2, 3], "y": [10, 20, 30]})
+        out = Perc(k=2)(data, GroupBy(["group"]), "y", {})
+        assert list(out["y"]) == [10, 30]
