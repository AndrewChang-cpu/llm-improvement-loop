diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..1c1ab23
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,57 @@
+"""Statistics that operate on ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with rows at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced levels from 0 through 100, or explicit levels.
+        The default produces quartiles (0, 25, 50, 75, and 100).
+    method : str
+        Method used to estimate percentiles, as in :func:`numpy.percentile`.
+        Defaults to "linear". Available methods are "inverted_cdf",
+        "averaged_inverted_cdf", "closest_observation",
+        "interpolated_inverted_cdf", "hazen", "weibull", "linear",
+        "median_unbiased", "normal_unbiased", "lower", "higher",
+        "midpoint", and "nearest".
+
+    Notes
+    -----
+    The output contains one row per requested level per group, with the
+    percentile value on the dependent axis and the level in `percentile`.
+    These rows are percentile values, not an estimate or interval.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    group_by_orient = True
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    def __call__(self, data, groupby: GroupBy, orient: str, scales) -> pd.DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile_rows(part):
+            values = part[orient].dropna().to_numpy()
+            if Version(np.__version__) < Version("1.22.0"):
+                percentiles = np.percentile(values, levels, interpolation=self.method)
+            else:
+                percentiles = np.percentile(values, levels, method=self.method)
+            return pd.DataFrame({orient: percentiles, "percentile": levels})
+
+        return groupby.apply(data, percentile_rows)
