diff --git a/docstrings/objects.Perc.rst b/docstrings/objects.Perc.rst
new file mode 100644
index 0000000..874d700
--- /dev/null
+++ b/docstrings/objects.Perc.rst
@@ -0,0 +1,29 @@
+By default, :class:`Perc` returns quartile rows, including both endpoints:
+
+.. plot::
+
+    import seaborn.objects as so
+    from seaborn import load_dataset
+    penguins = load_dataset("penguins")
+    so.Plot(penguins, x="flipper_length_mm").add(so.Range(), so.Perc())
+
+Set an integer to request that many evenly spaced levels from 0 to 100:
+
+.. code-block:: python
+
+    so.Plot(penguins, x="flipper_length_mm").add(so.Range(), so.Perc(k=3))
+
+Or provide levels explicitly:
+
+.. code-block:: python
+
+    so.Plot(penguins, x="flipper_length_mm").add(
+        so.Range(), so.Perc(k=[10, 50, 90])
+    )
+
+The ``method`` parameter follows :func:`numpy.percentile` semantics, with
+``"linear"`` as the default. Valid methods are ``inverted_cdf``,
+``averaged_inverted_cdf``, ``closest_observation``,
+``interpolated_inverted_cdf``, ``hazen``, ``weibull``, ``linear``,
+``median_unbiased``, ``normal_unbiased``, ``lower``, ``higher``, ``midpoint``,
+and ``nearest``.
diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..24690a6
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,57 @@
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from pandas import DataFrame
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile rows.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or explicit percentile levels.
+    method : str
+        Method used by :func:`numpy.percentile`. See its documentation for
+        details; the default is ``"linear"``.
+
+    The output has one row per requested level and group. The dependent axis
+    contains the percentile value, and ``percentile`` records the level.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = (
+            np.linspace(0, 100, self.k)
+            if isinstance(self.k, (int, np.integer)) else self.k
+        )
+        kwarg = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        kwargs = {kwarg: self.method}
+        values = np.percentile(data[var].dropna(), levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
