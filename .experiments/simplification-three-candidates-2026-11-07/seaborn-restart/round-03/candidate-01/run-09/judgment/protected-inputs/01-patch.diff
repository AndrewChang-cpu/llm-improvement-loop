diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..0020ce7
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,48 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [0] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert result.percentile.tolist() == [0, 50, 100]
+        result = Perc(k=[10, 90])(data, GroupBy(["x"]), "x", {})
+        np.testing.assert_allclose(result.y, [1.3, 3.7])
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, np.nan, 4]})
+        result = Perc(k=[50], method="nearest")(data, GroupBy(["x"]), "x", {})
+        assert result.y.tolist() == [2]
+
+    def test_grouping_order_and_orientation(self):
+        data = pd.DataFrame({
+            "x": [2, 2, 1, 1], "y": [10, 20, 30, 40], "group": ["b", "b", "a", "a"],
+        })
+        gb = GroupBy({"group": ["b", "a"], "x": [2, 1]})
+        result = Perc(k=[0, 100])(data, gb, "x", {})
+        assert result.group.tolist() == ["b", "b", "a", "a"]
+        assert result.y.tolist() == [10, 20, 30, 40]
+        assert result.columns.tolist() == ["x", "y", "group", "percentile"]
+
+    def test_public_import_and_plot_add(self):
+        assert ObjectsPerc is Perc
+        from seaborn.objects import Plot, Range
+        plot = Plot(pd.DataFrame({"x": [1, 2, 3, 4]}), x="x")
+        plot.add(Range(), Perc())
