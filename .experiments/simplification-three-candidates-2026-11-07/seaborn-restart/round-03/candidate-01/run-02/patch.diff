diff --git a/docstrings/objects.Perc.rst b/docstrings/objects.Perc.rst
new file mode 100644
index 0000000..600a3da
--- /dev/null
+++ b/docstrings/objects.Perc.rst
@@ -0,0 +1,36 @@
+Create a plot with the default quartiles and endpoints:
+
+.. plot::
+
+    import seaborn.objects as so
+
+    so.Plot(penguins, x="species", y="body_mass_g").add(so.Dots(), so.Perc())
+
+Set an integer count to request evenly spaced percentile levels:
+
+.. plot::
+
+    import seaborn.objects as so
+
+    so.Plot(penguins, x="species", y="body_mass_g").add(so.Dots(), so.Perc(k=3))
+
+Pass explicit percentile levels:
+
+.. plot::
+
+    import seaborn.objects as so
+
+    so.Plot(penguins, x="species", y="body_mass_g").add(
+        so.Dots(), so.Perc(k=[10, 50, 90])
+    )
+
+Use a range mark to draw the central interval between the 10th and 90th
+percentiles:
+
+.. plot::
+
+    import seaborn.objects as so
+
+    so.Plot(penguins, x="species", y="body_mass_g").add(
+        so.Range(), so.Perc(k=[10, 90])
+    )
diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..a81d7fc
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,68 @@
+"""Statistical transformations that operate on ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile rows.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of percentile levels. The default requests quartiles
+        and endpoints.
+    method : str
+        Method used to calculate the percentile, as in :func:`numpy.percentile`.
+        The default is ``"linear"``.
+
+    Notes
+    -----
+    Each group produces one row per requested percentile. The value axis contains
+    the percentile value and the ``percentile`` column contains its level.
+    These rows are percentile values, not estimates or intervals.
+
+    The supported methods are ``inverted_cdf``, ``averaged_inverted_cdf``,
+    ``closest_observation``, ``interpolated_inverted_cdf``, ``hazen``,
+    ``weibull``, ``linear``, ``median_unbiased``, ``normal_unbiased``,
+    ``lower``, ``higher``, ``midpoint``, and ``nearest``. See NumPy's percentile
+    documentation for the semantics of each method.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+
+        var = {"x": "y", "y": "x"}[orient]
+        percentiles = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+
+        def percentile_rows(group: DataFrame) -> DataFrame:
+            values = group[var].dropna()
+            if Version(np.__version__) < Version("1.22.0"):
+                result = np.nanpercentile(values, percentiles, interpolation=self.method)
+            else:
+                result = np.nanpercentile(values, percentiles, method=self.method)
+            return pd.DataFrame({var: result, "percentile": percentiles})
+
+        return groupby.apply(data, percentile_rows).reset_index(drop=True)
