diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..6637444
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,62 @@
+import numpy as np
+import pandas as pd
+
+import pytest
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    @pytest.fixture
+    def df(self):
+        return pd.DataFrame({
+            "x": ["b", "a", "b", "a", "b", "a"],
+            "y": [1, 10, 3, 20, 5, 30],
+            "group": ["g", "g", "g", "g", "h", "h"],
+            "unused": range(6),
+        })
+
+    def test_default(self, df):
+        res = Perc()(df, GroupBy(["x", "group"]), "x", {})
+
+        assert res.columns.tolist() == ["x", "y", "group", "percentile"]
+        assert res["x"].tolist() == ["b"] * 10 + ["a"] * 10
+        assert res["group"].tolist() == ["g"] * 5 + ["h"] * 5 + ["g"] * 5 + ["h"] * 5
+        assert res["percentile"].tolist() == [0, 25, 50, 75, 100] * 4
+        np.testing.assert_allclose(res["y"], [1, 1.5, 2, 2.5, 3, 5, 5, 5, 5, 5,
+                                               10, 12.5, 15, 17.5, 20, 30, 30, 30, 30, 30])
+
+    @pytest.mark.parametrize(
+        "k, expected_levels", [(3, [0, 50, 100]), ([10, 60], [10, 60])]
+    )
+    def test_levels(self, df, k, expected_levels):
+        res = Perc(k)(df, GroupBy(["x"]), "x", {})
+        assert res["percentile"].unique().tolist() == expected_levels
+
+    def test_method(self):
+        df = pd.DataFrame({"x": ["a"] * 4, "y": [0, 2, 4, 8]})
+        res = Perc(k=[50], method="nearest")(df, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [4]
+
+    def test_orientation(self):
+        df = pd.DataFrame({"group": ["a", "a"], "x": [1, 10], "y": [3, 30]})
+        vertical = Perc(k=[50])(df, GroupBy(["group"]), "x", {})
+        horizontal = Perc(k=[50])(df, GroupBy(["group"]), "y", {})
+        assert vertical["y"].tolist() == [16.5]
+        assert horizontal["x"].tolist() == [5.5]
+
+    def test_missing(self):
+        df = pd.DataFrame({"x": ["a", "a", "a"], "y": [1, np.nan, 3]})
+        res = Perc(k=[0, 50, 100])(df, GroupBy(["x"]), "x", {})
+        assert res["y"].tolist() == [1, 2, 3]
+
+    def test_public_imports_and_plot_add(self):
+        from seaborn import objects as so
+        from seaborn.objects import Perc as PublicPerc
+
+        assert PublicPerc is Perc
+        plot = so.Plot(pd.DataFrame({"x": [1], "y": [2]}), x="x", y="y")
+        layer = plot.add(so.Dots(), so.Perc())
+        assert isinstance(layer._layers[0]["stat"], PublicPerc)
