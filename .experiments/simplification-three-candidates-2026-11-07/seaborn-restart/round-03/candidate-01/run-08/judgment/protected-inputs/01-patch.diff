diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..fa22835
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,60 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_default(self):
+
+        data = pd.DataFrame({"x": [1, 2, 3, 4, 5], "y": [0] * 5})
+        result = Perc()(data, GroupBy(["y"]), "y", {})
+
+        assert result["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert result["x"].tolist() == [1, 2, 3, 4, 5]
+        assert result["y"].tolist() == [0] * 5
+        assert list(result) == ["x", "y", "percentile"]
+        assert ObjectsPerc is Perc
+
+    def test_count_and_explicit_levels(self):
+
+        data = pd.DataFrame({"x": [0, 10], "y": [0, 0]})
+        groupby = GroupBy(["y"])
+
+        counted = Perc(k=3)(data, groupby, "y", {})
+        assert counted["percentile"].tolist() == [0, 50, 100]
+        assert counted["x"].tolist() == [0, 5, 10]
+
+        explicit = Perc(k=[20, 80])(data, groupby, "y", {})
+        assert explicit["percentile"].tolist() == [20, 80]
+        assert explicit["x"].tolist() == [2, 8]
+
+    def test_method_and_horizontal_orientation(self):
+
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3]})
+        result = Perc(k=[25, 50], method="lower")(
+            data, GroupBy(["x"]), "x", {}
+        )
+
+        assert result["y"].tolist() == [1, 2]
+        assert result["x"].tolist() == [0, 0]
+        assert result["percentile"].tolist() == [25, 50]
+
+    def test_grouping_order_and_missing_data(self):
+
+        data = pd.DataFrame({
+            "x": [1, np.nan, 10, 20],
+            "y": [0, 0, 1, 1],
+            "group": ["b", "b", "a", "a"],
+        })
+        result = Perc(k=[0, 100])(
+            data, GroupBy(["group", "y"]), "y", {}
+        )
+
+        assert result["group"].tolist() == ["b", "b", "a", "a"]
+        assert result["y"].tolist() == [0, 0, 1, 1]
+        assert result["x"].tolist() == [1, 1, 10, 20]
+        assert list(result) == ["x", "y", "group", "percentile"]
