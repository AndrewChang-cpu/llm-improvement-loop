diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..cbdc044
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,60 @@
+"""Statistics that replace observations with ordered values."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile rows.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or the explicit percentile levels to compute. The default is 5.
+    method : str
+        Method used to estimate percentiles, as in :func:`numpy.percentile`.
+        The default is ``"linear"``. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Each group produces one row per requested level. The value axis contains
+    the percentile value and a ``percentile`` column records its level. These
+    are percentile rows, not an estimate or interval.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str, levels: list[float]) -> DataFrame:
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+        else:
+            percentiles = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, (int, np.integer)):
+            levels = np.linspace(0, 100, self.k).tolist()
+        else:
+            levels = self.k
+        return groupby.apply(data, self._compute, var, levels)
