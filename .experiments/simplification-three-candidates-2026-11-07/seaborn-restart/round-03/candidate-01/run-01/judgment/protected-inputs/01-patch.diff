diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..06c69db
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,75 @@
+"""Statistical transforms that change the order or ranks of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with rows at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 through 100, or the
+        percentile levels to compute directly. The default (5) gives quartiles
+        and endpoints.
+    method : str
+        Method used to estimate percentiles, passed to :func:`numpy.percentile`.
+        The default is ``"linear"``. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row for each requested level in each group, with the percentile
+        value on the dependent axis and the level in a ``percentile`` column.
+        These rows are percentile values, not an estimate or interval.
+
+    Examples
+    --------
+    Default quartiles and endpoints, an integer count, and explicit levels::
+
+        import seaborn.objects as so
+
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc())
+        so.Plot(data, x="group", y="value").add(so.Range(), so.Perc(3))
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc([10, 50, 90])
+        )
+
+    Use a range mark to draw an interval between percentiles::
+
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc([2.5, 97.5])
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        values = data[var].dropna()
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        keyword = "interpolation" if Version(np.__version__) < Version("1.22.0") else "method"
+        percentiles = np.percentile(values, levels, **{keyword: self.method})
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var)
