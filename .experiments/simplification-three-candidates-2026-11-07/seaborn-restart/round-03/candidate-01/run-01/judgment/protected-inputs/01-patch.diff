diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..13ed227
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,53 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+from seaborn.objects import Plot, Range
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 1, 1, 1], "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({
+            "x": [1] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        grouped = GroupBy(["x"])
+        count = Perc(3)(data, grouped, "x", {})
+        explicit = Perc([10, 90])(data, grouped, "x", {})
+        assert count["percentile"].tolist() == [0, 50, 100]
+        assert explicit["y"].tolist() == [1.3, 3.7]
+
+    def test_grouping_order_and_missing_values(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "x": [1, 2, 3, 4],
+            "y": [1, np.nan, 5, 3],
+            "extra": [0, 0, 0, 0],
+        })
+        result = Perc([0, 100])(data, GroupBy(["group"]), "x", {})
+        assert result["group"].tolist() == ["b", "b", "a", "a"]
+        assert result["y"].tolist() == [1, 5, 3, 3]
+        assert result.columns.tolist() == ["group", "y", "percentile"]
+
+    def test_orientation_and_method(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [1, 1, 2, 2]})
+        result = Perc(3, "lower")(data, GroupBy(["y"]), "y", {})
+        assert result["x"].tolist() == [1, 1, 2, 3, 3, 4]
+        assert result["y"].tolist() == [1, 1, 1, 2, 2, 2]
+        assert result["percentile"].tolist() == [0, 50, 100, 0, 50, 100]
+
+    def test_public_import_and_plot_add(self):
+        assert PublicPerc is Perc
+        plot = Plot(pd.DataFrame({"x": ["a", "a"], "y": [1, 2]}), x="x", y="y")
+        plot.add(Range(), Perc())
