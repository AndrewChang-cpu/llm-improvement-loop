diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..47e4c23
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,61 @@
+"""Statistics that change the ordering or sampling of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with rows at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced levels from 0 to 100, inclusive, or explicit
+        percentile levels.
+    method : str
+        Method used to estimate percentiles, passed to :func:`numpy.percentile`.
+        Defaults to ``"linear"``. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Returns
+    -------
+    DataFrame
+        One row per requested level per group, with the percentile value on
+        the dependent axis and the level in a ``percentile`` column.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentile(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            percentiles = np.percentile(values, levels, interpolation=self.method)
+        else:
+            percentiles = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: percentiles, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentile, var)
