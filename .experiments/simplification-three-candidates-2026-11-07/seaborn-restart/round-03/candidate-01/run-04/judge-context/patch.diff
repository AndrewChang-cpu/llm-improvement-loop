diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..722dd0c
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,75 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc
+
+
+class TestPerc:
+
+    def test_imports(self):
+
+        assert ObjectsPerc is Perc
+
+    def test_default_levels_and_values(self):
+
+        data = pd.DataFrame({"x": [0, 1, 2, 3], "y": [0, 1, 2, 3], "group": ["a"] * 4})
+        res = Perc()(data, GroupBy(["group"]), "x", {})
+
+        assert_array_equal(res.columns, ["y", "group", "percentile"])
+        assert_array_equal(res["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(res["y"], [0, .75, 1.5, 2.25, 3])
+
+    def test_integer_count(self):
+
+        data = pd.DataFrame({"x": [0, 1, 2], "y": [1, 2, 3]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+        assert_array_equal(res["percentile"], [0, 50, 100] * 3)
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [0, 1, 2]})
+        res = Perc(k=[10, 90], method="nearest")(data, GroupBy(["x"]), "x", {})
+
+        assert_array_equal(res["percentile"], [10, 90])
+        assert_array_equal(res["y"], [0, 2])
+
+    def test_vertical_orientation(self):
+
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [0, 0, 0]})
+        res = Perc(k=3)(data, GroupBy(["y"]), "y", {})
+
+        assert_array_equal(res["x"], [1, 2, 3])
+        assert_array_equal(res["y"], [0, 0, 0])
+        assert_array_equal(res["percentile"], [0, 50, 100])
+
+    def test_grouping_and_order(self):
+
+        data = pd.DataFrame({
+            "x": [0, 0, 0, 0], "y": [1, 3, 10, 20], "group": ["b", "b", "a", "a"],
+        })
+        res = Perc(k=2)(data, GroupBy({"group": ["a", "b"], "x": None}), "x", {})
+
+        assert_array_equal(res.columns, ["x", "y", "group", "percentile"])
+        assert_array_equal(res["group"], ["a", "a", "b", "b"])
+        assert_array_equal(res["y"], [10, 20, 1, 3])
+
+    def test_missing_observations(self):
+
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, np.nan, 3]})
+        res = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+
+        assert_array_equal(res["percentile"], [0, 50, 100])
+        assert_array_equal(res["y"], [1, 2, 3])
+
+    def test_plot_add(self):
+
+        from seaborn.objects import Plot, Range
+
+        data = pd.DataFrame({"x": [0, 0, 1, 1], "y": [1, 3, 2, 4]})
+        plot = Plot(data, "x", "y").add(Range(), Perc(k=[0, 100]))
+
+        assert plot.plot() is not None
