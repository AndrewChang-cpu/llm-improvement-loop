diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..8554715
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,66 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as ObjectsPerc, Plot, Range
+
+
+class TestPerc:
+
+    def test_imports(self):
+        assert ObjectsPerc is Perc
+
+    def test_plot_add(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        plot = Plot(data).add(Range(), Perc(), x="x", y="y")
+
+        plot.plot()
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+
+        expected = pd.DataFrame({
+            "x": [0] * 5,
+            "y": [1, 1.75, 2.5, 3.25, 4],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0] * 4, "y": [1, 2, 3, 4]})
+
+        result = Perc(k=3)(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100]
+
+        result = Perc(k=[20, 80])(data, GroupBy(["x"]), "x", {})
+        np.testing.assert_allclose(result["y"], [1.6, 3.4])
+        assert result["percentile"].tolist() == [20, 80]
+
+    def test_orientation_and_method(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [0] * 4})
+
+        result = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["y"]), "y", {}
+        )
+        assert result["x"].tolist() == [2, 3]
+
+    def test_grouping_order_columns_and_missing(self):
+        data = pd.DataFrame({
+            "x": [0, 0, 1, 1, 1],
+            "y": [1, np.nan, 4, 2, 3],
+            "group": ["a", "a", "b", "b", "b"],
+            "unused": [1, 2, 3, 4, 5],
+        })
+        groupby = GroupBy({"group": ["b", "a"], "x": [1, 0]})
+
+        result = Perc(k=[0, 100])(data, groupby, "x", {})
+
+        assert result[["group", "x"]].drop_duplicates().values.tolist() == [
+            ["b", 1], ["a", 0]
+        ]
+        assert list(result) == ["x", "y", "group", "percentile"]
+        assert result.loc[result["group"] == "a", "y"].tolist() == [1, 1]
+        assert "unused" not in result
