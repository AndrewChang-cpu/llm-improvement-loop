diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..472ca80
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,85 @@
+"""Statistical transformations that order or select observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with rows at requested percentiles.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, or an
+        explicit list of percentile levels. The default is 5, giving quartiles
+        and the endpoints.
+    method : str
+        Method used to calculate the percentiles. See :func:`numpy.percentile`
+        for the meaning of each method. Valid methods are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+        The default, ``"linear"``, interpolates between observations.
+
+    Returns one row per requested level and group, with the level recorded in
+    the ``percentile`` column. These are percentile rows, not an estimate or
+    interval.
+
+    Examples
+    --------
+    The default gives the endpoints and quartiles::
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc())
+
+    Request three evenly spaced levels or explicit levels::
+
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=3))
+        so.Plot(data, x="x", y="y").add(so.Range(), so.Perc(k=[10, 90]))
+
+    Use endpoints for a percentile interval::
+
+        so.Plot(data, x="x", y="y").add(
+            so.Range(), so.Perc(k=[2.5, 97.5])
+        )
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self,
+        data: DataFrame,
+        groupby: GroupBy,
+        orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, int):
+            levels = np.linspace(0, 100, self.k)
+        else:
+            levels = self.k
+
+        def percentile(part: DataFrame) -> DataFrame:
+            values = part[var].dropna()
+            if Version(np.__version__) < Version("1.22.0"):
+                kws = {"interpolation": self.method}
+            else:
+                kws = {"method": self.method}
+            result = np.percentile(values, levels, **kws)
+            return pd.DataFrame({"percentile": levels, var: result})
+
+        return groupby.apply(data, percentile).reset_index(drop=True)
