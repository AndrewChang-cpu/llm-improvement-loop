diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..9c0c7e9
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,70 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+from seaborn.objects import Plot, Range
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"y": [0, 10]})
+        groupby = GroupBy(["missing"])
+
+        default = Perc()(data, groupby, "x", {})
+        counted = Perc(k=3)(data, groupby, "x", {})
+
+        assert default["percentile"].tolist() == [0, 25, 50, 75, 100]
+        assert default["y"].tolist() == [0, 2.5, 5, 7.5, 10]
+        assert counted["percentile"].tolist() == [0, 50, 100]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"y": [0, 10]})
+        result = Perc(k=[25, 75], method="nearest")(
+            data, GroupBy(["missing"]), "x", {}
+        )
+
+        assert result["percentile"].tolist() == [25, 75]
+        assert result["y"].tolist() == [0, 10]
+
+    def test_orientation_and_missing_data(self):
+        data = pd.DataFrame({"x": [1, 3, np.nan]})
+        result = Perc(k=[0, 50, 100])(
+            data, GroupBy(["missing"]), "y", {}
+        )
+
+        assert result.columns.tolist() == ["x", "percentile"]
+        assert result["x"].tolist() == [1, 2, 3]
+
+    def test_groups_labels_and_order(self):
+        data = pd.DataFrame({
+            "x": [1, 2, 10, 20],
+            "y": [0, 0, 1, 1],
+            "group": ["b", "b", "a", "a"],
+            "unused": [1, 2, 3, 4],
+        })
+        groupby = GroupBy({"group": ["a", "b"]})
+        result = Perc(k=[50])(data, groupby, "y", {})
+
+        assert result.columns.tolist() == ["x", "group", "percentile"]
+        assert result[["group", "x"]].values.tolist() == [["a", 15], ["b", 1.5]]
+
+    def test_orientation_groups_are_retained(self):
+        data = pd.DataFrame({
+            "y": [1, 3, 10, 20],
+            "orient": ["x", "x", "y", "y"],
+        })
+        result = Perc(k=[50])(data, GroupBy(["orient"]), "x", {})
+
+        assert result[["orient", "y"]].values.tolist() == [["x", 2], ["y", 15]]
+
+    def test_public_import_and_plot_add(self):
+        assert PublicPerc is Perc
+        plot = Plot(x=[1, 2, 3], y=[0, 0, 0]).add(
+            Range(), PublicPerc(k=[0, 100]), orient="y"
+        ).plot()
+
+        assert plot._layers[0]["data"].frame["x"].tolist() == [1, 3]
