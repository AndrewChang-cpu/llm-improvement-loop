diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..e543817
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,53 @@
+"""Statistics that order or select observations along an axis."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+from typing import TYPE_CHECKING
+if TYPE_CHECKING:
+    from seaborn._core.scales import Scale
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentiles, one row per level.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or an explicit list of levels.
+    method : str
+        Method used to calculate the percentile. Defaults to ``"linear"``.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        vals = data[var].dropna()
+        kwargs = (
+            {"method": self.method}
+            if Version(np.__version__) >= Version("1.22.0")
+            else {"interpolation": self.method}
+        )
+        values = np.percentile(vals, levels, **kwargs)
+        return pd.DataFrame({var: values, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var).reset_index(drop=True)
