diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..d7a6c8b
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,57 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [2, 4, 6, 8]})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "y": [2, 3.5, 5, 6.5, 8],
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [0, 10, 20, 30]})
+        groupby = GroupBy(["group"])
+        result = Perc(k=3)(data, groupby, "x", {})
+        assert result.percentile.tolist() == [0, 50, 100]
+        result = Perc(k=[10, 90])(data, groupby, "x", {})
+        assert result.percentile.tolist() == [10, 90]
+
+    def test_method_and_missing(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [0, 10, np.nan]})
+        result = Perc(k=[25, 75], method="lower")(
+            data, GroupBy(["group"]), "x", {},
+        )
+        assert result.y.tolist() == [0, 0]
+
+    def test_orientation(self):
+        data = pd.DataFrame({"x": [0, 10, 20, 30], "y": [1, 1, 2, 2]})
+        result = Perc(k=[0, 100])(data, GroupBy(["y"]), "y", {})
+        assert result.columns.tolist() == ["x", "y", "percentile"]
+        assert result.x.tolist() == [0, 10, 20, 30]
+        assert result.y.tolist() == [1, 1, 2, 2]
+
+    def test_group_labels_and_order(self):
+        data = pd.DataFrame({"x": [1, 2, 3, 4], "y": [10, 20, 30, 40],
+                             "group": ["b", "a", "b", "a"], "extra": [1, 2, 3, 4]})
+        result = Perc(k=[0, 100])(data, GroupBy({"group": ["a", "b"]}), "x", {})
+        assert result.columns.tolist() == ["y", "group", "percentile"]
+        assert result.group.tolist() == ["a", "a", "b", "b"]
+        assert result.y.tolist() == [20, 40, 10, 30]
+
+    def test_public_imports_and_plot_add(self):
+        import seaborn.objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+        plot = so.Plot(pd.DataFrame({"x": [0, 1, 2], "y": [1, 2, 3]}), x="x", y="y")
+        plot.add(so.Dots(), so.Perc(k=3)).plot()
+
