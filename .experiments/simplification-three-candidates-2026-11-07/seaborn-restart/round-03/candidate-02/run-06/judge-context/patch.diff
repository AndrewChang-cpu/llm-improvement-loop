diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5d7cc92
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels_and_group_order(self):
+
+        data = pd.DataFrame({
+            "group": ["b", "b", "b", "a", "a", "a"],
+            "y": [1, 2, 3, 10, 20, np.nan],
+        })
+        res = Perc()(data, GroupBy({"group": ["b", "a"]}), "x", {})
+        expected = pd.DataFrame({
+            "group": ["b"] * 5 + ["a"] * 5,
+            "y": [1, 1.5, 2, 2.5, 3, 10, 12.5, 15, 17.5, 20],
+            "percentile": [0., 25., 50., 75., 100.] * 2,
+        })
+        assert_frame_equal(res, expected)
+
+    def test_count(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [0, 1, 2, 3]})
+        res = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert res["percentile"].tolist() == [0, 50, 100]
+        assert res["y"].tolist() == [0, 1.5, 3]
+
+    def test_explicit_levels_and_method(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [0, 1, 2, 3]})
+        res = Perc(k=[25, 75], method="lower")(
+            data, GroupBy(["group"]), "x", {},
+        )
+        assert res["percentile"].tolist() == [25, 75]
+        assert res["y"].tolist() == [0, 2]
+
+    def test_orientation(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [0, 1, 2, 3], "y": [4, 3, 2, 1]})
+        groupby = GroupBy(["group"])
+        assert Perc(k=3)(data, groupby, "x", {})["y"].tolist() == [1, 2.5, 4]
+        assert Perc(k=3)(data, groupby, "y", {})["x"].tolist() == [0, 1.5, 3]
+
+    def test_public_import(self):
+
+        assert so.Perc is Perc
+
+    def test_plot_add_with_range(self):
+
+        data = pd.DataFrame({"x": ["a"] * 4 + ["b"] * 4, "y": range(8)})
+        plot = so.Plot(data, "x", "y").add(so.Range(), so.Perc(k=[25, 75]))
+        assert plot._layers[-1]["stat"].k == [25, 75]
+        plot.plot()
