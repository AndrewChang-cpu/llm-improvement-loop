diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..6b7805c
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,73 @@
+import numpy as np
+import pandas as pd
+from numpy.testing import assert_array_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [2, 4, 6, 8]})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+
+        assert_array_equal(result["percentile"], [0, 25, 50, 75, 100])
+        assert_array_equal(result["y"], [2, 3.5, 5, 6.5, 8])
+        assert result.columns.to_list() == ["group", "y", "percentile"]
+
+    def test_integer_and_explicit_levels(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [2, 4, 6, 8]})
+        groupby = GroupBy(["group"])
+
+        result = Perc(3)(data, groupby, "x", {})
+        assert_array_equal(result["percentile"], [0, 50, 100])
+
+        result = Perc([10, 90])(data, groupby, "x", {})
+        assert_array_equal(result["percentile"], [10, 90])
+        assert_array_equal(result["y"], [2.6, 7.4])
+
+    def test_method(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [2, 4, 6, 8]})
+        result = Perc([25, 75], method="nearest")(
+            data, GroupBy(["group"]), "x", {},
+        )
+
+        assert_array_equal(result["y"], np.percentile(data.y, [25, 75], method="nearest"))
+
+    def test_orientation_and_missing(self):
+
+        data = pd.DataFrame({"group": ["a"] * 4, "x": [1, 2, 3, 4], "y": [2, np.nan, 6, 8]})
+        result = Perc([0, 50, 100])(data, GroupBy(["group"]), "x", {})
+        assert_array_equal(result["y"], [2, 6, 8])
+
+        result = Perc([0, 100])(data, GroupBy(["group"]), "y", {})
+        assert_array_equal(result["x"], [1, 4])
+        assert result.columns.to_list() == ["group", "x", "percentile"]
+
+    def test_group_labels_order_and_columns(self):
+
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "orient": ["x", "x", "y", "y"],
+            "x": [1, 10, 3, 30],
+            "y": [2, 20, 4, 40],
+            "unused": [0, 0, 0, 0],
+        })
+        result = Perc([0, 100])(data, GroupBy(["orient", "group"]), "x", {})
+
+        assert result.columns.to_list() == ["orient", "group", "y", "percentile"]
+        assert result[["orient", "group"]].drop_duplicates().values.tolist() == [
+            ["x", "b"], ["x", "a"], ["y", "b"], ["y", "a"],
+        ]
+
+    def test_public_imports(self):
+
+        from seaborn import objects as so
+        from seaborn._stats.order import Perc as InternalPerc
+
+        assert so.Perc is InternalPerc
+
