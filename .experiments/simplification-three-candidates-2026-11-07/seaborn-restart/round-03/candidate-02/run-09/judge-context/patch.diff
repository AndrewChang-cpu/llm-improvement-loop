diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..dca5cc5
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,60 @@
+"""Statistics that transform observations into ordered values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with their percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or a list of explicit levels in that range. The default is 5.
+    method : str
+        Method used to calculate the percentiles. Defaults to ``"linear"``;
+        See :func:`numpy.percentile` for the available methods:
+        ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    The transform returns one row for each requested percentile in each group.
+    The computed value is in the orientation-selected coordinate column, and
+    the percentile level is recorded in a ``percentile`` column.
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(self, data, groupby, orient, scales):
+
+        var = {"x": "y", "y": "x"}[orient]
+        if isinstance(self.k, int):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+
+        def percentile(data):
+            values = data[var].dropna()
+            if Version(np.__version__) < Version("1.22.0"):
+                values = np.percentile(values, percentiles, interpolation=self.method)
+            else:
+                values = np.percentile(values, percentiles, method=self.method)
+            return pd.DataFrame({var: values, "percentile": percentiles})
+
+        columns = [col for col in groupby.order if col in data and col != var]
+        columns.append(var)
+        return groupby.apply(data[columns], percentile)
