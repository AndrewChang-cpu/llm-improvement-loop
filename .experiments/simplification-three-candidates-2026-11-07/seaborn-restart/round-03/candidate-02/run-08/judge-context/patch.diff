diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..d4b9d3c
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,80 @@
+"""Statistics that order observations along a value axis."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of levels in that range.
+    method : str
+        Method used to compute the percentiles. Defaults to ``"linear"`` and
+        accepts NumPy's percentile methods: ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    The result has one row per requested percentile for each group, with the
+    percentile level in a ``percentile`` column.
+
+    Examples
+    --------
+    By default, quartiles and endpoints are computed:
+
+    .. code:: python
+
+        p = so.Plot(data, x="x").add(so.Range(), so.Perc())
+
+    Request a number of evenly spaced levels or an explicit set of levels:
+
+    .. code:: python
+
+        p.add(so.Dots(), so.Perc(10))
+        p.add(so.Dots(), so.Perc([5, 25, 50, 75, 95]))
+
+    Combine the percentile rows with a range mark to show an interval:
+
+    .. code:: python
+
+        p.add(so.Range(), so.Perc([2.5, 97.5]))
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+
+        var = {"x": "y", "y": "x"}[orient]
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        grouping_vars = [v for v in groupby.order if v in data and v != var]
+        data = data[grouping_vars + [var]]
+
+        def percentile(group):
+            values = group[var].dropna()
+            kwargs = {"method": self.method}
+            if Version(np.__version__) < Version("1.22.0"):
+                kwargs = {"interpolation": self.method}
+            computed = np.percentile(values, levels, **kwargs)
+            return pd.DataFrame({var: computed, "percentile": levels})
+
+        return groupby.apply(data, percentile).reset_index(drop=True)
