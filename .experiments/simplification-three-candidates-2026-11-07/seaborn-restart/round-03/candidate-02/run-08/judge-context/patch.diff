diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..012dc69
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,43 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn import objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_and_count(self):
+        data = pd.DataFrame({"x": range(5), "y": [1, 2, 3, 4, 5]})
+        result = Perc()(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [0, 25, 50, 75, 100] * 5
+        assert result["y"].tolist() == [1] * 5 + [2] * 5 + [3] * 5 + [4] * 5 + [5] * 5
+
+        result = Perc(3)(data, GroupBy(["x"]), "x", {})
+        assert result["percentile"].tolist() == [0, 50, 100] * 5
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [0, 10, 20], "extra": 1})
+        result = Perc([25, 75], method="nearest")(data, GroupBy(["x"]), "x", {})
+        expected = pd.DataFrame({"x": [0, 0], "y": [0, 20], "percentile": [25, 75]})
+        assert_frame_equal(result, expected)
+
+    def test_orientation_and_missing(self):
+        data = pd.DataFrame({"x": [1, np.nan, 3], "y": [0, 1, 2], "group": ["a"] * 3})
+        result = Perc([0, 100])(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({"group": ["a", "a"], "x": [1., 3.], "percentile": [0, 100]})
+        assert_frame_equal(result, expected)
+
+    def test_group_labels_order_and_imports(self):
+        data = pd.DataFrame({"group": ["b", "a", "b", "a"], "x": [0, 0, 0, 0], "y": [1, 2, 3, 4]})
+        result = Perc([50])(data, GroupBy(["group", "x"]), "x", {})
+        expected = pd.DataFrame({"group": ["b", "a"], "x": [0, 0], "y": [2., 3.], "percentile": [50, 50]})
+        assert_frame_equal(result, expected)
+        assert so.Perc is Perc
+
+    def test_plot_add_with_range(self):
+        data = pd.DataFrame({"x": [0, 0, 0], "y": [1, 2, 3]})
+        plot = so.Plot(data, x="x", y="y").add(so.Range(), Perc([0, 100]))
+        plot.plot()
