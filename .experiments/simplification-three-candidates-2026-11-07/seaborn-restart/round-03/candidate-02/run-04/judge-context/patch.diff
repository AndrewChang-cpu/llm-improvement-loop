diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..afb238e
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,77 @@
+"""Statistics that order or select observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentiles from 0 to 100, inclusive, or an
+        explicit list of percentile levels.
+    method : str
+        Method used to estimate the percentile. Defaults to ``"linear"`` and
+        accepts ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    Each group produces one row per requested percentile. The value column
+    contains the percentile value and a ``percentile`` column records its level.
+
+    Examples
+    --------
+    .. code-block:: python
+
+        import seaborn.objects as so
+
+        data = {"group": ["a"] * 5, "value": [1, 2, 3, 4, 5]}
+
+        # Default quartiles and endpoints: 0, 25, 50, 75, and 100
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc())
+
+        # Three evenly spaced levels
+        so.Plot(data, x="group", y="value").add(so.Dots(), so.Perc(3))
+
+        # Explicit levels; a range mark draws the interval
+        so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc([25, 75])
+        )
+
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = self.k if isinstance(self.k, list) else np.linspace(0, 100, self.k)
+        values = data[var].dropna()
+        method_arg = (
+            {"interpolation": self.method}
+            if Version(np.__version__) < Version("1.22.0")
+            else {"method": self.method}
+        )
+        result = np.percentile(values, levels, **method_arg)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str,
+        scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
