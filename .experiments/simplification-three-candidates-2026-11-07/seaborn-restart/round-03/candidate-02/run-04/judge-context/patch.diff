diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..5b3bd3a
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,58 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+import seaborn.objects as so
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_integer_levels(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+        result = Perc(3)(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "group": ["a"] * 3, "y": [1, 2.5, 4],
+            "percentile": [0., 50., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [0, 10, 20, 30]})
+        result = Perc([25, 75], method="nearest")(
+            data, GroupBy(["group"]), "x", {}
+        )
+        expected = pd.DataFrame({
+            "group": ["a"] * 2, "y": [10, 20], "percentile": [25, 75],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_grouping_order_and_missing_values(self):
+        data = pd.DataFrame({
+            "group": ["b", "a", "b", "a"],
+            "x": [1, 10, np.nan, 30],
+            "y": [5, 6, 7, 8],
+        })
+        result = Perc([0, 100])(data, GroupBy(["group"]), "y", {})
+        expected = pd.DataFrame({
+            "group": ["b", "b", "a", "a"],
+            "x": [1., 1., 10., 30.],
+            "percentile": [0, 100, 0, 100],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_both_orientations(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [10, 20, 30]})
+        vertical = Perc([0, 100])(data, GroupBy(["x"]), "x", {})
+        horizontal = Perc([0, 100])(data, GroupBy(["y"]), "y", {})
+        assert vertical["y"].tolist() == [10, 10, 20, 20, 30, 30]
+        assert horizontal["x"].tolist() == [1, 1, 2, 2, 3, 3]
+
+    def test_public_export_and_plot_add(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "value": [1, 2, 3, 4]})
+        assert so.Perc is Perc
+        plot = so.Plot(data, x="group", y="value").add(
+            so.Range(), so.Perc([25, 75])
+        )
+        plot.plot()
