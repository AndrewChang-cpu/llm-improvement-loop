diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..49c509f
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,63 @@
+"""Statistics that change the order or position of observations."""
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        If an integer, request that many evenly spaced percentile levels from
+        0 through 100. A list specifies the percentile levels directly, each
+        between 0 and 100.
+    method : str
+        Method used to compute the percentile, as in :func:`numpy.percentile`.
+        Defaults to ``"linear"``. Choices are ``"inverted_cdf"``,
+        ``"averaged_inverted_cdf"``, ``"closest_observation"``,
+        ``"interpolated_inverted_cdf"``, ``"hazen"``, ``"weibull"``,
+        ``"linear"``, ``"median_unbiased"``, ``"normal_unbiased"``,
+        ``"lower"``, ``"higher"``, ``"midpoint"``, and ``"nearest"``.
+
+    The output has one row per requested percentile per group, with the
+    computed value in the value column and the requested level in
+    ``percentile``.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _percentiles(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        if Version(np.__version__) < Version("1.22.0"):
+            result = np.percentile(values, levels, interpolation=self.method)
+        else:
+            result = np.percentile(values, levels, method=self.method)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._percentiles, var).reset_index(drop=True)
