diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..aeac040
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,55 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_integer_levels(self):
+        data = pd.DataFrame({"group": ["a"] * 4, "y": [1, 2, 3, 4]})
+        out = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [0, 50, 100]
+        assert out["y"].tolist() == [1, 2.5, 4]
+        assert out.columns.tolist() == ["group", "y", "percentile"]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"group": ["a", "a"], "y": [0, 10]})
+        out = Perc(k=[25, 75], method="nearest")(data, GroupBy(["group"]), "x", {})
+        assert out["percentile"].tolist() == [25, 75]
+        assert out["y"].tolist() == [0, 10]
+
+    def test_grouping_order_and_missing(self):
+        data = pd.DataFrame({
+            "group": pd.Categorical(["a", "b", "a"], categories=["a", "b"]),
+            "x": [1, 1, 2], "y": [1, 20, np.nan], "other": [3, 4, 5],
+        })
+        out = Perc(k=[0, 100])(data, GroupBy({"group": ["b", "a"]}), "x", {})
+        assert out["group"].tolist() == ["b", "b", "a", "a"]
+        assert out["y"].tolist() == [20, 20, 1, 1]
+        assert out["percentile"].tolist() == [0, 100, 0, 100]
+        assert out.columns.tolist() == ["group", "y", "percentile"]
+
+    def test_vertical_orientation(self):
+        data = pd.DataFrame({"group": ["a", "a"], "x": [0, 10]})
+        out = Perc(k=[50])(data, GroupBy(["group"]), "y", {})
+        assert out["x"].tolist() == [5]
+
+    def test_orientation_groups(self):
+        data = pd.DataFrame({"x": [1, 1, 2, 2], "y": [0, 10, 100, 200]})
+        out = Perc(k=[0, 100])(data, GroupBy(["x"]), "x", {})
+        assert out["x"].tolist() == [1, 1, 2, 2]
+        assert out["y"].tolist() == [0, 10, 100, 200]
+        assert out["percentile"].tolist() == [0, 100, 0, 100]
+
+
+def test_public_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as StatsPerc
+
+    assert so.Perc is StatsPerc
+    plot = so.Plot(x=["a", "a", "a"], y=[1, 2, 3]).add(
+        so.Range(), so.Perc(k=[25, 75])
+    )
+    plot.plot()
