diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..5634a30
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,82 @@
+"""Statistics that replace observations with ordered summary values."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+from pandas import DataFrame
+
+from seaborn._core.groupby import GroupBy
+from seaborn._core.scales import Scale
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels from 0 to 100, inclusive,
+        or an explicit list of percentile levels.
+    method : str
+        Method used to calculate the percentiles. Defaults to ``"linear"``;
+        accepts ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``,
+        ``"median_unbiased"``, ``"normal_unbiased"``, ``"lower"``,
+        ``"higher"``, ``"midpoint"``, or ``"nearest"``.
+
+    The output contains one row per requested percentile per group, with the
+    computed value on the orientation-selected axis and the level in a
+    ``percentile`` column.
+
+    Examples
+    --------
+    Default quartiles and endpoints (0, 25, 50, 75, 100):
+
+    .. code:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Dots(), so.Perc()
+        )
+
+    Three evenly spaced levels (0, 50, 100), or explicit levels:
+
+    .. code:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Dots(), so.Perc(k=3)
+        )
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Dots(), so.Perc(k=[10, 50, 90])
+        )
+
+    Combine two percentile rows with ``Range`` to draw an interval:
+
+    .. code:: python
+
+        so.Plot(penguins, x="species", y="body_mass_g").add(
+            so.Range(), so.Perc(k=[25, 75])
+        )
+    """
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data: DataFrame, var: str) -> DataFrame:
+        levels = np.linspace(0, 100, self.k) if isinstance(self.k, int) else self.k
+        values = data[var].dropna()
+        kwargs = {"interpolation" if Version(np.__version__) < Version("1.22.0") else "method": self.method}
+        result = np.percentile(values, levels, **kwargs)
+        return pd.DataFrame({var: result, "percentile": levels})
+
+    def __call__(
+        self, data: DataFrame, groupby: GroupBy, orient: str, scales: dict[str, Scale],
+    ) -> DataFrame:
+        var = {"x": "y", "y": "x"}[orient]
+        return groupby.apply(data, self._compute, var)
