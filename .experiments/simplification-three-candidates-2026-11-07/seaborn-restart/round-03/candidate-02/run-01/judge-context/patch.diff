diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..c9035c6
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,68 @@
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+
+
+class TestPerc:
+
+    def test_default_levels(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": [1, 2, 3, 4, 5]})
+        out = Perc()(data, GroupBy(["group"]), "x", {})
+
+        assert out.columns.to_list() == ["y", "percentile"]
+        assert out["percentile"].to_list() == [0, 25, 50, 75, 100]
+        assert out["y"].to_list() == [1, 2, 3, 4, 5]
+
+    def test_integer_count(self):
+        data = pd.DataFrame({"y": [0, 10]})
+        out = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+
+        assert out["percentile"].to_list() == [0, 50, 100]
+        assert out["y"].to_list() == [0, 5, 10]
+
+    def test_explicit_levels_and_method(self):
+        data = pd.DataFrame({"y": [0, 10]})
+        out = Perc(k=[75, 25], method="lower")(data, GroupBy(["group"]), "x", {})
+
+        assert out["percentile"].to_list() == [75, 25]
+        assert out["y"].to_list() == [0, 0]
+
+    def test_orientation_grouping_order_and_columns(self):
+        data = pd.DataFrame({
+            "x": [2, 2, 1, 1],
+            "y": [20, 40, 10, 30],
+            "group": ["b", "b", "a", "a"],
+            "unused": [0, 0, 0, 0],
+        })
+        groupby = GroupBy({"x": [2, 1], "group": ["b", "a"]})
+        out = Perc(k=2)(data, groupby, "x", {})
+
+        assert out.columns.to_list() == ["y", "x", "group", "percentile"]
+        assert out[["x", "group"]].drop_duplicates().to_records(index=False).tolist() == [
+            (2, "b"), (1, "a")
+        ]
+        assert out["y"].to_list() == [20, 40, 10, 30]
+
+    def test_horizontal_orientation(self):
+        data = pd.DataFrame({"x": [0, 10], "y": [1, 2]})
+        out = Perc(k=3)(data, GroupBy(["group"]), "y", {})
+
+        assert out.columns.to_list() == ["x", "percentile"]
+        assert out["x"].to_list() == [0, 5, 10]
+
+    def test_missing_data(self):
+        data = pd.DataFrame({"y": [1, np.nan, 3]})
+        out = Perc(k=3)(data, GroupBy(["group"]), "x", {})
+
+        assert out["y"].to_list() == [1, 2, 3]
+
+
+def test_public_imports_and_plot_add():
+    import seaborn.objects as so
+    from seaborn._stats.order import Perc as InternalPerc
+
+    assert so.Perc is InternalPerc
+    plot = so.Plot(x=["a", "a", "b", "b"], y=[1, 2, 3, 4])
+    plot.add(so.Range(), so.Perc(k=[0, 100])).plot()
