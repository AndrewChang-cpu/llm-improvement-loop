diff --git a/seaborn/_stats/order.py b/seaborn/_stats/order.py
new file mode 100644
index 0000000..556971a
--- /dev/null
+++ b/seaborn/_stats/order.py
@@ -0,0 +1,60 @@
+"""Statistics that operate on the order of observations."""
+from __future__ import annotations
+from dataclasses import dataclass
+from typing import ClassVar
+
+import numpy as np
+import pandas as pd
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.base import Stat
+from seaborn.external.version import Version
+
+
+@dataclass
+class Perc(Stat):
+    """Replace observations with requested percentile values.
+
+    Parameters
+    ----------
+    k : int or list of float
+        Number of evenly spaced percentile levels between 0 and 100, inclusive,
+        or explicit percentile levels in the range [0, 100]. The output has one
+        row for each level in each group, with the level in the ``percentile``
+        column.
+    method : str
+        Method used to compute the percentiles. Defaults to ``"linear"``. Choices
+        are ``"inverted_cdf"``, ``"averaged_inverted_cdf"``,
+        ``"closest_observation"``, ``"interpolated_inverted_cdf"``,
+        ``"hazen"``, ``"weibull"``, ``"linear"``, ``"median_unbiased"``,
+        ``"normal_unbiased"``, ``"lower"``, ``"higher"``, ``"midpoint"``,
+        and ``"nearest"``.
+
+    Examples
+    --------
+    .. include:: ../docstrings/objects.Perc.rst
+    """
+
+    k: int | list[float] = 5
+    method: str = "linear"
+
+    group_by_orient: ClassVar[bool] = True
+
+    def _compute(self, data, var):
+        if isinstance(self.k, int):
+            percentiles = np.linspace(0, 100, self.k)
+        else:
+            percentiles = self.k
+        method_arg = (
+            "method" if Version(np.__version__) >= Version("1.22.0")
+            else "interpolation"
+        )
+        kwargs = {method_arg: self.method}
+        values = np.percentile(data[var].dropna(), percentiles, **kwargs)
+        return pd.DataFrame({var: values, "percentile": percentiles})
+
+    def __call__(self, data, groupby, orient, scales):
+        var = {"x": "y", "y": "x"}[orient]
+        group_vars = [key for key in groupby.order if key in data and key != var]
+        data = data[[var, *group_vars]]
+        return groupby.apply(data, self._compute, var)
