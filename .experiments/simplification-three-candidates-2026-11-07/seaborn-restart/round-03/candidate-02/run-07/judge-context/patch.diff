diff --git a/tests/_stats/test_order.py b/tests/_stats/test_order.py
new file mode 100644
index 0000000..bdeb816
--- /dev/null
+++ b/tests/_stats/test_order.py
@@ -0,0 +1,51 @@
+import numpy as np
+import pandas as pd
+from pandas.testing import assert_frame_equal
+
+from seaborn._core.groupby import GroupBy
+from seaborn._stats.order import Perc
+from seaborn.objects import Perc as PublicPerc
+from seaborn.objects import Dot, Plot, Range
+
+
+class TestPerc:
+
+    def test_default(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3, 4], "y": [0, 2, 4, 6, 8], "group": ["a"] * 5})
+        result = Perc()(data, GroupBy(["group"]), "x", {})
+        expected = pd.DataFrame({
+            "y": [0., 2., 4., 6., 8.],
+            "group": ["a"] * 5,
+            "percentile": [0., 25., 50., 75., 100.],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_count_and_explicit_levels(self):
+        data = pd.DataFrame({"x": [0, 1, 2, 3], "y": [0, 2, 4, 6], "group": ["a"] * 4})
+        count = Perc(3)(data, GroupBy(["group"]), "x", {})
+        explicit = Perc([10, 90])(data, GroupBy(["group"]), "x", {})
+        assert count["percentile"].tolist() == [0, 50, 100]
+        assert explicit["percentile"].tolist() == [10, 90]
+
+    def test_method_missing_group_labels_and_order(self):
+        data = pd.DataFrame({
+            "x": [2, 1, 2, 1], "y": [4., 1., np.nan, 3.],
+            "group": ["b", "a", "b", "a"], "unused": [9, 8, 7, 6],
+        })
+        groupby = GroupBy({"group": ["a", "b"], "x": [1, 2]})
+        result = Perc([50], method="higher")(data, groupby, "x", {})
+        expected = pd.DataFrame({
+            "x": [1, 2], "y": [3., 4.], "group": ["a", "b"],
+            "percentile": [50, 50],
+        })
+        assert_frame_equal(result, expected)
+
+    def test_orientation_and_plot_add(self):
+        data = pd.DataFrame({"x": [1, 2, 3], "y": [2, 4, 8], "group": ["a"] * 3})
+        horizontal = Perc([0, 100])(data, GroupBy(["group"]), "y", {})
+        assert horizontal["x"].tolist() == [1, 3]
+        assert PublicPerc is Perc
+        plot = Plot(data, x="x").add(Dot(), Perc([25, 75]))
+        assert isinstance(plot, Plot)
+        interval = Plot(data, x="x").add(Range(), Perc([25, 75]))
+        assert isinstance(interval, Plot)
