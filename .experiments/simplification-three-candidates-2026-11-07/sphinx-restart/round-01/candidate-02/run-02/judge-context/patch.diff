diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..4a657cd 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -54,6 +54,87 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: Target | None\n"
+            "\n"
+            "   An alias description.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    signode = next(doctree.findall(desc_signature))
+    assert signode.astext() == 'type example.Alias = Target | None'
+    assert list(signode.findall(pending_xref))[0].astext() == 'Target'
+    assert 'example.Alias' in domain.objects
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['Target | None'].aliased
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' in domain.directives
+    assert 'type' in domain.roles
+
+
+def test_pytype_without_canonical_and_nested_context(app):
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:type:: Nested\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[1].astext() == 'type Alias'
+    assert signatures[2].astext() == 'type Nested'
+    assert 'Container.Alias' in domain.objects
+    assert 'Container.Nested' in domain.objects
+    assert 'Container.Alias.Nested' not in domain.objects
+
+
+def test_pytype_index_text(app):
+    app.config.add_module_names = False
+    bare = restructuredtext.parse(app, ".. py:type:: Bare\n")
+    top = restructuredtext.parse(app, ".. py:module:: other\n.. py:type:: Alias\n")
+    nested = restructuredtext.parse(app, ".. py:module:: other\n"
+                                    ".. py:class:: Container\n\n"
+                                    "   .. py:type:: NestedAlias\n")
+    index_nodes = list(top.findall(addnodes.index))
+    assert any(entry[1] == 'Alias (in module other)'
+               for node in index_nodes for entry in node.get('entries', []))
+    index_nodes = list(bare.findall(addnodes.index))
+    assert any(entry[1] == 'Bare' for node in index_nodes
+               for entry in node.get('entries', []))
+    index_nodes = list(nested.findall(addnodes.index))
+    assert any(entry[1] == 'NestedAlias (type alias in Container)'
+               for node in index_nodes for entry in node.get('entries', []))
+
+    app.config.add_module_names = True
+    nested = restructuredtext.parse(app, ".. py:module:: other\n"
+                                    ".. py:class:: Container\n\n"
+                                    "   .. py:type:: NamedAlias\n")
+    index_nodes = list(nested.findall(addnodes.index))
+    assert any(entry[1] == 'NamedAlias (type alias in other.Container)'
+               for node in index_nodes for entry in node.get('entries', []))
+
+
+def test_pytype_role_resolves_alias_target(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: CanonicalAlias\n"
+            "\n"
+            ".. py:type:: Reference\n"
+            "\n"
+            "   :py:type:`CanonicalAlias`\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    pending = list(doctree.findall(pending_xref))[-1]
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                    pending['reftarget'], pending,
+                                    nodes.literal('', 'CanonicalAlias'))
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Alias'
+
+
