diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..d697880
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,75 @@
+from __future__ import annotations
+
+import pytest
+from docutils import nodes
+
+from sphinx import addnodes
+from sphinx.addnodes import desc_annotation, desc_name, pending_xref
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_type_alias_without_canonical(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias\n\n   Alias description.\n')
+    signature = next(doctree.findall(addnodes.desc_signature))
+    assert signature.astext() == 'type Alias'
+    assert_node(signature[-1], desc_name, 'Alias')
+    assert doctree[0]['entries'] == [('single', 'Alias', 'Alias', '', None)]
+    assert app.env.domains['py'].objects['Alias'].objtype == 'type'
+
+
+def test_type_alias_canonical_annotation_and_xref(app):
+    doctree = restructuredtext.parse(app, (
+        '.. py:class:: Container\n\n'
+        '   .. py:class:: Item\n\n'
+        '   .. py:type:: Alias\n'
+        '      :canonical: Item\n\n'
+        '   See :py:type:`Alias`.\n'
+    ))
+    signatures = list(doctree.findall(addnodes.desc_signature))
+    alias_signature = signatures[-1]
+    assert alias_signature.astext() == 'type Alias = Item'
+    annotation = list(alias_signature.findall(desc_annotation))[-1]
+    assert list(annotation.findall(pending_xref))
+    assert 'Container.Alias' in app.env.domains['py'].objects
+    assert app.env.domains['py'].objects['Item'].aliased is True
+
+    role_xref = list(doctree.findall(pending_xref))[-1]
+    assert role_xref['reftype'] == 'type'
+    resolved = app.env.domains['py'].resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', role_xref, nodes.Text('Alias'))
+    assert resolved is not None
+    assert resolved['refid'] == 'Container.Alias'
+
+
+@pytest.mark.parametrize(('module', 'add_module_names', 'nested', 'expected'), [
+    (None, True, False, 'Alias'),
+    ('example', True, False, 'Alias (in module example)'),
+    (None, False, True, 'Alias (type alias in Container)'),
+    ('example', True, True, 'Alias (type alias in example.Container)'),
+    ('example', False, True, 'Alias (type alias in Container)'),
+])
+def test_type_alias_index_text(app, module, add_module_names, nested, expected):
+    app.config.add_module_names = add_module_names
+    content = '.. py:class:: Container\n\n   .. py:type:: Alias\n' if nested else \
+        '.. py:type:: Alias\n'
+    if module:
+        content = f'.. py:module:: {module}\n\n' + content
+    doctree = restructuredtext.parse(app, content)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert expected in [entry[1] for entry in entries]
+
+
+def test_type_alias_role_registered_and_nested_content_not_scoped(app):
+    domain = app.env.domains['py']
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.directives['type']
+    assert domain.roles['type']
+
+    doctree = restructuredtext.parse(app, (
+        '.. py:type:: Alias\n\n'
+        '   .. py:data:: child\n'
+    ))
+    assert 'child' in domain.objects
+    assert 'Alias.child' not in domain.objects
