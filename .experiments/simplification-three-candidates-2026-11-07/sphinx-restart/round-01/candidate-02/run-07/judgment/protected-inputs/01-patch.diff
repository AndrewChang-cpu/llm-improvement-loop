diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..8f5526a
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,96 @@
+"""Tests for Python type aliases."""
+
+from docutils import nodes
+
+from sphinx import addnodes
+from sphinx.addnodes import (desc, desc_annotation, desc_content, desc_name,
+                             desc_sig_punctuation, desc_sig_space)
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_py_type_alias_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: UserId\n"
+            "   :canonical: int\n"
+            "\n"
+            "   A user identifier.\n"
+            ".. py:type:: Token\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    descriptions = list(doctree.findall(desc))
+    signature = descriptions[0][0]
+    assert_node(signature[2], [desc_name, "UserId"])
+    assert_node(signature[0], [desc_annotation, ("type", desc_sig_space)])
+    assert_node(signature[3],
+                [desc_annotation, (desc_sig_space, desc_sig_punctuation, desc_sig_space,
+                                   addnodes.pending_xref)])
+    assert signature.astext() == 'type example.UserId = int'
+    assert_node(descriptions[0], addnodes.desc, desctype='type', domain='py', objtype='type')
+    assert_node(descriptions[0][1], desc_content)
+    assert signature['fullname'] == 'UserId'
+    assert domain.objects['example.UserId'].objtype == 'type'
+    assert domain.objects['int'].aliased is True
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' in domain.directives
+    assert 'type' in domain.roles
+    assert descriptions[1][0].astext() == 'type example.Token'
+    assert domain.objects['example.Token'].objtype == 'type'
+
+
+def test_py_type_alias_index_text(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias\n", 'standalone')
+    index = next(node for node in doctree.findall(addnodes.index) if node.get('entries'))
+    assert index['entries'] == [('single', 'Alias', 'Alias', '', None)]
+
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: ModuleAlias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: NestedAlias\n")
+    doctree = restructuredtext.parse(app, text)
+    indexes = list(doctree.findall(addnodes.index))
+    assert next(node for node in indexes if node.get('entries') and
+                'ModuleAlias' in node['entries'][0][1])['entries'] == [
+        ('single', 'ModuleAlias (in module example)', 'example.ModuleAlias', '', None)]
+    assert next(node for node in indexes if node.get('entries') and 'NestedAlias' in node['entries'][0][1])['entries'] == [
+        ('single', 'NestedAlias (type alias in Container)', 'example.Container.NestedAlias', '', None)]
+
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:class:: Container\n\n   .. py:type:: NestedAlias\n", 'other')
+    indexes = list(doctree.findall(addnodes.index))
+    assert next(node for node in indexes if node.get('entries') and
+                'NestedAlias' in node['entries'][0][1])['entries'] == [
+        ('single', 'NestedAlias (type alias in example.Container)',
+         'example.Container.NestedAlias', '', None)]
+
+
+def test_py_type_role_resolves_alias_target(app):
+    text = (".. py:type:: UserId\n"
+            "\n"
+            "   .. py:data:: child\n"
+            "\n"
+            "Reference :py:type:`UserId`.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    xref = list(doctree.findall(addnodes.pending_xref))[0]
+    assert xref['reftype'] == 'type'
+    assert xref['reftarget'] == 'UserId'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'UserId',
+                                   xref, nodes.Text('UserId'))
+    assert isinstance(resolved, nodes.reference)
+    assert resolved['refid'] == 'UserId'
+    # PyObject is non-nestable: contents do not become members of the alias.
+    assert 'UserId.child' not in domain.objects
+    assert 'child' in domain.objects
+
+
+def test_py_type_alias_nested_in_class(app):
+    doctree = restructuredtext.parse(
+        app, ".. py:class:: Container\n\n   .. py:type:: ItemId\n")
+    domain = app.env.get_domain('py')
+    assert list(doctree.findall(desc))[1][0].astext() == 'type ItemId'
+    assert domain.objects['Container.ItemId'].objtype == 'type'
