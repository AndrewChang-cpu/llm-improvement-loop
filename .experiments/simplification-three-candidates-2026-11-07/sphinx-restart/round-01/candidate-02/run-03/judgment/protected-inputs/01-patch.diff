+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[int]\n"
+            "\n"
+            "   Alias description.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    sig = next(doctree.findall(desc_signature))
+    assert sig.astext() == 'type example.Alias = list[int]'
+    assert any(isinstance(node, pending_xref) for node in sig.findall(pending_xref))
+    assert 'example.Alias' in domain.objects
+    assert domain.objects['example.Alias'][2:] == ('type', False)
+    assert str(domain.object_types['type'].lname) == 'type alias'
+    assert 'type' in domain.directives
+    assert 'type' in domain.roles
+
+
+def test_pytype_alias_without_canonical_and_nested(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    sig = next(sig for sig in doctree.findall(desc_signature)
+               if sig.get('fullname') == 'Container.Alias')
+    assert sig.astext() == 'type Alias'
+    assert 'example.Container.Alias' in domain.objects
+    assert domain.objects['example.Container.Alias'][2] == 'type'
+
+
+def test_pytype_index_text(app):
+    for add_module_names, expected in [(False, 'Alias (type alias in Container)'),
+                                       (True, 'Alias (type alias in example.Container)')]:
+        app.config.add_module_names = add_module_names
+        doctree = restructuredtext.parse(
+            app, ".. py:module:: example\n"
+                 ".. py:class:: Container\n\n"
+                 "   .. py:type:: Alias\n")
+        entries = [entry for node in doctree.findall(addnodes.index)
+                   for entry in node['entries']]
+        assert ('single', expected, 'example.Container.Alias', '', None) in entries
+
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(app,
+                                     ".. py:module:: example\n.. py:type:: Alias\n")
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in entries
+
+
