diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..b934f65 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -21,6 +21,85 @@ from sphinx.testing import restructuredtext
 from sphinx.testing.util import assert_node
 
 
+def test_pytype_without_canonical(app):
+    text = ".. py:type:: Alias\n\n   Alias description."
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    assert_node(doctree[1], addnodes.desc, desctype="type", domain="py",
+                objtype="type", no_index=False)
+    assert next(doctree.findall(desc_signature)).astext() == 'type Alias'
+    assert domain.objects['Alias'] == ('index', 'Alias', 'type', False)
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' in domain.roles
+    assert list(doctree.findall(addnodes.index))[-1]['entries'][0][1] == 'Alias'
+
+
+def test_pytype_canonical_annotation_and_module_index(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Widget]\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    signature = next(doctree.findall(desc_signature))
+    assert signature.astext() == 'type example.Alias = list[Widget]'
+    assert any(isinstance(node, pending_xref) and node['reftarget'] == 'Widget'
+               for node in signature.findall(pending_xref))
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.objects['list[Widget]'] == ('index', 'example.Alias', 'type', True)
+    assert list(doctree.findall(addnodes.index))[-1]['entries'][0][1] == (
+        'Alias (in module example)')
+
+
+def test_pytype_nested_name_and_index(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    assert domain.objects['example.Container.Alias'] == (
+        'index', 'example.Container.Alias', 'type', False)
+    assert list(doctree.findall(addnodes.index))[-1]['entries'][0][1] == (
+        'Alias (type alias in Container)')
+
+
+def test_pytype_nested_index_includes_module_when_enabled(app):
+    app.config.add_module_names = True
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    doctree = restructuredtext.parse(app, text)
+    assert list(doctree.findall(addnodes.index))[-1]['entries'][0][1] == (
+        'Alias (type alias in example.Container)')
+
+
+def test_pytype_does_not_create_a_nested_namespace(app):
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      .. py:type:: Inner\n")
+    restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    assert 'Container.Alias.Inner' not in domain.objects
+    assert 'Container.Inner' in domain.objects
+
+
+def test_pytype_reference_resolves_to_alias_target(app):
+    text = (".. py:type:: Alias\n"
+            "\n"
+            "See :py:type:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    xref = next(doctree.findall(pending_xref))
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                   'Alias', xref, xref[0])
+    assert resolved is not None
+    assert resolved['refid'] == 'Alias'
+
+
