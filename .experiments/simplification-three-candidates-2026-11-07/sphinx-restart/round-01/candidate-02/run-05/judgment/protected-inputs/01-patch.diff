diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..ab08f2a
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+from docutils import nodes
+
+from sphinx import addnodes
+from sphinx.addnodes import (
+    desc,
+    desc_annotation,
+    desc_content,
+    desc_name,
+    desc_sig_space,
+    desc_signature,
+    pending_xref,
+)
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_pytype_without_canonical(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias\n\n'
+                                     '   An alias description.')
+    domain = app.env.get_domain('py')
+
+    assert_node(doctree, (addnodes.index,
+                          [desc, ([desc_signature, ([desc_annotation, ('type', desc_sig_space)],
+                                                    [desc_name, 'Alias'])],
+                                  desc_content)]))
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.directives['type']
+    assert domain.roles['type']
+    assert domain.objects['Alias'] == ('index', 'Alias', 'type', False)
+    assert_node(doctree[0], addnodes.index,
+                entries=[('single', 'Alias', 'Alias', '', None)])
+    assert doctree[1][1][0].astext() == 'An alias description.'
+
+
+def test_pytype_canonical_annotation(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:type:: Alias\n   :canonical: typing.Alias')
+
+    signature = doctree[1][0]
+    assert signature.astext() == 'type Alias = Alias'
+    target_xref = next(signature.findall(pending_xref))
+    assert target_xref['reftype'] == 'obj'
+    assert target_xref['reftarget'] == 'typing.Alias'
+    domain = app.env.get_domain('py')
+    assert domain.objects['typing.Alias'] == ('index', 'Alias', 'type', True)
+
+
+def test_pytype_in_class_context_and_index_text(app):
+    text = ('.. py:module:: example\n'
+            '.. py:class:: Container\n'
+            '\n'
+            '   .. py:type:: Alias\n'
+            '\n'
+            '      .. py:class:: Child')
+    domain = app.env.get_domain('py')
+
+    doctree = restructuredtext.parse(app, text)
+
+    assert 'example.Container.Alias' in domain.objects
+    assert 'example.Container.Alias.Child' not in domain.objects
+    assert 'example.Container.Child' in domain.objects
+    alias_index = next(index for index in doctree.findall(addnodes.index)
+                       if index.get('entries', [('', '', '', '', '')])[0][2]
+                       == 'example.Container.Alias')
+    assert_node(alias_index, addnodes.index,
+                entries=[('single', 'Alias (type alias in example.Container)',
+                          'example.Container.Alias', '', None)])
+
+
+def test_pytype_module_index_text_respects_module_names(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n.. py:type:: Alias')
+    assert_node(doctree[1], addnodes.index,
+                entries=[('single', 'Alias (in module example)',
+                          'example.Alias', '', None)])
+
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n.. py:class:: Container\n\n'
+             '   .. py:type:: Alias')
+    alias_index = next(index for index in doctree.findall(addnodes.index)
+                       if index.get('entries', [('', '', '', '', '')])[0][2]
+                       == 'example.Container.Alias')
+    assert_node(alias_index, addnodes.index,
+                entries=[('single', 'Alias (type alias in example.Container)',
+                          'example.Container.Alias', '', None)])
+
+    app.config.add_module_names = False
+    app.env.ref_context.pop('py:module', None)
+    doctree = restructuredtext.parse(app, '.. py:class:: Container\n\n'
+                                     '   .. py:type:: Alias')
+    alias_index = next(index for index in doctree.findall(addnodes.index)
+                       if index.get('entries', [('', '', '', '', '')])[0][2]
+                       == 'Container.Alias')
+    assert_node(alias_index, addnodes.index,
+                entries=[('single', 'Alias (type alias in Container)',
+                          'Container.Alias', '', None)])
+
+
+def test_pytype_role_resolves_alias_target(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n.. py:type:: Alias\n'
+             '   :canonical: typing.Alias\n\n'
+             'See :py:type:`typing.Alias`.')
+    xref = list(doctree.findall(addnodes.pending_xref))[-1]
+    domain = app.env.get_domain('py')
+
+    assert xref['reftype'] == 'type'
+    refnode = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                  'typing.Alias', xref, xref[0])
+    assert isinstance(refnode, nodes.reference)
+    assert refnode['refid'] == 'example.Alias'
