+@pytest.mark.sphinx(freshenv=True, confoverrides={'add_module_names': True})
+def test_type_alias_directive_and_role(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[int]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            "      .. py:type:: Child\n"
+            "\n"
+            ".. py:type:: Bare\n"
+            "   :module: example\n"
+            "\n"
+            "References: :py:type:`Alias`, :py:type:`Container.Nested`.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.object_types['type'].lname == 'type alias'
+    assert {'canonical', 'module'} <= PyTypeAlias.option_spec.keys()
+    assert 'type' not in PyTypeAlias.option_spec and 'value' not in PyTypeAlias.option_spec
+    assert 'example.Alias' in domain.objects
+    assert 'example.Container.Nested' in domain.objects
+    assert 'example.Container.Child' in domain.objects
+    assert 'example.Container.Nested.Child' not in domain.objects
+    assert 'example.Bare' in domain.objects
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['list[int]'].aliased is True
+
+    descriptions = list(doctree.findall(desc))
+    signatures = [signature for description in descriptions
+                  for signature in description.findall(desc_signature)]
+    alias = next(signature for signature in signatures
+                 if signature.get('fullname') == 'Alias')
+    assert alias.astext() == 'type example.Alias = list[int]'
+    assert list(alias.findall(pending_xref))
+    assert 'Alias description.' in doctree.astext()
+
+    indexes = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in indexes
+    assert ('single', 'Nested (type alias in example.Container)',
+            'example.Container.Nested', '', None) in indexes
+    assert ('single', 'Bare (in module example)', 'example.Bare', '', None) in indexes
+
+    role_refs = [node for node in doctree.findall(pending_xref)
+                 if node.get('reftype') == 'type']
+    assert len(role_refs) == 2
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   role_refs[0], nodes.Text('Alias'))
+    assert isinstance(resolved, nodes.reference)
+    assert resolved['refid'] == 'example.Alias'
+    assert PyTypeAlias.allow_nesting is False
+
+
+@pytest.mark.sphinx(freshenv=True, confoverrides={'add_module_names': False})
+def test_type_alias_index_without_module_names(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    indexes = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Nested (type alias in Container)',
+            'example.Container.Nested', '', None) in indexes
+
+
+def test_type_alias_without_module_or_canonical(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Standalone\n')
+    index = next(doctree.findall(addnodes.index))
+    assert index['entries'] == [('single', 'Standalone', 'Standalone', '', None)]
+    assert 'Standalone' in app.env.get_domain('py').objects
+
