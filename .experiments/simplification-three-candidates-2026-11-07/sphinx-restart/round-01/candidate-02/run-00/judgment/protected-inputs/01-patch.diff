+def test_pytype_signature_and_canonical(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Base\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: Base | int\n")
+    doctree = restructuredtext.parse(app, text)
+    signature = doctree[5][0]
+    assert signature.astext() == 'type example.Alias = Base | int'
+    assert [node['reftarget'] for node in signature.findall(pending_xref)] == ['Base', 'int']
+    assert app.env.domains['py'].objects['example.Alias'].objtype == 'type'
+    assert app.env.domains['py'].objects['example.Base'].objtype == 'class'
+
+
+def test_pytype_context_index_and_canonical_target(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: canonical.Alias\n"
+            "\n"
+            "      Alias description.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.domains['py']
+    assert 'example.Container.Alias' in domain.objects
+    assert domain.objects['canonical.Alias'].aliased
+    entry = next(entry for node in doctree.findall(addnodes.index)
+                 for entry in node['entries'] if 'Alias' in entry[1])
+    assert entry[1] == 'Alias (type alias in Container)'
+
+
+def test_pytype_index_text_module_name_setting(app):
+    domain = app.env.domains['py']
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(app, ".. py:module:: example\n.. py:type:: Alias")
+    entry = next(entry for node in doctree.findall(addnodes.index)
+                 for entry in node['entries'] if 'Alias' in entry[1])
+    assert entry[1] == 'Alias (in module example)'
+
+    app.env.ref_context.pop('py:module', None)
+    doctree = restructuredtext.parse(app, ".. py:type:: BuiltinAlias")
+    entry = next(entry for node in doctree.findall(addnodes.index)
+                 for entry in node['entries'] if 'BuiltinAlias' in entry[1])
+    assert entry[1] == 'BuiltinAlias'
+
+    app.config.add_module_names = True
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    doctree = restructuredtext.parse(app, text)
+    entry = next(entry for node in doctree.findall(addnodes.index)
+                 for entry in node['entries'] if 'Alias' in entry[1])
+    assert entry[1] == 'Alias (type alias in example.Container)'
+    assert domain.object_types['type'].lname == 'type alias'
+
+
+def test_pytype_without_canonical_and_role_resolution(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            "   A documented alias.\n"
+            "\n"
+            "Reference :py:type:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.domains['py']
+    xref = next(doctree.findall(pending_xref))
+    assert xref['reftype'] == 'type'
+    assert xref['reftarget'] == 'Alias'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   xref, nodes.Text('Alias'))
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Alias'
+
+
+def test_pytype_is_non_nestable_but_can_be_class_scoped(app):
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      Alias description.\n")
+    restructuredtext.parse(app, text)
+    assert 'Container.Alias' in app.env.domains['py'].objects
+
+    text = (".. py:type:: Alias\n"
+            "\n"
+            "   .. py:class:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    assert 'Nested' in app.env.domains['py'].objects
+    assert 'Alias.Nested' not in app.env.domains['py'].objects
+    assert app.env.ref_context.get('py:class') is None
+
+
