diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..60fa737
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,105 @@
+"""Tests for Python type aliases."""
+
+from __future__ import annotations
+
+from docutils import nodes
+import pytest
+
+from sphinx import addnodes
+from sphinx.addnodes import desc_annotation, desc_content, desc_name, desc_signature, pending_xref
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_type_alias_without_canonical(app):
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias\n\n   Alias description.')
+
+    assert_node(doctree, (addnodes.index,
+                          [addnodes.desc, ([desc_signature, (
+                              [desc_annotation, ('type', addnodes.desc_sig_space)],
+                              [desc_name, 'Alias'])],
+                                           [desc_content, nodes.paragraph])]))
+    assert domain.objects['Alias'] == ('index', 'Alias', 'type', False)
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' in domain.directives
+    assert 'type' in domain.roles
+    assert 'canonical' in domain.directives['type'].option_spec
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+    assert doctree[0]['entries'] == [('single', 'Alias', 'Alias', '', None)]
+
+
+def test_type_alias_canonical_annotation_and_canonical_target(app):
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(
+        app, '.. py:class:: Item\n\n.. py:type:: Alias\n   :canonical: list[Item]\n')
+
+    alias = doctree[-1]
+    signature = alias[0]
+    annotation = signature[-1]
+    assert isinstance(annotation, desc_annotation)
+    assert annotation.astext() == ' = list[Item]'
+    assert any(isinstance(node, pending_xref) and node.get('reftarget') == 'Item'
+               for node in annotation.findall(nodes.Element))
+    assert signature.astext() == 'type Alias = list[Item]'
+    assert domain.objects['Alias'] == ('index', 'Alias', 'type', False)
+    assert domain.objects['list[Item]'] == ('index', 'Alias', 'type', True)
+
+
+def test_type_alias_nested_in_class_and_not_nestable(app):
+    domain = app.env.get_domain('py')
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      Alias documentation.\n"
+            "\n"
+            "      .. py:class:: Inner\n"
+            "\n"
+            "   .. py:method:: method()\n")
+    restructuredtext.parse(app, text)
+
+    assert domain.objects['Container.Alias'][2] == 'type'
+    assert domain.objects['Container.Inner'][2] == 'class'
+    assert domain.objects['Container.method'][2] == 'method'
+    assert 'Container.Alias.Inner' not in domain.objects
+
+
+def test_type_alias_role_resolves_to_alias_target(app):
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(
+        app, '.. py:type:: Alias\n\nSee :py:type:`Alias` and :py:obj:`Alias`.')
+    references = list(doctree.findall(pending_xref))
+
+    assert [ref['reftype'] for ref in references] == ['type', 'obj']
+    for ref in references:
+        resolved = domain.resolve_xref(app.env, 'index', app.builder,
+                                       ref['reftype'], ref['reftarget'], ref,
+                                       ref[0])
+        assert resolved is not None
+        assert resolved['refid'] == 'Alias'
+
+
+@pytest.mark.sphinx(confoverrides={'add_module_names': False})
+def test_type_alias_index_module_and_nested_names(app):
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n\n.. py:type:: Alias\n\n.. py:class:: Container\n\n   .. py:type:: Nested\n')
+
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in entries
+    assert ('single', 'Nested (type alias in Container)',
+            'example.Container.Nested', '', None) in entries
+
+
+@pytest.mark.sphinx(confoverrides={'add_module_names': True})
+def test_type_alias_nested_index_includes_module_when_enabled(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n\n.. py:class:: Container\n\n   .. py:type:: Nested\n')
+
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Nested (type alias in example.Container)',
+            'example.Container.Nested', '', None) in entries
