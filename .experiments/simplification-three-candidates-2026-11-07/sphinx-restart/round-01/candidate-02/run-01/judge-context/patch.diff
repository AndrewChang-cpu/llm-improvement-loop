     assert_node(doctree[2], addnodes.index, entries=[])
 
 
+def test_type_alias_directive_and_role(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Item\n"
+            "      :canonical: list[str]\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            ".. py:type:: Standalone\n"
+            "\n"
+            "   Alias without a canonical expression.\n"
+            "\n"
+            "See :py:type:`Container.Item` and :py:type:`Standalone`.\n")
+    doctree = restructuredtext.parse(app, text)
+    aliases = [node for node in doctree.findall(desc)
+               if node.get('domain') == 'py' and node.get('objtype') == 'type']
+    assert [node[0].astext() for node in aliases] == [
+        'type Item = list[str]', 'type example.Standalone']
+    assert aliases[0][0].findall(pending_xref)
+    assert aliases[0][1].astext() == 'Alias description.'
+    assert [node['entries'][0][1] for node in doctree.findall(addnodes.index)
+            if node['entries'][0][1].startswith(('Item ', 'Standalone '))] == [
+        'Item (type alias in example.Container)', 'Standalone (in module example)']
+
+    domain = app.env.domains['py']
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objects['example.Container.Item'].objtype == 'type'
+    assert domain.objects['example.Standalone'].objtype == 'type'
+    assert domain.objects['list[str]'].aliased
+
+    ref = next(node for node in doctree.findall(pending_xref)
+               if node.get('reftype') == 'type')
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                   ref['reftarget'], ref, nodes.Text('Item'))
+    assert resolved is not None
+    assert resolved['refid'] == domain.objects['example.Container.Item'].node_id
+
+
+def test_type_alias_does_not_change_nesting_context(app):
+    restructuredtext.parse(
+        app, ".. py:class:: Container\n\n   .. py:type:: Alias\n\n   .. py:type:: Another\n")
+    domain = app.env.domains['py']
+    assert 'Container.Alias' in domain.objects
+    assert 'Container.Another' in domain.objects
+
+
+def test_type_alias_index_without_module_names(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:class:: Container\n\n   .. py:type:: Item\n")
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'Item (type alias in Container)',
+            'example.Container.Item', '', None) in entries
+
+
