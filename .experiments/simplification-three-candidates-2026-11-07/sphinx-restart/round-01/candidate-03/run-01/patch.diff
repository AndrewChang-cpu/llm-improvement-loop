diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..fc5241f
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,92 @@
+from __future__ import annotations
+
+import re
+
+import pytest
+
+from sphinx import addnodes
+from sphinx.addnodes import pending_xref
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Bare\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: Target | None\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:data:: nested\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    alias = next(node for node in doctree.findall(addnodes.desc)
+                 if node.get('objtype') == 'type'
+                 and node[0].astext() == 'type Alias = Target | None')
+    assert alias['objtype'] == 'type'
+    assert alias[0].astext() == 'type Alias = Target | None'
+    assert_node(list(alias[0].findall(pending_xref))[0], pending_xref,
+                refdomain='py', reftype='class', reftarget='Target')
+    assert domain.objects['example.Container.Alias'].objtype == 'type'
+    assert domain.objects['Target | None'].objtype == 'type'
+    assert domain.objects['example.Container.nested'].objtype == 'data'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objects['example.Bare'].objtype == 'type'
+    bare = next(node for node in doctree.findall(addnodes.desc)
+                if node.get('objtype') == 'type'
+                and node[0].astext() == 'type example.Bare')
+    assert bare[0].astext() == 'type example.Bare'
+    assert 'canonical' in domain.directives['type'].option_spec
+    assert not {'value', 'type'} & set(domain.directives['type'].option_spec)
+
+
+def test_pytype_index_text(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: ModuleAlias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'ModuleAlias (in module example)', 'example.ModuleAlias', '', None) in entries
+    assert ('single', 'Alias (type alias in example.Container)',
+            'example.Container.Alias', '', None) in entries
+
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert ('single', 'Alias (type alias in Container)',
+            'example.Container.Alias', '', None) in entries
+
+
+@pytest.mark.sphinx('html', testroot='domain-py')
+def test_pytype_role_resolves_module_and_class_aliases(app, status, warning):
+    source = (".. py:module:: example\n"
+              "\n"
+              ".. py:class:: Target\n"
+              "\n"
+              ".. py:type:: Bare\n"
+              "\n"
+              ".. py:type:: Alias\n"
+              "   :canonical: Target\n"
+              "\n"
+              ".. py:class:: Container\n"
+              "\n"
+              "   .. py:type:: NestedAlias\n"
+              "      :canonical: Target\n"
+              "\n"
+              "No-canonical reference: :py:type:`Bare`.\n"
+              "Alias reference: :py:type:`Alias`.\n"
+              "Nested reference: :py:type:`Container.NestedAlias`.\n")
+    (app.srcdir / 'type_aliases.rst').write_text(source, encoding='utf8')
+    app.build(force_all=True)
+    content = (app.outdir / 'type_aliases.html').read_text(encoding='utf8')
+    assert re.search(r'href="#example\.Bare"', content)
+    assert re.search(r'href="#example\.Alias"', content)
+    assert re.search(r'href="#example\.Container\.NestedAlias"', content)
