diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..f80a4d0
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from sphinx import addnodes
+from sphinx.addnodes import (
+    desc,
+    desc_annotation,
+    desc_name,
+    desc_sig_punctuation,
+    desc_sig_space,
+    pending_xref,
+)
+from sphinx.domains.python import PythonDomain
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def index_entries(doctree, target):
+    return next(node['entries'] for node in doctree.findall(addnodes.index)
+                if any(entry[2] == target for entry in node['entries']))
+
+
+def test_pytype_signature_and_canonical(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:class:: Target\n'
+        '.. py:type:: Alias\n'
+        '   :canonical: list[Target]\n')
+    type_desc = next(node for node in doctree.findall(desc) if node.get('objtype') == 'type')
+    assert_node(type_desc[0],
+                ([desc_annotation, ('type', desc_sig_space)],
+                 [desc_name, 'Alias'],
+                 [desc_annotation, (desc_sig_space, [desc_sig_punctuation, '='],
+                                    desc_sig_space, [pending_xref, 'list'],
+                                    [desc_sig_punctuation, '['],
+                                    [pending_xref, 'Target'],
+                                    [desc_sig_punctuation, ']'])]))
+    assert type_desc['objtype'] == 'type'
+    assert app.env.domains['py'].objects['Alias'].objtype == 'type'
+    assert app.env.domains['py'].objects['list[Target]'].aliased
+    annotation_xref = next(node for node in doctree.findall(pending_xref)
+                           if node.get('reftarget') == 'Target')
+    resolved = app.env.domains['py'].resolve_xref(
+        app.env, 'index', app.builder, 'class', 'Target', annotation_xref,
+        annotation_xref[0])
+    assert resolved is not None
+    assert PythonDomain.object_types['type'].lname == 'type alias'
+    assert PythonDomain.object_types['type'].roles == ('type', 'obj')
+    assert 'canonical' in PythonDomain.directives['type'].option_spec
+    assert 'type' not in PythonDomain.directives['type'].option_spec
+    assert 'value' not in PythonDomain.directives['type'].option_spec
+
+
+def test_pytype_without_canonical_and_index_text(app):
+    doctree = restructuredtext.parse(app, '.. py:module:: example\n.. py:type:: Alias\n')
+    type_desc = next(node for node in doctree.findall(desc) if node.get('objtype') == 'type')
+    assert type_desc[0].astext() == 'type example.Alias'
+    assert index_entries(doctree, 'example.Alias') == [
+        ('single', 'Alias (in module example)', 'example.Alias', '', None)]
+
+
+def test_pytype_index_without_module(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: BareAlias\n')
+    assert index_entries(doctree, 'BareAlias') == [
+        ('single', 'BareAlias', 'BareAlias', '', None)]
+
+
+def test_pytype_class_scope_and_non_nesting(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n'
+        '.. py:class:: Container\n\n'
+        '   .. py:type:: Alias\n\n'
+        '      Alias description.\n\n'
+        '      Use :py:type:`Alias`.\n\n'
+        '      .. py:data:: child\n')
+    domain = app.env.domains['py']
+    assert 'example.Container.Alias' in domain.objects
+    assert 'example.Container.child' in domain.objects
+    assert 'example.Container.Alias.child' not in domain.objects
+    assert index_entries(doctree, 'example.Container.Alias') == [
+        ('single', 'Alias (type alias in example.Container)', 'example.Container.Alias', '', None)]
+    assert 'Alias description.' in doctree.astext()
+    xref = next(node for node in doctree.findall(pending_xref)
+                if node.get('reftype') == 'type')
+    resolved = domain.resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', xref, xref[0])
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Container.Alias'
+
+
+def test_pytype_index_without_module_names(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n'
+        '.. py:class:: Container\n\n'
+        '   .. py:type:: Alias\n')
+    assert index_entries(doctree, 'example.Container.Alias') == [
+        ('single', 'Alias (type alias in Container)', 'example.Container.Alias', '', None)]
+
+
+def test_pytype_role_resolves_to_declared_alias(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n'
+        '.. py:type:: Alias\n\n'
+        '   Alias description.\n\n'
+        'Use :py:type:`Alias`.')
+    xref = next(node for node in doctree.findall(pending_xref)
+                if node.get('reftype') == 'type')
+    resolved = app.env.domains['py'].resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', xref, xref[0])
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Alias'
+
