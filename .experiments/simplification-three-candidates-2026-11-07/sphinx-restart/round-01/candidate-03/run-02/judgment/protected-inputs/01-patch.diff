+def test_pytype_alias_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            "   .. py:data:: child\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            ".. py:currentmodule:: None\n"
+            ".. py:type:: Bare\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    descriptions = list(doctree.findall(desc))
+    indexes = [node['entries'] for node in doctree.findall(addnodes.index)]
+
+    assert descriptions[0][0].astext() == 'type example.Alias = list[Target]'
+    assert list(doctree.findall(pending_xref))[-1]['reftarget'] == 'Target'
+    assert 'example.Alias' in domain.objects
+    assert 'list[Target]' in domain.objects
+    assert 'example.child' in domain.objects
+    assert 'example.Alias.child' not in domain.objects
+    assert 'example.Container.Nested' in domain.objects
+    assert 'Bare' in domain.objects
+    assert any(entry == ('single', 'Bare', 'Bare', '', None)
+               for entries in indexes for entry in entries)
+    assert descriptions[0][1].astext().startswith('Alias description.')
+    assert PyTypeAlias.allow_nesting is False
+    assert 'canonical' in PyTypeAlias.option_spec
+    assert 'type' not in PyTypeAlias.option_spec
+    assert 'value' not in PyTypeAlias.option_spec
+
+
+def test_pytype_alias_without_canonical_and_index_text(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    descriptions = list(doctree.findall(desc))
+    indexes = [node['entries'] for node in doctree.findall(addnodes.index)]
+    assert descriptions[0][0].astext() == 'type Alias'
+    assert any(entry == ('single', 'Alias (in module example)',
+                         'example.Alias', '', None)
+               for entries in indexes for entry in entries)
+    assert any(entry == ('single', 'Nested (type alias in Container)',
+                         'example.Container.Nested', '', None)
+               for entries in indexes for entry in entries)
+    assert 'example.Alias' in domain.objects
+    assert domain.object_types['type'].lname == 'type alias'
+
+
+def test_pytype_alias_nested_index_with_module_name(app):
+    app.config.add_module_names = True
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    indexes = [node['entries'] for node in doctree.findall(addnodes.index)]
+    assert any(entry == ('single', 'Nested (type alias in example.Container)',
+                         'example.Container.Nested', '', None)
+               for entries in indexes for entry in entries)
+
