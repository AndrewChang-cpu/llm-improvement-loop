+@pytest.mark.sphinx('html', testroot='domain-py')
+def test_type_alias_role_resolves_to_module_and_class_aliases(app, status, warning):
+    module_file = app.srcdir / 'module.rst'
+    module_file.write_text(
+        module_file.read_text(encoding='utf8') +
+        '\n.. py:module:: aliasmod\n\n'
+        '.. py:class:: Target\n\n'
+        '.. py:type:: Alias\n'
+        '   :canonical: Target\n\n'
+        '.. py:class:: Container\n\n'
+        '   .. py:type:: Nested\n\n'
+        '* Reference: :py:type:`Alias`\n'
+        '* Nested reference: :py:type:`Container.Nested`\n',
+        encoding='utf8',
+    )
+    app.build(force_all=True)
+
+    content = (app.outdir / 'module.html').read_text(encoding='utf8')
+    assert 'href="#aliasmod.Target"' in content
+    assert 'href="#aliasmod.Alias"' in content
+    assert 'href="#aliasmod.Container.Nested"' in content
+
