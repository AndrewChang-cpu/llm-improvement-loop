+@pytest.mark.sphinx('html', testroot='domain-py')
+def test_type_alias_directive_and_role(app, status, warning):
+    app.build(force_all=True)
+
+    domain = app.env.get_domain('py')
+    assert {'canonical', 'module', 'no-index'} <= PyTypeAlias.option_spec.keys()
+    assert not {'type', 'value'} & PyTypeAlias.option_spec.keys()
+    assert PyTypeAlias.allow_nesting is False
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.object_types['type'].lname == 'type alias'
+    assert {name: entry.objtype for name, entry in domain.objects.items()
+            if name.endswith(('.Alias', '.Bare'))} == {
+                'example.Container.Alias': 'type',
+                'example.Container.Bare': 'type',
+            }
+    assert domain.objects['typing.List[Target]'].objtype == 'type'
+    assert domain.objects['example.ModuleAlias'].objtype == 'type'
+    assert domain.objects['example.Target'].objtype == 'class'
+
+    content = (app.outdir / 'type_alias.html').read_text(encoding='utf8')
+    doctree = app.env.get_doctree('type_alias')
+    alias_sig = next(node for node in doctree.findall(desc_signature)
+                     if node.get('fullname') == 'Container.Alias')
+    assert alias_sig.astext() == 'type Alias = List[Target]'
+    assert 'href="#example.Target"' in content
+    assert 'href="#example.ModuleAlias"' in content
+    assert 'href="#example.Container.Alias"' in content
+    assert 'href="#example.Container.Bare"' in content
+    assert 'example.Container.regular' in content
+
+
+@pytest.mark.sphinx(freshenv=True)
+@pytest.mark.parametrize(
+    ('add_module_names', 'expected'),
+    [(True, 'Alias (type alias in example.Container)'),
+     (False, 'Alias (type alias in Container)')],
+)
+def test_type_alias_index_entry(app, add_module_names, expected):
+    app.config.add_module_names = add_module_names
+    doctree = restructuredtext.parse(
+        app,
+        """.. py:type:: Standalone
+
+.. py:module:: example
+
+.. py:type:: ModuleAlias
+
+.. py:class:: Container
+
+   .. py:type:: Alias
+""",
+    )
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Standalone', 'Standalone', '', None) in entries
+    assert ('single', 'ModuleAlias (in module example)', 'example.ModuleAlias', '', None) in entries
+    assert ('single', expected, 'example.Container.Alias', '', None) in entries
+
+
