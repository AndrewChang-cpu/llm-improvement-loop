diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..7ba9e4d
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,79 @@
+"""Tests the Python type alias directive and role."""
+
+from __future__ import annotations
+
+from sphinx import addnodes
+from sphinx.addnodes import desc, desc_annotation, desc_name, desc_sig_punctuation, desc_sig_space, desc_signature, pending_xref
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_pytype_canonical(app):
+    doctree = restructuredtext.parse(
+        app, ".. py:type:: Alias\n   :canonical: Target\n")
+    assert_node(doctree, (addnodes.index,
+                          [desc, ([desc_signature, ([desc_annotation, ('type', desc_sig_space)],
+                                                    [desc_name, 'Alias'],
+                                                    [desc_annotation, (desc_sig_space,
+                                                                       [desc_sig_punctuation, '='],
+                                                                       desc_sig_space,
+                                                                       [pending_xref, 'Target'])])],
+                                  addnodes.desc_content)]))
+    domain = app.env.get_domain('py')
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objects['Alias'].objtype == 'type'
+    assert domain.objects['Target'].aliased
+
+
+def test_pytype_module_index(app):
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:type:: Alias\n")
+    index = next(node for node in doctree.findall(addnodes.index)
+                 if node['entries'] and 'Alias' in node['entries'][0][1])
+    assert index['entries'][0][1] == 'Alias (in module example)'
+
+
+def test_pytype_without_canonical_and_role(app):
+    doctree = restructuredtext.parse(
+        app, ".. py:type:: Alias\n\nSee :py:type:`Alias`.\n")
+    assert_node(next(doctree.findall(pending_xref)), pending_xref,
+                refdomain='py', reftype='type', reftarget='Alias')
+    target = app.env.get_domain('py').objects['Alias']
+    assert target.objtype == 'type'
+    xref = next(doctree.findall(pending_xref))
+    resolved = app.env.get_domain('py').resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', xref, xref[0])
+    assert resolved['refid'] == target.node_id
+
+
+def test_pytype_class_context_and_index(app):
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n"
+        ".. py:class:: Class\n\n"
+        "   .. py:type:: Alias\n\n"
+        "      description\n")
+    alias = next(node for node in doctree.findall(desc) if node['objtype'] == 'type')
+    assert alias['objtype'] == 'type'
+    assert app.env.get_domain('py').objects['example.Class.Alias'].objtype == 'type'
+    index = next(node for node in doctree.findall(addnodes.index)
+                 if node['entries'] and 'Alias' in node['entries'][0][1])
+    assert index['entries'][0][1] == 'Alias (type alias in example.Class)'
+
+
+def test_pytype_nested_index_without_module_names(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, ".. py:class:: Class\n\n   .. py:type:: Alias\n")
+    index = next(node for node in doctree.findall(addnodes.index)
+                 if node['entries'] and 'Alias' in node['entries'][0][1])
+    assert index['entries'][0][1] == 'Alias (type alias in Class)'
+
+
+def test_pytype_is_not_a_container(app):
+    restructuredtext.parse(
+        app, ".. py:class:: Class\n\n"
+        "   .. py:type:: Alias\n\n"
+        "      .. py:data:: child\n")
+    objects = app.env.get_domain('py').objects
+    assert 'Class.child' in objects
+    assert 'Class.Alias.child' not in objects
