diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..b29af7a 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -54,6 +54,97 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            "      Nested alias description.\n"
+            "\n"
+            "   See :py:type:`Nested`.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: AliasWithChild\n"
+            "\n"
+            "      .. py:method:: child()\n"
+            "\n"
+            ".. py:class:: Target\n"
+            "\n"
+            "See :py:type:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    alias = next(node for node in doctree.findall(desc)
+                 if node[0].astext() == 'type example.Alias = list[Target]')
+    assert alias[0]['module'] == 'example'
+    assert alias[0].astext() == 'type example.Alias = list[Target]'
+    annotation_xref = next(node for node in alias[0].findall(pending_xref)
+                           if node['reftarget'] == 'Target')
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'class', 'Target',
+                                   annotation_xref, nodes.Text('Target'))
+    assert resolved['refid'] == 'example.Target'
+    assert 'example.Alias' in domain.objects
+    assert 'list[Target]' in domain.objects  # canonical name is also registered
+    assert domain.objects['example.Alias'][2] == 'type'
+    assert alias[1].astext() == 'Alias description.'
+
+    nested = next(node for node in doctree.findall(desc)
+                  if node.get('objtype') == 'type' and
+                  node[0].get('fullname') == 'Class.Nested')
+    assert nested[0].astext() == 'type Nested'
+    assert domain.objects['example.Class.Nested'][2] == 'type'
+    child = next(node for node in doctree.findall(desc)
+                 if node.get('objtype') == 'method')
+    assert child[0]['fullname'] == 'Container.child'
+
+    role = next(node for node in doctree.findall(pending_xref)
+                if node['reftype'] == 'type' and node['reftarget'] == 'Alias')
+    assert role['reftype'] == 'type'
+    assert role['reftarget'] == 'Alias'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                  role, nodes.Text('Alias'))
+    assert resolved['refid'] == 'example.Alias'
+    nested_role = next(node for node in doctree.findall(pending_xref)
+                       if node['reftype'] == 'type' and
+                       node['reftarget'] == 'Nested')
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Nested',
+                                  nested_role, nodes.Text('Nested'))
+    assert resolved['refid'] == 'example.Class.Nested'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+
+
+def test_pytype_alias_index_text(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: ModuleAlias\n"
+            "\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: NestedAlias\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'ModuleAlias (in module example)',
+            'example.ModuleAlias', '', None) in entries
+    assert ('single', 'NestedAlias (type alias in Class)',
+            'example.Class.NestedAlias', '', None) in entries
+
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'NestedAlias (type alias in example.Class)',
+            'example.Class.NestedAlias', '', None) in entries
+
+
