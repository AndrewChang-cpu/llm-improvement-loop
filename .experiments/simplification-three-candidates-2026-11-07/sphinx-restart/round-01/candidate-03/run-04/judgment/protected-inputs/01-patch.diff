+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: int | str\n"
+            "\n"
+            "      Alias description.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    declaration = next(node for node in doctree.findall(addnodes.desc)
+                       if node['objtype'] == 'type')
+    assert declaration[0].astext() == 'type Alias = int | str'
+    alias = domain.objects['example.Class.Alias']
+    assert alias[2:] == ('type', False)
+    assert domain.objects['int | str'][:3] == alias[:3]
+    assert domain.objects['int | str'][3] is True
+    index = next(node for node in doctree.findall(addnodes.index)
+                 if node.get('entries') and node['entries'][0][2] == 'example.Class.Alias')
+    assert index['entries'] == [
+        ('single', 'Alias (type alias in example.Class)', 'example.Class.Alias', '', None),
+    ]
+    assert domain.object_types['type'].lname == 'type alias'
+
+
+def test_pytype_without_canonical_and_module_index(app):
+    text = ".. py:module:: example\n.. py:type:: Alias\n"
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    declaration = next(node for node in doctree.findall(addnodes.desc)
+                       if node['objtype'] == 'type')
+    assert declaration[0].astext() == 'type example.Alias'
+    assert domain.objects['example.Alias'][2] == 'type'
+    index = next(node for node in doctree.findall(addnodes.index)
+                 if node.get('entries') and node['entries'][0][2] == 'example.Alias')
+    assert index['entries'] == [
+        ('single', 'Alias (in module example)', 'example.Alias', '', None),
+    ]
+
+
+def test_pytype_nested_index_without_module_names(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    doctree = restructuredtext.parse(app, text)
+    index = next(node for node in doctree.findall(addnodes.index)
+                 if node.get('entries') and node['entries'][0][2] == 'example.Class.Alias')
+    assert index['entries'][0][1] == 'Alias (type alias in Class)'
+
+
+def test_pytype_role_resolves_to_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            "Reference :py:type:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    xref = next(doctree.findall(pending_xref))
+    assert xref['reftype'] == 'type'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   xref, xref[0])
+    assert resolved['refid'] == 'example.Alias'
+
+
+def test_pytype_disallows_nested_objects(app):
+    text = (".. py:type:: Alias\n"
+            "\n"
+            "   .. py:data:: nested\n")
+    domain = app.env.get_domain('py')
+    restructuredtext.parse(app, text)
+    assert 'Alias' in domain.objects
+    assert 'nested' in domain.objects
+    assert 'Alias.nested' not in domain.objects
+
+
