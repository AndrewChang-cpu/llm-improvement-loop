+def test_pytype_alias(app):
+    app.config.add_module_names = True
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: list[Target]\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:data:: member\n"
+            "\n"
+            "Alias reference: :py:type:`Container.Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    alias = doctree[3][1][1]
+    assert alias[0].astext() == 'type Alias = list[Target]'
+    annotation_targets = {node['reftarget'] for node in alias[0].findall(pending_xref)}
+    assert {'list', 'Target'} <= annotation_targets
+    assert domain.objects['example.Container.Alias'] == (
+        'index', 'example.Container.Alias', 'type', False)
+    assert domain.objects['list[Target]'] == (
+        'index', 'example.Container.Alias', 'type', True)
+    assert 'example.Container.Alias.member' not in domain.objects
+    assert domain.objects['example.Container.member'][2] == 'data'
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'Alias (type alias in example.Container)',
+            'example.Container.Alias', '', None) in entries
+
+    role_xref = next(node for node in doctree.findall(pending_xref)
+                     if node['reftype'] == 'type')
+    assert role_xref['reftarget'] == 'Container.Alias'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                   'Container.Alias', role_xref, nodes.Text('Alias'))
+    assert resolved['refid'] == 'example.Container.Alias'
+    assert domain.object_types['type'].lname == 'type alias'
+
+
+def test_pytype_alias_without_canonical_and_index_names(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: ModuleAlias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: NestedAlias\n"
+            "\n"
+            ".. py:currentmodule:: None\n"
+            ".. py:type:: BuiltinAlias\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    assert any(node.astext() == 'type ModuleAlias'
+               for node in doctree.findall(desc_signature))
+    assert domain.objects['example.ModuleAlias'][2] == 'type'
+    assert domain.objects['example.Container.NestedAlias'][2] == 'type'
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert ('single', 'ModuleAlias (in module example)',
+            'example.ModuleAlias', '', None) in entries
+    assert ('single', 'NestedAlias (type alias in Container)',
+            'example.Container.NestedAlias', '', None) in entries
+    assert ('single', 'BuiltinAlias', 'BuiltinAlias', '', None) in entries
+
+
