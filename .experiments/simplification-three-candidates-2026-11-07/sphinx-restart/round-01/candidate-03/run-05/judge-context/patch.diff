+def test_pytype_alias_with_canonical(app):
+    text = (".. py:module:: alias_mod\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   An alias description.\n"
+            "\n"
+            "See :py:type:`Alias`.")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    signature = list(doctree.findall(desc_signature))[0]
+    assert signature.astext() == 'type alias_mod.Alias = list[Target]'
+    assert any(node['reftarget'] == 'Target'
+               for node in signature.findall(pending_xref))
+    assert list(doctree.findall(desc))[0]['objtype'] == 'type'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert 'canonical' in domain.directives['type'].option_spec
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+    assert 'alias_mod.Alias' in domain.objects
+    assert domain.objects['list[Target]'].aliased is True
+    assert domain.objects['list[Target]'].node_id == domain.objects['alias_mod.Alias'].node_id
+
+    role = list(doctree.findall(pending_xref))[-1]
+    assert role['reftype'] == 'type'
+    assert role['reftarget'] == 'Alias'
+    refnode = domain.resolve_xref(app.env, 'index', app.builder,
+                                 'type', 'Alias', role, role[0])
+    assert refnode['refid'] == 'alias_mod.Alias'
+
+
+def test_pytype_alias_without_canonical_in_class(app, monkeypatch):
+    text = (".. py:module:: alias_mod\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      .. py:attribute:: item\n")
+    domain = app.env.get_domain('py')
+    monkeypatch.setattr(app.config, 'add_module_names', False)
+    doctree = restructuredtext.parse(app, text)
+    alias = domain.objects['alias_mod.Container.Alias']
+    assert alias.objtype == 'type'
+    assert 'alias_mod.Container.item' in domain.objects
+    assert 'alias_mod.Container.Alias.item' not in domain.objects
+    assert domain.directives['type'].allow_nesting is False
+    index_entries = [entry for node in doctree.findall(addnodes.index)
+                     for entry in node['entries']]
+    assert ('single', 'Alias (type alias in Container)',
+            'alias_mod.Container.Alias', '', None) in index_entries
+
+
+def test_pytype_alias_index_with_module_names(app, monkeypatch):
+    text = (".. py:module:: alias_mod\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: NestedAlias\n")
+    monkeypatch.setattr(app.config, 'add_module_names', True)
+    doctree = restructuredtext.parse(app, text)
+    indexes = [node for node in doctree.findall(addnodes.index)
+               if any('type alias' in entry[1] or 'in module alias_mod' in entry[1]
+                      for entry in node['entries'])]
+    assert ('single', 'Alias (in module alias_mod)', 'alias_mod.Alias', '', None) in indexes[0]['entries']
+    assert ('single', 'NestedAlias (type alias in alias_mod.Container)',
+            'alias_mod.Container.NestedAlias', '', None) in indexes[-1]['entries']
+
