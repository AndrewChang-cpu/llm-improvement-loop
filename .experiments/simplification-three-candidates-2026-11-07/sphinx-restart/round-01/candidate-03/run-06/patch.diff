+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Target\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias = list[Target]'
+    assert signatures[1].astext() == 'class example.Container'
+    assert signatures[2].astext() == 'type Nested = Target'
+    annotation_xrefs = list(doctree.findall(pending_xref))
+    assert [node['reftarget'] for node in annotation_xrefs] == ['list', 'Target', 'Target']
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['list[Target]'].aliased
+    assert domain.objects['example.Container.Nested'].objtype == 'type'
+    index_entries = [entry for index in doctree.findall(addnodes.index)
+                     for entry in index['entries']]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in index_entries
+    assert ('single', 'Nested (type alias in example.Container)',
+            'example.Container.Nested', '', None) in index_entries
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' in domain.object_types['type'].roles
+    assert 'obj' in domain.object_types['type'].roles
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:module:: example\n"
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Nested\n",
+    )
+    index_entries = [entry for index in doctree.findall(addnodes.index)
+                     for entry in index['entries']]
+    assert ('single', 'Nested (type alias in Container)',
+            'example.Container.Nested', '', None) in index_entries
+
+    doctree = restructuredtext.parse(
+        app, '.. py:currentmodule:: None\n.. py:type:: Bare',
+    )
+    index_entries = [entry for index in doctree.findall(addnodes.index)
+                     for entry in index['entries']]
+    assert ('single', 'Bare', 'Bare', '', None) in index_entries
+
+
+def test_pytype_alias_without_canonical_and_nested_contents(app):
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Alias\n"
+        "\n"
+        "      Description.\n"
+        "\n"
+        "      .. py:data:: child\n",
+    )
+    objects = app.env.get_domain('py').objects
+    signatures = list(doctree.findall(desc_signature))
+    assert [signature.astext() for signature in signatures[:2]] == [
+        'class Container', 'type Alias',
+    ]
+    assert objects['Container.Alias'].objtype == 'type'
+    assert objects['Container.child'].objtype == 'data'
+    assert 'Container.Alias.child' not in objects
+
