@@ -67,6 +67,61 @@ def test_pydata_signature_old(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            "See :py:type:`Alias`.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            ".. py:type:: Bare\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias = list[str]'
+    assert signatures[1].astext() == 'class example.Container'
+    assert signatures[2].astext() == 'type Nested'
+    assert signatures[3].astext() == 'type example.Bare'
+    assert [node['reftarget'] for node in signatures[0].findall(pending_xref)] == ['list', 'str']
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['list[str]'].aliased is True
+    assert domain.objects['example.Bare'].objtype == 'type'
+    assert domain.objects['example.Container.Nested'].objtype == 'type'
+    indices = list(doctree.findall(addnodes.index))
+    index_text = [entry[1] for index in indices for entry in index['entries']]
+    assert 'Alias (in module example)' in index_text
+    assert 'Bare (in module example)' in index_text
+    assert 'Nested (type alias in example.Container)' in index_text
+
+    role_ref = list(doctree.findall(pending_xref))[-1]
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   role_ref, nodes.Text('Alias'))
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Alias'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+
+
+def test_pytype_alias_index_without_module_names(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, ".. py:class:: Container\n\n   .. py:type:: Nested\n")
+    indices = list(doctree.findall(addnodes.index))
+    index_text = [entry[1] for index in indices for entry in index['entries']]
+    assert 'Container (built-in class)' in index_text
+    assert 'Nested (type alias in Container)' in index_text
+
+    doctree = restructuredtext.parse(app, ".. py:type:: Plain\n")
+    assert list(doctree.findall(addnodes.index))[0]['entries'][0][1] == 'Plain'
+
+
