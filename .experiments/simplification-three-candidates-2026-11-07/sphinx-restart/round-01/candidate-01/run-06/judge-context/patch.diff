--- a/sphinx/domains/python/__init__.py
+++ b/sphinx/domains/python/__init__.py
@@ -169,6 +169,42 @@ class PyVariable(PyObject):
             return _('%s (built-in variable)') % name
 
 
+class PyTypeAlias(PyObject):
+    """Description of a type alias."""
+
+    option_spec: ClassVar[OptionSpec] = PyObject.option_spec.copy()
+
+    def get_signature_prefix(self, sig: str) -> list[nodes.Node]:
+        return [nodes.Text('type'), addnodes.desc_sig_space()]
+
+    def handle_signature(self, sig: str, signode: desc_signature) -> tuple[str, str]:
+        fullname, prefix = super().handle_signature(sig, signode)
+
+        canonical = self.options.get('canonical')
+        if canonical:
+            annotation = _parse_annotation(canonical, self.env)
+            signode += addnodes.desc_annotation(
+                canonical, '', addnodes.desc_sig_space(),
+                addnodes.desc_sig_punctuation('', '='),
+                addnodes.desc_sig_space(), *annotation,
+            )
+
+        return fullname, prefix
+
+    def get_index_text(self, modname: str, name_cls: tuple[str, str]) -> str:
+        name = name_cls[0]
+        try:
+            clsname, aliasname = name.rsplit('.', 1)
+        except ValueError:
+            if modname:
+                return _('%s (in module %s)') % (name, modname)
+            return name
+
+        if modname and self.env.config.add_module_names:
+            clsname = f'{modname}.{clsname}'
+        return _('%s (type alias in %s)') % (aliasname, clsname)
+
+
