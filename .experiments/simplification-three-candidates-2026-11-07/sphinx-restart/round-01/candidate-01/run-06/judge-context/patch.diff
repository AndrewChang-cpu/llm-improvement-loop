diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..d9de50d
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,106 @@
+"""Tests for Python type aliases."""
+
+from __future__ import annotations
+
+import pytest
+from sphinx import addnodes
+from sphinx.addnodes import desc, desc_annotation, desc_signature, pending_xref
+from sphinx.domains.python import PyTypeAlias
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_type_alias_signature_and_registration(app):
+    assert PyTypeAlias.allow_nesting is False
+    assert {'canonical', 'module', 'annotation'} <= PyTypeAlias.option_spec.keys()
+    assert 'type' not in PyTypeAlias.option_spec
+    assert 'value' not in PyTypeAlias.option_spec
+
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    alias = next(doctree.findall(desc))
+    signature = alias[0]
+    assert_node(signature, desc_signature,
+                fullname='Alias', module='example')
+    assert signature.astext() == 'type example.Alias = list[str]'
+    assert isinstance(signature[0], desc_annotation)
+    assert signature[0].astext() == 'type '
+    assert signature[2].astext() == 'Alias'
+    canonical = signature[3]
+    assert canonical[1].astext() == '='
+    assert list(canonical.findall(pending_xref))
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.objects['list[str]'] == ('index', 'example.Alias', 'type', True)
+
+
+def test_type_alias_without_canonical_and_class_context(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      Description.\n"
+            "\n"
+            "      .. py:data:: member\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert 'example.Container.Alias' in domain.objects
+    assert 'example.Container.Alias.member' not in domain.objects
+    assert 'example.Container.member' in domain.objects
+    declarations = list(doctree.findall(desc))
+    assert declarations[0][0].astext().endswith('example.Container')
+    assert declarations[1][0].astext() == 'type Alias'
+    assert declarations[1][1].astext() == 'Description.'
+
+
+@pytest.mark.parametrize(
+    ('add_module_names', 'expected'),
+    [(True, ['Alias (in module example)',
+             'Alias (type alias in example.Container)']),
+     (False, ['Alias (in module example)',
+              'Alias (type alias in Container)'])],
+)
+def test_type_alias_index_text(app, add_module_names, expected):
+    app.config.add_module_names = add_module_names
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:module:: example\n"
+        ".. py:type:: Alias\n"
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Alias\n",
+    )
+
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])
+               if entry[1].startswith('Alias')]
+    assert entries == expected
+
+
+@pytest.mark.sphinx('html', testroot='domain-py')
+def test_type_alias_role_resolves(app, status, warning):
+    source = app.srcdir / 'type_alias.rst'
+    index = app.srcdir / 'index.rst'
+    original_index = index.read_text(encoding='utf8')
+    source.write_text(
+        ".. py:module:: example\n\n"
+        ".. py:type:: Alias\n"
+        "   :canonical: str\n\n"
+        "A link to :py:type:`Alias`.\n",
+        encoding='utf8',
+    )
+    index.write_text(original_index + '    type_alias\n', encoding='utf8')
+    try:
+        app.build(force_all=True)
+
+        content = (app.outdir / 'type_alias.html').read_text(encoding='utf8')
+        assert 'href="#example.Alias"' in content
+        assert warning.getvalue() == ''
+    finally:
+        source.unlink()
+        index.write_text(original_index, encoding='utf8')
