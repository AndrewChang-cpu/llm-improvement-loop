+def test_pytype_role_resolves_declared_alias(app):
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:module:: example\n"
+        "\n"
+        ".. py:type:: Alias\n"
+        "\n"
+        "See :py:type:`Alias`.\n"
+        "\n"
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Nested\n"
+        "\n"
+        "   See :py:type:`Nested`.\n",
+    )
+    domain = app.env.get_domain('py')
+    xrefs = list(doctree.findall(pending_xref))
+    assert [xref['reftype'] for xref in xrefs] == ['type', 'type']
+    for xref, target in zip(xrefs, ('Alias', 'Nested')):
+        refnode = domain.resolve_xref(
+            app.env, 'index', app.builder, 'type', target, xref, nodes.Text(target)
+        )
+        assert refnode is not None
+        assert refnode['refid'] == domain.objects[
+            f'example.{"Container." if target == "Nested" else ""}{target}'
+        ].node_id
+
