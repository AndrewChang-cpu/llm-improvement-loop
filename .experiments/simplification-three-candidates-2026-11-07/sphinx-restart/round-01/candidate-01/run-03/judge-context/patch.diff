@@ -21,6 +22,127 @@ from sphinx.testing import restructuredtext
 from sphinx.testing.util import assert_node
 
 
+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    aliases = [node for node in doctree.findall(desc) if node.get('objtype') == 'type']
+    assert aliases[0][0].astext() == 'type example.Alias = list[Target]'
+    annotation_xrefs = list(aliases[0][0].findall(pending_xref))
+    assert [xref['reftarget'] for xref in annotation_xrefs] == ['list', 'Target']
+    assert all(xref['reftype'] == 'class' for xref in annotation_xrefs)
+    assert aliases[0][1].astext() == 'Alias description.'
+    assert aliases[1][0].astext() == 'type Nested'
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert not domain.objects['example.Alias'].aliased
+    assert domain.objects['list[Target]'].aliased
+    assert domain.objects['example.Container.Nested'].objtype == 'type'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+
+    alias_directive = domain.directives['type']
+    assert 'canonical' in alias_directive.option_spec
+    assert 'type' not in alias_directive.option_spec
+    assert 'value' not in alias_directive.option_spec
+
+
+def test_pytype_without_canonical_and_indexes(app):
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, ".. py:type:: Local\n")
+    index_texts = [entry[1] for index in doctree.findall(addnodes.index)
+                   for entry in index['entries']]
+    assert 'Local' in index_texts
+
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:module:: example\n"
+        "\n"
+        ".. py:type:: TopLevel\n"
+        "\n"
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Nested\n",
+    )
+    aliases = [node for node in doctree.findall(desc) if node.get('objtype') == 'type']
+    assert aliases[0][0].astext() == 'type TopLevel'
+    index_texts = [entry[1] for index in doctree.findall(addnodes.index)
+                   for entry in index['entries']]
+    assert 'TopLevel (in module example)' in index_texts
+    assert 'Nested (type alias in Container)' in index_texts
+
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:module:: example\n"
+        "\n"
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Nested\n",
+    )
+    index_texts = [entry[1] for index in doctree.findall(addnodes.index)
+                   for entry in index['entries']]
+    assert 'Nested (type alias in example.Container)' in index_texts
+
