+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: Target | Other\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias = Target | Other'
+    annotation = signatures[0][-1]
+    assert len(list(annotation.findall(pending_xref))) == 2
+    assert signatures[1].astext() == 'class example.Class'
+    assert signatures[2].astext() == 'type Nested'
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['Target | Other'].aliased is True
+    assert domain.objects['Target | Other'].objtype == 'type'
+    assert domain.objects['example.Class.Nested'].objtype == 'type'
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+    assert domain.directives['type'].allow_nesting is False
+
+
+def test_pytype_without_canonical_and_role_resolution(app):
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:type:: Alias\n\n"
+        ".. py:class:: Class\n\n   .. py:type:: Nested\n\n"
+        "See :py:type:`Alias` and :py:type:`Class.Nested`.\n")
+    domain = app.env.get_domain('py')
+    xrefs = list(doctree.findall(pending_xref))
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias'
+    assert [xref['reftype'] for xref in xrefs] == ['type', 'type']
+    for xref, target, refid in zip(xrefs, ('Alias', 'Class.Nested'),
+                                   ('example.Alias', 'example.Class.Nested')):
+        resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', target,
+                                       xref, xref[0])
+        assert isinstance(resolved, nodes.reference)
+        assert resolved['refid'] == refid
+
+
+@pytest.mark.parametrize(('add_module_names', 'module_index', 'nested_index'), [
+    (True, 'Alias (in module example)', 'Nested (type alias in example.Class)'),
+    (False, 'Alias (in module example)', 'Nested (type alias in Class)'),
+])
+def test_pytype_index_text(app, add_module_names, module_index, nested_index):
+    app.config.add_module_names = add_module_names
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert module_index in [entry[1] for entry in entries]
+    assert nested_index in [entry[1] for entry in entries]
+
+
+def test_pytype_index_text_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias\n")
+    entry = next(entry for index in doctree.findall(addnodes.index)
+                 for entry in index['entries'] if entry[1] == 'Alias')
+    assert entry[1] == 'Alias'
+
+
