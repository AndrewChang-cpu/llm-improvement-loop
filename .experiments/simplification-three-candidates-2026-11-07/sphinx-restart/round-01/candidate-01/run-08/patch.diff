+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n\n"
+            "   Alias description.\n\n"
+            ".. py:class:: Container\n\n"
+            "   .. py:type:: Nested\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias = list[Target]'
+    assert [xref['reftarget'] for xref in signatures[0].findall(pending_xref)] == [
+        'list', 'Target',
+    ]
+    assert signatures[1].astext() == 'class example.Container'
+    assert signatures[2].astext() == 'type Nested'
+    assert domain.objects['example.Alias'] == ('index', signatures[0]['ids'][0], 'type', False)
+    assert 'example.Container.Nested' in domain.objects
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.objects['list[Target]'].aliased
+    assert not domain.directives['type'].allow_nesting
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+
+
+def test_pytype_without_canonical_and_index_text(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n\n"
+            ".. py:class:: Container\n\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert [entry[1] for entry in entries if entry[1] != 'module; example'] == [
+        'Alias (in module example)',
+        'Container (class in example)',
+        'Nested (type alias in example.Container)',
+    ]
+    assert 'example.Alias' in app.env.get_domain('py').objects
+
+
+def test_pytype_index_text_without_module_names(app):
+    app.config.add_module_names = False
+    text = (".. py:type:: Alias\n\n"
+            ".. py:class:: Container\n\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert entries == ['Alias', 'Container (built-in class)',
+                       'Nested (type alias in Container)']
+
+
+def test_pytype_role_resolves(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n\n"
+            "See :py:type:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    reference = next(doctree.findall(pending_xref))
+    domain = app.env.get_domain('py')
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                   reference['reftarget'], reference,
+                                   reference[0])
+    assert isinstance(resolved, nodes.reference)
+    assert resolved['refid'] == list(doctree.findall(desc_signature))[0]['ids'][0]
+
+
