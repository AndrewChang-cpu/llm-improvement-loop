@@ -612,6 +612,21 @@ Cross-referencing Python objects
 The following roles refer to objects in modules and are possibly hyperlinked if
 a matching identifier is found:
 
+.. rst:directive:: .. py:type:: name
+
+   Describes a type alias. The optional ``canonical`` option describes the type
+   represented by the alias and is shown after the alias name in the signature.
+   Its expression is parsed as a Python annotation, so referenced types can be
+   cross-referenced. The directive may include an optional description body.
+   Type aliases can be documented at module level or inside a class; class
+   context qualifies the alias name, but the body cannot contain declarations
+   for nested Python objects.
+
+.. rst:role:: py:type
+
+   Reference a type alias. The role uses normal Python object lookup, so a
+   module-level or class-scoped alias can be referenced by its qualified name.
+
 .. rst:role:: py:mod
 
    Reference a module; a dotted name may be used.  This should also be used for
diff --git a/sphinx/domains/python/__init__.py b/sphinx/domains/python/__init__.py
index 75c2cdd..db8b50f 100644
--- a/sphinx/domains/python/__init__.py
+++ b/sphinx/domains/python/__init__.py
@@ -169,6 +169,41 @@ class PyVariable(PyObject):
             return _('%s (built-in variable)') % name
 
 
+class PyTypeAlias(PyObject):
+    """Description of a type alias."""
+
+    option_spec: ClassVar[OptionSpec] = PyObject.option_spec.copy()
+
+    def get_signature_prefix(self, sig: str) -> list[nodes.Node]:
+        return [nodes.Text('type'), addnodes.desc_sig_space()]
+
+    def handle_signature(self, sig: str, signode: desc_signature) -> tuple[str, str]:
+        fullname, prefix = super().handle_signature(sig, signode)
+
+        canonical = self.options.get('canonical')
+        if canonical:
+            signode += addnodes.desc_annotation(
+                canonical, '', addnodes.desc_sig_space(),
+                addnodes.desc_sig_punctuation('', '='), addnodes.desc_sig_space(),
+                *_parse_annotation(canonical, self.env),
+            )
+
+        return fullname, prefix
+
+    def get_index_text(self, modname: str, name_cls: tuple[str, str]) -> str:
+        name, _cls = name_cls
+        shortname = name.rsplit('.', 1)[-1]
+        if '.' not in name:
+            if modname:
+                return _('%s (in module %s)') % (shortname, modname)
+            return shortname
+
+        clsname = name.rsplit('.', 1)[0]
+        if modname and self.env.config.add_module_names:
+            clsname = f'{modname}.{clsname}'
+        return _('%s (type alias in %s)') % (shortname, clsname)
+
+
