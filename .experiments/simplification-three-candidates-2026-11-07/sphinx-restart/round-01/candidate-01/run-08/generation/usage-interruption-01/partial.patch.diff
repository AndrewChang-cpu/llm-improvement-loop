diff --git a/tests/test_domains/test_domain_py_pyobject.py b/tests/test_domains/test_domain_py_pyobject.py
index 04f9341..d09ef07 100644
--- a/tests/test_domains/test_domain_py_pyobject.py
+++ b/tests/test_domains/test_domain_py_pyobject.py
@@ -485,3 +485,107 @@ def test_pycurrentmodule(app):
     assert domain.objects['Other.B.m3'] == ('index', 'Other.B.m3', 'method', False)
     assert 'Other.B.m4' in domain.objects
     assert domain.objects['Other.B.m4'] == ('index', 'Other.B.m4', 'method', False)
+
+
+def test_pytype_alias_signature_and_annotation(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Item\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: Item\n"
+            "\n"
+            "      Description.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    alias = next(node for node in doctree.findall(desc) if node.get('objtype') == 'type')
+    signature = alias[0]
+    assert signature.astext() == 'type Alias = Item'
+    assert isinstance(next(signature.findall(pending_xref)), pending_xref)
+    assert domain.objects['example.Item.Alias'].objtype == 'type'
+    assert domain.objects['Item'].aliased is True
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+
+
+def test_pytype_alias_without_canonical_and_index(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            ".. py:class:: Item\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    aliases = [node for node in doctree.findall(desc) if node.get('objtype') == 'type']
+    assert aliases[0][0].astext() == 'type Alias'
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert 'Alias (in module example)' in [entry[1] for entry in entries]
+    assert 'Nested (type alias in Item)' in [entry[1] for entry in entries]
+
+
+def test_pytype_alias_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert 'Alias' in [entry[1] for entry in entries]
+
+
+def test_pytype_alias_index_includes_module_when_enabled(app):
+    app.config.add_module_names = True
+    text = (".. py:module:: example\n"
+            ".. py:class:: Item\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    alias = next(node for node in doctree.findall(desc) if node.get('objtype') == 'type')
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert 'Nested (type alias in example.Item)' in [entry[1] for entry in entries]
+
+
+def test_pytype_role_resolves_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            "See :py:type:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    xref = next(doctree.findall(pending_xref))
+    assert xref['reftype'] == 'type'
+    ref = app.env.get_domain('py').resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', xref, nodes.Text('Alias'),
+    )
+    assert isinstance(ref, nodes.reference)
+    assert ref['refid'] == 'example.Alias'
+
+
+def test_pytype_role_resolves_nested_alias(app):
+    text = (".. py:class:: Item\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "   See :py:type:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    xref = next(doctree.findall(pending_xref))
+    assert xref['py:class'] == 'Item'
+    ref = app.env.get_domain('py').resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', xref, nodes.Text('Alias'),
+    )
+    assert isinstance(ref, nodes.reference)
+    assert ref['refid'] == 'Item.Alias'
+
+
+def test_pytype_alias_class_scope_does_not_become_a_container(app):
+    text = (".. py:class:: Item\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: int\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:data:: nested\n")
+    restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    assert 'Item.Alias' in domain.objects
+    assert 'Item.Alias.nested' not in domain.objects
+    assert 'Item.nested' in domain.objects
