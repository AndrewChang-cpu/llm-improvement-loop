 from __future__ import annotations
 
+import pytest
 from docutils import nodes
 
 from sphinx import addnodes
@@ -54,6 +55,102 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_alias_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: str | int\n"
+            "\n"
+            "   A description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Alias\n"
+            "\n"
+            ".. py:type:: Plain\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert 'type' in domain.directives
+    assert 'type' in domain.roles
+    aliases = [node for node in doctree.findall(addnodes.desc)
+               if node['objtype'] == 'type']
+    assert len(aliases) == 3
+    assert aliases[0][0].astext() == 'type example.Alias = str | int'
+    assert aliases[1][0].astext() == 'type Nested = Alias'
+    assert aliases[2][0].astext() == 'type example.Plain'
+    assert aliases[0][0]['fullname'] == 'Alias'
+    assert aliases[1][0]['fullname'] == 'Container.Nested'
+    assert aliases[0][0]['ids']
+    assert 'example.Alias' in domain.objects
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['str | int'].aliased is True
+    assert 'example.Container.Nested' in domain.objects
+    assert domain.objects['example.Container.Nested'].objtype == 'type'
+    assert 'example.Plain' in domain.objects
+
+    annotations = list(aliases[0].findall(pending_xref))
+    assert [node['reftarget'] for node in annotations] == ['str', 'int']
+
+
+@pytest.mark.parametrize(('module_names', 'module', 'expected'), [
+    (False, True, ['Alias (in module example)', 'Nested (type alias in Container)']),
+    (True, True, ['Alias (in module example)',
+                  'Nested (type alias in example.Container)']),
+    (True, False, ['Alias', 'Nested (type alias in Container)']),
+])
+def test_pytype_alias_index_text(app, module_names, module, expected):
+    app.config.add_module_names = module_names
+    text = (('.. py:module:: example\n' if module else '') +
+            ".. py:type:: Alias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry[1] for node in doctree.findall(addnodes.index)
+               for entry in node['entries']
+               if entry[1].startswith(('Alias ', 'Alias', 'Nested '))]
+    assert entries == expected, doctree.pformat()
+
+
+def test_pytype_role_resolves_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            "Reference :py:type:`Alias` and :py:type:`Container.Nested`.\n")
+    doctree = restructuredtext.parse(app, text)
+    xrefs = [node for node in doctree.findall(pending_xref)
+             if node['reftype'] == 'type']
+    domain = app.env.get_domain('py')
+    targets = ['Alias', 'Container.Nested']
+    for xref, target in zip(xrefs, targets):
+        refnode = domain.resolve_xref(app.env, 'index', app.builder, 'type', target,
+                                      xref, xref[0])
+        assert isinstance(refnode, nodes.reference)
+        assert refnode['refid'] == 'example.' + target
+
+
+def test_pytype_alias_does_not_allow_nested_objects(app):
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      Description.\n"
+            "\n"
+            "   .. py:type:: Child\n")
+    doctree = restructuredtext.parse(app, text)
+    aliases = [node for node in doctree.findall(addnodes.desc)
+               if node['objtype'] == 'type']
+    alias = aliases[0]
+    assert alias[1].astext().strip() == 'Description.'
+    assert aliases[1][0]['fullname'] == 'Container.Child'
+
+
