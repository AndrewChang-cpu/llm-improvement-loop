--- a/doc/usage/domains/python.rst
+++ b/doc/usage/domains/python.rst
@@ -153,6 +153,33 @@ The following directives are provided for module and class contents:
       Describe the location where the object is defined.  The default value is
       the module specified by :rst:dir:`py:currentmodule`.
 
+.. rst:directive:: .. py:type:: name
+
+   Describes a type alias.  The optional ``canonical`` option specifies the
+   type represented by the alias and is shown in the signature after ``=``.
+   The directive may also contain a description body.  For example::
+
+      .. py:type:: UserId
+         :canonical: int
+
+         Identifier assigned to a user.
+
+   Type aliases can be linked with the :rst:role:`py:type` role.  The role
+   resolves aliases documented at module level or in a class.
+
+   .. rubric:: options
+
+   .. rst:directive:option:: canonical
+      :type: type expression
+
+      Describe the type represented by the alias.  This option is optional;
+      when provided, the expression is parsed as an annotation and displayed
+      in the signature.
+
+.. rst:role:: py:type
+
+   Reference a type alias documented with :rst:dir:`py:type`.
+
 .. rst:directive:: .. py:exception:: name
                    .. py:exception:: name(parameters)
                    .. py:exception:: name[type parameters](parameters)
diff --git a/sphinx/domains/python/__init__.py b/sphinx/domains/python/__init__.py
index 75c2cdd..7da4de9 100644
--- a/sphinx/domains/python/__init__.py
+++ b/sphinx/domains/python/__init__.py
@@ -169,6 +169,36 @@ class PyVariable(PyObject):
             return _('%s (built-in variable)') % name
 
 
+class PyTypeAlias(PyObject):
+    """Description of a type alias."""
+
+    def get_signature_prefix(self, sig: str) -> list[nodes.Node]:
+        return [nodes.Text('type'), addnodes.desc_sig_space()]
+
+    def handle_signature(self, sig: str, signode: desc_signature) -> tuple[str, str]:
+        fullname, prefix = super().handle_signature(sig, signode)
+        canonical = self.options.get('canonical')
+        if canonical:
+            signode += addnodes.desc_annotation(
+                canonical, '', addnodes.desc_sig_space(),
+                addnodes.desc_sig_punctuation('', '='), addnodes.desc_sig_space(),
+                *_parse_annotation(canonical, self.env),
+            )
+        return fullname, prefix
+
+    def get_index_text(self, modname: str, name_cls: tuple[str, str]) -> str:
+        fullname, _prefix = name_cls
+        name = fullname.rsplit('.', 1)[-1]
+        cls = fullname.rpartition('.')[0]
+        if cls:
+            if modname and self.env.config.add_module_names:
+                return _('%s (type alias in %s.%s)') % (name, modname, cls)
+            return _('%s (type alias in %s)') % (name, cls)
+        if modname:
+            return _('%s (in module %s)') % (name, modname)
+        return name
+
+
