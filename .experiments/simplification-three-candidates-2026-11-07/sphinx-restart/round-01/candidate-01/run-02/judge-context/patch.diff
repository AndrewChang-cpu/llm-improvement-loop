+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: int | str\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Alias\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    alias = doctree[3]
+    assert alias['objtype'] == 'type'
+    assert alias[0].astext() == 'type example.Alias = int | str'
+    assert any(isinstance(node, pending_xref) and node['reftarget'] == 'int'
+               for node in alias[0].findall(pending_xref))
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.objects['int | str'] == ('index', 'example.Alias', 'type', True)
+    assert domain.objects['example.Container.Nested'] == (
+        'index', 'example.Container.Nested', 'type', False)
+    assert any(entry[1] == 'Alias (in module example)'
+               for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', []))
+    assert any(entry[1] == 'Nested (type alias in example.Container)'
+               for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', []))
+
+
+def test_pytype_alias_without_canonical_and_role_resolves(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            "See :py:type:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    alias = doctree[3]
+    assert alias[0].astext() == 'type example.Alias'
+    xref = next(doctree[4].findall(pending_xref))
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   xref, xref[0])
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Alias'
+
+
+def test_pytype_alias_index_without_module_names(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert 'Alias (in module example)' in entries
+    assert 'Nested (type alias in Container)' in entries
+
+
