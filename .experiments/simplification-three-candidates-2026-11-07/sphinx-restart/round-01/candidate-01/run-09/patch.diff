+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: Target\n"
+            "\n"
+            "   An alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Alias\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    alias = doctree[3]
+    assert alias['objtype'] == 'type'
+    assert alias[0].astext() == 'type example.Alias = Target'
+    assert isinstance(alias[0][-1][-1], pending_xref)
+    assert alias[1].astext() == 'An alias description.'
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['Target'].aliased
+    assert domain.objects['example.Container.Nested'].objtype == 'type'
+
+
+def test_pytype_alias_no_canonical(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias')
+    assert doctree[1][0].astext() == 'type Alias'
+
+
+def test_pytype_alias_index_text(app):
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n\n.. py:type:: Alias\n\n'
+             '.. py:class:: Container\n\n   .. py:type:: Nested\n')
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Alias (in module example)' in entries
+    assert 'Nested (type alias in example.Container)' in entries
+
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, '.. py:module:: example\n\n.. py:type:: Alias\n\n'
+             '.. py:class:: Container\n\n   .. py:type:: Nested\n')
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Alias' in entries
+    assert 'Nested (type alias in Container)' in entries
+
+
+def test_pytype_alias_role_resolves(app):
+    text = (".. py:type:: Alias\n"
+            "\n"
+            "See :py:type:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    ref = next(doctree.findall(pending_xref))
+    resolved = app.env.get_domain('py').resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', ref, nodes.Text('Alias'))
+    assert isinstance(resolved, nodes.reference)
+    assert resolved['refid'] == 'Alias'
+
+
+def test_pytype_alias_rejects_nested_objects(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:class:: Container\n\n   .. py:type:: Alias\n\n      .. py:data:: nested\n')
+    assert 'nested' not in app.env.get_domain('py').objects
+
+
