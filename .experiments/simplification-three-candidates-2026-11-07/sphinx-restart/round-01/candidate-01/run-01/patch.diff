+def test_pytype_signature_and_registration(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Description.\n"
+            "\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.domains['py']
+    aliases = [desc for desc in doctree.findall(desc) if desc['objtype'] == 'type']
+    assert [alias[0].astext() for alias in aliases] == [
+        'type example.Alias = list[Target]', 'type Nested']
+    assert [node.astext() for node in aliases[0].findall(pending_xref)] == ['list', 'Target']
+    assert domain.objects['example.Alias'][2] == 'type'
+    assert domain.objects['example.Class.Nested'][2] == 'type'
+    assert aliases[0][0]['ids'] and aliases[1][0]['ids']
+    role = restructuredtext.parse(app, ':py:type:`Alias`')
+    role_ref = next(role.findall(pending_xref))
+    assert_node(role_ref, reftype='type', reftarget='Alias')
+    role_ref['py:module'] = 'example'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   role_ref, nodes.Text('Alias'))
+    assert resolved['refid'] == domain.objects['example.Alias'].node_id
+    role_ref['py:class'] = 'Class'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Nested',
+                                   role_ref, nodes.Text('Nested'))
+    assert resolved['refid'] == domain.objects['example.Class.Nested'].node_id
+
+
+def test_pytype_index_text(app):
+    app.env.ref_context['py:module'] = 'example'
+    alias = restructuredtext.parse(app, '.. py:type:: Alias')
+    assert alias[0]['entries'][0][1] == 'Alias (in module example)'
+
+    app.config.add_module_names = False
+    alias = restructuredtext.parse(app, '.. py:module:: example\n\n.. py:type:: Alias')
+    texts = [entry[1] for index in alias.findall(addnodes.index)
+             for entry in index['entries']]
+    assert 'Alias' in texts
+    nested = restructuredtext.parse(
+        app, '.. py:module:: example\n\n.. py:class:: Class\n\n   .. py:type:: Alias')
+    texts = [entry[1] for index in nested.findall(addnodes.index)
+             for entry in index['entries']]
+    assert 'Alias (type alias in Class)' in texts
+
+    app.config.add_module_names = True
+    nested = restructuredtext.parse(
+        app, '.. py:module:: example\n\n.. py:class:: Class\n\n   .. py:type:: Alias')
+    texts = [entry[1] for index in nested.findall(addnodes.index)
+             for entry in index['entries']]
+    assert 'Alias (type alias in example.Class)' in texts
+
+
