@@ -54,6 +54,92 @@ def test_pydata_signature(app):
                 domain="py", objtype="data", no_index=False)
 
 
+def test_pytype_alias_signature_and_role_resolution(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: list[Target]\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:data:: child\n"
+            "\n"
+            "   :py:type:`Alias`\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    alias = next(node for node in doctree.findall(addnodes.desc)
+                 if node['objtype'] == 'type')
+    assert_node(alias, addnodes.desc, desctype='type', domain='py', objtype='type')
+    signode = alias[0]
+    assert signode['fullname'] == 'Container.Alias'
+    assert signode.astext() == 'type Alias = list[Target]'
+    assert signode[0].astext().strip() == 'type'
+    assert [node['reftarget'] for node in signode.findall(pending_xref)] == [
+        'list', 'Target',
+    ]
+    assert domain.objects['example.Container.Alias'].objtype == 'type'
+    assert domain.objects['list[Target]'].aliased
+    assert domain.object_types['type'].label == 'type alias'
+    assert 'canonical' in domain.directives['type'].option_spec
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+    assert 'example.Container.child' in domain.objects
+    assert 'example.Container.Alias.child' not in domain.objects
+    alias_index = next(node for node in doctree.findall(addnodes.index)
+                       if node.get('entries', [('', '', '', '', '')])[0][2]
+                       == 'example.Container.Alias')
+    assert alias_index['entries'] == [
+        ('single', 'Alias (type alias in example.Container)',
+         'example.Container.Alias', '', None),
+    ]
+
+    role_node = next(node for node in doctree.findall(pending_xref)
+                     if node['reftype'] == 'type')
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                   role_node['reftarget'], role_node,
+                                   nodes.Text('Alias'))
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Container.Alias'
+
+
+def test_pytype_alias_without_canonical_and_module_index(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "\n"
+            "   Alias description.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    signode = next(doctree.findall(desc_signature))
+    assert signode.astext() == 'type example.Alias'
+    assert domain.objects['example.Alias'].objtype == 'type'
+    alias_index = next(node for node in doctree.findall(addnodes.index)
+                       if node.get('entries', [('', '', '', '', '')])[0][2]
+                       == 'example.Alias')
+    assert alias_index['entries'] == [
+        ('single', 'Alias (in module example)', 'example.Alias', '', None),
+    ]
+
+
+def test_pytype_alias_nested_index_respects_module_names(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app,
+        ".. py:module:: example\n"
+        ".. py:class:: Container\n"
+        "\n"
+        "   .. py:type:: Alias\n")
+    alias_index = next(node for node in doctree.findall(addnodes.index)
+                       if node.get('entries', [('', '', '', '', '')])[0][2]
+                       == 'example.Container.Alias')
+    assert alias_index['entries'] == [
+        ('single', 'Alias (type alias in Container)',
+         'example.Container.Alias', '', None),
+    ]
+
