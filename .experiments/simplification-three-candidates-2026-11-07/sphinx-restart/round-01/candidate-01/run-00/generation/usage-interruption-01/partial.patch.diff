+def test_pytype(app):
+    text = (".. py:module:: example\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[str]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            "      Nested description.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    alias = next(node for node in doctree.findall(addnodes.desc)
+                 if node.get('objtype') == 'type')
+    assert_node(alias, addnodes.desc, desctype="type", domain="py", objtype="type")
+    signode = alias[0]
+    assert signode['fullname'] == 'Alias'
+    assert signode.astext() == 'type example.Alias = list[str]'
+    assert next(signode.findall(pending_xref))['reftarget'] == 'str'
+    assert alias[1].astext() == 'Alias description.'
+    assert domain.objects['example.Alias'][2:] == ('type', False)
+    assert domain.objects['list[str]'][2:] == ('type', True)
+    assert domain.object_types['type'].roles == {'type', 'obj'}
+    assert doctree.findall(addnodes.index)[1]['entries'] == [
+        ('single', 'Alias (in module example)', 'example.Alias', '', None)]
+    nested = [node for node in doctree.findall(addnodes.desc)
+              if node.get('objtype') == 'type'][1]
+    assert nested[0]['fullname'] == 'Container.Nested'
+    assert domain.objects['example.Container.Nested'][2:] == ('type', False)
+    assert domain.directives['type'].allow_nesting is False
+
+
+def test_pytype_without_canonical_and_index_text(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:type:: Alias")
+    assert next(doctree.findall(addnodes.desc)).astext().strip() == 'type Alias'
+    assert list(doctree.findall(addnodes.index))[1]['entries'] == [
+        ('single', 'Alias (in module example)', 'example.Alias', '', None)]
+
+    app.env.ref_context.pop('py:module', None)
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    assert list(doctree.findall(addnodes.index))[0]['entries'] == [
+        ('single', 'Alias', 'Alias', '', None)]
+
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:class:: Container\n\n   .. py:type:: Alias")
+    assert list(doctree.findall(addnodes.index))[-1]['entries'] == [
+        ('single', 'Alias (type alias in Container)',
+         'example.Container.Alias', '', None)]
+
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n\n.. py:class:: Container\n\n   .. py:type:: Alias")
+    assert list(doctree.findall(addnodes.index))[-1]['entries'] == [
+        ('single', 'Alias (type alias in example.Container)',
+         'example.Container.Alias', '', None)]
+
+
+def test_pytype_role_resolves(app):
+    text = (".. py:module:: example\n\n"
+            ".. py:type:: Alias\n\n"
+            "Reference :py:type:`Alias`.\n\n"
+            ".. py:class:: Container\n\n"
+            "   .. py:type:: Nested\n\n"
+            "   Reference :py:type:`Nested`.\n")
+    doctree = restructuredtext.parse(app, text)
+    xrefs = list(doctree.findall(pending_xref))
+    assert len(xrefs) == 2
+    domain = app.env.get_domain('py')
+    resolved = [domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                    xref['reftarget'], xref, xref[0])
+                for xref in xrefs]
+    assert all(isinstance(node, nodes.reference) for node in resolved)
+    assert resolved[0]['refid'] == 'example.Alias'
+    assert resolved[1]['refid'] == 'example.Container.Nested'
+
+
