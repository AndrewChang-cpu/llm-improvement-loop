diff --git a/doc/usage/domains/python.rst b/doc/usage/domains/python.rst
index 96982f1..c9bd90c 100644
--- a/doc/usage/domains/python.rst
+++ b/doc/usage/domains/python.rst
@@ -147,6 +147,30 @@ The following directives are provided for module and class contents:
 
       .. versionadded:: 4.0
 
+
+.. rst:directive:: .. py:type:: name
+
+   Describes a type alias. The directive may be used at module level or within
+   a class. An optional description may be placed in the directive body.
+   The directive does not establish a nested object context.
+
+   The optional ``canonical`` option describes the type represented by the
+   alias and is displayed in the signature after ``=``. Types in the
+   expression are parsed as annotations and can be cross-referenced::
+
+      .. py:type:: UserId
+         :canonical: int
+
+         Identifier for a user.
+
+   The directive supports the shared Python object options, including
+   ``canonical``.
+
+.. rst:role:: py:type
+
+   Reference a type alias declared with :rst:dir:`py:type`. A dotted name may
+   be used.
+
    .. rst::directive:option:: module
       :type: text
 
diff --git a/sphinx/domains/python/__init__.py b/sphinx/domains/python/__init__.py
index 75c2cdd..377df51 100644
--- a/sphinx/domains/python/__init__.py
+++ b/sphinx/domains/python/__init__.py
@@ -169,6 +169,35 @@ class PyVariable(PyObject):
             return _('%s (built-in variable)') % name
 
 
+class PyTypeAlias(PyObject):
+    """Description of a type alias."""
+
+    def get_signature_prefix(self, sig: str) -> list[nodes.Node]:
+        return [nodes.Text('type'), addnodes.desc_sig_space()]
+
+    def handle_signature(self, sig: str, signode: desc_signature) -> tuple[str, str]:
+        fullname, prefix = super().handle_signature(sig, signode)
+        canonical = self.options.get('canonical')
+        if canonical:
+            signode += addnodes.desc_annotation(
+                canonical, '', addnodes.desc_sig_space(),
+                addnodes.desc_sig_operator('', '='), addnodes.desc_sig_space(),
+                *_parse_annotation(canonical, self.env),
+            )
+        return fullname, prefix
+
+    def get_index_text(self, modname: str, name_cls: tuple[str, str]) -> str:
+        name, _prefix = name_cls
+        classname = self.env.ref_context.get('py:class')
+        if classname:
+            if modname and self.env.config.add_module_names:
+                classname = f'{modname}.{classname}'
+            return _('%s (type alias in %s)') % (name.rsplit('.', 1)[-1], classname)
+        if modname:
+            return _('%s (in module %s)') % (name, modname)
+        return name
+
+
