+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            ".. py:class:: Target\n"
+            "\n"
+            "Use :py:type:`Alias` and :py:type:`Container.Nested`.\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    assert 'example.Alias' in domain.objects
+    assert 'list[Target]' in domain.objects
+    assert 'example.Container.Nested' in domain.objects
+    signatures = list(doctree.findall(desc_signature))
+    assert signatures[0].astext() == 'type example.Alias = list[Target]'
+    assert signatures[1].astext() == 'class example.Container'
+    assert signatures[2].astext() == 'type Nested'
+    assert signatures[0].findall(pending_xref)
+    refs = list(doctree.findall(pending_xref))
+    assert [ref['reftype'] for ref in refs[-2:]] == ['type', 'type']
+    for ref in refs[-2:]:
+        resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                       ref['reftarget'], ref, ref[0])
+        assert isinstance(resolved, nodes.reference)
+        assert resolved['refid'].startswith('example.')
+    index_texts = [entry[1] for index in doctree.findall(addnodes.index)
+                   for entry in index.get('entries', [])]
+    assert 'Alias (in module example)' in index_texts
+    assert 'Nested (type alias in example.Container)' in index_texts
+
+
+def test_pytype_alias_without_canonical(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias')
+    assert doctree[1][0].astext() == 'type Alias'
+    assert doctree[0]['entries'][0][1] == 'Alias'
+
+
+def test_pytype_alias_index_without_module_names(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(
+        app, ".. py:module:: example\n"
+        ".. py:class:: Container\n\n"
+        "   .. py:type:: Nested\n")
+    index_texts = [entry[1] for index in doctree.findall(addnodes.index)
+                   for entry in index.get('entries', [])]
+    assert 'Nested (type alias in Container)' in index_texts
+
+
