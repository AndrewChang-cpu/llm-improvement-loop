+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            ".. py:type:: Plain\n"
+            "\n"
+            "See :py:type:`Alias`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    assert 'example.Alias' in domain.objects
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objects['list[Target]'].aliased
+    assert 'example.Class.Nested' in domain.objects
+    assert 'example.Plain' in domain.objects
+    descriptions = list(doctree.findall(addnodes.desc))
+    alias = descriptions[0]
+    assert alias[0].astext() == 'type example.Alias = list[Target]'
+    annotation_xrefs = list(alias.findall(pending_xref))
+    assert any(node.get('reftarget') == 'Target' for node in annotation_xrefs)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert any(entry[0] == 'single' and entry[1] == 'Alias (in module example)'
+               for entry in entries)
+    assert any(entry[1] == 'Nested (type alias in example.Class)' for entry in entries)
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+
+
+def test_pytype_alias_role_resolution(app):
+    source = app.srcdir / 'type_alias.txt'
+    source.write_text(".. py:module:: example\n\n"
+                      ".. py:type:: Alias\n\n"
+                      "See :py:type:`Alias`.\n", encoding='utf8')
+    app.config.root_doc = 'type_alias'
+    app.build(force_all=True)
+    content = (app.outdir / 'type_alias.html').read_text(encoding='utf8')
+    assert 'href="#example.Alias"' in content
+    assert 'py py-type' in content
+
+
+def test_pytype_alias_without_module_name_in_index(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert any(entry[1] == 'Nested (type alias in Class)' for entry in entries)
+
+
