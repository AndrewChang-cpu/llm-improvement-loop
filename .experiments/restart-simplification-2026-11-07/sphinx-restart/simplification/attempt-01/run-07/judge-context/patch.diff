diff --git a/tests/test_domains/test_domain_py_type.py b/tests/test_domains/test_domain_py_type.py
new file mode 100644
index 0000000..01fd070
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type.py
@@ -0,0 +1,68 @@
+"""Tests for Python type aliases."""
+
+from __future__ import annotations
+
+import pytest
+from docutils import nodes
+
+from sphinx import addnodes
+from sphinx.testing import restructuredtext
+
+
+def test_type_alias_signature_and_canonical(app):
+    doctree = restructuredtext.parse(
+        app, '.. py:class:: Target\n\n'
+        '.. py:type:: Alias\n   :canonical: Target\n')
+    signature = next(doctree.findall(addnodes.desc_signature))
+    assert signature.astext() == 'class Target'
+    signature = list(doctree.findall(addnodes.desc_signature))[1]
+    assert signature.astext() == 'type Alias = Target'
+    assert any(isinstance(node, addnodes.pending_xref)
+               for node in signature.findall(addnodes.pending_xref))
+    assert signature[0].astext() == 'type '
+
+
+def test_type_alias_registration_body_and_role(app):
+    text = ('.. py:currentmodule:: example\n\n'
+            '.. py:type:: Alias\n   :canonical: int\n\n'
+            '   Alias description.\n\n'
+            'Use :py:type:`Alias`.')
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    entry = domain.objects['example.Alias']
+    assert entry.objtype == 'type'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert doctree.findall(addnodes.desc_content)
+    xref = next(node for node in doctree.findall(addnodes.pending_xref)
+                if node.get('reftype') == 'type')
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   xref, nodes.Text('Alias'))
+    assert isinstance(resolved, nodes.reference)
+    assert resolved['refid'] == entry.node_id
+    assert domain.objects['int'].aliased
+
+
+@pytest.mark.parametrize(('module', 'add_module_names', 'nested', 'expected'), [
+    ('example', True, True, 'Alias (type alias in example.Class)'),
+    ('example', False, True, 'Alias (type alias in Class)'),
+    ('', True, True, 'Alias (type alias in Class)'),
+    ('example', True, False, 'Alias (in module example)'),
+    ('', True, False, 'Alias'),
+])
+def test_type_alias_index(app, module, add_module_names, nested, expected):
+    app.config.add_module_names = add_module_names
+    module_directive = f'.. py:currentmodule:: {module}\n\n' if module else ''
+    if nested:
+        text = module_directive + '.. py:class:: Class\n\n   .. py:type:: Alias\n'
+    else:
+        text = module_directive + '.. py:type:: Alias\n'
+    doctree = restructuredtext.parse(app, text)
+    indexes = doctree.findall(addnodes.index)
+    entries = [entry[1] for index in indexes for entry in index['entries']]
+    assert expected in entries, entries
+
+
+def test_type_alias_is_not_nestable(app, warning):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias\n\n   .. py:data:: nested\n')
+    domain = app.env.get_domain('py')
+    assert 'Alias.nested' not in domain.objects
