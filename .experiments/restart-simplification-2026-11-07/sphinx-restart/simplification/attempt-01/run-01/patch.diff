+def test_pytype_alias_signature_and_role(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "      :canonical: list[int]\n"
+            "\n"
+            "      Alias description with :py:type:`Alias`.\n"
+            "\n"
+            ".. py:type:: BareAlias\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+
+    signatures = list(doctree.findall(desc_signature))
+    alias_signature = next(node for node in signatures
+                           if node['fullname'] == 'Container.Alias')
+    assert alias_signature['fullname'] == 'Container.Alias'
+    assert alias_signature.astext() == 'type Alias = list[int]'
+    assert [node.astext() for node in alias_signature.findall(pending_xref)] == ['list', 'int']
+    assert domain.objects['example.Container.Alias'].objtype == 'type'
+    assert domain.objects['list[int]'].aliased is True
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'type' in domain.roles
+    assert 'canonical' in domain.directives['type'].option_spec
+    assert 'type' not in domain.directives['type'].option_spec
+    assert 'value' not in domain.directives['type'].option_spec
+
+    role = next(node for node in doctree.findall(pending_xref)
+                if node['reftype'] == 'type' and node['reftarget'] == 'Alias')
+    assert role['py:module'] == 'example'
+    assert role['py:class'] == 'Container'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   role, nodes.Text('Alias'))
+    assert resolved['refid'] == domain.objects['example.Container.Alias'].node_id
+
+    bare_signature = next(node for node in signatures
+                          if node['fullname'] == 'BareAlias')
+    assert bare_signature.astext() == 'type example.BareAlias'
+    assert domain.objects['example.BareAlias'].objtype == 'type'
+    assert app.env.ref_context.get('py:class') is None
+
+
+def test_pytype_alias_index_text(app):
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(app, """\
+.. py:module:: example
+.. py:type:: Top
+.. py:class:: Container
+
+   .. py:type:: Nested
+""")
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Top (in module example)' in entries
+    assert 'Nested (type alias in Container)' in entries
+
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(app, """\
+.. py:module:: example
+.. py:class:: Container
+
+   .. py:type:: Nested
+""")
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Nested (type alias in example.Container)' in entries
+
+    doctree = restructuredtext.parse(app, """\
+.. py:currentmodule:: None
+.. py:type:: Standalone
+""")
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Standalone' in entries
+
+
+def test_pytype_alias_does_not_contain_nested_objects(app):
+    restructuredtext.parse(app, """\
+.. py:type:: Alias
+
+   .. py:data:: nested
+""")
+    domain = app.env.get_domain('py')
+    assert 'Alias.nested' not in domain.objects
+    assert 'nested' in domain.objects
+
+
