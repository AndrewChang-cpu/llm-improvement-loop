+@pytest.mark.sphinx('html', testroot='domain-py-typealias')
+def test_domain_py_type_aliases(app, status, warning):
+    app.build(force_all=True)
+
+    domain = app.env.domains['py']
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.objects['example.Scalar'].objtype == 'type'
+    assert domain.objects['example.Container.Item'].objtype == 'type'
+    assert domain.objects['example.Container.Bare'].objtype == 'type'
+    assert domain.objects['example.Container.NestedFromBody'].objtype == 'class'
+    assert 'example.Container.Item.NestedFromBody' not in domain.objects
+    assert domain.objects['list[Target]'].aliased
+    assert 'type' not in PyTypeAlias.option_spec
+    assert 'value' not in PyTypeAlias.option_spec
+
+    doctree = app.env.get_doctree('index')
+    signatures = [node.astext() for node in doctree.findall(addnodes.desc_signature)]
+    assert 'type example.Scalar = int' in signatures
+    assert 'type example.OptionalScalar = list[Target]' in signatures
+    assert 'type Item = Scalar' in signatures
+
+    content = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert re.search(r'href="#example\.Scalar"', content)
+    assert re.search(r'href="#example\.OptionalScalar"', content)
+    assert re.search(r'href="#example\.Container\.Item"', content)
+    assert re.search(r'href="#example\.Target"', content)
+    assert 'xref py py-type' in content
+
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Scalar (in module example)' in entries
+    assert 'OptionalScalar (in module example)' in entries
+    assert 'Item (type alias in example.Container)' in entries
+    assert 'Bare (type alias in example.Container)' in entries
+
+    directive = Mock(env=Mock(config=Mock(add_module_names=False)))
+    assert PyTypeAlias.get_index_text(directive, 'example', ('Container.Item', '')) == (
+        'Item (type alias in Container)'
+    )
+    assert PyTypeAlias.get_index_text(directive, '', ('Bare', '')) == 'Bare'
+
+
