+def test_pytype_alias_signature_and_role(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: list[Target]\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "\n"
+            "      .. py:data:: child\n"
+            "\n"
+            "See :py:type:`Alias`.")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['example.Container.Nested'].objtype == 'type'
+    assert domain.objects['example.Container.child'].objtype == 'data'
+    alias_sig = list(doctree.findall(desc))[0][0]
+    assert alias_sig.astext() == 'type example.Alias = list[Target]'
+    assert list(alias_sig.findall(pending_xref))
+    xref = list(doctree.findall(pending_xref))[-1]
+    assert isinstance(xref, pending_xref)
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type', 'Alias',
+                                   xref, nodes.Text('Alias'))
+    assert resolved['refid'] == 'example.Alias'
+
+
+def test_pytype_alias_without_canonical_and_index(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested")
+    doctree = restructuredtext.parse(app, text)
+    assert list(doctree.findall(desc))[0][0].astext() == 'type example.Alias'
+    entries = [entry[1] for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert 'Alias (in module example)' in entries
+    assert 'Nested (type alias in example.Container)' in entries
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry[1] for node in doctree.findall(addnodes.index)
+               for entry in node['entries']]
+    assert 'Nested (type alias in Container)' in entries
+
+
