+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: typing.Sequence[int]\n"
+            "\n"
+            "   An alias description.\n"
+            "\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Child\n"
+            "\n"
+            "      .. py:function:: method()\n"
+            "\n"
+            ".. py:type:: Bare\n"
+            "\n"
+            "   :py:type:`Alias`\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    descriptions = list(doctree.findall(addnodes.desc))
+    assert descriptions[0]['objtype'] == 'type'
+    assert descriptions[0][0].astext() == 'type example.Alias = Sequence[int]'
+    assert any(isinstance(node, pending_xref) for node in descriptions[0][0].findall())
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objects['example.Alias'] == ('index', 'example.Alias', 'type', False)
+    assert domain.objects['typing.Sequence[int]'] == (
+        'index', 'example.Alias', 'type', True)
+    assert domain.objects['example.Container.Child'] == (
+        'index', 'example.Container.Child', 'type', False)
+    assert 'example.Container.method' in domain.objects
+    assert 'example.Container.Child.method' not in domain.objects
+    reference = next(ref for ref in doctree.findall(pending_xref)
+                     if ref['reftype'] == 'type')
+    assert reference['reftype'] == 'type'
+    assert reference['reftarget'] == 'Alias'
+    resolved = domain.resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', reference, nodes.Text('Alias'))
+    assert resolved is not None
+    assert resolved['refid'] == 'example.Alias'
+
+
+def test_pytype_alias_index_text_and_body(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Child\n")
+    doctree = restructuredtext.parse(app, text)
+    entry = next(entry for index in doctree.findall(addnodes.index)
+                 for entry in index['entries'] if 'type alias in' in entry[1])
+    assert entry[1] == 'Child (type alias in example.Container)'
+
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(app, text)
+    entry = next(entry for index in doctree.findall(addnodes.index)
+                 for entry in index['entries'] if 'type alias in' in entry[1])
+    assert entry[1] == 'Child (type alias in Container)'
+
+    doctree = restructuredtext.parse(app, ".. py:module:: example\n.. py:type:: Alias")
+    entry = next(entry for index in doctree.findall(addnodes.index)
+                 for entry in index['entries'] if entry[1].startswith('Alias'))
+    assert entry[1] == 'Alias (in module example)'
+
+def test_pytype_alias_without_module_index(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    entry = next(entry for index in doctree.findall(addnodes.index)
+                 for entry in index['entries'] if entry[1].startswith('Alias'))
+    assert entry[1] == 'Alias'
+
+
+def test_pytype_alias_without_canonical(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias")
+    assert next(doctree.findall(addnodes.desc))[0].astext() == 'type Alias'
+
