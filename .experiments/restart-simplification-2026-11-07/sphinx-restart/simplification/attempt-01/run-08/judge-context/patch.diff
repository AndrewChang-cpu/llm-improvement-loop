+def test_pytype_signature_and_registration(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: OtherAlias\n"
+            "\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: OtherAlias\n"
+            "\n"
+            "   Alias description.\n"
+            "\n"
+            ".. py:type:: Untyped\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    descriptions = list(doctree.findall(desc))
+    alias = descriptions[1]
+    assert alias['objtype'] == 'type'
+    assert alias[0].astext() == 'type Alias = OtherAlias'
+    annotation_xrefs = list(alias[0].findall(pending_xref))
+    assert len(annotation_xrefs) == 1
+    assert annotation_xrefs[0]['reftarget'] == 'OtherAlias'
+    assert domain.objects['example.Alias'][2:] == ('type', False)
+    assert domain.objects['OtherAlias'][2:] == ('type', True)
+    assert alias[1].astext().strip() == 'Alias description.'
+    assert descriptions[2][0].astext() == 'type Untyped'
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+
+
+def test_pytype_index_text(app):
+    app.config.add_module_names = True
+    text = (".. py:module:: example\n"
+            ".. py:type:: ModuleAlias\n"
+            "\n"
+            ".. py:class:: Class\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = list(doctree.findall(addnodes.index))
+    assert entries[1]['entries'] == [
+        ('single', 'ModuleAlias (in module example)', 'example.ModuleAlias', '', None),
+    ]
+    assert entries[3]['entries'] == [
+        ('single', 'Nested (type alias in example.Class)',
+         'example.Class.Nested', '', None),
+    ]
+    domain = app.env.get_domain('py')
+    assert domain.objects['example.Class.Nested'][2] == 'type'
+
+    app.config.add_module_names = False
+    doctree = restructuredtext.parse(app, text)
+    entries = list(doctree.findall(addnodes.index))
+    assert entries[3]['entries'] == [
+        ('single', 'Nested (type alias in Class)', 'example.Class.Nested', '', None),
+    ]
+
+    app.env.ref_context['py:module'] = None
+    app.env.ref_context['py:class'] = None
+    doctree = restructuredtext.parse(app, ".. py:type:: Standalone\n")
+    entries = list(doctree.findall(addnodes.index))
+    assert entries[-1]['entries'] == [('single', 'Standalone', 'Standalone', '', None)]
+
+
+def test_pytype_role_resolves_alias(app):
+    text = (".. py:type:: Alias\n"
+            "\n"
+            "Reference :py:type:`Alias`.\n")
+    doctree = restructuredtext.parse(app, text)
+    refnode = next(doctree.findall(pending_xref))
+    assert refnode['reftype'] == 'type'
+    resolved = app.env.get_domain('py').resolve_xref(
+        app.env, 'index', app.builder, 'type', 'Alias', refnode, nodes.literal('', 'Alias'))
+    assert resolved.get('refid') == 'Alias'
+
+
+def test_pytype_does_not_create_nested_namespace(app):
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      Alias description.\n"
+            "\n"
+            "      .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    domain = app.env.get_domain('py')
+    assert 'Container.Alias' in domain.objects
+    assert 'Container.Nested' in domain.objects
+    assert 'Container.Alias.Nested' not in domain.objects
