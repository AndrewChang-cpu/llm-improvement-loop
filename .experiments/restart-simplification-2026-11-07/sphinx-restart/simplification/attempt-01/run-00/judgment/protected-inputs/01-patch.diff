+Type aliases
+============
+
+.. py:module:: example
+
+.. py:class:: Target
+
+.. py:type:: Alias
+   :canonical: Target
+
+   A documented alias.
+
+See :py:type:`Alias`.
+
+.. py:type:: Unspecified
diff --git a/tests/test_domains/test_domain_py_type_alias.py b/tests/test_domains/test_domain_py_type_alias.py
new file mode 100644
index 0000000..f86eb31
--- /dev/null
+++ b/tests/test_domains/test_domain_py_type_alias.py
@@ -0,0 +1,97 @@
+from __future__ import annotations
+
+import pytest
+
+from sphinx import addnodes
+from sphinx.addnodes import (
+    desc_addname,
+    desc_annotation,
+    desc_name,
+    desc_signature,
+    pending_xref,
+)
+from sphinx.domains.python import PyTypeAlias
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_type_alias_signature_and_registration(app):
+    assert PyTypeAlias.allow_nesting is False
+    assert 'canonical' in PyTypeAlias.option_spec
+    assert 'type' not in PyTypeAlias.option_spec
+    assert 'value' not in PyTypeAlias.option_spec
+
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: Target\n")
+    doctree = restructuredtext.parse(app, text)
+
+    signature = next(doctree.findall(desc_signature))
+    assert_node(signature, desc_signature)
+    assert [type(node) for node in signature] == [
+        desc_annotation, desc_addname, desc_name, desc_annotation,
+    ]
+    assert signature.astext() == 'type example.Alias = Target'
+    assert list(signature.findall(pending_xref))
+    domain = app.env.get_domain('py')
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.objects['example.Alias'].objtype == 'type'
+    assert domain.objects['Target'].aliased is True
+
+
+def test_type_alias_without_canonical_and_index_forms(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:type:: TopLevel\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n")
+    doctree = restructuredtext.parse(app, text)
+    assert [node.astext() for node in doctree.findall(desc_signature)][:3] == [
+        'type TopLevel', 'class Container', 'type Nested',
+    ]
+    index_entries = [entry for node in doctree.findall(addnodes.index)
+                     for entry in node['entries']]
+    assert ('single', 'TopLevel (in module example)',
+            'example.TopLevel', '', None) in index_entries
+    assert ('single', 'Nested (type alias in Container)',
+            'example.Container.Nested', '', None) in index_entries
+    app.config.add_module_names = True
+    doctree = restructuredtext.parse(app, text)
+    index_entries = [entry for node in doctree.findall(addnodes.index)
+                     for entry in node['entries']]
+    assert ('single', 'Nested (type alias in example.Container)',
+            'example.Container.Nested', '', None) in index_entries
+
+    app.env.ref_context.pop('py:module', None)
+    app.env.ref_context.pop('py:class', None)
+    doctree = restructuredtext.parse(
+        app, ".. py:class:: Builtin\n\n   .. py:type:: Standalone\n")
+    index_entries = [entry for node in doctree.findall(addnodes.index)
+                     for entry in node['entries']]
+    assert ('single', 'Standalone (type alias in Builtin)',
+            'Builtin.Standalone', '', None) in index_entries
+
+
+def test_type_alias_does_not_containerize_nested_objects(app):
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      .. py:function:: nested\n")
+    restructuredtext.parse(app, text)
+    objects = app.env.get_domain('py').objects
+    assert 'Container.Alias' in objects
+    assert 'Container.nested' in objects
+    assert 'Container.Alias.nested' not in objects
+
+
+@pytest.mark.sphinx('html', testroot='domain-py', freshenv=True)
+def test_type_role_resolves_to_alias_target(app, status, warning):
+    app.build(force_all=True)
+    html = (app.outdir / 'type_alias.html').read_text(encoding='utf8')
+
+    assert 'href="#example.Alias"' in html
+    assert 'href="#example.Target"' in html
+    assert 'See <a class="reference internal" href="#example.Alias"' in html
+    assert warning.getvalue() == ''
