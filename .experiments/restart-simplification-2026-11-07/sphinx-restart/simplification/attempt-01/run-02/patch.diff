+Type aliases
+============
+
+.. py:module:: example
+
+.. py:class:: Target
+
+.. py:type:: Alias
+   :canonical: list[Target]
+
+   Refer to :py:type:`Alias`.
diff --git a/tests/test_domains/test_domain_py_typealias.py b/tests/test_domains/test_domain_py_typealias.py
new file mode 100644
index 0000000..ae7dd5c
--- /dev/null
+++ b/tests/test_domains/test_domain_py_typealias.py
@@ -0,0 +1,92 @@
+from __future__ import annotations
+
+import pytest
+
+from sphinx import addnodes
+from sphinx.addnodes import desc_annotation, desc_name, desc_sig_punctuation, desc_sig_space
+from sphinx.testing import restructuredtext
+from sphinx.testing.util import assert_node
+
+
+def test_pytype_signature_and_registration(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:class:: Target\n"
+            ".. py:type:: Alias\n"
+            "   :canonical: Target | str\n"
+            "\n"
+            "   An alias description.\n"
+            "\n"
+            ".. py:type:: BareAlias")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+    alias = next(node for node in doctree.findall(addnodes.desc)
+                 if node.get('objtype') == 'type' and 'Alias' in node[0].astext())
+
+    assert_node(alias[0][0], desc_annotation)
+    assert_node(alias[0][0], ('type', desc_sig_space))
+    assert_node(alias[0][1], desc_name, 'Alias')
+    assert_node(alias[0][2], desc_annotation)
+    assert [type(node) for node in alias[0][2]] == [
+        desc_sig_space, desc_sig_punctuation, desc_sig_space, addnodes.pending_xref,
+        desc_sig_space, desc_sig_punctuation, desc_sig_space, addnodes.pending_xref,
+    ]
+    assert alias[0][2][1].astext() == '='
+    assert alias[1].astext() == 'An alias description.'
+    assert domain.objects['example.Alias'][2:] == ('type', False)
+    assert domain.objects['Target | str'][2:] == ('type', True)
+    assert domain.objects['example.Target'][2:] == ('class', False)
+    assert domain.object_types['type'].lname == 'type alias'
+    assert domain.object_types['type'].roles == ('type', 'obj')
+    assert 'example.BareAlias' in domain.objects
+    assert domain.objects['example.BareAlias'][2] == 'type'
+
+
+@pytest.mark.parametrize(('add_module_names', 'expected'), [
+    (True, 'Nested (type alias in example.Container)'),
+    (False, 'Nested (type alias in Container)'),
+])
+def test_pytype_index_text(app, add_module_names, expected):
+    app.config.add_module_names = add_module_names
+    text = (".. py:module:: example\n"
+            ".. py:type:: Alias\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested")
+    doctree = restructuredtext.parse(app, text)
+
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert ('single', 'Alias (in module example)', 'example.Alias', '', None) in entries
+    assert ('single', expected, 'example.Container.Nested', '', None) in entries
+
+
+def test_pytype_index_without_module(app):
+    doctree = restructuredtext.parse(app, '.. py:type:: Alias')
+    entries = [entry for index in doctree.findall(addnodes.index)
+               for entry in index.get('entries', [])]
+    assert ('single', 'Alias', 'Alias', '', None) in entries
+
+
+def test_pytype_class_scope_does_not_containerize_contents(app):
+    text = (".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n"
+            "\n"
+            "      .. py:type:: Inner")
+    domain = app.env.get_domain('py')
+    restructuredtext.parse(app, text)
+
+    assert 'Container.Alias' in domain.objects
+    assert 'Container.Inner' in domain.objects
+    assert 'Container.Alias.Inner' not in domain.objects
+
+
+@pytest.mark.sphinx('html', testroot='domain-py-typealias')
+def test_pytype_role_resolves_alias(app, status, warning):
+    app.build(force_all=True)
+    content = (app.outdir / 'index.html').read_text(encoding='utf8')
+    assert 'href="#example.Alias"' in content
+    assert 'href="#example.Target"' in content
+    assert warning.getvalue() == ''
+
