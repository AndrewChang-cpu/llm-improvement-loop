+def test_pytype_alias(app):
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Nested\n"
+            "      :canonical: Target\n"
+            "\n"
+            "      A description.\n"
+            "\n"
+            "      .. py:method:: nested_method\n"
+            "\n"
+            "   .. py:method:: after_alias\n"
+            "\n"
+            ".. py:type:: TopLevel\n"
+            "\n"
+            ".. py:type:: Canonical\n"
+            "   :canonical: example.Target\n"
+            "\n"
+            "Reference: :py:type:`TopLevel`.\n")
+    domain = app.env.get_domain('py')
+    doctree = restructuredtext.parse(app, text)
+
+    signatures = list(doctree.findall(addnodes.desc_signature))
+    nested_sig = signatures[1]
+    assert nested_sig.astext() == 'type Nested = Target'
+    assert isinstance(nested_sig[-1], addnodes.desc_annotation)
+    assert list(nested_sig[-1].findall(pending_xref))
+    assert 'example.Container.Nested' in domain.objects
+    assert domain.objects['example.Container.Nested'][2:] == ('type', False)
+    assert 'example.Container.nested_method' in domain.objects
+    assert 'example.Container.Nested.nested_method' not in domain.objects
+    assert 'example.Container.after_alias' in domain.objects
+
+    assert signatures[4].astext() == 'type example.TopLevel'
+    assert signatures[5].astext() == 'type example.Canonical = example.Target'
+    assert domain.objects['example.TopLevel'][2:] == ('type', False)
+    assert domain.objects['example.Target'][2:] == ('type', True)
+    assert domain.object_types['type'].lname == 'type alias'
+    assert 'canonical' in PyTypeAlias.option_spec
+    assert 'type' not in PyTypeAlias.option_spec
+    assert 'value' not in PyTypeAlias.option_spec
+
+    index_text = [entry[1] for index in doctree.findall(addnodes.index)
+                  for entry in index['entries']]
+    assert 'Nested (type alias in example.Container)' in index_text
+    assert 'TopLevel (in module example)' in index_text
+    assert 'Canonical (in module example)' in index_text
+
+    ref = next(ref for ref in doctree.findall(pending_xref)
+               if ref.get('reftype') == 'type')
+    assert ref['reftype'] == 'type'
+    resolved = domain.resolve_xref(app.env, 'index', app.builder, 'type',
+                                   'TopLevel', ref, nodes.Text('TopLevel'))
+    assert_node(resolved, nodes.reference, refid='example.TopLevel')
+
+
+def test_pytype_alias_index_without_module_names(app):
+    app.config.add_module_names = False
+    text = (".. py:module:: example\n"
+            ".. py:class:: Container\n"
+            "\n"
+            "   .. py:type:: Alias\n")
+    doctree = restructuredtext.parse(app, text)
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Alias (type alias in Container)' in entries
+
+
+def test_pytype_alias_index_without_module(app):
+    doctree = restructuredtext.parse(app, ".. py:type:: Alias\n")
+    entries = [entry[1] for index in doctree.findall(addnodes.index)
+               for entry in index['entries']]
+    assert 'Alias' in entries
+
