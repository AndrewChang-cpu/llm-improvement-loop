+class JSONHighlighter(RegexHighlighter):
+    """Highlights JSON text."""
+
+    base_style = "json."
+    highlights = [
+        _combine_regex(
+            r"(?P<brace>[\{\}\[\]\(\)])",
+            r"(?P<bool_true>\btrue\b)",
+            r"(?P<bool_false>\bfalse\b)",
+            r"(?P<null>\bnull\b)",
+            r"(?<!\w)(?P<number>0x[0-9a-fA-F]+|-?\d+(?:\.\d+)?(?:e[+-]?\d+)?)",
+            r'(?<![\\\w])(?P<str>b?"(?:[^"\\]|\\.)*")',
+        ),
+    ]
+
