diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..3e895f7
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,53 @@
+from json import dumps, loads
+from typing import Any
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (int, optional): Number of spaces to indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of output. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        serialized = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        text = highlighter(serialized)
+        text.no_wrap = True
+        text.overflow = None
+        self.text = text
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="PATH",
+        help="path to a json file",
+    )
+    args = parser.parse_args()
+
+    try:
+        with open(args.path, "rt", encoding="utf-8") as json_file:
+            json_text = json_file.read()
+    except Exception as error:
+        error_console = Console(stderr=True)
+        error_console.print(f"Unable to read {args.path!r}; {error}", markup=False)
+        sys.exit(-1)
+
+    console = Console()
+    console.print(JSON(json_text), soft_wrap=True)
diff --git a/tests/test_print_json.py b/tests/test_print_json.py
new file mode 100644
index 0000000..1e54a2d
--- /dev/null
+++ b/tests/test_print_json.py
@@ -0,0 +1,28 @@
+import io
+
+import rich
+from rich.console import Console
+
+SAMPLE = '[false, true, null, "foo"]'
+
+
+def test_console_print_json():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.print_json(SAMPLE)
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        "    \x1b[32m\"foo\"\x1b[0m\n"
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert console.file.getvalue() == expected
+
+
+def test_package_print_json(monkeypatch):
+    console = Console(file=io.StringIO())
+    monkeypatch.setattr(rich, "get_console", lambda: console)
+    rich.print_json(SAMPLE)
+    expected = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+    assert console.file.getvalue() == expected
