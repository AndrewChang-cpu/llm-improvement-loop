diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..3647af6
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,51 @@
+from json import dumps, loads
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON text to format.
+        indent (int, optional): Number of spaces to indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        serialized = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        self.text = highlighter(serialized)
+        self.text.no_wrap = True
+        self.text.overflow = None
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="PATH",
+        help="path to file",
+    )
+    args = parser.parse_args()
+
+    console = Console()
+    error_console = Console(stderr=True)
+    try:
+        with open(args.path, "rt") as json_file:
+            json_text = json_file.read()
+    except OSError as error:
+        error_console.print("Unable to read", repr(args.path), str(error), markup=False)
+        sys.exit(-1)
+
+    console.print(JSON(json_text), soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..1129b05
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,80 @@
+import io
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+EXPECTED_STYLED = (
+    "\x1b[1m[\x1b[0m\n"
+    "    \x1b[3;91mfalse\x1b[0m,\n"
+    "    \x1b[3;92mtrue\x1b[0m,\n"
+    "    \x1b[3;35mnull\x1b[0m,\n"
+    "    \x1b[32m\"foo\"\x1b[0m\n"
+    "\x1b[1m]\x1b[0m\n"
+)
+
+EXPECTED_PLAIN = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_print_json_styled():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.print_json(SAMPLE)
+    assert console.file.getvalue() == EXPECTED_STYLED
+
+
+def test_print_json_indent_two():
+    console = Console(file=io.StringIO(), color_system=None)
+    console.print_json('{"a": [1]}', indent=2)
+    assert console.file.getvalue() == '{\n  "a": [\n    1\n  ]\n}\n'
+
+
+def test_print_json_no_highlight():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == EXPECTED_PLAIN
+
+
+def test_print_json_invalid_prints_nothing():
+    console = Console(file=io.StringIO(), color_system=None)
+    with pytest.raises(ValueError):
+        console.print_json("{not json")
+    assert console.file.getvalue() == ""
+
+
+def test_print_json_long_line_not_wrapped():
+    console = Console(file=io.StringIO(), color_system=None, width=20)
+    console.print_json('"' + "x" * 40 + '"', highlight=False)
+    assert console.file.getvalue() == '"' + "x" * 19 + "\n"
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4)
+    assert renderable.text.plain == EXPECTED_PLAIN.rstrip("\n")
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+    assert renderable.__rich__() is renderable.text
+
+
+def test_json_string_contents_not_styled_separately():
+    renderable = JSON('["a{1}true"]')
+    assert renderable.text.plain == '[\n    "a{1}true"\n]'
+    spans = {(span.start, span.end, span.style) for span in renderable.text.spans}
+    string_start = renderable.text.plain.index('"')
+    string_end = renderable.text.plain.rindex('"') + 1
+    assert (string_start, string_end, "json.str") in spans
+    assert not any(
+        style != "json.str" and string_start < start < string_end
+        for start, _end, style in spans
+    )
+
+
+def test_package_print_json(monkeypatch):
+    output = io.StringIO()
+    console = Console(file=output, color_system=None)
+    monkeypatch.setattr(rich, "_console", console)
+    rich.print_json(SAMPLE)
+    assert output.getvalue() == EXPECTED_PLAIN
