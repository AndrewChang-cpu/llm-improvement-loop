+++ b/tests/test_json.py
@@ -0,0 +1,96 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+from rich.text import Span
+
+SAMPLE = '[false, true, null, "foo"]'
+SAMPLE_PLAIN = '[\n    false,\n    true,\n    null,\n    "foo"\n]'
+
+
+def test_print_json_console_plain():
+    output = io.StringIO()
+    console = Console(file=output, width=80, color_system=None)
+    console.print_json(SAMPLE)
+    assert output.getvalue() == SAMPLE_PLAIN + "\n"
+
+
+def test_print_json_indent_two():
+    output = io.StringIO()
+    console = Console(file=output, width=80, color_system=None)
+    console.print_json(SAMPLE, indent=2)
+    assert output.getvalue() == '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+
+
+def test_print_json_highlight_off_plain():
+    output = io.StringIO()
+    console = Console(file=output, width=80, color_system="truecolor")
+    console.print_json(SAMPLE, highlight=False)
+    assert output.getvalue() == SAMPLE_PLAIN + "\n"
+
+
+def test_print_json_invalid_prints_nothing():
+    output = io.StringIO()
+    console = Console(file=output, width=80, color_system=None)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2")
+    assert output.getvalue() == ""
+
+
+def test_json_renderable_spans():
+    text = JSON(SAMPLE).text
+    assert text.plain == SAMPLE_PLAIN
+    assert Span(0, 1, "json.brace") in text.spans
+    assert Span(6, 11, "json.bool_false") in text.spans
+    assert Span(17, 21, "json.bool_true") in text.spans
+    assert Span(27, 31, "json.null") in text.spans
+    assert Span(37, 42, "json.str") in text.spans
+    assert Span(43, 44, "json.brace") in text.spans
+
+
+def test_json_renderable_no_highlight():
+    text = JSON(SAMPLE, highlight=False).text
+    assert text.plain == SAMPLE_PLAIN
+    assert text.spans == []
+
+
+def test_json_renderable_string_contents_not_styled():
+    text = JSON('["[1] true"]').text
+    assert text.plain == '[\n    "[1] true"\n]'
+    assert sorted(text.spans, key=lambda span: span.start) == [
+        Span(0, 1, "json.brace"),
+        Span(6, 16, "json.str"),
+        Span(17, 18, "json.brace"),
+    ]
+
+
+def test_json_renderable_positional_indent():
+    text = JSON(SAMPLE, 4).text
+    assert text.plain == SAMPLE_PLAIN
+
+
+def test_json_renderable_no_wrap():
+    text = JSON(SAMPLE).text
+    assert text.no_wrap is True
+    assert text.overflow is None
+
+
+def test_json_renderable_invalid_raises():
+    with pytest.raises(json.JSONDecodeError):
+        JSON("{")
+
+
+def test_package_print_json():
+    console = rich.get_console()
+    output = io.StringIO()
+    backup_file = console.file
+    try:
+        console.file = output
+        rich.print_json(SAMPLE, highlight=False)
+        assert output.getvalue() == SAMPLE_PLAIN + "\n"
+    finally:
+        console.file = backup_file
