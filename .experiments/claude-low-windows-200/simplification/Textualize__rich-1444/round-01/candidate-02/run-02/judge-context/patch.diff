diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..65933b0
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,51 @@
+import json as jsonlib
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (int, optional): Number of spaces to indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of JSON. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = jsonlib.loads(json)
+        serialized = jsonlib.dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        self.text = highlighter(serialized)
+        self.text.no_wrap = True
+        self.text.overflow = None
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from rich.console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="PATH",
+        help="path to a JSON file",
+    )
+    args = parser.parse_args()
+
+    console = Console()
+    try:
+        with open(args.path, "rt") as json_file:
+            json_data = json_file.read()
+    except OSError as error:
+        error_console = Console(stderr=True)
+        error_console.print("Unable to read", repr(args.path), str(error), markup=False)
+        sys.exit(-1)
+
+    console.print(JSON(json_data), soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..ecd6f6f
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,116 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+from rich.text import Text
+
+SAMPLE = '[false, true, null, "foo"]'
+
+SAMPLE_PLAIN = '[\n    false,\n    true,\n    null,\n    "foo"\n]'
+
+
+def _make_console(**kwargs) -> Console:
+    return Console(file=io.StringIO(), width=80, **kwargs)
+
+
+def test_print_json_styled_output():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+    )
+    console.print_json(SAMPLE)
+    expected = Text.assemble(
+        ("[", "json.brace"),
+        "\n    ",
+        ("false", "json.bool_false"),
+        ",\n    ",
+        ("true", "json.bool_true"),
+        ",\n    ",
+        ("null", "json.null"),
+        ",\n    ",
+        ('"foo"', "json.str"),
+        "\n",
+        ("]", "json.brace"),
+    )
+    expected_console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+    )
+    expected_console.print(expected)
+    assert console.file.getvalue() == expected_console.file.getvalue()
+
+
+def test_print_json_plain_output():
+    console = _make_console(color_system=None)
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == SAMPLE_PLAIN + "\n"
+
+
+def test_print_json_indent_two():
+    console = _make_console(color_system=None)
+    console.print_json(SAMPLE, indent=2, highlight=False)
+    assert console.file.getvalue() == (
+        '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+    )
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4)
+    assert renderable.text.plain == SAMPLE_PLAIN
+
+
+def test_json_renderable_protocol_returns_text():
+    renderable = JSON(SAMPLE)
+    assert renderable.__rich__() is renderable.text
+
+
+def test_json_renderable_no_wrap_and_overflow():
+    renderable = JSON(SAMPLE)
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+
+
+def test_json_highlight_false_has_no_spans():
+    renderable = JSON(SAMPLE, highlight=False)
+    assert renderable.text.spans == []
+
+
+def test_json_literals_styled_inside_string_not_styled():
+    renderable = JSON('{"a": "true 1"}')
+    styles = {(span.start, span.end, span.style) for span in renderable.text.spans}
+    plain = renderable.text.plain
+    string_start = plain.index('"true 1"')
+    string_end = string_start + len('"true 1"')
+    assert (string_start, string_end, "json.str") in styles
+    for span in renderable.text.spans:
+        if string_start < span.start < string_end:
+            pytest.fail("token styled inside string")
+
+
+def test_print_json_invalid_json_prints_nothing():
+    console = _make_console(color_system=None)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2,")
+    assert console.file.getvalue() == ""
+
+
+def test_package_print_json(monkeypatch):
+    console = _make_console(color_system=None)
+    monkeypatch.setattr(rich, "get_console", lambda: console)
+    rich.print_json(SAMPLE)
+    assert console.file.getvalue() == SAMPLE_PLAIN + "\n"
+
+
+def test_long_json_soft_wrap_keeps_line_whole():
+    long_value = '"' + "a" * 100 + '"'
+    console = Console(file=io.StringIO(), width=20, color_system=None)
+    console.print(JSON(long_value), soft_wrap=True)
+    assert console.file.getvalue() == long_value + "\n"
