--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,104 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.color import ColorSystem
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+PLAIN_SAMPLE = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def _styled(console: Console, name: str, text: str) -> str:
+    return console.get_style(name).render(text, color_system=ColorSystem.TRUECOLOR)
+
+
+def test_print_json_styled_output():
+    console = Console(
+        file=io.StringIO(),
+        width=80,
+        color_system="truecolor",
+        force_terminal=True,
+    )
+    console.print_json(SAMPLE)
+    expected = (
+        _styled(console, "json.brace", "[")
+        + "\n    "
+        + _styled(console, "json.bool_false", "false")
+        + ",\n    "
+        + _styled(console, "json.bool_true", "true")
+        + ",\n    "
+        + _styled(console, "json.null", "null")
+        + ",\n    "
+        + _styled(console, "json.str", '"foo"')
+        + "\n"
+        + _styled(console, "json.brace", "]")
+        + "\n"
+    )
+    assert console.file.getvalue() == expected
+
+
+def test_print_json_plain_with_indent_two():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.print_json(SAMPLE, indent=2)
+    assert console.file.getvalue() == '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+
+
+def test_print_json_highlight_disabled():
+    console = Console(
+        file=io.StringIO(),
+        width=80,
+        color_system="truecolor",
+        force_terminal=True,
+    )
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == PLAIN_SAMPLE
+
+
+def test_print_json_invalid_json_prints_nothing():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2,")
+    assert console.file.getvalue() == ""
+
+
+def test_print_json_long_line_not_wrapped():
+    long_value = "x" * 40
+    console = Console(file=io.StringIO(), width=20, color_system=None)
+    console.print_json(json.dumps([long_value]))
+    lines = console.file.getvalue().splitlines()
+    assert len(lines) == 3
+    assert lines[0] == "["
+    assert lines[2] == "]"
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4)
+    assert renderable.text.plain == PLAIN_SAMPLE[:-1]
+
+
+def test_json_renderable_protocol_returns_text():
+    renderable = JSON(SAMPLE)
+    assert renderable.__rich__() is renderable.text
+
+
+def test_package_print_json(monkeypatch):
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    monkeypatch.setattr(rich, "get_console", lambda: console)
+    rich.print_json(SAMPLE)
+    assert console.file.getvalue() == PLAIN_SAMPLE
+
+
+def test_package_print_json_matches_console_method(monkeypatch):
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.print_json(SAMPLE, indent=2)
+    expected = console.file.getvalue()
+
+    global_console = Console(file=io.StringIO(), width=80, color_system=None)
+    monkeypatch.setattr(rich, "get_console", lambda: global_console)
+    rich.print_json(SAMPLE, indent=2)
+    assert global_console.file.getvalue() == expected
