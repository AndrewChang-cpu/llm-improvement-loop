@@ -0,0 +1,71 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+EXPECTED_PLAIN = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+EXPECTED_STYLED = (
+    "\x1b[1m[\x1b[0m\n"
+    "    \x1b[3;91mfalse\x1b[0m,\n"
+    "    \x1b[3;92mtrue\x1b[0m,\n"
+    "    \x1b[3;35mnull\x1b[0m,\n"
+    '    \x1b[32m"foo"\x1b[0m\n'
+    "\x1b[1m]\x1b[0m\n"
+)
+
+
+def test_console_print_json_styled():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+    )
+    console.print_json(SAMPLE)
+    assert console.file.getvalue() == EXPECTED_STYLED
+
+
+def test_console_print_json_indent_two():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.print_json(SAMPLE, indent=2)
+    assert console.file.getvalue() == '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+
+
+def test_console_print_json_highlight_disabled():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+    )
+    console.print_json(SAMPLE, highlight=False)
+    output = console.file.getvalue()
+    assert "\x1b" not in output
+    assert output == EXPECTED_PLAIN
+
+
+def test_console_print_json_invalid_prints_nothing():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2")
+    assert console.file.getvalue() == ""
+
+
+def test_package_print_json(monkeypatch):
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    monkeypatch.setattr(rich, "_console", console)
+    rich.print_json(SAMPLE)
+    assert console.file.getvalue() == EXPECTED_PLAIN
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4, True)
+    assert renderable.text.plain == EXPECTED_PLAIN.rstrip("\n")
+    assert renderable.__rich__() is renderable.text
