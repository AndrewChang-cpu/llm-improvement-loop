diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..3751a93
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,53 @@
+from json import dumps, loads
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (int, optional): Number of spaces to indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of JSON. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        serialized = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        text = highlighter(serialized)
+        text.no_wrap = True
+        text.overflow = None
+        self.text = text
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="PATH",
+        help="path to json file",
+    )
+    args = parser.parse_args()
+
+    console = Console()
+    error_console = Console(stderr=True)
+    try:
+        with open(args.path, "rt") as json_file:
+            json_data = json_file.read()
+    except OSError as error:
+        error_console.print(f"Unable to read {args.path!r}; {error}")
+        sys.exit(-1)
+
+    json_renderable = JSON(json_data)
+    console.print(json_renderable, soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..e471fc8
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,85 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+
+def test_print_json_styled_output():
+    output = io.StringIO()
+    console = Console(
+        file=output,
+        force_terminal=True,
+        color_system="truecolor",
+        _environ={},
+    )
+    console.print_json(SAMPLE)
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert output.getvalue() == expected
+
+
+def test_print_json_indent():
+    output = io.StringIO()
+    console = Console(file=output, width=80)
+    console.print_json(SAMPLE, indent=2, highlight=False)
+    assert output.getvalue() == (
+        "[\n"
+        "  false,\n"
+        "  true,\n"
+        "  null,\n"
+        '  "foo"\n'
+        "]\n"
+    )
+
+
+def test_print_json_invalid_prints_nothing():
+    output = io.StringIO()
+    console = Console(file=output, width=80)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[false, ")
+    assert output.getvalue() == ""
+
+
+def test_print_json_long_line_is_not_wrapped():
+    output = io.StringIO()
+    console = Console(file=output, width=20)
+    console.print_json(json.dumps(["a" * 40]), highlight=False)
+    assert len(output.getvalue().splitlines()) == 3
+
+
+def test_json_renderable_is_no_wrap():
+    renderable = JSON(SAMPLE)
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+    assert renderable.__rich__() is renderable.text
+
+
+def test_rich_print_json():
+    console = rich.get_console()
+    output = io.StringIO()
+    backup_file = console.file
+    try:
+        console.file = output
+        rich.print_json(SAMPLE)
+        assert output.getvalue() == (
+            "[\n"
+            "    false,\n"
+            "    true,\n"
+            "    null,\n"
+            '    "foo"\n'
+            "]\n"
+        )
+    finally:
+        console.file = backup_file
