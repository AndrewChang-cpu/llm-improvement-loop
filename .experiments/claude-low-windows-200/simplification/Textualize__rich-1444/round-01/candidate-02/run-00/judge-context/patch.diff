@@ -0,0 +1,38 @@
+import io
+
+import pytest
+
+import rich
+from rich.console import Console
+
+SAMPLE = '[false, true, null, "foo"]'
+
+
+def test_print_json_highlighted() -> None:
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", width=80
+    )
+    console.print_json(SAMPLE)
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert console.file.getvalue() == expected
+
+
+def test_print_json_global(monkeypatch: pytest.MonkeyPatch) -> None:
+    buffer = io.StringIO()
+    monkeypatch.setattr(rich, "_console", Console(file=buffer, width=80))
+    rich.print_json(SAMPLE)
+    assert buffer.getvalue() == '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_print_json_invalid_prints_nothing() -> None:
+    console = Console(file=io.StringIO(), width=80)
+    with pytest.raises(ValueError):
+        console.print_json("[false,")
+    assert console.file.getvalue() == ""
