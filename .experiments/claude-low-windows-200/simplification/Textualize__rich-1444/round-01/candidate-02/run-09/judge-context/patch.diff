diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..7f11919
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,47 @@
+from json import dumps, loads
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (int, optional): Number of spaces used to indent the output. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of JSON. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        json_text = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        self.text = highlighter(json_text)
+        self.text.no_wrap = True
+        self.text.overflow = None
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument("path", metavar="PATH", help="path to a JSON file")
+    args = parser.parse_args()
+
+    console = Console()
+    error_console = Console(stderr=True)
+    try:
+        with open(args.path, "rt", encoding="utf-8") as json_file:
+            json_text = json_file.read()
+    except Exception as error:
+        error_console.print("Unable to read", repr(args.path), str(error), markup=False)
+        sys.exit(-1)
+
+    console.print(JSON(json_text), soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..f3dd74a
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,95 @@
+import json
+from io import StringIO
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+from rich.text import Text
+
+SAMPLE = '[false, true, null, "foo"]'
+
+PLAIN_SAMPLE = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def _styled_sample() -> Text:
+    return Text.assemble(
+        ("[", "json.brace"),
+        "\n    ",
+        ("false", "json.bool_false"),
+        ",\n    ",
+        ("true", "json.bool_true"),
+        ",\n    ",
+        ("null", "json.null"),
+        ",\n    ",
+        ('"foo"', "json.str"),
+        "\n",
+        ("]", "json.brace"),
+    )
+
+
+def test_print_json_styled_output():
+    buffer = StringIO()
+    console = Console(file=buffer, force_terminal=True, color_system="truecolor")
+    console.print_json(SAMPLE)
+
+    expected_buffer = StringIO()
+    expected_console = Console(
+        file=expected_buffer, force_terminal=True, color_system="truecolor"
+    )
+    expected_console.print(_styled_sample())
+
+    assert "\x1b[" in buffer.getvalue()
+    assert buffer.getvalue() == expected_buffer.getvalue()
+
+
+def test_print_json_plain_output():
+    buffer = StringIO()
+    console = Console(file=buffer, color_system=None)
+    console.print_json(SAMPLE)
+    assert buffer.getvalue() == PLAIN_SAMPLE
+
+
+def test_print_json_indent():
+    buffer = StringIO()
+    console = Console(file=buffer, color_system=None)
+    console.print_json("[1]", indent=2)
+    assert buffer.getvalue() == "[\n  1\n]\n"
+
+
+def test_print_json_highlight_disabled():
+    buffer = StringIO()
+    console = Console(file=buffer, force_terminal=True, color_system="truecolor")
+    console.print_json(SAMPLE, highlight=False)
+    assert buffer.getvalue() == PLAIN_SAMPLE
+
+
+def test_print_json_invalid_prints_nothing():
+    buffer = StringIO()
+    console = Console(file=buffer, color_system=None)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1,")
+    assert buffer.getvalue() == ""
+
+
+def test_print_json_soft_wrap_keeps_long_line():
+    buffer = StringIO()
+    console = Console(file=buffer, color_system=None, width=20)
+    long_value = "x" * 50
+    console.print(JSON(json.dumps(long_value)), soft_wrap=True)
+    assert buffer.getvalue() == json.dumps(long_value) + "\n"
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON("[1]", 2)
+    assert renderable.text.plain == "[\n  1\n]"
+    assert renderable.text.no_wrap is True
+    assert renderable.__rich__() is renderable.text
+
+
+def test_package_print_json(monkeypatch):
+    buffer = StringIO()
+    monkeypatch.setattr(rich, "_console", Console(file=buffer, color_system=None))
+    rich.print_json(SAMPLE)
+    assert buffer.getvalue() == PLAIN_SAMPLE
