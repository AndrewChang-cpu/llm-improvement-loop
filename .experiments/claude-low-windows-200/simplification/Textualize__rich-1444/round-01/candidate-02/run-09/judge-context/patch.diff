+class JSONHighlighter(RegexHighlighter):
+    """Highlights JSON."""
+
+    base_style = "json."
+    highlights = [
+        _combine_regex(
+            r"(?P<brace>[\{\[\(\)\]\}])",
+            r"(?P<bool_true>\btrue\b)|(?P<bool_false>\bfalse\b)|(?P<null>\bnull\b)",
+            r"(?P<number>(?<!\w)\-?[0-9]+(\.[0-9]+)?(e[\-\+]?[0-9]+)?|(?<!\w)0x[0-9a-fA-F]+)",
+            r"(?<![\\\w])(?P<str>b?\".*?(?<!\\)\")",
+        ),
+    ]
+
+
