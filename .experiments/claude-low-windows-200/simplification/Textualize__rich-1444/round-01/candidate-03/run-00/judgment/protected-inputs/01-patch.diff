diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..1f67165
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,50 @@
+"""Pretty print JSON text, with optional highlighting."""
+
+from json import dumps, loads
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON text.
+
+    Args:
+        json (str): JSON document as text.
+        indent (int, optional): Number of spaces to indent by. Defaults to 4.
+        highlight (bool, optional): Enable JSON highlighting. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        json_text = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        self.text = highlighter(json_text)
+        self.text.no_wrap = True
+        self.text.overflow = None
+
+    def __rich__(self) -> Text:
+        """Return the highlighted text."""
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument("path", metavar="PATH", help="path to a JSON file")
+    args = parser.parse_args()
+
+    console = Console()
+    error_console = Console(stderr=True)
+    try:
+        with open(args.path, "rt", encoding="utf-8") as json_file:
+            json_text = json_file.read()
+    except (OSError, UnicodeDecodeError) as error:
+        error_console.print(f"Unable to read {args.path!r}; {error}")
+        sys.exit(-1)
+
+    console.print(JSON(json_text), soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..4077376
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,70 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.default_styles import DEFAULT_STYLES
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+
+def test_console_print_json_styled():
+    console = Console(
+        file=io.StringIO(),
+        width=80,
+        color_system="truecolor",
+        _environ={},
+    )
+    console.print_json(SAMPLE)
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert console.file.getvalue() == expected
+
+
+def test_console_print_json_indent_and_no_highlight():
+    console = Console(file=io.StringIO(), width=80, color_system=None, _environ={})
+    console.print_json(SAMPLE, indent=2, highlight=False)
+    assert console.file.getvalue() == '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+
+
+def test_package_print_json(monkeypatch):
+    console = Console(file=io.StringIO(), width=80, color_system=None, _environ={})
+    monkeypatch.setattr(rich, "_console", console)
+    rich.print_json(SAMPLE)
+    assert console.file.getvalue() == '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4, False)
+    assert renderable.text.plain == '[\n    false,\n    true,\n    null,\n    "foo"\n]'
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+    assert renderable.__rich__() is renderable.text
+
+
+def test_invalid_json_raises_and_prints_nothing():
+    console = Console(file=io.StringIO(), width=80, color_system=None, _environ={})
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("{")
+    assert console.file.getvalue() == ""
+
+
+def test_json_default_styles_registered():
+    for name in (
+        "json.brace",
+        "json.bool_true",
+        "json.bool_false",
+        "json.null",
+        "json.number",
+        "json.str",
+    ):
+        assert name in DEFAULT_STYLES
