diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..f738ab1
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,52 @@
+from json import dumps, loads
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (int, optional): Number of spaces to indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of JSON. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        json_text = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        self.text = highlighter(json_text)
+        self.text.no_wrap = True
+        self.text.overflow = None
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="FILE",
+        help="path to a JSON file",
+    )
+    args = parser.parse_args()
+
+    console = Console()
+    try:
+        with open(args.path, "rt") as json_file:
+            json_data = json_file.read()
+    except OSError as error:
+        error_console = Console(stderr=True)
+        error_console.print(f"Unable to read {args.path!r}; {error}")
+        sys.exit(-1)
+
+    console.print(JSON(json_data), soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..0bbcab6
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,78 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+PLAIN_SAMPLE = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_print_json_styled_output():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.print_json(SAMPLE)
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert console.file.getvalue() == expected
+
+
+def test_print_json_indent_two():
+    console = Console(file=io.StringIO(), color_system=None)
+    console.print_json(SAMPLE, indent=2, highlight=False)
+    expected = '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+    assert console.file.getvalue() == expected
+
+
+def test_print_json_no_highlight_plain():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == PLAIN_SAMPLE
+
+
+def test_print_json_invalid_raises_and_prints_nothing():
+    console = Console(file=io.StringIO(), color_system=None)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2")
+    assert console.file.getvalue() == ""
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4)
+    assert renderable.text.plain == PLAIN_SAMPLE.rstrip("\n")
+
+
+def test_json_renderable_no_wrap_settings():
+    renderable = JSON(SAMPLE)
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+    assert renderable.__rich__() is renderable.text
+
+
+def test_json_highlight_styles_literals_not_in_strings():
+    renderable = JSON('["true 1", true]')
+    styles = {(span.start, span.end, span.style) for span in renderable.text.spans}
+    true_start = renderable.text.plain.rindex("true")
+    assert (true_start, true_start + 4, "json.bool_true") in styles
+    assert (1, 9, "json.str") in styles
+    assert not any(style == "json.number" for _, _, style in styles)
+
+
+def test_package_print_json_matches_console():
+    console = rich.get_console()
+    output = io.StringIO()
+    backup_file = console.file
+    try:
+        console.file = output
+        rich.print_json(SAMPLE, highlight=False)
+        assert output.getvalue() == PLAIN_SAMPLE
+    finally:
+        console.file = backup_file
