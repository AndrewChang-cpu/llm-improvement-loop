@@ -0,0 +1,67 @@
+import io
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+PLAIN_FOUR_SPACES = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_console_print_json_styled():
+    console = Console(
+        file=io.StringIO(),
+        color_system="truecolor",
+        width=80,
+        _environ={},
+    )
+    console.print_json(SAMPLE)
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert console.file.getvalue() == expected
+
+
+def test_console_print_json_indent_two():
+    console = Console(file=io.StringIO(), color_system=None, width=80)
+    console.print_json(SAMPLE, indent=2)
+    expected = '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+    assert console.file.getvalue() == expected
+
+
+def test_console_print_json_no_highlight():
+    console = Console(file=io.StringIO(), color_system="truecolor", width=80)
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == PLAIN_FOUR_SPACES
+
+
+def test_package_print_json():
+    console = rich.get_console()
+    output = io.StringIO()
+    backup_file = console.file
+    try:
+        console.file = output
+        rich.print_json(SAMPLE)
+        assert output.getvalue() == PLAIN_FOUR_SPACES
+    finally:
+        console.file = backup_file
+
+
+def test_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4, False)
+    assert renderable.text.plain == PLAIN_FOUR_SPACES[:-1]
+    assert renderable.text.no_wrap is True
+
+
+def test_invalid_json_raises_and_prints_nothing():
+    console = Console(file=io.StringIO(), color_system=None)
+    with pytest.raises(ValueError):
+        console.print_json("[1, 2")
+    assert console.file.getvalue() == ""
