diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..07cc77b
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,52 @@
+from json import dumps, loads
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): JSON encoded data.
+        indent (int, optional): Number of spaces in indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of JSON. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        serialized = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        self.text = highlighter(serialized)
+        self.text.no_wrap = True
+        self.text.overflow = None
+
+    def __rich__(self) -> Text:
+        """Return the highlighted JSON text."""
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="PATH",
+        help="path to a JSON file",
+    )
+    args = parser.parse_args()
+
+    stderr_console = Console(stderr=True)
+    try:
+        with open(args.path, "rt") as json_file:
+            json_data = json_file.read()
+    except OSError as error:
+        stderr_console.print(f"Unable to read {args.path!r}; {error}")
+        sys.exit(-1)
+
+    console = Console()
+    console.print(JSON(json_data), soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..88caac3
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,79 @@
+import io
+import json
+
+import pytest
+
+from rich.console import Console
+from rich.highlighter import JSONHighlighter
+from rich.json import JSON
+from rich.text import Span
+
+SAMPLE = '[false, true, null, "foo"]'
+SAMPLE_PLAIN = '[\n    false,\n    true,\n    null,\n    "foo"\n]'
+
+
+def test_json_plain_text():
+    renderable = JSON(SAMPLE, highlight=False)
+    assert renderable.text.plain == SAMPLE_PLAIN
+    assert renderable.text.spans == []
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+
+
+def test_json_rich_protocol_returns_text():
+    renderable = JSON(SAMPLE)
+    assert renderable.__rich__() is renderable.text
+
+
+def test_json_indent_positional():
+    renderable = JSON(SAMPLE, 2, False)
+    assert renderable.text.plain == SAMPLE_PLAIN.replace("    ", "  ")
+
+
+def test_json_indent_keyword():
+    renderable = JSON(SAMPLE, indent=4, highlight=False)
+    assert renderable.text.plain == SAMPLE_PLAIN
+
+
+def test_json_invalid_raises():
+    with pytest.raises(json.JSONDecodeError):
+        JSON("[1, 2")
+
+
+def test_json_highlight_spans():
+    renderable = JSON(SAMPLE)
+    assert renderable.text.spans == [
+        Span(0, 1, "json.brace"),
+        Span(1, 6, "json.bool_false"),
+        Span(8, 12, "json.bool_true"),
+        Span(14, 18, "json.null"),
+        Span(20, 25, "json.str"),
+        Span(25, 26, "json.brace"),
+    ]
+
+
+def test_json_highlighter_literals_and_strings():
+    highlighted = JSONHighlighter()('[true, "a 1 true"]')
+    assert highlighted.spans == [
+        Span(0, 1, "json.brace"),
+        Span(1, 5, "json.bool_true"),
+        Span(7, 17, "json.str"),
+        Span(17, 18, "json.brace"),
+    ]
+
+
+def test_json_highlighter_number():
+    highlighted = JSONHighlighter()("[-1.5e+3]")
+    assert highlighted.spans == [
+        Span(0, 1, "json.brace"),
+        Span(1, 8, "json.number"),
+        Span(8, 9, "json.brace"),
+    ]
+
+
+def test_json_console_output_has_no_color_when_disabled():
+    console = Console(
+        file=io.StringIO(), color_system=None, width=80, force_terminal=False
+    )
+    console.print(JSON(SAMPLE, highlight=False))
+    assert console.file.getvalue() == SAMPLE_PLAIN + "\n"
