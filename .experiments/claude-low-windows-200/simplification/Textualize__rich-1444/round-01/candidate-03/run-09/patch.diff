+++ b/tests/test_print_json.py
@@ -0,0 +1,51 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich import print_json
+from rich.console import Console
+
+SAMPLE = '[false, true, null, "foo"]'
+SAMPLE_PLAIN = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+SAMPLE_STYLED = (
+    "\x1b[1m[\x1b[0m\n"
+    "    \x1b[3;91mfalse\x1b[0m,\n"
+    "    \x1b[3;92mtrue\x1b[0m,\n"
+    "    \x1b[3;35mnull\x1b[0m,\n"
+    '    \x1b[32m"foo"\x1b[0m\n'
+    "\x1b[1m]\x1b[0m\n"
+)
+
+
+def test_console_print_json_styled():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+    )
+    console.print_json(SAMPLE)
+    assert console.file.getvalue() == SAMPLE_STYLED
+
+
+def test_console_print_json_indent_two():
+    console = Console(file=io.StringIO(), color_system=None, width=80)
+    console.print_json(SAMPLE, indent=2, highlight=False)
+    expected = '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+    assert console.file.getvalue() == expected
+
+
+def test_console_print_json_invalid_prints_nothing():
+    console = Console(file=io.StringIO(), color_system=None, width=80)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2")
+    assert console.file.getvalue() == ""
+
+
+def test_package_print_json(monkeypatch):
+    console = Console(file=io.StringIO(), color_system=None, width=80)
+    monkeypatch.setattr(rich, "_console", console)
+    print_json(SAMPLE)
+    assert console.file.getvalue() == SAMPLE_PLAIN
