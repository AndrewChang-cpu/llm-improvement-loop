+++ b/tests/test_json.py
@@ -0,0 +1,91 @@
+import io
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+PLAIN_SAMPLE = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_console_print_json_styled():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        width=80,
+        _environ={},
+    )
+    console.print_json(SAMPLE)
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert console.file.getvalue() == expected
+
+
+def test_console_print_json_indent_two():
+    console = Console(file=io.StringIO(), width=80, _environ={})
+    console.print_json(SAMPLE, indent=2, highlight=False)
+    assert console.file.getvalue() == '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+
+
+def test_console_print_json_highlight_off_is_plain():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        width=80,
+        _environ={},
+    )
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == PLAIN_SAMPLE
+
+
+def test_console_print_json_invalid_prints_nothing():
+    console = Console(file=io.StringIO(), width=80, _environ={})
+    with pytest.raises(ValueError):
+        console.print_json("[1, 2")
+    assert console.file.getvalue() == ""
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4, False)
+    assert renderable.text.plain == PLAIN_SAMPLE[:-1]
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow == "ignore"
+
+
+def test_json_renderable_protocol_returns_text():
+    renderable = JSON(SAMPLE)
+    assert renderable.__rich__() is renderable.text
+
+
+def test_json_string_content_not_styled_apart():
+    renderable = JSON('{"a": "true 12 {"}')
+    spans = renderable.text.spans
+    styles = [span.style for span in spans]
+    assert styles.count("json.str") == 2
+    assert "json.bool_true" not in styles
+    assert "json.number" not in styles
+
+
+def test_rich_print_json_plain():
+    console = rich.get_console()
+    output = io.StringIO()
+    backup_file = console.file
+    try:
+        console.file = output
+        rich.print_json(SAMPLE)
+        assert output.getvalue() == PLAIN_SAMPLE
+    finally:
+        console.file = backup_file
