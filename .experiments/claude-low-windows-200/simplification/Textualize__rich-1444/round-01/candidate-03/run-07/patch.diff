+class JSONHighlighter(RegexHighlighter):
+    """Highlights JSON text."""
+
+    base_style = "json."
+    highlights = [
+        _combine_regex(
+            r"(?P<brace>[\{\[\(\)\]\}])",
+            r"\b(?P<bool_true>true)\b",
+            r"\b(?P<bool_false>false)\b",
+            r"\b(?P<null>null)\b",
+            r"(?P<number>(?<!\w)(?:\-?[0-9]+(?:\.[0-9]+)?(?:e[\-\+]?[0-9]+)?|0x[0-9a-fA-F]+))",
+            r'(?<![\\\w])(?P<str>b?".*?(?<!\\)")',
+        ),
+    ]
+
+
