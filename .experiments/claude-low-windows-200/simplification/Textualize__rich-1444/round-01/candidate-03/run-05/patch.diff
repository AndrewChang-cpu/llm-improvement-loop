+++ b/tests/test_json.py
@@ -0,0 +1,80 @@
+import io
+import json
+
+import pytest
+
+import rich
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+PLAIN_SAMPLE = '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+STYLED_SAMPLE = (
+    "\x1b[1m[\x1b[0m\n"
+    "    \x1b[3;91mfalse\x1b[0m,\n"
+    "    \x1b[3;92mtrue\x1b[0m,\n"
+    "    \x1b[3;35mnull\x1b[0m,\n"
+    '    \x1b[32m"foo"\x1b[0m\n'
+    "\x1b[1m]\x1b[0m\n"
+)
+
+
+def test_console_print_json_styled():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+    )
+    console.print_json(SAMPLE)
+    assert console.file.getvalue() == STYLED_SAMPLE
+
+
+def test_console_print_json_indent_two():
+    console = Console(file=io.StringIO(), highlight=False)
+    console.print_json(SAMPLE, indent=2)
+    assert console.file.getvalue() == '[\n  false,\n  true,\n  null,\n  "foo"\n]\n'
+
+
+def test_console_print_json_no_highlight():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+    )
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == PLAIN_SAMPLE
+
+
+def test_console_print_json_invalid():
+    console = Console(file=io.StringIO())
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2")
+    assert console.file.getvalue() == ""
+
+
+def test_print_json_package_level(monkeypatch):
+    buffer = io.StringIO()
+    console = Console(file=buffer)
+    monkeypatch.setattr(rich, "_console", console)
+    rich.print_json(SAMPLE)
+    assert buffer.getvalue() == PLAIN_SAMPLE
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON(SAMPLE, 4)
+    assert renderable.text.plain == PLAIN_SAMPLE
+
+
+def test_json_renderable_protocol_returns_text():
+    renderable = JSON(SAMPLE)
+    assert renderable.__rich__() is renderable.text
+
+
+def test_json_renderable_no_wrap_and_overflow():
+    renderable = JSON(SAMPLE)
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+
+
