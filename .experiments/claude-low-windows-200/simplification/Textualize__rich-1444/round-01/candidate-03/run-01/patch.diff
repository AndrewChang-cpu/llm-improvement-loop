diff --git a/rich/json.py b/rich/json.py
new file mode 100644
index 0000000..3893bb3
--- /dev/null
+++ b/rich/json.py
@@ -0,0 +1,52 @@
+from json import dumps, loads
+
+from .highlighter import JSONHighlighter, NullHighlighter
+from .text import Text
+
+
+class JSON:
+    """A renderable which pretty prints JSON.
+
+    Args:
+        json (str): A string containing JSON.
+        indent (int, optional): Number of spaces to indent. Defaults to 4.
+        highlight (bool, optional): Enable highlighting of output. Defaults to True.
+    """
+
+    def __init__(self, json: str, indent: int = 4, highlight: bool = True) -> None:
+        data = loads(json)
+        json_str = dumps(data, indent=indent)
+        highlighter = JSONHighlighter() if highlight else NullHighlighter()
+        text: Text = highlighter(json_str)
+        text.no_wrap = True
+        text.overflow = None
+        self.text = text
+
+    def __rich__(self) -> Text:
+        return self.text
+
+
+if __name__ == "__main__":  # pragma: no cover
+    import argparse
+    import sys
+
+    from .console import Console
+
+    parser = argparse.ArgumentParser(description="Pretty print json")
+    parser.add_argument(
+        "path",
+        metavar="PATH",
+        help="path to a JSON file",
+    )
+    args = parser.parse_args()
+
+    console = Console()
+    error_console = Console(stderr=True)
+    try:
+        with open(args.path, "rt") as json_file:
+            json_text = json_file.read()
+    except OSError as error:
+        error_console.print(f"Unable to read {args.path!r}; {error}")
+        sys.exit(-1)
+
+    console.print(JSON(json_text), soft_wrap=True)
diff --git a/tests/test_json.py b/tests/test_json.py
new file mode 100644
index 0000000..1d97615
--- /dev/null
+++ b/tests/test_json.py
@@ -0,0 +1,85 @@
+import io
+import json
+
+import pytest
+
+from rich import get_console, print_json
+from rich.console import Console
+from rich.json import JSON
+
+SAMPLE = '[false, true, null, "foo"]'
+
+
+def test_console_print_json_styled():
+    console = Console(
+        file=io.StringIO(), width=80, color_system="truecolor", force_terminal=True
+    )
+    console.print_json(SAMPLE)
+    result = console.file.getvalue()
+    expected = (
+        "\x1b[1m[\x1b[0m\n"
+        "    \x1b[3;91mfalse\x1b[0m,\n"
+        "    \x1b[3;92mtrue\x1b[0m,\n"
+        "    \x1b[3;35mnull\x1b[0m,\n"
+        '    \x1b[32m"foo"\x1b[0m\n'
+        "\x1b[1m]\x1b[0m\n"
+    )
+    assert result == expected
+
+
+def test_console_print_json_indent_two():
+    console = Console(file=io.StringIO(), width=80)
+    console.print_json('{"a": 1}', indent=2, highlight=False)
+    assert console.file.getvalue() == '{\n  "a": 1\n}\n'
+
+
+def test_console_print_json_no_highlight_is_plain():
+    console = Console(file=io.StringIO(), width=80, color_system="truecolor")
+    console.print_json(SAMPLE, highlight=False)
+    assert console.file.getvalue() == '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_console_print_json_long_line_soft_wrap_keeps_line_whole():
+    console = Console(file=io.StringIO(), width=20)
+    long_value = "a" * 30
+    console.print(JSON(json.dumps([long_value]), highlight=False), soft_wrap=True)
+    lines = console.file.getvalue().splitlines()
+    assert lines[1] == '    "' + long_value + '"'
+
+
+def test_json_renderable_positional_indent():
+    renderable = JSON('{"a": [1]}', 4, False)
+    assert renderable.text.plain == json.dumps({"a": [1]}, indent=4)
+    assert renderable.text.no_wrap is True
+    assert renderable.text.overflow is None
+
+
+def test_json_renderable_highlight_off_has_no_spans():
+    renderable = JSON(SAMPLE, highlight=False)
+    assert renderable.text.spans == []
+
+
+def test_json_renderable_is_rich_renderable():
+    renderable = JSON(SAMPLE)
+    assert renderable.__rich__() is renderable.text
+
+
+def test_invalid_json_raises_and_prints_nothing():
+    console = Console(file=io.StringIO(), width=80)
+    with pytest.raises(json.JSONDecodeError):
+        console.print_json("[1, 2")
+    assert console.file.getvalue() == ""
+
+
+def test_package_print_json_plain():
+    console = get_console()
+    with console.capture() as capture:
+        print_json(SAMPLE, highlight=False)
+    assert capture.get() == '[\n    false,\n    true,\n    null,\n    "foo"\n]\n'
+
+
+def test_package_print_json_indent_two():
+    console = get_console()
+    with console.capture() as capture:
+        print_json('{"a": 1}', indent=2, highlight=False)
+    assert capture.get() == '{\n  "a": 1\n}\n'
