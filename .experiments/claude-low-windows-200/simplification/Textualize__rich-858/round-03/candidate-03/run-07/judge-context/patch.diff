+def test_time_elapsed_column():
+    clock = MockClock(auto=False)
+    progress = Progress(
+        console=Console(file=io.StringIO(), width=80, legacy_windows=False),
+        get_time=clock,
+        auto_refresh=False,
+    )
+    column = TimeElapsedColumn()
+
+    # Unstarted task shows the placeholder
+    task_id = progress.add_task("foo", start=False, total=10)
+    task = progress.tasks[0]
+    assert str(column(task)) == "-:--:--"
+
+    # Running task shows live elapsed time
+    progress.start_task(task_id)  # start_time = 0
+    clock.tick(5)
+    assert str(column(task)) == "0:00:05"
+
+    # Reaching the total freezes the value at the elapsed time at that moment
+    clock.tick(2)  # time = 7, elapsed = 7
+    progress.update(task_id, completed=10)
+    assert task.finished
+    clock.tick(20)
+    assert str(column(task)) == "0:00:07"
+
+
