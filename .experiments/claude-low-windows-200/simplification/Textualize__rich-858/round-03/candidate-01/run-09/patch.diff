+class TimeElapsedColumn(ProgressColumn):
+    """Renders time elapsed."""
+
+    def render(self, task: "Task") -> Text:
+        """Show time elapsed, frozen at the finished time once the task has finished."""
+        if task.finished:
+            elapsed = task.finished_time
+        else:
+            elapsed = task.elapsed
+        if elapsed is None:
+            return Text("-:--:--", style="progress.elapsed")
+        elapsed_delta = timedelta(seconds=int(elapsed))
+        return Text(str(elapsed_delta), style="progress.elapsed")
+
