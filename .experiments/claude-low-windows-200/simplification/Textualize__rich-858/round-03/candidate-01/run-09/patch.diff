@@ -79,6 +80,42 @@ def test_time_remaining_column():
     assert str(text) == "0:01:00"
 
 
+def test_time_elapsed_column():
+    clock = MockClock(auto=False)
+    progress = Progress(
+        console=Console(file=io.StringIO()), auto_refresh=False, get_time=clock
+    )
+    column = TimeElapsedColumn()
+    task_id = progress.add_task("foo", total=10, start=False)
+    task = progress.tasks[0]
+
+    # Unstarted
+    assert str(column(task)) == "-:--:--"
+
+    # Running: live elapsed time, truncated to whole seconds
+    progress.start_task(task_id)  # started at 0
+    clock.tick(5)
+    progress.advance(task_id, 3)
+    assert str(column(task)) == "0:00:05"
+    clock.tick(4.5)
+    assert str(column(task)) == "0:00:09"
+
+    # Finished: value frozen at the elapsed time when the total was reached
+    clock.tick(0.5)  # now 10
+    progress.update(task_id, completed=10)
+    assert task.finished
+    assert str(column(task)) == "0:00:10"
+    clock.tick(20)
+    assert str(column(task)) == "0:00:10"
+
+    # Reset clears the frozen value and the task shows live time again
+    progress.reset(task_id)
+    assert not task.finished
+    assert str(column(task)) == "0:00:00"
+    clock.tick(3)
+    assert str(column(task)) == "0:00:03"
+
+
