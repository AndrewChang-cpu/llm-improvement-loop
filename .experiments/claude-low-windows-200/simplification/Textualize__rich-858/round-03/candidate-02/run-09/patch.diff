+def test_time_elapsed_column():
+    clock = MockClock(auto=False)
+    progress = Progress(
+        TimeElapsedColumn(),
+        console=Console(file=io.StringIO()),
+        auto_refresh=False,
+        get_time=clock,
+    )
+    column = TimeElapsedColumn()
+    task_id = progress.add_task("test", total=10, start=False)
+    task = progress.tasks[0]
+
+    # Unstarted: placeholder
+    assert str(column(task)) == "-:--:--"
+
+    # Running: live elapsed time
+    progress.start_task(task_id)
+    clock.tick(5)
+    assert str(column(task)) == "0:00:05"
+
+    # Finished: frozen at the elapsed time when the total was reached
+    clock.tick(5)
+    progress.advance(task_id, 10)
+    clock.tick(7)
+    assert str(column(task)) == "0:00:10"
+
+
