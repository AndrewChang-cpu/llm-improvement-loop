+def test_time_elapsed_column():
+    clock = MockClock(auto=False)
+    progress = Progress(
+        TimeElapsedColumn(),
+        console=Console(file=io.StringIO()),
+        auto_refresh=False,
+        get_time=clock,
+    )
+    column = TimeElapsedColumn()
+    task_id = progress.add_task("foo", total=10, start=False)
+    task = progress.tasks[0]
+
+    # Unstarted: placeholder
+    assert str(column(task)) == "-:--:--"
+
+    # Running: live elapsed time
+    progress.start_task(task_id)
+    clock.tick(3)
+    assert str(column(task)) == "0:00:03"
+    clock.tick(4)
+    assert str(column(task)) == "0:00:07"
+
+    # Finished at 10 seconds: frozen while the clock keeps moving
+    clock.tick(3)
+    progress.update(task_id, completed=10)
+    assert task.finished
+    clock.tick(5)
+    assert str(column(task)) == "0:00:10"
+
+
