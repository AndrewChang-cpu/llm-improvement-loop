+def test_time_elapsed_column() -> None:
+    clock = MockClock(auto=False)
+    progress = Progress(
+        console=Console(file=io.StringIO()),
+        auto_refresh=False,
+        get_time=clock,
+    )
+    column = TimeElapsedColumn()
+    progress.add_task("unstarted", total=10, start=False)
+    running_id = progress.add_task("running", total=10)
+    unstarted, running = progress.tasks
+
+    # Unstarted: placeholder
+    assert str(column(unstarted)) == "-:--:--"
+
+    # Running: live elapsed time
+    clock.tick(5)
+    assert str(column(running)) == "0:00:05"
+
+    # Finished at time 5: value frozen at the finish time
+    progress.update(running_id, completed=10)
+    clock.tick(7)
+    assert str(column(running)) == "0:00:05"
+
+
