diff --git a/rich/console.py b/rich/console.py
index 64d0109..322a2b0 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,41 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output raw text to the console (low level alternative to print).
+
+        Objects are converted with ``str()`` and joined by ``sep``. No pretty printing,
+        wrapping, cropping, markup or emoji replacement is applied. Highlighting is
+        applied by default, and a basic style may be set.
+
+        Args:
+            objects (positional args): Objects to write to the console.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. True forces
+                highlighting, False disables it, or ``None`` to use console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
