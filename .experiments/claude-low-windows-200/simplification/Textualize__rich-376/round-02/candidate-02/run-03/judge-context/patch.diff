+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO())
+    assert console.out("foo") is None
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] [red]bar")
+    assert console.file.getvalue() == "[bold]foo[/bold] [red]bar\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("foo :smiley: bar")
+    assert console.file.getvalue() == "foo :smiley: bar\n"
+
+
+def test_out_containers():
+    console = Console(file=io.StringIO(), width=10)
+    values = list(range(20))
+    console.out(values)
+    assert console.file.getvalue() == str(values) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar baz qux")
+    assert console.file.getvalue() == "foo bar baz qux\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_false():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("1", highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_default():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none_defers_to_console():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1", highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("1", highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+class _RecordingHook(RenderHook):
+    def __init__(self):
+        self.calls = 0
+
+    def process_renderables(self, renderables):
+        self.calls += 1
+        return renderables
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=80)
+    hook = _RecordingHook()
+    console.push_render_hook(hook)
+    console.out("foo")
+    console.pop_render_hook()
+    assert hook.calls == 1
+    assert console.file.getvalue() == "foo\n"
+
+
