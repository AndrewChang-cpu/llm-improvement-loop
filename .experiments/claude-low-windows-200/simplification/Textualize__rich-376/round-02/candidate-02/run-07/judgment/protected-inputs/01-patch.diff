diff --git a/rich/console.py b/rich/console.py
index 64d0109..474293c 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,42 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output raw text to the console.
+
+        This is a low-level alternative to print. Objects are converted with
+        normal string conversion (no pretty printing), joined by ``sep``, and
+        written as plain text. The text is not wrapped, cropped, or subject to
+        markup or emoji code replacement. Highlighting and a basic style may be
+        applied, as with print.
+
+        Args:
+            objects (positional args): Objects to output as text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. True forces highlighting even if the Console disabled it, False disables it, or ``None`` to use the console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            end=end,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
