diff --git a/rich/console.py b/rich/console.py
index 64d0109..4f9594b 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,41 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output low-level text to the console.
+
+        Unlike print, objects are not pretty printed, wrapped, cropped, or
+        processed for markup or emoji codes. Each object is converted with
+        ``str()`` and the results are joined by ``sep``. Highlighting is on
+        by default.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A basic style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, ``True`` to force it, ``False`` to disable it, or ``None`` to use console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            end=end,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
