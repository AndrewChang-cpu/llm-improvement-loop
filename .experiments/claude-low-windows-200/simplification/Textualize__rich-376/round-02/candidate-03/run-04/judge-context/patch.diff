+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold]")
+    assert console.file.getvalue() == "[bold]foo[/bold]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smile:")
+    assert console.file.getvalue() == ":smile:\n"
+
+
+def test_out_containers():
+    console = Console(file=io.StringIO(), width=10)
+    data = list(range(10))
+    console.out(data)
+    assert console.file.getvalue() == str(data) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("x" * 30)
+    assert console.file.getvalue() == "x" * 30 + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    # Default highlight=True applies highlighting even though the console disabled it.
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1")
+    default_output = console.file.getvalue()
+
+    plain = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    plain.out("1", highlight=False)
+    assert "\x1b[" in default_output
+    assert default_output != plain.file.getvalue()
+
+
+def test_out_highlight_none():
+    # None defers to the console setting, which here is highlight=False.
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1", highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_false():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("1", highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_render_hook():
+    calls = []
+
+    class RecordingHook(RenderHook):
+        def process_renderables(self, renderables):
+            calls.append(len(renderables))
+            return renderables
+
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(RecordingHook())
+    console.out("foo")
+    assert calls == [1]
+    assert console.file.getvalue() == "foo\n"
+
+
