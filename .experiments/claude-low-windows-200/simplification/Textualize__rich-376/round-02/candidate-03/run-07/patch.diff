diff --git a/rich/console.py b/rich/console.py
index 64d0109..8a9e93d 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,40 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output raw text to the console, without pretty printing or markup.
+
+        Each object is converted with normal string conversion and joined by ``sep``.
+        Unlike print, the text is not pretty printed, wrapped, cropped, or processed for
+        markup or emoji codes. Highlighting and a basic style may still be applied.
+
+        Args:
+            objects (positional args): Objects to convert to text and output.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, or ``None`` to use console default. Defaults to True.
+        """
+        raw_output = sep.join([str(obj) for obj in objects])
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
