diff --git a/rich/console.py b/rich/console.py
index 64d0109..fd84b10 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,41 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output low level text to the console, without pretty printing, wrapping, or markup.
+
+        Objects are converted with ``str()`` and joined with ``sep``. The result is passed
+        to :meth:`print` with emoji and markup disabled, no wrapping, overflow set to
+        "ignore", and cropping disabled.
+
+        Args:
+            objects (positional args): Objects to output as plain text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, ``False`` to disable,
+                or ``None`` to use console default. Defaults to True (highlighting is forced on).
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
