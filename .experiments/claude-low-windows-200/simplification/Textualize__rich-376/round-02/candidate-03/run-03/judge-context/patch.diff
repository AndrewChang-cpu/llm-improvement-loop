+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    for _ in range(5):
+        console.out("foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] [red]")
+    assert console.file.getvalue() == "[bold]foo[/bold] [red]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smiley:")
+    assert console.file.getvalue() == ":smiley:\n"
+
+
+def test_out_containers_not_pretty_printed():
+    console = Console(file=io.StringIO(), width=80)
+    console.out([1, 2, 3], {"a": 1})
+    assert console.file.getvalue() == "[1, 2, 3] {'a': 1}\n"
+
+
+def test_out_not_cropped():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar baz egg")
+    assert console.file.getvalue() == "foo bar baz egg\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default_applies_highlight():
+    # "None" is styled by the default ReprHighlighter; the console disables highlighting.
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("None")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none_defers_to_console():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("None", highlight=None)
+    assert console.file.getvalue() == "None\n"
+
+
+def test_out_highlight_false():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("None", highlight=False)
+    assert console.file.getvalue() == "None\n"
+
+
+def test_out_render_hook():
+    class ReplaceHook:
+        def process_renderables(self, renderables):
+            return [Text("hooked\n")]
+
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(ReplaceHook())
+    console.out("foo")
+    console.pop_render_hook()
+    assert console.file.getvalue() == "hooked\n"
+
+
