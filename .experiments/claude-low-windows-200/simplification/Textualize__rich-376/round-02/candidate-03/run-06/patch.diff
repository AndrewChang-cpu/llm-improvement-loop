+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold]")
+    assert console.file.getvalue() == "[bold]foo[/bold]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smile:")
+    assert console.file.getvalue() == ":smile:\n"
+
+
+def test_out_containers():
+    console = Console(file=io.StringIO(), width=10)
+    data = list(range(10))
+    console.out(data)
+    assert console.file.getvalue() == str(data) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("x" * 30)
+    assert console.file.getvalue() == "x" * 30 + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_plain():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(1)
+    console.out(1, highlight=None)
+    console.out(1, highlight=False)
+    assert console.file.getvalue() == "1\n1\n1\n"
+
+
+def test_out_highlight_default_overrides_console():
+    def render(**kwargs):
+        console = Console(
+            file=io.StringIO(),
+            highlight=False,
+            force_terminal=True,
+            color_system="truecolor",
+            width=80,
+        )
+        console.out("1 2", **kwargs)
+        return console.file.getvalue()
+
+    assert render() != render(highlight=False)
+    assert render(highlight=True) == render()
+
+
+def test_out_highlight_none_defers_to_console():
+    def render(**kwargs):
+        console = Console(
+            file=io.StringIO(),
+            highlight=False,
+            force_terminal=True,
+            color_system="truecolor",
+            width=80,
+        )
+        console.out("1 2", **kwargs)
+        return console.file.getvalue()
+
+    assert render(highlight=None) == render(highlight=False)
+
+
+def test_out_render_hook():
+    class _Hook(RenderHook):
+        def process_renderables(self, renderables):
+            return [Text("hooked")] + list(renderables)
+
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(_Hook())
+    console.out("foo")
+    assert "hooked" in console.file.getvalue()
+    assert "foo" in console.file.getvalue()
+
+
