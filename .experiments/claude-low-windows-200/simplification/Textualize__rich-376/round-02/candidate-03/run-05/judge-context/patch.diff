+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_default_end():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("foo")
+    console.out()
+    assert console.file.getvalue() == "foo\n\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold]", "[link]bar[/link]")
+    assert console.file.getvalue() == "[bold]foo[/bold] [link]bar[/link]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smile: foo")
+    assert console.file.getvalue() == ":smile: foo\n"
+
+
+def test_out_containers():
+    console = Console(file=io.StringIO(), width=80)
+    console.out([1, 2], {"a": 1})
+    assert console.file.getvalue() == "[1, 2] {'a': 1}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("x" * 25)
+    assert console.file.getvalue() == "x" * 25 + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight():
+    # Non-terminal console: highlighting produces no escape codes, so the
+    # plain text must be identical for default, None and False.
+    for highlight in (None, False, True):
+        console = Console(file=io.StringIO(), width=80)
+        console.out("foo", highlight=highlight)
+        assert console.file.getvalue() == "foo\n"
+    console = Console(file=io.StringIO(), width=80)
+    console.out("foo")
+    assert console.file.getvalue() == "foo\n"
+
+
+class _AppendHook:
+    def process_renderables(self, renderables):
+        return list(renderables) + [Text("HOOK")]
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(_AppendHook())
+    console.out("foo")
+    output = console.file.getvalue()
+    assert output.startswith("foo\n")
+    assert "HOOK" in output
+
+
