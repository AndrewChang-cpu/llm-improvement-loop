diff --git a/rich/console.py b/rich/console.py
index 64d0109..e712317 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,40 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Optional[Union[str, Style]] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output to the terminal as low-level plain text.
+
+        Objects are converted with ``str()`` and joined by ``sep``. Unlike
+        print, the output is not pretty-printed, wrapped, cropped, marked up,
+        or emoji-replaced. Highlighting and a basic style are still applied.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, ``True`` to force it, ``False`` to disable it, or ``None`` to use console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
