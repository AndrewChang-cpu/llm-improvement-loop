+def test_out():
+    console = Console(width=10, file=io.StringIO())
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_empty():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_sep_end_no_wrap():
+    console = Console(width=10, file=io.StringIO())
+    console.out("foo bar baz egg", "egg", sep="|", end="!")
+    assert console.file.getvalue() == "foo bar baz egg|egg!"
+
+
+def test_out_no_crop():
+    console = Console(width=10, file=io.StringIO())
+    console.out("0123456789ABCDEF")
+    assert console.file.getvalue() == "0123456789ABCDEF\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("[bold]foo[/bold] [link=https://example.org]bar", highlight=False)
+    assert console.file.getvalue() == "[bold]foo[/bold] [link=https://example.org]bar\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out(":vampire: foo", highlight=False)
+    assert console.file.getvalue() == ":vampire: foo\n"
+
+
+def test_out_containers_not_pretty_printed():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out([1, "a"], {"b": None}, highlight=False)
+    assert console.file.getvalue() == "[1, 'a'] {'b': None}\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_false():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("1 foo", highlight=False)
+    assert console.file.getvalue() == "1 foo\n"
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1 foo", highlight=None)
+    assert console.file.getvalue() == "1 foo\n"
+
+
+def test_out_highlight_default_is_true():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1 foo")
+    assert "\x1b[" in console.file.getvalue()
+
+
+class _RecordingHook(RenderHook):
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def process_renderables(self, renderables):
+        self.calls += 1
+        return renderables
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=20)
+    hook = _RecordingHook()
+    console.push_render_hook(hook)
+    console.out("foo", highlight=False)
+    console.pop_render_hook()
+    assert hook.calls == 1
+    assert console.file.getvalue() == "foo\n"
+
+
