diff --git a/rich/console.py b/rich/console.py
index 64d0109..9329fcc 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,43 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output low level text to the console.
+
+        Objects are converted with ``str()`` and joined with ``sep`` to form plain text.
+        Unlike print, no pretty printing, word wrapping, cropping, markup, or emoji
+        replacement is applied. The text is passed to print, so render hooks and the
+        buffer are used as normal.
+
+        Args:
+            objects (positional args): Objects to output as plain text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A basic style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. ``True`` forces
+                highlighting, ``False`` disables it, and ``None`` uses the console default.
+                Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
