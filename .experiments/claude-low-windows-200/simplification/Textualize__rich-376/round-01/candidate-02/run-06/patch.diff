+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    result = console.out("foo bar", "baz", sep="|", end="X")
+    assert result is None
+    assert console.file.getvalue() == "foo bar|bazX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_sep_end_no_wrap():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("x" * 30)
+    assert console.file.getvalue() == "x" * 30 + "\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=10)
+    console.out(list(range(10)))
+    assert console.file.getvalue() == str(list(range(10))) + "\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] [red]bar")
+    assert console.file.getvalue() == "[bold]foo[/bold] [red]bar\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smile: foo")
+    assert console.file.getvalue() == ":smile: foo\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor", force_terminal=True)
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, highlight=False
+    )
+    console.out("1")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, highlight=False
+    )
+    console.out("1", highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, highlight=True
+    )
+    console.out("1", highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+class ReplaceHook(RenderHook):
+    def process_renderables(self, renderables):
+        return [Text("changed")]
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(ReplaceHook())
+    console.out("foo")
+    assert console.file.getvalue() == "changed\n"
+
+
