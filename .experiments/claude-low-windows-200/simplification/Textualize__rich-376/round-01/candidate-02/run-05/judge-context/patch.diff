@@ -70,6 +70,16 @@ The :meth:`~rich.console.Console.log` methods offers the same capabilities as pr
 To help with debugging, the log() method has a ``log_locals`` parameter. If you set this to ``True``, Rich will display a table of local variables where the method was called.
 
 
+Low level output
+----------------
+
+The :meth:`~rich.console.Console.out` method is a lower-level alternative to :meth:`~rich.console.Console.print` and :meth:`~rich.console.Console.log`. It converts each object to a plain string, joins them with ``sep``, and writes the result followed by ``end``. Here's an example::
+
+    console.out("foo", "bar", sep=", ", style="bold")
+
+Unlike print, :meth:`~rich.console.Console.out` does not pretty print containers, does not wrap or crop text, does not apply console markup, and does not replace emoji codes. It does apply highlighting by default (set ``highlight=False`` to turn it off) and accepts a basic ``style``.
+
+
 Justify / Alignment
 -------------------
 
diff --git a/rich/console.py b/rich/console.py
index 64d0109..e570263 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,41 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output low-level plain text to the console.
+
+        Unlike print, objects are converted with plain string conversion. No pretty printing,
+        word wrapping, cropping, markup, or emoji replacement is applied. Highlighting is
+        applied by default, and a basic style may be given.
+
+        Args:
+            objects (positional args): Objects to write, converted to strings and joined by ``sep``.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. ``True`` forces highlighting,
+                ``False`` disables it, and ``None`` uses the console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            end=end,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
