+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+    console.out(end="X")
+    assert console.file.getvalue() == "\nX"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] [b]")
+    assert console.file.getvalue() == "[bold]foo[/bold] [b]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smiley: :thumbs_up:")
+    assert console.file.getvalue() == ":smiley: :thumbs_up:\n"
+
+
+def test_out_containers():
+    console = Console(file=io.StringIO(), width=10)
+    console.out(list(range(30)))
+    assert console.file.getvalue() == str(list(range(30))) + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    console = Console(
+        file=io.StringIO(),
+        color_system="truecolor",
+        force_terminal=True,
+        width=80,
+        highlight=False,
+    )
+    console.out("1 2")
+    reference = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, width=80
+    )
+    reference.print("1 2", crop=False, no_wrap=True, overflow="ignore")
+    assert console.file.getvalue() == reference.file.getvalue()
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none():
+    console = Console(
+        file=io.StringIO(),
+        color_system="truecolor",
+        force_terminal=True,
+        width=80,
+        highlight=False,
+    )
+    console.out("1 2", highlight=None)
+    assert console.file.getvalue() == "1 2\n"
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, width=80
+    )
+    console.out("1 2", highlight=False)
+    assert console.file.getvalue() == "1 2\n"
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(_ReplaceHook())
+    console.out("foo")
+    console.pop_render_hook()
+    assert console.file.getvalue() == "replaced\n"
+
+
