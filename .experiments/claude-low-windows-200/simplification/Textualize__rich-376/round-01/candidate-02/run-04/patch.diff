diff --git a/rich/console.py b/rich/console.py
index 64d0109..541e102 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,43 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output to the terminal as plain text, without pretty printing.
+
+        This is a low-level alternative to print. Objects are converted to strings
+        and joined with ``sep``. The result is written as-is: no pretty printing,
+        no word wrapping, no cropping, no markup, and no emoji code replacement.
+        Output is passed through the normal print pipeline, so render hooks and
+        the buffer apply.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A basic style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. ``True`` forces highlighting,
+                ``False`` disables it, and ``None`` uses the console default. Defaults to ``True``.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
         *,
