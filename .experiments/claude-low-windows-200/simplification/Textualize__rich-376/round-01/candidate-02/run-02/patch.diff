diff --git a/rich/console.py b/rich/console.py
index 64d0109..157eda1 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,43 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: bool = True,
+    ) -> None:
+        """Output to the terminal as raw text (low level output).
+
+        Unlike print, objects are not pretty printed, wrapped, cropped, or subject
+        to markup or emoji replacement. Each object is converted to a string and
+        the results are joined with ``sep``. Highlighting and a basic style may
+        still be applied. Output still passes through the console buffer and render hooks.
+
+        Args:
+            objects (positional args): Objects to write as plain text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. ``True`` forces
+                highlighting, ``False`` disables it, and ``None`` uses the console default.
+                Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
