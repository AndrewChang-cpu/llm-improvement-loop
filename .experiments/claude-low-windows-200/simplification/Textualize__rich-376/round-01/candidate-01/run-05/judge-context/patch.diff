diff --git a/rich/console.py b/rich/console.py
index 64d0109..454a2a3 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,41 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output to the terminal as plain text, with optional highlighting and basic style.
+
+        Unlike print, objects are converted with ``str()`` and joined with ``sep``.
+        There is no pretty printing, word wrapping, cropping, markup, or emoji
+        replacement. Output is passed through print, so render hooks and the
+        buffer are used as normal.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A basic style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): True forces highlighting, False disables it, or ``None`` to use the console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
