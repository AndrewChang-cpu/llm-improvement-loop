diff --git a/rich/console.py b/rich/console.py
index 64d0109..ee9c01b 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,42 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output to the terminal as plain text, without pretty printing or wrapping.
+
+        Each object is converted to a string, joined with ``sep``, and written
+        followed by ``end``. Unlike print, the text is not pretty printed, is not
+        wrapped or cropped to the console width, and is not treated as markup or
+        emoji codes. Highlighting and basic style are still applied.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. True forces
+                highlighting, False disables it, or ``None`` to use console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
     def print_exception(
