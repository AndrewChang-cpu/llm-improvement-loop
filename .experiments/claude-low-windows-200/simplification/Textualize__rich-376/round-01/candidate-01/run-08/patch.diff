+def test_out():
+    console = Console(file=io.StringIO(), width=10, color_system="truecolor")
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_empty():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80, color_system="truecolor")
+    console.out("[bold]foo[/bold]", highlight=False)
+    assert console.file.getvalue() == "[bold]foo[/bold]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80, color_system="truecolor")
+    console.out(":smile:", highlight=False)
+    assert console.file.getvalue() == ":smile:\n"
+
+
+def test_out_container():
+    console = Console(file=io.StringIO(), width=80, color_system="truecolor")
+    console.out([1, "a"], highlight=False)
+    assert console.file.getvalue() == "[1, 'a']\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=5, color_system="truecolor")
+    console.out("foo bar baz", highlight=False)
+    assert console.file.getvalue() == "foo bar baz\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("1", highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_none():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("1", highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("1", highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+class _RecordingHook(RenderHook):
+    def __init__(self):
+        self.calls = 0
+
+    def process_renderables(self, renderables):
+        self.calls += 1
+        return renderables
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=80, color_system="truecolor")
+    hook = _RecordingHook()
+    console.push_render_hook(hook)
+    console.out("foo", highlight=False)
+    console.pop_render_hook()
+    assert hook.calls == 1
+    assert console.file.getvalue() == "foo\n"
+
+
