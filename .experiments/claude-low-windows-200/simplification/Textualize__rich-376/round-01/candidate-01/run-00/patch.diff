+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    result = console.out("foo bar", "baz", sep=".", end="X")
+    assert result is None
+    assert console.file.getvalue() == "foo bar.bazX"
+
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert (
+        console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+    )
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold]")
+    assert console.file.getvalue() == "[bold]foo[/bold]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smile:")
+    assert console.file.getvalue() == ":smile:\n"
+
+
+def test_out_container():
+    console = Console(file=io.StringIO(), width=80)
+    console.out([1, 2], {"a": 1})
+    assert console.file.getvalue() == "[1, 2] {'a': 1}\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    value = console.file.getvalue()
+    assert "\x1b[1m" in value
+    assert value.endswith("\n")
+
+
+def test_out_highlight_default():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("123")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("123", highlight=None)
+    assert "\x1b[" not in console.file.getvalue()
+
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("123", highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("123", highlight=False)
+    assert "\x1b[" not in console.file.getvalue()
+
+
+def test_out_render_hook():
+    class AddHook(RenderHook):
+        def process_renderables(self, renderables: List) -> List:
+            return list(renderables) + [Text("HOOKED")]
+
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(AddHook())
+    console.out("foo")
+    console.pop_render_hook()
+    assert "HOOKED" in console.file.getvalue()
+
+
