+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    result = console.out(*["foo bar"] * 5, sep=".", end="X")
+    assert result is None
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold]")
+    assert console.file.getvalue() == "[bold]foo[/bold]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("foo :smile:")
+    assert console.file.getvalue() == "foo :smile:\n"
+
+
+def test_out_container():
+    console = Console(file=io.StringIO(), width=80)
+    console.out([1, 2], {"a": 1})
+    assert console.file.getvalue() == "[1, 2] {'a': 1}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("a" * 30)
+    assert console.file.getvalue() == "a" * 30 + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, highlight=False
+    )
+    console.out("1")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, highlight=True
+    )
+    console.out("1", highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_none():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, highlight=False
+    )
+    console.out("1", highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, highlight=True
+    )
+    console.out("1", highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_render_hook():
+    class CountHook(RenderHook):
+        def __init__(self):
+            self.calls = 0
+
+        def process_renderables(self, renderables):
+            self.calls += 1
+            return renderables
+
+    hook = CountHook()
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(hook)
+    console.out("foo")
+    assert hook.calls == 1
+    assert console.file.getvalue() == "foo\n"
+
+
