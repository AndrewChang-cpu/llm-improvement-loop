+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] [red]bar[/]")
+    assert console.file.getvalue() == "[bold]foo[/bold] [red]bar[/]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(":smile: foo")
+    assert console.file.getvalue() == ":smile: foo\n"
+
+
+def test_out_container():
+    console = Console(file=io.StringIO(), width=80)
+    console.out([1, "a"], {"k": "v"})
+    assert console.file.getvalue() == "[1, 'a'] {'k': 'v'}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("0123456789ABCDEF")
+    assert console.file.getvalue() == "0123456789ABCDEF\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor", width=80)
+    console.out("foo", style="bold")
+    output = console.file.getvalue()
+    assert output.startswith("\x1b[1m") and "foo" in output
+    assert output.endswith("\x1b[0m\n")
+
+
+def test_out_highlight_default():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, width=80, highlight=False
+    )
+    console.out("1")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, width=80, highlight=True
+    )
+    console.out("1", highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_none():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, width=80, highlight=False
+    )
+    console.out("1", highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", force_terminal=True, width=80, highlight=True
+    )
+    console.out("1", highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_render_hook():
+    calls = []
+
+    class RecordingHook(RenderHook):
+        def process_renderables(self, renderables):
+            calls.append(list(renderables))
+            return [Text("hooked")]
+
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(RecordingHook())
+    result = console.out("foo")
+    assert result is None
+    assert len(calls) == 1
+    assert console.file.getvalue() == "hooked"
+
+
