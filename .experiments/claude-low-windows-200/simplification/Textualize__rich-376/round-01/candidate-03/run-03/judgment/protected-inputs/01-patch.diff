diff --git a/rich/console.py b/rich/console.py
index 64d0109..82ec7a2 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,41 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output to the terminal as plain text, without pretty printing, wrapping or markup.
+
+        Objects are converted to strings, joined with ``sep`` and written through
+        :meth:`print` with emoji and markup disabled, word wrapping disabled, and
+        cropping disabled. Highlighting is applied by default.
+
+        Args:
+            objects (positional args): Objects to output. Each is converted with ``str()``.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. Defaults to True,
+                or ``None`` to use the console default, or ``False`` to disable highlighting.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
