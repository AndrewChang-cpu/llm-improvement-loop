+def test_out():
+    console = Console(width=10, file=io.StringIO())
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_empty():
+    console = Console(file=io.StringIO())
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO())
+    assert console.out("foo") is None
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO())
+    console.out("[bold]foo[/bold] [red]bar")
+    assert console.file.getvalue() == "[bold]foo[/bold] [red]bar\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO())
+    console.out(":smiley: foo")
+    assert console.file.getvalue() == ":smiley: foo\n"
+
+
+def test_out_container():
+    console = Console(file=io.StringIO(), width=10)
+    console.out([1, 2, 3])
+    assert console.file.getvalue() == "[1, 2, 3]\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar baz egg")
+    assert console.file.getvalue() == "foo bar baz egg\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", highlight=False
+    )
+    console.out("'foo'")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", highlight=False
+    )
+    console.out("'foo'", highlight=None)
+    assert console.file.getvalue() == "'foo'\n"
+
+
+def test_out_highlight_none_console_enabled():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", highlight=True
+    )
+    console.out("'foo'", highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", highlight=True
+    )
+    console.out("'foo'", highlight=False)
+    assert console.file.getvalue() == "'foo'\n"
+
+
+class AppendHook(RenderHook):
+    def process_renderables(self, renderables):
+        return list(renderables) + [Text("HOOKED")]
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=20)
+    console.push_render_hook(AppendHook())
+    console.out("foo")
+    console.pop_render_hook()
+    assert console.file.getvalue() == "foo\nHOOKED\n"
+
+
