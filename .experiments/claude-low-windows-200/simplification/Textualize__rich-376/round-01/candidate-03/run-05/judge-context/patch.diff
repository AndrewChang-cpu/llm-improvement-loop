+def test_out():
+    console = Console(width=10, file=io.StringIO())
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_empty():
+    console = Console(file=io.StringIO())
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO())
+    assert console.out("foo") is None
+
+
+def test_out_markup():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] [red]bar[/red]")
+    assert console.file.getvalue() == "[bold]foo[/bold] [red]bar[/red]\n"
+
+
+def test_out_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("foo :smiley: bar")
+    assert console.file.getvalue() == "foo :smiley: bar\n"
+
+
+def test_out_container():
+    console = Console(file=io.StringIO(), width=80)
+    console.out([1, 2, 3])
+    assert console.file.getvalue() == "[1, 2, 3]\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar baz egg")
+    assert console.file.getvalue() == "foo bar baz egg\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        highlight=False,
+    )
+    console.out("1")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        highlight=False,
+    )
+    console.out("1", highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        highlight=True,
+    )
+    console.out("1", highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+class ReplaceHook(RenderHook):
+    def process_renderables(self, renderables):
+        return [Text("HOOKED")]
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(ReplaceHook())
+    console.out("foo")
+    output = console.file.getvalue()
+    assert "HOOKED" in output
+    assert "foo" not in output
+
+
