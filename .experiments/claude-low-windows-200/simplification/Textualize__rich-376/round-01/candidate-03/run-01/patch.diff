+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=10)
+    assert console.out("foo") is None
+
+
+def test_out_markup_and_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] :smile:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smile:\n"
+
+
+def test_out_container():
+    console = Console(file=io.StringIO(), width=80)
+    console.out(["a", "b"], {"k": 1})
+    assert console.file.getvalue() == "['a', 'b'] {'k': 1}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("x" * 30)
+    assert console.file.getvalue() == "x" * 30 + "\n"
+
+
+def test_out_style():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor"
+    )
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        highlight=False,
+    )
+    console.out("'foo'")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        highlight=True,
+    )
+    console.out("'foo'", highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        highlight=False,
+    )
+    console.out("'foo'", highlight=None)
+    assert console.file.getvalue() == "'foo'\n"
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        highlight=True,
+    )
+    console.out("'foo'", highlight=False)
+    assert console.file.getvalue() == "'foo'\n"
+
+
+class _PrefixHook(RenderHook):
+    def process_renderables(self, renderables):
+        return [Text("hooked ")] + list(renderables)
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(_PrefixHook())
+    console.out("foo")
+    assert console.file.getvalue() == "hooked foo\n"
+
+
