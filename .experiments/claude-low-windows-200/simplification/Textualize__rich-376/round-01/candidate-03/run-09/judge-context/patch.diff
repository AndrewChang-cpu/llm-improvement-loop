diff --git a/rich/console.py b/rich/console.py
index 64d0109..0cddb45 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1012,6 +1012,41 @@ class Console:
             self._buffer.append(Segment.control(str(control_codes)))
             self._check_buffer()
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output raw text to the console with low-level formatting.
+
+        Unlike print, objects are converted to strings and written as plain text:
+        no pretty printing, word wrapping, cropping, markup, or emoji replacement.
+        Highlighting is optional and a basic style may be applied.
+
+        Args:
+            objects (positional args): Objects to write, converted with ``str()``.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable highlighting. True forces highlighting,
+                False disables it, and None uses the console default. Defaults to True.
+        """
+        raw_output: str = sep.join(str(object) for object in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print(
         self,
         *objects: Any,
