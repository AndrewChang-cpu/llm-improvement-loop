diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..ddc0111
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,128 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+TRIPLE = (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "b"))
+
+INSERT_DATA = (
+    "PREFIX ex: <http://example.org/>\n"
+    "INSERT DATA { ex:a ex:p ex:b . ex:c ex:p ex:d }"
+)
+
+INSERT_THEN_DELETE = (
+    "PREFIX ex: <http://example.org/>\n"
+    "INSERT DATA { ex:a ex:p ex:b } ;\n"
+    "DELETE DATA { ex:c ex:p ex:d }"
+)
+
+
+def _snapshot(update):
+    return [[op.name, *str(op).splitlines()] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_applied_to_second_graph_gives_same_result():
+    prepared = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_application_is_idempotent():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_init_ns_prefixes_resolve_in_prepared_update():
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:p ex:b }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert TRIPLE in g
+
+
+def test_init_bindings_visible_to_prepared_update_operations():
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT { ?s ex:p ex:b } WHERE {}"
+    )
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef(EX + "a")})
+    assert TRIPLE in g
+
+
+def test_direct_evaluation_applies_prepared_update():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_non_empty_request_returns_update_container_in_request_order():
+    prepared = prepareUpdate(INSERT_THEN_DELETE)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert [op.name for op in prepared.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+
+def test_empty_request_evaluation_does_not_raise_or_change_graph():
+    g = Graph()
+    g.add(TRIPLE)
+    evalUpdate(g, translateUpdate(parseUpdate("")))
+    assert len(g) == 1
+
+
+def test_declarations_only_request_binds_declared_prefix_in_prologue():
+    update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "a") == URIRef(EX + "a")
+
+
+def test_declarations_only_request_leaves_graph_unchanged():
+    g = Graph()
+    g.add(TRIPLE)
+    g.update(prepareUpdate("PREFIX ex: <http://example.org/>"))
+    assert len(g) == 1
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.add(TRIPLE)
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_THEN_DELETE)
+    before = _snapshot(prepared)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    evalUpdate(g2, prepared)
+    g1.update(prepared)
+    assert _snapshot(prepared) == before
+    assert len(prepared.algebra) == 2
