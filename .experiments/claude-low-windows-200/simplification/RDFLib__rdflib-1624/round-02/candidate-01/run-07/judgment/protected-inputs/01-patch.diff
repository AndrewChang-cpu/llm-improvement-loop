diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..63fc548
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,136 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:a ex:p ex:b . ex:c ex:p ex:d . }
+"""
+
+INSERT_TWO_OPERATIONS = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:a ex:p ex:b . } ;
+INSERT DATA { ex:c ex:p ex:d . }
+"""
+
+
+def _algebra_snapshot(update):
+    return [(op.name, repr(op).splitlines()) for op in update.algebra]
+
+
+class TestPrepareUpdate(unittest.TestCase):
+    def test_prepare_then_update_inserts_triples(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_reused_across_graphs(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(set(g1), set(g2))
+        self.assertEqual(len(g2), 2)
+
+    def test_prepared_update_repeated_on_one_graph_is_idempotent(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_init_ns_resolves_prefixes_in_update(self):
+        prepared = prepareUpdate(
+            "INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": "urn:ex:"}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn(
+            (URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b")), g
+        )
+
+    def test_init_bindings_visible_to_update_operations(self):
+        prepared = prepareUpdate("PREFIX ex: <urn:ex:> INSERT { ?s ex:p ?o } WHERE { }")
+        g = Graph()
+        g.update(
+            prepared,
+            initBindings={"s": URIRef("urn:ex:a"), "o": Literal("b")},
+        )
+        self.assertIn((URIRef("urn:ex:a"), URIRef("urn:ex:p"), Literal("b")), g)
+
+    def test_direct_evaluation_applies_prepared_update(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_direct_evaluation_with_graph_and_bindings(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared, {})
+        self.assertEqual(len(g), 2)
+
+    def test_non_empty_request_returns_update_container(self):
+        prepared = prepareUpdate(INSERT_TWO_OPERATIONS)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(len(prepared.algebra), 2)
+        self.assertEqual([op.name for op in prepared.algebra], ["InsertData"] * 2)
+
+    def test_prepare_records_original_arguments(self):
+        prepared = prepareUpdate(INSERT_TWO, {"ex": "urn:ex:"}, None)
+        self.assertEqual(prepared._original_args, (INSERT_TWO, {"ex": "urn:ex:"}, None))
+
+    def test_empty_request_translates_to_empty_container(self):
+        prepared = translateUpdate(parseUpdate(""))
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+
+    def test_empty_request_evaluates_without_error(self):
+        prepared = prepareUpdate("")
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request_binds_prefix_in_prologue(self):
+        prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+        self.assertEqual(prepared.algebra, [])
+        self.assertEqual(prepared.prologue.resolvePName("ex", "x"), URIRef("urn:ex:x"))
+
+    def test_declarations_only_request_leaves_graph_unchanged(self):
+        g = Graph()
+        g.update(prepareUpdate("PREFIX ex: <urn:ex:>"))
+        self.assertEqual(len(g), 0)
+
+    def test_update_does_not_mutate_prepared_algebra(self):
+        prepared = prepareUpdate(INSERT_TWO_OPERATIONS)
+        before = _algebra_snapshot(prepared)
+        algebra_list = prepared.algebra
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(_algebra_snapshot(prepared), before)
+        self.assertIs(prepared.algebra, algebra_list)
+        self.assertEqual(len(prepared.algebra), 2)
+
+
+class TestProcessUpdateEmptyString(unittest.TestCase):
+    def test_empty_update_string_leaves_graph_unchanged_via_process_update(self):
+        g = Graph()
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_leaves_graph_unchanged_via_graph_update(self):
+        g = Graph()
+        g.update("")
+        self.assertEqual(len(g), 0)
