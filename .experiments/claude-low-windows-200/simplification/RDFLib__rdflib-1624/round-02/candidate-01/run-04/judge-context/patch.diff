diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..701ffb9
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,123 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _algebra_snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applies_through_graph_update():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(update)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs():
+    update = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(update)
+    g2.update(update)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_application_is_idempotent():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(update)
+    g.update(update)
+    assert len(g) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    update = prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(update)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 2
+
+
+def test_prepared_update_init_bindings_visible_to_operations():
+    update = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+    g = Graph()
+    g.update(update, initBindings={"s": URIRef("urn:s")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    update = prepareUpdate(INSERT_TWO)
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 1
+    assert update.algebra[0].name == "InsertData"
+
+
+def test_prepared_update_keeps_original_arguments():
+    update = prepareUpdate(INSERT_TWO, initNs={"ex": "urn:ex:"}, base=None)
+    assert update._original_args == (INSERT_TWO, {"ex": "urn:ex:"}, None)
+
+
+def test_empty_request_translates_to_empty_update_container():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+
+def test_empty_request_evaluation_does_not_raise():
+    update = translateUpdate(parseUpdate(""))
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    update = prepareUpdate("PREFIX ex: <urn:ex:>\n")
+    assert isinstance(update, Update)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+
+
+def test_declarations_only_request_leaves_graph_unchanged():
+    update = prepareUpdate("PREFIX ex: <urn:ex:>\nBASE <urn:base:>\n")
+    g = Graph()
+    g.update(update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    update = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(update)
+    g = Graph()
+    g.update(update)
+    g.update(update)
+    assert _algebra_snapshot(update) == before
