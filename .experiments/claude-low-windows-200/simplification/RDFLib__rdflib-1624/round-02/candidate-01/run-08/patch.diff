diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..ad88553
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,135 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_DATA = "INSERT DATA { ex:a ex:p ex:o . ex:b ex:p ex:o . }"
+
+
+def _snapshot(prepared):
+    return [[op.name, str(op)] for op in prepared.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_reused_across_graphs():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_on_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_init_ns_prefix_resolves_in_prepared_update():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_init_bindings_visible_to_prepared_update_operations():
+    prepared = prepareUpdate("INSERT { ?s ?p ?o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={
+            "s": URIRef(EX + "a"),
+            "p": URIRef(EX + "p"),
+            "o": URIRef(EX + "o"),
+        },
+    )
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_without_error():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 1
+    assert prepared._original_args == (INSERT_DATA, {"ex": EX}, None)
+
+
+def test_prepared_update_container_shape_with_two_operations():
+    prepared = prepareUpdate("INSERT DATA { <urn:a> <urn:p> <urn:o> } ; CLEAR DEFAULT")
+    assert [op.name for op in prepared.algebra] == ["InsertData", "Clear"]
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+
+def test_empty_request_evaluation_does_not_raise():
+    prepared = prepareUpdate("")
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "a") == URIRef(EX + "a")
+
+
+def test_declarations_only_request_evaluation_leaves_graph_unchanged():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "o")))
+    g.update(prepared)
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "o")))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "o")))
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    before = _snapshot(prepared)
+    algebra_before = list(prepared.algebra)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert _snapshot(prepared) == before
+    assert all(a is b for a, b in zip(prepared.algebra, algebra_before))
