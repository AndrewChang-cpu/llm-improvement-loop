diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..4c66673
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,125 @@
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _snapshot(algebra):
+    return [[op.name, repr(dict(op))] for op in algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_on_same_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    g.update(prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": EX}))
+    assert (EX.s, EX.p, EX.o) in g
+
+
+def test_prepared_update_passes_init_bindings_to_operations():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT { ?s ex:p ?v } WHERE { }",
+        initNs={"ex": EX},
+    )
+    g.update(prepared, initBindings={"s": EX.subj, "v": Literal(1)})
+    assert (EX.subj, EX.p, Literal(1)) in g
+
+
+def test_direct_evaluation_of_prepared_update_applies_operations():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_non_empty_update_container_shape():
+    ret = prepareUpdate(INSERT_TWO)
+    assert isinstance(ret, Update)
+    assert isinstance(ret.prologue, Prologue)
+    assert len(ret.algebra) == 1
+    assert ret.algebra[0].name == "InsertData"
+
+
+def test_empty_update_string_translates_to_empty_container():
+    ret = prepareUpdate("")
+    assert isinstance(ret, Update)
+    assert isinstance(ret.prologue, Prologue)
+    assert ret.algebra == []
+
+
+def test_empty_update_evaluation_does_not_raise():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(""))
+    assert len(g) == 0
+
+
+def test_declarations_only_update_binds_prefix_and_runs_nothing():
+    ret = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(ret, Update)
+    assert ret.algebra == []
+    assert "ex" in dict(ret.prologue.namespace_manager.namespaces())
+
+    g = Graph()
+    evalUpdate(g, ret)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, EX.o))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, EX.o))
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(
+        """
+        PREFIX ex: <http://example.org/>
+        INSERT DATA { ex:s ex:p ex:o . }
+        DELETE DATA { ex:s ex:p ex:o2 . }
+        """
+    )
+    before = _snapshot(prepared.algebra)
+    g = Graph()
+    evalUpdate(g, prepared)
+    evalUpdate(g, prepared)
+    assert _snapshot(prepared.algebra) == before
+    assert len(prepared.algebra) == 2
+    assert all(isinstance(op.name, str) for op in prepared.algebra)
