diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..8222692
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,107 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+INSERT_TWO = (
+    "INSERT DATA { <http://example.org/a> <http://example.org/p> "
+    "<http://example.org/b> . <http://example.org/c> <http://example.org/p> "
+    "<http://example.org/d> }"
+)
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepared_update_through_graph_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_applied_to_second_graph_gives_same_result():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_on_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_initns_prefix_resolves_in_update():
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:p ex:b }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "b")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_without_error():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_nonempty_request():
+    prepared = prepareUpdate(
+        "INSERT DATA { <http://example.org/a> <http://example.org/p> "
+        "<http://example.org/b> } ; "
+        "INSERT DATA { <http://example.org/c> <http://example.org/p> "
+        "<http://example.org/d> }"
+    )
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert [op.name for op in prepared.algebra] == ["InsertData", "InsertData"]
+
+
+def test_prepared_update_empty_request_has_empty_algebra_and_no_error():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepared_update_declarations_only_binds_prefix_and_leaves_graph():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.namespace_manager.store.namespace("ex") == URIRef(EX)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g = Graph()
+    evalUpdate(g, prepared)
+    g.update(prepared)
+    assert _snapshot(prepared) == before
