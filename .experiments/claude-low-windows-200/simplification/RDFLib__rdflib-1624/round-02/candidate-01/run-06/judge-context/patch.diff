diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..af4a7ec
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,113 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+    <urn:s> <urn:p> <urn:o1> .
+    <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    u = prepareUpdate(INSERT_TWO)
+    g.update(u)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    u = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(u)
+    g2 = Graph()
+    g2.update(u)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(u)
+    assert len(g1) == 2
+
+
+def test_init_ns_prefixes_resolve_at_prepare_time():
+    g = Graph()
+    u = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }",
+        initNs={"ex": "http://example.org/"},
+    )
+    g.update(u)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/o"),
+    ) in g
+
+
+def test_init_bindings_passed_to_graph_update_are_visible():
+    g = Graph()
+    u = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+    g.update(u, initBindings={"s": URIRef("urn:subject")})
+    assert (URIRef("urn:subject"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_direct_evaluation_of_prepared_update_applies_it():
+    g = Graph()
+    u = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, u)
+    assert len(g) == 2
+
+
+def test_non_empty_request_container_shape():
+    u = prepareUpdate(
+        """
+        INSERT DATA { <urn:s> <urn:p> <urn:o> . } ;
+        DELETE DATA { <urn:s> <urn:p> <urn:o> . }
+        """
+    )
+    assert isinstance(u, Update)
+    assert isinstance(u.prologue, Prologue)
+    assert [op.name for op in u.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_translates_to_empty_update():
+    g = Graph()
+    u = prepareUpdate("")
+    assert isinstance(u, Update)
+    assert isinstance(u.prologue, Prologue)
+    assert u.algebra == []
+    evalUpdate(g, u)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    g = Graph()
+    u = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert u.algebra == []
+    assert u.prologue.resolvePName("ex", "x") == URIRef("http://example.org/x")
+    evalUpdate(g, u)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    u = prepareUpdate(INSERT_TWO)
+    before = _snapshot(u)
+    g1 = Graph()
+    g1.update(u)
+    g1.update(u)
+    evalUpdate(Graph(), u)
+    assert _snapshot(u) == before
