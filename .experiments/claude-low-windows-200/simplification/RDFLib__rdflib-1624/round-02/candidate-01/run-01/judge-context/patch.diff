diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..656be8f
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,118 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+    <urn:s1> <urn:p> <urn:o1> .
+    <urn:s2> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _algebra_snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o }",
+        initNs={"ex": "http://example.org/"},
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/o"),
+    ) in g
+
+
+def test_prepared_update_applies_initial_bindings():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:subject")})
+    assert (URIRef("urn:subject"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_empty_request_translates_to_empty_update_container():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "x") == URIRef(
+        "http://example.org/x"
+    )
+
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_and_process_update_is_noop():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+    list_before = prepared.algebra
+
+    g = Graph()
+    g.update(prepared)
+
+    assert _algebra_snapshot(prepared) == before
+    assert prepared.algebra is list_before
