diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..1f2d474
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,115 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "urn:ex:"
+
+INSERT_TWO = (
+    "INSERT DATA { <urn:ex:a> <urn:ex:p> <urn:ex:b> . "
+    "<urn:ex:c> <urn:ex:p> <urn:ex:d> . }"
+)
+
+INSERT_PREFIXED = "INSERT DATA { ex:a ex:p ex:b . ex:c ex:p ex:d . }"
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepare_then_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert set(g1) == set(g2)
+    assert len(g2) == 2
+
+
+def test_prepared_update_repeated_application_is_idempotent():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_init_ns_prefixes_resolve_in_prepared_update():
+    prepared = prepareUpdate(INSERT_PREFIXED, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "b")) in g
+    assert (URIRef(EX + "c"), URIRef(EX + "p"), URIRef(EX + "d")) in g
+
+
+def test_init_bindings_visible_to_prepared_update():
+    prepared = prepareUpdate("INSERT { ?s <urn:ex:p> ?o } WHERE { }")
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={"s": URIRef(EX + "a"), "o": Literal("v")},
+    )
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), Literal("v")) in g
+
+
+def test_direct_evaluation_of_prepared_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(INSERT_TWO + " ; " + INSERT_PREFIXED, initNs={"ex": EX})
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 2
+    assert all(op.name == "InsertData" for op in prepared.algebra)
+    assert prepared._original_args[1] == {"ex": EX}
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    evalUpdate(Graph(), update)
+
+
+def test_declarations_only_request_keeps_declared_prefix():
+    update = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert isinstance(update, Update)
+    assert update.algebra == []
+    assert str(update.prologue.resolvePName("ex", "a")) == EX + "a"
+
+
+def test_declarations_only_request_evaluates_without_change():
+    g = Graph()
+    g.update("PREFIX ex: <urn:ex:>")
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g = Graph()
+    evalUpdate(g, prepared)
+    g.update(prepared)
+    assert _snapshot(prepared) == before
