diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..4eff84c
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,120 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql.processor import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> "a" .
+  <urn:s> <urn:p> "b" .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    u = prepareUpdate(INSERT_TWO)
+    g.update(u)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    u = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(u)
+    g2 = Graph()
+    g2.update(u)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(u)
+    assert len(g1) == 2
+
+
+def test_init_ns_prefixes_resolve_inside_prepared_update():
+    u = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(u)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_evaluated_directly_with_graph():
+    u = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, u)
+    assert len(g) == 2
+
+
+def test_initial_bindings_visible_to_prepared_update_operations():
+    u = prepareUpdate("INSERT { ?s <urn:p> ?o } WHERE { }")
+    g = Graph()
+    g.update(u, initBindings={"s": URIRef("urn:s"), "o": Literal("x")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("x")) in g
+
+
+def test_non_empty_request_returns_update_container_in_request_order():
+    u = prepareUpdate(
+        "INSERT DATA { <urn:s> <urn:p> <urn:o> } ; "
+        "DELETE DATA { <urn:s> <urn:p> <urn:o> }"
+    )
+    assert isinstance(u, Update)
+    assert isinstance(u.prologue, Prologue)
+    assert [op.name for op in u.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    u = prepareUpdate("")
+    assert isinstance(u, Update)
+    assert isinstance(u.prologue, Prologue)
+    assert u.algebra == []
+
+
+def test_empty_request_evaluation_raises_nothing_and_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), Literal("kept")))
+    before = set(g)
+    evalUpdate(g, prepareUpdate(""))
+    assert set(g) == before
+
+
+def test_declarations_only_request_binds_prefix_and_has_no_operations():
+    u = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(u, Update)
+    assert u.algebra == []
+    assert u.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+
+
+def test_declarations_only_request_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), Literal("kept")))
+    before = set(g)
+    g.update(prepareUpdate("PREFIX ex: <urn:ex:> BASE <urn:base:>"))
+    assert set(g) == before
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), Literal("kept")))
+    before = set(g)
+    g.update("")
+    processUpdate(g, "")
+    assert set(g) == before
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    u = prepareUpdate(
+        INSERT_TWO
+        + "; DELETE DATA { <urn:s> <urn:p> \"b\" }"
+        + "; INSERT { ?s <urn:q> ?o } WHERE { ?s <urn:p> ?o }"
+    )
+    before = _snapshot(u)
+    g = Graph()
+    g.update(u)
+    g.update(u)
+    assert _snapshot(u) == before
