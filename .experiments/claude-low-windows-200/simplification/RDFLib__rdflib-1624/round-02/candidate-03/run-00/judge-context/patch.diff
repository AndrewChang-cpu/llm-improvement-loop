diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..7a9d7c3
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,149 @@
+import unittest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareQuery, prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+def _algebra_repr(update):
+    return [f"{op.name}:{repr(op)}" for op in update.algebra]
+
+
+class TestPrepareUpdate(unittest.TestCase):
+    def test_prepared_insert_data_applied_through_graph_update(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_reused_across_graphs(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(set(g1), set(g2))
+
+    def test_prepared_update_applied_twice_is_idempotent(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_init_ns_prefixes_resolve_in_prepared_update(self):
+        prepared = prepareUpdate(
+            'INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": str(EX)}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((EX.s, EX.p, Literal("a")), g)
+
+    def test_init_bindings_visible_to_prepared_update(self):
+        prepared = prepareUpdate(
+            "INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": str(EX)}
+        )
+        g = Graph()
+        g.update(
+            prepared,
+            initBindings={"s": EX.subject, "o": Literal("bound")},
+        )
+        self.assertIn((EX.subject, EX.p, Literal("bound")), g)
+
+    def test_direct_evaluation_of_prepared_update(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_direct_evaluation_with_init_bindings_does_not_raise(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared, {})
+        self.assertEqual(len(g), 2)
+
+    def test_non_empty_request_container_shape(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(len(prepared.algebra), 1)
+        self.assertEqual(prepared.algebra[0].name, "InsertData")
+
+    def test_translate_update_returns_container_with_one_entry_per_operation(self):
+        update_str = """
+        PREFIX ex: <http://example.org/>
+        INSERT DATA { ex:a ex:p "1" . } ;
+        DELETE DATA { ex:a ex:p "1" . }
+        """
+        translated = translateUpdate(parseUpdate(update_str))
+        self.assertIsInstance(translated, Update)
+        self.assertIsInstance(translated.prologue, Prologue)
+        self.assertEqual(
+            [op.name for op in translated.algebra], ["InsertData", "DeleteData"]
+        )
+
+    def test_empty_request_yields_empty_algebra(self):
+        prepared = prepareUpdate("")
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(list(prepared.algebra), [])
+
+    def test_empty_request_evaluates_without_error(self):
+        prepared = prepareUpdate("")
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request_binds_declared_prefix(self):
+        prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+        self.assertIsInstance(prepared, Update)
+        self.assertEqual(list(prepared.algebra), [])
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(
+            prepared.prologue.namespace_manager.store.namespace("ex"),
+            URIRef("http://example.org/"),
+        )
+
+    def test_declarations_only_request_leaves_graph_unchanged(self):
+        prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_graph_update_leaves_graph_unchanged(self):
+        g = Graph()
+        g.update("")
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_process_update_leaves_graph_unchanged(self):
+        g = Graph()
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_container(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        before = _algebra_repr(prepared)
+        g1 = Graph()
+        g2 = Graph()
+        evalUpdate(g1, prepared)
+        g2.update(prepared)
+        self.assertEqual(_algebra_repr(prepared), before)
+
+    def test_prepare_query_still_works(self):
+        q = prepareQuery("SELECT ?s WHERE { ?s ?p ?o }")
+        self.assertEqual(q.algebra.name, "SelectQuery")
+
+
+if __name__ == "__main__":
+    unittest.main()
