diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..0385f15
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,105 @@
+from rdflib import Graph, URIRef, Literal
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _algebra_snapshot(prepared):
+    return [[op.name, str(op)] for op in prepared.algebra]
+
+
+def test_prepare_update_then_apply_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepare_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_passes_init_bindings_to_operations():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE {}")
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:subj")})
+    assert (URIRef("urn:subj"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_evaluate_prepared_update_directly_with_graph():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_evaluate_prepared_update_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+    g = Graph()
+    evalUpdate(g, prepared)
+    g.update(prepared)
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(
+        "INSERT DATA { <urn:a> <urn:b> <urn:c> } ; "
+        "DELETE DATA { <urn:a> <urn:b> <urn:c> }"
+    )
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 2
+    assert [op.name for op in prepared.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_prepared_empty_request_has_empty_algebra_and_no_op():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepared_declarations_only_request_binds_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    assert str(prepared.prologue.namespace_manager.store.namespace("ex")) == "urn:ex:"
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:a"), URIRef("urn:b"), Literal("c")))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:a"), URIRef("urn:b"), Literal("c")))
+    processUpdate(g, "PREFIX ex: <urn:ex:>")
+    assert len(g) == 1
