diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..023970c
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,109 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = 'INSERT DATA { <urn:s1> <urn:p> "a" . <urn:s2> <urn:p> "b" . }'
+INSERT_ONE = 'INSERT DATA { <urn:s1> <urn:p> "a" . }'
+TWO_OPERATIONS = (
+    'INSERT DATA { <urn:s1> <urn:p> "a" } ; INSERT DATA { <urn:s2> <urn:p> "b" }'
+)
+
+
+def _describe_algebra(algebra):
+    return ["%s: %s" % (op.name, str(op)) for op in algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_initns_prefixes():
+    prepared = prepareUpdate('INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": "urn:"})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("a")) in g
+
+
+def test_prepared_update_initial_bindings_are_visible_to_operations():
+    prepared = prepareUpdate('INSERT { ?s <urn:p> "x" } WHERE { }')
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:s")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("x")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_non_empty_request_translates_to_update_container():
+    upd = translateUpdate(parseUpdate(TWO_OPERATIONS))
+    assert isinstance(upd, Update)
+    assert isinstance(upd.prologue, Prologue)
+    assert [op.name for op in upd.algebra] == ["InsertData", "InsertData"]
+
+
+def test_empty_request_translates_to_empty_update_container():
+    upd = translateUpdate(parseUpdate(""))
+    assert isinstance(upd, Update)
+    assert isinstance(upd.prologue, Prologue)
+    assert upd.algebra == []
+
+    g = Graph()
+    evalUpdate(g, upd)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix_without_operations():
+    upd = translateUpdate(parseUpdate("PREFIX ex: <urn:>"))
+    assert isinstance(upd.prologue, Prologue)
+    assert upd.algebra == []
+    assert upd.prologue.resolvePName("ex", "x") == URIRef("urn:x")
+
+    g = Graph()
+    evalUpdate(g, upd)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    upd = prepareUpdate(TWO_OPERATIONS)
+    before = _describe_algebra(upd.algebra)
+    g1 = Graph()
+    g2 = Graph()
+    evalUpdate(g1, upd)
+    evalUpdate(g2, upd)
+    assert _describe_algebra(upd.algebra) == before
+    assert len(upd.algebra) == 2
