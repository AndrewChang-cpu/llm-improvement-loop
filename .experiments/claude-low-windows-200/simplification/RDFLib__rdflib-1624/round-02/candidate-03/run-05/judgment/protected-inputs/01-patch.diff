diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..fb86e36
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,125 @@
+from rdflib import Graph, URIRef, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+def _algebra_repr(update):
+    return [f"{op.name} {str(op)}" for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_initns_prefixes():
+    prepared = prepareUpdate(
+        'INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": "http://example.org/"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (EX.s, EX.p, Literal("a")) in g
+
+
+def test_prepared_update_receives_initial_bindings():
+    prepared = prepareUpdate("INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared, initBindings={"s": EX.s, "o": Literal("v")})
+    assert (EX.s, EX.p, Literal("v")) in g
+
+
+def test_prepared_update_evaluated_directly():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_shape_for_nonempty_request():
+    prepared = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_prepared_update_algebra_is_not_mutated_by_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_repr(prepared)
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    evalUpdate(g2, prepared)
+    assert _algebra_repr(prepared) == before
+
+
+def test_empty_request_translates_to_empty_update():
+    prepared = translateUpdate(parseUpdate(""))
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+
+def test_empty_request_evaluates_without_error():
+    prepared = prepareUpdate("")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.namespace_manager.store.namespace("ex") == URIRef(
+        "http://example.org/"
+    )
+
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, Literal("keep")))
+    before = set(g)
+    g.update("")
+    assert set(g) == before
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, Literal("keep")))
+    before = set(g)
+    processUpdate(g, "")
+    assert set(g) == before
