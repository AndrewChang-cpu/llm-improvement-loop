diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..81a26f2
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,136 @@
+from typing import List
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql.processor import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o . ex:s ex:p ex:o2 . }
+"""
+
+
+def _snapshot(update: Update) -> List[str]:
+    return [f"{op.name}: {op}" for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_prefixes_from_init_ns() -> None:
+    prepared = prepareUpdate(
+        "INSERT DATA { x:s x:p x:o . }", initNs={"x": "http://example.org/"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (EX["s"], EX["p"], EX["o"]) in g
+
+
+def test_prepared_update_initial_bindings_are_visible_to_operations() -> None:
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT { ?s ex:p ex:o } WHERE { }"
+    )
+    g = Graph()
+    g.update(prepared, initBindings={"s": EX["subj"]})
+    assert (EX["subj"], EX["p"], EX["o"]) in g
+
+
+def test_prepared_update_direct_evaluation_applies_without_error() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_prepared_update_container_has_one_entry_per_operation_in_order() -> None:
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> "
+        "CLEAR DEFAULT ; INSERT DATA { ex:a ex:b ex:c }"
+    )
+    assert [op.name for op in prepared.algebra] == ["Clear", "InsertData"]
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert _snapshot(prepared) == before
+
+
+def test_empty_request_translates_to_update_with_empty_algebra() -> None:
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+
+def test_empty_request_evaluation_does_not_raise() -> None:
+    prepared = prepareUpdate("")
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix() -> None:
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "thing") == URIRef(
+        "http://example.org/thing"
+    )
+
+
+def test_declarations_only_request_leaves_graph_unchanged() -> None:
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    g = Graph()
+    g.add((EX["s"], EX["p"], Literal("keep")))
+    before = set(g)
+    g.update(prepared)
+    assert set(g) == before
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged() -> None:
+    g = Graph()
+    g.add((EX["s"], EX["p"], EX["o"]))
+    before = set(g)
+    g.update("")
+    assert set(g) == before
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged() -> None:
+    g = Graph()
+    g.add((EX["s"], EX["p"], EX["o"]))
+    before = set(g)
+    processUpdate(g, "")
+    assert set(g) == before
