diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..79a6ffb
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,103 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_DATA = "INSERT DATA { <urn:a> <urn:p> <urn:b> . <urn:a> <urn:p> <urn:c> }"
+
+
+def _algebra_snapshot(update):
+    return [str(op) for op in update.algebra]
+
+
+class TestPrepareUpdate(unittest.TestCase):
+    def test_prepared_update_applied_through_graph_update(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_reused_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_prefixes_resolve_inside_update(self):
+        prepared = prepareUpdate(
+            "INSERT DATA { ex:a ex:p ex:b }", initNs={"ex": "urn:ex:"}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b")), g)
+
+    def test_init_bindings_passed_to_graph_update_are_visible(self):
+        prepared = prepareUpdate("INSERT { ?s <urn:p> ?o } WHERE { }")
+        g = Graph()
+        g.update(
+            prepared,
+            initBindings={"s": URIRef("urn:s"), "o": Literal("value")},
+        )
+        self.assertIn((URIRef("urn:s"), URIRef("urn:p"), Literal("value")), g)
+
+    def test_direct_evaluation_applies_prepared_update(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape_for_non_empty_request(self):
+        prepared = prepareUpdate(
+            "INSERT DATA { <urn:a> <urn:p> <urn:b> } ; "
+            "INSERT DATA { <urn:c> <urn:p> <urn:d> }"
+        )
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(len(prepared.algebra), 2)
+        self.assertEqual([op.name for op in prepared.algebra], ["InsertData"] * 2)
+
+    def test_empty_request_yields_empty_container_and_evaluates_silently(self):
+        prepared = prepareUpdate("")
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+
+        g = Graph()
+        g.update(prepared)
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request_binds_prefix_in_prologue(self):
+        prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+        self.assertEqual(prepared.prologue.resolvePName("ex", "x"), URIRef("urn:ex:x"))
+
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_container(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        before = _algebra_snapshot(prepared)
+        g = Graph()
+        g.update(prepared)
+        g.update(prepared)
+        self.assertEqual(_algebra_snapshot(prepared), before)
+
+    def test_empty_update_string_through_process_update_leaves_graph_unchanged(self):
+        g = Graph()
+        g.add((URIRef("urn:a"), URIRef("urn:p"), Literal("x")))
+        before = set(g)
+        processUpdate(g, "")
+        self.assertEqual(set(g), before)
