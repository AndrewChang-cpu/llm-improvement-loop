diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..dc9b499
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,112 @@
+from rdflib import Graph, Literal, URIRef, Variable
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_TWO = (
+    "INSERT DATA { <http://example.org/a> <http://example.org/p> 'x' . "
+    "<http://example.org/b> <http://example.org/p> 'y' . }"
+)
+
+
+def _algebra_snapshot(update):
+    return [str(op) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_two_graphs():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_applied_twice_to_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_resolves_initns_prefix():
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:p 'x' . }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), Literal("x")) in g
+
+
+def test_prepared_update_direct_evaluation_with_evalUpdate():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_receives_init_bindings_from_graph_update():
+    prepared = prepareUpdate("INSERT { ?s <http://example.org/p> 'x' } WHERE { }")
+    g = Graph()
+    subject = URIRef(EX + "a")
+    g.update(prepared, initBindings={Variable("s"): subject})
+    assert (subject, URIRef(EX + "p"), Literal("x")) in g
+
+
+def test_prepared_update_container_has_prologue_and_algebra_list():
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 2
+    assert [op.name for op in prepared.algebra] == ["InsertData", "InsertData"]
+
+
+def test_translate_update_empty_request_returns_container_with_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    update = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(update, Update)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "a") == URIRef(EX + "a")
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), Literal("x")))
+    before = set(g)
+    g.update("")
+    assert set(g) == before
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), Literal("x")))
+    before = set(g)
+    processUpdate(g, "")
+    assert set(g) == before
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    assert _algebra_snapshot(prepared) == before
