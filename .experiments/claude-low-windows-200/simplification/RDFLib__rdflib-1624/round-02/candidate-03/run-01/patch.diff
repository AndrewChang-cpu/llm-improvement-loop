diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..945039e
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,113 @@
+import unittest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+def algebra_snapshot(update: Update) -> list:
+    return [f"{op.name}:{op}" for op in update.algebra]
+
+
+class SPARQLPrepareUpdateTests(unittest.TestCase):
+    def test_prepare_then_apply_through_graph_update(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_reused_across_graphs(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(set(g1), set(g2))
+
+    def test_prepared_update_applied_twice_to_one_graph_is_idempotent(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_init_ns_prefix_resolves_in_prepared_update(self) -> None:
+        prepared = prepareUpdate('INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": EX})
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((EX["s"], EX["p"], Literal("a")), g)
+
+    def test_init_bindings_visible_to_operations(self) -> None:
+        prepared = prepareUpdate("INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": EX})
+        g = Graph()
+        g.update(prepared, initBindings={"s": EX["s"], "o": Literal("v")})
+        self.assertIn((EX["s"], EX["p"], Literal("v")), g)
+
+    def test_direct_evaluation_with_evalUpdate(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape_for_non_empty_request(self) -> None:
+        update = translateUpdate(parseUpdate(INSERT_TWO))
+        self.assertIsInstance(update, Update)
+        self.assertIsInstance(update.prologue, Prologue)
+        self.assertEqual(len(update.algebra), 1)
+        self.assertEqual(update.algebra[0].name, "InsertData")
+
+    def test_empty_request_yields_empty_algebra(self) -> None:
+        update = translateUpdate(parseUpdate(""))
+        self.assertIsInstance(update, Update)
+        self.assertIsInstance(update.prologue, Prologue)
+        self.assertEqual(list(update.algebra), [])
+        evalUpdate(Graph(), update)
+
+    def test_declarations_only_request_binds_prefix_in_prologue(self) -> None:
+        update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+        self.assertIsInstance(update, Update)
+        self.assertEqual(list(update.algebra), [])
+        self.assertIsInstance(update.prologue, Prologue)
+        self.assertEqual(
+            update.prologue.resolvePName("ex", "s"), URIRef("http://example.org/s")
+        )
+
+    def test_declarations_only_request_leaves_graph_unchanged(self) -> None:
+        g = Graph()
+        g.update(prepareUpdate("PREFIX ex: <http://example.org/>"))
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_graph_update_is_noop(self) -> None:
+        g = Graph()
+        g.update("")
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_process_update_is_noop(self) -> None:
+        g = Graph()
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_container(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        before_algebra = algebra_snapshot(prepared)
+        before_prologue = prepared.prologue
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(algebra_snapshot(prepared), before_algebra)
+        self.assertIs(prepared.prologue, before_prologue)
+
+
+if __name__ == "__main__":
+    unittest.main()
