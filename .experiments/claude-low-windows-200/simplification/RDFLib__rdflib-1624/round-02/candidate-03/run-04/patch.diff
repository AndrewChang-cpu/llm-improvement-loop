diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..8f289f2
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,123 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = "INSERT DATA { <urn:s1> <urn:p> <urn:o1> . <urn:s2> <urn:p> <urn:o2> . }"
+
+
+def _snapshot(prepared):
+    return [f"{op.name}: {op}" for op in prepared.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_init_ns_resolves_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }",
+        initNs={"ex": "http://example.org/"},
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/o"),
+    ) in g
+
+
+def test_prepared_update_receives_init_bindings_through_graph_update():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:s")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_without_error():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_update_container_has_prologue_and_algebra_per_operation():
+    u = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(u, Update)
+    assert isinstance(u.prologue, Prologue)
+    assert isinstance(u.algebra, list)
+    assert len(u.algebra) == 1
+    assert u.algebra[0].name == "InsertData"
+
+
+def test_translated_update_container_keeps_operation_order():
+    u = translateUpdate(
+        parseUpdate(
+            "INSERT DATA { <urn:a> <urn:p> <urn:o> } ; "
+            "DELETE DATA { <urn:a> <urn:p> <urn:o> }"
+        )
+    )
+    assert [op.name for op in u.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_translates_to_container_with_empty_algebra():
+    u = translateUpdate(parseUpdate(""))
+    assert isinstance(u, Update)
+    assert isinstance(u.prologue, Prologue)
+    assert u.algebra == []
+    evalUpdate(Graph(), u)
+
+
+def test_declarations_only_request_binds_prefix_and_has_empty_algebra():
+    u = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert isinstance(u.prologue, Prologue)
+    assert u.algebra == []
+    assert u.prologue.resolvePName("ex", "x") == URIRef("http://example.org/x")
+
+    g = Graph()
+    evalUpdate(g, u)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_update_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    evalUpdate(g2, prepared)
+    assert _snapshot(prepared) == before
