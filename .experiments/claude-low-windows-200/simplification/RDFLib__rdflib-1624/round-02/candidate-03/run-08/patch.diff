diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..992013f
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,118 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:a ex:p ex:b . ex:c ex:p "x" . }
+"""
+
+
+def _algebra_repr(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applies_through_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_DATA)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_DATA)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b")) in g
+
+
+def test_prepared_update_with_init_bindings_is_visible_to_operations():
+    prepared = prepareUpdate("INSERT { ?s <urn:ex:p> ?o } WHERE { }")
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={
+            "s": URIRef("urn:ex:a"),
+            "o": Literal("bound"),
+        },
+    )
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), Literal("bound")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_update_container_shape_for_non_empty_request():
+    update = translateUpdate(parseUpdate(INSERT_DATA))
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 1
+    assert update.algebra[0].name == "InsertData"
+
+
+def test_empty_update_request_translates_to_empty_container():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_update_binds_declared_prefix_in_prologue():
+    update = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "a") == URIRef("urn:ex:a")
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b")))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b")))
+    processUpdate(g, "PREFIX ex: <urn:ex:>")
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _algebra_repr(prepared)
+
+    g = Graph()
+    g.update(prepared)
+    evalUpdate(Graph(), prepared)
+
+    assert _algebra_repr(prepared) == before
