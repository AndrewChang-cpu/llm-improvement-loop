diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..af44361
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,114 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.sparql import Prologue
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_DATA = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o . ex:s ex:p ex:o2 . }
+"""
+
+INSERT_DATA_INITNS = """
+INSERT DATA { ex:s ex:p ex:o . ex:s ex:p ex:o2 . }
+"""
+
+
+def _algebra_repr(update):
+    return [f"{op.name} {op!r}" for op in update.algebra]
+
+
+def test_prepare_then_update_graph_inserts_triples():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepare_update_initns_resolves_prefixes():
+    prepared = prepareUpdate(INSERT_DATA_INITNS, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_direct_evaluation_does_not_raise():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translate_non_empty_request_returns_update_container():
+    prepared = prepareUpdate(INSERT_DATA)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 1
+
+    two_ops = prepareUpdate(
+        """
+        PREFIX ex: <http://example.org/>
+        INSERT DATA { ex:a ex:p ex:b . } ;
+        CLEAR DEFAULT
+        """
+    )
+    assert isinstance(two_ops.prologue, Prologue)
+    assert [op.name for op in two_ops.algebra] == ["InsertData", "Clear"]
+
+
+def test_translate_empty_request_returns_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue():
+    update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert update.algebra == []
+    bound = dict(update.prologue.namespace_manager.store.namespaces())
+    assert str(bound["ex"]) == EX
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _algebra_repr(prepared)
+    g = Graph()
+    g.update(prepared)
+    after = _algebra_repr(prepared)
+    assert before == after
