diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..71e5d2f
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,110 @@
+import unittest
+from typing import List
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o1> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+
+def algebra_snapshot(update) -> List[str]:
+    return [f"{op.name} {op}" for op in update.algebra]
+
+
+class PrepareUpdateTests(unittest.TestCase):
+    def test_prepared_update_applies_through_graph_update(self) -> None:
+        g = Graph()
+        prepared = prepareUpdate(INSERT_TWO)
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_applies_to_two_graphs_and_repeats(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_resolves_prefixes_in_prepared_update(self) -> None:
+        prepared = prepareUpdate(
+            "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g)
+
+    def test_init_bindings_are_visible_to_prepared_update(self) -> None:
+        prepared = prepareUpdate("INSERT { <urn:s> <urn:p> ?o } WHERE { }")
+        g = Graph()
+        g.update(prepared, initBindings={"o": Literal("bound")})
+        self.assertIn((URIRef("urn:s"), URIRef("urn:p"), Literal("bound")), g)
+
+    def test_direct_evaluation_of_prepared_update(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_non_empty_request_container_shape(self) -> None:
+        update = translateUpdate(
+            parseUpdate(
+                "INSERT DATA { <urn:a> <urn:b> <urn:c> } ;"
+                " INSERT DATA { <urn:a> <urn:b> <urn:d> }"
+            )
+        )
+        self.assertIsInstance(update.prologue, Prologue)
+        self.assertEqual(len(update.algebra), 2)
+        self.assertEqual(
+            [op.name for op in update.algebra], ["InsertData", "InsertData"]
+        )
+
+    def test_empty_request_yields_empty_algebra_and_evaluates_silently(self) -> None:
+        update = translateUpdate(parseUpdate(""))
+        self.assertIsInstance(update.prologue, Prologue)
+        self.assertEqual(update.algebra, [])
+        g = Graph()
+        evalUpdate(g, update)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request_binds_declared_prefix(self) -> None:
+        update = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+        self.assertEqual(update.algebra, [])
+        namespace = update.prologue.namespace_manager.store.namespace("ex")
+        self.assertEqual(namespace, URIRef("urn:ex:"))
+        g = Graph()
+        evalUpdate(g, update)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_leaves_graph_unchanged(self) -> None:
+        g = Graph()
+        g.update(prepareUpdate(""))
+        g.update("")
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_prepared_update(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        before = algebra_snapshot(prepared)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        evalUpdate(g2, prepared)
+        self.assertEqual(algebra_snapshot(prepared), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
