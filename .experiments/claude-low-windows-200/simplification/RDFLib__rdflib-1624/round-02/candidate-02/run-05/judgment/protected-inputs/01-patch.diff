diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..1cafe3e
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,112 @@
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.com/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.com/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+def _algebra_repr(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate('INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX.s), URIRef(EX.p), Literal("a")) in g
+
+
+def test_prepared_update_receives_init_bindings():
+    prepared = prepareUpdate("INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={"s": URIRef(EX.s), "o": Literal("v")},
+    )
+    assert (URIRef(EX.s), URIRef(EX.p), Literal("v")) in g
+
+
+def test_prepared_update_direct_evaluation_on_graph():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepare_non_empty_request_returns_update_container():
+    prepared = prepareUpdate(INSERT_TWO + ";\nCLEAR DEFAULT")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 2
+    assert prepared.algebra[0].name == "InsertData"
+    assert prepared.algebra[1].name == "Clear"
+
+
+def test_prepare_empty_request_returns_empty_container():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_prepare_declarations_only_keeps_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <http://example.com/>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.prologue.resolvePName("ex", "x") == URIRef(EX.x)
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO + ";\nCLEAR DEFAULT")
+    before = _algebra_repr(prepared)
+    g = Graph()
+    g.update(prepared)
+    assert _algebra_repr(prepared) == before
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
