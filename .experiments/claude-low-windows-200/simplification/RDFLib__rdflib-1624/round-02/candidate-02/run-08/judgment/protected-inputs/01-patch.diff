diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..09cabff
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,129 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = URIRef("http://example.org/")
+
+INSERT_DATA = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _operation_texts(update):
+    return [[u.name, str(u)] for u in update.algebra]
+
+
+def test_prepare_then_update_through_graph_inserts_triples():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_gives_same_result():
+    prepared = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_applied_twice_to_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepare_update_resolves_initns_prefixes():
+    prepared = prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (EX.s, EX.p, EX.o) in g
+
+
+def test_prepare_update_passes_initial_bindings_to_operations():
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/>\n"
+        "INSERT { ?s ex:p ex:o } WHERE { }"
+    )
+    g = Graph()
+    g.update(prepared, initBindings={"s": EX.subject})
+    assert (EX.subject, EX.p, EX.o) in g
+
+
+def test_evaluate_prepared_update_directly_on_graph():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_non_empty_update_has_prologue_and_one_entry_per_operation():
+    update = translateUpdate(parseUpdate(INSERT_DATA))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 1
+    assert update.algebra[0].name == "InsertData"
+
+
+def test_translated_empty_update_has_prologue_and_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+
+def test_evaluating_empty_prepared_update_does_not_raise():
+    prepared = prepareUpdate("")
+    g = Graph()
+    g.update(prepared)
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_update_binds_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.prologue.resolvePName("ex", "s") == EX.s
+
+
+def test_declarations_only_update_leaves_graph_unchanged():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _operation_texts(prepared)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    g1.update(prepared)
+    after = _operation_texts(prepared)
+    assert before == after
