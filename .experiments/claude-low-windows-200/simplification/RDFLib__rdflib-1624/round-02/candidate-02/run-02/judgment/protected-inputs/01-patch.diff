diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..08097f6
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,116 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "urn:ex:"
+
+INSERT_TWO = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:a ex:p ex:b . ex:a ex:p ex:c . }
+"""
+
+
+def _snapshot(algebra):
+    return [[op.name, str(op)] for op in algebra]
+
+
+def test_prepared_update_applied_with_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": EX})
+    g.update(prepared)
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "b")) in g
+
+
+def test_prepared_update_init_bindings_visible_to_operations():
+    g = Graph()
+    prepared = prepareUpdate("INSERT { ?s <urn:ex:p> ?o } WHERE { }")
+    g.update(
+        prepared,
+        initBindings={"s": URIRef(EX + "a"), "o": Literal("v")},
+    )
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), Literal("v")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(INSERT_TWO + "; CLEAR DEFAULT")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 2
+    assert [op.name for op in prepared.algebra] == ["InsertData", "Clear"]
+
+
+def test_prepared_update_empty_request_has_empty_algebra():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert list(prepared.algebra) == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepared_update_declarations_only_binds_declared_prefix():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(prepared, Update)
+    assert list(prepared.algebra) == []
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.prologue.resolvePName("ex", "a") == URIRef(EX + "a")
+
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), Literal("keep")))
+    before = set(g)
+
+    g.update("")
+    assert set(g) == before
+
+    processUpdate(g, "")
+    assert set(g) == before
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO + "; CLEAR DEFAULT")
+    before = _snapshot(prepared.algebra)
+
+    g = Graph()
+    g.update(prepared)
+    evalUpdate(g, prepared)
+
+    assert _snapshot(prepared.algebra) == before
