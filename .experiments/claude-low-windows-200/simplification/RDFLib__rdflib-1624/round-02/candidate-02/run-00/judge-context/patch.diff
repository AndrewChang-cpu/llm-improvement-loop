diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..87226a0
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,145 @@
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("urn:ex:")
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA {
+    ex:s1 ex:p "one" .
+    ex:s2 ex:p "two" .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepare_then_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+    assert (EX.s1, EX.p, Literal("one")) in g
+
+
+def test_prepared_update_reused_across_graphs():
+    prepared = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_on_same_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepare_init_ns_resolves_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (EX.s, EX.p, EX.o) in g
+
+
+def test_prepared_update_with_init_bindings():
+    prepared = prepareUpdate(
+        "PREFIX ex: <urn:ex:> INSERT { ?s ex:p ?o } WHERE { }"
+    )
+    g = Graph()
+    g.update(prepared, initBindings={"s": EX.s, "o": Literal("bound")})
+    assert (EX.s, EX.p, Literal("bound")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translate_non_empty_request_returns_update_container():
+    update = translateUpdate(parseUpdate(INSERT_DATA))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 1
+    assert update.algebra[0].name == "InsertData"
+
+
+def test_translate_multiple_operations_keeps_request_order():
+    update = translateUpdate(
+        parseUpdate(
+            "PREFIX ex: <urn:ex:> "
+            "INSERT DATA { ex:a ex:p ex:b } ; "
+            "CLEAR DEFAULT"
+        )
+    )
+    assert [op.name for op in update.algebra] == ["InsertData", "Clear"]
+
+
+def test_empty_request_translates_to_empty_container():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert list(update.algebra) == []
+
+
+def test_empty_request_evaluates_without_raising():
+    g = Graph()
+    evalUpdate(g, translateUpdate(parseUpdate("")))
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue():
+    update = translateUpdate(
+        parseUpdate("PREFIX ex: <urn:ex:>"), base=None, initNs=None
+    )
+    assert isinstance(update, Update)
+    assert list(update.algebra) == []
+    assert update.prologue.resolvePName("ex", "s") == EX.s
+
+
+def test_declarations_only_request_evaluates_without_change():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, EX.o))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, EX.o))
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert _snapshot(prepared) == before
+    assert len(prepared.algebra) == 1
