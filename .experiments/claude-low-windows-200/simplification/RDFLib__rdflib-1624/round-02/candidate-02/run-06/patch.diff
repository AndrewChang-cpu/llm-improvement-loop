diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..42dbfa0
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,144 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:a ex:p ex:b . ex:a ex:p ex:c }
+"""
+
+
+def _algebra_snapshot(prepared):
+    return [[op.name, str(op)] for op in prepared.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g = Graph()
+    g.update(prepared)
+
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_two_graphs():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_application_is_idempotent():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+
+    assert len(g) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:p ex:b }", initNs={"ex": "urn:ex:"})
+
+    g = Graph()
+    g.update(prepared)
+
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b")) in g
+
+
+def test_prepared_update_init_bindings_visible_to_operations():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:> INSERT { ?s ex:p ?o } WHERE { }")
+
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={"s": URIRef("urn:ex:a"), "o": Literal("x")},
+    )
+
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), Literal("x")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g = Graph()
+    evalUpdate(g, prepared)
+
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(
+        "PREFIX ex: <urn:ex:> INSERT DATA { ex:a ex:p ex:b } ; "
+        "DELETE DATA { ex:a ex:p ex:b }"
+    )
+
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert [op.name for op in prepared.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_prepared_update_empty_request_has_empty_algebra():
+    prepared = prepareUpdate("")
+
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepared_update_declarations_only_binds_declared_prefix():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "a") == URIRef("urn:ex:a")
+
+    g = Graph()
+    g.add((URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("o")))
+    evalUpdate(g, prepared)
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("o")))
+
+    g.update("")
+    g.update("PREFIX ex: <urn:ex:>")
+
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("o")))
+
+    processUpdate(g, "")
+    processUpdate(g, "PREFIX ex: <urn:ex:>")
+
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    evalUpdate(Graph(), prepared)
+
+    assert _algebra_snapshot(prepared) == before
