diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..54774ac
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,109 @@
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.com/")
+
+INSERT_TWO = (
+    "PREFIX ex: <http://example.com/> "
+    "INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }"
+)
+
+INSERT_TWO_OPS = (
+    "PREFIX ex: <http://example.com/> "
+    "INSERT DATA { ex:s ex:p ex:o1 } ; "
+    "INSERT DATA { ex:s ex:p ex:o2 }"
+)
+
+
+def _algebra_repr(update):
+    return [f"{op.name} {op}" for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    q = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(q)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    q = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(q)
+    g2.update(q)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(q)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    q = prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": EX})
+    g = Graph()
+    g.update(q)
+    assert (EX.s, EX.p, EX.o) in g
+
+
+def test_prepared_update_passes_init_bindings_to_operations():
+    q = prepareUpdate("INSERT { ex:s ex:p ?o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    g.update(q, initBindings={"o": Literal("bound")})
+    assert (EX.s, EX.p, Literal("bound")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    q = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, q)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    q = prepareUpdate(INSERT_TWO_OPS)
+    assert isinstance(q, Update)
+    assert isinstance(q.prologue, Prologue)
+    assert [op.name for op in q.algebra] == ["InsertData", "InsertData"]
+
+
+def test_prepared_update_empty_request_has_empty_algebra():
+    q = prepareUpdate("")
+    assert isinstance(q, Update)
+    assert isinstance(q.prologue, Prologue)
+    assert list(q.algebra) == []
+
+    g = Graph()
+    evalUpdate(g, q)
+    assert len(g) == 0
+
+
+def test_prepared_update_declarations_only_binds_declared_prefix():
+    q = prepareUpdate("PREFIX ex: <http://example.com/>")
+    assert list(q.algebra) == []
+    assert q.prologue.resolvePName("ex", "") == URIRef(EX)
+
+    g = Graph()
+    g.update(q)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    q = prepareUpdate(INSERT_TWO_OPS)
+    before = _algebra_repr(q)
+
+    g1 = Graph()
+    g1.update(q)
+    evalUpdate(Graph(), q)
+
+    assert _algebra_repr(q) == before
