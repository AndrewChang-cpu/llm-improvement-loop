diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..910bcba
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,106 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_DATA = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:a ex:p ex:b . ex:c ex:p ex:d . }
+"""
+
+
+def _snapshot(pq):
+    return [f"{op.name}: {op}" for op in pq.algebra]
+
+
+def test_prepare_update_applied_through_graph_update():
+    pq = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(pq)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    pq = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(pq)
+    g2.update(pq)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(pq)
+    assert len(g1) == 2
+
+
+def test_prepared_update_no_mutation_during_evaluation():
+    pq = prepareUpdate(INSERT_DATA)
+    before = _snapshot(pq)
+    g = Graph()
+    evalUpdate(g, pq)
+    g.update(pq)
+    assert _snapshot(pq) == before
+
+
+def test_init_ns_prefixes_resolve_inside_update():
+    pq = prepareUpdate("INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": URIRef(EX)})
+    g = Graph()
+    g.update(pq)
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "b")) in g
+
+
+def test_init_bindings_visible_to_update_operations():
+    pq = prepareUpdate(
+        "INSERT { ?s <http://example.org/p> <http://example.org/o> } WHERE {}"
+    )
+    g = Graph()
+    g.update(pq, initBindings={"s": URIRef(EX + "a")})
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_direct_evaluation_of_prepared_update():
+    pq = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, pq)
+    assert len(g) == 2
+
+
+def test_non_empty_request_container_shape():
+    pq = translateUpdate(parseUpdate(INSERT_DATA))
+    assert isinstance(pq, Update)
+    assert isinstance(pq.prologue, Prologue)
+    assert len(pq.algebra) == 1
+    assert pq.algebra[0].name == "InsertData"
+
+
+def test_empty_request_yields_empty_algebra_and_no_error():
+    pq = prepareUpdate("")
+    assert isinstance(pq, Update)
+    assert isinstance(pq.prologue, Prologue)
+    assert pq.algebra == []
+    g = Graph()
+    evalUpdate(g, pq)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefixes_and_is_noop():
+    pq = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(pq, Update)
+    assert pq.algebra == []
+    assert pq.prologue.resolvePName("ex", "a") == URIRef(EX + "a")
+    g = Graph()
+    g.update(pq)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), URIRef(EX + "b")))
+    processUpdate(g, "")
+    assert len(g) == 1
