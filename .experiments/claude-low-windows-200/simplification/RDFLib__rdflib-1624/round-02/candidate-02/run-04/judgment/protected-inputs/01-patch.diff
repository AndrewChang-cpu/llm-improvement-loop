diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..015a78c
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,144 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_DATA = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+def _algebra_snapshot(update):
+    return ["%s %s" % (u.name, u) for u in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_DATA)
+
+    g.update(prepared)
+
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+
+    g1.update(prepared)
+    g2.update(prepared)
+    g1.update(prepared)
+
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    prepared = prepareUpdate(
+        'INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": "http://example.org/"}
+    )
+
+    g.update(prepared)
+
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        Literal("a"),
+    ) in g
+
+
+def test_prepared_update_passes_init_bindings_to_operations():
+    g = Graph()
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT { ?s ex:p ?o } WHERE { }"
+    )
+
+    g.update(
+        prepared,
+        initBindings={
+            "s": URIRef("http://example.org/s"),
+            "o": Literal("a"),
+        },
+    )
+
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        Literal("a"),
+    ) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_DATA)
+
+    evalUpdate(g, prepared)
+
+    assert len(g) == 2
+
+
+def test_non_empty_request_translates_to_update_container():
+    parsed = parseUpdate(INSERT_DATA)
+
+    result = translateUpdate(parsed)
+
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert len(result.algebra) == len(parsed.request)
+    assert [u.name for u in result.algebra] == ["InsertData"]
+
+
+def test_empty_request_translates_to_update_container_with_empty_algebra():
+    result = translateUpdate(parseUpdate(""))
+
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert result.algebra == []
+
+
+def test_empty_request_evaluates_without_error_or_change():
+    g = Graph()
+    evalUpdate(g, translateUpdate(parseUpdate("")))
+
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "a") == URIRef("http://example.org/a")
+
+
+def test_declarations_only_request_leaves_graph_unchanged():
+    g = Graph()
+    g.update(prepareUpdate("PREFIX ex: <http://example.org/>"))
+
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _algebra_snapshot(prepared)
+
+    g = Graph()
+    g.update(prepared)
+    evalUpdate(g, prepared)
+
+    assert _algebra_snapshot(prepared) == before
