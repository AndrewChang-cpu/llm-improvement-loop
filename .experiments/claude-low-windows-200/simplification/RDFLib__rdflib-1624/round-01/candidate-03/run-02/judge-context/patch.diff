diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..71cc6e7
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,122 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:a ex:p ex:b . ex:a ex:q ex:c . }
+"""
+
+
+def _snapshot(prepared):
+    return [(op.name, str(op)) for op in prepared.algebra]
+
+
+def test_prepared_update_applied_through_graph_inserts_triples():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeatedly():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepare_init_ns_resolves_prefix_in_update():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:a ex:p ex:b . }",
+        initNs={"ex": "http://example.org/"},
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (
+        URIRef("http://example.org/a"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/b"),
+    ) in g
+
+
+def test_prepared_update_init_bindings_visible_to_operations():
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> " "INSERT { ex:a ex:p ?o } WHERE { }"
+    )
+    g = Graph()
+    g.update(prepared, initBindings={"o": Literal(1)})
+    assert (
+        URIRef("http://example.org/a"),
+        URIRef("http://example.org/p"),
+        Literal(1),
+    ) in g
+
+
+def test_prepared_update_evaluated_directly_without_error():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+    assert _snapshot(prepared) == before
+
+
+def test_prepared_update_algebra_not_mutated_by_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert _snapshot(prepared) == before
+
+
+def test_translated_update_container_shape_for_non_empty_request():
+    result = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert len(result.algebra) == 2
+    assert [op.name for op in result.algebra] == ["InsertData", "InsertData"]
+
+
+def test_translated_update_container_for_empty_request():
+    result = translateUpdate(parseUpdate(""))
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert result.algebra == []
+    evalUpdate(Graph(), result)
+
+
+def test_translated_update_container_for_declarations_only_request():
+    result = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert isinstance(result, Update)
+    assert result.algebra == []
+    assert result.prologue.resolvePName("ex", "a") == URIRef("http://example.org/a")
+
+    g = Graph()
+    evalUpdate(g, result)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+    processUpdate(g, "PREFIX ex: <http://example.org/>")
+    assert len(g) == 1
