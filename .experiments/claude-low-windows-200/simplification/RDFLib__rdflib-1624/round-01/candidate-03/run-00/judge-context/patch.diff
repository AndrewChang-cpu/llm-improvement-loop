diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..ad65120
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,100 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _snapshot(update):
+    return [(op.name, str(op)) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeats():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    prepared = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": EX})
+    g.update(prepared)
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_passed_to_evaluation_directly():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_receives_init_bindings():
+    g = Graph()
+    prepared = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+    g.update(prepared, initBindings={"s": URIRef("urn:s")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_translate_update_returns_update_container_for_operations():
+    update = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert [op.name for op in update.algebra] == ["InsertData", "InsertData"]
+
+
+def test_empty_update_request_yields_container_with_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    evalUpdate(Graph(), update)
+
+
+def test_declarations_only_update_binds_declared_prefix():
+    prepared = prepareUpdate("PREFIX ex: <%s>" % EX)
+    assert prepared.algebra == []
+    assert prepared.prologue.namespace_manager.store.namespace("ex") == URIRef(EX)
+
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    evalUpdate(g2, prepared)
+    assert _snapshot(prepared) == before
