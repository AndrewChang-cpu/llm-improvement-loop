diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..1477107
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,96 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = "INSERT DATA { <urn:s1> <urn:p> <urn:o1> . <urn:s2> <urn:p> <urn:o2> . }"
+
+INSERT_THEN_DELETE = (
+    "INSERT DATA { <urn:s1> <urn:p> <urn:o1> } ; "
+    "DELETE DATA { <urn:s1> <urn:p> <urn:o1> }"
+)
+
+
+def _snapshot(update):
+    return [(op.name, str(op).splitlines()) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_inserts_triples():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    update = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(update)
+    g2.update(update)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+    g1.update(update)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    update = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(update)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_evaluated_directly_on_graph():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_translate_non_empty_request_returns_update_container():
+    update = translateUpdate(parseUpdate(INSERT_THEN_DELETE))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert [op.name for op in update.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_translate_empty_request_returns_empty_update_container():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_translate_declarations_only_request_binds_declared_prefix():
+    update = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert isinstance(update, Update)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_is_noop_through_graph_and_process_update():
+    g = Graph()
+    g.update("")
+    g.update(prepareUpdate(""))
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluating_prepared_update_does_not_mutate_algebra():
+    update = prepareUpdate(INSERT_THEN_DELETE)
+    before = _snapshot(update)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(update)
+    evalUpdate(g2, update)
+    g1.update(update)
+    assert _snapshot(update) == before
+    assert len(update.algebra) == 2
