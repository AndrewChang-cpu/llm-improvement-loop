diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..4ca712b
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,116 @@
+import unittest
+
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+class TestPrepareUpdate(unittest.TestCase):
+    def test_prepare_then_update_graph(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_reused_across_graphs_and_repeated(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_resolves_prefixes(self):
+        prepared = prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": EX})
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((EX.s, EX.p, EX.o), g)
+
+    def test_init_bindings_visible_to_operations(self):
+        prepared = prepareUpdate(
+            "INSERT { ?s ex:p ?o } WHERE { }",
+            initNs={"ex": EX},
+        )
+        g = Graph()
+        g.update(prepared, initBindings={"s": EX.s, "o": Literal("v")})
+        self.assertIn((EX.s, EX.p, Literal("v")), g)
+
+    def test_direct_evaluation(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_non_empty_request_container_shape(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(len(prepared.algebra), 1)
+
+        two = prepareUpdate(
+            "INSERT DATA { <urn:a> <urn:b> <urn:c> } ; "
+            "DELETE DATA { <urn:a> <urn:b> <urn:c> }"
+        )
+        self.assertEqual([op.name for op in two.algebra], ["InsertData", "DeleteData"])
+
+    def test_empty_request(self):
+        prepared = prepareUpdate("")
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(list(prepared.algebra), [])
+
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request(self):
+        prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+        self.assertIsInstance(prepared, Update)
+        self.assertEqual(list(prepared.algebra), [])
+        self.assertEqual(
+            str(prepared.prologue.namespace_manager.store.namespace("ex")),
+            "http://example.org/",
+        )
+
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_graph_and_process_update(self):
+        g = Graph()
+        g.update("")
+        self.assertEqual(len(g), 0)
+
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_container(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        before = _snapshot(prepared)
+        g1 = Graph()
+        g2 = Graph()
+        evalUpdate(g1, prepared)
+        evalUpdate(g2, prepared)
+        self.assertEqual(_snapshot(prepared), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
