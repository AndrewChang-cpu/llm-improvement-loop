diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..141fcca
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,105 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o1> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _snapshot(update):
+    return [op.name + " " + repr(op) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeatedly():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT DATA { <urn:s> ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g.update(prepared)
+    assert (URIRef("urn:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_receives_init_bindings():
+    g = Graph()
+    prepared = prepareUpdate("INSERT { <urn:s> <urn:p> ?o } WHERE { }")
+    g.update(prepared, initBindings={"o": Literal("bound")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("bound")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    g = Graph()
+    prepared = prepareUpdate("INSERT DATA { <urn:s> <urn:p> <urn:o> . }")
+    evalUpdate(g, prepared)
+    assert len(g) == 1
+
+
+def test_prepare_update_non_empty_container_shape():
+    prepared = prepareUpdate(
+        "INSERT DATA { <urn:s> <urn:p> <urn:o> . } ; "
+        "DELETE DATA { <urn:s> <urn:p> <urn:o> . }"
+    )
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert [op.name for op in prepared.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_prepare_update_empty_request_evaluates_without_error():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    evalUpdate(g, prepared)
+    assert len(g) == 1
+
+
+def test_prepare_update_declarations_only_binds_prefixes():
+    g = Graph()
+    before = set(g)
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "foo") == URIRef("urn:ex:foo")
+    evalUpdate(g, prepared)
+    assert set(g) == before
+
+
+def test_empty_update_string_through_graph_and_process_update_is_noop():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_prepared_update_algebra_is_not_mutated_by_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    evalUpdate(Graph(), prepared)
+    Graph().update(prepared)
+    assert _snapshot(prepared) == before
