diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..208262c
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,122 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated():
+    update = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(update)
+    g2 = Graph()
+    g2.update(update)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(update)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    update = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": EX})
+    g = Graph()
+    g.update(update)
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_receives_init_bindings():
+    update = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT { ?s ex:p ?o } WHERE {}"
+    )
+    g = Graph()
+    g.update(
+        update,
+        initBindings={"s": URIRef(EX + "s"), "o": URIRef(EX + "o")},
+    )
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 2
+
+
+def test_prepared_update_evaluation_does_not_mutate_container():
+    update = prepareUpdate(INSERT_TWO)
+    before = _snapshot(update)
+
+    g = Graph()
+    evalUpdate(g, update)
+    g.update(update)
+
+    assert _snapshot(update) == before
+
+
+def test_translated_non_empty_request_is_update_container():
+    update = translateUpdate(
+        parseUpdate(
+            "PREFIX ex: <http://example.org/> "
+            "INSERT DATA { ex:a ex:b ex:c } ; "
+            "DELETE DATA { ex:x ex:y ex:z }"
+        )
+    )
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert [op.name for op in update.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_translated_empty_request_is_empty_update_container():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef(EX + "s")
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_is_noop():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_is_noop():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
