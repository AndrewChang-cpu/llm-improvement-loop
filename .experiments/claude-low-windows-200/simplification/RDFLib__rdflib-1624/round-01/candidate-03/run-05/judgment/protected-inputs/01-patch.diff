diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..c6d2be1
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,131 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s1> <urn:p> <urn:o1> .
+  <urn:s2> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_sees_init_bindings():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> ?o } WHERE { }")
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={"s": URIRef("urn:s"), "o": Literal("value")},
+    )
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("value")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_update_container_shape():
+    update = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 1
+    assert update.algebra[0].name == "InsertData"
+
+
+def test_translated_update_container_one_entry_per_operation_in_order():
+    update = translateUpdate(
+        parseUpdate(
+            "INSERT DATA { <urn:a> <urn:p> <urn:b> } ; "
+            "DELETE DATA { <urn:a> <urn:p> <urn:b> }"
+        )
+    )
+    assert [op.name for op in update.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_translates_to_empty_update_container():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert list(update.algebra) == []
+
+
+def test_empty_request_evaluates_without_error():
+    update = translateUpdate(parseUpdate(""))
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_keeps_prefix_bindings():
+    update = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>\nBASE <urn:base:>"))
+    assert isinstance(update, Update)
+    assert list(update.algebra) == []
+    assert update.prologue.resolvePName("ex", "x") == URIRef("urn:ex:x")
+
+
+def test_declarations_only_request_evaluates_as_noop():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_is_noop():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_is_noop():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert _snapshot(prepared) == before
