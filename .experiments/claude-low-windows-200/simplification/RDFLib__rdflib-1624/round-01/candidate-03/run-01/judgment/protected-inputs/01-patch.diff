diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..0ff6d36
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,112 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import SPARQLUpdateProcessor
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s1> <urn:p> <urn:o1> .
+  <urn:s2> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _snapshot(prepared):
+    return [(op.name, repr(op)) for op in prepared.algebra]
+
+
+def test_prepare_then_update_through_graph_inserts_triples():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeatedly():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepare_update_resolves_init_ns_prefixes():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_init_bindings_visible_to_operations():
+    g = Graph()
+    prepared = prepareUpdate("INSERT { <urn:s> <urn:p> ?o } WHERE { }")
+    g.update(prepared, initBindings={"o": Literal("value")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("value")) in g
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 2
+    assert all(op.name == "InsertData" for op in prepared.algebra)
+
+
+def test_prepare_empty_request_returns_empty_container():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepare_declarations_only_request_binds_prefixes():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    namespace = prepared.prologue.namespace_manager.store.namespace("ex")
+    assert namespace == URIRef("urn:ex:")
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    SPARQLUpdateProcessor(g).update("")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+
+    assert _snapshot(prepared) == before
