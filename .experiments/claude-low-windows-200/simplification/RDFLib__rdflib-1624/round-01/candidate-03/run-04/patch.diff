diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..57eb580
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,116 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.com/"
+
+INSERT_TWO = (
+    "PREFIX ex: <http://example.com/> "
+    'INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }'
+)
+
+INSERT_WITH_INIT_NS = 'INSERT DATA { ex:s ex:p "a" . }'
+
+TWO_OPERATIONS = (
+    "PREFIX ex: <http://example.com/> "
+    'INSERT DATA { ex:s ex:p "a" . }; '
+    'DELETE DATA { ex:s ex:p "a" . }'
+)
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applies_through_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+    assert _snapshot(prepared) == before
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_WITH_INIT_NS, initNs={"ex": EX})
+    g.update(prepared)
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), Literal("a")) in g
+    assert len(g) == 1
+
+
+def test_prepared_update_direct_evaluation():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_passes_init_bindings_to_operations():
+    g = Graph()
+    prepared = prepareUpdate("INSERT { ?s <http://example.com/p> 'x' } WHERE { }")
+    g.update(prepared, initBindings={"s": URIRef(EX + "subject")})
+    assert (URIRef(EX + "subject"), URIRef(EX + "p"), Literal("x")) in g
+    assert len(g) == 1
+
+
+def test_translated_non_empty_request_returns_update_container():
+    update = translateUpdate(parseUpdate(TWO_OPERATIONS))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert [op.name for op in update.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_prepares_empty_update_container():
+    update = prepareUpdate("")
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    g = Graph()
+    update = prepareUpdate("PREFIX ex: <http://example.com/>")
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef(EX + "s")
+
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    evalUpdate(Graph(), prepared)
+    assert _snapshot(prepared) == before
