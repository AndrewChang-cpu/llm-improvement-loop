diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..e5933dc
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,116 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o1> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _algebra_snapshot(update):
+    return [(op.name, [f"{k}={v}" for k, v in op.items()]) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_sees_initial_bindings_from_graph_update():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:s")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_prepared_update_passed_directly_to_evaluation_applies_without_error():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    evalUpdate(g2, prepared)
+
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_translated_update_non_empty_request_has_prologue_and_algebra_list():
+    res = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(res, Update)
+    assert isinstance(res.prologue, Prologue)
+    assert len(res.algebra) == 2
+    assert all(op.name == "InsertData" for op in res.algebra)
+
+
+def test_translated_empty_request_returns_update_with_empty_algebra():
+    res = translateUpdate(parseUpdate(""))
+    assert isinstance(res, Update)
+    assert isinstance(res.prologue, Prologue)
+    assert res.algebra == []
+
+    g = Graph()
+    evalUpdate(g, res)
+    assert len(g) == 0
+
+
+def test_translated_declarations_only_request_binds_declared_prefix():
+    res = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert isinstance(res, Update)
+    assert res.algebra == []
+    assert res.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+
+    g = Graph()
+    evalUpdate(g, res)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
