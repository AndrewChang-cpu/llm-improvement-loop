diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..6e56487
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,108 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = "INSERT DATA { <urn:s> <urn:p> 'a' . <urn:s> <urn:p> 'b' . }"
+
+INSERT_TWO_OPERATIONS = (
+    "INSERT DATA { <urn:s> <urn:p> 'a' } ; INSERT DATA { <urn:s> <urn:p> 'b' }"
+)
+
+MIXED = (
+    "INSERT DATA { <urn:s> <urn:p> 'a' } ; "
+    "INSERT { <urn:s> <urn:q> ?o } WHERE { <urn:s> <urn:p> ?o }"
+)
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(update)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_two_graphs():
+    update = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(update)
+    g2.update(update)
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_repeated_application_is_idempotent():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(update)
+    g.update(update)
+    assert len(g) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    update = prepareUpdate("INSERT DATA { ex:s ex:p 'a' . }", initNs={"ex": "urn:"})
+    g = Graph()
+    g.update(update)
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("a")) in g
+
+
+def test_prepared_update_initial_bindings_visible_to_operations():
+    update = prepareUpdate("INSERT { <urn:s> <urn:p> ?o } WHERE { }")
+    g = Graph()
+    g.update(update, initBindings={"o": Literal("v")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("v")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 2
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    update = prepareUpdate(MIXED)
+    before = _snapshot(update)
+    g = Graph()
+    g.update(update)
+    assert _snapshot(update) == before
+
+
+def test_translated_non_empty_update_returns_update_container():
+    update = translateUpdate(parseUpdate(INSERT_TWO_OPERATIONS))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 2
+    assert [op.name for op in update.algebra] == ["InsertData", "InsertData"]
+
+
+def test_empty_update_translates_to_empty_container():
+    update = prepareUpdate("")
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    evalUpdate(Graph(), update)
+
+
+def test_declarations_only_update_binds_prefixes_in_prologue():
+    update = prepareUpdate("PREFIX ex: <urn:>")
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef("urn:s")
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
