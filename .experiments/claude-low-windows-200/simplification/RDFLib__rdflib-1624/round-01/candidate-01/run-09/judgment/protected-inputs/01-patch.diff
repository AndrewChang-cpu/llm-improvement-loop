diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..1f9335f
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,98 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = "INSERT DATA { <urn:s> <urn:p> <urn:o1> . <urn:s> <urn:p> <urn:o2> . }"
+
+
+def _snapshot(prepared):
+    return [op.name + " " + str(op) for op in prepared.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_init_ns_prefix_resolves_inside_update():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_without_error():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, prepared, {})
+    assert len(g) == 2
+
+
+def test_prepared_update_direct_evaluation_does_not_mutate_algebra():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    evalUpdate(g, prepared, {})
+    assert _snapshot(prepared) == before
+
+
+def test_prepared_update_container_has_prologue_and_algebra_for_request():
+    prepared = prepareUpdate(INSERT_TWO + " ; " + INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 2
+    assert [op.name for op in prepared.algebra] == ["InsertData", "InsertData"]
+
+
+def test_empty_update_request_yields_empty_algebra_and_evaluates_silently():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared, {})
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "thing") == URIRef("urn:ex:thing")
+
+    g = Graph()
+    evalUpdate(g, prepared, {})
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
