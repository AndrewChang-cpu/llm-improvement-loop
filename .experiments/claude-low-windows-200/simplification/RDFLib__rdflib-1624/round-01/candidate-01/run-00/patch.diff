diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..864ee9f
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,105 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = 'INSERT DATA { <urn:s> <urn:p> "a" . <urn:s> <urn:p> "b" . }'
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    g = Graph()
+    q = prepareUpdate(INSERT_TWO)
+    g.update(q)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    q = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(q)
+    g2 = Graph()
+    g2.update(q)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(q)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_initns_prefixes():
+    g = Graph()
+    q = prepareUpdate('INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": "urn:ex:"})
+    g.update(q)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), None) in g
+    assert len(g) == 1
+
+
+def test_prepared_update_passed_directly_to_evalupdate_applies_without_error():
+    g = Graph()
+    q = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, q)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_has_prologue_and_algebra_for_operations():
+    q = prepareUpdate(INSERT_TWO)
+    assert isinstance(q, Update)
+    assert isinstance(q.prologue, Prologue)
+    assert len(q.algebra) == 1
+    assert q.algebra[0].name == "InsertData"
+
+
+def test_prepared_update_container_has_one_entry_per_operation_in_order():
+    q = prepareUpdate(
+        "INSERT DATA { <urn:s> <urn:p> <urn:o1> . } ; "
+        "DELETE DATA { <urn:s> <urn:p> <urn:o1> . }"
+    )
+    assert [op.name for op in q.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_update_string_prepares_to_empty_algebra():
+    q = prepareUpdate("")
+    assert isinstance(q, Update)
+    assert isinstance(q.prologue, Prologue)
+    assert q.algebra == []
+
+
+def test_empty_prepared_update_evaluates_without_raising():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(""))
+    assert len(g) == 0
+
+
+def test_declarations_only_update_binds_prefix_in_prologue():
+    q = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert q.algebra == []
+    assert q.prologue.resolvePName("ex", "x") == URIRef("urn:ex:x")
+
+
+def test_declarations_only_update_evaluates_and_leaves_graph_unchanged():
+    g = Graph()
+    evalUpdate(g, prepareUpdate("PREFIX ex: <urn:ex:>"))
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update_algebra():
+    q = prepareUpdate(INSERT_TWO)
+    before = _snapshot(q)
+    g = Graph()
+    g.update(q)
+    evalUpdate(g, q)
+    assert _snapshot(q) == before
