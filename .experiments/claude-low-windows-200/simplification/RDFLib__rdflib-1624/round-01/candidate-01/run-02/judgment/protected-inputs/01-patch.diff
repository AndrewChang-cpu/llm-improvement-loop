diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..d467102
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,144 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareQuery, prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _algebra_snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    pu = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(pu)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    pu = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(pu)
+    g2.update(pu)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(pu)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    pu = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": EX})
+    g = Graph()
+    g.update(pu)
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_passes_init_bindings_to_operations():
+    pu = prepareUpdate(
+        "INSERT { <http://example.org/s> <http://example.org/p> ?o } WHERE { }"
+    )
+    g = Graph()
+    g.update(pu, initBindings={"o": Literal("bound")})
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        Literal("bound"),
+    ) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    pu = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, pu)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    pu = prepareUpdate(INSERT_TWO)
+    assert isinstance(pu, Update)
+    assert isinstance(pu.prologue, Prologue)
+    assert isinstance(pu.algebra, list)
+    assert len(pu.algebra) == 1
+    assert pu.algebra[0].name == "InsertData"
+
+
+def test_prepared_update_container_keeps_request_order_for_multiple_operations():
+    pu = prepareUpdate(
+        "PREFIX ex: <http://example.org/> "
+        "INSERT DATA { ex:a ex:p ex:b } ; "
+        "DELETE DATA { ex:a ex:p ex:b }"
+    )
+    assert [op.name for op in pu.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    pu = prepareUpdate("")
+    assert isinstance(pu, Update)
+    assert isinstance(pu.prologue, Prologue)
+    assert pu.algebra == []
+
+
+def test_empty_request_evaluates_without_error_or_change():
+    pu = prepareUpdate("")
+    g = Graph()
+    g.update(pu)
+    evalUpdate(g, pu)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefixes_in_prologue():
+    pu = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(pu, Update)
+    assert pu.algebra == []
+    assert isinstance(pu.prologue, Prologue)
+    assert pu.prologue.namespace_manager.store.namespace("ex") == URIRef(EX)
+
+
+def test_declarations_only_request_leaves_graph_unchanged():
+    pu = prepareUpdate("PREFIX ex: <http://example.org/>")
+    g = Graph()
+    g.update(pu)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    pu = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(pu)
+    g = Graph()
+    g.update(pu)
+    evalUpdate(g, pu)
+    assert _algebra_snapshot(pu) == before
+
+
+def test_translate_update_returns_update_container_for_empty_request():
+    u = translateUpdate(parseUpdate(""))
+    assert isinstance(u, Update)
+    assert u.algebra == []
+
+
+def test_prepare_query_still_returns_query_with_original_args():
+    q = prepareQuery("SELECT * WHERE { ?s ?p ?o }")
+    assert q._original_args[0] == "SELECT * WHERE { ?s ?p ?o }"
