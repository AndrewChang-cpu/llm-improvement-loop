diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..3934bce
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,134 @@
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:a ex:p "1" . ex:b ex:p "2" . }
+"""
+
+INSERT_TWO_NO_PREFIX = """
+INSERT DATA { <http://example.org/a> <http://example.org/p> "1" .
+  <http://example.org/b> <http://example.org/p> "2" . }
+"""
+
+INSERT_WITH_NS = """
+INSERT DATA { ex:a ex:p "1" . }
+"""
+
+
+def _algebra_snapshot(prepared):
+    return [(op.name, str(op)) for op in prepared.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_applied_twice_to_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepare_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(INSERT_WITH_NS, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("http://example.org/a"), EX.p, Literal("1")) in g
+
+
+def test_prepared_update_initial_bindings_visible_to_operations():
+    prepared = prepareUpdate(
+        "INSERT { ?s <http://example.org/p> <http://example.org/o> } WHERE {}"
+    )
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("http://example.org/a")})
+    assert (
+        URIRef("http://example.org/a"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/o"),
+    ) in g
+
+
+def test_prepared_update_direct_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepare_update_non_empty_container_shape():
+    prepared = translateUpdate(parseUpdate(INSERT_TWO_NO_PREFIX))
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_prepare_update_empty_request_container():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert list(prepared.algebra) == []
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepare_update_declarations_only_binds_prefix():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared, Update)
+    assert list(prepared.algebra) == []
+    assert prepared.prologue.resolvePName("ex", "a") == URIRef(
+        "http://example.org/a"
+    )
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("http://example.org/a"), URIRef("http://example.org/p"), Literal(1)))
+    before = set(g)
+    g.update("")
+    assert set(g) == before
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("http://example.org/a"), URIRef("http://example.org/p"), Literal(1)))
+    before = set(g)
+    processUpdate(g, "PREFIX ex: <http://example.org/>")
+    assert set(g) == before
+
+
+def test_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert _algebra_snapshot(prepared) == before
