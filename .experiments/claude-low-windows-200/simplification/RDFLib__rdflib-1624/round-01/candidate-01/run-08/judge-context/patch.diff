diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..1215e07
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,131 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_DATA = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _algebra_snapshot(update):
+    return [(op.name, [str(op)]) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_DATA)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_DATA)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }",
+        initNs={"ex": "http://example.org/"},
+    )
+    g.update(prepared)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/o"),
+    ) in g
+
+
+def test_prepared_update_with_init_bindings_is_visible_to_operations():
+    g = Graph()
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT { ?s ex:p ?o } WHERE { }"
+    )
+    g.update(
+        prepared,
+        initBindings={"s": URIRef("http://example.org/s"), "o": Literal("v")},
+    )
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        Literal("v"),
+    ) in g
+
+
+def test_prepared_update_passed_directly_to_evaluation_function():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_DATA)
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translate_update_returns_update_container_for_non_empty_request():
+    update = translateUpdate(parseUpdate(INSERT_DATA))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 1
+    assert update.algebra[0].name == "InsertData"
+
+
+def test_prepare_update_empty_request_returns_empty_algebra():
+    update = prepareUpdate("")
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_prepare_update_declarations_only_binds_prefixes():
+    update = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(update, Update)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef("http://example.org/s")
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _algebra_snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    evalUpdate(Graph(), prepared)
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add(
+        (URIRef("http://example.org/a"), URIRef("http://example.org/b"), Literal(1))
+    )
+    before = set(g)
+    g.update("")
+    assert set(g) == before
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    before = set(g)
+    processUpdate(g, "")
+    assert set(g) == before
