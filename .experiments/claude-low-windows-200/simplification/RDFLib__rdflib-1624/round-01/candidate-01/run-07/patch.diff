diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..8c92c94
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,123 @@
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+def algebra_snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_initns_prefixes():
+    prepared = prepareUpdate(
+        'INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": "http://example.org/"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (EX.s, EX.p, Literal("a")) in g
+
+
+def test_prepared_update_receives_initial_bindings():
+    prepared = prepareUpdate("INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared, initBindings={"s": EX.s, "o": Literal("v")})
+    assert (EX.s, EX.p, Literal("v")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_without_error():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_update_container_has_prologue_and_algebra_list():
+    update = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert isinstance(update.algebra, list)
+    assert len(update.algebra) == 1
+    assert update.algebra[0].name == "InsertData"
+
+
+def test_empty_request_translates_to_empty_update_container():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+
+def test_empty_request_evaluation_does_not_raise():
+    g = Graph()
+    evalUpdate(g, translateUpdate(parseUpdate("")))
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue():
+    update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    assert update.prologue.namespace_manager.store.namespace("ex") == URIRef(
+        "http://example.org/"
+    )
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, Literal("a")))
+    before = set(g)
+    g.update("")
+    assert set(g) == before
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.s, EX.p, Literal("a")))
+    before = set(g)
+    processUpdate(g, "")
+    assert set(g) == before
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = algebra_snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    assert algebra_snapshot(prepared) == before
+
+
+def test_prepare_update_records_original_arguments():
+    ns = {"ex": "http://example.org/"}
+    prepared = prepareUpdate(INSERT_TWO, initNs=ns, base=None)
+    assert prepared._original_args == (INSERT_TWO, ns, None)
