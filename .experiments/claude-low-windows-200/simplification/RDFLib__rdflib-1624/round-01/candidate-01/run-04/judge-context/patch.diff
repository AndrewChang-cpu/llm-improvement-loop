diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..a6dfe67
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,139 @@
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_DATA = "INSERT DATA { ex:a ex:p ex:b . ex:a ex:p ex:c . }"
+INSERT_DATA_WITH_PREFIX = "PREFIX ex: <http://example.org/>\n" + INSERT_DATA
+INSERT_BOUND_VARS = "PREFIX ex: <http://example.org/> INSERT { ?s ex:p ?o } WHERE { }"
+
+
+def _algebra_snapshot(update):
+    return [f"{op.name}: {op}" for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_DATA_WITH_PREFIX)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_two_graphs_gives_same_result():
+    prepared = prepareUpdate(INSERT_DATA_WITH_PREFIX)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_applied_twice_to_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_DATA_WITH_PREFIX)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepare_update_init_ns_prefix_resolves_inside_update():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (EX.a, EX.p, EX.b) in g
+    assert (EX.a, EX.p, EX.c) in g
+
+
+def test_prepared_update_init_bindings_visible_to_operations():
+    prepared = prepareUpdate(INSERT_BOUND_VARS)
+    g = Graph()
+    g.update(prepared, initBindings={"s": EX.a, "o": Literal("x")})
+    assert (EX.a, EX.p, Literal("x")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_without_error():
+    prepared = prepareUpdate(INSERT_DATA_WITH_PREFIX)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_non_empty_request_has_prologue_and_one_entry_per_operation():
+    update = translateUpdate(
+        parseUpdate(
+            "PREFIX ex: <http://example.org/> "
+            "INSERT DATA { ex:a ex:p ex:b } ; "
+            "PREFIX ex2: <http://example.org/2/> "
+            "DELETE DATA { ex2:a ex2:p ex2:b }"
+        )
+    )
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 2
+    assert [op.name for op in update.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+
+def test_empty_request_evaluates_without_raising():
+    prepared = prepareUpdate("")
+    g = Graph()
+    g.update(prepared)
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix_in_prologue():
+    update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert isinstance(update, Update)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "a") == EX.a
+
+
+def test_declarations_only_request_evaluates_without_changing_graph():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.a, EX.p, EX.b))
+    g.update("")
+    assert len(g) == 1
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    g.add((EX.a, EX.p, EX.b))
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_evaluating_prepared_update_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_DATA_WITH_PREFIX)
+    before = _algebra_snapshot(prepared)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    g1.update(prepared)
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_prepare_update_records_original_arguments():
+    prepared = prepareUpdate(INSERT_DATA, initNs={"ex": EX}, base=None)
+    assert prepared._original_args == (INSERT_DATA, {"ex": EX}, None)
+
