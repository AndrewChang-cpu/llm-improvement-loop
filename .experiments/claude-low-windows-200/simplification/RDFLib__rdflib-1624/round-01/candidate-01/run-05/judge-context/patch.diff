diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..139d559
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,135 @@
+import unittest
+from typing import List
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA {
+    ex:s ex:p "one" .
+    ex:s ex:p "two" .
+}
+"""
+
+INSERT_TWO_NO_PREFIX = """
+INSERT DATA {
+    <http://example.org/s> <http://example.org/p> "one" .
+    <http://example.org/s> <http://example.org/p> "two" .
+}
+"""
+
+
+def algebra_snapshot(update: Update) -> List[List[str]]:
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+class SPARQLPrepareUpdateTests(unittest.TestCase):
+    def test_prepare_then_update_graph_inserts_triples(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_applied_to_two_graphs_gives_same_result(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(set(g1), set(g2))
+
+    def test_prepared_update_applied_twice_to_one_graph_is_idempotent(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_init_ns_prefixes_resolve_inside_update(self) -> None:
+        prepared = prepareUpdate('INSERT DATA { ex:s ex:p "one" . }', initNs={"ex": EX})
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 1)
+        self.assertIn((EX["s"], EX["p"], Literal("one")), g)
+
+    def test_init_bindings_visible_to_operations(self) -> None:
+        prepared = prepareUpdate(
+            "INSERT { ?s <http://example.org/p> <http://example.org/o> } WHERE { }"
+        )
+        g = Graph()
+        g.update(prepared, initBindings={"s": EX["subject"]})
+        self.assertIn((EX["subject"], EX["p"], EX["o"]), g)
+
+    def test_direct_evaluation_of_prepared_update_applies_it(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_translated_non_empty_request_has_prologue_and_algebra(self) -> None:
+        update = translateUpdate(parseUpdate(INSERT_TWO))
+        self.assertIsInstance(update, Update)
+        self.assertIsInstance(update.prologue, Prologue)
+        self.assertEqual(len(update.algebra), 1)
+        self.assertEqual(update.algebra[0].name, "InsertData")
+
+    def test_empty_request_translates_to_update_with_empty_algebra(self) -> None:
+        update = translateUpdate(parseUpdate(""))
+        self.assertIsInstance(update, Update)
+        self.assertIsInstance(update.prologue, Prologue)
+        self.assertEqual(list(update.algebra), [])
+
+    def test_empty_request_evaluates_without_error(self) -> None:
+        update = translateUpdate(parseUpdate(""))
+        g = Graph()
+        evalUpdate(g, update)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request_binds_declared_prefix(self) -> None:
+        update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+        self.assertIsInstance(update, Update)
+        self.assertEqual(list(update.algebra), [])
+        self.assertEqual(
+            update.prologue.resolvePName("ex", "s"), URIRef("http://example.org/s")
+        )
+
+    def test_declarations_only_request_leaves_graph_unchanged(self) -> None:
+        prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_graph_update_is_noop(self) -> None:
+        g = Graph()
+        g.update("")
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_process_update_is_noop(self) -> None:
+        g = Graph()
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_algebra(self) -> None:
+        prepared = prepareUpdate(INSERT_TWO)
+        before = algebra_snapshot(prepared)
+        g = Graph()
+        g.update(prepared)
+        after = algebra_snapshot(prepared)
+        self.assertEqual(before, after)
+
+    def test_string_path_matches_prepared_path(self) -> None:
+        g_string = Graph()
+        processUpdate(g_string, INSERT_TWO_NO_PREFIX)
+        g_prepared = Graph()
+        g_prepared.update(prepareUpdate(INSERT_TWO_NO_PREFIX))
+        self.assertEqual(set(g_string), set(g_prepared))
+        self.assertEqual(len(g_string), 2)
