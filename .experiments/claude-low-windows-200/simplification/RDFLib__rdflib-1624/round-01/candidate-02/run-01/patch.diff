diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..cc1c9f8
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,101 @@
+from typing import List, Tuple
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = "INSERT DATA { <urn:s> <urn:p> 1 . <urn:s> <urn:p> 2 . }"
+
+TWO_OPERATIONS = (
+    "INSERT DATA { <urn:s> <urn:p> 1 } ; INSERT DATA { <urn:s> <urn:p> 2 }"
+)
+
+
+def _snapshot(update: Update) -> List[Tuple[str, List[str]]]:
+    return [(op.name, [str(op)]) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes() -> None:
+    prepared = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(prepared)
+    triple = (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o"))
+    assert triple in g
+
+
+def test_prepared_update_passed_to_evalupdate_applies_without_error() -> None:
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_non_empty_update_returns_update_container() -> None:
+    result = translateUpdate(parseUpdate(TWO_OPERATIONS))
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert len(result.algebra) == 2
+    assert [op.name for op in result.algebra] == ["InsertData", "InsertData"]
+
+
+def test_translated_empty_update_returns_empty_algebra_and_evaluates() -> None:
+    result = translateUpdate(parseUpdate(""))
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert result.algebra == []
+    g = Graph()
+    evalUpdate(g, result)
+    assert len(g) == 0
+
+
+def test_translated_declarations_only_update_binds_declared_prefix() -> None:
+    result = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert isinstance(result, Update)
+    assert result.algebra == []
+    assert result.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+    g = Graph()
+    evalUpdate(g, result)
+    assert len(g) == 0
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra() -> None:
+    prepared = prepareUpdate(TWO_OPERATIONS)
+    before = _snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+    assert _snapshot(prepared) == before
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged() -> None:
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged() -> None:
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
