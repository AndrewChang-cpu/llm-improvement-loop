diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..d165efc
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,113 @@
+from typing import List
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o1> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _algebra_snapshot(update: Update) -> List[List[str]]:
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_prefixes_from_init_ns():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_passed_to_evaluation_function_applies_operations():
+    g = Graph()
+    prepared = prepareUpdate("INSERT DATA { <urn:s> <urn:p> <urn:o> . }")
+    evalUpdate(g, prepared)
+    assert len(g) == 1
+
+
+def test_prepared_update_initial_bindings_are_visible_to_operations():
+    g = Graph()
+    prepared = prepareUpdate("INSERT { <urn:x> <urn:p> ?o } WHERE {}")
+    g.update(prepared, initBindings={"o": URIRef("urn:o")})
+    assert (URIRef("urn:x"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+    g.update(prepared)
+    g.update(prepared)
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_translated_non_empty_request_has_prologue_and_algebra_per_operation():
+    update = translateUpdate(
+        parseUpdate(
+            "INSERT DATA { <urn:s> <urn:p> <urn:o> } ; "
+            "DELETE DATA { <urn:s> <urn:p> <urn:o> }"
+        )
+    )
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert [op.name for op in update.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_translated_empty_request_has_prologue_and_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_translated_declarations_only_request_binds_declared_prefix():
+    update = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+
+
+def test_empty_update_string_through_graph_update_and_process_update_is_noop():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+
+    g.update("")
+    assert len(g) == 1
+
+    processUpdate(g, "")
+    assert len(g) == 1
