diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..9384278
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,110 @@
+from rdflib import Graph, URIRef, Literal
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" }
+"""
+
+
+def _snapshot(algebra):
+    return [[op.name, str(op)] for op in algebra]
+
+
+def test_prepared_update_applied_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate('INSERT DATA { ex:s ex:p "a" }', initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("a")) in g
+
+
+def test_prepared_update_sees_initial_bindings():
+    prepared = prepareUpdate('INSERT { ?s <urn:ex:p> "a" } WHERE { }')
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:ex:s")})
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("a")) in g
+
+
+def test_prepared_update_evaluated_directly_without_error():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_update_has_prologue_and_one_algebra_entry_per_operation():
+    prepared = translateUpdate(
+        parseUpdate(
+            "PREFIX ex: <urn:ex:> INSERT DATA { ex:s ex:p 'a' } ; "
+            "DELETE DATA { ex:s ex:p 'a' }"
+        )
+    )
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 2
+    assert [op.name for op in prepared.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_update_prepares_to_empty_algebra_and_evaluates_without_error():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_update_binds_prefix_in_prologue():
+    prepared = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_and_process_update_is_noop():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(
+        "PREFIX ex: <urn:ex:> "
+        'INSERT DATA { ex:s ex:p "a" } ; DELETE DATA { ex:s ex:p "a" }'
+    )
+    before = _snapshot(prepared.algebra)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    g1.update(prepared)
+    assert _snapshot(prepared.algebra) == before
