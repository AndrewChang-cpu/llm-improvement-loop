diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..cff7efa
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,106 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+INSERT_TWO = (
+    'INSERT DATA { <http://example.org/s> <http://example.org/p> "a" . '
+    '<http://example.org/s> <http://example.org/p> "b" . }'
+)
+
+
+def _algebra_snapshot(update):
+    return [(op.name, [str(op)]) for op in update.algebra]
+
+
+def test_prepared_update_applies_through_graph_update():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_applies_to_second_graph_and_repeatedly():
+    update = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(update)
+    g2 = Graph()
+    g2.update(update)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    g1.update(update)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    g = Graph()
+    update = prepareUpdate('INSERT DATA { ex:s ex:p "a" }', initNs={"ex": EX})
+    g.update(update)
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), Literal("a")) in g
+
+
+def test_prepared_update_sees_initial_bindings():
+    g = Graph()
+    update = prepareUpdate('INSERT { ?s <http://example.org/p> "a" } WHERE { }')
+    g.update(update, initBindings={"s": URIRef(EX + "s")})
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), Literal("a")) in g
+
+
+def test_prepared_update_evaluated_directly_with_evalupdate():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_container_has_prologue_and_ordered_algebra():
+    update = prepareUpdate(
+        'INSERT DATA { <http://example.org/s> <http://example.org/p> "a" } ; '
+        'DELETE DATA { <http://example.org/s> <http://example.org/p> "a" }'
+    )
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert [op.name for op in update.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_prepared_update_has_empty_algebra_and_evaluates_silently():
+    update = prepareUpdate("")
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_prepared_update_binds_prefixes_and_is_noop():
+    update = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "a") == URIRef(EX + "a")
+
+    g = Graph()
+    g.add((URIRef(EX + "s"), URIRef(EX + "p"), Literal("a")))
+    evalUpdate(g, update)
+    assert len(g) == 1
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef(EX + "s"), URIRef(EX + "p"), Literal("a")))
+
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    update = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(update)
+
+    g1 = Graph()
+    g1.update(update)
+    g2 = Graph()
+    evalUpdate(g2, update)
+
+    assert _algebra_snapshot(update) == before
