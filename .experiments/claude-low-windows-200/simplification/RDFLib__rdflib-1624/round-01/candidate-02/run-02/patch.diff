diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..f02e86f
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,123 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+    <urn:s> <urn:p> 1 .
+    <urn:s> <urn:p> 2 .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepared_update_applies_through_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g.update(prepared)
+
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+
+    g1.update(prepared)
+    g2.update(prepared)
+    g1.update(prepared)
+
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate("INSERT DATA { ex:s ex:p 1 }", initNs={"ex": "urn:ex:"})
+    g = Graph()
+
+    g.update(prepared)
+
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal(1)) in g
+
+
+def test_prepared_update_sees_initial_bindings():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> 1 } WHERE { }")
+    g = Graph()
+
+    g.update(prepared, initBindings={"s": URIRef("urn:s")})
+
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal(1)) in g
+
+
+def test_prepared_update_evaluated_directly_without_error():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+
+    evalUpdate(g, prepared)
+
+    assert len(g) == 2
+
+
+def test_translated_update_is_update_container_with_one_entry_per_operation():
+    update = translateUpdate(
+        parseUpdate(
+            "INSERT DATA { <urn:s> <urn:p> 1 } ; INSERT DATA { <urn:s> <urn:p> 2 }"
+        )
+    )
+
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 2
+    assert [op.name for op in update.algebra] == ["InsertData", "InsertData"]
+
+
+def test_empty_update_translates_to_empty_container():
+    update = prepareUpdate("")
+
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+
+def test_declarations_only_update_binds_prefix_in_prologue():
+    update = prepareUpdate("PREFIX ex: <urn:ex:>")
+
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), Literal(1)))
+
+    g.update("")
+    processUpdate(g, "")
+    g.update(prepareUpdate("PREFIX ex: <urn:ex:>"))
+
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(
+        """
+        INSERT DATA { <urn:s> <urn:p> 1 } ;
+        DELETE { ?s <urn:p> ?o } INSERT { ?s <urn:q> ?o } WHERE { ?s <urn:p> ?o }
+        """
+    )
+    before = _snapshot(prepared)
+    g = Graph()
+
+    g.update(prepared)
+
+    assert _snapshot(prepared) == before
