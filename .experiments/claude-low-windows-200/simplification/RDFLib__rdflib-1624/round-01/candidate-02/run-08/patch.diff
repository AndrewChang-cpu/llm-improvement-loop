diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..9a6ca1d
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,104 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s1> <urn:p> <urn:o1> .
+  <urn:s2> <urn:p> <urn:o2> .
+}
+"""
+
+MODIFY_THEN_INSERT = """
+INSERT { ?s <urn:p> <urn:o> } WHERE {} ;
+INSERT DATA { <urn:a> <urn:b> <urn:c> }
+"""
+
+PREFIX_THEN_CLEAR = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:a ex:b ex:c } ;
+CLEAR DEFAULT
+"""
+
+
+def _snapshot(prepared):
+    return [[op.name, str(op)] for op in prepared.algebra]
+
+
+def test_prepared_update_inserts_triples_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_applies_to_second_graph_and_repeatedly():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_sees_init_bindings_from_graph_update():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE {}")
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:subject")})
+    assert (URIRef("urn:subject"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_evalUpdate_applies_prepared_update_directly():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_translated_update_has_prologue_and_one_algebra_entry_per_operation():
+    result = translateUpdate(parseUpdate(PREFIX_THEN_CLEAR))
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert [op.name for op in result.algebra] == ["InsertData", "Clear"]
+
+
+def test_empty_update_translates_to_empty_algebra_with_prologue():
+    result = translateUpdate(parseUpdate(""))
+    assert isinstance(result, Update)
+    assert isinstance(result.prologue, Prologue)
+    assert list(result.algebra) == []
+
+
+def test_declarations_only_update_binds_prefix_in_prologue():
+    result = translateUpdate(parseUpdate("PREFIX ex: <urn:ex:>"))
+    assert list(result.algebra) == []
+    assert result.prologue.resolvePName("ex", "a") == URIRef("urn:ex:a")
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    g.update("PREFIX ex: <urn:ex:>")
+    assert len(g) == 0
+
+
+def test_evalUpdate_does_not_mutate_prepared_algebra():
+    prepared = prepareUpdate(MODIFY_THEN_INSERT)
+    before = _snapshot(prepared)
+    evalUpdate(Graph(), prepared, {"s": URIRef("urn:x")})
+    assert _snapshot(prepared) == before
