diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..55c9f9e
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,102 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = 'INSERT DATA { <urn:s1> <urn:p> "a" . <urn:s2> <urn:p> "b" . }'
+
+
+def _describe(algebra):
+    return [[op.name, str(op)] for op in algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    pu = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(pu)
+    g2 = Graph()
+    g2.update(pu)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    g1.update(pu)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    pu = prepareUpdate('INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(pu)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("a")) in g
+
+
+def test_prepared_update_initial_bindings_visible_to_operations():
+    pu = prepareUpdate("INSERT { <urn:s> <urn:p> ?o } WHERE { }")
+    g = Graph()
+    g.update(pu, initBindings={"o": Literal("bound")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("bound")) in g
+
+
+def test_prepared_update_passed_directly_to_evalUpdate_applies_without_error():
+    pu = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, pu)
+    assert len(g) == 2
+
+
+def test_non_empty_request_container_has_prologue_and_one_entry_per_operation():
+    pu = prepareUpdate(
+        'INSERT DATA { <urn:s1> <urn:p> "a" } ; '
+        'INSERT DATA { <urn:s2> <urn:p> "b" }'
+    )
+    assert isinstance(pu, Update)
+    assert isinstance(pu.prologue, Prologue)
+    assert [op.name for op in pu.algebra] == ["InsertData", "InsertData"]
+
+
+def test_empty_request_has_prologue_and_empty_algebra_and_evaluates_silently():
+    pu = prepareUpdate("")
+    assert isinstance(pu, Update)
+    assert isinstance(pu.prologue, Prologue)
+    assert pu.algebra == []
+
+    g = Graph()
+    evalUpdate(g, pu)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue_and_is_noop():
+    pu = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(pu, Update)
+    assert pu.algebra == []
+    assert pu.prologue.resolvePName("ex", "s") == URIRef("urn:ex:s")
+
+    g = Graph()
+    evalUpdate(g, pu)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_and_process_update_is_noop():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_algebra():
+    pu = prepareUpdate(INSERT_TWO)
+    before = _describe(pu.algebra)
+
+    g = Graph()
+    g.update(pu)
+
+    assert _describe(pu.algebra) == before
