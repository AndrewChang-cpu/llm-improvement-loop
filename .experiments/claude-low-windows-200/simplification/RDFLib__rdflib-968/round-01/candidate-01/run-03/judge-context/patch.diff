diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..9c88f3c 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,49 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource from this graph.
+
+        The Concise Bounded Description is built by three rules from the
+        W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource. For each
+           object that is a blank node, apply the same rules to it, unless
+           the result already contains a triple with that blank node as
+           subject, which terminates blank node cycles.
+        2. Include every statement reified by the resource, i.e. every
+           node S with an rdf:subject triple whose object is the resource.
+           All triples whose subject is S are included, whether or not S
+           has an rdf:Statement type and whether or not its rdf:predicate
+           or rdf:object values match any triple.
+        3. Reification applies to every processed node, including blank
+           nodes reached by rule 1. Blank nodes that appear only as objects
+           of triples added by rule 2 are not followed.
+
+        The result is a new Graph that is a subgraph of this graph. This
+        graph is not modified.
+
+        :param resource: the resource (URIRef or BNode) to describe.
+        :return: a new Graph containing the Concise Bounded Description.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: direct triples, expanding unseen blank node objects.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) is BNode and \
+                        next(result.triples((o, None, None)), None) is None:
+                    add_to_cbd(o)
+            # Rule 2: triples of every statement that reifies this node.
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..6f7421b
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,110 @@
+import unittest
+
+from rdflib import Graph, Literal, Namespace, RDF
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.g = Graph()
+        self.g.parse(data="""
+            @prefix ex: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            [ ex:name "a" ;
+              ex:p ex:U1 , ex:U2 ;
+              ex:q [ ex:r "x" ;
+                     ex:s [ ex:t "y" ; ex:u "z" ] ] ] .
+
+            ex:R2 ex:type ex:T ; ex:rel1 ex:U1 ; ex:rel2 ex:U2 .
+            ex:R3 ex:p1 "a" ; ex:p2 "b" .
+
+            ex:R5 ex:a1 "1" ; ex:a2 "2" ; ex:a3 ex:U1 .
+            [ rdf:type rdf:Statement ; rdf:subject ex:R5 ;
+              rdf:predicate ex:a1 ; rdf:object "1" ; ex:note "x" ] .
+
+            ex:R6 ex:b1 "1" ; ex:b2 "2" ; ex:b3 "3" .
+            [ rdf:type rdf:Statement ; rdf:subject ex:R6 ;
+              rdf:predicate ex:b1 ; rdf:object "1" ; ex:note "t" ] .
+            [ rdf:subject ex:R6 ; rdf:predicate ex:b2 ;
+              rdf:object "2" ; ex:note "u" ; ex:by "me" ] .
+
+            ex:A ex:label "a" ; ex:p ex:B .
+            ex:B ex:label "b" .
+            [ rdf:subject ex:A ; rdf:predicate ex:p ;
+              rdf:object ex:B ; ex:note "r" ] .
+
+            ex:R7 ex:label "r" .
+            [ rdf:subject ex:R7 ; ex:detail [ ex:x "1" ] ] .
+
+            ex:Root ex:has _:a .
+            _:a ex:next _:b .
+            _:b ex:next _:a .
+            """, format="turtle")
+        self.ex = Namespace("http://example.org/")
+
+    def tearDown(self):
+        self.g.close()
+
+    def testCbd(self):
+        EX = self.ex
+        root = self.g.value(predicate=EX.name, object=Literal("a"))
+        result = self.g.cbd(root)
+        # 4 root triples, 2 for the blank node "r", 2 for the nested "t"/"u".
+        self.assertEqual(len(result), 8)
+
+        result = self.g.cbd(EX.R2)
+        self.assertEqual(len(result), 3)
+
+        result = self.g.cbd(EX.R3)
+        self.assertEqual(len(result), 2)
+
+        result = self.g.cbd(EX.NoSuchResource)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        EX = self.ex
+        # Case A: three direct triples plus a typed reifier with five triples.
+        result = self.g.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+
+        # Case B: three direct triples, a typed reifier with five triples,
+        # and an untyped reifier with five triples (must be included).
+        result = self.g.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertEqual(len(list(result.triples((None, EX.by, None)))), 1)
+
+    def testCbdIncomingReification(self):
+        EX = self.ex
+        result_b = self.g.cbd(EX.B)
+        self.assertEqual(len(result_b), 1)
+        self.assertEqual(len(list(result_b.subjects(RDF.subject, EX.A))), 0)
+
+        result_a = self.g.cbd(EX.A)
+        self.assertEqual(len(result_a), 6)
+        self.assertEqual(len(list(result_a.subjects(RDF.subject, EX.A))), 1)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        EX = self.ex
+        result = self.g.cbd(EX.R7)
+        # label, plus the reifier's rdf:subject and ex:detail triples.
+        self.assertEqual(len(result), 3)
+        detail = self.g.value(predicate=EX.x, object=Literal("1"))
+        self.assertEqual(len(list(result.triples((detail, None, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        EX = self.ex
+        result = self.g.cbd(EX.Root)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        EX = self.ex
+        before = sorted(self.g)
+        result = self.g.cbd(EX.R6)
+        self.assertIsNot(result, self.g)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(sorted(self.g), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
