diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..63b36f2 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        The Concise Bounded Description (CBD) of a resource is built from
+        the three rules of the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource.
+        2. For each blank node object reached by rule 1, apply rules 1
+           and 2 to it as well, unless the result already contains a
+           triple with that blank node as subject (this makes cycles
+           terminate).
+        3. Reification: for every node processed, include every triple
+           whose subject is a statement S that has an rdf:subject triple
+           whose object is that node. This is done without checking for
+           an rdf:Statement type and without matching rdf:predicate or
+           rdf:object values, so untyped reifiers are included too.
+           The rdf:object and rdf:predicate values of a reifier are not
+           followed.
+
+        The returned Graph is a subgraph of this Graph: it contains only
+        triples from this Graph, and this Graph is not modified. Namespace
+        bindings are not copied.
+
+        :param resource: the resource (node) to describe.
+        :return: a new Graph containing the Concise Bounded Description of
+            the resource. It is empty if the resource has no triples and
+            no reifiers in this Graph.
+        """
+        def add_to_cbd(node, result):
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode):
+                    if not any(True for _ in result.triples((o, None, None))):
+                        add_to_cbd(o, result)
+
+            for reifier in self.subjects(RDF.subject, node):
+                for t in self.triples((reifier, None, None)):
+                    result.add(t)
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..184c889
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,131 @@
+import unittest
+
+from rdflib import Graph, Namespace, RDF, Literal
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data="""
+            @prefix ex: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            ex:blankResource ex:p1 "a" ;
+                ex:p2 "b" ;
+                ex:p3 "c" ;
+                ex:l1 ex:x ;
+                ex:l2 ex:y ;
+                ex:l3 _:b2 .
+            _:b2 ex:q ex:z ;
+                ex:r _:b3 .
+
+            ex:R1 rdf:type ex:T ;
+                ex:p ex:A ;
+                ex:q ex:B .
+
+            ex:S1 ex:p "a" ;
+                ex:q "b" .
+
+            ex:R5 ex:p1 "a" ;
+                ex:p2 "b" ;
+                ex:p3 "c" .
+            ex:st5 rdf:type rdf:Statement ;
+                rdf:subject ex:R5 ;
+                rdf:predicate ex:p1 ;
+                rdf:object "a" ;
+                ex:note "n" .
+
+            ex:R6 ex:p1 "a" ;
+                ex:p2 "b" ;
+                ex:p3 "c" .
+            ex:st6a rdf:type rdf:Statement ;
+                rdf:subject ex:R6 ;
+                rdf:predicate ex:p1 ;
+                rdf:object "a" ;
+                ex:note "n" ;
+                ex:extra "e" .
+            ex:st6b rdf:subject ex:R6 ;
+                rdf:predicate ex:p2 ;
+                rdf:object "b" ;
+                ex:note "n" ;
+                ex:extra "e" .
+
+            ex:A ex:p ex:B .
+            ex:stInc rdf:subject ex:A ;
+                rdf:object ex:B ;
+                ex:note "x" .
+
+            ex:R7 ex:p ex:O .
+            ex:stBlank rdf:subject ex:R7 ;
+                rdf:object _:bo .
+            _:bo ex:deep "d" .
+
+            _:c1 ex:next _:c2 .
+            _:c2 ex:next _:c1 .
+            ex:R8 ex:has _:c1 .
+            """, format="turtle")
+        self.ex = Namespace("http://example.org/")
+        self.graph.bind("ex", self.ex)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        cbd = self.graph.cbd(self.ex.blankResource)
+        self.assertEqual(len(cbd), 8)
+
+    def testCbdTypeAndRelations(self):
+        cbd = self.graph.cbd(self.ex.R1)
+        self.assertEqual(len(cbd), 3)
+
+    def testCbdTwoProperties(self):
+        cbd = self.graph.cbd(self.ex.S1)
+        self.assertEqual(len(cbd), 2)
+
+    def testCbdNoTriples(self):
+        cbd = self.graph.cbd(self.ex.nothingHere)
+        self.assertEqual(len(cbd), 0)
+        self.assertIsInstance(cbd, Graph)
+
+    def testCbdReifiedTyped(self):
+        cbd = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(cbd), 8)
+        self.assertIn((self.ex.st5, RDF.type, RDF.Statement), cbd)
+
+    def testCbdReifiedUntypedIncluded(self):
+        cbd = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(cbd), 13)
+        self.assertIn((self.ex.st6b, RDF.predicate, self.ex.p2), cbd)
+
+    def testCbdIncomingReification(self):
+        ex = self.ex
+        cbd_b = self.graph.cbd(ex.B)
+        self.assertEqual(len(cbd_b), 0)
+        cbd_a = self.graph.cbd(ex.A)
+        self.assertIn((ex.stInc, RDF.subject, ex.A), cbd_a)
+        self.assertIn((ex.stInc, ex.note, Literal("x")), cbd_a)
+
+    def testCbdReificationBlankNodeNotExpanded(self):
+        ex = self.ex
+        cbd = self.graph.cbd(ex.R7)
+        bo = self.graph.value(ex.stBlank, RDF.object)
+        self.assertIn((ex.stBlank, RDF.subject, ex.R7), cbd)
+        self.assertIn((ex.stBlank, RDF.object, bo), cbd)
+        self.assertEqual(len(list(cbd.triples((bo, None, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        cbd = self.graph.cbd(self.ex.R8)
+        self.assertEqual(len(cbd), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        cbd = self.graph.cbd(self.ex.blankResource)
+        self.assertIsNot(cbd, self.graph)
+        self.assertEqual(set(self.graph), before)
+        for t in cbd:
+            self.assertIn(t, self.graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
