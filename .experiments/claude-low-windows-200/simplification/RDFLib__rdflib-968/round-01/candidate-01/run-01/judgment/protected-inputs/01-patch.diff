diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..885288e 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,57 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        The Concise Bounded Description (CBD) of a resource is built from
+        the three rules of the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource.
+        2. For every blank node object reached by rule 1, recursively apply
+           rules 1 and 2 to that blank node, unless the description already
+           contains a triple with that blank node as subject.
+        3. Reification: for every node processed above, include every
+           statement whose ``rdf:subject`` is that node, together with all
+           triples whose subject is that statement. No ``rdf:Statement``
+           type check and no ``rdf:predicate`` or ``rdf:object`` matching is
+           performed. The ``rdf:object`` and ``rdf:predicate`` values of such
+           statements are not followed.
+
+        The result is a new Graph that is a subgraph of the source graph;
+        the source graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description
+        """
+
+        cbd = Graph()
+
+        def add_to_cbd(node):
+            # Rules 1 and 2: triples with node as subject. Collected first so
+            # the cycle guard below sees everything added for this node.
+            subject_triples = list(self.triples((node, None, None)))
+            for triple in subject_triples:
+                cbd.add(triple)
+            for triple in subject_triples:
+                obj = triple[2]
+                if type(obj) is BNode and next(
+                        cbd.triples((obj, None, None)), None) is None:
+                    add_to_cbd(obj)
+
+            # Rule 3: statements whose rdf:subject is node contribute all of
+            # their own triples. Their objects are not expanded here.
+            reifiers = set(
+                s for s, _, _ in self.triples((None, RDF.subject, node)))
+            for reifier in reifiers:
+                for triple in self.triples((reifier, None, None)):
+                    cbd.add(triple)
+
+        add_to_cbd(resource)
+        return cbd
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..01013a8
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,131 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph().parse(data="""
+            @prefix example: <http://example.org/> .
+            @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+            # Rules 1 and 2: blank node resource (8 triples reachable)
+            example:Root example:part [
+                example:p1 "lit" ;
+                example:p2 example:U1 ;
+                example:p3 example:U2 ;
+                example:p4 [
+                    example:q1 "y" ;
+                    example:q2 example:U3 ;
+                    example:q3 [ example:r "z" ]
+                ]
+            ] .
+
+            # Rules 1 and 2: typed resource with two relations (3 triples)
+            example:R1 a example:Class ;
+                example:p1 example:U1 ;
+                example:p2 example:U2 .
+
+            # Rules 1 and 2: resource with two property triples (2 triples)
+            example:R2 example:p1 "a" ;
+                example:p2 "b" .
+
+            # Reification case A: typed reifier with rdf:subject R5 (8 triples)
+            example:R5 example:p1 "a" ;
+                example:p2 example:U1 ;
+                example:p3 example:U2 .
+            example:S5 a rdf:Statement ;
+                rdf:subject example:R5 ;
+                rdf:predicate example:p1 ;
+                rdf:object "a" ;
+                example:note "n" .
+
+            # Reification case B: typed and untyped reifiers (13 triples)
+            example:R6 example:p1 "a" ;
+                example:p2 example:U1 ;
+                example:p3 example:U2 .
+            example:S6a a rdf:Statement ;
+                rdf:subject example:R6 ;
+                rdf:predicate example:p1 ;
+                rdf:object "a" ;
+                example:note "n" .
+            example:S6b rdf:subject example:R6 ;
+                rdf:predicate example:p2 ;
+                rdf:object example:U1 ;
+                example:note "m" ;
+                example:date "d" .
+
+            # Incoming reification: statement A p B with reifier S7
+            example:A7 example:p example:B7 .
+            example:S7 rdf:subject example:A7 ;
+                rdf:object example:B7 ;
+                example:note "x" .
+
+            # Reifier whose rdf:object is a blank node
+            example:R8 example:p "v" .
+            example:S8 rdf:subject example:R8 ;
+                rdf:predicate example:p ;
+                rdf:object [ example:name "n" ] .
+
+            # Blank node cycle
+            example:R9 example:p _:a .
+            _:a example:q _:b .
+            _:b example:r _:a .
+        """, format="turtle")
+        self.graph.bind("example", self.ex)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        blank = self.graph.value(self.ex.Root, self.ex.part)
+        result = self.graph.cbd(blank)
+        self.assertEqual(len(result), 8)
+
+        result = self.graph.cbd(self.ex.R1)
+        self.assertEqual(len(result), 3)
+
+        result = self.graph.cbd(self.ex.R2)
+        self.assertEqual(len(result), 2)
+
+        result = self.graph.cbd(self.ex.Missing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(result), 8)
+
+        result = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((self.ex.S6b, self.ex.note, None), result)
+
+    def testCbdIncomingReification(self):
+        result = self.graph.cbd(self.ex.B7)
+        self.assertEqual(len(result), 0)
+
+        result = self.graph.cbd(self.ex.A7)
+        self.assertIn((self.ex.S7, self.ex.note, None), result)
+        self.assertEqual(len(result), 4)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(self.ex.R8)
+        self.assertEqual(len(result), 4)
+        self.assertNotIn((None, self.ex.name, None), result)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(self.ex.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(self.ex.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+        self.assertTrue(set(result).issubset(before))
+
+
+if __name__ == "__main__":
+    unittest.main()
