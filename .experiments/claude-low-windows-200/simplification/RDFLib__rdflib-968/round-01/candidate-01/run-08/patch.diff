diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..f738fcb 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,52 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource.
+
+        The Concise Bounded Description is computed by the three rules of the
+        W3C Member Submission on Concise Bounded Descriptions
+        (https://www.w3.org/Submission/CBD/), applied to this graph:
+
+        1. For a node N, every triple whose subject is N is included. Each
+           object that is a blank node is then described in the same way,
+           unless the result already contains a triple whose subject is that
+           blank node (which makes cycles terminate).
+        2. Reification: for a node N, every reifier S (a node with an
+           ``rdf:subject`` triple whose object is N) contributes every triple
+           whose subject is S. Every such reifier is included, regardless of
+           whether it has an ``rdf:Statement`` type or whether its
+           ``rdf:predicate`` or ``rdf:object`` values match any triple.
+           Rule 2 is applied to every processed node, including blank nodes
+           described through rule 1.
+        3. The ``rdf:object`` and ``rdf:predicate`` values of a reifier are
+           not followed, and blank nodes that appear only as objects of
+           triples added by rule 2 are not described.
+
+        The result is a subgraph of this graph. This graph is not modified,
+        and namespace bindings are not copied to the result.
+
+        :param resource: the starting node of the description.
+        :return: a new Graph containing the Concise Bounded Description of
+            ``resource``. It is empty if the graph has no matching triples.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples whose subject is the node.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) is BNode and not any(
+                        True for _ in result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 2: reifiers of the node contribute their triples.
+            for reifier in list(self.subjects(RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..79cd7e3
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,132 @@
+import sys
+import unittest
+
+from rdflib import Graph, Namespace, RDF
+
+
+TURTLE_FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: blank-node resource (8 triples in its description).
+ex:Holder ex:p [
+    ex:p1 ex:X ;
+    ex:p2 ex:Y ;
+    ex:p3 [
+        ex:q "lit" ;
+        ex:s "x" ;
+        ex:r [ ex:t "a" ; ex:u "b" ]
+    ]
+] .
+
+# Rules 1 and 2: type and two relations (3 triples).
+ex:R1 a ex:Thing ;
+    ex:rel1 ex:A ;
+    ex:rel2 ex:B .
+
+# Rules 1 and 2: two property triples (2 triples).
+ex:R2 ex:prop1 "one" ;
+    ex:prop2 "two" .
+
+# Reified case A: three direct triples plus a typed reifier (5 triples).
+ex:R5 ex:a1 "v1" ;
+    ex:a2 ex:X ;
+    ex:a3 ex:Y .
+ex:S5 a rdf:Statement ;
+    rdf:subject ex:R5 ;
+    rdf:predicate ex:a1 ;
+    rdf:object "v1" ;
+    ex:note "n5" .
+
+# Reified case B: three direct triples, a typed reifier (5 triples) and an
+# untyped reifier (5 triples).
+ex:R6 ex:b1 "v1" ;
+    ex:b2 ex:X ;
+    ex:b3 ex:Y .
+ex:S6 a rdf:Statement ;
+    rdf:subject ex:R6 ;
+    rdf:predicate ex:b1 ;
+    rdf:object "v1" ;
+    ex:note "n6" .
+ex:U6 rdf:subject ex:R6 ;
+    rdf:predicate ex:b2 ;
+    rdf:object ex:X ;
+    ex:note "u1" ;
+    ex:note2 "u2" .
+
+# Incoming reification: statement (A p B) reified by S7.
+ex:A ex:p ex:B .
+ex:S7 rdf:subject ex:A ;
+    rdf:object ex:B ;
+    ex:note "n7" .
+
+# Reifier whose rdf:object is a blank node that must not be expanded.
+ex:R8 ex:p ex:Q .
+ex:S8 rdf:subject ex:R8 ;
+    rdf:object [ ex:v "z" ] ;
+    ex:note "n8" .
+
+# Blank-node cycle.
+ex:Cyc ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+EX = Namespace("http://example.org/")
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("example", EX)
+        self.graph.parse(data=TURTLE_FIXTURE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        bnode = self.graph.value(EX.Holder, EX.p)
+        result = self.graph.cbd(bnode)
+        self.assertEqual(len(result), 8)
+
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.Missing)), 0)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (A p B) is only described from its rdf:subject, A.
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 4)
+        self.assertIn((EX.S7, EX.note, None), result)
+
+    def testCbdReifierBlankNodeObjectNotExpanded(self):
+        bnode = self.graph.value(EX.S8, RDF.object)
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+        self.assertNotIn((bnode, EX.v, None), result)
+        self.assertEqual(len(list(result.triples((bnode, None, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.Cyc)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(
+            len(list(result.triples((None, EX.q, None)))), 1)
+        self.assertEqual(
+            len(list(result.triples((None, EX.r, None)))), 1)
+
+    def testCbdImmutability(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(set(self.graph), before)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+
+
+if __name__ == '__main__':
+    unittest.main(argv=sys.argv[:1])
