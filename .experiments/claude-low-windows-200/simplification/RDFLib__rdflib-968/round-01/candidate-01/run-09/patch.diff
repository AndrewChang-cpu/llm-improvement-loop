diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..c035192 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,47 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Return the Concise Bounded Description of a resource.
+
+        The Concise Bounded Description (CBD) is computed by the three
+        rules of the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource. For each
+           blank node object of such a triple that is not already the
+           subject of a triple in the result, apply these rules to it.
+        2. Reification: include every triple whose subject is a reifier of
+           the resource, where a reifier is any node S that has an
+           rdf:subject triple whose object is the resource. Every such
+           statement is included, with no rdf:Statement type check and no
+           matching of its rdf:predicate or rdf:object values. The
+           rdf:object and rdf:predicate values of a reifier are not
+           followed. Rules 1 and 2 are applied to every node processed,
+           including blank nodes reached by rule 1.
+
+        The result is a subgraph of this graph, which is not modified.
+
+        :param resource: the resource to describe, used as the subject
+            (or, for rule 2, the object) in triple-pattern queries
+        :return: a new Graph containing the concise bounded description;
+            it is empty if the graph holds no matching triples
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            for s, p, o in list(self.triples((node, None, None))):
+                result.add((s, p, o))
+                if type(o) is BNode and not any(
+                        True for _ in result.triples((o, None, None))):
+                    add_to_cbd(o)
+            for reifier in list(self.subjects(RDF.subject, node)):
+                for s, p, o in list(self.triples((reifier, None, None))):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..149d328
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,124 @@
+import sys
+import unittest
+
+from rdflib import Graph, Literal, Namespace, RDF
+
+EX = Namespace('http://example.org/')
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: blank-node resource (8 triples in its description)
+[] ex:knows ex:x ;
+   ex:likes ex:y ;
+   ex:address [ ex:street "s" ;
+                ex:geo [ ex:lat "1" ; ex:long "2" ; ex:label "l" ] ] .
+
+# Rules 1 and 2: URI resource with a type and two relations (3 triples)
+ex:r1 rdf:type ex:Person ;
+      ex:knows ex:r2 ;
+      ex:likes ex:r3 .
+
+# Rules 1 and 2: URI resource with two property triples (2 triples)
+ex:r2 ex:name "a" ;
+      ex:age "2" .
+
+# Reified case A: one typed reifier (8 triples)
+ex:R5 ex:p1 ex:o1 ;
+      ex:p2 ex:o2 ;
+      ex:p3 ex:o3 .
+ex:S5 rdf:type rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:p1 ;
+      rdf:object ex:o1 ;
+      ex:note "five" .
+
+# Reified case B: typed and untyped reifiers (13 triples)
+ex:R6 ex:p1 ex:o1 ;
+      ex:p2 ex:o2 ;
+      ex:p3 ex:o3 .
+ex:S6a rdf:type rdf:Statement ;
+       rdf:subject ex:R6 ;
+       rdf:predicate ex:p1 ;
+       rdf:object ex:o1 ;
+       ex:note "typed" .
+ex:S6b rdf:subject ex:R6 ;
+       rdf:predicate ex:p2 ;
+       rdf:object ex:o2 ;
+       ex:q1 "one" ;
+       ex:q2 "two" .
+
+# Incoming reification: statement (A p B) with a reifier of A and B
+ex:A ex:p ex:B ;
+     ex:name "a" .
+ex:B ex:name "b" .
+ex:S7 rdf:subject ex:A ;
+      rdf:predicate ex:p ;
+      rdf:object ex:B ;
+      ex:note "n" .
+
+# Blank-node object of a reifier is not expanded
+ex:R8 ex:name "r8" .
+ex:S8 rdf:subject ex:R8 ;
+      ex:note [ ex:val "v" ] .
+
+# Blank-node cycle
+ex:cyc ex:has _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format='turtle')
+        self.graph.bind('ex', EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        b1 = next(self.graph.subjects(EX.address))
+        self.assertEqual(len(self.graph.cbd(b1)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.r1)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.r2)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.nothing)), 0)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+        result = self.graph.cbd(EX.R6)
+        self.assertIn((EX.S6b, RDF.subject, EX.R6), result)
+
+    def testCbdIncomingReification(self):
+        result_b = self.graph.cbd(EX.B)
+        self.assertEqual(len(result_b), 1)
+        self.assertNotIn((EX.S7, RDF.subject, EX.A), result_b)
+        result_a = self.graph.cbd(EX.A)
+        self.assertIn((EX.S7, RDF.subject, EX.A), result_a)
+        self.assertEqual(len(result_a), 6)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        bn = self.graph.value(EX.S8, EX.note)
+        self.assertEqual(len(result), 3)
+        self.assertNotIn((bn, EX.val, Literal('v')), result)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.cyc)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, None, None)))), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(self.graph), before)
+
+
+if __name__ == '__main__':
+    unittest.main(argv=sys.argv[:1])
