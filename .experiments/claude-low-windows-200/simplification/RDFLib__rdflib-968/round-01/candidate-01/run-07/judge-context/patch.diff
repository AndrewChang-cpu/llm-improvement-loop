diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..ceb91e3 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,48 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the starting node.
+        2. For each object that is a blank node, recursively apply rules
+           1 and 2 to that blank node, unless the result already contains
+           a triple with that blank node as subject (cycle guard).
+        3. Reification: for every node processed, include every triple
+           whose subject is a statement S that has an rdf:subject triple
+           whose object is that node. Every such statement is included,
+           with no rdf:Statement type check and no matching of its
+           rdf:predicate or rdf:object values. The rdf:object and
+           rdf:predicate values of a reifier are not followed.
+
+        The result is a new Graph containing a subgraph of the source
+        graph; the source graph is not modified. Namespace bindings of the
+        source graph are not copied. Only this method and its nested helper
+        are defined; SPARQL DESCRIBE is not implemented by this method.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rules 1 and 2: triples with node as subject
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        True for _ in result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3: reification via rdf:subject
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..106ecd2
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,156 @@
+import sys
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+TURTLE_FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: blank-node resource with a nested blank node (8 triples)
+ex:Root ex:holds _:b1 .
+_:b1 ex:p1 ex:U1 ;
+     ex:p2 ex:U2 ;
+     ex:p3 _:b2 .
+_:b2 ex:q1 "a" ;
+     ex:q2 _:b3 ;
+     ex:q3 "c" .
+_:b3 ex:s "x" ;
+     ex:t "y" .
+
+# Rules 1 and 2: type triple and two relations (3 triples)
+ex:R1 a ex:Thing ;
+      ex:rel1 ex:X ;
+      ex:rel2 ex:Y .
+
+# Rules 1 and 2: two property triples (2 triples)
+ex:P1 ex:name "a" ;
+      ex:label "b" .
+
+# Reified case A: typed reifier of R5 (3 + 5 = 8 triples)
+ex:R5 ex:a "1" ;
+      ex:b "2" ;
+      ex:c ex:Z .
+ex:S5 a rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:a ;
+      rdf:object "1" ;
+      ex:note "n" .
+
+# Reified case B: typed and untyped reifiers of R6 (3 + 5 + 5 = 13 triples)
+ex:R6 ex:a "1" ;
+      ex:b "2" ;
+      ex:c ex:Z .
+ex:S6 a rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:a ;
+      rdf:object "1" ;
+      ex:note "n" .
+ex:S7 rdf:subject ex:R6 ;
+      rdf:predicate ex:b ;
+      rdf:object "2" ;
+      ex:note "m" ;
+      ex:date "d" .
+
+# Incoming reification: statement (A p B) reified by S8
+ex:A ex:p ex:B .
+ex:S8 rdf:subject ex:A ;
+      rdf:object ex:B ;
+      ex:note "n" .
+
+# Reifier whose blank-node object must not be expanded
+ex:R7 ex:a "1" .
+ex:S9 rdf:subject ex:R7 ;
+      ex:note _:bn9 .
+_:bn9 ex:v "x" .
+
+# Blank-node cycle
+ex:C ex:link _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph()
+        self.graph.parse(data=TURTLE_FIXTURE, format="turtle")
+        self.graph.bind("ex", self.ex)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        ex = self.ex
+        bnode = self.graph.value(ex.Root, ex.holds)
+        result = self.graph.cbd(bnode)
+        self.assertEqual(len(result), 8)
+
+    def testCbdTypeAndRelations(self):
+        result = self.graph.cbd(self.ex.R1)
+        self.assertEqual(len(result), 3)
+
+    def testCbdTwoProperties(self):
+        result = self.graph.cbd(self.ex.P1)
+        self.assertEqual(len(result), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(self.ex.Absent)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(result), 8)
+        self.assertEqual(
+            len(list(result.triples((self.ex.S5, None, None)))), 5)
+
+    def testCbdReifiedUntypedIncluded(self):
+        ex = self.ex
+        result = self.graph.cbd(ex.R6)
+        self.assertEqual(len(result), 13)
+        # The untyped reifier S7 must be included
+        self.assertEqual(
+            len(list(result.triples((ex.S7, None, None)))), 5)
+
+    def testCbdIncomingReification(self):
+        ex = self.ex
+        target = self.graph.cbd(ex.B)
+        self.assertEqual(len(target), 0)
+        self.assertEqual(
+            len(list(target.triples((ex.S8, None, None)))), 0)
+
+        source = self.graph.cbd(ex.A)
+        self.assertEqual(
+            len(list(source.triples((ex.S8, None, None)))), 3)
+        self.assertIn((ex.A, ex.p, ex.B), source)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        ex = self.ex
+        bn9 = self.graph.value(ex.S9, ex.note)
+        result = self.graph.cbd(ex.R7)
+        self.assertEqual(len(result), 3)
+        self.assertIn((ex.S9, ex.note, bn9), result)
+        self.assertEqual(
+            len(list(result.triples((bn9, None, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        ex = self.ex
+        result = self.graph.cbd(ex.C)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        size_before = len(self.graph)
+        result = self.graph.cbd(self.ex.R6)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), size_before)
+        self.assertEqual(set(self.graph), before)
+        self.assertTrue(set(result).issubset(before))
+
+
+if __name__ == '__main__':
+    unittest.main(argv=sys.argv[:1])
