diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..44ad49e 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,52 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a resource from this
+        graph, as defined by the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included. For each
+           object that is a blank node not already described in the result,
+           its own description is included recursively.
+        2. Every statement S that reifies the resource (an ``rdf:subject``
+           triple whose object is the resource) is included: all triples
+           whose subject is S are added. This applies to every statement
+           with ``rdf:subject`` equal to the node, without checking for an
+           ``rdf:Statement`` type and without matching ``rdf:predicate`` or
+           ``rdf:object`` values.
+        3. The ``rdf:object`` and ``rdf:predicate`` values of reifiers are
+           not followed, and blank nodes that appear only as objects of
+           reifier triples are not described.
+
+        The result is a subgraph of this graph; this graph is not modified.
+        Namespace bindings are not copied.
+
+        :param resource: the resource term to describe, used as given in
+            triple-pattern queries.
+        :return: a new :class:`~rdflib.graph.Graph` containing the
+            description.
+        """
+
+        def add_to_cbd(node, result):
+            # Rule 1: add all triples with node as subject.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+            # Recurse into blank-node objects not yet described in the result.
+            for s, p, o in self.triples((node, None, None)):
+                if type(o) is BNode and not any(
+                        True for _ in result.triples((o, None, None))):
+                    add_to_cbd(o, result)
+            # Rule 2: add all triples of statements reifying node.
+            for reifier in set(self.subjects(RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..cd9f19a
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,130 @@
+import unittest
+
+from rdflib import Graph, Namespace, RDF
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+# Rules 1 and 2: blank-node expansion
+ex:R1 ex:p1 ex:U1 ;
+      ex:p2 ex:U2 ;
+      ex:p3 _:b1 .
+_:b1 ex:p "a" ;
+     ex:q "b" ;
+     ex:n _:b2 .
+_:b2 ex:r "c" ;
+     ex:s "d" .
+
+# Rules 1 and 2: type and relation triples
+ex:R2 a ex:Thing ;
+      ex:rel1 ex:U1 ;
+      ex:rel2 ex:U2 .
+
+# Rules 1 and 2: two property triples
+ex:R3 ex:prop1 "x" ;
+      ex:prop2 "y" .
+
+# Reified case A: one typed reifier
+ex:R5 ex:a ex:U1 ;
+      ex:b "1" ;
+      ex:c "2" .
+ex:S5 a rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:a ;
+      rdf:object ex:U1 ;
+      ex:note "n" .
+
+# Reified case B: typed and untyped reifiers
+ex:R6 ex:a ex:U1 ;
+      ex:b "1" ;
+      ex:c "2" .
+ex:S6t a rdf:Statement ;
+       rdf:subject ex:R6 ;
+       rdf:predicate ex:a ;
+       rdf:object ex:U1 ;
+       ex:note "n" .
+ex:S6u rdf:subject ex:R6 ;
+       rdf:predicate ex:b ;
+       rdf:object "1" ;
+       ex:x "x" ;
+       ex:y "y" .
+
+# Incoming reification: (A p B) reified by S
+ex:A ex:p ex:B .
+ex:S rdf:subject ex:A ;
+     rdf:predicate ex:p ;
+     rdf:object ex:B ;
+     ex:note "i" .
+
+# Reifier whose blank-node object is not described
+ex:R7 ex:a "1" .
+ex:S7 rdf:subject ex:R7 ;
+      ex:x _:bn .
+_:bn ex:y "2" .
+
+# Blank-node cycle
+ex:R8 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph().parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Rule 1 with a blank-node object that has a nested blank node.
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 8)
+        # Type triple and two relation triples.
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        # Two property triples.
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+        # No triples at all.
+        self.assertEqual(len(self.graph.cbd(EX.Nothing)), 0)
+
+    def testCbdTypedReifier(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+
+    def testCbdUntypedReifier(self):
+        result = self.graph.cbd(EX.R6)
+        # The untyped reifier S6u must be included.
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6u, EX.x, None), result)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (A p B) is excluded from cbd of B...
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        # ...and included in cbd of A.
+        result = self.graph.cbd(EX.A)
+        self.assertIn((EX.S, EX.note, None), result)
+        self.assertEqual(len(result), 5)
+
+    def testCbdReifiedBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.R7)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, EX.y, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, None, None)))), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
