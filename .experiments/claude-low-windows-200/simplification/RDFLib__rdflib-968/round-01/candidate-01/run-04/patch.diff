diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..ad613b0 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,46 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the starting node.
+        2. For each blank node object of an included triple, recursively
+           include its triples (cycles are cut by never expanding a blank
+           node that already has a triple in the result).
+        3. Reification: for every processed node N, include every statement
+           S that has an rdf:subject triple whose object is N, together with
+           all triples whose subject is S. Every such statement is included;
+           no rdf:Statement type check and no matching of rdf:predicate or
+           rdf:object values is performed. The rdf:object and rdf:predicate
+           values of a reifier are not followed.
+
+        The result is a new Graph that is a subgraph of this Graph; this
+        Graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rules 1 and 2: triples whose subject is node
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) is BNode and not any(
+                        True for _ in result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3: statements reifying node
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..47a44c0
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,131 @@
+import sys
+import unittest
+
+from rdflib import Graph, Literal, Namespace, RDF
+
+EX = Namespace('http://example.org/')
+
+TTL = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: resource with a type and two relations (3 triples)
+ex:R1 ex:type ex:Thing ;
+      ex:rel1 ex:Obj1 ;
+      ex:rel2 ex:Obj2 .
+
+# Rules 1 and 2: resource with two property triples (2 triples)
+ex:R2 ex:name "two" ;
+      ex:value 2 .
+
+# Rules 1 and 2: blank-node resource (8 triples)
+[] ex:id "bnode" ;
+   ex:p1 ex:Obj1 ;
+   ex:p2 ex:Obj2 ;
+   ex:child [ ex:name "child" ;
+              ex:nested [ ex:name "nested" ;
+                          ex:mark "m" ] ] .
+
+# Reified case A: three direct triples plus a typed reifier (5 triples)
+ex:R5 ex:a "1" ;
+      ex:b ex:Obj1 ;
+      ex:c ex:Obj2 .
+[] a rdf:Statement ;
+   rdf:subject ex:R5 ;
+   rdf:predicate ex:a ;
+   rdf:object "1" ;
+   ex:note "typed-a" .
+
+# Reified case B: three direct triples, a typed reifier and an untyped reifier
+ex:R6 ex:a "1" ;
+      ex:b ex:Obj1 ;
+      ex:c ex:Obj2 .
+[] a rdf:Statement ;
+   rdf:subject ex:R6 ;
+   rdf:predicate ex:a ;
+   rdf:object "1" ;
+   ex:note "typed-b" .
+[] rdf:subject ex:R6 ;
+   rdf:predicate ex:b ;
+   rdf:object ex:Obj1 ;
+   ex:p1 "u1" ;
+   ex:p2 "u2" .
+
+# Incoming reification: statement (ex:A ex:p ex:B) reified by one reifier
+ex:A ex:p ex:B .
+[] rdf:subject ex:A ;
+   rdf:predicate ex:p ;
+   rdf:object ex:B ;
+   ex:note "incoming" .
+
+# Reifier whose rdf:object is a blank node that is not reached by rules 1 or 2
+ex:R7 ex:p ex:Obj1 .
+[] rdf:subject ex:R7 ;
+   rdf:predicate ex:p ;
+   rdf:object [ ex:hidden "h" ] .
+
+# Blank-node cycle: _:a -> _:b -> _:a
+ex:root ex:p _:a .
+_:a ex:q _:b .
+_:b ex:r _:a ;
+    ex:s "x" .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=TTL, format='turtle')
+        self.graph.bind('example', EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        blank = self.graph.value(None, EX.id, Literal('bnode'))
+        self.assertEqual(len(self.graph.cbd(blank)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.NoSuchResource)), 0)
+
+    def testCbdReturnsNewGraph(self):
+        result = self.graph.cbd(EX.R2)
+        self.assertIsInstance(result, Graph)
+        self.assertIsNot(result, self.graph)
+
+    def testCbdTypedReifier(self):
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+        self.assertIn((None, EX.note, Literal('typed-a')), result)
+
+    def testCbdUntypedReifier(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((None, EX.p1, Literal('u1')), result)
+        self.assertIn((None, RDF.subject, EX.R6), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 5)
+        self.assertIn((None, EX.note, Literal('incoming')), result)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.R7)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, EX.hidden, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.root)
+        self.assertEqual(len(result), 4)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        self.graph.cbd(EX.R6)
+        self.graph.cbd(EX.root)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == '__main__':
+    unittest.main(argv=sys.argv[:1])
