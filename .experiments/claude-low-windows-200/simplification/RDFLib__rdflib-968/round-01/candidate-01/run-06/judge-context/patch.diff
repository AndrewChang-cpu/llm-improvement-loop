diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..7fc3082 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,53 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/ and is applied here
+        as follows:
+
+        1. Include every triple whose subject is the resource.
+        2. For each object of such a triple that is a blank node, apply the
+           same rules recursively, unless the result already contains a
+           triple whose subject is that blank node (which ends cycles).
+        3. Reification: for every node processed, include every triple whose
+           subject is a statement S with an ``rdf:subject`` triple whose
+           object is that node. Every statement with such an ``rdf:subject``
+           triple is included, whether or not it is typed ``rdf:Statement``
+           and whether or not its ``rdf:predicate`` or ``rdf:object`` values
+           match any triple. The ``rdf:object`` and ``rdf:predicate`` values
+           of such statements are not followed.
+
+        The result is a subgraph of this Graph; this Graph is not modified.
+
+        :param resource: the resource (URIRef or BNode) to describe.
+        :return: a new Graph containing the Concise Bounded Description of
+            the resource. It is empty if the resource has no triples and no
+            reifiers.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            blank_objects = []
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                if isinstance(triple[2], BNode):
+                    blank_objects.append(triple[2])
+
+            for obj in blank_objects:
+                if (obj, None, None) not in result:
+                    add_to_cbd(obj)
+
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..5204d63
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,135 @@
+import unittest
+
+from rdflib import Graph, Literal, Namespace, RDF
+
+
+TTL = """
+@prefix example: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+example:R1 a example:Thing ; example:rel example:R2 ; example:rel2 example:R3 .
+
+example:R4 example:p1 "a" ; example:p2 "b" .
+
+example:Root example:name "root" ;
+    example:p1 example:U1 ;
+    example:p2 example:U2 ;
+    example:p3 _:b1 .
+_:b1 example:q "v" ; example:r _:b2 .
+_:b2 example:s "w" ; example:t "z" .
+
+example:R5 example:a "1" ; example:b "2" ; example:c "3" .
+example:S5 a rdf:Statement ;
+    rdf:subject example:R5 ;
+    rdf:predicate example:a ;
+    rdf:object "1" ;
+    example:note "typed" .
+
+example:R6 example:a "1" ; example:b "2" ; example:c "3" .
+example:S6 a rdf:Statement ;
+    rdf:subject example:R6 ;
+    rdf:predicate example:a ;
+    rdf:object "1" ;
+    example:note "typed" .
+example:S6u rdf:subject example:R6 ;
+    rdf:predicate example:b ;
+    rdf:object "2" ;
+    example:n1 "x" ;
+    example:n2 "y" .
+
+example:A example:p example:B .
+example:S9 rdf:subject example:A ;
+    rdf:predicate example:p ;
+    rdf:object example:B ;
+    example:note "incoming" .
+
+example:R8 example:q "k" .
+example:S8 rdf:subject example:R8 ;
+    rdf:object _:bo ;
+    example:x "1" .
+_:bo example:y "2" .
+
+_:c1 example:next _:c2 .
+_:c2 example:next _:c1 .
+example:Cyc example:has _:c1 .
+"""
+
+EX = Namespace('http://example.org/')
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind('example', EX)
+        self.graph.parse(data=TTL, format='turtle')
+
+    def tearDown(self):
+        self.graph.close()
+
+    def blankRoot(self):
+        return next(self.graph.subjects(EX.name, Literal('root')))
+
+    def testCbd(self):
+        root = self.blankRoot()
+        result = self.graph.cbd(root)
+        # 3 direct triples, 3 for _:b1, 2 for _:b2
+        self.assertEqual(len(result), 8)
+
+        r1 = self.graph.cbd(EX.R1)
+        self.assertEqual(len(r1), 3)
+
+        r4 = self.graph.cbd(EX.R4)
+        self.assertEqual(len(r4), 2)
+
+        empty = self.graph.cbd(EX.NoSuchResource)
+        self.assertEqual(len(empty), 0)
+        self.assertIsInstance(empty, Graph)
+
+    def testCbdReified(self):
+        # 3 direct triples + typed reifier (type, subject, predicate,
+        # object, note)
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        # 3 direct + typed reifier (5) + untyped reifier (5)
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6u, RDF.subject, EX.R6), result)
+        self.assertIn((EX.S6u, EX.n1, Literal('x')), result)
+
+    def testCbdIncomingReification(self):
+        # Statement A p B is reified by S9 whose rdf:subject is A.
+        # S9 is not reached from B, and B has no outgoing triples.
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertIn((EX.S9, EX.note, Literal('incoming')), result)
+        self.assertEqual(len(result), 5)
+
+    def testCbdReifierBlankObjectNotExpanded(self):
+        # _:bo is only the object of a reifier triple, so its triples
+        # are not added.
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, EX.y, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.Cyc)
+        self.assertEqual(len(result), 3)
+        c1 = self.graph.value(EX.Cyc, EX.has)
+        c2 = self.graph.value(c1, EX.next)
+        self.assertIn((c1, EX.next, c2), result)
+        self.assertIn((c2, EX.next, c1), result)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        root = self.blankRoot()
+        result = self.graph.cbd(root)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+        self.assertTrue(all(t in self.graph for t in result))
+
+
+if __name__ == '__main__':
+    unittest.main()
