diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..33fc3e8 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,53 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission "CBD - Concise Bounded Description"
+        (https://www.w3.org/Submission/CBD/). Three rules are applied to
+        the starting node and to every blank node reached from it:
+
+        1. Every triple whose subject is the node is included. Each
+           object that is a blank node is described in the same way,
+           unless the result already contains a triple with that blank
+           node as its subject (which stops cycles).
+        2. Every statement S with an rdf:subject triple whose object is
+           the node is a reifier of the node. Every triple whose subject
+           is a reifier is included. Reification is not checked against
+           rdf:Statement, rdf:predicate or rdf:object, so every statement
+           whose rdf:subject is the node is included.
+        3. The rdf:object and rdf:predicate values of a reifier are not
+           followed, and blank nodes that appear only as objects of
+           triples added by rule 2 are not described.
+
+        The result is a subgraph of this graph; this graph is not
+        modified. Namespace bindings are not copied.
+
+        :param resource: the starting node of the description
+        :return: a new :class:`Graph` containing the Concise Bounded
+            Description of ``resource``; empty if the graph has no
+            matching triples
+        """
+        retval = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: all triples whose subject is node.
+            for s, p, o in self.triples((node, None, None)):
+                retval.add((s, p, o))
+            for s, p, o in self.triples((node, None, None)):
+                if isinstance(o, BNode) and not any(
+                        True for _ in retval.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 2: reifiers of node contribute all their triples.
+            for reifier in set(self.subjects(RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    retval.add((s, p, o))
+
+        add_to_cbd(resource)
+        return retval
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..e52d95c
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,134 @@
+import unittest
+
+from rdflib import Graph, Namespace, RDF
+
+
+TTL = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix example: <http://example.org/> .
+
+# Rules 1 and 2 counts: blank-node resource with 8 triples
+[] example:name "n" ;
+   example:knows example:A ;
+   example:likes example:B ;
+   example:addr [ example:street "s" ;
+                  example:geo [ example:lat "1" ; example:long "2" ] ] .
+
+# Rules 1 and 2 counts: 3 triples
+example:R1 rdf:type example:Thing ;
+   example:rel example:X ;
+   example:rel example:Y .
+
+# Rules 1 and 2 counts: 2 triples
+example:R2 example:p "1" ;
+   example:q "2" .
+
+# Reified case A: 3 direct triples + typed reifier (8 total)
+example:R5 example:p1 "a" ;
+   example:p2 example:X ;
+   example:p3 "c" .
+example:S5 rdf:type rdf:Statement ;
+   rdf:subject example:R5 ;
+   rdf:predicate example:p ;
+   rdf:object example:o ;
+   example:note "a" .
+
+# Reified case B: 3 direct triples + typed reifier + untyped reifier (13 total)
+example:R6 example:p1 "a" ;
+   example:p2 example:X ;
+   example:p3 "c" .
+example:S6 rdf:type rdf:Statement ;
+   rdf:subject example:R6 ;
+   rdf:predicate example:p ;
+   rdf:object example:o ;
+   example:note "a" .
+example:U6 rdf:subject example:R6 ;
+   rdf:predicate example:q ;
+   rdf:object example:o2 ;
+   example:r1 "x" ;
+   example:r2 "y" .
+
+# Incoming reification: statement (A p B) reified by S
+example:A example:p example:B ;
+   example:label "a" .
+example:B example:label "b" .
+example:S7 rdf:subject example:A ;
+   rdf:object example:B ;
+   example:note "x" .
+
+# A reifier's blank-node object is not described unless reached by rules 1 or 2
+example:R8 example:p example:Q .
+example:S8 rdf:subject example:R8 ;
+   rdf:object [ example:x "y" ] .
+
+# Blank-node cycle
+example:R9 example:p _:c1 .
+_:c1 example:next _:c2 ;
+     example:name "a" .
+_:c2 example:next _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph()
+        self.graph.parse(data=TTL, format="turtle")
+        self.graph.bind("example", self.ex)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Blank-node resource: 4 direct triples + 4 from nested blank nodes.
+        blank = next(self.graph.subjects(self.ex.name, None))
+        self.assertEqual(len(self.graph.cbd(blank)), 8)
+        # URI resource with a type and two relations.
+        self.assertEqual(len(self.graph.cbd(self.ex.R1)), 3)
+        # URI resource with two property triples.
+        self.assertEqual(len(self.graph.cbd(self.ex.R2)), 2)
+        # Resource with no triples yields an empty graph.
+        self.assertEqual(len(self.graph.cbd(self.ex.Nothing)), 0)
+
+    def testCbdReified(self):
+        # Case A: typed reifier contributes its 5 triples.
+        self.assertEqual(len(self.graph.cbd(self.ex.R5)), 8)
+        # Case B: typed and untyped reifiers both contribute.
+        result = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((self.ex.U6, self.ex.r1, None), result)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (A p B) is not included in the description of B.
+        result_b = self.graph.cbd(self.ex.B)
+        self.assertEqual(len(result_b), 1)
+        self.assertNotIn((self.ex.S7, None, None), result_b)
+        # It is included in the description of A.
+        result_a = self.graph.cbd(self.ex.A)
+        self.assertEqual(len(result_a), 5)
+        self.assertIn((self.ex.S7, self.ex.note, None), result_a)
+
+    def testCbdReifierBlankObjectNotExpanded(self):
+        result = self.graph.cbd(self.ex.R8)
+        # R8 p Q, plus the two triples of reifier S8 (rdf:subject, rdf:object).
+        self.assertEqual(len(result), 3)
+        # The blank node reached only as rdf:object of S8 is not described.
+        for _, _, bnode in result.triples((None, RDF.object, None)):
+            self.assertEqual(len(list(result.triples((bnode, None, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(self.ex.R9)
+        # R9 p c1; c1 next c2; c1 name "a"; c2 next c1 -- each once.
+        self.assertEqual(len(result), 4)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(self.ex.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+        self.assertIsInstance(result, Graph)
+
+
+if __name__ == '__main__':
+    unittest.main()
