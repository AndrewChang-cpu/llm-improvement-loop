diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..44dedea 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,48 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/ and is applied
+        here as follows:
+
+        1. Include every triple whose subject is the resource.
+        2. For every object that is a blank node, apply rule 1 and rule 2
+           to that blank node, unless the result already contains a triple
+           whose subject is that blank node.
+        3. Reification: for every statement whose ``rdf:subject`` is the
+           resource, include every triple whose subject is that statement.
+           No ``rdf:Statement`` type check and no matching of
+           ``rdf:predicate`` or ``rdf:object`` is performed. Blank nodes
+           found in these reified triples are not expanded.
+
+        The result is a new Graph containing a subgraph of this Graph; this
+        Graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the node whose description is requested, used as
+            the subject in triple-pattern queries.
+        :return: a new Graph holding the Concise Bounded Description.
+        """
+        cbd = Graph()
+
+        def add_to_cbd(node, cbd):
+            # Rules 1 and 2: triples with the node as subject.
+            for s, p, o in self.triples((node, None, None)):
+                cbd.add((s, p, o))
+                if type(o) is BNode and not any(
+                        True for _ in cbd.triples((o, None, None))):
+                    add_to_cbd(o, cbd)
+            # Rule 3: reifications of the node.
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    cbd.add((s, p, o))
+
+        add_to_cbd(resource, cbd)
+        return cbd
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..e53bc25
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,111 @@
+import unittest
+
+from rdflib import Graph
+from rdflib.namespace import Namespace
+
+EX = Namespace("http://example.org/")
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rule 1 and 2: type plus two relations.
+ex:R1 a ex:Thing ; ex:rel1 ex:O1 ; ex:rel2 ex:O2 .
+
+# Rule 1: two property triples.
+ex:R2 ex:prop1 "one" ; ex:prop2 "two" .
+
+# Rule 2: nested blank nodes.
+ex:R3 ex:p ex:A ; ex:q ex:B ; ex:r [ ex:s [ ex:t "deep" ] ] .
+
+# Blank-node resource with a nested blank node.
+[ ex:marker "bn" ; ex:a ex:b ; ex:c [ ex:d "e" ] ] .
+
+# Reified case A: three direct triples and one typed reifier.
+ex:R5 ex:a ex:b ; ex:c ex:d ; ex:e "f" .
+ex:S5 a rdf:Statement ; rdf:subject ex:R5 ;
+    rdf:predicate ex:a ; rdf:object ex:b ; ex:note "n5" .
+
+# Reified case B: three direct triples, a typed and an untyped reifier.
+ex:R6 ex:a ex:b ; ex:c ex:d ; ex:e "f" .
+ex:S6a a rdf:Statement ; rdf:subject ex:R6 ;
+    rdf:predicate ex:a ; rdf:object ex:b ; ex:note "n6a" .
+ex:S6b rdf:subject ex:R6 ; rdf:predicate ex:c ; rdf:object ex:d ;
+    ex:note "n6b" ; ex:extra "x" .
+
+# Incoming reification: statement (A p B) with a reifier of A and B.
+ex:A ex:p ex:B .
+ex:S7 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:B ;
+    ex:note "n7" .
+
+# Reifier whose blank-node object must not be expanded.
+ex:R8 ex:a ex:b .
+ex:S8 rdf:subject ex:R8 ; ex:hidden [ ex:deep "x" ] .
+
+# Blank-node cycle.
+_:c1 ex:next _:c2 ; ex:cycleMarker "start" .
+_:c2 ex:next _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=TURTLE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(EX.R1)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 3)
+
+    def testCbdPropertiesOnly(self):
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdNestedBlankNodes(self):
+        # R3 direct: p, q, r; _:b1 s _:b2; _:b2 t "deep"
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 5)
+
+    def testCbdBlankNodeResource(self):
+        bnode = next(self.graph.subjects(EX.marker, None))
+        # marker, a, c, plus nested d
+        self.assertEqual(len(self.graph.cbd(bnode)), 4)
+
+    def testCbdTypedReifier(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+
+    def testCbdUntypedReifierIncluded(self):
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        # statement (A p B) plus reifier S7 with four triples
+        self.assertEqual(len(self.graph.cbd(EX.A)), 5)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        # R8 a b; S8 rdf:subject R8; S8 ex:hidden _:h (h's triples excluded)
+        self.assertEqual(len(self.graph.cbd(EX.R8)), 3)
+
+    def testCbdBlankNodeCycle(self):
+        start = next(self.graph.subjects(EX.cycleMarker, None))
+        result = self.graph.cbd(start)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R6)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
