diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..3e58839 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,50 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a resource from this
+        graph, as described in the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/).
+
+        The description is built from three rules:
+
+        1. Every triple whose subject is the resource is included. Each
+           blank node object of such a triple is described in the same way,
+           recursively, unless the description already contains a triple
+           with that blank node as subject.
+        2. Every reifier of the resource is included: every node S that has
+           an rdf:subject triple whose object is the resource contributes
+           all triples whose subject is S. No rdf:Statement type check and
+           no rdf:predicate or rdf:object matching is performed.
+        3. Blank nodes reached only through rule 2 are not described, and
+           the rdf:object and rdf:predicate values of a reifier are not
+           followed.
+
+        The result is a subgraph of this graph; this graph is not modified.
+
+        :param resource: The resource (URIRef or BNode) to describe. It is
+            used as given in triple-pattern queries.
+        :return: A new Graph containing the Concise Bounded Description of
+            resource. The graph is empty if the resource has no triples in
+            this graph.
+        """
+        def add_to_cbd(node):
+            # Rule 1: triples with the node as subject.
+            for s, p, o in self.triples((node, None, None)):
+                cbd.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        cbd.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 2: triples of every reifier of the node.
+            for reifier in self.subjects(RDF.subject, node):
+                for triple in self.triples((reifier, None, None)):
+                    cbd.add(triple)
+
+        cbd = Graph()
+        add_to_cbd(resource)
+        return cbd
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..219f84e
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,176 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+RDF = Namespace("http://www.w3.org/1999/02/22-rdf-syntax-ns#")
+
+PREFIXES = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", EX)
+        # Unrelated base data, present in every test.
+        self.graph.parse(data=PREFIXES + "ex:Base ex:p ex:Other .",
+                         format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def parse(self, body):
+        self.graph.parse(data=PREFIXES + body, format="turtle")
+
+    def testCbd(self):
+        # Rules 1 and 2: a type triple and two relation triples.
+        self.parse("""
+            ex:R a ex:Thing ;
+                ex:rel ex:X ;
+                ex:rel ex:Y .
+            ex:Unrelated ex:rel ex:Z .
+        """)
+        result = self.graph.cbd(EX.R)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 3)
+
+    def testCbdProperties(self):
+        # Two property triples; the incoming triple is excluded.
+        self.parse("""
+            ex:R ex:name "one" ;
+                ex:label "two" .
+            ex:X ex:points ex:R .
+        """)
+        result = self.graph.cbd(EX.R)
+        self.assertEqual(len(result), 2)
+        self.assertNotIn((EX.X, EX.points, EX.R), result)
+
+    def testCbdNoTriples(self):
+        self.parse("ex:A ex:b ex:C .")
+        result = self.graph.cbd(EX.R)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdNestedBlankNodes(self):
+        self.parse("""
+            ex:R ex:p1 ex:O1 ;
+                ex:p2 ex:O2 ;
+                ex:p3 _:b1 .
+            _:b1 ex:q ex:O4 ;
+                ex:r _:b2 .
+            _:b2 ex:s ex:O5 .
+            ex:Unrelated ex:p ex:O6 .
+        """)
+        result = self.graph.cbd(EX.R)
+        self.assertEqual(len(result), 6)
+        self.assertNotIn((EX.Unrelated, EX.p, EX.O6), result)
+
+    def testCbdBlankNodeResource(self):
+        self.parse("""
+            _:b1 ex:p ex:O1 ;
+                ex:q _:b2 .
+            _:b2 ex:r ex:O2 ;
+                ex:s "x" .
+        """)
+        b1 = self.graph.value(predicate=EX.p, object=EX.O1)
+        result = self.graph.cbd(b1)
+        self.assertEqual(len(result), 4)
+
+    def testCbdReifiedTyped(self):
+        # Case A: three direct triples plus a typed reifier with
+        # four other triples (five triples including rdf:subject).
+        self.parse("""
+            ex:R5 ex:p1 ex:O1 ;
+                ex:p2 ex:O2 ;
+                ex:p3 ex:O3 .
+            ex:S1 a rdf:Statement ;
+                rdf:subject ex:R5 ;
+                rdf:predicate ex:p1 ;
+                rdf:object ex:O1 ;
+                ex:note "n" .
+        """)
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntyped(self):
+        # Case B: the untyped reifier is included.
+        self.parse("""
+            ex:R6 ex:p1 ex:O1 ;
+                ex:p2 ex:O2 ;
+                ex:p3 ex:O3 .
+            ex:S1 a rdf:Statement ;
+                rdf:subject ex:R6 ;
+                rdf:predicate ex:p1 ;
+                rdf:object ex:O1 ;
+                ex:note "n" ;
+                ex:src "s" .
+            ex:S2 rdf:subject ex:R6 ;
+                ex:predicate ex:p2 ;
+                rdf:object ex:O2 ;
+                ex:note "m" ;
+                ex:src "t" .
+        """)
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S2, RDF.subject, EX.R6), result)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (A p B) is included for A but not for B.
+        self.parse("""
+            ex:A ex:p ex:B .
+            ex:S ex:note "n" ;
+                rdf:subject ex:A ;
+                rdf:object ex:B .
+        """)
+        result_b = self.graph.cbd(EX.B)
+        self.assertEqual(len(result_b), 0)
+        result_a = self.graph.cbd(EX.A)
+        self.assertEqual(len(result_a), 4)
+        self.assertIn((EX.S, RDF.subject, EX.A), result_a)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        # The blank node object of a reifier's triple is not described
+        # unless rules 1 or 2 reach it.
+        self.parse("""
+            ex:R ex:p ex:O1 .
+            ex:S rdf:subject ex:R ;
+                rdf:object _:b1 ;
+                ex:note "n" .
+            _:b1 ex:q ex:O2 .
+        """)
+        result = self.graph.cbd(EX.R)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, EX.q, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        self.parse("""
+            ex:R ex:p _:b1 .
+            _:b1 ex:q _:b2 .
+            _:b2 ex:r _:b1 .
+        """)
+        result = self.graph.cbd(EX.R)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        self.parse("""
+            ex:R ex:p ex:O1 ;
+                ex:q _:b1 .
+            _:b1 ex:r ex:O2 .
+            ex:S rdf:subject ex:R ;
+                ex:note "n" .
+        """)
+        before = set(self.graph)
+        before_len = len(self.graph)
+        result = self.graph.cbd(EX.R)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before_len)
+        self.assertEqual(set(self.graph), before)
+        self.assertGreater(len(result), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
