diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..5c663b6 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) and is applied here
+        as follows:
+
+        1. Every triple whose subject is the resource is included.
+        2. Every blank node object of an included triple is described
+           recursively by the same rules. A blank node is expanded only
+           if the result does not already contain a triple with that
+           blank node as subject, so cycles terminate.
+        3. Reification: every statement whose ``rdf:subject`` is the
+           resource (or a described blank node) is a reifier, and all of
+           its triples are included. No ``rdf:Statement`` type check and
+           no matching of ``rdf:predicate`` or ``rdf:object`` is done.
+           Blank nodes reached only through reifier triples are not
+           expanded.
+
+        The result is a new subgraph of this Graph; this Graph is not
+        modified. Namespace bindings are not copied. If the resource has
+        no triples and no reifiers, an empty Graph is returned.
+
+        :param resource: the node whose description is wanted, used as
+            given in triple-pattern queries.
+        :return: a new Graph containing the Concise Bounded Description.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rules 1 and 2: direct triples, expanding unseen blank nodes.
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode and \
+                        not any(result.triples((obj, None, None))):
+                    add_to_cbd(obj)
+            # Rule 3: reifiers of this node contribute all their triples.
+            for reifier in self.subjects(RDF.subject, node):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..dc99c97
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,102 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: direct triples and a nested blank node.
+ex:R1 ex:p ex:A ; ex:q ex:B ; rdf:type ex:Thing .
+ex:A ex:name "a" .
+ex:R2 ex:p "x" ; ex:q "y" .
+ex:R3 ex:link [ ex:name "b" ; ex:child [ ex:v "c" ] ] .
+
+# Reification case A: one typed reifier with four other triples.
+ex:R5 ex:p ex:A ; ex:q ex:B ; ex:r ex:C .
+ex:st1 rdf:type rdf:Statement ; rdf:subject ex:R5 ;
+    rdf:predicate ex:p ; rdf:object ex:A ; ex:note "n" .
+
+# Reification case B: a typed and an untyped reifier.
+ex:R6 ex:p ex:A ; ex:q ex:B ; ex:r ex:C .
+ex:st2 rdf:type rdf:Statement ; rdf:subject ex:R6 ;
+    rdf:predicate ex:p ; rdf:object ex:A ; ex:note "n" .
+ex:st4 rdf:subject ex:R6 ; ex:predicate ex:p ;
+    ex:object ex:A ; ex:note "m" ; ex:when "t" .
+
+# Incoming reification: (ex:A ex:p ex:B) is reified by ex:st5.
+ex:A ex:p ex:B .
+ex:st5 rdf:subject ex:A ; rdf:predicate ex:p ;
+    rdf:object ex:B ; ex:note "i" .
+
+# Blank node reached only through a reifier is not expanded.
+ex:R7 ex:p ex:A .
+ex:st6 rdf:subject ex:R7 ; ex:info [ ex:deep "z" ] .
+
+# Blank-node cycle: _:x -> _:y -> _:x.
+ex:R8 ex:p _:x .
+_:x ex:q _:y .
+_:y ex:r _:x .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph()
+        self.graph.bind("ex", self.ex)
+        self.graph.parse(data=TURTLE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Direct triples of R1 (3) and the blank-node-free R2 (2).
+        self.assertEqual(len(self.graph.cbd(self.ex.R1)), 3)
+        self.assertEqual(len(self.graph.cbd(self.ex.R2)), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(self.ex.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdBlankNodes(self):
+        # R3 link _:b, _:b name, _:b child _:c, _:c v.
+        self.assertEqual(len(self.graph.cbd(self.ex.R3)), 4)
+
+    def testCbdReifiedTyped(self):
+        # 3 direct triples plus the 5 triples of the typed reifier st1.
+        self.assertEqual(len(self.graph.cbd(self.ex.R5)), 8)
+
+    def testCbdReifiedUntyped(self):
+        # 3 direct, 5 typed reifier st2, 5 untyped reifier st4.
+        self.assertEqual(len(self.graph.cbd(self.ex.R6)), 13)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(self.ex.B)), 0)
+
+    def testCbdIncomingReificationIncluded(self):
+        # (A p B) plus the 4 triples of reifier st5 (subject triple included).
+        self.assertEqual(len(self.graph.cbd(self.ex.A)), 5)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        # st6 subject R7 and st6 info _:d; _:d deep "z" is not expanded.
+        result = self.graph.cbd(self.ex.R7)
+        self.assertEqual(len(result), 3)
+
+    def testCbdBlankNodeCycle(self):
+        # R8 p _:x; _:x q _:y; _:y r _:x. Each triple appears once.
+        result = self.graph.cbd(self.ex.R8)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(self.ex.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
