diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..13dd230 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,52 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission "CBD - Concise Bounded Description"
+        (https://www.w3.org/Submission/CBD/) and is implemented here with
+        three rules:
+
+        1. For the starting node, every triple whose subject is that node
+           is included.
+        2. If an object of an included triple is a blank node, rule 1 and
+           rule 2 are applied recursively to that blank node, unless the
+           result already contains a triple whose subject is that blank
+           node (this guards against cycles).
+        3. Reification: every statement whose ``rdf:subject`` is the node
+           is included, together with all triples whose subject is that
+           statement. No ``rdf:Statement`` type check is made and the
+           ``rdf:predicate`` and ``rdf:object`` values are not matched.
+           The reified statements' blank node objects are not expanded
+           unless rules 1 or 2 reach them.
+
+        The result is a new Graph that is a subgraph of this Graph; this
+        Graph is not modified. Namespace bindings are not copied.
+
+        This method does not implement SPARQL DESCRIBE.
+
+        :param resource: the node whose description is requested
+        :return: a new Graph containing the Concise Bounded Description
+        """
+
+        def add_to_cbd(node, result):
+            # Rules 1 and 2
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) is BNode:
+                    if not any(True for _ in result.triples((o, None, None))):
+                        add_to_cbd(o, result)
+            # Rule 3: reification
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        cbd_graph = Graph()
+        add_to_cbd(resource, cbd_graph)
+        return cbd_graph
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..838d775
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,134 @@
+import unittest
+
+from rdflib import Graph
+from rdflib.namespace import Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rule 1 and 2: direct triples, blank node expansion
+ex:R1 ex:p1 ex:O1 ;
+      ex:p2 ex:O2 ;
+      ex:p3 [ ex:q1 "x" ;
+              ex:q2 [ ex:r "y" ] ] .
+
+# Blank node resource
+ex:R2 ex:p ex:O3 ;
+      ex:p2 "v" .
+_:start ex:q1 "a" ;
+        ex:q2 ex:O4 ;
+        ex:q3 "b" .
+
+# Reified case A: typed reifier
+ex:R5 ex:a ex:O5 ;
+      ex:b ex:O6 ;
+      ex:c ex:O7 .
+_:s5 rdf:type rdf:Statement ;
+     rdf:subject ex:R5 ;
+     rdf:predicate ex:a ;
+     rdf:object ex:O5 ;
+     ex:note "n5" .
+
+# Reified case B: typed and untyped reifiers
+ex:R6 ex:a ex:O8 ;
+      ex:b ex:O9 ;
+      ex:c ex:O10 .
+_:s6t rdf:type rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:a ;
+      rdf:object ex:O8 ;
+      ex:note "n6t" .
+_:s6u rdf:subject ex:R6 ;
+      rdf:predicate ex:b ;
+      rdf:object ex:O9 ;
+      ex:note "n6u" ;
+      ex:extra "e6" .
+
+# Incoming reification: (ex:A ex:p ex:B) is reified
+ex:A ex:p ex:B .
+_:sin rdf:subject ex:A ;
+      rdf:predicate ex:p ;
+      rdf:object ex:B ;
+      ex:note "nin" .
+
+# Reifier whose blank node object is not reached by rules 1 or 2
+ex:R8 ex:p ex:O11 .
+_:s8 rdf:subject ex:R8 ;
+     rdf:predicate ex:p ;
+     rdf:object ex:O11 ;
+     ex:detail _:hidden .
+_:hidden ex:y "hidden" .
+
+# Blank node cycle
+ex:R9 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", EX)
+        self.graph.parse(data=FIXTURE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbdRuleOneAndTwo(self):
+        cbd = self.graph.cbd(EX.R1)
+        # 3 direct triples, 2 nested in the blank node, 1 in the nested one
+        self.assertEqual(len(cbd), 6)
+
+    def testCbdBlankNodeResource(self):
+        start = next(self.graph.subjects(EX.q3, None))
+        cbd = self.graph.cbd(start)
+        self.assertEqual(len(cbd), 3)
+
+    def testCbdTwoPropertyTriples(self):
+        cbd = self.graph.cbd(EX.R2)
+        self.assertEqual(len(cbd), 2)
+
+    def testCbdNoTriples(self):
+        cbd = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(cbd, Graph)
+        self.assertEqual(len(cbd), 0)
+
+    def testCbdReifiedTypedAndUntyped(self):
+        # R5: 3 direct triples + typed reifier with 5 triples
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        # R6: 3 direct triples + typed reifier (5) + untyped reifier (5)
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdIncomingReificationExcluded(self):
+        # The reifier of (A p B) is included for A but not for B
+        cbd_b = self.graph.cbd(EX.B)
+        self.assertEqual(len(cbd_b), 0)
+        cbd_a = self.graph.cbd(EX.A)
+        # (A p B) plus the 4 triples of the reifier
+        self.assertEqual(len(cbd_a), 5)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        cbd = self.graph.cbd(EX.R8)
+        # (R8 p O11) plus the 4 reifier triples; _:hidden is not expanded
+        self.assertEqual(len(cbd), 5)
+        self.assertEqual(len(list(cbd.triples((None, EX.y, None)))), 0)
+
+    def testCbdBlankNodeCycleTerminates(self):
+        cbd = self.graph.cbd(EX.R9)
+        # R9 p _:c1, _:c1 q _:c2, _:c2 r _:c1; each triple once
+        self.assertEqual(len(cbd), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        cbd = self.graph.cbd(EX.R5)
+        self.assertIsNot(cbd, self.graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
