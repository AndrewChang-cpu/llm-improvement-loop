diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..68f1b46 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,54 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        The Concise Bounded Description (CBD) is computed by the three rules
+        of the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource.
+        2. If an object of an included triple is a blank node, include the
+           blank node's description by applying the same rules to it, unless
+           the result already contains a triple whose subject is that blank
+           node (this terminates blank node cycles).
+        3. Reification: for every statement whose rdf:subject is the resource
+           (a "reifier"), include every triple whose subject is that
+           reifier. This applies without checking for an rdf:Statement type
+           and without matching rdf:predicate or rdf:object values. Rule 3
+           is applied to every processed node, including blank nodes reached
+           through rule 2. Blank nodes that are objects of the reifier
+           triples are not expanded, and the rdf:object and rdf:predicate
+           values of a reifier are not followed.
+
+        The result is a subgraph of this Graph; this Graph is not modified.
+        Namespace bindings are not copied to the result.
+
+        :param resource: The resource (URIRef or BNode) whose description is
+            retrieved. It is used as given in triple-pattern queries.
+        :return: A new Graph containing the Concise Bounded Description of
+            resource. It is empty if no matching triples exist.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples with node as subject.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 2: reification of node, every statement whose rdf:subject
+            # is node.
+            for reifier in list(self.subjects(RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..3391355
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,116 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: direct triples, a nested blank node chain.
+ex:R1 ex:p ex:A ; ex:q ex:B ; ex:r _:b1 .
+_:b1 ex:s "x" ; ex:t _:b2 .
+_:b2 ex:u "y" .
+
+# Two property triples.
+ex:R2 ex:name "two" ; ex:age 2 .
+
+# A type triple and two relation triples.
+ex:R4 rdf:type ex:Thing ; ex:p ex:A ; ex:q ex:B .
+
+# Reified case A: one typed reifier with rdf:subject R5.
+ex:R5 ex:p ex:A ; ex:q ex:B ; ex:r ex:C .
+_:s5 rdf:type rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:p ;
+     rdf:object ex:A ; ex:note "n5" .
+
+# Reified case B: one typed and one untyped reifier with rdf:subject R6.
+ex:R6 ex:p ex:A ; ex:q ex:B ; ex:r ex:C .
+_:s6a rdf:type rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:p ;
+      rdf:object ex:A ; ex:note "n6a" ; ex:by ex:Bob .
+_:s6b rdf:subject ex:R6 ; rdf:predicate ex:q ; rdf:object ex:B ;
+      ex:note "n6b" ; ex:by ex:Carol .
+
+# Incoming reification: the statement A p B is reified.
+ex:A7 ex:p ex:B7 .
+_:s7 rdf:subject ex:A7 ; rdf:predicate ex:p ; rdf:object ex:B7 ;
+     ex:note "n7" .
+
+# A reifier whose object is a blank node that must not be expanded.
+ex:R8 ex:p ex:Y8 .
+_:s8 rdf:subject ex:R8 ; ex:ref _:c8 .
+_:c8 ex:v "z" .
+
+# A blank node cycle.
+ex:R9 ex:p _:a9 .
+_:a9 ex:q _:b9 .
+_:b9 ex:r _:a9 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph()
+        self.graph.bind("ex", self.ex)
+        self.graph.parse(data=FIXTURE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # R1: 3 direct triples, plus 2 from _:b1 and 1 from _:b2.
+        result = self.graph.cbd(self.ex.R1)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 6)
+
+        # Blank node resource: 2 from _:b1 and 1 from _:b2.
+        bnode = self.graph.value(self.ex.R1, self.ex.r)
+        self.assertEqual(len(self.graph.cbd(bnode)), 3)
+
+        # Type triple and two relation triples.
+        self.assertEqual(len(self.graph.cbd(self.ex.R4)), 3)
+
+        # Two property triples.
+        self.assertEqual(len(self.graph.cbd(self.ex.R2)), 2)
+
+        # No triples for this resource.
+        result = self.graph.cbd(self.ex.nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        # Case A: 3 direct triples plus the 5 triples of one typed reifier.
+        self.assertEqual(len(self.graph.cbd(self.ex.R5)), 8)
+
+        # Case B: 3 direct triples plus 5 typed and 5 untyped reifier triples.
+        self.assertEqual(len(self.graph.cbd(self.ex.R6)), 13)
+
+    def testCbdIncomingReification(self):
+        # The reifier of A p B is not part of the description of B.
+        self.assertEqual(len(self.graph.cbd(self.ex.B7)), 0)
+
+        # The reifier of A p B is part of the description of A.
+        self.assertEqual(len(self.graph.cbd(self.ex.A7)), 5)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        # R8 p Y8, plus the reifier's rdf:subject and ex:ref triples.
+        # The blank node _:c8 is not expanded, so ex:v is absent.
+        result = self.graph.cbd(self.ex.R8)
+        self.assertEqual(len(result), 3)
+        self.assertNotIn((None, self.ex.v, None), result)
+
+    def testCbdBlankNodeCycle(self):
+        # Each triple of the cycle is included exactly once.
+        result = self.graph.cbd(self.ex.R9)
+        self.assertEqual(len(result), 3)
+
+    def testSourceGraphUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(self.graph), before)
+        self.assertIsNot(result, self.graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
