diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..52620b5 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,47 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource.
+
+        Implements the three rules of the W3C Member Submission
+        "Concise Bounded Description" (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included.
+        2. For each blank node object of an included triple that is not
+           already described in the result, the same rules are applied to
+           that blank node, recursively.
+        3. Reification: for every node described, every statement whose
+           rdf:subject is that node is a reifier, and all triples whose
+           subject is the reifier are included. No rdf:Statement type check
+           and no rdf:predicate or rdf:object matching is done, so untyped
+           reifiers are included as well. Blank node objects of triples
+           added by this rule are not described further, unless rules 1 and
+           2 reach them.
+
+        The result is a subgraph of this graph, which is not modified.
+        The result is a new Graph; it does not copy namespace bindings.
+
+        :param resource: the resource (node) to describe. It is used as given
+            in triple-pattern queries.
+        :return: a new Graph containing the description. It is empty if the
+            graph has no matching triples.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) is BNode and not any(
+                        result.triples((o, None, None))):
+                    add_to_cbd(o)
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..0de54ed
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,126 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+RDF = Namespace("http://www.w3.org/1999/02/22-rdf-syntax-ns#")
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:R1 rdf:type ex:Thing ; ex:rel ex:A ; ex:rel2 ex:B .
+
+ex:R2 ex:name "x" ; ex:age 3 .
+
+ex:R3 ex:link [ ex:q ex:X ; ex:r [ ex:s ex:Y ] ] ;
+      ex:link2 ex:C ;
+      ex:link3 ex:D .
+
+ex:R5 ex:p ex:a ; ex:q ex:b ; ex:r ex:c .
+ex:S5 rdf:type rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:p ;
+      rdf:object ex:a ;
+      ex:note "n" .
+
+ex:R6 ex:p ex:a ; ex:q ex:b ; ex:r ex:c .
+ex:S6 rdf:type rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:p ;
+      rdf:object ex:a ;
+      ex:note "n" .
+ex:S6u rdf:subject ex:R6 ;
+       ex:note "u" ;
+       ex:by ex:Who ;
+       ex:when "t" ;
+       ex:sec "s" .
+
+ex:A ex:p ex:B .
+ex:S7 rdf:subject ex:A ;
+      rdf:object ex:B ;
+      ex:note "m" .
+
+ex:R8 ex:v ex:W .
+ex:S8 rdf:subject ex:R8 ;
+      ex:ctx [ ex:z ex:Q ] ;
+      ex:note "k" .
+
+ex:R9 ex:link _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 ;
+     ex:name "z" .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=TURTLE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Rule 1 and 2: a resource with a type and two relation triples.
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(result), 3)
+
+    def testCbdTwoProperties(self):
+        result = self.graph.cbd(EX.R2)
+        self.assertEqual(len(result), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdBlankNodeRecursion(self):
+        # Three direct triples, plus a blank node with a nested blank node.
+        result = self.graph.cbd(EX.R3)
+        self.assertEqual(len(result), 6)
+
+    def testCbdReified(self):
+        # Three direct triples plus a typed reifier with five triples.
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+        self.assertIn((EX.S5, EX.note, None), result)
+
+    def testCbdReifiedUntyped(self):
+        # Three direct triples, a typed reifier and an untyped reifier.
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6u, EX.by, EX.Who), result)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+
+    def testCbdIncomingReificationIncluded(self):
+        # The reifier of (A p B) is included for A, which is its subject.
+        result = self.graph.cbd(EX.A)
+        self.assertIn((EX.A, EX.p, EX.B), result)
+        self.assertIn((EX.S7, EX.note, None), result)
+        self.assertEqual(len(result), 4)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        bnode = self.graph.value(EX.S8, EX.ctx)
+        self.assertEqual(len(result), 4)
+        self.assertIn((EX.S8, EX.ctx, bnode), result)
+        self.assertNotIn((bnode, EX.z, EX.Q), result)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 4)
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(self.graph), before)
+        self.assertIsNot(result, self.graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
