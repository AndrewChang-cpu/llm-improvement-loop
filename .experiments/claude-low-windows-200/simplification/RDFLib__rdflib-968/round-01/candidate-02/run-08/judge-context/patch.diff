diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..9dfaf72 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,49 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the starting node.
+        2. If an object of an included triple is a blank node, recursively
+           apply rules 1 and 2 to that blank node (unless the result
+           already contains a triple whose subject is that blank node).
+        3. Reification: include every triple whose subject is a reifier
+           of the node, i.e. every S with an rdf:subject triple whose
+           object is the node. No rdf:Statement type check is made and
+           no rdf:predicate or rdf:object matching is performed. The
+           rdf:object and rdf:predicate values of a reifier are not
+           followed.
+
+        The result is a subgraph of the source graph; the source graph is
+        not modified. Namespace bindings are not copied. If the resource
+        has no subject triples and no reifiers, an empty Graph is returned.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rules 1 and 2: triples whose subject is the node.
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode and not any(
+                        result.triples((obj, None, None))):
+                    add_to_cbd(obj)
+            # Rule 3: reification. Every reifier S of the node contributes
+            # all triples whose subject is S.
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..812361b
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,137 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rule 1: two property triples
+ex:R1 ex:name "one" ;
+      ex:name "uno" .
+
+# Rule 1: a type triple and two relation triples
+ex:R2 a ex:Type ;
+      ex:rel1 ex:R1 ;
+      ex:rel2 ex:R1 .
+
+# Rule 2: two URI objects and one blank node object with a nested blank node
+ex:R3 ex:p ex:A ;
+      ex:q ex:B ;
+      ex:r _:b1 .
+_:b1 ex:s _:b2 .
+_:b2 ex:t "deep" .
+
+# Reified case A: one typed reifier with rdf:subject R5
+ex:R5 ex:p ex:A ;
+      ex:q ex:B ;
+      ex:r ex:C .
+_:s5 a rdf:Statement ;
+     rdf:subject ex:R5 ;
+     rdf:predicate ex:p ;
+     rdf:object ex:A ;
+     ex:note "a" .
+
+# Reified case B: one typed reifier and one untyped reifier with rdf:subject R6
+ex:R6 ex:p ex:A ;
+      ex:q ex:B ;
+      ex:r ex:C .
+_:s6 a rdf:Statement ;
+     rdf:subject ex:R6 ;
+     rdf:predicate ex:p ;
+     rdf:object ex:A ;
+     ex:note "t" .
+_:u6 rdf:subject ex:R6 ;
+     rdf:predicate ex:q ;
+     rdf:object ex:B ;
+     ex:note "u1" ;
+     ex:note "u2" .
+
+# Incoming reification: a reifier of (A p B) is not part of B's description
+ex:A ex:p ex:B .
+_:s7 rdf:subject ex:A ;
+     rdf:predicate ex:p ;
+     rdf:object ex:B ;
+     ex:note "x" .
+
+# Blank node object of a reifier is not expanded
+ex:R8 ex:p ex:A .
+_:s8 rdf:subject ex:R8 ;
+     ex:detail _:d8 .
+_:d8 ex:x "hidden" .
+
+# Blank node cycle
+ex:Cyc ex:has _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbdRuleOneProperties(self):
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(result), 2)
+
+    def testCbdRuleOneTypeAndRelations(self):
+        result = self.graph.cbd(EX.R2)
+        self.assertEqual(len(result), 3)
+
+    def testCbdRuleTwoBlankNodeChain(self):
+        result = self.graph.cbd(EX.R3)
+        # three direct triples, plus the two blank node triples
+        self.assertEqual(len(result), 5)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReifiedTyped(self):
+        result = self.graph.cbd(EX.R5)
+        # three direct triples plus the five triples of the typed reifier
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedTypedAndUntyped(self):
+        result = self.graph.cbd(EX.R6)
+        # three direct triples, the typed reifier (5), the untyped reifier (5)
+        self.assertEqual(len(result), 13)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+
+    def testCbdIncomingReificationOnSubject(self):
+        result = self.graph.cbd(EX.A)
+        # (A p B) plus the four triples of the reifier with rdf:subject A
+        self.assertEqual(len(result), 5)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        # (R8 p A) plus the two triples of the reifier; _:d8 is not expanded
+        self.assertEqual(len(result), 3)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.Cyc)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        size_before = len(self.graph)
+        result = self.graph.cbd(EX.R6)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), size_before)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
