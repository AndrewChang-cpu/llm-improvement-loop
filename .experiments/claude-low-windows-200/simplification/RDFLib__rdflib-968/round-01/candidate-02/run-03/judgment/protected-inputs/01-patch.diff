diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..46dd527 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,49 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the resource.
+        2. Recursively include the CBD of every blank node that is the
+           object of a triple already included by rule 1, unless the
+           result already contains a triple whose subject is that blank
+           node (this also terminates blank node cycles).
+        3. Reification: for every reifier S, that is, every node with an
+           rdf:subject triple whose object is the resource, include every
+           triple whose subject is S. No rdf:Statement type check and no
+           matching of rdf:predicate or rdf:object is performed, so every
+           such reifier is included. Blank nodes reached only through
+           rule 3 are not expanded.
+
+        The result is a subgraph of this Graph; this Graph is not modified.
+
+        :param resource: the resource (a term such as a URIRef or BNode)
+            whose Concise Bounded Description is returned. It is used as
+            given in triple-pattern queries.
+        :return: a new Graph containing the Concise Bounded Description of
+            resource. It is empty if this Graph has no matching triples.
+        """
+        def add_to_cbd(node, cbd):
+            # Rules 1 and 2: triples whose subject is the node.
+            for s, p, o in self.triples((node, None, None)):
+                cbd.add((s, p, o))
+                if isinstance(o, BNode) and \
+                        not any(cbd.triples((o, None, None))):
+                    add_to_cbd(o, cbd)
+
+            # Rule 3: triples of every reifier of the node.
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    cbd.add((s, p, o))
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..c08a7b6
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,149 @@
+import unittest
+
+from rdflib import Graph
+from rdflib.namespace import Namespace
+
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Blank node resource: 3 + 3 + 1 = 7 triples reachable by rule 1.
+ex:Holder ex:link _:b .
+_:b ex:p "1" ;
+    ex:q _:c ;
+    ex:r ex:U .
+_:c ex:s "2" ;
+    ex:t _:d ;
+    ex:w "4" .
+_:d ex:u "3" .
+
+# Rule 1 and 2 with a nested blank node: 3 direct + 1 + 1 = 5 triples.
+ex:T ex:a ex:U1 ;
+     ex:b ex:U2 ;
+     ex:c _:n1 .
+_:n1 ex:d _:n2 .
+_:n2 ex:e "v" .
+
+# Resource with a type triple and two relation triples (3 triples).
+ex:R1 a ex:Thing ;
+      ex:knows ex:R2 ;
+      ex:likes ex:R3 .
+ex:R2 ex:name "two" .
+
+# Resource with two property triples (2 triples).
+ex:R4 ex:name "four" ;
+      ex:age "4" .
+
+# Reified case A: 3 direct triples + typed reifier with 5 triples = 8.
+ex:R5 ex:a1 ex:U5 ;
+      ex:a2 ex:U5b ;
+      ex:a3 "x" .
+_:s5 a rdf:Statement ;
+     rdf:subject ex:R5 ;
+     rdf:predicate ex:a1 ;
+     rdf:object ex:U5 ;
+     ex:note "a" .
+
+# Reified case B: 3 direct + typed reifier (5) + untyped reifier (5) = 13.
+ex:R6 ex:a1 ex:U6 ;
+      ex:a2 ex:U6b ;
+      ex:a3 "y" .
+_:t6 a rdf:Statement ;
+     rdf:subject ex:R6 ;
+     rdf:predicate ex:a1 ;
+     rdf:object ex:Y6 ;
+     ex:note "b" .
+_:u6 rdf:subject ex:R6 ;
+     ex:a "1" ;
+     ex:b "2" ;
+     ex:c "3" ;
+     ex:d "4" .
+
+# Incoming reification: A p B is reified by _:s9, whose rdf:object is B.
+ex:A ex:p ex:B .
+_:s9 rdf:subject ex:A ;
+     rdf:predicate ex:p ;
+     rdf:object ex:B ;
+     ex:note "n" .
+
+# Reifier whose triples point to a blank node not reached by rules 1 or 2.
+ex:R7 ex:p ex:Z .
+_:s7 rdf:subject ex:R7 ;
+     ex:info _:bn7 .
+_:bn7 ex:v "1" .
+
+# Blank node cycle: _:k1 -> _:k2 -> _:k1.
+ex:C ex:p _:k1 .
+_:k1 ex:q _:k2 .
+_:k2 ex:r _:k1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.ex = Namespace("http://example.org/")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        cbd = self.graph.cbd(self.ex.R1)
+        self.assertIsInstance(cbd, Graph)
+        self.assertEqual(len(cbd), 3)
+
+    def testCbdTwoProperties(self):
+        cbd = self.graph.cbd(self.ex.R4)
+        self.assertEqual(len(cbd), 2)
+
+    def testCbdNoTriples(self):
+        cbd = self.graph.cbd(self.ex.Nothing)
+        self.assertIsInstance(cbd, Graph)
+        self.assertEqual(len(cbd), 0)
+
+    def testCbdUriAndNestedBlankNodes(self):
+        cbd = self.graph.cbd(self.ex.T)
+        self.assertEqual(len(cbd), 5)
+
+    def testCbdBlankNodeResource(self):
+        bnode = self.graph.value(self.ex.Holder, self.ex.link)
+        cbd = self.graph.cbd(bnode)
+        self.assertEqual(len(cbd), 7)
+
+    def testCbdReified(self):
+        cbd = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(cbd), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        cbd = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(cbd), 13)
+        self.assertIn((self.ex.R6, self.ex.a1, self.ex.U6), cbd)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(self.ex.B)), 0)
+        cbd = self.graph.cbd(self.ex.A)
+        self.assertEqual(len(cbd), 5)
+        self.assertIn((self.ex.A, self.ex.p, self.ex.B), cbd)
+
+    def testCbdReificationDoesNotExpandBlankNode(self):
+        cbd = self.graph.cbd(self.ex.R7)
+        self.assertEqual(len(cbd), 3)
+        bn7 = self.graph.value(predicate=self.ex.info)
+        self.assertNotIn(bn7, [s for s, _, _ in cbd])
+
+    def testCbdBlankNodeCycle(self):
+        cbd = self.graph.cbd(self.ex.C)
+        self.assertEqual(len(cbd), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        cbd = self.graph.cbd(self.ex.R1)
+        self.assertIsNot(cbd, self.graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
