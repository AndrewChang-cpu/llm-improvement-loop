diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..f0d7d83 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,52 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        Given a particular node (the starting node) in a particular RDF graph
+        (the source graph), a subgraph of that particular graph, taken to
+        comprise a concise bounded description of the resource denoted by the
+        starting node, can be identified as follows:
+
+        1. Include in the subgraph all statements in the source graph where
+           the subject of the statement is the starting node.
+        2. Recursively, for all statements identified in the subgraph thus
+           far having a blank node as object, include in the subgraph all
+           statements in the source graph where the subject of the statement
+           is the blank node in question and which are not already included
+           in the subgraph.
+        3. Include in the subgraph all statements in the source graph where
+           the subject of the statement is a reifier of the starting node,
+           i.e. a node S with an rdf:subject triple whose object is the
+           starting node. Every such reifier is included, whether or not it
+           has an rdf:Statement type and whether or not its rdf:predicate or
+           rdf:object values match any statement in the source graph.
+
+        The result is a subgraph of the source graph, which is not modified.
+        The result is a new Graph; namespace bindings are not copied.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description of
+            resource (empty if resource has no statements or reifiers)
+        """
+        def add_to_cbd(node, cbd):
+            for s, p, o in self.triples((node, None, None)):
+                cbd.add((s, p, o))
+                if type(o) is BNode and not any(
+                        cbd.triples((o, None, None))):
+                    add_to_cbd(o, cbd)
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    cbd.add((s, p, o))
+            return cbd
+
+        return add_to_cbd(resource, Graph())
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..5ab0fe2
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,98 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:R1 a ex:Class ; ex:rel1 ex:X ; ex:rel2 ex:Y .
+ex:R2 ex:name "a" ; ex:label "b" .
+
+ex:Root ex:has [ ex:x 1 ; ex:y [ ex:z 2 ; ex:w 3 ] ] ; ex:other ex:Z .
+
+ex:Cyc ex:cycle _:c1 .
+_:c1 ex:next _:c2 ; ex:label "x" .
+_:c2 ex:next _:c1 .
+
+ex:R5 ex:p1 ex:V1 ; ex:p2 ex:V2 ; ex:p3 ex:V3 .
+ex:S5 a rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:p1 ;
+      rdf:object ex:V1 ; ex:note "n5" .
+
+ex:R6 ex:p1 ex:V1 ; ex:p2 ex:V2 ; ex:p3 ex:V3 .
+ex:S6a a rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:p1 ;
+       rdf:object ex:V1 ; ex:note "a" .
+ex:S6b rdf:subject ex:R6 ; rdf:predicate ex:p2 ; rdf:object ex:V2 ;
+       ex:note "b" ; ex:by "x" .
+
+ex:A ex:p ex:B .
+ex:S7 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:B ;
+      ex:note "r" .
+
+ex:R8 ex:p ex:V8 .
+ex:S8 rdf:subject ex:R8 ; rdf:object _:bn8 ; ex:note "n8" .
+_:bn8 ex:inner "i" .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.ex = Namespace("http://example.org/")
+        self.graph = Graph()
+        self.graph.parse(data=TURTLE, format="turtle")
+        self.graph.bind("ex", self.ex)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbdRule1And2Counts(self):
+        self.assertEqual(len(self.graph.cbd(self.ex.R1)), 3)
+        self.assertEqual(len(self.graph.cbd(self.ex.R2)), 2)
+        self.assertEqual(len(self.graph.cbd(self.ex.Nothing)), 0)
+
+    def testCbdBlankNode(self):
+        root = self.graph.value(self.ex.Root, self.ex.has)
+        self.assertEqual(len(self.graph.cbd(self.ex.Root)), 5)
+        self.assertEqual(len(self.graph.cbd(root)), 4)
+
+    def testCbdNoTriplesIsEmptyGraph(self):
+        result = self.graph.cbd(self.ex.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdBlankCycle(self):
+        result = self.graph.cbd(self.ex.Cyc)
+        self.assertEqual(len(result), 4)
+
+    def testCbdReifiedTyped(self):
+        result = self.graph.cbd(self.ex.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntyped(self):
+        result = self.graph.cbd(self.ex.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((self.ex.S6b, self.ex.by, None), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(self.ex.B)), 0)
+        result = self.graph.cbd(self.ex.A)
+        self.assertEqual(len(result), 5)
+        self.assertIn((self.ex.S7, self.ex.note, None), result)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(self.ex.R8)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(
+            list(result.triples((None, self.ex.inner, None))), [])
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(self.ex.R5)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
