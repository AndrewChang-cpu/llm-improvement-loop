diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..335ff4b 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,45 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource.
+
+        The description is built from three rules of the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/):
+
+        1. Include every triple whose subject is the resource. If an object
+           of such a triple is a blank node not already described in the
+           result, recursively apply these rules to that blank node.
+        2. Reification: for every reifier S with an rdf:subject triple whose
+           object is the resource, include every triple whose subject is S.
+           Any statement with rdf:subject set to the resource counts as a
+           reifier; no rdf:Statement type check and no matching of
+           rdf:predicate or rdf:object is performed.
+        3. Blank nodes that are objects of triples added by rule 2 are not
+           expanded, and the rdf:object and rdf:predicate values of a
+           reifier are not followed.
+
+        The result is a new Graph containing a subgraph of this graph; this
+        graph is not modified. Namespace bindings are not copied. If the
+        resource has no subject triples and no reifiers, the result is empty.
+
+        :param resource: the resource (URIRef or BNode) to describe.
+        :return: a new Graph containing the Concise Bounded Description.
+        """
+        def add_to_cbd(node, cbd_graph):
+            for s, p, o in self.triples((node, None, None)):
+                cbd_graph.add((s, p, o))
+                if type(o) is BNode and not any(
+                        True for _ in cbd_graph.triples((o, None, None))):
+                    add_to_cbd(o, cbd_graph)
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    cbd_graph.add((s, p, o))
+
+        result = Graph()
+        add_to_cbd(resource, result)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..bdc3eea
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,114 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Plain resource: three direct triples.
+ex:R1 a ex:Thing ; ex:p ex:O1 ; ex:q ex:O2 .
+
+# Two property triples.
+ex:R2 ex:name "a" ; ex:age "1" .
+
+# Nested blank nodes: 3 direct + 2 + 1 = 6 triples.
+ex:R4 ex:part [ ex:a ex:X ; ex:b [ ex:c ex:Y ] ] ;
+      ex:link ex:Z ; ex:other ex:W .
+
+# Reified case A: 3 direct + typed reifier (5 triples) = 8.
+ex:R5 ex:p ex:A ; ex:q ex:B ; ex:r ex:C .
+ex:S5 a rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:p ;
+      rdf:object ex:A ; ex:note "x" .
+
+# Reified case B: 3 direct + typed reifier (5) + untyped reifier (5) = 13.
+ex:R6 ex:p ex:A ; ex:q ex:B ; ex:r ex:C .
+ex:S6a a rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:p ;
+       rdf:object ex:A ; ex:note "1" .
+ex:S6b rdf:subject ex:R6 ; rdf:predicate ex:p ; rdf:object ex:A ;
+       ex:note "u" ; ex:by ex:Who .
+
+# Incoming reification: statement (ex:A ex:p ex:B) reified by ex:S7.
+ex:A ex:p ex:B .
+ex:B ex:label "b" .
+ex:S7 rdf:subject ex:A ; rdf:predicate ex:p ; rdf:object ex:B ;
+      ex:note "n" .
+
+# Reifier whose object is a blank node that must not be expanded.
+ex:R8 ex:p ex:A .
+ex:S8 rdf:subject ex:R8 ; rdf:object [ ex:deep ex:V ] ; ex:note "m" .
+
+# Blank-node cycle: _:c1 -> _:c2 -> _:c1.
+ex:R9 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", EX)
+        self.graph.parse(data=FIXTURE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Rule 1 counts.
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.Nothing)), 0)
+        self.assertIsInstance(self.graph.cbd(EX.Nothing), Graph)
+
+    def testCbdBlankNodes(self):
+        # Rule 1 expands nested blank nodes: 3 + 2 + 1 = 6.
+        result = self.graph.cbd(EX.R4)
+        self.assertEqual(len(result), 6)
+        self.assertIn((EX.R4, EX.link, EX.Z), result)
+        self.assertIn((None, EX.c, EX.Y), result)
+
+    def testCbdReified(self):
+        # Reified case A: 3 direct + typed reifier (5 triples).
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        # Reified case B: 3 direct + typed (5) + untyped (5) reifier.
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+        result = self.graph.cbd(EX.R6)
+        self.assertIn((EX.S6b, EX.by, EX.Who), result)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (A p B) is not part of B's description; B's own
+        # label triple is the only triple.
+        result_b = self.graph.cbd(EX.B)
+        self.assertEqual(len(result_b), 1)
+        self.assertIn((EX.B, EX.label, None), result_b)
+        self.assertNotIn((EX.S7, None, None), result_b)
+        # ...but it is part of A's description.
+        result_a = self.graph.cbd(EX.A)
+        self.assertIn((EX.S7, EX.note, None), result_a)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        # 1 direct triple + 3 triples of the reifier; _:n is not expanded.
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+        self.assertNotIn((None, EX.deep, EX.V), result)
+
+    def testCbdBlankNodeCycle(self):
+        # Terminates and includes each triple once: 3 triples.
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        length = len(self.graph)
+        result = self.graph.cbd(EX.R6)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), length)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
