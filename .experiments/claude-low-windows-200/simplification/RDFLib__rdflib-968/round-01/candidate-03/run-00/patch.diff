diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..0651d25 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,48 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) and applies three
+        rules:
+
+        1. Include every triple whose subject is the resource.
+        2. For every blank node object reached by rule 1 that is not already
+           the subject of a triple in the description, apply these rules to
+           that blank node as well (recursively).
+        3. Reification: for every statement S whose rdf:subject is the
+           resource (or a blank node in the description), include every
+           triple whose subject is S. No rdf:Statement type check is made
+           and the rdf:predicate and rdf:object values are not matched.
+           Blank nodes that appear only as objects of these reification
+           triples are not expanded.
+
+        The result is a subgraph of this Graph; this Graph is not modified.
+        Namespace bindings are not copied to the result.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description
+        """
+
+        retval = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: direct triples of the node
+            for s, p, o in self.triples((node, None, None)):
+                retval.add((s, p, o))
+                if isinstance(o, BNode) and not any(
+                        True for _ in retval.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3: reifiers of the node
+            for reifier, _, _ in self.triples((None, RDF.subject, node)):
+                for t in self.triples((reifier, None, None)):
+                    retval.add(t)
+
+        add_to_cbd(resource)
+        return retval
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..ca07a9f
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,138 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Three direct triples: two to URIs, one to a blank node with a nested blank node.
+ex:R1 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 _:b1 .
+_:b1 ex:name "x" ;
+     ex:child _:b2 .
+_:b2 ex:val "y" ;
+     ex:tag "z" ;
+     ex:val2 "w" .
+
+# A type triple and two relation triples.
+ex:R2 a ex:Thing ;
+      ex:rel ex:X ;
+      ex:rel ex:Y .
+
+# Two property triples.
+ex:R3 ex:name "a" ;
+      ex:label "b" .
+
+# Reified case A: R5 with a typed reifier (5 triples with subject _:s1).
+ex:R5 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 "c" .
+_:s1 a rdf:Statement ;
+     rdf:subject ex:R5 ;
+     rdf:predicate ex:p1 ;
+     rdf:object ex:A ;
+     ex:note "n" .
+
+# Reified case B: R6 with a typed reifier and an untyped reifier.
+ex:R6 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 "c" .
+_:s2 a rdf:Statement ;
+     rdf:subject ex:R6 ;
+     rdf:predicate ex:p1 ;
+     rdf:object ex:A ;
+     ex:note "t" .
+_:s3 rdf:subject ex:R6 ;
+     rdf:predicate ex:p2 ;
+     rdf:object ex:B ;
+     ex:note "u" ;
+     ex:by "k" .
+
+# Incoming reification: statement (ex:A ex:p ex:B) with a reifier of ex:A.
+ex:A ex:p ex:B .
+_:s4 a rdf:Statement ;
+     rdf:subject ex:A ;
+     rdf:predicate ex:p ;
+     rdf:object ex:B ;
+     ex:note "i" .
+
+# Reifier whose rdf:object is a blank node that must not be expanded.
+ex:R8 ex:p ex:X .
+_:s5 rdf:subject ex:R8 ;
+     rdf:object _:c .
+_:s5 ex:note "n" .
+_:c ex:name "hidden" .
+
+# Blank-node cycle: _:a -> _:b -> _:a.
+ex:R9 ex:p _:a .
+_:a ex:q _:b ;
+    ex:name "a" .
+_:b ex:r _:a .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(result), 8)
+
+    def testCbdTypeAndRelations(self):
+        result = self.graph.cbd(EX.R2)
+        self.assertEqual(len(result), 3)
+
+    def testCbdTwoProperties(self):
+        result = self.graph.cbd(EX.R3)
+        self.assertEqual(len(result), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 6)
+
+    def testCbdReificationBnodeNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(
+            len(list(result.triples((None, EX.name, None)))), 0)
+
+    def testCbdBnodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 4)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+        self.assertTrue(all(t in self.graph for t in result))
+
+
+if __name__ == '__main__':
+    unittest.main()
