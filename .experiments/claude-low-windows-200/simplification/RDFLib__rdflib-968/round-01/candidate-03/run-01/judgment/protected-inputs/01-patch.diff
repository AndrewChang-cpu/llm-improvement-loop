diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..07fd749 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,58 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        Given a particular node (the starting node) in a particular RDF graph
+        (the source graph), a subgraph of that particular graph, taken to
+        comprise a concise bounded description of the resource denoted by the
+        starting node, can be identified as follows:
+
+        1. Include in the subgraph all statements in the source graph where
+           the subject of the statement is the starting node.
+        2. Recursively, for all statements identified in the subgraph thus far
+           having a blank node object, include in the subgraph all statements
+           in the source graph where the subject of the statement is the blank
+           node in question and which are not already included in the subgraph.
+        3. Include in the subgraph all statements in the source graph where
+           the subject of the statement is a reifier (a node S having an
+           rdf:subject triple whose object is the node being described). This
+           is applied to every processed node, including blank nodes reached
+           by rule 2. Every statement whose rdf:subject is the node is included
+           as it stands; there is no rdf:Statement type check and no matching
+           of rdf:predicate or rdf:object values.
+
+        The result is a new Graph containing only triples from the source
+        graph, which is not modified. Namespace bindings are not copied.
+        If the starting node has no matching triples, an empty Graph is
+        returned.
+
+        :param resource: the starting node of the description
+        :return: a new Graph holding the Concise Bounded Description
+        """
+
+        def add_to_cbd(node, cbd_graph):
+            # Rules 1 and 2: statements with the node as subject; expand
+            # blank node objects that have no statements in the result yet.
+            for s, p, o in self.triples((node, None, None)):
+                cbd_graph.add((s, p, o))
+                if type(o) is BNode and \
+                        not any(cbd_graph.triples((o, None, None))):
+                    add_to_cbd(o, cbd_graph)
+            # Rule 3: statements of every reifier of the node.
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    cbd_graph.add((s, p, o))
+
+        cbd_graph = Graph()
+        add_to_cbd(resource, cbd_graph)
+        return cbd_graph
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..f8a868b
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,130 @@
+import unittest
+
+from rdflib import Graph
+from rdflib.namespace import Namespace
+
+EX = Namespace("http://example.org/")
+
+DATA = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2: blank node with a nested blank node (8 triples)
+ex:R1 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 _:b1 .
+_:b1 ex:q1 "x" ;
+     ex:q2 _:b2 ;
+     ex:q3 "z" .
+_:b2 ex:r1 "y" ;
+     ex:r2 "w" .
+
+# Three triples: type and two relations (3 triples)
+ex:R2 a ex:T ;
+      ex:rel1 ex:X ;
+      ex:rel2 ex:Y .
+
+# Two property triples (2 triples)
+ex:R3 ex:name "n" ;
+      ex:size "s" .
+
+# Reified case A: typed reifier (3 + 5 = 8 triples)
+ex:R5 ex:a1 ex:A ;
+      ex:a2 ex:B ;
+      ex:a3 ex:C .
+ex:S5 a rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:a1 ;
+      rdf:object ex:A ;
+      ex:note "case A" .
+
+# Reified case B: typed and untyped reifiers (3 + 5 + 5 = 13 triples)
+ex:R6 ex:b1 ex:A ;
+      ex:b2 ex:B ;
+      ex:b3 ex:C .
+ex:S6 a rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:b1 ;
+      rdf:object ex:A ;
+      ex:note "typed" .
+ex:S6u rdf:subject ex:R6 ;
+       rdf:predicate ex:b2 ;
+       rdf:object ex:B ;
+       ex:note "untyped" ;
+       ex:other "extra" .
+
+# Incoming reification: A p B, reified by S2 (rdf:subject A, rdf:object B)
+ex:A ex:p ex:B .
+ex:S2 rdf:subject ex:A ;
+      rdf:predicate ex:p ;
+      rdf:object ex:B ;
+      ex:note "incoming" .
+
+# Blank node reached only through a reifier's rdf:object is not expanded
+ex:R7 ex:p _:b3 .
+_:b3 ex:label "reified" .
+ex:S7 rdf:subject _:b3 ;
+      ex:note "blank reifier" ;
+      rdf:object _:b4 .
+_:b4 ex:deep "d" .
+
+# Blank node cycle: _:c1 -> _:c2 -> _:c1
+ex:R8 ex:p _:c1 .
+_:c1 ex:q _:c2 ;
+     ex:name "a" .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=DATA, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.R4)), 0)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdReifiedUntypedIncluded(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(list(result.triples((EX.S6u, None, None)))), 5)
+
+    def testCbdIncomingReificationExcluded(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 5)
+        self.assertIn((EX.S2, EX.note, None), [(s, EX.note, None)
+                                               for s, _, _ in result])
+
+    def testCbdBlankNodeNotExpandedThroughReification(self):
+        # R7 p _:b3 (1), _:b3 label (1), reifier S7 triples (3)
+        result = self.graph.cbd(EX.R7)
+        self.assertEqual(len(result), 5)
+        self.assertEqual(len(list(result.triples((None, EX.deep, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 4)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        before_len = len(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before_len)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
