diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..e994149 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,48 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/. The following
+        rules are applied:
+
+        1. For a starting node, include every triple whose subject is that
+           node. If a triple's object is a blank node not yet described in
+           the result, apply the same rules to that blank node recursively.
+        2. Reification: for each node, include every statement whose
+           rdf:subject is that node. No rdf:Statement type check and no
+           matching of rdf:predicate or rdf:object is performed.
+        3. Reification of blank nodes is handled as in rule 2 for every
+           described node, including blank nodes reached by rule 1. The
+           objects of reifier triples are not followed.
+
+        The result is a new Graph that is a subgraph of this Graph; this
+        Graph is not modified. Namespace bindings are not copied.
+
+        :param resource: The starting node of the description.
+        :return: A new Graph containing the Concise Bounded Description.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples whose subject is the node
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode and \
+                        next(result.triples((obj, None, None)), None) is None:
+                    add_to_cbd(obj)
+            # Rule 2: reification, every statement with rdf:subject node
+            for reifier in list(self.subjects(RDF.subject, node)):
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..9d0f05d
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,102 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rules 1 and 2 with nested blank nodes (expected 8)
+ex:R1 ex:p1 ex:A1 ; ex:p2 ex:A2 ; ex:p3 _:b1 .
+_:b1 ex:x "1" ; ex:y "2" ; ex:w _:b2 .
+_:b2 ex:z "3" ; ex:v "4" .
+
+# Type and two relations (expected 3)
+ex:R2 rdf:type ex:Thing ; ex:rel1 ex:U ; ex:rel2 ex:V .
+
+# Two property triples (expected 2)
+ex:R3 ex:prop1 "a" ; ex:prop2 "b" .
+
+# Reified case A: one typed reifier (expected 8)
+ex:R5 ex:p1 ex:a1 ; ex:p2 ex:a2 ; ex:p3 ex:a3 .
+ex:S5 rdf:type rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:p1 ;
+    rdf:object ex:a1 ; ex:note "typed" .
+
+# Reified case B: typed and untyped reifiers (expected 13)
+ex:R6 ex:p1 ex:b1 ; ex:p2 ex:b2 ; ex:p3 ex:b3 .
+ex:S6 rdf:type rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:p1 ;
+    rdf:object ex:b1 ; ex:note "typed" .
+ex:S6u rdf:subject ex:R6 ; rdf:predicate ex:p2 ; rdf:object ex:b2 ;
+    ex:note "untyped" ; ex:src "x" .
+
+# Incoming reification: statement (A7 p B7) is reified by S7 (expected 5 for A7, 0 for B7)
+ex:A7 ex:p ex:B7 .
+ex:S7 rdf:subject ex:A7 ; rdf:predicate ex:p ; rdf:object ex:B7 ;
+    ex:note "incoming" .
+
+# Reifier with a blank-node object (expected 3 for R8; _:o8 not expanded)
+ex:R8 ex:p ex:X8 .
+ex:S8 rdf:subject ex:R8 ; rdf:object _:o8 .
+_:o8 ex:secret "hidden" .
+
+# Blank-node cycle (expected 3)
+ex:R9 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.Nothing)), 0)
+
+    def testCbdEmptyIsGraph(self):
+        result = self.graph.cbd(EX.Nothing)
+        self.assertIsInstance(result, Graph)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6u, EX.note, None), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B7)), 0)
+        result = self.graph.cbd(EX.A7)
+        self.assertEqual(len(result), 5)
+        self.assertIn((EX.S7, EX.note, None), result)
+
+    def testCbdReifierBlankNodeObjectNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, EX.secret, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(set(self.graph), before)
+        self.assertIsNot(result, self.graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
