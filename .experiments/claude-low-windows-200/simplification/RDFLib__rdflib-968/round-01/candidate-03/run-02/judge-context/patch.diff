diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..65b19ce 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,53 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a resource from this
+        graph, following the three CBD rules of the W3C Member Submission
+        (https://www.w3.org/Submission/CBD/):
+
+        1. All triples whose subject is the resource are included. Blank
+           node objects of those triples are described recursively, unless
+           the result already contains a triple with that blank node as
+           subject.
+        2. Reification is included: for every statement S with an
+           ``rdf:subject`` triple whose object is the resource, all triples
+           whose subject is S are included. No ``rdf:Statement`` type check
+           and no matching of ``rdf:predicate`` or ``rdf:object`` values is
+           performed, so an untyped reifier is included as well.
+        3. Reification is applied to every described node, including blank
+           nodes reached through rule 1. Blank nodes that appear only as
+           objects of reification triples are not described.
+
+        The result is a new Graph that is a subgraph of this graph; this
+        graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the resource to describe (a term such as a URIRef
+            or BNode).
+        :return: a new Graph containing the Concise Bounded Description of
+            resource. It is empty if the resource has no matching triples.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: outgoing triples, recursing into undescribed blank nodes
+            for triple in self.triples((node, None, None)):
+                result.add(triple)
+                obj = triple[2]
+                if type(obj) is BNode and not any(
+                        True for _ in result.triples((obj, None, None))):
+                    add_to_cbd(obj)
+            # Rule 2 and 3: reifiers of this node contribute all their triples
+            reifiers = [s for s, _, _ in
+                        self.triples((None, RDF.subject, node))]
+            for reifier in reifiers:
+                for triple in self.triples((reifier, None, None)):
+                    result.add(triple)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..8725bcb
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,145 @@
+import unittest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.namespace import RDF
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Rule 1: blank node with a nested blank node (8 triples)
+ex:R1 ex:p ex:A ;
+      ex:q ex:B ;
+      ex:r [ ex:s ex:C ;
+             ex:v "x" ;
+             ex:t [ ex:u ex:D ;
+                    ex:w "y" ] ] .
+
+# Type and relation triples (3 triples)
+ex:R2 a ex:Thing ;
+      ex:rel ex:X ;
+      ex:rel2 ex:Y .
+
+# Two property triples (2 triples)
+ex:R3 ex:name "n" ;
+      ex:age 3 .
+
+# Reified case A: direct triples plus one typed reifier (8 triples)
+ex:R5 ex:p1 ex:o1 ;
+      ex:p2 ex:o2 ;
+      ex:p3 ex:o3 .
+ex:stA a rdf:Statement ;
+       rdf:subject ex:R5 ;
+       rdf:predicate ex:p ;
+       rdf:object ex:o ;
+       ex:note "typed" .
+
+# Reified case B: direct triples, typed and untyped reifiers (13 triples)
+ex:R6 ex:p1 ex:o1 ;
+      ex:p2 ex:o2 ;
+      ex:p3 ex:o3 .
+ex:stB1 a rdf:Statement ;
+        rdf:subject ex:R6 ;
+        rdf:predicate ex:p ;
+        rdf:object ex:o ;
+        ex:note "typed" ;
+        ex:extra "one" .
+ex:stB2 rdf:subject ex:R6 ;
+        rdf:predicate ex:q ;
+        rdf:object ex:o2 ;
+        ex:note "untyped" ;
+        ex:extra "two" .
+
+# Incoming reification: statement A p B, reified by ex:stI
+ex:A ex:p ex:B .
+ex:stI a rdf:Statement ;
+       rdf:subject ex:A ;
+       rdf:predicate ex:p ;
+       rdf:object ex:B ;
+       ex:note "incoming" .
+
+# Reifier whose object is a blank node
+ex:R8 ex:p ex:Z .
+ex:stR8 rdf:subject ex:R8 ;
+        rdf:object [ ex:secret "x" ] .
+
+# Blank-node cycle: _:c1 -> _:c2 -> _:c1 (3 triples)
+ex:R9 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(result), 8)
+        self.assertIn((EX.R1, EX.p, EX.A), result)
+        self.assertIn((EX.R1, EX.q, EX.B), result)
+
+    def testCbdTypeAndRelations(self):
+        result = self.graph.cbd(EX.R2)
+        self.assertEqual(len(result), 3)
+
+    def testCbdPropertyTriples(self):
+        result = self.graph.cbd(EX.R3)
+        self.assertEqual(len(result), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(URIRef("http://example.org/absent"))
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+        self.assertIn((EX.stA, RDF.subject, EX.R5), result)
+
+    def testCbdReifiedUntypedIncluded(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.stB2, RDF.subject, EX.R6), result)
+        self.assertIn((EX.stB2, EX.note, None), result)
+
+    def testCbdIncomingReificationExcluded(self):
+        result_b = self.graph.cbd(EX.B)
+        self.assertEqual(len(result_b), 0)
+        result_a = self.graph.cbd(EX.A)
+        self.assertIn((EX.A, EX.p, EX.B), result_a)
+        self.assertIn((EX.stI, RDF.subject, EX.A), result_a)
+        self.assertIn((EX.stI, RDF.object, EX.B), result_a)
+
+    def testCbdReifierBlankObjectNotExpanded(self):
+        bn = self.graph.value(EX.stR8, RDF.object)
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+        self.assertIn((EX.stR8, RDF.object, bn), result)
+        self.assertNotIn((bn, EX.secret, None), result)
+        self.assertEqual(len(list(result.triples((bn, None, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        before_len = len(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before_len)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == '__main__':
+    unittest.main()
