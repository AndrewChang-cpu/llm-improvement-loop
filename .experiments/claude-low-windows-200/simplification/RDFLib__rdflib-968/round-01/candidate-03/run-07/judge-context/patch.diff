diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..0d9eeab 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,51 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a resource
+
+        Returns a new Graph that is a subgraph of this graph, containing the
+        triples that make up the Concise Bounded Description (CBD) of
+        ``resource``, following the three CBD rules of the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/):
+
+        1. Every triple whose subject is the resource is included. If the
+           object of such a triple is a blank node that is not yet described
+           in the result, the same rules are applied to that blank node.
+        2. Reification: every statement whose ``rdf:subject`` is the resource
+           is included together with all of its triples. No ``rdf:Statement``
+           type check and no matching of ``rdf:predicate`` or ``rdf:object``
+           is performed, so untyped reifiers are included too. Blank nodes
+           reached only through such reifiers are not expanded.
+        3. Reification of blank nodes: rule 2 is applied to every described
+           blank node, including blank nodes reached through rule 1.
+
+        The source graph is not modified. Namespace bindings are not copied.
+
+        :param resource: the resource (URIRef or BNode) to describe. It is
+            used as given in triple-pattern queries.
+        :return: a new Graph instance containing the CBD of ``resource``, or
+            an empty Graph if the resource has no subject triples and no
+            reifiers.
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples with node as subject. The check for an existing
+            # subject triple guards against blank-node cycles.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) is BNode and \
+                        not any(result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 2: reifiers of node, with all of their triples.
+            for reifier, _p, _o in self.triples((None, RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..df86bf8
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,123 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Blank-node resource: 3 direct triples + 3 (address) + 2 (geo) = 8
+ex:A ex:name "A" ;
+     ex:knows ex:B ;
+     ex:address [ ex:street "Main" ;
+                  ex:zip "12345" ;
+                  ex:geo [ ex:lat "1" ; ex:long "2" ] ] .
+
+# Type and two relation triples: 3
+ex:C a ex:Thing ;
+     ex:knows ex:B ;
+     ex:likes ex:B .
+
+# Two property triples: 2
+ex:D ex:name "D" ;
+     ex:age 3 .
+
+# Typed reifier R5: 3 direct + 5 reifier triples = 8
+ex:R5 ex:p1 ex:X ;
+      ex:p2 ex:Y ;
+      ex:p3 ex:Z .
+ex:S5 a rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:p1 ;
+      rdf:object ex:X ;
+      ex:note "typed" .
+
+# Typed reifier + untyped reifier for R6: 3 + 5 + 5 = 13
+ex:R6 ex:p1 ex:X ;
+      ex:p2 ex:Y ;
+      ex:p3 ex:Z .
+ex:S6 a rdf:Statement ;
+      rdf:subject ex:R6 ;
+      rdf:predicate ex:p1 ;
+      rdf:object ex:X ;
+      ex:note "typed" .
+ex:S6u rdf:subject ex:R6 ;
+       rdf:predicate ex:p2 ;
+       rdf:object ex:Y ;
+       ex:note "untyped" ;
+       ex:source ex:doc .
+
+# Incoming reification: statement (A p B) reified by S7 with subject A
+ex:A2 ex:p ex:B2 .
+ex:S7 rdf:subject ex:A2 ;
+      rdf:predicate ex:p ;
+      rdf:object ex:B2 ;
+      ex:note "incoming" .
+
+# Reifier with a blank-node object: the blank node must not be expanded
+ex:F ex:r ex:G .
+ex:S8 rdf:subject ex:F ;
+      rdf:object [ ex:val "z" ] ;
+      ex:note "n" .
+
+# Blank-node cycle: _:c1 -> _:c2 -> _:c1, 3 triples in total
+ex:H ex:link _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.A)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.C)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.D)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.Nobody)), 0)
+
+    def testCbdEmptyIsGraph(self):
+        result = self.graph.cbd(EX.Nobody)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6u, EX.note, None), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B2)), 0)
+        result = self.graph.cbd(EX.A2)
+        self.assertIn((EX.S7, EX.note, None), result)
+
+    def testCbdReifierBlankNodeNotExpanded(self):
+        result = self.graph.cbd(EX.F)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(len(list(result.triples((None, EX.val, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.H)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchangedAndNewInstance(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.A)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
