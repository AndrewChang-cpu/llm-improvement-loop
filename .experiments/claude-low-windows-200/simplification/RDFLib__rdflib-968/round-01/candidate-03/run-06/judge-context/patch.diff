diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..fd3588c 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,52 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        Rule 1: For every triple whose subject is the starting node, include
+        the triple in the description.
+
+        Rule 2: If the object of an included triple is a blank node, apply
+        the rules recursively to that blank node, unless the description
+        already contains a triple with that blank node as subject.
+
+        Rule 3 (reification): For every reifier S with an rdf:subject triple
+        whose object is the node, include every triple whose subject is S.
+        This is applied as it behaves here: every statement whose rdf:subject
+        is the node is included, with no rdf:Statement type check and no
+        predicate or object matching. Rule 3 applies to every processed node,
+        including blank nodes reached through Rule 2. The rdf:object and
+        rdf:predicate values of a reifier are not followed, and blank nodes
+        that appear only in triples added by Rule 3 are not expanded.
+
+        The result is a subgraph of the source graph. The source graph is not
+        modified, and namespace bindings are not copied.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the Concise Bounded Description
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rules 1 and 2: triples whose subject is the node, recursing into
+            # blank node objects not yet expanded
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if isinstance(o, BNode) and \
+                        not any(result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3: triples of every reifier whose rdf:subject is the node
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..3122440
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,104 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Blank node resource: 3 direct triples, one blank node with a nested one.
+ex:R1 ex:p1 ex:A ; ex:p2 ex:B ; ex:p3 _:b1 .
+_:b1 ex:q1 "x" ; ex:q2 _:b2 .
+_:b2 ex:r1 "y" ; ex:r2 "z" ; ex:r3 "w" .
+
+# Type triple and two relation triples.
+ex:R2 a ex:Thing ; ex:rel1 ex:X ; ex:rel2 ex:Y .
+
+# Two property triples.
+ex:R3 ex:name "n" ; ex:label "l" .
+
+# Reified case A: three direct triples and one typed reifier (5 triples).
+ex:R5 ex:a1 ex:O1 ; ex:a2 ex:O2 ; ex:a3 "lit" .
+ex:S5a a rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:a1 ;
+    rdf:object ex:O1 ; ex:comment "typed" .
+
+# Reified case B: three direct triples, a typed reifier (5 triples) and an
+# untyped reifier (5 triples).
+ex:R6 ex:b1 ex:P1 ; ex:b2 ex:P2 ; ex:b3 "lit6" .
+ex:S6a a rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:b1 ;
+    rdf:object ex:P1 ; ex:comment "typed6" .
+ex:S6b rdf:subject ex:R6 ; rdf:predicate ex:b2 ; rdf:object ex:P2 ;
+    ex:comment "untyped6" ; ex:note "n6" .
+
+# Incoming reification: (IncA p IncB) is reified by S7.
+ex:IncA ex:p ex:IncB .
+ex:S7 rdf:subject ex:IncA ; rdf:predicate ex:p ; rdf:object ex:IncB ;
+    ex:comment "inc" .
+
+# Reifier with a blank node object that is not otherwise reached.
+ex:R8 ex:p ex:O8 .
+ex:S8 rdf:subject ex:R8 ; rdf:object _:bo .
+_:bo ex:deep "d" .
+
+# Blank node cycle: R9 -> _:c1 -> _:c2 -> _:c1.
+ex:R9 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Rules 1 and 2: direct triples plus the nested blank nodes.
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.NoSuchResource)), 0)
+
+    def testCbdReified(self):
+        # Reified case A: typed reifier is included.
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        # Reified case B: both the typed and the untyped reifier are included.
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdUntypedReifierIncluded(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertIn((EX.S6b, EX.note, None), result)
+        self.assertEqual(len(list(result.triples((EX.S6b, None, None)))), 5)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (IncA p IncB) describes IncA, not IncB.
+        self.assertEqual(len(self.graph.cbd(EX.IncB)), 0)
+        result = self.graph.cbd(EX.IncA)
+        self.assertEqual(len(list(result.triples((EX.S7, None, None)))), 4)
+
+    def testCbdReifierBlankNodeObjectNotExpanded(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(list(result.triples((None, EX.deep, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(len(self.graph), before)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
