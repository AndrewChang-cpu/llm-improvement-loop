diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..41e5873 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,57 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        1. Include every triple whose subject is the starting node.
+        2. Recursively apply rule 1 to every blank node that is the object
+           of a triple already included in the description.
+        3. Reification: for the starting node and each blank node processed
+           by rules 1 and 2, include every triple whose subject is a reifier
+           of that node, that is, every S with an rdf:subject triple whose
+           object is the node. Reification behaves as follows: every
+           statement whose rdf:subject is the node is included, with no
+           rdf:Statement type check and no predicate or object matching.
+
+        The result is a new Graph that is a subgraph of this Graph; this
+        Graph is not modified. Namespace bindings are not copied.
+
+        Example::
+
+            >>> g = Graph()
+            >>> ex = Namespace("http://example.org/")
+            >>> g.add((ex.R, ex.p, ex.X))
+            >>> g.add((ex.X, ex.q, ex.Y))
+            >>> len(g.cbd(ex.R))
+            1
+
+        :param resource: the starting node of the description
+        :return: a new Graph holding the Concise Bounded Description
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1: triples whose subject is the node.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                # Expand blank node objects not yet described in the result.
+                if type(o) is BNode:
+                    if not any(result.triples((o, None, None))):
+                        add_to_cbd(o)
+            # Rule 3: each reifier S of the node contributes its triples.
+            reifiers = [s for s, _, _ in
+                        self.triples((None, RDF.subject, node))]
+            for reifier in reifiers:
+                for t in self.triples((reifier, None, None)):
+                    result.add(t)
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..20e1645
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,128 @@
+import unittest
+
+from rdflib import Graph
+from rdflib.namespace import Namespace
+
+
+EX = Namespace("http://example.org/")
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# blank node resource: 8 triples reachable
+ex:R1 ex:p1 ex:X ;
+      ex:p2 ex:Y ;
+      ex:p3 _:b1 .
+_:b1 ex:q1 ex:Z ;
+     ex:q2 "lit" ;
+     ex:q3 _:b2 .
+_:b2 ex:r1 ex:W ;
+     ex:r2 "lit2" .
+
+# type plus two relations: 3 triples
+ex:R2 rdf:type ex:T ;
+      ex:p1 ex:X ;
+      ex:p2 ex:Y .
+
+# two property triples: 2 triples
+ex:R3 ex:p1 "a" ;
+      ex:p2 "b" .
+
+# reified case A: 3 direct + 5 from one typed reifier = 8
+ex:R5 ex:p1 ex:X ;
+      ex:p2 ex:Y ;
+      ex:p3 ex:Z .
+ex:S5 rdf:type rdf:Statement ;
+      rdf:subject ex:R5 ;
+      rdf:predicate ex:p1 ;
+      rdf:object ex:X ;
+      ex:note "n" .
+
+# reified case B: 3 direct + 5 typed + 5 untyped = 13
+ex:R6 ex:p1 ex:X ;
+      ex:p2 ex:Y ;
+      ex:p3 ex:Z .
+ex:S6a rdf:type rdf:Statement ;
+       rdf:subject ex:R6 ;
+       rdf:predicate ex:p1 ;
+       rdf:object ex:X ;
+       ex:note "a" .
+ex:S6b rdf:subject ex:R6 ;
+       rdf:predicate ex:p2 ;
+       rdf:object ex:Y ;
+       ex:note "b" ;
+       ex:note2 "c" .
+
+# incoming reification: A p B, reifier of A with object B
+ex:A ex:p ex:B .
+ex:SI rdf:subject ex:A ;
+      rdf:object ex:B ;
+      ex:note "incoming" .
+
+# reifier with blank-node object, not otherwise reached
+ex:R7 ex:p ex:X .
+ex:S7 rdf:subject ex:R7 ;
+      rdf:object _:b3 ;
+      ex:note "y" .
+_:b3 ex:q "hidden" .
+
+# blank node cycle
+ex:R8 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", EX)
+        self.graph.parse(data=TURTLE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+
+    def testCbdNoTriples(self):
+        result = self.graph.cbd(EX.Missing)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(len(result), 0)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+
+    def testCbdReifiedUntypedIncluded(self):
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertIn((EX.S6b, EX.note2, None), result)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        self.assertEqual(len(result), 4)
+        self.assertIn((EX.SI, EX.note, None), result)
+
+    def testCbdBlankNodeNotExpandedThroughReification(self):
+        result = self.graph.cbd(EX.R7)
+        self.assertEqual(len(result), 4)
+        self.assertNotIn((None, EX.q, None), result)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == '__main__':
+    unittest.main()
