diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..3dc67e2 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,50 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        The Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission at https://www.w3.org/Submission/CBD/ . Given a starting
+        node and this graph as the source graph, the CBD is the subgraph
+        identified by these rules:
+
+        1. Include all statements in the source graph whose subject is the
+           starting node.
+        2. For each blank node object of an included statement that has no
+           included statements with that blank node as subject, recursively
+           apply rules 1 and 2 to that blank node.
+        3. Reification: for each reifier of a node being described, include
+           all statements in the source graph whose subject is the reifier.
+           A reifier is any node S having an rdf:subject triple whose object
+           is the node. No rdf:Statement type check is made and no
+           rdf:predicate or rdf:object values are matched, so every statement
+           whose rdf:subject is the node is included, typed or untyped.
+
+        The result is a new Graph that is a subgraph of this graph. This
+        graph is not modified, and namespace bindings are not copied.
+
+        :param resource: the starting node of the description
+        :return: a new Graph containing the concise bounded description,
+                 which is empty if the resource has no statements
+        """
+
+        def add_to_cbd(cbd, node):
+            # Rules 1 and 2: subject triples, then expand blank node objects
+            for s, p, o in self.triples((node, None, None)):
+                cbd.add((s, p, o))
+                if type(o) is BNode and \
+                        next(cbd.triples((o, None, None)), None) is None:
+                    add_to_cbd(cbd, o)
+            # Rule 3: statements whose rdf:subject is this node
+            for reifier in self.subjects(RDF.subject, node):
+                for s, p, o in self.triples((reifier, None, None)):
+                    cbd.add((s, p, o))
+
+        result = Graph()
+        add_to_cbd(result, resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..403906e
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,132 @@
+import unittest
+
+from rdflib import RDF, Graph, Namespace
+
+
+EX = Namespace("http://example.org/")
+
+FIXTURE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Blank node resource: 8 triples reachable by rules 1 and 2
+ex:blankRes ex:p1 ex:o1 ;
+    ex:p2 ex:o2 ;
+    ex:p3 _:b1 .
+_:b1 ex:q1 "x" ;
+    ex:q2 _:b2 ;
+    ex:q3 "z" .
+_:b2 ex:r1 "y" ;
+    ex:r2 "w" .
+
+# Resource with a type triple and two relation triples: 3 triples
+ex:typed a ex:Thing ;
+    ex:rel1 ex:a ;
+    ex:rel2 ex:b .
+
+# Resource with two property triples: 2 triples
+ex:two ex:name "Two" ;
+    ex:value 2 .
+
+# Reified case A: 3 direct triples plus a typed reifier (5 triples): 8
+ex:R5 ex:a1 ex:v1 ;
+    ex:a2 ex:v2 ;
+    ex:a3 ex:v3 .
+ex:s5 a rdf:Statement ;
+    rdf:subject ex:R5 ;
+    rdf:predicate ex:a1 ;
+    rdf:object ex:v1 ;
+    ex:note "reif A" .
+
+# Reified case B: 3 direct triples, typed reifier (5), untyped reifier (5): 13
+ex:R6 ex:b1 ex:w1 ;
+    ex:b2 ex:w2 ;
+    ex:b3 ex:w3 .
+ex:s6 a rdf:Statement ;
+    rdf:subject ex:R6 ;
+    rdf:predicate ex:b1 ;
+    rdf:object ex:w1 ;
+    ex:note "typed B" .
+ex:s6u rdf:subject ex:R6 ;
+    rdf:predicate ex:b2 ;
+    rdf:object ex:w2 ;
+    ex:note "untyped B" ;
+    ex:detail ex:d6 .
+
+# Incoming reification: A p B, reified with rdf:subject A and rdf:object B
+ex:A ex:p ex:B .
+ex:sAB a rdf:Statement ;
+    rdf:subject ex:A ;
+    rdf:object ex:B ;
+    ex:note "incoming" .
+
+# Reifier with a blank node object: the blank node must not be expanded
+ex:R7 ex:p ex:v7 .
+ex:s7 a rdf:Statement ;
+    rdf:subject ex:R7 ;
+    rdf:predicate ex:p ;
+    rdf:object _:bo7 .
+_:bo7 ex:secret "hidden" .
+
+# Blank node cycle: _:c1 and _:c2 point to each other
+ex:R8 ex:p _:c1 .
+_:c1 ex:next _:c2 .
+_:c2 ex:next _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=FIXTURE, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.blankRes)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.typed)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.two)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.missing)), 0)
+
+    def testCbdReified(self):
+        caseA = self.graph.cbd(EX.R5)
+        self.assertEqual(len(caseA), 8)
+        self.assertIn((EX.s5, RDF.type, RDF.Statement), caseA)
+
+        caseB = self.graph.cbd(EX.R6)
+        self.assertEqual(len(caseB), 13)
+        # The untyped reifier must be included
+        self.assertIn((EX.s6u, RDF.subject, EX.R6), caseB)
+        self.assertIn((EX.s6u, EX.detail, EX.d6), caseB)
+
+    def testCbdIncomingReification(self):
+        # B is the object of the reified statement, not its subject
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        # A is the subject of the reified statement and includes its reifier
+        cbdA = self.graph.cbd(EX.A)
+        self.assertEqual(len(cbdA), 5)
+        self.assertIn((EX.sAB, EX.note, None), cbdA)
+
+    def testCbdReifierBlankObject(self):
+        cbd = self.graph.cbd(EX.R7)
+        self.assertEqual(len(cbd), 5)
+        self.assertEqual(len(list(cbd.triples((None, EX.secret, None)))), 0)
+
+    def testCbdBlankCycle(self):
+        cbd = self.graph.cbd(EX.R8)
+        self.assertEqual(len(cbd), 3)
+        self.assertEqual(len(list(cbd.triples((None, EX.next, None)))), 2)
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.blankRes)
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+        self.assertEqual(set(self.graph), before)
+
+
+if __name__ == '__main__':
+    unittest.main()
