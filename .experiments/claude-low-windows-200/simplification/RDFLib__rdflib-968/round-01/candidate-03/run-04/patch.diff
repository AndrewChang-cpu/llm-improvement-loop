diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..e2ebe24 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,56 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """
+        Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        Given a particular node (the starting node) in a particular RDF graph
+        (the source graph), a subgraph of that particular graph, taken to
+        comprise a concise bounded description of the resource denoted by the
+        starting node, can be identified as follows:
+
+        1. Include in the subgraph all statements in the source graph where the
+           subject of the statement is the starting node.
+        2. Recursively, for all statements identified in the subgraph thus far
+           having a blank node as object, include in the subgraph all
+           statements in the source graph where the subject of the statement
+           is the same blank node.
+        3. Include in the subgraph all statements in the source graph where the
+           subject of the statement is a reifier whose rdf:subject is the
+           starting node. Every statement whose rdf:subject is the reifier is
+           included, with no rdf:Statement type check and no predicate or
+           object matching.
+
+        The result is a subgraph of the source graph, which is not modified.
+        Only the three rules above are implemented here; this method is not
+        a claim of W3C conformance for any other rule.
+
+        :param resource: the starting node of the description. It is used as
+            given in triple-pattern queries.
+        :return: a new Graph containing the Concise Bounded Description of
+            resource. It is empty if the source graph has no matching data.
+        """
+        def add_to_cbd(node, cbd):
+            # Rules 1 and 2: statements about the node, expanding blank nodes.
+            for s, p, o in list(self.triples((node, None, None))):
+                cbd.add((s, p, o))
+                if type(o) is BNode and not any(
+                        cbd.triples((o, None, None))):
+                    add_to_cbd(o, cbd)
+            # Rule 3: statements about every reifier of the node.
+            reifiers = self.triples((None, RDF.subject, node))
+            for reifier, _, _ in list(reifiers):
+                for triple in list(self.triples((reifier, None, None))):
+                    cbd.add(triple)
+
+        cbd = Graph()
+        add_to_cbd(resource, cbd)
+        return cbd
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..7558abb
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,135 @@
+import unittest
+
+from rdflib import Graph, Namespace
+from rdflib.namespace import RDF
+
+EX = Namespace("http://example.org/")
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:R1 ex:p1 ex:A ;
+      ex:p2 ex:B ;
+      ex:p3 [ ex:q1 "x" ;
+              ex:q2 [ ex:r "y" ] ] .
+ex:A ex:z "1" .
+
+ex:R2 rdf:type ex:Thing ;
+      ex:knows ex:R3 ;
+      ex:likes ex:R4 .
+ex:R3 ex:name "three" .
+
+ex:R7 ex:name "a" ;
+      ex:age 3 .
+
+ex:R5 ex:p1 "a" ;
+      ex:p2 "b" ;
+      ex:p3 "c" .
+[] rdf:type rdf:Statement ;
+   rdf:subject ex:R5 ;
+   rdf:predicate ex:p1 ;
+   rdf:object "a" ;
+   ex:note "n5" .
+
+ex:R6 ex:p1 "a" ;
+      ex:p2 "b" ;
+      ex:p3 "c" .
+[] rdf:type rdf:Statement ;
+   rdf:subject ex:R6 ;
+   rdf:predicate ex:p1 ;
+   rdf:object "a" ;
+   ex:note "n6a" .
+[] rdf:subject ex:R6 ;
+   rdf:predicate ex:p2 ;
+   rdf:object "b" ;
+   ex:note "n6b" ;
+   ex:source "s6" .
+
+ex:A ex:p ex:B .
+[] rdf:type rdf:Statement ;
+   rdf:subject ex:A ;
+   rdf:predicate ex:p ;
+   rdf:object ex:B .
+
+ex:R9 ex:p ex:X .
+[] rdf:subject ex:R9 ;
+   rdf:predicate ex:p ;
+   rdf:object [ ex:q "deep" ] .
+
+ex:R10 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.bind("ex", EX)
+        self.graph.parse(data=TURTLE, format="turtle")
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        # Three direct triples, two to URIs and one to a blank node
+        # with a nested blank node: 3 + 2 + 1 = 6.
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 6)
+        # A type triple and two relation triples.
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        # Two property triples.
+        self.assertEqual(len(self.graph.cbd(EX.R7)), 2)
+        # No triples at all.
+        self.assertEqual(len(self.graph.cbd(EX.Nothing)), 0)
+
+    def testCbdReifiedTyped(self):
+        # Three direct triples plus a typed reifier (five triples).
+        result = self.graph.cbd(EX.R5)
+        self.assertEqual(len(result), 8)
+        self.assertEqual(
+            len(list(result.triples((None, RDF.type, RDF.Statement)))), 1)
+
+    def testCbdReified(self):
+        # Three direct triples, a typed reifier (five triples) and an
+        # untyped reifier (five triples).
+        result = self.graph.cbd(EX.R6)
+        self.assertEqual(len(result), 13)
+        self.assertEqual(
+            len(list(result.triples((None, EX.source, None)))), 1)
+
+    def testCbdIncomingReification(self):
+        # The reifier of (A p B) is included for A, not for B.
+        self.assertEqual(len(self.graph.cbd(EX.B)), 0)
+        result = self.graph.cbd(EX.A)
+        # A z "1", A p B, and the four reifier triples.
+        self.assertEqual(len(result), 6)
+        self.assertEqual(
+            len(list(result.triples((None, RDF.object, EX.B)))), 1)
+
+    def testCbdBlankNodeNotExpandedThroughReification(self):
+        # R9 p X (1) plus the reifier's triples (3). The blank node
+        # object of rdf:object is not expanded.
+        result = self.graph.cbd(EX.R9)
+        self.assertEqual(len(result), 4)
+        self.assertEqual(
+            len(list(result.triples((None, EX.q, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R10)
+        self.assertEqual(len(result), 3)
+        triples = list(result)
+        self.assertEqual(len(triples), len(set(triples)))
+
+    def testCbdSourceUnchanged(self):
+        before = len(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertIsNot(result, self.graph)
+        self.assertEqual(len(self.graph), before)
+        for triple in result:
+            self.assertIn(triple, self.graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
