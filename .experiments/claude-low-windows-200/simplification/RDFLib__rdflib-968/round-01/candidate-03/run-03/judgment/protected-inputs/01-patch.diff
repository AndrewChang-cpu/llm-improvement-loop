diff --git a/rdflib/graph.py b/rdflib/graph.py
index 4a27e6d..2218dce 100644
--- a/rdflib/graph.py
+++ b/rdflib/graph.py
@@ -1269,6 +1269,58 @@ class Graph(Node):
 
         return retval
 
+    def cbd(self, resource):
+        """Retrieves the Concise Bounded Description of a Resource from a Graph
+
+        Concise Bounded Description (CBD) is defined in the W3C Member
+        Submission (https://www.w3.org/Submission/CBD/) as follows:
+
+        Given a particular node (the starting node) in a particular RDF
+        graph (the source graph), a subgraph of that particular graph,
+        taken to comprise a concise bounded description of the resource
+        denoted by the starting node, can be identified as follows:
+
+        1. Include in the subgraph all statements in the source graph where
+           the subject of the statement is the starting node.
+        2. Recursively, for all statements identified in the subgraph
+           thus far having a blank node object, include in the subgraph
+           all statements in the source graph where the subject of the
+           statement is the blank node in question and which are not
+           already included in the subgraph.
+        3. Include in the subgraph all statements in the source graph
+           where the subject of the statement is a reifier (a node S with
+           an rdf:subject triple whose object is the node being
+           processed). Every statement whose rdf:subject is the node is
+           included, with no rdf:Statement type check and no predicate or
+           object matching. This rule is applied to every processed node,
+           including blank nodes reached by rule 2.
+
+        The result is a subgraph of the source graph. The source graph is
+        not modified, and the result is a new Graph that does not copy the
+        namespace bindings of the source graph.
+
+        :param resource: the starting node (a URIRef, BNode or Literal)
+        :return: a new Graph containing the Concise Bounded Description of
+                 the resource; empty if the resource has no statements
+        """
+        result = Graph()
+
+        def add_to_cbd(node):
+            # Rule 1 and 2: statements with node as subject; expand
+            # blank node objects not yet described in the result.
+            for s, p, o in self.triples((node, None, None)):
+                result.add((s, p, o))
+                if type(o) is BNode and \
+                        not any(True for _ in result.triples((o, None, None))):
+                    add_to_cbd(o)
+            # Rule 3: statements whose subject reifies the node.
+            for reifier in list(self.subjects(RDF.subject, node)):
+                for s, p, o in self.triples((reifier, None, None)):
+                    result.add((s, p, o))
+
+        add_to_cbd(resource)
+        return result
+
 
 class ConjunctiveGraph(Graph):
 
diff --git a/test/test_graph_cbd.py b/test/test_graph_cbd.py
new file mode 100644
index 0000000..e9492d0
--- /dev/null
+++ b/test/test_graph_cbd.py
@@ -0,0 +1,95 @@
+import unittest
+
+from rdflib import Graph, Namespace
+
+TTL = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+# Blank node resource: 3 direct + 2 + 3 = 8 triples
+ex:R1 ex:p1 ex:A ; ex:p2 ex:B ; ex:p3 _:b1 .
+_:b1 ex:q1 "x" ; ex:q2 _:b2 .
+_:b2 ex:r1 "y" ; ex:r2 "z" ; ex:r3 "w" .
+
+# Type plus two relations: 3 triples
+ex:R2 a ex:Thing ; ex:rel1 ex:X ; ex:rel2 ex:Y .
+
+# Two property triples: 2 triples
+ex:R3 ex:name "n" ; ex:age 3 .
+
+# Reified case A: 3 direct + 5 reifier triples = 8
+ex:R5 a ex:Thing ; ex:name "five" ; ex:rel ex:X .
+_:s5 a rdf:Statement ; rdf:subject ex:R5 ; rdf:predicate ex:name ;
+     rdf:object "five" ; ex:certainty "high" .
+
+# Reified case B: 3 direct + 5 typed + 5 untyped = 13
+ex:R6 a ex:Thing ; ex:name "six" ; ex:rel ex:X .
+_:s6t a rdf:Statement ; rdf:subject ex:R6 ; rdf:predicate ex:name ;
+      rdf:object "six" ; ex:certainty "high" .
+_:s6u rdf:subject ex:R6 ; rdf:predicate ex:name ; rdf:object "six" ;
+      ex:note "untyped" ; ex:source "src" .
+
+# Incoming reification: reifier of (S1 link S2) must not describe S2
+ex:S1 ex:link ex:S2 .
+_:r1 rdf:subject ex:S1 ; rdf:predicate ex:link ; rdf:object ex:S2 ;
+     ex:note "r" .
+
+# Reifier with blank node object: _:bo is not expanded by rule 3
+ex:R7 ex:p ex:C .
+_:s7 rdf:subject ex:R7 ; rdf:predicate ex:p ; rdf:object _:bo ;
+     ex:note "n" .
+_:bo ex:deep "d" ; ex:deep2 "e" .
+
+# Blank node cycle: _:c1 -> _:c2 -> _:c1
+ex:R8 ex:p _:c1 .
+_:c1 ex:q _:c2 .
+_:c2 ex:r _:c1 .
+"""
+
+EX = Namespace("http://example.org/")
+
+
+class CbdTestCase(unittest.TestCase):
+
+    def setUp(self):
+        self.graph = Graph()
+        self.graph.parse(data=TTL, format="turtle")
+        self.graph.bind("ex", EX)
+
+    def tearDown(self):
+        self.graph.close()
+
+    def testCbd(self):
+        self.assertEqual(len(self.graph.cbd(EX.R1)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R2)), 3)
+        self.assertEqual(len(self.graph.cbd(EX.R3)), 2)
+        self.assertEqual(len(self.graph.cbd(EX.Nothing)), 0)
+
+    def testCbdReified(self):
+        self.assertEqual(len(self.graph.cbd(EX.R5)), 8)
+        self.assertEqual(len(self.graph.cbd(EX.R6)), 13)
+
+    def testCbdIncomingReification(self):
+        self.assertEqual(len(self.graph.cbd(EX.S1)), 5)
+        self.assertEqual(len(self.graph.cbd(EX.S2)), 0)
+
+    def testCbdReifierBlankNodeObjectNotExpanded(self):
+        result = self.graph.cbd(EX.R7)
+        self.assertEqual(len(result), 5)
+        self.assertEqual(len(list(result.triples((None, EX.deep, None)))), 0)
+
+    def testCbdBlankNodeCycle(self):
+        result = self.graph.cbd(EX.R8)
+        self.assertEqual(len(result), 3)
+        self.assertEqual(len(set(result)), len(result))
+
+    def testCbdSourceUnchanged(self):
+        before = set(self.graph)
+        result = self.graph.cbd(EX.R1)
+        self.assertEqual(before, set(self.graph))
+        self.assertIsNot(result, self.graph)
+        self.assertIsInstance(result, Graph)
+
+
+if __name__ == "__main__":
+    unittest.main()
