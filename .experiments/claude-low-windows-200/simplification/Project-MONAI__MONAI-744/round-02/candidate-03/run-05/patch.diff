+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(label, num_classes):
+    """
+    Build prediction logits from a batched integer label map (batch, spatial...):
+    one-hot encode, move the class axis to channel position 1, scale by 1000 and cast to float.
+    """
+    onehot = torch.nn.functional.one_hot(label, num_classes)  # (batch, spatial..., classes)
+    dims = [0, label.dim()] + list(range(1, label.dim()))  # (batch, classes, spatial...)
+    logits = onehot.permute(*dims) * 1000
+    return logits.float()
+
+
+def binary_target():
+    target = torch.zeros(1, 4, 4, dtype=torch.long)  # batch axis of size 1
+    target[:, 1:3, 1:3] = 1
+    return target
+
+
+TEST_CASES = [
+    [  # binary 2D case, class-axis target shape (1, 4, 4)
+        {"dist_matrix": torch.tensor([[0.0, 1.0], [1.0, 0.0]])},
+        {"target": binary_target(), "flip": False},
+        0.0,
+    ],
+    [  # binary 2D case, target with added size-1 channel dim (1, 1, 4, 4)
+        {"dist_matrix": torch.tensor([[0.0, 1.0], [1.0, 0.0]])},
+        {"target": binary_target().unsqueeze(1), "flip": False},
+        0.0,
+    ],
+    [  # binary 2D case, flipped predictions
+        {"dist_matrix": torch.tensor([[0.0, 1.0], [1.0, 0.0]])},
+        {"target": binary_target(), "flip": True},
+        1.0,
+    ],
+    [  # empty class case: all voxels label 0, two classes
+        {"dist_matrix": torch.tensor([[0.0, 1.0], [1.0, 0.0]])},
+        {"target": torch.zeros(1, 4, 4, dtype=torch.long), "flip": False},
+        0.0,
+    ],
+    [  # empty class case, flipped predictions
+        {"dist_matrix": torch.tensor([[0.0, 1.0], [1.0, 0.0]])},
+        {"target": torch.zeros(1, 4, 4, dtype=torch.long), "flip": True},
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES)
+    def test_result(self, init_param, data_param, expected_val):
+        target = data_param["target"]
+        label = target.squeeze(1) if target.dim() == 4 else target  # batched label map (batch, H, W)
+        if data_param["flip"]:
+            label = 1 - label
+        input = one_hot_logits(label, num_classes=2)
+        result = GeneralizedWassersteinDiceLoss(**init_param).forward(input, target)
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+    def test_numpy_matrix_and_max_normalization(self):
+        target = binary_target()
+        input = one_hot_logits(target, num_classes=2)
+        loss_tensor = GeneralizedWassersteinDiceLoss(torch.tensor([[0.0, 1.0], [1.0, 0.0]]))(input, target)
+        loss_numpy = GeneralizedWassersteinDiceLoss(np.array([[0.0, 1.0], [1.0, 0.0]]))(input, target)
+        loss_scaled = GeneralizedWassersteinDiceLoss(torch.tensor([[0.0, 2.0], [2.0, 0.0]]))(input, target)
+        np.testing.assert_allclose(loss_numpy.detach().numpy(), loss_tensor.detach().numpy(), atol=1e-6)
+        np.testing.assert_allclose(loss_scaled.detach().numpy(), loss_tensor.detach().numpy(), atol=1e-6)
+
+    def test_ill_matrix(self):
+        with self.assertRaisesRegex(ValueError, "Dist Matrix is invalid."):
+            GeneralizedWassersteinDiceLoss(torch.ones((2, 3)))
+
+    def test_alias(self):
+        from monai.losses.dice import generalized_wasserstein_dice
+
+        self.assertIs(generalized_wasserstein_dice, GeneralizedWassersteinDiceLoss)
+
+
+if __name__ == "__main__":
+    unittest.main()
