+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_prediction(label_map, num_classes):
+    """
+    label_map: batched integer label map, shape (1, H, W).
+    Returns logits of shape (1, num_classes, H, W) equal to 1000 times the one-hot encoding.
+    """
+    onehot = F.one_hot(label_map.long(), num_classes)  # (1, H, W, C), class axis last
+    last = label_map.dim()
+    perm = [0, last] + list(range(1, last))  # move class axis to channel position 1
+    return onehot.permute(*perm).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(DIST_MATRIX)
+
+        result = loss(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # optional class-dimension target variant: insert size-1 axis after the batch axis
+        result = loss(make_prediction(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped = 1 - target
+        result = loss(make_prediction(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(DIST_MATRIX)
+
+        result = loss(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped = 1 - target
+        result = loss(make_prediction(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
