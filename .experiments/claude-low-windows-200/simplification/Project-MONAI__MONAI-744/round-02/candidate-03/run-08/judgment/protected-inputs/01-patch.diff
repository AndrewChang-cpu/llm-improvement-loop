+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground-truth label, using a class-distance matrix. The class weights follow
+    the generalized Dice weighting of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    so the weighting follows the generalized Dice loss.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array,
+                where C is the number of classes. Entries must be nonnegative. The matrix is divided by its
+                maximum entry if that maximum is not exactly 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Reduction mode, stored for the parent loss. It does not change the returned loss, which is
+                always the batch mean regardless of reduction.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map for every sample in the batch:
+            W_s(v) = sum_k M[y_s(v), k] * p_k,s(v)
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N), computed for every sample s.
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target.long()]  # (batch, N, classes): distance row selected by each voxel's label
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the generalized Dice class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Classes absent from a sample receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target.long(), self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for each sample b:
+            TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v))
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target.long())  # (batch, N): alpha(b, y_b(v))
+        # (b, s, v) products, summed over s and v
+        products = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(products, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for each sample b:
+            D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v))
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target.long())  # (batch, N): alpha(b, y_b(v))
+        # (b, s, v) products, summed over s and v
+        products = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(products, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape (batch, classes, spatial dimensions...).
+            target: integer class-index labels of shape (batch, spatial dimensions...) or
+                (batch, 1, spatial dimensions...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of 1 - (2 * TP_b + smooth) / (D_b + smooth).
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
