+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix.
+    The class weighting follows the generalized Dice loss, using inverse volume as in
+    Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+    unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits, and the target is a batch of integer class-index label maps.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: the square C by C class-distance matrix, as a 2D torch tensor or 2D numpy array,
+                where C is the number of classes. Entries must be nonnegative. The matrix is divided by its
+                maximum entry if that maximum is not exactly 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Reduction mode, stored on the loss. The returned loss is the batch mean regardless of reduction.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: the softmax probabilities, shape (batch, classes, N).
+            flat_target: the integer class-index labels, shape (batch, N).
+
+        Returns:
+            the distance map, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # gather each voxel's distance row by its label: shape (batch, N, classes)
+        rows = m[flat_target.long()]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of class c in sample b.
+        Absent classes get weight 1.
+
+        Args:
+            flat_target: the integer class-index labels, shape (batch, N).
+
+        Returns:
+            the class weights, shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target.long(), num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)). The sum over s runs over every sample's
+        distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: the class weights, shape (batch, classes).
+            flat_target: the integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: the distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one generalized true positive value per sample, shape (batch,).
+        """
+        # each voxel's alpha picked by its label: shape (batch, N)
+        alpha_map = torch.gather(alpha, 1, flat_target.long())
+        prod = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(torch.sum(prod, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)). The sum over s runs over every sample's
+        distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: the class weights, shape (batch, classes).
+            flat_target: the integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: the distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target.long())
+        prod = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(torch.sum(prod, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape (batch, classes, spatial dimensions).
+            target: the integer class-index labels, shape (batch, spatial dimensions) or
+                (batch, 1, spatial dimensions).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the scalar batch mean of the per-sample losses 1 - (2 * TP_b + smooth) / (D_b + smooth).
+
+        """
+        batch = input.shape[0]
+        n_classes = input.shape[1]
+        flat_proba = torch.softmax(input.reshape(batch, n_classes, -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denom = self.compute_denominator(alpha, flat_target, wdm)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
