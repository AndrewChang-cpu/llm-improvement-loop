+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_prediction(batched_label_map, num_classes):
+    """
+    Build logits from a batched integer label map of shape (B, H, W).
+    One-hot encode with `num_classes`, move the class axis to channel position 1, then scale by 1000.
+    """
+    one_hot = F.one_hot(batched_label_map, num_classes)  # (B, H, W, C)
+    one_hot = one_hot.permute(0, 3, 1, 2)  # (B, C, H, W)
+    return (one_hot * 1000).float()
+
+
+def binary_target():
+    target = torch.zeros(1, 4, 4, dtype=torch.long)
+    target[:, 1:3, 1:3] = 1
+    return target
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = binary_target()
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        # correct prediction, target without channel axis
+        pred = make_prediction(target, 2)
+        result = loss(pred, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3, rtol=0)
+
+        # correct prediction, target with size-1 channel axis (B, 1, H, W)
+        result = loss(pred, target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3, rtol=0)
+
+        # flipped prediction
+        flipped = make_prediction(1 - target, 2)
+        result = loss(flipped, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3, rtol=0)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        pred = make_prediction(target, 2)
+        result = loss(pred, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3, rtol=0)
+
+        flipped = make_prediction(1 - target, 2)
+        result = loss(flipped, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3, rtol=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
