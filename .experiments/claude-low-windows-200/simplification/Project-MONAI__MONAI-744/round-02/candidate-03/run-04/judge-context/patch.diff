+import unittest
+
+import numpy as np
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(label_map, num_classes):
+    """
+    Build prediction logits from a batched integer label map of shape (batch, H, W).
+    The label map is one-hot encoded with the class axis last, moved to channel position 1,
+    then scaled by 1000 and cast to float. Result shape: (batch, num_classes, H, W).
+    """
+    onehot = torch.nn.functional.one_hot(torch.as_tensor(label_map, dtype=torch.long), num_classes)
+    return (onehot.permute(0, 3, 1, 2) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = np.zeros((1, 4, 4), dtype=np.int64)
+        target[0, 1:3, 1:3] = 1
+        flipped = 1 - target
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        # correct prediction, with and without an added size-1 class axis in the target
+        pred = one_hot_logits(target, 2)
+        result = loss(pred, torch.as_tensor(target))
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.numpy(), 0.0, atol=1e-3)
+
+        result = loss(pred, torch.as_tensor(target).unsqueeze(1))
+        np.testing.assert_allclose(result.numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        pred_flipped = one_hot_logits(flipped, 2)
+        result = loss(pred_flipped, torch.as_tensor(target))
+        np.testing.assert_allclose(result.numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = np.zeros((1, 4, 4), dtype=np.int64)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        pred = one_hot_logits(target, 2)
+        result = loss(pred, torch.as_tensor(target))
+        np.testing.assert_allclose(result.numpy(), 0.0, atol=1e-3)
+
+        pred_flipped = one_hot_logits(1 - target, 2)
+        result = loss(pred_flipped, torch.as_tensor(target))
+        np.testing.assert_allclose(result.numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
