+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The per-voxel true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, given a class-distance matrix. The class
+    weights follow the generalized Dice weighting of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is treated as logits and the target as integer class-index labels, with shapes
+    BCS[...] and B[S...] or B1S[...] respectively. The returned loss is a scalar: the batch mean.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape CxC, as a torch tensor or numpy array.
+                Entries are nonnegative. It is max-normalized to a maximum of 1 when needed.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Reduction mode, stored on the loss. It does not change the returned value, which is
+                always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix).item() != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = self.m.shape[1]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance map for every sample in the batch:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities of shape BxCxN.
+            flat_target: integer class-index labels of shape BxN.
+
+        Returns:
+            distance map of shape BxN.
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # each voxel's distance row, selected by its label: BxNxC
+        dist_rows = m[flat_target]
+        # sum over classes of distance row times probability: BxN
+        return torch.sum(dist_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the generalized Dice class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape BxN.
+
+        Returns:
+            alpha weights of shape BxC.
+        """
+        one_hot_target = F.one_hot(flat_target, self.num_classes)  # BxNxC
+        volumes = torch.sum(one_hot_target, dim=1).to(torch.float32)  # BxC
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for every sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape BxC, from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels of shape BxN.
+            wasserstein_distance_map: distance maps of shape BxN, from wasserstein_distance_map.
+
+        Returns:
+            one true-positive value per sample, shape B.
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # BxN, alpha of each voxel's own label
+        # pairs (b, s, v): alpha of sample b at voxel v, times (1 - W) of sample s at voxel v
+        pairs = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # BxBxN
+        return torch.sum(torch.sum(pairs, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for every sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape BxC, from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels of shape BxN.
+            wasserstein_distance_map: distance maps of shape BxN, from wasserstein_distance_map.
+
+        Returns:
+            one denominator value per sample, shape B.
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # BxN, alpha of each voxel's own label
+        # pairs (b, s, v): alpha of sample b at voxel v, times (2 - W) of sample s at voxel v
+        pairs = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # BxBxN
+        return torch.sum(torch.sum(pairs, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape BCS[...], where S[...] are zero or more spatial dimensions.
+            target: integer class-index labels of shape BS[...] or B1S[...].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        num_classes = input.shape[1]
+
+        flat_input = input.reshape(batch, num_classes, -1)  # BxCxN
+        flat_target = target.reshape(batch, -1)  # BxN
+        flat_proba = torch.softmax(flat_input, dim=1)
+
+        wasserstein_distance = self.wasserstein_distance_map(flat_proba, flat_target)  # BxN
+        alpha = self.compute_weights_generalized_true_positives(flat_target)  # BxC
+
+        true_positive = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance)  # B
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance)  # B
+
+        score = (2.0 * true_positive + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
