+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_logits(label_map, num_classes):
+    """
+    Build 1000-scaled one-hot logits from a batched integer label map of shape B x spatial.
+    The class axis is moved from last to channel position 1, giving B x C x spatial.
+    """
+    one_hot = F.one_hot(label_map, num_classes)  # B x spatial x C
+    ndim = one_hot.dim()
+    perm = [0, ndim - 1] + list(range(1, ndim - 1))
+    return one_hot.permute(*perm).float() * 1000.0
+
+
+def binary_target():
+    target = torch.zeros((1, 4, 4), dtype=torch.long)  # batch axis of size 1
+    target[:, 1:3, 1:3] = 1
+    return target
+
+
+def empty_class_target():
+    return torch.zeros((1, 4, 4), dtype=torch.long)  # every voxel is label 0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        target = binary_target()
+
+        # correct prediction, target of shape B x S x S
+        result = loss(make_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # correct prediction, target with an added size-1 channel dimension B x 1 x S x S
+        result = loss(make_logits(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(make_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        target = empty_class_target()
+
+        result = loss(make_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped = 1 - target
+        result = loss(make_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
