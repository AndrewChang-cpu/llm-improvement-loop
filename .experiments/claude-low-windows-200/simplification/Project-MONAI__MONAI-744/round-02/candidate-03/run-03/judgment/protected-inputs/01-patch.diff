+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The generalized true positives and the denominator of the generalized Dice overlap (Sudre, C. et. al. (2017)
+    Generalised Dice overlap as a deep learning loss function for highly unbalanced segmentations. MICCAI DLMIA 2017)
+    are discounted per voxel by the Wasserstein distance between the predicted class distribution and the
+    ground-truth label, computed with the class-distance matrix ``dist_matrix``. The class weighting follows the
+    generalized Dice loss: the weight of class c in sample b is 1 / (V(b, c) + 1), where V(b, c) is the number of
+    voxels of class c in sample b.
+
+    Because the distance term of every voxel is summed over all samples of the batch while the class weights come
+    from each sample's own labels, the loss for each sample depends on the whole batch.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), where C is the number of classes. Given as a
+                2D torch tensor or a 2D numpy array with nonnegative entries. It is divided by its maximum entry
+                when that maximum is not 1.
+            reduction: the reduction mode, stored on the parent loss. Defaults to ``"mean"``. The returned loss is
+                the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: dist_matrix is not square (message: ``"Dist Matrix is invalid."``).
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: softmax probabilities, shape batch by classes by N.
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            per-voxel distances for every sample, shape batch by N.
+        """
+        m = self.m.to(flat_proba.device)
+        # row M[y_s(v), :] selected by each voxel's label, shape batch by N by classes -> batch by classes by N
+        dist_rows = m[flat_target].permute(0, 2, 1)
+        return torch.sum(dist_rows * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) counts the voxels of class c in
+        sample b. A class absent from a sample gets weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            alpha weights, shape batch by classes.
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1).float()
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum over every sample s and voxel v of alpha(b, y_b(v)) * (1 - W_s(v)).
+
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: distance map of all samples, shape batch by N.
+
+        Returns:
+            one generalized true positive value per sample, shape batch.
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # batch by N, weight of each voxel of sample b
+        pairs = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # b, s, v
+        return torch.sum(pairs, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum over every sample s and voxel v of alpha(b, y_b(v)) * (2 - W_s(v)).
+
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: distance map of all samples, shape batch by N.
+
+        Returns:
+            one denominator value per sample, shape batch.
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # batch by N, weight of each voxel of sample b
+        pairs = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # b, s, v
+        return torch.sum(pairs, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BCH[WD].
+            target: integer class indices, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample loss, as a scalar tensor.
+        """
+        batch_size = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch_size, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch_size, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
