+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The per-voxel true-positive and denominator contributions are discounted by the Wasserstein
+    distance between the predicted class distribution and the ground-truth label, using a class-distance
+    matrix. The class weighting follows the generalized Dice loss (Sudre et al., Generalised Dice overlap
+    as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017), i.e. the inverse
+    of the volume of each class in each sample.
+
+    The true positives and denominator of each sample sum over the distance maps of every sample in the
+    batch, so the loss of one sample depends on the whole batch.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: a 2D square class-distance matrix of shape (C, C), where C is the number of classes.
+                Entries should be nonnegative. Accepts a torch tensor or a numpy array. If its maximum is not 1,
+                the whole matrix is divided by its maximum.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Reduction mode, passed to the parent loss and stored. It does not change the returned loss,
+                which is always the batch mean.
+
+        Raises:
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+            ValueError: Dist Matrix is invalid. The distance matrix is not square.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s and voxel v.
+
+        Args:
+            flat_proba: the softmax probabilities, shape (batch, classes, N).
+            flat_target: the flattened integer labels, shape (batch, N).
+
+        Returns:
+            the per-voxel distances for every sample, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # gather each voxel's distance row by its label: (batch, N, classes)
+        dist_rows = m[flat_target.long()]
+        return torch.sum(dist_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: the flattened integer labels, shape (batch, N).
+
+        Returns:
+            the alpha weights, shape (batch, classes).
+        """
+        one_hot_target = F.one_hot(flat_target.long(), num_classes=self.num_classes)
+        volumes = torch.sum(one_hot_target, dim=1)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for every sample b. The sum over s runs over
+        every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: the class weights, shape (batch, classes).
+            flat_target: the flattened integer labels, shape (batch, N).
+            wasserstein_distance_map: the distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        # each voxel's alpha picked by its label: (batch, N)
+        alpha_vox = torch.gather(alpha, 1, flat_target.long())
+        # (b, s, v) combinations, summed over s and v
+        prod = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(prod, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for every sample b. The sum over s runs over
+        every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: the class weights, shape (batch, classes).
+            flat_target: the flattened integer labels, shape (batch, N).
+            wasserstein_distance_map: the distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target.long())
+        prod = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(prod, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape should be (batch, classes, spatial dims...).
+            target: integer class-index labels, shape should be (batch, spatial dims...) or
+                (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the scalar batch mean of the per-sample losses.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, self.num_classes, -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wass_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wass_map)
+        denom = self.compute_denominator(alpha, flat_target, wass_map)
+
+        per_sample = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(per_sample)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
