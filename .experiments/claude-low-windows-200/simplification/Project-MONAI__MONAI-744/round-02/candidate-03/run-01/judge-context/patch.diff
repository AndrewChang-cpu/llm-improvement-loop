+import unittest
+
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_predictions(label, num_classes):
+    """
+    One-hot encode a batched integer label map, move the class axis (last) to channel position 1,
+    then scale by 1000 to act as confident logits.
+    """
+    one_hot = F.one_hot(label.long(), num_classes=num_classes)
+    last = one_hot.dim() - 1
+    one_hot = one_hot.permute(0, last, *range(1, last))
+    return one_hot.float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        # batch of one, 4 by 4 map with inner 2 by 2 block labeled 1
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(make_predictions(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # the same target with an added size-1 channel dimension
+        result = loss(make_predictions(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # logits of the flipped target
+        flipped = make_predictions(1 - target, 2)
+        result = loss(flipped, target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        # batch of one, 4 by 4 map where every voxel is label 0
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(make_predictions(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        flipped = make_predictions(1 - target, 2)
+        result = loss(flipped, target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
