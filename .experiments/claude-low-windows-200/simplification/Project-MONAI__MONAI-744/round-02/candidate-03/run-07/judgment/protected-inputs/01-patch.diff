+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It uses the Wasserstein distance between the predicted class distribution of each voxel and
+    the ground-truth label, given a class-distance matrix, to discount the true-positive terms.
+    The class weighting follows the generalized Dice loss (Sudre et al., Generalised Dice overlap
+    as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix, as a torch tensor or numpy array. Entries should be
+                nonnegative. It is divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. Defaults to ``"mean"``.
+                It is stored but does not change the output: the returned loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample.
+
+        Args:
+            flat_proba: class probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N), computed for every sample in the batch.
+        """
+        m = self.m.to(flat_proba.device)
+        dist_rows = m[flat_target]  # (batch, N, classes): each voxel's row selected by its label
+        probs = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(dist_rows * probs, dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        one_hot = F.one_hot(flat_target, self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot, dim=1).float()  # (batch, classes)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)), one value per sample b.
+        The sum over s runs over every sample's distance map in the batch, so each value depends on the
+        whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N).
+
+        Returns:
+            generalized true positives, shape (batch,).
+        """
+        alpha_vox = alpha.gather(1, flat_target)  # (batch, N): each voxel's alpha by its label
+        # (b, s, voxel) combinations
+        prod = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(prod, dim=[1, 2])
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)), one value per sample b.
+        The sum over s runs over every sample's distance map in the batch, so each value depends on the
+        whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N).
+
+        Returns:
+            generalized denominators, shape (batch,).
+        """
+        alpha_vox = alpha.gather(1, flat_target)  # (batch, N): each voxel's alpha by its label
+        # (b, s, voxel) combinations
+        prod = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(prod, dim=[1, 2])
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial dims...).
+            target: integer class-index labels, shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of 1 - (2 * TP_b + smooth) / (D_b + smooth).
+            The reduction setting is not applied here.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+        flat_proba = torch.softmax(flat_input, dim=1)
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denom = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
