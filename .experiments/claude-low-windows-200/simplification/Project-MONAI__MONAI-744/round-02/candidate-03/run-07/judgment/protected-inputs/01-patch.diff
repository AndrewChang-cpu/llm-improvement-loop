+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_pred(target, num_classes):
+    """
+    target: batched integer label map, shape (1, H, W).
+    Returns logits of shape (1, num_classes, H, W): 1000 times the one-hot encoding of the label map.
+    """
+    onehot = F.one_hot(target, num_classes)  # (1, H, W, num_classes)
+    onehot = onehot.permute(0, 3, 1, 2)  # class axis moved to channel position 1
+    return onehot.float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        flipped = 1 - target
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix)
+
+        # correct prediction
+        loss = loss_fn(make_pred(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # same target with an added class-dimension axis: (1, 1, 4, 4)
+        loss = loss_fn(make_pred(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # prediction of the flipped labels
+        loss = loss_fn(make_pred(flipped, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # every voxel is label 0
+        flipped = 1 - target
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix)
+
+        loss = loss_fn(make_pred(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        loss = loss_fn(make_pred(flipped, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
