+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss in which each voxel's true-positive contribution is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label,
+    using a class-distance matrix. The class weighting follows the generalized Dice loss
+    (Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+    unbalanced segmentations. DLMIA 2017), i.e. inverse volume weights.
+
+    The input is treated as logits. The target is a batch of integer class-index label maps with
+    shape (B, spatial dims) or (B, 1, spatial dims). The loss is always the batch mean, regardless
+    of the ``reduction`` setting.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D distance matrix between classes, as a torch tensor or numpy array.
+                It is max-normalized to a maximum of 1 if its maximum is not already 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. It is stored but does not
+                change the output: the loss is always the batch mean. Defaults to ``"mean"``.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.dim() != 2 or dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        max_value = dist_matrix.max()
+        if max_value.item() != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # gather each voxel's distance row by its label: shape (batch, N, classes)
+        rows = m[flat_target]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for each sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map s, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        # each voxel's alpha by its label of the sample itself: shape (batch, N)
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_map[:, None, :] * (1.0 - wasserstein_distance_map[None, :, :]), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for each sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map s, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_map[:, None, :] * (2.0 - wasserstein_distance_map[None, :, :]), dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BCH[WD], raw logits.
+            target: the shape should be BH[WD] or B1H[WD], integer class-index labels.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the batch mean of the per-sample loss.
+        """
+        batch_size, num_channels = input.shape[0], input.shape[1]
+        if target.dim() == input.dim():
+            target = target[:, 0]
+        flat_target = target.reshape(batch_size, -1)
+        flat_proba = torch.softmax(input.reshape(batch_size, num_channels, -1), 1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
