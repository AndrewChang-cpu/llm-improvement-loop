+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(label_map, num_classes):
+    """label_map has a leading batch axis; returns logits shaped (batch, classes, spatial...)."""
+    onehot = F.one_hot(label_map, num_classes=num_classes)  # class axis last
+    last = onehot.dim() - 1
+    dims = [0, last] + list(range(1, last))  # move class axis to channel position 1
+    return onehot.permute(*dims).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def _target_binary(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # batch axis first
+        target[:, 1:3, 1:3] = 1
+        return target
+
+    def test_binary_2d(self):
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        target = self._target_binary()
+
+        correct = _one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss_fn.forward(correct, target).item(), 0.0, places=3)
+
+        # target with an added size-1 channel dimension after the batch axis
+        self.assertAlmostEqual(loss_fn.forward(correct, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        flipped = _one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss_fn.forward(flipped, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+
+        correct = _one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss_fn.forward(correct, target).item(), 0.0, places=3)
+
+        flipped = _one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss_fn.forward(flipped, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
