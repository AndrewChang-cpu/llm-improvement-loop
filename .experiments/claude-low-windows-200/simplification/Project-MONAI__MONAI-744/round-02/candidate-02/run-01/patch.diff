+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss in which the true-positive contribution of each voxel is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed from a
+    class-distance matrix. The class weighting follows the generalized Dice loss, i.e. the inverse volume weights
+    described in:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+        segmentations. DLMIA 2017.
+    """
+
+    def __init__(
+        self, dist_matrix: Union[torch.Tensor, np.ndarray], reduction: Union[LossReduction, str] = LossReduction.MEAN
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), as a 2D torch tensor or numpy array.
+                Entries must be nonnegative. The matrix is divided by its maximum entry unless that maximum is 1.
+            reduction: the reduction mode, as a ``LossReduction`` member or its string value. Defaults to ``"mean"``.
+                It is stored but does not change the output: the loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BCH[WD].
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            a scalar tensor, the mean over the batch of the per-sample loss ``1 - (2 * TP + smooth) / (D + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denom = self.compute_denominator(alpha, flat_target, wdm)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: softmax probabilities, the shape should be batch x classes x N.
+            flat_target: integer class-index labels, the shape should be batch x N.
+
+        Returns:
+            per-voxel distances for every sample, the shape is batch x N.
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes): row M[y_s(v), :] for each voxel
+        return torch.sum(rows * flat_proba.transpose(1, 2), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, the shape should be batch x N.
+
+        Returns:
+            per-sample, per-class weights, the shape is batch x classes.
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for each sample b. The sum over s runs over
+        every sample's distance map, so each value depends on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, the shape is batch x classes.
+            flat_target: integer class-index labels, the shape should be batch x N.
+            wasserstein_distance_map: distances for every sample, the shape is batch x N.
+
+        Returns:
+            one generalized true-positive value per sample, the shape is batch.
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's own label
+        return torch.einsum("bn,sn->b", alpha_map, 1.0 - wasserstein_distance_map)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for each sample b. The sum over s runs over
+        every sample's distance map, so each value depends on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, the shape is batch x classes.
+            flat_target: integer class-index labels, the shape should be batch x N.
+            wasserstein_distance_map: distances for every sample, the shape is batch x N.
+
+        Returns:
+            one generalized denominator value per sample, the shape is batch.
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's own label
+        return torch.einsum("bn,sn->b", alpha_map, 2.0 - wasserstein_distance_map)
+
+
 dice = Dice = DiceLoss
