+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_prediction(label_map, num_classes):
+    """
+    Build logits from a batched integer label map of shape (batch, H, W).
+    One-hot encode with `num_classes`, move the class axis to channel position 1, then scale by 1000.
+    Result has shape (batch, classes, H, W).
+    """
+    one_hot = F.one_hot(label_map, num_classes)  # (batch, H, W, classes)
+    one_hot = one_hot.permute(0, 3, 1, 2)  # (batch, classes, H, W)
+    return (one_hot * 1000).float()
+
+
+TARGET = torch.zeros(1, 4, 4, dtype=torch.long)
+TARGET[:, 1:3, 1:3] = 1  # inner 2x2 block is label 1, rest is label 0
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+TEST_CASES_BINARY = [
+    [{"target_channel_dim": False, "flip": False}, 0.0],  # correct prediction
+    [{"target_channel_dim": True, "flip": False}, 0.0],  # correct prediction, target shape (1, 1, 4, 4)
+    [{"target_channel_dim": False, "flip": True}, 1.0],  # flipped prediction
+]
+
+TEST_CASES_EMPTY = [
+    [{"flip": False}, 0.0],  # correct prediction
+    [{"flip": True}, 1.0],  # flipped prediction
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES_BINARY)
+    def test_binary_2d(self, params, expected):
+        target = TARGET.clone()
+        pred_labels = 1 - target if params["flip"] else target
+        input = make_prediction(pred_labels, 2)
+        loss_target = target.unsqueeze(1) if params["target_channel_dim"] else target
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        result = loss.forward(input, loss_target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), expected, places=3)
+
+    @parameterized.expand(TEST_CASES_EMPTY)
+    def test_empty_class(self, params, expected):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        pred_labels = 1 - target if params["flip"] else target
+        input = make_prediction(pred_labels, 2)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        result = loss.forward(input, target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), expected, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
