+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss in which each voxel's true-positive contribution is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label.
+    The class weighting follows the generalized Dice loss (Sudre, C. et. al. (2017) Generalised Dice
+    overlap as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017), i.e.
+    each class is weighted by the inverse of its volume.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), where C is the number of classes.
+                It can be a torch tensor or a numpy array. Entries should be nonnegative. The matrix is
+                divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. It is stored but does not
+                change the output of ``forward``, which is always the batch mean. Defaults to ``"mean"``.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map for every sample. For sample s and voxel v with
+        label y_s(v), the distance is W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: class probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target]  # (batch, N, classes): distance row of each voxel's label
+        return torch.sum(rows.permute(0, 2, 1) * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of sample b labelled c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).float()  # (batch, classes)
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The weight uses sample b's labels and volumes, while the sum runs over every sample's distance
+        map, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's label
+        products = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # (batch, batch, N)
+        return torch.sum(torch.sum(products, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's label
+        products = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # (batch, batch, N)
+        return torch.sum(torch.sum(products, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape should be BCH[WD].
+            target: integer class-index labels, shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses, as a scalar tensor.
+        """
+        batch = input.shape[0]
+        flat_target = target.reshape(batch, -1)
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), 1)
+
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
