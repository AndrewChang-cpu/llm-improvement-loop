+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(label, num_classes):
+    """Batched integer label map (batch, spatial...) -> logits (batch, classes, spatial...) scaled by 1000."""
+    onehot = F.one_hot(label, num_classes)  # (batch, spatial..., classes)
+    axes = [0, onehot.dim() - 1] + list(range(1, onehot.dim() - 1))
+    return (onehot.permute(*axes) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # batch, H, W
+        target[:, 1:3, 1:3] = 1
+
+        correct = one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss(correct, target).item(), 0.0, places=3)
+
+        # optional size-1 channel axis on the target; prediction layout unchanged
+        self.assertAlmostEqual(loss(correct, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        flipped = one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # batch, H, W; all voxels in class 0
+
+        correct = one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss(correct, target).item(), 0.0, places=3)
+
+        flipped = one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
