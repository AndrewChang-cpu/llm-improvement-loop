+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    The Generalized Wasserstein Dice Loss (GW-DL) defined in:
+
+    Fidon et al., Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+    using Holistic Convolutional Networks, MICCAI BrainLes 2017.
+
+    It discounts each voxel's true-positive contribution by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix. The class
+    weights follow the generalized Dice loss (Sudre et al., Generalised Dice overlap as a deep learning
+    loss function for highly unbalanced segmentations, MICCAI DLMIA 2017), i.e. inverse volume weighting.
+
+    The input is expected to be raw logits of shape (batch, classes, spatial dims...), and the target
+    an integer class-index map of shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+    """
+
+    def __init__(self, dist_matrix, reduction: Union[LossReduction, str] = LossReduction.MEAN) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix, given as a torch tensor or numpy array.
+                Its size must equal the number of input channels. Entries must be nonnegative.
+                It is divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode to store, {``"none"``, ``"mean"``, ``"sum"``}.
+                Default is ``"mean"``. The loss returned by ``forward`` is always the batch mean,
+                regardless of this setting.
+
+        Raises:
+            ValueError: when ``dist_matrix`` is not square.
+            ValueError: when ``reduction`` is not a valid ``LossReduction`` value.
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = self.m.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Computes the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v)
+        for every sample s, using the row of the distance matrix selected by each voxel's label.
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # rows[s, v, k] = M[y_s(v), k]
+        rows = m[flat_target]
+        # W[s, v] = sum_k rows[s, v, k] * p[s, k, v]
+        return (rows * flat_proba.permute(0, 2, 1)).sum(-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Computes the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            weights of shape (batch, classes).
+        """
+        counts = F.one_hot(flat_target, num_classes=self.num_classes).sum(1).float()
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Computes TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)). The sum runs over every sample's
+        distance map, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (b, N): alpha of sample b's own labels
+        return (alpha_vox[:, None, :] * (1.0 - wasserstein_distance_map[None, :, :])).sum(dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Computes D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)). The sum runs over every sample's
+        distance map, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (b, N): alpha of sample b's own labels
+        return (alpha_vox[:, None, :] * (2.0 - wasserstein_distance_map[None, :, :])).sum(dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial dims...).
+            target: integer class-index labels, shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: small value added to numerator and denominator to avoid division by zero.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        num_channels = input.shape[1]
+        flat_proba = F.softmax(input.reshape(batch, num_channels, -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denom = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return (1.0 - score).mean()
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
