+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_logits(label_map, num_classes):
+    """
+    Build logits from a batched integer label map of shape (batch, spatial dims...).
+    One-hot encode with num_classes, move the class axis to channel position 1, scale by 1000.
+    """
+    onehot = F.one_hot(label_map, num_classes)  # (batch, spatial..., classes)
+    dims = list(range(onehot.dim()))
+    order = [0, dims[-1]] + dims[1:-1]
+    return (onehot.permute(*order) * 1000).float()
+
+
+# binary 2D label maps: inner 2x2 block is class 1, the rest is class 0
+BINARY_TARGET = torch.zeros((1, 4, 4), dtype=torch.long)
+BINARY_TARGET[:, 1:3, 1:3] = 1
+BINARY_FLIPPED = 1 - BINARY_TARGET
+
+TEST_CASES_BINARY = [
+    [  # shape: (1, 4, 4) target, (1, 2, 4, 4) logits, correct
+        {"dist_matrix": DIST_MATRIX},
+        {"input": make_logits(BINARY_TARGET, 2), "target": BINARY_TARGET},
+        0.0,
+    ],
+    [  # shape: (1, 1, 4, 4) target, (1, 2, 4, 4) logits, correct
+        {"dist_matrix": DIST_MATRIX},
+        {"input": make_logits(BINARY_TARGET, 2), "target": BINARY_TARGET.unsqueeze(1)},
+        0.0,
+    ],
+    [  # shape: (1, 4, 4) target, (1, 2, 4, 4) logits, flipped
+        {"dist_matrix": DIST_MATRIX},
+        {"input": make_logits(BINARY_FLIPPED, 2), "target": BINARY_TARGET},
+        1.0,
+    ],
+]
+
+# all-zero target: class 1 is absent from the sample
+EMPTY_TARGET = torch.zeros((1, 4, 4), dtype=torch.long)
+
+TEST_CASES_EMPTY = [
+    [  # shape: (1, 4, 4) target, (1, 2, 4, 4) logits, correct
+        {"dist_matrix": DIST_MATRIX},
+        {"input": make_logits(EMPTY_TARGET, 2), "target": EMPTY_TARGET},
+        0.0,
+    ],
+    [  # shape: (1, 4, 4) target, (1, 2, 4, 4) logits, flipped
+        {"dist_matrix": DIST_MATRIX},
+        {"input": make_logits(1 - EMPTY_TARGET, 2), "target": EMPTY_TARGET},
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES_BINARY)
+    def test_binary_result(self, arguments, input_data, expected_val):
+        result = GeneralizedWassersteinDiceLoss(**arguments)(**input_data)
+        np.testing.assert_allclose(result.item(), expected_val, atol=1e-3)
+
+    @parameterized.expand(TEST_CASES_EMPTY)
+    def test_empty_class_result(self, arguments, input_data, expected_val):
+        result = GeneralizedWassersteinDiceLoss(**arguments)(**input_data)
+        np.testing.assert_allclose(result.item(), expected_val, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
