+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalized Dice overlap (Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning
+    loss function for highly unbalanced segmentations. MICCAI DLMIA 2017) in which the true-positive
+    contribution of each voxel is discounted by the Wasserstein distance between the predicted class
+    distribution and the ground-truth label, computed from a class-distance matrix. The class weighting
+    follows the generalized Dice loss: each class is weighted by the inverse of its volume.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix, as a torch tensor or numpy array. It is divided by
+                its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. It is stored but does not
+                change the output: the loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction value is invalid, see ``LossReduction``.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if float(dist_matrix.max()) != 1.0:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape BCS[...] (batch, classes, spatial dimensions).
+            target: integer class-index labels, shape B S[...] or B 1 S[...].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of the per-sample loss.
+
+        """
+        batch = input.shape[0]
+        num_classes = input.shape[1]
+        flat_proba = torch.softmax(input.reshape(batch, num_classes, -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denom = self.compute_denominator(alpha, flat_target, wdm)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(loss)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample.
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N).
+
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes): row M[y_s(v)] for each voxel
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels of class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            weights of shape (batch, classes).
+
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).to(torch.float)
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)). The sum runs over every sample's distance
+        map, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances for all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+
+        """
+        alpha_voxel = alpha.gather(1, flat_target)  # (batch, N)
+        gain = 1.0 - wasserstein_distance_map  # (batch, N), indexed by s
+        return torch.sum(alpha_voxel.unsqueeze(1) * gain.unsqueeze(0), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)). The sum runs over every sample's distance
+        map, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances for all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        alpha_voxel = alpha.gather(1, flat_target)  # (batch, N)
+        gain = 2.0 - wasserstein_distance_map  # (batch, N), indexed by s
+        return torch.sum(alpha_voxel.unsqueeze(1) * gain.unsqueeze(0), dim=(1, 2))
+
+
