+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def one_hot_logits(target, num_classes, class_dim=False):
+    """Build logits (batch, classes, spatial...) = 1000 * one-hot of a batched integer label map."""
+    onehot = F.one_hot(target, num_classes)  # (batch, spatial..., classes)
+    dims = [0, onehot.dim() - 1] + list(range(1, onehot.dim() - 1))
+    return (onehot.permute(*dims) * 1000).float()
+
+
+def binary_target():
+    target = torch.zeros((1, 4, 4), dtype=torch.long)
+    target[:, 1:3, 1:3] = 1
+    return target
+
+
+TEST_CASES = [
+    [  # binary 2D, correct logits, shape (1, 4, 4) target
+        {"dist_matrix": DIST_MATRIX},
+        {"target": binary_target(), "flipped": False, "class_dim": False},
+        0.0,
+    ],
+    [  # binary 2D, correct logits, target with size-1 class dimension
+        {"dist_matrix": DIST_MATRIX},
+        {"target": binary_target(), "flipped": False, "class_dim": True},
+        0.0,
+    ],
+    [  # binary 2D, flipped logits
+        {"dist_matrix": DIST_MATRIX},
+        {"target": binary_target(), "flipped": True, "class_dim": False},
+        1.0,
+    ],
+    [  # empty class case, correct logits (all-zero target)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": torch.zeros((1, 4, 4), dtype=torch.long), "flipped": False, "class_dim": False},
+        0.0,
+    ],
+    [  # empty class case, flipped logits (all-zero target)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": torch.zeros((1, 4, 4), dtype=torch.long), "flipped": True, "class_dim": False},
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def _run(self, input_param, input_data):
+        target = input_data["target"]
+        num_classes = 2
+        logits_target = 1 - target if input_data["flipped"] else target
+        logits = one_hot_logits(logits_target, num_classes)
+        label = target.unsqueeze(1) if input_data["class_dim"] else target
+        return GeneralizedWassersteinDiceLoss(**input_param)(logits, label)
+
+    def _check(self, case):
+        input_param, input_data, expected_val = case
+        result = self._run(input_param, input_data)
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+    def test_binary_2d(self):
+        for case in TEST_CASES[:3]:
+            self._check(case)
+
+    def test_empty_class(self):
+        for case in TEST_CASES[3:]:
+            self._check(case)
+
+
+if __name__ == "__main__":
+    unittest.main()
