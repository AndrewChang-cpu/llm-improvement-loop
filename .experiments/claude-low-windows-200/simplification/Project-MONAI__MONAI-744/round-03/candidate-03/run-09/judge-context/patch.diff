+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_prediction(target, num_classes, flip=False):
+    """Build logits of shape (batch, classes, spatial...) from a batched integer label map (batch, spatial...)."""
+    labels = 1 - target if flip else target
+    onehot = F.one_hot(labels, num_classes)  # (batch, spatial..., classes)
+    ndim = onehot.dim()
+    dims = [0, ndim - 1] + list(range(1, ndim - 1))
+    return onehot.permute(*dims).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1  # batched label map, shape (1, 4, 4)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        result = loss(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # same target with an extra size-1 channel dimension
+        result = loss(make_prediction(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        result = loss(make_prediction(target, 2, flip=True), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # no voxels of class 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        result = loss(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        result = loss(make_prediction(target, 2, flip=True), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
