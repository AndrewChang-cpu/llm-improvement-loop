+import unittest
+
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _logits_from_target(target, num_classes):
+    """target: integer label map with batch axis, shape (1, H, W). Returns logits (1, C, H, W)."""
+    onehot = F.one_hot(target, num_classes)  # (1, H, W, C)
+    onehot = onehot.permute(0, 3, 1, 2)  # class axis to channel position 1
+    return (onehot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        self.target = torch.zeros(1, 4, 4, dtype=torch.long)
+        self.target[:, 1:3, 1:3] = 1
+
+    def test_binary_2d(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        correct = _logits_from_target(self.target, 2)
+        flipped = _logits_from_target(1 - self.target, 2)
+
+        result = loss(correct, self.target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # optional size-1 class dimension in the target
+        result = loss(correct, self.target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        result = loss(flipped, self.target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        correct = _logits_from_target(target, 2)
+        flipped = _logits_from_target(1 - target, 2)
+
+        result = loss(correct, target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        result = loss(flipped, target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
