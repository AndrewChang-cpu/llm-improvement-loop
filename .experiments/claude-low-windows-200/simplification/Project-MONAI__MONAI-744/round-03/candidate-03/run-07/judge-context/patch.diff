+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+
+
+def make_prediction(target, num_classes):
+    """Logits equal to 1000 times the one-hot of a batched label map, class axis moved to channel position 1."""
+    onehot = F.one_hot(target.long(), num_classes)  # (batch, spatial..., classes)
+    last = onehot.dim() - 1
+    onehot = onehot.permute(0, last, *range(1, last))  # (batch, classes, spatial...)
+    return (onehot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        # correct logits, target with and without a size-1 class dimension
+        pred = make_prediction(target, 2)
+        result = loss(pred, target)
+        np.testing.assert_allclose(result.cpu().numpy(), 0.0, atol=1e-3)
+        result = loss(pred, target.unsqueeze(1))
+        np.testing.assert_allclose(result.cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped logits
+        flipped = make_prediction(1 - target, 2)
+        result = loss(flipped, target)
+        np.testing.assert_allclose(result.cpu().numpy(), 1.0, atol=1e-3)
+        result = loss(flipped, target.unsqueeze(1))
+        np.testing.assert_allclose(result.cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.cpu().numpy(), 0.0, atol=1e-3)
+
+        result = loss(make_prediction(1 - target, 2), target)
+        np.testing.assert_allclose(result.cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
