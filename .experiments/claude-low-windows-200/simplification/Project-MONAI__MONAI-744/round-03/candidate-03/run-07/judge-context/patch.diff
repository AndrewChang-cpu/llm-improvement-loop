+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class probabilities and the ground-truth label, using a class-distance matrix. The
+    class weighting follows the generalized Dice loss (Sudre, C. et. al. (2017) Generalised Dice
+    overlap as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017),
+    i.e. each class is weighted by the inverse of its volume.
+
+    The input is raw logits shaped (batch, classes, spatial dims...). The target is an integer
+    class-index map shaped (batch, spatial dims...) or (batch, 1, spatial dims...).
+    """
+
+    def __init__(self, dist_matrix, reduction: Union[LossReduction, str] = LossReduction.MEAN) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (classes, classes), as a 2D torch tensor
+                or 2D numpy array with nonnegative entries. It is divided by its maximum entry if that
+                maximum is not exactly 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                The reduction mode, stored on the parent loss. Defaults to ``"mean"``. The loss returned
+                by ``forward`` is always the batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.ndim != 2 or dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance of every sample. For sample s and voxel v with
+        ground-truth label y, the distance is W_s(v) = sum_k M[y, k] * p_k,s(v), where M is the
+        normalized distance matrix and p is the softmax probability of class k.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's distance row, selected by its label
+        return (rows * flat_proba.permute(0, 2, 1)).sum(-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Classes absent from a sample get weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = F.one_hot(flat_target, self.num_classes).sum(1)  # (batch, classes)
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map, while the class weight uses the
+        labels of sample b.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: per-voxel distances of shape (batch, N), summed over every sample.
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        distance_term = (1.0 - wasserstein_distance_map).sum(0)  # (N,), summed over every sample s
+        return (alpha_voxel * distance_term).sum(1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map, while the class weight uses the
+        labels of sample b.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: per-voxel distances of shape (batch, N), summed over every sample.
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        distance_term = (2.0 - wasserstein_distance_map).sum(0)  # (N,), summed over every sample s
+        return (alpha_voxel * distance_term).sum(1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape (batch, classes, spatial dims...). Softmax is applied internally.
+            target: integer class-index labels of shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant added to the numerator and denominator to avoid division by zero.
+
+        Returns:
+            scalar tensor: the mean over the batch of the per-sample loss ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, self.num_classes, -1), 1)
+        flat_target = target.reshape(batch, -1)
+
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
