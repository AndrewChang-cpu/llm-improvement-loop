+import unittest
+
+import torch
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def one_hot_logits(label_map, num_classes):
+    """Build logits of shape (batch, classes, spatial...) equal to 1000 times the one-hot of a batched label map."""
+    encoded = torch.nn.functional.one_hot(label_map, num_classes)
+    # move the class axis (last) to channel position 1
+    dims = [0, encoded.dim() - 1] + list(range(1, encoded.dim() - 1))
+    return encoded.permute(*dims).float() * 1000.0
+
+
+def binary_target():
+    target = torch.zeros(1, 4, 4, dtype=torch.long)
+    target[:, 1:3, 1:3] = 1
+    return target
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(
+        [
+            [False, False],
+            [False, True],
+            [True, False],
+            [True, True],
+        ]
+    )
+    def test_binary_case(self, flipped, add_channel_dim):
+        target = binary_target()
+        pred_label = 1 - target if flipped else target
+        input = one_hot_logits(pred_label, 2)
+        gt = target.unsqueeze(1) if add_channel_dim else target
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(input, gt)
+        expected = 1.0 if flipped else 0.0
+        self.assertEqual(loss.dim(), 0)
+        self.assertAlmostEqual(loss.item(), expected, places=3)
+
+    @parameterized.expand([[False], [True]])
+    def test_empty_class_case(self, flipped):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        pred_label = 1 - target if flipped else target
+        input = one_hot_logits(pred_label, 2)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(input, target)
+        expected = 1.0 if flipped else 0.0
+        self.assertAlmostEqual(loss.item(), expected, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
