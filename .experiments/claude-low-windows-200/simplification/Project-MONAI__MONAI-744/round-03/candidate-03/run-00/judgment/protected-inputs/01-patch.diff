+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def one_hot_logits(target, num_classes):
+    """Build logits 1000 * one-hot(target) with the class axis at channel position 1."""
+    onehot = F.one_hot(target, num_classes)  # (batch, spatial..., classes)
+    ndim = onehot.dim()
+    onehot = onehot.permute(0, ndim - 1, *range(1, ndim - 1))  # (batch, classes, spatial...)
+    return onehot.float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d_case(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # batch axis present
+        target[:, 1:3, 1:3] = 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        # correct logits
+        logits = one_hot_logits(target, 2)
+        self.assertEqual(logits.shape, (1, 2, 4, 4))
+        loss = loss_fn(logits, target)
+        self.assertEqual(loss.dim(), 0)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # same target with an added size-1 channel dimension
+        target_chn = target.unsqueeze(1)  # (1, 1, 4, 4)
+        loss = loss_fn(logits, target_chn)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # flipped logits
+        flipped = 1 - target
+        loss = loss_fn(one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class_case(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        loss = loss_fn(one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        loss = loss_fn(one_hot_logits(1 - target, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
