+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The true-positive and denominator terms of the generalized Dice overlap (Sudre et al.,
+    Generalised Dice overlap as a deep learning loss function for highly unbalanced segmentations,
+    MICCAI DLMIA 2017) are discounted by a Wasserstein distance between the predicted class
+    probabilities and the ground-truth label, given by a class-distance matrix. The class weighting
+    follows the generalized Dice loss, using the inverse of the class volume.
+
+    The input is treated as raw logits (softmax is applied internally) and the target is a
+    batched integer class-index label map.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                Entries must be nonnegative. It is divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, one of ``"none"``, ``"mean"``, ``"sum"``. Defaults to ``"mean"``.
+                It is stored but not applied in forward: the loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix is not square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W[s, v] = sum_k M[y_s(v), k] * p_k,s(v) for every sample s
+        and voxel v.
+
+        Args:
+            flat_proba: class probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances for every sample, shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes): distance row of each voxel's label
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels in sample b with label c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights, shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum over every sample s and voxel v of alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map, not only sample b's own.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance map for every sample, shape (batch, N).
+
+        Returns:
+            one generalized true-positive value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        coupled = torch.sum(1.0 - wasserstein_distance_map, dim=0)  # (N,), summed over samples s
+        return torch.sum(alpha_vox * coupled, dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum over every sample s and voxel v of alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map, not only sample b's own.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance map for every sample, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        coupled = torch.sum(2.0 - wasserstein_distance_map, dim=0)  # (N,), summed over samples s
+        return torch.sum(alpha_vox * coupled, dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BCS[D[H[W]]] (batch, classes, spatial dimensions).
+            target: integer class-index labels, the shape should be B[1]S[D[H[W]]]
+                (batch plus spatial dimensions, or batch, 1, spatial dimensions).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses, as a scalar tensor.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, self.num_classes, -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denom = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
