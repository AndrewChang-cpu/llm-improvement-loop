+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_prediction(target, num_classes, flip=False):
+    """Build logits of shape (batch, classes, spatial...) from a batched integer label map (batch, spatial...)."""
+    labels = 1 - target if flip else target
+    one_hot = F.one_hot(labels, num_classes=num_classes)  # (batch, spatial..., classes)
+    one_hot = one_hot.permute(0, -1, *range(1, one_hot.dim() - 1))  # class axis to channel position 1
+    return one_hot.float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # batched label map, shape (1, 4, 4)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss.forward(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # same target with an added size-1 class dimension
+        result = loss.forward(make_prediction(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        result = loss.forward(make_prediction(target, 2, flip=True), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # all voxels in class 0, class 1 is empty
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss.forward(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        result = loss.forward(make_prediction(target, 2, flip=True), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
