+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class probabilities and the ground-truth label, where the class-distance matrix gives the cost between classes.
+    The class weighting follows the generalized Dice loss (Sudre, C. et. al. (2017) Generalised Dice overlap as a
+    deep learning loss function for highly unbalanced segmentations. DLMIA 2017), i.e. the inverse of the
+    class volume. Input is raw logits, and target is an integer class-index label map.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), as a torch tensor or numpy array,
+                with nonnegative entries. It is divided by its maximum entry when that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Reduction mode stored on the loss. The loss returned by ``forward`` is always the batch mean,
+                regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.dim() != 2 or dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BCH[WD].
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample losses.
+
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input, dim=1).reshape(batch, self.num_classes, -1)
+        if target.dim() == input.dim():
+            target = target.squeeze(1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denom = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes): distance row of each voxel's label
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights of shape (batch, classes).
+
+        """
+        volumes = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map, so the distance term couples the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance map for every sample, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+
+        """
+        alpha_v = alpha.gather(1, flat_target)  # (batch, N): each sample's weight at each voxel
+        return torch.sum(alpha_v.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map, so the distance term couples the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance map for every sample, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        alpha_v = alpha.gather(1, flat_target)  # (batch, N): each sample's weight at each voxel
+        return torch.sum(alpha_v.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2))
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
