+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class probabilities and the ground-truth label, using a class-distance matrix. The class weighting follows
+    the generalized Dice loss (Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function
+    for highly unbalanced segmentations. DLMIA 2017), i.e. the inverse of the class volume.
+
+    Input is raw logits of shape BCS[...] (batch, classes, spatial dimensions). Target is an integer class-index
+    map of shape B S[...] or B 1 S[...]. The distance matrix is C by C, where C is the number of classes.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), with C the number of classes.
+                Accepts a torch tensor or a numpy array with nonnegative entries. It is divided by its
+                maximum entry if that maximum is not 1.
+            reduction: reduction mode, stored on the parent loss. The forward output is always the batch mean,
+                regardless of this value.
+
+        Raises:
+            ValueError: reduction is invalid, as reported by the LossReduction conversion.
+            ValueError: Dist Matrix is invalid. The distance matrix is not square.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample. For sample s and voxel v with label
+        y_s(v), the distance is W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where p is the softmax probability.
+
+        Args:
+            flat_proba: class probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances for every sample, shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # gather each voxel's distance row by its label: (batch, N, classes)
+        distance_rows = m[flat_target]
+        return torch.sum(distance_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number
+        of voxels in sample b with label c. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights, shape (batch, classes).
+        """
+        one_hot_counts = F.one_hot(flat_target, self.num_classes)
+        volumes = torch.sum(one_hot_counts, dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The weight uses sample b's own labels, while the distance map sums over every sample s in the batch,
+        so the sum runs over every sample's distance map.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: per-voxel distances for every sample, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch).
+        """
+        voxel_alpha = torch.gather(alpha, 1, flat_target)  # (batch, N), sample b's weight per voxel
+        # term[b, s, v] = alpha(b, y_b(v)) * (1 - W_s(v))
+        terms = voxel_alpha.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(terms, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)), using the same cross-sample
+        coupling as compute_generalized_true_positive: the sum runs over every sample's distance map.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: per-voxel distances for every sample, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch).
+        """
+        voxel_alpha = torch.gather(alpha, 1, flat_target)
+        terms = voxel_alpha.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(terms, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape BCS[...] (batch, classes, spatial dimensions).
+            target: integer class-index labels, shape BS[...] or B1S[...].
+            smooth: a small constant added to the numerator and denominator to avoid division by zero.
+
+        Returns:
+            scalar tensor, the mean of the per-sample losses. The reduction setting is not applied here.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
