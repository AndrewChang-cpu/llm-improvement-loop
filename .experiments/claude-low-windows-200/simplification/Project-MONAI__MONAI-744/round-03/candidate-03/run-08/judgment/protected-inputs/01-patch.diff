+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_logits(target, num_classes, flip=False):
+    """Build logits of shape (batch, classes, H, W) from a batched integer label map (batch, H, W)."""
+    if flip:
+        target = 1 - target
+    one_hot = torch.nn.functional.one_hot(target, num_classes)  # (batch, H, W, classes)
+    return (one_hot.permute(0, 3, 1, 2) * 1000).float()
+
+
+BINARY_TARGET = torch.zeros((1, 4, 4), dtype=torch.long)
+BINARY_TARGET[:, 1:3, 1:3] = 1
+
+TEST_CASES_BINARY = [
+    [{"unsqueeze": False, "flip": False}, 0.0],
+    [{"unsqueeze": True, "flip": False}, 0.0],
+    [{"unsqueeze": False, "flip": True}, 1.0],
+]
+
+TEST_CASES_EMPTY = [
+    [{"flip": False}, 0.0],
+    [{"flip": True}, 1.0],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES_BINARY)
+    def test_binary_2d(self, params, expected_val):
+        target = BINARY_TARGET.clone()
+        logits = make_logits(target, 2, flip=params["flip"])
+        loss_target = target.unsqueeze(1) if params["unsqueeze"] else target
+        result = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(logits, loss_target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+    @parameterized.expand(TEST_CASES_EMPTY)
+    def test_empty_class(self, params, expected_val):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        logits = make_logits(target, 2, flip=params["flip"])
+        result = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
