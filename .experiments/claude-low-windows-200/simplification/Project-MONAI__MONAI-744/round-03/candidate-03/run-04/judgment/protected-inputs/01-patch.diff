+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+# binary 2D case: inner 2x2 block is label 1, rest is label 0; batch of one, shape (1, 4, 4)
+BINARY_TARGET = torch.zeros((1, 4, 4), dtype=torch.long)
+BINARY_TARGET[:, 1:3, 1:3] = 1
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def _one_hot_logits(label_map, num_classes):
+    """label_map has shape (batch, spatial...); returns logits of shape (batch, classes, spatial...)."""
+    onehot = F.one_hot(label_map, num_classes)  # (batch, spatial..., classes)
+    ndim = onehot.dim()
+    perm = [0, ndim - 1] + list(range(1, ndim - 1))
+    return onehot.permute(*perm).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = BINARY_TARGET.clone()  # (1, 4, 4): batch of one
+        logits = _one_hot_logits(target, 2)  # (1, 2, 4, 4)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(logits, target)
+        np.testing.assert_allclose(loss.item(), 0.0, atol=1e-3)
+
+        # same target with an added size-1 channel dimension
+        target_ch = target.unsqueeze(1)  # (1, 1, 4, 4)
+        loss_ch = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(logits, target_ch)
+        np.testing.assert_allclose(loss_ch.item(), 0.0, atol=1e-3)
+
+        # flipped logits: every sample is confidently wrong
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        loss_flipped = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(flipped_logits, target)
+        np.testing.assert_allclose(loss_flipped.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all label 0, batch of one
+        logits = _one_hot_logits(target, 2)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(logits, target)
+        np.testing.assert_allclose(loss.item(), 0.0, atol=1e-3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        loss_flipped = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(flipped_logits, target)
+        np.testing.assert_allclose(loss_flipped.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
