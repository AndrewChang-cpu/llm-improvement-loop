+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss in which the true-positive contribution of each voxel is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, measured with the
+    class-distance matrix `dist_matrix`. The class weights follow the generalized Dice loss, i.e. the inverse
+    volume of each class, as in:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+        segmentations. DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array,
+                with nonnegative entries. It is divided by its maximum entry if that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode. It is stored with the loss but does not change the output:
+                the loss is always the batch mean, regardless of reduction. Defaults to ``"mean"``.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_probs: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s,
+        where y_s(v) is the ground-truth label and p_k,s(v) the softmax probability of class k.
+
+        Args:
+            flat_probs: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N), one row per sample.
+        """
+        m = self.m.to(device=flat_probs.device, dtype=flat_probs.dtype)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's distance row, selected by its label
+        probs = flat_probs.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(rows * probs, dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        sample b whose label is c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)  # (batch, classes)
+        return 1.0 / (counts + 1)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The weights come from sample b's own labels, while the sum runs over every sample's distance map.
+
+        Args:
+            alpha: class weights, shape (batch, classes), from `compute_weights_generalized_true_positives`.
+            flat_target: integer class-index labels, shape (batch, N).
+            distance_map: Wasserstein distances for every sample, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): each voxel's weight of its own label
+        return torch.einsum("bn,sn->b", alpha_map, 1.0 - distance_map)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The weights come from sample b's own labels, while the sum runs over every sample's distance map.
+
+        Args:
+            alpha: class weights, shape (batch, classes), from `compute_weights_generalized_true_positives`.
+            flat_target: integer class-index labels, shape (batch, N).
+            distance_map: Wasserstein distances for every sample, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): each voxel's weight of its own label
+        return torch.einsum("bn,sn->b", alpha_map, 2.0 - distance_map)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, the shape should be BCH[WD].
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the scalar batch mean of the per-sample losses.
+
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        probs = torch.softmax(flat_input, dim=1)
+        distance_map = self.wasserstein_distance_map(probs, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
