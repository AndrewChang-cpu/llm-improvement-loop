+import unittest
+
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = [[0.0, 1.0], [1.0, 0.0]]
+
+
+def make_prediction(label, num_classes=2):
+    """One-hot a batched integer label map, move the class axis to channel position 1, scale to logits."""
+    onehot = F.one_hot(label.long(), num_classes)  # (B, H, W, C)
+    return (onehot.permute(0, 3, 1, 2) * 1000).float()  # (B, C, H, W)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=torch.tensor(DIST_MATRIX))
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # batch axis first
+        target[:, 1:3, 1:3] = 1
+
+        # correct prediction
+        result = loss(make_prediction(target), target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # optional size-1 class dimension in the target; prediction layout unchanged
+        result = loss(make_prediction(target), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(make_prediction(flipped), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=torch.tensor(DIST_MATRIX))
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+
+        # correct prediction
+        result = loss(make_prediction(target), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # flipped prediction
+        result = loss(make_prediction(1 - target), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
