+import unittest
+
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def _prediction(label, num_classes):
+    # label: batched integer label map, shape (1, H, W); one-hot, move class axis to channel 1, scale.
+    onehot = F.one_hot(label, num_classes)  # (1, H, W, C)
+    return (onehot.permute(0, 3, 1, 2) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        # correct prediction, with and without a size-1 class dimension in the target
+        result = loss(_prediction(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+        result = loss(_prediction(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(_prediction(flipped, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+        result = loss(_prediction(flipped, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(_prediction(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        flipped = 1 - target
+        result = loss(_prediction(flipped, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
