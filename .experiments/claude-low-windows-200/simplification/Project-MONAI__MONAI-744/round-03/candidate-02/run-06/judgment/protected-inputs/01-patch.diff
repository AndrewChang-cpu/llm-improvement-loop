+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The loss is a Dice-type overlap score in which each voxel's true positive contribution is
+    discounted by the Wasserstein distance between the predicted class distribution and the
+    ground-truth label, computed from a class-distance matrix. Class weighting follows the
+    generalized Dice loss (inverse volume), see:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for
+        highly unbalanced segmentations. MICCAI DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), where C is the number of classes.
+                It can be a torch tensor or a numpy array. It is max-normalized if its maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode, stored on the loss. The loss returned by ``forward`` is always
+                the batch mean, regardless of the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_probs: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_probs: flattened softmax probabilities, shape (batch, classes, N).
+            flat_target: flattened integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+        """
+        m = self.m.to(flat_probs.device)
+        rows = m[flat_target.long()]  # (batch, N, classes), row y_s(v) of M for each voxel
+        return torch.sum(rows * flat_probs.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: flattened integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target.long(), self.num_classes), dim=1).float()
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, dist_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map s, so samples are coupled through W.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: flattened integer class-index labels, shape (batch, N).
+            dist_map: Wasserstein distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one generalized true positive per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target.long())  # (batch, N), weight of b's own labels
+        return torch.sum(alpha_map[:, None, :] * (1.0 - dist_map[None]), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, dist_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map s, so samples are coupled through W.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: flattened integer class-index labels, shape (batch, N).
+            dist_map: Wasserstein distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one denominator per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target.long())  # (batch, N), weight of b's own labels
+        return torch.sum(alpha_map[:, None, :] * (2.0 - dist_map[None]), dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, the shape should be BCH[WD].
+            target: integer class-index labels, the shape should be B1H[WD] or BH[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean of the per-sample losses.
+        """
+        batch = input.shape[0]
+        probs = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        dist_map = self.wasserstein_distance_map(probs, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, dist_map)
+        denominator = self.compute_denominator(alpha, flat_target, dist_map)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
