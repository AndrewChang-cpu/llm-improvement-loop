+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground-truth label, using a class-distance matrix. The class weighting follows
+    the generalized Dice loss (Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function
+    for highly unbalanced segmentations. DLMIA 2017), i.e. inverse volume weights.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                Entries must be nonnegative. It is divided by its maximum entry if that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode, which is stored but does not change the output.
+                The loss is always the batch mean regardless of reduction.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: float logits of shape (batch, classes, spatial dims...). Softmax is applied over classes.
+            target: integer class-index labels of shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant added to numerator and denominator to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample loss.
+
+        """
+        batch = input.shape[0]
+        flat_target = target.reshape(batch, -1)
+        probs = torch.softmax(input.reshape(batch, input.shape[1], -1), 1)
+
+        distance_map = self.wasserstein_distance_map(probs, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denom = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+    def wasserstein_distance_map(self, flat_probs: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_probs: softmax probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+
+        """
+        m = self.m.to(flat_probs.device)
+        rows = m[flat_target]  # (batch, N, classes): distance row of each voxel's label
+        return torch.sum(rows * flat_probs.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the voxel count of class c in
+        sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).float()
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map s, while the weights come from sample b's own labels.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            distance_map: Wasserstein distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        return torch.sum(alpha_map.unsqueeze(1) * (1.0 - distance_map.unsqueeze(0)), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map s, while the weights come from sample b's own labels.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            distance_map: Wasserstein distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        return torch.sum(alpha_map.unsqueeze(1) * (2.0 - distance_map.unsqueeze(0)), dim=(1, 2))
+
+
 dice = Dice = DiceLoss
