+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(target, num_classes):
+    """Build logits of shape (B, C, spatial...) equal to 1000 times the one-hot of a batched label map."""
+    onehot = F.one_hot(target, num_classes)  # (B, spatial..., C)
+    ndim = onehot.dim()
+    perm = [0, ndim - 1] + list(range(1, ndim - 1))  # move class axis to channel position 1
+    return (onehot.permute(*perm) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        # batched label map, shape (1, 4, 4); inner 2x2 block is class 1
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        correct = one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss(correct, target).item(), 0.0, places=3)
+
+        # same target with an added class-like size-1 axis after the batch axis
+        self.assertAlmostEqual(loss(correct, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        flipped = one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        # all-zero target with two classes; class 1 is absent
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        correct = one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss(correct, target).item(), 0.0, places=3)
+
+        flipped = one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
