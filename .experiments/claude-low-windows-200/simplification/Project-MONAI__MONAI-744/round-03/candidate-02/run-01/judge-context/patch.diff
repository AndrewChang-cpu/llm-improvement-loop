+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def _predict(label, num_classes):
+    """One-hot a batched integer label map (B, H, W), move the class axis to position 1, scale by 1000."""
+    one_hot = F.one_hot(label, num_classes)  # (B, H, W, C)
+    return (one_hot.permute(0, 3, 1, 2) * 1000).float()  # (B, C, H, W)
+
+
+def _binary_target():
+    target = torch.zeros(1, 4, 4, dtype=torch.long)  # batch axis first: (1, 4, 4)
+    target[0, 1:3, 1:3] = 1
+    return target
+
+
+BINARY_TEST_CASES = [
+    [  # correct prediction, target shape (B, H, W)
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _predict(_binary_target(), 2), "target": _binary_target()},
+        0.0,
+    ],
+    [  # correct prediction, target shape (B, 1, H, W)
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _predict(_binary_target(), 2), "target": _binary_target().unsqueeze(1)},
+        0.0,
+    ],
+    [  # flipped prediction
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _predict(1 - _binary_target(), 2), "target": _binary_target()},
+        1.0,
+    ],
+]
+
+EMPTY_TEST_CASES = [
+    [  # all-zero target, correct prediction
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _predict(torch.zeros(1, 4, 4, dtype=torch.long), 2), "target": torch.zeros(1, 4, 4, dtype=torch.long)},
+        0.0,
+    ],
+    [  # all-zero target, flipped prediction
+        {"dist_matrix": DIST_MATRIX},
+        {
+            "input": _predict(torch.ones(1, 4, 4, dtype=torch.long), 2),
+            "target": torch.zeros(1, 4, 4, dtype=torch.long),
+        },
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(BINARY_TEST_CASES)
+    def test_binary_2d(self, input_param, input_data, expected_val):
+        result = GeneralizedWassersteinDiceLoss(**input_param).forward(**input_data)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+    @parameterized.expand(EMPTY_TEST_CASES)
+    def test_empty_class(self, input_param, input_data, expected_val):
+        result = GeneralizedWassersteinDiceLoss(**input_param).forward(**input_data)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
