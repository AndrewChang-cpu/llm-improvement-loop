+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def _prediction_logits(label_map):
+    """
+    Build logits from a batched integer label map of shape (1, H, W):
+    one-hot encode with 2 classes, move the class axis to position 1, then scale by 1000 and cast to float.
+    """
+    onehot = F.one_hot(label_map, 2)  # (1, H, W, 2)
+    return (onehot.permute(0, 3, 1, 2) * 1000).float()  # (1, 2, H, W)
+
+
+def _binary_target():
+    target = torch.zeros((1, 4, 4), dtype=torch.long)
+    target[:, 1:3, 1:3] = 1  # inner 2 by 2 block is label 1
+    return target
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(
+        [
+            [  # shape: (1, 4, 4) target, correct logits
+                {"channel_dim": False, "flip": False},
+                0.0,
+            ],
+            [  # shape: (1, 1, 4, 4) target, correct logits
+                {"channel_dim": True, "flip": False},
+                0.0,
+            ],
+            [  # shape: (1, 4, 4) target, logits of the flipped target
+                {"channel_dim": False, "flip": True},
+                1.0,
+            ],
+        ]
+    )
+    def test_binary_2d(self, input_param, expected_val):
+        target = _binary_target()
+        logits = _prediction_logits(1 - target if input_param["flip"] else target)
+        loss_target = target.unsqueeze(1) if input_param["channel_dim"] else target
+        result = GeneralizedWassersteinDiceLoss(DIST_MATRIX)(logits, loss_target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+    @parameterized.expand(
+        [
+            [  # shape: (1, 4, 4) all-zero target, correct logits
+                {"flip": False},
+                0.0,
+            ],
+            [  # shape: (1, 4, 4) all-zero target, logits of the flipped target
+                {"flip": True},
+                1.0,
+            ],
+        ]
+    )
+    def test_empty_class(self, input_param, expected_val):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        logits = _prediction_logits(1 - target if input_param["flip"] else target)
+        result = GeneralizedWassersteinDiceLoss(DIST_MATRIX)(logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
