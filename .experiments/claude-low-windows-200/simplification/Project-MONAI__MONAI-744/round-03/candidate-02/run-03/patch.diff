+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss in which each voxel's true-positive contribution is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed
+    from a class-distance matrix. The class weights follow the generalized Dice loss, i.e. inverse volume:
+
+        Sudre, C. et al. Generalised Dice overlap as a deep learning loss function for highly unbalanced
+        segmentations. MICCAI DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), as a 2D torch tensor or 2D numpy array,
+                where C is the number of input channels. If its maximum entry is not 1, the whole matrix is
+                divided by that maximum.
+            reduction: the reduction mode, as a ``LossReduction`` member or its string value. Defaults to ``"mean"``.
+                It is stored but does not change the output: the loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction is not a valid ``LossReduction`` value.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_probs: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) for every sample s.
+
+        For voxel v with ground-truth label y_s(v), W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where M is the
+        normalized distance matrix and p_k,s(v) the softmax probability of class k.
+
+        Args:
+            flat_probs: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distances W with shape (batch, N), one distance map per sample.
+        """
+        m = self.m.to(device=flat_probs.device, dtype=flat_probs.dtype)
+        rows = m[flat_target.long()]  # (batch, N, classes): each voxel's distance row, picked by its label
+        return torch.sum(rows * flat_probs.transpose(1, 2), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of sample b whose label is c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights with shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target.long(), self.num_classes), dim=1)  # (batch, classes)
+        return 1.0 / (counts + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, dist_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+
+        The weight uses sample b's own labels and volumes, while the sum runs over every sample's distance
+        map (every s in the batch, including b itself).
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            dist_map: Wasserstein distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target.long()).to(dist_map.dtype)  # (batch, N)
+        return torch.einsum("bn,sn->b", alpha_vox, 1.0 - dist_map)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, dist_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+
+        As in ``compute_generalized_true_positive``, the sum runs over every sample's distance map.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            dist_map: Wasserstein distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target.long()).to(dist_map.dtype)  # (batch, N)
+        return torch.einsum("bn,sn->b", alpha_vox, 2.0 - dist_map)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, shape (batch, classes, spatial dims...). Softmax is applied over the class axis.
+            target: integer class-index labels, shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample loss ``1 - (2 * TP + smooth) / (D + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1).long()
+
+        probs = torch.softmax(flat_input, dim=1)
+        dist_map = self.wasserstein_distance_map(probs, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, dist_map)
+        denominator = self.compute_denominator(alpha, flat_target, dist_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
