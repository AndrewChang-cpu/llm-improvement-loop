+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_prediction(label, num_classes):
+    """One-hot the batched integer label map, move the class axis to channel 1, scale to logits."""
+    onehot = F.one_hot(label, num_classes)  # (B, H, W, C)
+    return (onehot.permute(0, 3, 1, 2) * 1000).float()  # (B, C, H, W)
+
+
+def binary_target():
+    """Batch of one, 4 by 4, inner 2 by 2 block is label 1, rest is label 0."""
+    target = torch.zeros((1, 4, 4), dtype=torch.long)
+    target[:, 1:3, 1:3] = 1
+    return target
+
+
+def empty_target():
+    """Batch of one, 4 by 4, all label 0 (class 1 absent)."""
+    return torch.zeros((1, 4, 4), dtype=torch.long)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = binary_target()
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        # correct logits
+        result = loss(make_prediction(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # same target with an added size-1 class dimension (B, 1, H, W)
+        result = loss(make_prediction(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # flipped logits
+        result = loss(make_prediction(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = empty_target()
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        # correct logits
+        result = loss(make_prediction(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # flipped logits
+        result = loss(make_prediction(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
