+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix.
+    Class weights follow the generalized Dice loss (inverse volume), as in:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+        unbalanced segmentations. DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), with C the number of classes.
+                Accepts a torch tensor or a numpy array. Entries are nonnegative. The matrix is divided
+                by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode. The stored value is passed to the parent loss, but the
+                forward output is always the batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: dist_matrix is not square. Message: "Dist Matrix is invalid."
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if len(dist_matrix.shape) != 2 or dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if dist_matrix.max().item() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N), computed for every sample.
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes): distance row of each voxel's label
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        onehot = F.one_hot(flat_target, self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(onehot, dim=1).to(torch.float32)  # (batch, classes)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, flat_dist_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The weight uses sample b's labels, while the sum runs over every sample's distance map s.
+
+        Args:
+            alpha: class weights, shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels, shape (batch, N).
+            flat_dist_map: distance maps for all samples, shape (batch, N). The sum runs over every
+                sample's distance map.
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha(b, y_b(v))
+        return torch.einsum("bn,sn->b", alpha_map, 1.0 - flat_dist_map)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, flat_dist_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The weight uses sample b's labels, while the sum runs over every sample's distance map s.
+
+        Args:
+            alpha: class weights, shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels, shape (batch, N).
+            flat_dist_map: distance maps for all samples, shape (batch, N). The sum runs over every
+                sample's distance map.
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha(b, y_b(v))
+        return torch.einsum("bn,sn->b", alpha_map, 2.0 - flat_dist_map)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, shape (batch, classes, spatial dims...).
+            target: integer class-index labels, shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of the per-sample loss 1 - (2 TP_b + smooth) / (D_b + smooth).
+        """
+        batch = input.shape[0]
+        proba = torch.softmax(input, 1)
+        flat_proba = proba.reshape(batch, self.num_classes, -1)
+        flat_target = target.reshape(batch, -1)
+
+        dist_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, dist_map)
+        denom = self.compute_denominator(alpha, flat_target, dist_map)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
