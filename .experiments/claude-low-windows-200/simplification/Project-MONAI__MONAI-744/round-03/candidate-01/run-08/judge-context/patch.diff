+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(target, num_classes):
+    """target: batched integer label map, shape (B, H, W). Returns logits of shape (B, C, H, W)."""
+    encoded = F.one_hot(target, num_classes)  # B, H, W, C
+    return (encoded.permute(0, 3, 1, 2) * 1000.0).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        # correct prediction
+        result = loss(one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(float(result), 0.0, places=3)
+
+        # extra size-1 class dimension in the target
+        result = loss(one_hot_logits(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(float(result), 0.0, places=3)
+
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(float(result), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        # correct prediction
+        result = loss(one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(float(result), 0.0, places=3)
+
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(float(result), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
