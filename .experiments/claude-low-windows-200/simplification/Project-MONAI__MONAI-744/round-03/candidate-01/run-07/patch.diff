+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+
+
+def _logits_from_labels(label, num_classes, scale=1000.0):
+    """label: batched integer label map (batch, spatial...). Returns logits (batch, classes, spatial...)."""
+    onehot = F.one_hot(label.long(), num_classes=num_classes)  # (batch, spatial..., classes)
+    onehot = onehot.permute(0, -1, *range(1, label.dim()))  # move class axis to channel position 1
+    return (onehot * scale).float()
+
+
+BINARY_TARGET = torch.zeros((1, 4, 4), dtype=torch.long)
+BINARY_TARGET[:, 1:3, 1:3] = 1
+
+EMPTY_TARGET = torch.zeros((1, 4, 4), dtype=torch.long)
+
+TEST_CASES_BINARY = [
+    [  # correct logits, target shape (1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _logits_from_labels(BINARY_TARGET, 2), "target": BINARY_TARGET},
+        0.0,
+    ],
+    [  # correct logits, target shape (1, 1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _logits_from_labels(BINARY_TARGET, 2), "target": BINARY_TARGET.unsqueeze(1)},
+        0.0,
+    ],
+    [  # flipped logits, target shape (1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _logits_from_labels(1 - BINARY_TARGET, 2), "target": BINARY_TARGET},
+        1.0,
+    ],
+]
+
+TEST_CASES_EMPTY = [
+    [  # correct logits, all-zero target
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _logits_from_labels(EMPTY_TARGET, 2), "target": EMPTY_TARGET},
+        0.0,
+    ],
+    [  # flipped logits, all-zero target
+        {"dist_matrix": DIST_MATRIX},
+        {"input": _logits_from_labels(1 - EMPTY_TARGET, 2), "target": EMPTY_TARGET},
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES_BINARY)
+    def test_binary_2d(self, input_param, input_data, expected_val):
+        result = GeneralizedWassersteinDiceLoss(**input_param).forward(**input_data)
+        np.testing.assert_array_almost_equal(result.detach().cpu().numpy(), expected_val, decimal=3)
+
+    @parameterized.expand(TEST_CASES_EMPTY)
+    def test_empty_class(self, input_param, input_data, expected_val):
+        result = GeneralizedWassersteinDiceLoss(**input_param).forward(**input_data)
+        np.testing.assert_array_almost_equal(result.detach().cpu().numpy(), expected_val, decimal=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
