+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _logits_from_labels(label_map, num_classes):
+    """Batched integer label map (B, spatial...) -> logits (B, C, spatial...) equal to 1000 times one-hot."""
+    onehot = F.one_hot(label_map, num_classes)  # (B, spatial..., C)
+    onehot = onehot.permute(0, -1, *range(1, onehot.dim() - 1))  # class axis to channel position 1
+    return (onehot * 1000).float()
+
+
+_binary_target = torch.zeros((1, 4, 4), dtype=torch.long)
+_binary_target[:, 1:3, 1:3] = 1
+_binary_dist = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+
+_empty_target = torch.zeros((1, 4, 4), dtype=torch.long)
+
+TEST_CASES = [
+    [  # binary 2D, correct logits, target shape (1, 4, 4)
+        {"dist_matrix": _binary_dist},
+        {"input": _logits_from_labels(_binary_target, 2), "target": _binary_target},
+        0.0,
+    ],
+    [  # binary 2D, correct logits, target shape (1, 1, 4, 4)
+        {"dist_matrix": _binary_dist},
+        {"input": _logits_from_labels(_binary_target, 2), "target": _binary_target.unsqueeze(1)},
+        0.0,
+    ],
+    [  # binary 2D, flipped logits, target shape (1, 4, 4)
+        {"dist_matrix": _binary_dist},
+        {"input": _logits_from_labels(1 - _binary_target, 2), "target": _binary_target},
+        1.0,
+    ],
+    [  # binary 2D, flipped logits, target shape (1, 1, 4, 4)
+        {"dist_matrix": _binary_dist},
+        {"input": _logits_from_labels(1 - _binary_target, 2), "target": _binary_target.unsqueeze(1)},
+        1.0,
+    ],
+    [  # empty class, correct logits
+        {"dist_matrix": _binary_dist},
+        {"input": _logits_from_labels(_empty_target, 2), "target": _empty_target},
+        0.0,
+    ],
+    [  # empty class, flipped logits
+        {"dist_matrix": _binary_dist},
+        {"input": _logits_from_labels(1 - _empty_target, 2), "target": _empty_target},
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES)
+    def test_result(self, input_param, input_data, expected_val):
+        result = GeneralizedWassersteinDiceLoss(**input_param).forward(**input_data)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
