+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss in which each voxel's true-positive contribution is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, using a
+    class-distance matrix. The class weighting follows the generalized Dice overlap of:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+        unbalanced segmentations. MICCAI DLMIA 2017.
+
+    Input is raw logits shaped (B, C, spatial...). Target is an integer class-index map shaped (B, spatial...)
+    or (B, 1, spatial...).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                It is divided by its maximum entry when that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode. Stored for the parent class; the loss returned by ``forward``
+                is always the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max().item() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map of every sample: for sample s and voxel v with label y_s(v),
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where M is the normalized distance matrix and p is the softmax
+        probability of class k.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N) for every sample.
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes)
+        return (rows * flat_proba.permute(0, 2, 1)).sum(-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        volumes = F.one_hot(flat_target, self.num_classes).sum(1)  # (batch, classes)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives of each sample b: TP_b = sum over every sample s and voxel v of
+        alpha(b, y_b(v)) * (1 - W_s(v)). The sum runs over every sample's distance map, not only sample b's.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N) for every sample.
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        return (alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)).sum(dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator of each sample b: D_b = sum over every sample s and voxel v of
+        alpha(b, y_b(v)) * (2 - W_s(v)). The sum runs over every sample's distance map, not only sample b's.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N) for every sample.
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        return (alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)).sum(dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (B, C, spatial...).
+            target: integer class-index labels, shape (B, spatial...) or (B, 1, spatial...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, self.num_classes, -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, 1)
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
