+import unittest
+
+import numpy as np
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(label_map, num_classes):
+    """label_map: batched integer label map (B, *spatial). Returns logits (B, C, *spatial) scaled by 1000."""
+    onehot = torch.nn.functional.one_hot(label_map, num_classes)  # (B, *spatial, C)
+    ndim = onehot.dim()
+    perm = [0, ndim - 1] + list(range(1, ndim - 1))  # class axis to channel position 1
+    return (onehot.permute(*perm) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        # correct prediction
+        logits = _one_hot_logits(target, 2)
+        loss = loss_fn(logits, target)
+        self.assertEqual(loss.dim(), 0)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # target with an added size-1 class dimension gives the same result
+        loss = loss_fn(logits, target.unsqueeze(1))
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # flipped prediction
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        loss = loss_fn(flipped_logits, target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        logits = _one_hot_logits(target, 2)
+        loss = loss_fn(logits, target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        loss = loss_fn(flipped_logits, target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
