+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The loss is a Dice-type overlap score in which each voxel's true-positive contribution is
+    discounted by the Wasserstein distance between the predicted class distribution and the
+    ground-truth label, given a class-distance matrix. The class weighting follows generalized
+    Dice (inverse volume), as in:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for
+        highly unbalanced segmentations. DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square matrix of class distances, either a torch tensor or a numpy array.
+                The matrix is divided by its maximum entry when that maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. It is stored and passed
+                to the parent class. The loss returned by ``forward`` is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        m = torch.as_tensor(dist_matrix).float()
+        if m.max().item() != 1:
+            m = m / m.max()
+
+        self.m = m
+        self.num_classes = m.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map of every sample and voxel:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where y_s(v) is the ground-truth label and p_k,s(v) the
+        predicted probability of class k.
+
+        Args:
+            flat_proba: class probabilities, shape (batch, classes, N).
+            flat_target: integer class indices, shape (batch, N).
+
+        Returns:
+            distances for every sample, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target.long()]  # (batch, N, classes)
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the generalized Dice class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class indices, shape (batch, N).
+
+        Returns:
+            alpha weights, shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target.long(), self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives per sample:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)), where the sum runs over every sample's
+        distance map s and every voxel v.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class indices, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target.long())  # (batch, N)
+        return torch.sum(alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator per sample:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)), where the sum runs over every sample's
+        distance map s and every voxel v.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class indices, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target.long())  # (batch, N)
+        return torch.sum(alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial...).
+            target: integer class indices, shape (batch, spatial...) or (batch, 1, spatial...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean of the per-sample losses.
+        """
+        batch = input.shape[0]
+        flat_proba = F.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
