+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The true-positive and denominator terms of each voxel are discounted by the Wasserstein distance between
+    the predicted class distribution and the ground-truth label, using the class-distance matrix `dist_matrix`.
+    The class weighting follows the generalized Dice overlap of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    Input is expected to be logits shaped (B, C, spatial...). Target is an integer class-index map shaped
+    (B, spatial...) or (B, 1, spatial...).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                It is divided by its maximum entry when that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode stored by the loss. Defaults to ``"mean"``.
+                The loss returned by ``forward`` is always the batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance of every voxel of every sample:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where y_s(v) is the ground-truth label and p_k,s(v) the
+        predicted probability of class k.
+
+        Args:
+            flat_proba: probabilities shaped (batch, classes, N).
+            flat_target: integer class-index labels shaped (batch, N).
+
+        Returns:
+            distance map shaped (batch, N), computed for every sample.
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target.long()]  # (batch, N, classes)
+        proba = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(rows * proba, dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels shaped (batch, N).
+
+        Returns:
+            alpha weights shaped (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target.long(), self.num_classes), dim=1)  # (batch, classes)
+        return 1.0 / (counts.to(torch.float) + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives of each sample b:
+        TP_b = sum over every sample s and every voxel v of alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map, not only sample b's.
+
+        Args:
+            alpha: class weights shaped (batch, classes).
+            flat_target: integer class-index labels shaped (batch, N).
+            wasserstein_distance_map: distance maps of all samples shaped (batch, N).
+
+        Returns:
+            one true-positive value per sample, shaped (batch,).
+        """
+        voxel_alpha = torch.gather(alpha, 1, flat_target.long())  # (batch, N)
+        voxel_sum = torch.sum(1.0 - wasserstein_distance_map, dim=0)  # (N,), summed over all samples s
+        return torch.sum(voxel_alpha * voxel_sum.unsqueeze(0), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator of each sample b:
+        D_b = sum over every sample s and every voxel v of alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map, not only sample b's.
+
+        Args:
+            alpha: class weights shaped (batch, classes).
+            flat_target: integer class-index labels shaped (batch, N).
+            wasserstein_distance_map: distance maps of all samples shaped (batch, N).
+
+        Returns:
+            one denominator value per sample, shaped (batch,).
+        """
+        voxel_alpha = torch.gather(alpha, 1, flat_target.long())  # (batch, N)
+        voxel_sum = torch.sum(2.0 - wasserstein_distance_map, dim=0)  # (N,), summed over all samples s
+        return torch.sum(voxel_alpha * voxel_sum.unsqueeze(0), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits shaped (B, C, spatial...).
+            target: integer class-index labels shaped (B, spatial...) or (B, 1, spatial...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor with the batch mean of the per-sample losses.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wd = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wd)
+        denom = self.compute_denominator(alpha, flat_target, wd)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
