+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss. The true-positive contribution of each voxel is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed
+    from the class-distance matrix ``dist_matrix``. The class weights follow the generalized Dice
+    scheme of Sudre et al., Generalised Dice overlap as a deep learning loss function for highly
+    unbalanced segmentations, DLMIA 2017, i.e. the weight of a class is the inverse of its volume.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D, square, non-negative class-distance matrix of shape (C, C), as a torch tensor
+                or a numpy array. It is divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. It is stored and passed
+                to the parent class. The loss returned by ``forward`` is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if float(dist_matrix.max()) != 1.0:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map for every sample and voxel:
+        ``W_s(v) = sum_k M[y_s(v), k] * p_k,s(v)``, where ``y_s(v)`` is the ground-truth label of sample ``s``
+        at voxel ``v``, ``p_k,s(v)`` is the predicted probability of class ``k`` and ``M`` is the distance matrix.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes), distance row of each voxel's label
+        return torch.einsum("bnk,bkn->bn", rows, flat_proba)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights ``alpha(b, c) = 1 / (V(b, c) + 1)``, where ``V(b, c)`` is the number of voxels
+        of sample ``b`` labelled ``c``. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives of each sample:
+        ``TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v))``. The sum runs over every sample's distance map
+        ``W_s``, while the weight uses the labels and volumes of sample ``b``.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), alpha(b, y_b(v))
+        return torch.einsum("bn,sn->b", alpha_map, 1.0 - wasserstein_distance_map)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator of each sample:
+        ``D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v))``. The sum runs over every sample's distance map
+        ``W_s``, while the weight uses the labels and volumes of sample ``b``.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), alpha(b, y_b(v))
+        return torch.einsum("bn,sn->b", alpha_map, 2.0 - wasserstein_distance_map)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape should be BC[spatial dims], where C is the number of classes.
+            target: integer class-index labels, shape should be B[spatial dims] or B1[spatial dims].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean of the per-sample losses over the batch.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, self.num_classes, -1), dim=1)
+        if target.dim() == input.dim() and target.shape[1] == 1:
+            target = target[:, 0]
+        flat_target = target.reshape(batch, -1).long()
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
