+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap loss in which each voxel's true-positive contribution is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label,
+    computed from a class-distance matrix. The class weighting follows the generalized Dice loss
+    (inverse volume) of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is expected to be logits with shape BCS[D][H][W]; the target is an integer class-index
+    label map with shape B1S[D][H][W] or BS[D][H][W].
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix, as a torch tensor or numpy array. Entries are
+                nonnegative. The matrix is divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, stored and passed to the parent loss. Valid options are
+                ``"none"``, ``"mean"`` and ``"sum"``. Defaults to ``"mean"``.
+                The loss returned by ``forward`` is the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_entry = torch.max(dist_matrix)
+        if float(max_entry) != 1.0:
+            dist_matrix = dist_matrix / max_entry
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map for every sample and voxel:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where y_s(v) is the ground-truth label and p_k,s(v) the
+        predicted probability of class k.
+
+        Args:
+            flat_proba: probabilities flattened to shape (batch, classes, N).
+            flat_target: integer class-index labels flattened to shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N), computed for every sample.
+        """
+        m = self.m.to(flat_proba.device)
+        # distance rows selected by each voxel's label, shape (batch, N, classes)
+        dist_rows = m[flat_target]
+        return torch.sum(dist_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number
+        of voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels flattened to shape (batch, N).
+
+        Returns:
+            weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for each sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)), where the sum runs over every sample's
+        distance map s (the batch-wide sum), and alpha uses sample b's labels and volumes.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels flattened to shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N). The sum runs over
+                every sample's distance map.
+
+        Returns:
+            true positives of shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        # per-voxel sum over all samples' distance maps, shape (N,)
+        per_voxel = torch.sum(1.0 - wasserstein_distance_map, dim=0)
+        return torch.sum(alpha_map * per_voxel.unsqueeze(0), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for each sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)), where the sum runs over every sample's
+        distance map s (the batch-wide sum), and alpha uses sample b's labels and volumes.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels flattened to shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N). The sum runs over
+                every sample's distance map.
+
+        Returns:
+            denominators of shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        # per-voxel sum over all samples' distance maps, shape (N,)
+        per_voxel = torch.sum(2.0 - wasserstein_distance_map, dim=0)
+        return torch.sum(alpha_map * per_voxel.unsqueeze(0), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BCS[D][H][W], raw logits.
+            target: the shape should be B1S[D][H][W] or BS[D][H][W], integer class-index labels.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses, as a scalar tensor.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        if target.dim() == input.dim():
+            target = target[:, 0]
+        flat_target = target.reshape(batch, -1)
+
+        wd = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wd)
+        denominator = self.compute_denominator(alpha, flat_target, wd)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
