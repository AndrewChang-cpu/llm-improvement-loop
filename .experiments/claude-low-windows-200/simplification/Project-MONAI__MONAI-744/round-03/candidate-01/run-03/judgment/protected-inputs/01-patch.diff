+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _prediction(label_map, num_classes):
+    """label_map: integer labels with shape (1, H, W). Returns logits (1, num_classes, H, W)."""
+    one_hot = F.one_hot(label_map, num_classes)  # (1, H, W, C)
+    one_hot = one_hot.permute(0, 3, 1, 2)  # class axis to channel position 1
+    return one_hot.float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+
+        loss = GeneralizedWassersteinDiceLoss(dist)
+        # correct prediction
+        result = loss(_prediction(target, 2), target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+        # target with an added size-1 channel dimension
+        result = loss(_prediction(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(_prediction(flipped, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+
+        loss = GeneralizedWassersteinDiceLoss(dist)
+        result = loss(_prediction(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+        result = loss(_prediction(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
