+import unittest
+
+import numpy as np
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(label_map, num_classes, add_channel_dim=False):
+    """Batched integer label map (B, spatial...) -> logits (B, C, spatial...) with values 1000 * one-hot."""
+    onehot = torch.nn.functional.one_hot(label_map, num_classes=num_classes)
+    # move class axis (last) to channel position 1
+    dims = [0, onehot.dim() - 1] + list(range(1, onehot.dim() - 1))
+    logits = onehot.permute(*dims) * 1000.0
+    return logits.float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct prediction
+        logits = _one_hot_logits(target, num_classes=2)
+        self.assertAlmostEqual(loss(logits, target).item(), 0.0, places=3)
+        # same target with an added channel dimension
+        self.assertAlmostEqual(loss(logits, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        # flipped prediction
+        flipped = 1 - target
+        logits_flipped = _one_hot_logits(flipped, num_classes=2)
+        self.assertAlmostEqual(loss(logits_flipped, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        logits = _one_hot_logits(target, num_classes=2)
+        self.assertAlmostEqual(loss(logits, target).item(), 0.0, places=3)
+
+        logits_flipped = _one_hot_logits(1 - target, num_classes=2)
+        self.assertAlmostEqual(loss(logits_flipped, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
