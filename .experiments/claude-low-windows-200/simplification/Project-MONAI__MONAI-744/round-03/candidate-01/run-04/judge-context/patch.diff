+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix. The class
+    weights follow the generalized Dice overlap (inverse volume), as in:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. MICCAI DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square matrix of nonnegative class distances, as a torch tensor or numpy array.
+                The matrix is divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, stored on the parent loss. Valid values are the
+                ``LossReduction`` members or their string values. Defaults to ``"mean"``.
+                The loss returned by ``forward`` is the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_entry = dist_matrix.max()
+        if max_entry != 1:
+            dist_matrix = dist_matrix / max_entry
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W_s(v) = sum_k m[y_s(v), k] * p_k,s(v) for every sample s and voxel v,
+        where y_s(v) is the ground-truth label and p_k,s(v) is the predicted probability of class k.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # (batch, N, classes): distance row of each voxel's ground-truth label
+        rows = m[flat_target]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.to(torch.float) + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum over all samples s and voxels v of
+        alpha(b, y_b(v)) * (1 - W_s(v)). The sum runs over every sample's distance map, not only sample b.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N) for every sample.
+
+        Returns:
+            one true-positive value per sample, of shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        distance_term = torch.sum(1.0 - wasserstein_distance_map, dim=0, keepdim=True)
+        return torch.sum(alpha_map * distance_term, dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum over all samples s and voxels v of
+        alpha(b, y_b(v)) * (2 - W_s(v)). The sum runs over every sample's distance map, not only sample b.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N) for every sample.
+
+        Returns:
+            one denominator value per sample, of shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        distance_term = torch.sum(2.0 - wasserstein_distance_map, dim=0, keepdim=True)
+        return torch.sum(alpha_map * distance_term, dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape (batch, classes, spatial...).
+            target: integer class-index labels of shape (batch, spatial...) or (batch, 1, spatial...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the batch mean of the per-sample losses.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input, dim=1).reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
