+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The per-voxel true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, given a class-distance matrix. The class
+    weighting follows the generalized Dice loss of Sudre et al. (2017), Generalised Dice overlap as a
+    deep learning loss function for highly unbalanced segmentations. DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square, C by C, class-distance matrix as a torch tensor or numpy array.
+                Entries are nonnegative. The matrix is divided by its maximum entry if that maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. It is stored and passed to the
+                parent initializer, but the returned loss is always the batch mean regardless of reduction.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BCH[WD], float logits.
+            target: the shape should be BH[WD] or B1H[WD], integer class indices.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the batch mean of the per-sample loss.
+
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), 1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample in the batch:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: softmax probabilities, shape batch by classes by N.
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            per-voxel distances, shape batch by N.
+
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # rows of the matrix selected by each voxel's label, shape batch by N by classes
+        dist_rows = m[flat_target]
+        return torch.sum(dist_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the generalized Dice class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            per-sample, per-class weights, shape batch by classes.
+
+        """
+        volumes = F.one_hot(flat_target, self.num_classes).sum(1)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: per-voxel distances for all samples, shape batch by N.
+
+        Returns:
+            one true-positive value per sample, shape batch.
+
+        """
+        alpha_vox = alpha.gather(1, flat_target)  # batch by N, weights from each sample's own labels
+        return torch.sum(
+            alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2)
+        )
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: per-voxel distances for all samples, shape batch by N.
+
+        Returns:
+            one denominator value per sample, shape batch.
+
+        """
+        alpha_vox = alpha.gather(1, flat_target)  # batch by N, weights from each sample's own labels
+        return torch.sum(
+            alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2)
+        )
+
+
 dice = Dice = DiceLoss
