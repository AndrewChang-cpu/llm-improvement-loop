+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_prediction(label_map, num_classes):
+    """
+    label_map: integer label map with a leading batch axis, shape (B, H, W).
+    Returns float logits of shape (B, num_classes, H, W): 1000 times the one-hot encoding.
+    """
+    one_hot = F.one_hot(label_map, num_classes)  # (B, H, W, C)
+    one_hot = one_hot.permute(0, 3, 1, 2)  # class axis to channel position 1
+    return (one_hot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # batch axis of size 1
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix)
+
+        for target_var in (target, target.unsqueeze(1)):  # (1, 4, 4) and (1, 1, 4, 4)
+            # correct prediction
+            result = loss(make_prediction(target, 2), target_var)
+            np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+            # flipped prediction
+            flipped = make_prediction(1 - target, 2)
+            result = loss(flipped, target_var)
+            np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all label 0, batch axis of size 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix)
+
+        # correct prediction
+        result = loss(make_prediction(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+        # flipped prediction
+        result = loss(make_prediction(1 - target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
