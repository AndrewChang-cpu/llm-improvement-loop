+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It builds on the generalized Dice overlap of:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for
+        highly unbalanced segmentations. DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label. The class weighting follows the
+    generalized Dice loss (inverse volume). Input is always treated as logits.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                Entries must be nonnegative. It is divided by its maximum if the maximum is not 1.
+            reduction: the reduction mode, stored for API consistency. The returned loss is always the
+                batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if float(dist_matrix.max()) != 1.0:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), for every sample.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: class-index labels of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target.long()]  # (batch, N, classes): row M[y_s(v)] for each voxel
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: class-index labels of shape (batch, N).
+
+        Returns:
+            weights of shape (batch, classes).
+        """
+        one_hot = F.one_hot(flat_target.long(), self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot, dim=1).to(torch.float32)  # (batch, classes)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum over every sample s and voxel v of alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on
+        the whole batch. The weight uses sample b's own labels; the distance term comes from all samples.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N), from wasserstein_distance_map.
+
+        Returns:
+            one true-positive value per sample, of shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target.long())  # (batch, N): alpha(b, y_b(v))
+        # index [b, s, v] = alpha_vox[b, v] * (1 - W_s(v))
+        prod = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(prod, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum over every sample s and voxel v of alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on
+        the whole batch. The weight uses sample b's own labels; the distance term comes from all samples.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from compute_weights_generalized_true_positives.
+            flat_target: class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N), from wasserstein_distance_map.
+
+        Returns:
+            one denominator value per sample, of shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target.long())  # (batch, N): alpha(b, y_b(v))
+        # index [b, s, v] = alpha_vox[b, v] * (2 - W_s(v))
+        prod = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(prod, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits of shape (batch, classes, spatial dims...).
+            target: class-index labels of shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of 1 - (2 * TP_b + smooth) / (D_b + smooth).
+            The reduction setting is not applied here.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+
+        flat_proba = torch.softmax(flat_input, 1)
+        w_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, w_map)
+        denom = self.compute_denominator(alpha, flat_target, w_map)
+
+        per_sample_loss = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(per_sample_loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
