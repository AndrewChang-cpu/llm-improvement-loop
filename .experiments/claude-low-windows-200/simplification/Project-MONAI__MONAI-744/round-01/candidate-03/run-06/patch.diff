+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_prediction(label_map, num_classes, flip=False):
+    """
+    Build logits from a batched integer label map of shape (batch, spatial...).
+    The label map is one-hot encoded, the class axis is moved to channel position 1,
+    and the result is scaled by 1000 and cast to float.
+    """
+    labels = label_map.long()
+    if flip:
+        labels = (num_classes - 1) - labels
+    one_hot = F.one_hot(labels, num_classes)  # (batch, spatial..., classes)
+    dims = [0, one_hot.dim() - 1] + list(range(1, one_hot.dim() - 1))
+    one_hot = one_hot.permute(*dims)  # (batch, classes, spatial...)
+    return (one_hot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # batch axis of size 1
+        target[:, 1:3, 1:3] = 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        # correct prediction
+        pred = make_prediction(target, 2)
+        self.assertEqual(pred.shape, (1, 2, 4, 4))
+        result = loss_fn(pred, target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # same target with an added size-1 class dimension (batch, 1, H, W)
+        target_expanded = target.unsqueeze(1)
+        result = loss_fn(pred, target_expanded)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        pred_flipped = make_prediction(target, 2, flip=True)
+        result = loss_fn(pred_flipped, target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # all label 0, batch axis of size 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        pred = make_prediction(target, 2)
+        result = loss_fn(pred, target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        pred_flipped = make_prediction(target, 2, flip=True)
+        result = loss_fn(pred_flipped, target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
