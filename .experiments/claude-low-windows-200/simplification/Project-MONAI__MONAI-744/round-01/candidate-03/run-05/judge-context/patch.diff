+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_prediction(label_map, num_classes):
+    """
+    Build logits from a batched integer label map of shape (batch, spatial...).
+    One-hot encode, move the class axis (last) to channel position 1, scale by 1000 and cast to float.
+    """
+    one_hot = F.one_hot(label_map.long(), num_classes=num_classes)  # (batch, spatial..., classes)
+    last = one_hot.dim() - 1
+    dims = [0, last] + list(range(1, last))
+    return (one_hot.permute(*dims) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1  # batch axis included: shape (1, 4, 4)
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+        np.testing.assert_allclose(loss(make_prediction(target, 2), target).item(), 0.0, atol=1e-3)
+
+        # same target with an added size-1 channel dimension, prediction layout unchanged
+        np.testing.assert_allclose(
+            loss(make_prediction(target, 2), target.unsqueeze(1)).item(), 0.0, atol=1e-3
+        )
+
+        flipped = 1 - target
+        np.testing.assert_allclose(loss(make_prediction(flipped, 2), target).item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all label 0, batch axis of size 1
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+        np.testing.assert_allclose(loss(make_prediction(target, 2), target).item(), 0.0, atol=1e-3)
+
+        flipped = 1 - target
+        np.testing.assert_allclose(loss(make_prediction(flipped, 2), target).item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
