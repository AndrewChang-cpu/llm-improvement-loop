+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is based on the generalised Dice overlap defined in:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for
+        highly unbalanced segmentations. DLMIA 2017.
+
+    The class weights follow the generalized Dice loss weighting (inverse volume), with
+    ``alpha(b, c) = 1 / (V(b, c) + 1)``. Each voxel's true-positive contribution is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                Entries must be nonnegative. The matrix is divided by its maximum if the maximum is not 1.
+            reduction: the reduction mode, passed to the parent loss class. Valid options are ``"none"``,
+                ``"mean"`` and ``"sum"``. It does not change the returned value: the returned loss is
+                always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_value = dist_matrix.max()
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5):
+        """
+        Args:
+            input: the shape should be BCS[D]H[W], float logits.
+            target: the shape should be B1S[D]H[W] or BS[D]H[W], integer class indices.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            a scalar tensor, the batch mean of the per-sample losses.
+        """
+        batch = input.shape[0]
+        n_classes = input.shape[1]
+
+        flat_proba = torch.softmax(input, 1).reshape(batch, n_classes, -1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        per_sample_score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - per_sample_score)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class labels of shape (batch, N).
+
+        Returns:
+            the distance map of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # rows of the matrix selected by each voxel's label: (batch, N, classes)
+        rows = m[flat_target]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of sample b labelled c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class labels of shape (batch, N).
+
+        Returns:
+            the weights of shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)
+        return 1.0 / (volumes.to(torch.float32) + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum over every sample s in the batch and every voxel v of
+        alpha(b, y_b(v)) * (1 - W_s(v)). The sum runs over every sample's distance map in the batch,
+        so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = alpha.gather(1, flat_target)  # (batch, N)
+        term = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # (batch, batch, N)
+        return torch.sum(term, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum over every sample s in the batch and every voxel v of
+        alpha(b, y_b(v)) * (2 - W_s(v)). The sum runs over every sample's distance map in the batch,
+        so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = alpha.gather(1, flat_target)  # (batch, N)
+        term = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # (batch, batch, N)
+        return torch.sum(term, dim=(1, 2))
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
