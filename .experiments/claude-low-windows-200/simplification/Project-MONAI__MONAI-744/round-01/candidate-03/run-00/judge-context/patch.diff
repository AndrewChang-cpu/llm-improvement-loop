+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_logits(label_map, num_classes):
+    """
+    label_map: batched integer label map, shape (batch, H, W).
+    Returns logits of shape (batch, num_classes, H, W): 1000 times the one-hot encoding.
+    """
+    one_hot = F.one_hot(label_map, num_classes)  # (batch, H, W, num_classes)
+    return (one_hot.permute(0, 3, 1, 2) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_case(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix)
+
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # batch axis, then spatial
+        target[:, 1:3, 1:3] = 1
+        flipped = 1 - target
+
+        # correct prediction
+        result = loss(make_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # same target with an added size-1 channel dimension
+        result = loss(make_logits(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        result = loss(make_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class_case(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix)
+
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all label 0, batch axis of size 1
+        flipped = 1 - target
+
+        # correct prediction
+        result = loss(make_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        result = loss(make_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
