+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground truth label, given by a class-distance matrix. The per-class weighting
+    follows the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+        segmentations. DLMIA 2017.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target is an
+    integer class-index label map with shape BS[WD] or B1S[WD]. The returned loss is the batch mean,
+    regardless of the ``reduction`` setting.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), as a 2D torch tensor or 2D numpy array,
+                where C is the number of classes. Entries must be nonnegative. The matrix is divided by its
+                maximum entry if that maximum is not 1.
+            reduction: the reduction mode of the parent loss class. Valid options are ``"none"``, ``"mean"``
+                and ``"sum"``. Defaults to ``"mean"``. It is stored but does not change the output: the
+                returned loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # each voxel's row of the distance matrix, selected by its label: (batch, N, classes)
+        m_rows = m[flat_target]
+        return torch.sum(m_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            weights of shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes).float(), dim=1)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for every sample b. The sum over s runs over
+        every sample's distance map in the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances W of shape (batch, N) for all samples.
+
+        Returns:
+            one true-positive value per sample, of shape (batch,).
+        """
+        # each sample's weight at every voxel, from its own labels: (batch, N)
+        alpha_vox = torch.gather(alpha, 1, flat_target)
+        # indexed as [b, s, v]
+        prod = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(prod, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for every sample b. The sum over s runs over
+        every sample's distance map in the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances W of shape (batch, N) for all samples.
+
+        Returns:
+            one denominator value per sample, of shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)
+        # indexed as [b, s, v]
+        prod = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(prod, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape (batch, classes, spatial_dims...).
+            target: integer class-index labels of shape (batch, spatial_dims...) or (batch, 1, spatial_dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the scalar mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positives = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * true_positives + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
