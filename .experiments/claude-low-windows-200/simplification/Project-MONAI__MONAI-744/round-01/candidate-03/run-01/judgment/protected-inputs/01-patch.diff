+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It combines the Wasserstein distance between the predicted class distribution and the ground-truth
+    label (computed from a class-distance matrix) with the generalized Dice overlap of
+    Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+    segmentations. DLMIA 2017. The class weighting follows the generalized Dice loss (inverse volume).
+
+    The input is always treated as logits; softmax is applied over the class dimension.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array,
+                with nonnegative entries. It is divided by its maximum if the maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}, stored with the loss.
+                The returned loss is always the batch mean, regardless of the reduction setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix).item() != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: class-index labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances for every sample, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # distance row of each voxel's ground-truth label, shape (batch, N, classes)
+        rows = m[flat_target]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: class-index labels, shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights, shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for every sample b.
+        The sum over s runs over every sample's distance map in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances of all samples, shape (batch, N).
+
+        Returns:
+            one generalized true positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weights from each sample's own labels
+        return torch.sum(alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0)), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for every sample b.
+        The sum over s runs over every sample's distance map in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weights from each sample's own labels
+        return torch.sum(alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0)), dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, shape (batch, classes, spatial dims...).
+            target: class-index labels, shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses, as a scalar tensor.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input, 1).reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denom = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
