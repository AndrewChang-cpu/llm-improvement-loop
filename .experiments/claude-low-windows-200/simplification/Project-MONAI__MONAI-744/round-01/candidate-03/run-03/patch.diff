+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses.dice import GeneralizedWassersteinDiceLoss
+
+
+def make_prediction(label, num_classes):
+    """
+    label: batched integer label map, shape (B, H, W). Returns logits of shape (B, C, H, W).
+    """
+    one_hot = F.one_hot(label.long(), num_classes=num_classes)  # (B, H, W, C)
+    one_hot = one_hot.permute(0, 3, 1, 2)  # class axis moved to channel position 1
+    return (one_hot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1  # inner 2x2 block is label 1
+        target_channel = target.unsqueeze(1)  # (1, 1, 4, 4)
+
+        # correct predictions
+        pred = make_prediction(target, 2)
+        self.assertAlmostEqual(loss(pred, target).item(), 0.0, places=3)
+        self.assertAlmostEqual(loss(pred, target_channel).item(), 0.0, places=3)
+
+        # flipped predictions
+        flipped = make_prediction(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+        self.assertAlmostEqual(loss(flipped, target_channel).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all label 0, class 1 is empty
+
+        pred = make_prediction(target, 2)
+        self.assertAlmostEqual(loss(pred, target).item(), 0.0, places=3)
+
+        flipped = make_prediction(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
