+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def make_prediction(target, num_classes):
+    """Logits = 1000 * one-hot(target), class axis moved to channel position 1. target has a leading batch axis."""
+    one_hot = F.one_hot(target.long(), num_classes)  # (B, H, W, C)
+    one_hot = one_hot.permute(0, 3, 1, 2)  # (B, C, H, W)
+    return (one_hot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        # batch 1; inner 2x2 block labelled 1, rest 0
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        pred = make_prediction(target, 2)
+        self.assertAlmostEqual(loss(pred, target).item(), 0.0, places=3)
+        # the same target with an added size-1 class dimension
+        self.assertAlmostEqual(loss(pred, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        flipped_pred = make_prediction(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped_pred, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        # batch 1; all-zero target, so class 1 is absent
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        pred = make_prediction(target, 2)
+        self.assertAlmostEqual(loss(pred, target).item(), 0.0, places=3)
+
+        flipped_pred = make_prediction(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped_pred, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
