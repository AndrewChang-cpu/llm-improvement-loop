+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap score in which each voxel's true-positive contribution is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed from a
+    class-distance matrix. The per-class weighting follows the generalized Dice loss (Sudre et al., Generalised
+    Dice overlap as a deep learning loss function for highly unbalanced segmentations, DLMIA 2017), i.e. inverse
+    volume weights.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target is an integer
+    class-index map with a leading batch axis, shape ``B[1]S``, where ``S`` are the spatial dimensions.
+    """
+
+    def __init__(self, dist_matrix, reduction: Union[LossReduction, str] = LossReduction.MEAN) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), where C is the number of classes. Accepts
+                a 2D torch tensor or a 2D numpy array with nonnegative entries. It is max-normalized if its maximum
+                is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode passed to the parent class. Defaults to ``"mean"``. The returned loss
+                is always the batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+            ValueError: Dist Matrix is invalid.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample. For sample s and voxel v with label y_s(v),
+        W_s(v) = sum_k m[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities flattened to shape (batch, classes, N).
+            flat_target: integer labels flattened to shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        m_rows = m[flat_target]  # (batch, N, classes): each voxel's row of m chosen by its label
+        proba = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return (m_rows * proba).sum(-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels of class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer labels flattened to shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = F.one_hot(flat_target, self.num_classes).sum(1)  # (batch, classes) volumes
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer labels flattened to shape (batch, N).
+            wasserstein_distance_map: distance maps of shape (batch, N) for all samples.
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        dist_sum = (1.0 - wasserstein_distance_map).sum(0)  # (N,), summed over every sample s
+        return (alpha_vox * dist_sum.unsqueeze(0)).sum(1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer labels flattened to shape (batch, N).
+            wasserstein_distance_map: distance maps of shape (batch, N) for all samples.
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        dist_sum = (2.0 - wasserstein_distance_map).sum(0)  # (N,), summed over every sample s
+        return (alpha_vox * dist_sum.unsqueeze(0)).sum(1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial dimensions...).
+            target: integer class indices, shape (batch, spatial dimensions...) or (batch, 1, spatial dimensions...).
+            smooth: a small constant added to numerator and denominator to avoid division by zero.
+
+        Returns:
+            scalar loss, the batch mean of the per-sample losses (reduction is not applied).
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input, 1).reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denom = self.compute_denominator(alpha, flat_target, wdm)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
