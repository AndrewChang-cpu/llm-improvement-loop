+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss. Each voxel's true-positive contribution is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed with a
+    class-distance matrix. Class weights follow the generalized Dice loss (inverse volume). Defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The class weighting follows the generalized Dice loss:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target is an integer
+    label map with a leading batch axis, shape ``B[, 1], spatial dims``.
+    """
+
+    def __init__(
+        self, dist_matrix: Union[np.ndarray, torch.Tensor], reduction: Union[LossReduction, str] = LossReduction.MEAN
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                Entries must be nonnegative. If its maximum is not 1, the matrix is divided by its maximum.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``} the reduction mode. Defaults to ``"mean"``.
+                The returned loss is always the batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample:
+        W_s(v) = sum_k m[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            Wasserstein distance map, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's row of m chosen by its label
+        return (rows * flat_proba.transpose(1, 2)).sum(-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels in sample b labeled c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights, shape (batch, classes).
+        """
+        volumes = F.one_hot(flat_target, self.num_classes).sum(1)  # (batch, classes)
+        return 1.0 / (volumes.to(torch.float) + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for each sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The weight uses sample b's labels; the sum over s runs over every sample's distance map in the batch,
+        so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance map for all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        summed_over_s = (1.0 - wasserstein_distance_map).sum(0)  # (N,), summed over every sample s
+        return (alpha_map * summed_over_s.unsqueeze(0)).sum(1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for each sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance map for all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        summed_over_s = (2.0 - wasserstein_distance_map).sum(0)  # (N,), summed over every sample s
+        return (alpha_map * summed_over_s.unsqueeze(0)).sum(1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape BCS[D][H][W] (batch, classes, then spatial dimensions).
+            target: integer class-index labels, shape B[1]S[D][H][W] (batch, optional size-1 axis, spatial dims).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar loss: the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+        flat_proba = torch.softmax(flat_input, 1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
