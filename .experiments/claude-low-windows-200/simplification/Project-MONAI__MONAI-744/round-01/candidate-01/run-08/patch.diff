+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_prediction(batched_target, num_classes):
+    """Logits equal to 1000 times the one-hot of a batched integer label map, class axis at channel position 1."""
+    one_hot = F.one_hot(batched_target, num_classes)  # (B, spatial..., C)
+    ndim = one_hot.dim()
+    dims = [0, ndim - 1] + list(range(1, ndim - 1))
+    return (one_hot.permute(*dims) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # batch axis of size 1
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(DIST_MATRIX)
+
+        # correct prediction, with and without a size-1 class dimension in the target
+        pred = make_prediction(target, 2)
+        self.assertAlmostEqual(loss(pred, target).item(), 0.0, places=3)
+        self.assertAlmostEqual(loss(pred, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        # flipped prediction
+        flipped_pred = make_prediction(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped_pred, target).item(), 1.0, places=3)
+        self.assertAlmostEqual(loss(flipped_pred, target.unsqueeze(1)).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all voxels in class 0; class 1 is empty
+        loss = GeneralizedWassersteinDiceLoss(DIST_MATRIX)
+
+        pred = make_prediction(target, 2)
+        self.assertAlmostEqual(loss(pred, target).item(), 0.0, places=3)
+
+        flipped_pred = make_prediction(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped_pred, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
