+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_logits(label_map, num_classes):
+    """label_map: batched integer labels, shape (batch, spatial...). Returns logits (batch, classes, spatial...)."""
+    one_hot = F.one_hot(label_map.long(), num_classes).float()  # class axis last
+    dims = [0, one_hot.dim() - 1] + list(range(1, one_hot.dim() - 1))  # move class axis to channel position 1
+    return one_hot.permute(*dims) * 1000.0
+
+
+def make_target(label_map, add_channel):
+    """Optionally insert a size-1 channel axis after the batch axis."""
+    if add_channel:
+        return label_map.unsqueeze(1)
+    return label_map
+
+
+TARGET = torch.zeros(1, 4, 4, dtype=torch.long)
+TARGET[:, 1:3, 1:3] = 1
+EMPTY_TARGET = torch.zeros(1, 4, 4, dtype=torch.long)
+
+TEST_CASES = [
+    [{"add_channel": False}],
+    [{"add_channel": True}],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES)
+    def test_binary_2d(self, params):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        target = make_target(TARGET, params["add_channel"])
+
+        result = loss(make_logits(TARGET, 2), target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        flipped = 1 - TARGET
+        result = loss(make_logits(flipped, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    @parameterized.expand(TEST_CASES)
+    def test_empty_class(self, params):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        target = make_target(EMPTY_TARGET, params["add_channel"])
+
+        result = loss(make_logits(EMPTY_TARGET, 2), target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        flipped = 1 - EMPTY_TARGET
+        result = loss(make_logits(flipped, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
