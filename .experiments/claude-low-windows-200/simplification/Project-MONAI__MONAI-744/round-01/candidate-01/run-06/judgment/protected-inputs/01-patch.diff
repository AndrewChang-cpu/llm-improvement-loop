+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix. The class
+    weighting follows the generalized Dice loss (Sudre, C. et. al. (2017) Generalised Dice overlap as a
+    deep learning loss function for highly unbalanced segmentations. DLMIA 2017), i.e. inverse volume.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                Entries are nonnegative. It is divided by its maximum if the maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. Defaults to ``"mean"``.
+                It is stored but does not change the output: the returned loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if len(dist_matrix.shape) != 2 or dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k m[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes): row of m selected by each voxel's label
+        probs = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return (rows * probs).sum(dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        in sample b labeled c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        counts = F.one_hot(flat_target, self.num_classes).sum(dim=1)  # (batch, classes)
+        return 1.0 / (counts.to(torch.float) + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum over all samples s and voxels v of alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of sample b at each voxel
+        one_minus_w = 1.0 - wasserstein_distance_map  # (batch, N): indexed by sample s
+        # broadcast to (b, s, N), then sum over s and voxels
+        return (alpha_vox.unsqueeze(1) * one_minus_w.unsqueeze(0)).sum(dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum over all samples s and voxels v of alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of sample b at each voxel
+        two_minus_w = 2.0 - wasserstein_distance_map  # (batch, N): indexed by sample s
+        # broadcast to (b, s, N), then sum over s and voxels
+        return (alpha_vox.unsqueeze(1) * two_minus_w.unsqueeze(0)).sum(dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial dims...).
+            target: integer class-index labels, shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the batch mean of the per-sample loss, regardless of ``reduction``.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)  # (batch, classes, N)
+        flat_target = target.reshape(batch, -1)  # (batch, N)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denom = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
