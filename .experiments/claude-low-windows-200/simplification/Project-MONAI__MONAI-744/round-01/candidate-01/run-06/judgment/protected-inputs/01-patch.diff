+import unittest
+
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(target, num_classes):
+    """target: integer label map with a leading batch axis, shape (B, *spatial). Returns (B, C, *spatial) logits."""
+    onehot = F.one_hot(target.long(), num_classes)  # (B, *spatial, C)
+    ndim = onehot.dim()
+    onehot = onehot.permute(0, ndim - 1, *range(1, ndim - 1))  # class axis to channel position 1
+    return onehot.float() * 1000.0
+
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1  # inner 2x2 block labeled 1, batch axis of size 1
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        result = loss(one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # same target with an added size-1 class dimension
+        result = loss(one_hot_logits(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # logits of the flipped target
+        flipped = 1 - target
+        result = loss(one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # all class 0, batch axis of size 1
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        result = loss(one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        flipped = 1 - target
+        result = loss(one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
