+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_prediction(target, num_classes=2, flip=False):
+    """
+    Build logits from a batched integer label map of shape (batch, spatial dims...).
+    The one-hot class axis is moved to channel position 1 and scaled by 1000.
+    """
+    labels = target.long()
+    if flip:
+        labels = (num_classes - 1) - labels
+    onehot = F.one_hot(labels, num_classes)  # (batch, spatial..., classes)
+    dims = [0, onehot.dim() - 1] + list(range(1, onehot.dim() - 1))
+    return (onehot.permute(*dims) * 1000).float()  # (batch, classes, spatial...)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(make_prediction(target), target)
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        target_cls = target.unsqueeze(1)  # (batch, 1, H, W)
+        result_cls = loss(make_prediction(target), target_cls)
+        np.testing.assert_allclose(result_cls.item(), 0.0, atol=1e-3)
+
+        result_flip = loss(make_prediction(target, flip=True), target)
+        np.testing.assert_allclose(result_flip.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(make_prediction(target), target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        result_flip = loss(make_prediction(target, flip=True), target)
+        np.testing.assert_allclose(result_flip.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
