+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss, a Dice-type overlap score in which each voxel's
+    true-positive contribution is discounted by a Wasserstein distance between the predicted class
+    distribution and the ground-truth label, using a class-distance matrix. The class weighting follows
+    the generalized Dice loss (inverse volume). Defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The class weighting follows the generalized Dice loss, as in:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The true-positive and denominator terms couple samples: for each sample b, the sum runs over the
+    distance maps of every sample s in the batch. This is the reference behavior and is kept for parity.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                Entries must be nonnegative. It is max-normalized if its maximum is not 1.
+            reduction: the reduction mode, stored on the loss. The returned loss is always the batch mean,
+                regardless of this setting. Defaults to ``"mean"``.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k m[y_s(v), k] * p_k,s(v) for every sample.
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            Wasserstein distance map of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # each voxel's row of m, selected by its label: shape (batch, N, classes)
+        m_rows = m[flat_target.long()]
+        return torch.sum(m_rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        onehot_target = F.one_hot(flat_target.long(), self.num_classes).to(torch.float32)
+        volumes = torch.sum(onehot_target, dim=1)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for each sample b.
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for every sample, shape (batch, N).
+
+        Returns:
+            one generalized true-positive value per sample, shape (batch,).
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target.long())  # (batch, N), uses sample b's own labels
+        summed_over_samples = torch.sum(1.0 - wasserstein_distance_map, dim=0)  # (N,), sums over every s
+        return torch.sum(alpha_voxel * summed_over_samples.unsqueeze(0), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for each sample b.
+        The sum runs over every sample's distance map in the batch, so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps for every sample, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target.long())  # (batch, N), uses sample b's own labels
+        summed_over_samples = torch.sum(2.0 - wasserstein_distance_map, dim=0)  # (N,), sums over every s
+        return torch.sum(alpha_voxel * summed_over_samples.unsqueeze(0), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial dims...).
+            target: integer class-index labels, shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_proba = F.softmax(input.reshape(batch, self.num_classes, -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
