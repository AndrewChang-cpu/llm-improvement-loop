+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The per-voxel true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix. The class
+    weighting follows the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target is
+    an integer class-index map with a leading batch axis, shape (B, *spatial) or (B, 1, *spatial).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), as a 2D torch tensor or 2D numpy array.
+                Entries are nonnegative. It is max-normalized if its maximum is not 1.
+            reduction: the reduction mode, as a ``LossReduction`` member or its string value.
+                It is stored and passed to the parent class, but the returned loss is always the batch mean
+                regardless of this setting. Defaults to ``"mean"``.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max().item() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map for every sample in the batch:
+        W_s(v) = sum_k m[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N), one row per sample.
+        """
+        m = self.m.to(flat_proba.device)
+        # each voxel's row of m, selected by its ground-truth label: shape (batch, N, classes)
+        m_rows = m[flat_target]
+        return torch.sum(m_rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the generalized Dice class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number
+        of voxels in sample b labelled c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each value depends on the
+        whole batch (cross-sample coupling).
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N) for every sample.
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weight from each sample's own labels
+        products = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))  # (b, s, N)
+        return torch.sum(products, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each value depends on the
+        whole batch (cross-sample coupling).
+
+        Args:
+            alpha: class weights of shape (batch, classes), from ``compute_weights_generalized_true_positives``.
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances of shape (batch, N) for every sample.
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weight from each sample's own labels
+        products = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))  # (b, s, N)
+        return torch.sum(products, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape (batch, classes, *spatial).
+            target: integer class-index labels of shape (batch, *spatial) or (batch, 1, *spatial).
+            smooth: a small constant added to numerator and denominator to avoid division by zero.
+
+        Returns:
+            scalar loss, the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input, dim=1).reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        w_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, w_map)
+        denom = self.compute_denominator(alpha, flat_target, w_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
