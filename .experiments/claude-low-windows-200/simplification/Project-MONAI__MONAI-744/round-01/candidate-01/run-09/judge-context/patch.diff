+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix. The per-class
+    weighting follows the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+        unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits; softmax is applied over the class dimension.
+    """
+
+    def __init__(self, dist_matrix, reduction: Union[LossReduction, str] = LossReduction.MEAN) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), with C the number of classes.
+                Entries are nonnegative. Accepts a 2D torch tensor or a 2D numpy array. The matrix is
+                divided by its maximum entry unless that maximum is already 1.
+            reduction: the reduction mode. Defaults to ``"mean"``. It is stored and passed to the parent,
+                but the returned loss is always the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. (dist_matrix is not square)
+            ValueError: reduction is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, shape BCS[...]: batch, classes, then zero or more spatial dimensions.
+            target: integer class-index labels, shape BS[...] or B1S[...].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample loss.
+
+        """
+        num_batch = input.shape[0]
+        flat_proba = torch.softmax(input, 1).reshape(num_batch, input.shape[1], -1)
+        flat_target = target.reshape(num_batch, -1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denominator = self.compute_denominator(alpha, flat_target, wdm)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample. For sample s and voxel v with label y,
+        W_s(v) = sum_k m[y, k] * p_k(v), where p is the softmax probability.
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distances for every sample and voxel, shape (batch, N).
+
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's row of m selected by its label
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        in sample b labeled c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights, shape (batch, classes).
+
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each value depends on the
+        whole batch. The weight uses sample b's own labels; the distance term comes from all samples.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances for every sample, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        voxel_term = torch.sum(1.0 - wasserstein_distance_map, dim=0)  # (N,), summed over every sample s
+        return torch.sum(alpha_voxel * voxel_term.unsqueeze(0), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each value depends on the
+        whole batch. The weight uses sample b's own labels; the distance term comes from all samples.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances for every sample, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        voxel_term = torch.sum(2.0 - wasserstein_distance_map, dim=0)  # (N,), summed over every sample s
+        return torch.sum(alpha_voxel * voxel_term.unsqueeze(0), dim=1)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
