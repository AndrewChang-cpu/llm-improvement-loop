+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @staticmethod
+    def make_target(batched_label_map):
+        """Batched integer label map of shape (1, H, W), with a leading batch axis of size 1."""
+        return batched_label_map
+
+    @staticmethod
+    def make_prediction(batched_label_map, num_classes=2):
+        """
+        One-hot encode the batched label map, move the class axis to channel position 1,
+        then scale by 1000 to give near-certain logits of shape (batch, classes, H, W).
+        """
+        one_hot = F.one_hot(batched_label_map, num_classes)  # (batch, H, W, classes)
+        one_hot = one_hot.permute(0, 3, 1, 2)  # (batch, classes, H, W)
+        return one_hot.float() * 1000.0
+
+    @staticmethod
+    def make_dist_matrix():
+        return torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        label = torch.zeros((1, 4, 4), dtype=torch.long)
+        label[:, 1:3, 1:3] = 1
+        flipped = 1 - label
+        loss = GeneralizedWassersteinDiceLoss(self.make_dist_matrix())
+
+        # correct prediction
+        result = loss(self.make_prediction(self.make_target(label)), self.make_target(label))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # class-dimension target variant: (batch, 1, H, W), prediction layout unchanged
+        result = loss(self.make_prediction(label), label.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        result = loss(self.make_prediction(self.make_target(flipped)), self.make_target(label))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        label = torch.zeros((1, 4, 4), dtype=torch.long)
+        flipped = 1 - label
+        loss = GeneralizedWassersteinDiceLoss(self.make_dist_matrix())
+
+        result = loss(self.make_prediction(label), label)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        result = loss(self.make_prediction(flipped), label)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
