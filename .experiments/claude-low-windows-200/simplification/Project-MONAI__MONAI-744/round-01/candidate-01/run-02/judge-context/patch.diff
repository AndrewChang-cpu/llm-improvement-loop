+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It extends the generalized Dice overlap of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. MICCAI DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground-truth label, computed from the class-distance matrix `dist_matrix`.
+    The class weights follow the generalized Dice loss weighting (inverse volume, see
+    `compute_weights_generalized_true_positives`).
+    The input is always treated as logits (softmax is applied over the class dimension).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), with C the number of classes.
+                Accepts a 2D torch tensor or a 2D numpy array. It is max-normalized if its maximum is not 1.
+            reduction: the reduction mode name, e.g. ``"mean"``. Defaults to ``"mean"``. It is stored,
+                but the returned loss is always the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max().item() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape should be BC[spatial dims].
+            target: integer class-index labels, shape should be B[spatial dims] or B1[spatial dims].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample losses.
+
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input, 1).reshape(batch, input.shape[1], -1)  # B, C, N
+        flat_target = target.reshape(batch, -1)  # B, N
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)  # B, N
+        alpha = self.compute_weights_generalized_true_positives(flat_target)  # B, C
+
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)  # B
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)  # B
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        loss = 1.0 - score  # per-sample losses, B
+        return torch.mean(loss)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample. For sample s and voxel v with label y_s(v):
+        W_s(v) = sum_k m[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities flattened to shape (batch, classes, N).
+            flat_target: integer labels flattened to shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N).
+
+        """
+        rows = self.m.to(flat_proba.device)[flat_target]  # B, N, C: row of m chosen by each voxel's label
+        return torch.sum(rows * flat_proba.transpose(1, 2), dim=2)  # B, N
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer labels flattened to shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)  # B, C
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch,
+        so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer labels flattened to shape (batch, N).
+            wasserstein_distance_map: distances for every sample, shape (batch, N).
+
+        Returns:
+            one true positive per sample, shape (batch,).
+
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # B, N: alpha of each voxel's own label
+        return torch.einsum("bv,sv->b", alpha_voxel, 1.0 - wasserstein_distance_map)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch,
+        so each value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer labels flattened to shape (batch, N).
+            wasserstein_distance_map: distances for every sample, shape (batch, N).
+
+        Returns:
+            one denominator per sample, shape (batch,).
+
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # B, N: alpha of each voxel's own label
+        return torch.einsum("bv,sv->b", alpha_voxel, 2.0 - wasserstein_distance_map)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
