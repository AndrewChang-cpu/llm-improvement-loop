+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_prediction(target, num_classes=2, scale=1000.0):
+    """target: batched integer label map (B, *spatial). Returns logits (B, C, *spatial)."""
+    one_hot = F.one_hot(target, num_classes)  # B, *spatial, C
+    one_hot = one_hot.permute(0, -1, *range(1, one_hot.dim() - 1))  # B, C, *spatial
+    return (one_hot * scale).float()
+
+
+def make_target(batch_target, add_channel=False):
+    """batch_target: batched integer label map (B, *spatial). Optionally insert a size-1 axis after batch."""
+    if add_channel:
+        return batch_target.unsqueeze(1)
+    return batch_target
+
+
+TEST_CASES = [
+    [  # binary 2D, correct prediction, target shape (1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": "block", "flip": False, "add_channel": False},
+        0.0,
+    ],
+    [  # binary 2D, correct prediction, target shape (1, 1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": "block", "flip": False, "add_channel": True},
+        0.0,
+    ],
+    [  # binary 2D, flipped (fully wrong) prediction
+        {"dist_matrix": DIST_MATRIX},
+        {"target": "block", "flip": True, "add_channel": False},
+        1.0,
+    ],
+    [  # binary 2D, flipped (fully wrong) prediction, target shape (1, 1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": "block", "flip": True, "add_channel": True},
+        1.0,
+    ],
+]
+
+EMPTY_CLASS_CASES = [
+    [  # all-zero target, correct prediction
+        {"dist_matrix": DIST_MATRIX},
+        {"flip": False, "add_channel": False},
+        0.0,
+    ],
+    [  # all-zero target, flipped prediction
+        {"dist_matrix": DIST_MATRIX},
+        {"flip": True, "add_channel": False},
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES)
+    def test_binary_2d(self, init_params, case, expected):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1  # inner 2x2 block labeled 1
+        if case["flip"]:
+            logit_target = 1 - target
+        else:
+            logit_target = target
+        logits = make_prediction(logit_target)
+        loss_fn = GeneralizedWassersteinDiceLoss(**init_params)
+        result = loss_fn(logits, make_target(target, case["add_channel"]))
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.item(), expected, atol=1e-3)
+
+    @parameterized.expand(EMPTY_CLASS_CASES)
+    def test_empty_class(self, init_params, case, expected):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # no voxels of class 1
+        if case["flip"]:
+            logit_target = 1 - target
+        else:
+            logit_target = target
+        logits = make_prediction(logit_target)
+        loss_fn = GeneralizedWassersteinDiceLoss(**init_params)
+        result = loss_fn(logits, make_target(target, case["add_channel"]))
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.item(), expected, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
