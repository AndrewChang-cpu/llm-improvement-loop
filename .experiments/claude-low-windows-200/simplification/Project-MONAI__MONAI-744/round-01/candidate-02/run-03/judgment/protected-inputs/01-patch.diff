+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The true-positive and denominator terms of the generalized Dice overlap (Sudre, C. et. al. (2017)
+    Generalised Dice overlap as a deep learning loss function for highly unbalanced segmentations.
+    DLMIA 2017) are discounted per voxel by a Wasserstein distance between the predicted class
+    distribution and the ground-truth label, given by a class-distance matrix. The class weighting
+    follows the generalized Dice loss (inverse volume of each class).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of size C by C, where C is the number of classes.
+                Can be a torch tensor or a numpy array. The matrix is divided by its maximum entry if that
+                maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode. It is stored and passed to the parent class, but the forward
+                method always returns the batch mean of the per-sample losses, regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_value = torch.max(dist_matrix)
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            Wasserstein distances, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # each voxel selects the row of M given by its label: shape (batch, N, classes)
+        rows = m[flat_target]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights, shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, not only sample b's own map.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances for all samples, shape (batch, N).
+
+        Returns:
+            one true positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weights of each sample's own labels
+        # (b, s, v) combinations: alpha_map[b, v] * (1 - W[s, v]), summed over s and v
+        terms = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(terms, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, not only sample b's own map.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distances for all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weights of each sample's own labels
+        # (b, s, v) combinations: alpha_map[b, v] * (2 - W[s, v]), summed over s and v
+        terms = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(terms, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: float logits, shape (batch, classes, spatial dimensions...).
+            target: integer class-index labels, shape (batch, spatial...) or (batch, 1, spatial...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the batch mean of the per-sample losses (independent of the reduction setting).
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, self.num_classes, -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+
+        true_positive = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * true_positive + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
