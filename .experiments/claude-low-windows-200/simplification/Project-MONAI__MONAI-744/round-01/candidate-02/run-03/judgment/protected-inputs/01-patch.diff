+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def class_first_logits(batched_label_map, num_classes):
+    """
+    batched_label_map: integer labels with a leading batch axis, shape (B, H, W).
+    Returns float logits of shape (B, num_classes, H, W): 1000 times the one-hot encoding.
+    """
+    one_hot = F.one_hot(batched_label_map, num_classes=num_classes)  # (B, H, W, C)
+    return (one_hot.permute(0, 3, 1, 2) * 1000).float()  # (B, C, H, W)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1  # inner 2 by 2 block is label 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct prediction
+        logits = class_first_logits(target, 2)
+        result = loss(logits, target)
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # same target with an added size-1 channel dimension
+        result = loss(logits, target.unsqueeze(1))
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(class_first_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)  # batch axis 1, class 1 absent
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct prediction
+        result = loss(class_first_logits(target, 2), target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(class_first_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
