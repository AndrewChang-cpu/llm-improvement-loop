+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def logits_from_labels(labels, num_classes=2):
+    """
+    labels: integer label map with a leading batch axis, shape (1, H, W).
+    Returns class-first logits, shape (1, num_classes, H, W), scaled by 1000.
+    """
+    onehot = F.one_hot(labels, num_classes)  # (1, H, W, num_classes)
+    onehot = onehot.permute(0, 3, 1, 2)  # class axis to channel position 1
+    return (onehot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        flipped = 1 - target
+
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct logits
+        loss = loss_fn(logits_from_labels(target), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # same target with an added size-1 class dimension
+        loss = loss_fn(logits_from_labels(target), target.unsqueeze(1))
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # logits predicting the flipped target
+        loss = loss_fn(logits_from_labels(flipped), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        flipped = 1 - target
+
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        loss = loss_fn(logits_from_labels(target), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        loss = loss_fn(logits_from_labels(flipped), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
