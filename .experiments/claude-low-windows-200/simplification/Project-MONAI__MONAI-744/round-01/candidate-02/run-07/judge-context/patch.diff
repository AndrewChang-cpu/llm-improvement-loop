+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def _one_hot_logits(target, num_classes):
+    """target: integer label map of shape (1, H, W). Returns logits of shape (1, num_classes, H, W)."""
+    one_hot = F.one_hot(target, num_classes=num_classes)  # (1, H, W, num_classes)
+    return (one_hot.permute(0, 3, 1, 2) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = _one_hot_logits(target, 2)
+        loss = loss_fn(logits, target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # same target with an added size-1 class-dimension axis; prediction layout unchanged
+        loss = loss_fn(logits, target.unsqueeze(1))
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # logits from the flipped target
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        loss = loss_fn(flipped_logits, target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = _one_hot_logits(target, 2)
+        loss = loss_fn(logits, target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        loss = loss_fn(flipped_logits, target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
