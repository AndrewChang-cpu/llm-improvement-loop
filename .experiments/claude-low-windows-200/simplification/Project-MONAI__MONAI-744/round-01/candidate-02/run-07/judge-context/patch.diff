+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalization of the Generalized Dice loss (Sudre, C. et al., Generalised Dice overlap as a deep
+    learning loss function for highly unbalanced segmentations, MICCAI DLMIA 2017). Each voxel's true-positive
+    contribution is discounted by a Wasserstein distance between the predicted class distribution and the
+    ground-truth label, computed from a class-distance matrix. The class weighting follows the generalized Dice
+    loss (inverse volume).
+
+    Input is raw logits of shape BCS[D][H][W] and target is an integer class-index label map of shape
+    B1S[D][H][W] or BS[D][H][W].
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D, square, non-negative class-distance matrix of size C by C, where C is the number of
+                classes. May be a torch tensor or a numpy array. If its maximum entry is not 1, the whole matrix
+                is divided by that maximum.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode. It is stored and passed to the parent loss. The returned loss is
+                always the batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_entry = torch.max(dist_matrix)
+        if max_entry != 1:
+            dist_matrix = dist_matrix / max_entry
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance for every sample. For sample s and voxel v with label y_s(v):
+
+            W_s(v) = sum_k M[y_s(v), k] * p_k,s(v)
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's matrix row chosen by its label
+        proba = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(rows * proba, dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels in
+        sample b whose label is c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for each sample b:
+
+            TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v))
+
+        The sum runs over every sample's distance map s in the batch (cross-sample coupling), while the weight
+        uses sample b's own labels and volumes.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: per-voxel distances of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        weight = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha(b, y_b(v))
+        return torch.sum(weight[:, None, :] * (1.0 - wasserstein_distance_map[None, :, :]), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for each sample b:
+
+            D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v))
+
+        The sum runs over every sample's distance map s in the batch (cross-sample coupling), while the weight
+        uses sample b's own labels and volumes.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: per-voxel distances of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        weight = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha(b, y_b(v))
+        return torch.sum(weight[:, None, :] * (2.0 - wasserstein_distance_map[None, :, :]), dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BCS[D][H][W].
+            target: integer class-index labels, the shape should be B1S[D][H][W] or BS[D][H][W].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of the per-sample loss, regardless of ``reduction``.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+        flat_proba = torch.softmax(flat_input, dim=1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_pos = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denom = self.compute_denominator(alpha, flat_target, wdm)
+
+        score = (2.0 * true_pos + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
