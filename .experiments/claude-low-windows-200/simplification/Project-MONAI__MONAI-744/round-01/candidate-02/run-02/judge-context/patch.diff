+import unittest
+
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def logits_from_labels(label_map, num_classes):
+    """
+    Build class-first logits from a batched integer label map of shape (B, *spatial).
+    The one-hot class axis is moved to channel position 1 and scaled by 1000.
+    """
+    one_hot = F.one_hot(label_map, num_classes=num_classes)  # (B, *spatial, C)
+    ndim = one_hot.dim()
+    one_hot = one_hot.permute(0, ndim - 1, *range(1, ndim - 1))  # (B, C, *spatial)
+    return (one_hot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        # batched integer label map, shape (1, 4, 4); inner 2 by 2 block is label 1
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        # correct logits, shape (1, 2, 4, 4)
+        result = loss(logits_from_labels(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # same target with an added size-1 class dimension, shape (1, 1, 4, 4)
+        result = loss(logits_from_labels(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # logits from the flipped target
+        result = loss(logits_from_labels(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        # all-zero target, batch axis 1, two classes; class 1 is absent
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        result = loss(logits_from_labels(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        result = loss(logits_from_labels(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
