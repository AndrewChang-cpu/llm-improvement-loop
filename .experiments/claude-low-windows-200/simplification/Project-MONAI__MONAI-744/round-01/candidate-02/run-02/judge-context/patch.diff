+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap score in which the true-positive contribution of each voxel is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed from a
+    class-distance matrix. The class weights follow the generalized Dice weighting of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+        segmentations. DLMIA 2017.
+
+    The weight of a class in a sample is the inverse of its voxel count plus one, so the weighting follows the
+    generalized Dice loss.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: a square 2D class-distance matrix of shape classes by classes, given as a torch tensor or a
+                numpy array. Entries must be nonnegative. It is divided by its maximum entry unless that maximum is 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Reduction mode passed to the parent loss. The returned loss is the batch mean regardless of
+                this setting. Defaults to ``"mean"``.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction is not a valid LossReduction value.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if len(dist_matrix.shape) != 2 or dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max().item() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), for every sample s.
+
+        Args:
+            flat_proba: the softmax probabilities, shape batch by classes by N.
+            flat_target: the flattened integer class labels, shape batch by N.
+
+        Returns:
+            the distance of each voxel, shape batch by N.
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # shape batch by N by classes: row M[y, :] for each voxel's label y
+        return torch.sum(rows * flat_proba.transpose(1, 2), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: the flattened integer class labels, shape batch by N.
+
+        Returns:
+            the class weights, shape batch by classes.
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for each sample b.
+        The inner sum runs over every sample's distance map s in the batch, not only sample b's own map.
+
+        Args:
+            alpha: the class weights of each sample, shape batch by classes.
+            flat_target: the flattened integer class labels, shape batch by N.
+            wasserstein_distance_map: the distance map of every sample, shape batch by N.
+
+        Returns:
+            one true-positive value per sample, shape batch.
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # shape batch by N: alpha(b, y_b(v))
+        weighted = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))  # index [b, s, v]
+        return torch.sum(weighted, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for each sample b.
+        The inner sum runs over every sample's distance map s in the batch, not only sample b's own map.
+
+        Args:
+            alpha: the class weights of each sample, shape batch by classes.
+            flat_target: the flattened integer class labels, shape batch by N.
+            wasserstein_distance_map: the distance map of every sample, shape batch by N.
+
+        Returns:
+            one denominator value per sample, shape batch.
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # shape batch by N: alpha(b, y_b(v))
+        weighted = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))  # index [b, s, v]
+        return torch.sum(weighted, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape batch by classes by spatial dimensions.
+            target: the integer class labels, shape batch by spatial dimensions or batch by 1 by spatial dimensions.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample loss, as a scalar tensor.
+        """
+        batch = input.shape[0]
+        num_ch = input.shape[1]
+        flat_input = input.reshape(batch, num_ch, -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
