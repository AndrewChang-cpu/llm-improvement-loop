+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground-truth label, computed from a class-distance matrix. The class weights
+    follow the generalized Dice loss, using inverse volume as in:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+        segmentations. MICCAI DLMIA 2017.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of size C by C, where C is the number of classes.
+                Entries must be nonnegative. Accepts a 2D torch tensor or a 2D numpy array. If its maximum
+                entry is not 1, the whole matrix is divided by that maximum.
+            reduction: reduction mode, a ``LossReduction`` member or its string value. Defaults to ``"mean"``.
+                It is stored and passed to the parent loss, but forward always returns the batch mean
+                regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix is not square.
+            ValueError: reduction is invalid. Raised by the ``LossReduction`` conversion.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        max_entry = torch.max(dist_matrix)
+        if max_entry.item() != 1:
+            dist_matrix = dist_matrix / max_entry
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance between the predicted distribution and the ground truth:
+
+            W_s(v) = sum_k M[y_s(v), k] * p_k,s(v)
+
+        The distance is computed for every sample s in the batch.
+
+        Args:
+            flat_proba: probabilities after softmax, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances, shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # batch, N, classes: each voxel's matrix row selected by its label
+        return torch.sum(rows * flat_proba.transpose(1, 2), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights from label volumes:
+
+            alpha(b, c) = 1 / (V(b, c) + 1)
+
+        where V(b, c) is the number of voxels in sample b whose label is c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights, shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives of each sample:
+
+            TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v))
+
+        The sum over s runs over every sample's distance map in the batch, not only sample b's own map.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: per-voxel distances for the whole batch, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # batch, N
+        distance_sum = torch.sum(1.0 - wasserstein_distance_map, dim=0)  # N, summed over every sample s
+        return torch.sum(alpha_map * distance_sum, dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator of each sample:
+
+            D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v))
+
+        The sum over s runs over every sample's distance map in the batch, not only sample b's own map.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: per-voxel distances for the whole batch, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # batch, N
+        distance_sum = torch.sum(2.0 - wasserstein_distance_map, dim=0)  # N, summed over every sample s
+        return torch.sum(alpha_map * distance_sum, dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial dimensions...).
+            target: integer class-index labels, shape (batch, spatial dimensions...) or
+                (batch, 1, spatial dimensions...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of the per-sample loss, regardless of reduction.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+        flat_proba = torch.softmax(flat_input, dim=1)
+
+        distance = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positives = self.compute_generalized_true_positive(alpha, flat_target, distance)
+        denominator = self.compute_denominator(alpha, flat_target, distance)
+
+        score = (2.0 * true_positives + smooth) / (denominator + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
