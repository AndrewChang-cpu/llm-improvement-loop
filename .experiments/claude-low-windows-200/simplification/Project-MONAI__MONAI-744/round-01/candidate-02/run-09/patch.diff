+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _class_first_logits(label: torch.Tensor, num_classes: int) -> torch.Tensor:
+    """Build class-first logits from a batched integer label map of shape (batch, spatial...)."""
+    one_hot = F.one_hot(label, num_classes)  # batch, spatial..., classes
+    dims = [0, one_hot.dim() - 1] + list(range(1, one_hot.dim() - 1))
+    return (one_hot.permute(*dims) * 1000).float()  # batch, classes, spatial...
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        # batched label map of shape (1, 4, 4) with an inner 2 by 2 block of label 1
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        flipped = 1 - target
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        correct_logits = _class_first_logits(target, 2)
+        np.testing.assert_allclose(loss.forward(correct_logits, target).detach().cpu().numpy(), 0.0, atol=5e-4)
+        # same target with an added size-1 channel axis after the batch axis
+        np.testing.assert_allclose(
+            loss.forward(correct_logits, target.unsqueeze(1)).detach().cpu().numpy(), 0.0, atol=5e-4
+        )
+
+        flipped_logits = _class_first_logits(flipped, 2)
+        np.testing.assert_allclose(loss.forward(flipped_logits, target).detach().cpu().numpy(), 1.0, atol=5e-4)
+
+    def test_empty_class(self):
+        # all-zero label map: class 1 is absent from the target
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        flipped = 1 - target
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        correct_logits = _class_first_logits(target, 2)
+        np.testing.assert_allclose(loss.forward(correct_logits, target).detach().cpu().numpy(), 0.0, atol=5e-4)
+        np.testing.assert_allclose(
+            loss.forward(correct_logits, target.unsqueeze(1)).detach().cpu().numpy(), 0.0, atol=5e-4
+        )
+
+        flipped_logits = _class_first_logits(flipped, 2)
+        np.testing.assert_allclose(loss.forward(flipped_logits, target).detach().cpu().numpy(), 1.0, atol=5e-4)
+
+
+if __name__ == "__main__":
+    unittest.main()
