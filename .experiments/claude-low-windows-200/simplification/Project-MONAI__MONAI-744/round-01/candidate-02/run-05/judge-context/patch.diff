+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _onehot_logits(batched_target, num_classes):
+    """
+    Build class-first predictions from a batched label map (B, H, W): one-hot encode with the class count,
+    move the class axis (last) to channel position 1, then scale by 1000 and cast to float.
+    """
+    one_hot = F.one_hot(batched_target, num_classes)  # (B, H, W, C)
+    dims = [0, one_hot.dim() - 1] + list(range(1, one_hot.dim() - 1))  # (B, C, H, W)
+    return one_hot.permute(*dims).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        # batched label map: batch 1, 4 x 4, inner 2 x 2 block is label 1
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        perfect = _onehot_logits(target, 2)
+        self.assertAlmostEqual(loss(perfect, target).item(), 0.0, places=3)
+        # target with an added size-1 class-dimension axis after the batch axis
+        self.assertAlmostEqual(loss(perfect, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        flipped = _onehot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        # batched all-zero label map: class 1 is absent
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        perfect = _onehot_logits(target, 2)
+        self.assertAlmostEqual(loss(perfect, target).item(), 0.0, places=3)
+
+        flipped = _onehot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
