+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It builds on the generalised Dice overlap of:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for
+        highly unbalanced segmentations. MICCAI DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix.
+    The class weighting follows the generalized Dice loss (inverse volume).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), where C is the number of classes.
+                It is a 2D torch tensor or a 2D numpy array with nonnegative entries. It is divided by its
+                maximum entry when that maximum is not 1.
+            reduction: the reduction mode passed to the parent loss. Accepts a ``LossReduction`` member or
+                its string value. Defaults to ``"mean"``. The returned loss is the batch mean regardless
+                of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The matrix is not square.
+            ValueError: reduction={reduction} is invalid.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        max_entry = torch.max(dist_matrix)
+        if max_entry != 1:
+            dist_matrix = dist_matrix / max_entry
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's matrix row chosen by its label
+        return torch.sum(rows * flat_proba.transpose(1, 2), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of sample b labelled c. A class absent from a sample has weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            alpha weights, shape (batch, classes).
+        """
+        one_hot = F.one_hot(flat_target, self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot, dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for each sample b. The sum over s runs
+        over every sample's distance map in the batch, not only sample b's own map.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps W for all samples, shape (batch, N).
+
+        Returns:
+            generalized true positives, one per sample, shape (batch,).
+        """
+        alpha_voxels = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        return torch.einsum("bn,sn->b", alpha_voxels, 1.0 - wasserstein_distance_map)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for each sample b. The sum over s runs
+        over every sample's distance map in the batch, not only sample b's own map.
+
+        Args:
+            alpha: class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps W for all samples, shape (batch, N).
+
+        Returns:
+            denominator terms, one per sample, shape (batch,).
+        """
+        alpha_voxels = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        return torch.einsum("bn,sn->b", alpha_voxels, 2.0 - wasserstein_distance_map)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape (batch, classes, spatial_dims...).
+            target: integer class-index labels, shape (batch, spatial_dims...) or (batch, 1, spatial_dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch, classes = input.shape[0], input.shape[1]
+        flat_proba = torch.softmax(input.reshape(batch, classes, -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
