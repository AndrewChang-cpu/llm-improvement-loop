+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+
+
+def _logits_from_labels(target, num_classes=2):
+    """Class-first logits of 1000 * one-hot(target); target is a batched label map (batch, H, W)."""
+    one_hot = F.one_hot(target, num_classes)  # (batch, H, W, classes)
+    return (one_hot.permute(0, 3, 1, 2) * 1000).float()  # (batch, classes, H, W)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        flipped = 1 - target
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        self.assertAlmostEqual(loss(_logits_from_labels(target), target).item(), 0.0, places=3)
+        # target with an added size-1 channel axis after the batch axis
+        self.assertAlmostEqual(loss(_logits_from_labels(target), target.unsqueeze(1)).item(), 0.0, places=3)
+        self.assertAlmostEqual(loss(_logits_from_labels(flipped), target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        flipped = 1 - target
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        self.assertAlmostEqual(loss(_logits_from_labels(target), target).item(), 0.0, places=3)
+        self.assertAlmostEqual(loss(_logits_from_labels(flipped), target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
