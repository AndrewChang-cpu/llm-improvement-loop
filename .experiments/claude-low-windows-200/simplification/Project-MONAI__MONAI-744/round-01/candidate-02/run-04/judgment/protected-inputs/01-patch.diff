+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+TEST_CASE_DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def make_logits(target, num_classes):
+    """
+    Build class-first logits from a batched label map of shape (batch, spatial...).
+    The one-hot class axis (last) is moved to channel position 1 and scaled by 1000.
+    """
+    one_hot = F.one_hot(target, num_classes=num_classes)  # batch, spatial..., classes
+    dims = list(range(one_hot.dim()))
+    one_hot = one_hot.permute(0, dims[-1], *dims[1:-1])  # batch, classes, spatial...
+    return (one_hot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=TEST_CASE_DIST_MATRIX)
+
+        loss = loss_fn(make_logits(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # same target with an added size-1 class dimension
+        loss = loss_fn(make_logits(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # logits from the flipped target
+        flipped = 1 - target
+        loss = loss_fn(make_logits(flipped, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=TEST_CASE_DIST_MATRIX)
+
+        loss = loss_fn(make_logits(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        flipped = 1 - target
+        loss = loss_fn(make_logits(flipped, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
