+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix. The class
+    weights follow the generalized Dice weighting (inverse volume) as in the generalized Dice loss
+    of Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+    unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target
+    is an integer class-index label map with a leading batch axis, shaped ``B[1]HW[D]``.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of size C by C, where C is the number of
+                classes. Can be a torch tensor or a numpy array. Entries must be nonnegative. The matrix
+                is divided by its maximum entry when that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode. It is stored and passed to the parent class. The returned
+                loss is always the batch mean regardless of this setting. Defaults to ``"mean"``.
+
+        Raises:
+            ValueError: dist_matrix is not square ("Dist Matrix is invalid.").
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        max_value = torch.max(dist_matrix)
+        if max_value.item() != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map of every sample. For sample s and voxel v with
+        ground-truth label y_s(v), the distance is W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities of shape batch by classes by N.
+            flat_target: integer class-index labels of shape batch by N.
+
+        Returns:
+            distances of shape batch by N.
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # each voxel's row of the matrix, selected by its label: batch by N by classes
+        rows = m[flat_target]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes therefore have weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape batch by N.
+
+        Returns:
+            alpha weights of shape batch by classes.
+        """
+        one_hot_target = F.one_hot(flat_target, num_classes=self.num_classes)
+        volumes = torch.sum(one_hot_target, dim=1)
+        return 1.0 / (volumes.to(torch.float) + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_{s} sum_{v} alpha(b, y_b(v)) * (1 - W_s(v)).
+        The weight uses sample b's labels and volumes, while the sum runs over every sample's distance
+        map in the batch (the batch-wide cross-sample rule).
+
+        Args:
+            alpha: class weights of shape batch by classes.
+            flat_target: integer class-index labels of shape batch by N.
+            wasserstein_distance_map: distances of all samples, of shape batch by N.
+
+        Returns:
+            one true-positive value per sample, of shape batch.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # batch by N, weights of each sample's own labels
+        # pair sample b's weights (index b) with all distance maps (index s), then sum over s and voxels
+        return torch.sum(alpha_voxel[:, None, :] * (1.0 - wasserstein_distance_map[None, :, :]), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_{s} sum_{v} alpha(b, y_b(v)) * (2 - W_s(v)).
+        The weight uses sample b's labels and volumes, while the sum runs over every sample's distance
+        map in the batch (the batch-wide cross-sample rule).
+
+        Args:
+            alpha: class weights of shape batch by classes.
+            flat_target: integer class-index labels of shape batch by N.
+            wasserstein_distance_map: distances of all samples, of shape batch by N.
+
+        Returns:
+            one denominator value per sample, of shape batch.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # batch by N, weights of each sample's own labels
+        # pair sample b's weights (index b) with all distance maps (index s), then sum over s and voxels
+        return torch.sum(alpha_voxel[:, None, :] * (2.0 - wasserstein_distance_map[None, :, :]), dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape batch by classes by spatial dimensions.
+            target: integer class-index labels of shape batch by spatial dimensions, or
+                batch by 1 by spatial dimensions.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the batch mean of the per-sample losses (independent of ``reduction``).
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input, dim=1).reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        wd = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wd)
+        denominator = self.compute_denominator(alpha, flat_target, wd)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
