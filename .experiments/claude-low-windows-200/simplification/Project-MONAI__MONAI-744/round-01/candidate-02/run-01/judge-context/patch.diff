+import unittest
+
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(target, num_classes):
+    """
+    Build class-first logits from a batched label map.
+
+    Args:
+        target: integer label map with a leading batch axis, shape batch, spatial dimensions.
+        num_classes: number of classes, which must equal the channel count of the result.
+
+    Returns:
+        float logits of shape batch, num_classes, spatial dimensions, equal to 1000 times the one-hot encoding.
+    """
+    onehot = F.one_hot(target, num_classes)  # batch, spatial dimensions, classes
+    dims = [0, target.dim()] + list(range(1, target.dim()))  # move the class axis to channel position 1
+    onehot = onehot.permute(*dims)
+    return (onehot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        logits = _one_hot_logits(target, 2)
+        result = loss(logits, target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # same target with an added size-1 channel dimension in the label map
+        result = loss(logits, target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        result = loss(flipped_logits, target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        logits = _one_hot_logits(target, 2)
+        result = loss(logits, target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        result = loss(flipped_logits, target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
