+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It builds on the generalised Dice overlap of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. MICCAI DLMIA 2017.
+
+    The class weights follow the generalized Dice loss weighting (inverse volume), so an
+    absent class receives weight 1.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of size C by C, where C is the number of classes.
+                It can be a 2D torch tensor or a 2D numpy array with nonnegative entries. It is divided
+                by its maximum entry when that maximum is not 1.
+            reduction: the reduction mode, passed to the parent class and stored. It accepts a
+                ``LossReduction`` member or its string value. Defaults to ``"mean"``. The forward
+                method always returns the batch mean, whatever the reduction is.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The matrix is not square.
+            ValueError: reduction is invalid, as reported by the ``LossReduction`` conversion.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        max_val = dist_matrix.max()
+        if max_val.item() != 1:
+            dist_matrix = dist_matrix / max_val
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance between the predicted class distribution and the label.
+
+        For sample s and voxel v with label y(v): W_s(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities after softmax, shape batch by classes by N.
+            flat_target: integer class labels, shape batch by N.
+
+        Returns:
+            per-voxel distances, shape batch by N.
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)  # copy, the stored matrix is unchanged
+        rows = m[flat_target]  # batch by N by classes, each voxel's row chosen by its label
+        return torch.sum(rows.permute(0, 2, 1) * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. An absent class gets weight 1.
+
+        Args:
+            flat_target: integer class labels, shape batch by N.
+
+        Returns:
+            alpha weights, shape batch by classes.
+        """
+        one_hot = F.one_hot(flat_target, self.num_classes)  # batch by N by classes
+        volumes = torch.sum(one_hot, dim=1).float()  # batch by classes
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives of each sample:
+        TP_b = sum over every sample s in the batch and every voxel v of alpha(b, y_b(v)) * (1 - W_s(v)).
+
+        The sum runs over every sample's distance map in the batch, not only over sample b's own map.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class labels, shape batch by N.
+            wasserstein_distance_map: distances of the whole batch, shape batch by N.
+
+        Returns:
+            one true positive value per sample, shape batch.
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)  # batch by N, weight from sample b's own labels
+        terms = alpha_per_voxel.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # b, s, N
+        return torch.sum(terms, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator of each sample:
+        D_b = sum over every sample s in the batch and every voxel v of alpha(b, y_b(v)) * (2 - W_s(v)).
+
+        The sum runs over every sample's distance map in the batch, not only over sample b's own map.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class labels, shape batch by N.
+            wasserstein_distance_map: distances of the whole batch, shape batch by N.
+
+        Returns:
+            one denominator value per sample, shape batch.
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)  # batch by N, weight from sample b's own labels
+        terms = alpha_per_voxel.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # b, s, N
+        return torch.sum(terms, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, shape batch, classes, then zero or more spatial dimensions.
+            target: integer class indices, shape batch, spatial dimensions, or batch, 1, spatial dimensions.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of the per-sample loss ``1 - (2 TP + smooth) / (D + smooth)``.
+            The reduction is not applied here.
+
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+        flat_proba = torch.softmax(flat_input, 1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positives = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        loss = 1.0 - (2.0 * true_positives + smooth) / (denominator + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
