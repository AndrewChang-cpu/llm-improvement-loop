diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..caf3602
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,256 @@
+from __future__ import annotations
+
+import asyncio
+import concurrent.futures
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5
+
+
+def start_thread(target: Callable[[], None]) -> threading.Thread:
+    """Start a daemon thread that runs `target`."""
+    thread = threading.Thread(target=target, daemon=True)
+    thread.start()
+    return thread
+
+
+def assert_threads_finished(threads: list[threading.Thread]) -> None:
+    """Join each thread with a bounded wait, and assert that it finished."""
+    for thread in threads:
+        thread.join(JOIN_TIMEOUT)
+        assert not thread.is_alive()
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """Calling before the app runs raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises_not_running_without_blocking() -> None:
+    """Calling after run has returned raises 'App is not running' and does not block."""
+    threads: list[threading.Thread] = []
+
+    class StopApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                self.call_from_thread(self.exit, 7)
+
+            threads.append(start_thread(background))
+
+    app = StopApp()
+    assert app.run(headless=True) == 7
+    assert_threads_finished(threads)
+
+    # The app has stopped, so this must fail immediately rather than block.
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error() -> None:
+    """Calling from the app thread raises a runtime error about running in a different thread."""
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(0)
+
+    app = SameThreadApp()
+    assert app.run(headless=True) == 0
+    assert len(errors) == 1
+    assert "different thread from the app" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_returns_result_from_background_thread() -> None:
+    """A background thread receives the callable's return value."""
+    results: dict[str, Any] = {}
+    threads: list[threading.Thread] = []
+
+    class ResultApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                results["value"] = self.call_from_thread(lambda: 21 * 2)
+                self.call_from_thread(self.exit, 1)
+
+            threads.append(start_thread(background))
+
+    app = ResultApp()
+    assert app.run(headless=True) == 1
+    assert_threads_finished(threads)
+    assert results["value"] == 42
+
+
+def test_call_from_thread_writes_to_widget_in_app() -> None:
+    """A callable that writes to a TextLog widget completes and the app exits with the code."""
+    results: dict[str, Any] = {}
+    threads: list[threading.Thread] = []
+
+    class WidgetApp(App[int]):
+        def compose(self):
+            yield TextLog()
+
+        def on_mount(self) -> None:
+            def background() -> None:
+                def write_to_log() -> str:
+                    self.query_one(TextLog).write("written from thread")
+                    return "done"
+
+                results["value"] = self.call_from_thread(write_to_log)
+                self.call_from_thread(self.exit, 5)
+
+            threads.append(start_thread(background))
+
+    app = WidgetApp()
+    assert app.run(headless=True) == 5
+    assert_threads_finished(threads)
+    assert results["value"] == "done"
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+    results: dict[str, Any] = {}
+    threads: list[threading.Thread] = []
+
+    async def coroutine_callable() -> str:
+        await asyncio.sleep(0)
+        return "awaited"
+
+    class AwaitApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                results["value"] = self.call_from_thread(coroutine_callable)
+                self.call_from_thread(self.exit, 2)
+
+            threads.append(start_thread(background))
+
+    app = AwaitApp()
+    assert app.run(headless=True) == 2
+    assert_threads_finished(threads)
+    assert results["value"] == "awaited"
+
+
+def test_call_from_thread_propagates_timeout_exception() -> None:
+    """A timeout-class exception reaches the calling thread with the same message and args."""
+    errors: list[BaseException] = []
+    threads: list[threading.Thread] = []
+
+    def raise_timeout() -> None:
+        raise concurrent.futures.TimeoutError("timed out waiting", 3)
+
+    class TimeoutApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                try:
+                    self.call_from_thread(raise_timeout)
+                except (concurrent.futures.TimeoutError, asyncio.TimeoutError) as error:
+                    # The asyncio bridge may re-create the timeout as asyncio's class.
+                    errors.append(error)
+                self.call_from_thread(self.exit, 4)
+
+            threads.append(start_thread(background))
+
+    app = TimeoutApp()
+    assert app.run(headless=True) == 4
+    assert_threads_finished(threads)
+    assert len(errors) == 1
+    assert errors[0].args == ("timed out waiting", 3)
+
+
+def test_call_from_thread_propagates_value_error() -> None:
+    """A non-timeout exception reaches the calling thread with the same message and args."""
+    errors: list[BaseException] = []
+    threads: list[threading.Thread] = []
+
+    def raise_value_error() -> None:
+        raise ValueError("bad value", 9)
+
+    class ValueErrorApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                try:
+                    self.call_from_thread(raise_value_error)
+                except ValueError as error:
+                    errors.append(error)
+                self.call_from_thread(self.exit, 6)
+
+            threads.append(start_thread(background))
+
+    app = ValueErrorApp()
+    assert app.run(headless=True) == 6
+    assert_threads_finished(threads)
+    assert len(errors) == 1
+    assert errors[0].args == ("bad value", 9)
+
+
+def test_call_from_thread_forwards_variadic_positional_arguments() -> None:
+    """A variadic callable receives all supplied positional arguments."""
+    results: dict[str, Any] = {}
+    threads: list[threading.Thread] = []
+
+    def collect(*values: int) -> tuple:
+        return values
+
+    class VariadicApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                results["value"] = self.call_from_thread(collect, 1, 2, 3, 4)
+                self.call_from_thread(self.exit, 8)
+
+            threads.append(start_thread(background))
+
+    app = VariadicApp()
+    assert app.run(headless=True) == 8
+    assert_threads_finished(threads)
+    assert results["value"] == (1, 2, 3, 4)
+
+
+def test_call_from_thread_forwards_keyword_arguments() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+    results: dict[str, Any] = {}
+    threads: list[threading.Thread] = []
+
+    def combine(first: str, second: str = "") -> str:
+        return f"{first}-{second}"
+
+    class KeywordApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                results["value"] = self.call_from_thread(
+                    combine, "a", second="b"
+                )
+                self.call_from_thread(self.exit, 10)
+
+            threads.append(start_thread(background))
+
+    app = KeywordApp()
+    assert app.run(headless=True) == 10
+    assert_threads_finished(threads)
+    assert results["value"] == "a-b"
+
+
+def test_background_thread_exit_returns_exit_value_from_run() -> None:
+    """A background thread that exits the app through call_from_thread makes run return the value."""
+    threads: list[threading.Thread] = []
+
+    class ExitApp(App[int]):
+        def on_mount(self) -> None:
+            def background() -> None:
+                self.call_from_thread(self.exit, 99)
+
+            threads.append(start_thread(background))
+
+    app = ExitApp()
+    assert app.run(headless=True) == 99
+    assert_threads_finished(threads)
