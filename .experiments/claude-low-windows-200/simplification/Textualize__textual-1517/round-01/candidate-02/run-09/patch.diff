diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..98e73dc
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,195 @@
+from __future__ import annotations
+
+import threading
+from concurrent.futures import TimeoutError as FuturesTimeoutError
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5
+
+
+def run_app_with_worker(worker: Callable[[App], None]) -> Any:
+    """Run a headless app, starting `worker` on a daemon thread from `on_mount`.
+
+    The worker must end the app by calling `app.exit` through `call_from_thread`.
+    If the worker raises, the app is exited so the run cannot hang, and the
+    error is re-raised here after the run returns.
+    """
+    errors: list[BaseException] = []
+    threads: list[threading.Thread] = []
+
+    class WorkerApp(App):
+        def compose(self):
+            yield TextLog(id="log")
+
+        def on_mount(self) -> None:
+            def target() -> None:
+                try:
+                    worker(self)
+                except BaseException as error:
+                    errors.append(error)
+                    try:
+                        self.call_from_thread(self.exit)
+                    except Exception:
+                        pass
+
+            thread = threading.Thread(target=target, daemon=True)
+            threads.append(thread)
+            thread.start()
+
+    result = WorkerApp().run(headless=True)
+    for thread in threads:
+        thread.join(JOIN_TIMEOUT)
+        assert not thread.is_alive()
+    if errors:
+        raise errors[0]
+    return result
+
+
+def test_call_from_thread_before_run_raises_app_not_running() -> None:
+    app = App()
+    with pytest.raises(RuntimeError) as error:
+        app.call_from_thread(lambda: None)
+    assert str(error.value) == "App is not running"
+
+
+def test_call_from_thread_from_app_thread_raises_different_thread_error() -> None:
+    messages: list[str] = []
+
+    class SameThreadApp(App):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                messages.append(str(error))
+            self.exit()
+
+    SameThreadApp().run(headless=True)
+    assert messages == [
+        "The `call_from_thread` method must run in a different thread from the app"
+    ]
+
+
+def test_call_from_thread_after_run_returns_raises_app_not_running_without_blocking() -> None:
+    seen_apps: list[App] = []
+
+    def worker(app: App) -> None:
+        seen_apps.append(app)
+        app.call_from_thread(app.exit, "finished")
+
+    assert run_app_with_worker(worker) == "finished"
+
+    # The app has stopped. Calling from a daemon thread must be rejected
+    # immediately rather than blocking forever.
+    app = seen_apps[0]
+    outcome: list[str] = []
+
+    def late_caller() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            outcome.append(str(error))
+
+    late_thread = threading.Thread(target=late_caller, daemon=True)
+    late_thread.start()
+    late_thread.join(JOIN_TIMEOUT)
+    assert not late_thread.is_alive()
+    assert outcome == ["App is not running"]
+
+
+def test_call_from_thread_returns_callable_result_to_calling_thread() -> None:
+    received: list[int] = []
+
+    def worker(app: App) -> None:
+        received.append(app.call_from_thread(lambda x: x * 2, 21))
+        app.call_from_thread(app.exit, "done")
+
+    assert run_app_with_worker(worker) == "done"
+    assert received == [42]
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    received: list[int] = []
+
+    async def double(value: int) -> int:
+        return value * 2
+
+    def worker(app: App) -> None:
+        received.append(app.call_from_thread(double, 21))
+        app.call_from_thread(app.exit, "awaited")
+
+    assert run_app_with_worker(worker) == "awaited"
+    assert received == [42]
+
+
+def test_call_from_thread_writes_to_text_log_widget_in_app() -> None:
+    completed: list[bool] = []
+
+    def write_to_log(app: App, message: str) -> None:
+        app.query_one(TextLog).write(message)
+
+    def worker(app: App) -> None:
+        app.call_from_thread(write_to_log, app, "hello from thread")
+        completed.append(True)
+        app.call_from_thread(app.exit, 7)
+
+    assert run_app_with_worker(worker) == 7
+    assert completed == [True]
+
+
+def test_call_from_thread_reraises_timeout_error_with_same_message_and_args() -> None:
+    captured: list[Exception] = []
+
+    def timeout_callable() -> None:
+        raise FuturesTimeoutError("timed out waiting for response")
+
+    def worker(app: App) -> None:
+        try:
+            app.call_from_thread(timeout_callable)
+        except Exception as error:
+            captured.append(error)
+        app.call_from_thread(app.exit, "returned")
+
+    assert run_app_with_worker(worker) == "returned"
+    assert len(captured) == 1
+    assert str(captured[0]) == "timed out waiting for response"
+    assert captured[0].args == ("timed out waiting for response",)
+
+
+def test_call_from_thread_forwards_all_positional_arguments_to_variadic_callable() -> None:
+    received: list[tuple] = []
+
+    def collect(*values: int) -> tuple:
+        return values
+
+    def worker(app: App) -> None:
+        received.append(app.call_from_thread(collect, 1, 2, 3))
+        app.call_from_thread(app.exit, "variadic")
+
+    assert run_app_with_worker(worker) == "variadic"
+    assert received == [(1, 2, 3)]
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters() -> None:
+    received: list[tuple] = []
+
+    def combine(*, first: int, second: int) -> tuple:
+        return (first, second)
+
+    def worker(app: App) -> None:
+        received.append(app.call_from_thread(combine, first=1, second=2))
+        app.call_from_thread(app.exit, "keywords")
+
+    assert run_app_with_worker(worker) == "keywords"
+    assert received == [(1, 2)]
+
+
+def test_call_from_thread_exit_from_background_thread_returns_exit_value() -> None:
+    def worker(app: App) -> None:
+        app.call_from_thread(app.exit, 42)
+
+    assert run_app_with_worker(worker) == 42
