diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..5fd5b5c
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,205 @@
+from __future__ import annotations
+
+import threading
+from concurrent.futures import TimeoutError as FuturesTimeoutError
+from typing import Any
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5
+
+
+def start_daemon_thread(target) -> threading.Thread:
+    thread = threading.Thread(target=target, daemon=True)
+    thread.start()
+    return thread
+
+
+def assert_thread_finished(thread: threading.Thread) -> None:
+    thread.join(JOIN_TIMEOUT)
+    assert not thread.is_alive()
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error() -> None:
+    errors: list[RuntimeError] = []
+
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    ThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert "must run in a different thread from the app" in str(errors[0])
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    results: list[int] = []
+
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                results.append(self.call_from_thread(lambda: 6 * 7))
+                self.call_from_thread(self.exit)
+
+            start_daemon_thread(worker)
+
+    ThreadApp().run(headless=True)
+    assert results == [42]
+
+
+def test_call_from_thread_writes_to_text_log_widget() -> None:
+    worker_outcomes: list[str] = []
+
+    class ThreadApp(App):
+        def compose(self):
+            yield TextLog()
+
+        def on_mount(self) -> None:
+            def write_line() -> None:
+                self.query_one(TextLog).write("hello from thread")
+
+            def worker() -> None:
+                self.call_from_thread(write_line)
+                worker_outcomes.append("completed")
+                self.call_from_thread(self.exit, "written")
+
+            self.worker_thread = start_daemon_thread(worker)
+
+    app = ThreadApp()
+    result = app.run(headless=True)
+    assert_thread_finished(app.worker_thread)
+    assert worker_outcomes == ["completed"]
+    assert result == "written"
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    results: list[str] = []
+
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            async def make_value() -> str:
+                return "awaited"
+
+            def worker() -> None:
+                results.append(self.call_from_thread(make_value))
+                self.call_from_thread(self.exit)
+
+            self.worker_thread = start_daemon_thread(worker)
+
+    app = ThreadApp()
+    app.run(headless=True)
+    assert_thread_finished(app.worker_thread)
+    assert results == ["awaited"]
+
+
+def test_call_from_thread_propagates_timeout_exception_message_and_args() -> None:
+    raised: list[BaseException] = []
+
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            def raise_timeout() -> None:
+                raise FuturesTimeoutError("request timed out", 42)
+
+            def worker() -> None:
+                try:
+                    self.call_from_thread(raise_timeout)
+                except Exception as error:
+                    raised.append(error)
+                self.call_from_thread(self.exit)
+
+            self.worker_thread = start_daemon_thread(worker)
+
+    app = ThreadApp()
+    app.run(headless=True)
+    assert_thread_finished(app.worker_thread)
+    assert len(raised) == 1
+    assert raised[0].args == ("request timed out", 42)
+
+
+def test_call_from_thread_forwards_variadic_arguments() -> None:
+    results: list[Any] = []
+
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            def collect(*args: object, **kwargs: object) -> tuple:
+                return args, kwargs
+
+            def worker() -> None:
+                outcome = self.call_from_thread(collect, 1, "two", 3.0, key="value")
+                results.append(outcome)
+                self.call_from_thread(self.exit)
+
+            self.worker_thread = start_daemon_thread(worker)
+
+    app = ThreadApp()
+    app.run(headless=True)
+    assert_thread_finished(app.worker_thread)
+    assert results == [((1, "two", 3.0), {"key": "value"})]
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters() -> None:
+    results: list[int] = []
+
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            def add(x: int, y: int = 0) -> int:
+                return x + y
+
+            def worker() -> None:
+                results.append(self.call_from_thread(add, x=1, y=2))
+                self.call_from_thread(self.exit)
+
+            self.worker_thread = start_daemon_thread(worker)
+
+    app = ThreadApp()
+    app.run(headless=True)
+    assert_thread_finished(app.worker_thread)
+    assert results == [3]
+
+
+def test_call_from_thread_exit_from_background_thread_returns_exit_value() -> None:
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                self.call_from_thread(self.exit, "bye")
+
+            self.worker_thread = start_daemon_thread(worker)
+
+    app = ThreadApp()
+    result = app.run(headless=True)
+    assert_thread_finished(app.worker_thread)
+    assert result == "bye"
+
+
+def test_call_from_thread_after_app_stopped_raises_not_running_without_blocking() -> None:
+    class ThreadApp(App):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = ThreadApp()
+    app.run(headless=True)
+
+    outcomes: list[str] = []
+
+    def late_caller() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            outcomes.append(str(error))
+
+    thread = start_daemon_thread(late_caller)
+    assert_thread_finished(thread)
+    assert outcomes == ["App is not running"]
