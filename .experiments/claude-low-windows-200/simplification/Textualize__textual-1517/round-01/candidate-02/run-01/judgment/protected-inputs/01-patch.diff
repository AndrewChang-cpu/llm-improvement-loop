diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..78a97ce
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,220 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App, ComposeResult
+from textual.widgets import TextLog
+
+# Upper bound for joining background threads; a live thread after this is a failure.
+JOIN_TIMEOUT = 5.0
+
+
+def start_thread(target: Callable[[], None]) -> threading.Thread:
+    thread = threading.Thread(target=target, daemon=True)
+    thread.start()
+    return thread
+
+
+def assert_threads_finished(threads: list[threading.Thread]) -> None:
+    for thread in threads:
+        thread.join(JOIN_TIMEOUT)
+        assert not thread.is_alive()
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises_not_running() -> None:
+    class ExampleApp(App[None]):
+        def on_ready(self) -> None:
+            self.exit()
+
+    app = ExampleApp()
+    app.run(headless=True)
+    # Run has returned, so the app is stopped; the call must be rejected, not block.
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error() -> None:
+    errors: list[RuntimeError] = []
+
+    class ExampleApp(App[None]):
+        def on_ready(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            finally:
+                self.exit()
+
+    ExampleApp().run(headless=True)
+    assert len(errors) == 1
+    assert "must run in a different thread from the app" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_returns_value_from_background_thread() -> None:
+    results: list[int] = []
+    threads: list[threading.Thread] = []
+
+    class ExampleApp(App[None]):
+        def on_ready(self) -> None:
+            def worker() -> None:
+                try:
+                    results.append(self.call_from_thread(lambda: 6 * 7))
+                finally:
+                    self.call_from_thread(self.exit)
+
+            threads.append(start_thread(worker))
+
+    ExampleApp().run(headless=True)
+    assert_threads_finished(threads)
+    assert results == [42]
+
+
+def test_call_from_thread_runs_callable_that_writes_to_widget() -> None:
+    outcome: list[str] = []
+    threads: list[threading.Thread] = []
+
+    class ExampleApp(App[None]):
+        def compose(self) -> ComposeResult:
+            yield TextLog(id="log")
+
+        def on_ready(self) -> None:
+            def write_to_log() -> str:
+                # Runs on the app's loop, so the widget query and write happen in the app.
+                log = self.query_one(TextLog)
+                log.write("hello from thread")
+                return "written"
+
+            def worker() -> None:
+                try:
+                    outcome.append(self.call_from_thread(write_to_log))
+                finally:
+                    self.call_from_thread(self.exit)
+
+            threads.append(start_thread(worker))
+
+    ExampleApp().run(headless=True)
+    assert_threads_finished(threads)
+    assert outcome == ["written"]
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    results: list[str] = []
+    threads: list[threading.Thread] = []
+
+    class ExampleApp(App[None]):
+        def on_ready(self) -> None:
+            async def coroutine_callable() -> str:
+                return "awaited"
+
+            def worker() -> None:
+                try:
+                    results.append(self.call_from_thread(coroutine_callable))
+                finally:
+                    self.call_from_thread(self.exit)
+
+            threads.append(start_thread(worker))
+
+    ExampleApp().run(headless=True)
+    assert_threads_finished(threads)
+    assert results == ["awaited"]
+
+
+def test_call_from_thread_propagates_timeout_exception_message_and_args() -> None:
+    captured: list[Exception] = []
+    returned: list[bool] = []
+    threads: list[threading.Thread] = []
+
+    def raise_timeout() -> None:
+        raise TimeoutError("request timed out")
+
+    class ExampleApp(App[None]):
+        def on_ready(self) -> None:
+            def worker() -> None:
+                try:
+                    try:
+                        self.call_from_thread(raise_timeout)
+                    except Exception as error:
+                        captured.append(error)
+                    returned.append(True)
+                finally:
+                    self.call_from_thread(self.exit)
+
+            threads.append(start_thread(worker))
+
+    ExampleApp().run(headless=True)
+    assert_threads_finished(threads)
+    assert returned == [True]
+    assert len(captured) == 1
+    assert str(captured[0]) == "request timed out"
+    assert captured[0].args == ("request timed out",)
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable() -> None:
+    results: list[tuple[Any, ...]] = []
+    threads: list[threading.Thread] = []
+
+    def collect(*values: Any) -> tuple[Any, ...]:
+        return values
+
+    class ExampleApp(App[None]):
+        def on_ready(self) -> None:
+            def worker() -> None:
+                try:
+                    results.append(self.call_from_thread(collect, 1, "two", 3.0))
+                finally:
+                    self.call_from_thread(self.exit)
+
+            threads.append(start_thread(worker))
+
+    ExampleApp().run(headless=True)
+    assert_threads_finished(threads)
+    assert results == [(1, "two", 3.0)]
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_callable() -> None:
+    results: list[str] = []
+    threads: list[threading.Thread] = []
+
+    def greet(name: str, punctuation: str = "!") -> str:
+        return f"hello {name}{punctuation}"
+
+    class ExampleApp(App[None]):
+        def on_ready(self) -> None:
+            def worker() -> None:
+                try:
+                    results.append(
+                        self.call_from_thread(greet, "world", punctuation="?")
+                    )
+                finally:
+                    self.call_from_thread(self.exit)
+
+            threads.append(start_thread(worker))
+
+    ExampleApp().run(headless=True)
+    assert_threads_finished(threads)
+    assert results == ["hello world?"]
+
+
+def test_call_from_thread_exit_from_background_thread_returns_exit_value() -> None:
+    threads: list[threading.Thread] = []
+
+    class ExampleApp(App[int]):
+        def on_ready(self) -> None:
+            def worker() -> None:
+                self.call_from_thread(self.exit, 42)
+
+            threads.append(start_thread(worker))
+
+    result = ExampleApp().run(headless=True)
+    assert_threads_finished(threads)
+    assert result == 42
