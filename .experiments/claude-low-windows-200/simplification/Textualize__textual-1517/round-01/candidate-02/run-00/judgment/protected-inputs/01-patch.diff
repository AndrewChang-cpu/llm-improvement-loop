+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: object,
+        **kwargs: object,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, in the context of the app.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context (e.g. widget access through the app works), and
+        blocks the calling thread until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable returning a value, or an awaitable of a value. It is
+                awaited if needed.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including after it has stopped).
+            RuntimeError: If called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            """Set the active app, then invoke the bound callable."""
+            self._set_active()
+            return await invoke(partial(callback, *args, **kwargs))
+
+        scheduled: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), self._loop
+        )
+        return scheduled.result()
