diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..be1c06f
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,214 @@
+from __future__ import annotations
+
+import concurrent.futures
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5
+
+
+def assert_threads_finished(threads: list[threading.Thread]) -> None:
+    """Join each thread with a bounded wait and fail if any is still alive."""
+    for thread in threads:
+        thread.join(JOIN_TIMEOUT)
+        assert not thread.is_alive()
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """A call made before the app runs raises RuntimeError with 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises_not_running() -> None:
+    """A call made after run has returned raises 'App is not running' without blocking."""
+
+    class StopApp(App[int]):
+        def on_mount(self) -> None:
+            self.exit(3)
+
+    app = StopApp()
+    assert app.run(headless=True) == 3
+
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread_raises_runtime_error() -> None:
+    """Calling from the app thread raises RuntimeError naming the different-thread rule."""
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(4)
+
+    app = SameThreadApp()
+    assert app.run(headless=True) == 4
+
+    assert len(errors) == 1
+    assert str(errors[0]) == (
+        "The `call_from_thread` method must run in a different thread from the app"
+    )
+
+
+def test_call_from_thread_widget_access_completes_and_exits_with_code() -> None:
+    """A callable that writes to a TextLog through the app completes and the app exits."""
+    results: list[object] = []
+
+    class LogApp(App[int]):
+        def compose(self):
+            yield TextLog()
+
+        def on_mount(self) -> None:
+            def worker() -> None:
+                def write_log() -> str:
+                    self.query_one(TextLog).write("hello from thread")
+                    return "written"
+
+                results.append(self.call_from_thread(write_log))
+                self.call_from_thread(self.exit, 7)
+
+            thread = threading.Thread(target=worker, daemon=True)
+            threads.append(thread)
+            thread.start()
+
+    threads: list[threading.Thread] = []
+    app = LogApp()
+    assert app.run(headless=True) == 7
+
+    assert_threads_finished(threads)
+    assert results == ["written"]
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+    results: list[object] = []
+
+    class AwaitApp(App[int]):
+        def on_mount(self) -> None:
+            async def double(value: int) -> int:
+                return value * 2
+
+            def worker() -> None:
+                results.append(self.call_from_thread(double, 21))
+                self.call_from_thread(self.exit, 5)
+
+            thread = threading.Thread(target=worker, daemon=True)
+            threads.append(thread)
+            thread.start()
+
+    threads: list[threading.Thread] = []
+    app = AwaitApp()
+    assert app.run(headless=True) == 5
+
+    assert_threads_finished(threads)
+    assert results == [42]
+
+
+def test_call_from_thread_reraises_timeout_error_with_same_message_and_args() -> None:
+    """A timeout-class exception reaches the calling thread with the same message and args."""
+    errors: list[BaseException] = []
+
+    class TimeoutApp(App[int]):
+        def on_mount(self) -> None:
+            def raise_timeout() -> None:
+                raise concurrent.futures.TimeoutError("request timed out")
+
+            def worker() -> None:
+                try:
+                    self.call_from_thread(raise_timeout)
+                except Exception as error:
+                    errors.append(error)
+                self.call_from_thread(self.exit, 6)
+
+            thread = threading.Thread(target=worker, daemon=True)
+            threads.append(thread)
+            thread.start()
+
+    threads: list[threading.Thread] = []
+    app = TimeoutApp()
+    assert app.run(headless=True) == 6
+
+    assert_threads_finished(threads)
+    assert len(errors) == 1
+    assert str(errors[0]) == "request timed out"
+    assert errors[0].args == ("request timed out",)
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable() -> None:
+    """A variadic callable receives every supplied positional argument."""
+    results: list[object] = []
+
+    class VariadicApp(App[int]):
+        def on_mount(self) -> None:
+            def collect(*values: object) -> tuple[object, ...]:
+                return values
+
+            def worker() -> None:
+                results.append(self.call_from_thread(collect, 1, 2, 3))
+                self.call_from_thread(self.exit, 8)
+
+            thread = threading.Thread(target=worker, daemon=True)
+            threads.append(thread)
+            thread.start()
+
+    threads: list[threading.Thread] = []
+    app = VariadicApp()
+    assert app.run(headless=True) == 8
+
+    assert_threads_finished(threads)
+    assert results == [(1, 2, 3)]
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_parameters() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+    results: list[object] = []
+
+    class KeywordApp(App[int]):
+        def on_mount(self) -> None:
+            def add(*, left: int, right: int) -> int:
+                return left + right
+
+            def worker() -> None:
+                results.append(self.call_from_thread(add, left=1, right=2))
+                self.call_from_thread(self.exit, 9)
+
+            thread = threading.Thread(target=worker, daemon=True)
+            threads.append(thread)
+            thread.start()
+
+    threads: list[threading.Thread] = []
+    app = KeywordApp()
+    assert app.run(headless=True) == 9
+
+    assert_threads_finished(threads)
+    assert results == [3]
+
+
+def test_call_from_thread_exit_from_background_thread_returns_exit_value() -> None:
+    """A background thread calling exit through the method makes run return the value."""
+
+    class ExitApp(App[str]):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                self.call_from_thread(self.exit, "bye")
+
+            thread = threading.Thread(target=worker, daemon=True)
+            threads.append(thread)
+            thread.start()
+
+    threads: list[threading.Thread] = []
+    app = ExitApp()
+    assert app.run(headless=True) == "bye"
+
+    assert_threads_finished(threads)
