diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..94b7f94
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,203 @@
+from __future__ import annotations
+
+import concurrent.futures
+import threading
+from typing import Any, Callable
+
+from textual.app import App
+from textual.widgets import TextLog
+
+# Upper bound on how long the test's main thread waits for a background thread.
+JOIN_TIMEOUT = 10.0
+
+
+class ThreadedApp(App[Any]):
+    """An app that runs a target function on a daemon thread once mounted.
+
+    The target receives the app and returns the exit value. The thread then
+    exits the app through `call_from_thread`, so the app is never stopped by
+    the main thread.
+    """
+
+    def __init__(self, target: Callable[[ThreadedApp], Any]) -> None:
+        super().__init__()
+        self._target = target
+        self.thread = threading.Thread(target=self._run_target, daemon=True)
+        self.thread_error: BaseException | None = None
+
+    def compose(self):
+        yield TextLog()
+
+    def on_mount(self) -> None:
+        self.thread.start()
+
+    def _run_target(self) -> None:
+        exit_value: Any = None
+        try:
+            exit_value = self._target(self)
+        except BaseException as error:
+            self.thread_error = error
+        self.call_from_thread(self.exit, exit_value)
+
+
+def run_threaded_app(target: Callable[[ThreadedApp], Any]) -> tuple[ThreadedApp, Any]:
+    """Run a ThreadedApp headless, then check its thread finished cleanly."""
+    app = ThreadedApp(target)
+    return_value = app.run(headless=True)
+    app.thread.join(JOIN_TIMEOUT)
+    assert not app.thread.is_alive(), "background thread did not finish"
+    assert app.thread_error is None, f"background thread raised {app.thread_error!r}"
+    return app, return_value
+
+
+def test_call_from_thread_before_run_raises_app_not_running() -> None:
+    app = App()
+    try:
+        app.call_from_thread(lambda: None)
+    except RuntimeError as error:
+        assert str(error) == "App is not running"
+    else:
+        raise AssertionError("expected RuntimeError before the app runs")
+
+
+def test_call_from_thread_after_run_raises_app_not_running_without_blocking() -> None:
+    class QuitImmediatelyApp(App[None]):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = QuitImmediatelyApp()
+    app.run(headless=True)
+
+    outcome: dict[str, str] = {}
+
+    def call_after_stop() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            outcome["message"] = str(error)
+
+    # The call happens on a separate thread after run returned; the bounded
+    # join proves it did not block.
+    thread = threading.Thread(target=call_after_stop, daemon=True)
+    thread.start()
+    thread.join(JOIN_TIMEOUT)
+    assert not thread.is_alive(), "call after the app stopped blocked"
+    assert outcome == {"message": "App is not running"}
+
+
+def test_call_from_thread_on_app_thread_raises_different_thread_error() -> None:
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.same_thread_message = str(error)
+            self.exit()
+
+    app = SameThreadApp()
+    app.run(headless=True)
+
+    message = app.same_thread_message
+    assert "must run in a different thread from the app" in message
+    assert "not running" not in message
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    observed: dict[str, int] = {}
+
+    def target(app: ThreadedApp) -> int:
+        observed["result"] = app.call_from_thread(lambda: 6 * 7)
+        return observed["result"]
+
+    _, return_value = run_threaded_app(target)
+    assert observed == {"result": 42}
+    assert return_value == 42
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    observed: dict[str, int] = {}
+
+    async def double(value: int) -> int:
+        return value * 2
+
+    def target(app: ThreadedApp) -> int:
+        observed["result"] = app.call_from_thread(double, 21)
+        return observed["result"]
+
+    _, return_value = run_threaded_app(target)
+    assert observed == {"result": 42}
+    assert return_value == 42
+
+
+def test_call_from_thread_widget_access_completes_and_app_exits_with_code() -> None:
+    observed: dict[str, bool] = {}
+
+    def target(app: ThreadedApp) -> int:
+        def write_to_log() -> None:
+            text_log = app.query_one(TextLog)
+            text_log.write("hello from a thread")
+            observed["completed"] = True
+
+        app.call_from_thread(write_to_log)
+        return 7
+
+    _, return_value = run_threaded_app(target)
+    assert observed == {"completed": True}
+    assert return_value == 7
+
+
+def test_call_from_thread_forwards_variadic_and_keyword_arguments() -> None:
+    observed: dict[str, Any] = {}
+
+    def collect_variadic(*values: int) -> tuple[int, ...]:
+        return values
+
+    def collect_named(first: str, second: str) -> tuple[str, str]:
+        return first, second
+
+    def target(app: ThreadedApp) -> int:
+        observed["variadic"] = app.call_from_thread(collect_variadic, 1, 2, 3)
+        observed["named"] = app.call_from_thread(collect_named, "x", second="y")
+        return 0
+
+    _, return_value = run_threaded_app(target)
+    assert observed == {"variadic": (1, 2, 3), "named": ("x", "y")}
+    assert return_value == 0
+
+
+def test_call_from_thread_propagates_timeout_exception_and_returns() -> None:
+    observed: dict[str, Any] = {}
+
+    def raise_timeout() -> None:
+        raise concurrent.futures.TimeoutError("request timed out", 5)
+
+    def target(app: ThreadedApp) -> int:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            observed["args"] = error.args
+            observed["message"] = str(error)
+        return 1
+
+    _, return_value = run_threaded_app(target)
+    assert observed["args"] == ("request timed out", 5)
+    assert "request timed out" in observed["message"]
+    assert return_value == 1
+
+
+def test_call_from_thread_propagates_value_error_with_same_message() -> None:
+    observed: dict[str, Any] = {}
+
+    def raise_value_error() -> None:
+        raise ValueError("bad input", 3)
+
+    def target(app: ThreadedApp) -> int:
+        try:
+            app.call_from_thread(raise_value_error)
+        except ValueError as error:
+            observed["args"] = error.args
+        return 2
+
+    _, return_value = run_threaded_app(target)
+    assert observed == {"args": ("bad input", 3)}
+    assert return_value == 2
