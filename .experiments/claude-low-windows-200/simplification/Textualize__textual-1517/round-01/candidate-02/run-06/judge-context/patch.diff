+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, in the context of the app.
+
+        Textual objects are not thread-safe. This call ensures that the callable
+        runs in the correct context (with the app as the active app). The call
+        blocks until the callable returns, and its result is returned.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable returning a value, or an awaitable of a value. It is called
+                with the supplied positional and keyword arguments.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including after it has stopped),
+                or if called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callable in the app's context on the app's loop."""
+            self._set_active()
+            return await invoke(partial(callback, *args, **kwargs))
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), self._loop
+        )
+        return future.result()
