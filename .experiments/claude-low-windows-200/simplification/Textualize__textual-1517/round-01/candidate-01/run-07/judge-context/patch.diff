+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the context of the app, so it is safe to call app and widget methods from
+        a thread other than the app thread. The call blocks until the callable returns.
+
+        Args:
+            callback (Callable[..., Awaitable[CallThreadReturnType] | CallThreadReturnType]):
+                A callable to run in the app's context. It may return a value or an
+                awaitable of a value.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it starts, or after it has stopped).
+            RuntimeError: If called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Make the app active, then run the callable and await it if needed."""
+            self._set_active()
+            return await invoke(callback_with_args)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), self._loop
+        )
+        return future.result()
