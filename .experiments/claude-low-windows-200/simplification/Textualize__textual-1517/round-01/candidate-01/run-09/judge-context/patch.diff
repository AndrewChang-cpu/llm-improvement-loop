diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..ea70cae
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,168 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5.0
+
+
+class ThreadedApp(App[int]):
+    """An app that starts a single background thread from its mount hook."""
+
+    def __init__(self, target: Callable[[ThreadedApp], None]) -> None:
+        super().__init__()
+        self.target = target
+        self.thread: threading.Thread | None = None
+
+    def on_mount(self) -> None:
+        self.thread = threading.Thread(target=self.target, args=(self,), daemon=True)
+        self.thread.start()
+
+
+def run_and_join(app: App[Any]) -> Any:
+    """Run the app headlessly, then assert any background thread has finished."""
+    return_value = app.run(headless=True, size=(80, 24))
+    thread = getattr(app, "thread", None)
+    if thread is not None:
+        thread.join(JOIN_TIMEOUT)
+        assert not thread.is_alive()
+    return return_value
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error() -> None:
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(3)
+
+    assert run_and_join(SameThreadApp()) == 3
+    assert len(errors) == 1
+    assert "different thread from the app" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_writes_to_text_log_widget() -> None:
+    results: dict[str, Any] = {}
+
+    def target(app: ThreadedApp) -> None:
+        def write_to_log() -> str:
+            log = app.query_one(TextLog)
+            log.write("hello from thread")
+            return "written"
+
+        results["value"] = app.call_from_thread(write_to_log)
+        app.call_from_thread(app.exit, 7)
+
+    class LogApp(ThreadedApp):
+        def compose(self):
+            yield TextLog()
+
+    app = LogApp(target)
+    assert run_and_join(app) == 7
+    assert results["value"] == "written"
+
+
+def test_call_from_thread_returns_awaited_result() -> None:
+    results: dict[str, Any] = {}
+
+    async def coroutine_callable(value: int) -> int:
+        return value * 2
+
+    def target(app: ThreadedApp) -> None:
+        results["value"] = app.call_from_thread(coroutine_callable, 21)
+        app.call_from_thread(app.exit, 1)
+
+    assert run_and_join(ThreadedApp(target)) == 1
+    assert results["value"] == 42
+
+
+def test_call_from_thread_propagates_timeout_exception_message_and_args() -> None:
+    results: dict[str, Any] = {}
+
+    def raise_timeout() -> None:
+        raise TimeoutError("third-party timeout")
+
+    def target(app: ThreadedApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            results["message"] = str(error)
+            results["args"] = error.args
+        app.call_from_thread(app.exit, 5)
+
+    assert run_and_join(ThreadedApp(target)) == 5
+    assert results["message"] == "third-party timeout"
+    assert results["args"] == ("third-party timeout",)
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable() -> None:
+    results: dict[str, Any] = {}
+
+    def collect(*values: int, **options: str) -> tuple:
+        return values, options
+
+    def target(app: ThreadedApp) -> None:
+        results["value"] = app.call_from_thread(collect, 1, 2, 3, label="x")
+        app.call_from_thread(app.exit, 2)
+
+    assert run_and_join(ThreadedApp(target)) == 2
+    assert results["value"] == ((1, 2, 3), {"label": "x"})
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_parameters() -> None:
+    results: dict[str, Any] = {}
+
+    def combine(first: str, second: str = "") -> str:
+        return first + second
+
+    def target(app: ThreadedApp) -> None:
+        results["value"] = app.call_from_thread(combine, first="a", second="b")
+        app.call_from_thread(app.exit, 4)
+
+    assert run_and_join(ThreadedApp(target)) == 4
+    assert results["value"] == "ab"
+
+
+def test_call_from_thread_exit_from_thread_returns_exit_value() -> None:
+    def target(app: ThreadedApp) -> None:
+        app.call_from_thread(app.exit, 9)
+
+    assert run_and_join(ThreadedApp(target)) == 9
+
+
+def test_call_from_thread_after_run_returned_raises_not_running() -> None:
+    results: dict[str, BaseException] = {}
+
+    def target(app: ThreadedApp) -> None:
+        app.call_from_thread(app.exit, 6)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 6
+
+    def call_after_stop() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            results["error"] = error
+
+    after_thread = threading.Thread(target=call_after_stop, daemon=True)
+    after_thread.start()
+    after_thread.join(JOIN_TIMEOUT)
+    assert not after_thread.is_alive()
+    assert "App is not running" in str(results["error"])
