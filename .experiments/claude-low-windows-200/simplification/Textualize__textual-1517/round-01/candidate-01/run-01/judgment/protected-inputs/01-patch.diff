diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..46fc325
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,181 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5
+
+
+class ThreadedApp(App[int]):
+    """An app that starts a background thread once it has mounted."""
+
+    def __init__(self, thread_target: Callable[[ThreadedApp], None]) -> None:
+        self.thread_target = thread_target
+        self.thread: threading.Thread | None = None
+        self.outcomes: dict[str, Any] = {}
+        super().__init__()
+
+    def compose(self):
+        yield TextLog()
+
+    def on_mount(self) -> None:
+        self.thread = threading.Thread(target=self.thread_target, args=(self,))
+        self.thread.daemon = True
+        self.thread.start()
+
+
+def run_and_join(app: ThreadedApp) -> int | None:
+    """Run the app headlessly, then check its background thread has finished."""
+    result = app.run(headless=True)
+    assert app.thread is not None
+    app.thread.join(JOIN_TIMEOUT)
+    assert not app.thread.is_alive()
+    return result
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """Calling call_from_thread before the app runs raises 'App is not running'."""
+    app = ThreadedApp(lambda app: None)
+    with pytest.raises(RuntimeError, match="^App is not running$"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_returns_raises_not_running() -> None:
+    """Calling call_from_thread after run has returned raises and does not block."""
+    def target(app: ThreadedApp) -> None:
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 0
+    with pytest.raises(RuntimeError, match="^App is not running$"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_on_app_thread_raises_runtime_error() -> None:
+    """Calling call_from_thread from the app thread raises a RuntimeError."""
+
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            self.error: RuntimeError | None = None
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.error = error
+            self.exit()
+
+    app = SameThreadApp()
+    app.run(headless=True)
+    assert app.error is not None
+    assert "different thread from the app" in str(app.error)
+    assert "not running" not in str(app.error)
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    """The value returned by the callable is returned to the calling thread."""
+
+    def target(app: ThreadedApp) -> None:
+        app.outcomes["result"] = app.call_from_thread(lambda: 123)
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 0
+    assert app.outcomes["result"] == 123
+
+
+def test_call_from_thread_writes_to_widget_in_app() -> None:
+    """A callable that accesses widgets through the app completes without error."""
+
+    def target(app: ThreadedApp) -> None:
+        def write_to_log() -> str:
+            log = app.query_one(TextLog)
+            log.write("written from thread")
+            return "done"
+
+        app.outcomes["result"] = app.call_from_thread(write_to_log)
+        app.call_from_thread(app.exit, 5)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 5
+    assert app.outcomes["result"] == "done"
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+
+    async def double(value: int) -> int:
+        return value * 2
+
+    def target(app: ThreadedApp) -> None:
+        app.outcomes["result"] = app.call_from_thread(double, 21)
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 0
+    assert app.outcomes["result"] == 42
+
+
+def test_call_from_thread_reraises_timeout_exception_with_same_message() -> None:
+    """A timeout-class exception from the callable is re-raised on the calling thread."""
+
+    def raise_timeout() -> None:
+        raise TimeoutError("timed out waiting")
+
+    def target(app: ThreadedApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            app.outcomes["error"] = error
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 0
+    error = app.outcomes["error"]
+    assert str(error) == "timed out waiting"
+    assert error.args == ("timed out waiting",)
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable() -> None:
+    """A variadic callable receives every supplied positional argument."""
+
+    def collect(*values: int) -> tuple[int, ...]:
+        return values
+
+    def target(app: ThreadedApp) -> None:
+        app.outcomes["result"] = app.call_from_thread(collect, 1, 2, 3, 4)
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 0
+    assert app.outcomes["result"] == (1, 2, 3, 4)
+
+
+def test_call_from_thread_forwards_keyword_arguments() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+
+    def combine(first: str, second: str) -> str:
+        return f"{first}-{second}"
+
+    def target(app: ThreadedApp) -> None:
+        app.outcomes["result"] = app.call_from_thread(
+            combine, first="a", second="b"
+        )
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 0
+    assert app.outcomes["result"] == "a-b"
+
+
+def test_background_thread_exit_returns_exit_value_from_run() -> None:
+    """A background thread that exits the app causes run to return the exit value."""
+
+    def target(app: ThreadedApp) -> None:
+        app.call_from_thread(app.exit, 9)
+
+    app = ThreadedApp(target)
+    assert run_and_join(app) == 9
