diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..1b26a1b
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,156 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual import events
+from textual.app import App, ComposeResult
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5
+
+
+class ThreadApp(App[int]):
+    """An app that starts a daemon worker thread once it is mounted."""
+
+    def __init__(self, worker: Callable[[ThreadApp], None]) -> None:
+        super().__init__()
+        self.worker = worker
+        self.outcome: dict[str, Any] = {}
+        self.worker_thread: threading.Thread | None = None
+
+    def compose(self) -> ComposeResult:
+        yield TextLog()
+
+    def on_mount(self, event: events.Mount) -> None:
+        self.worker_thread = threading.Thread(
+            target=self.worker, args=(self,), daemon=True
+        )
+        self.worker_thread.start()
+
+
+def run_thread_app(worker: Callable[[ThreadApp], None]) -> tuple[ThreadApp, Any]:
+    """Run a ThreadApp headless, join its worker thread, and return the app and run result."""
+    app = ThreadApp(worker)
+    result = app.run(headless=True)
+    assert app.worker_thread is not None
+    app.worker_thread.join(JOIN_TIMEOUT)
+    assert not app.worker_thread.is_alive()
+    return app, result
+
+
+def test_call_from_thread_not_running_before_run_raises():
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_returns_raises_without_blocking():
+    def worker(app: ThreadApp) -> None:
+        app.call_from_thread(app.exit, 3)
+
+    app, result = run_thread_app(worker)
+    assert result == 3
+
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread_raises_runtime_error():
+    class SameThreadApp(App[None]):
+        def on_mount(self, event: events.Mount) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.caught_message = str(error)
+            self.exit()
+
+    app = SameThreadApp()
+    app.run(headless=True)
+    assert app.caught_message == (
+        "The `call_from_thread` method must run in a different thread from the app"
+    )
+
+
+def test_call_from_thread_callable_writes_to_widget():
+    def worker(app: ThreadApp) -> None:
+        def write_to_log() -> None:
+            app.query_one(TextLog).write("hello from thread")
+
+        app.call_from_thread(write_to_log)
+        app.call_from_thread(app.exit, 0)
+
+    app, result = run_thread_app(worker)
+    assert result == 0
+
+
+def test_call_from_thread_returns_result_of_callable():
+    def worker(app: ThreadApp) -> None:
+        app.outcome["value"] = app.call_from_thread(lambda: 17)
+        app.call_from_thread(app.exit, 0)
+
+    app, result = run_thread_app(worker)
+    assert app.outcome["value"] == 17
+
+
+def test_call_from_thread_awaits_awaitable_result():
+    async def coroutine_callable() -> str:
+        return "awaited value"
+
+    def worker(app: ThreadApp) -> None:
+        app.outcome["value"] = app.call_from_thread(coroutine_callable)
+        app.call_from_thread(app.exit, 0)
+
+    app, result = run_thread_app(worker)
+    assert app.outcome["value"] == "awaited value"
+
+
+def test_call_from_thread_reraises_timeout_error_with_same_message_and_args():
+    def raise_timeout() -> None:
+        raise TimeoutError("operation timed out", 5)
+
+    def worker(app: ThreadApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            app.outcome["message"] = str(error)
+            app.outcome["args"] = error.args
+        app.call_from_thread(app.exit, 0)
+
+    app, result = run_thread_app(worker)
+    assert app.outcome["message"] == str(TimeoutError("operation timed out", 5))
+    assert app.outcome["args"] == ("operation timed out", 5)
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable():
+    def collect(*values: Any, **named: Any) -> tuple[tuple[Any, ...], dict[str, Any]]:
+        return values, named
+
+    def worker(app: ThreadApp) -> None:
+        app.outcome["value"] = app.call_from_thread(collect, 1, 2, 3)
+        app.call_from_thread(app.exit, 0)
+
+    app, result = run_thread_app(worker)
+    assert app.outcome["value"] == ((1, 2, 3), {})
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_parameters():
+    def combine(first: int, second: int) -> int:
+        return first * 10 + second
+
+    def worker(app: ThreadApp) -> None:
+        app.outcome["value"] = app.call_from_thread(combine, second=4, first=2)
+        app.call_from_thread(app.exit, 0)
+
+    app, result = run_thread_app(worker)
+    assert app.outcome["value"] == 24
+
+
+def test_call_from_thread_exit_from_worker_returns_exit_value():
+    def worker(app: ThreadApp) -> None:
+        app.call_from_thread(app.exit, 42)
+
+    app, result = run_thread_app(worker)
+    assert result == 42
