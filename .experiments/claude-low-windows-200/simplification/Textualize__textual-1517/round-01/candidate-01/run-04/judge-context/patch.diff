+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in
+        the correct context (with the app as the active app), so it is safe to call
+        app and widget methods from a non-app thread. The call blocks until the
+        callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. It may return a value or an
+                awaitable of a value. All ``args`` and ``kwargs`` are forwarded to it unchanged.
+            *args: Positional arguments to forward to the callable.
+            **kwargs: Keyword arguments to forward to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it starts and
+                after it has stopped).
+            RuntimeError: If called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._thread_loop is None:
+            raise RuntimeError("App is not running")
+        if self._thread_id == threading.get_ident():
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callback in the app's context."""
+            self._set_active()
+            return await invoke(partial(callback, *args, **kwargs))
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._thread_loop)
+        return future.result()
