diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..f445047
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,196 @@
+from __future__ import annotations
+
+import asyncio
+import concurrent.futures
+import threading
+from typing import Any, Callable
+
+from textual.app import App, ComposeResult
+from textual.widgets import TextLog
+
+THREAD_JOIN_TIMEOUT = 5
+
+
+class ThreadedApp(App[int]):
+    """An app with a TextLog that starts a daemon background thread from on_mount."""
+
+    def __init__(self, work: Callable[["ThreadedApp"], None]) -> None:
+        self.work = work
+        self.threads: list[threading.Thread] = []
+        self.thread_error: BaseException | None = None
+        super().__init__()
+
+    def compose(self) -> ComposeResult:
+        yield TextLog()
+
+    def on_mount(self) -> None:
+        thread = threading.Thread(target=self._run_work, daemon=True)
+        self.threads.append(thread)
+        thread.start()
+
+    def _run_work(self) -> None:
+        """Run the work; on failure, record the error and exit so run() cannot hang."""
+        try:
+            self.work(self)
+        except BaseException as error:
+            self.thread_error = error
+            try:
+                self.call_from_thread(self.exit, 1)
+            except RuntimeError:
+                pass
+
+
+def run_and_join(app: ThreadedApp) -> Any:
+    """Run the app headless, then check every background thread has finished."""
+    result = app.run(headless=True)
+    for thread in app.threads:
+        thread.join(THREAD_JOIN_TIMEOUT)
+        assert not thread.is_alive(), "background thread did not finish"
+    assert app.thread_error is None, f"background work failed: {app.thread_error!r}"
+    return result
+
+
+def test_call_from_thread_not_running_before_run_raises() -> None:
+    """Calling before the app has started raises 'App is not running'."""
+    app = App()
+    try:
+        app.call_from_thread(lambda: None)
+    except RuntimeError as error:
+        assert str(error) == "App is not running"
+    else:
+        raise AssertionError("expected RuntimeError")
+
+
+def test_call_from_thread_same_thread_raises() -> None:
+    """Calling from the app thread raises a different-thread RuntimeError."""
+    errors: list[RuntimeError] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(1)
+
+    app = SameThreadApp()
+    assert app.run(headless=True) == 1
+    assert len(errors) == 1
+    assert "different thread from the app" in str(errors[0])
+
+
+def test_call_from_thread_widget_write_completes() -> None:
+    """A callable that writes to a TextLog through the app completes and the app exits."""
+    outcome: dict[str, Any] = {}
+
+    def work(app: ThreadedApp) -> None:
+        def write_to_log() -> str:
+            app.query_one(TextLog).write("hello from thread")
+            return "written"
+
+        outcome["result"] = app.call_from_thread(write_to_log)
+        app.call_from_thread(app.exit, 3)
+
+    app = ThreadedApp(work)
+    assert run_and_join(app) == 3
+    assert outcome["result"] == "written"
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result returned."""
+    outcome: dict[str, Any] = {}
+
+    async def compute(value: int) -> int:
+        await asyncio.sleep(0)
+        return value * 2
+
+    def work(app: ThreadedApp) -> None:
+        outcome["result"] = app.call_from_thread(compute, 21)
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(work)
+    assert run_and_join(app) == 0
+    assert outcome["result"] == 42
+
+
+def test_call_from_thread_reraises_timeout_error_message_and_args() -> None:
+    """A timeout-class exception reaches the calling thread with the same message and args."""
+    outcome: dict[str, Any] = {}
+
+    def raise_timeout() -> None:
+        raise concurrent.futures.TimeoutError("timed out")
+
+    def work(app: ThreadedApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            outcome["error"] = error
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(work)
+    assert run_and_join(app) == 0
+    error = outcome["error"]
+    assert str(error) == "timed out"
+    assert error.args == ("timed out",)
+
+
+def test_call_from_thread_forwards_positional_and_keyword_args_to_variadic() -> None:
+    """A variadic callable receives every positional and keyword argument supplied."""
+    outcome: dict[str, Any] = {}
+
+    def collect(*values: Any, **options: Any) -> tuple:
+        return values, options
+
+    def work(app: ThreadedApp) -> None:
+        outcome["result"] = app.call_from_thread(collect, 1, 2, 3, flag=True)
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(work)
+    assert run_and_join(app) == 0
+    assert outcome["result"] == ((1, 2, 3), {"flag": True})
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_parameters() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+    outcome: dict[str, Any] = {}
+
+    def combine(first: str, second: str = "", *, suffix: str = "") -> str:
+        return first + second + suffix
+
+    def work(app: ThreadedApp) -> None:
+        outcome["result"] = app.call_from_thread(
+            combine, "a", second="b", suffix="c"
+        )
+        app.call_from_thread(app.exit, 0)
+
+    app = ThreadedApp(work)
+    assert run_and_join(app) == 0
+    assert outcome["result"] == "abc"
+
+
+def test_call_from_thread_after_run_returns_raises_not_running() -> None:
+    """After run has returned, a call raises 'App is not running' without blocking."""
+
+    class ExitOnMountApp(App[None]):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = ExitOnMountApp()
+    assert app.run(headless=True) is None
+
+    try:
+        app.call_from_thread(lambda: None)
+    except RuntimeError as error:
+        assert str(error) == "App is not running"
+    else:
+        raise AssertionError("expected RuntimeError")
+
+
+def test_call_from_thread_exit_from_background_thread_returns_exit_value() -> None:
+    """A background thread that exits the app through call_from_thread makes run return its value."""
+
+    def work(app: ThreadedApp) -> None:
+        app.call_from_thread(app.exit, 7)
+
+    app = ThreadedApp(work)
+    assert run_and_join(app) == 7
