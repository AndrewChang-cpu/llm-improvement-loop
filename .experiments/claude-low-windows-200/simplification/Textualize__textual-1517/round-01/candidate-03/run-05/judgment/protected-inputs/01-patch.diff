+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from another thread, and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (the app's event loop and active app), so it is safe
+        to call from a thread other than the app's thread. The call blocks until the
+        callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. It may return a value or an
+                awaitable of a value; an awaitable is awaited before the result is returned.
+            *args: Positional arguments forwarded unchanged to ``callback``.
+            **kwargs: Keyword arguments forwarded unchanged to ``callback``.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it starts and
+                after it has stopped), or if called from the app's thread.
+
+        Returns:
+            CallThreadReturnType: The result of ``callback``.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        # Bind the arguments first, so invoke() needs no arguments from us.
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callable inside the app's event loop."""
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
