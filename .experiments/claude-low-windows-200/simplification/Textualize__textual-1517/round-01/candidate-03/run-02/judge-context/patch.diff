diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..7e6b3cd
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,214 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+THREAD_JOIN_TIMEOUT = 5
+
+
+class ThreadApp(App[int]):
+    """An app that starts a daemon background thread from its ready hook."""
+
+    def __init__(self, worker: Callable[[ThreadApp], None]) -> None:
+        self._worker = worker
+        self.worker_thread: threading.Thread | None = None
+        super().__init__()
+
+    def compose(self):
+        yield TextLog()
+
+    def on_ready(self) -> None:
+        self.worker_thread = threading.Thread(
+            target=self._worker, args=(self,), daemon=True
+        )
+        self.worker_thread.start()
+
+
+def run_with_worker(
+    worker: Callable[[ThreadApp], None]
+) -> tuple[ThreadApp, int | None]:
+    """Run a ThreadApp headlessly and check its background thread finished."""
+    app = ThreadApp(worker)
+    return_value = app.run(headless=True)
+    assert app.worker_thread is not None
+    app.worker_thread.join(THREAD_JOIN_TIMEOUT)
+    assert not app.worker_thread.is_alive()
+    return app, return_value
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """A call made before the app runs raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises_not_running() -> None:
+    """A call made after run has returned raises 'App is not running' without blocking."""
+    class ExitImmediatelyApp(App[int]):
+        def on_ready(self) -> None:
+            self.exit(0)
+
+    app = ExitImmediatelyApp()
+    assert app.run(headless=True) == 0
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error() -> None:
+    """A call made from the app thread raises a runtime error."""
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App[int]):
+        def on_ready(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(3)
+
+    app = SameThreadApp()
+    assert app.run(headless=True) == 3
+    assert len(errors) == 1
+    assert "must run in a different thread from the app" in str(errors[0])
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    """A background thread receives the value returned by the callable."""
+    received: list[Any] = []
+
+    def worker(app: ThreadApp) -> None:
+        try:
+            received.append(app.call_from_thread(lambda: "result-value"))
+        finally:
+            app.call_from_thread(app.exit, 4)
+
+    _, return_value = run_with_worker(worker)
+    assert received == ["result-value"]
+    assert return_value == 4
+
+
+def test_call_from_thread_writes_to_widget_in_app() -> None:
+    """A callable that accesses a widget through the app completes without error."""
+    outcome: list[str] = []
+
+    def write_to_log() -> None:
+        app_log = app_holder[0].query_one(TextLog)
+        app_log.write("hello from thread")
+        outcome.append("written")
+
+    app_holder: list[ThreadApp] = []
+
+    def worker(app: ThreadApp) -> None:
+        app_holder.append(app)
+        try:
+            app.call_from_thread(write_to_log)
+        finally:
+            app.call_from_thread(app.exit, 5)
+
+    _, return_value = run_with_worker(worker)
+    assert outcome == ["written"]
+    assert return_value == 5
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable that returns an awaitable is awaited and its result returned."""
+    received: list[Any] = []
+
+    async def produce_value() -> str:
+        return "awaited-value"
+
+    def worker(app: ThreadApp) -> None:
+        try:
+            received.append(app.call_from_thread(produce_value))
+        finally:
+            app.call_from_thread(app.exit, 6)
+
+    _, return_value = run_with_worker(worker)
+    assert received == ["awaited-value"]
+    assert return_value == 6
+
+
+def test_call_from_thread_reraises_timeout_error_on_calling_thread() -> None:
+    """A timeout-class exception is re-raised on the calling thread and the call returns."""
+    caught: list[BaseException] = []
+
+    def raise_timeout() -> None:
+        raise TimeoutError("slow operation")
+
+    def worker(app: ThreadApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            caught.append(error)
+        finally:
+            app.call_from_thread(app.exit, 2)
+
+    _, return_value = run_with_worker(worker)
+    assert len(caught) == 1
+    assert str(caught[0]) == "slow operation"
+    assert return_value == 2
+
+
+def test_call_from_thread_forwards_all_arguments_to_variadic_callable() -> None:
+    """A variadic callable receives every supplied positional and keyword argument."""
+    received: list[Any] = []
+
+    def collect(*args: Any, **kwargs: Any) -> tuple[tuple[Any, ...], dict[str, Any]]:
+        return args, kwargs
+
+    def worker(app: ThreadApp) -> None:
+        try:
+            received.append(app.call_from_thread(collect, 1, 2, 3, flag="yes"))
+        finally:
+            app.call_from_thread(app.exit, 8)
+
+    _, return_value = run_with_worker(worker)
+    assert received == [((1, 2, 3), {"flag": "yes"})]
+    assert return_value == 8
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+    received: list[Any] = []
+
+    def combine(first: int, second: int, *, scale: int) -> int:
+        return (first + second) * scale
+
+    def worker(app: ThreadApp) -> None:
+        try:
+            received.append(app.call_from_thread(combine, 1, 2, scale=10))
+        finally:
+            app.call_from_thread(app.exit, 9)
+
+    _, return_value = run_with_worker(worker)
+    assert received == [30]
+    assert return_value == 9
+
+
+def test_call_from_thread_after_app_stopped_does_not_block() -> None:
+    """A call made after the app has stopped raises 'App is not running' and returns."""
+    def worker(app: ThreadApp) -> None:
+        app.call_from_thread(app.exit, 1)
+
+    app, return_value = run_with_worker(worker)
+    assert return_value == 1
+
+    # The app has stopped; the not-running check must reject this call immediately.
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_exit_from_background_thread_returns_exit_value() -> None:
+    """A background thread exiting the app through call_from_thread makes run return the value."""
+
+    def worker(app: ThreadApp) -> None:
+        app.call_from_thread(app.exit, 42)
+
+    _, return_value = run_with_worker(worker)
+    assert return_value == 42
