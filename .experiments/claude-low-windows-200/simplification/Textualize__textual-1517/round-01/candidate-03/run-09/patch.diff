diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..daff120
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,189 @@
+from __future__ import annotations
+
+import threading
+from typing import Any
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+THREAD_JOIN_TIMEOUT = 5
+
+
+def run_in_daemon_thread(target, *args: Any) -> threading.Thread:
+    thread = threading.Thread(target=target, args=args, daemon=True)
+    thread.start()
+    return thread
+
+
+def assert_threads_finished(threads: list[threading.Thread]) -> None:
+    for thread in threads:
+        thread.join(THREAD_JOIN_TIMEOUT)
+        assert not thread.is_alive()
+
+
+def test_call_from_thread_not_running() -> None:
+    """Calling before the app runs raises the not running error."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread() -> None:
+    """Calling from the app thread raises a runtime error about the thread."""
+
+    class SameThreadApp(App[dict]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.exit({"message": str(error)})
+            else:
+                self.exit({"message": None})
+
+    app = SameThreadApp()
+    result = app.run(headless=True)
+    assert result is not None
+    assert result["message"] == (
+        "The `call_from_thread` method must run in a different thread from the app"
+    )
+
+
+def test_call_from_thread_widget_access() -> None:
+    """A callable touching a widget through the app completes without error."""
+    errors: list[BaseException] = []
+
+    class WidgetApp(App[int]):
+        def compose(self):
+            yield TextLog(id="log")
+
+        def on_mount(self) -> None:
+            def write_to_log() -> None:
+                self.query_one("#log", TextLog).write("hello from thread")
+
+            def worker() -> None:
+                try:
+                    self.call_from_thread(write_to_log)
+                    self.call_from_thread(self.exit, 3)
+                except BaseException as error:
+                    errors.append(error)
+                    self.call_from_thread(self.exit, -1)
+
+            threads.append(run_in_daemon_thread(worker))
+
+    threads: list[threading.Thread] = []
+    app = WidgetApp()
+    result = app.run(headless=True)
+    assert_threads_finished(threads)
+    assert errors == []
+    assert result == 3
+
+
+def test_call_from_thread_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result returned."""
+    results: list[Any] = []
+
+    class AwaitableApp(App[int]):
+        def on_mount(self) -> None:
+            async def coro_callable() -> str:
+                return "awaited value"
+
+            def worker() -> None:
+                results.append(self.call_from_thread(coro_callable))
+                self.call_from_thread(self.exit, 7)
+
+            threads.append(run_in_daemon_thread(worker))
+
+    threads: list[threading.Thread] = []
+    app = AwaitableApp()
+    result = app.run(headless=True)
+    assert_threads_finished(threads)
+    assert results == ["awaited value"]
+    assert result == 7
+
+
+def test_call_from_thread_propagates_timeout_exception() -> None:
+    """A timeout-class exception raised by the callable reaches the calling thread."""
+    outcomes: list[BaseException] = []
+
+    class TimeoutApp(App[int]):
+        def on_mount(self) -> None:
+            def raise_timeout() -> None:
+                raise TimeoutError("third-party timeout")
+
+            def worker() -> None:
+                try:
+                    self.call_from_thread(raise_timeout)
+                except Exception as error:
+                    outcomes.append(error)
+                self.call_from_thread(self.exit, 5)
+
+            threads.append(run_in_daemon_thread(worker))
+
+    threads: list[threading.Thread] = []
+    app = TimeoutApp()
+    result = app.run(headless=True)
+    assert_threads_finished(threads)
+    assert len(outcomes) == 1
+    assert str(outcomes[0]) == "third-party timeout"
+    assert outcomes[0].args == ("third-party timeout",)
+    assert result == 5
+
+
+def test_call_from_thread_forwards_arguments() -> None:
+    """Positional arguments reach a variadic callable and keywords reach named parameters."""
+    received: dict[str, Any] = {}
+
+    def variadic(*values: Any) -> None:
+        received["values"] = values
+
+    def named(first: int, second: int, *, flag: bool) -> None:
+        received["named"] = (first, second, flag)
+
+    class ArgsApp(App[int]):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                self.call_from_thread(variadic, 1, 2, 3)
+                self.call_from_thread(named, 4, 5, flag=True)
+                self.call_from_thread(self.exit, 9)
+
+            threads.append(run_in_daemon_thread(worker))
+
+    threads: list[threading.Thread] = []
+    app = ArgsApp()
+    result = app.run(headless=True)
+    assert_threads_finished(threads)
+    assert received["values"] == (1, 2, 3)
+    assert received["named"] == (4, 5, True)
+    assert result == 9
+
+
+def test_call_from_thread_after_run_returns() -> None:
+    """A call made after the app's run has returned raises the not running error."""
+
+    class StoppingApp(App[int]):
+        def on_mount(self) -> None:
+            self.exit(1)
+
+    app = StoppingApp()
+    assert app.run(headless=True) == 1
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_exit_from_thread_returns_exit_value() -> None:
+    """A background thread exiting the app through call_from_thread makes run return the value."""
+
+    class ExitFromThreadApp(App[str]):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                self.call_from_thread(self.exit, "exit value")
+
+            threads.append(run_in_daemon_thread(worker))
+
+    threads: list[threading.Thread] = []
+    app = ExitFromThreadApp()
+    result = app.run(headless=True)
+    assert_threads_finished(threads)
+    assert result == "exit value"
