+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, in the context of the app, and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in the
+        correct context (with this app as the active app), so it may be used to safely
+        interact with widgets from a thread other than the app's thread.
+
+        This call blocks the calling thread until the callable returns.
+
+        Args:
+            callback: A callable (or a callable returning an awaitable) to run in the app's
+                context. Every supplied positional and keyword argument is forwarded to it unchanged.
+            *args: Positional arguments to forward to the callable.
+            **kwargs: Keyword arguments to forward to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it starts, or after it has stopped).
+            RuntimeError: If called from the app's thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable, after awaiting it if needed.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callback in the app's event loop, with this app active."""
+            self._set_active()
+            return await invoke(callback_with_args)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), self._loop
+        )
+        return future.result()
+
