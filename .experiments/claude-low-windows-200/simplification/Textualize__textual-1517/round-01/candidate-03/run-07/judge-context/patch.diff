diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..b785c05
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,180 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5.0
+EXIT_VALUE = 7
+
+
+class ThreadApp(App[int]):
+    """An app that starts a daemon background thread from its mount hook."""
+
+    def __init__(self, target: Callable[[ThreadApp], None]) -> None:
+        super().__init__()
+        self.target = target
+        self.threads: list[threading.Thread] = []
+
+    def compose(self):
+        yield TextLog()
+
+    def on_mount(self) -> None:
+        thread = threading.Thread(target=self.target, args=(self,), daemon=True)
+        self.threads.append(thread)
+        thread.start()
+
+
+def run_with_thread(target: Callable[[ThreadApp], None]) -> tuple[ThreadApp, Any]:
+    """Run a ThreadApp headlessly, then check that its background threads finished."""
+    app = ThreadApp(target)
+    result = app.run(headless=True, size=(80, 24))
+    for thread in app.threads:
+        thread.join(JOIN_TIMEOUT)
+        assert not thread.is_alive(), "background thread did not finish"
+    return app, result
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """A call made before the app runs raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises_not_running() -> None:
+    """A call made after run has returned raises 'App is not running' without blocking."""
+    class ExitImmediatelyApp(App[None]):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = ExitImmediatelyApp()
+    app.run(headless=True, size=(80, 24))
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_on_app_thread_raises_runtime_error() -> None:
+    """A call made from the app's own thread raises a RuntimeError about threads."""
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    SameThreadApp().run(headless=True, size=(80, 24))
+    assert len(errors) == 1
+    assert "must run in a different thread from the app" in str(errors[0])
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    """The value returned by the callable is returned to the calling thread."""
+    results: list[object] = []
+
+    def target(app: ThreadApp) -> None:
+        results.append(app.call_from_thread(lambda: "from-callable"))
+        app.call_from_thread(app.exit, EXIT_VALUE)
+
+    _, return_value = run_with_thread(target)
+    assert results == ["from-callable"]
+    assert return_value == EXIT_VALUE
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+    results: list[object] = []
+
+    async def coroutine_callable() -> str:
+        return "awaited"
+
+    def target(app: ThreadApp) -> None:
+        results.append(app.call_from_thread(coroutine_callable))
+        app.call_from_thread(app.exit, EXIT_VALUE)
+
+    run_with_thread(target)
+    assert results == ["awaited"]
+
+
+def test_call_from_thread_widget_access_completes_in_callable() -> None:
+    """A callable that writes to a widget through the app completes without error."""
+    completed: list[bool] = []
+
+    def target(app: ThreadApp) -> None:
+        def write_to_log() -> None:
+            app.query_one(TextLog).write("hello from thread")
+            completed.append(True)
+
+        app.call_from_thread(write_to_log)
+        app.call_from_thread(app.exit, EXIT_VALUE)
+
+    _, return_value = run_with_thread(target)
+    assert completed == [True]
+    assert return_value == EXIT_VALUE
+
+
+def test_call_from_thread_propagates_timeout_exception() -> None:
+    """A timeout-class exception from the callable reaches the calling thread with the same args."""
+    raised: list[BaseException] = []
+
+    def raise_timeout() -> None:
+        raise TimeoutError("timed out", 3)
+
+    def target(app: ThreadApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            raised.append(error)
+        app.call_from_thread(app.exit, EXIT_VALUE)
+
+    _, return_value = run_with_thread(target)
+    assert len(raised) == 1
+    assert raised[0].args == ("timed out", 3)
+    assert return_value == EXIT_VALUE
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable() -> None:
+    """A variadic callable receives every supplied positional argument."""
+    received: list[tuple[object, ...]] = []
+
+    def collect(*values: object) -> None:
+        received.append(values)
+
+    def target(app: ThreadApp) -> None:
+        app.call_from_thread(collect, 1, "two", 3.0)
+        app.call_from_thread(app.exit, EXIT_VALUE)
+
+    run_with_thread(target)
+    assert received == [(1, "two", 3.0)]
+
+
+def test_call_from_thread_forwards_keyword_arguments() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+    received: list[tuple[object, object]] = []
+
+    def collect(*, first: object, second: object) -> None:
+        received.append((first, second))
+
+    def target(app: ThreadApp) -> None:
+        app.call_from_thread(collect, first="a", second="b")
+        app.call_from_thread(app.exit, EXIT_VALUE)
+
+    run_with_thread(target)
+    assert received == [("a", "b")]
+
+
+def test_call_from_thread_exit_returns_exit_value_from_run() -> None:
+    """Exiting the app through call_from_thread makes run return the supplied exit value."""
+
+    def target(app: ThreadApp) -> None:
+        app.call_from_thread(app.exit, EXIT_VALUE)
+
+    _, return_value = run_with_thread(target)
+    assert return_value == EXIT_VALUE
