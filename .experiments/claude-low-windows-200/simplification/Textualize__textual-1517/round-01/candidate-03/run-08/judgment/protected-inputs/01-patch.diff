diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..d8a0a9e
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,192 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5
+
+
+class CallerApp(App[Any]):
+    """An app that runs a target function on a daemon thread once it is ready."""
+
+    def __init__(self, target: Callable[[CallerApp], Any]) -> None:
+        super().__init__()
+        self.target = target
+        self.caller_outcome: dict[str, Any] = {}
+        self.caller_thread = threading.Thread(target=self._run_target, daemon=True)
+
+    def _run_target(self) -> None:
+        try:
+            self.caller_outcome["value"] = self.target(self)
+        except BaseException as error:
+            self.caller_outcome["error"] = error
+            # Make sure the app still exits so the test cannot hang.
+            self.call_from_thread(self.exit)
+
+    def on_ready(self) -> None:
+        self.caller_thread.start()
+
+
+def test_call_from_thread_not_running_before_run() -> None:
+    """A call made before the app runs raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="^App is not running$"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_not_running_after_run_returns() -> None:
+    """A call made after run has returned raises 'App is not running' without blocking."""
+    class ExitApp(App[None]):
+        def on_ready(self) -> None:
+            self.exit()
+
+    exit_app = ExitApp()
+    exit_app.run(headless=True)
+    with pytest.raises(RuntimeError, match="^App is not running$"):
+        exit_app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread_raises() -> None:
+    """Calling from the app thread raises a runtime error about the thread."""
+    errors: list[RuntimeError] = []
+
+    class SameThreadApp(App[None]):
+        def on_ready(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    SameThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert (
+        str(errors[0])
+        == "The `call_from_thread` method must run in a different thread from the app"
+    )
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    """The value returned by the callable is returned to the calling thread."""
+
+    def target(app: CallerApp) -> int:
+        result = app.call_from_thread(lambda: 40 + 2)
+        app.call_from_thread(app.exit)
+        return result
+
+    app = CallerApp(target)
+    app.run(headless=True)
+    app.caller_thread.join(JOIN_TIMEOUT)
+    assert not app.caller_thread.is_alive()
+    assert app.caller_outcome == {"value": 42}
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+
+    async def compute() -> str:
+        return "awaited"
+
+    def target(app: CallerApp) -> str:
+        result = app.call_from_thread(compute)
+        app.call_from_thread(app.exit)
+        return result
+
+    app = CallerApp(target)
+    app.run(headless=True)
+    app.caller_thread.join(JOIN_TIMEOUT)
+    assert not app.caller_thread.is_alive()
+    assert app.caller_outcome == {"value": "awaited"}
+
+
+def test_call_from_thread_widget_access_in_callable() -> None:
+    """A callable that writes to a widget through the app completes without error."""
+
+    class LogApp(CallerApp):
+        def compose(self):
+            yield TextLog(id="log")
+
+    def write_to_log(app: CallerApp) -> None:
+        log = app.get_widget_by_id("log", TextLog)
+        log.write("hello from a thread")
+
+    def target(app: CallerApp) -> None:
+        app.call_from_thread(write_to_log, app)
+        app.call_from_thread(app.exit, "done")
+
+    app = LogApp(target)
+    result = app.run(headless=True)
+    app.caller_thread.join(JOIN_TIMEOUT)
+    assert not app.caller_thread.is_alive()
+    assert "error" not in app.caller_outcome
+    assert result == "done"
+
+
+def test_call_from_thread_propagates_timeout_exception() -> None:
+    """A timeout-class exception raised by the callable reaches the calling thread."""
+
+    def raise_timeout() -> None:
+        raise TimeoutError("timed out after 5 seconds")
+
+    def target(app: CallerApp) -> str:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            message = str(error)
+            args = error.args
+        else:
+            raise AssertionError("expected an exception")
+        app.call_from_thread(app.exit)
+        return f"{message}|{args!r}"
+
+    app = CallerApp(target)
+    app.run(headless=True)
+    app.caller_thread.join(JOIN_TIMEOUT)
+    assert not app.caller_thread.is_alive()
+    assert "error" not in app.caller_outcome
+    assert (
+        app.caller_outcome["value"]
+        == "timed out after 5 seconds|('timed out after 5 seconds',)"
+    )
+
+
+def test_call_from_thread_forwards_arguments_to_variadic_callable() -> None:
+    """All positional arguments reach a variadic callable and keywords reach named parameters."""
+
+    def variadic(*args: Any, **kwargs: Any) -> tuple[tuple[Any, ...], dict[str, Any]]:
+        return args, kwargs
+
+    def named(first: int, second: int, *, third: int) -> int:
+        return first + second + third
+
+    def target(app: CallerApp) -> Any:
+        values = (
+            app.call_from_thread(variadic, 1, 2, 3, key="value"),
+            app.call_from_thread(named, 1, 2, third=3),
+        )
+        app.call_from_thread(app.exit)
+        return values
+
+    app = CallerApp(target)
+    app.run(headless=True)
+    app.caller_thread.join(JOIN_TIMEOUT)
+    assert not app.caller_thread.is_alive()
+    assert app.caller_outcome["value"] == (((1, 2, 3), {"key": "value"}), 6)
+
+
+def test_call_from_thread_exit_returns_exit_value() -> None:
+    """A background thread that exits the app through call_from_thread sets run's result."""
+
+    def target(app: CallerApp) -> None:
+        app.call_from_thread(app.exit, "exit value")
+
+    app = CallerApp(target)
+    result = app.run(headless=True)
+    app.caller_thread.join(JOIN_TIMEOUT)
+    assert not app.caller_thread.is_alive()
+    assert result == "exit value"
