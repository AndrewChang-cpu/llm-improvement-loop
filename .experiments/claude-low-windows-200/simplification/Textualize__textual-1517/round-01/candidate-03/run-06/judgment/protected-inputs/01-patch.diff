+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, in the context of the app.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context, on the app's event loop. The call blocks until
+        the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run. It may return a value or an awaitable, which is awaited.
+            *args (object): Positional arguments forwarded unchanged to the callable.
+            **kwargs (object): Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it starts, or after it has stopped).
+            RuntimeError: If called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if self._thread_id == threading.get_ident():
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
