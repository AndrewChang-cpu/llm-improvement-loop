+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file, advancing a task as bytes are read.
+
+        The display is not started by this method, and the wrapped file is not closed by the reader.
+
+        Args:
+            file (BinaryIO): A binary file object, opened by the caller.
+            total (int, optional): Size of the file in bytes. Defaults to the total of ``task_id`` if given.
