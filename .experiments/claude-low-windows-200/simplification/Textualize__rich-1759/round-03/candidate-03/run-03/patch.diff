+            file = progress.wrap_file(raw, total=11)
+            task = progress.tasks[0]
+            assert file.read(5) == b"hello"
+            assert task.completed == 5
+            assert file.seek(2) == 2
+            assert task.completed == 2
+            assert file.readline() == b"llo world"
+            assert task.completed == 11
+            with pytest.raises(io.UnsupportedOperation):
+                file.write(b"x")
+    finally:
+        os.remove(path)
