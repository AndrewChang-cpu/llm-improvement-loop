+def test_reader_advances_by_bytes_read() -> None:
+    path = _temp_file(b"one\ntwo\nthree\n")
+    try:
+        progress = Progress(
+            console=_file_console(), auto_refresh=False, get_time=MockClock()
+        )
+        with open(path, "rb") as raw:
+            file = progress.wrap_file(raw, total=14)
+            task = progress.tasks[0]
+            assert file.read(2) == b"on"
+            assert task.completed == 2
+            assert file.readline() == b"e\n"
+            assert task.completed == 4
+            assert list(file) == [b"two\n", b"three\n"]
+            assert task.completed == 14
+            assert file.seek(0) == 0
+            assert task.completed == 0
+            buffer = bytearray(3)
+            assert file.readinto(buffer) == 3
+            assert buffer == bytearray(b"one")
+            assert task.completed == 3
+            assert file.tell() == 3
+    finally:
+        os.remove(path)
+
