+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): Binary file object to read from. Available as the ``handle`` attribute.
+        progress (Progress): Progress instance that owns the task.
+        task_id (TaskID): ID of the task to advance.
+        owns_handle (bool): Close ``handle`` when this reader is closed.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._is_closed = False
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once this reader has been closed."""
+        return self._is_closed
+
+    def close(self) -> None:
+        """Close the reader, and the handle if the reader owns it."""
+        try:
+            if self._owns_handle and not self._is_closed:
+                self.handle.close()
+        finally:
+            self._is_closed = True
+
+    def read(self, size: int = -1) -> bytes:
+        """Read bytes and advance the task by the number of bytes returned.
+
+        Args:
+            size (int, optional): Number of bytes to read, or -1 to read all. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._progress.advance(self._task_id, len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(len(line) for line in lines))
+        return lines
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._progress.advance(self._task_id, count)
+        return count
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        raise io.UnsupportedOperation("write")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+
+class _ProgressContext:
+    """Context manager that runs a Progress display around a reader.
+
+    Entering starts the display, then enters the result. Exiting stops the display first, then exits the result.
+
+    Args:
+        progress (Progress): Progress instance to start and stop.
+        result (Any): Object to yield: a binary reader, or a text wrapper around one.
+    """
+
+    def __init__(self, progress: "Progress", result: Any) -> None:
+        self._progress = progress
+        self._result = result
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._result.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._result.__exit__(exc_type, exc_val, exc_tb)
+
