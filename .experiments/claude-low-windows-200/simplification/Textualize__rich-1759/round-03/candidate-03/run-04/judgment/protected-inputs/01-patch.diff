+def test_text_buffering_passed_to_handle(monkeypatch) -> None:
+    path = _write_temp_file(b"abc")
+    real_open = io.open
+    calls = []
+
+    def fake_open(file, mode, buffering=-1):
+        calls.append((mode, buffering))
+        return real_open(file, mode, buffering=buffering)
+
+    monkeypatch.setattr(io, "open", fake_open)
+    try:
