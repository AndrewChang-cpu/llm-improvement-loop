+def test_reader_advances_completed_by_bytes_consumed() -> None:
+    content = b"line one\nline two\nline three\n"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_make_console())
+        with open(path, "rb") as raw:
+            reader = progress.wrap_file(raw, total=len(content))
+            task = progress.tasks[0]
+
+            assert reader.readline() == b"line one\n"
+            assert task.completed == 9
+            assert reader.read(4) == b"line"
+            assert task.completed == 13
+            buffer = bytearray(3)
+            assert reader.readinto(buffer) == 3
+            assert buffer == b" tw"
+            assert task.completed == 16
+            assert reader.readlines() == [b"o\n", b"line three\n"]
+            assert task.completed == len(content)
+
+            assert reader.seek(5) == 5
+            assert task.completed == 5
+            assert reader.tell() == 5
+            assert list(reader) == [b"one\n", b"line two\n", b"line three\n"]
+            assert task.completed == len(content)
+
+            with pytest.raises(io.UnsupportedOperation):
+                reader.write(b"x")
+            reader.close()
+            assert reader.closed
+            assert not raw.closed
+    finally:
+        os.remove(path)
