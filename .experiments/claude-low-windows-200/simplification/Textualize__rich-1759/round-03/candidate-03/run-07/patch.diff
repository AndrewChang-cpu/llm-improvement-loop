+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
