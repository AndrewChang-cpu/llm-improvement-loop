+def test_reader_advances_completed_by_bytes_returned() -> None:
+    progress = Progress(console=_make_file_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(b"abc\ndef\nghi"), total=11)
+    task = progress.tasks[0]
+
+    assert reader.read(2) == b"ab"
+    assert task.completed == 2
+
+    assert reader.readline() == b"c\n"
+    assert task.completed == 4
+
+    assert reader.readlines() == [b"def\n", b"ghi"]
+    assert task.completed == 11
+
+    assert reader.seek(0) == 0
+    assert task.completed == 0
+    assert reader.tell() == 0
+
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == b"abc"
+    assert task.completed == 3
+
+    assert list(reader) == [b"\n", b"def\n", b"ghi"]
+    assert task.completed == 11
+
+    assert not reader.writable()
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+
