+def test_text_mode_buffering_is_forwarded_to_handle(monkeypatch) -> None:
+    path = _write_temp_file(b"hello")
+    seen_buffering = []
+    real_open = io.open
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen_buffering.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_make_file_console(), disable=True)
+        text_file = progress.open(path, "r", buffering=4)
+        try:
+            assert text_file.read() == "hello"
+        finally:
+            text_file.close()
+        assert seen_buffering == [4]
+    finally:
+        os.remove(path)
