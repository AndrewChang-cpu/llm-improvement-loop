+class _Reader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file object being wrapped.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance as bytes are read.
+        owns_handle (bool): True if closing the reader should also close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    @property
+    def mode(self) -> str:
+        """str: The mode of the wrapped handle."""
+        return self.handle.mode
+
+    @property
+    def name(self) -> str:
+        """str: The name of the wrapped handle."""
+        return self.handle.name
+
+    def __enter__(self) -> "_Reader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_Reader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def read(self, size: int = -1) -> bytes:
+        data = self.handle.read(size)
+        self._progress.advance(self._task_id, len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(len(line) for line in lines))
+        return lines
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._progress.advance(self._task_id, count)
+        return count
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        raise io.UnsupportedOperation("write")
+
+    def truncate(self, size: Optional[int] = None) -> int:
+        raise io.UnsupportedOperation("truncate")
+
+    def close(self) -> None:
+        if self._owns_handle:
+            self.handle.close()
+        self._closed = True
+
+
+class _ReaderContext(Generic[_StreamT]):
+    """Context manager that shows progress while a stream is in use.
+
+    On enter it starts the Progress display and enters the stream. On exit it
+    stops the display first, then exits the stream, even if the body raised.
+
+    Args:
+        progress (Progress): The Progress instance whose display is managed.
+        stream (IO): The text or binary object yielded on enter, wrapping a reader.
+    """
+
+    def __init__(self, progress: "Progress", stream: _StreamT) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> _StreamT:
+        self._progress.start()
+        self._stream.__enter__()
+        return self._stream
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._stream.__exit__(exc_type, exc_val, exc_tb)
+
