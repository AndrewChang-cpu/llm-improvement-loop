+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file-like object so that reads advance a task.
+
+        The wrapped file is caller-owned: closing the returned reader does not close it.
+        The display is not started by this method.
+
+        Args:
+            file (BinaryIO): An open binary file-like object to read from.
+            total (int, optional): Total size in bytes. If omitted, the total of ``task_id`` is used.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader wrapping ``file``.
+
+        Raises:
+            ValueError: If no total is given and the task (if any) has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified; file-like input has no size "
+                "and the task has no total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _Reader(file, self, task_id, owns_handle=False)
