+class _Reader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if closing the reader should close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._reader_closed = False
+
+    def _advance(self, count: int) -> None:
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        return self._reader_closed
+
+    @property
+    def mode(self) -> str:
+        return self.handle.mode
+
+    @property
+    def name(self) -> Any:
+        return self.handle.name
+
+    def __enter__(self) -> "_Reader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_Reader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def close(self) -> None:
+        """Close the handle if owned by this reader, and mark the reader closed.
+
+        Returns:
+            None
+        """
+        if self._owns_handle:
+            self.handle.close()
+        self._reader_closed = True
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read one line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1.
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate size limit. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap]
+    ):
+        """Read into ``buffer`` and advance the task by the count returned.
+
+        Args:
+            buffer (Union[bytearray, memoryview, mmap]): Buffer to fill.
+
+        Returns:
+            int: Number of bytes read into the buffer.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count)
+        return count
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        """Seek in the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset to seek to.
+            whence (int, optional): Reference point for offset. Defaults to 0.
+
+        Returns:
+            int: The absolute position after seeking.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle.
+
+        Returns:
+            int: The current position.
+        """
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        raise io.UnsupportedOperation("write")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+
+@contextmanager
+def _reader_context(progress: "Progress", reader: _IOT) -> Iterator[_IOT]:
+    """Start the progress display, enter the reader, and yield it.
+
+    On exit the display is stopped first, then the reader is exited.
+    """
+    progress.start()
+    try:
+        reader.__enter__()
+    except BaseException:
+        progress.stop()
+        raise
+    try:
+        yield reader
+    finally:
+        progress.stop()
+        reader.__exit__(None, None, None)
+
