+def test_reader_advances_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nthree\n"
+    progress = Progress(console=_make_test_console())
+    task_id = progress.add_task("reading", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+
+    assert reader.read(2) == b"li"
+    assert progress.tasks[0].completed == 11
+
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert progress.tasks[0].completed == 14
+    assert reader.tell() == 14
+
+    assert list(reader) == [b"two\n", b"three\n"]
+    assert progress.tasks[0].completed == len(data)
+
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+    assert reader.readlines() == [b"line one\n", b"line two\n", b"three\n"]
+    assert progress.tasks[0].completed == len(data)
+
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+    assert reader.writable() is False
+
