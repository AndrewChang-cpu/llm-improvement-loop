+def test_reader_advances_completed_by_bytes_returned() -> None:
+    console = _make_console()
+    data = b"line one\nline two\nline three\n"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=console, disable=True)
+        with progress.open(path, "rb") as reader:
+            task = progress.tasks[0]
+            first = reader.readline()
+            assert task.completed == len(first)
+            chunk = reader.read(4)
+            assert task.completed == len(first) + len(chunk)
+            reader.readlines()
+            assert task.completed == len(data)
+            assert reader.seek(0) == 0
+            assert task.completed == 0
+            assert reader.tell() == 0
+            assert reader.seek(5) == 5
+            assert task.completed == 5
+            line = next(reader)
+            assert task.completed == 5 + len(line)
+    finally:
+        os.remove(path)
+
