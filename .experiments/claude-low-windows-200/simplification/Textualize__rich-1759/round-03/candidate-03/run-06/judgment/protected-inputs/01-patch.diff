+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    console = _make_console()
+    path = _write_temp_file(b"hello")
+    forwarded = []
+    real_open = io.open
+
+    def spy_open(file, mode, buffering=-1, *args, **kwargs):
+        forwarded.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy_open)
+    try:
+        progress = Progress(console=console, disable=True)
+        with progress.open(path, "r", buffering=8) as reader:
+            assert reader.read() == "hello"
+        assert forwarded == [8]
+    finally:
+        os.remove(path)
