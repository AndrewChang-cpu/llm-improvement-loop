+    """Open a file for reading, displaying progress while it is read.
+
+    The progress display starts when the returned context manager is entered
+    and stops when it exits.
+
+    Args:
+        file (Union[str, bytes, os.PathLike]): Path of the file to open.
+        mode (str, optional): Mode, either "r" or "rt" for text, or "rb" for binary. Defaults to "r".
+        buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+        encoding (str, optional): Text encoding, used in text mode.
+        errors (str, optional): Error handling for text decoding.
+        newline (str, optional): Newline handling, used in text mode.
+        total (int, optional): Total size in bytes. Defaults to the size of the file.
+        description (str, optional): Description of the task. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh. Defaults to True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time. Defaults to None.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager[Union[TextIO, BinaryIO]]: A context manager yielding a text reader for "r" and "rt", otherwise a binary reader.
+    """
+    progress = _reading_progress(
+        description=description,
+        auto_refresh=auto_refresh,
+        console=console,
+        transient=transient,
+        get_time=get_time,
+        refresh_per_second=refresh_per_second,
+        style=style,
+        complete_style=complete_style,
+        finished_style=finished_style,
+        pulse_style=pulse_style,
+        disable=disable,
+    )
+    reader = progress.open(
+        file,
+        mode,
+        buffering,
+        encoding,
+        errors,
+        newline,
+        total=total,
+        description=description,
+    )
+    return _reading_context(progress, reader)  # type: ignore[return-value, type-var]
