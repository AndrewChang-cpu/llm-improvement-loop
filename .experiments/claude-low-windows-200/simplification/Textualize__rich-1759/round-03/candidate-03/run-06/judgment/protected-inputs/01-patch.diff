+def test_progress_wrap_file_reuses_task_float_total() -> None:
+    console = _make_console()
+    progress = Progress(console=console, disable=True)
+    task_id = progress.add_task("reading", total=5.5)
+    handle = io.BytesIO(b"hello")
+    reader = progress.wrap_file(handle, task_id=task_id)
+    assert reader.read() == b"hello"
+    task = progress.tasks[0]
+    assert task.completed == 5
+    assert task.total == 5.5
