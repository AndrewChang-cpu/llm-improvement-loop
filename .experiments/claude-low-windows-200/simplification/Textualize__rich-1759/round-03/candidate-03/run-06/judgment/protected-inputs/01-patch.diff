+class _Reader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a task as bytes are read from it.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance as bytes are consumed.
+        owns_handle (bool): True if the reader should close the handle when closed.
+
+    Returns:
+        _Reader: A binary reader that tracks progress.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: "TaskID",
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    def __enter__(self) -> "_Reader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def __iter__(self) -> "_Reader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = next(self.handle)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def close(self) -> None:
+        if self._owns_handle:
+            self.handle.close()
+        self._closed = True
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def read(self, size: int = -1) -> bytes:
+        block = self.handle.read(size)
+        self._progress.advance(self._task_id, len(block))
+        return block
+
+    def readinto(
+        self, b: Union[bytearray, memoryview, mmap.mmap]
+    ):  # type: ignore[no-untyped-def, override]
+        count = self.handle.readinto(b)  # type: ignore[attr-defined]
+        self._progress.advance(self._task_id, count or 0)
+        return count
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(map(len, lines)))
+        return lines
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def write(self, s: Any) -> int:
+        raise io.UnsupportedOperation("write")
+
+
+_IOType = TypeVar("_IOType", TextIO, BinaryIO)
+
+
+@contextmanager
+def _reading_context(progress: "Progress", reader: _IOType) -> Iterator[_IOType]:
+    """Show progress while the reader is open; stop the display before closing it."""
+    progress.start()
+    try:
+        reader.__enter__()
+        yield reader
+    finally:
+        progress.stop()
+        reader.__exit__(None, None, None)
+
+
