+def test_readline_iteration_and_readinto_accounting() -> None:
+    content = b"ab\ncd\nef"
+    progress = Progress(console=_make_file_console())
+    with io.BytesIO(content) as file:
+        reader = progress.wrap_file(file, len(content))
+        assert reader.readline() == b"ab\n"
+        assert progress.tasks[0].completed == 3
+        assert list(reader) == [b"cd\n", b"ef"]
+        assert progress.tasks[0].completed == len(content)
+
+    with io.BytesIO(content) as file:
+        reader = progress.wrap_file(file, len(content))
+        buffer = bytearray(4)
+        assert reader.readinto(buffer) == 4
+        assert buffer == b"ab\ncd"[:4]
+        assert progress.tasks[1].completed == 4
+        assert reader.readlines() == [b"d\n", b"ef"]
+        assert progress.tasks[1].completed == len(content)
+
