+    with os.fdopen(handle, "wb") as file:
+        file.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    content = b"hello world\nsecond line\n"
+    path = _write_temp_file(content)
+    try:
+        with progress_module.open(path, console=_make_file_console()) as reader:
+            data = reader.read()
+            assert data == content.decode()
+        assert reader.closed
+    finally:
+        os.remove(path)
+
