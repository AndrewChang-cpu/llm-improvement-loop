+def test_text_mode_buffering_is_passed_to_handle(monkeypatch) -> None:
+    content = b"buffered text"
+    path = _write_temp_file(content)
+    real_open = io.open
+    requested: list = []
+
+    def recording_open(file, mode="r", buffering=-1, **kwargs):
+        requested.append(buffering)
+        return real_open(file, mode, buffering=buffering, **kwargs)
+
+    try:
+        monkeypatch.setattr(io, "open", recording_open)
+        progress = Progress(console=_make_file_console())
+        reader = progress.open(path, "r", buffering=512)
+        assert requested == [512]
+        assert reader.read() == content.decode()
+        reader.close()
+    finally:
+        os.remove(path)
