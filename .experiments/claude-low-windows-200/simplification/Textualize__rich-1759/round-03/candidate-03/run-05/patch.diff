+def test_seek_tell_and_write_accounting() -> None:
+    content = b"0123456789"
+    progress = Progress(console=_make_file_console())
+    with io.BytesIO(content) as file:
+        reader = progress.wrap_file(file, len(content))
+        assert reader.seek(4) == 4
+        assert progress.tasks[0].completed == 4
+        assert reader.tell() == 4
+        assert reader.read(2) == b"45"
+        assert progress.tasks[0].completed == 6
+        assert reader.writable() is False
+        with pytest.raises(io.UnsupportedOperation):
+            reader.write(b"x")
+
