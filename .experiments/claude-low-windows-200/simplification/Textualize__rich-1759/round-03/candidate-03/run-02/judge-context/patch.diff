+def test_reader_advances_completed_for_each_read_path() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 13
+    assert reader.readlines() == [b" two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(data)
+
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+    assert reader.tell() == 0
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert progress.tasks[0].completed == 4
+
+    assert next(reader) == b" one\n"
+    assert progress.tasks[0].completed == 9
+
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+
