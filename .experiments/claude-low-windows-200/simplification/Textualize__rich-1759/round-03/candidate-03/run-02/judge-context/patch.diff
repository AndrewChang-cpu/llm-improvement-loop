+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _make_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with progress_open(path, console=_make_console()) as text_file:
+            assert text_file.read() == "hello world"
+        assert text_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_returns_bytes() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with progress_open(path, "rb", console=_make_console()) as binary_file:
+            assert binary_file.read() == b"hello world"
+        assert binary_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_explicit_mode_uses_file_size_as_total() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        progress = Progress(console=_make_console())
+        text_file = progress.open(path, "r")
+        assert progress.tasks[0].total == 11
+        assert text_file.read() == "hello world"
+        assert progress.tasks[0].completed == 11
+        text_file.close()
+    finally:
+        os.remove(path)
