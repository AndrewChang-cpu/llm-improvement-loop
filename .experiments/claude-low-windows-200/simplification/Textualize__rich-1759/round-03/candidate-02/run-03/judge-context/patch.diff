+class _ReaderContext(Generic[_ReaderType]):
+    """Context wrapper that starts a Progress display and enters a stream.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        stream (ContextManager): The reader or text wrapper to enter and exit.
+
+    Returns:
+        ContextManager: A context manager yielding the entered stream.
+    """
+
+    def __init__(
+        self, progress: "Progress", stream: "ContextManager[_ReaderType]"
+    ) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> _ReaderType:
+        self._progress.start()
+        try:
+            return self._stream.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._stream.__exit__(exc_type, exc_val, exc_tb)
+
