+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Read from a binary file-like object, advancing a task as bytes are read.
+
+        The wrapped file is caller-owned and is not closed by the reader.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size in bytes. Defaults to the total of task_id, if given.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of task, if new task is created. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that advances the task.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        task_total: Optional[float] = total
+        if task_total is None and task_id is not None:
+            with self._lock:
+                task_total = self._tasks[task_id].total
+        if task_total is None:
+            raise ValueError(
+                "total must be specified for file-like input "
+                "unless the task has a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=task_total)
+        else:
+            self.update(task_id, total=task_total)
+        return _FileReader(file, self, task_id, owns_handle=False)
