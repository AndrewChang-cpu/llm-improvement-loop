+def test_reader_read_paths_advance_completed() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console, auto_refresh=False)
+    data = b"line one\nline two\nline three\n"
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert progress.tasks[0].completed == 13
+    assert next(reader) == b" two\n"
+    assert progress.tasks[0].completed == 18
+    assert reader.readlines() == [b"line three\n"]
+    assert progress.tasks[0].completed == 29
+
