+def test_reader_advances_completed_by_bytes_returned() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    data = b"line one\nline two\nline three\n"
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 4
+    assert reader.readline() == b" one\n"
+    assert progress.tasks[0].completed == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert progress.tasks[0].completed == 13
+    assert reader.readlines() == [b" two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(data)
+
+    assert reader.seek(10) == 10
+    assert progress.tasks[0].completed == 10
+    assert reader.tell() == 10
+    assert list(reader) == [b"ine two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(data)
+
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+    assert not reader.writable()
+
