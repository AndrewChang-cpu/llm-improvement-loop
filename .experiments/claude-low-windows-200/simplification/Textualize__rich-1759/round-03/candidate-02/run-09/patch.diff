+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task as bytes are consumed.
+
+        The display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): Mode, one of "r", "rt", or "rb". Defaults to "r".
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding for "r" and "rt". Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text decoding. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description for a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for "r" and "rt", otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 for a text mode.
+            OSError: If the size of the file cannot be read, or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        byte_buffering = buffering
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "buffering=1 is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                byte_buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                byte_buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", byte_buffering)
+        reader = _BinaryFileReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
