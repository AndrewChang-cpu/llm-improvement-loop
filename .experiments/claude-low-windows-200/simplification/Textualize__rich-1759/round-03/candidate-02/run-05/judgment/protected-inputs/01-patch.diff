+class _ProgressContext(Generic[_IOT]):
+    """Context manager that runs a progress display around a reader.
+
+    Args:
+        progress (Progress): The Progress whose display is started and stopped.
+        reader (IO[Any]): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: _IOT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _IOT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
