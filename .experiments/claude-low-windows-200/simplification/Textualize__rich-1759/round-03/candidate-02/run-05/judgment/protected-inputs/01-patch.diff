+def test_reader_advances_completed_for_each_read_path() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    task = progress.tasks[0]
+
+    assert reader.read(4) == b"line"
+    assert task.completed == 4
+    assert reader.readline() == b" one\n"
+    assert task.completed == 9
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == b"lin"
+    assert task.completed == 12
+    assert reader.readlines() == [b"e two\n", b"line three\n"]
+    assert task.completed == 29
+    assert reader.seek(0) == 0
+    assert task.completed == 0
+    assert reader.tell() == 0
+    assert list(reader) == [b"line one\n", b"line two\n", b"line three\n"]
+    assert task.completed == 29
+    assert reader.seek(5) == 5
+    assert task.completed == 5
+    assert reader.tell() == 5
+
