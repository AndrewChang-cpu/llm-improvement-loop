+def test_module_open_default_mode_reads_text() -> None:
+    content = "hello\nworld\n"
+    path = _write_temp_file(content.encode())
+    try:
+        with rich_progress.open(path, console=_make_console()) as reader:
+            assert reader.read() == content
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_modes() -> None:
+    content = b"abc\ndef\n"
+    path = _write_temp_file(content)
+    try:
+        with rich_progress.open(path, "r", console=_make_console()) as text_reader:
+            assert text_reader.read() == "abc\ndef\n"
+        with rich_progress.open(path, "rb", console=_make_console()) as binary_reader:
+            assert binary_reader.read() == content
+        assert binary_reader.closed
+    finally:
+        os.remove(path)
