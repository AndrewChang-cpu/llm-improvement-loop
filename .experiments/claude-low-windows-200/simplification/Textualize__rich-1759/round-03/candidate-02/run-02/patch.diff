+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object so that reading advances a task.
+
+        The display is not started, and the file is not closed by the reader.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size in bytes. Defaults to the existing task's total.
+            task_id (TaskID, optional): An existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader wrapping the file.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved: Optional[float] = total
+        if resolved is None and task_id is not None:
+            with self._lock:
+                resolved = self._tasks[task_id].total
+        if resolved is None:
+            raise ValueError("total must be specified for file-like input")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved)
+        else:
+            self.update(task_id, total=resolved)
+        return _BinaryFileReader(file, self, task_id, owns_handle=False)
