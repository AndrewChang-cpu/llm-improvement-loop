+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and advance a task as bytes are consumed.
+
+        The display is not started; use the Progress as a context manager to show it.
+
+        Args:
+            file (str | PathLike | bytes): Path of the file to open.
+            mode (str, optional): "r" or "rt" for text, or "rb" for binary. Defaults to "r".
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling, for text modes. Defaults to None.
+            newline (str, optional): Newline handling, for text modes. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            TextIO | BinaryIO: A text wrapper for "r" and "rt", or a binary reader otherwise.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 for a text mode.
+            OSError: If the file size cannot be determined or the file cannot be opened.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "buffering=1 is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _BinaryFileReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
