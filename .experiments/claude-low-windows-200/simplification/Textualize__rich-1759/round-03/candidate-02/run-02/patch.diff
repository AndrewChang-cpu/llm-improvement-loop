+class _BinaryFileReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file handle being wrapped.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if the reader should close the handle on close.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self._closed = False
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+
+    def _advance(self, count: int) -> None:
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def writable(self) -> bool:
+        return False
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def read(self, size: int = -1) -> bytes:
+        """Read bytes and advance the task by the number returned.
+
+        Args:
+            size (int, optional): Number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read a line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1.
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read into a caller buffer and advance the task by the count returned.
+
+        Args:
+            buffer (bytearray | memoryview | mmap): The buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all lines and advance the task by their total length.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_BinaryFileReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek in the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Byte offset.
+            whence (int, optional): Reference point for offset. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The absolute position after seeking.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        return self.handle.tell()
+
+    def write(self, s: Any) -> int:
+        raise io.UnsupportedOperation("write")
+
+    def close(self) -> None:
+        if not self._closed:
+            if self._owns_handle:
+                self.handle.close()
+            self._closed = True
+
+    def __enter__(self) -> "_BinaryFileReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+@contextmanager
+def _display_context(progress: "Progress", target: Any) -> Iterator[Any]:
+    """Start the progress display, enter the target, and yield the entered target.
+
+    On exit the display is stopped first, then the target is exited.
+    """
+    progress.start()
+    try:
+        yield target.__enter__()
+    finally:
+        try:
+            progress.stop()
+        finally:
+            target.__exit__(None, None, None)
+
