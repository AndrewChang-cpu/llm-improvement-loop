+def test_reader_read_paths_advance_completed() -> None:
+    content = b"alpha\nbeta\ngamma\ndelta\nepsilon\n"
+    progress = Progress(console=_make_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(content), total=len(content))
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"alpha\n"
+    assert task.completed == 6
+    assert reader.read(4) == b"beta"
+    assert task.completed == 10
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert bytes(buffer) == b"\nga"
+    assert task.completed == 13
+    assert reader.readlines() == [b"mma\n", b"delta\n", b"epsilon\n"]
+    assert task.completed == len(content)
+
