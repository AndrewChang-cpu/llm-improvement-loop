+
+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        progress (Progress): The Progress instance that owns the task.
+        handle (BinaryIO): The binary file object to read from.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if the reader should close the handle on close.
+
+    """
+
+    def __init__(
+        self,
+        progress: "Progress",
+        handle: BinaryIO,
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self._progress = progress
+        self.handle = handle
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    @property
+    def mode(self) -> str:
+        """str: The mode of the wrapped handle."""
+        return self.handle.mode
+
+    @property
+    def name(self) -> Any:
+        """Any: The name of the wrapped handle."""
+        return self.handle.name
+
+    @property
+    def closed(self) -> bool:
+        """bool: True if the reader has been closed."""
+        return self._closed
+
+    def readable(self) -> bool:
+        """Check if the handle is readable.
+
+        Returns:
+            bool: True if the handle is readable.
+        """
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Check if the handle is seekable.
+
+        Returns:
+            bool: True if the handle is seekable.
+        """
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        """Check if the reader is writable.
+
+        Returns:
+            bool: Always False.
+        """
+        return False
+
+    def fileno(self) -> int:
+        """Get the file descriptor of the handle.
+
+        Returns:
+            int: The file descriptor.
+        """
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Check if the handle is connected to a terminal.
+
+        Returns:
+            bool: True if the handle is a terminal.
+        """
+        return self.handle.isatty()
+
+    def tell(self) -> int:
+        """Get the current position of the handle.
+
+        Returns:
+            int: The absolute position in the handle.
+        """
+        return self.handle.tell()
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): The offset in bytes.
+            whence (int, optional): Reference point for the offset. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The new absolute position.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def read(self, size: int = -1) -> bytes:
+        """Read bytes and advance the task by the number of bytes returned.
+
+        Args:
+            size (int, optional): Number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._progress.advance(self._task_id, len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read a line and advance the task by the number of bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for no limit. Defaults to -1.
+
+        Returns:
+            bytes: The line read, including its line ending.
+        """
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read into a buffer and advance the task by the number of bytes read.
+
+        Args:
+            buffer (Union[bytearray, memoryview, mmap.mmap]): The buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._progress.advance(self._task_id, count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def write(self, data: Any) -> int:
+        """Writing is not supported.
+
+        Args:
+            data (Any): Ignored.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def close(self) -> None:
+        """Close the handle if it is owned by the reader, and mark the reader closed."""
+        try:
+            if self._owns_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressContext(ContextManager[_ReaderT]):
+    """Starts a Progress and yields a reader for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (IO): The reader to enter and exit.
+
+    """
+
+    def __init__(self, progress: "Progress", reader: _ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
