+def test_open_text_forwards_buffering_to_handle(monkeypatch) -> None:
+    console = _make_console()
+    data = b"buffered\n"
+    path = _write_temp(data)
+    seen = []
+    real_open = io.open
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    try:
+        monkeypatch.setattr(io, "open", recording_open)
+        progress = Progress(console=console)
+        text = progress.open(path, "r", 4096)
+        try:
+            assert text.read() == "buffered\n"
+        finally:
+            text.close()
+        assert seen == [4096]
+    finally:
