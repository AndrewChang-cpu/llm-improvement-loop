+def test_reader_read_paths_advance_completed() -> None:
+    console = _make_console()
+    data = b"line one\nline two\nline three\nline four\n"
+    path = _write_temp(data)
+    try:
+        progress = Progress(console=console)
+        task_id = progress.add_task("reading", total=len(data))
+        with io.open(path, "rb") as raw:
+            reader = progress.wrap_file(raw, task_id=task_id)
+            assert reader.read(4) == b"line"
+            assert progress.tasks[0].completed == 4
+            assert reader.readline() == b" one\n"
+            assert progress.tasks[0].completed == 9
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert bytes(buffer) == b"line"
+            assert progress.tasks[0].completed == 13
+            assert reader.readlines() == [b" two\n", b"line three\n", b"line four\n"]
+            assert progress.tasks[0].completed == len(data)
+            assert reader.seek(9) == 9
+            assert progress.tasks[0].completed == 9
+            assert reader.tell() == 9
+            assert list(reader) == [b"line two\n", b"line three\n", b"line four\n"]
+            assert progress.tasks[0].completed == len(data)
+    finally:
+        os.remove(path)
