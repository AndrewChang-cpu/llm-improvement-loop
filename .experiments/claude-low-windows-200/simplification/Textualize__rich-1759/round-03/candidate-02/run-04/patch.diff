+
+def _write_temp(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
+    return path
+
+
+def _missing_path() -> str:
+    path = _write_temp(b"")
+    os.remove(path)
+    return path
+
