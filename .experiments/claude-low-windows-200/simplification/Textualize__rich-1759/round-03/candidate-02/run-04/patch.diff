+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and track the bytes read in a task.
+
+        The display is not started; start this Progress before reading to show progress.
+
+        Args:
+            file (Union[str, PathLike, bytes]): Path of the file to open.
+            mode (str, optional): "r" or "rt" for text, "rb" for binary. Defaults to "r".
+            buffering (int, optional): Buffering policy, as for the built-in open. Buffering 0 is not allowed in text mode. Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling, for text modes. Defaults to None.
+            newline (str, optional): Newline handling, for text modes. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for "r" and "rt", otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the size of the file cannot be found, or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        handle_buffering = buffering
+        if normalized_mode == "br":
+            if buffering == 1:
