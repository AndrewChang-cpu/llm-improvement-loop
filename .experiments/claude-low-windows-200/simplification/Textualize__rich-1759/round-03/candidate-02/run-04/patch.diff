+class _ProgressContext(AbstractContextManager):
+    """Starts and stops a Progress display around an opened file.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        value (Any): The object to enter on start and exit on stop.
+    """
+
+    def __init__(self, progress: "Progress", value: Any) -> None:
+        self._progress = progress
+        self._value = value
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._value.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._value.__exit__(exc_type, exc_val, exc_tb)
+
