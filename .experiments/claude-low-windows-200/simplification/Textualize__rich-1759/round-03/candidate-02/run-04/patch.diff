+def test_open_default_mode_reads_text() -> None:
+    console = _make_console()
+    path = _write_temp(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=console) as text:
+            assert text.read() == "hello\nworld\n"
+        assert text.closed
+    finally:
+        os.remove(path)
+
+
+def test_open_binary_mode_reads_bytes() -> None:
+    console = _make_console()
+    data = b"\x00\x01binary"
+    path = _write_temp(data)
+    try:
