+def _make_file_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
+
+
+def test_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_make_file_console()) as reader:
+            assert reader.read() == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_open_explicit_r_mode_reads_text() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        with progress_open(path, "r", console=_make_file_console()) as reader:
+            assert reader.read() == "abc"
+    finally:
+        os.remove(path)
+
+
+def test_open_binary_mode_reads_bytes() -> None:
+    data = b"\x00\x01abc"
+    path = _write_temp_file(data)
+    try:
+        with progress_open(path, "rb", console=_make_file_console()) as reader:
+            assert reader.read() == data
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_sets_total_to_file_size() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_file_console())
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(data)
+            assert reader.read() == data
+            assert progress.tasks[0].completed == len(data)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_missing_path_without_total_raises() -> None:
+    path = _missing_path()
+    progress = Progress(console=_make_file_console())
+    with pytest.raises(FileNotFoundError):
+        progress.open(path, "rb")
+    assert progress.tasks == []
+    with pytest.raises(FileNotFoundError):
+        progress_open(path, console=_make_file_console())
+
+
+def test_wrap_file_caller_owned_file() -> None:
+    data = b"caller owned data"
+    path = _write_temp_file(data)
+    try:
+        with open(path, "rb") as handle:
+            with progress_wrap_file(
+                handle, len(data), console=_make_file_console()
+            ) as reader:
+                assert reader.read() == data
+            assert reader.closed
+            assert not handle.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    data = b"abcdefg"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_file_console())
+        task_id = progress.add_task("reading", total=7.5)
+        with open(path, "rb") as handle:
+            reader = progress.wrap_file(handle, task_id=task_id)
+            assert reader.read() == data
+        task = progress.tasks[0]
+        assert task.total == 7.5
+        assert task.completed == len(data)
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_without_total_raises() -> None:
+    progress = Progress(console=_make_file_console())
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"))
+    assert progress.tasks == []
+
+    task_id = progress.add_task("reading", total=None)
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+    assert not progress.live.is_started
+
+
+def test_wrap_file_write_raises() -> None:
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(b"abc"), 3)
+    assert not reader.writable()
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+
+
+def test_read_paths_advance_completed() -> None:
+    data = b"one\ntwo\nthree\n"
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"one\n"
+    assert task.completed == 4
+
+    assert reader.seek(0) == 0
+    assert task.completed == 0
+
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == b"one"
+    assert task.completed == 3
+    assert reader.tell() == 3
+
+    assert reader.readlines() == [b"\n", b"two\n", b"three\n"]
+    assert task.completed == len(data)
+
+    assert reader.seek(4) == 4
+    assert task.completed == 4
+    assert list(reader) == [b"two\n", b"three\n"]
+    assert task.completed == len(data)
+
+
+def test_text_mode_zero_buffering_raises() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_file_console())
+        with pytest.raises(ValueError):
+            progress.open(path, "r", buffering=0)
+        with pytest.raises(ValueError):
+            progress.open(path, "tr", buffering=0)
+        assert progress.tasks == []
+    finally:
+        os.remove(path)
+
+
+def test_binary_mode_line_buffering_warns() -> None:
+    data = b"abc\ndef\n"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_file_console())
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        try:
+            assert reader.read() == data
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_tr_mode_returns_binary_reader() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_file_console())
+        reader = progress.open(path, "tr")
+        try:
+            assert reader.read() == b"abc"
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
