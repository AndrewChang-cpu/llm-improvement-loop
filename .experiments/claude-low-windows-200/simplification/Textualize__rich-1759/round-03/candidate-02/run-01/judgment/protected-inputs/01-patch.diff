+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object, advancing a task as bytes are read.
+
+        The reader does not close the wrapped file. The display is not started.
+
+        Args:
+            file (BinaryIO): A binary file-like object.
+            total (int, optional): Total number of bytes. Default uses the total of ``task_id``.
+            task_id (TaskID, optional): Existing task to advance. Default creates a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader wrapping ``file``.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, the file has no total and its task has none"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _FileReader(file, self, task_id, owns_handle=False)
