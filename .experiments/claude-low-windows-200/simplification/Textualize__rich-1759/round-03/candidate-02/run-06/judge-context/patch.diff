+def test_reader_advances_completed_for_each_read_path() -> None:
+    data = b"one\ntwo\nthree\n"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_console())
+        reader = progress.open(path, "rb")
+        assert reader.readline() == b"one\n"
+        assert progress.tasks[0].completed == 4
+        assert next(reader) == b"two\n"
+        assert progress.tasks[0].completed == 8
+        assert reader.read(1) == b"t"
+        assert progress.tasks[0].completed == 9
+        buffer = bytearray(2)
+        assert reader.readinto(buffer) == 2
+        assert buffer == b"hr"
+        assert progress.tasks[0].completed == 11
+        assert reader.readlines() == [b"ee\n"]
+        assert progress.tasks[0].completed == 14
+        assert reader.seek(4) == 4
+        assert progress.tasks[0].completed == 4
+        assert reader.tell() == 4
+        reader.seek(0)
+        assert list(reader) == [b"one\n", b"two\n", b"three\n"]
+        assert progress.tasks[0].completed == 14
+        reader.close()
+        assert reader.closed
+    finally:
+        os.remove(path)
