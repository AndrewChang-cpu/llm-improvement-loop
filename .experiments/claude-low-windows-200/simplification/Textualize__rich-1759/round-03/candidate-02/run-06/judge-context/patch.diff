+class _ReaderContext:
+    """Context manager that runs a Progress display around a reader.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        target (Any): The object yielded on enter, a text or binary reader.
+        reader (_ProgressReader): The binary reader entered and exited with the display.
+    """
+
+    def __init__(self, progress: "Progress", target: Any, reader: Any) -> None:
+        self._progress = progress
+        self._target = target
+        self._reader = reader
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._target
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
