+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object so that reading advances a task.
+
+        The file object is not closed by the returned reader, and the display is
+        not started by this method.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Size of the file in bytes. Defaults to the total of task_id.
+            task_id (TaskID, optional): An existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader wrapping file.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved: Optional[float] = total
+        if resolved is None and task_id is not None:
+            with self._lock:
+                resolved = self._tasks[task_id].total
+        if resolved is None:
+            raise ValueError(
+                "total must be specified, either as an argument or on the task"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved)
+        else:
+            self.update(task_id, total=resolved)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
