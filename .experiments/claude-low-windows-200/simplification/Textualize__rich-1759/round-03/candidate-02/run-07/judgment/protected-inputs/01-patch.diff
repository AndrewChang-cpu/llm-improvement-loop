+def test_reader_read_paths_advance_completed() -> None:
+    content = b"alpha\nbeta\ngamma\n"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console())
+        with open(path, "rb") as caller_file:
+            reader = progress.wrap_file(caller_file, len(content))
+            assert reader.readline() == b"alpha\n"
+            assert progress.tasks[0].completed == 6
+            assert reader.read(4) == b"beta"
+            assert progress.tasks[0].completed == 10
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert buffer == b"\ngam"
+            assert progress.tasks[0].completed == 14
+            assert reader.tell() == 14
+            assert reader.readlines() == [b"ma\n"]
+            assert progress.tasks[0].completed == 17
+            assert reader.seek(0) == 0
+            assert progress.tasks[0].completed == 0
+            assert reader.seek(3) == 3
+            assert reader.tell() == 3
+            assert progress.tasks[0].completed == 3
+            assert next(reader) == b"ha\n"
+            assert list(reader) == [b"beta\n", b"gamma\n"]
+            assert progress.tasks[0].completed == 17
+    finally:
+        os.remove(path)
+
