+def test_reader_seek_tell_readinto_and_write() -> None:
+    data = b"0123456789"
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert reader.seek(4) == 4
+    assert progress.tasks[0].completed == 4
+    assert reader.tell() == 4
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == b"456"
+    assert progress.tasks[0].completed == 7
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+    assert reader.read(2) == b"01"
+    assert progress.tasks[0].completed == 2
+    assert reader.readable()
+    assert reader.seekable()
+    assert not reader.writable()
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
