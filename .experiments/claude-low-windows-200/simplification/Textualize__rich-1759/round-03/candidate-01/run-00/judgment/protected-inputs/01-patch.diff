+def _make_file_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(data: bytes) -> str:
+    handle, path = tempfile.mkstemp()
+    with os.fdopen(handle, "wb") as file:
+        file.write(data)
+    return path
+
+
+def _missing_file_path() -> str:
+    path = _write_temp_file(b"")
+    os.remove(path)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello world\n")
+    try:
+        with progress_open(path, console=_make_file_console()) as file:
+            assert file.read() == "hello world\n"
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_reads_bytes() -> None:
+    path = _write_temp_file(b"hello world\n")
+    try:
+        with progress_open(path, "rb", console=_make_file_console()) as file:
+            assert file.read() == b"hello world\n"
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_explicit_text_mode_sets_total_from_file_size() -> None:
+    data = b"abc\ndef\n"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_file_console())
+        file = progress.open(path, "r")
+        try:
+            assert progress.tasks[0].total == len(data)
+            assert file.read() == "abc\ndef\n"
+            assert progress.tasks[0].completed == len(data)
+        finally:
+            file.close()
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_missing_path_without_total_creates_no_task() -> None:
+    path = _missing_file_path()
+    progress = Progress(console=_make_file_console())
+    with pytest.raises(FileNotFoundError):
