+def test_progress_open_text_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    path = _write_temp_file(b"data")
+    calls = []
+    real_open = io.open
+
+    def recording_open(*args, **kwargs):
+        calls.append(args)
+        return real_open(*args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_make_file_console())
+        file = progress.open(path, "r", buffering=4096)
+        try:
+            assert calls == [(path, "rb", 4096)]
+        finally:
+            file.close()
+    finally:
+        os.remove(path)
