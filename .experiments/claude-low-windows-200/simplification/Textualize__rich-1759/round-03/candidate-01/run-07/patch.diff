+def test_reader_advances_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_file_console())
+    task_id = progress.add_task("read", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert progress.tasks[0].completed == 13
+
+    assert reader.read(3) == b" tw"
+    assert progress.tasks[0].completed == 16
+
+    rest = reader.readlines()
+    assert b"".join(rest) == data[16:]
+    assert progress.tasks[0].completed == len(data)
+
+
+def test_reader_seek_sets_completed_and_iteration_advances() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_file_console())
+    task_id = progress.add_task("read", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.seek(5) == 5
+    assert progress.tasks[0].completed == 5
+    assert reader.tell() == 5
+
+    lines = list(reader)
+    assert lines == [b"one\n", b"line two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(data)
+
