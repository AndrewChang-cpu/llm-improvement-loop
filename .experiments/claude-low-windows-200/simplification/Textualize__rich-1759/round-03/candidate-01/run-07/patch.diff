+    def open(
+        self,
+        file: _FilePath,
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> IO[Any]:
+        """Open a file and read it, advancing a task as bytes are consumed.
+
+        The task is not started by this method. Use the module-level ``open``
+        to show the progress display automatically.
+
+        Args:
+            file (Union[str, bytes, PathLike]): The path of the file to open.
+            mode (str, optional): File mode. "r" and "rt" return a text reader, "rb" returns a binary reader. Defaults to "r".
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding used for text modes. Defaults to None.
+            errors (str, optional): Error handling for text modes. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            IO: A text reader for "r" and "rt", otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering is 0 for a text mode.
+            OSError: If the size of the file cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        elif buffering == 0:
+            raise ValueError("can't have unbuffered text I/O")
+        elif buffering == 1:
+            line_buffering = True
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file object, advancing a task as bytes are consumed.
+
+        The wrapped file is not closed by the reader. The task is not started by this method.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size in bytes. If omitted, the total of task_id is used.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, or task_id must name a task with a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
