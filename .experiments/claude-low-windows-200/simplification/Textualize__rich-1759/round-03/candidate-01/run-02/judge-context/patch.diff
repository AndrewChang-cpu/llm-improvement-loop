+class _ReaderContext:
+    """Context wrapper that runs a Progress display around a reader or text wrapper.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        stream (Any): The object returned by ``Progress.open`` or ``Progress.wrap_file``.
+    """
+
+    def __init__(self, progress: "Progress", stream: Any) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._stream.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._stream.__exit__(exc_type, exc_val, exc_tb)
+
