+def test_progress_open_text_forwards_buffering(monkeypatch) -> None:
+    path = _temp_file(b"abc")
+    calls = []
+    real_open = io.open
+
+    def fake_open(file, mode="r", buffering=-1, **kwargs):
+        calls.append((mode, buffering))
+        return real_open(file, mode, buffering, **kwargs)
+
+    try:
+        monkeypatch.setattr(io, "open", fake_open)
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        reader = progress.open(path, "r", 4096)
+        assert calls == [("rb", 4096)]
+        reader.close()
+    finally:
+        os.remove(path)
