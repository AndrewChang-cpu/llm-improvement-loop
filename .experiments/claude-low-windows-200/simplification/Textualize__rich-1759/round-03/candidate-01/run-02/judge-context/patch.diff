+def _temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
+
+
+def test_module_open_default_mode_returns_text() -> None:
+    data = b"hello world"
+    path = _temp_file(data)
+    try:
+        with progress_open(path, console=_file_console()) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_returns_bytes() -> None:
+    data = b"\x00\x01binary"
+    path = _temp_file(data)
+    try:
+        with progress_open(path, "rb", console=_file_console()) as reader:
+            assert reader.read() == data
+        assert reader.closed
+    finally:
+        os.remove(path)
+
