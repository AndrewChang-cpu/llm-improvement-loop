+def test_reader_byte_accounting() -> None:
+    data = b"line one\nline two\nline three\n"
+    source = io.BytesIO(data)
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    reader = progress.wrap_file(source, len(data))
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"line one\n"
+    assert task.completed == 9
+    assert reader.read(4) == b"line"
+    assert task.completed == 13
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert bytes(buffer) == b" tw"
+    assert task.completed == 16
+    assert reader.readlines() == [b"o\n", b"line three\n"]
+    assert task.completed == 29
+    assert reader.read() == b""
+    assert task.completed == 29
+
+    assert reader.seek(0) == 0
+    assert task.completed == 0
+    assert reader.tell() == 0
+    assert list(reader) == [b"line one\n", b"line two\n", b"line three\n"]
+    assert task.completed == 29
+    assert reader.tell() == 29
+
