+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object so that reading advances a task.
+
+        This does not start the progress display, and does not close the wrapped file.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total number of bytes. Defaults to the total of task_id, if given.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the new task, if one is created. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that advances the task as bytes are read.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved: Optional[float] = total
+        if resolved is None and task_id is not None:
+            with self._lock:
+                resolved = self._tasks[task_id].total
+        if resolved is None:
+            raise ValueError(
+                "total must be specified, either as an argument or on the task"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved)
+        else:
+            self.update(task_id, total=resolved)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
