+        """Open a file for reading and advance a task as bytes are read.
+
+        This does not start the progress display.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): File mode. 'r' and 'rt' return a text wrapper; 'rb' returns a binary reader. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update. Default is a new task.
+            description (str, optional): Description of the new task, if one is created. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the size of the file cannot be obtained, or the file cannot be opened.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode, "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
