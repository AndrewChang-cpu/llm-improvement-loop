+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    path = _write_temp_file(b"abc")
+    calls = []
+    real_open = io.open
+
+    def spy_open(*args, **kwargs):
+        calls.append(kwargs)
+        return real_open(*args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy_open)
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        reader = progress.open(path, "r", buffering=8192)
