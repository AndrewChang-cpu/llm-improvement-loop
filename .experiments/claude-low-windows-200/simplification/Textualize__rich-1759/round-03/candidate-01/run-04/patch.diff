+def test_reader_advances_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        reader = progress.open(path, "rb")
+        try:
+            assert reader.read(4) == b"line"
+            assert progress.tasks[0].completed == 4
+            assert reader.readline() == b" one\n"
+            assert progress.tasks[0].completed == 9
+            assert reader.tell() == 9
+            assert reader.seek(0) == 0
+            assert progress.tasks[0].completed == 0
+            assert next(reader) == b"line one\n"
+            assert progress.tasks[0].completed == 9
+            assert reader.readlines() == [b"line two\n", b"line three\n"]
+            assert progress.tasks[0].completed == len(data)
+            assert reader.seek(5) == 5
+            assert progress.tasks[0].completed == 5
+            buffer = bytearray(3)
+            assert reader.readinto(buffer) == 3
+            assert buffer == b"one"
+            assert progress.tasks[0].completed == 8
+            assert not reader.writable()
+            with pytest.raises(io.UnsupportedOperation):
+                reader.write(b"x")
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
