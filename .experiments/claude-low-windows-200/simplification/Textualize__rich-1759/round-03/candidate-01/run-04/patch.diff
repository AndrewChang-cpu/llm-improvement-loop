+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Read from a binary file-like object and advance a task as it is read.
+
+        The wrapped file is not closed by the returned reader. The display is not
+        started by this method.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size in bytes. If not given, the total of task_id is used.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that advances the task.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, either as an argument or on an existing task"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _FileReader(file, self, task_id, owns_handle=False)
