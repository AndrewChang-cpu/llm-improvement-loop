+def test_progress_wrap_file_accounting_for_each_read_path() -> None:
+    progress = Progress(console=Console(file=io.StringIO()))
+    source = io.BytesIO(b"line one\nline two\nline three\nline four\n")
+    reader = progress.wrap_file(source, total=39)
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"line one\n"
+    assert task.completed == 9
+
+    assert reader.read(4) == b"line"
+    assert task.completed == 13
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b" two"
+    assert task.completed == 17
+
+    assert next(reader) == b"\n"
+    assert task.completed == 18
+
+    assert reader.readlines() == [b"line three\n", b"line four\n"]
+    assert task.completed == 39
+
+    reader.seek(5)
+    assert task.completed == 5
+    assert reader.tell() == 5
+    assert reader.read(2) == b"on"
+    assert task.completed == 7
+
