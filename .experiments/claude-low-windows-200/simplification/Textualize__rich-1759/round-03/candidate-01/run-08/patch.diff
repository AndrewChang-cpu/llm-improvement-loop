+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and track the bytes read in a task.
+
+        The task is not started by this method, so the display is unchanged until the
+        Progress is started.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): File mode. 'r' and 'rt' return a text reader; 'rb' returns a binary reader. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding for text modes. Defaults to None.
+            errors (str, optional): Error handling for text modes. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            TextIO or BinaryIO: A text reader for 'r' and 'rt', otherwise a binary reader. Closing it closes the file.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in a text mode.
+            OSError: If the size of the file cannot be obtained, or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode, "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _BinaryReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
