+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file object and track the bytes read in a task.
+
+        The wrapped file is not closed by the reader. The task is not started by this
+        method.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size in bytes. If omitted, the total of the task given by task_id is used.
+            task_id (TaskID, optional): Existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that advances the task as bytes are read.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError("total must be specified, since no task total is known")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _BinaryReader(file, self, task_id, owns_handle=False)
