+class _ProgressContext(Generic[_ReaderT]):
+    """A context manager that runs a Progress display around a reader.
+
+    Args:
+        progress (Progress): The Progress instance to start on enter and stop on exit.
+        reader (IO): The reader to enter on enter and exit on exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: _ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
