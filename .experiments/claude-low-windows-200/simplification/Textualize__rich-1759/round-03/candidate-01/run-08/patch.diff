+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    path = _write_temp_file(b"hello world")
+    real_open = io.open
+    recorded: List[int] = []
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        recorded.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_make_console())
+        reader = progress.open(path, "r", 4096)
+        try:
+            assert reader.read() == "hello world"
+        finally:
+            reader.close()
+        assert recorded == [4096]
+    finally:
+        os.remove(path)
