+def test_reader_advances_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\n"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_console())
+        task_id = progress.add_task("Reading", total=len(data))
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, task_id=task_id)
+            assert reader.read(4) == b"line"
+            assert progress.tasks[0].completed == 4
+            assert reader.readline() == b" one\n"
+            assert progress.tasks[0].completed == 9
+            assert reader.readlines() == [b"line two\n"]
+            assert progress.tasks[0].completed == 18
+            assert reader.seek(0) == 0
+            assert progress.tasks[0].completed == 0
+            assert reader.tell() == 0
+            assert list(reader) == [b"line one\n", b"line two\n"]
+            assert progress.tasks[0].completed == 18
+            assert reader.seek(0) == 0
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert buffer == b"line"
+            assert progress.tasks[0].completed == 4
+            with pytest.raises(io.UnsupportedOperation):
+                reader.write(b"x")
+    finally:
+        os.remove(path)
