+    def open(
+        self,
+        file: Union[str, bytes, "os.PathLike[str]"],
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and advance a task as bytes are read.
+
+        The progress display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): File mode. 'r' and 'rt' return a text reader; other accepted modes return a binary reader. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used when a text reader is returned. Defaults to None.
+            errors (str, optional): Error handling for text, used when a text reader is returned. Defaults to None.
+            newline (str, optional): Newline handling, used when a text reader is returned. Defaults to None.
+            total (int, optional): Total size in bytes. Default is the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Default creates a new task.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering is 0 for a text mode.
+            OSError: If the size of the file cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        binary_handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(binary_handle, self, task_id, owns_handle=True)
+
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file object and advance a task as bytes are read.
+
+        The wrapped file is not closed by the reader. The progress display is not started by this method.
+
+        Args:
+            file (BinaryIO): A binary file-like object that is already open.
+            total (int, optional): Total size in bytes. If omitted, the total of ``task_id`` is used.
+            task_id (TaskID, optional): Existing task to advance. Default creates a new task.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader wrapping ``file``.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError("total must be specified when the task has no total")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+
+        return _ProgressReader(file, self, task_id, owns_handle=False)
