+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    path = _write_temp_file(b"abc")
+    real_open = io.open
+    calls = []
+
+    def spy_open(file, mode="r", buffering=-1, *args, **kwargs):
+        calls.append((mode, buffering))
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy_open)
+    try:
+        progress = Progress(console=_make_console())
+        with progress.open(path, "r", 4096) as reader:
+            assert reader.read() == "abc"
+    finally:
+        monkeypatch.undo()
+        os.remove(path)
+    assert ("rb", 4096) in calls
+
+
