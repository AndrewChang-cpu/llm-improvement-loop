+def test_read_paths_advance_completed() -> None:
+    data = b"line1\nline2\nline3\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"line1\n"
+    assert task.completed == 6
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert task.completed == 10
+
+    assert reader.read(2) == b"2\n"
+    assert task.completed == 12
+
+    assert next(iter(reader)) == b"line3\n"
+    assert task.completed == 18
+
+    assert reader.readlines() == []
+    assert task.completed == 18
+
+
+def test_iteration_advances_completed() -> None:
+    data = b"a\nbb\nccc\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert list(reader) == [b"a\n", b"bb\n", b"ccc\n"]
+    assert progress.tasks[0].completed == len(data)
