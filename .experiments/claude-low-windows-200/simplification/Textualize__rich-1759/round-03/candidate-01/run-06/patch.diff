+def test_progress_wrap_file_reuses_float_task_total() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_console())
+        task_id = progress.add_task("reading", total=12.5)
+        with open(path, "rb") as caller_file:
+            reader = progress.wrap_file(caller_file, task_id=task_id)
+            assert reader.read() == data
+        assert progress.tasks[0].total == 12.5
+        assert progress.tasks[0].completed == len(data)
+    finally:
+        os.remove(path)
