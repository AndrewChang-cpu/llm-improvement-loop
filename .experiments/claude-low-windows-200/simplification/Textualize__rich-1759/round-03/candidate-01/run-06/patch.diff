+def test_module_wrap_file_caller_owned() -> None:
+    data = b"caller owned data"
+    path = _write_temp_file(data)
+    try:
+        with open(path, "rb") as caller_file:
+            with progress_wrap_file(
+                caller_file, len(data), console=_make_console()
+            ) as reader:
+                assert reader.read() == data
+            assert reader.closed
+            assert not caller_file.closed
+    finally:
+        os.remove(path)
