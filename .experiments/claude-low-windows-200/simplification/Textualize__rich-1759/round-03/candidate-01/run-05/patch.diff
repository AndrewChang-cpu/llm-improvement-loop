+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    path = _temp_file(b"abc\n")
+    seen = []
+    real_open = io.open
+
+    def spy_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy_open)
+    try:
+        progress = Progress(console=_make_read_console())
+        reader = progress.open(path, "r", buffering=512)
+        try:
+            assert reader.read() == "abc\n"
+        finally:
+            reader.close()
+        assert seen == [512]
+    finally:
+        os.remove(path)
