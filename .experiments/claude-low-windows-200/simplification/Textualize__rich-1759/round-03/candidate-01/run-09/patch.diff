+def test_reader_advances_task_for_each_read_method() -> None:
+    progress = Progress(console=Console(file=io.StringIO(), force_terminal=True))
+    task_id = progress.add_task("reading", total=10)
+    reader = progress.wrap_file(io.BytesIO(b"0123456789"), task_id=task_id)
+    assert reader.read(3) == b"012"
+    assert progress.tasks[0].completed == 3
+    assert reader.readline() == b"3456789"
+    assert progress.tasks[0].completed == 10
+    assert reader.seek(2) == 2
+    assert progress.tasks[0].completed == 2
+    assert reader.tell() == 2
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"2345"
+    assert progress.tasks[0].completed == 6
+
