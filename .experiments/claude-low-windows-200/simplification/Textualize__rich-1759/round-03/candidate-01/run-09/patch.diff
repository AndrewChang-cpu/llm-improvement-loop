+def test_file_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello world")
+    try:
+        console = Console(file=io.StringIO(), force_terminal=True)
+        with progress_open(path, console=console) as file:
+            assert file.read() == "hello world"
+        assert file.closed
+    finally:
