+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    path = _write_temp_file(b"forward")
+    real_open = io.open
+    seen_buffering = []
+
+    def spy_open(*args: object, **kwargs: object) -> object:
+        seen_buffering.append(kwargs.get("buffering"))
+        return real_open(*args, **kwargs)
+
+    try:
+        monkeypatch.setattr(rich_progress.io, "open", spy_open)
+        progress = Progress(console=_make_file_console())
+        with progress.open(path, "r", 4096) as file:
+            assert file.read() == "forward"
+        assert seen_buffering == [4096]
+    finally:
+        os.remove(path)
+
