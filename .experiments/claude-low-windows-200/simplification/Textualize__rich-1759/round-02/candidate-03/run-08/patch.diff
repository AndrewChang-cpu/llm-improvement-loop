+class _ProgressContext(Generic[_ContextType]):
+    """Starts a Progress display and enters a target for use in a with statement.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        target (ContextManager): The object to enter and exit inside the display.
+    """
+
+    def __init__(
+        self, progress: "Progress", target: ContextManager[_ContextType]
+    ) -> None:
+        self._progress = progress
+        self._target = target
+
+    def __enter__(self) -> _ContextType:
+        self._progress.start()
+        return self._target.__enter__()
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._target.__exit__(exc_type, exc_val, exc_tb)
