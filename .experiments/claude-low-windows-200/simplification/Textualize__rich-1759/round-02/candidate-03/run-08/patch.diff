+def test_reader_read_paths_advance_completed() -> None:
+    content = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(content), len(content))
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"line one\n"
+    assert task.completed == 9
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert task.completed == 13
+
+    assert reader.read(2) == b" t"
+    assert task.completed == 15
+
+    assert reader.readlines() == [b"wo\n", b"line three\n"]
+    assert task.completed == len(content)
+
