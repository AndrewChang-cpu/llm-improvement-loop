+def test_reader_read_paths_advance_completed() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console(), disable=True)
+    task_id = progress.add_task("read", total=len(data))
+    source = io.BytesIO(data)
+    reader = progress.wrap_file(source, task_id=task_id)
+
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 13
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b" two"
+    assert progress.tasks[0].completed == 17
+    assert reader.readlines() == [b"\n", b"line three\n"]
+    assert progress.tasks[0].completed == 29
+
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+    assert list(reader) == [b"line one\n", b"line two\n", b"line three\n"]
+    assert progress.tasks[0].completed == 29
+
+    assert reader.seek(5) == 5
+    assert progress.tasks[0].completed == 5
+    assert reader.tell() == 5
+
+    with pytest.raises(TypeError):
+        reader.readinto(b"fixed")
+    assert progress.tasks[0].completed == 5
+
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
+    assert reader.writable() is False
+
+    reader.close()
+    assert reader.closed
+    assert not source.closed
+
