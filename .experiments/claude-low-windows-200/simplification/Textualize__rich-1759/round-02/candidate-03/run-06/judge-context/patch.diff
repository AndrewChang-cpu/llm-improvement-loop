+def test_progress_open_text_buffering_above_one_is_forwarded(
+    monkeypatch: Any,
+) -> None:
+    path = _write_temp_file(b"abc")
+    real_open = io.open
+    buffering_values = []
+
+    def recording_open(file: Any, mode: str, buffering: int = -1) -> Any:
+        buffering_values.append(buffering)
+        return real_open(file, mode, buffering)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_make_file_console())
+        with progress.open(path, "r", buffering=8192) as file:
+            assert file.read() == "abc"
+        assert buffering_values == [8192]
+    finally:
+        os.remove(path)
+
