+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(b"0123456789"), total=10)
+    assert reader.seek(4) == 4
+    assert progress.tasks[0].completed == 4
+    assert reader.tell() == 4
+    assert reader.read(2) == b"45"
+    assert progress.tasks[0].completed == 6
