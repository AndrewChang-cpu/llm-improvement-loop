+def test_read_methods_advance_completed_by_bytes_returned() -> None:
+    data = b"first\nsecond\nthird\n"
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert reader.readline() == b"first\n"
+    assert progress.tasks[0].completed == 6
+    buffer = bytearray(6)
+    assert reader.readinto(buffer) == 6
+    assert buffer == b"second"
+    assert progress.tasks[0].completed == 12
+    assert reader.readlines() == [b"\n", b"third\n"]
+    assert progress.tasks[0].completed == len(data)
+
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert list(reader) == [b"first\n", b"second\n", b"third\n"]
+    assert progress.tasks[1].completed == len(data)
+
