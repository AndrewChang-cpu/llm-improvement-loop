+    """Read a file while displaying a progress bar.
+
+    The display runs only inside the returned context manager. Mode 'r' and
+    'rt' yield a text reader; 'rb' yields a binary reader.
+
+    Args:
+        file (str | PathLike | bytes): Path of the file to open.
+        mode (str, optional): File mode, 'r', 'rt' or 'rb'. Defaults to 'r'.
+        buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+        encoding (str, optional): Text encoding, for text modes. Defaults to None.
+        errors (str, optional): Error handling for text modes. Defaults to None.
+        newline (str, optional): Newline handling for text modes. Defaults to None.
+        total (int, optional): Total size in bytes. Defaults to the size of the file.
+        description (str, optional): Description shown next to the bar. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh, disable to force a refresh after each read. Defaults to True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time. Defaults to None.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager: A context manager yielding a text reader for 'r' and 'rt',
+            and a binary reader for 'rb'.
+    """
+    progress = _make_file_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
+        disable,
+    )
+    reader = progress.open(
+        file,
+        mode,
+        buffering,
+        encoding=encoding,
+        errors=errors,
+        newline=newline,
+        total=total,
+        description=description,
+    )
+    return _ProgressFileContext(  # type: ignore[return-value, type-var]
+        progress, reader
+    )
