+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
+
+
+def _completed(progress: Progress) -> float:
+    return progress.tasks[0].completed
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    console = _make_console()
+    try:
+        with progress_open(path, console=console, auto_refresh=False) as reader:
+            text = reader.read()
+        assert text == FILE_CONTENT.decode()
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_text() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    console = _make_console()
+    try:
+        with progress_open(path, "r", console=console, auto_refresh=False) as reader:
+            text = reader.read()
+        assert text == FILE_CONTENT.decode()
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_rb_mode_returns_bytes() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    console = _make_console()
+    try:
+        with progress_open(path, "rb", console=console, auto_refresh=False) as reader:
+            data = reader.read()
+        assert data == FILE_CONTENT
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_with_caller_owned_file() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    console = _make_console()
+    try:
+        with open(path, "rb") as caller_file:
+            with progress_wrap_file(
+                caller_file, len(FILE_CONTENT), console=console, auto_refresh=False
+            ) as reader:
+                data = reader.read()
+            assert data == FILE_CONTENT
+            assert reader.closed
+            assert not caller_file.closed
+        assert caller_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_sets_total_to_file_size() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    try:
+        with progress.open(path, "rb") as reader:
+            assert progress.tasks[0].total == len(FILE_CONTENT)
+            assert reader.read() == FILE_CONTENT
+    finally:
+        os.remove(path)
+
+
+def test_missing_path_without_total_raises_file_not_found() -> None:
+    path = _missing_path()
+    console = _make_console()
+    progress = Progress(console=console, auto_refresh=False)
+    with pytest.raises(FileNotFoundError):
+        progress_open(path, console=console, auto_refresh=False)
+    with pytest.raises(FileNotFoundError):
+        progress.open(path, "rb")
+    assert progress.tasks == []
+
+
+def test_wrap_file_reuses_existing_task_total() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=12.5)
+    try:
+        with open(path, "rb") as caller_file:
+            reader = progress.wrap_file(caller_file, task_id=task_id)
+            data = reader.read()
+        assert data == FILE_CONTENT
+        assert progress.tasks[0].total == 12.5
+        assert progress.tasks[0].completed == len(FILE_CONTENT)
+    finally:
+        os.remove(path)
+
+
+def test_wrap_file_task_without_total_raises_value_error() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=None)
+    try:
+        with open(path, "rb") as caller_file:
+            with pytest.raises(ValueError):
+                progress.wrap_file(caller_file, task_id=task_id)
+        assert progress.tasks[0].total is None
+        assert progress.tasks[0].completed == 0
+        assert not progress.live.is_started
+    finally:
+        os.remove(path)
+
+
+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    try:
+        with open(path, "rb") as caller_file:
+            reader = progress.wrap_file(caller_file, total=len(FILE_CONTENT))
+
+            assert reader.read(3) == b"abc"
+            assert _completed(progress) == 3
+
+            assert reader.readline() == b"\n"
+            assert _completed(progress) == 4
+
+            buffer = bytearray(2)
+            assert reader.readinto(buffer) == 2
+            assert buffer == b"de"
+            assert _completed(progress) == 6
+
+            assert reader.readlines() == [b"f\n", b"ghi\n"]
+            assert _completed(progress) == 12
+
+            reader.seek(0)
+            assert _completed(progress) == 0
+            assert list(reader) == [b"abc\n", b"def\n", b"ghi\n"]
+            assert _completed(progress) == 12
+    finally:
+        os.remove(path)
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    path = _write_temp_file(FILE_CONTENT)
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    try:
+        with open(path, "rb") as caller_file:
+            reader = progress.wrap_file(caller_file, total=len(FILE_CONTENT))
+            assert reader.seek(4) == 4
+            assert _completed(progress) == 4
+            assert reader.tell() == 4
+    finally:
+        os.remove(path)
+
