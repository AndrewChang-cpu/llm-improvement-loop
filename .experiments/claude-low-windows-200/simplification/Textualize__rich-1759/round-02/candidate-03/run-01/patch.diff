+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object so that reading it advances a task.
+
+        The wrapped file is not closed by the returned reader.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total number of bytes for the task. If not given, the total
+                of ``task_id`` is used.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved: Optional[float] = total
+        if resolved is None and task_id is not None:
+            with self._lock:
+                resolved = self._tasks[task_id].total
+        if resolved is None:
+            raise ValueError(
+                "total must be specified, either as an argument "
+                "or on a task that has a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved)
+        else:
+            self.update(task_id, total=resolved)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
