+def _temp_file_with(content: bytes) -> str:
+    """Write content to a new temporary file and return its path."""
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True, width=80)
+    path = _temp_file_with(b"hello\nworld")
+    try:
+        with progress_open(path, console=console) as reader:
+            assert reader.read() == "hello\nworld"
+        assert reader.closed
+    finally:
+        os.remove(path)
