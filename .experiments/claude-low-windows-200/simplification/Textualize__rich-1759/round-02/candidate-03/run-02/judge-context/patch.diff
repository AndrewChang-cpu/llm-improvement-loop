+class _FileReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file object being wrapped.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance as bytes are read.
+        owns_handle (bool): True if closing the reader should close the handle.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    def _advance(self, count: int) -> None:
+        """Advance the task by a number of bytes."""
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def readable(self) -> bool:
+        """Delegate to the wrapped handle."""
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Delegate to the wrapped handle."""
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        """The reader is never writable."""
+        return False
+
+    def fileno(self) -> int:
+        """Delegate to the wrapped handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Delegate to the wrapped handle."""
+        return self.handle.isatty()
+
+    def write(self, data: Any) -> int:
+        """Always raises, the reader is read only.
+
+        Args:
+            data (Any): Ignored.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to size bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (all).
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read a line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (no limit).
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read into a buffer and advance the task by the bytes read.
+
+        Args:
+            buffer (bytearray | memoryview | mmap): Buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all lines and advance the task by their total length.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def seek(self, offset: int, whence: int = os.SEEK_SET) -> int:
+        """Seek in the wrapped handle and set the task's completed to the new position.
+
+        Args:
+            offset (int): Position to seek to, relative to whence.
+            whence (int, optional): Reference point for offset. Defaults to os.SEEK_SET.
+
+        Returns:
+            int: The new absolute position.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the wrapped handle."""
+        return self.handle.tell()
+
+    def __iter__(self) -> "_FileReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.handle.readline()
+        if not line:
+            raise StopIteration
+        self._advance(len(line))
+        return line
+
+    def __enter__(self) -> "_FileReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+    def close(self) -> None:
+        """Close the handle if the reader owns it, and mark the reader closed."""
+        try:
+            if self._owns_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+
+class _FileContext:
+    """Starts and stops a Progress display around a reader.
+
+    Args:
+        progress (Progress): The Progress instance to display.
+        reader (Union[TextIO, BinaryIO]): The reader to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", reader: Union[TextIO, BinaryIO]) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
