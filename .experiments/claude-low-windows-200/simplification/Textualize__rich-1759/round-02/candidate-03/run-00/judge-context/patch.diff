+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file object, advancing a task by the bytes read.
+
+        The display is not started; use this Progress as a context manager, or call start().
+        The reader does not close the wrapped file.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Size of the file in bytes. Required unless task_id names a task with a total.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If total is not given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError("total must be specified for a file-like object")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
