+def test_read_methods_advance_completed() -> None:
+    content = b"one\ntwo\nthree\n"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, len(content))
+            assert reader.read(3) == b"one"
+            assert progress.tasks[0].completed == 3
+            assert reader.readline() == b"\n"
+            assert progress.tasks[0].completed == 4
+            buffer = bytearray(3)
+            assert reader.readinto(buffer) == 3
+            assert buffer == b"two"
+            assert progress.tasks[0].completed == 7
+            assert reader.readlines() == [b"\n", b"three\n"]
+            assert progress.tasks[0].completed == len(content)
+    finally:
+        os.remove(path)
+
+
+def test_iteration_advances_completed() -> None:
+    content = b"one\ntwo\nthree\n"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, len(content))
+            assert list(reader) == [b"one\n", b"two\n", b"three\n"]
+        assert progress.tasks[0].completed == len(content)
+    finally:
+        os.remove(path)
+
