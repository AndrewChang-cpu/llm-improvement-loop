+def _make_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as file:
+        file.write(content)
+    return path
+
+
+def _make_console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True, width=80)
+
+
+def test_open_default_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with progress_open(path, console=_make_console(), auto_refresh=False) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_open_explicit_modes() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with progress_open(path, "r", console=_make_console(), auto_refresh=False) as r:
+            assert r.read() == "hello world"
+        with progress_open(
+            path, "rb", console=_make_console(), auto_refresh=False
+        ) as binary_reader:
+            assert binary_reader.read() == b"hello world"
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    content = b"abc"
+    path = _make_temp_file(content)
+    try:
+        with open(path, "rb") as file:
+            with wrap_file(
+                file, len(content), console=_make_console(), auto_refresh=False
+            ) as reader:
+                assert reader.read() == content
+            assert reader.closed
+            assert not file.closed
+        assert file.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_defaults_total_to_file_size() -> None:
+    content = b"0123456789"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with progress.open(path, "rb") as reader:
+            assert progress.tasks[0].total == len(content)
+            reader.read()
+        assert progress.tasks[0].completed == len(content)
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    content = b"hello"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        task_id = progress.add_task("reading", total=5.5)
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, task_id=task_id)
+            assert reader.read() == content
+        assert progress.tasks[0].total == 5.5
+        assert progress.tasks[0].completed == len(content)
+    finally:
+        os.remove(path)
+
+
+def test_open_missing_path_without_total_raises_file_not_found() -> None:
+    path = _make_temp_file(b"")
+    os.remove(path)
+    progress = Progress(console=_make_console(), disable=True)
+    with pytest.raises(FileNotFoundError):
+        progress.open(path)
+    assert progress.tasks == []
+    with pytest.raises(FileNotFoundError):
+        progress_open(path, console=_make_console())
+
+
+def test_progress_wrap_file_task_without_total_raises() -> None:
+    content = b"abc"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        task_id = progress.add_task("reading", total=None)
+        with open(path, "rb") as file:
+            with pytest.raises(ValueError):
+                progress.wrap_file(file, task_id=task_id)
+        assert len(progress.tasks) == 1
+        assert progress.tasks[0].total is None
+    finally:
+        os.remove(path)
+
