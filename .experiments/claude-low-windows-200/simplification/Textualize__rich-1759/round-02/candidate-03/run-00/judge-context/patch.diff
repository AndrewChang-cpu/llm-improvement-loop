+def test_seek_and_tell_track_position() -> None:
+    content = b"one\ntwo\nthree\n"
+    path = _make_temp_file(content)
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, len(content))
+            assert reader.seek(4) == 4
+            assert progress.tasks[0].completed == 4
+            assert reader.tell() == 4
+            assert reader.read(3) == b"two"
+            assert progress.tasks[0].completed == 7
+    finally:
+        os.remove(path)
+
