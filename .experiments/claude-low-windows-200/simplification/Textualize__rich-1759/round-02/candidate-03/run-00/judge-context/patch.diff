+def test_text_mode_buffering_is_forwarded(monkeypatch) -> None:
+    real_open = io.open
+    seen = []
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    path = _make_temp_file(b"hello")
+    try:
+        progress = Progress(console=_make_console(), disable=True)
+        with progress.open(path, "r", buffering=2) as reader:
+            assert reader.read() == "hello"
+        assert seen == [2]
+    finally:
+        os.remove(path)
+
