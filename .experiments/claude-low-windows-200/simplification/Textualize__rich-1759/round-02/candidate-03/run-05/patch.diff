+def test_open_text_mode_forwards_buffering_above_one(monkeypatch) -> None:
+    path = _write_temp_file(b"abc")
+    real_open = io.open
+    calls = []
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        calls.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    try:
+        monkeypatch.setattr(io, "open", recording_open)
+        progress = Progress(console=_make_console())
+        with progress.open(path, "r", buffering=4096) as text_file:
+            assert text_file.read() == "abc"
+        assert calls == [4096]
+    finally:
+        os.remove(path)
+
