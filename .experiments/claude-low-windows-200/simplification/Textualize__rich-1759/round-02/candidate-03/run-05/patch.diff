+def test_wrap_file_read_paths_advance_completed() -> None:
+    data = b"one\ntwo\nthree\n"
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("read", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+    assert reader.readline() == b"one\n"
+    assert progress.tasks[0].completed == 4
+    assert reader.read(3) == b"two"
+    assert progress.tasks[0].completed == 7
+    buffer = bytearray(2)
+    assert reader.readinto(buffer) == 2
+    assert buffer == b"\nt"
+    assert progress.tasks[0].completed == 9
+    assert reader.readlines() == [b"hree\n"]
+    assert progress.tasks[0].completed == 14
+
