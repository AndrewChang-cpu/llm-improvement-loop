+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from. Available as the ``handle`` attribute.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if closing the reader should also close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    @property
+    def name(self) -> str:
+        """str: Name of the wrapped handle."""
+        return self.handle.name
+
+    @property
+    def mode(self) -> str:
+        """str: Mode of the wrapped handle."""
+        return self.handle.mode
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the number returned.
+
+        Args:
+            size (int, optional): Number of bytes to read, or -1 for all remaining bytes. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._progress.advance(self._task_id, len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read one line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for no limit. Defaults to -1.
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read into a writable buffer and advance the task by the count returned.
+
+        Args:
+            buffer (bytearray | memoryview | mmap): Buffer to fill.
+
+        Returns:
+            int: The number of bytes read into the buffer.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        if count:
+            self._progress.advance(self._task_id, count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all lines and advance the task by their total length.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.handle.readline()
+        if not line:
+            raise StopIteration
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def seek(self, offset: int, whence: int = os.SEEK_SET) -> int:
+        """Seek in the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point for offset. Defaults to os.SEEK_SET.
+
+        Returns:
+            int: The new absolute position.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        """Return whether the handle is readable."""
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Return whether the handle is seekable."""
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        """The reader is never writable."""
+        return False
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Return whether the handle is a terminal."""
+        return self.handle.isatty()
+
+    def write(self, data: Any) -> int:
+        """Writing is not supported; always raises.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def truncate(self, size: Optional[int] = None) -> int:
+        """Truncation is not supported; always raises.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("truncate")
+
+    def close(self) -> None:
+        """Mark the reader closed, and close the handle if the reader owns it."""
+        self._closed = True
+        if self._owns_handle:
+            self.handle.close()
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressFileContext:
+    """Context manager that runs a Progress display around a reader.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (Any): The object to enter and exit, which is yielded on enter.
+    """
+
+    def __init__(self, progress: "Progress", reader: Any) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
