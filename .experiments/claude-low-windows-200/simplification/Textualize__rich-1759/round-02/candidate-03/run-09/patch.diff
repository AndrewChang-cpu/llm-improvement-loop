+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and advance a task as bytes are read.
+
+        The display is not started by this method; start the Progress (for example
+        with a ``with`` block) to show it.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): File mode, 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode.
+            errors (str, optional): Error handling for text decoding, used in text mode.
+            newline (str, optional): Newline handling, used in text mode.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to advance. Default is a new task.
+            description (str, optional): Description of the task, if a new task is created. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering is 0 in text mode.
+            RuntimeWarning: Emitted as a warning if buffering is 1 in binary mode.
+            OSError: If the size of the file cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
