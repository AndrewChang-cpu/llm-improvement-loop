+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    payload = b"line1\nline2\nline3\n"
+    progress = Progress(console=Console(file=io.StringIO(), force_terminal=True))
+    task_id = progress.add_task("reading", total=len(payload))
+    reader = progress.wrap_file(io.BytesIO(payload), task_id=task_id)
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"line1\n"
+    assert task.completed == 6
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert task.completed == 10
+    assert reader.readlines() == [b"2\n", b"line3\n"]
+    assert task.completed == len(payload)
