+def test_progress_reader_advances_completed_on_each_read_path() -> None:
+    data = b"line one\nline two\nline three\n"
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    task = progress.tasks[0]
+
+    assert reader.read(4) == b"line"
+    assert task.completed == 4
+    assert reader.readline() == b" one\n"
+    assert task.completed == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert task.completed == 13
+    assert reader.readlines() == [b" two\n", b"line three\n"]
+    assert task.completed == len(data)
+
+    assert reader.seek(0) == 0
+    assert task.completed == 0
+    assert reader.tell() == 0
+    assert list(reader) == [b"line one\n", b"line two\n", b"line three\n"]
+    assert task.completed == len(data)
+
+    assert reader.seek(5) == 5
+    assert task.completed == 5
+    assert reader.tell() == 5
+
