+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    data = b"forwarded"
+    path = _make_temp_file(data)
+    real_open = io.open
+    seen: List[int] = []
+
+    def spy_open(file, mode="rb", buffering=-1, *args, **kwargs):
+        seen.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    try:
+        monkeypatch.setattr(io, "open", spy_open)
+        console = Console(file=io.StringIO(), force_terminal=True)
+        progress = Progress(console=console)
+        reader = progress.open(path, "r", buffering=5)
+        assert reader.read() == "forwarded"
+        reader.close()
+        assert seen == [5]
+    finally:
+        os.remove(path)
