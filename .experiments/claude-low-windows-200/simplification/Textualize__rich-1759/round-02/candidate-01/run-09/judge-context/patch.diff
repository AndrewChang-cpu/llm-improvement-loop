+def test_reader_read_paths_advance_completed() -> None:
+    console = _make_console()
+    progress = Progress(console=console)
+    data = b"line one\nline two\nline three\n"
+    task_id = progress.add_task("reading", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert progress.tasks[0].completed == 13
+
+    assert reader.readlines() == [b" two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(data)
+
+    assert reader.tell() == len(data)
+    assert reader.seek(5) == 5
+    assert progress.tasks[0].completed == 5
+
+    reader.seek(0)
+    assert list(reader) == [b"line one\n", b"line two\n", b"line three\n"]
+    assert progress.tasks[0].completed == len(data)
+
