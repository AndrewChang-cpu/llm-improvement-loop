+class _ContextWrapper:
+    """Context manager that runs a Progress display around a reader.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        target (Any): The object to enter and exit, and to yield on enter.
+    """
+
+    def __init__(self, progress: "Progress", target: Any) -> None:
+        self._progress = progress
+        self._target = target
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        self._target.__enter__()
+        return self._target
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._target.__exit__(exc_type, exc_val, exc_tb)
+
