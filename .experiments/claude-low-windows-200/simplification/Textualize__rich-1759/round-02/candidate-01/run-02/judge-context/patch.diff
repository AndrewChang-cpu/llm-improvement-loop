+def test_seek_sets_completed_to_position() -> None:
+    content = b"0123456789"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(content), total=len(content))
+    assert reader.seek(6) == 6
+    assert progress.tasks[0].completed == 6
+    assert reader.tell() == 6
+    assert reader.read() == content[6:]
