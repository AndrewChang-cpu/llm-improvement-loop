+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    content = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(content), total=len(content))
+    task = progress.tasks[0]
+
+    assert reader.read(4) == content[:4]
+    assert task.completed == 4
+    assert reader.readline() == content[4:9]
+    assert task.completed == 9
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == content[9:12]
+    assert task.completed == 12
+    rest = reader.readlines()
+    assert b"".join(rest) == content[12:]
+    assert task.completed == len(content)
+
+
