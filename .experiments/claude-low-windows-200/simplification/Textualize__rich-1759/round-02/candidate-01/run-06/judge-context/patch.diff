+def test_text_buffering_passed_to_handle(monkeypatch) -> None:
+    path = _write_temp(b"hello\n")
+    seen_buffering = []
+    real_open = io.open
+
+    def fake_open(file, mode="r", buffering=-1, **kwargs):
+        seen_buffering.append(buffering)
+        return real_open(file, mode, buffering=buffering, **kwargs)
+
+    monkeypatch.setattr(io, "open", fake_open)
+    try:
+        progress = Progress(console=_test_console())
+        with progress.open(path, "r", buffering=4096) as text_file:
+            assert text_file.read() == "hello\n"
+        assert seen_buffering == [4096]
+    finally:
+        os.remove(path)
+
