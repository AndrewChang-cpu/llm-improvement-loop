+def _test_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def test_module_open_default_mode_returns_text() -> None:
+    path = _write_temp(b"hello\nworld\n")
+    try:
+        with rich_progress.open(path, console=_test_console()) as text_file:
+            text = text_file.read()
+        assert text == "hello\nworld\n"
+        assert text_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_returns_bytes() -> None:
+    path = _write_temp(b"hello\nworld\n")
+    try:
+        with rich_progress.open(path, "rb", console=_test_console()) as binary_file:
+            data = binary_file.read()
+        assert data == b"hello\nworld\n"
+        assert binary_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_explicit_r_sets_total_to_file_size() -> None:
+    path = _write_temp(b"hello\n")
+    try:
+        progress = Progress(console=_test_console())
+        with progress.open(path, "r") as text_file:
+            assert text_file.read() == "hello\n"
+        assert progress.tasks[0].total == 6
+        assert not progress.live.is_started
+    finally:
+        os.remove(path)
+
+
+def test_module_open_missing_path_raises() -> None:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    with pytest.raises(FileNotFoundError):
+        rich_progress.open(path, console=_test_console())
+    progress = Progress(console=_test_console())
+    with pytest.raises(FileNotFoundError):
+        progress.open(path)
+    assert progress.tasks == []
+
+
+def test_module_wrap_file_caller_owned() -> None:
+    path = _write_temp(b"binary data")
+    try:
+        file = open(path, "rb")
+        try:
+            with rich_progress.wrap_file(
+                file, total=11, console=_test_console()
+            ) as reader:
+                data = reader.read()
+            assert data == b"binary data"
+            assert reader.closed
+            assert not file.closed
+        finally:
+            file.close()
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_reuses_float_total() -> None:
+    path = _write_temp(b"12345")
+    try:
+        progress = Progress(console=_test_console())
+        task_id = progress.add_task("reading", total=5.5)
+        with open(path, "rb") as file:
+            reader = progress.wrap_file(file, task_id=task_id)
+            data = reader.read()
+        assert data == b"12345"
+        assert progress.tasks[0].total == 5.5
+        assert progress.tasks[0].completed == 5
+    finally:
+        os.remove(path)
+
+
+def test_progress_wrap_file_without_total_raises() -> None:
+    progress = Progress(console=_test_console())
+    task_id = progress.add_task("reading", total=None)
+    with io.BytesIO(b"abc") as file:
+        with pytest.raises(ValueError):
+            progress.wrap_file(file, task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+    assert not progress.live.is_started
+
+
+def test_read_paths_advance_completed() -> None:
+    data = b"abc\ndef\nghi\n"
+    progress = Progress(console=_test_console())
+    with io.BytesIO(data) as file:
+        reader = progress.wrap_file(file, total=len(data))
+
+        def completed() -> float:
+            return progress.tasks[0].completed
+
+        assert reader.readline() == b"abc\n"
+        assert completed() == 4
+        assert reader.read(2) == b"de"
+        assert completed() == 6
+        buffer = bytearray(3)
+        assert reader.readinto(buffer) == 3
+        assert buffer == b"f\ng"
+        assert completed() == 9
+        assert reader.readlines() == [b"hi\n"]
+        assert completed() == 12
+        reader.seek(4)
+        assert completed() == 4
+        assert reader.tell() == 4
+        assert list(reader) == [b"def\n", b"ghi\n"]
+        assert completed() == 12
+
+
+def test_write_raises_unsupported_operation() -> None:
+    progress = Progress(console=_test_console())
+    with io.BytesIO(b"x") as file:
+        reader = progress.wrap_file(file, total=1)
+        with pytest.raises(io.UnsupportedOperation):
+            reader.write(b"y")
+
