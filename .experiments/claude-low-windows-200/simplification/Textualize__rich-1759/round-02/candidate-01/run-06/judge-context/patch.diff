+def test_module_open_error_inside_context_closes_reader() -> None:
+    path = _write_temp(b"hello\n")
+    try:
+        held = None
+        with pytest.raises(RuntimeError):
+            with rich_progress.open(
+                path, "rb", console=_test_console()
+            ) as binary_file:
+                held = binary_file
+                raise RuntimeError("boom")
+        assert held is not None
+        assert held.closed
+    finally:
+        os.remove(path)
