+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object so reading it advances a task.
+
+        The wrapped file is not closed by the returned reader.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size in bytes. If None, the total of task_id is used.
+            task_id (TaskID, optional): Existing task to update. If None, a new task is added.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
