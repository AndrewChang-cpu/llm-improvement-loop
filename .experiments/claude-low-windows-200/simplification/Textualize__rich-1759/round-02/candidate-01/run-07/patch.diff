+def test_reader_read_paths_advance_completed() -> None:
+    content = b"one\ntwo\nthree\n"
+    progress = Progress(console=_test_console())
+    reader = progress.wrap_file(io.BytesIO(content), len(content))
+    task = progress.tasks[0]
+    assert reader.readline() == b"one\n"
+    assert task.completed == 4
+    assert reader.read(3) == b"two"
+    assert task.completed == 7
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"\nthr"
+    assert task.completed == 11
+    assert reader.readlines() == [b"ee\n"]
+    assert task.completed == 14
+
