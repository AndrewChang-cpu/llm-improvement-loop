+        """Open a file for reading and advance a task by the bytes read.
+
+        The progress display is not started by this method. Start it with the Progress context
+        manager or the start method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): File mode, 'r', 'rt', or 'rb'. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling for text modes. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (int, optional): Total size of the file in bytes. Defaults to the file size.
+            task_id (TaskID, optional): Existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering 0 is given for a text mode.
+            FileNotFoundError: If total is not given and the file does not exist.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt', or 'rb'")
+
+        line_buffering = False
+        if normalized == "br":
+            if buffering == 1:
+                warnings.warn(
