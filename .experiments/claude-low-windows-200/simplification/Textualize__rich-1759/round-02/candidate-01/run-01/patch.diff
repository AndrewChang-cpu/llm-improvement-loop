+def test_open_mode_and_buffering_rules() -> None:
+    path = _write_temp_file(b"hello world")
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        with pytest.raises(ValueError):
+            progress.open(path, "w")
+        with pytest.raises(ValueError):
+            progress.open(path, "r", buffering=0)
+        with pytest.raises(ValueError):
+            progress.open(path, "tr", buffering=0)
+        assert progress.task_ids == []
+
+        with pytest.warns(RuntimeWarning):
+            binary = progress.open(path, "rb", buffering=1)
+        assert binary.read() == b"hello world"
+        binary.close()
+
+        untyped = progress.open(path, "tr")
+        assert untyped.read() == b"hello world"
+        untyped.close()
+
+        text = progress.open(path, "r", buffering=8192)
+        assert text.read() == "hello world"
+        text.close()
+    finally:
+        os.remove(path)
