+    def open(
+        self,
+        file: Union[str, bytes, "os.PathLike[str]"],
+        mode: Literal["r", "rt", "rb"] = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task as bytes are read.
+
+        The progress display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): "r" or "rt" for a text reader, "rb" for a binary reader. Defaults to "r".
+            buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only. Defaults to None.
+            errors (str, optional): Error handling for text mode. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total size of the file in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for "r" and "rt", otherwise a binary reader. Closing it closes the file.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering 0 is used in text mode.
+            OSError: If the file size cannot be obtained or the file cannot be opened.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(handle, self, task_id, True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object so that reading advances a task.
+
+        The progress display is not started by this method, and the wrapped file
+        is not closed by the returned reader.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size of the file in bytes. Defaults to the total of task_id, if given.
+            task_id (TaskID, optional): An existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader wrapping the file.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, either as an argument or as the task total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+        return _ProgressReader(file, self, task_id, False)
