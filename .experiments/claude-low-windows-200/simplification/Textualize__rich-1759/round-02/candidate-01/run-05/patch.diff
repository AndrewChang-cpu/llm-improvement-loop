+def test_text_mode_buffering_above_one_is_passed_to_handle(monkeypatch) -> None:
+    calls = []
+    original_open = io.open
+
+    def spy_open(file, mode="r", buffering=-1, *args, **kwargs):
+        calls.append(buffering)
+        return original_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy_open)
+    path = _make_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_console())
+        file = progress.open(path, "r", 4096)
+        try:
+            assert 4096 in calls
+        finally:
+            file.close()
+    finally:
+        os.remove(path)
