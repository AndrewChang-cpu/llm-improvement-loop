+def _make_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp:
+        temp.write(content)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
