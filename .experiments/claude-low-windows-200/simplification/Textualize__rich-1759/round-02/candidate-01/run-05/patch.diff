+def test_read_paths_advance_completed() -> None:
+    payload = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(payload), len(payload))
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert progress.tasks[0].completed == 13
+    assert reader.read(5) == b" two\n"
+    assert progress.tasks[0].completed == 18
+    assert reader.readlines() == [b"line three\n"]
+    assert progress.tasks[0].completed == len(payload)
+    assert reader.tell() == len(payload)
+
