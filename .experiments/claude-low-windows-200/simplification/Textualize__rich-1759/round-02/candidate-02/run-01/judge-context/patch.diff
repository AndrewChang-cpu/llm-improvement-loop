+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a Progress task as bytes are consumed.
+
+    Args:
+        progress (Progress): Progress that owns the task.
+        task_id (TaskID): Task to advance.
+        handle (BinaryIO): Binary handle to read from. Available as the ``handle`` attribute.
+        owns_handle (bool): True if closing the reader should also close ``handle``.
+    """
+
+    def __init__(
+        self,
+        progress: "Progress",
+        task_id: TaskID,
+        handle: BinaryIO,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    def _advance(self, size: int) -> None:
+        if size:
+            self._progress.advance(self._task_id, size)
+
+    def _check_open(self) -> None:
+        if self._closed:
+            raise ValueError("I/O operation on closed reader")
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        self._check_open()
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read one line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for no limit. Defaults to -1.
+
+        Returns:
+            bytes: The line read.
+        """
+        self._check_open()
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):  # type: ignore[no-untyped-def, override]
+        """Read into ``buffer`` and advance the task by the number of bytes read.
+
+        Args:
+            buffer (Union[bytearray, memoryview, mmap.mmap]): Buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        self._check_open()
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of those lines.
+
+        Args:
+            hint (int, optional): Approximate byte count to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        self._check_open()
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset to seek to.
+            whence (int, optional): Reference point for offset. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The new absolute position.
+        """
+        self._check_open()
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle.
+
+        Returns:
+            int: The current absolute position.
+        """
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        raise io.UnsupportedOperation("'write' is not supported by a progress reader")
+
+    def close(self) -> None:
+        try:
+            if self._owns_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+    @property
+    def closed(self) -> bool:
+        return self._closed
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ReaderContext(Generic[_ReaderT]):
+    """Context manager that starts a Progress on enter and stops it on exit.
+
+    Args:
+        progress (Progress): Progress to start and stop.
+        reader (IO): Reader to enter and exit, and to yield on enter.
+    """
+
+    def __init__(self, progress: "Progress", reader: _ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
