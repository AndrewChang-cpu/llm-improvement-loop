+
+        Returns:
+            BinaryIO: A binary reader.
+        """
+        if total is None and task_id is not None:
+            with self._lock:
+                total = self._tasks[task_id].total
+        if total is None:
+            raise ValueError(
+                "total must be specified, or task_id must refer to a task with a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+        return _ProgressReader(self, task_id, file, owns_handle=False)
