+def test_progress_wrap_file_reuses_task_total() -> None:
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("reading", total=12.5)
+    reader = progress.wrap_file(io.BytesIO(b"0123456789ab"), task_id=task_id)
+    assert reader.read() == b"0123456789ab"
+    task = progress.tasks[0]
+    assert task.total == 12.5
+    assert task.completed == 12
