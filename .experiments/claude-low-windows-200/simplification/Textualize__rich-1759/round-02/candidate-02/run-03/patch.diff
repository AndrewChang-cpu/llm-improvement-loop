+def _make_console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True)
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    try:
+        with progress_open(path, console=_make_console()) as reader:
+            text = reader.read()
+        assert text == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_modes() -> None:
+    data = b"hello\nworld\n"
+    path = _write_temp_file(data)
+    try:
+        with progress_open(path, "r", console=_make_console()) as text_reader:
+            assert text_reader.read() == "hello\nworld\n"
+        with progress_open(path, "rb", console=_make_console()) as binary_reader:
+            assert binary_reader.read() == data
+        assert binary_reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    data = b"caller owned data"
+    path = _write_temp_file(data)
+    try:
+        with open(path, "rb") as source:
+            with progress_wrap_file(
+                source, len(data), console=_make_console()
+            ) as reader:
+                assert reader.read() == data
+            assert reader.closed
+            assert not source.closed
+    finally:
+        os.remove(path)
+
