+        """Wrap a binary file-like object and advance a task as bytes are read.
+
+        The wrapped file is not closed when the reader is closed.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (float, optional): Total size in bytes. If omitted, the total of task_id is used.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        if total is None and task_id is not None:
+            with self._lock:
+                total = self._tasks[task_id].total
+        if total is None:
+            raise ValueError("total must be specified for a file-like object")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
