+def test_progress_open_uses_file_size_as_total() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_console())
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(data)
+            assert reader.read() == data
+            assert progress.tasks[0].completed == len(data)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_progress_reader_advances_by_bytes_returned() -> None:
+    data = b"alpha\nbeta\ngamma\ndelta\n"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_console())
+        reader = progress.open(path, "rb")
+        task = progress.tasks[0]
+        try:
+            assert reader.readline() == b"alpha\n"
+            assert task.completed == 6
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert buffer == b"beta"
+            assert task.completed == 10
+            assert reader.readlines() == [b"\n", b"gamma\n", b"delta\n"]
+            assert task.completed == len(data)
+            assert reader.seek(0) == 0
+            assert task.completed == 0
+            assert reader.tell() == 0
+            assert list(reader) == [b"alpha\n", b"beta\n", b"gamma\n", b"delta\n"]
+            assert task.completed == len(data)
+            with pytest.raises(io.UnsupportedOperation):
+                reader.write(b"x")
+        finally:
+            reader.close()
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
