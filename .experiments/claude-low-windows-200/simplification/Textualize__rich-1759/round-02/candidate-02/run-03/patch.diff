+def test_missing_path_without_total_raises_file_not_found() -> None:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    progress = Progress(console=_make_console())
+    with pytest.raises(FileNotFoundError):
