+def _make_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
+
+
+def test_module_open_default_mode_reads_str() -> None:
+    path = _make_temp_file(b"hello world")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    try:
+        with progress_open(path, console=console) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_mode_reads_str() -> None:
+    path = _make_temp_file(b"hello world")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    try:
+        with progress_open(path, "r", console=console) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_binary_mode_reads_bytes() -> None:
+    path = _make_temp_file(b"hello world")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    try:
+        with progress_open(path, "rb", console=console) as reader:
+            assert reader.read() == b"hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_does_not_start_display_until_entered() -> None:
+    path = _make_temp_file(b"abc")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    try:
+        context = progress_open(path, console=console)
+        assert console.file.getvalue() == ""
+        with context as reader:
+            assert reader.read() == "abc"
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    source = io.BytesIO(b"hello")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    with progress_wrap_file(source, total=5, console=console) as reader:
+        assert reader.read() == b"hello"
+    assert reader.closed
+    assert not source.closed
+
+
+def test_progress_open_path_without_total_uses_file_size() -> None:
+    path = _make_temp_file(b"0123456789")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    try:
+        with progress.open(path, "rb") as reader:
+            assert progress.tasks[0].total == 10
+            assert reader.read() == b"0123456789"
+        assert progress.tasks[0].completed == 10
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_text_mode_returns_str() -> None:
+    path = _make_temp_file(b"abc")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    try:
+        with progress.open(path, "r") as reader:
+            assert reader.read() == "abc"
+    finally:
+        os.remove(path)
+
+
+def test_missing_path_without_total_raises_file_not_found() -> None:
+    path = _missing_path()
+    console = Console(file=io.StringIO(), force_terminal=True)
+    with pytest.raises(FileNotFoundError):
+        progress_open(path, console=console)
+
+    progress = Progress(console=console)
+    with pytest.raises(FileNotFoundError):
+        progress.open(path)
+    assert progress.tasks == []
+
+
+def test_invalid_mode_raises_before_opening() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    with pytest.raises(ValueError, match="'w'"):
+        progress.open(_missing_path(), "w")
+    assert progress.tasks == []
+
+
+def test_text_mode_zero_buffering_raises() -> None:
+    path = _make_temp_file(b"abc")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    try:
+        with pytest.raises(ValueError):
+            progress.open(path, "r", buffering=0)
+        assert progress.tasks == []
+    finally:
+        os.remove(path)
+
+
+def test_binary_line_buffering_warns_and_reads() -> None:
+    path = _make_temp_file(b"abc")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    try:
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        with reader:
+            assert reader.read() == b"abc"
+    finally:
+        os.remove(path)
+
+
+def test_tr_mode_returns_binary_reader() -> None:
+    path = _make_temp_file(b"abc")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    try:
+        with progress.open(path, "tr") as reader:
+            assert reader.read() == b"abc"
+    finally:
+        os.remove(path)
+
+
+def test_text_mode_forwards_buffering_to_byte_handle(monkeypatch) -> None:
+    path = _make_temp_file(b"abc")
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    seen = []
+    real_open = io.open
+
+    def spy_open(*args, **kwargs):
+        seen.append(kwargs.get("buffering"))
+        return real_open(*args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy_open)
+    try:
+        with progress.open(path, "r", buffering=8192) as reader:
+            assert reader.read() == "abc"
+    finally:
+        os.remove(path)
+    assert 8192 in seen
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    task_id = progress.add_task("test", total=5.5)
+    reader = progress.wrap_file(io.BytesIO(b"hello"), task_id=task_id)
+    assert reader.read() == b"hello"
+    task = progress.tasks[0]
+    assert task.total == 5.5
+    assert task.completed == 5
+
+
+def test_progress_wrap_file_task_without_total_raises() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    task_id = progress.add_task("test", total=None)
+    with pytest.raises(ValueError, match="total must be specified"):
+        progress.wrap_file(io.BytesIO(b"hello"), task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+
+
+def test_progress_wrap_file_without_total_or_task_raises() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    with pytest.raises(ValueError, match="total must be specified"):
+        progress.wrap_file(io.BytesIO(b"hello"))
+    assert progress.tasks == []
+
+
+def test_reader_read_paths_advance_completed() -> None:
+    data = b"line1\nline2\nline3\nline4\nline5\n"
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    task_id = progress.add_task("test", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.readline() == b"line1\n"
+    assert progress.tasks[0].completed == 6
+    assert reader.read(2) == b"li"
+    assert progress.tasks[0].completed == 8
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == b"ne2"
+    assert progress.tasks[0].completed == 11
+    assert reader.readlines() == [b"\n", b"line3\n", b"line4\n", b"line5\n"]
+    assert progress.tasks[0].completed == len(data)
+
+
+def test_reader_iteration_advances_completed() -> None:
+    data = b"one\ntwo\nthree\n"
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    task_id = progress.add_task("test", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+    assert list(reader) == [b"one\n", b"two\n", b"three\n"]
+    assert progress.tasks[0].completed == len(data)
+
+
+def test_reader_seek_tell_and_write() -> None:
+    data = b"0123456789"
+    console = Console(file=io.StringIO(), force_terminal=True)
+    progress = Progress(console=console)
+    task_id = progress.add_task("test", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+    assert reader.seek(4) == 4
+    assert progress.tasks[0].completed == 4
+    assert reader.tell() == 4
+    with pytest.raises(io.UnsupportedOperation, match="write"):
+        reader.write(b"x")
+
+
