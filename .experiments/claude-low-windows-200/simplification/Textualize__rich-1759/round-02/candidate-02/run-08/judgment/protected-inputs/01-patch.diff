+        """Open a file path and read it, advancing a task by the bytes consumed.
+
+        The task is not started or displayed by this method. Use a with statement
+        on Progress to show the display.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling for text modes. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (float, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. If None, a new task is added. Defaults to None.
+            description (str, optional): Description for a new task. Defaults to "Reading...".
+
+        Raises:
+            ValueError: If the mode is not 'r', 'rt', or 'rb', or if buffering is 0 for a text mode.
+            FileNotFoundError: If total is not given and the file does not exist.
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt', or 'rb'")
+
