+    disable: bool = False,
+) -> ContextManager[Any]:
+    """Read a file while displaying progress of the bytes consumed.
+
+    Args:
+        file (Union[str, PathLike, bytes]): Path of the file to open.
+        mode (str, optional): File mode, one of 'r', 'rt', or 'rb'. Defaults to 'r'.
+        buffering (int, optional): Buffering policy, passed to the file open. Defaults to -1.
+        encoding (str, optional): Text encoding for 'r' and 'rt' modes.
+        errors (str, optional): Error handling for text decoding.
+        newline (str, optional): Newline handling for text modes.
+        total (float, optional): Total size in bytes. Defaults to the file size.
+        description (str, optional): Description of the task. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh, disable to force a refresh manually. Defaults to True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time. Defaults to None.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager: A context manager yielding a text reader for 'r' and 'rt', or a binary reader otherwise.
+
+    Raises:
+        FileNotFoundError: If total is not given and the file does not exist.
+    """
+    progress = _create_file_progress(
