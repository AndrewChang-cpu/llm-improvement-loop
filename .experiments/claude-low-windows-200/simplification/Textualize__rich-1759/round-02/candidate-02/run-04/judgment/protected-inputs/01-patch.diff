+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    path = _write_temp_file(b"line one\nline two\nline three\n")
+    try:
+        progress = Progress(console=_file_console())
+        with progress.open(path, "rb") as reader:
+            assert reader.readline() == b"line one\n"
+            assert progress.tasks[0].completed == 9
+            assert reader.read(4) == b"line"
+            assert progress.tasks[0].completed == 13
+            assert reader.readlines() == [b" two\n", b"line three\n"]
+            assert progress.tasks[0].completed == 29
+
+        with progress.open(path, "rb") as reader:
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert progress.tasks[1].completed == 4
+            assert list(reader) == [b" one\n", b"line two\n", b"line three\n"]
+            assert progress.tasks[1].completed == 29
+    finally:
+        os.remove(path)
