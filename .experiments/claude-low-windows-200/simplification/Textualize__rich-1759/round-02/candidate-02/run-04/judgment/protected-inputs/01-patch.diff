+class _ProgressFileContext:
+    """Context manager that starts a Progress, enters a stream, and stops on exit.
+
+    Args:
+        progress (Progress): The Progress instance to display.
+        stream (Any): The reader, or a text wrapper around it, to yield on enter.
+    """
+
+    def __init__(self, progress: "Progress", stream: Any) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._stream.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._stream.__exit__(exc_type, exc_val, exc_tb)
+
