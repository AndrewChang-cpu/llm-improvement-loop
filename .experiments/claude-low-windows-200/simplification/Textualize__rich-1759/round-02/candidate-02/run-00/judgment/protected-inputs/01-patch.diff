+def _make_file_test_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(data: bytes) -> str:
+    handle, path = tempfile.mkstemp()
+    with os.fdopen(handle, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def _missing_path() -> str:
+    path = _write_temp_file(b"")
+    os.remove(path)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"foo\nbar\n")
+    try:
+        with rich.progress.open(
+            path, console=_make_file_test_console(), auto_refresh=False
+        ) as reader:
+            assert reader.read() == "foo\nbar\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_modes() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        with rich.progress.open(
+            path, "r", console=_make_file_test_console(), auto_refresh=False
+        ) as text_reader:
+            assert text_reader.read() == "abc"
+        with rich.progress.open(
+            path, "rb", console=_make_file_test_console(), auto_refresh=False
+        ) as binary_reader:
+            assert binary_reader.read() == b"abc"
+        assert binary_reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    caller_file = io.BytesIO(b"hello")
+    with rich.progress.wrap_file(
+        caller_file, 5, console=_make_file_test_console(), auto_refresh=False
+    ) as reader:
+        assert reader.read() == b"hello"
+    assert reader.closed
+    assert not caller_file.closed
+    caller_file.close()
+
+
+def test_progress_wrap_file_reuses_task_total() -> None:
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=3.5)
+    reader = progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert progress.tasks[0].total == 3.5
+    assert reader.read() == b"abc"
+    assert progress.tasks[0].completed == 3
+
+
+def test_module_open_missing_path_without_total_raises() -> None:
+    path = _missing_path()
+    with pytest.raises(FileNotFoundError):
+        rich.progress.open(path, console=_make_file_test_console())
+
+
+def test_progress_open_missing_path_without_total_creates_no_task() -> None:
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    path = _missing_path()
+    with pytest.raises(FileNotFoundError):
+        progress.open(path)
+    assert progress.tasks == []
+
+
+def test_progress_wrap_file_task_without_total_raises() -> None:
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=None)
+    with pytest.raises(ValueError):
+        progress.wrap_file(io.BytesIO(b"abc"), task_id=task_id)
+    assert len(progress.tasks) == 1
+    assert progress.tasks[0].total is None
+
+
+def test_file_like_without_total_creates_no_task() -> None:
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    with pytest.raises(ValueError, match="total must be specified"):
+        progress.wrap_file(io.BytesIO(b"abc"))
+    assert progress.tasks == []
+
