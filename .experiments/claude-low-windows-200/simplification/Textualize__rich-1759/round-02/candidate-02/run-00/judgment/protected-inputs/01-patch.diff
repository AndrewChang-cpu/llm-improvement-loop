+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    path = _write_temp_file(b"abc")
+    calls = []
+    real_open = io.open
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        calls.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+        reader = progress.open(path, "r", buffering=8192)
+        try:
+            assert calls == [8192]
+            assert reader.read() == "abc"
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_tr_mode_returns_binary_reader() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+        reader = progress.open(path, "tr")
+        try:
+            assert reader.read() == b"abc"
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
