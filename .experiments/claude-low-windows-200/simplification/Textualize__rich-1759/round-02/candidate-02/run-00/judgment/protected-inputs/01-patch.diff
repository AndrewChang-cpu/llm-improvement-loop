+def test_progress_open_sets_total_to_file_size() -> None:
+    data = b"0123456789"
+    path = _write_temp_file(data)
+    try:
+        progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+        reader = progress.open(path, "rb")
+        try:
+            assert progress.tasks[0].total == len(data)
+            assert not progress.live.is_started
+            assert reader.read() == data
+            assert progress.tasks[0].completed == len(data)
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
+
+def test_readline_readinto_readlines_advance_completed() -> None:
+    data = b"line1\nline2\nline3\n"
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert reader.readline() == b"line1\n"
+    assert progress.tasks[0].completed == 6
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert progress.tasks[0].completed == 10
+    assert reader.readlines() == [b"2\n", b"line3\n"]
+    assert progress.tasks[0].completed == 18
+
+
+def test_iteration_advances_completed() -> None:
+    data = b"a\nbb\nccc\n"
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert list(reader) == [b"a\n", b"bb\n", b"ccc\n"]
+    assert progress.tasks[0].completed == len(data)
+
+
+def test_seek_sets_completed_and_tell_reports_position() -> None:
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(b"0123456789"), 10)
+    assert reader.seek(4) == 4
+    assert progress.tasks[0].completed == 4
+    assert reader.tell() == 4
+    assert reader.read(2) == b"45"
+    assert reader.seek(0, 2) == 10
+    assert progress.tasks[0].completed == 10
+
+
+def test_write_raises_unsupported_operation() -> None:
+    progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(b"abc"), 3)
+    assert not reader.writable()
+    with pytest.raises(io.UnsupportedOperation, match="write"):
