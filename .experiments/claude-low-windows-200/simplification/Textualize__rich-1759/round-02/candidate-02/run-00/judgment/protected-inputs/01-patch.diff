+def test_text_mode_buffering_zero_raises() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+        with pytest.raises(ValueError):
+            progress.open(path, "r", buffering=0)
+        with pytest.raises(ValueError):
+            progress.open(path, "rt", buffering=0)
