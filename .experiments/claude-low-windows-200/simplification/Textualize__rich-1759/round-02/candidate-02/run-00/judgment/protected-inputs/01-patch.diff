+def test_binary_mode_buffering_one_warns_and_reads() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_file_test_console(), auto_refresh=False)
+        with pytest.warns(RuntimeWarning):
+            reader = progress.open(path, "rb", buffering=1)
+        try:
+            assert reader.read() == b"abc"
+        finally:
+            reader.close()
+    finally:
+        os.remove(path)
+
