+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[float] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap a binary file-like object so that reading it advances a task.
+
+        The wrapped file is not closed by the reader; the caller owns it.
+        The display is not started.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (float, optional): Total size in bytes. Default is the total of task_id.
+            task_id (TaskID, optional): An existing task to update. Default is a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader.
+
+        Raises:
+            ValueError: If no total is given and the task (if any) has no total.
+        """
+        if total is None and task_id is not None:
+            with self._lock:
+                total = self._tasks[task_id].total
+        if total is None:
+            raise ValueError(
+                "total must be specified, either as an argument or on an existing task"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
