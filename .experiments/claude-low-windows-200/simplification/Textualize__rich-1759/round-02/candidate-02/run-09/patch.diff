+def test_read_paths_advance_completed() -> None:
+    content = b"one\ntwo\nthree\n"
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(content), total=len(content))
+    task = progress.tasks[0]
+
+    assert reader.readline() == b"one\n"
+    assert task.completed == 4
+    assert reader.read(3) == b"two"
+    assert task.completed == 7
+    assert reader.readlines() == [b"\n", b"three\n"]
+    assert task.completed == 14
