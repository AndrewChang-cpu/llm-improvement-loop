+class _ProgressContext(Generic[_ManagedT]):
+    """Context wrapper that starts a Progress, enters a managed object, and stops and exits in order.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        managed (ContextManager): The object to enter and exit while the display runs.
+    """
+
+    def __init__(self, progress: "Progress", managed: _ManagedT) -> None:
+        self._progress = progress
+        self._managed = managed
+
+    def __enter__(self) -> _ManagedT:
+        self._progress.start()
+        try:
+            return self._managed.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._managed.__exit__(exc_type, exc_val, exc_tb)
+
+
