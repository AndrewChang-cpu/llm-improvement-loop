+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading, advancing a task by the bytes consumed.
+
+        The display is not started by this method. Start this Progress (or use it as a context manager) to show progress.
+
+        Args:
+            file (Union[str, bytes, os.PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for open(). Defaults to -1.
+            encoding (str, optional): Text encoding, for text modes. Defaults to None.
+            errors (str, optional): Error handling for text modes. Defaults to None.
+            newline (str, optional): Newline handling for text modes. Defaults to None.
+            total (float, optional): Size of the file in bytes. Defaults to the file size.
+            task_id (TaskID, optional): An existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 for a text mode.
+            OSError: If the file size cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        if normalized_mode == "br":
+            if buffering == 1:
