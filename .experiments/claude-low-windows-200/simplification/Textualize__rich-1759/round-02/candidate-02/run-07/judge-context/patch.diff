+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a Progress task by the bytes it consumes.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress that owns the task.
+        task_id (TaskID): The task to advance as bytes are read.
+        owns_handle (bool): True if closing the reader closes the handle.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    @property
+    def mode(self) -> str:
+        """str: The mode of the wrapped handle."""
+        return self.handle.mode
+
+    @property
+    def name(self) -> Any:
+        """Any: The name of the wrapped handle."""
+        return self.handle.name
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to size bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._progress.advance(self._task_id, len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read one line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read, or -1 for no limit. Defaults to -1.
+
+        Returns:
+            bytes: The line read, including its line ending.
+        """
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readinto(
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):  # type: ignore[no-untyped-def, override]
+        """Read into a buffer and advance the task by the bytes returned.
+
+        Args:
+            buffer (Union[bytearray, memoryview, mmap.mmap]): The buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._progress.advance(self._task_id, count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read, or -1 for all. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(map(len, lines)))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def seek(self, offset: int, whence: int = 0) -> int:
+        """Seek in the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point, as for file.seek. Defaults to 0.
+
+        Returns:
+            int: The absolute position after seeking.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Get the position of the handle.
+
+        Returns:
+            int: The current absolute position in bytes.
+        """
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        """Writing is not supported.
+
+        Args:
+            data (Any): Ignored.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def close(self) -> None:
+        """Mark the reader closed, and close the handle if the reader owns it."""
+        self._closed = True
+        if self._owns_handle:
+            self.handle.close()
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressFileContext(Generic[_FileT]):
+    """Context manager that runs a Progress display around a file.
+
+    Args:
+        progress (Progress): The Progress whose display is started and stopped.
+        file (IO[Any]): The file or reader yielded on enter.
+    """
+
+    def __init__(self, progress: "Progress", file: _FileT) -> None:
+        self._progress = progress
+        self._file = file
+
+    def __enter__(self) -> _FileT:
+        self._progress.start()
+        try:
+            self._file.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._file
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._file.__exit__(exc_type, exc_val, exc_tb)
+
+
