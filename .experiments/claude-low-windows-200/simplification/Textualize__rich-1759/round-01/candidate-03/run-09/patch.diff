+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=Console(file=io.StringIO()))
+
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[-1].completed == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert progress.tasks[-1].completed == 13
+    assert reader.readlines() == [b" two\n", b"line three\n"]
+    assert progress.tasks[-1].completed == len(data)
+
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert reader.read(5) == b"line "
+    assert progress.tasks[-1].completed == 5
+
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert list(reader) == [b"line one\n", b"line two\n", b"line three\n"]
+    assert progress.tasks[-1].completed == len(data)
+
