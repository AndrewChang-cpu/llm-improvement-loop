+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello world\n")
+    try:
+        console = Console(file=io.StringIO(), force_terminal=True)
+        with progress_open(path, console=console) as handle:
+            assert handle.read() == "hello world\n"
+        assert handle.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_reads_text() -> None:
