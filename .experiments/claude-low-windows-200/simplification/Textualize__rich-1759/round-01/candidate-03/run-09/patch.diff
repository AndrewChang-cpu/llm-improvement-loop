+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file-like object and advance a task as bytes are read.
+
+        The wrapped file is not closed when the reader is closed.
+
+        Args:
+            file (BinaryIO): An open binary file-like object to read from.
+            total (int, optional): Total size in bytes. Defaults to the total of task_id, if given.
+            task_id (TaskID, optional): Existing task to advance. Default is a new task.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that counts the bytes consumed from file.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved: Optional[float] = total
+        if resolved is None and task_id is not None:
+            with self._lock:
+                resolved = self._tasks[task_id].total
+        if resolved is None:
+            raise ValueError(
+                "total must be specified for file-like objects without a task total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved)
+        else:
+            self.update(task_id, total=resolved)
+        return _ProgressReader(file, self, task_id, close_handle=False)
