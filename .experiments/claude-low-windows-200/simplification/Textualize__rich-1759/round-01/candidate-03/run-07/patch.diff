+class _FileReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that holds the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if closing the reader should close ``handle``.
+
+    Returns:
+        None
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        super().__init__()
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._is_closed = False
+
+    def _advance(self, count: int) -> None:
+        """Advance the task by a number of bytes."""
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._is_closed
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes, advancing the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (all).
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read a line, advancing the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (no limit).
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readinto(  # type: ignore[no-untyped-def,override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read into a buffer, advancing the task by the count returned.
+
+        Args:
+            buffer (Union[bytearray, memoryview, mmap.mmap]): Buffer to fill.
+
+        Returns:
+            int: The number of bytes read into the buffer.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all lines, advancing the task by the bytes returned.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_FileReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.readline()
+        if not line:
+            raise StopIteration
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek in the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point for offset. Defaults to 0.
+
+        Returns:
+            int: The new absolute position.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        """Writing is not supported.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def close(self) -> None:
+        """Close the handle if this reader owns it, and mark the reader closed."""
+        if self._owns_handle:
+            self.handle.close()
+        self._is_closed = True
+
+    def __enter__(self) -> "_FileReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ReaderContext(Generic[_ReaderT]):
+    """Context manager that starts a Progress display and yields a reader.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        reader (IO[Any]): The reader to enter and exit.
+
+    Returns:
+        None
+    """
+
+    def __init__(self, progress: "Progress", reader: _ReaderT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _ReaderT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self._progress.stop()
+        self._reader.__exit__(exc_type, exc_val, exc_tb)
+
