+def open(
+    file: Union[str, "os.PathLike[str]", bytes],
+    mode: Literal["r", "rt", "rb"] = "r",
+    buffering: int = -1,
+    encoding: Optional[str] = None,
+    errors: Optional[str] = None,
+    newline: Optional[str] = None,
+    *,
+    total: Optional[int] = None,
+    description: str = "Reading...",
+    auto_refresh: bool = True,
+    console: Optional[Console] = None,
+    transient: bool = False,
+    get_time: Optional[Callable[[], float]] = None,
+    refresh_per_second: float = 10,
+    style: StyleType = "bar.back",
+    complete_style: StyleType = "bar.complete",
+    finished_style: StyleType = "bar.finished",
+    pulse_style: StyleType = "bar.pulse",
+    disable: bool = False,
+) -> ContextManager[Union[TextIO, BinaryIO]]:
+    """Read a file with a progress display.
+
+    Args:
+        file (Union[str, os.PathLike, bytes]): Path of the file to open.
+        mode (str, optional): 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+        buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+        encoding (str, optional): Text encoding. Defaults to None.
+        errors (str, optional): Text error handling. Defaults to None.
+        newline (str, optional): Text newline handling. Defaults to None.
+        total (int, optional): Total number of bytes. Defaults to the file size.
+        description (str, optional): Description of task shown next to the bar. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh, disable to force a refresh. Default is True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time. Defaults to None.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager: A context manager that yields a text reader for 'r' and 'rt', or a binary reader otherwise.
+    """
+    progress = _make_read_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
+        disable,
+    )
+    reader = progress.open(
+        file,
+        mode,
+        buffering,
+        encoding,
+        errors,
+        newline,
+        total=total,
+        description=description,
+    )
+    return _ReaderContext(progress, reader)
+
+
+def wrap_file(
+    file: BinaryIO,
+    total: int,
+    *,
+    description: str = "Reading...",
+    auto_refresh: bool = True,
+    console: Optional[Console] = None,
+    transient: bool = False,
+    get_time: Optional[Callable[[], float]] = None,
+    refresh_per_second: float = 10,
+    style: StyleType = "bar.back",
+    complete_style: StyleType = "bar.complete",
+    finished_style: StyleType = "bar.finished",
+    pulse_style: StyleType = "bar.pulse",
+    disable: bool = False,
+) -> ContextManager[BinaryIO]:
+    """Read an already-open binary file with a progress display.
+
+    The file is not closed when the context exits.
+
+    Args:
+        file (BinaryIO): A binary file-like object to read from.
+        total (int): Total number of bytes to read.
+        description (str, optional): Description of task shown next to the bar. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh, disable to force a refresh. Default is True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time. Defaults to None.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager: A context manager that yields a binary reader.
+    """
+    progress = _make_read_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
+        disable,
+    )
+    reader = progress.wrap_file(file, total, description=description)
+    return _ReaderContext(progress, reader)
+
