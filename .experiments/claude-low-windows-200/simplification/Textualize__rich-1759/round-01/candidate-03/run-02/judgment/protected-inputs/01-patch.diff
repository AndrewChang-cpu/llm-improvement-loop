+class _ReaderContext:
+    """Starts a Progress display and enters a reader for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        reader (Any): A context manager yielding the reader to hand to the caller.
+
+    Returns:
+        _ReaderContext: A context manager that yields the reader.
+    """
+
+    def __init__(self, progress: "Progress", reader: Any) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
+
+def _make_read_progress(
+    description: str,
+    auto_refresh: bool,
+    console: Optional[Console],
+    transient: bool,
+    get_time: Optional[Callable[[], float]],
+    refresh_per_second: float,
+    style: StyleType,
+    complete_style: StyleType,
+    finished_style: StyleType,
+    pulse_style: StyleType,
+    disable: bool,
+) -> "Progress":
+    """Build a Progress display with the columns used for file reads."""
+    columns: List["ProgressColumn"] = (
+        [TextColumn("[progress.description]{task.description}")] if description else []
+    )
+    columns.extend(
+        (
+            BarColumn(
+                style=style,
+                complete_style=complete_style,
+                finished_style=finished_style,
+                pulse_style=pulse_style,
+            ),
+            DownloadColumn(),
+            TimeRemainingColumn(),
+        )
+    )
+    return Progress(
+        *columns,
+        auto_refresh=auto_refresh,
+        console=console,
+        transient=transient,
+        get_time=get_time,
+        refresh_per_second=refresh_per_second or 10,
+        disable=disable,
+    )
+
