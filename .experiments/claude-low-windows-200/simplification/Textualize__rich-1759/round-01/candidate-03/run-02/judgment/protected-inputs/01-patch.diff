+def test_read_paths_advance_completed() -> None:
+    content = b"alpha\nbeta\ngamma\ndelta\nepsilon\n"
+    path = _write_temp_file(content)
+    try:
+        progress = Progress(console=_file_console())
+        with progress.open(path, "rb") as reader:
+            assert reader.readline() == b"alpha\n"
+            assert progress.tasks[0].completed == 6
+            buffer = bytearray(4)
+            assert reader.readinto(buffer) == 4
+            assert progress.tasks[0].completed == 10
+            assert reader.read(3) == b"\nga"
+            assert progress.tasks[0].completed == 13
+            reader.readlines()
+            assert progress.tasks[0].completed == len(content)
+
+        progress = Progress(console=_file_console())
+        with progress.open(path, "rb") as reader:
+            lines = list(reader)
+        assert b"".join(lines) == content
+        assert progress.tasks[0].completed == len(content)
+    finally:
+        os.remove(path)
