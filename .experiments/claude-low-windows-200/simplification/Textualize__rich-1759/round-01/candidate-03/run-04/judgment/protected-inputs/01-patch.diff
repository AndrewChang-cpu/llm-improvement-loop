+def _make_temp_file(data: bytes) -> str:
+    """Write bytes to a new temporary file and return its path."""
+    descriptor, path = tempfile.mkstemp()
+    with os.fdopen(descriptor, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def _make_console() -> Console:
+    """Create a console writing to an in-memory stream with forced terminal output."""
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+        legacy_windows=False,
+    )
+
+
+def test_module_open_reads_text_by_default() -> None:
+    path = _make_temp_file(b"hello\nworld\n")
+    try:
+        with rich_progress.open(path, console=_make_console()) as reader:
+            assert isinstance(reader, io.TextIOBase)
+            assert reader.read() == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_reads_text() -> None:
+    path = _make_temp_file(b"hello\n")
+    try:
+        with rich_progress.open(path, "r", console=_make_console()) as reader:
