+def test_seek_sets_completed_to_position() -> None:
+    data = b"0123456789"
+    progress = rich_progress.Progress(console=_make_console())
+    with io.BytesIO(data) as caller_file:
+        task_id = progress.add_task("seek", total=len(data))
+        reader = progress.wrap_file(caller_file, task_id=task_id)
+        assert reader.seek(4) == 4
+        assert progress.tasks[0].completed == 4
