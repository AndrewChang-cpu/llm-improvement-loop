+class _ContextWrapper(Generic[_IOT]):
+    """Run a progress display around a reader for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress instance whose display is started and stopped.
+        reader (IO): The reader to enter on start and exit on stop.
+
+    Returns:
+        ContextManager: A context manager that yields the reader.
+    """
+
+    def __init__(self, progress: "Progress", reader: _IOT) -> None:
+        self._progress = progress
+        self._reader = reader
+
+    def __enter__(self) -> _IOT:
+        self._progress.start()
+        try:
+            self._reader.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._reader
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._reader.__exit__(exc_type, exc_val, exc_tb)
+
