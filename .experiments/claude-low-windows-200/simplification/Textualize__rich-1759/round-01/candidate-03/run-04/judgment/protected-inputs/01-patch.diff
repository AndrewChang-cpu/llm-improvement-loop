+def test_reader_advances_completed_for_each_read_path() -> None:
+    data = b"line one\nline two\nline three\nline four\nline five\n"
+    progress = rich_progress.Progress(console=_make_console())
+
+    with io.BytesIO(data) as caller_file:
+        task_id = progress.add_task("readline", total=len(data))
+        reader = progress.wrap_file(caller_file, task_id=task_id)
+        assert reader.readline() == b"line one\n"
+        assert progress.tasks[0].completed == len(b"line one\n")
+
+    with io.BytesIO(data) as caller_file:
+        task_id = progress.add_task("readinto", total=len(data))
+        reader = progress.wrap_file(caller_file, task_id=task_id)
+        buffer = bytearray(4)
+        assert reader.readinto(buffer) == 4
+        assert bytes(buffer) == b"line"
+        assert progress.tasks[-1].completed == 4
+
+    with io.BytesIO(data) as caller_file:
+        task_id = progress.add_task("read", total=len(data))
+        reader = progress.wrap_file(caller_file, task_id=task_id)
+        assert reader.read(6) == b"line o"
+        assert progress.tasks[-1].completed == 6
+
+    with io.BytesIO(data) as caller_file:
+        task_id = progress.add_task("readlines", total=len(data))
+        reader = progress.wrap_file(caller_file, task_id=task_id)
+        lines = reader.readlines()
+        assert lines == data.splitlines(keepends=True)
+        assert progress.tasks[-1].completed == len(data)
+
+    with io.BytesIO(data) as caller_file:
+        task_id = progress.add_task("iterate", total=len(data))
+        reader = progress.wrap_file(caller_file, task_id=task_id)
+        assert list(reader) == data.splitlines(keepends=True)
+        assert progress.tasks[-1].completed == len(data)
+
