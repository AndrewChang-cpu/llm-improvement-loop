+def _make_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=60,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def _write_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(data)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_make_console()) as handle:
+            text = handle.read()
+        assert text == "hello\nworld\n"
+        assert handle.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_reads_text() -> None:
