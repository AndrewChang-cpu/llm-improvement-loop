+def test_reader_readinto_seek_tell_and_write() -> None:
+    data = b"line1\nline2\nline3"
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("reading", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert progress.tasks[0].completed == 4
+    assert reader.tell() == 4
+    assert reader.seek(2) == 2
+    assert progress.tasks[0].completed == 2
+    with pytest.raises(io.UnsupportedOperation):
+        reader.write(b"x")
