+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and advance a task as bytes are consumed.
+
+        The display is not started by this method. Use the result in a ``with`` statement.
+
+        Args:
+            file (str | PathLike | bytes): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, for text mode. Defaults to None.
+            errors (str, optional): Error handling for text mode. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to update, or None to add a new task. Defaults to None.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode or buffering is not valid for the mode.
+            OSError: If the size of the file cannot be obtained, or it cannot be opened.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized in ("r", "rt"):
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            byte_buffering = -1 if line_buffering else buffering
+        elif buffering == 1:
+            warnings.warn(
+                "line buffering is not supported in binary mode, "
+                "the default buffer size is used",
+                RuntimeWarning,
+            )
+            byte_buffering = -1
+        else:
+            byte_buffering = buffering
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=byte_buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
