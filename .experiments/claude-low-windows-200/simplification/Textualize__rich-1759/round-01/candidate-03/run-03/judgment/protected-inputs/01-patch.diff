+def _temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as handle:
+        handle.write(content)
+    return path
+
+
+def test_open_default_mode_reads_text() -> None:
+    path = _temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_file_console()) as reader:
+            assert reader.read() == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
