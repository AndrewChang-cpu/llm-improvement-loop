+def test_each_read_path_advances_completed() -> None:
+    data = b"one\ntwo\nthree\nfour\nfive\n"
+    path = _temp_file(data)
+    try:
+        progress = Progress(console=_file_console())
+        task_id = progress.add_task("file", total=len(data))
+        with open(path, "rb") as handle:
+            reader = progress.wrap_file(handle, task_id=task_id)
+            assert reader.readline() == b"one\n"
+            assert progress.tasks[0].completed == 4
+            buffer = bytearray(3)
+            assert reader.readinto(buffer) == 3
+            assert bytes(buffer) == b"two"
+            assert progress.tasks[0].completed == 7
+            assert reader.read(2) == b"\nt"
+            assert progress.tasks[0].completed == 9
+            assert reader.readlines() == [b"hree\n", b"four\n", b"five\n"]
+            assert progress.tasks[0].completed == len(data)
+            assert reader.seek(0) == 0
+            assert progress.tasks[0].completed == 0
+            assert reader.tell() == 0
+            assert list(reader) == data.splitlines(keepends=True)
+            assert progress.tasks[0].completed == len(data)
+            with pytest.raises(io.UnsupportedOperation):
+                reader.write(b"x")
+    finally:
+        os.remove(path)
+
