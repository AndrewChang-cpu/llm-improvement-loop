+def test_module_open_default_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello world")
+    try:
+        with progress_open(path, console=_file_console()) as reader:
+            assert reader.read() == "hello world"
+        assert reader.closed
+    finally:
+        os.remove(path)
