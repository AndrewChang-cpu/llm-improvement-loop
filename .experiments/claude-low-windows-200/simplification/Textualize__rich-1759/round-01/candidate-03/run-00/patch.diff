+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Read from an already-open binary file, advancing a task as bytes are consumed.
+
+        The wrapped file is not closed by the reader. The display is not started by
+        this method.
+
+        Args:
+            file (BinaryIO): An open binary file-like object to read from.
+            total (int, optional): Total size in bytes. Defaults to the total of ``task_id``.
+            task_id (TaskID, optional): Existing task to update. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that wraps ``file``.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved: Optional[float] = total
+        if resolved is None and task_id is not None:
+            with self._lock:
+                resolved = self._tasks[task_id].total
+        if resolved is None:
+            raise ValueError(
+                "total must be specified for file-like input, "
+                "or pass a task_id whose task has a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved)
+        else:
+            self.update(task_id, total=resolved)
+        return _FileReader(file, self, task_id, owns_handle=False)
