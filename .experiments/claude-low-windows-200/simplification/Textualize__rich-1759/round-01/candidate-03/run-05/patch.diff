+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    content = b"line1\nline2\nline3\n"
+    progress = Progress(console=_make_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(content), len(content))
+    assert reader.readline() == b"line1\n"
+    assert progress.tasks[0].completed == 6
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert progress.tasks[0].completed == 10
+    assert reader.readlines() == [b"2\n", b"line3\n"]
+    assert progress.tasks[0].completed == 18
+
