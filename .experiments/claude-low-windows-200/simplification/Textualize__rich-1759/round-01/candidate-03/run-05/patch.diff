+def test_iteration_seek_and_tell_track_position() -> None:
+    content = b"line1\nline2\nline3\n"
+    progress = Progress(console=_make_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(content), len(content))
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+    assert list(reader) == [b"line1\n", b"line2\n", b"line3\n"]
+    assert progress.tasks[0].completed == 18
+    assert reader.seek(6) == 6
+    assert progress.tasks[0].completed == 6
+    assert reader.tell() == 6
