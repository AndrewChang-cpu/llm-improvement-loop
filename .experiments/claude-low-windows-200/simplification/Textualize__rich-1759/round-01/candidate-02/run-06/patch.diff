+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file from a path, and attach a reader that advances a task as bytes are consumed.
+
+        The display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy passed to the file open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Error handling for text decoding, used in text mode only.
+            newline (str, optional): Newline handling, used in text mode only.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): An existing task to advance. Defaults to a new task.
+            description (str, optional): Description of the new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text reader for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering is 0 in text mode.
+            OSError: If the file size or the file cannot be obtained.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}; expected 'r', 'rt' or 'rb'")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        elif buffering == 0:
+            raise ValueError("can't have unbuffered text I/O")
+        elif buffering == 1:
+            line_buffering = True
+            buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering=buffering)
+        reader = _Reader(handle, self, task_id)
+        if mode not in ("r", "rt"):
+            return reader
+        try:
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        except BaseException:
+            reader.close()
+            raise
