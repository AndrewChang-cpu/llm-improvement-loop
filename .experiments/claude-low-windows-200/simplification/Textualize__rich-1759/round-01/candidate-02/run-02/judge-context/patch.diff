+class _ProgressContext(Generic[_IOT]):
+    """Context manager that runs a progress display around a file object.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        file (IO): The file object to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", file: _IOT) -> None:
+        self._progress = progress
+        self._file = file
+
+    def __enter__(self) -> _IOT:
+        self._progress.start()
+        try:
+            self._file.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._file
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._file.__exit__(exc_type, exc_val, exc_tb)
+
