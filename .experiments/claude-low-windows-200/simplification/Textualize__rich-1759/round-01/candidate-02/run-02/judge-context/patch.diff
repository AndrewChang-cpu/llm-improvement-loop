+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"alpha\nbeta\ngamma\ndelta\nepsilon\n"
+    progress = Progress(console=_make_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    task = progress.tasks[0]
+
+    assert reader.read(3) == b"alp"
+    assert task.completed == 3
+    assert reader.readline() == b"ha\n"
+    assert task.completed == 6
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"beta"
+    assert task.completed == 10
+    assert reader.readlines() == [b"\n", b"gamma\n", b"delta\n", b"epsilon\n"]
+    assert task.completed == len(data)
+
+    reader.seek(0)
+    assert task.completed == 0
+    expected_lines = [b"alpha\n", b"beta\n", b"gamma\n", b"delta\n", b"epsilon\n"]
+    assert list(reader) == expected_lines
+    assert task.completed == len(data)
+
