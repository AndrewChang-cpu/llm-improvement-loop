+        task_id = progress.add_task("Reading", total=10.5)
+        with open(path, "rb") as caller_file:
+            reader = progress.wrap_file(caller_file, task_id=task_id)
+            assert reader.read() == data
+            reader.close()
+            assert not caller_file.closed
+        task = progress.tasks[0]
+        assert task.total == 10.5
