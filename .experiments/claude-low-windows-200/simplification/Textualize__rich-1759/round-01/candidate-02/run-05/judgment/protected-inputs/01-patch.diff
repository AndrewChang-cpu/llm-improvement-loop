+def _write_temp_file(content: bytes) -> str:
+    descriptor, path = tempfile.mkstemp()
+    with os.fdopen(descriptor, "wb") as file:
+        file.write(content)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello world\n")
+    try:
+        with progress_module.open(path, console=_make_read_console()) as file:
+            assert file.read() == "hello world\n"
+        assert file.closed
+    finally:
+        os.remove(path)
+
