+def test_read_paths_advance_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = progress_module.Progress(console=_make_read_console(), disable=True)
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+    assert next(reader) == b"line two\n"
+    assert progress.tasks[0].completed == 18
+    assert reader.readlines() == [b"line three\n"]
+    assert progress.tasks[0].completed == len(data)
