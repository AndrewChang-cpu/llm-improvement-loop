+def _write_temp_file(content: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(content)
+    return path
+
+
+def _file_console() -> Console:
+    return Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=80,
+        legacy_windows=False,
+        _environ={},
+    )
+
+
+def test_module_open_reads_text_by_default() -> None:
+    path = _write_temp_file(b"hello\nworld")
+    try:
+        with rich.progress.open(path, console=_file_console()) as f:
+            assert f.read() == "hello\nworld"
+        assert f.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_r_reads_text() -> None:
+    path = _write_temp_file(b"hello")
+    try:
+        with rich.progress.open(path, "r", console=_file_console()) as f:
+            assert f.read() == "hello"
+        assert f.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_rb_reads_bytes() -> None:
+    path = _write_temp_file(b"hello")
+    try:
+        with rich.progress.open(path, "rb", console=_file_console()) as f:
+            assert f.read() == b"hello"
+        assert f.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_wrap_file_leaves_caller_file_open() -> None:
+    path = _write_temp_file(b"hello")
+    try:
+        with open(path, "rb") as raw:
+            with rich.progress.wrap_file(raw, total=5, console=_file_console()) as f:
+                assert f.read() == b"hello"
+            assert f.closed
+            assert not raw.closed
+        assert raw.closed
+    finally:
+        os.remove(path)
+
+
+def test_progress_open_sets_total_to_file_size() -> None:
+    path = _write_temp_file(b"hello")
+    try:
+        progress = Progress(console=_file_console(), auto_refresh=False)
+        with progress.open(path, "rb") as f:
+            assert f.read() == b"hello"
+        assert progress.tasks[0].total == 5
+        assert progress.tasks[0].completed == 5
+    finally:
+        os.remove(path)
+
