+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"line"
+    assert progress.tasks[0].completed == 13
+    assert reader.read(2) == b" t"
+    assert progress.tasks[0].completed == 15
+    assert reader.readlines() == [b"wo\n", b"line three\n"]
+    assert progress.tasks[0].completed == 29
+
+
+def test_iteration_advances_completed_by_line_lengths() -> None:
+    data = b"ab\ncde\n"
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert list(reader) == [b"ab\n", b"cde\n"]
+    assert progress.tasks[0].completed == 6
