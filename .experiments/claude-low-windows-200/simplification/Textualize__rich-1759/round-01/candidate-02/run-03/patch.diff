+def test_wrap_file_reuses_existing_task_total() -> None:
+    data = b"hello world!"
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=12.5)
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+    assert reader.read() == data
+    assert progress.tasks[0].total == 12.5
+    assert progress.tasks[0].completed == 12
