+def test_progress_open_with_buffering_zero_text_raises_value_error() -> None:
+    progress = Progress(console=_file_console(), auto_refresh=False)
+    with pytest.raises(ValueError):
+        progress.open("does-not-exist.txt", "r", buffering=0, total=3)
+    with pytest.raises(ValueError):
+        progress.open("does-not-exist.txt", "tr", buffering=0, total=3)
