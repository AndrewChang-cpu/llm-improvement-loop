+    def open(
+        self,
+        file: Union[str, bytes, "os.PathLike[Any]"],
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file for reading and advance a task as bytes are read.
+
+        The display is not started by this method.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' and 'rt' return text, 'rb' returns bytes. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode only.
+            errors (str, optional): Text error handling, used in text mode only.
+            newline (str, optional): Text newline handling, used in text mode only.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is invalid, or buffering is 0 in text mode.
+            OSError: If the file cannot be sized or opened.
+        """
+        normalized = "".join(sorted(mode))
+        if normalized not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                    stacklevel=2,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            if buffering == 1:
+                line_buffering = True
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if mode in ("r", "rt"):
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file so that a task advances as bytes are read.
+
+        The file is not closed when the returned reader is closed.
+
+        Args:
+            file (BinaryIO): A binary file-like object to read from.
+            total (int, optional): Total size in bytes. Defaults to the total of ``task_id``.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader wrapping ``file``.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        if total is None and task_id is not None:
+            with self._lock:
+                total = self._tasks[task_id].total
+        if total is None:
+            raise ValueError("total must be specified, or the task must have a total")
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
+            self.update(task_id, total=total)
+        return _ProgressReader(file, self, task_id, owns_handle=False)
