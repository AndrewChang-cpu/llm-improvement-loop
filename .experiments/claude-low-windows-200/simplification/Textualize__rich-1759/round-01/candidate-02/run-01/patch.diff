+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"a\nbb\nccc\n"
+    progress = Progress(console=_file_console())
+    task_id = progress.add_task("read", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.readline() == b"a\n"
+    assert progress.tasks[0].completed == 2
+
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert progress.tasks[0].completed == 5
+
+    assert reader.readlines() == [b"ccc\n"]
+    assert progress.tasks[0].completed == 9
