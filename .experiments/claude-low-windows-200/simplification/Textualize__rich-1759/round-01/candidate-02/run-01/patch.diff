+def test_progress_wrap_file_reuses_task_total() -> None:
+    data = b"0123456789ab"
+    path = _write_temp(data)
+    try:
+        progress = Progress(console=_file_console())
+        task_id = progress.add_task("read", total=12.5)
+        with io.open(path, "rb") as caller_file:
