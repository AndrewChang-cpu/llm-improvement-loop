+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"alpha\nbeta\ngamma\ndelta\n"
+
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    task = progress.tasks[0]
+    assert reader.readline() == b"alpha\n"
+    assert task.completed == 6
+    assert reader.read(4) == b"beta"
+    assert task.completed == 10
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"\ngam"
+    assert task.completed == 14
+    assert reader.readlines() == [b"ma\n", b"delta\n"]
+    assert task.completed == 23
+
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    assert list(reader) == [b"alpha\n", b"beta\n", b"gamma\n", b"delta\n"]
+    assert progress.tasks[0].completed == 23
+
