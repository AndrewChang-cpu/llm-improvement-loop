+def test_reader_readlines_seek_tell_and_read() -> None:
+    data = b"line1\nline2\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    task = progress.tasks[0]
+    assert reader.readlines() == [b"line1\n", b"line2\n"]
+    assert task.completed == len(data)
+    assert reader.seek(3) == 3
+    assert task.completed == 3
+    assert reader.tell() == 3
+    assert reader.read(2) == b"e1"
+    assert task.completed == 5
