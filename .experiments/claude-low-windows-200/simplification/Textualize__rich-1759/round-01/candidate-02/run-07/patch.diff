+def _write_temp_file(data: bytes) -> str:
+    handle, path = tempfile.mkstemp()
+    with os.fdopen(handle, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def _make_console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True)
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello world\n")
+    try:
+        with progress_open(path, console=_make_console()) as reader:
+            assert reader.read() == "hello world\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
