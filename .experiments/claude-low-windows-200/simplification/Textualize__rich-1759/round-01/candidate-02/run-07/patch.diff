+def test_reader_readline_and_readinto_advance_completed() -> None:
+    data = b"line1\nline2\nline3\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    task = progress.tasks[0]
+    assert reader.readline() == b"line1\n"
+    assert task.completed == 6
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert task.completed == 10
+    assert list(reader) == [b"2\n", b"line3\n"]
+    assert task.completed == len(data)
+
