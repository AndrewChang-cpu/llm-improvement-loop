+def test_text_mode_forwards_large_buffering(monkeypatch) -> None:
+    path = _write_temp_file(b"hello")
+    real_open = io.open
+    seen_args = []
+
+    def recording_open(*args, **kwargs):
+        seen_args.append(args)
+        return real_open(*args, **kwargs)
+
+    try:
+        monkeypatch.setattr(io, "open", recording_open)
+        progress = Progress(console=_file_console())
+        f = progress.open(path, "r", buffering=8192)
+        try:
+            assert f.read() == "hello"
+        finally:
+            f.close()
+        assert seen_args[0][2] == 8192
+    finally:
+        os.remove(path)
