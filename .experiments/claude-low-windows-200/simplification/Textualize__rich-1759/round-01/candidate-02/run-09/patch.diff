+def test_reader_advances_completed_for_each_read_path() -> None:
+    data = b"line1\nline2\nline3\nline4\n"
+    progress = Progress(console=_file_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+
+    assert reader.readline() == b"line1\n"
+    assert progress.tasks[0].completed == 6
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert progress.tasks[0].completed == 10
+
+    assert reader.readlines() == [b"2\n", b"line3\n", b"line4\n"]
+    assert progress.tasks[0].completed == 24
+
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+    assert list(reader) == [b"line1\n", b"line2\n", b"line3\n", b"line4\n"]
+    assert progress.tasks[0].completed == 24
+
