+    def open(
+        self,
+        file: Union[str, bytes, "os.PathLike[str]"],
+        mode: str = "r",
+        buffering: int = -1,
+        encoding: Optional[str] = None,
+        errors: Optional[str] = None,
+        newline: Optional[str] = None,
+        *,
+        total: Optional[int] = None,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> Union[TextIO, BinaryIO]:
+        """Open a file path and read it, advancing a task as bytes are consumed.
+
+        The display is not started by this method. Use the returned object in a ``with`` statement.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): 'r' or 'rt' for text, or 'rb' for binary. Defaults to 'r'.
+            buffering (int, optional): Buffering policy, as for the built-in open. Defaults to -1.
+            encoding (str, optional): Text encoding, used in text mode. Defaults to None.
+            errors (str, optional): Error handling for text decoding. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total number of bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for 'r' and 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or buffering 0 is used in text mode.
+            OSError: If the file size cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode, "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+            line_buffering = False
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            if line_buffering:
+                buffering = -1
+
+        resolved_total: float
+        if total is None:
+            resolved_total = os.stat(file).st_size
+        else:
+            resolved_total = total
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+
+        handle = io.open(file, "rb", buffering)
+        reader = _ProgressReader(handle, self, task_id, owns_handle=True)
+        if mode == "r" or mode == "rt":
+            return io.TextIOWrapper(
+                reader,
+                encoding=encoding,
+                errors=errors,
+                newline=newline,
+                line_buffering=line_buffering,
+            )
+        return reader
+
+    def wrap_file(
+        self,
+        file: BinaryIO,
+        total: Optional[int] = None,
+        *,
+        task_id: Optional[TaskID] = None,
+        description: str = "Reading...",
+    ) -> BinaryIO:
+        """Wrap an open binary file-like object, advancing a task as bytes are consumed.
+
+        The wrapped file is not closed when the reader is closed.
+
+        Args:
+            file (BinaryIO): An open binary file-like object.
+            total (int, optional): Total number of bytes. Defaults to the total of ``task_id``.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            BinaryIO: A binary reader that advances the task.
+
+        Raises:
+            ValueError: If no total is given and the task has no total.
+        """
+        resolved_total: Optional[float] = total
+        if resolved_total is None and task_id is not None:
+            with self._lock:
+                resolved_total = self._tasks[task_id].total
+        if resolved_total is None:
+            raise ValueError(
+                "total must be specified, or the task must have a total"
+            )
+
+        if task_id is None:
+            task_id = self.add_task(description, total=resolved_total)
+        else:
+            self.update(task_id, total=resolved_total)
+
+        return _ProgressReader(file, self, task_id, owns_handle=False)
