+class _ProgressFileReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file object being wrapped.
+        progress (Progress): The Progress that owns the task.
+        task_id (TaskID): The task to advance.
+        owns_handle (bool): True if the reader opened the handle and should close it.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self._closed = False
+        self._owns_handle = owns_handle
+        self._progress = progress
+        self._task_id = task_id
+        self.handle = handle
+        super().__init__()
+
+    def _advance(self, count: int) -> None:
+        if count:
+            self._progress.advance(self._task_id, count)
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum bytes to read. Defaults to -1 (all).
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._advance(len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read one line and advance the task by its length.
+
+        Args:
+            size (int, optional): Maximum bytes to read. Defaults to -1.
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._advance(len(line))
+        return line
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read all lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._advance(sum(len(line) for line in lines))
+        return lines
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read bytes into a buffer and advance the task by the count returned.
+
+        Args:
+            buffer (Union[bytearray, memoryview, mmap.mmap]): Buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        self._advance(count)
+        return count
+
+    def __iter__(self) -> "_ProgressFileReader":
+        return self
+
+    def __next__(self) -> bytes:
+        line = self.handle.readline()
+        if not line:
+            raise StopIteration
+        self._advance(len(line))
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point for offset. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The new absolute position.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """int: The current position of the handle."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        return self.handle.isatty()
+
+    def writable(self) -> bool:
+        return False
+
+    def write(self, data: Any) -> int:
+        """Always raises, because the reader is read-only.
+
+        Args:
+            data (Any): Ignored.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def close(self) -> None:
+        """Close the handle if the reader owns it, and mark the reader closed."""
+        try:
+            if self._owns_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+            super().close()
+
+    def __enter__(self) -> "_ProgressFileReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressFileContext(Generic[_IOT]):
+    """Starts a progress display and yields a reader, stopping the display on exit.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        stream (IO): The file object to enter and exit within the display.
+    """
+
+    def __init__(self, progress: "Progress", stream: _IOT) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> _IOT:
+        self._progress.start()
+        try:
+            self._stream.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._stream
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._stream.__exit__(exc_type, exc_val, exc_tb)
+
+
