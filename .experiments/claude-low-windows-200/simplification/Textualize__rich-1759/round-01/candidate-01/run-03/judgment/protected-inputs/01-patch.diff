+def test_progress_wrap_file_reuses_task_total_without_truncating() -> None:
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=12.5)
+    reader = progress.wrap_file(io.BytesIO(b"abcdefghijkl"), task_id=task_id)
+    assert progress.tasks[0].total == 12.5
+    assert reader.read() == b"abcdefghijkl"
+    assert progress.tasks[0].completed == 12
