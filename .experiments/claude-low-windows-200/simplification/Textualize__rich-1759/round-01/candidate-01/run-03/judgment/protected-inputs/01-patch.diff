+def test_binary_mode_with_buffering_one_warns_and_reads() -> None:
+    path = _make_temp_file(b"abc")
+    try:
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        with pytest.warns(RuntimeWarning):
+            with progress.open(path, "rb", 1) as reader:
+                assert reader.read() == b"abc"
+    finally:
+        os.remove(path)
