+
+
+def _make_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as file:
+        file.write(data)
+    return path
+
+
+def _missing_path() -> str:
+    path = _make_temp_file(b"")
+    os.remove(path)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _make_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_make_console()) as reader:
+            assert reader.read() == "hello\nworld\n"
+        assert reader.closed
+    finally:
+        os.remove(path)
+
+
