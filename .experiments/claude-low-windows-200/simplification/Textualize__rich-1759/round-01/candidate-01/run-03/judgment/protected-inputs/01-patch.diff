+
+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    seen = []
+    real_open = io.open
+
+    def recording_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    path = _make_temp_file(b"abc")
+    try:
+        monkeypatch.setattr(io, "open", recording_open)
+        progress = Progress(console=_make_console(), auto_refresh=False)
+        with progress.open(path, "r", 512) as text:
+            assert text.read() == "abc"
+        assert seen == [512]
+    finally:
+        os.remove(path)
+
