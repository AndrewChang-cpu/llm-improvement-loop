+def test_reader_read_paths_advance_completed() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console(), auto_refresh=False)
+    task_id = progress.add_task("reading", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 13
+    buffer = bytearray(3)
+    assert reader.readinto(buffer) == 3
+    assert buffer == b" tw"
+    assert progress.tasks[0].completed == 16
+    assert reader.readlines() == [b"o\n", b"line three\n"]
+    assert progress.tasks[0].completed == 29
+
+
+def test_reader_iteration_advances_completed() -> None:
