+def test_read_paths_advance_completed_by_bytes_returned() -> None:
+    data = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_console())
+    task_id = progress.add_task("reading", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+    completed = progress.tasks[0].completed
+
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == completed + 9
+
+    assert next(reader) == b"line two\n"
+    assert progress.tasks[0].completed == completed + 18
+
+    assert reader.read(3) == b"lin"
+    assert progress.tasks[0].completed == completed + 21
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"e th"
+    assert progress.tasks[0].completed == completed + 25
+
+    assert reader.readlines() == [b"ree\n"]
+    assert progress.tasks[0].completed == completed + 29
+
