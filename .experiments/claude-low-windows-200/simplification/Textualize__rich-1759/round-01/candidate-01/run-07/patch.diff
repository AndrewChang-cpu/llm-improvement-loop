+def test_text_mode_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    path = _write_temp_file(b"data")
+    real_open = io.open
+    seen_buffering = []
+
+    def fake_open(file, mode="r", buffering=-1, *args, **kwargs):
+        seen_buffering.append(buffering)
+        return real_open(file, mode, buffering, *args, **kwargs)
+
+    monkeypatch.setattr(io, "open", fake_open)
+    try:
+        progress = Progress(console=_make_console())
+        reader = progress.open(path, "r", buffering=8192)
+        try:
+            assert reader.read() == "data"
+        finally:
+            reader.close()
+        assert seen_buffering == [8192]
+    finally:
+        os.remove(path)
