+def test_text_mode_buffering_is_forwarded_to_handle(monkeypatch) -> None:
+    path = _write_temp_file(b"forwarded\n")
+    calls = []
+    real_open = io.open
+
+    def spy(*args, **kwargs):
+        calls.append(args)
+        return real_open(*args, **kwargs)
+
+    try:
+        monkeypatch.setattr(io, "open", spy)
+        progress = Progress(console=_reader_console())
+        with progress.open(path, "r", buffering=8192) as text:
+            assert text.read() == "forwarded\n"
+        assert calls[-1][2] == 8192
+    finally:
+        os.remove(path)
+
