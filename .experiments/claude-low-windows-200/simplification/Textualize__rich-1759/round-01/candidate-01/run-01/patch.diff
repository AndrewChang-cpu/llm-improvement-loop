+        """Open a file for reading, advancing a task as it is read.
+
+        The display is not started by this method. Use the Progress as a context
+        manager, or call start(), to display progress.
+
+        Args:
+            file (Union[str, bytes, PathLike]): Path of the file to open.
+            mode (str, optional): File mode, 'r', 'rt', or 'rb'. Defaults to 'r'.
+            buffering (int, optional): Buffering policy passed to the file open. Defaults to -1.
+            encoding (str, optional): Text encoding for text mode. Defaults to None.
+            errors (str, optional): Error handling for text mode. Defaults to None.
+            newline (str, optional): Newline handling for text mode. Defaults to None.
+            total (int, optional): Total size in bytes. Defaults to the size of the file.
+            task_id (TaskID, optional): Existing task to advance. Defaults to a new task.
+            description (str, optional): Description of a new task. Defaults to "Reading...".
+
+        Returns:
+            Union[TextIO, BinaryIO]: A text wrapper for mode 'r' or 'rt', otherwise a binary reader.
+
+        Raises:
+            ValueError: If the mode is not supported, or if buffering is 0 in text mode.
+            OSError: If the file size cannot be obtained or the file cannot be opened.
+        """
+        normalized_mode = "".join(sorted(mode))
+        if normalized_mode not in ("r", "rt", "br"):
+            raise ValueError(f"invalid mode {mode!r}")
+
+        line_buffering = False
+        if normalized_mode == "br":
+            if buffering == 1:
+                warnings.warn(
+                    "line buffering is not supported in binary mode; "
+                    "the default buffer size is used",
+                    RuntimeWarning,
+                )
+                buffering = -1
+        else:
+            if buffering == 0:
+                raise ValueError("can't have unbuffered text I/O")
+            line_buffering = buffering == 1
+            if line_buffering:
+                buffering = -1
+
+        if total is None:
+            total = os.stat(file).st_size
+
+        if task_id is None:
+            task_id = self.add_task(description, total=total)
+        else:
