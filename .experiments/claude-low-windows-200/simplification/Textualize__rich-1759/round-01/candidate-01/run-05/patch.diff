+    finished_style: StyleType = "bar.finished",
+    pulse_style: StyleType = "bar.pulse",
+    disable: bool = False,
+) -> ContextManager[Union[TextIO, BinaryIO]]:
+    """Open a file and display a progress bar while it is read.
+
+    The display starts when the returned context manager is entered and stops
+    when it exits. The returned reader is closed on exit.
+
+    Args:
+        file (Union[str, bytes, os.PathLike]): Path of the file to open.
+        mode (str, optional): 'r' or 'rt' for text, 'rb' for binary. Defaults to 'r'.
+        buffering (int, optional): Buffering policy, as for the builtin open. Defaults to -1.
+        encoding (str, optional): Text encoding, used in text mode. Defaults to None.
+        errors (str, optional): Text error handling, used in text mode. Defaults to None.
+        newline (str, optional): Text newline handling, used in text mode. Defaults to None.
+        total (int, optional): Size of the file in bytes. Defaults to the file size.
+        description (str, optional): Description of the task. Defaults to "Reading...".
+        auto_refresh (bool, optional): Automatic refresh. Defaults to True.
+        console (Console, optional): Console to write to. Default creates internal Console instance.
+        transient (bool, optional): Clear the progress on exit. Defaults to False.
+        get_time (Callable, optional): A callable that gets the current time, or None to use Console.get_time. Defaults to None.
+        refresh_per_second (float, optional): Number of times per second to refresh the progress information. Defaults to 10.
+        style (StyleType, optional): Style for the bar background. Defaults to "bar.back".
+        complete_style (StyleType, optional): Style for the completed bar. Defaults to "bar.complete".
+        finished_style (StyleType, optional): Style for a finished bar. Defaults to "bar.finished".
+        pulse_style (StyleType, optional): Style for pulsing bars. Defaults to "bar.pulse".
+        disable (bool, optional): Disable display of progress. Defaults to False.
+
+    Returns:
+        ContextManager[Union[TextIO, BinaryIO]]: A text reader for 'r' and 'rt', otherwise a binary reader.
+    """
+    progress = _file_progress(
+        description,
+        auto_refresh,
+        console,
+        transient,
+        get_time,
+        refresh_per_second,
+        style,
+        complete_style,
+        finished_style,
+        pulse_style,
+        disable,
+    )
+    reader = progress.open(
+        file,
+        mode,
+        buffering,
+        encoding,
+        errors,
+        newline,
