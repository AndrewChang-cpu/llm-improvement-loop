+def test_text_buffering_above_one_is_forwarded_to_handle(monkeypatch) -> None:
+    real_open = io.open
+    buffering_values = []
+
+    def fake_open(file, mode="r", buffering=-1, **kwargs):
+        buffering_values.append(buffering)
+        return real_open(file, mode, buffering=buffering, **kwargs)
+
+    monkeypatch.setattr(io, "open", fake_open)
+    path = _write_temp_file(b"abc")
+    progress = Progress(console=_make_file_console(), disable=True)
+    reader = progress.open(path, "r", buffering=2)
+    try:
+        assert buffering_values == [2]
+        assert reader.read() == "abc"
+    finally:
+        reader.close()
+        os.remove(path)
+
