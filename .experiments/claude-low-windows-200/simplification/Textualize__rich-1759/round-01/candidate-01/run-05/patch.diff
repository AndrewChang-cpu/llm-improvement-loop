+def test_read_methods_advance_completed_by_bytes_returned() -> None:
+    content = b"line one\nline two\nline three\n"
+    progress = Progress(console=_make_file_console(), disable=True)
+    with io.BytesIO(content) as file:
+        reader = progress.wrap_file(file, len(content))
+        assert reader.readline() == b"line one\n"
+        assert progress.tasks[0].completed == 9
+        buffer = bytearray(4)
+        assert reader.readinto(buffer) == 4
+        assert bytes(buffer) == b"line"
+        assert progress.tasks[0].completed == 13
+        assert reader.read(3) == b" tw"
+        assert progress.tasks[0].completed == 16
+        assert reader.readlines() == [b"o\n", b"line three\n"]
+        assert progress.tasks[0].completed == len(content)
+
