+def test_read_methods_advance_completed_by_bytes_returned() -> None:
+    data = b"line1\nline2\nline3\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), len(data))
+    task = progress.tasks[0]
+    assert reader.read(3) == b"lin"
+    assert task.completed == 3
+    assert reader.readline() == b"e1\n"
+    assert task.completed == 6
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert task.completed == 10
+    assert reader.readlines() == [b"2\n", b"line3\n"]
+    assert task.completed == len(data)
+
