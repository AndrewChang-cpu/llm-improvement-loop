+def _make_console() -> Console:
+    return Console(file=io.StringIO(), force_terminal=True, width=60)
+
+
+def _write_temp_file(data: bytes) -> str:
+    fd, path = tempfile.mkstemp()
+    with os.fdopen(fd, "wb") as temp_file:
+        temp_file.write(data)
+    return path
+
+
+def _missing_path() -> str:
+    fd, path = tempfile.mkstemp()
+    os.close(fd)
+    os.remove(path)
+    return path
+
+
+def test_module_open_default_mode_reads_text() -> None:
+    path = _write_temp_file(b"hello\nworld\n")
+    try:
+        with progress_open(path, console=_make_console()) as text_file:
+            assert text_file.read() == "hello\nworld\n"
+        assert text_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_explicit_modes() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        console = _make_console()
+        with progress_open(path, "r", console=console) as text_file:
+            assert text_file.read() == "abc"
+        with progress_open(path, "rb", console=console) as binary_file:
+            assert binary_file.read() == b"abc"
+        assert binary_file.closed
+    finally:
+        os.remove(path)
+
+
+def test_module_open_closes_reader_when_body_raises() -> None:
+    path = _write_temp_file(b"abc")
+    try:
+        with pytest.raises(RuntimeError):
+            with progress_open(path, "rb", console=_make_console()) as binary_file:
+                raise RuntimeError("boom")
+        assert binary_file.closed
+    finally:
+        os.remove(path)
