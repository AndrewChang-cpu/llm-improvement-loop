+def test_reader_advances_by_bytes_returned() -> None:
+    progress = Progress(console=_make_file_console(), disable=True)
+    task_id = progress.add_task("read", total=100)
+    data = b"first line\nsecond line\nthird\n"
+    with io.BytesIO(data) as source:
+        reader = progress.wrap_file(source, task_id=task_id)
+        assert reader.readline() == b"first line\n"
+        assert progress.tasks[0].completed == 11
+        assert reader.read(5) == b"secon"
+        assert progress.tasks[0].completed == 16
+        assert reader.readlines() == [b"d line\n", b"third\n"]
+        assert progress.tasks[0].completed == 29
+        reader.close()
