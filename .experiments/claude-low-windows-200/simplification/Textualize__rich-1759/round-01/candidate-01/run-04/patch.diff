+def test_reader_read_paths_advance_completed() -> None:
+    data = b"alpha\nbeta\ngamma\ndelta\n"
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+    assert reader.read(3) == b"alp"
+    assert progress.tasks[0].completed == 3
+    assert reader.readline() == b"ha\n"
+    assert progress.tasks[0].completed == 6
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert buffer == b"beta"
+    assert progress.tasks[0].completed == 10
+    assert reader.readlines() == [b"\n", b"gamma\n", b"delta\n"]
+    assert progress.tasks[0].completed == len(data)
+
