+def test_text_buffering_above_one_is_forwarded(monkeypatch) -> None:
+    seen: dict = {}
+    original_open = io.open
+
+    def spy(*args, **kwargs):
+        seen.update(kwargs)
+        return original_open(*args, **kwargs)
+
+    monkeypatch.setattr(io, "open", spy)
+    path = _write_temp_file(b"data")
+    try:
+        progress = Progress(console=_make_file_console())
+        with progress.open(path, "r", buffering=8192) as text_file:
+            assert text_file.read() == "data"
+        assert seen["buffering"] == 8192
+    finally:
+        os.remove(path)
+
