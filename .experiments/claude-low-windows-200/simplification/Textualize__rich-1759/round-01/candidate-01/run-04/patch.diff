+class _ReaderContext(AbstractContextManager):
+    """Starts a Progress display and enters a reader for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress to start and stop.
+        stream (IO[Any]): The reader or text wrapper to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", stream: IO[Any]) -> None:
+        self._progress = progress
+        self._stream = stream
+
+    def __enter__(self) -> IO[Any]:
+        self._progress.start()
+        try:
+            self._stream.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+        return self._stream
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._stream.__exit__(exc_type, exc_val, exc_tb)
+
