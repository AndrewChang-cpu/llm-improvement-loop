+def test_reader_iteration_and_seek_track_position() -> None:
+    data = b"line one\nline two\nline three\nlast\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+
+    assert reader.seek(0) == 0
+    assert progress.tasks[0].completed == 0
+
+    lines = list(reader)
+    assert lines == [b"line one\n", b"line two\n", b"line three\n", b"last\n"]
+    assert progress.tasks[0].completed == 34
+
+    assert reader.seek(9) == 9
+    assert reader.tell() == 9
+    assert progress.tasks[0].completed == 9
+    assert reader.read() == data[9:]
+    assert progress.tasks[0].completed == 34
+
