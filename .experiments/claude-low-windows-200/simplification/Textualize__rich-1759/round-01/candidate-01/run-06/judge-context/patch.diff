+def test_reader_read_paths_advance_completed() -> None:
+    data = b"line one\nline two\nline three\nlast\n"
+    progress = Progress(console=_make_console())
+    reader = progress.wrap_file(io.BytesIO(data), total=len(data))
+
+    assert reader.readline() == b"line one\n"
+    assert progress.tasks[0].completed == 9
+
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"line"
+    assert progress.tasks[0].completed == 13
+
+    assert reader.readlines() == [b" two\n", b"line three\n", b"last\n"]
+    assert progress.tasks[0].completed == 34
+
