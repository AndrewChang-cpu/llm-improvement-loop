+            wrapped = progress_wrap_file(
+                caller_file, 11, console=_make_file_console()
+            )
+            with wrapped as reader:
+                assert reader.read() == b"hello world"
+            assert reader.closed
+            assert not caller_file.closed
+        assert caller_file.closed
+    finally:
