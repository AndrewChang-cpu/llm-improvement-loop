+def test_progress_open_forwards_large_text_buffering(monkeypatch) -> None:
+    path = _write_temp_file(b"hello world")
+    real_open = io.open
+    buffering_values = []
+
+    def recording_open(*args, **kwargs):
+        buffering_values.append(kwargs["buffering"])
+        return real_open(*args, **kwargs)
+
+    monkeypatch.setattr(io, "open", recording_open)
+    try:
+        progress = Progress(console=_make_file_console())
+        reader = progress.open(path, "r", buffering=8192)
+        try:
+            assert reader.read() == "hello world"
+        finally:
+            reader.close()
+        assert buffering_values == [8192]
+    finally:
+        os.remove(path)
+
