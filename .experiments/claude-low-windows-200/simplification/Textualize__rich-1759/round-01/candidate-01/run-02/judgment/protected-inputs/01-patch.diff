+class _ProgressReader(io.RawIOBase, BinaryIO):
+    """A binary reader that advances a progress task as bytes are consumed.
+
+    Args:
+        handle (BinaryIO): The binary file object to read from.
+        progress (Progress): The Progress instance that owns the task.
+        task_id (TaskID): The task to advance as bytes are read.
+        owns_handle (bool): True if closing the reader should close ``handle``.
+    """
+
+    def __init__(
+        self,
+        handle: BinaryIO,
+        progress: "Progress",
+        task_id: TaskID,
+        owns_handle: bool,
+    ) -> None:
+        self.handle = handle
+        self._progress = progress
+        self._task_id = task_id
+        self._owns_handle = owns_handle
+        self._closed = False
+
+    @property
+    def closed(self) -> bool:
+        """bool: True once the reader has been closed."""
+        return self._closed
+
+    def close(self) -> None:
+        """Close the reader, and the handle if the reader owns it."""
+        try:
+            if self._owns_handle:
+                self.handle.close()
+        finally:
+            self._closed = True
+
+    def read(self, size: int = -1) -> bytes:
+        """Read up to ``size`` bytes and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (all).
+
+        Returns:
+            bytes: The bytes read.
+        """
+        data = self.handle.read(size)
+        self._progress.advance(self._task_id, len(data))
+        return data
+
+    def readline(self, size: int = -1) -> bytes:  # type: ignore[override]
+        """Read one line and advance the task by the bytes returned.
+
+        Args:
+            size (int, optional): Maximum number of bytes to read. Defaults to -1 (no limit).
+
+        Returns:
+            bytes: The line read.
+        """
+        line = self.handle.readline(size)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def readinto(  # type: ignore[no-untyped-def, override]
+        self, buffer: Union[bytearray, memoryview, mmap.mmap]
+    ):
+        """Read bytes into a buffer and advance the task by the count returned.
+
+        Args:
+            buffer (Union[bytearray, memoryview, mmap.mmap]): Buffer to fill.
+
+        Returns:
+            int: The number of bytes read.
+        """
+        count = self.handle.readinto(buffer)  # type: ignore[attr-defined]
+        if count:
+            self._progress.advance(self._task_id, count)
+        return count
+
+    def readlines(self, hint: int = -1) -> List[bytes]:
+        """Read lines and advance the task by the total length of the lines.
+
+        Args:
+            hint (int, optional): Approximate number of bytes to read. Defaults to -1.
+
+        Returns:
+            List[bytes]: The lines read.
+        """
+        lines = self.handle.readlines(hint)
+        self._progress.advance(self._task_id, sum(len(line) for line in lines))
+        return lines
+
+    def __iter__(self) -> "_ProgressReader":
+        return self
+
+    def __next__(self) -> bytes:
+        """Return the next line and advance the task by its length.
+
+        Returns:
+            bytes: The next line of the handle.
+        """
+        line = next(self.handle)
+        self._progress.advance(self._task_id, len(line))
+        return line
+
+    def seek(self, offset: int, whence: int = io.SEEK_SET) -> int:
+        """Seek the handle and set the task's completed value to the new position.
+
+        Args:
+            offset (int): Offset in bytes.
+            whence (int, optional): Reference point for offset. Defaults to io.SEEK_SET.
+
+        Returns:
+            int: The new absolute position.
+        """
+        position = self.handle.seek(offset, whence)
+        self._progress.update(self._task_id, completed=position)
+        return position
+
+    def tell(self) -> int:
+        """Return the position of the handle."""
+        return self.handle.tell()
+
+    def readable(self) -> bool:
+        """Return whether the handle is readable."""
+        return self.handle.readable()
+
+    def seekable(self) -> bool:
+        """Return whether the handle is seekable."""
+        return self.handle.seekable()
+
+    def fileno(self) -> int:
+        """Return the file descriptor of the handle."""
+        return self.handle.fileno()
+
+    def isatty(self) -> bool:
+        """Return whether the handle is an interactive terminal."""
+        return self.handle.isatty()
+
+    def writable(self) -> bool:
+        """The reader is never writable."""
+        return False
+
+    def write(self, data: Any) -> int:
+        """Writing is not supported; always raises.
+
+        Args:
+            data (Any): Ignored.
+
+        Raises:
+            io.UnsupportedOperation: Always.
+        """
+        raise io.UnsupportedOperation("write")
+
+    def __enter__(self) -> "_ProgressReader":
+        self.handle.__enter__()
+        return self
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        self.close()
+
+
+class _ProgressContext:
+    """Starts a Progress display and enters a file for the duration of a with block.
+
+    Args:
+        progress (Progress): The Progress instance to start and stop.
+        file (Union[TextIO, BinaryIO]): The file object to enter and exit.
+    """
+
+    def __init__(self, progress: "Progress", file: Union[TextIO, BinaryIO]) -> None:
+        self._progress = progress
+        self._file = file
+
+    def __enter__(self) -> Any:
+        self._progress.start()
+        try:
+            return self._file.__enter__()
+        except BaseException:
+            self._progress.stop()
+            raise
+
+    def __exit__(
+        self,
+        exc_type: Optional[Type[BaseException]],
+        exc_val: Optional[BaseException],
+        exc_tb: Optional[TracebackType],
+    ) -> None:
+        try:
+            self._progress.stop()
+        finally:
+            self._file.__exit__(exc_type, exc_val, exc_tb)
+
