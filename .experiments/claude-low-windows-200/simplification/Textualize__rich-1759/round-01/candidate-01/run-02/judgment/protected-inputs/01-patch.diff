+def test_progress_reader_read_paths_advance_completed() -> None:
+    data = b"first line\nsecond line\nthird\n"
+    progress = Progress(console=_make_file_console())
+    task_id = progress.add_task("read", total=len(data))
+    task = progress.tasks[0]
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.readline() == b"first line\n"
+    assert task.completed == 11
+    buffer = bytearray(4)
+    assert reader.readinto(buffer) == 4
+    assert bytes(buffer) == b"seco"
+    assert task.completed == 15
+    assert reader.read(2) == b"nd"
+    assert task.completed == 17
+    assert reader.readlines() == [b" line\n", b"third\n"]
+    assert task.completed == len(data)
+
+
+def test_progress_reader_iteration_advances_completed() -> None:
+    data = b"first line\nsecond line\nthird\n"
+    progress = Progress(console=_make_file_console())
+    task_id = progress.add_task("read", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    lines = [line for line in reader]
+    assert lines == [b"first line\n", b"second line\n", b"third\n"]
+    assert progress.tasks[0].completed == len(data)
+
+
+def test_progress_reader_seek_sets_completed() -> None:
+    data = b"first line\nsecond line\n"
+    progress = Progress(console=_make_file_console())
+    task_id = progress.add_task("read", total=len(data))
+    reader = progress.wrap_file(io.BytesIO(data), task_id=task_id)
+
+    assert reader.seek(6) == 6
+    assert progress.tasks[0].completed == 6
+    assert reader.tell() == 6
+    assert reader.read(5) == b"line\n"
+    assert progress.tasks[0].completed == 11
+
+
+def test_progress_reader_write_raises_unsupported() -> None:
+    progress = Progress(console=_make_file_console())
+    reader = progress.wrap_file(io.BytesIO(b"abc"), total=3)
+    assert not reader.writable()
+    with pytest.raises(io.UnsupportedOperation, match="write"):
+        reader.write(b"x")
