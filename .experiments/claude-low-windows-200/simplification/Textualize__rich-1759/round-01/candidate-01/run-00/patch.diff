+def test_read_methods_advance_completed() -> None:
+    data = b"line1\nline2\nline3\n"
+
+    progress, _, reader = _wrapped_with_task(data)
+    assert reader.readline() == b"line1\n"
+    assert progress.tasks[0].completed == 6
+
+    progress, _, reader = _wrapped_with_task(data)
+    assert reader.read(4) == b"line"
+    assert progress.tasks[0].completed == 4
+
+    progress, _, reader = _wrapped_with_task(data)
+    buffer = bytearray(5)
+    assert reader.readinto(buffer) == 5
+    assert buffer == bytearray(b"line1")
+    assert progress.tasks[0].completed == 5
+
+    progress, _, reader = _wrapped_with_task(data)
+    assert reader.readlines() == [b"line1\n", b"line2\n", b"line3\n"]
+    assert progress.tasks[0].completed == 18
+
+    progress, _, reader = _wrapped_with_task(data)
+    assert [line for line in reader] == [b"line1\n", b"line2\n", b"line3\n"]
+    assert progress.tasks[0].completed == 18
