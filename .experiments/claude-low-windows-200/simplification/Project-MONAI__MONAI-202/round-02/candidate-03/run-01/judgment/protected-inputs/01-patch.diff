@@ -11,8 +11,12 @@
 
 import numpy as np
 import PIL
+import torch
 from PIL.GifImagePlugin import Image as GifImage
 from tensorboard.compat.proto import summary_pb2
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.transforms.utils import rescale_array
 
 
 def _image3_animated_gif(imp, scale_factor=1):
@@ -126,3 +130,45 @@ def add_animated_gif_no_channels(writer, tag, image_tensor, max_out, scale_facto
                                                                     max_out=max_out, animation_axes=[1],
                                                                     image_axes=[2, 3], scale_factor=scale_factor),
                                           global_step)
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot one item of a batch to TensorBoard as a 2D image or as 3D images shown as animated GIFs.
+
+    A 2D item is written as one image with suffix 'HW'. A 3D item with three channels is written as one RGB image
+    with suffix 'CHW' when max_channels is 3; otherwise channel 0 is written with suffix 'HW_0' when max_channels is
+    at least 1. An item with four or more dimensions is flattened into 3D volumes, and each of the first
+    max_channels volumes is written as an animated GIF with suffix 'HWD_j'. Other dimensionalities write nothing.
+
+    Args:
+        data (torch.Tensor or numpy.ndarray): batch in NCHW[D] layout; only the item at ``index`` is plotted.
+        step (int): global step value to record.
+        writer (torch.utils.tensorboard.SummaryWriter): TensorBoard writer to write to.
+        index (int): index of the item along the first dimension to plot.
+        max_channels (int): maximum number of channels or volumes to plot.
+        max_frames (int): number of frames of the animated GIFs.
+        tag (str): tag prefix of the written images.
+    """
+    assert isinstance(writer, SummaryWriter), 'writer must be a SummaryWriter.'
+    d = data[index]
+    if torch.is_tensor(d):
+        d = d.detach().cpu().numpy()
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+    elif d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            dataformats = 'CHW'
+            writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+        elif max_channels >= 1:
+            d2 = rescale_array(d[0], 0, 1)
+            dataformats = 'HW'
+            writer.add_image('{}_{}_0'.format(tag, dataformats), d2, step, dataformats=dataformats)
+    elif d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
