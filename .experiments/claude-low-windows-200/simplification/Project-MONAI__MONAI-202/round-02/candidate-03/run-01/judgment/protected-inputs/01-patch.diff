+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_save_batch_with_meta_data(self):
+        with tempfile.TemporaryDirectory() as temp_dir:
+            saver = CSVSaver(output_dir=temp_dir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8, 1), meta_data)
+            saver.finalize()
+
+            filepath = os.path.join(temp_dir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_save_without_meta_data_uses_item_index(self):
+        temp_dir = tempfile.mkdtemp()
+        try:
+            saver = CSVSaver(output_dir=temp_dir)
+            saver.save_batch(np.ones((3, 2), dtype=np.float32))
+            saver.finalize()
+
+            with open(os.path.join(temp_dir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            self.assertEqual(rows[1], ['1', '1.0', '1.0'])
+        finally:
+            shutil.rmtree(temp_dir, ignore_errors=True)
+
+    def test_save_keyword_arguments(self):
+        temp_dir = tempfile.mkdtemp()
+        try:
+            saver = CSVSaver(output_dir=temp_dir)
+            saver.save_batch(batch_data=torch.zeros(2, 1), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.save(data=torch.ones(1), meta_data={'filename_or_obj': 'c'})
+            saver.finalize()
+
+            with open(os.path.join(temp_dir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['a', 'b', 'c'])
+        finally:
+            shutil.rmtree(temp_dir, ignore_errors=True)
+
+    def test_overwrite_false_merges_file_rows(self):
+        temp_dir = tempfile.mkdtemp()
+        try:
+            filepath = os.path.join(temp_dir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,5.0\n')
+                f.write('C,7.0\n')
+
+            saver = CSVSaver(output_dir=temp_dir, overwrite=False)
+            saver.save(torch.tensor([1.0]), {'filename_or_obj': 'A'})
+            saver.save(torch.tensor([2.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # memory holds A and B, the file holds A and C: order is A, B, C and A takes the file's value
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            self.assertEqual(float(rows[0][1]), 5.0)
+            self.assertEqual(float(rows[1][1]), 2.0)
+            self.assertEqual(float(rows[2][1]), 7.0)
+        finally:
+            shutil.rmtree(temp_dir, ignore_errors=True)
+
+    def test_filename_must_end_with_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir='./', filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
