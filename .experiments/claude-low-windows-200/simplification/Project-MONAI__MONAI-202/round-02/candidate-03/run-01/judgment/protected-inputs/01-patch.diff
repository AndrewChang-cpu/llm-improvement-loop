+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+def _read_events(log_dir):
+    content = b''
+    for path in glob.glob(os.path.join(log_dir, 'events.out.tfevents*')):
+        with open(path, 'rb') as f:
+            content += f.read()
+    return content
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        default_dir = os.path.join('.', 'runs_plot')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        writer = SummaryWriter(log_dir=default_dir)
+        plot_2d_or_3d_image(torch.zeros(shape), 1, writer, index=0, max_channels=1, max_frames=4, tag='input_0')
+        writer.close()
+
+        self.assertTrue(os.path.exists(default_dir))
+        self.assertTrue(len(glob.glob(default_dir)) > 0)
+        shutil.rmtree(default_dir)
+
+    def test_three_dimensional_single_channel_writes_hw_0(self):
+        default_dir = os.path.join('.', 'runs_plot_hw0')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        writer = SummaryWriter(log_dir=default_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 1, writer, tag='input_0')
+        writer.close()
+
+        self.assertIn(b'input_0_HW_0', _read_events(default_dir))
+        shutil.rmtree(default_dir)
+
+    def test_three_dimensional_no_channels_writes_nothing(self):
+        default_dir = os.path.join('.', 'runs_plot_none')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        writer = SummaryWriter(log_dir=default_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 1, writer, max_channels=0, tag='input_0')
+        writer.close()
+
+        self.assertNotIn(b'HW_0', _read_events(default_dir))
+        shutil.rmtree(default_dir)
+
+
