index 0000000..49931dd
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,98 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches model outputs item by item and writes them to a CSV file with one row per item, without a header row.
+    Each row starts with the item key, followed by the flattened item values. The key is the ``filename_or_obj``
+    value of the meta data when meta data is present, otherwise the string form of the item index.
+    The file is written only when ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file content. When overwrite is false, rows
+                loaded from an existing file replace in-memory values with the same key. Keys found only in the
+                file are appended after all in-memory keys, in file order.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending with .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item. Saving with an existing key replaces its values and keeps its position.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): values of one item, channel-first.
+            meta_data (dict): optional meta data of this item. When it is present, the key is taken from
+                its ``'filename_or_obj'`` value, and a missing key raises KeyError. When it is absent or empty,
+                the key is the string form of the item index.
+        """
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of a batch by calling ``save`` for each item.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of items, the first dimension indexes the items.
+            meta_data (dict): optional meta data of the batch. Each value is a per-item sequence indexed in
+                parallel with the batch. Keys ``'filename_or_obj'`` and the per-item values are passed to ``save``.
+                When it is absent or empty, items are keyed by the item index.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = None
+            if meta_data:
+                item_meta = {k: v[i] for k, v in meta_data.items() if v is not None}
+            self.save(data, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached results to the CSV file, creating the output directory if it is missing.
+        When overwrite is false and the file exists, its rows are loaded first and merged into the cache.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if row:
+                        self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if self.output_dir:
+            os.makedirs(self.output_dir, exist_ok=True)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
