index 0000000..ff5657d
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,96 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the data as CSV rows, one row per item, keyed by file name or item index.
+    Values are cached in memory and written to the file when ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite existing CSV file content. When it is False and the file
+                exists, rows loaded from the existing file replace in-memory values with the same key.
+                Keys found only in the file are appended after the in-memory keys.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._cache = OrderedDict()
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is taken from the ``'filename_or_obj'`` entry of ``meta_data`` when it is
+        present, otherwise from the string form of the item index.
+
+        Args:
+            data (Tensor or numpy.ndarray): one item to save, channel-first.
+            meta_data (dict): optional meta data mapping with the key ``'filename_or_obj'``.
+                A missing key raises KeyError. When None or empty, the item index is used as the key.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache[key] = np.asarray(data).astype(np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item of a batch along the first dimension.
+
+        Args:
+            batch_data (Tensor or numpy.ndarray): batch of items, the first dimension indexes items.
+            meta_data (dict): optional meta data mapping. Each value is a per-item sequence indexed in parallel
+                with the batch. See ``save`` for the keys.
+        """
+        for i, item in enumerate(batch_data):
+            item_meta = None
+            if meta_data:
+                item_meta = {k: v[i] for k, v in meta_data.items()}
+            self.save(item, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached rows to the CSV file, one line per key in insertion order, without a header.
+        When ``overwrite`` is False and the file exists, its rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            file_cache = OrderedDict()
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    file_cache[row[0]] = np.array(row[1:]).astype(np.float32)
+            self._cache.update(file_cache)
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
