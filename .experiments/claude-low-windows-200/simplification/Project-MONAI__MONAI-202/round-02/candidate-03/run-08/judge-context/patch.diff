+import glob
+import os
+import shutil
+import tempfile
+import unittest
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [[1, 1, 10, 10]],
+    [[1, 3, 10, 10]],
+    [[1, 4, 10, 10]],
+    [[1, 1, 10, 10, 10]],
+    [[1, 3, 10, 10, 10]],
+]
+
+
+class RecordingSummaryWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images it writes."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.tags.append(tag)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+        self.writer = RecordingSummaryWriter(log_dir=os.path.join(self.test_dir, 'runs'))
+
+    def tearDown(self):
+        self.writer.close()
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        plot_2d_or_3d_image(torch.zeros(shape), 0, self.writer)
+        self.writer.flush()
+
+        self.assertTrue(os.path.exists(self.writer.log_dir))
+        self.assertTrue(len(glob.glob(os.path.join(self.writer.log_dir, '*'))) > 0)
+
+    def test_2d_image(self):
+        plot_2d_or_3d_image(torch.zeros(1, 10, 10), 0, self.writer, tag='output')
+        self.assertEqual(self.writer.tags, ['output_HW'])
+
+    def test_rgb_image(self):
+        plot_2d_or_3d_image(torch.zeros(1, 3, 10, 10), 0, self.writer, max_channels=3, tag='output')
+        self.assertEqual(self.writer.tags, ['output_CHW'])
+
+    def test_3d_single_channel_image(self):
+        plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, self.writer, tag='input_0')
+        self.assertEqual(self.writer.tags, ['input_0_HW_0'])
+
+    def test_3d_no_channel_writes_nothing(self):
+        plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, self.writer, max_channels=0, tag='input_0')
+        self.assertEqual(self.writer.tags, [])
+
+    def test_index_selects_item(self):
+        data = torch.zeros(2, 1, 10, 10)
+        data[1] = 1.0
+        plot_2d_or_3d_image(data, 0, self.writer, index=1, tag='output')
+        self.assertEqual(self.writer.tags, ['output_HW_0'])
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
