+
+import os
+import csv
+import shutil
+import tempfile
+import unittest
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return list(csv.reader(f))
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_save_batch_content(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+        saver.save_batch(torch.zeros(8, 1), meta_data)
+        saver.finalize()
+
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        rows = _read_rows(filepath)
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(float(row[1]), 0.0)
+
+    def test_keyword_calls(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save(data=torch.zeros(1), meta_data={'filename_or_obj': 'testfile0'})
+        saver.save_batch(batch_data=torch.zeros(2, 1), meta_data={'filename_or_obj': ['a', 'b']})
+        saver.finalize()
+
+        rows = _read_rows(os.path.join(self.test_dir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['testfile0', 'a', 'b'])
+
+    def test_index_naming_without_meta_data(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.zeros(3, 2))
+        saver.save(torch.zeros(2), {})
+        saver.finalize()
+
+        rows = _read_rows(os.path.join(self.test_dir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['0', '1', '2', '3'])
+        self.assertEqual(len(rows[0]), 3)
+
+    def test_overwrite_false_merges_file_values(self):
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        with open(filepath, 'w') as f:
+            f.write('A,5.0\n')
+            f.write('C,7.0\n')
+
+        saver = CSVSaver(output_dir=self.test_dir, overwrite=False)
+        saver.save(torch.tensor([1.0]), {'filename_or_obj': 'A'})
+        saver.save(torch.tensor([2.0]), {'filename_or_obj': 'B'})
+        saver.finalize()
+
+        rows = _read_rows(filepath)
+        self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+        self.assertEqual(float(rows[0][1]), 5.0)
+        self.assertEqual(float(rows[1][1]), 2.0)
+        self.assertEqual(float(rows[2][1]), 7.0)
+
+    def test_invalid_filename(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir=self.test_dir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
