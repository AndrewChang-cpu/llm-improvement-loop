+++ b/monai/data/csv_saver.py
@@ -0,0 +1,103 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves classification-style predictions into a CSV file, one row per item. The file is only written when
+    ``finalize`` is called. Items are keyed by the ``filename_or_obj`` meta data when it is present, otherwise by
+    the string form of the item index, which counts every item saved by this object from zero.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory that the CSV file is written into.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file. When it is False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key. Keys found only in
+                the existing file are appended after the in-memory keys, in file order.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = {}
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item for writing in ``finalize``.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): one item, the values of the prediction.
+            meta_data (dict): optional meta data of this item. The ``filename_or_obj`` key is used as the item key.
+                If it is None or empty, the item key is the string form of the item index.
+        """
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._index)
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        self._cache[key] = np.asarray(data).astype(np.float32)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``batch_data``.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): a batch whose first dimension indexes the items.
+            meta_data (dict): optional batch meta data. Each value is a per-item sequence, indexed in parallel with
+                the batch. If it is None or empty, items are keyed by their item index.
+        """
+        for i in range(len(batch_data)):
+            self.save(batch_data[i], _item_meta_data(meta_data, i))
+
+    def finalize(self):
+        """
+        Writes all cached items to the CSV file, one line per key in insertion order: the key, then each flattened
+        value separated by commas. When ``overwrite`` is False and the file exists, its rows are merged first.
+        """
+        cache = dict(self._cache)
+        if not self.overwrite and os.path.exists(self._filepath):
+            file_rows = {}
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if row:
+                        file_rows[row[0]] = np.array(row[1:]).astype(np.float32)
+            # assigning to an existing key keeps its position and replaces its value
+            for key, value in file_rows.items():
+                cache[key] = value
+
+        if self.output_dir:
+            os.makedirs(self.output_dir, exist_ok=True)
+        with open(self._filepath, 'w') as f:
+            for key, values in cache.items():
+                f.write(key)
+                for value in values.flatten():
+                    f.write(',' + str(value))
+                f.write('\n')
+
+
+def _item_meta_data(meta_data, index):
+    """Return the per-item meta data mapping for ``index``, or None when there is no meta data."""
+    if not meta_data:
+        return None
+    return {key: value[index] for key, value in meta_data.items()}
