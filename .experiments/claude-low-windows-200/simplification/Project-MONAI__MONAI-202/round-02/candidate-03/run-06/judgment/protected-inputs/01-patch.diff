+import glob
+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+def _event_bytes(log_dir):
+    """Concatenate the raw bytes of all event files, tags are stored as plain strings in them."""
+    data = b''
+    for filepath in glob.glob(os.path.join(log_dir, 'events.out.tfevents*')):
+        with open(filepath, 'rb') as f:
+            data += f.read()
+    return data
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, max_channels=3, max_frames=4)
+            writer.close()
+
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_3d_single_channel_writes_channel_zero(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, tag='input_0')
+            writer.close()
+
+            self.assertIn(b'input_0_HW_0', _event_bytes(tempdir))
+
+    def test_3d_non_rgb_max_channels_zero_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, max_channels=0, tag='input_0')
+            writer.close()
+
+            self.assertNotIn(b'input_0', _event_bytes(tempdir))
+
+    def test_index_selects_batch_item(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(2, 1, 10, 10), 0, writer, index=1, tag='output')
+            writer.close()
+
+            self.assertIn(b'output_HW_0', _event_bytes(tempdir))
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros(1, 10, 10), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
