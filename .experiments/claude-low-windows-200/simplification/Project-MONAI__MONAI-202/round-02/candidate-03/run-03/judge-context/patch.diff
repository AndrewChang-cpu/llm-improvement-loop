--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,98 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the predictions of items as a CSV file. Predictions are cached in memory, keyed by the item's
+    file name (from the meta data) or by its item index when meta data is absent, and written to disk
+    when ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file, must end with '.csv'.
+            overwrite (bool): whether to overwrite existing CSV file content. When overwrite is false and the file
+                exists, rows loaded from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the prediction of a single item.
+
+        Args:
+            data (Tensor or numpy.ndarray): the prediction of one item, channel-first.
+            meta_data (dict, optional): meta data of the item. Its ``'filename_or_obj'`` key gives the key of the
+                cached values. If it is none or empty, the string form of the item index is used as the key.
+                A missing ``'filename_or_obj'`` key raises KeyError.
+        """
+        if meta_data:
+            key = str(meta_data['filename_or_obj'])
+        else:
+            key = str(self._index)
+        self._index += 1
+
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._cache[key] = np.asarray(data).astype(np.float32)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches the predictions of a batch, one item at a time along the first dimension.
+
+        Args:
+            batch_data (Tensor or numpy.ndarray): predictions of the batch, the first dimension indexes the items.
+            meta_data (dict, optional): meta data of the batch. Each value is a per-item sequence indexed in
+                parallel with the batch. See ``save`` for the keys used.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None
+            if meta_data:
+                item_meta = {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached predictions to the CSV file, one line per key in insertion order. When overwrite is false
+        and the file exists, the rows of the existing file are merged first: values of keys already cached are
+        replaced, and keys found only in the file are appended after the cached keys.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
