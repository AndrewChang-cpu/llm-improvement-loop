+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta_data)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_index_keys_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(3, 2), None)
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            self.assertEqual(len(rows[0]), 3)
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir, filename='keyword.csv')
+            saver.save(data=torch.zeros(2), meta_data={'filename_or_obj': 'testfile'})
+            saver.save_batch(batch_data=torch.zeros(2, 2), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'keyword.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['testfile', 'a', 'b'])
+
+    def test_overwrite_false(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,1.0,1.0\nC,2.0,2.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(torch.zeros(2), {'filename_or_obj': 'A'})
+            saver.save(torch.zeros(2), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # A and B are in memory, C only in the file: order is A, B, C
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            # file values replace in-memory values for the shared key A
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [1.0, 1.0])
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [0.0, 0.0])
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32).tolist(), [2.0, 2.0])
+
+    def test_invalid_filename(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
