+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASE_1 = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}, 'testfile']
+TEST_CASE_2 = [{'filename_or_obj': ['sub/case' + str(i) + '.nii.gz' for i in range(8)]}, 'case']
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    @parameterized.expand([TEST_CASE_1, TEST_CASE_2])
+    def test_saved_content(self, meta_data, prefix):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(8, 1, 2, 2), meta_data)
+
+            for i in range(8):
+                name = prefix + str(i)
+                filepath = os.path.join(tempdir, name, name + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_no_meta_data_uses_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(np.zeros((2, 1, 2, 2)))
+            saver.save_batch(np.zeros((1, 1, 2, 2)), {})
+
+            for i in range(3):
+                filepath = os.path.join(tempdir, str(i), str(i) + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(batch_data=np.zeros((1, 1, 2, 2)))
+            saver.save(data=np.zeros((1, 1, 2, 2)), meta_data={'filename_or_obj': 'named'})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '0', '0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'named', 'named_seg.nii.gz')))
+
+    def test_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            data = np.zeros((1, 1, 2, 2), dtype=np.int32)
+
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(data, {'filename_or_obj': 'keep'})
+            kept = nib.load(os.path.join(tempdir, 'keep', 'keep_seg.nii.gz'))
+            self.assertEqual(np.dtype(kept.get_data_dtype()), np.dtype(np.int32))
