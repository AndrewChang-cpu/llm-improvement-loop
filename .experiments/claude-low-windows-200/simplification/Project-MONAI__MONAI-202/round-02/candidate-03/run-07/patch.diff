+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta_data)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                reader = csv.reader(f)
+                i = 0
+                for row in reader:
+                    self.assertEqual(row[0], 'testfile' + str(i))
+                    self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+                    i += 1
+                self.assertEqual(i, 8)
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(batch_data=torch.zeros(2, 3))
+            saver.save(data=np.ones(3), meta_data={'filename_or_obj': 'single'})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', 'single'])
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32).tolist(), [1.0, 1.0, 1.0])
+
+    def test_overwrite_false_merges_file(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,1.0\nC,3.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(torch.tensor([5.0]), {'filename_or_obj': 'A'})
+            saver.save(torch.tensor([6.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # keys in memory keep their positions, keys only in the file are appended in file order
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            # the value of A is taken from the file, replacing the in-memory value
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 1.0)
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32), 6.0)
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 3.0)
+
+    def test_filename_must_be_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir='.', filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
