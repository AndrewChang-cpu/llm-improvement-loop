--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,93 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches the values of items and writes them to a CSV file when ``finalize`` is called.
+    Each row of the file holds the key of an item followed by its flattened values, and there is no header row.
+    Items are keyed by the ``'filename_or_obj'`` meta data when it is present, otherwise by the item index.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the CSV file, it must be a string ending in ``'.csv'``.
+            overwrite (bool): whether to overwrite existing CSV file content. If False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = {}
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Cache one item. If ``meta_data`` is present, its ``'filename_or_obj'`` value is the key of the item.
+        If ``meta_data`` is absent (None or an empty mapping), the key is the string form of the item index.
+        The item index starts at zero and increases by one on every call.
+
+        Args:
+            data (Tensor or numpy.ndarray): one item, channel-first.
+            meta_data (dict, optional): per-item meta data mapping with the key ``'filename_or_obj'``.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Cache every item of a batch by calling ``save`` on each item along the first dimension.
+
+        Args:
+            batch_data (Tensor or numpy.ndarray): batch of items, the first dimension indexes the items.
+            meta_data (dict, optional): meta data mapping whose values are per-item sequences, indexed in parallel
+                with the batch. It must contain the key ``'filename_or_obj'`` when present.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta_data = None if not meta_data else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta_data)
+
+    def finalize(self):
+        """
+        Write the cached items to the CSV file, one line per key in insertion order.
+        When ``overwrite`` is False and the file exists, its rows are merged first: values of keys found in the file
+        replace the in-memory values, and keys found only in the file are appended after the in-memory keys.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if row:
+                        self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
