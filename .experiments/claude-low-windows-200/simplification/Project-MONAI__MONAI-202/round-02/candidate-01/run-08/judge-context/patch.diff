--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,94 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the data as CSV file, one row per item. Each row starts with a key followed by the flattened values.
+    Items are cached in memory and written to disk only when `finalize` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file.
+            filename (str): name of the saved CSV file name, must end with '.csv'.
+            overwrite (bool): whether to overwrite existing CSV file content. If False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key. Keys found only
+                in the file are appended after the in-memory keys, in file order.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._cache_dict = OrderedDict()
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is taken from the ``'filename_or_obj'`` value of `meta_data`. If `meta_data`
+        is absent (None or an empty mapping), the key is the string form of the item index.
+
+        Args:
+            data (Tensor or numpy.ndarray): the data of one item to save.
+            meta_data (dict): optional meta data mapping with the key ``'filename_or_obj'``.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache_dict[key] = np.asarray(data, dtype=np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of `batch_data`.
+
+        Args:
+            batch_data (Tensor or numpy.ndarray): a batch of data, the first dimension indexes items.
+            meta_data (dict): optional meta data mapping. Each value is a per-item sequence indexed in parallel
+                with the batch. The ``'filename_or_obj'`` key is required when `meta_data` is present.
+        """
+        for i, data in enumerate(batch_data):
+            per_item_meta = None
+            if meta_data:
+                per_item_meta = {k: v[i] for k, v in meta_data.items()}
+            self.save(data, per_item_meta)
+
+    def finalize(self):
+        """
+        Writes all cached items to the CSV file, one line per key in insertion order. If `overwrite` is False and
+        the file exists, rows are first loaded from the file and merged into the cache before writing.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
