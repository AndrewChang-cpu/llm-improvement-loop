+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_save_batch_content(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+        saver.save_batch(torch.zeros(8), meta_data)
+        saver.finalize()
+
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_save_without_meta_uses_item_index(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.ones(3, 2))
+        saver.save(np.zeros(2), {})
+        saver.finalize()
+
+        with open(os.path.join(self.test_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([row[0] for row in rows], ['0', '1', '2', '3'])
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [1.0, 1.0])
+        self.assertEqual(np.array(rows[3][1:]).astype(np.float32).tolist(), [0.0, 0.0])
+
+    def test_keyword_arguments(self):
+        saver = CSVSaver(output_dir=self.test_dir, filename='keyword.csv')
+        saver.save(data=torch.zeros(2), meta_data={'filename_or_obj': 'single'})
+        saver.save_batch(batch_data=torch.zeros(2, 2), meta_data={'filename_or_obj': ['a', 'b']})
+        saver.finalize()
+
+        with open(os.path.join(self.test_dir, 'keyword.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([row[0] for row in rows], ['single', 'a', 'b'])
+
+    def test_overwrite_false_merges_existing_file(self):
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        with open(filepath, 'w') as f:
+            f.write('A,1.0,1.0\nC,2.0,2.0\n')
+
+        saver = CSVSaver(output_dir=self.test_dir, overwrite=False)
+        saver.save_batch(torch.zeros(2, 2), {'filename_or_obj': ['A', 'B']})
+        saver.finalize()
+
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        # in-memory keys keep their positions, file-only keys are appended in file order
+        self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+        # A takes the value from the file, not the in-memory value
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [1.0, 1.0])
+        self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [0.0, 0.0])
+        self.assertEqual(np.array(rows[2][1:]).astype(np.float32).tolist(), [2.0, 2.0])
+
+    def test_filename_must_end_with_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir=self.test_dir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
