+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASES = [
+    [(8, 1, 2, 2)],
+    [(4, 2, 3, 3)],
+    [(2, 3, 4, 4, 2)],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_save_batch_content(self, shape):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(shape[0])]}
+        saver.save_batch(torch.zeros(shape), meta_data)
+
+        for i in range(shape[0]):
+            name = 'testfile' + str(i)
+            filepath = os.path.join(self.test_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_save_without_meta_uses_item_index(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.zeros(2, 1, 2, 2))
+        saver.save(np.zeros((1, 2, 2)), {})
+
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, '0', '0_seg.nii.gz')))
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, '1', '1_seg.nii.gz')))
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, '2', '2_seg.nii.gz')))
+
+    def test_path_layout_drops_input_directory(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save(torch.zeros(1, 2, 2), {'filename_or_obj': 'sub/case0.nii.gz'})
+
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, 'case0', 'case0_seg.nii.gz')))
+        self.assertFalse(os.path.exists(os.path.join(self.test_dir, 'sub')))
+
+    def test_default_dtype_keeps_data_dtype(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'int_case'})
+
+        img = nib.load(os.path.join(self.test_dir, 'int_case', 'int_case_seg.nii.gz'))
+        self.assertEqual(img.get_data_dtype(), np.int32)
+
+    def test_set_dtype_is_used(self):
+        saver = NiftiSaver(output_dir=self.test_dir, dtype=np.float32)
+        saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'float_case'})
+
+        img = nib.load(os.path.join(self.test_dir, 'float_case', 'float_case_seg.nii.gz'))
+        self.assertEqual(img.get_data_dtype(), np.float32)
+
+    def test_keyword_arguments(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save(data=torch.zeros(1, 2, 2), meta_data={'filename_or_obj': 'single'})
