+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.transforms.utils import rescale_array
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class _RecordingSummaryWriter(SummaryWriter):
+    """SummaryWriter that also records the tags and images passed to add_image."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+        self.images = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+        self.images.append(img_tensor)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+        self.writer = _RecordingSummaryWriter(log_dir=self.test_dir)
+
+    def tearDown(self):
+        self.writer.close()
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        plot_2d_or_3d_image(torch.zeros(shape), 0, self.writer, index=0, max_channels=1, max_frames=4,
+                            tag='input_0')
+        self.writer.flush()
+
+        self.assertTrue(os.path.exists(self.test_dir))
+        self.assertTrue(len(os.listdir(self.test_dir)) > 0)
+
+    def test_2d_item_writes_hw_image(self):
+        plot_2d_or_3d_image(torch.zeros(1, 10, 10), 0, self.writer, tag='output')
+        self.assertEqual(self.writer.image_tags, ['output_HW'])
+
+    def test_3d_single_channel_writes_hw_0_image(self):
+        plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, self.writer, tag='input_0')
+        self.assertEqual(self.writer.image_tags, ['input_0_HW_0'])
+
+    def test_3d_non_rgb_max_channels_zero_writes_nothing(self):
+        plot_2d_or_3d_image(torch.zeros(1, 4, 10, 10), 0, self.writer, max_channels=0, tag='input_0')
+        self.assertEqual(self.writer.image_tags, [])
+
+    def test_3d_rgb_writes_chw_image(self):
+        plot_2d_or_3d_image(torch.zeros(1, 3, 10, 10), 0, self.writer, max_channels=3, tag='input_0')
+        self.assertEqual(self.writer.image_tags, ['input_0_CHW'])
+
+    def test_index_selects_batch_item(self):
+        data = np.random.rand(2, 1, 10, 10).astype(np.float32)
+        plot_2d_or_3d_image(data, 0, self.writer, index=1, tag='output')
+
+        self.assertEqual(self.writer.image_tags, ['output_HW_0'])
+        expected = rescale_array(data[1][0], 0, 1)
+        np.testing.assert_allclose(np.asarray(self.writer.images[0]), expected, rtol=1e-5)
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer=object(), tag='output')
+
+
+if __name__ == '__main__':
+    unittest.main()
