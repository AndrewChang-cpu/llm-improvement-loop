+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_saved_content(self):
+        # set up engine
+        def _train_func(engine, batch):
+            return torch.zeros(8, 1, 2, 2)
+
+        engine = Engine(_train_func)
+
+        # set up testing handler
+        saver = SegmentationSaver(output_dir=self.test_dir, output_postfix='seg', output_ext='.nii.gz')
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        for i in range(8):
+            name = 'testfile' + str(i)
+            filepath = os.path.join(self.test_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+            # each item is channel-first (1, 2, 2), written channel-last
+            self.assertEqual(nib.load(filepath).shape, (2, 2, 1))
+
+    def test_attach_sets_logger_from_name(self):
+        def _train_func(engine, batch):
+            return torch.zeros(1, 1, 2, 2)
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_dir=self.test_dir, name='evaluator')
+        saver.attach(engine)
+        self.assertEqual(saver.logger.name, 'evaluator')
+
+
+if __name__ == '__main__':
+    unittest.main()
