index 0000000..e8f0fbb
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,98 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the data items as rows of a CSV file. Each row starts with a key, followed by the flattened values
+    of the item. Items are cached in memory and written to the file only when `finalize` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file content. If False and the file exists,
+                the rows loaded from the existing file replace in-memory values with the same key. Keys found
+                only in the file are appended after the in-memory keys, in file order.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._cache_dict = OrderedDict()
+        self._idx = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is the `filename_or_obj` value of `meta_data` when it is present,
+        otherwise the string form of the item index.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the data item to save.
+            meta_data (dict): optional meta data mapping with the key `filename_or_obj`. None or an empty mapping
+                means absent meta data, and the item index is used as the key.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._idx)
+        self._cache_dict[key] = np.array(data, dtype=np.float32)
+        self._idx += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of `batch_data`.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): the batch of data items, the first dimension is the batch.
+            meta_data (dict): optional meta data mapping. Each value is a per-item sequence indexed in parallel
+                with the batch, and must contain the key `filename_or_obj`. None or an empty mapping means
+                absent meta data, and the item index is used as the key.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached items to the CSV file, one line per key in insertion order. Creates the output
+        directory if it is missing. When `overwrite` is False and the file exists, the rows of the existing file
+        are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            file_dict = OrderedDict()
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    file_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+            for k, v in file_dict.items():
+                self._cache_dict[k] = v
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
