+
+        data = [{'filename_or_obj': ['intfile']}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        img = nib.load(os.path.join(self.test_dir, 'intfile', 'intfile_seg.nii.gz'))
+        self.assertEqual(img.get_data_dtype(), np.int16)
+
+
+if __name__ == '__main__':
+    unittest.main()
