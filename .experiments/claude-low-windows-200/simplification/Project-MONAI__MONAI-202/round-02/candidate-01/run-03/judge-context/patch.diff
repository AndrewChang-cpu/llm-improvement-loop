+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def _read_rows(self, filepath):
+        with open(filepath, 'r') as f:
+            return list(csv.reader(f))
+
+    def test_save_batch_and_finalize(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+        saver.save_batch(torch.zeros(8), meta_data)
+        saver.finalize()
+
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        rows = self._read_rows(filepath)
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_save_without_meta_data_uses_index(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(np.zeros((3, 2)))
+        saver.finalize()
+
+        rows = self._read_rows(os.path.join(self.test_dir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+
+    def test_save_with_empty_meta_data_uses_index(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(np.zeros((2, 2)), {})
+        saver.finalize()
+
+        rows = self._read_rows(os.path.join(self.test_dir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['0', '1'])
+
+    def test_keyword_calls(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(batch_data=torch.zeros(2), meta_data={'filename_or_obj': ['a', 'b']})
+        saver.save(data=torch.ones(2), meta_data={'filename_or_obj': 'c'})
+        saver.finalize()
+
+        rows = self._read_rows(os.path.join(self.test_dir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['a', 'b', 'c'])
+
+    def test_overwrite_false_merge(self):
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        with open(filepath, 'w') as f:
+            f.write('A,1.0,2.0\nC,3.0\n')
+
+        saver = CSVSaver(output_dir=self.test_dir, overwrite=False)
+        saver.save(np.array([5.0, 5.0]), {'filename_or_obj': 'A'})
+        saver.save(np.array([6.0, 6.0]), {'filename_or_obj': 'B'})
+        saver.finalize()
+
+        rows = self._read_rows(filepath)
+        # memory keys keep their positions, file-only keys are appended in file order
+        self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+        # the file value replaces the in-memory value of the shared key A
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [1.0, 2.0])
+        self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [6.0, 6.0])
+        self.assertEqual(np.array(rows[2][1:]).astype(np.float32).tolist(), [3.0])
+
+    def test_overwrite_true_ignores_existing_file(self):
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        with open(filepath, 'w') as f:
+            f.write('A,1.0\n')
+
+        saver = CSVSaver(output_dir=self.test_dir, overwrite=True)
+        saver.save(np.array([5.0]), {'filename_or_obj': 'B'})
+        saver.finalize()
+
+        rows = self._read_rows(filepath)
+        self.assertEqual([row[0] for row in rows], ['B'])
+
+    def test_creates_missing_output_dir(self):
+        output_dir = os.path.join(self.test_dir, 'sub', 'dir')
+        saver = CSVSaver(output_dir=output_dir)
+        saver.save(np.zeros(1), {'filename_or_obj': 'x'})
+        saver.finalize()
+
+        self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+
+if __name__ == '__main__':
+    unittest.main()
