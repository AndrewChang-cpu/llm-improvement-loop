+import os
+import shutil
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASE_1 = [(1, 1, 10, 10)]
+TEST_CASE_2 = [(1, 3, 10, 10)]
+TEST_CASE_3 = [(1, 4, 10, 10)]
+TEST_CASE_4 = [(1, 1, 10, 10, 10)]
+TEST_CASE_5 = [(1, 3, 10, 10, 10)]
+
+
+class RecordingWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images added through add_image."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, *args, **kwargs):
+        self.image_tags.append(tag)
+        super().add_image(tag, *args, **kwargs)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand([TEST_CASE_1, TEST_CASE_2, TEST_CASE_3, TEST_CASE_4, TEST_CASE_5])
+    def test_plot_shapes(self, shape):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=2, tag='input_0')
+        writer.close()
+
+        self.assertTrue(os.path.exists(self.test_dir))
+        self.assertTrue(len(os.listdir(self.test_dir)) > 0)
+
+    def test_3d_single_channel_writes_first_channel(self):
+        writer = RecordingWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, tag='input_0')
+        writer.close()
+
+        self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_3d_non_rgb_with_zero_max_channels_writes_nothing(self):
+        writer = RecordingWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 3, 10, 10)), 0, writer, max_channels=0, tag='output')
+        writer.close()
+
+        self.assertEqual(writer.image_tags, [])
+
+    def test_index_selects_batch_item(self):
+        writer = RecordingWriter(log_dir=self.test_dir)
+        data = torch.zeros((2, 3, 10, 10))
+        plot_2d_or_3d_image(data, 0, writer, index=1, tag='output')
+        writer.close()
+
+        # item 1 is 3D with a non-RGB channel count under the default max_channels, so only HW_0 is written
+        self.assertEqual(writer.image_tags, ['output_HW_0'])
+
+
+if __name__ == '__main__':
+    unittest.main()
