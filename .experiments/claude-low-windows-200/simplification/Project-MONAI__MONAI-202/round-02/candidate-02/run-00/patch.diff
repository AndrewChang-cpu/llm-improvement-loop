+# limitations under the License.
+
+import os
+import numpy as np
+import torch
+from monai.data.nifti_writer import write_nifti
+
+
+class NiftiSaver:
+    """
+    Saves predictions as NIfTI files, one file per item, in ``<output_dir>/<base name>/<base name>_<postfix><ext>``.
+    """
+
+    def __init__(self, output_dir='./', output_postfix='seg', output_ext='.nii.gz', dtype=None):
+        """
+        Args:
+            output_dir (str): output directory, defaults to the current directory.
+            output_postfix (str): a string appended to the base name of all output files.
+            output_ext (str): output file extension.
+            dtype (numpy.dtype): data type to write. When None, the data's own dtype is kept.
+        """
+        self.output_dir = output_dir
+        self.output_postfix = output_postfix
+        self.output_ext = output_ext
+        self.dtype = dtype
+        self._item_index = 0
+
+    @staticmethod
+    def _create_file_basename(postfix, input_file_name, folder_path, data_root_dir=""):
+        """
+        Utility function to create the path to the output file based on the input
+        filename (extension is added by the NIfTI writer before writing the file).
+
+        Args:
+            postfix (str): output name's postfix.
+            input_file_name (str): path to the input image file, only its base name is used unless
+                ``data_root_dir`` is given.
+            folder_path (str): path for the output file.
+            data_root_dir (str): if not empty, it specifies the beginning parts of the input file's
+                absolute path. This is used to compute the relative path to the file from ``data_root_dir``
+                to preserve folder structure when saving in case there are files in different folders with
+                the same file names.
+        """
+        # get the filename and directory
+        filedir, filename = os.path.split(input_file_name)
+
+        # jettison the extension to have just filename
+        filename, ext = os.path.splitext(filename)
+        while ext != "":
+            filename, ext = os.path.splitext(filename)
+
+        # use data_root_dir to find relative path to file
+        filedir_rel_path = ""
+        if data_root_dir:
+            filedir_rel_path = os.path.relpath(filedir, data_root_dir)
+
+        # sub-folder path will be original name without the extension
+        subfolder_path = os.path.join(folder_path, filedir_rel_path, filename)
+        if not os.path.exists(subfolder_path):
+            os.makedirs(subfolder_path)
+
+        # add the sub-folder plus the postfix name to become the file basename in the output path
+        return os.path.join(subfolder_path, filename + "_" + postfix)
+
+    def save(self, data, meta_data=None):
+        """
+        Writes one item to a NIfTI file. The base name comes from the ``'filename_or_obj'`` meta data key when
+        meta data is present, otherwise from the string form of the item index. The optional ``'affine'`` and
+        ``'original_affine'`` keys of ``meta_data`` are used for the output affine. The channel axis (first
+        dimension) is moved to the last position before writing.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the prediction of one item, channel-first.
+            meta_data (dict): optional meta data mapping with keys ``'filename_or_obj'``, ``'affine'`` and
+                ``'original_affine'``. When it is none or empty, the item is named by its item index and no
+                affine is used.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        data = np.asarray(data)
+
+        if meta_data:
+            base_name = meta_data['filename_or_obj']
+            affine = meta_data.get('affine', None)
+            original_affine = meta_data.get('original_affine', None)
+        else:
+            base_name = str(self._item_index)
+            affine = None
+            original_affine = None
+        self._item_index += 1
+
+        affine = affine.detach().cpu().numpy() if torch.is_tensor(affine) else affine
+        original_affine = original_affine.detach().cpu().numpy() if torch.is_tensor(original_affine) \
+            else original_affine
+
+        output_filename = self._create_file_basename(self.output_postfix, base_name, self.output_dir)
+        output_filename = '{}{}'.format(output_filename, self.output_ext)
+        dtype = self.dtype if self.dtype is not None else data.dtype
+        # change output to "channel last" format and write to nifti format file
+        to_save = np.moveaxis(data, 0, -1)
+        write_nifti(to_save, affine, output_filename, original_affine, dtype=dtype)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Writes each item along the first dimension of ``batch_data`` with :py:meth:`save`.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of predictions, the first dimension indexes items.
+            meta_data (dict): optional meta data mapping. Each value is a per-item sequence indexed in parallel
+                with the batch. When it is none or empty, each item is named by its item index.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None if not meta_data else {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
