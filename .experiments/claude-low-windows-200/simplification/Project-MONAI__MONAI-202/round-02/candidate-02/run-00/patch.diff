+import tempfile
+import unittest
+import numpy as np
+import nibabel as nib
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+        self.output_dir = os.path.join(self.test_dir, 'output')
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand([[(8, 1, 2, 2)], [(8, 2, 3, 4, 5)]])
+    def test_saved_content(self, shape):
+        saver = NiftiSaver(output_dir=self.output_dir)
+        names = ['testfile' + str(i) for i in range(8)]
+        saver.save_batch(torch.zeros(shape), {'filename_or_obj': names})
+
+        for name in names:
+            filepath = os.path.join(self.output_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_without_meta_data_uses_item_index(self):
+        saver = NiftiSaver(output_dir=self.output_dir)
+        saver.save_batch(torch.zeros(8, 1, 2, 2))
+
+        for i in range(8):
+            filepath = os.path.join(self.output_dir, str(i), str(i) + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_empty_meta_data_uses_item_index(self):
+        saver = NiftiSaver(output_dir=self.output_dir)
+        saver.save_batch(torch.zeros(8, 1, 2, 2), {})
+
+        for i in range(8):
+            filepath = os.path.join(self.output_dir, str(i), str(i) + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_input_subfolder_is_not_preserved(self):
+        saver = NiftiSaver(output_dir=self.output_dir)
+        saver.save(np.zeros((1, 2, 2)), {'filename_or_obj': 'sub/case0.nii.gz'})
