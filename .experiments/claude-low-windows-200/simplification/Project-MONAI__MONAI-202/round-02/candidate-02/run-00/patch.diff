+import os
+import shutil
+import tempfile
+import unittest
+import numpy as np
+import nibabel as nib
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+        self.output_dir = os.path.join(self.test_dir, 'output')
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def _run(self, output, names, **kwargs):
+        def _train_func(engine, batch):
+            return output
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_dir=self.output_dir, **kwargs)
+        saver.attach(engine)
+        engine.run([{'filename_or_obj': names}], max_epochs=1)
+
+    def test_saved_content(self):
+        names = ['testfile' + str(i) for i in range(8)]
+        self._run(torch.zeros((8, 1, 2, 2)), names)
+
+        for name in names:
+            filepath = os.path.join(self.output_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_integer_output_keeps_integer_dtype(self):
+        names = ['testfile' + str(i) for i in range(8)]
+        self._run(torch.zeros((8, 1, 2, 2), dtype=torch.int32), names)
+
+        img = nib.load(os.path.join(self.output_dir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(img.get_data_dtype(), np.dtype(np.int32))
+
+
+if __name__ == '__main__':
+    unittest.main()
