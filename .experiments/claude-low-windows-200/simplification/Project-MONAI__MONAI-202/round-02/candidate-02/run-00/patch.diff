+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=4, tag='output')
+        writer.close()
+
+        self.assertTrue(len(os.listdir(self.test_dir)) > 0)
+
