+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches per-item predictions in memory and writes them to a CSV file on ``finalize``.
+    Each line of the file holds the item key followed by its flattened float32 values. There is no header row.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory for the CSV file, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite an existing file. When False and the file exists, rows loaded
+                from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._item_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is the ``'filename_or_obj'`` value of ``meta_data`` when meta data is present,
+        otherwise the string form of the item index. The item index advances by one on every call.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the prediction of one item.
+            meta_data (dict): optional meta data mapping with key ``'filename_or_obj'``. When it is none or
+                empty, the item is named by its item index.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = str(meta_data['filename_or_obj'])
+        else:
+            key = str(self._item_index)
+        self._item_index += 1
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches each item along the first dimension of ``batch_data``.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of predictions, the first dimension indexes items.
+            meta_data (dict): optional meta data mapping. Each value is a per-item sequence indexed in parallel
+                with the batch. When it is none or empty, each item is named by its item index.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None if not meta_data else {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order. When ``overwrite`` is
+        False and the file exists, rows loaded from the file replace in-memory values with the same key, and
+        file-only keys are appended after the in-memory keys in file order.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
