--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,96 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches per-item values and writes them to a CSV file without a header row.
+    Each row is the item key followed by its flattened values.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite existing CSV file content. When it is False and the file
+                exists, rows loaded from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is the ``'filename_or_obj'`` value of ``meta_data`` when meta data is present,
+        otherwise the string form of the item index. The item index increments on every call.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of one item.
+            meta_data (dict): optional meta data mapping with the key ``'filename_or_obj'``.
+                If none or empty, the item is named by its item index.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = str(meta_data['filename_or_obj'])
+        else:
+            key = str(self._index)
+        self._index += 1
+        self._cache_dict[key] = np.asarray(data, dtype=np.float32)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``batch_data`` by calling ``save`` for each item.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): data whose first dimension indexes items.
+            meta_data (dict): optional meta data mapping. Each value is a per-item sequence indexed in parallel
+                with the batch, for example ``'filename_or_obj'`` holds one name per item.
+                If none or empty, items are named by their item index.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta_data = None
+            if meta_data:
+                item_meta_data = {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta_data)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file. When ``overwrite`` is False and the file exists, its rows are
+        merged first: rows replace in-memory values with the same key, and file-only keys are appended after the
+        in-memory keys, in file order.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:], dtype=np.float32)
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for key, values in self._cache_dict.items():
+                f.write(key)
+                for value in values.flatten():
+                    f.write(',' + str(value))
+                f.write('\n')
