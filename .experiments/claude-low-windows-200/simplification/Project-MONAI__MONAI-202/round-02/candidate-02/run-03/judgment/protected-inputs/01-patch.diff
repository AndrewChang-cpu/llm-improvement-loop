+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import numpy as np
+import torch
+from monai.data.nifti_writer import write_nifti
+
+
+class NiftiSaver:
+    """
+    Writes data items to NIfTI files, one file per item, named from the input filename in the meta data
+    or from the item index when no meta data is given.
+    """
+
+    def __init__(self, output_dir='./', output_postfix='seg', output_ext='.nii.gz', dtype=None):
+        """
+        Args:
+            output_dir (str): output directory to write the files into.
+            output_postfix (str): a string appended to all output file names.
+            output_ext (str): output file extension name.
+            dtype (numpy.dtype): data type to write. If None, the data's own dtype is used.
+        """
+        self.output_dir = output_dir
+        self.output_postfix = output_postfix
+        self.output_ext = output_ext
+        self.dtype = dtype
+        self._index = 0
+
+    @staticmethod
+    def _create_file_basename(postfix, input_file_name, folder_path, data_root_dir=''):
+        """
+        Creates the path to the output file based on the input filename. The file extension is added by the
+        NIfTI writer. The output is ``folder_path/<base name>/<base name>_<postfix>``.
+
+        Args:
+            postfix (str): output name's postfix.
+            input_file_name (str): path to the input image file, only its base name is used unless
+                ``data_root_dir`` is given.
+            folder_path (str): path of the output folder.
+            data_root_dir (str): if not empty, it specifies the beginning parts of the input file's
+                absolute path. This is used to compute the relative path to the file from ``data_root_dir``
+                to preserve folder structure when saving in case there are files in different folders with
+                the same file names.
+        """
+        # get the filename and directory
+        filedir, filename = os.path.split(input_file_name)
+
+        # jettison the extension to have just filename
+        filename, ext = os.path.splitext(filename)
+        while ext != '':
+            filename, ext = os.path.splitext(filename)
+
+        # use data_root_dir to find relative path to file
+        filedir_rel_path = ''
+        if data_root_dir:
+            filedir_rel_path = os.path.relpath(filedir, data_root_dir)
+
+        # sub-folder path will be original name without the extension
+        subfolder_path = os.path.join(folder_path, filedir_rel_path, filename)
+        os.makedirs(subfolder_path, exist_ok=True)
+
+        # add the sub-folder plus the postfix name to become the file basename in the output path
+        return os.path.join(subfolder_path, filename + '_' + postfix)
+
+    def save(self, data, meta_data=None):
+        """
+        Writes one item to a NIfTI file. The channel axis (first axis) is moved to the last position before writing.
+
+        Meta data keys:
+
+            - ``'filename_or_obj'``: used to name the output file. If the meta data is none or empty, the item
+              index is used as the name instead.
+            - ``'affine'`` (optional): affine of the output image.
+            - ``'original_affine'`` (optional): original affine used for orientation handling.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of one item, channel-first.
+            meta_data (dict): optional meta data mapping, see above.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        affine = None
+        original_affine = None
+        if meta_data:
+            filename = meta_data['filename_or_obj']
+            affine = meta_data.get('affine', None)
+            original_affine = meta_data.get('original_affine', None)
+        else:
+            filename = str(self._index)
+        self._index += 1
+        if torch.is_tensor(affine):
+            affine = affine.detach().cpu().numpy()
+        if torch.is_tensor(original_affine):
+            original_affine = original_affine.detach().cpu().numpy()
+
+        output_file = self._create_file_basename(self.output_postfix, filename, self.output_dir)
+        output_file = '{}{}'.format(output_file, self.output_ext)
+        # change output to "channel last" format and write to nifti format file
+        to_save = np.moveaxis(data, 0, -1)
+        dtype = data.dtype if self.dtype is None else self.dtype
+        write_nifti(to_save, affine, output_file, original_affine, dtype=dtype)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Writes every item along the first dimension of ``batch_data`` by calling ``save`` for each item.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): data whose first dimension indexes items.
+            meta_data (dict): optional meta data mapping. Each value is a per-item sequence indexed in parallel
+                with the batch. If none or empty, items are named by their item index.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta_data = None
+            if meta_data:
+                item_meta_data = {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta_data)
