+import os
+import csv
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta_data)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_saved_content_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(np.ones((3, 2), dtype=np.float32), {})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            self.assertEqual(rows[1], ['1', '1.0', '1.0'])
+
+    def test_overwrite_false_merge(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,9.0,9.0\nC,7.0,7.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(np.array([1.0, 2.0]), {'filename_or_obj': 'A'})
+            saver.save(np.array([3.0, 4.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # in-memory keys keep their order, file-only keys are appended in file order
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            # the file value replaces the in-memory value for the shared key A
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [9.0, 9.0])
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [3.0, 4.0])
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32).tolist(), [7.0, 7.0])
+
+    def test_creates_missing_output_dir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            output_dir = os.path.join(tempdir, 'nested', 'out')
+            saver = CSVSaver(output_dir=output_dir)
+            saver.save(torch.tensor([1.0]), None)
+            saver.finalize()
+            self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+    def test_filename_must_end_with_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
