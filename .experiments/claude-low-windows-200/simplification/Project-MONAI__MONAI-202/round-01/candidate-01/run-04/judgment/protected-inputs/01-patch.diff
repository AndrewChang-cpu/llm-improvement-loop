+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the predictions of items as a CSV file. Values are cached in memory and written
+    to disk only when ``finalize`` is called. Each item is stored under a key: its
+    ``filename_or_obj`` when meta data is present, otherwise the string form of its item index.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory where the CSV file is written.
+            filename (str): name of the CSV file, must end with '.csv'.
+            overwrite (bool): whether to overwrite an existing CSV file. If False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key.
+                Keys only present in the file are appended after the in-memory keys.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._cache = {}
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of one item, stored as float32.
+            meta_data (dict): optional mapping with key ``filename_or_obj`` used as the item key.
+                If None or empty, the key is the string form of the item index and no error is raised.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache[key] = np.asarray(data).astype(np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of a batch.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch whose first dimension indexes items.
+            meta_data (dict): optional mapping with key ``filename_or_obj``, whose values are per-item
+                sequences indexed in parallel with the batch. If None or empty, each item is saved by its index.
+        """
+        for i in range(len(batch_data)):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order.
+        If ``overwrite`` is False and the file exists, its rows are merged in first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
