+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class RecordingWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images it is asked to write."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingWriter(os.path.join(tempdir, 'runs'))
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=4)
+            writer.close()
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'runs')))
+            self.assertTrue(len(os.listdir(os.path.join(tempdir, 'runs'))) > 0)
+
+    def test_tensor_and_numpy_input(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingWriter(os.path.join(tempdir, 'runs'))
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10).numpy(), 0, writer, tag='input_0')
+            writer.close()
+            self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_three_dimensional_single_channel_tag(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingWriter(os.path.join(tempdir, 'runs'))
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, tag='input_0', max_channels=1)
+            writer.close()
+            self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_three_dimensional_non_rgb_zero_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingWriter(os.path.join(tempdir, 'runs'))
+            plot_2d_or_3d_image(torch.zeros(1, 3, 10, 10), 0, writer, tag='output', max_channels=0)
+            writer.close()
+            self.assertEqual(writer.image_tags, [])
+
+    def test_index_selects_item(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingWriter(os.path.join(tempdir, 'runs'))
+            data = torch.zeros(2, 1, 10, 10)
+            data[1] = 1.0
+            plot_2d_or_3d_image(data, 0, writer, index=1, tag='output')
+            writer.close()
+            self.assertEqual(writer.image_tags, ['output_HW_0'])
+
+    def test_unsupported_dimensionality_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingWriter(os.path.join(tempdir, 'runs'))
+            plot_2d_or_3d_image(torch.zeros(1, 10), 0, writer, tag='output')
+            writer.close()
+            self.assertEqual(writer.image_tags, [])
+
+
+if __name__ == '__main__':
+    unittest.main()
