+# limitations under the License.
+
+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return [row for row in csv.reader(f)]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(8), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            rows = _read_rows(filepath)
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_saved_content_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(3, 2))
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            for row in rows:
+                self.assertEqual(len(row), 3)
+
+    def test_empty_meta_data_same_as_absent(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2), {})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['0', '1'])
+
+    def test_keyword_calls(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(batch_data=torch.zeros(2), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.save(data=torch.ones(1), meta_data={'filename_or_obj': 'c'})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['a', 'b', 'c'])
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 1.0)
+
+    def test_overwrite_false_merge(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,5.0\n')
+                f.write('C,2.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save_batch(torch.zeros(2), {'filename_or_obj': ['A', 'B']})
+            saver.finalize()
+
+            rows = _read_rows(filepath)
+            # keys in memory keep their positions (A, B), file-only keys are appended after them (C)
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            # the value of the shared key A comes from the file, not from memory
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 5.0)
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32), 0.0)
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 2.0)
+
+    def test_finalize_creates_output_dir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            output_dir = os.path.join(tempdir, 'nested')
+            saver = CSVSaver(output_dir=output_dir)
+            saver.save(torch.zeros(1), {'filename_or_obj': 'x'})
+            saver.finalize()
+            self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+
+if __name__ == '__main__':
+    unittest.main()
