--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,95 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the predictions of items into a CSV file, one row per key. The key is the item's
+    ``filename_or_obj`` from meta data, or the item index when meta data is absent.
+    The file is written only when :py:meth:`finalize` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory for the CSV file, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite an existing CSV file. If False and the file exists, the rows
+                loaded from the existing file replace in-memory values with the same key when finalize is called.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending with .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = {}
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the predictions of a single item.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): predictions of one item.
+            meta_data (dict): optional mapping with the key ``filename_or_obj``, used as the row name.
+                If None or an empty mapping, the row name is the string form of the item index.
+                A missing ``filename_or_obj`` key raises KeyError.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._index)
+        self._index += 1
+        self._cache[key] = np.asarray(data).astype(np.float32)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches the predictions of every item along the first dimension of a batch.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): predictions with the batch as the first dimension.
+            meta_data (dict): optional mapping with the key ``filename_or_obj``, each value is a sequence
+                indexed in parallel with the batch. If None or an empty mapping, each item is named by its index.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached predictions to the CSV file, one line per key in insertion order, with no header.
+        If overwrite is False and the file exists, its rows are merged first: rows from the file replace
+        in-memory values with the same key, and keys found only in the file are appended after the in-memory keys.
+        """
+        merged = dict(self._cache)
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    merged[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in merged.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
