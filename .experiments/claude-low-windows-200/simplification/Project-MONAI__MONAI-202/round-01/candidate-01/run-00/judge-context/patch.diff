+import glob
+import os
+import shutil
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class RecordingWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images written through add_image."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        default_dir = tempfile.mkdtemp()
+        try:
+            writer = RecordingWriter(log_dir=default_dir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=4,
+                                tag='input_0')
+            writer.flush()
+            writer.close()
+
+            self.assertTrue(os.path.exists(default_dir))
+            self.assertTrue(len(glob.glob(os.path.join(default_dir, '*'))) > 0)
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_3d_single_channel_writes_hw_0(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            writer = RecordingWriter(log_dir=default_dir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, tag='input_0')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_3d_non_rgb_max_channels_zero_writes_nothing(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            writer = RecordingWriter(log_dir=default_dir)
+            plot_2d_or_3d_image(torch.zeros(1, 4, 10, 10), 0, writer, max_channels=0, tag='output')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, [])
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_index_selects_batch_item(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            writer = RecordingWriter(log_dir=default_dir)
+            data = torch.zeros(2, 1, 10, 10)
+            plot_2d_or_3d_image(data, 0, writer, index=1, tag='output')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, ['output_HW_0'])
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_numpy_input_accepted(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            writer = RecordingWriter(log_dir=default_dir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10).numpy(), 0, writer, tag='output')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, ['output_HW_0'])
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
