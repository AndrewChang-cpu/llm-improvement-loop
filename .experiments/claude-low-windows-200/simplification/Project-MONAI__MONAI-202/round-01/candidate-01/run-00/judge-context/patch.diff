+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return [row for row in csv.reader(f)]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            saver = CSVSaver(output_dir=default_dir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta_data)
+            saver.finalize()
+
+            filepath = os.path.join(default_dir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            rows = _read_rows(filepath)
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_no_meta_data_uses_item_index(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            saver = CSVSaver(output_dir=default_dir)
+            saver.save_batch(torch.zeros(3))
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(default_dir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_keyword_arguments(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            saver = CSVSaver(output_dir=default_dir)
+            saver.save(data=torch.zeros(2), meta_data={'filename_or_obj': 'single'})
+            saver.save_batch(batch_data=torch.zeros(2, 2), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(default_dir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['single', 'a', 'b'])
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_overwrite_false_merges_existing_file(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            filepath = os.path.join(default_dir, 'predictions.csv')
+            # existing file holds A (value 1.0) and C (value 2.0)
+            with open(filepath, 'w') as f:
+                f.write('A,1.0\nC,2.0\n')
+
+            saver = CSVSaver(output_dir=default_dir, overwrite=False)
+            # in-memory holds A (value 0.0) and B (value 0.0)
+            saver.save_batch(torch.zeros(2), {'filename_or_obj': ['A', 'B']})
+            saver.finalize()
+
+            rows = _read_rows(filepath)
+            # keys keep in-memory positions, file-only keys are appended in file order,
+            # and file values replace in-memory values with the same key
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 1.0)
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32), 0.0)
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 2.0)
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_output_dir_created(self):
+        base_dir = tempfile.mkdtemp()
+        output_dir = os.path.join(base_dir, 'nested', 'out')
+        try:
+            saver = CSVSaver(output_dir=output_dir)
+            saver.save(torch.zeros(1), {'filename_or_obj': 'x'})
+            saver.finalize()
+            self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+        finally:
+            shutil.rmtree(base_dir, ignore_errors=True)
+
+    def test_filename_must_end_with_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
