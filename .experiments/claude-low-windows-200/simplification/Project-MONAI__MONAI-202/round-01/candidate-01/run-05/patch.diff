+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(data=np.zeros((1, 2, 2)), meta_data={'filename_or_obj': 'single'})
+            saver.save_batch(batch_data=np.zeros((2, 1, 2, 2)), meta_data={'filename_or_obj': ['a', 'b']})
