--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,92 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the predictions of items as a CSV file. Each item is stored under a key, and the file is written
+    only when `finalize` is called. There is no header row; each line is the key followed by the flattened values.
+
+    Args:
+        output_dir (str): output CSV file directory, defaults to the current directory.
+        filename (str): name of the output CSV file, must be a string ending with '.csv'.
+        overwrite (bool): whether to overwrite the existing CSV file content. If False and the file exists,
+            rows loaded from the existing file replace in-memory values with the same key. Keys found only in
+            the file are appended after the in-memory keys, in file order.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = {}
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is taken from the `filename_or_obj` entry of `meta_data`. If `meta_data` is
+        absent (None or an empty mapping), the key is the string form of the item index.
+
+        Args:
+            data (Tensor or ndarray): the item's data, channel-first.
+            meta_data (dict): optional mapping with the key `filename_or_obj`, one entry per item.
+        """
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._data_index += 1
+
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        self._cache_dict[key] = np.asarray(data, dtype=np.float32)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item of a batch by calling `save` on each item along the first dimension.
+
+        Args:
+            batch_data (Tensor or ndarray): the batch, whose first dimension indexes items.
+            meta_data (dict): optional mapping with the key `filename_or_obj`. Each value is a per-item
+                sequence indexed in parallel with the batch. If absent (None or an empty mapping), the items
+                are named by item index.
+        """
+        for i in range(len(batch_data)):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached predictions to the CSV file, one line per key in insertion order. If `overwrite` is
+        False and the file exists, its rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
