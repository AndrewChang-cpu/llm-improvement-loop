+
+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return [row for row in csv.reader(f)]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            filenames = ['testfile' + str(i) for i in range(8)]
+            saver.save_batch(torch.zeros(8), {'filename_or_obj': filenames})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            rows = _read_rows(filepath)
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_keyword_calls(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir, filename='keyword.csv')
+            saver.save(data=np.ones((2,)), meta_data={'filename_or_obj': 'single'})
+            saver.save_batch(batch_data=np.zeros((2, 2)), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'keyword.csv'))
+            self.assertEqual([row[0] for row in rows], ['single', 'a', 'b'])
+
+    def test_absent_meta_data_uses_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(np.zeros((3, 1)))
+            saver.save(np.zeros((1,)), {})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2', '3'])
+
+    def test_overwrite_false_merges_file(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,5.0\nC,7.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(np.array([1.0]), {'filename_or_obj': 'A'})
+            saver.save(np.array([2.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            rows = _read_rows(filepath)
+            # keys in memory keep their order, file-only keys are appended in file order
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            # the value of A comes from the file, replacing the in-memory value
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 5.0)
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32), 2.0)
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 7.0)
+
+    def test_creates_output_dir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            output_dir = os.path.join(tempdir, 'nested', 'out')
+            saver = CSVSaver(output_dir=output_dir)
+            saver.save(np.zeros((1,)), {'filename_or_obj': 'x'})
+            saver.finalize()
+            self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+
+if __name__ == '__main__':
+    unittest.main()
