+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            # set up engine
+            def _train_func(engine, batch):
+                return torch.zeros((8, 1, 2, 2))
+
+            engine = Engine(_train_func)
+
+            # set up testing handler
+            saver = SegmentationSaver(output_dir=default_dir)
+            saver.attach(engine)
+
+            data = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            for i in range(8):
+                name = 'testfile' + str(i)
+                filepath = os.path.join(default_dir, name, name + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+    def test_integer_output_dtype_kept(self):
+        default_dir = tempfile.mkdtemp()
+        try:
+            def _train_func(engine, batch):
+                return torch.zeros((8, 1, 2, 2), dtype=torch.int32)
+
+            engine = Engine(_train_func)
+
+            saver = SegmentationSaver(output_dir=default_dir)
+            saver.attach(engine)
+
+            data = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            img = nib.load(os.path.join(default_dir, 'testfile0', 'testfile0_seg.nii.gz'))
+            self.assertEqual(img.header.get_data_dtype(), np.dtype(np.int32))
+        finally:
+            shutil.rmtree(default_dir, ignore_errors=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
