+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class RecordingSummaryWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images it writes."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer)
+            writer.close()
+
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_plot_accepts_ndarray(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(np.zeros((1, 1, 10, 10)), 0, writer)
+            writer.close()
+
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_3d_single_channel_tag(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingSummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, index=0, max_channels=1, tag='input_0')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_3d_non_rgb_zero_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingSummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 4, 10, 10)), 0, writer, max_channels=0, tag='output')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, [])
+
+
+if __name__ == '__main__':
+    unittest.main()
