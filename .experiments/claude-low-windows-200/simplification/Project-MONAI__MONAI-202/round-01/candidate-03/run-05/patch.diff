+import os
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8, 1, 2, 2), meta_data)
+
+            for i in range(8):
+                name = 'testfile' + str(i)
+                filepath = os.path.join(tempdir, name, name + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    @parameterized.expand([[None], [{}]])
+    def test_absent_meta_data(self, meta_data):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(8, 1, 2, 2), meta_data)
+
+            for i in range(8):
+                filepath = os.path.join(tempdir, str(i), str(i) + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_path_layout(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(np.zeros((1, 2, 2)), {'filename_or_obj': 'sub/case0.nii.gz'})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz')))
+            self.assertFalse(os.path.exists(os.path.join(tempdir, 'sub')))
+
+    def test_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            data = np.zeros((1, 2, 2), dtype=np.int32)
+
+            # no dtype set: the data's own dtype is written
+            NiftiSaver(output_dir=tempdir).save(data, {'filename_or_obj': 'a'})
+            saved = nib.load(os.path.join(tempdir, 'a', 'a_seg.nii.gz'))
+            self.assertEqual(saved.get_data_dtype(), np.int32)
+
+            # dtype set: that dtype is written
+            NiftiSaver(output_dir=tempdir, output_postfix='float', dtype=np.float32).save(
+                data, {'filename_or_obj': 'a'})
+            saved = nib.load(os.path.join(tempdir, 'a', 'a_float.nii.gz'))
+            self.assertEqual(saved.get_data_dtype(), np.float32)
+
+    def test_keyword_calls(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(data=np.zeros((1, 2, 2)), meta_data={'filename_or_obj': 'kw'})
+            saver.save_batch(batch_data=torch.zeros(1, 1, 2, 2), meta_data={'filename_or_obj': ['kwb']})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'kw', 'kw_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'kwb', 'kwb_seg.nii.gz')))
+
+
+if __name__ == '__main__':
+    unittest.main()
