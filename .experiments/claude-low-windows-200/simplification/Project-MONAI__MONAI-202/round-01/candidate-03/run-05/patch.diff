index 0000000..b87e415
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,100 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saver to collect per-item values in memory and write them to a CSV file.
+    Each row holds a key followed by the flattened values of one item. The key is the
+    ``filename_or_obj`` value from the meta data, or the item index when meta data is absent.
+    Nothing is written to disk until ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, default is the current directory.
+            filename (str): name of the saved CSV file inside the output directory. It must be a string
+                ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file content. When it is False and the file
+                exists, rows loaded from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._cache_dict = OrderedDict()
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Store one item in the cache.
+
+        Args:
+            data (Tensor or numpy.ndarray): the item to save.
+            meta_data (dict): optional meta data mapping for this item. The key ``filename_or_obj`` names the
+                item. If meta data is None or an empty mapping, the item is named by its item index instead.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache_dict[key] = np.asarray(data, dtype=np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Store every item along the first dimension of a batch.
+
+        Args:
+            batch_data (Tensor or numpy.ndarray): batch whose first dimension indexes items.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in
+                parallel with the batch. See ``save`` for the naming rules.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(data, item_meta)
+
+    def finalize(self):
+        """
+        Write the cached values to the CSV file. If ``overwrite`` is False and the file exists, the rows
+        in the file are merged first: keys already in memory keep their position, file values replace
+        in-memory values with the same key, and keys found only in the file are appended in file order.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            file_dict = OrderedDict()
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    if row:
+                        file_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+            merged = OrderedDict((k, file_dict.get(k, v)) for k, v in self._cache_dict.items())
+            for k, v in file_dict.items():
+                if k not in merged:
+                    merged[k] = v
+            self._cache_dict = merged
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
