+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from tensorboard.backend.event_processing.event_accumulator import EventAccumulator
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+def _read_image_tags(logdir):
+    accumulator = EventAccumulator(logdir)
+    accumulator.Reload()
+    return accumulator.Tags()['images']
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, max_channels=1, max_frames=4, tag='input_0')
+            writer.close()
+
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_single_channel_3d_tag(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, max_channels=1, tag='input_0')
+            writer.close()
+
+            tags = _read_image_tags(tempdir)
+            self.assertIn('input_0_HW_0', tags)
+            self.assertNotIn('input_0_HW', tags)
+
+    def test_no_image_for_zero_max_channels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, max_channels=0, tag='input_0')
+            writer.close()
+
+            self.assertEqual(_read_image_tags(tempdir), [])
+
+    def test_index_selects_item(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(2, 1, 10, 10), 0, writer, index=1, max_channels=1, tag='output')
+            writer.close()
+
+            self.assertIn('output_HW_0', _read_image_tags(tempdir))
+
+
+if __name__ == '__main__':
+    unittest.main()
