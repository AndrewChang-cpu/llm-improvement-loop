--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,103 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Store the values of items in an insertion-ordered cache and write them to a CSV file.
+    Each item is keyed by the ``filename_or_obj`` value of its meta data. When meta data is absent
+    (``None`` or an empty mapping), the key is the string form of the item index, which counts every item saved.
+    Nothing is written to disk until ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, default is the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file content. When False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key during ``finalize``.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._cache_dict = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Save the values of a single item into the cache.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of one item to save.
+            meta_data (dict): optional meta data mapping. The key ``filename_or_obj`` is used as the item key.
+                If None or an empty mapping, the item key is the string form of the item index.
+        """
+        if meta_data is None or len(meta_data) == 0:
+            key = str(self._index)
+        else:
+            key = meta_data['filename_or_obj']
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Save a batch of items, one item per entry along the first dimension of ``batch_data``.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): the batch of values to save, first dimension is the batch.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in parallel
+                with the batch. The key ``filename_or_obj`` is used as the item key. If None or an empty mapping,
+                each item falls back to the item index.
+        """
+        has_meta = meta_data is not None and len(meta_data) > 0
+        for i, data in enumerate(batch_data):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if has_meta else None
+            self.save(data, item_meta)
+
+    def finalize(self):
+        """
+        Write the cached values to the CSV file, one line per key in insertion order, with no header row.
+        When ``overwrite`` is False and the file exists, its rows are merged into the cache first: rows with the
+        same key replace in-memory values, keys already in memory keep their position, and keys found only in the
+        file are appended after the in-memory keys in file order.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            file_dict = OrderedDict()
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    file_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+            merged = OrderedDict()
+            for k, v in self._cache_dict.items():
+                merged[k] = file_dict[k] if k in file_dict else v
+            for k, v in file_dict.items():
+                if k not in merged:
+                    merged[k] = v
+            self._cache_dict = merged
+
+        os.makedirs(self.output_dir, exist_ok=True)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
