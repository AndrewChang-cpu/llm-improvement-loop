+import os
+import csv
+import shutil
+import tempfile
+import unittest
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(8), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                reader = csv.reader(f)
+                i = 0
+                for row in reader:
+                    self.assertEqual(row[0], 'testfile' + str(i))
+                    self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+                    i += 1
+                self.assertEqual(i, 8)
+
+    def test_save_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir, filename='out.csv')
+            saver.save_batch(torch.ones(3, 2))
+            saver.save({'filename_or_obj': 'named'}, {'filename_or_obj': 'named'})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'out.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2', 'named'])
+            self.assertEqual(rows[0][1:], ['1.0', '1.0'])
+
+    def test_empty_meta_data_falls_back_to_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 1), {})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1'])
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(batch_data=torch.zeros(2, 1), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.save(data=torch.zeros(1), meta_data={'filename_or_obj': 'c'})
+            saver.finalize()
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'predictions.csv')))
+
+    def test_overwrite_false_merges_file(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            # existing file holds A (value 5) and C (value 7)
+            with open(filepath, 'w') as f:
+                f.write('A,5.0\nC,7.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            # in memory: A (value 1) and B (value 2)
+            saver.save(torch.tensor([1.0]), {'filename_or_obj': 'A'})
+            saver.save(torch.tensor([2.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # keys in memory keep their position, file-only keys are appended in file order
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            # file values replace in-memory values for shared keys
+            self.assertEqual(float(rows[0][1]), 5.0)
+            self.assertEqual(float(rows[1][1]), 2.0)
+            self.assertEqual(float(rows[2][1]), 7.0)
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
