+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.temp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.temp_dir, ignore_errors=True)
+
+    def test_saved_content(self):
+        saver = CSVSaver(output_dir=self.temp_dir)
+        batch = torch.zeros(8)
+        meta = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+        saver.save_batch(batch, meta)
+        saver.finalize()
+
+        filepath = os.path.join(self.temp_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_keyword_batch_data(self):
+        saver = CSVSaver(output_dir=self.temp_dir)
+        saver.save_batch(batch_data=torch.zeros(2, 3), meta_data={'filename_or_obj': ['a', 'b']})
+        saver.finalize()
+        with open(os.path.join(self.temp_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([row[0] for row in rows], ['a', 'b'])
+        self.assertEqual(len(rows[0]), 4)
+
+    def test_keyword_data(self):
+        saver = CSVSaver(output_dir=self.temp_dir)
+        saver.save(data=torch.ones(2), meta_data={'filename_or_obj': 'single'})
+        saver.finalize()
+        with open(os.path.join(self.temp_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(rows[0][0], 'single')
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 1.0)
+
+    def test_index_key_without_meta_data(self):
+        saver = CSVSaver(output_dir=self.temp_dir)
+        saver.save_batch(torch.zeros(3, 1))
+        saver.save(torch.ones(1), {})
+        saver.finalize()
+        with open(os.path.join(self.temp_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([row[0] for row in rows], ['0', '1', '2', '3'])
+
+    def test_overwrite_false_merge(self):
+        filepath = os.path.join(self.temp_dir, 'predictions.csv')
+        with open(filepath, 'w') as f:
+            f.write('A,5.0\n')
+            f.write('C,7.0\n')
+
+        saver = CSVSaver(output_dir=self.temp_dir, overwrite=False)
+        saver.save(torch.tensor([1.0]), {'filename_or_obj': 'A'})
+        saver.save(torch.tensor([2.0]), {'filename_or_obj': 'B'})
+        saver.finalize()
+
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 5.0)
+        self.assertEqual(np.array(rows[1][1:]).astype(np.float32), 2.0)
+        self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 7.0)
+
+    def test_creates_missing_output_dir(self):
+        output_dir = os.path.join(self.temp_dir, 'nested')
+        saver = CSVSaver(output_dir=output_dir)
+        saver.save(torch.zeros(1), {'filename_or_obj': 'x'})
+        saver.finalize()
+        self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+    def test_invalid_filename(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir=self.temp_dir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
