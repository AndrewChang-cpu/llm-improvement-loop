+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.temp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.temp_dir, ignore_errors=True)
+
+    def _run(self, output, saver_kwargs):
+        def _process_func(engine, batch):
+            return output
+
+        engine = Engine(_process_func)
+        saver = SegmentationSaver(output_dir=os.path.join(self.temp_dir, 'output'), **saver_kwargs)
+        saver.attach(engine)
+        data = [{
+            'filename_or_obj': ['testfile' + str(i) for i in range(8)],
+            'affine': [np.eye(4)] * 8,
+            'original_affine': [np.eye(4)] * 8,
+        }]
+        engine.run(data, epoch_length=1, max_epochs=1)
+        return os.path.join(self.temp_dir, 'output')
+
+    def test_saved_content(self):
+        output_dir = self._run(torch.zeros((8, 1, 2, 2)), {})
+        for i in range(8):
+            name = 'testfile' + str(i)
+            self.assertTrue(os.path.exists(os.path.join(output_dir, name, name + '_seg.nii.gz')))
+
+    def test_default_dtype_keeps_integer_output(self):
+        output_dir = self._run(torch.zeros((8, 1, 2, 2), dtype=torch.int32), {})
+        img = nib.load(os.path.join(output_dir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+
+    def test_output_dir_keyword(self):
+        output_dir = self._run(torch.zeros((8, 1, 2, 2)), {'output_postfix': 'out'})
+        self.assertTrue(os.path.exists(os.path.join(output_dir, 'testfile3', 'testfile3_out.nii.gz')))
+
+
+if __name__ == '__main__':
+    unittest.main()
