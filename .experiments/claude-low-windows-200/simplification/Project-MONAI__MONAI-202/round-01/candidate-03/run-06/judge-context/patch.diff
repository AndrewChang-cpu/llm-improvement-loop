--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,98 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the model outputs of items as one CSV file. Items are cached in memory by key and the file
+    is written when ``finalize`` is called. There is no header row, each line holds the key followed by
+    the flattened values of the item.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite existing CSV file content. If False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key. Keys found only
+                in the file are appended after the in-memory keys.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is the ``'filename_or_obj'`` value of ``meta_data`` when it is present.
+        If ``meta_data`` is absent (None or an empty mapping), the key is the string form of the item index.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the model output of one item, channel first.
+            meta_data (dict): optional mapping of per-item meta data, uses the key ``'filename_or_obj'``.
+        """
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._index)
+        self._index += 1
+
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``batch_data``, see ``save``. In the meta data mapping,
+        each value is a per-item sequence that is indexed in parallel with the batch.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): model outputs, the first dimension indexes the items.
+            meta_data (dict): optional mapping of per-item sequences of meta data, uses the key
+                ``'filename_or_obj'``.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None
+            if meta_data:
+                item_meta = {k: (None if v is None else v[i]) for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached items to the CSV file, one line per key in insertion order. When ``overwrite`` is False
+        and the file exists, rows from the file are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(str(k))
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
