+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.temp_dir = tempfile.mkdtemp()
+        self.log_dir = os.path.join(self.temp_dir, 'runs')
+
+    def tearDown(self):
+        shutil.rmtree(self.temp_dir, ignore_errors=True)
+
+    def _image_tags(self, writer):
+        writer.flush()
+        writer.close()
+        accumulator = EventAccumulator(self.log_dir)
+        accumulator.Reload()
+        return accumulator.Tags()['images']
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        writer = SummaryWriter(log_dir=self.log_dir)
+        plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=3, max_frames=4, tag='input_0')
+        writer.flush()
+        writer.close()
+        self.assertTrue(os.path.exists(self.log_dir))
+        self.assertTrue(len(os.listdir(self.log_dir)) > 0)
+
+    def test_three_dimensional_single_channel_suffix(self):
+        writer = SummaryWriter(log_dir=self.log_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, tag='input_0')
+        tags = self._image_tags(writer)
+        self.assertIn('input_0_HW_0', tags)
+        self.assertNotIn('input_0_HW', tags)
+
+    def test_three_dimensional_non_rgb_writes_one_image(self):
+        writer = SummaryWriter(log_dir=self.log_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 4, 10, 10)), 0, writer, max_channels=3, tag='output')
+        tags = self._image_tags(writer)
+        self.assertEqual(tags, ['output_HW_0'])
+
+    def test_three_dimensional_non_rgb_zero_channels_writes_nothing(self):
+        writer = SummaryWriter(log_dir=self.log_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 4, 10, 10)), 0, writer, max_channels=0, tag='output')
+        self.assertEqual(self._image_tags(writer), [])
+
+    def test_index_selects_item(self):
+        writer = SummaryWriter(log_dir=self.log_dir)
+        data = torch.zeros((2, 1, 10, 10))
+        plot_2d_or_3d_image(data, 0, writer, index=1, tag='input_0')
+        tags = self._image_tags(writer)
+        self.assertIn('input_0_HW', tags)
+
+    def test_numpy_input_accepted(self):
+        writer = SummaryWriter(log_dir=self.log_dir)
+        plot_2d_or_3d_image(np.zeros((1, 1, 10, 10), dtype=np.float32), 0, writer, tag='output')
+        self.assertIn('output_HW', self._image_tags(writer))
+
+    def test_non_summary_writer_rejected(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, object(), tag='output')
