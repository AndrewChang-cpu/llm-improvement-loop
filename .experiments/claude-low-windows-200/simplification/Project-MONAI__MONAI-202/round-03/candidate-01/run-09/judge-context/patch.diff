@@ -0,0 +1,93 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saver to collect values of items and write them to a CSV file, one row per item.
+    Items are stored in memory, and the file is written when ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file content. When overwrite is false,
+                rows loaded from an existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._prediction_dict = {}
+        self._data_index = 0
+
+    def finalize(self):
+        """
+        Write the collected values to the CSV file, one line per key in insertion order.
+        When overwrite is false and the file exists, rows read from the file are merged in first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            file_values = {}
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    file_values[row[0]] = np.array(row[1:]).astype(np.float32)
+            for key, value in file_values.items():
+                self._prediction_dict[key] = value
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for key, value in self._prediction_dict.items():
+                f.write(key)
+                for result in value.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+
+    def save(self, data, meta_data=None):
+        """
+        Store the values of one item. The key is the ``filename_or_obj`` value of ``meta_data`` when meta data
+        is present, otherwise the string form of the item index. The item index increments on every call.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): values of one item, channel-first.
+            meta_data (dict): meta data mapping with key ``filename_or_obj``. A missing key raises KeyError.
+                None or an empty mapping means the item index is used as the key.
+        """
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._prediction_dict[key] = np.asarray(data, dtype=np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Store every item along the first dimension of ``batch_data``, see ``save``.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of items, the first dimension indexes items.
+            meta_data (dict): meta data mapping whose values are per-item sequences indexed in parallel
+                with the batch. None or an empty mapping means the item index is used as the key.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None
+            if meta_data:
+                item_meta = {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
