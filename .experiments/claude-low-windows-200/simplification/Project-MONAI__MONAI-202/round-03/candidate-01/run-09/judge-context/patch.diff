+import os
+import csv
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.csv_saver import CSVSaver
+
+TEST_CASES = [
+    [(8,), 1],
+    [(8, 2), 2],
+]
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return list(csv.reader(f))
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_save_batch(self, shape, num_values):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(shape), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            rows = _read_rows(filepath)
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(len(row) - 1, num_values)
+                self.assertTrue(np.all(np.array(row[1:]).astype(np.float32) == 0.0))
+
+    def test_index_keys_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 1), {})
+            saver.save(torch.zeros(1))
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir, filename='out.csv')
+            saver.save_batch(batch_data=torch.zeros(2, 1), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.save(data=torch.zeros(1), meta_data={'filename_or_obj': 'c'})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'out.csv'))
+            self.assertEqual([row[0] for row in rows], ['a', 'b', 'c'])
+
+    def test_overwrite_false_merges_file_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,5.0\nC,7.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(torch.tensor([1.0]), {'filename_or_obj': 'A'})
+            saver.save(torch.tensor([2.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            rows = _read_rows(filepath)
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            self.assertEqual(float(rows[0][1]), 5.0)
+            self.assertEqual(float(rows[1][1]), 2.0)
+            self.assertEqual(float(rows[2][1]), 7.0)
+
+    def test_invalid_filename(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
