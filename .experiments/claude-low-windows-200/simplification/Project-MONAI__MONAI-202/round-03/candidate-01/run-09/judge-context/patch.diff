+import os
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASES = [
+    [(8, 1, 2, 2)],
+    [(8, 1, 2, 2, 2)],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_save_batch(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(shape), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+            for i in range(8):
+                name = 'testfile' + str(i)
+                self.assertTrue(os.path.exists(os.path.join(tempdir, name, name + '_seg.nii.gz')))
+
+    def test_input_subdirectory_is_dropped(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(torch.zeros(1, 2, 2), {'filename_or_obj': 'sub/case0.nii.gz'})
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz')))
+
+    def test_index_names_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 1, 2, 2))
+            saver.save(torch.zeros(1, 2, 2), {})
+            for name in ['0', '1', '2']:
+                self.assertTrue(os.path.exists(os.path.join(tempdir, name, name + '_seg.nii.gz')))
+
+    def test_affine_is_used(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            affine = np.diag([2.0, 3.0, 4.0, 1.0])
+            saver.save(np.zeros((1, 2, 2), dtype=np.float32),
+                       {'filename_or_obj': 'case1.nii.gz', 'affine': affine, 'original_affine': affine})
+            img = nib.load(os.path.join(tempdir, 'case1', 'case1_seg.nii.gz'))
+            self.assertTrue(np.allclose(img.affine, affine))
+
+    def test_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            data = torch.zeros(1, 2, 2, dtype=torch.int32)
+            NiftiSaver(output_dir=tempdir).save(data, {'filename_or_obj': 'int_case.nii.gz'})
+            NiftiSaver(output_dir=tempdir, dtype=np.float32).save(data, {'filename_or_obj': 'float_case.nii.gz'})
+
+            img = nib.load(os.path.join(tempdir, 'int_case', 'int_case_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.int32)
+            img = nib.load(os.path.join(tempdir, 'float_case', 'float_case_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.float32)
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(batch_data=torch.zeros(2, 1, 2, 2), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.save(data=torch.zeros(1, 2, 2), meta_data={'filename_or_obj': 'c'})
+            for name in ['a', 'b', 'c']:
+                self.assertTrue(os.path.exists(os.path.join(tempdir, name, name + '_seg.nii.gz')))
+
+
+if __name__ == '__main__':
+    unittest.main()
