+
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.transforms.utils import rescale_array
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class _RecordingWriter(SummaryWriter):
+    """SummaryWriter that records the images passed to add_image, for checking tags and contents."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.images = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.images.append((tag, np.asarray(img_tensor)))
+
+
+class TestPlot2dOr3dImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, max_channels=1, max_frames=2)
+            writer.flush()
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_three_dimensional_single_channel_suffix(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(tempdir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, tag='input_0')
+            plot_2d_or_3d_image(torch.zeros(1, 4, 10, 10), 0, writer, tag='input_0')
+            writer.close()
+            self.assertEqual([tag for tag, _ in writer.images], ['input_0_HW_0', 'input_0_HW_0'])
+
+    def test_rgb_suffix(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(tempdir)
+            plot_2d_or_3d_image(torch.zeros(1, 3, 10, 10), 0, writer, max_channels=3, tag='input_0')
+            writer.close()
+            self.assertEqual([tag for tag, _ in writer.images], ['input_0_CHW'])
+
+    def test_zero_max_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(tempdir)
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, max_channels=0, tag='input_0')
+            writer.close()
+            self.assertEqual(writer.images, [])
+
+    def test_index_selects_item(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(tempdir)
+            data = np.arange(2 * 10 * 10, dtype=np.float32).reshape(2, 1, 10, 10)
+            plot_2d_or_3d_image(data, 0, writer, index=1, tag='output')
+            writer.close()
+            tag, image = writer.images[0]
+            self.assertEqual(tag, 'output_HW_0')
+            self.assertTrue(np.allclose(image, rescale_array(data[1][0], 0, 1)))
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
