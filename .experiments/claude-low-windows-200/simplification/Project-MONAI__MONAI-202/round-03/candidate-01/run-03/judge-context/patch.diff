                                                                     max_out=max_out, animation_axes=[1],
                                                                     image_axes=[2, 3], scale_factor=scale_factor),
                                           global_step)
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot the data of one item in a batch as a 2D image or 3D images on TensorBoard.
+
+    2D data (H, W) is written as one image. 3D data (C, H, W) is written as one RGB image when C is 3 and
+    ``max_channels`` is 3; otherwise channel 0 is written as one image when ``max_channels`` is at least 1.
+    Data with four or more dimensions is flattened into 3D volumes, and each of the first ``max_channels``
+    volumes is written as an animated GIF along its last axis.
+
+    Args:
+        data (torch.Tensor or numpy.ndarray): data in NCHW[D] layout, one item at ``index`` is plotted.
+        step (int): global step value to record.
+        writer (SummaryWriter): TensorBoard SummaryWriter to write to.
+        index (int): index of the item in the batch to plot.
+        max_channels (int): maximum number of channels or volumes to plot.
+        max_frames (int): number of frames of the animated GIF.
+        tag (str): data identifier used as the prefix of the tags.
+    """
+    assert isinstance(writer, SummaryWriter), 'plot_2d_or_3d_image requires SummaryWriter as input.'
+    d = data[index]
+    if torch.is_tensor(d):
+        d = d.detach().cpu().numpy()
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+        return
+
+    if d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            dataformats = 'CHW'
+            writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+            return
+        if max_channels >= 1:
+            d2 = rescale_array(d[0], 0, 1)
+            dataformats = 'HW'
+            writer.add_image('{}_{}_0'.format(tag, dataformats), d2, step, dataformats=dataformats)
+        return
+
+    if d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
+        return
