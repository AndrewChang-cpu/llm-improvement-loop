+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class RecordingSummaryWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images it writes."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+        self.log_dir = os.path.join(self.test_dir, 'runs')
+        self.writer = RecordingSummaryWriter(log_dir=self.log_dir)
+
+    def tearDown(self):
+        self.writer.close()
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        plot_2d_or_3d_image(torch.zeros(shape), 0, self.writer, index=0, max_channels=1, max_frames=5, tag='input_0')
+        self.writer.flush()
+
+        self.assertTrue(os.path.exists(self.log_dir))
+        self.assertTrue(len(glob.glob(os.path.join(self.log_dir, '*'))) > 0)
+
+    def test_three_dimensional_single_channel_writes_channel_zero(self):
+        plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, self.writer, index=0, max_channels=1, tag='input_0')
+        self.assertEqual(self.writer.image_tags, ['input_0_HW_0'])
+
+    def test_three_dimensional_rgb_writes_one_image(self):
+        plot_2d_or_3d_image(torch.zeros(1, 3, 10, 10), 0, self.writer, index=0, max_channels=3, tag='input_0')
+        self.assertEqual(self.writer.image_tags, ['input_0_CHW'])
+
+    def test_zero_max_channels_writes_nothing(self):
+        plot_2d_or_3d_image(torch.zeros(1, 2, 10, 10), 0, self.writer, max_channels=0, tag='input_0')
+        self.assertEqual(self.writer.image_tags, [])
+
+    def test_index_selects_batch_item(self):
+        data = torch.zeros(2, 1, 10, 10)
+        data[1] = 1.0
+        plot_2d_or_3d_image(data, 0, self.writer, index=1, tag='output')
+        self.assertEqual(self.writer.image_tags, ['output_HW_0'])
+
+    def test_keyword_arguments(self):
+        plot_2d_or_3d_image(data=torch.zeros(1, 10, 10), step=0, writer=self.writer, tag='output')
+        self.assertEqual(self.writer.image_tags, ['output_HW'])
+
+    def test_invalid_writer_raises(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros(1, 10, 10), 0, writer=object())
