index 0000000..60a3fc6
--- /dev/null
+++ b/monai/data/nifti_saver.py
@@ -0,0 +1,122 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+
+import numpy as np
+import torch
+
+from monai.data.nifti_writer import write_nifti
+
+
+class NiftiSaver:
+    """
+    Saves items as NIfTI files. Each item is written immediately by ``save``, or item by item by ``save_batch``.
+    """
+
+    def __init__(self, output_dir='./', output_postfix='seg', output_ext='.nii.gz', dtype=None):
+        """
+        Args:
+            output_dir (str): output directory. Defaults to the current directory.
+            output_postfix (str): a string appended to the base name of every output file.
+            output_ext (str): output file extension name.
+            dtype (numpy.dtype): data type to write. If None, the data's own dtype is kept.
+        """
+        self.output_dir = output_dir
+        self.output_postfix = output_postfix
+        self.output_ext = output_ext
+        self.dtype = dtype
+        self._item_index = 0
+
+    @staticmethod
+    def _create_file_basename(postfix, input_file_name, output_folder, data_root_dir=''):
+        """
+        Utility function to create the path to the output file based on the input
+        filename (extension is added by lib level writer before writing the file).
+
+        Args:
+            postfix (str): output name's postfix.
+            input_file_name (str): path to the input image file; only its base name is used.
+            output_folder (str): output directory, the base name is created as a sub-folder inside it.
+            data_root_dir (str): if not empty, it specifies the beginning parts of the input file's
+                absolute path. This is used to compute the relative path to the file from `data_root_dir`
+                to preserve folder structure when saving in case there are files in different folders
+                with the same file names.
+        """
+        # get the filename and directory
+        filedir, filename = os.path.split(input_file_name)
+
+        # jettison the extension to have just filename
+        filename, ext = os.path.splitext(filename)
+        while ext != '':
+            filename, ext = os.path.splitext(filename)
+
+        # use data_root_dir to find relative path to file
+        filedir_rel_path = ''
+        if data_root_dir:
+            filedir_rel_path = os.path.relpath(filedir, data_root_dir)
+
+        # sub-folder path will be original name without the extension
+        subfolder_path = os.path.join(output_folder, filedir_rel_path, filename)
+        os.makedirs(subfolder_path, exist_ok=True)
+
+        # add the sub-folder plus the postfix name to become the file basename in the output path
+        return os.path.join(subfolder_path, filename + '_' + postfix)
+
+    def save(self, data, meta_data=None):
+        """
+        Writes one item to a NIfTI file.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): one item, channel-first.
+            meta_data (dict): optional meta data mapping. Key ``'filename_or_obj'`` gives the base name of the
+                output file. Keys ``'affine'`` and ``'original_affine'`` are optional and used when present.
+                If meta data is None or empty, the file is named by the string form of the item index and no
+                affine is used.
+        """
+        affine = None
+        original_affine = None
+        if meta_data:
+            filename = meta_data['filename_or_obj']
+            affine = meta_data.get('affine', None)
+            original_affine = meta_data.get('original_affine', None)
+        else:
+            filename = str(self._item_index)
+
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        data = np.asarray(data)
+        if torch.is_tensor(affine):
+            affine = affine.detach().cpu().numpy()
+        if torch.is_tensor(original_affine):
+            original_affine = original_affine.detach().cpu().numpy()
+
+        output_file = self._create_file_basename(self.output_postfix, filename, self.output_dir)
+        output_file = '{}{}'.format(output_file, self.output_ext)
+        dtype = data.dtype if self.dtype is None else self.dtype
+
+        # change output to "channel last" format and write to nifti format file
+        to_save = np.moveaxis(data, 0, -1)
+        write_nifti(to_save, affine, output_file, original_affine, dtype=dtype)
+        self._item_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Writes every item along the first dimension of a batch to its own NIfTI file.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of items, the first dimension indexes items.
+            meta_data (dict): optional meta data mapping where each value is a per-item sequence, indexed in
+                parallel with the batch. See ``save`` for the meaning of the keys.
+        """
+        for i, item in enumerate(batch_data):
+            item_meta = None if not meta_data else {k: v[i] for k, v in meta_data.items()}
+            self.save(item, item_meta)
