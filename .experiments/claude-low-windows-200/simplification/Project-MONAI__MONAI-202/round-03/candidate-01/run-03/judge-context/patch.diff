index 0000000..40ee256
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,95 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches values of items and writes them to one CSV file. Items are saved with ``save`` or ``save_batch``
+    and the file is written when ``finalize`` is called. The file has no header row; each line holds a key
+    followed by the flattened values of the item.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory where the CSV file is written. Defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite an existing CSV file. When it is False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key. Keys found only
+                in the existing file are appended after the in-memory keys.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._item_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): values of one item, channel-first.
+            meta_data (dict): optional meta data mapping with key ``'filename_or_obj'``, which is used as the key
+                of the item. If meta data is None or empty, the key is the string form of the item index.
+        """
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._item_index)
+
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._item_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches the values of every item along the first dimension of a batch.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of items, the first dimension indexes items.
+            meta_data (dict): optional meta data mapping where each value is a per-item sequence, indexed in
+                parallel with the batch. See ``save`` for the meaning of the keys.
+        """
+        for i, item in enumerate(batch_data):
+            item_meta = None if not meta_data else {k: v[i] for k, v in meta_data.items()}
+            self.save(item, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file. When ``overwrite`` is False and the file exists, the rows of
+        the existing file are loaded first and their values replace in-memory values with the same key.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if self.output_dir:
+            os.makedirs(self.output_dir, exist_ok=True)
+        with open(self._filepath, 'w') as f:
+            for key, values in self._cache_dict.items():
+                f.write(key)
+                for result in values.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
