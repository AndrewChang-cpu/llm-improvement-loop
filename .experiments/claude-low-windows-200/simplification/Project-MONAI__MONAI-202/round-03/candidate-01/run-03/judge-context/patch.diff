+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.csv_saver import CSVSaver
+
+TEST_CASE_1 = [{'output_dir': './', 'filename': 'predictions.csv'}]
+TEST_CASE_2 = [{'output_dir': './tempdir/sub', 'filename': 'out.csv'}]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand([TEST_CASE_1])
+    def test_saved_content(self, kwargs):
+        output_dir = os.path.join(self.test_dir, kwargs['output_dir'])
+        saver = CSVSaver(output_dir=output_dir, filename=kwargs['filename'])
+        saver.save_batch(torch.zeros(8), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+        saver.finalize()
+
+        filepath = os.path.join(output_dir, kwargs['filename'])
+        self.assertTrue(os.path.exists(filepath))
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    @parameterized.expand([TEST_CASE_2])
+    def test_creates_output_dir(self, kwargs):
+        output_dir = os.path.join(self.test_dir, kwargs['output_dir'])
+        saver = CSVSaver(output_dir=output_dir, filename=kwargs['filename'])
+        saver.save(np.ones((2,)), {'filename_or_obj': 'a'})
+        saver.finalize()
+        self.assertTrue(os.path.exists(os.path.join(output_dir, kwargs['filename'])))
+
+    def test_save_without_meta_data_uses_index_keys(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.ones(3, 2))
+        saver.finalize()
+        with open(os.path.join(self.test_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+        self.assertEqual(rows[0], ['0', '1.0', '1.0'])
+
+    def test_keyword_arguments(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(batch_data=torch.zeros(2), meta_data={'filename_or_obj': ['a', 'b']})
+        saver.save(data=torch.zeros(1), meta_data={'filename_or_obj': 'c'})
+        saver.finalize()
+        with open(os.path.join(self.test_dir, 'predictions.csv'), 'r') as f:
+            keys = [row[0] for row in csv.reader(f)]
+        self.assertEqual(keys, ['a', 'b', 'c'])
+
+    def test_overwrite_false_merges_existing_file(self):
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        with open(filepath, 'w') as f:
+            f.write('A,5.0\nC,7.0\n')
+
+        saver = CSVSaver(output_dir=self.test_dir, overwrite=False)
+        saver.save(torch.tensor([1.0]), {'filename_or_obj': 'A'})
+        saver.save(torch.tensor([2.0]), {'filename_or_obj': 'B'})
+        saver.finalize()
+
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        # A keeps its in-memory position and takes the file's value, B is in memory, C is only in the file
+        self.assertEqual(rows, [['A', '5.0'], ['B', '2.0'], ['C', '7.0']])
+
+    def test_invalid_filename_raises(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir=self.test_dir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
