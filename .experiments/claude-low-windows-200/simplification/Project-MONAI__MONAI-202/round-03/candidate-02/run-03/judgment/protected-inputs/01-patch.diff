+import shutil
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from tensorboard.backend.event_processing.event_accumulator import EventAccumulator
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASE_SHAPES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def _image_tags(self, writer):
+        writer.close()
+        accumulator = EventAccumulator(self.test_dir, size_guidance={'images': 0})
+        accumulator.Reload()
+        return accumulator.Tags()['images']
+
+    @parameterized.expand(TEST_CASE_SHAPES)
+    def test_plot_shapes(self, shape):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(shape), 0, writer, tag='input_0')
+
+        self.assertTrue(len(self._image_tags(writer)) > 0)
+
+    def test_2d_image_tag(self):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer, tag='input_0')
+
+        tags = self._image_tags(writer)
+        self.assertIn('input_0_HW', tags)
+
+    def test_3d_rgb_tag(self):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(1, 3, 10, 10), 0, writer, max_channels=3, tag='input_0')
+
+        tags = self._image_tags(writer)
+        self.assertIn('input_0_CHW', tags)
+
+    def test_3d_single_channel_tag(self):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(1, 4, 10, 10), 0, writer, max_channels=1, tag='input_0')
+
+        tags = self._image_tags(writer)
+        self.assertIn('input_0_HW_0', tags)
+
+    def test_3d_not_rgb_zero_channels_writes_nothing(self):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(1, 4, 10, 10), 0, writer, max_channels=0, tag='input_0')
+
+        tags = self._image_tags(writer)
+        self.assertFalse(any(tag.startswith('input_0') for tag in tags))
+
+    def test_4d_gif_tag(self):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10, 10), 0, writer, tag='input_0')
+
+        tags = self._image_tags(writer)
+        self.assertTrue(any(tag.startswith('input_0_HWD_0') for tag in tags))
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros(1, 1, 10, 10), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
