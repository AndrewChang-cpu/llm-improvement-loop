+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_saved_content(self):
+        def _train_func(engine, batch):
+            return torch.zeros((8, 1, 2, 2))
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_dir=self.test_dir)
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}]
+        engine.run(data, max_epochs=1)
+
+        for i in range(8):
+            name = 'testfile' + str(i)
+            filepath = os.path.join(self.test_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_integer_output_keeps_dtype(self):
+        def _train_func(engine, batch):
+            return torch.zeros((8, 1, 2, 2), dtype=torch.int32)
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_dir=self.test_dir)
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}]
+        engine.run(data, max_epochs=1)
+
+        img = nib.load(os.path.join(self.test_dir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+
+
+if __name__ == '__main__':
+    unittest.main()
