+++ b/monai/data/csv_saver.py
@@ -0,0 +1,93 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches per-item values in memory and writes them to a CSV file when ``finalize`` is called.
+    Each row holds a key followed by the flattened values, with no header row.
+    Engine-free: batches are saved by calling ``save_batch`` directly.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory that the CSV file is written into.
+            filename (str): name of the CSV file, must be a string ending in '.csv'.
+            overwrite (bool): whether to overwrite an existing CSV file. When it is False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = {}
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of a single item.
+            meta_data (dict): optional meta data mapping for the item. The key is taken from ``filename_or_obj``.
+                If it is None or empty, the key is the string form of the item index.
+        """
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._index)
+        self._index += 1
+
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        self._cache[key] = np.asarray(data).astype(np.float32)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches each item along the first dimension of a batch.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): a batch whose first dimension indexes items.
+            meta_data (dict): optional meta data mapping, whose values are per-item sequences indexed in
+                parallel with the batch. See ``save`` for how the key is chosen.
+        """
+        for i in range(len(batch_data)):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Merges rows from an existing file when ``overwrite`` is False, then writes one line per key in
+        insertion order to the CSV file.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for key, values in self._cache.items():
+                f.write(key)
+                for value in values.flatten():
+                    f.write(',' + str(value))
+                f.write('\n')
