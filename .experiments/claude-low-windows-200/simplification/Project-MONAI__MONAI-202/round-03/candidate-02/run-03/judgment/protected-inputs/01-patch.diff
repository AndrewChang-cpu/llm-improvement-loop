+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASE_NO_META = [None]
+TEST_CASE_EMPTY_META = [{}]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_save_batch(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+        saver.save_batch(torch.zeros(8, 1, 2, 2), meta_data)
+
+        for i in range(8):
+            name = 'testfile' + str(i)
+            filepath = os.path.join(self.test_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_input_directory_is_dropped(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.zeros(1, 1, 2, 2), {'filename_or_obj': ['sub/case0.nii.gz']})
+
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, 'case0', 'case0_seg.nii.gz')))
+
+    @parameterized.expand([TEST_CASE_NO_META, TEST_CASE_EMPTY_META])
+    def test_save_batch_index_names(self, meta_data):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.zeros(2, 1, 2, 2), meta_data)
+
+        for i in range(2):
+            name = str(i)
+            self.assertTrue(os.path.exists(os.path.join(self.test_dir, name, name + '_seg.nii.gz')))
+
+    def test_keyword_calls(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save_batch(batch_data=torch.zeros(1, 1, 2, 2), meta_data={'filename_or_obj': ['testfile0']})
+        saver.save(data=torch.zeros(1, 2, 2), meta_data={'filename_or_obj': 'testfile1'})
+
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, 'testfile0', 'testfile0_seg.nii.gz')))
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, 'testfile1', 'testfile1_seg.nii.gz')))
+
+    def test_default_dtype_keeps_data_dtype(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.zeros(1, 1, 2, 2, dtype=torch.int32), {'filename_or_obj': ['testfile0']})
+
+        img = nib.load(os.path.join(self.test_dir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+
+    def test_set_dtype_is_used(self):
+        saver = NiftiSaver(output_dir=self.test_dir, dtype=np.float32)
+        saver.save_batch(torch.zeros(1, 1, 2, 2, dtype=torch.int32), {'filename_or_obj': ['testfile0']})
+
+        img = nib.load(os.path.join(self.test_dir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.float32))
+
+
+if __name__ == '__main__':
+    unittest.main()
