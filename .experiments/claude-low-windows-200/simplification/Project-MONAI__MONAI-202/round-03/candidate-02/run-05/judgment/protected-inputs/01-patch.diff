+import os
+import tempfile
+import unittest
+
+import numpy as np
+import nibabel as nib
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            names = ['testfile' + str(i) for i in range(8)]
+            saver.save_batch(torch.zeros(8, 1, 2, 2), {'filename_or_obj': names})
+
+            for name in names:
+                filepath = os.path.join(tempdir, name, name + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_input_directory_is_dropped(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(torch.zeros(1, 2, 2), {'filename_or_obj': 'sub/case0.nii.gz'})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz')))
+
+    def test_no_meta_data_uses_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 1, 2, 2))
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '0', '0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '1', '1_seg.nii.gz')))
+
+    def test_empty_meta_data_uses_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 1, 2, 2), {})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '0', '0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '1', '1_seg.nii.gz')))
+
+    def test_keyword_call(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(data=torch.zeros(1, 2, 2), meta_data={'filename_or_obj': 'testfile0'})
+            saver.save_batch(batch_data=torch.zeros(1, 1, 2, 2), meta_data={'filename_or_obj': ['testfile1']})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'testfile0', 'testfile0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'testfile1', 'testfile1_seg.nii.gz')))
+
+    def test_dtype_default_keeps_data_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'testfile0'})
+
+            img = nib.load(os.path.join(tempdir, 'testfile0', 'testfile0_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.dtype(np.int32))
+
+    def test_dtype_set_is_used(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir, dtype=np.float64)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'testfile0'})
+
+            img = nib.load(os.path.join(tempdir, 'testfile0', 'testfile0_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.dtype(np.float64))
+
+
+if __name__ == '__main__':
+    unittest.main()
