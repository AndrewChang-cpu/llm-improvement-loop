+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+from tensorboard.backend.event_processing.event_accumulator import EventAccumulator
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASE_1 = [(1, 1, 10, 10), 'input_0_HW_0']
+TEST_CASE_2 = [(1, 3, 10, 10), 'input_0_HW_0']
+TEST_CASE_3 = [(1, 4, 10, 10), 'input_0_HW_0']
+TEST_CASE_4 = [(1, 1, 10, 10, 10), 'input_0_HWD_0']
+TEST_CASE_5 = [(1, 3, 10, 10, 10), 'input_0_HWD_0']
+
+TEST_CASES = [TEST_CASE_1, TEST_CASE_2, TEST_CASE_3, TEST_CASE_4, TEST_CASE_5]
+
+
+def _written_tags(log_dir):
+    accumulator = EventAccumulator(log_dir)
+    accumulator.Reload()
+    return accumulator.Tags()['images']
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape, expected_tag):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=4,
+                                tag='input_0')
+            writer.close()
+
+            self.assertTrue(os.path.exists(tempdir))
+            self.assertIn(expected_tag, _written_tags(tempdir))
+
+    def test_rgb_plot(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 3, 10, 10)), 0, writer, max_channels=3, tag='input_0')
+            writer.close()
+
+            self.assertIn('input_0_CHW', _written_tags(tempdir))
+
+    def test_3d_non_rgb_no_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 4, 10, 10)), 0, writer, max_channels=0, tag='input_0')
+            writer.close()
+
+            tags = _written_tags(tempdir)
+            self.assertFalse(any(tag.startswith('input_0') for tag in tags))
+
+
+if __name__ == '__main__':
+    unittest.main()
