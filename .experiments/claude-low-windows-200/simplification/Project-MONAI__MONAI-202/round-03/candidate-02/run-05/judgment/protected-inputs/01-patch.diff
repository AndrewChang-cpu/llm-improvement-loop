+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the values of items into a CSV file. Values are cached in memory and written to disk
+    only when ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the CSV file to write, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite existing CSV file content. When overwrite is False,
+                rows loaded from an existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item of values, keyed by its name.
+
+        Args:
+            data (Tensor or numpy.ndarray): the values of one item to save.
+            meta_data (dict): optional mapping with the key ``'filename_or_obj'``, used as the item name.
+                If it is None or empty, the item is named by the string form of the item index.
+                A missing ``'filename_or_obj'`` key raises KeyError.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches a batch of items, one item per entry along the first dimension.
+
+        Args:
+            batch_data (Tensor or numpy.ndarray): the batch of values to save, first dimension indexes items.
+            meta_data (dict): optional mapping with the key ``'filename_or_obj'`` (and optionally others),
+                each value is a per-item sequence indexed in parallel with the batch.
+                If it is None or empty, items are named by the item index.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(data, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order.
+        When overwrite is False and the file exists, rows read from the file are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
