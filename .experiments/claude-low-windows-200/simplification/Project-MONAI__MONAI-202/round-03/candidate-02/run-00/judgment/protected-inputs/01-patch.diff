+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return list(csv.reader(f))
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(8), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                reader = csv.reader(f)
+                i = 0
+                for row in reader:
+                    self.assertEqual(row[0], 'testfile' + str(i))
+                    self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+                    i += 1
+                self.assertEqual(i, 8)
+
+    def test_index_key_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 3))
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['0', '1'])
+            self.assertEqual(len(rows[0]), 4)
+
+    def test_keyword_calls(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(data=torch.zeros(2), meta_data={'filename_or_obj': 'testfile0'})
+            saver.save_batch(batch_data=torch.zeros(1, 2), meta_data={'filename_or_obj': ['testfile1']})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['testfile0', 'testfile1'])
+
+    def test_overwrite_false_merges_existing_file(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            first = CSVSaver(output_dir=tempdir)
+            first.save(torch.ones(2), {'filename_or_obj': 'A'})
+            first.save(torch.full((2,), 2.0), {'filename_or_obj': 'C'})
+            first.finalize()
+
+            second = CSVSaver(output_dir=tempdir, overwrite=False)
+            second.save(torch.zeros(2), {'filename_or_obj': 'A'})
+            second.save(torch.zeros(2), {'filename_or_obj': 'B'})
+            second.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            # memory holds A and B, the file holds A and C: order is A, B, C and A takes the file's value
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [1.0, 1.0])
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [0.0, 0.0])
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32).tolist(), [2.0, 2.0])
+
+    def test_invalid_filename(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
