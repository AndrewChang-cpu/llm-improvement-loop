--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,96 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches the values of each item and writes them to a CSV file when ``finalize`` is called.
+    Each row holds a key followed by the flattened values of the item, with no header row.
+    The key is the ``filename_or_obj`` value of the item's meta data when meta data is present,
+    otherwise it is the string form of the item index, which counts saved items from zero.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file, must end with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file. When it is False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename.endswith('.csv'), 'filename must be a string ending in .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of one item, channel-first.
+            meta_data (dict): optional mapping with the key ``filename_or_obj``, used as the row key.
+                If none or empty, the row key is the string form of the item index.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = str(meta_data['filename_or_obj'])
+        else:
+            key = str(self._index)
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches the values of each item along the first dimension of a batch.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of values, the first dimension indexes items.
+            meta_data (dict): optional mapping whose values are per-item sequences, indexed in parallel with
+                the batch. See ``save`` for the keys used.
+        """
+        for i, data in enumerate(batch_data):
+            meta_i = None
+            if meta_data:
+                meta_i = {k: v[i] for k, v in meta_data.items()}
+            self.save(data, meta_i)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order.
+        When ``overwrite`` is False and the file exists, its rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
