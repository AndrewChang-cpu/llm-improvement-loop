+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot the data of one item of a batch to TensorBoard as a 2D image, an RGB image, a single channel image,
+    or animated GIFs of 3D volumes.
+
+    Args:
+        data (torch.Tensor or numpy.ndarray): batch of data in NCHW[D] layout, one item of it is plotted.
+        step (int): global step value to record.
+        writer (SummaryWriter): TensorBoard SummaryWriter to write to.
+        index (int): index of the item in the batch to plot.
+        max_channels (int): maximum number of channels or volumes to plot.
+        max_frames (int): number of frames for the animated GIF of 3D volumes.
+        tag (str): tag prefix for the written images.
+    """
+    assert isinstance(writer, SummaryWriter), 'writer must be an instance of SummaryWriter'
+    if torch.is_tensor(data):
+        data = data.detach().cpu().numpy()
+    d = data[index]
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        writer.add_image('{}_HW'.format(tag), d, step, dataformats='HW')
+    elif d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            writer.add_image('{}_CHW'.format(tag), d, step, dataformats='CHW')
+        elif max_channels >= 1:
+            d2 = rescale_array(d[0], 0, 1)
+            writer.add_image('{}_HW_0'.format(tag), d2, step, dataformats='HW')
+    elif d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
