+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASE_SHAPES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class _RecordingWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images it writes."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, *args, **kwargs):
+        self.image_tags.append(tag)
+        super().add_image(tag, *args, **kwargs)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASE_SHAPES)
+    def test_plot_writes_output(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer)
+            writer.close()
+
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_three_dim_single_channel_tag(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, tag='input_0')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_three_dim_without_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, max_channels=0)
+            writer.close()
+
+            self.assertEqual(writer.image_tags, [])
+
+
+if __name__ == '__main__':
+    unittest.main()
