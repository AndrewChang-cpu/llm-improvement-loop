+"""Tests for the Databricks OAuth profile."""
+
+import json
+from unittest.mock import patch
+
+import pytest
+from airflow.models.connection import Connection
+
+from cosmos.profiles import get_automatic_profile_mapping
+from cosmos.profiles.databricks import (
+    DatabricksOauthProfileMapping,
+    DatabricksTokenProfileMapping,
+)
+
+
+@pytest.fixture()
+def mock_databricks_oauth_conn():  # type: ignore
+    """
+    Mocks and returns an Airflow Databricks connection that uses OAuth client credentials.
+    """
+    conn = Connection(
+        conn_id="my_databricks_oauth_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        extra=json.dumps(
+            {
+                "http_path": "my_http_path",
+                "client_id": "my_client_id",
+                "client_secret": "my_client_secret",
+            }
+        ),
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        yield conn
+
+
+def test_connection_claiming() -> None:
+    """
+    Tests that the Databricks OAuth profile mapping claims the correct connection type.
+    """
+    # should only claim when:
+    # - conn_type == databricks
+    # and the following exist:
+    # - schema
+    # - host
+    # - http_path
+    # - client_id (login or extra.client_id)
+    # - client_secret (password or extra.client_secret)
+    potential_values = {
+        "conn_type": "databricks",
+        "host": "my_host",
+        "extra": json.dumps(
+            {
+                "http_path": "my_http_path",
+                "client_id": "my_client_id",
+                "client_secret": "my_client_secret",
+            }
+        ),
+    }
+
+    # if we're missing any of the values, it shouldn't claim
+    for key in potential_values:
+        values = potential_values.copy()
+        del values[key]
+        conn = Connection(**values)  # type: ignore
+
+        print("testing with", values)
+
+        with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+            profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+            assert not profile_mapping.can_claim_connection()
+
+    # also test when there's no schema
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {})
+        assert not profile_mapping.can_claim_connection()
+
+    # also test when the http_path is removed from extra
+    extra_without_http_path = json.dumps({"client_id": "my_client_id", "client_secret": "my_client_secret"})
+    conn = Connection(**{**potential_values, "extra": extra_without_http_path})  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert not profile_mapping.can_claim_connection()
+
+    # also test when the client id is removed from extra
+    extra_without_client_id = json.dumps({"http_path": "my_http_path", "client_secret": "my_client_secret"})
+    conn = Connection(**{**potential_values, "extra": extra_without_client_id})  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert not profile_mapping.can_claim_connection()
+
+    # also test when the client secret is removed from extra
+    extra_without_client_secret = json.dumps({"http_path": "my_http_path", "client_id": "my_client_id"})
+    conn = Connection(**{**potential_values, "extra": extra_without_client_secret})  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert not profile_mapping.can_claim_connection()
+
+    # if we have them all, it should claim
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert profile_mapping.can_claim_connection()
+
+
+def test_databricks_token_mapping_selected_when_login_and_password_set() -> None:
+    """
+    Tests that a connection with login, password, host, schema and http_path still selects the token mapping.
+    """
+    conn = Connection(
+        conn_id="my_databricks_token_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_login",
+        password="my_token",
+        extra=json.dumps({"http_path": "my_http_path"}),
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = get_automatic_profile_mapping(
+            conn.conn_id,
+            {"schema": "my_schema"},
+        )
+    assert isinstance(profile_mapping, DatabricksTokenProfileMapping)
+
+
+def test_databricks_oauth_mapping_selected(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the OAuth profile mapping is selected when no password or token is set.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        {"schema": "my_schema"},
+    )
+    assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+
+
+def test_profile_args(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the profile values get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "catalog": "my_catalog",
+            "threads": 4,
+        },
+    )
+    assert profile_mapping.profile_args == {
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "threads": 4,
+    }
+
+    assert profile_mapping.profile == {
+        "type": mock_databricks_oauth_conn.conn_type,
+        "host": mock_databricks_oauth_conn.host,
+        "http_path": mock_databricks_oauth_conn.extra_dejson.get("http_path"),
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "threads": 4,
+        "auth_type": "oauth",
+        "client_id": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}",
+        "client_secret": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}",
+    }
+    expected_profile_yml = """example:
+    outputs:
+        cosmos_target:
+            auth_type: oauth
+            catalog: my_catalog
+            client_id: '{{ env_var(''COSMOS_CONN_DATABRICKS_CLIENT_ID'') }}'
+            client_secret: '{{ env_var(''COSMOS_CONN_DATABRICKS_CLIENT_SECRET'') }}'
+            host: https://my_host
+            http_path: my_http_path
+            schema: my_schema
+            threads: 4
+            type: databricks
+    target: cosmos_target\n"""
+    assert profile_mapping.get_profile_file_contents("example") == expected_profile_yml
+
+
+def test_profile_args_cannot_override_auth_or_secrets(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that profile_args cannot override auth_type or the secret fields in the generated profile.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "auth_type": "token",
+            "client_id": "override_client_id",
+            "client_secret": "override_client_secret",
+        },
+    )
+    profile = profile_mapping.profile
+    assert profile["auth_type"] == "oauth"
+    assert profile["client_id"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}"
+    assert profile["client_secret"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}"
+
+
+def test_profile_env_vars(
+    mock_databricks_oauth_conn: Connection,
+) -> None:
+    """
+    Tests that the environment variables get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_oauth_conn.conn_id,
+        profile_args={"schema": "my_schema"},
+    )
+    assert profile_mapping.env_vars == {
+        "COSMOS_CONN_DATABRICKS_CLIENT_SECRET": "my_client_secret",
+        "COSMOS_CONN_DATABRICKS_CLIENT_ID": "my_client_id",
+    }
