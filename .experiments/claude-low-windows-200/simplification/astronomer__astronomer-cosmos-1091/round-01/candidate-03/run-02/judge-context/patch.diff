+"""Tests for the Databricks OAuth profile mapping."""
+
+import json
+from unittest.mock import patch
+
+import pytest
+from airflow.models.connection import Connection
+
+from cosmos.profiles import get_automatic_profile_mapping
+from cosmos.profiles.databricks import (
+    DatabricksOauthProfileMapping,
+    DatabricksTokenProfileMapping,
+)
+
+
+@pytest.fixture()
+def mock_databricks_conn():  # type: ignore
+    """
+    Mocks and returns an Airflow Databricks connection that carries OAuth credentials in extra.
+    """
+    conn = Connection(
+        conn_id="my_databricks_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        extra=json.dumps(
+            {
+                "http_path": "my_http_path",
+                "client_id": "my_client_id",
+                "client_secret": "my_client_secret",
+            }
+        ),
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        yield conn
+
+
+def test_connection_claiming() -> None:
+    """
+    Tests that the Databricks OAuth profile mapping claims the correct connection type.
+    """
+    # should only claim when:
+    # - conn_type == databricks
+    # and the following exist:
+    # - schema
+    # - host
+    # - http_path
+    # - client_id (login or extra.client_id)
+    # - client_secret (password or extra.client_secret)
+    # client_id is sourced from login or extra.client_id; client_secret from password or extra.client_secret
+    full_values = {
+        "conn_type": "databricks",
+        "host": "my_host",
+        "login": "my_client_id",
+        "password": "my_client_secret",
+        "extra": json.dumps({"http_path": "my_http_path"}),
+    }
+    full_profile_args = {"schema": "my_schema"}
+
+    # remove each required input in turn; none of these should claim
+    missing_cases = [
+        # (name, connection kwargs, profile_args)
+        ("host", {k: v for k, v in full_values.items() if k != "host"}, full_profile_args),
+        ("schema", full_values, {}),
+        ("http_path", {**full_values, "extra": json.dumps({})}, full_profile_args),
+        ("client_id", {k: v for k, v in full_values.items() if k != "login"}, full_profile_args),
+        (
+            "client_secret",
+            {k: v for k, v in full_values.items() if k != "password"},
+            full_profile_args,
+        ),
+    ]
+    for name, values, profile_args in missing_cases:
+        conn = Connection(**values)  # type: ignore
+
+        print("testing with missing", name, values)
+
+        with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+            profile_mapping = DatabricksOauthProfileMapping("my_conn", profile_args)
+            assert not profile_mapping.can_claim_connection(), name
+
+    # client id and client secret can also come from extra
+    conn = Connection(
+        conn_type="databricks",
+        host="my_host",
+        extra=json.dumps({"http_path": "my_http_path", "client_id": "my_client_id", "client_secret": "my_secret"}),
+    )
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping("my_conn", full_profile_args)
+        assert profile_mapping.can_claim_connection()
+
+    # with every required input present, it should claim
+    conn = Connection(**full_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping("my_conn", full_profile_args)
+        assert profile_mapping.can_claim_connection()
+
+
+def test_databricks_token_mapping_selected_with_login_and_password() -> None:
+    """
+    Tests that a connection with login, password, host, schema, and http path still selects the token mapping.
+    """
+    conn = Connection(
+        conn_id="my_token_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_login",
+        password="my_token",
+        extra=json.dumps({"http_path": "my_http_path"}),
+    )
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = get_automatic_profile_mapping(
+            conn.conn_id,
+            {"schema": "my_schema"},
+        )
+    assert isinstance(profile_mapping, DatabricksTokenProfileMapping)
+
+
+def test_databricks_oauth_mapping_selected(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that the OAuth profile mapping is selected when there is no password or token.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_conn.conn_id,
+        {"schema": "my_schema"},
+    )
+    assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+
+
+def test_profile_args(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that the profile values get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "catalog": "my_catalog",
+            "session_properties": {"legacy_time_parser_policy": "corrected"},
+            "threads": 4,
+        },
+    )
+    assert profile_mapping.profile_args == {
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "session_properties": {"legacy_time_parser_policy": "corrected"},
+        "threads": 4,
+    }
+
+    assert profile_mapping.profile == {
+        "type": mock_databricks_conn.conn_type,
+        "host": mock_databricks_conn.host,
+        "http_path": "my_http_path",
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "threads": 4,
+        "session_properties": {"legacy_time_parser_policy": "corrected"},
+        "auth_type": "oauth",
+        "client_secret": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}",
+        "client_id": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}",
+    }
+
+
+def test_profile_auth_and_secrets_not_overridable(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that profile_args cannot override auth_type or the secret fields.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "auth_type": "not_oauth",
+            "client_id": "plaintext_id",
+            "client_secret": "plaintext_secret",
+        },
+    )
+    profile = profile_mapping.profile
+    assert profile["auth_type"] == "oauth"
+    assert profile["client_id"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}"
+    assert profile["client_secret"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}"
+
+
+def test_profile_env_vars(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that the environment variables get set correctly.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_conn.conn_id,
+        profile_args={"schema": "my_schema"},
+    )
+    assert profile_mapping.env_vars == {
+        "COSMOS_CONN_DATABRICKS_CLIENT_SECRET": "my_client_secret",
+        "COSMOS_CONN_DATABRICKS_CLIENT_ID": "my_client_id",
+    }
