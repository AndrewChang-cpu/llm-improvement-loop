@@ -0,0 +1,181 @@
+"""Tests for the Databricks OAuth profile."""
+
+from unittest.mock import patch
+
+import pytest
+from airflow.models.connection import Connection
+
+from cosmos.profiles import get_automatic_profile_mapping
+from cosmos.profiles.databricks import (
+    DatabricksOauthProfileMapping,
+    DatabricksTokenProfileMapping,
+)
+
+
+@pytest.fixture()
+def mock_databricks_conn():  # type: ignore
+    """
+    Mocks and returns an Airflow Databricks connection using OAuth credentials.
+    """
+    conn = Connection(
+        conn_id="my_databricks_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        login="my_client_id",
+        password="my_client_secret",
+        extra='{"http_path": "my_http_path"}',
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        yield conn
+
+
+def test_connection_claiming() -> None:
+    """
+    Tests that the Databricks OAuth profile mapping claims the correct connection type.
+    """
+    # should only claim when:
+    # - conn_type == databricks
+    # and the following exist:
+    # - schema
+    # - host
+    # - http_path
+    # - client_id
+    # - client_secret
+    potential_values = {
+        "conn_type": "databricks",
+        "host": "my_host",
+        "login": "my_client_id",
+        "password": "my_client_secret",
+        "extra": '{"http_path": "my_http_path"}',
+    }
+
+    # if we're missing any of the values, it shouldn't claim
+    for key in potential_values:
+        values = potential_values.copy()
+        del values[key]
+        conn = Connection(**values)  # type: ignore
+
+        print("testing with", values)
+
+        with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+            profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+            assert not profile_mapping.can_claim_connection()
+
+    # also test when there's no schema
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {})
+        assert not profile_mapping.can_claim_connection()
+
+    # if we have them all, it should claim
+    conn = Connection(**potential_values)  # type: ignore
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = DatabricksOauthProfileMapping(conn, {"schema": "my_schema"})
+        assert profile_mapping.can_claim_connection()
+
+
+def test_databricks_token_mapping_selected_over_oauth(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that a connection with login, password, host, schema and http path is still
+    selected as the token mapping.
+    """
+    profile_mapping = get_automatic_profile_mapping(
+        mock_databricks_conn.conn_id,
+        {"schema": "my_schema"},
+    )
+    assert isinstance(profile_mapping, DatabricksTokenProfileMapping)
+
+
+def test_databricks_oauth_mapping_selected() -> None:
+    """
+    Tests that a connection with extra OAuth credentials and no password or token is
+    selected as the OAuth mapping.
+    """
+    conn = Connection(
+        conn_id="my_databricks_oauth_connection",
+        conn_type="databricks",
+        host="https://my_host",
+        extra='{"http_path": "my_http_path", "client_id": "my_client_id", "client_secret": "my_client_secret"}',
+    )
+
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=conn):
+        profile_mapping = get_automatic_profile_mapping(
+            conn.conn_id,
+            {"schema": "my_schema"},
+        )
+    assert isinstance(profile_mapping, DatabricksOauthProfileMapping)
+
+
+def test_profile_args_overrides_do_not_override_auth(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that profile_args cannot override the auth type or the secret fields.
+    """
+    profile_mapping = DatabricksOauthProfileMapping(
+        mock_databricks_conn.conn_id,
+        {
+            "schema": "my_schema",
+            "auth_type": "token",
+            "client_id": "plaintext_id",
+            "client_secret": "plaintext_secret",
+        },
+    )
+    with patch("airflow.hooks.base.BaseHook.get_connection", return_value=mock_databricks_conn):
+        profile = profile_mapping.profile
+
+    assert profile["auth_type"] == "oauth"
+    assert profile["client_id"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}"
+    assert profile["client_secret"] == "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}"
+
+
+def test_profile_args(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that the profile values get set correctly.
+    """
+    profile_mapping = DatabricksOauthProfileMapping(
+        mock_databricks_conn.conn_id,
+        profile_args={
+            "schema": "my_schema",
+            "catalog": "my_catalog",
+            "threads": 4,
+        },
+    )
+    assert profile_mapping.profile_args == {
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "threads": 4,
+    }
+
+    assert profile_mapping.profile == {
+        "type": mock_databricks_conn.conn_type,
+        "host": "https://my_host",
+        "http_path": mock_databricks_conn.extra_dejson.get("http_path"),
+        "schema": "my_schema",
+        "catalog": "my_catalog",
+        "threads": 4,
+        "auth_type": "oauth",
+        "client_id": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_ID') }}",
+        "client_secret": "{{ env_var('COSMOS_CONN_DATABRICKS_CLIENT_SECRET') }}",
+    }
+
+
+def test_profile_env_vars(
+    mock_databricks_conn: Connection,
+) -> None:
+    """
+    Tests that the environment variables get set correctly.
+    """
+    profile_mapping = DatabricksOauthProfileMapping(
+        mock_databricks_conn.conn_id,
+        profile_args={"schema": "my_schema"},
+    )
+    assert profile_mapping.env_vars == {
+        "COSMOS_CONN_DATABRICKS_CLIENT_SECRET": mock_databricks_conn.password,
+        "COSMOS_CONN_DATABRICKS_CLIENT_ID": mock_databricks_conn.login,
+    }
