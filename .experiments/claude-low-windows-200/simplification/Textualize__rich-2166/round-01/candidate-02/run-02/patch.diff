+def test_task_progress_column() -> None:
+    column = TaskProgressColumn()
+    known = Task(1, "test", 100, 25, _get_time=lambda: 1.0)
+    assert str(column.render(known)) == " 25%"
+    unknown = Task(1, "test", None, 25, _get_time=lambda: 1.0)
+    assert str(column.render(unknown)) == ""
+
+
+def test_unknown_total_task_is_not_finished() -> None:
+    progress = Progress(
+        get_time=lambda: 1.0,
+        auto_refresh=False,
+        console=Console(file=io.StringIO()),
+    )
+    task_id = progress.add_task("foo", total=None)
+    progress.advance(task_id, 5)
+    progress.update(task_id, completed=7)
+    task = progress.tasks[0]
+    assert task.total is None
+    assert task.completed == 7
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert task.percentage == 0
+    assert not task.finished
+    assert task.finished_time is None
+    assert task.finished_speed is None
+    progress.update(task_id, total=10)
+    assert task.remaining == 3
+    assert not task.finished
+    progress.update(task_id, completed=10)
+    assert task.finished
+
+
