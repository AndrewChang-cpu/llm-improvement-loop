+def test_unknown_total_task_fields() -> None:
+    task = Task(TaskID(1), "foo", None, 0, _get_time=lambda: 1)
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert task.percentage == 0
+
+
+def test_unknown_total_update_and_advance() -> None:
+    progress = Progress(
+        console=Console(file=io.StringIO()),
+        auto_refresh=False,
+        get_time=MockClock(),
+    )
+    task_id = progress.add_task("foo", total=None)
+    progress.advance(task_id, 10)
+    progress.update(task_id, advance=5)
+    task = progress.tasks[0]
+    assert task.completed == 15
+    assert not task.finished
+    assert task.finished_time is None
+    assert task.finished_speed is None
+
+    progress.update(task_id, total=20)
+    assert task.total == 20
+    progress.update(task_id, advance=5)
+    assert task.finished
+
+
+def test_unknown_total_bar_pulses() -> None:
+    bar = ProgressBar(total=None, completed=5, width=12, animation_time=10)
+    assert bar.percentage_completed is None
+
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=40,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+    with console.capture() as capture:
+        console.print(bar, end="")
+    pulse = ProgressBar(pulse=True, completed=5, width=12, animation_time=10)
+    with console.capture() as pulse_capture:
+        console.print(pulse, end="")
+    assert capture.get() == pulse_capture.get()
+
+
+def test_unknown_total_progress_pulse_render() -> None:
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=30,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+    progress = Progress(
+        BarColumn(bar_width=None),
+        TaskProgressColumn(),
+        TimeRemainingColumn(),
+        console=console,
+        auto_refresh=False,
+        get_time=MockClock(auto=False),
+    )
+    progress.add_task("foo", total=None)
+    with progress:
+        progress.refresh()
+    result = console.file.getvalue()
+    print(repr(result))
+    assert "%" not in result
+    assert "-:--:--" not in result
+
+    reference_console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=30,
+        color_system="truecolor",
+        legacy_windows=False,
+        _environ={},
+    )
+    reference_bar = ProgressBar(pulse=True, width=30, animation_time=0)
+    with reference_console.capture() as capture:
+        reference_console.print(reference_bar, end="")
+    assert result == "\x1b[?25l" + capture.get() + "\n\x1b[?25h"
