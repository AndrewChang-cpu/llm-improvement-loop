+class TaskProgressColumn(TextColumn):
+    """A column showing the task progress as a percentage, or blank text if the total is unknown.
+
+    Args:
+        text_format (str, optional): Format string used when the task total is known. Defaults to "[progress.percentage]{task.percentage:>3.0f}%".
+        text_format_no_percentage (str, optional): Format string used when the task total is None. Defaults to "" (blank).
+        style (StyleType, optional): Style of the text. Defaults to "none".
+        justify (JustifyMethod, optional): Justification of the text. Defaults to "left".
+        markup (bool, optional): Enable console markup in the text. Defaults to True.
+        highlighter (Highlighter, optional): Highlighter applied to the text. Defaults to None.
+        table_column (Column, optional): Table column to use. Defaults to None.
+    """
+
+    def __init__(
+        self,
+        text_format: str = "[progress.percentage]{task.percentage:>3.0f}%",
+        text_format_no_percentage: str = "",
+        style: StyleType = "none",
+        justify: JustifyMethod = "left",
+        markup: bool = True,
+        highlighter: Optional[Highlighter] = None,
+        table_column: Optional[Column] = None,
+    ) -> None:
+        self.text_format_no_percentage = text_format_no_percentage
+        super().__init__(
+            text_format,
+            style=style,
+            justify=justify,
+            markup=markup,
+            highlighter=highlighter,
+            table_column=table_column,
+        )
+
+    def render(self, task: "Task") -> Text:
+        """Show the task percentage, or blank text when the total is unknown."""
+        text_format = (
+            self.text_format_no_percentage if task.total is None else self.text_format
+        )
+        return self._make_text(text_format.format(task=task))
+
+
