+def test_unknown_total_task_progress_column_uses_no_percentage_format() -> None:
+    task = Task(1, "test", None, 20, _get_time=lambda: 1.0)
+    column = TaskProgressColumn(text_format_no_percentage="n/a")
+
+    assert str(column.render(task)) == "n/a"
+
+
+def test_task_progress_column_known_total() -> None:
+    task = Task(1, "test", 100, 20, _get_time=lambda: 1.0)
+
+    assert str(TaskProgressColumn().render(task)) == " 20%"
+
+
+def test_mofn_complete_column_unknown_total() -> None:
+    task = Task(1, "test", None, 5, _get_time=lambda: 1.0)
+
+    assert str(MofNCompleteColumn().render(task)) == "5/?"
+
+
+def test_download_column_unknown_total() -> None:
+    task = Task(1, "test", None, 2048, _get_time=lambda: 1.0)
+
+    assert str(DownloadColumn(binary_units=True).render(task)) == "2.0/? KiB"
+    assert str(DownloadColumn().render(task)) == "2.0/? kB"
+
+
+def test_unknown_total_task_never_finishes() -> None:
+    progress = Progress(auto_refresh=False, get_time=lambda: 1.0)
+    task_id = progress.add_task("test", total=None)
+    progress.advance(task_id, 1000)
+    progress.update(task_id, advance=1000)
+
+    task = progress.tasks[0]
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert task.percentage == 0
+    assert not task.finished
+    assert task.finished_time is None
+    assert task.finished_speed is None
+
+
+def test_update_total_restores_finish() -> None:
+    progress = Progress(auto_refresh=False, get_time=lambda: 1.0)
+    task_id = progress.add_task("test", total=None)
+    progress.advance(task_id, 20)
+    assert not progress.tasks[0].finished
+
+    progress.update(task_id, total=10)
+    task = progress.tasks[0]
+    assert task.total == 10
+    assert task.finished
+    assert task.remaining == -10
+
+
