diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..21967f1
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,425 @@
+from __future__ import annotations
+
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..reactive import Reactive
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A single tab in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = name or label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabEdge:
+    """Edge description for the shared layout resolver.
+
+    Args:
+        size (int, optional): Fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): Minimum size for a flexible edge. Defaults to 1.
+        fraction (int): Share of the remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Return one tab per distinct name, in first-occurrence order.
+
+    The label of each entry is the label of the last tab that carries that name.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The displayed tabs.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its original position
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    The label row lays out a left padding edge, a label edge, and a right padding
+    edge for each displayed tab. The underline bar follows the bar position.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the unhighlighted part of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding size in cells, or ``None``
+            to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Resolve every style before any span or bar is built
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        # A zero padding is treated as absent, so the padding edges auto-fit
+        padding_size = self.tab_padding or None
+        edges: List[_TabEdge] = []
+        for tab in displayed:
+            edges.append(_TabEdge(size=padding_size))
+            edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(_TabEdge(size=padding_size))
+        sizes = layout_resolve(width, edges)
+
+        label_row: List[Segment] = []
+        label_ranges: List[Tuple[int, int]] = []
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[3 * index : 3 * index + 3]
+            label_start = cursor + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (cursor, selection_end)
+            cursor = selection_end
+
+            # The padded span is one run of text, so padding shares the label's style
+            span = Text(no_wrap=True, overflow="crop", end="")
+            content = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                span.append(content, style=active_style)
+                label_row.extend(console.render(span, options))
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                span.append(content, style=click_style)
+                label_row.extend(
+                    console.render(
+                        Opacity(span, opacity=self.inactive_text_opacity), options
+                    )
+                )
+
+        yield from label_row
+        yield Segment.line()
+
+        highlight_range = self._highlight_range(label_ranges)
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _highlight_range(
+        self, label_ranges: List[Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (List[Tuple[int, int]]): Label range of each displayed tab.
+
+        Returns:
+            Tuple[float, float]: The highlight range, or ``(0, 0)`` with no tabs.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        floor_index = int(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+        floor_start, floor_end = label_ranges[floor_index]
+        next_start, next_end = label_ranges[next_index]
+        start = floor_start + (next_start - floor_start) * fraction
+        end = floor_end + (next_end - floor_end) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline.
+    A tab is selected with the keyboard or by clicking its label or underline.
+
+    Args:
+        tabs (List[Tab]): The tabs, in display order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. A name that matches no tab is kept, and the bar
+            sits at the first tab.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the unhighlighted part of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Seconds the underline takes to move to a new
+            active tab. Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            ``None`` or ``0`` auto-fits the padding to the widget width.
+            Defaults to None.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        else:
+            initial_name = active_tab or tabs[0].name
+        self._active_tab_name = initial_name
+        # The bar starts at the displayed position of the active tab, without animating
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the displayed position of the new active tab.
+
+        Args:
+            tab_name (str | None): The name of the new active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        Every key event is marked handled, and propagation is never stopped, so
+        application bindings still receive the key. With no tabs, nothing else happens.
+
+        - Escape releases focus from the widget.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - The digits 0 through 9 activate a tab by position, using the rules of
+          ``activate_tab_by_number``.
+        - Any other key, when ``search_by_first_character`` is true, activates the
+          next tab whose label starts with that character, ignoring case.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, ignores
+        case, and never selects the active tab. With no match, nothing changes.
+
+        Args:
+            char (str): The character to match against the first letter of each label.
+        """
+        target = char.lower()
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label[:1].lower() == target:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        A number above the tab count is ignored. The number 0 activates the 10th tab
+        when there are at least ten tabs, and otherwise the last tab. Any other number
+        activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the click action of the tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the position of a name among the displayed tabs, or 0 if absent.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index into the displayed tabs.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
