+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    first, second = item.spans[-2:]
+    assert (first.start, first.end) == (0, 2)
+    assert (second.start, second.end) == (3, 5)
+    assert _click_action(first) == "range_clicked('first')"
+    assert _click_action(second) == "range_clicked('second')"
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    for bar in (
+        UnderlineBar(width=6, clickable_ranges={"a": (0, 3)}),
+        UnderlineBar(
+            highlight_range=(5, 2), width=6, clickable_ranges={"a": (0, 3)}
+        ),
+    ):
+        item = _first_item(bar)
+        assert isinstance(item, Text)
+        assert item.plain == "━━━━━━"
+        assert item.spans
+        for span in item.spans:
+            assert isinstance(span.style, Style)
+            assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3), clickable_ranges={"a": (0, 2)}, width=6
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━━╸╺━━"
+    assert _click_action(item.spans[-1]) == "range_clicked('a')"
