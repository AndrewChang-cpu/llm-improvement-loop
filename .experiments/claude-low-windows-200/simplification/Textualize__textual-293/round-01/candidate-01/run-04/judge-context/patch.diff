+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows Tabs widgets mounted directly on the App."""
+
+    def on_mount(self):
+        self.mount(
+            first=Tabs(
+                [Tab("Home"), Tab("Files"), Tab("Settings")],
+                active_tab="Files",
+            ),
+            second=Tabs(
+                [Tab("Alpha", "a"), Tab("Beta", "b"), Tab("Gamma", "c")],
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
