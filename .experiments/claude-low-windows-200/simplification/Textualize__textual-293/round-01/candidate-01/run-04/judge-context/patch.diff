@@ -0,0 +1,159 @@
+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+TABS = [Tab("Home", "home"), Tab("Files", "files"), Tab("Settings", "settings")]
+
+
+def _plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def _segments(renderable, width=40):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def _click_actions(segments):
+    actions = set()
+    for segment in segments:
+        if isinstance(segment.style, Style):
+            action = segment.style.meta.get("@click")
+            if action is not None:
+                actions.add(action)
+    return actions
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert Tab("Home", "home") != Tab("Home")
+    assert Tab("Home") == Tab("Home", "Home")
+    assert "label='Home'" in repr(Tab("Home", "home"))
+    assert "name='home'" in repr(Tab("Home", "home"))
+
+
+def test_construct_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    assert Tabs(TABS)._active_tab_name == "home"
+
+
+def test_initial_active_tab_given_and_unknown():
+    assert Tabs(TABS, active_tab="files")._active_tab_name == "files"
+    assert Tabs(TABS, active_tab="missing")._active_tab_name == "missing"
+
+
+def test_find_tab_by_name_returns_first_occurrence():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs(TABS, active_tab="settings")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "home"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "settings"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs(TABS)
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "files"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "settings"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "settings"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_uses_tenth():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_first_char_searches_after_active_and_wraps():
+    tabs = Tabs(
+        [Tab("Alpha", "a"), Tab("apricot", "b"), Tab("Beta", "c"), Tab("ALL", "d")]
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "d"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active():
+    tabs = Tabs(TABS, active_tab="files")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "files"
+
+
+def test_activate_tab_by_first_char_never_selects_active():
+    tabs = Tabs([Tab("Alpha", "a"), Tab("Beta", "b")], active_tab="a")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs(TABS)
+    tabs.action_range_clicked("files")
+    assert tabs._active_tab_name == "files"
+
+
+def test_render_no_tabs_has_empty_label_row_and_full_bar():
+    lines = _plain(Tabs([]).render()).split("\n")
+    assert lines[0] == ""
+    assert lines[1] == "━" * 100
+
+
+def test_render_label_row_with_explicit_padding():
+    row = _plain(Tabs(TABS, tab_padding=1).render()).split("\n")[0]
+    assert row == " Home  Files  Settings "
+
+
+def test_render_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")],
+        active_tab="y",
+        tab_padding=1,
+    )
+    row = _plain(tabs.render()).split("\n")[0]
+    assert row == " C  B "
+
+
+def test_inactive_labels_carry_click_action_and_active_does_not():
+    tabs = Tabs(TABS, active_tab="files", tab_padding=1)
+    segments = _segments(tabs.render())
+    texts = {segment.text: segment for segment in segments if segment.text}
+    home = texts[" Home "]
+    files = texts[" Files "]
+    assert isinstance(home.style, Style)
+    assert home.style.meta.get("@click") == "range_clicked('home')"
+    assert isinstance(files.style, Style)
+    assert "@click" not in files.style.meta
+
+
+def test_underline_row_carries_click_action_for_every_displayed_tab():
+    tabs = Tabs(TABS, active_tab="files", tab_padding=1)
+    actions = _click_actions(_segments(tabs.render()))
+    assert actions == {
+        "range_clicked('home')",
+        "range_clicked('files')",
+        "range_clicked('settings')",
+    }
