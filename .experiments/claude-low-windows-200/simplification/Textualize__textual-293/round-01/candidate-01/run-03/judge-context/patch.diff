@@ -0,0 +1,177 @@
+import re
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+
+# The render helper prints at a width of 100 cells.
+RENDER_WIDTH = 100
+
+
+def plain_lines(renderable):
+    return ANSI_ESCAPE.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "start").name == "start"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "start") == Tab("Home", "start")
+    assert Tab("Home", "start") != Tab("Home", "other")
+    assert str(Tab("Home", "start")) == "Home"
+
+
+def test_construction_with_empty_tab_list_succeeds():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_construction_with_tabs_succeeds():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_and_bar_position():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], active_tab="Three")
+    assert tabs._active_tab_name == "Three"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_starts_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_tab_wrap_around():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], active_tab="Three")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_follows_position():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_zero_selects_last_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 4)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_activate_tab_by_number_above_count_is_ignored():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("avocado"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y")])
+    tabs.action_range_clicked("y")
+    assert tabs._active_tab_name == "y"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    lines = plain_lines(Tabs([]).render())
+    assert lines == ["", "━" * RENDER_WIDTH]
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Uno", "a")],
+        tab_padding=1,
+    )
+    assert plain_lines(tabs.render())[0] == " Uno  Two "
+
+
+def test_fixed_padding_row_layout():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " One  Two  Three "
+
+
+def test_auto_fit_row_layout_shares_space_across_padding_edges():
+    # Labels take 6 cells, leaving 94 cells for four flexible padding edges. Each
+    # edge gets 23.5 cells, so the fractional halves carry forward: 23, 24, 23, 24.
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    expected = " " * 23 + "One" + " " * 24 + " " * 23 + "Two" + " " * 24
+    assert plain_lines(tabs.render())[0] == expected
+
+
+def test_underline_highlights_active_tab_span():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two", tab_padding=1)
+    underline = plain_lines(tabs.render())[1]
+    # The row is " One  Two " so the label "Two" spans columns 6 to 9 and the
+    # highlight starts at column 6 with a right-half glyph at column 5.
+    assert underline[5] == "╸"
+    assert underline[6:9] == "━━━"
+    assert underline[9] == "╺"
+
+
+def test_inactive_label_span_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    console = Console(width=RENDER_WIDTH, color_system="truecolor")
+    row = next(iter(tabs.render().__rich_console__(console, console.options)))
+    assert isinstance(row, Text)
+    assert row.plain == " One  Two "
+
+    def covering_spans(position):
+        return [span for span in row.spans if span.start <= position < span.end]
+
+    for span in covering_spans(2):  # "One" is active
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+    inactive_spans = covering_spans(7)  # "Two" is inactive
+    click_actions = [
+        span.style.meta.get("@click")
+        for span in inactive_spans
+        if isinstance(span.style, Style)
+    ]
+    assert "range_clicked('Two')" in click_actions
