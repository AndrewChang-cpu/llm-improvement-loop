+def blend_style(style: Style, opacity: float) -> Style:
+    """Blend the foreground color of a style toward its background color.
+
+    The blended color replaces the foreground color. All other attributes of the
+    style, such as its background color and meta data, are kept.
+
+    Args:
+        style (Style): The style to blend.
+        opacity (float): The opacity as a float. A value of 1.0 means the text is
+            fully visible.
+
+    Returns:
+        Style: The blended style, or the original style if it has no truecolor
+            foreground and background colors to blend.
+    """
+    fg = style.color
+    bg = style.bgcolor
+    if fg and fg.triplet and bg and bg.triplet:
+        return style + _get_blended_color_cached(
+            fg_color=fg, bg_color=bg, opacity=opacity
+        )
+    return style
 
 
