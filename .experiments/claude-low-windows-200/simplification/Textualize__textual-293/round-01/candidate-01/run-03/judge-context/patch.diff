diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..305669a
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,452 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.style import Style, StyleType
+from rich.text import Span, Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import blend_style
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab shown by the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge for the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[tuple[str, str]]:
+    """Return one ``(name, label)`` pair per distinct tab name.
+
+    A name appears where it first occurs, and its label is taken from the last tab
+    that carries that name.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+
+    Returns:
+        list[tuple[str, str]]: The displayed ``(name, label)`` pairs.
+    """
+    # A dict keeps the position of the first insertion and updates the value on
+    # later insertions, which gives the placement and label rule described above.
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return list(labels.items())
+
+
+class TabsRenderable:
+    """Render the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): The fractional index of the bar into the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's label.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs' labels.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int, optional): The fixed padding on each side of a label, or
+            ``None`` to fit the labels across the width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        # Resolve every style before any span or bar is built.
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = blend_style(
+            console.get_style(self.inactive_tab_style), self.inactive_text_opacity
+        )
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        displayed = _displayed_tabs(self.tabs)
+        paddings = self._resolve_paddings(width, displayed)
+
+        row = Text(no_wrap=True, overflow="crop", end="\n")
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        column = 0
+        for (name, label), (left, label_width, right) in zip(displayed, paddings):
+            padded = " " * left + label + " " * right
+            char_start = len(row)
+            row.append(padded)
+            if padded:
+                if name == self.active_tab_name:
+                    # The active tab carries no click action.
+                    row.spans.append(
+                        Span(char_start, char_start + len(padded), active_style)
+                    )
+                else:
+                    click_style = Style(meta={"@click": f"range_clicked('{name}')"})
+                    row.spans.append(
+                        Span(
+                            char_start,
+                            char_start + len(padded),
+                            inactive_style + click_style,
+                        )
+                    )
+            label_start = column + left
+            label_ranges.append((label_start, label_start + label_width))
+            selection_ranges[name] = (column, column + left + label_width + right)
+            column += left + label_width + right
+
+        yield row
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _resolve_paddings(
+        self, width: int, displayed: list[tuple[str, str]]
+    ) -> list[tuple[int, int, int]]:
+        """Compute the left padding, label width, and right padding of each tab.
+
+        Args:
+            width (int): The width available to the label row.
+            displayed (list[tuple[str, str]]): The displayed ``(name, label)`` pairs.
+
+        Returns:
+            list[tuple[int, int, int]]: The ``(left, label, right)`` cell counts of
+                each tab.
+        """
+        padding_size = self.tab_padding or None
+        # A zero-width label is left out of the solver, since a size of zero would
+        # make it flexible. It is given a width of zero below.
+        slots: list[_Edge | None] = []
+        for _name, label in displayed:
+            label_width = cell_len(label)
+            slots.append(_Edge(size=padding_size))
+            slots.append(_Edge(size=label_width) if label_width else None)
+            slots.append(_Edge(size=padding_size))
+        solved = iter(
+            layout_resolve(width, [slot for slot in slots if slot is not None])
+        )
+        sizes = [next(solved) if slot is not None else 0 for slot in slots]
+        return [
+            (sizes[index], sizes[index + 1], sizes[index + 2])
+            for index in range(0, len(sizes), 3)
+        ]
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted columns from the bar position.
+
+        Args:
+            label_ranges (list[tuple[int, int]]): The label columns of each displayed
+                tab.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        floor_index = min(max(int(math.floor(self.bar_position)), 0), count - 1)
+        fraction = min(max(self.bar_position - floor_index, 0.0), 1.0)
+        next_index = (floor_index + 1) % count
+        current_start, current_end = label_ranges[floor_index]
+        next_start, next_end = label_ranges[next_index]
+        start = current_start + (next_start - current_start) * fraction
+        end = current_end + (next_end - current_end) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the labels and the second row shows the underline. A tab is
+    selected by pressing its number or the arrow keys, by typing its first character,
+    or by clicking it.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order.
+        active_tab (str, optional): The name of the tab to start on. Defaults to the
+            name of the first tab.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to the text of inactive
+            tabs, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline movement.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function for the underline
+            movement. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells of padding on each side of a
+            label. ``None`` or zero fits the labels across the width. Defaults to None.
+        search_by_first_character (bool): Whether pressing a letter key selects the
+            next tab whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            self.active_tab_style,
+            self.active_bar_style,
+            self.inactive_tab_style,
+            self.inactive_bar_style,
+            self.inactive_text_opacity,
+            self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget receives key events.
+
+        Every key event is marked handled, and propagation is not stopped, so
+        application bindings still receive the key. With no tabs, nothing else
+        happens.
+
+        The keys are handled as follows:
+
+        - Escape removes focus from the widget.
+        - Right and left select the next or previous tab, wrapping at either end.
+        - The digits 1 to 9 select the tab at that 1-based position. The digit 0
+          selects the 10th tab, or the last tab when there are fewer than ten.
+          Numbers above the tab count are ignored.
+        - When ``search_by_first_character`` is true, any other key selects the next
+          tab after the active one whose label starts with that character, ignoring
+          case. The search wraps, and it never selects the active tab.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            # Named keys such as "ctrl+a" are not characters, so they are not searched.
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full list active, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full list active, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Make the next tab whose label starts with a character active.
+
+        The search starts after the active tab and wraps around the full list. It
+        ignores case and never selects the active tab. If no tab matches, the active
+        tab does not change.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        # The range runs to count inclusive, so the starting tab is checked last. It
+        # is still skipped when it is the active tab.
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Make the tab at a 1-based position active.
+
+        A number above the tab count is ignored. The number 0 selects the 10th tab
+        when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name in the full list.
+
+        Args:
+            tab_name (str | None): The name to find.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the click action of a tab's cells.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed tab of the new active name.
+
+        Args:
+            active_tab_name (str | None): The name of the new active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs, or 0 if absent.
+
+        Args:
+            tab_name (str | None): The name to find.
+
+        Returns:
+            int: The index of the name among the displayed tabs.
+        """
+        names = [name for name, _label in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
