+from __future__ import annotations
+
+import io
+from typing import List
+
+from rich.console import Console, RenderableType
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def _rows(renderable: RenderableType, width: int) -> List[str]:
+    """Render to lines of plain text, without padding the lines to the width."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    lines = console.render_lines(renderable, console.options, pad=False)
+    return ["".join(segment.text for segment in line) for line in lines]
+
+
+def _segments(renderable: RenderableType, width: int, console: Console) -> list:
+    """Render to segments, which carry resolved styles."""
+    return list(console.render(renderable, console.options.update_width(width)))
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert Tab("Home", "home") != Tab("Home")
+    assert Tab("Home") == Tab("Home", "Home")
+
+
+def test_construction_with_empty_and_non_empty_lists():
+    assert Tabs([])._active_tab_name is None
+    assert Tabs([Tab("Home")])._active_tab_name == "Home"
+
+
+def test_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("About")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("About")], active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_bar_position_uses_displayed_index_for_duplicates():
+    # Displayed tabs are [Contact (name "x"), About]; About is displayed at index 1.
+    tabs = Tabs(
+        [Tab("Home", "x"), Tab("About"), Tab("Contact", "x")],
+        active_tab="About",
+    )
+    assert tabs._bar_position == 1.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("Home", "x"), Tab("About"), Tab("Contact", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("About") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_at_either_end():
+    tabs = Tabs(
+        [Tab("Home"), Tab("About"), Tab("Contact")], active_tab="Contact"
+    )
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Home"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Contact"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("Home"), Tab("About"), Tab("Contact")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "About"
+
+
+def test_activate_tab_by_number_zero_uses_last_tab_below_ten():
+    tabs = Tabs([Tab("Home"), Tab("About"), Tab("Contact")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Contact"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_at_ten_or_more():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_number_above_count_is_ignored():
+    tabs = Tabs([Tab("Home"), Tab("About")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "Home"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Home"), Tab("About"), Tab("Contact"), Tab("Help")],
+        active_tab="Help",
+    )
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("About"), Tab("Contact")], active_tab="About")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "About"
+
+
+def test_first_char_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Home"), Tab("Contact")],
+        search_by_first_character=False,
+    )
+    tabs.activate_tab_by_first_char("c")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Contact")])
+    tabs.action_range_clicked("Contact")
+    assert tabs._active_tab_name == "Contact"
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_underline():
+    tabs = Tabs([])
+    assert _rows(tabs.render(), 10) == ["", "━" * 10]
+
+
+def test_flexible_padding_shares_follow_layout_rule():
+    # Width 20, labels "A" and "B" take 2 cells, leaving 18 for four flexible edges.
+    # Shares are 18/4 = 4.5 each. The whole parts are 4, 5, 4, 5, with the
+    # fractional remainder carried forward.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert _rows(tabs.render(), 20)[0] == "    A" + " " * 9 + "B" + " " * 5
+
+
+def test_explicit_padding_row():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=2)
+    assert _rows(tabs.render(), 40)[0] == "  Home    About  "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("Home", "x"), Tab("About"), Tab("Contact", "x")],
+        tab_padding=1,
+    )
+    assert _rows(tabs.render(), 40)[0] == " Contact  About "
+
+
+def test_inactive_label_carries_click_action_and_active_label_does_not():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    segments = _segments(tabs.render(), 40, console)
+
+    about = [segment for segment in segments if "About" in segment.text]
+    assert len(about) == 1
+    assert isinstance(about[0].style, Style)
+    assert about[0].style.meta == {"@click": "range_clicked('About')"}
+
+    home = [segment for segment in segments if "Home" in segment.text]
+    assert len(home) == 1
+    assert isinstance(home[0].style, Style)
+    assert "@click" not in home[0].style.meta
+
+
+def test_inactive_label_is_dimmed_by_opacity():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    segments = _segments(tabs.render(), 40, console)
+    about = [segment for segment in segments if "About" in segment.text][0]
+    original_color = console.get_style(tabs.inactive_tab_style).color
+    assert about.style.color != original_color
