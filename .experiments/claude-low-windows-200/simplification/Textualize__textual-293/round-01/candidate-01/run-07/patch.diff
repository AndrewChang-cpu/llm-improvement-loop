+    assert isinstance(item, Text)
+    home_span, about_span = item.spans[-2:]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert (about_span.start, about_span.end) == (3, 6)
+    assert isinstance(home_span.style, Style)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
+    assert isinstance(about_span.style, Style)
+    assert about_span.style.meta == {"@click": "range_clicked('about')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (3, 1), (-5, -2)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar, max_width=6)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    for span in item.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_gets_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar, max_width=6)
+    home_span = item.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
+
+
+def test_highlight_edges_use_half_glyphs_at_whole_numbers():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    item = _first_item(bar, max_width=6)
+    assert item.plain == "━╸━━╺━"
