@@ -0,0 +1,450 @@
+from __future__ import annotations
+
+from typing import List
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab when it is selected.
+            Defaults to None, which uses the label as the name.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for layout_resolve.
+
+    Args:
+        size (int, optional): A fixed size, or None for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take.
+        fraction (int): The share of the remaining space a flexible edge takes.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Get the tabs that are drawn, one per distinct name.
+
+    Each name is placed where it first appears, and carries the label of the last
+    tab that uses that name.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs.
+
+    Returns:
+        List[Tab]: The displayed tabs, in display order.
+    """
+    displayed: dict[str, Tab] = {}
+    for tab in tabs:
+        displayed[tab.name] = tab
+    return list(displayed.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): The bar position, a fractional index into the
+            displayed tabs.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab labels.
+        tab_padding (int, optional): The fixed cell count of each padding edge, or
+            None (or zero) to fit padding automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_sizes(
+        self, label_total: int, edge_count: int, width: int
+    ) -> List[int]:
+        """Size the padding edges around the labels.
+
+        Args:
+            label_total (int): The total cell width of all labels.
+            edge_count (int): The number of padding edges.
+            width (int): The width available to the row.
+
+        Returns:
+            List[int]: The size of each padding edge, in row order.
+        """
+        if self.tab_padding:
+            edges = [_Edge(size=self.tab_padding) for _ in range(edge_count)]
+        else:
+            edges = [_Edge() for _ in range(edge_count)]
+        return layout_resolve(width - label_total, edges)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Resolve every configured style against the console before use.
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_widths = [cell_len(tab.label) for tab in displayed]
+        # Each tab has a left and a right padding edge.
+        paddings = self._padding_sizes(
+            sum(label_widths), 2 * len(displayed), width
+        )
+
+        label_row: List[Segment] = []
+        label_ranges: List[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        column = 0
+        for index, tab in enumerate(displayed):
+            left = paddings[2 * index]
+            right = paddings[2 * index + 1]
+            label_width = label_widths[index]
+            padded = " " * left + tab.label + " " * right
+
+            label_start = column + left
+            label_ranges.append((label_start, label_start + label_width))
+            selection_end = column + left + label_width + right
+            selection_ranges[tab.name] = (column, selection_end)
+
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action.
+                label_row.append(Segment(padded, active_style))
+            else:
+                # Inactive tabs carry their own click action, and are dimmed.
+                tab_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                padded_text = Text(padded, style=tab_style, end="", no_wrap=True)
+                label_row.extend(
+                    console.render(
+                        Opacity(padded_text, opacity=self.inactive_text_opacity),
+                        options,
+                    )
+                )
+            column = selection_end
+
+        yield from label_row
+        yield Segment.line()
+
+        # Clicks are clipped to the row width. Ranges that fall outside it are dropped.
+        clickable_ranges: dict[str, tuple[int, int]] = {}
+        for tab_name, (start, end) in selection_ranges.items():
+            start = max(start, 0)
+            end = min(end, width)
+            if start < end:
+                clickable_ranges[tab_name] = (start, end)
+
+        # The highlight follows the bar position, interpolating between the label
+        # ranges of the floor index and the next index, which wraps at the end.
+        highlight_range = (0.0, 0.0)
+        if displayed:
+            last_index = len(displayed) - 1
+            position = min(max(self.bar_position, 0.0), float(last_index))
+            index = int(position)
+            fraction = position - index
+            next_index = (index + 1) % len(displayed)
+            start_a, end_a = label_ranges[index]
+            start_b, end_b = label_ranges[next_index]
+            highlight_range = (
+                start_a + (start_b - start_a) * fraction,
+                end_a + (end_b - end_a) * fraction,
+            )
+
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The active tab is shown by the underline bar. The user can select a tab with the
+    keyboard, or by clicking its label or its underline.
+
+    Args:
+        tabs (List[Tab]): The tabs to display, in order. Tab names need not be unique.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            None, which selects the first tab. A name that matches no tab is kept, and
+            the bar sits at the first displayed tab.
+        active_tab_style (StyleType): The style of the active tab label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab labels,
+            from 0 (text matches its background) to 1 (no dimming). Defaults to 0.5.
+        animation_duration (float): The duration, in seconds, of the bar animation
+            when the active tab changes. Defaults to 0.3.
+        animation_function (str): The name of the easing function used for the bar
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a label.
+            Defaults to None, which fits padding to the available width. Zero is
+            treated the same as None.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label begins with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+
+        # Set the bar position first, so the watcher animates from the start position.
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a tab name within the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index, or 0 when no displayed tab has the name.
+        """
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name in the full tab list.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 when none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the bar to the displayed index of the new active tab.
+
+        Args:
+            active_tab_name (str | None): The new active tab name.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        """Build the label row and underline bar.
+
+        Returns:
+            RenderableType: A TabsRenderable for the current state.
+        """
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        The key is always marked handled, and propagation is not stopped, so
+        application bindings still receive it. With no tabs, the key does nothing else.
+
+        - Right and Left move to the next or previous tab, wrapping at either end.
+        - Escape removes focus from the widget.
+        - The digits 1 to 9 activate the tab at that position. The digit 0 follows
+          the rule of ``activate_tab_by_number``.
+        - Any other single character activates the next tab, after the active one,
+          whose label begins with that character. The search is case-insensitive
+          and skipped when ``search_by_first_character`` is False.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label begins with a character.
+
+        The search starts after the active tab and wraps. It never selects the active
+        tab, and does nothing when no tab matches or when the search is disabled.
+
+        Args:
+            char (str): The character to match, compared case-insensitively.
+        """
+        if not self.search_by_first_character:
+            return
+        needle = char.lower()
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        A number above the tab count is ignored. The number 0 activates the 10th tab
+        when there are at least ten tabs, and otherwise the last tab. Any other number
+        activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name when its label or underline is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
