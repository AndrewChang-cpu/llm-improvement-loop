+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+ACTIVE_COLOR = Color.parse("#f0f0f0").triplet
+
+
+def plain_lines(renderable):
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def segments_of(renderable):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def segment_containing(segments, text):
+    matches = [s for s in segments if s.style is not None and text in s.text]
+    assert matches, f"no segment contains {text!r}"
+    return matches[0]
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("One", "1") == Tab("One", "1")
+    assert Tab("One", "1") != Tab("One", "2")
+    assert repr(Tab("One", "1")) == "Tab(label='One', name='1')"
+
+
+def test_tab_text_form_is_label():
+    assert str(Tab("One", "1")) == "One"
+
+
+def test_construction_with_default_styles_succeeds():
+    Tabs([])
+    Tabs([Tab("One")])
+
+
+def test_initial_active_tab_is_first_tab_by_default():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    assert tabs._active_tab_name == "a"
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_at_either_end():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(f"T{i}", f"t{i}") for i in range(3)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "t1"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t2"
+    tabs.activate_tab_by_number(7)
+    assert tabs._active_tab_name == "t2"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{i}", f"t{i}") for i in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [
+            Tab("Apple", "a"),
+            Tab("Banana", "b"),
+            Tab("Avocado", "v"),
+            Tab("Apricot", "p"),
+        ],
+        active_tab="a",
+    )
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "v"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "p"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Alpha", "x"), Tab("Beta", "y")], active_tab="x")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "x"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Alpha", "x"), Tab("Beta", "y")], active_tab="x")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "x"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    assert plain_lines(Tabs([]).render()) == ["", "━" * 100]
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " C  B "
+
+
+def test_fixed_padding_lays_out_labels_with_padding_cells():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " One  Two "
+
+
+def test_auto_fit_padding_shares_remaining_width():
+    # Four flexible padding edges share the 94 cells left by two 3-cell labels.
+    # Each gets 23.5 cells, so the whole-cell parts are 23, 24, 23, 24, in order.
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    expected = " " * 23 + "One" + " " * 24 + " " * 23 + "Two" + " " * 24
+    assert plain_lines(tabs.render())[0] == expected
+
+
+def test_underline_highlights_active_label_with_half_cell_edges():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    # The active label occupies cells 1 to 3, so the highlight runs from cell 1 to 4.
+    # Cell 0 gets a right-half glyph and cell 4 gets a left-half glyph.
+    underline = plain_lines(tabs.render())[1]
+    assert underline == "╸" + "━" * 3 + "╺" + "━" * 95
+
+
+def test_inactive_label_and_padding_carry_click_action_and_are_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    inactive = segment_containing(segments_of(tabs.render()), "Two")
+    assert inactive.text == " Two "
+    assert inactive.style.meta == {"@click": "range_clicked('Two')"}
+    assert inactive.style.color.triplet != ACTIVE_COLOR
+
+
+def test_active_label_has_no_click_action_and_is_not_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    active = segment_containing(segments_of(tabs.render()), "One")
+    assert "@click" not in active.style.meta
+    assert active.style.color.triplet == ACTIVE_COLOR
