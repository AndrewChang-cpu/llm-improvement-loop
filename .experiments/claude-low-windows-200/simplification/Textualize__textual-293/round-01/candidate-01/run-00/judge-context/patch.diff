diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..da8441b
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,452 @@
+"""A horizontal tab bar with an animated underline."""
+
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len, set_cell_size
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """Edge description consumed by the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tuple[str, str]]:
+    """Return one ``(name, label)`` pair per distinct name.
+
+    Each name is placed where it first appears, and it takes the label of the last
+    tab that carries that name.
+    """
+    order: List[str] = []
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        if tab.name not in labels:
+            order.append(tab.name)
+        labels[tab.name] = tab.label
+    return [(name, labels[name]) for name in order]
+
+
+class _TabLayout:
+    """Cell positions of one displayed tab.
+
+    Args:
+        name (str): The tab name.
+        label (str): The fitted label text, exactly as wide as the label edge.
+        left (int): Width of the left padding in cells.
+        right (int): Width of the right padding in cells.
+        label_width (int): Width of the label in cells.
+        start (int): Column where the padded span begins.
+    """
+
+    def __init__(
+        self, name: str, label: str, left: int, right: int, label_width: int, start: int
+    ) -> None:
+        self.name = name
+        self.label = label
+        self.left = left
+        self.right = right
+        self.label_width = label_width
+        self.selection_range = (start, start + left + label_width + right)
+        label_start = start + left
+        self.label_range = (label_start, label_start + label_width)
+
+
+class TabsRenderable:
+    """Renderable for the Tabs widget: a label row followed by an underline bar.
+
+    Args:
+        tabs (list[Tab]): The full tab list. Duplicate names are displayed once.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs of the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of each inactive tab's padded span.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding size in cells, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> List[_TabLayout]:
+        """Lay out the displayed tabs across ``width`` cells."""
+        displayed = _displayed_tabs(self.tabs)
+        edges: List[_Edge] = []
+        for _, label in displayed:
+            if self.tab_padding:
+                padding = _Edge(size=self.tab_padding)
+            else:
+                padding = _Edge(size=None, min_size=1)
+            edges.extend([padding, _Edge(size=cell_len(label)), padding])
+
+        sizes = layout_resolve(width, edges)
+
+        layouts: List[_TabLayout] = []
+        position = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_width, right = sizes[3 * index : 3 * index + 3]
+            layouts.append(
+                _TabLayout(
+                    name=name,
+                    label=set_cell_size(label, label_width),
+                    left=left,
+                    right=right,
+                    label_width=label_width,
+                    start=position,
+                )
+            )
+            position = layouts[-1].selection_range[1]
+        return layouts
+
+    def _highlight_range(self, layouts: List[_TabLayout]) -> Tuple[float, float]:
+        """Interpolate the highlight between the label ranges at the bar position."""
+        if not layouts:
+            return (0, 0)
+        count = len(layouts)
+        floor_position = int(math.floor(self.bar_position))
+        fraction = self.bar_position - floor_position
+        current = layouts[floor_position % count]
+        following = layouts[(floor_position + 1) % count]
+        current_start, current_end = current.label_range
+        next_start, next_end = following.label_range
+        start = current_start + (next_start - current_start) * fraction
+        end = current_end + (next_end - current_end) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        # Resolve every configured style before any span is built
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        layouts = self._layout(width)
+
+        for layout in layouts:
+            padded = " " * layout.left + layout.label + " " * layout.right
+            if layout.name == self.active_tab_name:
+                # The active span carries no click action
+                yield Text(
+                    padded,
+                    style=active_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+            else:
+                click_style = inactive_tab_style + Style(
+                    meta={"@click": f"range_clicked('{layout.name}')"}
+                )
+                yield Opacity(
+                    Text(
+                        padded,
+                        style=click_style,
+                        no_wrap=True,
+                        overflow="crop",
+                        end="",
+                    ),
+                    opacity=self.inactive_text_opacity,
+                )
+
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(layouts),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges={
+                layout.name: layout.selection_range for layout in layouts
+            },
+            width=width,
+        )
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal tab bar. A user selects a tab by keyboard or mouse.
+
+    The widget is two rows high. The first row shows the tab labels and the second
+    row shows an underline bar that slides under the active tab. Tabs are identified
+    by name, not by position.
+
+    Args:
+        tabs (list[Tab]): The ordered tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. When it is
+            ``None`` or empty, the first tab is active. A name that matches no tab is
+            kept, and the bar sits at index 0. Defaults to None.
+        active_tab_style (StyleType): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the underline under the active tab.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the underline outside the active
+            tab. Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels, where
+            1.0 keeps the label fully visible and 0.0 hides it. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline animation
+            when the active tab changes. Defaults to 0.3.
+        animation_function (str): The name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label. When
+            it is ``None`` or zero, padding fills the remaining width. Defaults to None.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to True.
+    """
+
+    can_focus = True
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+        self._active_tab_name = initial_name
+        # The bar starts in place, without animation
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs, or 0 if absent."""
+        names = [name for name, _ in _displayed_tabs(self.tabs)]
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name in the full tab list.
+
+        Args:
+            tab_name (str): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 when none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search begins after the active tab and wraps around the full tab list. It
+        compares case-insensitively and never selects the active tab. When no tab
+        matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position, using 1-based numbering.
+
+        A number above the tab count is ignored. The number 0 activates the tenth tab
+        when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used by clickable underline spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Every key press is marked handled, and propagation is not stopped, so
+        application bindings still receive keys. With no tabs, nothing else happens.
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - Keys 1 to 9 activate the tab at that 1-based position. The key 0 follows the
+          rule of ``activate_tab_by_number``. Numbers above the tab count are ignored.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab whose label starts with it, ignoring case.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the displayed index of the new active tab."""
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
