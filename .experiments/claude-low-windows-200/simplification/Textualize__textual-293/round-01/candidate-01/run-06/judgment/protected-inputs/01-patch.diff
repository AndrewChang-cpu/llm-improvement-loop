     )
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (2, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    first, second = item.spans[-2:]
+    assert (first.start, first.end) == (0, 2)
+    assert (second.start, second.end) == (2, 6)
+    assert _click_meta(first) == "range_clicked('one')"
+    assert _click_meta(second) == "range_clicked('two')"
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(9, 10),
+        clickable_ranges={"one": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    for span in item.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_keeps_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"one": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert _click_meta(item.spans[-1]) == "range_clicked('one')"
