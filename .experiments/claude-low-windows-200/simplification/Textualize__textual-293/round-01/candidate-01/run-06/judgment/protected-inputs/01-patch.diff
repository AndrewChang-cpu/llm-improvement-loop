+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain_rows(widget):
+    return ANSI.sub("", render(widget.render())).split("\n")
+
+
+def _row_click_actions(widget, row):
+    """Return the click action of each cell in a row, or None for no action."""
+    console = Console(width=100, file=io.StringIO())
+    rows = [[]]
+    for segment in console.render(widget.render(), console.options):
+        if segment.text == "\n":
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    actions = []
+    for segment in rows[row]:
+        meta = segment.style.meta if segment.style is not None else {}
+        actions.extend([meta.get("@click")] * len(segment.text))
+    return actions
+
+
+def _three_tabs():
+    return [Tab("One"), Tab("Two"), Tab("Three")]
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "other")
+    assert str(Tab("Home", "home")) == "Home"
+
+
+def test_construct_with_empty_list():
+    widget = Tabs([])
+    assert widget._active_tab_name is None
+
+
+def test_construct_with_tabs():
+    widget = Tabs(_three_tabs())
+    assert widget._active_tab_name == "One"
+    assert widget._bar_position == 0.0
+
+
+def test_initial_active_tab_by_name():
+    widget = Tabs(_three_tabs(), active_tab="Three")
+    assert widget._active_tab_name == "Three"
+    assert widget._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    widget = Tabs(_three_tabs(), active_tab="Nope")
+    assert widget._active_tab_name == "Nope"
+    assert widget._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_occurrence():
+    widget = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    widget = Tabs(_three_tabs())
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "Two"
+    widget.activate_next_tab()
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "One"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs(_three_tabs())
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "Two"
+    widget.activate_tab_by_number(5)
+    assert widget._active_tab_name == "Two"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = [Tab(f"Tab {index}") for index in range(1, 13)]
+    widget = Tabs(tabs)
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "Tab 10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    widget = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")])
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Avocado"
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "Apple"
+    widget.activate_tab_by_first_char("B")
+    assert widget._active_tab_name == "banana"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active():
+    widget = Tabs(_three_tabs())
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "One"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    widget = Tabs([Tab("Apple"), Tab("Banana")])
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_first_char_search_disabled_by_flag():
+    widget = Tabs(_three_tabs(), search_by_first_character=False)
+    widget.activate_tab_by_first_char("t")
+    assert widget._active_tab_name == "One"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs(_three_tabs())
+    widget.action_range_clicked("Three")
+    assert widget._active_tab_name == "Three"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    rows = _plain_rows(Tabs([]))
+    assert rows == ["", "━" * 100]
+
+
+def test_label_row_uses_fixed_padding():
+    widget = Tabs([Tab("Home"), Tab("Settings")], tab_padding=1)
+    assert _plain_rows(widget)[0] == " Home  Settings "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    widget = Tabs(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")],
+        active_tab="x",
+        tab_padding=1,
+    )
+    assert _plain_rows(widget)[0] == " C  B "
+
+
+def test_underline_highlights_active_label_span():
+    widget = Tabs([Tab("Home"), Tab("Settings")], tab_padding=1)
+    underline = _plain_rows(widget)[1]
+    assert underline[0] == "╸"
+    assert underline[1:5] == "━━━━"
+    assert underline[5] == "╺"
+
+
+def test_inactive_label_carries_click_action_and_active_does_not():
+    widget = Tabs([Tab("Home"), Tab("Settings")], tab_padding=1)
+    actions = _row_click_actions(widget, 0)
+    assert actions[:6] == [None] * 6
+    assert actions[6:16] == ["range_clicked('Settings')"] * 10
+
+
+def test_underline_cells_carry_click_actions_for_every_displayed_tab():
+    widget = Tabs([Tab("Home"), Tab("Settings")], tab_padding=1)
+    actions = _row_click_actions(widget, 1)
+    assert actions[:6] == ["range_clicked('Home')"] * 6
+    assert actions[6:16] == ["range_clicked('Settings')"] * 10
+    assert actions[16] is None
