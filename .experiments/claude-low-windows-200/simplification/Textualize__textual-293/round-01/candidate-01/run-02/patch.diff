@@ -0,0 +1,187 @@
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+INACTIVE_STYLE = "#f0f0f0 on #021720"
+
+
+def _render_parts(tabs: Tabs, width: int = 40) -> tuple:
+    """Return the label row Text and the underline Text for a Tabs widget."""
+    console = Console(width=width)
+    row, bar = list(tabs.render().__rich_console__(console, console.options))
+    (bar_text,) = list(bar.__rich_console__(console, console.options))
+    return row, bar_text
+
+
+def _click_at(text: Text, cell: int):
+    """Return the click action covering a cell, if any."""
+    action = None
+    for span in text.spans:
+        if span.start <= cell < span.end and isinstance(span.style, Style):
+            action = span.style.meta.get("@click", action)
+    return action
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home-key").name == "home-key"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("A", "x") == Tab("A", "x")
+    assert Tab("A", "x") != Tab("A", "y")
+    assert Tab("A", "x") != Tab("B", "x")
+
+
+def test_tab_repr_and_str():
+    assert repr(Tab("A", "x")) == "Tab(label='A', name='x')"
+    assert str(Tab("A", "x")) == "A"
+
+
+def test_construction_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_construction_with_tabs_and_default_styles():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs.find_tab_by_name("B") == 1
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+
+
+def test_find_tab_by_name_unknown_returns_zero():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_unknown_active_tab_is_kept_and_bar_starts_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="nope")
+    assert tabs._active_tab_name == "nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(name) for name in "ABCDE"])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "E"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Home"), Tab("about"), Tab("Contact"), Tab("Docs")])
+    tabs.activate_tab_by_first_char("c")
+    assert tabs._active_tab_name == "Contact"
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Home"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "about"
+    tabs.activate_tab_by_first_char("D")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Home")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_first_char_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Home"), Tab("Contact")], search_by_first_character=False
+    )
+    tabs.activate_tab_by_first_char("c")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_label_row_with_fixed_padding():
+    row, _ = _render_parts(Tabs([Tab("Home"), Tab("About")], tab_padding=1))
+    assert row.plain == " Home  About "
+
+
+def test_label_row_auto_fit_shares_flexible_padding():
+    # Four flexible padding edges share 8 cells, so each gets 2
+    row, _ = _render_parts(Tabs([Tab("A"), Tab("B")]), width=10)
+    assert row.plain == "  A    B  "
+
+
+def test_inactive_label_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="A", tab_padding=1)
+    row, _ = _render_parts(tabs)
+    # " A " occupies cells 0-2 and " B " occupies cells 3-5
+    assert _click_at(row, 0) is None
+    assert _click_at(row, 1) is None
+    assert _click_at(row, 4) == "range_clicked('B')"
+    assert _click_at(row, 3) == "range_clicked('B')"
+    console = Console(width=40)
+    original = console.get_style(INACTIVE_STYLE)
+    inactive_span = next(
+        span for span in row.spans if span.start <= 4 < span.end
+    )
+    assert isinstance(inactive_span.style, Style)
+    assert inactive_span.style.color != original.color
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], tab_padding=1)
+    row, bar = _render_parts(tabs)
+    assert row.plain == " Three  Two "
+    click_spans = bar.spans[-2:]
+    assert (click_spans[0].start, click_spans[0].end) == (0, 7)
+    assert click_spans[0].style.meta == {"@click": "range_clicked('a')"}
+    assert (click_spans[1].start, click_spans[1].end) == (7, 12)
+    assert click_spans[1].style.meta == {"@click": "range_clicked('b')"}
+
+
+def test_underline_click_ranges_include_active_tab():
+    row, bar = _render_parts(Tabs([Tab("A"), Tab("B")]), width=10)
+    click_spans = bar.spans[-2:]
+    assert (click_spans[0].start, click_spans[0].end) == (0, 5)
+    assert click_spans[0].style.meta == {"@click": "range_clicked('A')"}
+    assert (click_spans[1].start, click_spans[1].end) == (5, 10)
+    assert click_spans[1].style.meta == {"@click": "range_clicked('B')"}
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    row, bar = _render_parts(Tabs([]), width=20)
+    assert row.plain == ""
+    assert bar.plain == "━" * 20
+
+
+def test_tabs_renderable_is_returned_by_render():
+    assert isinstance(Tabs([Tab("A")]).render(), TabsRenderable)
