@@ -1,3 +1,7 @@
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
@@ -124,3 +128,69 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+class _Options:
+    def __init__(self, max_width: int) -> None:
+        self.max_width = max_width
+
+
+def _render_items(bar: UnderlineBar, width: int) -> list:
+    console = Console(width=width)
+    return list(bar.__rich_console__(console, _Options(width)))
+
+
+def _click_meta(span_style) -> dict:
+    assert isinstance(span_style, Style)
+    return span_style.meta
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+        width=6,
+    )
+    items = _render_items(bar, 6)
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    assert text.plain == "━╸━━╺━"
+    first_click, second_click = text.spans[-2], text.spans[-1]
+    assert (first_click.start, first_click.end) == (0, 3)
+    assert _click_meta(first_click.style) == {"@click": "range_clicked('first')"}
+    assert (second_click.start, second_click.end) == (3, 6)
+    assert _click_meta(second_click.style) == {"@click": "range_clicked('second')"}
+
+
+def test_highlight_plain_text_has_half_glyphs_at_edges():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    (text,) = _render_items(bar, 6)
+    assert text.plain == "━╸━━╺━"
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(0, 0),
+        clickable_ranges={"tab": (0, 3)},
+        width=6,
+    )
+    (text,) = _render_items(bar, 6)
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    assert text.spans
+    for span in text.spans:
+        assert "@click" not in _click_meta(span.style)
+
+
+def test_zero_width_highlight_at_nonzero_position_keeps_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"tab": (0, 3)},
+        width=6,
+    )
+    (text,) = _render_items(bar, 6)
+    assert isinstance(text, Text)
+    click_span = text.spans[-1]
+    assert (click_span.start, click_span.end) == (0, 3)
+    assert _click_meta(click_span.style) == {"@click": "range_clicked('tab')"}
