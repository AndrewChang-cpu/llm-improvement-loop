+    assert item.plain == "━━━━━━"
+    for span in item.spans:
+        assert click_meta(span) is None
+
+
+def test_rejected_highlight_takes_early_path_without_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(9, 10),
+        clickable_ranges={"first": (0, 2)},
+        width=6,
+    )
+    item = render_first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    for span in item.spans:
+        assert click_meta(span) is None
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"tab": (0, 2)},
+        width=6,
+    )
+    item = render_first_item(bar)
+    assert isinstance(item, Text)
+    last = item.spans[-1]
+    assert (last.start, last.end) == (0, 2)
+    assert click_meta(last) == "range_clicked('tab')"
