+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def strip_ansi(text: str) -> str:
+    return ANSI_PATTERN.sub("", text)
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "h")
+
+
+def test_tabs_constructs_with_empty_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_tabs_constructs_with_default_styles():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")])
+    assert tabs.find_tab_by_name("d") == 1
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")])
+    assert tabs._active_tab_name == "h"
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")], active_tab="d")
+    assert tabs._active_tab_name == "d"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_zero_selects_last_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(str(number), f"t{number}") for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t9"
+
+
+def test_activate_tab_by_number_above_count_is_ignored():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")], active_tab="b")
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "b"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple", "apple"), Tab("Banana", "banana"), Tab("avocado", "avo")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avo"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple", "apple"), Tab("Banana", "banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple", "apple"), Tab("Banana", "banana")], active_tab="banana")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "banana"
+
+
+def test_first_char_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Apple", "apple"), Tab("Banana", "banana")],
+        search_by_first_character=False,
+    )
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    lines = strip_ansi(render(Tabs([]).render())).split("\n")
+    assert lines[0] == ""
+    assert lines[1] == "━" * 100
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")], tab_padding=1)
+    lines = strip_ansi(render(tabs.render())).split("\n")
+    assert lines[0] == " Home  Docs "
+    # The active label spans columns 1 to 5, so the bar highlights cells 1 to 4.
+    assert lines[1] == "╸" + "━" * 4 + "╺" + "━" * 94
+
+
+def test_auto_fit_labels_share_flexible_width():
+    # Width 100 with labels "A" and "B" leaves 98 cells for four flexible padding
+    # edges, a share of 24.5 each. The shares round to 24, 25, 24, 25 with the
+    # fractional part carried forward: 24 + 1 + 25 + 24 + 1 + 25 = 100.
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    lines = strip_ansi(render(tabs.render())).split("\n")
+    assert lines[0] == " " * 24 + "A" + " " * 49 + "B" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("Home", "h"), Tab("Docs", "d"), Tab("Home 2", "h")],
+        tab_padding=1,
+    )
+    lines = strip_ansi(render(tabs.render())).split("\n")
+    assert lines[0] == " Home 2  Docs "
+
+
+def test_inactive_label_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")], tab_padding=1)
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+    docs = [segment for segment in segments if "Docs" in segment.text]
+    assert len(docs) == 1
+    assert docs[0].text == " Docs "
+    style = docs[0].style
+    assert isinstance(style, Style)
+    assert style.meta["@click"] == "range_clicked('d')"
+    # The label colour is blended toward the background, so it differs from the
+    # configured foreground colour.
+    assert style.color != Color.parse("#f0f0f0")
+
+
+def test_active_label_has_no_click_action():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")], tab_padding=1)
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+    home = [segment for segment in segments if "Home" in segment.text]
+    assert len(home) == 1
+    assert isinstance(home[0].style, Style)
+    assert "@click" not in home[0].style.meta
