diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..fd54f46
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,400 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab shown in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A layout edge for one part of a tab: left padding, label, or right padding."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the full tab list for the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the non-highlighted part of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' text.
+        tab_padding (int | None): Fixed padding size per side, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """Return one tab per distinct name, in order of first occurrence.
+
+        The label of each entry is the label of the last tab carrying that name.
+        """
+        displayed: dict[str, Tab] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab
+        return list(displayed.values())
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        The bar position indexes the full tab list. Each index is mapped to the
+        displayed tab that carries its name, so the highlight sits under the displayed
+        tab with the active name.
+
+        Args:
+            label_ranges (dict[str, tuple[int, int]]): Label range per displayed tab.
+
+        Returns:
+            tuple[float, float]: The highlight range for the underline bar.
+        """
+        if not self.tabs:
+            return (0, 0)
+        count = len(self.tabs)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[self.tabs[index].name]
+        start_b, end_b = label_ranges[self.tabs[next_index].name]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = self._displayed_tabs()
+
+        # Each displayed tab has three edges: left padding, label, right padding.
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=self.tab_padding or None))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=self.tab_padding or None))
+        sizes = layout_resolve(width, edges)
+
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        offset = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            selection_start = offset
+            label_start = offset + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (selection_start, selection_end)
+            offset = selection_end
+
+            # The whole padded span is one run, so padding shares the label's style.
+            run = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                yield Text(
+                    run,
+                    style=active_tab_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+            else:
+                click_style = inactive_tab_style + Style.from_meta(
+                    {"@click": f"range_clicked('{tab.name}')"}
+                )
+                yield Opacity(
+                    Text(
+                        run,
+                        style=click_style,
+                        end="",
+                        no_wrap=True,
+                        overflow="crop",
+                    ),
+                    opacity=self.inactive_text_opacity,
+                )
+
+        # Line break between the label row and the underline row.
+        yield Text("", end="\n")
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline. A tab
+    is selected with the keyboard or with the mouse.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str | None, optional): The name of the initially active tab.
+            Defaults to the name of the first tab when not given.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio for inactive labels, where
+            1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the bar animation in seconds.
+            Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the bar
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): Fixed number of cells on each side of a
+            label, or ``None`` to fit the labels across the width. A value of zero is
+            treated as ``None``. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether letter keys activate the
+            next tab whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._bar_position = 0.0
+        if initial_name is not None:
+            self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the bar to the index of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            self.active_tab_style,
+            self.active_bar_style,
+            self.inactive_tab_style,
+            self.inactive_bar_style,
+            self.inactive_text_opacity,
+            self.tab_padding or None,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, compares
+        case-insensitively, and never selects the active tab. Nothing happens when
+        ``search_by_first_character`` is false or no tab matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        if not self.search_by_first_character:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for step in range(1, count):
+            tab = self.tabs[(start + step) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        A number above the tab count is ignored. The number 0 activates the 10th tab
+        when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Used by the click action of each tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Every key is marked as handled, and propagation is not stopped. With no tabs
+        the key is ignored. Otherwise:
+
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - Escape removes focus from the widget.
+        - The digits 1 to 9 activate the tab at that 1-based position. The digit 0
+          follows the rule of ``activate_tab_by_number``. Numbers above the tab count
+          are ignored.
+        - Any other single character activates the next tab whose label starts with
+          that character, when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1:
+            self.activate_tab_by_first_char(key)
