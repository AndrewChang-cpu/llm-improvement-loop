diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..d76d758
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,154 @@
+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable):
+    return ANSI.sub("", render(renderable))
+
+
+def segments_of(renderable):
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "h") != Tab("Home")
+    assert Tab("Home", "h") != Tab("Docs", "h")
+
+
+def test_tab_repr_shows_both_fields():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_empty_and_populated_lists():
+    assert Tabs([])._active_tab_name is None
+    assert Tabs([Tab("a"), Tab("b")])._active_tab_name == "a"
+
+
+def test_active_tab_given_sets_bar_position():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("a"), Tab("b")], active_tab="zz")
+    assert tabs._active_tab_name == "zz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_occurrence():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+    tabs.activate_tab_by_number(11)
+    assert tabs._active_tab_name == "10"
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "10"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_uses_last():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("a"), Tab("b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    text = plain(Tabs([]).render())
+    assert text == "\n" + "━" * 100
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    first_line = plain(tabs.render()).split("\n")[0]
+    assert first_line == " Home  Docs "
+
+
+def test_label_row_with_auto_fit_padding_shares_free_width():
+    # Four flexible padding edges share 98 cells: 24.5 each, with the fractional
+    # part carried forward, so the shares are 24, 25, 24, 25.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    first_line = plain(tabs.render()).split("\n")[0]
+    assert first_line == " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("Home", "h"), Tab("Docs", "d"), Tab("Home again", "h")],
+        active_tab="h",
+        tab_padding=1,
+    )
+    first_line = plain(tabs.render()).split("\n")[0]
+    assert first_line == " Home again  Docs "
+    assert tabs._bar_position == 0.0
+
+
+def test_inactive_padded_span_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Home", tab_padding=1)
+    segments = segments_of(tabs.render())
+    docs = [segment for segment in segments if segment.text == " Docs "]
+    home = [segment for segment in segments if segment.text == " Home "]
+    assert len(docs) == 1 and len(home) == 1
+    assert isinstance(docs[0].style, Style)
+    assert docs[0].style.meta == {"@click": "range_clicked('Docs')"}
+    assert home[0].style.meta == {}
+    assert docs[0].style.color != home[0].style.color
