+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows two Tabs widgets."""
+
+    def on_mount(self):
+        """Mount the example Tabs widgets directly on the app."""
+        self.mount(
+            fruit=Tabs(
+                [Tab("Apple"), Tab("Banana"), Tab("Cherry"), Tab("Date")],
+                active_tab="Banana",
+            ),
+            numbers=Tabs(
+                [Tab("One", "1"), Tab("Two", "2"), Tab("Three", "3")],
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
