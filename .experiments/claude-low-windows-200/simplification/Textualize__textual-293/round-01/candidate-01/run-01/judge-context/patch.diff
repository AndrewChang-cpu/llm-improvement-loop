diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..a1ce218
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,432 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A single entry in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab when it is
+            selected. Defaults to the label when not given.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """Layout edge description for the shared layout resolver."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Return one Tab per distinct name, in the position of its first occurrence.
+
+    The label of each returned Tab comes from the last tab carrying that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list, possibly with duplicate names.
+
+    Returns:
+        list[Tab]: The displayed tabs.
+    """
+    order: List[str] = []
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        if tab.name not in labels:
+            order.append(tab.name)
+        labels[tab.name] = tab.label
+    return [Tab(label=labels[name], name=name) for name in order]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of the inactive tab labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding size in cells, or None (or zero)
+            to share the free width between padding edges.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        # Resolve every configured style before it is attached to any span
+        active_tab_style = console.get_style(self.active_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        displayed = _displayed_tabs(self.tabs)
+        label_widths = [cell_len(tab.label) for tab in displayed]
+
+        # A padding size of zero is treated as absent (auto-fit)
+        padding_size = self.tab_padding or None
+
+        # Each displayed tab contributes a left padding edge, a label edge (omitted
+        # when the label is empty, since a zero size would read as flexible), and a
+        # right padding edge.
+        edges: List[_Edge] = []
+        for label_width in label_widths:
+            edges.append(_Edge(size=padding_size))
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            edges.append(_Edge(size=padding_size))
+        sizes = iter(layout_resolve(width, edges))
+
+        cursor = 0
+        label_ranges: List[Tuple[int, int]] = []
+        click_ranges: Dict[str, Tuple[int, int]] = {}
+        for tab, label_width in zip(displayed, label_widths):
+            left = next(sizes)
+            if label_width:
+                next(sizes)
+            right = next(sizes)
+
+            label_start = cursor + left
+            label_end = label_start + label_width
+            span_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            # The selection range covers the whole padded span
+            click_ranges[tab.name] = (cursor, span_end)
+
+            # The padded span is one run of text, so padding shares the label style
+            piece = Text(
+                " " * left + tab.label + " " * right,
+                end="",
+                no_wrap=True,
+                overflow="crop",
+            )
+            if tab.name == self.active_tab_name:
+                piece.stylize(active_tab_style)
+                renderable: RenderableType = piece
+            else:
+                click_style = inactive_tab_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                piece.stylize(click_style)
+                renderable = Opacity(piece, opacity=self.inactive_text_opacity)
+            yield from console.render(renderable, options)
+            cursor = span_end
+
+        # Line break between the label row and the underline row
+        yield Segment("\n")
+
+        highlight_range: Tuple[float, float] = (0, 0)
+        if displayed:
+            count = len(displayed)
+            position = min(max(self.bar_position, 0.0), float(count - 1))
+            index = int(position)
+            fraction = position - index
+            next_index = (index + 1) % count
+            start_a, end_a = label_ranges[index]
+            start_b, end_b = label_ranges[next_index]
+            highlight_range = (
+                start_a + (start_b - start_a) * fraction,
+                end_a + (end_b - end_a) * fraction,
+            )
+
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=click_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline.
+    Tabs are selected by keyboard or mouse. A selection is identified by the tab
+    name, not by position.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults
+            to None, which selects the first tab. A value that matches no tab name
+            is kept, and the bar sits at index 0.
+        active_tab_style (StyleType): Style of the active tab label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of the inactive tab labels. Defaults
+            to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to None, which fits the padding to the available width. Zero is
+            treated as None.
+        search_by_first_character (bool): If True, pressing a character key selects
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if active_tab:
+            initial_name = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+
+        # Set the bar before the active name so the initial state does not animate
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Index of a tab name within the displayed tabs, or 0 when absent.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The index into the displayed tabs.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name in the full tab list.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed index of the new active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the new active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full list active, wrapping at the end."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full list active, wrapping at the start."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around the full list. It
+        compares case-insensitively and never selects the active tab. If nothing
+        matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A number above the tab count is ignored. The number 0 activates the 10th
+        tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The position to activate.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with the given name active. Used by clickable underline spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the Tabs widget has focus.
+
+        Key behavior:
+
+        - With no tabs, the event is marked handled and nothing else happens.
+        - Escape removes focus from the widget.
+        - Right and Left move to the next or previous tab, wrapping at either end.
+        - The digits 1 through 9 activate the tab at that 1-based position. The
+          digit 0 uses the rule of ``activate_tab_by_number``. Numbers above the
+          tab count are ignored.
+        - When ``search_by_first_character`` is True, other single-character keys
+          activate the next tab whose label starts with that character.
+
+        Every key event is marked handled by preventing its default action, and
+        propagation is not stopped, so application bindings still receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        """Build the renderable for the label row and the underline.
+
+        Returns:
+            RenderableType: A TabsRenderable for the current state.
+        """
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
