+from __future__ import annotations
+
+import io
+import re
+from typing import List, Optional
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual._layout_resolve import layout_resolve
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+class LayoutEdgeDouble:
+    def __init__(self, size: Optional[int] = None) -> None:
+        self.size = size
+        self.min_size = 1
+        self.fraction = 1
+
+
+def plain_lines(renderable) -> List[str]:
+    return ANSI_PATTERN.sub("", render(renderable)).split("\n")
+
+
+def tabs_renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home-tab").name == "home-tab"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("A") == Tab("A", "A")
+    assert Tab("A") != Tab("A", "b")
+    assert str(Tab("A", "b")) == "A"
+
+
+def test_tab_repr_shows_label_and_name():
+    text = repr(Tab("A", "b"))
+    assert "label='A'" in text
+    assert "name='b'" in text
+
+
+def test_construction_with_empty_list_succeeds():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_construction_with_tabs_succeeds():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+
+
+def test_initial_active_tab_given():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_occurrence():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="A")
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Banana")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_label_row_with_fixed_padding():
+    tabs = tabs_renderable([Tab("A"), Tab("BB")], "A", tab_padding=1)
+    assert plain_lines(tabs)[0] == " A  BB "
+
+
+def test_label_row_auto_fit_follows_layout_rule():
+    tabs = tabs_renderable([Tab("A"), Tab("BB")], "A")
+    # Edges: padding, label, padding for each tab, with padding flexible.
+    edges = [
+        LayoutEdgeDouble(None),
+        LayoutEdgeDouble(1),
+        LayoutEdgeDouble(None),
+        LayoutEdgeDouble(None),
+        LayoutEdgeDouble(2),
+        LayoutEdgeDouble(None),
+    ]
+    left, label_a, right_a, left_b, label_b, right_b = layout_resolve(100, edges)
+    expected = (
+        " " * left
+        + "A"
+        + " " * right_a
+        + " " * left_b
+        + "BB"
+        + " " * right_b
+    )
+    assert plain_lines(tabs)[0] == expected
+    assert len(expected) == 100
+    assert label_a == 1 and label_b == 2
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = tabs_renderable(
+        [Tab("Home", "a"), Tab("Files", "b"), Tab("Later", "a")],
+        "b",
+        bar_position=1.0,
+        tab_padding=1,
+    )
+    lines = plain_lines(tabs)
+    assert lines[0] == " Later  Files "
+    # The active tab is "b", at displayed index 1: its label starts at cell 8.
+    assert lines[1] == "━" * 7 + "╸" + "━" * 5 + "╺" + "━" * 86
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    lines = plain_lines(tabs_renderable([], None))
+    assert lines == ["", "━" * 100]
+
+
+def test_inactive_labels_are_dimmed_and_clickable_active_is_not():
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    renderable = tabs_renderable(
+        [Tab("Home"), Tab("Files")], "Home", tab_padding=1
+    )
+    segments = list(console.render(renderable, console.options))
+
+    home = [segment for segment in segments if "Home" in segment.text]
+    files = [segment for segment in segments if "Files" in segment.text]
+    assert len(home) == 1 and len(files) == 1
+
+    active_style = home[0].style
+    assert isinstance(active_style, Style)
+    assert "@click" not in active_style.meta
+
+    inactive_style = files[0].style
+    assert isinstance(inactive_style, Style)
+    assert inactive_style.meta == {"@click": "range_clicked('Files')"}
+    raw_color = Color.parse("#f0f0f0").triplet
+    assert inactive_style.color.triplet != raw_color
