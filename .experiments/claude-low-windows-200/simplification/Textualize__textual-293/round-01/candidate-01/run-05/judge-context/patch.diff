+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application demonstrating the Tabs widget."""
+
+    def on_mount(self):
+        """Mount Tabs widgets directly on the app."""
+        self.mount(
+            basic=Tabs(
+                [Tab("Home"), Tab("Files"), Tab("Settings"), Tab("Help")],
+            ),
+            named=Tabs(
+                [
+                    Tab("Overview", "overview"),
+                    Tab("Details", "details"),
+                    Tab("History", "history"),
+                ],
+                active_tab="details",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
