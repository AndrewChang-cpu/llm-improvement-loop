diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..7982b31
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,426 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _LayoutEdge:
+    """An edge description for ``layout_resolve``.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` if flexible.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _click_style(tab_name: str) -> Style:
+    """Build a style that carries the click action for a tab name."""
+    return Style.from_meta({"@click": f"range_clicked('{tab_name}')"})
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full list of tabs, including duplicate names.
+        active_tab_name (str, optional): The name of the active tab, if any.
+        bar_position (float): The fractional index into the full tab list that
+            places the underline.
+        active_tab_style (StyleType): The style of the active tab's label span.
+        active_bar_style (StyleType): The style of the highlighted underline.
+        inactive_tab_style (StyleType): The style of inactive label spans.
+        inactive_bar_style (StyleType): The style of the non-highlighted underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int, optional): The fixed padding size on each side of a label,
+            or ``None`` (or zero) to auto-fit the padding.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _displayed_tabs(self) -> List[Tuple[str, str]]:
+        """Return ``(name, label)`` pairs, one per distinct name.
+
+        Each name is placed at its first occurrence and carries the label of the
+        last tab with that name.
+        """
+        labels: Dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return list(labels.items())
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        # Resolve every style before any span or bar is built.
+        active_tab_style = console.get_style(self.active_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        width = options.max_width
+        displayed = self._displayed_tabs()
+
+        # Three edges per displayed tab: left padding, label, right padding.
+        # A zero or absent tab_padding makes the padding edges flexible.
+        padding_size = self.tab_padding or None
+        edges: List[_LayoutEdge] = []
+        for _name, label in displayed:
+            edges.append(_LayoutEdge(size=padding_size))
+            edges.append(_LayoutEdge(size=cell_len(label)))
+            edges.append(_LayoutEdge(size=padding_size))
+        sizes = layout_resolve(width, edges)
+
+        segments: List[Segment] = []
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_width = cell_len(label)
+            # Label range: the label text only, without padding.
+            label_start = cursor + left
+            label_ranges[name] = (label_start, label_start + label_width)
+            # Selection range: left padding, label, and right padding.
+            selection_end = cursor + left + label_size + right
+            selection_ranges[name] = (cursor, selection_end)
+
+            padded = (
+                " " * left + label + " " * (label_size - label_width) + " " * right
+            )
+            if name == self.active_tab_name:
+                # The active span is styled but carries no click action.
+                piece = Text(
+                    padded,
+                    style=active_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                segments.extend(console.render(piece, options))
+            else:
+                # Inactive spans carry the click action and are dimmed.
+                piece = Text(
+                    padded,
+                    style=inactive_tab_style + _click_style(name),
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                segments.extend(
+                    console.render(
+                        Opacity(piece, opacity=self.inactive_text_opacity), options
+                    )
+                )
+            cursor = selection_end
+
+        # Separate the label row from the underline row.
+        segments.append(Segment.line())
+
+        highlight_range = self._highlight_range(displayed, label_ranges)
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield from segments
+        yield bar
+
+    def _highlight_range(
+        self,
+        displayed: List[Tuple[str, str]],
+        label_ranges: Dict[str, Tuple[int, int]],
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        The bar position indexes the full tab list. Each index maps to the label range
+        of the displayed tab carrying that name, and the next index wraps at the end.
+        """
+        tab_count = len(self.tabs)
+        if not displayed or tab_count == 0:
+            return (0, 0)
+        floor_index = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_index
+        current_name = self.tabs[floor_index % tab_count].name
+        next_name = self.tabs[(floor_index + 1) % tab_count].name
+        current_start, current_end = label_ranges[current_name]
+        next_start, next_end = label_ranges[next_name]
+        start = current_start + fraction * (next_start - current_start)
+        end = current_end + fraction * (next_end - current_end)
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline. A
+    tab is selected with the keyboard or by clicking its label or underline.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab's name when tabs are given.
+        active_tab_style (StyleType): The style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted underline. Defaults
+            to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the non-highlighted underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels, where
+            ``0`` makes them match their background and ``1`` leaves them unchanged.
+            Defaults to ``0.5``.
+        animation_duration (float): The duration in seconds of the underline animation.
+            Defaults to ``0.3``.
+        animation_function (str): The name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            Defaults to ``None``, which auto-fits the padding to the widget width. A
+            value of zero is treated as ``None``.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self._tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self._tabs:
+            initial_name = self._tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline bar to the position of the new active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        Right and left move to the next or previous tab, wrapping at either end.
+        Keys ``1`` through ``9`` activate the tab at that position, and ``0`` uses the
+        same rule as ``activate_tab_by_number``. When ``search_by_first_character`` is
+        true, another single-character key activates the next tab whose label starts
+        with that character. Escape removes focus from the widget. Every key event is
+        marked as handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self._tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The tab name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has that name.
+        """
+        for index, tab in enumerate(self._tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab active, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self._tabs)
+        self._active_tab_name = self._tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab active, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self._tabs)
+        self._active_tab_name = self._tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It is case-insensitive and
+        never selects the active tab. With no match, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        active_name = self._active_tab_name
+        tab_count = len(self._tabs)
+        start = self.find_tab_by_name(active_name)
+        needle = char.lower()
+        for offset in range(1, tab_count + 1):
+            tab = self._tabs[(start + offset) % tab_count]
+            if tab.name == active_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        A number above the tab count is ignored. Zero activates the 10th tab when there
+        are at least ten tabs, and otherwise the last tab. Any other number activates
+        the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0 for the rule above.
+        """
+        tab_count = len(self._tabs)
+        if tab_number > tab_count:
+            return
+        if tab_number == 0:
+            index = 9 if tab_count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self._tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with the given name active.
+
+        This is the action attached to clickable label and underline spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
