+
+def _console_and_options():
+    console = Console(file=io.StringIO(), width=100, color_system="truecolor")
+    return console, console.options
+
+
+def _first_item(bar):
+    console, options = _console_and_options()
+    return next(iter(bar.__rich_console__(console, options)))
+
+
+def _click_meta(style):
+    assert isinstance(style, Style)
+    return style.meta.get("@click")
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"Home": (0, 2), "Work": (2, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    home_span, work_span = item.spans[-2:]
+    assert (home_span.start, home_span.end) == (0, 2)
+    assert _click_meta(home_span.style) == "range_clicked('Home')"
+    assert (work_span.start, work_span.end) == (2, 6)
+    assert _click_meta(work_span.style) == "range_clicked('Work')"
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    clickable = {"Home": (0, 2)}
+    cases = [
+        UnderlineBar(width=6, clickable_ranges=clickable),
+        UnderlineBar(highlight_range=(4, 2), width=6, clickable_ranges=clickable),
+    ]
+    for bar in cases:
+        item = _first_item(bar)
+        assert isinstance(item, Text)
+        assert item.plain == "━" * 6
+        for span in item.spans:
+            assert _click_meta(span.style) is None
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        width=6,
+        clickable_ranges={"Work": (2, 4)},
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━━╸╺━━"
+    work_span = item.spans[-1]
+    assert (work_span.start, work_span.end) == (2, 4)
+    assert _click_meta(work_span.style) == "range_clicked('Work')"
