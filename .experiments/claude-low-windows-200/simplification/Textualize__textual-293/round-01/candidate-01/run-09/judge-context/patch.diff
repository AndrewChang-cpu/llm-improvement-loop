index 0000000..2215072
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,430 @@
+from __future__ import annotations
+
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A single tab item for the `Tabs` widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab when selecting it.
+            Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """Edge description consumed by the shared layout resolver.
+
+    Args:
+        size (int, optional): Fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): Minimum size in cells for a flexible edge. Defaults to 1.
+        fraction (int): Share of the remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Return one tab per distinct name, placed at the first occurrence of the name.
+
+    The returned tab for each name is the last tab that carries that name, so its
+    label is the one shown.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs in order.
+    """
+    positions: dict[str, int] = {}
+    displayed: list[Tab] = []
+    for tab in tabs:
+        if tab.name in positions:
+            displayed[positions[tab.name]] = tab
+        else:
+            positions[tab.name] = len(displayed)
+            displayed.append(tab)
+    return displayed
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a `Tabs` widget.
+
+    The label row is laid out with the shared layout resolver. Each displayed tab
+    contributes a left padding edge, a label edge, and a right padding edge.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str, optional): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the full tab list that places
+            the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the non-highlighted bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding size in cells, or ``None`` or zero
+            to fit padding automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding and self.tab_padding > 0:
+            return _Edge(size=self.tab_padding)
+        return _Edge()
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Lay out the padding and label edges of each displayed tab in one pass
+        # so that flexible padding shares the remaining width.
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(self._padding_edge())
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        # Resolve every style against the console before attaching it to any span.
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_segments: list[Segment] = []
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        x = 0
+        for index, tab in enumerate(displayed):
+            left = sizes[3 * index]
+            right = sizes[3 * index + 2]
+            label_width = cell_len(tab.label)
+            label_ranges[tab.name] = (x + left, x + left + label_width)
+            span_end = x + left + label_width + right
+            selection_ranges[tab.name] = (x, span_end)
+
+            padded = " " * left + tab.label + " " * right
+            is_active = tab.name == self.active_tab_name
+            if is_active:
+                # The active tab carries no click action.
+                piece = Text(
+                    padded,
+                    style=active_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+                label_segments.extend(console.render(piece, options))
+            else:
+                piece = Text(
+                    padded,
+                    style=inactive_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+                piece.apply_meta({"@click": f"range_clicked('{tab.name}')"})
+                dimmed = Opacity(piece, opacity=self.inactive_text_opacity)
+                label_segments.extend(console.render(dimmed, options))
+            x = span_end
+
+        # The bar position is an index into the full tab list. Each full-list index
+        # maps to its displayed tab through the name, so duplicate names resolve to
+        # the displayed tab that carries the name.
+        count = len(self.tabs)
+        if count == 0:
+            highlight_range = (0.0, 0.0)
+        else:
+            position = min(max(self.bar_position, 0.0), float(count - 1))
+            floor_index = int(position)
+            fraction = position - floor_index
+            next_index = (floor_index + 1) % count
+            start_a, end_a = label_ranges[self.tabs[floor_index].name]
+            start_b, end_b = label_ranges[self.tabs[next_index].name]
+            highlight_range = (
+                start_a + (start_b - start_a) * fraction,
+                end_a + (end_b - end_a) * fraction,
+            )
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield from label_segments
+        yield Segment.line()
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row holds the tab labels and the second row holds the underline. A user
+    selects a tab with the keyboard or the mouse.
+
+    Args:
+        tabs (list[Tab]): The ordered list of tabs. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. A name that matches no tab is kept as given.
+        active_tab_style (StyleType): Style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the non-highlighted underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels,
+            where 1.0 is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed padding in cells on each side of a label.
+            Defaults to ``None``, which fits padding automatically to the width. Zero
+            is treated as absent.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if tabs:
+            active_name: str | None = active_tab or tabs[0].name
+        else:
+            active_name = None
+        # Set the bar position directly so the initial state is not animated.
+        self._bar_position = float(self.find_tab_by_name(active_name))
+        self._active_tab_name = active_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        index = self.find_tab_by_name(active_tab_name)
+        self.animate(
+            "_bar_position",
+            float(index),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab in the full list with that name, or 0 if
+                no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around the full list. It
+        compares case-insensitively and never selects the active tab. If no tab
+        matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        A number above the tab count is ignored. Zero activates the 10th tab when there
+        are at least ten tabs, and otherwise the last tab. Any other number activates
+        the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based position, or 0 for the number-zero rule.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Dispatched from clicks on a tab's range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation of the tabs.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - The digit keys 0 through 9 activate a tab by position, following
+          `activate_tab_by_number`.
+        - Any other single character activates the next tab whose label starts with
+          it, when ``search_by_first_character`` is true.
+
+        Every key event is marked handled by preventing its default action. Propagation
+        is not stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
