@@ -0,0 +1,236 @@
+import io
+
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+INACTIVE_STYLE = "#f0f0f0 on #021720"
+ACTIVE_BAR_STYLE = "#1BB152"
+
+
+def _console(width=20):
+    return Console(file=io.StringIO(), width=width, color_system="truecolor")
+
+
+def _segments(tabs, width=20):
+    console = _console(width)
+    return list(console.render(tabs.render(), console.options))
+
+
+def _rows(segments):
+    """Split rendered segments into rows at the line-break segments."""
+    rows = [[]]
+    for segment in segments:
+        if segment.text == "\n":
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    return rows
+
+
+def _plain(segments):
+    return "".join(segment.text for segment in segments)
+
+
+def _meta(style):
+    assert isinstance(style, Style)
+    return style.meta
+
+
+def _click_by_column(segments):
+    clicks = []
+    for segment in segments:
+        click = _meta(segment.style).get("@click")
+        clicks.extend([click] * len(segment.text))
+    return clicks
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_text_form_is_label():
+    assert str(Tab("Home", "h")) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("A") == Tab("A", "A")
+    assert Tab("A") != Tab("A", "x")
+    assert Tab("A") != Tab("B")
+
+
+def test_tab_repr_shows_label_and_name():
+    representation = repr(Tab("Home", "h"))
+    assert "'Home'" in representation
+    assert "'h'" in representation
+
+
+def test_construction_succeeds_with_empty_and_non_empty_tab_lists():
+    Tabs([])
+    Tabs([Tab("Home"), Tab("Work")])
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Work")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("Home"), Tab("Work")], active_tab="Work")
+    assert tabs._active_tab_name == "Work"
+    assert tabs._bar_position == 1.0
+
+
+def test_empty_active_tab_falls_back_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Work")], active_tab="")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Work")], active_tab="nope")
+    assert tabs._active_tab_name == "nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("Home"), Tab("Work"), Tab("Cherry")])
+    tabs.action_range_clicked("Cherry")
+    assert tabs._active_tab_name == "Cherry"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_width_underline():
+    rows = _rows(_segments(Tabs([]), width=20))
+    assert _plain(rows[0]) == ""
+    assert _plain(rows[1]) == "━" * 20
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Work")], tab_padding=1)
+    rows = _rows(_segments(tabs, width=20))
+    assert _plain(rows[0]) == " Home  Work "
+
+
+def test_label_row_auto_fit_shares_flexible_padding():
+    # Width 20 minus the label cells (1 + 2) leaves 17 cells for four flexible
+    # padding edges. Each gets 4.25 cells; the carried remainder makes the sizes
+    # 4, 4, 4, and 5 in order.
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    rows = _rows(_segments(tabs, width=20))
+    assert _plain(rows[0]) == "    A" + " " * 8 + "BB" + " " * 5
+
+
+def test_duplicate_names_display_once_with_last_label_at_first_position():
+    tabs = Tabs(
+        [Tab("Alpha", "x"), Tab("Beta", "b"), Tab("Gamma", "x")],
+        active_tab="b",
+        tab_padding=1,
+    )
+    rows = _rows(_segments(tabs, width=20))
+    assert _plain(rows[0]) == " Gamma  Beta "
+
+
+def test_inactive_label_carries_click_action_and_is_dimmed():
+    console = _console(width=20)
+    tabs = Tabs([Tab("Home"), Tab("Work")], tab_padding=1)
+    segments = list(console.render(tabs.render(), console.options))
+    rows = _rows(segments)
+
+    work_segments = [s for s in rows[0] if s.text == " Work "]
+    assert len(work_segments) == 1
+    work_style = work_segments[0].style
+    assert _meta(work_style) == {"@click": "range_clicked('Work')"}
+    base_color = console.get_style(INACTIVE_STYLE).color
+    assert work_style.color != base_color
+
+
+def test_active_label_has_no_click_action_and_keeps_active_style():
+    console = _console(width=20)
+    tabs = Tabs([Tab("Home"), Tab("Work")], tab_padding=1)
+    rows = _rows(list(console.render(tabs.render(), console.options)))
+
+    home_segments = [s for s in rows[0] if s.text == " Home "]
+    assert len(home_segments) == 1
+    home_style = home_segments[0].style
+    assert "@click" not in _meta(home_style)
+    assert home_style.color == console.get_style(INACTIVE_STYLE).color
+
+
+def test_underline_cells_carry_click_action_for_every_displayed_tab():
+    tabs = Tabs([Tab("Home"), Tab("Work")], tab_padding=1)
+    rows = _rows(_segments(tabs, width=20))
+    clicks = _click_by_column(rows[1])
+    assert len(clicks) == 20
+    assert clicks[0:6] == ["range_clicked('Home')"] * 6
+    assert clicks[6:12] == ["range_clicked('Work')"] * 6
+    assert clicks[12:] == [None] * 8
+
+
+def test_underline_highlights_active_label_with_half_cell_edges():
+    # The active label " Home " spans columns 1 through 4, so the highlight covers
+    # those label cells, with half-cell glyphs on the background edges.
+    tabs = Tabs([Tab("Home"), Tab("Work")], tab_padding=1)
+    rows = _rows(_segments(tabs, width=20))
+    assert _plain(rows[1]) == "╸" + "━" * 4 + "╺" + "━" * 14
