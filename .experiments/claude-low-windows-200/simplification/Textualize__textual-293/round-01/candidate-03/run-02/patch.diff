+
+
+def test_bar_yields_single_text_object():
+    item = _first_item(UnderlineBar(highlight_range=(2, 4), width=6))
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+
+
+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (3, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    first, second = item.spans[-2], item.spans[-1]
+    assert isinstance(first.style, Style)
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": "range_clicked('one')"}
+    assert isinstance(second.style, Style)
+    assert (second.start, second.end) == (3, 6)
+    assert second.style.meta == {"@click": "range_clicked('two')"}
+
+
+@pytest.mark.parametrize(
+    "bar",
+    [
+        UnderlineBar(width=6),
+        UnderlineBar(highlight_range=(0, 0), width=6, clickable_ranges={"one": (0, 2)}),
+        UnderlineBar(highlight_range=(3, 1), width=6, clickable_ranges={"one": (0, 2)}),
+        UnderlineBar(highlight_range=(-3, -1), width=6),
+    ],
+)
+def test_zero_width_early_path_has_no_click_metadata(bar):
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    for span in item.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_gets_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3), clickable_ranges={"one": (2, 4)}, width=6
+    )
+    item = _first_item(bar)
+    last = item.spans[-1]
+    assert isinstance(last.style, Style)
+    assert (last.start, last.end) == (2, 4)
+    assert last.style.meta == {"@click": "range_clicked('one')"}
