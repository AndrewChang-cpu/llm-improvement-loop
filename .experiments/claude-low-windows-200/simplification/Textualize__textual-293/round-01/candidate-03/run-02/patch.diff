@@ -0,0 +1,198 @@
+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _renderable(tabs, active=None, bar_position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def _rows(renderable):
+    """Plain-text rows of the rendered widget: label row, then underline row."""
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def _segments(renderable):
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("A", "x") == Tab("A", "x")
+    assert Tab("A", "x") != Tab("A", "y")
+    assert Tab("A", "x") != Tab("B", "x")
+
+
+def test_tab_repr_shows_label_and_name():
+    assert repr(Tab("A", "x")) == "Tab(label='A', name='x')"
+
+
+def test_label_row_and_underline_row_are_separate():
+    rows = _rows(_renderable([Tab("One"), Tab("Two")], active="One"))
+    assert len(rows) == 2
+    assert rows[0].rstrip() == " One  Two"
+    assert rows[1].startswith("━")
+
+
+def test_auto_fit_label_row_shares_flexible_edges():
+    # Widths 3 + 3 fixed; the remaining 94 cells split over four padding edges as
+    # 23.5 each, so the whole-cell parts are 23, 24, 23, 24.
+    renderable = _renderable([Tab("One"), Tab("Two")], active="One", tab_padding=None)
+    rows = _rows(renderable)
+    expected = " " * 23 + "One" + " " * 47 + "Two"
+    assert rows[0].rstrip() == expected
+
+
+def test_zero_tab_padding_matches_auto_fit():
+    auto = _renderable([Tab("One"), Tab("Two")], active="One", tab_padding=None)
+    zero = _renderable([Tab("One"), Tab("Two")], active="One", tab_padding=0)
+    assert _rows(zero) == _rows(auto)
+
+
+def test_no_tabs_gives_empty_label_row_and_inactive_underline():
+    rows = _rows(_renderable([], active=None, tab_padding=None))
+    assert rows == ["", "━" * 100]
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("A1", "a"), Tab("B", "b"), Tab("A2", "a")]
+    rows = _rows(_renderable(tabs, active="a"))
+    assert rows[0].rstrip() == " A2  B"
+    # The active highlight sits under the first displayed tab, whose label is A2.
+    assert rows[1].startswith("╸━━╺")
+
+
+def test_inactive_padded_span_has_click_action_and_resolved_style():
+    segments = _segments(_renderable([Tab("One"), Tab("Two")], active="One"))
+    inactive = [segment for segment in segments if segment.text == " Two "]
+    assert len(inactive) == 1
+    assert isinstance(inactive[0].style, Style)
+    assert inactive[0].style.meta == {"@click": "range_clicked('Two')"}
+
+
+def test_active_padded_span_has_no_click_action():
+    segments = _segments(_renderable([Tab("One"), Tab("Two")], active="One"))
+    active = [segment for segment in segments if segment.text == " One "]
+    assert len(active) == 1
+    assert isinstance(active[0].style, Style)
+    assert "@click" not in active[0].style.meta
+
+
+def test_underline_bar_carries_selection_ranges_for_every_tab():
+    renderable = _renderable([Tab("One"), Tab("Two")], active="One", tab_padding=1)
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    bar = list(renderable.__rich_console__(console, console.options))[-1]
+    assert isinstance(bar, UnderlineBar)
+    assert bar.clickable_ranges == {"One": (0, 5), "Two": (5, 10)}
+    item = next(iter(bar.__rich_console__(console, console.options)))
+    assert isinstance(item, Text)
+    first, second = item.spans[-2], item.spans[-1]
+    assert (first.start, first.end) == (0, 5)
+    assert first.style.meta == {"@click": "range_clicked('One')"}
+    assert (second.start, second.end) == (5, 10)
+    assert second.style.meta == {"@click": "range_clicked('Two')"}
+
+
+def test_constructing_tabs_with_default_styles_succeeds():
+    assert Tabs([]).tabs == []
+    assert Tabs([Tab("A")]).tabs[0].name == "A"
+
+
+def test_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_tab_number_zero_selects_last_tab_when_fewer_than_ten():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 4)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+
+
+def test_tab_number_zero_selects_tenth_tab_when_ten_or_more():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_tab_number_selects_by_one_based_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_tab_number_above_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "A"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_other_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_find_tab_by_name_returns_first_index_or_zero():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_range_clicked_action_activates_named_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
