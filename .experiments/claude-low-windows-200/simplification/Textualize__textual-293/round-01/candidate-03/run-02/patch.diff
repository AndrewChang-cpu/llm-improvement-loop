diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..c30af1e
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,443 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, NamedTuple, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = name or label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan(NamedTuple):
+    """Column geometry of one displayed tab."""
+
+    name: str
+    label: str
+    pad_left: int
+    pad_right: int
+    selection_start: int
+    label_start: int
+    label_end: int
+    selection_end: int
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> List[Tuple[str, str]]:
+    """Collapse tabs to one entry per name.
+
+    Each name keeps the position of its first occurrence and the label of its last
+    occurrence.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        List[Tuple[str, str]]: ``(name, label)`` pairs in display order.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return list(labels.items())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of the inactive tabs' labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding on each side of a label, or ``None``
+            (or zero) to share the remaining width.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout_spans(self, width: int) -> List[_TabSpan]:
+        """Compute the column geometry of every displayed tab.
+
+        Args:
+            width (int): The width available to the label row.
+
+        Returns:
+            List[_TabSpan]: One entry per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        padding = self.tab_padding or None
+        edges: List[_Edge] = []
+        for _name, label in displayed:
+            edges.append(_Edge(size=padding))
+            edges.append(_Edge(size=cell_len(label)))
+            edges.append(_Edge(size=padding))
+
+        sizes = layout_resolve(width, edges)
+
+        spans: List[_TabSpan] = []
+        position = 0
+        for index, (name, label) in enumerate(displayed):
+            pad_left, label_width, pad_right = sizes[index * 3 : index * 3 + 3]
+            selection_start = position
+            label_start = selection_start + pad_left
+            label_end = label_start + label_width
+            selection_end = label_end + pad_right
+            spans.append(
+                _TabSpan(
+                    name=name,
+                    label=label,
+                    pad_left=pad_left,
+                    pad_right=pad_right,
+                    selection_start=selection_start,
+                    label_start=label_start,
+                    label_end=label_end,
+                    selection_end=selection_end,
+                )
+            )
+            position = selection_end
+        return spans
+
+    @staticmethod
+    def _highlight_range(
+        spans: Sequence[_TabSpan], bar_position: float
+    ) -> Tuple[float, float]:
+        """Interpolate the highlighted label range for a bar position.
+
+        Args:
+            spans (Sequence[_TabSpan]): The displayed tabs' geometry.
+            bar_position (float): Fractional index into the displayed tabs.
+
+        Returns:
+            Tuple[float, float]: The ``(start, end)`` columns of the highlight.
+        """
+        if not spans:
+            return (0, 0)
+        last = len(spans) - 1
+        position = min(max(bar_position, 0.0), float(last))
+        index = min(int(math.floor(position)), last)
+        fraction = position - index
+        current = spans[index]
+        following = spans[(index + 1) % len(spans)]
+        start = current.label_start + fraction * (
+            following.label_start - current.label_start
+        )
+        end = current.label_end + fraction * (following.label_end - current.label_end)
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        spans = self._layout_spans(width)
+
+        for span in spans:
+            padded = " " * span.pad_left + span.label + " " * span.pad_right
+            if span.name == self.active_tab_name:
+                yield Segment(padded, active_tab_style)
+            else:
+                click_style = inactive_tab_style + Style(
+                    meta={"@click": f"range_clicked('{span.name}')"}
+                )
+                label_text = Text(padded, end="", no_wrap=True)
+                label_text.stylize(click_style)
+                yield from console.render(
+                    Opacity(label_text, opacity=self.inactive_text_opacity), options
+                )
+
+        yield Segment.line()
+
+        clickable_ranges = {
+            span.name: (span.selection_start, span.selection_end) for span in spans
+        }
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans, self.bar_position),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected with the keyboard or by clicking them. Tabs are identified by
+    name, and tabs that share a name are displayed once.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str | None, optional): The name of the initially active tab. If
+            not given, or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of the inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline
+            bar. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to the inactive
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration in seconds of the underline
+            animation. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): Fixed number of cells on each side of a
+            label, or ``None`` to fit the labels across the width. Zero is treated the
+            same as ``None``. Defaults to None.
+        search_by_first_character (bool, optional): Whether pressing a key that is not
+            a digit activates the next tab whose label starts with that character.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+
+        self.tabs: List[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index, or 0 when the name is not displayed.
+        """
+        names = [name for name, _label in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline bar to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and never selects the
+        active tab. The comparison ignores case. If no other tab matches, the active
+        tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        Numbers greater than the tab count are ignored. Zero selects the tenth tab when
+        there are at least ten tabs, and the last tab otherwise. Other numbers select
+        the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0 for the rule above.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        Right and left activate the next and previous tab, wrapping at either end.
+        The digit keys 0 through 9 activate a tab by position, using the rule of
+        ``activate_tab_by_number``. Other single characters activate the next tab
+        whose label starts with that character, when ``search_by_first_character``
+        is true. Escape removes focus from the widget. Every key event is marked
+        handled, and propagation continues to other handlers.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Called when a tab is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
