+import io
+import re
+
+from rich.console import Console
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.renderables.opacity import Opacity
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+WIDTH = 100
+
+
+def plain_lines(renderable):
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def row_items(tabs_widget, console_width=40):
+    console = Console(width=console_width, file=io.StringIO())
+    renderable = tabs_widget.render()
+    return list(renderable.__rich_console__(console, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home", "home") == Tab("Home", "home")
+    assert Tab("Home", "home") != Tab("Home", "other")
+    assert Tab("Home") != Tab("Settings")
+
+
+def test_construct_with_default_styles_and_empty_list():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_construct_with_tabs_uses_first_tab_as_active():
+    tabs = Tabs([Tab("One", "one"), Tab("Two", "two")])
+    assert tabs._active_tab_name == "one"
+
+
+def test_active_tab_argument_selects_named_tab():
+    tabs = Tabs([Tab("One", "one"), Tab("Two", "two")], active_tab="two")
+    assert tabs._active_tab_name == "two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One", "one"), Tab("Two", "two")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("nope") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_small_list():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{i}", f"t{i}") for i in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Apple", "apple"), Tab("Avocado", "avocado"), Tab("banana", "banana")]
+    )
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple", "apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple", "apple"), Tab("Banana", "banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs(
+        [Tab("Home", "home"), Tab("Settings", "settings")], tab_padding=1
+    )
+    lines = plain_lines(tabs.render())
+    assert lines[0].rstrip() == " Home  Settings"
+    assert len(lines[0]) == WIDTH
+
+
+def test_underline_highlights_active_span():
+    tabs = Tabs([Tab("Home", "home"), Tab("Settings", "settings")], tab_padding=1)
+    underline = plain_lines(tabs.render())[1]
+    assert underline[0] == "╸"
+    assert underline[1:5] == "━━━━"
+    assert underline[5] == "╺"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("Old", "a"), Tab("B", "b"), Tab("New", "a")], tab_padding=1
+    )
+    lines = plain_lines(tabs.render())
+    assert lines[0].rstrip() == " New  B"
+    assert lines[1][1:4] == "━━━"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    lines = plain_lines(Tabs([]).render())
+    assert lines[0].strip() == ""
+    assert lines[1] == "━" * WIDTH
+
+
+def test_inactive_spans_carry_click_action_and_are_dimmed():
+    tabs = Tabs(
+        [Tab("Home", "home"), Tab("Settings", "settings")], tab_padding=1
+    )
+    items = row_items(tabs)
+    dimmed = [item for item in items if isinstance(item, Opacity)]
+    assert len(dimmed) == 1
+    assert dimmed[0].opacity == 0.5
+    inactive_text = dimmed[0].renderable
+    assert isinstance(inactive_text, Text)
+    assert inactive_text.plain == " Settings "
+    for span in inactive_text.spans:
+        assert span.style.meta.get("@click") == "range_clicked('settings')"
+
+
+def test_active_label_has_no_click_action():
+    tabs = Tabs(
+        [Tab("Home", "home"), Tab("Settings", "settings")], tab_padding=1
+    )
+    items = row_items(tabs)
+    active_text = next(item for item in items if isinstance(item, Text))
+    assert active_text.plain == " Home "
+    for span in active_text.spans:
+        assert "@click" not in span.style.meta
