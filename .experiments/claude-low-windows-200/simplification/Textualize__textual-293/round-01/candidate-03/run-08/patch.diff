+    assert item.plain == "━╸━━╺━"
+    one, two = item.spans[-2], item.spans[-1]
+    assert (one.start, one.end) == (0, 2)
+    assert click_meta(one) == "range_clicked('one')"
+    assert (two.start, two.end) == (2, 6)
+    assert click_meta(two) == "range_clicked('two')"
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (3, 1), (-5, -2)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"one": (0, 3)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    for span in item.spans:
+        assert click_meta(span) is None
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"one": (0, 3)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    assert any(click_meta(span) == "range_clicked('one')" for span in item.spans)
+
+
+def test_fractional_edges_use_half_cell_glyphs():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    item = first_item(bar)
+    assert item.plain == "━╸━━╺━"
