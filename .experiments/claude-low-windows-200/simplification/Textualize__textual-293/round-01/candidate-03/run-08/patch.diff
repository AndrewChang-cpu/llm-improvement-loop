diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..720fecf
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,432 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+import rich.repr
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+@rich.repr.auto
+class Tab:
+    """A tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """A layout edge for the label row, consumed by ``layout_resolve``."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Collapse tabs to one displayed tab per distinct name.
+
+    Each name keeps the position of its first occurrence and the label of its last
+    occurrence.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: One tab per distinct name, in display order.
+    """
+    labels = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+def _label_piece(text: str, style: Style) -> Text:
+    """Build a single run of text with a resolved style that is cropped, not wrapped.
+
+    Args:
+        text (str): The text of the run.
+        style (Style): The resolved style of the run.
+
+    Returns:
+        Text: A text object containing one styled span.
+    """
+    piece = Text(end="", no_wrap=True, overflow="crop")
+    piece.append(text, style=style)
+    return piece
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): Fractional index into the displayed tabs for the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab spans.
+        tab_padding (int | None): Fixed padding cells per side, or None for auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Three edges per displayed tab: left padding, label, right padding.
+        padding = self.tab_padding or None
+        edges = []
+        for tab in displayed:
+            edges.append(_TabEdge(size=padding))
+            edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(_TabEdge(size=padding))
+        sizes = layout_resolve(width, edges)
+
+        label_ranges = {}
+        selection_ranges = {}
+        pieces = []  # (renderable, dimmed) pairs in display order
+        x = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[3 * index : 3 * index + 3]
+            label_start = x + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (x, selection_end)
+            x = selection_end
+
+            # Pad the label to its resolved cell width so the padded span's cells match
+            # the computed ranges, even when the label was sized to the minimum.
+            label_text = tab.label + " " * (label_size - cell_len(tab.label))
+            padded = " " * left + label_text + " " * right
+
+            if tab.name == self.active_tab_name:
+                style = console.get_style(self.active_tab_style)
+                pieces.append((_label_piece(padded, style), False))
+            else:
+                style = console.get_style(self.inactive_tab_style) + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                pieces.append((_label_piece(padded, style), True))
+
+        if x < width:
+            pieces.append((_label_piece(" " * (width - x), Style()), False))
+
+        for piece, dimmed in pieces:
+            if dimmed:
+                yield Opacity(piece, self.inactive_text_opacity)
+            else:
+                yield piece
+        yield Segment("\n")
+
+        highlight_range = self._highlight_range(displayed, label_ranges)
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _highlight_range(
+        self,
+        displayed: list[Tab],
+        label_ranges: dict[str, tuple[int, int]],
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            displayed (list[Tab]): The displayed tabs.
+            label_ranges (dict[str, tuple[int, int]]): Label range keyed by name.
+
+        Returns:
+            tuple[float, float]: The highlight range, or ``(0, 0)`` with no tabs.
+        """
+        count = len(displayed)
+        if not count:
+            return (0, 0)
+        floor = math.floor(self.bar_position)
+        fraction = self.bar_position - floor
+        index = floor % count
+        next_index = (index + 1) % count
+        start, end = label_ranges[displayed[index].name]
+        next_start, next_end = label_ranges[displayed[next_index].name]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by keyboard or mouse. The active tab is identified by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab's name. An unknown name is accepted and the underline sits at
+            the first position.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels, where
+            1.0 is fully visible. Defaults to ``0.5``.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to ``0.3``.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of padding cells on each side of a
+            label. Defaults to ``None``, which auto-fits the padding to the width.
+        search_by_first_character (bool): Whether pressing a character key activates the
+            next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+
+        # Set the bar position before the active tab so the initial placement is
+        # immediate rather than animated.
+        self._bar_position = float(self._bar_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._bar_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget receives them.
+
+        With no tabs, the key is consumed and nothing else happens. Otherwise:
+
+        - Escape removes focus from the widget by awaiting ``app.set_focus(None)``.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - The digits 1 through 9 activate the tab at that 1-based position. The digit 0
+          follows the rule of ``activate_tab_by_number``. Digits larger than the tab
+          count are ignored.
+        - Any other single character activates the next tab, after the active one and
+          wrapping, whose label starts with that character, ignoring case. The active
+          tab is never selected by this search. The search is skipped when
+          ``search_by_first_character`` is false.
+
+        Every key event is marked handled by preventing its default action. Propagation
+        is not stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if self.tabs:
+            key = event.key
+            if key == Keys.Escape:
+                await self.app.set_focus(None)
+            elif key == Keys.Right:
+                self.activate_next_tab()
+            elif key == Keys.Left:
+                self.activate_previous_tab()
+            elif len(key) == 1 and key in DIGITS:
+                self.activate_tab_by_number(int(key))
+            elif self.search_by_first_character and len(key) == 1:
+                self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and never selects the
+        active tab. The comparison ignores case. If no other tab matches, the active
+        tab is unchanged.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        A number greater than the tab count is ignored. The number 0 activates the 10th
+        tab when there are at least ten tabs, and the last tab otherwise. Any other
+        number activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The tab name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used by clickable label spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def _bar_index(self, tab_name: str | None) -> int:
+        """Index of a tab name among the displayed tabs, or 0 when not displayed.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The index into the displayed tabs.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
