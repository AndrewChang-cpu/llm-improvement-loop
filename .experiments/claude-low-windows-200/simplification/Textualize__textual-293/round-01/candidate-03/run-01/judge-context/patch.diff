diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..fa89956
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,344 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared resolver: fixed when ``size`` is set."""
+
+    def __init__(self, size: int | None = None, min_size: int = 1) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = 1
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Tabs): The widget whose state is rendered.
+    """
+
+    def __init__(self, tabs: Tabs) -> None:
+        self.tabs = tabs
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        tabs = self.tabs
+        width = options.max_width
+
+        # One entry per distinct name, at its first position, carrying the label
+        # of the last tab with that name.
+        displayed = list({tab.name: tab for tab in tabs.tabs}.values())
+
+        padding = tabs.tab_padding
+        fixed_padding = padding if padding is not None and padding > 0 else None
+
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=fixed_padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=fixed_padding))
+        sizes = layout_resolve(width, edges)
+
+        active_name = tabs._active_tab_name
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        label_renderables: list[RenderableType] = []
+
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (cursor, span_end)
+            cursor = span_end
+
+            label_padding = label_size - cell_len(tab.label)
+            content = (
+                " " * left + tab.label + " " * label_padding + " " * right
+            )
+            is_active = tab.name == active_name
+            tab_style = (
+                tabs.active_tab_style if is_active else tabs.inactive_tab_style
+            )
+            text = Text(
+                content,
+                style=console.get_style(tab_style),
+                end="",
+                no_wrap=True,
+                overflow="ignore",
+            )
+            if is_active:
+                # The active label carries no click action.
+                label_renderables.append(text)
+            else:
+                text.apply_meta({"@click": f"range_clicked('{tab.name}')"})
+                label_renderables.append(
+                    Opacity(text, opacity=tabs.inactive_text_opacity)
+                )
+
+        yield from label_renderables
+        yield Segment.line()
+
+        # Locate the highlight by interpolating between the label ranges of the
+        # tab at the floor index and the next tab, wrapping at the end.
+        count = len(displayed)
+        if count:
+            position = tabs._bar_position
+            floor_position = math.floor(position)
+            index = floor_position % count
+            fraction = position - floor_position
+            next_index = (index + 1) % count
+            start_a, end_a = label_ranges[displayed[index].name]
+            start_b, end_b = label_ranges[displayed[next_index].name]
+            highlight = (
+                start_a + (start_b - start_a) * fraction,
+                end_a + (end_b - end_a) * fraction,
+            )
+        else:
+            highlight = (0, 0)
+
+        yield UnderlineBar(
+            highlight_range=highlight,
+            highlight_style=console.get_style(tabs.active_bar_style),
+            background_style=console.get_style(tabs.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Users select a tab with the keyboard or the mouse. Selection is identified by
+    tab name, not by position.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. A name that matches no tab is kept,
+            and the underline sits under the first tab.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the underline beneath the
+            active tab. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the underline outside
+            the active tab. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            labels, from 0 (background color) to 1 (full color). Defaults to 0.5.
+        animation_duration (float, optional): The duration of the underline animation,
+            in seconds. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            If ``None`` or zero, the padding fits the available width. Defaults to
+            ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character. Defaults to
+            ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None = None
+        if self.tabs:
+            initial_name = active_tab or self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(self)
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab over the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab over the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, and never selects the active
+        tab. The comparison ignores case. If no other tab matches, the active tab
+        does not change.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        active_name = self._active_tab_name
+        count = len(self.tabs)
+        start = self.find_tab_by_name(active_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == active_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            tab = self.tabs[9] if count >= 10 else self.tabs[-1]
+        else:
+            tab = self.tabs[tab_number - 1]
+        self._active_tab_name = tab.name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used by clicks on the tab row.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the position of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        With no tabs, the key is consumed and nothing else happens. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - The digit keys 0 through 9 activate a tab by position, as described in
+          ``activate_tab_by_number``. Digits take precedence over letter search.
+        - Any other single character activates the next tab whose label starts with
+          that character, if ``search_by_first_character`` is true.
+
+        Every key event is marked as handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
