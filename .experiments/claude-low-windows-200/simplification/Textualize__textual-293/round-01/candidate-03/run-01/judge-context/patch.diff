+def test_flexible_padding_shares_width_by_resolver_rule():
+    # Width 100: two fixed label edges take 2 cells, leaving 98 for four flexible
+    # padding edges. Each gets 24.5 cells. The whole-cell parts are 24, 24, 24, 24
+    # with the leftover carried forward, so the shares are 24, 25, 24, 25.
+    # Home's label sits after 24 cells; the gap between labels is 25 + 24 = 49.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    label_row, underline = plain(tabs.render()).split("\n")
+    assert label_row == " " * 24 + "A" + " " * 49 + "B" + " " * 25
+    assert underline[23:26] == "╸━╺"
+
+
