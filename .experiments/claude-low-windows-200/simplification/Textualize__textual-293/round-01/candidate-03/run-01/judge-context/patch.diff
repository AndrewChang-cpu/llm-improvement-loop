+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.renderables.opacity import Opacity
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ANSI_PATTERN.sub("", render(renderable))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_text_form_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert str(Tab("Home", "a")) == "Home"
+    assert repr(Tab("Home", "a")) == "Tab(label='Home', name='a')"
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([]).tabs == []
