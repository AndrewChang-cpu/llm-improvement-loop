+def test_inactive_label_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    items = list(tabs.render().__rich_console__(console, console.options))
+
+    active_label, inactive_label = items[0], items[1]
+    assert isinstance(active_label, Text)
+    assert isinstance(active_label.style, Style)
+    assert not any(
+        "@click" in span.style.meta for span in active_label.spans
+    )
+
+    assert isinstance(inactive_label, Opacity)
+    assert inactive_label.opacity == 0.5
+    about = inactive_label.renderable
+    assert isinstance(about, Text)
+    assert isinstance(about.style, Style)
+    click_span = about.spans[-1]
+    assert isinstance(click_span.style, Style)
+    assert click_span.style.meta == {"@click": "range_clicked('About')"}
+    assert (click_span.start, click_span.end) == (0, len(about.plain))
+
+    bar = items[3]
+    assert isinstance(bar, UnderlineBar)
+    assert bar.clickable_ranges == {"Home": (0, 6), "About": (6, 13)}
