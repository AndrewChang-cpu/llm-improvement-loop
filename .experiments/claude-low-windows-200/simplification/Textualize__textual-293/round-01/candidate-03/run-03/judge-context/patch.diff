@@ -0,0 +1,181 @@
+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+SGR = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(text: str) -> str:
+    """Remove SGR color and style codes so that only the visible cells remain."""
+    return SGR.sub("", text)
+
+
+def tabs_renderable(tabs, active_tab_name=None, tab_padding=None, bar_position=0.0):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_compares_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert Tab("Home") != Tab("About")
+
+
+def test_tab_text_form_is_label_and_repr_shows_both_fields():
+    tab = Tab("Home", "home")
+    assert str(tab) == "Home"
+    assert repr(tab) == "Tab(label='Home', name='home')"
+
+
+def test_tabs_constructs_with_default_styles():
+    tabs = Tabs([Tab("Home"), Tab("About")])
+    assert tabs.tabs[0].label == "Home"
+
+
+def test_tabs_constructs_with_empty_list():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+
+
+def test_initial_active_tab_is_first_tab_when_not_given():
+    tabs = Tabs([Tab("Home", "h"), Tab("About", "a")])
+    assert tabs._active_tab_name == "h"
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("Home", "h"), Tab("About", "a")], active_tab="a")
+    assert tabs._active_tab_name == "a"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home", "h"), Tab("About", "a")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_with_duplicates():
+    tabs = Tabs([Tab("Home", "a"), Tab("About", "b"), Tab("Start", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("Home", "h"), Tab("About", "a"), Tab("Help", "e")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "e"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "h"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_number_is_one_based():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_above_count_changes_nothing():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_number_zero_selects_last_with_fewer_than_ten():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_with_ten_or_more():
+    tabs = Tabs([Tab(str(number), f"t{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_first_char_search_starts_after_active_and_wraps():
+    tabs = Tabs([Tab("Home", "home"), Tab("About", "about"), Tab("Help", "help")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "help"
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "home"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Home", "home"), Tab("About", "about")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "home"
+
+
+def test_first_char_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Home", "home"), Tab("Help", "help")],
+        search_by_first_character=False,
+    )
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "home"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("Home", "home"), Tab("About", "about")])
+    tabs.action_range_clicked("about")
+    assert tabs._active_tab_name == "about"
+
+
+def test_no_tabs_row_layout_is_empty_row_then_full_width_underline():
+    text = plain(render(tabs_renderable([])))
+    assert text == "\n" + "━" * 100
+
+
+def test_label_row_with_fixed_padding_and_inactive_tab():
+    tabs = [Tab("Home"), Tab("About")]
+    text = plain(render(tabs_renderable(tabs, active_tab_name="Home", tab_padding=1)))
+    assert text.split("\n")[0] == " Home  About "
+
+
+def test_auto_fit_label_row_shares_remaining_width():
+    # Width 100 with labels "Home" (4) and "About" (5) leaves 91 cells for four
+    # flexible padding edges. Each share is 91 / 4 = 22.75. The resolver gives the
+    # first edge 22 and carries .75, so the next edges get 23, 23, and 23.
+    tabs = [Tab("Home"), Tab("About")]
+    text = plain(render(tabs_renderable(tabs, active_tab_name="Home")))
+    expected = " " * 22 + "Home" + " " * 46 + "About" + " " * 23
+    assert text.split("\n")[0] == expected
+
+
+def test_duplicate_names_render_once_at_first_position_with_last_label():
+    tabs = [Tab("Home", "a"), Tab("About", "b"), Tab("Start", "a")]
+    text = plain(render(tabs_renderable(tabs, active_tab_name="a", tab_padding=1)))
+    assert text.split("\n")[0] == " Start  About "
+
+
+def test_underline_highlight_sits_under_active_label():
+    # Auto-fit at width 100 (see the auto-fit test): "Home" occupies columns 22 to 26,
+    # its right padding is 23 cells, and the left padding of "About" is 23 cells, so
+    # the "About" label occupies columns 72 to 77 (exclusive end).
+    # The highlight starts after cell 0 at a whole number, so the background cell
+    # before it is a right-half glyph. Its end is before the bar's width, so the
+    # background cell after it is a left-half glyph.
+    tabs = [Tab("Home"), Tab("About")]
+    text = plain(
+        render(tabs_renderable(tabs, active_tab_name="About", bar_position=1.0))
+    )
+    underline = text.split("\n")[1]
+    assert underline == "━" * 71 + "╸" + "━" * 5 + "╺" + "━" * 22
