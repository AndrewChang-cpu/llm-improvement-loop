diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..2054c78
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,446 @@
+from __future__ import annotations
+
+from math import floor
+from typing import NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import LayoutEdge, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar, range_click_action
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed on the tab.
+        name (str, optional): The name used to select the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = name or label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Return one tab per distinct name, in the order each name first appears.
+
+    Each returned tab carries the label of the last tab that has its name.
+
+    Args:
+        tabs (list[Tab]): The full ordered list of tabs.
+
+    Returns:
+        list[Tab]: The tabs to render.
+    """
+    last_by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its original position
+        last_by_name[tab.name] = tab
+    return list(last_by_name.values())
+
+
+class _TabSpan(NamedTuple):
+    """The columns occupied by one displayed tab.
+
+    Attributes:
+        tab (Tab): The displayed tab.
+        start (int): The first column of the tab's padded span.
+        left (int): The width of the left padding.
+        label_cells (int): The width of the label.
+        right (int): The width of the right padding.
+    """
+
+    tab: Tab
+    start: int
+    left: int
+    label_cells: int
+    right: int
+
+    @property
+    def label_range(self) -> tuple[int, int]:
+        """The columns of the label text, excluding padding. The end is exclusive."""
+        label_start = self.start + self.left
+        return (label_start, label_start + self.label_cells)
+
+    @property
+    def selection_range(self) -> tuple[int, int]:
+        """The columns of the padded span, which clicks use. The end is exclusive."""
+        return (self.start, self.start + self.left + self.label_cells + self.right)
+
+
+class TabsRenderable:
+    """Renders the tab labels above the underline bar.
+
+    Args:
+        tabs (list[Tab]): The full ordered list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None`` when
+            there are no tabs.
+        bar_position (float): Index into the full tab list that places the underline.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the underline's highlight.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the underline outside the
+            highlight.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs' text.
+        tab_padding (int | None): The fixed size of each padding edge, or ``None``
+            to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Divide the width among the displayed tabs' padding and label edges.
+
+        Each displayed tab contributes a left padding edge, a label edge, and a right
+        padding edge. A label with no cells has no label edge, because a zero size
+        would be read as flexible by the resolver.
+
+        Args:
+            width (int): The width available for the labels.
+
+        Returns:
+            list[_TabSpan]: The column layout of each displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        if self.tab_padding and self.tab_padding > 0:
+            padding = LayoutEdge(size=self.tab_padding)
+        else:
+            padding = LayoutEdge()
+
+        edges: list[LayoutEdge | None] = []
+        for tab in displayed:
+            label_cells = cell_len(tab.label)
+            edges.append(padding)
+            edges.append(LayoutEdge(size=label_cells) if label_cells else None)
+            edges.append(padding)
+
+        resolved = iter(
+            layout_resolve(width, [edge for edge in edges if edge is not None])
+        )
+        sizes = [next(resolved) if edge is not None else 0 for edge in edges]
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_cells, right = sizes[3 * index : 3 * index + 3]
+            span = _TabSpan(tab, cursor, left, label_cells, right)
+            spans.append(span)
+            cursor += left + label_cells + right
+        return spans
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the two tabs around the bar position.
+
+        Args:
+            label_ranges (dict[str, tuple[int, int]]): The label column range of each
+                tab name.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        if not self.tabs:
+            return (0, 0)
+        count = len(self.tabs)
+        index = floor(self.bar_position)
+        fraction = self.bar_position - index
+        current_start, current_end = label_ranges[self.tabs[index % count].name]
+        next_start, next_end = label_ranges[self.tabs[(index + 1) % count].name]
+        return (
+            current_start + (next_start - current_start) * fraction,
+            current_end + (next_end - current_end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        spans = self._layout(width)
+        label_ranges = {span.tab.name: span.label_range for span in spans}
+        selection_ranges = {span.tab.name: span.selection_range for span in spans}
+
+        # The label row: one run of text per tab, including its padding cells
+        for tab_span in spans:
+            tab = tab_span.tab
+            padded = " " * tab_span.left + tab.label + " " * tab_span.right
+            if tab.name == self.active_tab_name:
+                yield Text(padded, style=active_tab_style, no_wrap=True, end="")
+            else:
+                text = Text(padded, style=inactive_tab_style, no_wrap=True, end="")
+                text.apply_meta({"@click": range_click_action(tab.name)})
+                yield Opacity(text, opacity=self.inactive_text_opacity)
+
+        yield Segment.line()
+
+        # The underline row
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Users select a tab with the keyboard or the mouse. The selected tab is identified
+    by name.
+
+    Args:
+        tabs (list[Tab]): The ordered list of tabs. The list may be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            omitted or empty, the first tab is active. A name that matches no tab is
+            kept, and the underline sits at the first tab. Defaults to None.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the underline's highlight.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the underline outside the
+            highlight. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tabs' text, from 0 (the background color) to 1 (the full text color).
+            Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the underline
+            animation when the active tab changes. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label. If it
+            is omitted or zero, the padding is sized automatically to fill the width.
+            Defaults to None.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            activates the next tab whose label starts with that letter. Defaults to
+            True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if active_tab:
+            initial_name = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        if initial_name is None:
+            self._bar_position = 0.0
+        else:
+            self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the new active tab.
+        """
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the tabs have focus.
+
+        The event is always marked handled, and propagation is never stopped, so
+        application bindings still receive the key. With no tabs, the key does nothing.
+        Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - The digit keys 0 through 9 activate the tab at that position, following the
+          rule of ``activate_tab_by_number``.
+        - Any other single character activates the next tab, after the active one, whose
+          label starts with that character, ignoring case, if
+          ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab, after the active one, whose label starts with a char.
+
+        The search wraps around the list, ignores case, and never selects the active
+        tab. It does nothing when ``search_by_first_character`` is false.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        if not self.search_by_first_character:
+            return
+        count = len(self.tabs)
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count does nothing. The number 0 activates the
+        10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Called when a tab is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
