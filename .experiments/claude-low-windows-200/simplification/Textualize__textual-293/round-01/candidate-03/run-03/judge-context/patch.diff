+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows several Tabs configurations."""
+
+    def on_mount(self):
+        """Mount the example tab bars directly on the app."""
+        self.mount(
+            basic=Tabs(
+                [Tab("Home", "home"), Tab("About", "about"), Tab("Help", "help")]
+            ),
+            numbered=Tabs(
+                [Tab(str(number), f"tab{number}") for number in range(1, 12)],
+                active_tab="tab3",
+            ),
+            duplicates=Tabs(
+                [Tab("First", "a"), Tab("Second", "b"), Tab("Last", "a")],
+                tab_padding=2,
+            ),
+            empty=Tabs([]),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
