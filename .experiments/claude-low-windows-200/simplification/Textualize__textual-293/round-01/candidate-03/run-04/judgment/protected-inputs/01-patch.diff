diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..1bc4dcd
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,420 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+@dataclass
+class Tab:
+    """A tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str | None, optional): The name used to identify the tab. Defaults to
+            the label when not given.
+    """
+
+    label: str
+    name: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A flexible or fixed-size edge passed to the layout resolver."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Return one tab per distinct name.
+
+    Each name keeps the position of its first occurrence, and the label of its last
+    occurrence.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The tabs to display.
+    """
+    last_by_name: Dict[str | None, Tab] = {}
+    for tab in tabs:
+        last_by_name[tab.name] = tab
+    return list(last_by_name.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs of the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding cells per side, or ``None`` to fit.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        inactive_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.inactive_tab_style = inactive_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        # A falsy padding (None or zero) means auto-fit: a flexible edge.
+        return _Edge(size=self.tab_padding if self.tab_padding else None)
+
+    def _highlight_range(
+        self, label_ranges: List[Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the label range under the bar position.
+
+        Args:
+            label_ranges (List[Tuple[int, int]]): Label range of each displayed tab.
+
+        Returns:
+            Tuple[float, float]: The highlight range for the underline bar.
+        """
+        count = len(label_ranges)
+        position = self.bar_position
+        index = math.floor(position)
+        if index < 0:
+            index, fraction = 0, 0.0
+        elif index >= count:
+            index, fraction = count - 1, 0.0
+        else:
+            fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_ranges[index]
+        next_start, next_end = label_ranges[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        bar_highlight_style = console.get_style(self.active_bar_style)
+        bar_background_style = console.get_style(self.inactive_bar_style)
+
+        edges: List[_Edge] = []
+        for tab in displayed:
+            edges.append(self._padding_edge())
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        label_ranges: List[Tuple[int, int]] = []
+        clickable_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            span_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            clickable_ranges[tab.name] = (cursor, span_end)
+
+            padded_text = (
+                " " * left
+                + tab.label
+                + " " * (label_width - cell_len(tab.label))
+                + " " * right
+            )
+            if tab.name == self.active_tab_name:
+                yield Text(
+                    padded_text,
+                    style=active_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                yield Opacity(
+                    Text(
+                        padded_text,
+                        style=click_style,
+                        no_wrap=True,
+                        overflow="crop",
+                        end="",
+                    ),
+                    opacity=self.inactive_text_opacity,
+                )
+            cursor = span_end
+
+        yield Segment("\n")
+
+        highlight_range = (0.0, 0.0)
+        if label_ranges:
+            highlight_range = self._highlight_range(label_ranges)
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=bar_highlight_style,
+            background_style=bar_background_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal tab bar. The selected tab is shown by an animated underline.
+
+    Tabs are selected with the left and right keys, digit keys, or by first
+    character when searching is enabled. Clicking a tab's label or its underline
+    activates it. Pressing Escape removes focus from the widget.
+
+    Args:
+        tabs (List[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str | None, optional): The name of the initially active tab.
+            Defaults to ``None``, which selects the first tab.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of the inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): Padding cells on each side of a label,
+            or ``None`` to fit the tabs across the width. A value of zero is treated as
+            ``None``. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character.
+            Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Index of a name among the displayed tabs, or 0 when not found."""
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full list active, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full list active, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab. The comparison is case-insensitive. The search wraps around the full list and
+        never selects the active tab. If no other tab matches, nothing changes.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 selects the 10th tab when there are at least ten tabs, and the
+        last tab otherwise. A number greater than the tab count changes nothing.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with the given name active. Used by clickable ranges.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation for the tabs.
+
+        With no tabs, the event is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left activate the next or previous tab, wrapping at either end.
+        - The digits 1 through 9 activate the tab at that 1-based position, and 0
+          follows the rule of ``activate_tab_by_number``. Digits larger than the tab
+          count are ignored.
+        - Any other single character activates the next tab whose label starts with
+          it, when ``search_by_first_character`` is true.
+
+        Every key event is marked handled. Propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            inactive_tab_style=self.inactive_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
