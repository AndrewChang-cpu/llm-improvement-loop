+def test_opacity_preserves_click_metadata():
+    click_meta = {"@click": "range_clicked('home')"}
+    text = Text(
+        "Hello",
+        style=Style(color="#ff0000", bgcolor="#00ff00", meta=click_meta),
+        end="",
+    )
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rendered = console.render(Opacity(text, opacity=0.5))
+    segments = [segment for segment in rendered if segment.text]
+    assert len(segments) == 1
+    assert segments[0].style.meta == click_meta
+    assert segments[0].style.color.triplet != Style(color="#ff0000").color.triplet
