@@ -0,0 +1,184 @@
+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable):
+    return ANSI_PATTERN.sub("", render(renderable))
+
+
+def make_renderable(tabs, active=None, position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        inactive_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def segments_by_text(renderable):
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    segments = console.render(renderable)
+    return {segment.text: segment for segment in segments if segment.text}
+
+
+def click_action(style):
+    assert isinstance(style, Style)
+    return style.meta.get("@click")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_text_and_repr():
+    assert Tab("a") == Tab("a", "a")
+    assert Tab("a", "x") != Tab("a", "y")
+    assert str(Tab("Label", "name")) == "Label"
+    assert "label='Label'" in repr(Tab("Label", "name"))
+    assert "name='name'" in repr(Tab("Label", "name"))
+
+
+def test_construction_with_empty_list_and_default_styles():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+
+
+def test_construction_with_tabs_uses_first_tab_by_default():
+    tabs = Tabs([Tab("a"), Tab("b")])
+    assert tabs._active_tab_name == "a"
+
+
+def test_construction_with_unknown_active_tab_is_accepted():
+    tabs = Tabs([Tab("a"), Tab("b")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._displayed_index("zzz") == 0
+
+
+def test_no_tabs_row_layout():
+    assert plain(make_renderable([])) == "\n" + "━" * 100
+
+
+def test_label_row_with_fixed_padding():
+    renderable = make_renderable(
+        [Tab("a"), Tab("bb")], active="a", position=0.0, tab_padding=1
+    )
+    first_row, second_row = plain(renderable).split("\n")
+    assert first_row == " a  bb "
+    assert second_row[:3] == "╸━╺"
+    assert len(second_row) == 100
+
+
+def test_zero_padding_matches_auto_fit():
+    auto = make_renderable([Tab("a"), Tab("bb")], active="a", tab_padding=None)
+    zero = make_renderable([Tab("a"), Tab("bb")], active="a", tab_padding=0)
+    assert plain(auto) == plain(zero)
+
+
+def test_label_row_with_auto_fit_padding():
+    # Width 100, two labels of widths 1 and 2. The four flexible padding edges
+    # share 97 cells: 24.25 each, so the sizes are 24, 24, 24, 25 (with the
+    # fractional part carried forward). Layout: [24, 1, 24, 24, 2, 25].
+    renderable = make_renderable([Tab("a"), Tab("bb")], active="a", tab_padding=None)
+    first_row = plain(renderable).split("\n")[0]
+    assert first_row == " " * 24 + "a" + " " * 48 + "bb" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")]
+    renderable = make_renderable(tabs, active="x", position=0.0, tab_padding=1)
+    first_row, second_row = plain(renderable).split("\n")
+    assert first_row == " C  B "
+    assert second_row[:3] == "╸━╺"
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_inactive_padded_span_has_click_action_and_is_dimmed():
+    renderable = make_renderable([Tab("a"), Tab("b")], active="a", tab_padding=1)
+    segments = segments_by_text(renderable)
+
+    inactive = segments[" b "]
+    assert click_action(inactive.style) == "range_clicked('b')"
+    assert inactive.style.color.triplet != Color.parse("#f0f0f0").triplet
+
+    active = segments[" a "]
+    assert click_action(active.style) is None
+
+
+def test_active_label_has_no_click_action():
+    renderable = make_renderable([Tab("a"), Tab("b")], active="b", tab_padding=1)
+    segments = segments_by_text(renderable)
+    assert click_action(segments[" b "].style) is None
+    assert click_action(segments[" a "].style) == "range_clicked('a')"
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_small_list():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    names = ["t{}".format(index) for index in range(12)]
+    tabs = Tabs([Tab(name) for name in names])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t9"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado"), Tab("Blueberry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.action_range_clicked("c")
+    assert tabs._active_tab_name == "c"
