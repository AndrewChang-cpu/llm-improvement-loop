+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"home": (0, 2), "about": (2, 6)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    click_spans = item.spans[-2:]
+    assert [(span.start, span.end) for span in click_spans] == [(0, 2), (2, 6)]
+    assert click_meta(click_spans[0]) == {"@click": "range_clicked('home')"}
+    assert click_meta(click_spans[1]) == {"@click": "range_clicked('about')"}
