+class FakeConsole:
+    """Stands in for a console: resolves style names and passes Style objects through."""
+
+    def get_style(self, style, default=None):
+        if isinstance(style, Style):
+            return style
+        return Style.parse(style)
+
+
+def first_item(bar, width=6):
+    options = SimpleNamespace(max_width=width)
+    return next(iter(bar.__rich_console__(FakeConsole(), options)))
+
+
+def click_meta(span):
+    assert isinstance(span.style, Style)
+    return span.style.meta
+
+
+def test_underline_bar_yields_one_text_object():
