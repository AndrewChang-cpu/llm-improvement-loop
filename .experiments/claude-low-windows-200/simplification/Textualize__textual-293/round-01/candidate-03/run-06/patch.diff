diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..dc6a217
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,423 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab for the Tabs widget, identified by its name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = name or label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge: either a fixed size, or a flexible share with a minimum."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan:
+    """The rendered pieces of one displayed tab.
+
+    Args:
+        tab (Tab): The displayed tab.
+        text (str): The padded label text, including its padding cells.
+        selection (tuple[int, int]): Columns of the padded span, end exclusive.
+        label (tuple[int, int]): Columns of the label text, end exclusive.
+    """
+
+    def __init__(
+        self,
+        tab: Tab,
+        text: str,
+        selection: tuple[int, int],
+        label: tuple[int, int],
+    ) -> None:
+        self.tab = tab
+        self.text = text
+        self.selection = selection
+        self.label = label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Return one tab per distinct name, in order of first appearance.
+
+    Each entry is the last tab carrying that name, so its label is the one shown.
+    """
+    by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full ordered list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Index into the tabs that places the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of the inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding in cells on each side of a label,
+            or ``None`` (or zero) to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding:
+            return _Edge(size=self.tab_padding)
+        return _Edge(size=None, min_size=1, fraction=1)
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Lay out the displayed tabs across the given width."""
+        displayed = _displayed_tabs(self.tabs)
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(self._padding_edge())
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[3 * index : 3 * index + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    tab,
+                    " " * left + tab.label + " " * right,
+                    (cursor, selection_end),
+                    (label_start, label_end),
+                )
+            )
+            cursor = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        The bar position indexes the full tab list. Each index is mapped to the
+        displayed tab that carries its name.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return (0, 0)
+        label_ranges: dict[str, tuple[int, int]] = {
+            span.tab.name: span.label for span in spans
+        }
+        position = min(max(self.bar_position, 0.0), count - 1)
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_ranges[self.tabs[index].name]
+        next_start, next_end = label_ranges[self.tabs[next_index].name]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        for span in spans:
+            if span.tab.name == self.active_tab_name:
+                # The active tab carries no click action.
+                text = Text(
+                    span.text,
+                    style=active_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="ignore",
+                )
+                yield from console.render(text, options)
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{span.tab.name}')"}
+                )
+                text = Text(
+                    span.text,
+                    style=click_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="ignore",
+                )
+                yield from console.render(
+                    Opacity(text, opacity=self.inactive_text_opacity), options
+                )
+        yield Segment.line()
+
+        clickable_ranges = {span.tab.name: span.selection for span in spans}
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the keyboard or the mouse. The widget is two rows high:
+    labels on the first row and the underline on the second.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the underline beneath the
+            active tab. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of the inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to ``None``, which fits the padding to the widget width. Zero is
+            treated the same as ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with it. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        # Set the bar position before the active name so the watcher starts from
+        # the correct place instead of animating to an unchanged position.
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around the full list. It is
+        case-insensitive and never selects the active tab. If no other tab matches,
+        the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        count = len(self.tabs)
+        target = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Used as the click action of a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        Right and Left move to the next or previous tab, wrapping at either end.
+        The digit keys 1 to 9 activate the tab at that position, and 0 follows the
+        rule of ``activate_tab_by_number``. When search by first character is
+        enabled, any other single character activates the next tab whose label
+        starts with it. Escape removes focus from the widget. Every key event is
+        marked handled, and none is stopped, so application bindings still
+        receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
