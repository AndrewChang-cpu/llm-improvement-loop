@@ -0,0 +1,26 @@
+from textual import events
+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application showing a Tabs widget mounted directly on the App."""
+
+    async def on_mount(self) -> None:
+        tabs = Tabs(
+            [
+                Tab("Home"),
+                Tab("Articles"),
+                Tab("About"),
+                Tab("Contact"),
+            ],
+            active_tab="Home",
+        )
+        self.mount(tabs=tabs)
+        await self.set_focus(tabs)
+
+    async def on_key(self, event: events.Key) -> None:
+        await self.dispatch_key(event)
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
