@@ -0,0 +1,164 @@
+import io
+import re
+from typing import List, Tuple
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+CLICK_HOME = {"@click": "range_clicked('Home')"}
+CLICK_ABOUT = {"@click": "range_clicked('About')"}
+
+
+def plain(text: str) -> str:
+    return ANSI.sub("", text)
+
+
+def segments_of(renderable, width: int = 100):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def cells_by_row(segments) -> List[List[Tuple[str, dict]]]:
+    """Return each row as a list of (character, click metadata) pairs."""
+    rows: List[List[Tuple[str, dict]]] = [[]]
+    for segment in segments:
+        if segment.text == "\n":
+            rows.append([])
+            continue
+        meta = segment.style.meta if isinstance(segment.style, Style) else {}
+        rows[-1].extend((char, meta) for char in segment.text)
+    return rows
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert tab == Tab("Home", "Home")
+    assert tab != Tab("Home", "other")
+    assert "label='Home'" in repr(tab)
+    assert "name='Home'" in repr(tab)
+
+
+def test_construct_with_default_styles():
+    assert Tabs([]) is not None
+    tabs = Tabs([Tab("Home"), Tab("About")])
+    assert tabs._active_tab_name == "Home"
+
+
+def test_active_tab_given_and_unknown():
+    assert Tabs([Tab("A"), Tab("B")], active_tab="B")._active_tab_name == "B"
+    unknown = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert unknown._active_tab_name == "zzz"
+    assert unknown.find_tab_by_name("zzz") == 0
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_direct_positions():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 6)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "T3"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "T3"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_selects_last():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 6)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T5"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_char_search_starts_after_active_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    # Searching from Avocado wraps around and finds Apple, which is not active.
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("About")])
+    tabs.action_range_clicked("About")
+    assert tabs._active_tab_name == "About"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    assert plain(render(Tabs([]).render())) == "\n" + "━" * 100
+
+
+def test_fixed_padding_label_row_and_underline():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    lines = plain(render(tabs.render())).split("\n")
+    assert lines[0] == " Home  About "
+    # Highlight covers the Home label at columns 1 to 5.
+    assert lines[1] == "╸" + "━" * 4 + "╺" + "━" * 94
+
+
+def test_auto_fit_padding_shares_flexible_edges():
+    # Four flexible padding edges share 98 cells: 24.5 each, with the fractional
+    # part carried forward, which gives sizes 24, 25, 24 and 25.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    lines = plain(render(tabs.render())).split("\n")
+    assert lines[0] == " " * 24 + "A" + " " * 49 + "B" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")], tab_padding=1
+    )
+    lines = plain(render(tabs.render())).split("\n")
+    assert lines[0] == " Three  Two "
+    assert lines[1] == "╸" + "━" * 5 + "╺" + "━" * 93
+
+
+def test_inactive_label_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    rows = cells_by_row(segments_of(tabs.render()))
+    label_row = rows[0]
+    assert label_row[1] == ("H", {})
+    assert label_row[7] == ("A", CLICK_ABOUT)
+    # The padding cells of the inactive tab share its click action.
+    assert label_row[6] == (" ", CLICK_ABOUT)
+
+
+def test_underline_cells_under_each_tab_carry_its_click_action():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    rows = cells_by_row(segments_of(tabs.render()))
+    underline = rows[1]
+    assert underline[1][1] == CLICK_HOME
+    assert underline[7][1] == CLICK_ABOUT
