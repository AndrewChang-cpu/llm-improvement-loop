+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows a few Tabs widgets."""
+
+    def on_mount(self):
+        """Mount the example tab rows."""
+        self.mount(
+            top=Tabs(
+                [Tab("Home"), Tab("Products"), Tab("Support"), Tab("About")],
+                active_tab="Products",
+            ),
+            middle=Tabs([Tab("One"), Tab("Two"), Tab("Three")], tab_padding=2),
+            bottom=Tabs([]),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
