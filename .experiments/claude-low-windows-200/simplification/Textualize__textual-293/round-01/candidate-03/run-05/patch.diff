diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..c5473b7
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,462 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, NamedTuple, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+def _range_clicked_action(tab_name: str) -> str:
+    """Build the click action that activates the tab with the given name.
+
+    Args:
+        tab_name (str): The name of the tab.
+
+    Returns:
+        str: The action string, with the name in single quotes.
+    """
+    return f"range_clicked('{tab_name}')"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge description for the shared layout resolver.
+
+    Args:
+        size (int, optional): The fixed size of the edge, or ``None`` if flexible.
+        min_size (int, optional): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int, optional): The share of remaining space for a flexible edge.
+            Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSlot(NamedTuple):
+    """The resolved columns of one displayed tab.
+
+    Attributes:
+        name (str): The name of the tab.
+        label (str): The label of the tab.
+        left (int): Cells of left padding.
+        label_cells (int): Cells occupied by the label.
+        right (int): Cells of right padding.
+        label_range (Tuple[int, int]): Columns of the label, excluding padding.
+        selection_range (Tuple[int, int]): Columns of the padded span, end exclusive.
+    """
+
+    name: str
+    label: str
+    left: int
+    label_cells: int
+    right: int
+    label_range: Tuple[int, int]
+    selection_range: Tuple[int, int]
+
+
+class TabsRenderable:
+    """Renderable that draws tab labels above an underline bar.
+
+    Args:
+        tabs (List[Tab]): The full ordered list of tabs.
+        active_tab_name (str, optional): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the tabs that places the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding cells on each side of a label, or
+            ``None`` (or zero) to fit the padding automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        slots = self._layout_slots(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for slot in slots:
+            padded = (
+                " " * slot.left
+                + slot.label
+                + " " * (slot.label_cells - cell_len(slot.label))
+                + " " * slot.right
+            )
+            if slot.name == self.active_tab_name:
+                # The active span carries no click action.
+                yield Segment(padded, active_style)
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": _range_clicked_action(slot.name)}
+                )
+                label_text = Text(
+                    padded, style=click_style, end="", no_wrap=True, overflow="crop"
+                )
+                yield from console.render(
+                    Opacity(label_text, self.inactive_text_opacity), options
+                )
+        yield Segment("\n")
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(slots),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={slot.name: slot.selection_range for slot in slots},
+            width=width,
+        )
+
+    def _displayed_tabs(self) -> List[Tuple[str, str]]:
+        """Get one (name, label) pair per distinct name.
+
+        Each name keeps the position of its first occurrence and the label of its
+        last occurrence.
+
+        Returns:
+            List[Tuple[str, str]]: The displayed (name, label) pairs.
+        """
+        labels: Dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return list(labels.items())
+
+    def _layout_slots(self, width: int) -> List[_TabSlot]:
+        """Compute the columns of each displayed tab.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            List[_TabSlot]: One slot per displayed tab, in display order.
+        """
+        displayed = self._displayed_tabs()
+        # A padding of zero is treated as absent, so the padding is fitted.
+        padding_size = self.tab_padding or None
+
+        edges: List[_Edge] = []
+        for _name, label in displayed:
+            edges.append(_Edge(size=padding_size))
+            edges.append(_Edge(size=cell_len(label)))
+            edges.append(_Edge(size=padding_size))
+        sizes = layout_resolve(width, edges)
+
+        slots: List[_TabSlot] = []
+        cursor = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_cells, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_cells
+            selection_end = label_end + right
+            slots.append(
+                _TabSlot(
+                    name=name,
+                    label=label,
+                    left=left,
+                    label_cells=label_cells,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(cursor, selection_end),
+                )
+            )
+            cursor = selection_end
+        return slots
+
+    def _highlight_range(self, slots: List[_TabSlot]) -> Tuple[float, float]:
+        """Compute the highlighted columns under the bar position.
+
+        The bar position indexes the full tab list. Each full-list index uses the label
+        range of the displayed tab carrying that name, so duplicated names share a span.
+
+        Args:
+            slots (List[_TabSlot]): The resolved displayed tabs.
+
+        Returns:
+            Tuple[float, float]: The (start, end) columns to highlight.
+        """
+        if not self.tabs:
+            return (0, 0)
+        range_by_name = {slot.name: slot.label_range for slot in slots}
+        ranges = [range_by_name[tab.name] for tab in self.tabs]
+        count = len(ranges)
+
+        index = min(max(math.floor(self.bar_position), 0), count - 1)
+        fraction = min(max(self.bar_position - index, 0.0), 1.0)
+        next_index = (index + 1) % count
+
+        start, end = ranges[index]
+        next_start, next_end = ranges[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Args:
+        tabs (List[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab's name. A name matching no tab is kept, and the bar sits at
+            index 0.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label, or
+            ``None`` to fit the padding automatically. A value of zero also fits
+            automatically. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character. Defaults
+            to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: List[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if not self.tabs:
+            initial_name = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(
+            self.find_tab_by_name(initial_name) if initial_name is not None else 0
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            tab_name (str | None): The name of the newly active tab.
+        """
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the tabs have focus.
+
+        Escape removes focus from the widget. Right and left move to the next or
+        previous tab, wrapping at either end. The digit keys 0 to 9 activate a tab by
+        its 1-based position, where 0 selects the 10th tab or the last tab. When
+        search by first character is enabled, other single characters activate the
+        next tab, after the active one, whose label starts with that character. The
+        key event is marked handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, and never
+        selects the active tab. If no other tab matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match, compared case-insensitively.
+        """
+        count = len(self.tabs)
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for step in range(1, count):
+            tab = self.tabs[(active_index + step) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Invoked by clicks on tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
