@@ -0,0 +1,18 @@
+import io
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from textual.renderables.opacity import Opacity
+
+
+def test_opacity_preserves_click_metadata_and_blends_color():
+    style = Style(color="#ff0000", bgcolor="#00ff00", meta={"@click": "x()"})
+    text = Text("Hello", style=style, end="")
+    console = Console(width=20, file=io.StringIO(), color_system="truecolor")
+    opacity = Opacity(text, opacity=0.5)
+    segments = list(opacity.__rich_console__(console, console.options))
+    assert isinstance(segments[0].style, Style)
+    assert segments[0].style.meta == {"@click": "x()"}
+    assert segments[0].style.color.triplet == (127, 127, 0)
