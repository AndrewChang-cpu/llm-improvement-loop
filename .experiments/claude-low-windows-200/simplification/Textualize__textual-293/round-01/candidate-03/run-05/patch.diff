@@ -0,0 +1,155 @@
+import io
+
+import pytest
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def _render_lines(renderable, width=20):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return console.render_lines(renderable, console.options, pad=False)
+
+
+def _plain_rows(renderable, width=20):
+    return [
+        "".join(segment.text for segment in line)
+        for line in _render_lines(renderable, width)
+    ]
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home", "home") == Tab("Home", "home")
+    assert Tab("Home", "home") != Tab("Home", "other")
+    assert "Home" in repr(Tab("Home", "home"))
+    assert "home" in repr(Tab("Home", "home"))
+
+
+def test_empty_tabs_construct_with_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+
+
+def test_initial_active_tab_is_used_when_given():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="zz")
+    assert tabs._active_tab_name == "zz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_by_number_uses_one_based_position():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_by_number_zero_selects_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_activate_by_number_zero_selects_last_tab_with_fewer_than_ten():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_by_number_beyond_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B")
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    rows = _plain_rows(tabs.render())
+    assert rows[0] == " One  Two "
+
+
+def test_label_row_auto_fit_distributes_flexible_padding():
+    # Four flexible padding edges share 20 - 6 = 14 cells: 3.5 each. The whole-cell
+    # parts are 3, 4, 3, 4, and the fractional leftover carries forward.
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    rows = _plain_rows(tabs.render())
+    expected = " " * 3 + "One" + " " * 4 + " " * 3 + "Two" + " " * 4
+    assert rows[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    rows = _plain_rows(tabs.render())
+    assert rows[0] == " C  B "
+
+
+def test_no_tabs_draws_empty_label_row_and_inactive_underline():
+    tabs = Tabs([])
+    rows = _plain_rows(tabs.render(), width=10)
+    assert rows == ["", "━" * 10]
+
+
+def test_inactive_padded_span_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    row = _render_lines(tabs.render())[0]
+    by_text = {segment.text: segment for segment in row}
+
+    active = by_text[" One "]
+    assert isinstance(active.style, Style)
+    assert active.style.meta.get("@click") is None
+
+    inactive = by_text[" Two "]
+    assert isinstance(inactive.style, Style)
+    assert inactive.style.meta == {"@click": "range_clicked('Two')"}
