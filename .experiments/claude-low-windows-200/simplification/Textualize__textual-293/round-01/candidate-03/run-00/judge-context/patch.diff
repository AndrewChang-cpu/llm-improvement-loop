diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..bc0ef75
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,411 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = tuple("0123456789")
+
+
+class Tab:
+    """A tab shown by the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge description for the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible
+            edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of the remaining space for a flexible edge.
+            Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    The label row is followed by a line break and then the underline bar, so the
+    output always occupies two rows.
+
+    Args:
+        displayed_tabs (list[Tab]): One tab per distinct name, in display order.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs for the bar.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of an inactive tab's label.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding on each side of a label, or
+            ``None``/``0`` to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        displayed_tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.displayed_tabs = displayed_tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding:
+            return _Edge(size=self.tab_padding)
+        return _Edge()
+
+    def _label_row_part(
+        self, console: Console, tab: Tab, run: str, is_active: bool
+    ) -> RenderableType:
+        text = Text(run, end="", no_wrap=True, overflow="crop")
+        if is_active:
+            # The active tab carries no click action.
+            text.stylize(console.get_style(self.active_tab_style))
+            return text
+        click_meta = {"@click": f"range_clicked('{tab.name}')"}
+        style = console.get_style(self.inactive_tab_style) + Style(meta=click_meta)
+        text.stylize(style)
+        return Opacity(text, opacity=self.inactive_text_opacity)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        # Each displayed tab contributes: left padding, label (if non-empty), right
+        # padding. Zero-width labels are omitted from the resolver input.
+        edges: List[_Edge] = []
+        for tab in self.displayed_tabs:
+            edges.append(self._padding_edge())
+            label_width = cell_len(tab.label)
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        label_parts: List[RenderableType] = []
+        label_ranges: List[Tuple[int, int]] = []
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        position = 0
+        for tab in self.displayed_tabs:
+            label_width = cell_len(tab.label)
+            left = sizes[cursor]
+            cursor += 1
+            if label_width:
+                cursor += 1
+            right = sizes[cursor]
+            cursor += 1
+
+            selection_start = position
+            label_start = selection_start + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (selection_start, selection_end)
+
+            run = " " * left + tab.label + " " * right
+            is_active = tab.name == self.active_tab_name
+            label_parts.append(self._label_row_part(console, tab, run, is_active))
+            position = selection_end
+
+        highlight_range = self._highlight_range(label_ranges)
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        for part in label_parts:
+            yield part
+        yield Segment.line()
+        yield bar
+
+    def _highlight_range(
+        self, label_ranges: List[Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        The highlight runs between the label range at the floor index and the label
+        range at the next index, wrapping at the end.
+        """
+        count = len(label_ranges)
+        if not count:
+            return (0, 0)
+        floor_index = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_index
+        start_a, end_a = label_ranges[floor_index % count]
+        start_b, end_b = label_ranges[(floor_index + 1) % count]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the keyboard (right and left arrows, digit keys, and
+    first-character search) or with the mouse. Selection is by tab name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. An unknown name is kept as given.
+        active_tab_style (StyleType): The style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels, where
+            1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells of padding on each side of a
+            label. ``None`` or ``0`` fits the padding to the available width. Defaults
+            to ``None``.
+        search_by_first_character (bool): Whether a key press that is not a digit or an
+            arrow key activates the next tab whose label starts with that character.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name = active_tab or (self.tabs[0].name if self.tabs else None)
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """Return one tab per distinct name, in first-occurrence order.
+
+        Each entry is the last tab that carries its name.
+        """
+        last_by_name: dict[str, Tab] = {}
+        for tab in self.tabs:
+            # Re-assigning an existing key keeps its first-occurrence position.
+            last_by_name[tab.name] = tab
+        return list(last_by_name.values())
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs, or 0 if not found."""
+        for index, tab in enumerate(self._displayed_tabs()):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the position of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, compares
+        case-insensitively, and never selects the active tab. If nothing else matches,
+        the active tab is kept.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        A tab number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Invoked by clicks on a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget receives key events.
+
+        With no tabs, the key is ignored. Escape removes focus from the widget. The
+        right and left arrows move to the next or previous tab with wrap-around. The
+        digits 0 to 9 activate a tab by position (see ``activate_tab_by_number``). When
+        ``search_by_first_character`` is true, any other single-character key activates
+        the next tab whose label starts with that character. Every key is marked
+        handled, and propagation is not stopped, so application bindings still receive
+        the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            displayed_tabs=self._displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
