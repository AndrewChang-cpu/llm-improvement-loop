+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable):
+    """Render with the shared helper and return the rows without ANSI codes."""
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def label_segments(renderable, width=20):
+    """Return the segments of the label row, which is the first row."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(renderable, console.options))
+    row = []
+    for segment in segments:
+        if segment.text == "\n":
+            break
+        if segment.text:
+            row.append(segment)
+    return row
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home-key").name == "home-key"
+
+
+def test_tab_equality_repr_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home-key")
+    representation = repr(Tab("Home", "home-key"))
+    assert "label='Home'" in representation
+    assert "name='home-key'" in representation
+    assert str(Tab("Home", "home-key")) == "Home"
+
+
+def test_construction_with_default_styles_succeeds():
+    Tabs([Tab("One"), Tab("Two")])
+    Tabs([])
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0
+
+
+def test_no_tabs_has_no_active_tab():
+    assert Tabs([])._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_ignores_numbers_past_tab_count():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "One"
+
+
+def test_zero_activates_last_tab_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"t{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_first_character_search_skips_active_tab_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_other_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    lines = plain_lines(Tabs([]).render())
+    assert lines == ["", "━" * 100]
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " One  Two "
+
+
+def test_auto_fit_label_row_shares_flexible_space():
+    # Width 100. Labels take 1 + 2 cells, leaving 97 cells for 4 flexible padding
+    # edges. Each edge gets 97 / 4 = 24.25 cells. The whole-cell parts are 24, 24,
+    # 24, and the carried fractions total 0.75, which lifts the last edge to 25.
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    expected = " " * 24 + "A" + " " * 48 + "BB" + " " * 25
+    assert plain_lines(tabs.render())[0] == expected
+
+
+def test_duplicate_names_render_once_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " C  B "
+
+
+def test_underline_highlights_the_active_label_span():
+    tabs = Tabs([Tab("A"), Tab("BB")], active_tab="A", tab_padding=1)
+    # The label "A" occupies column 1. The highlight is one heavy bar with a
+    # right-half glyph before it and a left-half glyph after it.
+    assert plain_lines(tabs.render())[1] == "╸" + "━" + "╺" + "━" * 97
+
+
+def test_inactive_label_padding_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("One"), Tab("Two", "two")], active_tab="One", tab_padding=1)
+    segments = label_segments(tabs.render())
+
+    assert [segment.text for segment in segments] == [" One ", " Two "]
+    active, inactive = segments
+    assert isinstance(active.style, Style)
+    assert "@click" not in active.style.meta
+    assert isinstance(inactive.style, Style)
+    assert inactive.style.meta == {"@click": "range_clicked('two')"}
