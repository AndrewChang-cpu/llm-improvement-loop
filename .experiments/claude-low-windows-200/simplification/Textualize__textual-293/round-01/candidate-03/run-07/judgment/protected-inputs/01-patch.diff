+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable):
+    return ANSI_CODE.sub("", render(renderable))
+
+
+def make_renderable(tabs, active=None, position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs,
+        active,
+        position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("A", "a") == Tab("A", "a")
+    assert Tab("A", "a") != Tab("A", "b")
+    assert str(Tab("A", "a")) == "A"
+    assert repr(Tab("A", "a")) == "Tab(label='A', name='a')"
+
+
+def test_tabs_constructs_with_default_styles():
+    assert isinstance(Tabs([]), Tabs)
+    assert isinstance(Tabs([Tab("A"), Tab("B")]), Tabs)
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_active_tab_argument_selects_named_tab():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    assert Tabs([], active_tab="x")._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("1", "x"), Tab("2", "y"), Tab("3", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_when_ten_or_more():
+    tabs = Tabs([Tab(str(index)) for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_first_char_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_label_row_uses_fixed_padding():
+    tabs = [Tab("A"), Tab("BB")]
+    first_row = plain(make_renderable(tabs, active="A", tab_padding=1)).split("\n")[0]
+    assert first_row == " A  BB "
+
+
+def test_duplicate_names_render_once_with_last_label():
+    tabs = [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")]
+    first_row = plain(make_renderable(tabs, active="x", tab_padding=1)).split("\n")[0]
+    assert first_row == " Three  Two "
+
+
+def test_underline_sits_under_displayed_tab_with_duplicate_names():
+    tabs = [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")]
+    second_row = plain(
+        make_renderable(tabs, active="y", position=1.0, tab_padding=1)
+    ).split("\n")[1]
+    # The "Two" label spans columns 8 to 11, so the highlight is three heavy bars there
+    expected = "━" * 7 + "╸" + "━" * 3 + "╺" + "━" * 88
+    assert second_row == expected
+
+
+def test_no_tabs_draws_empty_row_and_full_inactive_underline():
+    assert plain(make_renderable([], tab_padding=1)) == "\n" + "━" * 100
+
+
+def test_inactive_padded_label_carries_click_action_and_is_dimmed():
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    tabs = [Tab("A"), Tab("B")]
+    renderable = make_renderable(tabs, active="A", tab_padding=1)
+    segments = list(console.render(renderable, console.options))
+
+    active = next(segment for segment in segments if segment.text == " A ")
+    inactive = next(segment for segment in segments if segment.text == " B ")
+
+    assert isinstance(inactive.style, Style)
+    assert inactive.style.meta == {"@click": "range_clicked('B')"}
+    assert "@click" not in active.style.meta
+    assert inactive.style.color.triplet != active.style.color.triplet
