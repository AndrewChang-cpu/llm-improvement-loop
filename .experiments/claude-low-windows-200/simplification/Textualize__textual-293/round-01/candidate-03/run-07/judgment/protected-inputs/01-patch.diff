+
+def _first_item(bar, width):
+    console = Console()
+    options = SimpleNamespace(max_width=width)
+    return next(iter(bar.__rich_console__(console, options)))
+
+
+def test_clickable_ranges_are_last_spans_with_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (2, 6)},
+        width=6,
+    )
+    text = _first_item(bar, 6)
+
+    assert isinstance(text, Text)
+    assert text.plain == "━╸━━╺━"
+    first, second = text.spans[-2:]
+    assert (first.start, first.end) == (0, 2)
+    assert (second.start, second.end) == (2, 6)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert second.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_zero_width_early_path_yields_no_click_metadata():
+    bar = UnderlineBar(clickable_ranges={"a": (0, 2)}, width=4)
+    text = _first_item(bar, 4)
+
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━"
+    for span in text.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_rejected_range_takes_early_path_without_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 1), clickable_ranges={"a": (0, 2)}, width=4
+    )
+    text = _first_item(bar, 4)
+
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━"
+    for span in text.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_keeps_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2), clickable_ranges={"a": (0, 2)}, width=4
+    )
+    text = _first_item(bar, 4)
+
+    click_spans = [span for span in text.spans if "@click" in span.style.meta]
+    assert [(span.start, span.end) for span in click_spans] == [(0, 2)]
+    assert click_spans[0].style.meta == {"@click": "range_clicked('a')"}
