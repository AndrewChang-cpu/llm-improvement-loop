diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..668c9eb
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,410 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab shown in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabEdge:
+    """A layout edge for the shared resolver. A ``None`` size makes the edge flexible."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[tuple[str, str]]:
+    """Return one ``(name, label)`` pair per distinct name.
+
+    Each name keeps the position of its first occurrence and the label of its last Tab.
+    Assigning to an existing dict key keeps its original position, which gives this rule.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return list(labels.items())
+
+
+class TabsRenderable:
+    """Renders the tab labels on the first row and the underline bar on the second.
+
+    Args:
+        tabs (list[Tab]): The full tab list, including tabs whose names repeat.
+        active_tab_name (str | None): The name of the active tab, or ``None`` when there are no tabs.
+        bar_position (float): The fractional index of the underline into the full tab list.
+        active_tab_style (StyleType): The style of the active tab's padded label.
+        active_bar_style (StyleType): The style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded labels.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int | None): The fixed padding on each side of a label, or ``None`` to fit the width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        label_ranges, selection_ranges, spans = self._layout(width, displayed)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for name, padded in spans:
+            if name == self.active_tab_name:
+                label = Text(
+                    padded, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+            else:
+                click_style = Style(meta={"@click": f"range_clicked('{name}')"})
+                label = Opacity(
+                    Text(
+                        padded,
+                        style=inactive_style + click_style,
+                        end="",
+                        no_wrap=True,
+                        overflow="crop",
+                    ),
+                    opacity=self.inactive_text_opacity,
+                )
+            yield from console.render(label, options)
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _layout(
+        self, width: int, displayed: list[tuple[str, str]]
+    ) -> tuple[
+        dict[str, tuple[int, int]], dict[str, tuple[int, int]], list[tuple[str, str]]
+    ]:
+        """Divide the row among padding and label edges.
+
+        Returns:
+            tuple: The label range and the selection range of each displayed name, and the
+                padded text of each displayed name, in display order.
+        """
+        has_fixed_padding = bool(self.tab_padding and self.tab_padding > 0)
+        padding = self.tab_padding if has_fixed_padding else None
+
+        edges: list[_TabEdge] = []
+        for _name, label in displayed:
+            edges.append(_TabEdge(size=padding))
+            # A zero-width label gets no edge, since a zero size reads as flexible
+            if cell_len(label):
+                edges.append(_TabEdge(size=cell_len(label)))
+            edges.append(_TabEdge(size=padding))
+        sizes = iter(layout_resolve(width, edges))
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        spans: list[tuple[str, str]] = []
+        position = 0
+        for name, label in displayed:
+            left = next(sizes)
+            label_width = cell_len(label)
+            if label_width:
+                next(sizes)
+            right = next(sizes)
+
+            label_start = position + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+
+            label_ranges[name] = (label_start, label_end)
+            selection_ranges[name] = (position, selection_end)
+            spans.append((name, " " * left + label + " " * right))
+            position = selection_end
+        return label_ranges, selection_ranges, spans
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        The bar position indexes the full tab list. Each index is mapped to its displayed
+        tab through the name, so duplicate names resolve to the displayed tab.
+        """
+        if not self.tabs:
+            return (0, 0)
+        count = len(self.tabs)
+        index = min(max(math.floor(self.bar_position), 0), count - 1)
+        fraction = min(max(self.bar_position - index, 0.0), 1.0)
+        next_index = (index + 1) % count
+
+        from_start, from_end = label_ranges[self.tabs[index].name]
+        to_start, to_end = label_ranges[self.tabs[next_index].name]
+        start = from_start + fraction * (to_start - from_start)
+        end = from_end + fraction * (to_end - from_end)
+        return (start, end)
+
+
+def _is_digit_key(key: str) -> bool:
+    """Return True only for the characters 0 through 9."""
+    return len(key) == 1 and key in _DIGITS
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the left and right keys, with digit keys, by typing the first
+    character of a label, or by clicking a tab.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str | None, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab.
+        active_tab_style (StyleType, optional): The style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio for inactive labels, from 0 to 1.
+            Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): The number of cells on each side of a label. Defaults
+            to ``None``, which fits the labels to the width. Zero is treated the same as ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key activates the
+            next tab whose label starts with it. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """height: 2;"""
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget receives key events.
+
+        Every key is marked handled, and propagation is never stopped, so app bindings still
+        receive keys. With no tabs, nothing else happens.
+
+        - Escape removes focus from the widget.
+        - Right and left activate the next or previous tab, wrapping at either end.
+        - The digits 1 through 9 activate the tab at that position. The 0 key activates the
+          10th tab when there are at least ten tabs, and the last tab otherwise.
+        - When ``search_by_first_character`` is true, any other single character activates the
+          next tab after the active one whose label starts with it, ignoring case and wrapping.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif _is_digit_key(key):
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab, after the active one, whose label starts with a character.
+
+        The comparison ignores case and wraps around the list. The active tab is never selected.
+        If no other tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate the tab at a 1-based position, with 0 meaning the 10th or the last tab.
+
+        A tab number greater than the tab count leaves the active tab unchanged.
+
+        Args:
+            tab_number (int): The 1-based position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with a name. This is the action of a clicked tab or underline cell.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the position of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
