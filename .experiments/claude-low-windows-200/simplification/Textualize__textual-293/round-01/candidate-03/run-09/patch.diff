+def test_opacity_preserves_click_metadata():
+    click_style = Style(
+        color="#ff0000", bgcolor="#00ff00", meta={"@click": "range_clicked('a')"}
+    )
+    text = Text("Hello", style=click_style, end="")
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = [
+        segment
+        for segment in console.render(Opacity(text, opacity=0.5))
+        if segment.text
+    ]
+    assert segments
+    for segment in segments:
+        assert segment.style.meta == {"@click": "range_clicked('a')"}
+        assert segment.style.bgcolor == click_style.bgcolor
+
+
