+
+def _first_item(bar):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return next(iter(bar.__rich_console__(console, console.options)))
+
+
+def test_highlight_half_glyphs_plain_text():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    assert _first_item(bar).plain == "━╸━━╺━"
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (2, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+
+    first_click, second_click = item.spans[-2:]
+    assert (first_click.start, first_click.end) == (0, 2)
+    assert isinstance(first_click.style, Style)
+    assert first_click.style.meta == {"@click": "range_clicked('first')"}
+    assert (second_click.start, second_click.end) == (2, 6)
+    assert isinstance(second_click.style, Style)
+    assert second_click.style.meta == {"@click": "range_clicked('second')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (-3, -1), (3, 1)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"only": (0, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    for span in item.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"only": (0, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    click_span = item.spans[-1]
+    assert (click_span.start, click_span.end) == (0, 6)
+    assert click_span.style.meta == {"@click": "range_clicked('only')"}
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..dfed11b
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,156 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain_lines(renderable):
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def _renderable(tabs, active=None, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("A", "x") == Tab("A", "x")
+    assert Tab("A", "x") != Tab("A", "y")
+    assert str(Tab("A", "x")) == "A"
+    assert repr(Tab("A", "x")) == "Tab(label='A', name='x')"
+
+
+def test_tabs_construct_with_empty_and_default_styles():
+    empty = Tabs([])
+    assert empty.render() is not None
+
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_falls_back_to_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "b")])
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_small_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Banana"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_no_tabs_draws_empty_label_row_and_inactive_underline():
+    lines = _plain_lines(_renderable([]))
+    assert lines == ["", "━" * 100]
+
+
+def test_auto_fit_label_row_follows_layout_rule():
+    # Two labels of width 3 leave 94 cells for four flexible padding edges:
+    # shares are 23.5 each, so the left edges get 23 and the right edges get 24.
+    tabs = [Tab("One", "A"), Tab("Two", "B")]
+    lines = _plain_lines(_renderable(tabs, active="A"))
+    expected = " " * 23 + "One" + " " * 47 + "Two" + " " * 24
+    assert lines[0] == expected
+
+
+def test_fixed_padding_label_row():
+    tabs = [Tab("One", "A"), Tab("Two", "B")]
+    lines = _plain_lines(_renderable(tabs, active="A", tab_padding=1))
+    assert lines[0] == " One  Two "
+
+
+def test_duplicate_names_render_once_with_last_label():
+    tabs = [Tab("A", "a"), Tab("B", "b"), Tab("C2", "a")]
+    lines = _plain_lines(_renderable(tabs, active="a", tab_padding=1))
+    assert lines[0] == " C2  B "
+
+
+def test_inactive_label_is_clickable_and_dimmed_as_one_run():
+    tabs = [Tab("One", "A"), Tab("Two", "B")]
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = [
+        segment
+        for segment in console.render(_renderable(tabs, active="A"))
+        if segment.text
+    ]
+
+    active_segments = [s for s in segments if "One" in s.text]
+    assert len(active_segments) == 1
+    assert active_segments[0].text == " " * 23 + "One" + " " * 24
+    assert active_segments[0].style.meta == {}
+
+    inactive_segments = [s for s in segments if "Two" in s.text]
+    assert len(inactive_segments) == 1
+    assert inactive_segments[0].text == " " * 23 + "Two" + " " * 24
+    assert inactive_segments[0].style.meta == {"@click": "range_clicked('B')"}
+
+
+def test_render_returns_tabs_renderable():
+    tabs = Tabs([Tab("A")])
+    assert isinstance(tabs.render(), TabsRenderable)
