+
+def _click_action(span):
+    """Return the click action of a span, reading only resolved style objects."""
+    assert isinstance(span.style, Style)
+    return span.style.meta.get("@click")
+
+
+def test_clickable_ranges_attach_click_spans_last_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (3, 6)},
+        width=6,
+    )
+    text = _bar_text(bar)
+    assert isinstance(text, Text)
+    first_click, second_click = text.spans[-2], text.spans[-1]
+    assert (first_click.start, first_click.end) == (0, 2)
+    assert _click_action(first_click) == "range_clicked('first')"
+    assert (second_click.start, second_click.end) == (3, 6)
+    assert _click_action(second_click) == "range_clicked('second')"
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(4, 2),
+        clickable_ranges={"first": (0, 3)},
+        width=6,
+    )
+    text = _bar_text(bar)
+    assert isinstance(text, Text)
+    assert text.plain == "━" * 6
+    for span in text.spans:
+        assert _click_action(span) is None
+
+
+def test_no_highlight_early_path_has_no_click_metadata():
+    bar = UnderlineBar(clickable_ranges={"first": (0, 3)}, width=6)
+    text = _bar_text(bar)
+    for span in text.spans:
+        assert _click_action(span) is None
+
+
+def test_zero_width_highlight_at_nonzero_position_gets_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"first": (0, 2)},
+        width=6,
+    )
+    text = _bar_text(bar)
+    assert _click_action(text.spans[-1]) == "range_clicked('first')"
+    assert (text.spans[-1].start, text.spans[-1].end) == (0, 2)
