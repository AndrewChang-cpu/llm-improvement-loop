diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..1c2254d
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,449 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar, range_click_action
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver.
+
+    Args:
+        size (int, optional): The fixed size of the edge, or ``None`` if flexible.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan:
+    """The columns occupied by one displayed tab.
+
+    Args:
+        tab (Tab): The displayed tab.
+        left (int): Width of the left padding.
+        right (int): Width of the right padding.
+        label_range (tuple[int, int]): Columns of the label text, exclusive end.
+        selection_range (tuple[int, int]): Columns of the padded span, exclusive end.
+    """
+
+    def __init__(
+        self,
+        tab: Tab,
+        left: int,
+        right: int,
+        label_range: tuple[int, int],
+        selection_range: tuple[int, int],
+    ) -> None:
+        self.tab = tab
+        self.left = left
+        self.right = right
+        self.label_range = label_range
+        self.selection_range = selection_range
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Collapse duplicate names into one displayed tab per name.
+
+    A name appears at the position of its first tab, and its label comes from the
+    last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: One tab per distinct name, in order of first appearance.
+    """
+    displayed: list[Tab] = []
+    position_by_name: dict[str, int] = {}
+    for tab in tabs:
+        if tab.name in position_by_name:
+            displayed[position_by_name[tab.name]] = tab
+        else:
+            position_by_name[tab.name] = len(displayed)
+            displayed.append(tab)
+    return displayed
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list, including duplicate names.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): Fractional index into the full tab list for the bar.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding on each side of a label, or
+            ``None`` to share the free width automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width, _displayed_tabs(self.tabs))
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for span in spans:
+            content = " " * span.left + span.tab.label + " " * span.right
+            if span.tab.name == self.active_tab_name:
+                # The active tab carries no click action.
+                yield Text(content, style=active_style, end="", no_wrap=True)
+            else:
+                label = Text(content, style=inactive_style, end="", no_wrap=True)
+                label.stylize(
+                    Style(meta={"@click": range_click_action(span.tab.name)})
+                )
+                yield Opacity(label, opacity=self.inactive_text_opacity)
+
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={
+                span.tab.name: span.selection_range for span in spans
+            },
+            width=width,
+        )
+        yield bar
+
+    def _layout(self, width: int, displayed: list[Tab]) -> list[_TabSpan]:
+        """Compute the columns of each displayed tab across the width.
+
+        Args:
+            width (int): The width available for the label row.
+            displayed (list[Tab]): The displayed tabs.
+
+        Returns:
+            list[_TabSpan]: The span of each displayed tab, in display order.
+        """
+        if not displayed:
+            return []
+
+        padding = self.tab_padding or None
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=padding))
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            selection_end = cursor + left + label_width + right
+            spans.append(
+                _TabSpan(
+                    tab=tab,
+                    left=left,
+                    right=right,
+                    label_range=(label_start, label_start + label_width),
+                    selection_range=(cursor, selection_end),
+                )
+            )
+            cursor = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            spans (list[_TabSpan]): The displayed tab spans.
+
+        Returns:
+            tuple[float, float]: The highlight range in columns.
+        """
+        if not spans:
+            return (0, 0)
+
+        count = len(self.tabs)
+        position = min(max(self.bar_position, 0.0), count - 1)
+        floor_index = int(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+
+        span_by_name = {span.tab.name: span for span in spans}
+        current = span_by_name[self.tabs[floor_index].name]
+        following = span_by_name[self.tabs[next_index].name]
+
+        current_start, current_end = current.label_range
+        next_start, next_end = following.label_range
+        start = current_start + fraction * (next_start - current_start)
+        end = current_end + fraction * (next_end - current_end)
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline bar,
+    which highlights the active tab. Tabs are selected with the keyboard or the mouse.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of the
+            underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the underline
+            bar. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the bar
+            animation when the active tab changes. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by the
+            bar animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label, or
+            ``None`` to share the free width between tabs. A value of zero is treated
+            the same as ``None``. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            activates the next tab whose label starts with that letter. Defaults
+            to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the list, and is
+        case-insensitive. The active tab is never selected. If no other tab matches,
+        the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        A number greater than the tab count is ignored. Zero selects the tenth tab when
+        there are at least ten tabs, and the last tab otherwise. Any other number
+        selects the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. Invoked by clicks on the tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left activate the next or previous tab, wrapping at either end.
+        - The digits 1 to 9 activate the tab at that 1-based position. The digit 0 uses
+          the rule of ``activate_tab_by_number``.
+        - Any other single character activates the next tab whose label starts with
+          that character, when ``search_by_first_character`` is true.
+
+        Every key is marked handled, but propagation is not stopped, so application
+        bindings still receive it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
