+import re
+from types import SimpleNamespace
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain(renderable):
+    """Render with the shared helper and strip the colour codes."""
+    return ANSI_PATTERN.sub("", render(renderable))
+
+
+def _underline_text(renderable, width):
+    """Return the text object that the underline bar of a renderable yields."""
+    console = Console()
+    options = SimpleNamespace(max_width=width)
+    *_, bar = renderable.__rich_console__(console, options)
+    (text,) = list(bar.__rich_console__(console, options))
+    return text
+
+
+def _click_action_at(text, column):
+    """Return the click action of the last span covering a column, if any."""
+    action = None
+    for span in text.spans:
+        assert isinstance(span.style, Style)
+        if span.start <= column < span.end and "@click" in span.style.meta:
+            action = span.style.meta["@click"]
+    return action
+
+
+def _three_tabs():
+    return [Tab("One"), Tab("Two"), Tab("Three")]
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "first").name == "first"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("One") == Tab("One", "One")
+    assert Tab("One", "a") != Tab("One", "b")
+    assert str(Tab("One", "a")) == "One"
+    representation = repr(Tab("One", "a"))
+    assert "label='One'" in representation
+    assert "name='a'" in representation
+
+
+def test_construction_with_no_tabs_and_default_styles():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_construction_defaults_active_tab_to_first_tab():
+    tabs = Tabs(_three_tabs())
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_explicit_active_tab_sets_bar_position():
+    tabs = Tabs(_three_tabs(), active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs(_three_tabs(), active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs(_three_tabs())
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = Tabs(_three_tabs())
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs(_three_tabs())
+    tabs.activate_tab_by_first_char("t")
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_tab_by_first_char("T")
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_tab_by_first_char("t")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_first_char_skips_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs(_three_tabs(), active_tab="Two")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs(_three_tabs())
+    tabs.action_range_clicked("Three")
+    assert tabs._active_tab_name == "Three"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    output = _plain(Tabs([]).render())
+    assert output == "\n" + "━" * 100
+
+
+def test_labels_share_width_when_padding_is_automatic():
+    # Width 100 with three labels of widths 3, 3 and 5 leaves 89 cells for the six
+    # flexible edges. Their shares are 14, 15, 15, 15, 15 and 15. The fractional
+    # leftover carries forward, so the shares sum to 89.
+    tabs = Tabs(_three_tabs())
+    expected_row = (
+        " " * 14
+        + "One"
+        + " " * 15
+        + " " * 15
+        + "Two"
+        + " " * 15
+        + " " * 15
+        + "Three"
+        + " " * 15
+    )
+    assert _plain(tabs.render()).split("\n")[0] == expected_row
+
+
+def test_labels_use_fixed_padding_when_given():
+    renderable = TabsRenderable(
+        tabs=_three_tabs(),
+        active_tab_name="One",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    )
+    assert _plain(renderable).split("\n")[0] == " One  Two  Three "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    renderable = TabsRenderable(
+        tabs=[Tab("A", "x"), Tab("B", "y"), Tab("C", "x")],
+        active_tab_name="x",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    )
+    lines = _plain(renderable).split("\n")
+    assert lines[0] == " C  B "
+    text = _underline_text(renderable, 100)
+    # The displayed "C" tab is at columns 0 to 3 and "B" at columns 3 to 6.
+    assert _click_action_at(text, 1) == "range_clicked('x')"
+    assert _click_action_at(text, 4) == "range_clicked('y')"
+    assert text.plain[:3] == "╸━╺"
+
+
+def test_inactive_labels_carry_click_action_and_active_label_does_not():
+    renderable = TabsRenderable(
+        tabs=_three_tabs(),
+        active_tab_name="One",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    )
+    segments = list(Console(width=100).render(renderable))
+    two = next(segment for segment in segments if "Two" in segment.text)
+    one = next(segment for segment in segments if "One" in segment.text)
+    assert two.text == " Two "
+    assert two.style.meta == {"@click": "range_clicked('Two')"}
+    assert one.style.meta == {}
+
+
+def test_inactive_labels_are_dimmed_by_opacity():
+    full = TabsRenderable(
+        tabs=_three_tabs(),
+        active_tab_name="One",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=1.0,
+        tab_padding=1,
+    )
+    dimmed = TabsRenderable(
+        tabs=_three_tabs(),
+        active_tab_name="One",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    )
+
+    def inactive_color(renderable):
+        segments = list(Console(width=100).render(renderable))
+        return next(s for s in segments if "Two" in s.text).style.color.triplet
+
+    assert inactive_color(dimmed) != inactive_color(full)
+    assert inactive_color(full) == Color.parse("#f0f0f0").triplet
+
+
+def test_underline_highlights_active_label_with_half_cell_edges():
+    renderable = TabsRenderable(
+        tabs=_three_tabs(),
+        active_tab_name="One",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    )
+    # "One" occupies columns 1 to 3, so the highlight runs from 1 to 4.
+    text = _underline_text(renderable, 100)
+    assert text.plain == "╸━━━╺" + "━" * 95
+
+
+def test_underline_click_ranges_cover_each_displayed_tab():
+    renderable = TabsRenderable(
+        tabs=_three_tabs(),
+        active_tab_name="One",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    )
+    text = _underline_text(renderable, 100)
+    assert _click_action_at(text, 2) == "range_clicked('One')"
+    assert _click_action_at(text, 7) == "range_clicked('Two')"
+    assert _click_action_at(text, 12) == "range_clicked('Three')"
+    assert _click_action_at(text, 50) is None
