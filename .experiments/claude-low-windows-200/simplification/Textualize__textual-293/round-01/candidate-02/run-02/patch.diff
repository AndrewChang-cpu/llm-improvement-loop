--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,424 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables._blend_colors import blend_colors
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class Tab:
+    """A tab with a label and a name that identifies it.
+
+    Args:
+        label (str): The text shown on the tab.
+        name (str | None, optional): The name used to select the tab.
+            Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for `layout_resolve`: a fixed size, or a flexible share."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: list[Tab]) -> dict[str, str]:
+    """Map each distinct tab name to its label.
+
+    Names keep the position of their first tab, and take their label from the last
+    tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        dict[str, str]: Tab names mapped to labels, in display order.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return labels
+
+
+def _dim_style(style: Style, opacity: float) -> Style:
+    """Blend the foreground of a style toward its background.
+
+    Args:
+        style (Style): A resolved style.
+        opacity (float): The blend ratio. 1.0 keeps the foreground color.
+
+    Returns:
+        Style: The style with its foreground blended, or the original style when
+            either color is not a fixed RGB value.
+    """
+    fg = style.color
+    bg = style.bgcolor
+    if fg and fg.triplet and bg and bg.triplet:
+        blended = Style.from_color(
+            color=blend_colors(bg, fg, ratio=opacity), bgcolor=bg
+        )
+        return style + blended
+    return style
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full ordered tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the full tab list that places the
+            underline.
+        active_tab_style (StyleType): Style of the active tab's label span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of the inactive tabs' label spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive label spans.
+        tab_padding (int | None): Fixed padding cells on each side of a label, or
+            ``None`` to share the free width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = _dim_style(
+            console.get_style(self.inactive_tab_style), self.inactive_text_opacity
+        )
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        displayed = list(_displayed_tabs(self.tabs).items())
+
+        # Each displayed tab contributes a left padding edge, a label edge, and a
+        # right padding edge. Padding is flexible unless tab_padding is positive.
+        fixed_padding = self.tab_padding or None
+        edges: list[_Edge] = []
+        for _name, label in displayed:
+            edges.append(_Edge(size=fixed_padding))
+            edges.append(_Edge(size=cell_len(label)))
+            edges.append(_Edge(size=fixed_padding))
+        sizes = layout_resolve(width, edges)
+
+        label_row = Text(no_wrap=True, overflow="crop", end="\n")
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        position = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = position + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            label_ranges[name] = (label_start, label_end)
+            selection_ranges[name] = (position, selection_end)
+
+            if name == self.active_tab_name:
+                # The active tab is not clickable.
+                span_style = active_tab_style
+            else:
+                span_style = inactive_tab_style + Style(
+                    meta={"@click": f"range_clicked('{name}')"}
+                )
+            # The padded span is one run, so its padding shares the label's style.
+            label_row.append(" " * left + label + " " * right, style=span_style)
+            position = selection_end
+
+        if position < width:
+            label_row.append(" " * (width - position))
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield label_row
+        yield bar
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Compute the underline's highlight from the bar position.
+
+        The bar position is a fractional index into the full tab list. The highlight
+        interpolates between the label ranges of the floor index and the next index,
+        wrapping at the end.
+
+        Args:
+            label_ranges (dict[str, tuple[int, int]]): Label range of each tab name.
+
+        Returns:
+            tuple[float, float]: The highlighted (start, end) columns.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return (0, 0)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        start_name = self.tabs[floor_position % count].name
+        next_name = self.tabs[(floor_position + 1) % count].name
+        start_a, end_a = label_ranges[start_name]
+        start_b, end_b = label_ranges[next_name]
+        return (
+            start_a + (start_b - start_a) * fraction,
+            end_a + (end_b - end_a) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the keyboard or the mouse. Each tab is identified by its
+    name, not its position.
+
+    Args:
+        tabs (list[Tab]): The ordered tabs to show. Names need not be unique.
+        active_tab (str | None, optional): The name of the initially active tab.
+            Defaults to the first tab's name.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of the inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive labels,
+            where 1.0 keeps the full foreground color. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): Fixed padding cells on each side of a label.
+            ``None`` or zero shares the free width between the tabs. Defaults to None.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with it. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            active_name: str | None = active_tab
+        elif tabs:
+            active_name = tabs[0].name
+        else:
+            active_name = None
+        self._active_tab_name = active_name
+        self._bar_position = float(self.find_tab_by_name(active_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the index of the newly active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the newly active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget receives key events.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - The digit keys 0 to 9 activate a tab by position (see
+          `activate_tab_by_number`). Digits take precedence over letter search.
+        - Any other single character activates the next tab, after the active one,
+          whose label starts with that character, when `search_by_first_character`
+          is true.
+
+        Every key event is marked handled without stopping its propagation.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping after the last tab."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping before the first tab."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It never selects the active
+        tab, and leaves the active tab unchanged when no other tab matches. The match
+        is case-insensitive.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        Number 0 activates the 10th tab when there are at least ten tabs, and the last
+        tab otherwise. A number above the tab count does nothing.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0 for the special rule above.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The tab name to find.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 when none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab whose selection range was clicked.
+
+        Args:
+            target_tab_name (str): The name of the clicked tab.
+        """
+        self._active_tab_name = target_tab_name
