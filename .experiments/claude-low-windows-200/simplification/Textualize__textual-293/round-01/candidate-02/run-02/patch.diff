+    assert text.plain == "━╸━━╺━"
+    home_span, about_span = text.spans[-2:]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
+    assert (about_span.start, about_span.end) == (3, 6)
+    assert about_span.style.meta == {"@click": "range_clicked('about')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (-5, -2), (4, 2), (9, 10)])
+def test_early_path_spans_carry_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    text = first_text(bar, 6)
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    assert text.spans
+    for span in text.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    text = first_text(bar, 6)
+    assert text.spans[-1].style.meta == {"@click": "range_clicked('home')"}
