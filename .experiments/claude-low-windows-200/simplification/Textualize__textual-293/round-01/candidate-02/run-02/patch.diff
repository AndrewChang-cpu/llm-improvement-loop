+import re
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+THREE_TABS = [Tab("Home"), Tab("About"), Tab("Docs")]
+
+
+class FixedOptions:
+    """Console options double that reports a fixed maximum width."""
+
+    def __init__(self, max_width):
+        self.max_width = max_width
+
+
+def make_renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def render_items(renderable, width):
+    """Return the label row and the underline bar for a fixed width."""
+    label_row, bar = list(renderable.__rich_console__(Console(), FixedOptions(width)))
+    assert isinstance(label_row, Text)
+    assert isinstance(bar, Text)
+    return label_row, bar
+
+
+def plain_rows(renderable):
+    return [ANSI_CODE.sub("", row) for row in render(renderable).split("\n")]
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home-tab").name == "home-tab"
+
+
+def test_tab_equality_repr_and_text():
+    assert Tab("a") == Tab("a", "a")
+    assert Tab("a") != Tab("a", "b")
+    assert "label='x'" in repr(Tab("x", "y"))
+    assert "name='y'" in repr(Tab("x", "y"))
+    assert str(Tab("x", "y")) == "x"
+
+
+def test_construction_with_and_without_tabs():
+    empty = Tabs([])
+    assert empty._active_tab_name is None
+    tabs = Tabs([Tab("a"), Tab("b")])
+    assert tabs._active_tab_name == "a"
+    assert tabs._bar_position == 0.0
+
+
+def test_active_tab_argument_sets_initial_state():
+    tabs = Tabs([Tab("a"), Tab("b")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+    assert tabs._bar_position == 1.0
+
+
+def test_unmatched_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("a"), Tab("b")], active_tab="zz")
+    assert tabs._active_tab_name == "zz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_over_tabs():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_for_fewer_than_ten_tabs():
+    tabs = Tabs([Tab(f"t{i}") for i in range(1, 6)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "t3"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "t3"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t5"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"t{i}") for i in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")],
+        active_tab="Apple",
+    )
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_never_selects_active_tab_alone():
+    tabs = Tabs([Tab("alpha"), Tab("beta")], active_tab="alpha")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "alpha"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    assert plain_rows(make_renderable([])) == ["", "━" * 100]
+    assert plain_rows(Tabs([]).render()) == ["", "━" * 100]
+
+
+def test_flexible_padding_shares_free_width():
+    # Six flexible padding edges share 20 - 13 = 7 cells: 1, 1, 1, 1, 1, and 2
+    # (the fractional leftover carries forward), so each span is 6, 7, and 7 cells.
+    label_row, _bar = render_items(
+        make_renderable(THREE_TABS, active_tab_name="Home"), 20
+    )
+    assert label_row.plain == " Home  About  Docs  "
+
+
+def test_active_span_has_no_click_and_inactive_spans_do():
+    label_row, _bar = render_items(
+        make_renderable(THREE_TABS, active_tab_name="Home"), 20
+    )
+    home, about, docs = label_row.spans
+    assert isinstance(home.style, Style)
+    assert (home.start, home.end) == (0, 6)
+    assert "@click" not in home.style.meta
+    assert (about.start, about.end) == (6, 13)
+    assert about.style.meta == {"@click": "range_clicked('About')"}
+    assert (docs.start, docs.end) == (13, 20)
+    assert docs.style.meta == {"@click": "range_clicked('Docs')"}
+
+
+def test_inactive_spans_are_dimmed_relative_to_active_span():
+    label_row, _bar = render_items(
+        make_renderable(THREE_TABS, active_tab_name="Home"), 20
+    )
+    home, about, _docs = label_row.spans
+    assert about.style.color.triplet != home.style.color.triplet
+
+
+def test_underline_highlights_active_span_and_carries_click_ranges():
+    _label_row, bar = render_items(
+        make_renderable(THREE_TABS, active_tab_name="Home"), 20
+    )
+    # Highlight covers the label "Home" (columns 1 to 5) with half-cell edges.
+    assert bar.plain == "╸━━━━╺" + "━" * 14
+    ranges = [
+        (span.start, span.end, span.style.meta) for span in bar.spans[-3:]
+    ]
+    assert ranges == [
+        (0, 6, {"@click": "range_clicked('Home')"}),
+        (6, 13, {"@click": "range_clicked('About')"}),
+        (13, 20, {"@click": "range_clicked('Docs')"}),
+    ]
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")]
+    label_row, _bar = render_items(
+        make_renderable(tabs, active_tab_name="x", tab_padding=1), 20
+    )
+    assert label_row.plain.startswith(" Three  Two ")
+    assert "One" not in label_row.plain
+    assert len(label_row.spans) == 2
+
+
+def test_fixed_padding_uses_given_cell_count():
+    label_row, _bar = render_items(
+        make_renderable(THREE_TABS, active_tab_name="Home", tab_padding=2), 30
+    )
+    assert label_row.plain.startswith("  Home    About    Docs  ")
