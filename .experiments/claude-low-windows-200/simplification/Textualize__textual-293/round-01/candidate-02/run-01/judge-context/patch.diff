@@ -0,0 +1,168 @@
+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.renderables.opacity import Opacity
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_render(renderable):
+    return ANSI_ESCAPE.sub("", render(renderable))
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.label == "Home"
+    assert tab.name == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home", "home") == Tab("Home", "home")
+    assert Tab("Home", "home") != Tab("Home", "other")
+    assert Tab("Home") != Tab("Away")
+
+
+def test_tab_str_is_label_and_repr_shows_both_fields():
+    tab = Tab("Home", "home")
+    assert str(tab) == "Home"
+    assert "label='Home'" in repr(tab)
+    assert "name='home'" in repr(tab)
+
+
+def test_tabs_construction_with_empty_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name(None) == 0
+
+
+def test_tabs_construction_with_default_styles():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs.tabs == [Tab("One"), Tab("Two")]
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("One"), Tab("Two", "two")])
+    assert tabs._active_tab_name == "One"
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("One"), Tab("Two", "two")], active_tab="two")
+    assert tabs._active_tab_name == "two"
+    assert tabs.find_tab_by_name("two") == 1
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_one_based():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_above_count_is_ignored():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(7)
+    assert tabs._active_tab_name == "One"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_selects_last():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_selects_tenth():
+    tabs = Tabs([Tab(f"Tab {number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Tab 10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")], active_tab="Banana")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_no_tabs_row_layout_is_empty_then_full_width_underline():
+    assert plain_render(Tabs([]).render()) == "\n" + "━" * 100
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    row, _bar = plain_render(tabs.render()).split("\n")
+    assert row == " One  Two "
+
+
+def test_label_row_with_auto_fit_padding_shares_flexible_cells():
+    # Two labels of one cell each leave 98 cells for four flexible padding edges.
+    # Each gets 24.5 cells, so the edges resolve to 24, 25, 24, 25 in order.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    row, _bar = plain_render(tabs.render()).split("\n")
+    expected = " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+    assert row == expected
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")],
+        active_tab="x",
+        tab_padding=1,
+    )
+    row, _bar = plain_render(tabs.render()).split("\n")
+    assert row == " C  B "
+
+
+def test_inactive_label_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    console = Console(file=io.StringIO(), width=100)
+    items = list(tabs.render().__rich_console__(console, console.options))
+
+    active_label = items[0]
+    assert active_label.style.meta == {}
+
+    inactive_label = items[1]
+    assert isinstance(inactive_label, Opacity)
+    assert inactive_label.opacity == 0.5
+    style = inactive_label.renderable.style
+    assert isinstance(style, Style)
+    assert style.meta == {"@click": "range_clicked('Two')"}
