+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _renderable(tabs, active=None, padding=1, position=0.0):
+    """Build a TabsRenderable with the default styles and a fixed padding."""
+    return TabsRenderable(
+        tabs,
+        active,
+        position,
+        "#f0f0f0 on #021720",
+        "#1BB152",
+        "#f0f0f0 on #021720",
+        "#455058",
+        0.5,
+        padding,
+    )
+
+
+def _plain(renderable):
+    """Render to text through the render helper and strip the ANSI codes."""
+    return ANSI_CODE.sub("", render(renderable))
+
+
+def _segments(renderable, width=40):
+    """Get the segments of a renderable from a real console."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(renderable.__rich_console__(console, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "first").name == "first"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("One", "a") == Tab("One", "a")
+    assert Tab("One", "a") != Tab("One", "b")
+    assert str(Tab("One", "a")) == "One"
+
+
+def test_construction_with_default_styles_succeeds_for_any_tab_list():
+    assert Tabs([])._active_tab_name is None
+    assert Tabs([Tab("One")])._active_tab_name == "One"
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    widget = Tabs([Tab("One"), Tab("Two")], active_tab="missing")
+    assert widget._active_tab_name == "missing"
+    assert widget._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate_index():
+    widget = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert widget.find_tab_by_name("a") == 0
+    assert widget.find_tab_by_name("b") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_over_full_list():
+    widget = Tabs([Tab("One"), Tab("Two"), Tab("Three")], active_tab="Three")
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "One"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_with_fewer_than_ten_tabs():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "B"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "C"
+    widget.activate_tab_by_number(4)
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    widget = Tabs([Tab(str(number)) for number in range(1, 13)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "10"
+
+
+def test_first_char_search_is_case_insensitive_wraps_and_skips_active():
+    widget = Tabs(
+        [Tab("Apple"), Tab("avocado"), Tab("Banana"), Tab("apricot")],
+        active_tab="Apple",
+    )
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "avocado"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "apricot"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    widget = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs([Tab("One"), Tab("Two")])
+    widget.action_range_clicked("Two")
+    assert widget._active_tab_name == "Two"
+
+
+def test_label_row_uses_padding_and_sits_on_first_row():
+    plain = _plain(_renderable([Tab("One"), Tab("Two")], active="One", padding=1))
+    assert plain.split("\n")[0] == " One  Two "
+
+
+def test_duplicate_names_render_once_at_first_position_with_last_label():
+    tabs = [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")]
+    plain = _plain(_renderable(tabs, active="a", padding=1))
+    assert plain.split("\n")[0] == " Three  Two "
+
+
+def test_no_tabs_gives_empty_label_row_and_full_inactive_bar():
+    lines = _plain(_renderable([], padding=None)).split("\n")
+    assert len(lines) == 2
+    assert lines[0] == ""
+    assert set(lines[1]) == {"━"}
+
+
+def test_inactive_span_carries_click_action_and_is_dimmed():
+    segments = _segments(
+        _renderable([Tab("One"), Tab("Two")], active="One", padding=1)
+    )
+    active = next(segment for segment in segments if segment.text == " One ")
+    inactive = next(segment for segment in segments if segment.text == " Two ")
+
+    assert isinstance(active.style, Style)
+    assert "@click" not in active.style.meta
+
+    assert isinstance(inactive.style, Style)
+    assert inactive.style.meta == {"@click": "range_clicked('Two')"}
+    assert inactive.style.color.triplet != active.style.color.triplet
+
+
+def test_underline_cells_under_inactive_tab_carry_its_click_action():
+    segments = _segments(
+        _renderable([Tab("One"), Tab("Two")], active="One", padding=1), width=12
+    )
+    line_break = next(i for i, segment in enumerate(segments) if segment.text == "\n")
+    bar_segments = segments[line_break + 1 :]
+    # " One " spans cells 0-4 and " Two " spans cells 5-9 on the label row.
+    two_cells = "".join(
+        segment.text
+        for segment in bar_segments
+        if segment.style is not None
+        and segment.style.meta.get("@click") == "range_clicked('Two')"
+    )
+    assert len(two_cells) == 5
