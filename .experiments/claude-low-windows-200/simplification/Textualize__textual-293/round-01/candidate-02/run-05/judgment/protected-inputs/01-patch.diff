+def _bar_item(bar, width):
+    """Return the first item yielded by the bar, rendered with a console and simple options."""
+    console = Console(file=io.StringIO())
+    options = SimpleNamespace(max_width=width)
+    return next(iter(bar.__rich_console__(console, options)))
+
+
+def test_clickable_ranges_attach_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"home": (0, 2), "docs": (2, 6)},
+        width=6,
+    )
+    item = _bar_item(bar, 6)
+    assert isinstance(item, Text)
+    first, second = item.spans[-2], item.spans[-1]
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": "range_clicked('home')"}
+    assert (second.start, second.end) == (2, 6)
+    assert second.style.meta == {"@click": "range_clicked('docs')"}
+
+
+def test_no_highlight_early_path_has_no_click_metadata():
+    bar = UnderlineBar(clickable_ranges={"home": (0, 3)}, width=6)
+    item = _bar_item(bar, 6)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    assert item.spans
+    for span in item.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_rejected_highlight_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(4, 2),
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    item = _bar_item(bar, 6)
+    assert isinstance(item, Text)
+    assert item.spans
+    for span in item.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"home": (0, 6)},
+        width=6,
+    )
+    item = _bar_item(bar, 6)
+    assert isinstance(item, Text)
+    assert item.spans[-1].style.meta == {"@click": "range_clicked('home')"}
+
+
+def test_highlight_between_whole_numbers_has_half_glyph_edges():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    item = _bar_item(bar, 6)
+    assert item.plain == "━╸━━╺━"
