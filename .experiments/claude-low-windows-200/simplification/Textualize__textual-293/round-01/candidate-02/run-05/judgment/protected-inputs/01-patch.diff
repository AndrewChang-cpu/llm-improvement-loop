diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..c24af36
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,407 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import LayoutEdge, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name used to select the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Collapse tabs with duplicate names into one displayed tab per name.
+
+    Each displayed tab keeps the position of the name's first occurrence and the
+    label of its last occurrence.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: One tab per distinct name, in first-appearance order.
+    """
+    order: list[str] = []
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        if tab.name not in labels:
+            order.append(tab.name)
+        labels[tab.name] = tab.label
+    return [Tab(labels[name], name) for name in order]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs for the
+            bar highlight.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of each inactive tab's padded span.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab spans.
+        tab_padding (int, optional): Fixed padding on each side of a label, or ``None``
+            to size padding automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Resolve every configured style into a style object before use.
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        # Zero or missing padding means automatic sizing; a positive value is fixed.
+        tab_padding = self.tab_padding
+        padding = tab_padding if tab_padding and tab_padding > 0 else None
+
+        # Each displayed tab contributes left padding, label, and right padding edges.
+        edges: list[LayoutEdge] = []
+        for tab in displayed:
+            edges.append(LayoutEdge(size=padding))
+            edges.append(LayoutEdge(size=cell_len(tab.label)))
+            edges.append(LayoutEdge(size=padding))
+        sizes = layout_resolve(width, edges)
+
+        label_segments: list[Segment] = []
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            span_width = left + label_width + right
+            label_start = cursor + left
+            label_ranges.append((label_start, label_start + label_width))
+            selection_ranges[tab.name] = (cursor, cursor + span_width)
+
+            run = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                # The active span carries no click action.
+                label_segments.append(Segment(run, active_style))
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                label_text = Text(end="", no_wrap=True)
+                label_text.append(run, click_style)
+                label_segments.extend(
+                    console.render(
+                        Opacity(label_text, opacity=self.inactive_text_opacity),
+                        options,
+                    )
+                )
+            cursor += span_width
+
+        yield from label_segments
+        yield Segment.line()
+
+        displayed_count = len(displayed)
+        if displayed_count == 0:
+            highlight_range = (0.0, 0.0)
+        else:
+            base = math.floor(self.bar_position)
+            fraction = self.bar_position - base
+            index = base % displayed_count
+            next_index = (index + 1) % displayed_count
+            start, end = label_ranges[index]
+            next_start, next_end = label_ranges[next_index]
+            highlight_range = (
+                start + fraction * (next_start - start),
+                end + fraction * (next_end - end),
+            )
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected by keyboard or mouse. The label row is drawn on the first
+    row and the underline bar on the second.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in display order. Names need not be unique.
+        active_tab (str, optional): The name of the tab to activate first. Defaults to
+            the first tab's name when not given or empty.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where 1.0
+            is fully visible. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            ``None`` or zero sizes the padding automatically to fill the width.
+            Defaults to None.
+        search_by_first_character (bool): Whether pressing a non-digit character key
+            activates the next tab whose label starts with it. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            active_name: str | None = active_tab
+        elif tabs:
+            active_name = tabs[0].name
+        else:
+            active_name = None
+        self._active_tab_name = active_name
+        self._bar_position = float(self._displayed_index(active_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a tab name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The displayed index, or 0 when the name is not displayed.
+        """
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of a tab in the full tab list by its name.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 when none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, is case-insensitive, and never
+        selects the active tab. The active tab is unchanged when nothing matches.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count is ignored. The number 0 activates the 10th
+        tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Called when a tab label or underline is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline bar to the newly active tab.
+
+        Args:
+            tab_name (str | None): The name of the new active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget receives key events.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget by awaiting ``set_focus(None)``.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digits 1 to 9 activate the tab at that 1-based position, and 0 follows the
+          rule of ``activate_tab_by_number``.
+        - Other single characters activate the next tab whose label starts with that
+          character, when ``search_by_first_character`` is true.
+
+        Every key event is marked handled by preventing its default action. Propagation
+        is not stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
