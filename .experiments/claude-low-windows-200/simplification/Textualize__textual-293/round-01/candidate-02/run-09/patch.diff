+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+CLICK_KEY = "@click"
+
+
+def plain(renderable) -> str:
+    return ANSI_PATTERN.sub("", render(renderable))
+
+
+def label_row_segments(renderable, width=100):
+    """Return the segments that make up the label row, up to the line break."""
+    console = Console(width=width, color_system="truecolor")
+    segments = []
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n":
+            break
+        segments.append(segment)
+    return segments
+
+
+def cell_metadata(renderable, width=100):
+    """Return the style metadata of each label-row cell."""
+    metas = []
+    for segment in label_row_segments(renderable, width):
+        style = segment.style
+        meta = style.meta if style else {}
+        metas.extend([meta] * len(segment.text))
+    return metas
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home")
+
+
+def test_tab_repr_shows_both_fields():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_default_styles_succeeds():
+    assert isinstance(Tabs([Tab("a"), Tab("b")]), Tabs)
+    assert isinstance(Tabs([]), Tabs)
+
+
+def test_render_returns_tabs_renderable():
+    assert isinstance(Tabs([Tab("a")]).render(), TabsRenderable)
+
+
+def test_no_tabs_row_layout():
+    tabs = Tabs([])
+    assert plain(tabs.render()) == "\n" + "━" * 100
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("one"), Tab("two")])
+    assert tabs._active_tab_name == "one"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("one"), Tab("two")], active_tab="two")
+    assert tabs._active_tab_name == "two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("one"), Tab("two")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("a", "x"), Tab("b", "y"), Tab("c", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_selects_position():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_above_count_changes_nothing():
+    tabs = Tabs([Tab("a"), Tab("b")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_number_zero_selects_last_with_fewer_than_ten():
+    tabs = Tabs([Tab(str(index)) for index in range(4)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_with_ten_or_more():
+    tabs = Tabs([Tab(str(index)) for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")], active_tab="avocado")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_skips_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+
+
+def test_first_char_search_with_no_other_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("a"), Tab("b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_duplicate_names_render_once_with_last_label():
+    tabs = Tabs([Tab("a", "x"), Tab("b", "y"), Tab("c", "x")], tab_padding=1)
+    row = plain(tabs.render()).split("\n")[0]
+    assert row == " c  b "
+
+
+def test_fixed_padding_label_row_and_underline():
+    tabs = Tabs([Tab("a"), Tab("bb")], tab_padding=1)
+    lines = plain(tabs.render()).split("\n")
+    assert lines[0] == " a  bb "
+    # Highlight covers the label "a" in cell 1, with half glyphs at its edges.
+    assert lines[1] == "╸━╺" + "━" * 97
+
+
+def test_inactive_padded_span_carries_its_click_action():
+    tabs = Tabs([Tab("a"), Tab("bb")], tab_padding=1)
+    metas = cell_metadata(tabs.render())
+    click = {CLICK_KEY: "range_clicked('bb')"}
+    for column in range(0, 3):
+        assert CLICK_KEY not in metas[column]
+    for column in range(3, 7):
+        assert metas[column] == click
+
+
+def test_active_padded_span_has_no_click_action():
+    tabs = Tabs([Tab("a"), Tab("bb")], tab_padding=1)
+    metas = cell_metadata(tabs.render())
+    for column in range(0, 3):
+        assert CLICK_KEY not in metas[column]
