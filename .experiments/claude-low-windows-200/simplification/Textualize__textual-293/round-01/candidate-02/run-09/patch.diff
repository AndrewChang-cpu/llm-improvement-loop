diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..d973590
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,447 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, NamedTuple, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = tuple("0123456789")
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """Size description for one edge of the label row, used by the layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The share of remaining space a flexible edge takes.
+            Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabCells(NamedTuple):
+    """The resolved columns of one displayed tab."""
+
+    name: str
+    label: str
+    start: int
+    left: int
+    label_width: int
+    right: int
+
+    @property
+    def label_start(self) -> int:
+        return self.start + self.left
+
+    @property
+    def label_end(self) -> int:
+        return self.label_start + self.label_width
+
+    @property
+    def selection_end(self) -> int:
+        return self.label_end + self.right
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> List[Tuple[str, str]]:
+    """Collapse tabs to one (name, label) entry per distinct name.
+
+    The entry keeps the position of the name's first tab and takes its label from
+    the name's last tab.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        List[Tuple[str, str]]: Pairs of tab name and label, in display order.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return list(labels.items())
+
+
+def _layout_cells(
+    width: int, displayed: Sequence[Tuple[str, str]], tab_padding: int | None
+) -> List[_TabCells]:
+    """Divide the label row into padding and label cells for each displayed tab.
+
+    Args:
+        width (int): The width of the label row in cells.
+        displayed (Sequence[Tuple[str, str]]): Pairs of tab name and label.
+        tab_padding (int | None): Fixed padding per side, or ``None`` for flexible.
+
+    Returns:
+        List[_TabCells]: The resolved columns of each displayed tab.
+    """
+    padding = tab_padding or None
+    edges: List[_Edge] = []
+    for _name, label in displayed:
+        edges.append(_Edge(size=padding))
+        # A zero-width label would be read as a flexible edge, so it is left out.
+        if cell_len(label):
+            edges.append(_Edge(size=cell_len(label)))
+        edges.append(_Edge(size=padding))
+
+    sizes = iter(layout_resolve(width, edges))
+    cells: List[_TabCells] = []
+    cursor = 0
+    for name, label in displayed:
+        left = next(sizes)
+        label_width = next(sizes) if cell_len(label) else 0
+        right = next(sizes)
+        cells.append(_TabCells(name, label, cursor, left, label_width, right))
+        cursor += left + label_width + right
+    return cells
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): The fractional index that places the underline.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tab labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding per side, or ``None`` for flexible.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        cells = _layout_cells(width, _displayed_tabs(self.tabs), self.tab_padding)
+
+        label_row = self._render_label_row(console, options, cells)
+        label_spans = {cell.name: (cell.label_start, cell.label_end) for cell in cells}
+        selection_spans = {
+            cell.name: (cell.start, cell.selection_end) for cell in cells
+        }
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_spans,
+            width=width,
+        )
+
+        yield label_row
+        yield Segment("\n")
+        yield bar
+
+    def _render_label_row(
+        self, console: Console, options: ConsoleOptions, cells: List[_TabCells]
+    ) -> Text:
+        """Build the label row, one run of text per displayed tab."""
+        row = Text(end="", no_wrap=True, overflow="crop")
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for cell in cells:
+            padded = " " * cell.left + cell.label + " " * cell.right
+            if cell.name == self.active_tab_name:
+                chunk = Text(
+                    padded, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+                segments = console.render(chunk, options)
+            else:
+                chunk = Text(
+                    padded, style=inactive_style, end="", no_wrap=True, overflow="crop"
+                )
+                chunk.apply_meta({"@click": f"range_clicked('{cell.name}')"})
+                segments = console.render(
+                    Opacity(chunk, opacity=self.inactive_text_opacity), options
+                )
+            for segment in segments:
+                row.append(segment.text, segment.style)
+        return row
+
+    def _highlight_range(
+        self, label_spans: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the label spans of adjacent tabs.
+
+        Args:
+            label_spans (Dict[str, Tuple[int, int]]): Label range of each displayed tab.
+
+        Returns:
+            Tuple[float, float]: The highlight range, or ``(0, 0)`` with no tabs.
+        """
+        count = len(self.tabs)
+        if not count:
+            return (0, 0)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = min(max(floor_position, 0), count - 1)
+        next_index = (index + 1) % count
+
+        start_a, end_a = label_spans[self.tabs[index].name]
+        start_b, end_b = label_spans[self.tabs[next_index].name]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tab labels with an animated underline under the active tab.
+
+    Select a tab with the keyboard or the mouse. Keys: left and right move between
+    tabs with wrap-around, digits 1 through 9 activate a tab by position, 0 activates
+    the tenth tab (or the last tab when there are fewer than ten), and Escape removes
+    focus. A letter key activates the next tab whose label starts with that letter.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive tab
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Seconds the underline takes to move to a
+            newly active tab. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used for the
+            underline movement. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Cells of padding on each side of a label. Defaults
+            to ``None``, which fits the labels across the width. A value of zero is
+            treated the same as ``None``.
+        search_by_first_character (bool, optional): Whether letter keys search tab
+            labels. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            self.active_tab_style,
+            self.active_bar_style,
+            self.inactive_tab_style,
+            self.inactive_bar_style,
+            self.inactive_text_opacity,
+            self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            easing=self.animation_function,
+            duration=self.animation_duration,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and never selects the
+        active tab. The comparison ignores case. If no other tab matches, the active
+        tab is unchanged.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        Args:
+            tab_number (int): A 1-based position. A value of 0 activates the tenth tab
+                when there are at least ten tabs, and the last tab otherwise. A value
+                greater than the number of tabs does nothing.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the named tab. Used as the click action of tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for tab navigation.
+
+        Every key event is marked handled, and propagation continues so that
+        application bindings still receive the key. Escape removes focus from the
+        widget. Left and right move to the previous and next tab. The digits 0 through
+        9 activate a tab by position. When ``search_by_first_character`` is true, any
+        other single character activates the next tab whose label starts with it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
