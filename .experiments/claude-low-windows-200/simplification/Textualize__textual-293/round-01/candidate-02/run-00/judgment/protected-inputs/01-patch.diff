+import re
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.renderables.opacity import Opacity
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+RENDER_WIDTH = 100
+
+
+def make_renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def rendered_lines(renderable):
+    """Render to plain text, one entry per row, with ANSI codes removed."""
+    return ANSI_PATTERN.sub("", render(renderable)).split("\n")
+
+
+def render_items(renderable):
+    console = Console(width=RENDER_WIDTH, color_system="truecolor")
+    return list(renderable.__rich_console__(console, console.options))
+
+
+def unwrap(item):
+    return item.renderable if isinstance(item, Opacity) else item
+
+
+def label_pieces(renderable):
+    """The label pieces, which come before the line break and the underline bar."""
+    return render_items(renderable)[:-2]
+
+
+def bar_text(renderable):
+    """The single text object that the underline bar yields."""
+    console = Console(width=RENDER_WIDTH, color_system="truecolor")
+    bar = render_items(renderable)[-1]
+    assert isinstance(bar, UnderlineBar)
+    items = list(bar.__rich_console__(console, console.options))
+    assert len(items) == 1
+    assert isinstance(items[0], Text)
+    return items[0]
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Settings", "settings").name == "settings"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+    assert str(Tab("Home", "home")) == "Home"
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([])._active_tab_name is None
+    assert Tabs([Tab("Home"), Tab("Help")])._active_tab_name == "Home"
+
+
+def test_initial_active_tab_and_bar_position():
+    tabs = [Tab("Home"), Tab("Settings", "settings"), Tab("Help")]
+
+    widget = Tabs(tabs, active_tab="settings")
+    assert widget._active_tab_name == "settings"
+    assert widget._bar_position == 1.0
+
+    unknown = Tabs(tabs, active_tab="missing")
+    assert unknown._active_tab_name == "missing"
+    assert unknown._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_match():
+    widget = Tabs([Tab("A"), Tab("B", "b"), Tab("B2", "b"), Tab("C")])
+    assert widget.find_tab_by_name("b") == 1
+    assert widget.find_tab_by_name("C") == 3
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_over_full_list():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "C"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "A"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_with_fewer_than_ten_tabs():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "B"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "C"
+    widget.activate_tab_by_number(4)
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    widget = Tabs([Tab(str(number)) for number in range(12)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "9"
+
+
+def test_first_character_search_wraps_and_ignores_case():
+    widget = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot"), Tab("Cherry")])
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "apricot"
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    widget = Tabs([Tab("Apple"), Tab("Banana")])
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_first_character_search_disabled_by_flag():
+    widget = Tabs([Tab("Apple"), Tab("Banana")], search_by_first_character=False)
+    widget.activate_tab_by_first_char("b")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_activates_named_tab():
+    widget = Tabs([Tab("Home"), Tab("Settings", "settings")])
+    widget.action_range_clicked("settings")
+    assert widget._active_tab_name == "settings"
+
+
+def test_tabs_render_returns_tabs_renderable():
+    assert isinstance(Tabs([Tab("Home")]).render(), TabsRenderable)
+
+
+def test_no_tabs_draws_empty_label_row_and_inactive_underline():
+    rows = rendered_lines(make_renderable([]))
+    assert rows == ["", "━" * RENDER_WIDTH]
+
+
+def test_label_row_with_fixed_padding():
+    tabs = [Tab("Home"), Tab("Settings", "settings"), Tab("Help")]
+    pieces = label_pieces(make_renderable(tabs, "settings", 1.0, tab_padding=1))
+    assert [unwrap(piece).plain for piece in pieces] == [
+        " Home ",
+        " Settings ",
+        " Help ",
+    ]
+
+
+def test_flexible_padding_shares_width_through_layout_rule():
+    # One tab in 100 cells: two flexible padding edges share 99 cells. The first
+    # gets 49 and carries 0.5 to the second, which gets 50.
+    pieces = label_pieces(make_renderable([Tab("A")], "A", 0.0, tab_padding=None))
+    assert unwrap(pieces[0]).plain == " " * 49 + "A" + " " * 50
+
+
+def test_inactive_padded_span_is_dimmed_and_clickable():
+    tabs = [Tab("Home"), Tab("Settings", "settings"), Tab("Help")]
+    pieces = label_pieces(make_renderable(tabs, "settings", 1.0))
+
+    inactive = pieces[0]
+    assert isinstance(inactive, Opacity)
+    assert inactive.opacity == 0.5
+    span = unwrap(inactive).spans[0]
+    assert (span.start, span.end) == (0, 6)
+    assert isinstance(span.style, Style)
+    assert span.style.meta == {"@click": "range_clicked('home')"}
+
+
+def test_active_padded_span_has_no_click_action():
+    tabs = [Tab("Home"), Tab("Settings", "settings"), Tab("Help")]
+    pieces = label_pieces(make_renderable(tabs, "settings", 1.0))
+
+    active = unwrap(pieces[1])
+    assert isinstance(active, Text)
+    span = active.spans[0]
+    assert isinstance(span.style, Style)
+    assert "@click" not in span.style.meta
+
+
+def test_underline_has_click_span_for_every_displayed_tab():
+    tabs = [Tab("Home"), Tab("Settings", "settings"), Tab("Help")]
+    text = bar_text(make_renderable(tabs, "settings", 1.0))
+
+    expected = [(0, 6, "home"), (6, 16, "settings"), (16, 22, "help")]
+    spans = text.spans[-3:]
+    for span, (start, end, name) in zip(spans, expected):
+        assert (span.start, span.end) == (start, end)
+        assert isinstance(span.style, Style)
+        assert span.style.meta == {"@click": f"range_clicked('{name}')"}
+
+
+def test_underline_highlights_active_tab_span():
+    tabs = [Tab("Home"), Tab("Settings", "settings"), Tab("Help")]
+    rows = rendered_lines(make_renderable(tabs, "settings", 1.0))
+    # The highlight covers the label of Settings, columns 7 to 15
+    assert rows[1] == "━" * 6 + "╸" + "━" * 8 + "╺" + "━" * 84
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("A"), Tab("B", "b"), Tab("B2", "b")]
+    widget = Tabs(tabs, active_tab="b")
+    assert widget.find_tab_by_name("b") == 1
+    assert widget._bar_position == 1.0
+
+    pieces = label_pieces(make_renderable(tabs, "b", 1.0))
+    assert [unwrap(piece).plain for piece in pieces] == [" A ", " B2 "]
+
+    rows = rendered_lines(make_renderable(tabs, "b", 1.0))
+    # The highlight covers the label of the displayed B2 tab, columns 4 to 6
+    assert rows[1] == "━" * 3 + "╸" + "━" * 2 + "╺" + "━" * 93
