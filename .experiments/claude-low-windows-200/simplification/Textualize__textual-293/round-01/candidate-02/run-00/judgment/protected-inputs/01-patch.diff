+class FakeConsole:
+    """Console double that resolves style strings into style objects."""
+
+    def get_style(self, style, *, default=None):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+class FakeOptions:
+    max_width = 6
+
+
+def render_bar_items(bar):
+    return list(bar.__rich_console__(FakeConsole(), FakeOptions()))
+
+
+def click_action(span):
+    assert isinstance(span.style, Style)
+    return span.style.meta.get("@click")
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"home": (0, 2), "help": (2, 6)},
+        width=6,
+    )
+    items = render_bar_items(bar)
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+
+    home_span, help_span = text.spans[-2:]
+    assert (home_span.start, home_span.end) == (0, 2)
+    assert click_action(home_span) == "range_clicked('home')"
+    assert (help_span.start, help_span.end) == (2, 6)
+    assert click_action(help_span) == "range_clicked('help')"
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (3, 1), (-5, -2)])
+def test_early_path_spans_carry_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    items = render_bar_items(bar)
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_gets_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"home": (0, 6)},
+        width=6,
+    )
+    text = render_bar_items(bar)[0]
+    last_span = text.spans[-1]
+    assert (last_span.start, last_span.end) == (0, 6)
+    assert click_action(last_span) == "range_clicked('home')"
