+def test_opacity_preserves_click_metadata():
+    link_text = Text(
+        "Hello",
+        style=Style(color="#ff0000", bgcolor="#00ff00", meta={"@click": "tab('a')"}),
+        end="",
+    )
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(Opacity(link_text, opacity=0.5), console.options))
+    assert [segment.text for segment in segments] == ["Hello"]
+    style = segments[0].style
+    assert isinstance(style, Style)
+    assert style.meta == {"@click": "tab('a')"}
+    assert style.color is not None
+    assert style.color.triplet != Style(color="#ff0000").color.triplet
