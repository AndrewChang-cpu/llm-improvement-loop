@@ -0,0 +1,476 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar, range_click_action
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Compute the tabs that are drawn, one per distinct name.
+
+    Each name is drawn at the position of its first tab, and its label comes
+    from the last tab that has that name.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs, which may contain duplicate names.
+
+    Returns:
+        list[Tab]: One tab per distinct name, in order of first appearance.
+    """
+    order: list[str] = []
+    last_tab: dict[str, Tab] = {}
+    for tab in tabs:
+        if tab.name not in last_tab:
+            order.append(tab.name)
+        last_tab[tab.name] = tab
+    return [last_tab[name] for name in order]
+
+
+class _Edge:
+    """A layout edge for the shared resolver. A size of None is flexible."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+@dataclass
+class _TabSpan:
+    """The laid-out columns of one displayed tab.
+
+    Attributes:
+        name (str): The tab name.
+        label (str): The label text.
+        left (int): Cells of left padding.
+        right (int): Cells of right padding.
+        label_range (tuple[int, int]): Columns of the label, with an exclusive end.
+        selection_range (tuple[int, int]): Columns of the padded span, with an
+            exclusive end. Clicks on these columns activate the tab.
+    """
+
+    name: str
+    label: str
+    left: int
+    right: int
+    label_range: Tuple[int, int]
+    selection_range: Tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): The bar position as a fractional index into the
+            displayed tabs.
+        active_tab_style (StyleType): The style of the active tab label.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding in cells on each side of a label,
+            or None to share the width automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Compute the columns of every displayed tab.
+
+        Each displayed tab contributes a left padding edge, a label edge, and a
+        right padding edge. Label edges are fixed to the label's cell width. Padding
+        edges are fixed to tab_padding when it is positive, and are otherwise
+        flexible with a minimum of one cell. A label with no cells has no label
+        edge, because a zero size would make the edge flexible.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: One span per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        padding = self.tab_padding or None
+
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding))
+            if cell_len(tab.label):
+                edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=padding))
+
+        sizes = iter(layout_resolve(width, edges))
+        spans: list[_TabSpan] = []
+        x = 0
+        for tab in displayed:
+            label_width = cell_len(tab.label)
+            left = next(sizes)
+            if label_width:
+                next(sizes)
+            right = next(sizes)
+
+            label_start = x + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    name=tab.name,
+                    label=tab.label,
+                    left=left,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(x, selection_end),
+                )
+            )
+            x = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Compute the highlighted columns for the current bar position.
+
+        The highlight interpolates between the label range at the floor index and
+        the label range at the next index. The next index wraps to the first tab.
+
+        Args:
+            spans (list[_TabSpan]): The laid-out displayed tabs.
+
+        Returns:
+            tuple[float, float]: The highlight start and end columns.
+        """
+        if not spans:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(len(spans) - 1))
+        index = int(math.floor(position))
+        fraction = position - index
+        current = spans[index]
+        following = spans[(index + 1) % len(spans)]
+        start = current.label_range[0] + (
+            following.label_range[0] - current.label_range[0]
+        ) * fraction
+        end = current.label_range[1] + (
+            following.label_range[1] - current.label_range[1]
+        ) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        # Label row: each padded span is one run of text. The inactive spans carry
+        # the click action for their name and are dimmed. The active span has no
+        # click action.
+        for span in spans:
+            padded = " " * span.left + span.label + " " * span.right
+            if span.name == self.active_tab_name:
+                yield Text(padded, style=active_style, end="", no_wrap=True)
+            else:
+                label = Text(padded, style=inactive_style, end="", no_wrap=True)
+                label.stylize(Style(meta={"@click": range_click_action(span.name)}))
+                yield Opacity(label, opacity=self.inactive_text_opacity)
+        yield Segment.line()
+
+        # Underline row: every displayed tab's selection range is clickable, including
+        # the active tab.
+        clickable_ranges = {span.name: span.selection_range for span in spans}
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by name. Keyboard and mouse selection are described in
+    ``on_key`` and in ``action_range_clicked``.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. Names need not be unique.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            None, which selects the first tab's name.
+        active_tab_style (StyleType): The style of the active tab label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio that dims inactive labels,
+            where 1.0 leaves them unchanged and 0.0 hides them. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation, in
+            seconds. Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a
+            label. Defaults to None, which shares the width automatically. A value of
+            zero is treated the same as None.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            active_name: str | None = active_tab
+        elif self.tabs:
+            active_name = self.tabs[0].name
+        else:
+            active_name = None
+        self._active_tab_name = active_name
+        self._bar_position = float(self._displayed_index(active_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index of the name, or 0 when it is not displayed.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed index of the new active tab.
+
+        Args:
+            active_tab_name (str | None): The new active tab name.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the tabs have focus.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left move to the next or previous tab, wrapping at either end.
+        - The digits 1 through 9 activate the tab at that 1-based position. The
+          digit 0 follows the rule of ``activate_tab_by_number``. Digits larger
+          than the number of tabs are ignored.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab whose label starts with it. The active tab is
+          never selected by search.
+
+        Every key event is marked handled. Propagation is not stopped, so
+        application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab over the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab over the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list,
+        compares case-insensitively, and never selects the active tab. If no other
+        tab matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The index of the first tab with that name in the full list, or 0
+                when no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the click action of a tab's range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
