+def range_click_action(range_name: str) -> str:
+    """Build the click action that activates a named clickable range.
+
+    The name is always written in single quotes, with backslashes and single
+    quotes escaped, so the action parses as a string argument.
+
+    Args:
+        range_name (str): The name of the range, such as a tab name.
+
+    Returns:
+        str: An action string of the form ``range_clicked('name')``.
+    """
+    escaped = range_name.replace("\\", "\\\\").replace("'", "\\'")
+    return f"range_clicked('{escaped}')"
 
 
