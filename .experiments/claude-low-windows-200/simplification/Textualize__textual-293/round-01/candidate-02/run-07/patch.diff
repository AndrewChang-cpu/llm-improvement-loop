@@ -0,0 +1,207 @@
+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.constrain import Constrain
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m|\x1b\]8;[^\x1b]*\x1b\\")
+
+
+def _renderable(tabs, active=None, position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def _plain(renderable, width=20):
+    return ANSI_PATTERN.sub("", render(Constrain(renderable, width)))
+
+
+def _segments(renderable, width=20):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(Constrain(renderable, width), console.options))
+
+
+def _underline_click_columns(renderable, width=20):
+    """Map each click action to the columns of the underline row it covers."""
+    segments = _segments(renderable, width)
+    newline = next(index for index, seg in enumerate(segments) if seg.text == "\n")
+    columns = {}
+    column = 0
+    for segment in segments[newline + 1 :]:
+        action = segment.style.meta.get("@click") if segment.style else None
+        for _ in segment.text:
+            if action is not None:
+                columns.setdefault(action, []).append(column)
+            column += 1
+    return columns
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert Tab("Home") != Tab("Docs")
+
+
+def test_tab_text_form_is_label_and_repr_shows_both_fields():
+    tab = Tab("Home", "home")
+    assert str(tab) == "Home"
+    assert "label='Home'" in repr(tab)
+    assert "name='home'" in repr(tab)
+
+
+def test_construct_with_empty_and_non_empty_tab_lists():
+    assert Tabs([]).find_tab_by_name(None) == 0
+    assert Tabs([Tab("Home"), Tab("Docs")]).find_tab_by_name("Docs") == 1
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("Home", "a"), Tab("Docs", "b"), Tab("Start", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_active_tab_defaults_to_first_tab_and_respects_active_tab():
+    assert Tabs([Tab("Home"), Tab("Docs")])._active_tab_name == "Home"
+    assert Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")._active_tab_name == (
+        "Docs"
+    )
+    assert Tabs([])._active_tab_name is None
+
+
+def test_next_and_previous_wrap_at_both_ends():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("About")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "About"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Home"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("About")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "Home"
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_activate_tab_by_number_zero_selects_last_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("About")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "About"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_searches_after_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Banana"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_activates_named_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    tabs.action_range_clicked("Docs")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_duplicate_names_render_once_with_last_label():
+    tabs = [Tab("Home", "a"), Tab("Docs", "b"), Tab("Start", "a")]
+    assert _plain(_renderable(tabs)) == (
+        " Start  Docs \n" + "╸" + "━" * 5 + "╺" + "━" * 13
+    )
+
+
+def test_fixed_padding_renders_label_row_and_highlight():
+    tabs = [Tab("Home"), Tab("Docs")]
+    assert _plain(_renderable(tabs, tab_padding=2, active="Home"), 30) == (
+        "  Home    Docs  \n" + "━╸━━━━╺" + "━" * 23
+    )
+
+
+def test_flexible_padding_shares_width_with_fractional_carry():
+    # Width 21: label cells use 8, leaving 13 for four flexible padding edges.
+    # Shares are 3.25 each, so the carried fractions give 3, 3, 3, 4.
+    tabs = [Tab("Home"), Tab("Docs")]
+    assert _plain(_renderable(tabs, tab_padding=None, active="Home"), 21) == (
+        "   Home      Docs    \n" + "━━╸━━━━╺" + "━" * 13
+    )
+
+
+def test_zero_tab_padding_matches_automatic_padding():
+    tabs = [Tab("Home"), Tab("Docs")]
+    assert _plain(_renderable(tabs, tab_padding=0), 21) == _plain(
+        _renderable(tabs, tab_padding=None), 21
+    )
+
+
+def test_interpolated_position_moves_highlight_between_tabs():
+    tabs = [Tab("Home"), Tab("Docs")]
+    assert _plain(_renderable(tabs, position=0.5)) == (
+        " Home  Docs \n" + "━━━╸━━━━╺" + "━" * 11
+    )
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_bar():
+    assert _plain(_renderable([]), 6) == "\n" + "━" * 6
+
+
+def test_inactive_padded_span_is_dimmed_and_clickable():
+    tabs = [Tab("Home"), Tab("Docs")]
+    segments = _segments(_renderable(tabs, active="Home"))
+
+    docs = next(segment for segment in segments if segment.text == " Docs ")
+    assert docs.style.meta == {"@click": "range_clicked('Docs')"}
+    assert docs.style.color.triplet != Color.parse("#f0f0f0").triplet
+
+    home = next(segment for segment in segments if segment.text == " Home ")
+    assert "@click" not in home.style.meta
+
+
+def test_underline_row_click_ranges_follow_selection_ranges():
+    tabs = [Tab("Home"), Tab("Docs")]
+    columns = _underline_click_columns(_renderable(tabs, active="Home"))
+    assert columns["range_clicked('Home')"] == list(range(0, 6))
+    assert columns["range_clicked('Docs')"] == list(range(6, 12))
+
+
+def test_tabs_construct_with_default_styles():
+    widget = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs", tab_padding=0)
+    assert widget.find_tab_by_name("Docs") == 1
