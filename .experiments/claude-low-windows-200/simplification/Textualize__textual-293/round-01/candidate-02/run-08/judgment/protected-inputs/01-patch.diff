+    assert (first_click.start, first_click.end) == (0, 2)
+    assert isinstance(first_click.style, Style)
+    assert first_click.style.meta == {"@click": "range_clicked('home')"}
+    assert (second_click.start, second_click.end) == (2, 4)
+    assert isinstance(second_click.style, Style)
+    assert second_click.style.meta == {"@click": "range_clicked('about')"}
