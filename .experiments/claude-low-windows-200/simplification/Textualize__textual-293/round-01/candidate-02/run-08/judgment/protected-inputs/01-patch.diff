+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable):
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def make_renderable(tabs, active=None, position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("Home", "home") == Tab("Home", "home")
+    assert Tab("Home", "home") != Tab("Home", "other")
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_construct_with_default_styles():
+    Tabs([])
+    tabs = Tabs([Tab("Home"), Tab("About")])
+
+    assert isinstance(tabs.render(), TabsRenderable)
+
+
+def test_initial_active_tab():
+    assert Tabs([Tab("A"), Tab("B")])._active_tab_name == "A"
+    assert Tabs([Tab("A"), Tab("B")], active_tab="B")._active_tab_name == "B"
+    assert Tabs([])._active_tab_name is None
+
+
+def test_unknown_active_tab_keeps_name_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_tab_by_number_is_one_based():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+
+
+def test_activate_tab_by_number_beyond_count_changes_nothing():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "1"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_selects_last():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_char_search_starts_after_active_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")], active_tab="Avocado")
+
+    tabs.activate_tab_by_first_char("a")
+
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_is_case_insensitive():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")], active_tab="Apple")
+
+    tabs.activate_tab_by_first_char("B")
+
+    assert tabs._active_tab_name == "banana"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+
+    tabs.activate_tab_by_first_char("a")
+
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+
+    tabs.activate_tab_by_first_char("z")
+
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Avocado")],
+        search_by_first_character=False,
+    )
+
+    tabs.activate_tab_by_first_char("a")
+
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+
+    tabs.action_range_clicked("B")
+
+    assert tabs._active_tab_name == "B"
+
+
+def test_fixed_padding_label_row_and_underline():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About"), Tab("Help")], active="Home", tab_padding=1
+    )
+
+    row, bar = plain_lines(renderable)
+
+    assert row == " Home  About  Help "
+    assert bar.startswith("╸━━━━╺")
+    assert len(bar) == 100
+
+
+def test_zero_padding_is_treated_as_auto_fit():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About"), Tab("Help")], active="Home", tab_padding=0
+    )
+
+    row, _bar = plain_lines(renderable)
+
+    assert len(row) == 100
+
+
+def test_auto_padding_fills_the_width():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About"), Tab("Help")], active="Home", tab_padding=None
+    )
+
+    row, _bar = plain_lines(renderable)
+
+    assert len(row) == 100
+    assert "Home" in row and "About" in row and "Help" in row
+
+
+def test_duplicate_names_display_once_with_last_label():
+    renderable = make_renderable(
+        [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")],
+        active="x",
+        tab_padding=1,
+    )
+
+    row, bar = plain_lines(renderable)
+
+    assert row == " Three  Two "
+    assert bar.startswith("╸━━━━━╺")
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_underline():
+    row, bar = plain_lines(make_renderable([], active=None))
+
+    assert row == ""
+    assert bar == "━" * 100
+
+
+def test_inactive_labels_carry_click_action_and_active_does_not():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About")], active="Home", tab_padding=1
+    )
+    console = Console(width=100, color_system="truecolor")
+
+    segments = list(console.render(renderable, console.options))
+    active = next(segment for segment in segments if segment.text == " Home ")
+    inactive = next(segment for segment in segments if segment.text == " About ")
+
+    assert isinstance(active.style, Style)
+    assert active.style.meta == {}
+    assert isinstance(inactive.style, Style)
+    assert inactive.style.meta == {"@click": "range_clicked('About')"}
