+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,464 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables._blend_colors import blend_colors
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+__all__ = ["Tab", "Tabs"]
+
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab item with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of flexible space this edge takes. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Compute the tabs that are shown, one per distinct name.
+
+    Each name appears at the position of its first tab, and its label comes from
+    the last tab with that name.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs.
+
+    Returns:
+        List[Tab]: The displayed tabs in display order.
+    """
+    positions: Dict[str, int] = {}
+    displayed: List[Tab] = []
+    for tab in tabs:
+        if tab.name in positions:
+            displayed[positions[tab.name]] = tab
+        else:
+            positions[tab.name] = len(displayed)
+            displayed.append(tab)
+    return displayed
+
+
+def _displayed_index(displayed: List[Tab], tab_name: str | None) -> int:
+    """Find the index of a name among the displayed tabs.
+
+    Args:
+        displayed (List[Tab]): The displayed tabs.
+        tab_name (str, optional): The name to look up.
+
+    Returns:
+        int: The index of the name, or 0 if no displayed tab has it.
+    """
+    for index, tab in enumerate(displayed):
+        if tab.name == tab_name:
+            return index
+    return 0
+
+
+def _dim_style(style: Style, opacity: float) -> Style:
+    """Blend a style's foreground toward its background by an opacity ratio.
+
+    Args:
+        style (Style): A resolved style.
+        opacity (float): The blend ratio. 1.0 keeps the foreground color.
+
+    Returns:
+        Style: The style with the blended foreground, keeping other attributes.
+    """
+    foreground = style.color
+    background = style.bgcolor
+    if foreground is None or background is None:
+        return style
+    if not (foreground.triplet and background.triplet):
+        return style
+    blended = Style.from_color(
+        color=blend_colors(background, foreground, ratio=opacity),
+        bgcolor=background,
+    )
+    return style + blended
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar for a set of tabs.
+
+    The label row lays out each displayed tab as a left padding edge, a label edge,
+    and a right padding edge. The underline bar is placed under the label row and
+    highlights the interpolated label span at the bar position.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs. Duplicate names are shown once.
+        active_tab_name (str, optional): The name of the active tab, or ``None``.
+        bar_position (float): The fractional index of the bar into the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int, optional): A fixed padding size in cells, or ``None``
+            to share the free width between the padding edges.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.displayed_tabs = _displayed_tabs(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        label_row, label_ranges, selection_ranges = self._build_label_row(
+            console, width
+        )
+        yield label_row
+        yield Segment.line()
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _build_label_row(
+        self, console: Console, width: int
+    ) -> Tuple[Text, Dict[str, Tuple[int, int]], Dict[str, Tuple[int, int]]]:
+        """Lay out the labels across the width.
+
+        Args:
+            console (Console): The console used to resolve styles.
+            width (int): The width available for the labels.
+
+        Returns:
+            Tuple: The label row, the label ranges keyed by name, and the selection
+                ranges keyed by name, in display order.
+        """
+        padding = self.tab_padding or None
+        label_widths = [cell_len(tab.label) for tab in self.displayed_tabs]
+
+        # Zero-width labels get no label edge, so they are not made flexible.
+        edges: List[_Edge] = []
+        for label_width in label_widths:
+            edges.append(_Edge(size=padding))
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            edges.append(_Edge(size=padding))
+        sizes = iter(layout_resolve(width, edges))
+
+        row = Text(no_wrap=True, overflow="crop", end="")
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for tab, label_width in zip(self.displayed_tabs, label_widths):
+            left = next(sizes)
+            if label_width:
+                next(sizes)
+            right = next(sizes)
+
+            span_width = left + label_width + right
+            selection_ranges[tab.name] = (cursor, cursor + span_width)
+            label_ranges[tab.name] = (cursor + left, cursor + left + label_width)
+
+            if tab.name == self.active_tab_name:
+                style = console.get_style(self.active_tab_style)
+            else:
+                inactive = console.get_style(self.inactive_tab_style)
+                style = _dim_style(inactive, self.inactive_text_opacity) + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+            row.append(" " * left + tab.label + " " * right, style)
+            cursor += span_width
+
+        return row, label_ranges, selection_ranges
+
+    def _highlight_range(
+        self, label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the label spans at the bar position.
+
+        Args:
+            label_ranges (Dict[str, Tuple[int, int]]): Label ranges keyed by name.
+
+        Returns:
+            Tuple[float, float]: The highlight range, or ``(0, 0)`` with no tabs.
+        """
+        count = len(self.displayed_tabs)
+        if count == 0:
+            return (0, 0)
+        floor_index = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_index
+        current = self.displayed_tabs[floor_index % count]
+        following = self.displayed_tabs[(floor_index + 1) % count]
+        current_start, current_end = label_ranges[current.name]
+        next_start, next_end = label_ranges[following.name]
+        start = current_start + (next_start - current_start) * fraction
+        end = current_end + (next_end - current_end) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the keyboard or the mouse. Selection identifies tabs by
+    name. Duplicate names are shown once, at the first occurrence's position, with
+    the label of the last tab that has that name.
+
+    Args:
+        tabs (List[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. A name that matches no tab is kept.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio that dims inactive
+            labels toward their background. Defaults to 0.5.
+        animation_duration (float, optional): The duration of the underline animation
+            in seconds. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used for
+            the underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): A fixed padding size in cells on each side of a
+            label. Defaults to ``None``, which fits the padding to the width. A value
+            of zero is treated the same as ``None``.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            activates the next tab whose label starts with that letter. Defaults to
+            True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+
+        self.tabs: List[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if self.tabs:
+            initial_name: str | None = active_tab or self.tabs[0].name
+        else:
+            initial_name = None
+
+        # Set the bar position before the name so the watcher animates to the
+        # same position and the bar does not visibly move on mount.
+        self._bar_position = float(
+            _displayed_index(_displayed_tabs(self.tabs), initial_name)
+        )
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        target = _displayed_index(_displayed_tabs(self.tabs), active_tab_name)
+        self.animate(
+            "_bar_position",
+            float(target),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the tabs have focus.
+
+        Escape removes focus from the widget. Right and left move to the next or
+        previous tab with wrap-around. Digits 0 through 9 activate a tab by position.
+        Other single characters activate the next tab whose label starts with that
+        character, when ``search_by_first_character`` is enabled. Every key event is
+        marked handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab active, wrapping to the first tab after the last."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab active, wrapping to the last tab before the first."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The comparison is case-insensitive and wraps around the full list. The active
+        tab is never selected. If no other tab matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label[:1].lower() == wanted:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count is ignored. Zero selects the tenth tab
+        when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the click action of each tab's span.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
