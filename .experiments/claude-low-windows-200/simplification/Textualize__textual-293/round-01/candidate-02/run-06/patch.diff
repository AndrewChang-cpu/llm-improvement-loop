diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..2b96663
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,168 @@
+import io
+import re
+
+from rich.console import Console
+from rich.constrain import Constrain
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain_lines(renderable, width):
+    """Render a constrained renderable and return its lines without ANSI codes."""
+    output = render(Constrain(renderable, width))
+    return ANSI_RE.sub("", output).split("\n")
+
+
+def _segments(renderable, width):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(Constrain(renderable, width), console.options))
+
+
+def _click_meta(style):
+    return style.meta.get("@click")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "one").name == "one"
+
+
+def test_tab_equality_text_and_repr():
+    assert Tab("A", "a") == Tab("A", "a")
+    assert Tab("A", "a") != Tab("A", "b")
+    assert str(Tab("A", "a")) == "A"
+    assert repr(Tab("A", "a")) == "Tab(label='A', name='a')"
+
+
+def test_construct_with_default_styles_and_empty_list():
+    Tabs([])
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert len(tabs.tabs) == 2
+
+
+def test_initial_active_tab():
+    assert Tabs([Tab("One"), Tab("Two")])._active_tab_name == "One"
+    assert Tabs([Tab("One"), Tab("Two")], active_tab="Two")._active_tab_name == "Two"
+    assert Tabs([Tab("One")], active_tab="zzz")._active_tab_name == "zzz"
+    assert Tabs([])._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(f"t{number}") for number in range(1, 6)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "t3"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "t3"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t5"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"t{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Apricot")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apricot"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apricot"
+
+
+def test_activate_tab_by_first_char_does_not_select_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_no_tabs_renders_empty_row_and_inactive_underline():
+    lines = _plain_lines(Tabs([]).render(), 10)
+    assert lines == ["", "━━━━━━━━━━"]
+
+
+def test_auto_fit_label_row_and_underline():
+    # Four flexible padding edges share the 8 free cells at 2 cells each.
+    # Layout: left 2, label 1, right 2, left 2, label 1, right 2.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    lines = _plain_lines(tabs.render(), 10)
+    assert lines[0] == "  A    B  "
+    # Highlight covers label A at columns 2 to 3.
+    assert lines[1] == "━╸━╺━━━━━━"
+
+
+def test_highlight_follows_active_tab_position():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    lines = _plain_lines(tabs.render(), 10)
+    # Label B sits at columns 7 to 8.
+    assert lines[1] == "━━━━━━╸━╺━"
+
+
+def test_fixed_tab_padding_row():
+    lines = _plain_lines(TabsRenderable(
+        [Tab("A"), Tab("B")],
+        active_tab_name="A",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    ), 20)
+    assert lines[0] == " A  B "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")],
+        active_tab="x",
+        tab_padding=1,
+    )
+    lines = _plain_lines(tabs.render(), 20)
+    assert lines[0] == " Three  Two "
+    assert lines[1].startswith("╸━━━━━╺")
+
+
+def test_inactive_padded_span_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    segments = _segments(tabs.render(), 10)
+    by_text = {segment.text: segment for segment in segments}
+
+    active = by_text["  A  "]
+    inactive = by_text["  B  "]
+    assert isinstance(active.style, Style)
+    assert isinstance(inactive.style, Style)
+    assert _click_meta(active.style) is None
+    assert _click_meta(inactive.style) == "range_clicked('B')"
