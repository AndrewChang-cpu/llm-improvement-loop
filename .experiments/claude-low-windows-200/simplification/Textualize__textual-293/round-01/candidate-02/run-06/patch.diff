+def test_opacity_preserves_other_style_attributes():
+    style = Style(
+        color="#ffffff",
+        bgcolor="#000000",
+        bold=True,
+        meta={"@click": "range_clicked('a')"},
+    )
+    console = Console(width=20, file=io.StringIO(), color_system="truecolor")
+    segments = list(
+        console.render(Opacity(Text("hi", style=style), opacity=.5), console.options)
+    )
+    text_segment = next(segment for segment in segments if segment.text == "hi")
+    assert text_segment.style.bold
+    assert text_segment.style.meta == {"@click": "range_clicked('a')"}
