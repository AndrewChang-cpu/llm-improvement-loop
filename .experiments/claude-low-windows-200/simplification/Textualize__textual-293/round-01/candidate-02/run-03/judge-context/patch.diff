@@ -0,0 +1,204 @@
+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain_lines(renderable):
+    return ANSI_ESCAPE.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", name="h").name == "h"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construct_with_default_styles():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs.find_tab_by_name("Docs") == 1
+
+
+def test_construct_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_given_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    assert tabs._active_tab_name == "Docs"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("First", "A"), Tab("Beta"), Tab("Second", "A")])
+    assert tabs.find_tab_by_name("A") == 0
+    assert tabs.find_tab_by_name("Beta") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("Api")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Api"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Home"
+
+
+def test_activate_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_by_number_zero_selects_last_tab_below_ten_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(5)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "4"
+
+
+def test_activate_by_number_zero_selects_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_first_character_search_wraps_and_is_case_insensitive():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Blue")])
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Blue"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Avocado"
+
+
+def test_range_clicked_action_activates_named_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    tabs.action_range_clicked("Docs")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_label_row_and_underline_with_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    label_row, underline = _plain_lines(tabs.render())[:2]
+    assert label_row.rstrip() == " Home  Docs"
+    # Highlight covers the label "Home" at columns 1 through 4.
+    assert underline[0] == "╸"
+    assert underline[1:5] == "━━━━"
+    assert underline[5] == "╺"
+
+
+def test_flexible_padding_shares_width_across_edges():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    label_row = _plain_lines(tabs.render())[0]
+    # Width 100 gives the four flexible padding edges 24, 25, 24 and 25 cells.
+    assert label_row.index("A") == 24
+    assert label_row.index("B") == 74
+
+
+def test_zero_tab_padding_matches_absent_padding():
+    absent = Tabs([Tab("Home"), Tab("Docs")])
+    zero = Tabs([Tab("Home"), Tab("Docs")], tab_padding=0)
+    assert _plain_lines(absent.render())[0] == _plain_lines(zero.render())[0]
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    tabs = Tabs(
+        [Tab("First", "A"), Tab("Beta"), Tab("Second", "A")], tab_padding=1
+    )
+    label_row = _plain_lines(tabs.render())[0]
+    assert label_row.rstrip() == " Second  Beta"
+
+
+def test_underline_sits_under_displayed_tab_with_active_duplicate_name():
+    tabs = Tabs(
+        [Tab("First", "A"), Tab("Beta"), Tab("Second", "A")],
+        active_tab="Beta",
+        tab_padding=1,
+    )
+    underline = _plain_lines(tabs.render())[1]
+    # " Second " occupies columns 0 through 7, so " Beta " puts its label at 9 to 12.
+    assert underline[8] == "╸"
+    assert underline[9:13] == "━━━━"
+    assert underline[13] == "╺"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    lines = _plain_lines(Tabs([]).render())
+    assert lines[0] == ""
+    assert lines[1] == "━" * 100
+
+
+def test_inactive_padded_span_is_dimmed_and_clickable():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+
+    active = [segment for segment in segments if segment.text == " Home "]
+    inactive = [segment for segment in segments if segment.text == " Docs "]
+    assert len(active) == 1 and len(inactive) == 1
+
+    assert isinstance(active[0].style, Style)
+    assert "@click" not in active[0].style.meta
+    assert active[0].style.color.triplet == Color.parse("#f0f0f0").triplet
+
+    assert isinstance(inactive[0].style, Style)
+    assert inactive[0].style.meta == {"@click": "range_clicked('Docs')"}
+    assert inactive[0].style.color.triplet != Color.parse("#f0f0f0").triplet
+
+
+def test_underline_row_carries_click_action_for_every_displayed_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+
+    line_break = next(
+        index for index, segment in enumerate(segments) if segment.text == "\n"
+    )
+    underline_segments = segments[line_break + 1 :]
+    clicks = [
+        segment.style.meta["@click"]
+        for segment in underline_segments
+        if segment.style is not None and "@click" in segment.style.meta
+    ]
+    assert list(dict.fromkeys(clicks)) == [
+        "range_clicked('Home')",
+        "range_clicked('Docs')",
+    ]
