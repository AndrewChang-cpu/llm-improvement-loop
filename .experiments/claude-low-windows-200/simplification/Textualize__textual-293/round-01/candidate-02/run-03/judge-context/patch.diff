+
+
+def _first_item(bar):
+    console = Console(width=20, file=io.StringIO(), color_system="truecolor")
+    return next(iter(bar.__rich_console__(console, console.options)))
+
+
+def _click(span):
+    assert isinstance(span.style, Style)
+    return span.style.meta.get("@click")
+
+
+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(1, 3),
+        clickable_ranges={"home": (0, 2), "docs": (2, 5)},
+        width=6,
+    )
+    text = _first_item(bar)
+    assert isinstance(text, Text)
+    home_span, docs_span = text.spans[-2], text.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 2)
+    assert _click(home_span) == "range_clicked('home')"
+    assert (docs_span.start, docs_span.end) == (2, 5)
+    assert _click(docs_span) == "range_clicked('docs')"
+    for span in text.spans[:-2]:
+        assert _click(span) is None
+
+
+def test_plain_text_has_half_glyphs_at_highlight_edges():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    assert _first_item(bar).plain == "━╸━━╺━"
+
+
+def test_early_path_spans_carry_no_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(9, 10), clickable_ranges={"home": (0, 2)}, width=6
+    )
+    text = _first_item(bar)
+    assert isinstance(text, Text)
+    assert text.spans
+    for span in text.spans:
+        assert _click(span) is None
+
+
+def test_no_highlight_early_path_carries_no_click_metadata():
+    bar = UnderlineBar(clickable_ranges={"home": (0, 2)}, width=6)
+    text = _first_item(bar)
+    assert text.spans
+    for span in text.spans:
+        assert _click(span) is None
+
+
+def test_zero_width_highlight_at_nonzero_position_gets_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(2, 2), clickable_ranges={"home": (0, 2)}, width=6
+    )
+    text = _first_item(bar)
+    assert _click(text.spans[-1]) == "range_clicked('home')"
