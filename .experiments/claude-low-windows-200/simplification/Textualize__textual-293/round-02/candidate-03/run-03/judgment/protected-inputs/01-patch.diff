@@ -0,0 +1,175 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable):
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def cells_by_row(tabs, width=100):
+    """Return, for each row, a list of (character, click action) pairs."""
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rows = [[]]
+    for segment in console.render(tabs.render(), console.options):
+        meta = segment.style.meta if segment.style else {}
+        for char in segment.text:
+            if char == "\n":
+                rows.append([])
+            else:
+                rows[-1].append((char, meta.get("@click")))
+    return rows
+
+
+def test_tab_equality_str_and_repr():
+    assert Tab("One", "a") == Tab("One", "a")
+    assert Tab("One", "a") != Tab("One", "b")
+    assert str(Tab("One", "a")) == "One"
+    assert repr(Tab("One", "a")) == "Tab(label='One', name='a')"
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+
+
+def test_construction_with_empty_tab_list_succeeds():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+
+
+def test_initial_active_tab_and_bar_position():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_name():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Uno", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_rules():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_first_character_search_wraps_and_skips_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana")],
+        active_tab="Apple",
+        search_by_first_character=False,
+    )
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    lines = plain_lines(Tabs([]).render())
+    assert lines == ["", "━" * 100]
+
+
+def test_label_row_uses_fixed_tab_padding():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], tab_padding=1)
+    rows = cells_by_row(tabs)
+    assert "".join(char for char, _ in rows[0]) == " One  Two "
+
+
+def test_auto_fit_padding_shares_width_across_flexible_edges():
+    # Width 100 with two 3-cell labels leaves 94 cells for four flexible padding
+    # edges. Each takes 23.5 cells, and the 0.5 fractions carry forward, so the
+    # edges resolve to 23, 24, 23, 24.
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    rows = cells_by_row(tabs)
+    expected = " " * 23 + "One" + " " * 24 + " " * 23 + "Two" + " " * 24
+    assert "".join(char for char, _ in rows[0]) == expected
+
+
+def test_duplicate_names_display_once_with_last_label_at_first_position():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Uno", "a")], tab_padding=1)
+    rows = cells_by_row(tabs)
+    assert "".join(char for char, _ in rows[0]) == " Uno  Two "
+
+
+def test_inactive_padded_cells_carry_their_own_click_action():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b")], active_tab="b", tab_padding=1
+    )
+    rows = cells_by_row(tabs)
+    label_row = rows[0]
+    assert [action for _, action in label_row[:5]] == ["range_clicked('a')"] * 5
+    assert [action for _, action in label_row[5:10]] == [None] * 5
+
+
+def test_underline_highlights_active_span_and_carries_click_actions():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b")], active_tab="b", tab_padding=1
+    )
+    rows = cells_by_row(tabs)
+    underline = rows[1]
+    # Active label "Two" occupies cells 6 to 8. The left glyph sits at cell 5 and
+    # the right glyph at cell 9.
+    assert "".join(char for char, _ in underline) == (
+        "━" * 5 + "╸" + "━" * 3 + "╺" + "━" * 90
+    )
+    # Underline cells carry the click action of their tab, including the active tab.
+    assert [action for _, action in underline[:5]] == ["range_clicked('a')"] * 5
+    assert [action for _, action in underline[5:10]] == ["range_clicked('b')"] * 5
