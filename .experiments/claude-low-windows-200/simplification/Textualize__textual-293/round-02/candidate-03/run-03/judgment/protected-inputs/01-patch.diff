diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..064e5f6
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,432 @@
+from __future__ import annotations
+
+import math
+from typing import List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = tuple("0123456789")
+
+
+class Tab:
+    """A single tab item for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str | None, optional): The name used to identify the tab when it is
+            selected. Defaults to the label when not given.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Return one tab per distinct name, in the order each name first appears.
+
+    Each entry uses the label of the last tab that carries that name.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs.
+
+    Returns:
+        List[Tab]: The tabs to display.
+    """
+    last_by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        last_by_name[tab.name] = tab
+    # Updating an existing key keeps its original position in the dict.
+    return list(last_by_name.values())
+
+
+class _TabEdge:
+    """A layout edge for the label row, consumed by the layout resolver.
+
+    Args:
+        size (int | None): A fixed size in cells, or None for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take.
+        fraction (int): The share of remaining space a flexible edge takes.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar for a Tabs widget.
+
+    The label row holds three edges per displayed tab: left padding, label, and
+    right padding. The second row is an UnderlineBar whose clickable ranges are the
+    selection range of each displayed tab.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): The fractional index of the underline into the
+            displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's label.
+        active_bar_style (StyleType): The style of the highlighted underline.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding in cells on each side of a label,
+            or None to share the remaining width between padding edges.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _edges(self, displayed: List[Tab]) -> List[_TabEdge]:
+        """Build the label-row edges: padding, label, padding for each tab."""
+        edges: List[_TabEdge] = []
+        for tab in displayed:
+            if self.tab_padding:
+                padding_edge = _TabEdge(size=self.tab_padding)
+            else:
+                padding_edge = _TabEdge()
+            edges.append(padding_edge)
+            edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(padding_edge)
+        return edges
+
+    def _highlight_range(
+        self, label_ranges: List[Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (List[Tuple[int, int]]): Label range of each displayed tab.
+
+        Returns:
+            Tuple[float, float]: The highlight range in cells.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), count - 1.0)
+        index = int(math.floor(position))
+        fraction = position - index
+        start, end = label_ranges[index]
+        # The next index wraps to the first tab after the last one.
+        next_start, next_end = label_ranges[(index + 1) % count]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        # Resolve every configured style before building any span.
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        displayed = displayed_tabs(self.tabs)
+        sizes = layout_resolve(width, self._edges(displayed))
+
+        label_ranges: List[Tuple[int, int]] = []
+        selection_ranges: dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[3 * index : 3 * index + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (cursor, selection_end)
+            cursor = selection_end
+
+            # The padded span is a single run, so its padding shares the label style.
+            padded = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action.
+                span: RenderableType = Text(
+                    padded,
+                    style=active_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+            else:
+                text = Text(
+                    padded,
+                    style=inactive_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                click_style = Style(meta={"@click": f"range_clicked('{tab.name}')"})
+                text.stylize(click_style, 0, len(padded))
+                span = Opacity(text, opacity=self.inactive_text_opacity)
+            yield from console.render(span, options)
+
+        # A line break separates the label row from the underline, even with no tabs.
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are selected by keyboard (left and right arrows, digit keys, and first
+    character search) or by mouse click. Tabs are identified by name.
+
+    Args:
+        tabs (List[Tab]): The tabs to show. May be empty.
+        active_tab (str | None, optional): The name of the initially active tab.
+            Defaults to None, which selects the first tab's name.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            labels, from 0 to 1. Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the
+            underline animation. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by
+            the underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): Fixed padding in cells on each side of a
+            label. Zero or None fits the padding to the available width. Defaults to
+            None.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            selects the next tab whose label starts with that character. Defaults to
+            True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            self.active_tab_style,
+            self.active_bar_style,
+            self.inactive_tab_style,
+            self.inactive_bar_style,
+            self.inactive_text_opacity,
+            self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs, or 0 if absent."""
+        names = [tab.name for tab in displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget receives key events.
+
+        With no tabs, the key is marked handled and nothing else happens. Escape
+        removes focus from the widget. Left and right move to the previous or next
+        tab, wrapping at either end. The keys 1 to 9 select the tab at that
+        position, and 0 uses the rule of ``activate_tab_by_number``. Any other
+        single character selects the next tab whose label starts with that
+        character, when ``search_by_first_character`` is true. Every key is marked
+        handled by preventing its default action. Propagation is not stopped, so
+        application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name) + 1
+        self._active_tab_name = self.tabs[index % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name) - 1
+        self._active_tab_name = self.tabs[index % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It never selects the
+        active tab, and it compares characters case-insensitively. Nothing happens
+        when ``search_by_first_character`` is false or when no tab matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        if not self.search_by_first_character:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.casefold()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label[:1].casefold() == target:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A number above the tab count is ignored. A number of 0 selects the tenth
+        tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Return the index of the first tab in the full list with a name.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The index of the first matching tab, or 0 when none matches.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Called when a tab label or underline is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
