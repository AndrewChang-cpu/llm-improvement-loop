+
+
+def first_item(bar):
+    console = Console()
+    items = list(bar.__rich_console__(console, console.options))
+    assert len(items) == 1
+    return items[0]
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (2, 6)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    first, second = item.spans[-2:]
+    assert (first.start, first.end) == (0, 2)
+    assert isinstance(first.style, Style)
+    assert first.style.meta == {"@click": "range_clicked('one')"}
+    assert (second.start, second.end) == (2, 6)
+    assert isinstance(second.style, Style)
+    assert second.style.meta == {"@click": "range_clicked('two')"}
+
+
+def test_highlight_plain_text_has_half_glyphs_at_fractional_edges():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 6)},
+        width=6,
+    )
+    assert first_item(bar).plain == "━╸━━╺━"
+
+
+def test_zero_width_early_path_spans_carry_no_click_metadata():
+    for highlight_range in [(0, 0), (4, 2)]:
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            clickable_ranges={"one": (0, 3)},
+            width=6,
+        )
+        item = first_item(bar)
+        assert item.plain == "━━━━━━"
+        for span in item.spans:
+            assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"one": (0, 6)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert item.spans[-1].style.meta == {"@click": "range_clicked('one')"}
