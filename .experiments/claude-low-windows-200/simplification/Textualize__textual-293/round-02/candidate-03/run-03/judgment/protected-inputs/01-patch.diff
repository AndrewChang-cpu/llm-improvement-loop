+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that mounts example Tabs widgets."""
+
+    def on_mount(self) -> None:
+        """Mount two tab rows directly on the app."""
+        self.mount(
+            first=Tabs([Tab("Home"), Tab("Projects"), Tab("Settings")]),
+            second=Tabs(
+                [Tab("Inbox", "inbox"), Tab("Sent", "sent"), Tab("Drafts", "drafts")],
+                active_tab="sent",
+            ),
+        )
+
+
+TabsDemoApp.run(log="textual.log")
