new file mode 100644
index 0000000..143d9c9
--- /dev/null
+++ b/tests/widgets/test_tabs.py
@@ -0,0 +1,130 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_SGR = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def make_renderable(tabs, active=None, bar_position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def rendered_lines(renderable):
+    plain = ANSI_SGR.sub("", render(renderable))
+    return plain.split("\n")
+
+
+def segments_of(renderable):
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "other")
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_empty_tab_list_and_defaults():
+    widget = Tabs([])
+    assert widget.find_tab_by_name("anything") == 0
+
+
+def test_empty_tab_list_renders_empty_label_row_and_full_underline():
+    lines = rendered_lines(make_renderable([], tab_padding=None))
+    assert lines[0] == ""
+    assert lines[1] == "━" * 100
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_name():
+    widget = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_fixed_padding_label_row():
+    lines = rendered_lines(make_renderable([Tab("Home"), Tab("Search")]))
+    assert lines[0].rstrip() == " Home  Search"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")]
+    lines = rendered_lines(make_renderable(tabs))
+    assert lines[0].rstrip() == " Gamma  Beta"
+
+
+def test_inactive_padded_span_carries_click_action_and_active_does_not():
+    tabs = [Tab("Alpha", "x"), Tab("Beta", "y")]
+    segments = segments_of(make_renderable(tabs, active="x"))
+
+    active_segment = next(s for s in segments if s.text == " Alpha ")
+    inactive_segment = next(s for s in segments if s.text == " Beta ")
+    assert "@click" not in active_segment.style.meta
+    assert inactive_segment.style.meta == {"@click": "range_clicked('y')"}
+
+
+def test_activate_next_and_previous_wrap_around():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "B"
+    widget.activate_next_tab()
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "A"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "B"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "C"
+    widget.activate_tab_by_number(4)
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs_uses_tenth():
+    widget = Tabs([Tab(f"T{index}") for index in range(12)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "T9"
+
+
+def test_first_char_search_skips_active_wraps_and_ignores_case():
+    widget = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado"), Tab("berry")])
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Avocado"
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "Apple"
+    widget.activate_tab_by_first_char("B")
+    assert widget._active_tab_name == "banana"
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "banana"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    widget = Tabs([Tab("A", "x"), Tab("B", "y")])
+    widget.action_range_clicked("y")
+    assert widget._active_tab_name == "y"
