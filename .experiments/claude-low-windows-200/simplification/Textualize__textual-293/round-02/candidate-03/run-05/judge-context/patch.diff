+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that mounts example Tabs widgets on the app."""
+
+    def on_mount(self):
+        """Mount the example tab rows."""
+        self.mount(
+            first=Tabs([Tab("Home"), Tab("Search"), Tab("Settings")]),
+            second=Tabs(
+                [Tab("Alpha", "a"), Tab("Beta", "b"), Tab("Gamma", "c")],
+                active_tab="b",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
