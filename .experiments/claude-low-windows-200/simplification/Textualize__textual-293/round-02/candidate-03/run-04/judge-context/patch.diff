+    assert (first_span.start, first_span.end) == (0, 3)
+    assert (second_span.start, second_span.end) == (3, 6)
+    assert isinstance(first_span.style, Style)
+    assert first_span.style.meta == {"@click": "range_clicked('first')"}
+    assert second_span.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_highlight_cells_and_half_cell_edges():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    assert _first_item(bar).plain == "━╸━━╺━"
+
+
+@pytest.mark.parametrize(
+    "highlight_range",
+    [(0, 0), (5, 2), (-5, -2)],
+)
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"only": (0, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert item.plain == "━━━━━━"
+    for span in item.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"only": (0, 6)},
+        width=6,
+    )
+    last_span = _first_item(bar).spans[-1]
+    assert isinstance(last_span.style, Style)
+    assert last_span.style.meta == {"@click": "range_clicked('only')"}
