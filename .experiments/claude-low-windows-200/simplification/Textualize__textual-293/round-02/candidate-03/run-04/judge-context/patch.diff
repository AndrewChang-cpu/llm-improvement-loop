+import io
+import re
+from typing import List
+
+from rich.color import Color
+from rich.console import Console
+from rich.segment import Segment
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable) -> List[str]:
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def label_segments(tabs: Tabs) -> List[Segment]:
+    """Return the segments of the label row, which ends at the first line break."""
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+    label: List[Segment] = []
+    for segment in segments:
+        if segment.text == "\n":
+            break
+        label.append(segment)
+    return label
+
+
+def test_tab_equality_and_text():
+    assert Tab("One") == Tab("One", "One")
+    assert Tab("One", "a") != Tab("One", "b")
+    assert str(Tab("One", "a")) == "One"
+    assert Tab("One").name == "One"
+    assert repr(Tab("One", "a")) == "Tab(label='One', name='a')"
+
+
+def test_construct_with_empty_and_non_empty_tab_lists():
+    assert Tabs([]).find_tab_by_name("missing") == 0
+    assert Tabs([Tab("One")]).find_tab_by_name("One") == 0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y")])
+    assert tabs._active_tab_name == "x"
+    assert tabs._bar_position == 0.0
+
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y")], active_tab="y")
+    assert tabs._active_tab_name == "y"
+    assert tabs._bar_position == 1.0
+
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y")], active_tab="unknown")
+    assert tabs._active_tab_name == "unknown"
+    assert tabs._bar_position == 0.0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y")])
+    tabs.action_range_clicked("y")
+    assert tabs._active_tab_name == "y"
+
+
+def test_no_tabs_rows_are_empty_then_full_width_underline():
+    lines = plain_lines(Tabs([]).render())
+    assert lines == ["", "━" * 100]
+
+
+def test_fixed_padding_label_row():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " One  Two "
+
+
+def test_auto_padding_label_row_shares_remaining_width():
+    # Width 100 minus the two labels leaves 98 cells for four flexible padding
+    # edges, 24.5 each. Whole cells are taken in order and the .5 carries forward,
+    # giving left/right padding of 24/25 for "A" and 24/25 for "B".
+    tabs = Tabs([Tab("A"), Tab("B")])
+    expected = " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+    assert plain_lines(tabs.render())[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("First", "x"), Tab("Second", "y"), Tab("Third", "x")], tab_padding=1
+    )
+    row = plain_lines(tabs.render())[0]
+    assert row == " Third  Second "
+    assert "First" not in row
+
+
+def test_inactive_padded_span_carries_click_action_and_is_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    segments = label_segments(tabs)
+
+    active = [segment for segment in segments if segment.text == " One "]
+    assert len(active) == 1
+    assert isinstance(active[0].style, Style)
+    assert "@click" not in active[0].style.meta
+
+    inactive = [
+        segment
+        for segment in segments
+        if segment.style.meta.get("@click") == "range_clicked('Two')"
+    ]
+    assert "".join(segment.text for segment in inactive) == " Two "
+    original = Color.parse("#f0f0f0").get_truecolor()
+    for segment in inactive:
+        assert segment.style.color.get_truecolor() != original
