+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+
+    first, second = item.spans[-2:]
+    assert isinstance(first.style, Style)
+    assert isinstance(second.style, Style)
+    assert (first.start, first.end) == (0, 3)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert (second.start, second.end) == (3, 6)
+    assert second.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    for highlight_range in [(0, 0), (3, 2), (-5, -2)]:
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            clickable_ranges={"tab": (0, 3)},
+            width=6,
+        )
+        item = first_item(bar)
+        assert isinstance(item, Text)
+        assert item.plain == "━━━━━━"
+        for span in item.spans:
+            assert isinstance(span.style, Style)
+            assert span.style.meta == {}
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"tab": (2, 4)},
+        width=6,
+    )
+    span = first_item(bar).spans[-1]
+    assert isinstance(span.style, Style)
+    assert (span.start, span.end) == (2, 4)
+    assert span.style.meta == {"@click": "range_clicked('tab')"}
