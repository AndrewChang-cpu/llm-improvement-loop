+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def make_row(tabs, active_tab_name=None, tab_padding=1, bar_position=0.0):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def plain_rows(renderable):
+    """Return the rendered rows with ANSI codes removed."""
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def styled_rows(renderable):
+    """Return each rendered row as a list of (character, style) pairs, one per cell."""
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    rows = [[]]
+    for segment in console.render(renderable):
+        if segment.text == "\n":
+            rows.append([])
+            continue
+        rows[-1].extend((char, segment.style) for char in segment.text)
+    return rows
+
+
+def meta_of(style):
+    assert isinstance(style, Style)
+    return style.meta
+
+
+def test_tab_equality_and_text():
+    assert Tab("Home") == Tab("Home", name="Home")
+    assert Tab("Home", name="other") != Tab("Home")
+    assert str(Tab("Home", name="other")) == "Home"
+    assert repr(Tab("Home", name="other")) == "Tab(label='Home', name='other')"
+
+
+def test_construct_with_default_styles():
+    assert Tabs([]).tabs == []
+    assert len(Tabs([Tab("A"), Tab("B")]).tabs) == 2
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    widget = Tabs([Tab("A", name="x"), Tab("B", name="y"), Tab("C", name="x")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "A"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "2"
+    widget.activate_tab_by_number(9)
+    assert widget._active_tab_name == "2"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    widget = Tabs([Tab(str(number)) for number in range(12)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "9"
+
+
+def test_activate_tab_by_first_char_wraps_and_skips_active():
+    widget = Tabs(
+        [Tab("Apple"), Tab("avocado"), Tab("Banana"), Tab("apricot")],
+        active_tab="Apple",
+    )
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "avocado"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "apricot"
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "Apple"
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    widget = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs([Tab("A"), Tab("B")])
+    widget.action_range_clicked("B")
+    assert widget._active_tab_name == "B"
+
+
+def test_no_tabs_row_layout():
+    assert plain_rows(make_row([])) == ["", "━" * 100]
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("A"), Tab("B", name="x"), Tab("C", name="x")]
+    rows = plain_rows(make_row(tabs, active_tab_name="A", tab_padding=1))
+    assert rows[0] == " A  C "
+    assert rows[1].startswith("╸━╺")
+
+
+def test_auto_fit_padding_shares_remaining_width():
+    # 100 cells, minus two one-cell labels, leaves 98 cells for four flexible
+    # padding edges: 24.5 each, with the fractional part carried forward.
+    rows = plain_rows(make_row([Tab("A"), Tab("B")], tab_padding=None))
+    assert rows[0] == " " * 24 + "A" + " " * 49 + "B" + " " * 25
+
+
+def test_label_cells_carry_click_action_only_when_inactive():
+    rows = styled_rows(make_row([Tab("A"), Tab("B")], active_tab_name="A"))
+    label_row = rows[0]
+    assert "".join(char for char, _ in label_row[:6]) == " A  B "
+    for _, style in label_row[:3]:
+        assert meta_of(style) == {}
+    for _, style in label_row[3:6]:
+        assert meta_of(style) == {"@click": "range_clicked('B')"}
+
+
+def test_underline_cells_carry_click_action_for_each_tab():
+    rows = styled_rows(make_row([Tab("A"), Tab("B")], active_tab_name="A"))
+    underline = rows[1]
+    for _, style in underline[:3]:
+        assert meta_of(style) == {"@click": "range_clicked('A')"}
+    for _, style in underline[3:6]:
+        assert meta_of(style) == {"@click": "range_clicked('B')"}
