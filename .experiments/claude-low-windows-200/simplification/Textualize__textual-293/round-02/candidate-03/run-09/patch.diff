+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that mounts example Tabs widgets directly on the app."""
+
+    def on_mount(self) -> None:
+        self.mount(
+            first=Tabs([Tab("Home"), Tab("Files"), Tab("Settings")]),
+            second=Tabs(
+                [Tab("One", name="one"), Tab("Two", name="two"), Tab("Three")],
+                active_tab="two",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemoApp.run(log="textual.log")
