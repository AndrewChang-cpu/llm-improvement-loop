diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..15cbf65
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,401 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab when selecting it.
+            Defaults to the label. Names are not required to be unique.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabEdge:
+    """A part of the label row (padding or label text) for the layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take.
+        fraction (int): The share of the remaining space a flexible edge takes.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    The label row is followed by a line break and then the underline bar.
+
+    Args:
+        tabs (list[Tab]): The full ordered list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs that places
+            the underline.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio that dims inactive tabs.
+        tab_padding (int, optional): Fixed padding in cells on each side of a label,
+            or ``None`` to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """Return one tab per distinct name, at the first occurrence's position.
+
+        Each entry uses the label of the last tab that has that name.
+        """
+        names = []
+        last_tab_by_name = {}
+        for tab in self.tabs:
+            if tab.name not in last_tab_by_name:
+                names.append(tab.name)
+            last_tab_by_name[tab.name] = tab
+        return [last_tab_by_name[name] for name in names]
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        # Resolve every style to a style object before any span is built.
+        active_tab_style = console.get_style(self.active_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        width = options.max_width
+        displayed = self._displayed_tabs()
+
+        # Three edges per tab: left padding, label, right padding.
+        # A falsy tab_padding (None or 0) makes the padding edges flexible.
+        padding = self.tab_padding or None
+        edges = []
+        for tab in displayed:
+            edges.append(_TabEdge(size=padding))
+            edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(_TabEdge(size=padding))
+        sizes = layout_resolve(width, edges)
+
+        label_ranges = []
+        selection_ranges = {}
+        label_pieces = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (cursor, selection_end)
+            cursor = selection_end
+
+            # The padded span is one text run, so its padding shares the label's style.
+            padded = " " * left + tab.label + " " * right
+            piece = Text(padded, end="", no_wrap=True)
+            if tab.name == self.active_tab_name:
+                piece.stylize(active_tab_style)
+            else:
+                click_style = inactive_tab_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                piece.stylize(click_style)
+                piece = Opacity(piece, opacity=self.inactive_text_opacity)
+            label_pieces.append(piece)
+
+        # The highlight interpolates between the label ranges of the floor index and
+        # the next index, wrapping at the end.
+        if displayed:
+            floor_position = math.floor(self.bar_position)
+            fraction = self.bar_position - floor_position
+            index = floor_position % len(displayed)
+            next_index = (index + 1) % len(displayed)
+            start_a, end_a = label_ranges[index]
+            start_b, end_b = label_ranges[next_index]
+            highlight_range = (
+                start_a + (start_b - start_a) * fraction,
+                end_a + (end_b - end_a) * fraction,
+            )
+        else:
+            highlight_range = (0, 0)
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield from label_pieces
+        yield Segment.line()
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by keyboard or mouse. Selection and activation identify tabs
+    by name. Tabs with duplicate names are displayed once, at the position of the
+    first occurrence, with the label of the last tab that has that name.
+
+    Args:
+        tabs (list[Tab]): The ordered tabs to display. May be empty.
+        active_tab (str, optional): The name of the tab to activate initially. If
+            ``None`` or empty, the first tab is active. A name that matches no tab is
+            kept, and the underline sits at index 0. Defaults to ``None``.
+        active_tab_style (StyleType): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the underline under the active
+            tab. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of the inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline
+            animation when the active tab changes. Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a
+            label. ``None`` or ``0`` fits the padding to the available width.
+            Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a key that is not a digit
+            or an arrow key activates the next tab whose label starts with that
+            character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            active_name: str | None = active_tab
+        elif tabs:
+            active_name = tabs[0].name
+        else:
+            active_name = None
+        self._active_tab_name = active_name
+        self._bar_position = float(self.find_tab_by_name(active_name))
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for selecting tabs.
+
+        Every key event is marked handled by preventing its default action. Propagation
+        is not stopped, so application bindings still receive the key.
+
+        With no tabs, the key is handled and nothing else happens.
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next or previous tab, wrapping at either end.
+        - The keys 1 through 9 activate the tab at that 1-based position. The key 0
+          follows the rule of ``activate_tab_by_number``.
+        - When ``search_by_first_character`` is true, any other single-character key
+          activates the next tab whose label starts with that character, ignoring
+          case. The active tab is never selected by this search.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and ignores case. It
+        never selects the active tab. If no other tab matches, the active tab is
+        unchanged.
+
+        Args:
+            char (str): The character to match against the first character of each
+                label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A number above the tab count is ignored. The number 0 activates the 10th tab
+        when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name in the full list.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the action of a click on a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
