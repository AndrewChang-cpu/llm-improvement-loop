diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..8f5b3ca
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,178 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.renderables.opacity import Opacity
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_SGR = re.compile(r"\x1b\[[0-9;]*m")
+WIDTH = 100  # The width used by the render helper.
+
+
+def plain(renderable):
+    return ANSI_SGR.sub("", render(renderable))
+
+
+def make_row(tabs, active=None, bar_position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def items_for(renderable):
+    console = Console(width=WIDTH, file=io.StringIO(), color_system="truecolor")
+    return list(renderable.__rich_console__(console, console.options)), console
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("A") == Tab("A", "A")
+    assert Tab("A", "x") != Tab("A", "y")
+    assert Tab("A", "x") != Tab("B", "x")
+
+
+def test_tab_text_form_is_label_and_repr_shows_both_fields():
+    tab = Tab("A", "x")
+    assert str(tab) == "A"
+    assert "label='A'" in repr(tab)
+    assert "name='x'" in repr(tab)
+
+
+def test_construction_with_empty_and_populated_tab_lists():
+    assert Tabs([]).tabs == []
+    assert len(Tabs([Tab("A")]).tabs) == 1
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_at_both_ends():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_follows_position_and_zero_rule():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab("T{}".format(number)) for number in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_row_is_empty_and_underline_is_full_width_inactive():
+    assert plain(make_row([])) == "\n" + "━" * WIDTH
+    assert plain(Tabs([]).render()) == "\n" + "━" * WIDTH
+
+
+def test_label_row_with_explicit_padding():
+    lines = plain(make_row([Tab("One"), Tab("Two")], active="One")).split("\n")
+    assert lines[0] == " One  Two "
+    # Highlight covers the label range 1 to 4: half-cell edges, then the tail.
+    assert lines[1] == "╸━━━╺" + "━" * 95
+
+
+def test_auto_fit_padding_shares_remaining_width():
+    # Edges for "A" and "B" with flexible padding: the four padding edges share
+    # 100 - 2 = 98 cells, giving 24, 25, 24, 25 with the fraction carried forward.
+    expected_row = " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+    lines = plain(make_row([Tab("A"), Tab("B")], active="A", tab_padding=0)).split(
+        "\n"
+    )
+    assert lines[0] == expected_row
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("First", "x"), Tab("Second", "y"), Tab("Third", "x")]
+    lines = plain(make_row(tabs, active="x")).split("\n")
+    assert lines[0] == " Third  Second "
+
+
+def test_active_span_has_no_click_and_inactive_span_has_click():
+    items, _ = items_for(make_row([Tab("One"), Tab("Two")], active="One"))
+    active_piece, inactive_piece = items[0], items[1]
+
+    for span in active_piece.spans:
+        assert "@click" not in span.style.meta
+
+    assert isinstance(inactive_piece, Opacity)
+    assert inactive_piece.opacity == 0.5
+    text = inactive_piece.renderable
+    assert text.plain == " Two "
+    assert text.spans[0].start == 0
+    assert text.spans[0].end == len(text.plain)
+    assert text.spans[0].style.meta == {"@click": "range_clicked('Two')"}
+
+
+def test_underline_clickable_ranges_cover_selection_ranges_including_active():
+    items, console = items_for(make_row([Tab("One"), Tab("Two")], active="One"))
+    bar = items[3]
+    assert isinstance(bar, UnderlineBar)
+    text = list(bar.__rich_console__(console, console.options))[0]
+    first, second = text.spans[-2], text.spans[-1]
+    assert (first.start, first.end) == (0, 3)
+    assert (second.start, second.end) == (3, 6)
+    assert first.style.meta == {"@click": "range_clicked('One')"}
+    assert second.style.meta == {"@click": "range_clicked('Two')"}
+
+
+def test_bar_position_moves_highlight_to_label_of_fractional_index():
+    lines = plain(
+        make_row([Tab("A"), Tab("B")], active="B", bar_position=1.0)
+    ).split("\n")
+    # Label B occupies cells 4 to 5 with padding 1.
+    assert lines[1] == "━━━╸━╺" + "━" * 94
