+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    css = """
+    Tabs {
+        margin: 1 2;
+    }
+    """
+
+    async def on_mount(self) -> None:
+        tabs = [Tab("Home"), Tab("Projects"), Tab("Settings"), Tab("Help")]
+        self.mount(Tabs(tabs))
+        self.mount(Tabs(tabs, active_tab="Settings", tab_padding=2))
+
+
+TabsDemo.run(log="textual.log")
