+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_rows(renderable):
+    """Return the rendered rows with ANSI codes removed."""
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def label_row_segments(renderable, width=100):
+    """Return the segments of the first row, before the line break."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    segments = []
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n":
+            break
+        segments.append(segment)
+    return segments
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "other")
+    assert Tab("Home", "h") != Tab("Start", "h")
+
+
+def test_tab_text_is_label_and_repr_shows_both_fields():
+    tab = Tab("Home", "h")
+    assert str(tab) == "Home"
+    assert "label='Home'" in repr(tab)
+    assert "name='h'" in repr(tab)
+
+
+def test_construction_accepts_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+    assert tabs._bar_position == 0.0
+
+
+def test_construction_with_tabs_uses_default_styles():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_bar_position_follows_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    assert tabs._active_tab_name == "C"
+    assert tabs._bar_position == 2.0
+
+
+def test_find_tab_by_name_returns_first_duplicate_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_no_tabs_renders_empty_label_row_and_full_width_underline():
+    rows = plain_rows(Tabs([]).render())
+    assert rows == ["", "━" * 100]
+
+
+def test_label_row_with_explicit_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    assert plain_rows(tabs.render())[0] == " One  Two "
+
+
+def test_label_row_with_auto_fit_padding():
+    # Width 100, labels "One" and "Two" take 6 cells, leaving 94 cells for four
+    # flexible edges. Each share is 23.5 cells. The fractional halves carry
+    # forward, so the edges get 23, 24, 23 and 24 cells in order.
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    expected = " " * 23 + "One" + " " * 24 + " " * 23 + "Two" + " " * 24
+    assert plain_rows(tabs.render())[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label_at_first_position():
+    tabs = Tabs(
+        [Tab("Alpha", "a"), Tab("Beta", "b"), Tab("Gamma", "a")], tab_padding=1
+    )
+    assert plain_rows(tabs.render())[0] == " Gamma  Beta "
+
+
+def test_active_tab_underline_highlights_its_label_span():
+    # With padding 1, the labels "A", "B" and "C" occupy columns 1, 4 and 7.
+    # The active tab "C" highlights column 7 of the 100-cell bar.
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C", tab_padding=1)
+    bar_row = plain_rows(tabs.render())[1]
+    assert bar_row == "━" * 6 + "╸" + "━" + "╺" + "━" * 91
+
+
+def test_inactive_padded_span_carries_click_action_and_is_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    segments = label_row_segments(tabs.render())
+    two = [segment for segment in segments if segment.text == " Two "]
+    assert len(two) == 1
+    style = two[0].style
+    assert isinstance(style, Style)
+    assert style.meta == {"@click": "range_clicked('Two')"}
+    original_color = Color.parse("#f0f0f0")
+    assert style.color.triplet != original_color.triplet
+
+
+def test_active_padded_span_has_no_click_action():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    segments = label_row_segments(tabs.render())
+    one = [segment for segment in segments if segment.text == " One "]
+    assert len(one) == 1
+    assert isinstance(one[0].style, Style)
+    assert one[0].style.meta == {}
+
+
+def test_next_and_previous_wrap_over_full_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_selects_position_and_ignores_overflow():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "3"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_first_character_search_wraps_skips_active_and_ignores_case():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("p")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
