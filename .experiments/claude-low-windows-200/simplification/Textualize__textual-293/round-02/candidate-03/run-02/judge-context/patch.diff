+
+
+def test_clickable_ranges_attach_click_actions_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+        width=6,
+    )
+    item = _first_item(bar, max_width=6)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    click_spans = item.spans[-2:]
+    assert [(span.start, span.end) for span in click_spans] == [(0, 3), (3, 6)]
+    assert isinstance(click_spans[0].style, Style)
+    assert click_spans[0].style.meta == {"@click": "range_clicked('first')"}
+    assert click_spans[1].style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_zero_width_early_path_adds_no_click_metadata():
+    ranges = [(0, 0), (3, 1), (-2, -1)]
+    for highlight_range in ranges:
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            clickable_ranges={"first": (0, 3)},
+            width=6,
+        )
+        item = _first_item(bar, max_width=6)
+        assert isinstance(item, Text)
+        assert item.plain == "━━━━━━"
+        for span in item.spans:
+            assert isinstance(span.style, Style)
+            assert span.style.meta == {}
+
+
+def test_zero_width_highlight_at_nonzero_position_receives_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"first": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar, max_width=6)
+    assert item.spans[-1].style.meta == {"@click": "range_clicked('first')"}
