diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..2463875
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,455 @@
+from __future__ import annotations
+
+from math import floor
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str | None, optional): The name used to identify the tab when it is
+            selected or activated. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[tuple[str, str]]:
+    """Return one (name, label) entry per distinct name.
+
+    Each name is placed where it first appears and uses the label of the last
+    tab that has that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[tuple[str, str]]: The displayed (name, label) pairs in display order.
+    """
+    order: list[str] = []
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        if tab.name not in labels:
+            order.append(tab.name)
+        labels[tab.name] = tab.label
+    return [(name, labels[name]) for name in order]
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver.
+
+    Args:
+        size (int | None): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int, optional): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int, optional): The share of flexible space. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    The label row holds one padded span per displayed tab. The underline bar
+    highlights the active position and carries a click range for each tab.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): The fractional index into the displayed tabs that
+            places the underline.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted underline.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int | None): A fixed padding size in cells, or ``None`` (or
+            zero) to fit the padding automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Resolve every configured style before building any span
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_row: list[Segment] = []
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+
+        cursor = 0
+        for (name, label), (left, label_cells, right) in zip(
+            displayed, self._layout(width, displayed)
+        ):
+            span_cells = left + label_cells + right
+            label_start = cursor + left
+            label_ranges[name] = (label_start, label_start + label_cells)
+            selection_ranges[name] = (cursor, cursor + span_cells)
+            cursor += span_cells
+
+            # The whole padded span is one run, so padding shares the label's style
+            run = " " * left + label + " " * right
+            if name == self.active_tab_name:
+                run_text = Text(
+                    run, style=active_tab_style, end="", no_wrap=True, overflow="ignore"
+                )
+                label_row.extend(console.render(run_text, options))
+            else:
+                click_style = inactive_tab_style + Style(
+                    meta={"@click": f"range_clicked('{name}')"}
+                )
+                run_text = Text(
+                    run, style=click_style, end="", no_wrap=True, overflow="ignore"
+                )
+                dimmed = Opacity(run_text, opacity=self.inactive_text_opacity)
+                label_row.extend(console.render(dimmed, options))
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(displayed, label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield from label_row
+        yield Segment.line()
+        yield from console.render(bar, options)
+
+    def _layout(
+        self, width: int, displayed: list[tuple[str, str]]
+    ) -> list[tuple[int, int, int]]:
+        """Compute the left padding, label, and right padding cells for each tab.
+
+        Args:
+            width (int): The available width in cells.
+            displayed (list[tuple[str, str]]): The displayed (name, label) pairs.
+
+        Returns:
+            list[tuple[int, int, int]]: One (left, label, right) cell count per tab.
+        """
+        padding = self.tab_padding or None
+        edges: list[_Edge] = []
+        for _, label in displayed:
+            edges.append(_Edge(padding))
+            edges.append(_Edge(cell_len(label)))
+            edges.append(_Edge(padding))
+
+        # A zero-width label edge would be read as flexible by the resolver, so it is
+        # left out of the resolver and given zero cells directly.
+        sized = [edge for edge in edges if edge.size != 0]
+        resolved = iter(layout_resolve(width, sized))
+        sizes = [0 if edge.size == 0 else next(resolved) for edge in edges]
+        return [
+            (sizes[index], sizes[index + 1], sizes[index + 2])
+            for index in range(0, len(sizes), 3)
+        ]
+
+    def _highlight_range(
+        self,
+        displayed: list[tuple[str, str]],
+        label_ranges: dict[str, tuple[int, int]],
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position.
+
+        The highlight moves between the label range at the floor index and the
+        label range at the next index, wrapping after the last tab.
+
+        Args:
+            displayed (list[tuple[str, str]]): The displayed (name, label) pairs.
+            label_ranges (dict[str, tuple[int, int]]): Label ranges keyed by name.
+
+        Returns:
+            tuple[float, float]: The highlight range in cells.
+        """
+        count = len(displayed)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), count - 1)
+        base = floor(position)
+        fraction = position - base
+        names = [name for name, _ in displayed]
+        current = label_ranges[names[base]]
+        following = label_ranges[names[(base + 1) % count]]
+        start = current[0] + fraction * (following[0] - current[0])
+        end = current[1] + fraction * (following[1] - current[1])
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by name. Duplicate names display once, at the position of
+    the first occurrence and with the label of the last tab that has the name.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. May be empty.
+        active_tab (str | None, optional): The name of the tab that starts active.
+            Defaults to ``None``, which selects the first tab's name. A name that
+            matches no tab is kept, and the underline starts at position 0.
+        active_tab_style (StyleType, optional): The style of the active tab's label
+            and padding. Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels
+            and padding. Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tabs, where 1 is fully visible and 0 is hidden. Defaults to 0.5.
+        animation_duration (float, optional): The time in seconds for the underline
+            to move to a new active tab. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used
+            for the underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): A fixed number of cells of padding on
+            each side of a label, or ``None`` (or 0) to fit padding to the width.
+            Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            that is not a digit selects the next tab whose label starts with that
+            character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name in the displayed tabs, or 0 if it is not shown."""
+        names = [name for name, _ in _displayed_tabs(self.tabs)]
+        if tab_name is not None and tab_name in names:
+            return names.index(tab_name)
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list of the first tab with that name, or
+                0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full list active, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full list active, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, and
+        never selects the active tab. The comparison ignores case. If no tab matches,
+        the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        start = self.find_tab_by_name(self._active_tab_name)
+        count = len(self.tabs)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        Numbers are 1-based positions in the full list. A number above the tab count
+        is ignored. Number 0 activates the 10th tab when there are at least ten tabs,
+        and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            tab = self.tabs[9] if len(self.tabs) >= 10 else self.tabs[-1]
+        else:
+            tab = self.tabs[tab_number - 1]
+        self._active_tab_name = tab.name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with a given name active. Used by clicks on the tab bar.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the widget has focus.
+
+        Every key event is marked handled, and propagation is not stopped, so
+        application bindings still receive the key. With no tabs, nothing else
+        happens. Otherwise:
+
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - Escape removes focus from the widget.
+        - The digits 1 to 9 activate the tab at that 1-based position, and 0 follows
+          the rule of ``activate_tab_by_number``. Other digit-like characters are
+          not digit keys.
+        - Any other single character activates the next tab whose label starts with
+          that character, when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    async def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the position of the new active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+
+__all__ = ["Tab", "Tabs"]
