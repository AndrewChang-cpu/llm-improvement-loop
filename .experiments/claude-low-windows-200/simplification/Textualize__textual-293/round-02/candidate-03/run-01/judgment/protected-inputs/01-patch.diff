+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that mounts example Tabs widgets."""
+
+    def on_mount(self):
+        """Mount the example tab bars."""
+        self.mount(
+            plain=Tabs([Tab("Home"), Tab("Files"), Tab("Settings")]),
+            numbered=Tabs(
+                [Tab(f"Tab {number}", f"tab-{number}") for number in range(1, 12)],
+                active_tab="tab-3",
+                tab_padding=2,
+            ),
+            duplicates=Tabs(
+                [Tab("Inbox", "mail"), Tab("Sent", "mail"), Tab("Drafts")],
+                active_tab="mail",
+            ),
+        )
+
+
+TabsDemoApp.run(log="textual.log")
