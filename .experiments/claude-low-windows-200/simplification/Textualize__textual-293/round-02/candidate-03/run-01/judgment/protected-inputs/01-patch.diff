--- /dev/null
+++ b/tests/widgets/test_tabs.py
@@ -0,0 +1,163 @@
+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def _segments(renderable, width: int = 100):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def _tab_renderable(tabs, active_tab_name=None, tab_padding=1) -> TabsRenderable:
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_equality_repr_and_text():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "h") != Tab("Home", "home")
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+    assert str(Tab("Home", "h")) == "Home"
+
+
+def test_name_defaults_to_label():
+    assert Tab("Files").name == "Files"
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("Inbox", "mail"), Tab("Sent", "sent"), Tab("Copy", "mail")])
+    assert tabs.find_tab_by_name("mail") == 0
+    assert tabs.find_tab_by_name("sent") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_over_full_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_navigation_uses_first_occurrence_of_duplicate_name():
+    tabs = Tabs([Tab("A", "x"), Tab("B"), Tab("C", "x")], active_tab="x")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_positions_and_zero_rule():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 4)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+
+    many = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+    many.activate_tab_by_number(0)
+    assert many._active_tab_name == "T10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado")], active_tab="Avocado")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab_by_name():
+    tabs = Tabs([Tab("One", "1"), Tab("Two", "2")])
+    tabs.action_range_clicked("2")
+    assert tabs._active_tab_name == "2"
+
+
+def test_unknown_active_tab_is_kept_and_bar_starts_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_bar_position_follows_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], active_tab="Three")
+    assert tabs._bar_position == 2.0
+
+
+def test_empty_tab_list_constructs_with_default_styles():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_nonempty_tab_list_constructs_with_default_styles():
+    tabs = Tabs([Tab("One")])
+    assert tabs._active_tab_name == "One"
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_underline():
+    lines = _plain(Tabs([]).render()).split("\n")
+    assert lines[0] == ""
+    assert lines[1] == "━" * 100
+
+
+def test_label_row_with_explicit_padding():
+    row = _plain(_tab_renderable([Tab("One"), Tab("Two")], "One")).split("\n")[0]
+    assert row == " One  Two "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("Inbox", "mail"), Tab("Sent", "sent"), Tab("Drafts", "mail")]
+    row = _plain(_tab_renderable(tabs, "sent")).split("\n")[0]
+    assert row == " Drafts  Sent "
+
+
+def test_inactive_padded_span_is_dimmed_and_clickable():
+    console_style = Console(file=io.StringIO(), color_system="truecolor").get_style(
+        "#f0f0f0 on #021720"
+    )
+    segments = _segments(_tab_renderable([Tab("One"), Tab("Two")], "One"))
+    two = next(segment for segment in segments if "Two" in segment.text)
+    assert two.text == " Two "
+    assert isinstance(two.style, Style)
+    assert two.style.meta == {"@click": "range_clicked('Two')"}
+    assert two.style.color.triplet != console_style.color.triplet
+
+
+def test_active_padded_span_has_no_click_action():
+    segments = _segments(_tab_renderable([Tab("One"), Tab("Two")], "One"))
+    one = next(segment for segment in segments if "One" in segment.text)
+    assert one.text == " One "
+    assert isinstance(one.style, Style)
+    assert "@click" not in one.style.meta
