+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows Tabs widgets."""
+
+    def on_mount(self) -> None:
+        """Mount example tab bars directly on the app."""
+        names = ["Home", "Search", "Settings", "Help", "About"]
+        self.mount(
+            first=Tabs([Tab(name) for name in names]),
+            second=Tabs([Tab(name) for name in names], active_tab="Settings"),
+            third=Tabs([Tab(name) for name in names], tab_padding=2),
+        )
+
+
+TabsDemoApp.run(log="textual.log")
