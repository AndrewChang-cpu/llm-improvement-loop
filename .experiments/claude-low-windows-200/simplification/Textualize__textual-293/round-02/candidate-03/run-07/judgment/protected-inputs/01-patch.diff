diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..dc6cb43
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,430 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+__all__ = ["Tab", "Tabs"]
+
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A single tab in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str | None, optional): The name that identifies the tab when selecting
+            it. Names do not have to be unique. Defaults to ``None``, which uses the
+            label as the name.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabEdge:
+    """Edge description consumed by the shared layout resolver."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Return one tab per distinct name, in order of first appearance.
+
+    Each returned tab carries the label of the last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+
+    Returns:
+        list[Tab]: The tabs that are displayed.
+    """
+    # Assigning to an existing key keeps its original position and replaces its value,
+    # so the result is ordered by first appearance and uses the last label.
+    by_name: dict = {}
+    for tab in tabs:
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+def _highlight_range(
+    bar_position: float, label_ranges: list[tuple[int, int]]
+) -> tuple[float, float]:
+    """Interpolate the highlight between two adjacent label ranges.
+
+    Args:
+        bar_position (float): Fractional index into the displayed tabs.
+        label_ranges (list[tuple[int, int]]): Label range of each displayed tab.
+
+    Returns:
+        tuple[float, float]: The highlight range in columns.
+    """
+    count = len(label_ranges)
+    if count == 0:
+        return (0, 0)
+    floor_position = math.floor(bar_position)
+    fraction = bar_position - floor_position
+    index = floor_position % count
+    next_index = (index + 1) % count
+    start, end = label_ranges[index]
+    next_start, next_end = label_ranges[next_index]
+    return (
+        start + (next_start - start) * fraction,
+        end + (next_end - end) * fraction,
+    )
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding on each side of a label, or ``None``
+            (or zero) to share the remaining width between the padding cells.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Resolve every style to a style object before any span uses it.
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        # A zero padding is treated as absent, so the padding edges are flexible.
+        padding_size = self.tab_padding or None
+
+        edges: list[_TabEdge] = []
+        for tab in displayed:
+            edges.append(_TabEdge(size=padding_size))
+            edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(_TabEdge(size=padding_size))
+        sizes = layout_resolve(width, edges)
+
+        label_pieces: list[RenderableType] = []
+        label_ranges: list[tuple[int, int]] = []
+        click_ranges: dict[str, tuple[int, int]] = {}
+
+        column = 0
+        for position, tab in enumerate(displayed):
+            left, label_size, right = sizes[3 * position : 3 * position + 3]
+            label_start = column + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+
+            label_ranges.append((label_start, label_end))
+            # The selection range covers the padded span, so padding is clickable.
+            click_ranges[tab.name] = (column, span_end)
+
+            # The padded span is one text run that shares the label's style.
+            padded = (
+                " " * left
+                + tab.label
+                + " " * (label_size - cell_len(tab.label) + right)
+            )
+            is_active = tab.name == self.active_tab_name
+            piece = Text(
+                padded,
+                style=active_tab_style if is_active else inactive_tab_style,
+                no_wrap=True,
+                overflow="crop",
+                end="",
+            )
+            if is_active:
+                label_pieces.append(piece)
+            else:
+                piece.apply_meta({"@click": f"range_clicked('{tab.name}')"})
+                label_pieces.append(
+                    Opacity(piece, opacity=self.inactive_text_opacity)
+                )
+            column = span_end
+
+        highlight = _highlight_range(self.bar_position, label_ranges)
+
+        for piece in label_pieces:
+            yield piece
+        yield Segment.line()
+        yield UnderlineBar(
+            highlight_range=highlight,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=click_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The widget occupies two rows. Tab labels are on the first row and the
+    underline is on the second. Tabs are selected by keyboard or by mouse click.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. The list may be empty.
+        active_tab (str | None, optional): The name of the initially active tab. If
+            this is ``None`` or empty, the first tab is active. A name that matches
+            no tab is kept, and the underline then sits at index zero. Defaults to
+            ``None``.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive tab
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): Number of cells of padding on each side
+            of a label. ``None`` or zero fits the padding to the available width.
+            Defaults to ``None``.
+        search_by_first_character (bool, optional): If True, pressing a letter key
+            activates the next tab whose label starts with that letter. Defaults to
+            True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name in the displayed tabs, or 0 if it is absent."""
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list, or 0
+                if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around the full list. The
+        comparison ignores case. The active tab is never selected, and the active
+        tab is unchanged when nothing matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        Number 0 selects the tenth tab when there are at least ten tabs, and the last
+        tab otherwise. A number above the tab count does nothing.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            tab = self.tabs[9] if len(self.tabs) >= 10 else self.tabs[-1]
+        else:
+            tab = self.tabs[tab_number - 1]
+        self._active_tab_name = tab.name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with a given name. Used as the click action of a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        With no tabs, the key is only marked as handled. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left move to the next or previous tab, wrapping at either end.
+        - The digits 1 to 9 activate the tab at that 1-based position. The digit 0
+          follows the rule of ``activate_tab_by_number``.
+        - Any other single character activates the next tab whose label starts with
+          that character, when ``search_by_first_character`` is True.
+
+        Every key is marked as handled, and the event still propagates.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
