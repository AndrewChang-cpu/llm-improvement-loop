+    first_span, second_span = text.spans[-2], text.spans[-1]
+    assert (first_span.start, first_span.end) == (0, 2)
+    assert first_span.style.meta == {"@click": "range_clicked('first')"}
+    assert (second_span.start, second_span.end) == (2, 6)
+    assert second_span.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        clickable_ranges={"tab": (0, 6)},
+        width=6,
+    )
+    text = _first_item(bar)
+
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"tab": (0, 6)},
+        width=6,
+    )
+    text = _first_item(bar)
+
+    assert isinstance(text, Text)
+    last_span = text.spans[-1]
+    assert (last_span.start, last_span.end) == (0, 6)
+    assert last_span.style.meta == {"@click": "range_clicked('tab')"}
