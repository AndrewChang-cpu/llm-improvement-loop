+import io
+
+from rich.console import Console
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def _rows(renderable, width=20):
+    """Render to rows of (character, style) pairs for per-cell checks."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    rows = [[]]
+    for segment in console.render(renderable, console.options):
+        for char in segment.text:
+            if char == "\n":
+                rows.append([])
+            else:
+                rows[-1].append((char, segment.style))
+    return rows
+
+
+def _text(row):
+    return "".join(char for char, _ in row)
+
+
+def _meta(style):
+    return style.meta if style else {}
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("One") == Tab("One", "One")
+    assert Tab("One", "a") != Tab("One", "b")
+    assert str(Tab("One", "a")) == "One"
+    assert repr(Tab("One", "a")) == "Tab(label='One', name='a')"
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+
+
+def test_construction_with_empty_and_default_styles():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert Tabs([Tab("One")]).tabs == [Tab("One")]
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    rows = _rows(Tabs([]).render())
+
+    assert _text(rows[0]) == ""
+    assert _text(rows[1]) == "━" * 20
+
+
+def test_label_row_and_underline_with_fixed_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    rows = _rows(tabs.render())
+
+    # Each label has one cell of padding on each side.
+    assert _text(rows[0]) == " One  Two "
+    # The first tab is active, so its label range is columns 1 to 4.
+    assert _text(rows[1]) == "╸━━━╺" + "━" * 15
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], tab_padding=1)
+    rows = _rows(tabs.render())
+
+    assert _text(rows[0]) == " Three  Two "
+    # The active name "a" is the first displayed tab, with label columns 1 to 6.
+    assert _text(rows[1]) == "╸━━━━━╺" + "━" * 13
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "a"), Tab("Three", "a")])
+
+    assert tabs.find_tab_by_name("a") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_click_ranges_cover_padded_spans_on_both_rows():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    rows = _rows(tabs.render())
+
+    # The active label carries no click action.
+    assert _meta(rows[0][1][1]) == {}
+    # The inactive padded span, including its padding, carries its own click action.
+    for column in range(5, 10):
+        assert _meta(rows[0][column][1]) == {"@click": "range_clicked('Two')"}
+        assert _meta(rows[1][column][1]) == {"@click": "range_clicked('Two')"}
+    # The active tab's underline cells carry its click action.
+    for column in range(0, 5):
+        assert _meta(rows[1][column][1]) == {"@click": "range_clicked('One')"}
+
+
+def test_inactive_label_and_padding_share_dimmed_style():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    rows = _rows(tabs.render())
+
+    active_color = rows[0][1][1].color.triplet
+    inactive_padding_color = rows[0][5][1].color.triplet
+    inactive_label_color = rows[0][6][1].color.triplet
+
+    assert inactive_padding_color == inactive_label_color
+    assert inactive_label_color != active_color
+
+
+def test_navigation_wraps_in_both_directions():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_follows_rule():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "T3"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_uses_last():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("avocado"), Tab("Banana")])
+
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "avocado"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+
+    tabs.action_range_clicked("Three")
+    assert tabs._active_tab_name == "Three"
+
+
+def test_unknown_active_tab_is_kept_and_bar_starts_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Missing")
+
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+
+    assert tabs._active_tab_name is None
