+@pytest.mark.parametrize("highlight_range", [(0, 0), (3, 1)])
+def test_zero_width_early_path_adds_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    text = _first_item(bar)
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    text = _first_item(bar)
+    home_span = text.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
