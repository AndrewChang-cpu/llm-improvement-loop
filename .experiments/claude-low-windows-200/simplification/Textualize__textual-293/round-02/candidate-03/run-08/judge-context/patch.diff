diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..5045ff0
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,440 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A single entry in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab when selecting it.
+            Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge for the layout resolver. ``None`` size means flexible."""
+
+    def __init__(self, size: int | None) -> None:
+        self.size = size
+        self.min_size = 1
+        self.fraction = 1
+
+
+class _TabSpan:
+    """Column positions of one displayed tab on the label row."""
+
+    def __init__(
+        self,
+        name: str,
+        label: str,
+        left: int,
+        label_cells: int,
+        right: int,
+        span_start: int,
+        label_start: int,
+        label_end: int,
+        span_end: int,
+    ) -> None:
+        self.name = name
+        self.label = label
+        self.left = left
+        self.label_cells = label_cells
+        self.right = right
+        self.span_start = span_start
+        self.label_start = label_start
+        self.label_end = label_end
+        self.span_end = span_end
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[tuple[str, str]]:
+    """Return one ``(name, label)`` pair per distinct name.
+
+    Each name is placed where it first appears and uses the label of the last
+    tab with that name.
+    """
+    names = []
+    labels = {}
+    for tab in tabs:
+        if tab.name not in labels:
+            names.append(tab.name)
+        labels[tab.name] = tab.label
+    return [(name, labels[name]) for name in names]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs that places
+            the underline.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tab labels.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding on each side of a label, or ``None``
+            (or zero) to fit padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _tab_spans(self, width: int) -> list[_TabSpan]:
+        """Work out the column positions of every displayed tab."""
+        displayed = _displayed_tabs(self.tabs)
+        padding = self.tab_padding or None
+        edges = []
+        for _name, label in displayed:
+            edges.append(_Edge(padding))
+            edges.append(_Edge(cell_len(label)))
+            edges.append(_Edge(padding))
+        sizes = layout_resolve(width, edges)
+
+        spans = []
+        position = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_cells, right = sizes[3 * index : 3 * index + 3]
+            span_start = position
+            label_start = span_start + left
+            label_end = label_start + label_cells
+            span_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    name,
+                    label,
+                    left,
+                    label_cells,
+                    right,
+                    span_start,
+                    label_start,
+                    label_end,
+                    span_end,
+                )
+            )
+            position = span_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the label range at the bar position, wrapping at the end."""
+        count = len(spans)
+        index = min(max(int(math.floor(self.bar_position)), 0), count - 1)
+        fraction = min(max(self.bar_position - index, 0.0), 1.0)
+        current = spans[index]
+        following = spans[(index + 1) % count]
+        start = current.label_start + (
+            following.label_start - current.label_start
+        ) * fraction
+        end = current.label_end + (following.label_end - current.label_end) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        # Resolve every configured style before building any span.
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        spans = self._tab_spans(width)
+
+        # Label row: each padded span is one text run.
+        for span in spans:
+            padded = (
+                " " * span.left
+                + span.label
+                + " " * (span.label_cells - cell_len(span.label))
+                + " " * span.right
+            )
+            if span.name == self.active_tab_name:
+                yield Text(
+                    padded,
+                    style=active_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+            else:
+                piece = Text(
+                    padded,
+                    style=inactive_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                piece.apply_meta(
+                    {"@click": f"range_clicked({span.name!r})"}, 0, len(padded)
+                )
+                yield Opacity(piece, opacity=self.inactive_text_opacity)
+        yield Text("", end="\n")
+
+        # Underline row.
+        highlight_range = self._highlight_range(spans) if spans else (0, 0)
+        clickable_ranges = {
+            span.name: (span.span_start, span.span_end) for span in spans
+        }
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by name. Keys: Left and Right move to the previous or next
+    tab with wrap-around; digit keys 1 to 9 select by position; 0 selects the 10th
+    tab (or the last tab when there are fewer than ten); other single characters
+    select the next tab whose label starts with that character, when search by
+    first character is enabled. Escape removes focus from the widget. Clicking a
+    tab selects it.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab's name when there are tabs.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the underline under the active tab.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where 1
+            is fully visible. Defaults to ``0.5``.
+        animation_duration (float): Duration in seconds of the underline animation.
+            Defaults to ``0.3``.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Cells of padding on each side of a label. Defaults
+            to ``None``, which fits padding to the available width. Zero is treated
+            as ``None``.
+        search_by_first_character (bool): Whether pressing a character key selects the
+            next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. The comparison is
+        case-insensitive. The active tab is never selected. If no other tab
+        matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match against the first letter of a label.
+        """
+        count = len(self.tabs)
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.label[:1].lower() == target:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        Args:
+            tab_number (int): The 1-based position. A value above the tab count is
+                ignored. ``0`` selects the 10th tab when there are at least ten tabs,
+                and the last tab otherwise.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the target of tab click actions.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for navigating and selecting tabs.
+
+        Every key event is marked handled, and propagation continues so that
+        application bindings still receive keys.
+
+        With no tabs, nothing else happens. Left and Right move to the previous or
+        next tab with wrap-around. Escape removes focus from the widget. Digits 1 to 9
+        select the tab at that position, and 0 follows the rule of
+        ``activate_tab_by_number``. When search by first character is enabled, other
+        single-character keys select the next tab whose label starts with that
+        character.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
