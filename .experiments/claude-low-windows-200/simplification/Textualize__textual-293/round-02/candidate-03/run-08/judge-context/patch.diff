+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _renderable(tabs, active=None, position=0.0, padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=padding,
+    )
+
+
+def _plain_render(renderable):
+    return ANSI.sub("", render(renderable))
+
+
+def _cell_styles(renderable, width):
+    """Return (character, style) for each cell of the first row."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    cells = []
+    for segment in console.render(renderable, console.options):
+        for char in segment.text:
+            if char == "\n":
+                return cells
+            cells.append((char, segment.style))
+    return cells
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+    assert str(Tab("Home", "home")) == "Home"
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_construction_with_default_styles_and_empty_list():
+    assert Tabs([]).tabs == []
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_names():
+    tabs = Tabs([Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_with_few_tabs():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("banana"), Tab("Avocado"), Tab("apricot")],
+        active_tab="Apple",
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Banana")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_row_is_empty_and_underline_is_full_width_inactive():
+    assert _plain_render(_renderable([])) == "\n" + "━" * 100
+
+
+def test_fixed_padding_label_row():
+    renderable = _renderable(
+        [Tab("Home"), Tab("Docs")], active="Home", padding=1
+    )
+    lines = _plain_render(renderable).split("\n")
+    assert lines[0] == " Home  Docs "
+
+
+def test_auto_fit_label_row_uses_layout_shares():
+    # Width 100. Two labels of one cell take 2 cells, leaving 98 cells for four
+    # flexible padding edges: 24.5 each. The resolver gives 24, 25, 24, 25.
+    renderable = _renderable([Tab("A"), Tab("B")], active="A")
+    lines = _plain_render(renderable).split("\n")
+    assert lines[0] == " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+
+
+def test_zero_padding_is_auto_fit():
+    auto = _plain_render(_renderable([Tab("A"), Tab("B")], active="A"))
+    zero = _plain_render(_renderable([Tab("A"), Tab("B")], active="A", padding=0))
+    assert auto == zero
+
+
+def test_duplicate_names_display_once_with_last_label():
+    renderable = _renderable(
+        [Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")],
+        active="x",
+        padding=1,
+    )
+    lines = _plain_render(renderable).split("\n")
+    assert lines[0] == " Gamma  Beta "
+
+
+def test_inactive_padding_cells_carry_click_action_and_active_does_not():
+    renderable = _renderable([Tab("Home"), Tab("Docs")], active="Home", padding=1)
+    cells = _cell_styles(renderable, 12)
+    # " Home  Docs ": the active span covers cells 0-5 and "Docs" covers 6-11.
+    active_style = cells[1][1]
+    assert isinstance(active_style, Style)
+    assert "@click" not in active_style.meta
+    for index in (6, 7, 11):
+        style = cells[index][1]
+        assert isinstance(style, Style)
+        assert style.meta == {"@click": "range_clicked('Docs')"}
