+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that mounts example Tabs widgets."""
+
+    def on_mount(self) -> None:
+        tabs = [Tab("Home"), Tab("Docs"), Tab("Settings"), Tab("Help")]
+        self.mount(
+            default=Tabs(tabs),
+            padded=Tabs(tabs, active_tab="Docs", tab_padding=2),
+            fixed=Tabs(
+                [Tab("One", "1"), Tab("Two", "2")], search_by_first_character=False
+            ),
+        )
+
+
+TabsDemoApp.run(log="textual.log")
