+import io
+import re
+
+from rich.console import Console
+from rich.segment import Segment
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_SEQUENCE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ANSI_SEQUENCE.sub("", render(renderable))
+
+
+def make_renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def label_segments(renderable):
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    labels = []
+    for item in renderable.__rich_console__(console, console.options):
+        if isinstance(item, Segment) and item.text == "\n":
+            break
+        labels.append(item)
+    return labels
+
+
+def test_tab_equality_text_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert str(Tab("Home", "a")) == "Home"
+    assert repr(Tab("Home", "a")) == "Tab(label='Home', name='a')"
+
+
+def test_construction_with_empty_tab_list_succeeds():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_names():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_unknown_active_tab_is_kept_and_bar_starts_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_underline():
+    rows = plain(make_renderable([])).split("\n")
+    assert rows == ["", "━" * 100]
+
+
+def test_auto_fit_padding_shares_remaining_width():
+    rows = plain(make_renderable([Tab("Home"), Tab("Docs")])).split("\n")
+    # 100 cells minus two 4-cell labels leaves 92 cells over four padding edges.
+    expected = " " * 23 + "Home" + " " * 46 + "Docs" + " " * 23
+    assert rows[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label_at_first_position():
+    renderable = make_renderable(
+        [Tab("Home", "a"), Tab("Docs", "b"), Tab("Index", "a")], tab_padding=1
+    )
+    rows = plain(renderable).split("\n")
+    assert rows[0] == " Index  Docs "
+
+
+def test_underline_highlights_active_label_with_half_cell_edges():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("Docs")], active_tab_name="Docs", bar_position=1.0,
+        tab_padding=1,
+    )
+    rows = plain(renderable).split("\n")
+    # Docs occupies cells 6 to 12 with its label at cells 7 to 11.
+    expected = "━" * 6 + "╸" + "━" * 4 + "╺" + "━" * 88
+    assert rows[1] == expected
+
+
+def test_inactive_padded_span_is_dimmed_and_carries_click_action():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("Docs")], active_tab_name="Home", tab_padding=1
+    )
+    active, inactive = label_segments(renderable)
+
+    assert active.text == " Home "
+    assert active.style.meta == {}
+    assert inactive.text == " Docs "
+    assert inactive.style.meta == {"@click": "range_clicked('Docs')"}
+    assert inactive.style.color != active.style.color
+
+
+def test_initial_active_tab_and_bar_position_follow_active_tab_argument():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    assert tabs._active_tab_name == "Docs"
+    assert tabs._bar_position == 1.0
+
+
+def test_next_and_previous_wrap_over_full_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_maps_positions_and_zero_rule():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "10"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_uses_last():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_first_character_search_wraps_skips_active_and_ignores_no_match():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("Help")], active_tab="Home")
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Help"
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "Home"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_action_range_clicked_activates_named_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
