+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (5, 2), (-3, -1)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 2)},
+        width=6,
+    )
+    text = first_item(bar)
+
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert span.style.meta == {}
+
+
+def test_zero_width_highlight_at_non_zero_position_gets_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"home": (3, 3)},
+        width=6,
+    )
+    text = first_item(bar)
+
+    assert text.plain == "━━╸╺━━"
+    assert text.spans[-1].style.meta == {"@click": "range_clicked('home')"}
