@@ -0,0 +1,453 @@
+from __future__ import annotations
+
+import math
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A single tab in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge description for the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[tuple[str, str]]:
+    """Get the (name, label) pairs shown in the tab row.
+
+    Each name appears once, at the position of its first occurrence, and shows the
+    label of the last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[tuple[str, str]]: The displayed (name, label) pairs in display order.
+    """
+    labels: dict = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return list(labels.items())
+
+
+def _cell_widths(
+    labels: list[str], tab_padding: int | None, total: int
+) -> list[int]:
+    """Compute the cell widths of the edges of each displayed tab.
+
+    Each tab contributes three edges: left padding, label, and right padding. Padding
+    is flexible when ``tab_padding`` is absent or zero, and fixed otherwise.
+
+    Args:
+        labels (list[str]): The labels of the displayed tabs, in display order.
+        tab_padding (int, optional): The fixed padding size, or ``None`` to auto-fit.
+        total (int): The width available for the tab row.
+
+    Returns:
+        list[int]: Three widths per label: left padding, label, right padding.
+    """
+    pad_size = tab_padding if tab_padding else None
+    edges: list[_Edge] = []
+    # Index into ``edges`` for each of the three widths of each tab, or ``None`` for
+    # an empty label, which has no edge and is given zero width.
+    slots: list[int | None] = []
+    for label in labels:
+        label_width = cell_len(label)
+        slots.append(len(edges))
+        edges.append(_Edge(size=pad_size))
+        if label_width:
+            slots.append(len(edges))
+            edges.append(_Edge(size=label_width))
+        else:
+            slots.append(None)
+        slots.append(len(edges))
+        edges.append(_Edge(size=pad_size))
+
+    resolved = layout_resolve(total, edges)
+    return [resolved[slot] if slot is not None else 0 for slot in slots]
+
+
+def _interpolate_highlight(
+    label_ranges: list[tuple[int, int]], position: float
+) -> tuple[float, float]:
+    """Interpolate the highlight range for a fractional bar position.
+
+    The highlight runs from the label range at the floor index to the label range at
+    the next index, wrapping at the end of the list.
+
+    Args:
+        label_ranges (list[tuple[int, int]]): The (start, end) label range of each
+            displayed tab.
+        position (float): The fractional bar position.
+
+    Returns:
+        tuple[float, float]: The (start, end) highlight range in cells.
+    """
+    count = len(label_ranges)
+    if not count:
+        return (0, 0)
+    floor_position = math.floor(position)
+    fraction = position - floor_position
+    index = floor_position % count
+    next_index = (index + 1) % count
+    start_from, end_from = label_ranges[index]
+    start_to, end_to = label_ranges[next_index]
+    start = start_from + (start_to - start_from) * fraction
+    end = end_from + (end_to - end_from) * fraction
+    return (start, end)
+
+
+def _range_click_action(tab_name: str) -> str:
+    """Build the click action for a tab name.
+
+    Args:
+        tab_name (str): The tab name.
+
+    Returns:
+        str: The action string, such as ``range_clicked('home')``.
+    """
+    return f"range_clicked('{tab_name}')"
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): The fractional index of the bar into the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab label.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int, optional): The fixed padding size, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        displayed = _displayed_tabs(self.tabs)
+        widths = _cell_widths(
+            [label for _, label in displayed], self.tab_padding, options.max_width
+        )
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict = {}
+        cursor = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_width, right = widths[index * 3 : index * 3 + 3]
+            selection_ranges[name] = (cursor, cursor + left + label_width + right)
+            label_start = cursor + left
+            label_ranges.append((label_start, label_start + label_width))
+            cursor += left + label_width + right
+
+            padded = " " * left + label + " " * right
+            is_active = name == self.active_tab_name
+            if is_active:
+                # The active tab carries no click action.
+                piece_style = active_style
+            else:
+                # Inactive tabs carry their own click action on the whole padded span.
+                piece_style = inactive_style + Style(
+                    meta={"@click": _range_click_action(name)}
+                )
+            piece = Text(end="", no_wrap=True, overflow="crop")
+            piece.append(padded, style=piece_style)
+            if is_active:
+                renderable: RenderableType = piece
+            else:
+                renderable = Opacity(piece, opacity=self.inactive_text_opacity)
+            yield from console.render(renderable, options)
+
+        # The underline row starts on a new line.
+        yield Segment.line()
+
+        highlight_range = _interpolate_highlight(label_ranges, self.bar_position)
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are selected with the keyboard or the mouse. The selected tab is identified by
+    name, and the underline moves to it with an animation.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. The list may be empty.
+        active_tab (str, optional): The name of the tab to select first. When absent or
+            empty, the first tab is selected. Defaults to None.
+        active_tab_style (StyleType): The style of the active tab label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels, where
+            1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation, in seconds.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function used for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells of padding on each side of a
+            label. When absent or zero, padding is sized to fit the widget width.
+            Defaults to None.
+        search_by_first_character (bool): Whether pressing a letter key selects the next
+            tab whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            active_tab_name (str, optional): The name of the newly active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard input for tab selection.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Right and left activate the next or previous tab, wrapping at the ends.
+        - Escape removes focus from the widget by awaiting ``set_focus(None)`` on the app.
+        - The digits 1 to 9 activate the tab at that position. The 0 key follows the
+          rule of ``activate_tab_by_number``.
+        - Other single-character keys, when ``search_by_first_character`` is true,
+          activate the next tab whose label starts with that character, ignoring case.
+
+        Every key event is marked handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, ignores
+        case, and never selects the active tab. If no tab matches, nothing changes.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A number above the tab count is ignored. The number 0 activates the 10th tab
+        when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str, optional): The tab name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with a given name when its label or underline is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
