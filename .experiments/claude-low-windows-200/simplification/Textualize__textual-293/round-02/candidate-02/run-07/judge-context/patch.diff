+    home_span, docs_span = text.spans[-2], text.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert _click_meta(home_span) == "range_clicked('home')"
+    assert (docs_span.start, docs_span.end) == (3, 6)
+    assert _click_meta(docs_span) == "range_clicked('docs')"
+
+
+def test_highlight_cells_and_half_glyphs_at_edges():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    text = _render_items(bar)[0]
+    assert text.plain == "━╸━━╺━"
+
+
+@pytest.mark.parametrize(
+    "highlight_range",
+    [(0, 0), (3, 1), (-5, -2)],
+)
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 3), "docs": (3, 6)},
+        width=6,
+    )
+    items = _render_items(bar)
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert _click_meta(span) is None
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    text = _render_items(bar)[0]
+    assert text.plain == "━╸╺━━━"
+    assert "range_clicked('home')" in [_click_meta(span) for span in text.spans]
