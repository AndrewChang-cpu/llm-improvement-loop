+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _rows(widget):
+    """Render a Tabs widget with the test helper and return its plain rows."""
+    return ANSI_CODE.sub("", render(widget.render())).split("\n")
+
+
+def _segments(widget, width=40):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(widget.render().__rich_console__(console, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "home") == Tab("Home", "home")
+    assert Tab("Home", "home") != Tab("Home", "other")
+    assert str(Tab("Home", "home")) == "Home"
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_construction_with_default_styles_succeeds_for_empty_list():
+    widget = Tabs([])
+    assert widget.find_tab_by_name("anything") == 0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    widget = Tabs([Tab("First", "a"), Tab("Second", "b"), Tab("Last", "a")])
+    assert widget.find_tab_by_name("a") == 0
+    assert widget.find_tab_by_name("b") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    widget = Tabs([Tab("Home", "home"), Tab("Docs", "docs")])
+    assert widget._active_tab_name == "home"
+    assert widget._bar_position == 0.0
+
+
+def test_initial_active_tab_uses_given_name():
+    widget = Tabs([Tab("Home", "home"), Tab("Docs", "docs")], active_tab="docs")
+    assert widget._active_tab_name == "docs"
+    assert widget._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    widget = Tabs([Tab("Home", "home")], active_tab="missing")
+    assert widget._active_tab_name == "missing"
+    assert widget._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    widget = Tabs([], active_tab="home")
+    assert widget._active_tab_name is None
+
+
+def test_next_and_previous_wrap_around():
+    widget = Tabs(
+        [Tab("A", "a"), Tab("B", "b"), Tab("C", "c")], active_tab="c"
+    )
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "a"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = [Tab(str(number), str(number)) for number in range(1, 6)]
+    widget = Tabs(tabs)
+    widget.activate_tab_by_number(3)
+    assert widget._active_tab_name == "3"
+    widget.activate_tab_by_number(9)
+    assert widget._active_tab_name == "3"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "5"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = [Tab(str(number), str(number)) for number in range(1, 13)]
+    widget = Tabs(tabs)
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    widget = Tabs(
+        [
+            Tab("Apple", "a"),
+            Tab("Avocado", "v"),
+            Tab("Banana", "b"),
+            Tab("apricot", "p"),
+        ]
+    )
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "v"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "p"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "a"
+
+
+def test_first_character_search_never_selects_active_tab():
+    widget = Tabs([Tab("Apple", "a"), Tab("Banana", "b")], active_tab="a")
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "a"
+
+
+def test_first_character_search_without_match_changes_nothing():
+    widget = Tabs([Tab("Apple", "a"), Tab("Banana", "b")], active_tab="b")
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "b"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    widget = Tabs([Tab("Home", "home"), Tab("Docs", "docs")])
+    widget.action_range_clicked("docs")
+    assert widget._active_tab_name == "docs"
+
+
+def test_label_row_with_fixed_padding():
+    widget = Tabs(
+        [Tab("Home", "home"), Tab("Docs", "docs")],
+        active_tab="home",
+        tab_padding=1,
+    )
+    rows = _rows(widget)
+    assert rows[0] == " Home  Docs "
+
+
+def test_label_row_auto_fit_shares_space_between_padding_edges():
+    widget = Tabs([Tab("Home", "home"), Tab("Docs", "docs")])
+    rows = _rows(widget)
+    # Four flexible padding edges share the 100 - 8 = 92 remaining cells: 23 each.
+    pad = " " * 23
+    assert rows[0] == pad + "Home" + pad + pad + "Docs" + pad
+
+
+def test_duplicate_names_display_once_with_last_label():
+    widget = Tabs(
+        [Tab("First", "a"), Tab("Second", "b"), Tab("Last", "a")],
+        tab_padding=1,
+    )
+    rows = _rows(widget)
+    assert rows[0] == " Last  Second "
+
+
+def test_no_tabs_shows_empty_label_row_and_full_width_underline():
+    rows = _rows(Tabs([]))
+    assert rows[0] == ""
+    assert rows[1] == "━" * 100
+
+
+def test_underline_highlights_active_label_span():
+    widget = Tabs([Tab("Home", "home"), Tab("Docs", "docs")], tab_padding=1)
+    rows = _rows(widget)
+    # The active label "Home" occupies cells 1 to 4, so the highlight covers 1 to 5.
+    assert rows[1] == "╸" + "━" * 4 + "╺" + "━" * 94
+
+
+def test_inactive_padded_span_is_dimmed_and_carries_click_action():
+    widget = Tabs(
+        [Tab("Home", "home"), Tab("Docs", "docs")],
+        active_tab="home",
+        tab_padding=1,
+    )
+    segments = _segments(widget)
+    docs = next(segment for segment in segments if "Docs" in segment.text)
+    home = next(segment for segment in segments if "Home" in segment.text)
+
+    assert docs.text == " Docs "
+    assert docs.style.meta == {"@click": "range_clicked('docs')"}
+    assert docs.style.color != Style.parse("#f0f0f0").color
+
+    assert home.text == " Home "
+    assert home.style.meta == {}
+    assert home.style.color == Style.parse("#f0f0f0").color
