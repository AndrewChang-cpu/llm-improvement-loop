+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows Tabs widgets directly on the App."""
+
+    def on_mount(self):
+        """Mount two tab bars with different settings."""
+        tabs = [
+            Tab("Home"),
+            Tab("Files"),
+            Tab("Settings"),
+            Tab("Help"),
+        ]
+        self.mount(
+            first=Tabs(tabs),
+            second=Tabs(tabs, active_tab="Settings", tab_padding=2),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
