@@ -0,0 +1,143 @@
+import io
+import re
+from types import SimpleNamespace
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+BAR = "━"
+
+
+def _plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def _label_row(tabs: Tabs) -> Text:
+    console = Console(file=io.StringIO(), width=40, color_system="truecolor")
+    options = SimpleNamespace(max_width=40)
+    return next(iter(tabs.render().__rich_console__(console, options)))
+
+
+def _span_at(text: Text, offset: int):
+    covering = [span for span in text.spans if span.start <= offset < span.end]
+    assert covering, f"no span covers offset {offset}"
+    return covering[-1]
+
+
+def test_default_construction_with_empty_list():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert tab == Tab("Home", name="Home")
+    assert tab != Tab("Home", name="Other")
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c", name="b")])
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_no_tabs_row_layout():
+    lines = _plain(Tabs([]).render()).split("\n")
+    assert lines[0] == ""
+    assert lines[1] == BAR * 100
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Files")], tab_padding=1)
+    first_line = _plain(tabs.render()).split("\n")[0]
+    assert first_line.rstrip() == " Home  Files"
+
+
+def test_underline_highlights_active_label_span():
+    tabs = Tabs([Tab("Home"), Tab("Files")], active_tab="Files", tab_padding=1)
+    underline = _plain(tabs.render()).split("\n")[1]
+    # " Home " occupies cells 0-5 and " Files " occupies cells 6-12.
+    assert underline[6] == "╸"
+    assert underline[7:12] == BAR * 5
+    assert underline[12] == "╺"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C", name="A")], tab_padding=1)
+    first_line = _plain(tabs.render()).split("\n")[0]
+    assert first_line.rstrip() == " C  B"
+
+
+def test_inactive_label_has_click_action_and_active_does_not():
+    tabs = Tabs([Tab("Home"), Tab("Files")], active_tab="Home", tab_padding=1)
+    row = _label_row(tabs)
+    active_span = _span_at(row, 2)
+    assert isinstance(active_span.style, Style)
+    assert "@click" not in active_span.style.meta
+
+    inactive_span = _span_at(row, 8)
+    assert isinstance(inactive_span.style, Style)
+    assert inactive_span.style.meta == {"@click": "range_clicked('Files')"}
+    # The left padding cell of the inactive tab shares its label's click action.
+    padding_span = _span_at(row, 6)
+    assert padding_span.style.meta == {"@click": "range_clicked('Files')"}
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_initial_active_tab_is_respected():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_first_char_search_without_match_changes_nothing():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
