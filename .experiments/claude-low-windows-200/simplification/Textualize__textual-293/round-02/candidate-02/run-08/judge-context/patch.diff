+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (2, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    first_click, second_click = item.spans[-2], item.spans[-1]
+    assert (first_click.start, first_click.end) == (0, 2)
+    assert _click_meta(first_click) == {"@click": "range_clicked('one')"}
+    assert (second_click.start, second_click.end) == (2, 6)
+    assert _click_meta(second_click) == {"@click": "range_clicked('two')"}
