@@ -0,0 +1,410 @@
+from __future__ import annotations
+
+import math
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab entry for the :class:`Tabs` widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the tab row: either a fixed size or a flexible share.
+
+    Args:
+        size (int, optional): The fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The relative share of a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Return one tab per distinct name, in the position of its first occurrence.
+
+    The tab kept for each name is the last one with that name, so its label wins.
+    """
+    by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+def _highlight_range(
+    label_ranges: Sequence[tuple[int, int]], position: float
+) -> tuple[float, float]:
+    """Interpolate the highlight between two adjacent label ranges.
+
+    Args:
+        label_ranges (Sequence[tuple[int, int]]): The label range of each displayed tab.
+        position (float): The fractional index of the bar into the displayed tabs.
+
+    Returns:
+        tuple[float, float]: The highlight range, or ``(0, 0)`` when there are no tabs.
+    """
+    count = len(label_ranges)
+    if count == 0:
+        return (0, 0)
+    position = min(max(position, 0.0), float(count - 1))
+    index = int(math.floor(position))
+    fraction = position - index
+    next_index = (index + 1) % count
+    start_a, end_a = label_ranges[index]
+    start_b, end_b = label_ranges[next_index]
+    start = start_a + (start_b - start_a) * fraction
+    end = end_a + (end_b - end_a) * fraction
+    return (start, end)
+
+
+class TabsRenderable:
+    """Render the tab labels and the underline bar of a :class:`Tabs` widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list. Duplicate names are shown once.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): The fractional index of the bar into the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab label.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int, optional): The fixed padding on each side of a label, or
+            ``None`` (or zero) to share the free space between the padding edges.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Each displayed tab contributes three edges: left padding, label, and
+        # right padding.
+        fixed_padding = self.tab_padding or None
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=fixed_padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=fixed_padding))
+        sizes = layout_resolve(width, edges)
+
+        label_row: list[RenderableType] = []
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+
+        column = 0
+        for index, tab in enumerate(displayed):
+            left_padding = sizes[3 * index]
+            right_padding = sizes[3 * index + 2]
+            label_width = cell_len(tab.label)
+            span_width = left_padding + label_width + right_padding
+
+            label_ranges.append(
+                (column + left_padding, column + left_padding + label_width)
+            )
+            selection_ranges[tab.name] = (column, column + span_width)
+            column += span_width
+
+            # The padded span is one text run, so its padding shares the label's
+            # style and click action.
+            padded = " " * left_padding + tab.label + " " * right_padding
+            if tab.name == self.active_tab_name:
+                style = console.get_style(self.active_tab_style)
+                label_row.append(
+                    Text(padded, style=style, no_wrap=True, overflow="crop", end="")
+                )
+            else:
+                style = console.get_style(self.inactive_tab_style)
+                text = Text(
+                    padded, style=style, no_wrap=True, overflow="crop", end=""
+                )
+                text.apply_meta(
+                    {"@click": f"range_clicked('{tab.name}')"}, 0, len(padded)
+                )
+                label_row.append(Opacity(text, opacity=self.inactive_text_opacity))
+
+        for renderable in label_row:
+            yield from console.render(renderable, options)
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=_highlight_range(label_ranges, self.bar_position),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tab labels with an animated underline bar.
+
+    Tabs are selected with the keyboard or the mouse. The selected tab is shown
+    with the active label style, and the underline bar slides to it.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. May be empty.
+        active_tab (str, optional): The name of the tab to activate first. When
+            absent or empty, the first tab is active. Defaults to ``None``.
+        active_tab_style (StyleType): The style of the active tab label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline bar.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration of the bar animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the bar
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a
+            label. When absent or zero, the padding fits the available width.
+            Defaults to ``None``.
+        search_by_first_character (bool): When true, pressing a letter key activates
+            the next tab whose label starts with that letter. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self._tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self._tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self._tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._bar_index_of(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def _bar_index_of(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs, or 0 if absent."""
+        for index, tab in enumerate(_displayed_tabs(self._tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        # Slide the underline to the newly active tab instead of jumping.
+        self.animate(
+            "_bar_position",
+            float(self._bar_index_of(tab_name)),
+            easing=self.animation_function,
+            duration=self.animation_duration,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation for the tabs.
+
+        Right and left move the active tab to the next or previous tab, wrapping
+        around. Escape removes focus from the widget. Keys 1 through 9 activate the
+        tab at that position, and 0 follows the rule of ``activate_tab_by_number``.
+        Other single-character keys activate the next tab whose label starts with
+        that character, when ``search_by_first_character`` is enabled. Every key
+        event is marked handled, and propagation continues so that application
+        bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self._tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        index = (index + 1) % len(self._tabs)
+        self._active_tab_name = self._tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        index = (index - 1) % len(self._tabs)
+        self._active_tab_name = self._tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around. It never selects
+        the active tab, and it leaves the active tab unchanged when nothing matches.
+        The comparison is case-insensitive.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self._tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for step in range(1, count):
+            tab = self._tabs[(start + step) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label[:1].lower() == wanted:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A number above the tab count is ignored. Zero activates the tenth tab when
+        there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0 as described above.
+        """
+        count = len(self._tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self._tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Return the index of the first tab in the full list with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab matches.
+        """
+        for index, tab in enumerate(self._tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab.
+
+        This is the action that clickable label and underline spans dispatch to.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
