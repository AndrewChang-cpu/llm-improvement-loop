+        item = first_item(bar)
+        assert isinstance(item, Text)
+        assert item.plain == "━" * 6
+        for span in item.spans:
+            assert click_meta(span.style) is None
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"a": (0, 3)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    assert click_meta(item.spans[-1].style) == "range_clicked('a')"
+
+
+def test_highlight_edges_show_half_glyphs_as_one_text_object():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
