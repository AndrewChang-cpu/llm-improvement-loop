+import io
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+
+def styled_rows(renderable, width):
+    """Return each row as a list of (character, style) cells."""
+    console = Console(
+        width=width,
+        file=io.StringIO(),
+        color_system="truecolor",
+        legacy_windows=False,
+    )
+    rows = [[]]
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n":
+            rows.append([])
+            continue
+        for char in segment.text:
+            rows[-1].append((char, segment.style))
+    return rows
+
+
+def plain(row):
+    return "".join(char for char, _ in row)
+
+
+def meta_of(style):
+    assert isinstance(style, Style)
+    return style.meta.get("@click")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_text_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "other")
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_construction_with_default_styles_and_tabs():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_given_tab():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_with_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "x"), Tab("C")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("C") == 2
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "T2"
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "T2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_zero_with_fewer_than_ten_tabs_activates_last_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_never_selects_active_tab_or_no_match():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    rows = styled_rows(Tabs([]).render(), 20)
+    assert len(rows) == 2
+    assert plain(rows[0]) == ""
+    assert plain(rows[1]) == "━" * 20
+
+
+def test_auto_fit_padding_shares_free_width_through_layout_rule():
+    # 30 cells, labels of 1 and 2 cells: 27 free cells over four flexible
+    # padding edges gives 6.75 each, carried as 6, 7, 7, 7.
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    row = plain(styled_rows(tabs.render(), 30)[0])
+    expected = " " * 6 + "A" + " " * 14 + "BB" + " " * 7
+    assert row.rstrip() == expected.rstrip()
+
+
+def test_duplicate_names_show_once_with_last_label():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs"), Tab("Start", "h")], tab_padding=1)
+    row = plain(styled_rows(tabs.render(), 40)[0])
+    assert row.strip() == "Start  Docs"
+
+
+def test_zero_tab_padding_is_treated_as_auto_fit():
+    auto = Tabs([Tab("A"), Tab("BB")], tab_padding=None)
+    zero = Tabs([Tab("A"), Tab("BB")], tab_padding=0)
+    assert render(auto.render()) == render(zero.render())
+
+
+def test_inactive_padded_span_is_dimmed_and_clickable():
+    tabs = Tabs([Tab("A"), Tab("BB")], active_tab="A", tab_padding=1)
+    row = styled_rows(tabs.render(), 20)[0]
+    assert plain(row)[:7] == " A  BB "
+
+    active_color = Color.parse("#f0f0f0").triplet
+    assert row[1][1].color.triplet == active_color
+    assert meta_of(row[1][1]) is None
+
+    for index in (3, 4):
+        style = row[index][1]
+        assert meta_of(style) == "range_clicked('BB')"
+        assert style.color.triplet != active_color
+
+
+def test_underline_highlights_active_label_and_carries_click_ranges():
+    tabs = Tabs([Tab("A"), Tab("BB")], active_tab="BB", tab_padding=1)
+    row = styled_rows(tabs.render(), 20)[1]
+    assert plain(row)[:7] == "━━━╸━━╺"
+    assert row[4][1].color.triplet == Color.parse("#1BB152").triplet
+    assert meta_of(row[0][1]) == "range_clicked('A')"
+    assert meta_of(row[4][1]) == "range_clicked('BB')"
