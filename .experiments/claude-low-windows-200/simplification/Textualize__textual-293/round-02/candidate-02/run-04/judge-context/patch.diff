+def test_clickable_ranges_add_click_spans_last_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(1, 3),
+        clickable_ranges={"first": (0, 2), "second": (2, 6)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    first_span, second_span = item.spans[-2], item.spans[-1]
+    assert (first_span.start, first_span.end) == (0, 2)
+    assert (second_span.start, second_span.end) == (2, 6)
+    assert click_meta(first_span.style) == "range_clicked('first')"
+    assert click_meta(second_span.style) == "range_clicked('second')"
+
