+from __future__ import annotations
+
+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_rows(renderable):
+    """Render with the test helper and return the rows without ANSI codes."""
+    return [ANSI_CODE.sub("", row) for row in render(renderable).split("\n")]
+
+
+def label_segments(renderable, width=40):
+    """Render to segments, which keep the style objects and their metadata."""
+    console = Console(width=width, file=io.StringIO())
+    return list(console.render(renderable, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "first").name == "first"
+    assert str(Tab("One", "first")) == "One"
+
+
+def test_tab_equality_compares_label_and_name():
+    assert Tab("One", "first") == Tab("One", "first")
+    assert Tab("One", "first") != Tab("One", "other")
+    assert Tab("One", "first") != Tab("Two", "first")
+
+
+def test_empty_tab_list_constructs_and_renders_empty_label_row():
+    tabs = Tabs([])
+    assert plain_rows(tabs.render()) == ["", "━" * 100]
+
+
+def test_construction_with_default_styles_succeeds():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs.find_tab_by_name("Two") == 1
+
+
+def test_labels_and_underline_with_fixed_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    rows = plain_rows(tabs.render())
+    assert rows[0] == " One  Two "
+    # Highlight covers the label "One" at columns 1 to 4
+    assert rows[1] == "╸━━━╺" + "━" * 95
+
+
+def test_auto_fit_padding_shares_remaining_width():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    rows = plain_rows(tabs.render())
+    # 98 cells remain for four flexible padding edges, a share of 24.5 each.
+    # Whole cells go to the earlier edges first and the half cell is carried:
+    # left 24, right 25 for "A", then left 24, right 25 for "B".
+    expected = " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+    assert rows[0] == expected
+    assert len(rows[0]) == 100
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    tabs = Tabs([Tab("One", "x"), Tab("Two"), Tab("Three", "x")], tab_padding=1)
+    rows = plain_rows(tabs.render())
+    assert rows[0] == " Three  Two "
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_name():
+    tabs = Tabs([Tab("A", "dup"), Tab("B"), Tab("C", "dup")])
+    assert tabs.find_tab_by_name("dup") == 0
+    assert tabs.find_tab_by_name("missing") == 0
+    assert tabs.find_tab_by_name("B") == 1
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_initial_active_tab_is_kept_with_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="zz")
+    assert tabs._active_tab_name == "zz"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([], active_tab="zz")
+    assert tabs._active_tab_name is None
+
+
+def test_next_and_previous_tab_wrap_around():
+    tabs = Tabs([Tab("Alpha"), Tab("Beta"), Tab("Gamma")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Gamma"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Alpha"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Beta"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 4)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "T2"
+
+
+def test_activate_tab_by_number_zero_selects_last_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 4)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T3"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_number_above_count_changes_nothing():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B")
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+
+
+def test_first_character_search_is_case_insensitive_and_starts_after_active():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_with_no_match_changes_nothing():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_the_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_is_skipped_when_disabled():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana")], search_by_first_character=False
+    )
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("Alpha"), Tab("Beta"), Tab("Gamma")])
+    tabs.action_range_clicked("Gamma")
+    assert tabs._active_tab_name == "Gamma"
+
+
+def test_inactive_label_is_clickable_and_dimmed_while_active_is_not():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    segments = label_segments(tabs.render())
+    active = next(segment for segment in segments if segment.text == " One ")
+    inactive = next(segment for segment in segments if segment.text == " Two ")
+
+    assert "@click" not in active.style.meta
+    assert active.style.color.triplet == Color.parse("#f0f0f0").triplet
+
+    assert inactive.style.meta == {"@click": "range_clicked('Two')"}
+    assert inactive.style.color.triplet != Color.parse("#f0f0f0").triplet
