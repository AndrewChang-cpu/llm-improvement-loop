+    click_spans = item.spans[-2:]
+    assert [(span.start, span.end) for span in click_spans] == [(0, 3), (3, 6)]
+    for span, name in zip(click_spans, ["first", "second"]):
+        assert isinstance(span.style, Style)
+        assert span.style.meta == {"@click": f"range_clicked('{name}')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (9, 10)])
+def test_zero_width_early_path_spans_have_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"first": (0, 3)},
+        width=6,
+    )
+    item = first_item(bar, 6)
+
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    assert item.spans
+    for span in item.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_keeps_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"first": (0, 3)},
+        width=6,
+    )
+    item = first_item(bar, 6)
+
+    assert isinstance(item, Text)
+    last_span = item.spans[-1]
+    assert isinstance(last_span.style, Style)
+    assert last_span.style.meta == {"@click": "range_clicked('first')"}
