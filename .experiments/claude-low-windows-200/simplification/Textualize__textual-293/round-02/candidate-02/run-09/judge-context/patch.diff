@@ -0,0 +1,191 @@
+import io
+
+from rich.color import Color
+from rich.console import Console
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def _rows(renderable, width):
+    """Render to segments and split them into rows at line breaks."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    rows = [[]]
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n":
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    return rows
+
+
+def _plain(row):
+    return "".join(segment.text for segment in row)
+
+
+def _cells(row):
+    """Expand a row into (character, style) pairs, one per cell."""
+    cells = []
+    for segment in row:
+        for character in segment.text:
+            cells.append((character, segment.style))
+    return cells
+
+
+def _click_meta(style):
+    return style.meta.get("@click") if style else None
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert str(Tab("Home", "a")) == "Home"
+    assert repr(Tab("Home", "a")) == "Tab(label='Home', name='a')"
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([]) is not None
+    assert Tabs([Tab("Home"), Tab("Docs")]) is not None
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given_by_name():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    assert tabs._active_tab_name == "Docs"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_name():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 4)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "T2"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "T2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T3"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Apricot")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_no_match_changes_nothing():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    tabs.action_range_clicked("Docs")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_auto_fit_label_row_and_underline_layout():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    rows = _rows(tabs.render(), 20)
+    # Label widths are 4 + 4, leaving 12 cells for four flexible padding edges.
+    # Each edge gets 12 / 4 = 3 cells, so each tab is 3 + label + 3 wide.
+    assert _plain(rows[0]) == "   Home" + " " * 6 + "Docs   "
+    # The active label spans columns 3 to 7; the underline highlights them, with
+    # half-cell glyphs at the start and end edges.
+    assert _plain(rows[1]) == "━━╸━━━━╺" + "━" * 12
+
+
+def test_active_underline_cells_carry_click_action_of_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    underline = _cells(_rows(tabs.render(), 20)[1])
+    assert _click_meta(underline[0][1]) == "range_clicked('Home')"
+
+
+def test_inactive_label_is_clickable_and_dimmed():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    label_cells = _cells(_rows(tabs.render(), 20)[0])
+    # "D" of "Docs" sits at column 13 in the auto-fit layout.
+    character, style = label_cells[13]
+    assert character == "D"
+    assert _click_meta(style) == "range_clicked('Docs')"
+    assert style.color.triplet != Color.parse("#f0f0f0").triplet
+
+
+def test_inactive_padding_cells_share_label_click_action():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    label_cells = _cells(_rows(tabs.render(), 20)[0])
+    # The left padding cell of "Docs" sits at column 10.
+    assert _click_meta(label_cells[10][1]) == "range_clicked('Docs')"
+
+
+def test_fixed_tab_padding_is_used_without_filling_width():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    rows = _rows(tabs.render(), 20)
+    assert _plain(rows[0]) == " Home  Docs "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")])
+    row = _plain(_rows(tabs.render(), 30)[0])
+    assert "Gamma" in row
+    assert "Alpha" not in row
+    assert row.count("Beta") == 1
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    tabs = Tabs([])
+    rows = _rows(tabs.render(), 20)
+    assert _plain(rows[0]) == ""
+    assert _plain(rows[1]) == "━" * 20
