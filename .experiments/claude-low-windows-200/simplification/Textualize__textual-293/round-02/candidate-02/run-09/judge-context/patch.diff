+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application for the Tabs widget.
+
+    Click a tab to select it. Click the tab bar first to give it focus before
+    using the keyboard: left and right move between tabs, digits select by
+    position, letters search by first character, and Escape removes focus.
+    """
+
+    def on_mount(self) -> None:
+        self.mount(
+            first=Tabs([Tab("Home"), Tab("Docs"), Tab("Settings")]),
+            second=Tabs(
+                [Tab("One", "one"), Tab("Two", "two"), Tab("Three", "three")],
+                active_tab="two",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
