+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    first, second = item.spans[-2], item.spans[-1]
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": _click_action("first")}
+    assert (second.start, second.end) == (2, 6)
+    assert second.style.meta == {"@click": _click_action("second")}
+
+
+@pytest.mark.parametrize(
+    "highlight_range",
+    [(0, 0), (3, 1)],
+)
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"a": (0, 3), "b": (3, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    assert item.spans
+    for span in item.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_gets_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"a": (0, 2)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    last = item.spans[-1]
+    assert (last.start, last.end) == (0, 2)
+    assert last.style.meta == {"@click": _click_action("a")}
