index 0000000..6ebdbac
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,415 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+# Key values that select a tab by position. Only ASCII digits count.
+_DIGIT_KEYS = tuple("0123456789")
+
+
+class Tab:
+    """A single entry in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The identifier used to select the tab. Defaults to
+            the label when not given.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver.
+
+    Args:
+        size (int, optional): Fixed size, or ``None`` for a flexible edge.
+        min_size (int): Smallest size for a flexible edge. Defaults to 1.
+        fraction (int): Share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full ordered list of tabs.
+        active_tab_name (str, optional): Name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs for the bar.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tab labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding cells on each side of a label.
+            ``None`` or zero means padding is sized to fit the width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _displayed_tabs(self) -> list[tuple[str, str]]:
+        """Return one ``(name, label)`` pair per distinct name.
+
+        A name is placed where it first appears, and it shows the label of the last
+        tab that uses that name.
+        """
+        labels: dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return list(labels.items())
+
+    def _layout(
+        self, displayed: list[tuple[str, str]], width: int
+    ) -> list[tuple[int, int, int]]:
+        """Compute the padding and label cell widths of each displayed tab.
+
+        Args:
+            displayed (list[tuple[str, str]]): The displayed ``(name, label)`` pairs.
+            width (int): The available width in cells.
+
+        Returns:
+            list[tuple[int, int, int]]: ``(left_padding, label_cells, right_padding)``
+                for each displayed tab, in order.
+        """
+        edges: list[_Edge] = []
+        for _name, label in displayed:
+            edges.append(_Edge(size=self.tab_padding or None))
+            edges.append(_Edge(size=cell_len(label)))
+            edges.append(_Edge(size=self.tab_padding or None))
+        sizes = layout_resolve(width, edges)
+        layout: list[tuple[int, int, int]] = []
+        for index, (_name, label) in enumerate(displayed):
+            left = sizes[3 * index]
+            right = sizes[3 * index + 2]
+            layout.append((left, cell_len(label), right))
+        return layout
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = self._displayed_tabs()
+        layout = self._layout(displayed, width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        label_row: list[Text | Opacity] = []
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        x = 0
+        for (name, label), (left, label_cells, right) in zip(displayed, layout):
+            # A padded span is one run, so its padding shares the label's style.
+            run = " " * left + label + " " * right
+            span_end = x + left + label_cells + right
+            selection_ranges[name] = (x, span_end)
+            label_ranges.append((x + left, x + left + label_cells))
+            if name == self.active_tab_name:
+                label_row.append(
+                    Text(
+                        run,
+                        style=active_style,
+                        end="",
+                        no_wrap=True,
+                        overflow="crop",
+                    )
+                )
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{name}')"}
+                )
+                label_row.append(
+                    Opacity(
+                        Text(
+                            run,
+                            style=click_style,
+                            end="",
+                            no_wrap=True,
+                            overflow="crop",
+                        ),
+                        opacity=self.inactive_text_opacity,
+                    )
+                )
+            x = span_end
+
+        highlight_range = (0.0, 0.0)
+        count = len(displayed)
+        if count:
+            position = min(max(self.bar_position, 0.0), count - 1)
+            index = int(position)
+            fraction = position - index
+            next_index = (index + 1) % count
+            start_a, end_a = label_ranges[index]
+            start_b, end_b = label_ranges[next_index]
+            highlight_range = (
+                start_a + (start_b - start_a) * fraction,
+                end_a + (end_b - end_a) * fraction,
+            )
+
+        yield from label_row
+        yield Segment.line()
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are selected by keyboard or mouse. Each tab is identified by its name.
+
+    Args:
+        tabs (list[Tab]): The ordered tabs. Names may repeat; a repeated name is
+            displayed once, at its first position, with the last tab's label.
+        active_tab (str, optional): Name of the initially active tab. When empty or
+            not given, the first tab is active. A name that matches no tab is kept,
+            and the bar sits at index 0. Defaults to ``None``.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted underline. Defaults
+            to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults
+            to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, from
+            0 (background color) to 1 (full color). Defaults to 0.5.
+        animation_duration (float): Seconds the underline takes to move to a newly
+            active tab. Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            ``None`` or zero sizes the padding to fit the width. Defaults to ``None``.
+        search_by_first_character (bool): When true, pressing a key that is not a
+            digit or arrow selects the next tab whose label starts with that
+            character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        else:
+            initial_name = active_tab if active_tab else tabs[0].name
+        # Set the bar position before the active tab so the watcher animates to it
+        # from its initial value rather than from a stale one.
+        if initial_name is not None:
+            self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for selecting tabs.
+
+        Right and Left move to the next or previous tab, wrapping at the ends.
+        The digit keys 1 through 9 select a tab by position, and 0 selects the 10th
+        tab, or the last tab when there are fewer than ten. Other keys select the
+        next tab whose label starts with that character, when
+        ``search_by_first_character`` is true. Escape removes focus from the widget.
+        Every key event is marked handled without stopping propagation.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+            event.prevent_default()
+            return
+
+        event.prevent_default()
+        if key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, is
+        case-insensitive, and never selects the active tab. It changes nothing when
+        no tab matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number above the tab count is ignored. The number 0 activates the 10th tab
+        when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The 1-based position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Invoked by clicks on a tab's range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
