@@ -0,0 +1,191 @@
+import io
+
+from rich.color import Color
+from rich.console import Console
+
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+BAR = "━"
+
+
+def _renderable(tabs, active=None, position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def _console(width=100):
+    return Console(width=width, file=io.StringIO(), color_system="truecolor")
+
+
+def _plain(renderable, width=100):
+    console = _console(width)
+    return "".join(
+        segment.text for segment in console.render(renderable, console.options)
+    )
+
+
+def _segments(renderable, width=100):
+    console = _console(width)
+    return list(console.render(renderable, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "h")
+    assert str(Tab("Home", "h")) == "Home"
+    assert "Home" in repr(Tab("Home", "h")) and "h" in repr(Tab("Home", "h"))
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([]) is not None
+    assert Tabs([Tab("A"), Tab("B")]) is not None
+
+
+def test_default_active_tab_is_first_tab():
+    widget = Tabs([Tab("A"), Tab("B")])
+    assert widget._active_tab_name == "A"
+    assert widget._bar_position == 0.0
+
+
+def test_given_active_tab_sets_bar_position_to_its_index():
+    widget = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert widget._active_tab_name == "B"
+    assert widget._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    widget = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert widget._active_tab_name == "zzz"
+    assert widget._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    widget = Tabs([], active_tab="zzz")
+    assert widget._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    widget = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "B"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "C"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "A"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs([Tab(str(number)) for number in range(1, 4)])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "2"
+    widget.activate_tab_by_number(5)
+    assert widget._active_tab_name == "2"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    widget = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "T10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    widget = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")])
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "avocado"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_first_char_search_never_selects_active_and_ignores_no_match():
+    widget = Tabs([Tab("Apple"), Tab("Banana")])
+    widget.activate_tab_by_first_char("p")
+    assert widget._active_tab_name == "Apple"
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    widget = Tabs([Tab("A"), Tab("B")])
+    widget.action_range_clicked("B")
+    assert widget._active_tab_name == "B"
+
+
+def test_no_tabs_row_layout_is_empty_row_then_full_inactive_bar():
+    assert _plain(_renderable([])) == "\n" + BAR * 100
+
+
+def test_fixed_padding_label_row_and_underline_highlight():
+    tabs = [Tab("Home"), Tab("Docs")]
+    lines = _plain(_renderable(tabs, active="Home", tab_padding=1)).split("\n")
+    # Each tab is 1 + label + 1 cells: " Home " then " Docs ".
+    assert lines[0] == " Home  Docs "
+    # The highlight covers cells 1 to 5, so cell 0 and cell 5 get half glyphs.
+    assert lines[1] == "╸" + BAR * 4 + "╺" + BAR * 94
+
+
+def test_fixed_padding_highlight_follows_fractional_position():
+    tabs = [Tab("Home"), Tab("Docs")]
+    lines = _plain(
+        _renderable(tabs, active="Docs", position=1.0, tab_padding=1)
+    ).split("\n")
+    # "Docs" occupies cells 7 to 10 of the label row, so its highlight is 7 to 11.
+    assert lines[1] == BAR * 6 + "╸" + BAR * 4 + "╺" + BAR * 88
+
+
+def test_auto_fit_label_row_follows_layout_rule():
+    # Width 20 with labels of 1 and 2 cells leaves 17 cells for four flexible
+    # padding edges. Each gets 4.25 cells, carrying 0.25, 0.5 and 0.75 forward,
+    # so the sizes are 4, 4, 4 and 5 for left/right padding of tabs one and two.
+    tabs = [Tab("A"), Tab("BB")]
+    lines = _plain(_renderable(tabs, active="A"), width=20).split("\n")
+    assert lines[0] == "    A" + " " * 8 + "BB" + " " * 5
+    assert len(lines[0]) == 20
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")]
+    lines = _plain(_renderable(tabs, active="y", tab_padding=1)).split("\n")
+    assert lines[0] == " Three  Two "
+
+
+def test_inactive_padded_label_is_one_run_with_click_and_dimmed():
+    tabs = [Tab("Home"), Tab("Docs")]
+    segments = _segments(_renderable(tabs, active="Home", tab_padding=1))
+    docs = [segment for segment in segments if segment.text == " Docs "]
+    assert len(docs) == 1
+    style = docs[0].style
+    assert style.meta == {"@click": "range_clicked('Docs')"}
+    assert style.color != Color.parse("#f0f0f0")
+
+
+def test_active_label_has_no_click_action():
+    tabs = [Tab("Home"), Tab("Docs")]
+    segments = _segments(_renderable(tabs, active="Home", tab_padding=1))
+    home = [segment for segment in segments if segment.text == " Home "]
+    assert len(home) == 1
+    assert "@click" not in home[0].style.meta
