+import io
+
+from rich.console import Console
+from rich.segment import Segment
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def render_segments(renderable, width):
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def label_and_bar_lines(renderable, width):
+    """Return the segments of the label row and of the underline row."""
+    return list(Segment.split_lines(render_segments(renderable, width)))
+
+
+def plain_rows(renderable, width):
+    lines = label_and_bar_lines(renderable, width)
+    return ["".join(segment.text for segment in line) for line in lines]
+
+
+def click_targets(line):
+    """Return the click action of each cell in a row of segments."""
+    targets = []
+    for segment in line:
+        assert isinstance(segment.style, Style)
+        targets.extend([segment.style.meta.get("@click")] * len(segment.text))
+    return targets
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tabs_are_equal_when_label_and_name_match():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+
+
+def test_tab_repr_shows_label_and_name():
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_construction_with_default_styles_accepts_empty_and_populated_tab_lists():
+    assert isinstance(Tabs([]), Tabs)
+    assert isinstance(Tabs([Tab("Home"), Tab("About")]), Tabs)
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("About")])
+
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_argument_is_used():
+    tabs = Tabs([Tab("Home"), Tab("About")], active_tab="About")
+
+    assert tabs._active_tab_name == "About"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("About")], active_tab="Missing")
+
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_names():
+    tabs = Tabs([Tab("Home", "x"), Tab("About"), Tab("Docs", "x")])
+
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("About") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("Home"), Tab("About"), Tab("Docs")])
+
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Docs"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Home"
+
+
+def test_activate_tab_by_number_uses_position_and_zero_rules():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "3"
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "10"
+
+
+def test_zero_activates_last_tab_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_tab_by_number(0)
+
+    assert tabs._active_tab_name == "C"
+
+
+def test_first_char_search_is_case_insensitive_wraps_and_skips_active():
+    tabs = Tabs([Tab("apple"), Tab("Banana"), Tab("avocado")])
+
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_first_char_search_never_selects_the_only_active_tab():
+    tabs = Tabs([Tab("apple")])
+
+    tabs.activate_tab_by_first_char("a")
+
+    assert tabs._active_tab_name == "apple"
+
+
+def test_range_clicked_action_activates_named_tab():
+    tabs = Tabs([Tab("Home"), Tab("About")])
+
+    tabs.action_range_clicked("About")
+
+    assert tabs._active_tab_name == "About"
+
+
+def test_no_tabs_has_empty_label_row_and_full_width_underline():
+    assert plain_rows(Tabs([]).render(), width=10) == ["", "━" * 10]
+
+
+def test_duplicate_names_display_once_with_last_label_at_first_position():
+    tabs = Tabs([Tab("Home", "x"), Tab("About"), Tab("Docs", "x")], tab_padding=1)
+
+    rows = plain_rows(tabs.render(), width=30)
+
+    assert rows[0] == " Docs  About "
+
+
+def test_fixed_padding_label_row_and_highlight_under_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+
+    rows = plain_rows(tabs.render(), width=20)
+
+    assert rows[0] == " Home  About "
+    # Home's label occupies columns 1 to 4, so the highlight covers them.
+    assert rows[1] == "╸" + "━" * 4 + "╺" + "━" * 14
+
+
+def test_auto_fit_padding_shares_remaining_width_through_layout_rule():
+    # Labels take 4 + 5 = 9 cells, leaving 11 cells for four flexible padding
+    # edges. Each edge's share is 11 / 4 = 2.75. Whole cells are taken in order
+    # with the fraction carried forward, giving 2, 3, 3, 3.
+    tabs = Tabs([Tab("Home"), Tab("About")])
+
+    rows = plain_rows(tabs.render(), width=20)
+
+    assert rows[0] == "  Home" + " " * 6 + "About" + " " * 3
+    # Home's label occupies columns 2 to 5 of the row.
+    assert rows[1] == "━╸" + "━" * 4 + "╺" + "━" * 13
+
+
+def test_inactive_label_carries_click_action_and_active_label_does_not():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+
+    label_line, bar_line = label_and_bar_lines(tabs.render(), width=20)
+
+    label_targets = click_targets(label_line)
+    assert label_targets[:6] == [None] * 6
+    assert label_targets[6:13] == ["range_clicked('About')"] * 7
+
+    bar_targets = click_targets(bar_line)
+    assert bar_targets[:6] == ["range_clicked('Home')"] * 6
+    assert bar_targets[6:13] == ["range_clicked('About')"] * 7
+    assert bar_targets[13:] == [None] * 7
+
+
+def test_inactive_label_is_dimmed_and_keeps_background():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+
+    label_line, _ = label_and_bar_lines(tabs.render(), width=20)
+
+    inactive = [
+        segment
+        for segment in label_line
+        if segment.style.meta.get("@click") == "range_clicked('About')"
+    ]
+    assert inactive
+    for segment in inactive:
+        assert segment.style.color.triplet != (240, 240, 240)
+        assert segment.style.bgcolor.triplet == (2, 23, 32)
