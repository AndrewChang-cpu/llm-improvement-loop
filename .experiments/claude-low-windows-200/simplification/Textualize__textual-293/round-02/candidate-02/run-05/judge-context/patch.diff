index 0000000..a5cfd24
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,456 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, NamedTuple, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A single tab with a visible label and a name used to identify it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """Edge description consumed by ``layout_resolve``.
+
+    Args:
+        size (int | None): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The flexible edge's share of the remaining space. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan(NamedTuple):
+    """Layout of one displayed tab.
+
+    Attributes:
+        name (str): The tab name.
+        text (str): Left padding, label, and right padding as one run.
+        selection (Tuple[int, int]): Columns of the padded span, with exclusive end.
+        label (Tuple[int, int]): Columns of the label text, excluding padding.
+    """
+
+    name: str
+    text: str
+    selection: Tuple[int, int]
+    label: Tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs that places
+            the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding size in cells, or ``None`` to fit
+            the padding to the width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        spans = self._layout_spans(width)
+
+        for span in spans:
+            if span.name == self.active_tab_name:
+                # The active tab has no click action.
+                yield Segment(span.text, active_style)
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{span.name}')"}
+                )
+                label = Text(span.text, style=click_style, end="")
+                yield from console.render(
+                    Opacity(label, opacity=self.inactive_text_opacity), options
+                )
+
+        yield Segment("\n")
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges={span.name: span.selection for span in spans},
+            width=width,
+        )
+
+    def _displayed_tabs(self) -> List[Tuple[str, str]]:
+        """Return one ``(name, label)`` pair per distinct name.
+
+        Names appear in the order of their first occurrence. Each pair carries the
+        label of the last Tab with that name.
+
+        Returns:
+            List[Tuple[str, str]]: The displayed tabs.
+        """
+        labels: Dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return list(labels.items())
+
+    def _layout_spans(self, width: int) -> List[_TabSpan]:
+        """Split the width into padded spans for the displayed tabs.
+
+        Each displayed tab has a left padding edge, a label edge sized to the label's
+        cell width, and a right padding edge. Padding edges are fixed when
+        ``tab_padding`` is positive and otherwise share the remaining width through
+        ``layout_resolve``. A label with zero cells has no edge.
+
+        Args:
+            width (int): The width available to the label row, in cells.
+
+        Returns:
+            List[_TabSpan]: The layout of each displayed tab, in display order.
+        """
+        displayed = self._displayed_tabs()
+        padding = self.tab_padding or None
+
+        edges: List[_Edge] = []
+        for _name, label in displayed:
+            edges.append(_Edge(size=padding))
+            label_width = cell_len(label)
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            edges.append(_Edge(size=padding))
+        sizes = iter(layout_resolve(width, edges))
+
+        spans: List[_TabSpan] = []
+        cursor = 0
+        for name, label in displayed:
+            left = next(sizes)
+            label_cells = next(sizes) if cell_len(label) else 0
+            right = next(sizes)
+            span_width = left + label_cells + right
+            text = " " * left + label + " " * right
+            spans.append(
+                _TabSpan(
+                    name=name,
+                    text=text,
+                    selection=(cursor, cursor + span_width),
+                    label=(cursor + left, cursor + left + label_cells),
+                )
+            )
+            cursor += span_width
+        return spans
+
+    def _highlight_range(self, spans: List[_TabSpan]) -> Tuple[float, float]:
+        """Interpolate the highlighted columns at the bar position.
+
+        The highlight runs from the label range at the floor index to the label
+        range at the next index, wrapping at the end.
+
+        Args:
+            spans (List[_TabSpan]): The displayed tabs' layout.
+
+        Returns:
+            Tuple[float, float]: The highlight range, or ``(0, 0)`` with no tabs.
+        """
+        count = len(spans)
+        if count == 0:
+            return (0, 0)
+        index = math.floor(self.bar_position)
+        fraction = self.bar_position - index
+        start_a, end_a = spans[index % count].label
+        start_b, end_b = spans[(index + 1) % count].label
+        return (
+            start_a + (start_b - start_a) * fraction,
+            end_a + (end_b - end_a) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    The widget uses two rows: the labels, then the underline bar. Tabs are chosen
+    by mouse click or by keyboard. Tabs with the same name display once.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            ``None`` or empty, the first tab's name is used. A name that matches no
+            tab is kept, and the underline sits at index 0. Defaults to ``None``.
+        active_tab_style (StyleType): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels,
+            where 1.0 is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): The time in seconds for the underline to move
+            to a new active tab. Defaults to 0.3.
+        animation_function (str): The name of the easing function used for the
+            underline movement. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            ``None`` or 0 fits the padding to the width. Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a letter key activates
+            the next tab whose label starts with that letter. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the index of the new active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the new active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            easing=self.animation_function,
+            duration=self.animation_duration,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        With no tabs, the key is consumed and nothing else happens. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left move to the next or previous tab, wrapping around.
+        - The digits 0 to 9 activate a tab by position. Key 1 activates the first
+          tab, and so on. Key 0 follows the rule of ``activate_tab_by_number``.
+          Numbers above the tab count are ignored.
+        - Other single-character keys, when ``search_by_first_character`` is
+          enabled, activate the next tab whose label starts with that character,
+          ignoring case. The search starts after the active tab and wraps around.
+
+        The default action of every key event is prevented. Propagation is not
+        stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end.
+
+        The search starts from the active tab's index.
+        """
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start.
+
+        The search starts from the active tab's index.
+        """
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search begins after the active tab, wraps around, and ignores case. It
+        never selects the active tab. If no tab matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match against each label's first letter.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        Number 0 activates the tenth tab when there are at least ten tabs, and
+        otherwise the last tab. A number above the tab count changes nothing.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full list, or 0 if no tab
+                has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active.
+
+        This is the target of the click action on each tab's labels and underline.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
