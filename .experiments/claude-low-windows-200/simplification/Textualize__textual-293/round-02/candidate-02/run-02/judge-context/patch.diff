+    assert text.plain == "━╸━━╺━"
+    home_span, docs_span = text.spans[-2:]
+    assert isinstance(home_span.style, Style)
+    assert isinstance(docs_span.style, Style)
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert (docs_span.start, docs_span.end) == (3, 6)
+    assert home_span.style.meta == {"@click": "range_clicked('Home')"}
+    assert docs_span.style.meta == {"@click": "range_clicked('Docs')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (5, 2), (-3, -1)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"Home": (0, 3)},
+        width=6,
+    )
+    text = _first_yielded(bar)
+
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"Docs": (0, 6)},
+        width=6,
+    )
+    text = _first_yielded(bar)
+
+    assert isinstance(text, Text)
+    docs_spans = [
+        span
+        for span in text.spans
+        if isinstance(span.style, Style)
+        and span.style.meta.get("@click") == "range_clicked('Docs')"
+    ]
+    assert docs_spans
