+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def tabs_renderable(tabs, active_name, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        inactive_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def label_row(renderable):
+    """Return the first yielded item, which is the label row as a Text object."""
+    console = Console(width=100, color_system="truecolor")
+    return next(iter(renderable.__rich_console__(console, console.options)))
+
+
+def plain_lines(renderable):
+    """Return the rendered output as plain text lines, with ANSI codes removed."""
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_text_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_default_styles_for_empty_and_filled_lists():
+    empty = Tabs([])
+    filled = Tabs([Tab("Home"), Tab("Docs")])
+
+    assert empty._active_tab_name is None
+    assert filled._active_tab_name == "Home"
+    assert isinstance(filled.render(), TabsRenderable)
+
+
+def test_initial_active_tab_and_unknown_name_falls_back_to_index_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+    unknown = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert unknown._active_tab_name == "zzz"
+    assert unknown._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_names():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around_the_full_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_tab_by_number_maps_positions_and_zero_rule_with_ten_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "2"
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_selects_last():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_first_char_search_starts_after_active_tab_and_wraps():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("Dashboard")])
+
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Docs"
+
+    tabs.activate_tab_by_first_char("D")
+    assert tabs._active_tab_name == "Dashboard"
+
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_first_char_search_never_selects_active_tab_and_ignores_no_match():
+    tabs = Tabs([Tab("Docs"), Tab("Home")])
+
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Docs"
+
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_first_char_search_disabled_by_flag():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], search_by_first_character=False)
+
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_range_clicked_action_activates_named_tab():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d")])
+
+    tabs.action_range_clicked("d")
+    assert tabs._active_tab_name == "d"
+
+
+def test_duplicate_names_render_once_at_first_position_with_last_label():
+    tabs = [Tab("Home", "h"), Tab("Docs", "d"), Tab("Home2", "h")]
+    text = label_row(tabs_renderable(tabs, "h", tab_padding=1))
+
+    assert text.plain == " Home2  Docs "
+    assert len(text.spans) == 2
+
+
+def test_inactive_padded_span_is_dimmed_and_clickable_active_span_is_not():
+    tabs = [Tab("Home"), Tab("Docs")]
+    text = label_row(tabs_renderable(tabs, "Home", tab_padding=1))
+
+    assert text.plain == " Home  Docs "
+    active_span, inactive_span = text.spans
+    assert (active_span.start, active_span.end) == (0, 6)
+    assert (inactive_span.start, inactive_span.end) == (6, 12)
+
+    assert isinstance(active_span.style, Style)
+    assert "@click" not in active_span.style.meta
+
+    assert isinstance(inactive_span.style, Style)
+    assert inactive_span.style.meta == {"@click": "range_clicked('Docs')"}
+
+    resolved = Console(color_system="truecolor").get_style("#f0f0f0 on #021720")
+    assert inactive_span.style.bgcolor == resolved.bgcolor
+    assert inactive_span.style.color != resolved.color
+
+
+def test_label_row_and_underline_highlight_the_active_tab():
+    tabs = [Tab("Home"), Tab("Docs")]
+    lines = plain_lines(tabs_renderable(tabs, "Home", tab_padding=1))
+
+    assert lines[0] == " Home  Docs "
+    # Home's label occupies cells 1 to 5, so the highlight starts at 1 and ends at 5.
+    assert lines[1] == "╸" + "━" * 4 + "╺" + "━" * 94
+
+
+def test_underline_interpolates_between_adjacent_labels():
+    tabs = [Tab("Home"), Tab("Docs")]
+    lines = plain_lines(tabs_renderable(tabs, "Home", bar_position=0.5, tab_padding=1))
+
+    # Labels span 1 to 5 and 7 to 11, so the halfway highlight covers 4 to 8.
+    assert lines[1] == "━" * 3 + "╸" + "━" * 4 + "╺" + "━" * 91
+
+
+def test_flexible_padding_is_shared_by_the_layout_resolver():
+    tabs = [Tab("A"), Tab("B")]
+    console = Console(width=20, color_system="truecolor")
+    renderable = tabs_renderable(tabs, "A")
+    text = next(iter(renderable.__rich_console__(console, console.options)))
+
+    # The four flexible padding edges share 18 cells: 4, 5, 4, 5.
+    assert text.plain == " " * 4 + "A" + " " * 5 + " " * 4 + "B" + " " * 5
+
+
+def test_no_tabs_gives_empty_label_row_and_full_inactive_underline():
+    lines = plain_lines(tabs_renderable([], None))
+
+    assert lines == ["", "━" * 100]
