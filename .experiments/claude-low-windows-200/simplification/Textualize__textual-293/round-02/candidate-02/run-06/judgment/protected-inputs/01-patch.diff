diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..b6c48ce
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,156 @@
+from __future__ import annotations
+
+import io
+from typing import List
+
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def _segments(renderable, width: int = 40) -> list:
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def _plain_rows(renderable, width: int = 40) -> List[str]:
+    text = "".join(segment.text for segment in _segments(renderable, width))
+    return text.split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "other")
+    assert str(Tab("Home", "home")) == "Home"
+
+
+def test_construction_with_empty_tab_list_uses_default_styles():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert _plain_rows(tabs.render()) == ["", "━" * 40]
+
+
+def test_construction_with_tabs_uses_first_tab_as_active():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")], tab_padding=1)
+    assert _plain_rows(tabs.render(), width=20)[0] == " Three  Two "
+
+
+def test_auto_fit_label_row_shares_remaining_width():
+    # Width 20 with two labels of 4 and 5 cells leaves 11 cells for four flexible
+    # padding edges. Each takes its whole-cell share (2.75) with the fractional part
+    # carried forward, giving 2, 3, 3, 3 cells in order.
+    tabs = Tabs([Tab("Home"), Tab("About")])
+    assert _plain_rows(tabs.render(), width=20)[0] == "  Home      About   "
+
+
+def test_fixed_padding_label_row():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    assert _plain_rows(tabs.render())[0] == " Home  About "
+
+
+def test_underline_highlights_active_label_with_half_cell_edges():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    underline = _plain_rows(tabs.render())[1]
+    # The active label "Home" occupies columns 1 through 4. The highlight starts
+    # after cell zero, so cell 0 carries a right-half glyph and cell 5 carries a
+    # left-half glyph.
+    assert underline[0] == "╸"
+    assert underline[1:5] == "━━━━"
+    assert underline[5] == "╺"
+
+
+def test_inactive_tab_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    segments = _segments(tabs.render())
+    home = next(segment for segment in segments if "Home" in segment.text)
+    about = next(segment for segment in segments if "About" in segment.text)
+
+    assert isinstance(home.style, Style)
+    assert isinstance(about.style, Style)
+    assert "@click" not in home.style.meta
+    assert about.style.meta == {"@click": "range_clicked('About')"}
+
+
+def test_inactive_label_is_dimmed_relative_to_active_label():
+    tabs = Tabs([Tab("Home"), Tab("About")], tab_padding=1)
+    segments = _segments(tabs.render())
+    home = next(segment for segment in segments if "Home" in segment.text)
+    about = next(segment for segment in segments if "About" in segment.text)
+
+    assert about.style.color.triplet != home.style.color.triplet
+
+
+def test_activate_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_tab_by_number_maps_positions():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")],
+        active_tab="Banana",
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("c")
+    assert tabs._active_tab_name == "Cherry"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Cherry"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
