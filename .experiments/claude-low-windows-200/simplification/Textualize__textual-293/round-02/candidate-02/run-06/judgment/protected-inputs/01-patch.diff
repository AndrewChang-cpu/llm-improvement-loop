diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..63583f9
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,483 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, Iterable, List, NamedTuple, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab shown by the Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Names are not
+            required to be unique. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __str__(self) -> str:
+        return self.label
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+
+class _Edge:
+    """A layout edge consumed by the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The share of the remaining space for a flexible edge.
+            Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan(NamedTuple):
+    """Column ranges occupied by one displayed tab.
+
+    Attributes:
+        tab (Tab): The displayed tab.
+        padded (tuple[int, int]): Selection range, from the start of the left padding
+            to the end of the right padding, exclusive end.
+        label (tuple[int, int]): Label range, excluding padding, exclusive end.
+    """
+
+    tab: Tab
+    padded: Tuple[int, int]
+    label: Tuple[int, int]
+
+
+def _displayed_tabs(tabs: Iterable[Tab]) -> List[Tab]:
+    """Return one tab per distinct name.
+
+    Each name is placed where it first appears and shows the label of the last
+    tab with that name.
+
+    Args:
+        tabs (Iterable[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The displayed tabs in order.
+    """
+    last_by_name: Dict[str, Tab] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its first-occurrence position.
+        last_by_name[tab.name] = tab
+    return list(last_by_name.values())
+
+
+class TabsRenderable:
+    """Render the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list, including duplicate names.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs that places
+            the underline highlight.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding in cells on each side of a label, or
+            ``None`` (or zero) to share the remaining width.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+        yield from self._label_segments(console, options, spans)
+        yield Segment.line()
+        bar = self._bar(console, width, spans)
+        yield from console.render(bar, options)
+
+    def _layout(self, width: int) -> List[_TabSpan]:
+        """Compute the padded and label ranges of each displayed tab.
+
+        Args:
+            width (int): The total width available to the label row.
+
+        Returns:
+            List[_TabSpan]: One entry per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+
+        def padding_edge() -> _Edge:
+            if self.tab_padding:
+                return _Edge(size=self.tab_padding)
+            return _Edge()
+
+        edges: List[_Edge] = []
+        for tab in displayed:
+            edges.append(padding_edge())
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(padding_edge())
+
+        sizes = layout_resolve(width, edges)
+
+        spans: List[_TabSpan] = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            padded_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    tab=tab,
+                    padded=(cursor, padded_end),
+                    label=(label_start, label_end),
+                )
+            )
+            cursor = padded_end
+        return spans
+
+    def _label_segments(
+        self,
+        console: Console,
+        options: ConsoleOptions,
+        spans: List[_TabSpan],
+    ) -> RenderResult:
+        """Yield the segments of the label row.
+
+        Args:
+            console (Console): The console used to resolve styles.
+            options (ConsoleOptions): The render options.
+            spans (List[_TabSpan]): The layout of the displayed tabs.
+
+        Yields:
+            Segment: Segments of the label row, without a trailing line break.
+        """
+        for span in spans:
+            tab = span.tab
+            left = span.label[0] - span.padded[0]
+            right = span.padded[1] - span.label[1]
+            content = " " * left + tab.label + " " * right
+
+            if tab.name == self.active_tab_name:
+                style = console.get_style(self.active_tab_style)
+                text = Text(
+                    content, style=style, no_wrap=True, overflow="crop", end=""
+                )
+                yield from console.render(text, options)
+            else:
+                style = console.get_style(self.inactive_tab_style) + Style.from_meta(
+                    {"@click": f"range_clicked('{tab.name}')"}
+                )
+                text = Text(
+                    content, style=style, no_wrap=True, overflow="crop", end=""
+                )
+                yield from console.render(
+                    Opacity(text, opacity=self.inactive_text_opacity), options
+                )
+
+    def _bar(
+        self, console: Console, width: int, spans: List[_TabSpan]
+    ) -> UnderlineBar:
+        """Build the underline bar for the current bar position.
+
+        Args:
+            console (Console): The console used to resolve styles.
+            width (int): The width of the bar.
+            spans (List[_TabSpan]): The layout of the displayed tabs.
+
+        Returns:
+            UnderlineBar: The bar with its highlight and clickable ranges.
+        """
+        highlight: Tuple[float, float] = (0, 0)
+        if spans:
+            count = len(spans)
+            floor_index = math.floor(self.bar_position)
+            index = floor_index % count
+            fraction = self.bar_position - floor_index
+            next_index = (index + 1) % count
+            start, end = spans[index].label
+            next_start, next_end = spans[next_index].label
+            highlight = (
+                start + (next_start - start) * fraction,
+                end + (next_end - end) * fraction,
+            )
+
+        return UnderlineBar(
+            highlight_range=highlight,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={span.tab.name: span.padded for span in spans},
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are selected by keyboard or mouse. The active tab is identified by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. When empty
+            or ``None``, the first tab is active. A name matching no tab is kept, and
+            the underline sits at the first position. Defaults to ``None``.
+        active_tab_style (StyleType, optional): Style of the active tab's label and
+            padding. Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs' labels and
+            padding. Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Seconds the underline takes to move to
+            a new active tab. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing used when the underline
+            moves. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            ``None`` or zero shares the remaining width between the padding cells.
+            Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            activates the next tab whose label starts with that letter.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+
+        # Set the bar position before the active name, so the active-tab watcher
+        # targets the same position and nothing jumps on construction.
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The displayed index, or 0 if the name is not displayed.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            active_tab_name (str | None): The new active tab name.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation.
+
+        Right and Left move to the next or previous tab, wrapping at the ends.
+        Keys 0 through 9 activate a tab by its 1-based position, with 0 following the
+        rule of ``activate_tab_by_number``. Other keys, when
+        ``search_by_first_character`` is true, activate the next tab whose label starts
+        with that character. Escape removes focus from the widget. Every key event
+        has its default action prevented, and propagation is not stopped, so
+        application bindings still receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to find.
+
+        Returns:
+            int: The index in the full tab list of the first match, or 0 if none.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full list active, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full list active, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, ignores
+        case, and never selects the active tab. Nothing changes if no tab matches.
+
+        Args:
+            char (str): The character to match against the first letter of each label.
+        """
+        tab_count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, tab_count + 1):
+            tab = self.tabs[(start + offset) % tab_count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label[:1].lower() == wanted:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A number above the tab count is ignored. The number 0 activates the 10th tab
+        when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position, or 0.
+        """
+        tab_count = len(self.tabs)
+        if tab_number > tab_count:
+            return
+        if tab_number == 0:
+            index = 9 if tab_count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with the given name active.
+
+        This is the action run by the click metadata on each tab's label and
+        underline.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
