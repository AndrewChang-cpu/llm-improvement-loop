+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows a Tabs widget mounted on the App."""
+
+    css = """
+    Tabs {
+        margin: 1 2;
+    }
+    """
+
+    def on_mount(self) -> None:
+        self.mount(
+            tabs=Tabs(
+                [
+                    Tab("Home"),
+                    Tab("Projects"),
+                    Tab("Settings", "settings"),
+                    Tab("Help"),
+                ],
+                active_tab="Projects",
+            )
+        )
+
+
+TabsDemo.run(log="textual.log")
