+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+BAR = "━"
+
+
+def plain_lines(renderable):
+    text = ANSI_CODE.sub("", render(renderable))
+    return text.split("\n")
+
+
+def make_tabs(labels, **kwargs):
+    return Tabs([Tab(label) for label in labels], **kwargs)
+
+
+def test_construction_with_empty_list_and_with_tabs():
+    empty = Tabs([])
+    populated = make_tabs(["One", "Two"])
+    assert empty is not None
+    assert populated is not None
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert Tab("Home", name="main").name == "main"
+    assert Tab("Home") == Tab("Home", name="Home")
+    assert str(Tab("Home", name="main")) == "Home"
+
+
+def test_find_tab_by_name_returns_first_index_of_duplicate():
+    tabs = Tabs([Tab("A"), Tab("B", name="x"), Tab("C", name="x")])
+    assert tabs.find_tab_by_name("x") == 1
+
+
+def test_find_tab_by_name_returns_zero_when_missing():
+    tabs = make_tabs(["A", "B"])
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = make_tabs(["A", "B", "C"])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_used_when_given():
+    tabs = make_tabs(["A", "B", "C"], active_tab="C")
+    assert tabs._active_tab_name == "C"
+    assert tabs._bar_position == 2.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([], active_tab="A")
+    assert tabs._active_tab_name is None
+
+
+def test_next_and_previous_wrap_around():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_first_character_search_wraps_and_skips_active_tab():
+    tabs = make_tabs(["Apple", "Avocado", "banana", "Apricot"])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_is_case_insensitive():
+    tabs = make_tabs(["Apple", "banana"])
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "banana"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = make_tabs(["Apple", "banana"])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = make_tabs(["T1", "T2", "T3"])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "T2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T3"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "T3"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab_when_ten_or_more():
+    tabs = make_tabs([f"T{number}" for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("A2", name="A")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " A2  B "
+
+
+def test_row_layout_with_fixed_padding():
+    tabs = make_tabs(["One", "Two"], tab_padding=1)
+    lines = plain_lines(tabs.render())
+    assert lines[0] == " One  Two "
+    assert lines[1] == BAR * 100
+
+
+def test_flexible_padding_fills_the_row():
+    tabs = make_tabs(["One", "Two"])
+    lines = plain_lines(tabs.render())
+    assert len(lines[0]) == 100
+
+
+def test_no_tabs_renders_empty_row_and_full_underline():
+    tabs = Tabs([])
+    lines = plain_lines(tabs.render())
+    assert lines == ["", BAR * 100]
