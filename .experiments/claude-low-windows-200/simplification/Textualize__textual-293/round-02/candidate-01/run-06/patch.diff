index 0000000..36b548b
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,441 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+# Keys that select a tab by position. Only the ASCII digits count.
+DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = name or label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabEdge:
+    """A layout edge for one part of a tab (padding or label).
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Return one tab per distinct name, in order of first occurrence.
+
+    Each returned tab carries the label of the last tab that has its name.
+
+    Args:
+        tabs (List[Tab]): The full tab list, which may contain duplicate names.
+
+    Returns:
+        List[Tab]: The displayed tabs.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Render the label row and the underline bar of a Tabs widget.
+
+    The label row is built from one padded span per displayed tab. The underline bar
+    highlights the interpolated position of the active tab and carries a click range for
+    every displayed tab.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+        active_tab_name (str, optional): The name of the active tab, or ``None``.
+        bar_position (float): The position of the underline, as a fractional index into
+            the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs'
+            text.
+        tab_padding (int, optional): A fixed padding size in cells, or ``None`` to
+            fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        # Each displayed tab contributes left padding, label, and right padding edges.
+        edges: List[_TabEdge] = []
+        for tab in displayed:
+            edges.append(_TabEdge(size=self.tab_padding or None))
+            edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(_TabEdge(size=self.tab_padding or None))
+        sizes = layout_resolve(width, edges)
+
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        label_pieces: List[RenderableType] = []
+
+        position = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_start = position + left
+            label_ranges[tab.name] = (label_start, label_start + cell_len(tab.label))
+            span_width = left + label_size + right
+            selection_ranges[tab.name] = (position, position + span_width)
+            position += span_width
+
+            # The padded span is one run of text, so padding shares the label's style
+            # and click action.
+            padded = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                label_pieces.append(
+                    Text(
+                        padded,
+                        style=console.get_style(self.active_tab_style),
+                        end="",
+                        no_wrap=True,
+                        overflow="crop",
+                    )
+                )
+            else:
+                piece = Text(
+                    padded,
+                    style=console.get_style(self.inactive_tab_style),
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+                piece.apply_meta(
+                    {"@click": f"range_clicked('{tab.name}')"}, 0, len(padded)
+                )
+                label_pieces.append(
+                    Opacity(piece, opacity=self.inactive_text_opacity)
+                )
+
+        yield from label_pieces
+        yield Segment("\n")
+
+        highlight_range = self._highlight_range(displayed, label_ranges)
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _highlight_range(
+        self, displayed: List[Tab], label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlighted label range at the bar position.
+
+        The highlight runs between the label range at the floor index and the label
+        range at the next index. The next index wraps at the end of the list.
+
+        Args:
+            displayed (List[Tab]): The displayed tabs.
+            label_ranges (Dict[str, Tuple[int, int]]): Label ranges keyed by tab name.
+
+        Returns:
+            Tuple[float, float]: The highlight range in cells.
+        """
+        count = len(displayed)
+        if count == 0:
+            return (0, 0)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = int(floor_position) % count
+        next_index = (index + 1) % count
+        start, end = label_ranges[displayed[index].name]
+        next_start, next_end = label_ranges[displayed[next_index].name]
+        return (
+            start + fraction * (next_start - start),
+            end + fraction * (next_end - end),
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    The label row is on the first line and the underline bar is on the second line.
+    Tabs are selected by name. Click a tab, press left or right to move between tabs,
+    press 1 to 9 to select a tab by position, or press a letter to jump to the next tab
+    whose label starts with that letter.
+
+    Args:
+        tabs (List[Tab]): The tabs, in display order. Duplicate names display once,
+            at the first occurrence, with the label of the last tab that has the name.
+        active_tab (str, optional): The name of the initially active tab. Defaults
+            to the name of the first tab. A name that matches no tab is kept, and the
+            underline starts at index 0.
+        active_tab_style (StyleType): The style of the active tab's label. Defaults
+            to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs' labels. Defaults
+            to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs' text,
+            where 1.0 is fully visible and 0.0 is invisible. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation, in seconds.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells of padding on each side of a
+            label. Defaults to ``None``, which fits the padding to the available width,
+            with a minimum of one cell.
+        search_by_first_character (bool): If true, a letter key activates the next tab
+            whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if tabs:
+            self._active_tab_name = active_tab or tabs[0].name
+        else:
+            self._active_tab_name = None
+        self._bar_position = float(self._displayed_index(self._active_tab_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            self._active_tab_name,
+            self._bar_position,
+            self.active_tab_style,
+            self.active_bar_style,
+            self.inactive_tab_style,
+            self.inactive_bar_style,
+            self.inactive_text_opacity,
+            self.tab_padding,
+        )
+
+    async def watch__active_tab_name(self, tab_name: str | None) -> None:
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab in the full list with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, compares
+        case-insensitively, and never selects the active tab. If no tab matches, the
+        active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A ``tab_number`` above the tab count is ignored. ``0`` activates the 10th tab
+        when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0 for the 10th or
+                last tab.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with a name. This is the click action of the tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        With no tabs, the key is marked handled and nothing else happens. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left activate the next or previous tab, wrapping at either end.
+        - The keys 1 to 9 activate the tab at that 1-based position. The key 0 activates
+          the 10th tab, or the last tab when there are fewer than ten.
+        - A single letter activates the next tab whose label starts with that letter,
+          if ``search_by_first_character`` is true.
+
+        Every key is marked handled by preventing its default action. Propagation is not
+        stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs.
+
+        Args:
+            tab_name (str, optional): The name to look for.
+
+        Returns:
+            int: The index among the displayed tabs, or 0 if no displayed tab has
+                the name.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
