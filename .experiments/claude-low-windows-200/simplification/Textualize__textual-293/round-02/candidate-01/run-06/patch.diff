+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (2, 6)},
+        width=6,
+    )
+    rendered = _first_rendered_item(bar, 6)
+
+    assert isinstance(rendered, Text)
+    assert rendered.plain == "━╸━━╺━"
+    first, second = rendered.spans[-2:]
+    assert (first.start, first.end) == (0, 2)
+    assert (second.start, second.end) == (2, 6)
+    assert isinstance(first.style, Style)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert second.style.meta == {"@click": "range_clicked('second')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (3, 1), (-5, -2)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"tab": (0, 3)},
+        width=6,
+    )
+    rendered = _first_rendered_item(bar, 6)
+
+    assert isinstance(rendered, Text)
+    assert rendered.plain == "━━━━━━"
+    for span in rendered.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"tab": (2, 3)},
+        width=6,
+    )
+    rendered = _first_rendered_item(bar, 6)
+
+    click = rendered.spans[-1]
+    assert (click.start, click.end) == (2, 3)
+    assert click.style.meta == {"@click": "range_clicked('tab')"}
