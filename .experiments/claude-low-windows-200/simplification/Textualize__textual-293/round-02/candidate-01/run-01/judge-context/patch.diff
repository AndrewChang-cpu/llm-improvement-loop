+def _first_item(bar):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return next(iter(bar.__rich_console__(console, console.options)))
+
+
+def _click_meta(span):
+    assert isinstance(span.style, Style)
+    return span.style.meta.get("@click")
+
+
+def test_clickable_ranges_add_click_spans_last_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (2, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    first, second = item.spans[-2], item.spans[-1]
+    assert (first.start, first.end) == (0, 2)
+    assert _click_meta(first) == "range_clicked('one')"
+    assert (second.start, second.end) == (2, 6)
+    assert _click_meta(second) == "range_clicked('two')"
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    clickable = {"one": (0, 3)}
+    for highlight_range in [(0, 0), (4, 2)]:
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            clickable_ranges=clickable,
+            width=6,
+        )
+        item = _first_item(bar)
+        assert isinstance(item, Text)
+        assert item.plain == "━" * 6
+        for span in item.spans:
+            assert isinstance(span.style, Style)
+            assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"one": (0, 2)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert item.plain == "━╸╺━━━"
+    last = item.spans[-1]
+    assert (last.start, last.end) == (0, 2)
+    assert _click_meta(last) == "range_clicked('one')"
