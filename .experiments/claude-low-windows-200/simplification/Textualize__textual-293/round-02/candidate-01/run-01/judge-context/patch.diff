+import io
+
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def _segments(renderable):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def _rows(renderable):
+    rows = [""]
+    for segment in _segments(renderable):
+        if segment.text == "\n":
+            rows.append("")
+        else:
+            rows[-1] += segment.text
+    return rows
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "first").name == "first"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("One", "1") == Tab("One", "1")
+    assert Tab("One", "1") != Tab("One", "2")
+    assert str(Tab("One", "1")) == "One"
+    assert repr(Tab("One", "1")) == "Tab(label='One', name='1')"
+
+
+def test_construct_with_empty_and_default_styles():
+    empty = Tabs([])
+    assert empty.find_tab_by_name("anything") == 0
+    assert Tabs([Tab("One")]).find_tab_by_name("One") == 0
+
+
+def test_find_tab_by_name_returns_first_index_of_duplicate():
+    tabs = Tabs([Tab("First", "x"), Tab("Other", "y"), Tab("Last", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="A")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "10"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_first_character_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana"), Tab("avocado")], active_tab="Apple"
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Banana"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_no_tabs_row_layout():
+    assert _rows(Tabs([]).render()) == ["", "━" * 100]
+
+
+def test_label_row_with_fixed_tab_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    rows = _rows(tabs.render())
+    assert rows[0] == " One  Two "
+    assert len(rows[1]) == 100
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("First", "x"), Tab("Other", "y"), Tab("Last", "x")],
+        active_tab="x",
+        tab_padding=1,
+    )
+    assert _rows(tabs.render())[0] == " Last  Other "
+
+
+def test_inactive_padded_cell_carries_click_action_and_style():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    inactive = [s for s in _segments(tabs.render()) if "Two" in s.text]
+    assert len(inactive) == 1
+    assert isinstance(inactive[0].style, Style)
+    assert inactive[0].style.meta["@click"] == "range_clicked('Two')"
+    assert inactive[0].text == " Two "
+
+
+def test_underline_row_has_click_action_for_every_displayed_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    names = set()
+    row = 0
+    for segment in _segments(tabs.render()):
+        if segment.text == "\n":
+            row += 1
+        elif row == 1 and isinstance(segment.style, Style):
+            click = segment.style.meta.get("@click")
+            if click:
+                names.add(click)
+    assert names == {"range_clicked('One')", "range_clicked('Two')"}
