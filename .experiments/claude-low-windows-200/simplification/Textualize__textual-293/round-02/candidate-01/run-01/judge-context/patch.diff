diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..86bba24
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,414 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Optional, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab shown in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: Optional[str] = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabEdge:
+    """An edge in the layout resolver: a label or a padding span of a tab."""
+
+    def __init__(
+        self, size: Optional[int] = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The displayed tabs, one per distinct name, in display order.
+        active_tab_name (str, optional): The name of the active tab, if any.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' text.
+        tab_padding (int, optional): Fixed size of each padding edge, or ``None`` to fit
+            the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: Optional[str],
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: Optional[int],
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        # A positive tab_padding fixes each padding edge; otherwise padding flexes.
+        fixed_padding = self.tab_padding if self.tab_padding else None
+
+        # Three edges per tab: left padding, label, right padding.
+        edges: List[_TabEdge] = []
+        for tab in self.tabs:
+            label_width = cell_len(tab.label)
+            edges.append(_TabEdge(size=fixed_padding))
+            if label_width:
+                edges.append(_TabEdge(size=label_width))
+            else:
+                # A zero-width label must resolve to zero, not to a flexible share.
+                edges.append(_TabEdge(min_size=0, fraction=0))
+            edges.append(_TabEdge(size=fixed_padding))
+        sizes = layout_resolve(width, edges)
+
+        label_row: List[Segment] = []
+        label_ranges: List[Tuple[int, int]] = []
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for index, tab in enumerate(self.tabs):
+            left = sizes[3 * index]
+            right = sizes[3 * index + 2]
+            label_width = cell_len(tab.label)
+            label_start = cursor + left
+            label_ranges.append((label_start, label_start + label_width))
+            selection_end = cursor + left + label_width + right
+            selection_ranges[tab.name] = (cursor, selection_end)
+            padded = " " * left + tab.label + " " * right
+
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action.
+                label_row.append(Segment(padded, active_tab_style))
+            else:
+                click_style = inactive_tab_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                text = Text(padded, style=click_style, end="", no_wrap=True)
+                label_row.extend(
+                    console.render(
+                        Opacity(text, opacity=self.inactive_text_opacity), options
+                    )
+                )
+            cursor = selection_end
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield from label_row
+        yield Segment.line()
+        yield from console.render(bar, options)
+
+    def _highlight_range(
+        self, label_ranges: List[Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the label range at the bar position, wrapping at the end.
+
+        Args:
+            label_ranges (List[Tuple[int, int]]): Label range of each displayed tab.
+
+        Returns:
+            Tuple[float, float]: The highlight range in columns.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = floor_position % count
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[index]
+        start_b, end_b = label_ranges[next_index]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs select by name. The label row is on the first line and the underline on the
+    second. Users move between tabs with the keyboard or by clicking a tab.
+
+    Args:
+        tabs (List[Tab]): The tabs, in order. Names may repeat; a repeated name is shown
+            once, at its first position, with the label of its last tab.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. A name that matches no tab is kept,
+            and the bar sits at index 0.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label, or
+            ``None`` to fit the padding to the available width. Defaults to ``None``.
+        search_by_first_character (bool, optional): If true, pressing a key that is not
+            a digit or arrow activates the next tab whose label starts with that
+            character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: Optional[str] = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: Optional[int] = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: Optional[str] = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+
+        # Set the bar position before the name so the initial state does not animate.
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_tabs(self) -> List[Tab]:
+        """Get one tab per distinct name, placed at its first occurrence.
+
+        Returns:
+            List[Tab]: The displayed tabs, showing the label of the last tab per name.
+        """
+        labels: Dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return [Tab(label, name) for name, label in labels.items()]
+
+    def _displayed_index(self, tab_name: Optional[str]) -> int:
+        """Get the index of a name among the displayed tabs.
+
+        Args:
+            tab_name (str, optional): The name to look up.
+
+        Returns:
+            int: The displayed index, or 0 if no displayed tab has the name.
+        """
+        for index, tab in enumerate(self._displayed_tabs()):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab in the full list with a name.
+
+        Args:
+            tab_name (str): The name to look up.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: Optional[str]) -> None:
+        """Animate the underline to the displayed index of the new active tab.
+
+        Args:
+            active_tab_name (str, optional): The new active tab name.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, compares case-insensitively,
+        and never selects the active tab. If nothing matches, the active tab is kept.
+
+        Args:
+            char (str): The character to match against the first letter of each label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label[:1].lower() == target:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        A ``tab_number`` of 0 selects the 10th tab when there are at least ten tabs,
+        and the last tab otherwise. A number above the tab count is ignored.
+
+        Args:
+            tab_number (int): The 1-based position, or 0 as described above.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with the given name active. Invoked by a click on its range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        With no tabs, the key is consumed and nothing else happens. Escape removes focus
+        from the widget. Right and Left move to the next or previous tab, wrapping. The
+        digits 0 to 9 activate tabs by position, using the rule of
+        ``activate_tab_by_number``. Any other single character activates the next tab
+        whose label starts with it, when ``search_by_first_character`` is true. Every
+        key event has its default action prevented, and propagation is not stopped, so
+        application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
