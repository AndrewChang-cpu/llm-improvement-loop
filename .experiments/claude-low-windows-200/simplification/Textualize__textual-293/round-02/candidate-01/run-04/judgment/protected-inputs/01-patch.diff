@@ -0,0 +1,195 @@
+import io
+
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def make_tabs_renderable(tabs, active_tab_name=None, bar_position=0.0, padding=1):
+    return TabsRenderable(
+        tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=padding,
+    )
+
+
+def render_rows(renderable, width):
+    console = Console(width=width, file=io.StringIO())
+    segments = list(console.render(renderable, console.options))
+    rows = [[]]
+    for segment in segments:
+        if segment.text == "\n":
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    return rows
+
+
+def plain(row):
+    return "".join(segment.text for segment in row)
+
+
+def cell_metadata(row):
+    cells = []
+    for segment in row:
+        assert isinstance(segment.style, Style)
+        cells.extend([segment.style.meta] * len(segment.text))
+    return cells
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert tab == Tab("Home", "Home")
+    assert str(tab) == "Home"
+    assert "name='Home'" in repr(tab)
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([]).tabs == []
+    assert Tabs([Tab("One"), Tab("Two")]).tabs[1].name == "Two"
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    assert tabs._active_tab_name == "a"
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+    assert tabs.find_tab_by_name(tabs._active_tab_name) == 1
+
+
+def test_no_tabs_has_no_active_tab():
+    assert Tabs([])._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "c")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_by_number_follows_position_rules():
+    tabs = Tabs([Tab(str(number), f"t{number}") for number in range(1, 6)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "t2"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "t2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t5"
+
+
+def test_activate_by_number_zero_uses_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number), f"t{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [
+            Tab("Home", "home"),
+            Tab("Docs", "docs"),
+            Tab("Dashboard", "dashboard"),
+            Tab("Help", "help"),
+        ]
+    )
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "docs"
+    tabs.activate_tab_by_first_char("D")
+    assert tabs._active_tab_name == "dashboard"
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "docs"
+
+
+def test_first_character_search_without_match_changes_nothing():
+    tabs = Tabs([Tab("Home", "home"), Tab("Docs", "docs")])
+    tabs.activate_tab_by_first_char("x")
+    assert tabs._active_tab_name == "home"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Home", "home"), Tab("Docs", "docs")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "home"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_label_row_uses_fixed_padding():
+    rows = render_rows(
+        make_tabs_renderable([Tab("One", "a"), Tab("Two", "b")], "a", padding=1), 12
+    )
+    assert plain(rows[0]) == " One  Two "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("One", "a"), Tab("Two", "b"), Tab("Uno", "a")]
+    rows = render_rows(make_tabs_renderable(tabs, "a", padding=1), 20)
+    assert plain(rows[0]) == " Uno  Two "
+
+
+def test_inactive_padded_span_carries_click_action_and_is_dimmed():
+    tabs = [Tab("One", "a"), Tab("Two", "b")]
+    rows = render_rows(make_tabs_renderable(tabs, "a", padding=1), 12)
+    active, inactive = rows[0][0], rows[0][1:]
+    assert active.style.meta == {}
+    assert plain(inactive) == " Two "
+    for segment in inactive:
+        assert isinstance(segment.style, Style)
+        assert segment.style.meta == {"@click": "range_clicked('b')"}
+        assert segment.style.color.triplet != (0xF0, 0xF0, 0xF0)
+        assert segment.style.bgcolor.triplet == (0x02, 0x17, 0x20)
+
+
+def test_underline_highlights_active_tab_and_clicks_its_range():
+    tabs = [Tab("One", "a"), Tab("Two", "b")]
+    rows = render_rows(make_tabs_renderable(tabs, "a", bar_position=0.0, padding=1), 10)
+    bar = rows[1]
+    text = plain(bar)
+    assert text[0] == "╸"
+    assert text[1:4] == "━━━"
+    assert text[4] == "╺"
+    metadata = cell_metadata(bar)
+    assert metadata[0] == {"@click": "range_clicked('a')"}
+    assert metadata[9] == {"@click": "range_clicked('b')"}
+
+
+def test_empty_tabs_render_empty_row_and_full_underline():
+    rows = render_rows(make_tabs_renderable([], None, padding=None), 10)
+    assert plain(rows[0]) == ""
+    assert plain(rows[1]) == "━" * 10
+
+
+def test_auto_padding_fills_width_with_at_least_one_cell_per_side():
+    tabs = [Tab("One", "a"), Tab("Two", "b")]
+    rows = render_rows(make_tabs_renderable(tabs, "a", padding=None), 20)
+    label_row = plain(rows[0])
+    assert len(label_row) == 20
+    assert label_row.count("One") == 1
+    assert label_row.count("Two") == 1
