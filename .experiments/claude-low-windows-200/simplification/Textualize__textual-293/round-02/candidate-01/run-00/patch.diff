+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain_text(renderable):
+    return ANSI_PATTERN.sub("", render(renderable))
+
+
+def _segments(renderable, width):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def _first_row(renderable, width):
+    segments = _segments(renderable, width)
+    row = "".join(segment.text for segment in segments)
+    return row.split("\n")[0]
+
+
+def _tabs(*names):
+    return [Tab(name) for name in names]
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.label == "Home"
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "h") != Tab("Home")
+    assert Tab("Home") != Tab("Start")
+
+
+def test_tab_repr_shows_label_and_name():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_default_styles_and_empty_list():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+
+
+def test_construction_with_default_styles_and_tabs():
+    tabs = Tabs(_tabs("One", "Two"))
+    assert tabs._active_tab_name == "One"
+
+
+def test_active_tab_argument_is_used_when_given():
+    tabs = Tabs(_tabs("One", "Two"), active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs(_tabs("One", "Two"), active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A"), Tab("B", "x"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap_around():
+    tabs = Tabs(_tabs("A", "B", "C"))
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_uses_one_based_positions():
+    tabs = Tabs(_tabs("A", "B", "C", "D", "E"))
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_uses_last():
+    tabs = Tabs(_tabs("A", "B", "C", "D", "E"))
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "E"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs_uses_tenth():
+    names = [str(number) for number in range(12)]
+    tabs = Tabs(_tabs(*names))
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_first_char_searches_after_active_tab_and_wraps():
+    tabs = Tabs(_tabs("Apple", "Banana", "avocado", "Blueberry"), active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Blueberry"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs(_tabs("Apple", "Banana"), active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = Tabs(_tabs("Apple", "Banana"), active_tab="Apple")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs(_tabs("One", "Two", "Three"))
+    tabs.action_range_clicked("Three")
+    assert tabs._active_tab_name == "Three"
+
+
+def test_no_tabs_row_is_empty_and_bar_is_full_width_inactive():
+    assert _plain_text(Tabs([]).render()) == "\n" + "━" * 100
+
+
+def test_duplicate_names_display_once_with_last_label_at_first_position():
+    tabs = Tabs(
+        [Tab("A", "x"), Tab("B"), Tab("Last", "x")],
+        tab_padding=1,
+    )
+    first_row = _plain_text(tabs.render()).split("\n")[0]
+    assert first_row == " Last  B "
+
+
+def test_fixed_padding_gives_each_label_padded_span():
+    tabs = Tabs(_tabs("One", "Two"), tab_padding=1)
+    assert _first_row(tabs.render(), 40) == " One  Two "
+
+
+def test_flexible_padding_shares_remaining_width_with_carry():
+    tabs = Tabs(_tabs("A"))
+    # Width 10 minus label 1 leaves 9 cells for two flexible paddings: 4 and 5.
+    assert _first_row(tabs.render(), 10) == "    A     "
+
+
+def test_inactive_padded_span_carries_click_action_and_active_does_not():
+    tabs = Tabs(_tabs("One", "Two"), tab_padding=1)
+    segments = _segments(tabs.render(), 40)
+    by_text = {segment.text: segment for segment in segments if segment.text.strip()}
+
+    active = by_text[" One "]
+    assert isinstance(active.style, Style)
+    assert "@click" not in active.style.meta
+
+    inactive = by_text[" Two "]
+    assert isinstance(inactive.style, Style)
+    assert inactive.style.meta == {"@click": "range_clicked('Two')"}
+
+
+def test_render_returns_tabs_renderable():
+    assert isinstance(Tabs(_tabs("One")).render(), TabsRenderable)
