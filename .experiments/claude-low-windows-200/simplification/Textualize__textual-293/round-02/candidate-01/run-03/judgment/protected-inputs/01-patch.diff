@@ -0,0 +1,437 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Span, Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A single entry in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A size constraint for one part of a tab row, consumed by layout_resolve."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+@dataclass
+class _Slot:
+    """Measured position of one displayed tab, in cells."""
+
+    name: str
+    label: str
+    left: int
+    label_width: int
+    right: int
+    start: int
+    end: int
+
+    @property
+    def text(self) -> str:
+        return " " * self.left + self.label + " " * self.right
+
+    @property
+    def label_range(self) -> tuple[int, int]:
+        label_start = self.start + self.left
+        return (label_start, label_start + self.label_width)
+
+    @property
+    def selection_range(self) -> tuple[int, int]:
+        return (self.start, self.end)
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Return one tab per distinct name, placed at the first occurrence of the name.
+
+    The tab kept for each name is the last tab with that name.
+    """
+    by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its first position and updates the value.
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+def _displayed_index(tabs: list[Tab], tab_name: str | None) -> int:
+    """Return the position of a name among the displayed tabs, or 0 if absent."""
+    names = list(_displayed_tabs(tabs))
+    for index, tab in enumerate(names):
+        if tab.name == tab_name:
+            return index
+    return 0
+
+
+class TabsRenderable:
+    """Renders the label row and underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs. Duplicate names are shown once.
+        active_tab_name (str | None): The name of the active tab, if any.
+        bar_position (float): Fractional index of the underline into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of each inactive tab's padded span.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels.
+        tab_padding (int | None): Fixed padding size on each side of a label, or
+            ``None`` to share the remaining width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_Slot]:
+        """Measure the displayed tabs across the given width."""
+        displayed = _displayed_tabs(self.tabs)
+        # Only a positive tab_padding is fixed. Otherwise padding is flexible.
+        padding: int | None = None
+        if self.tab_padding and self.tab_padding > 0:
+            padding = self.tab_padding
+
+        edges: list[_Edge] = []
+        # For each displayed tab: index of its left padding, label (or None when the
+        # label is empty and so takes no edge), and right padding.
+        indices: list[tuple[int, int | None, int]] = []
+        for tab in displayed:
+            label_width = cell_len(tab.label)
+            left = len(edges)
+            edges.append(_Edge(size=padding))
+            label: int | None = None
+            if label_width:
+                label = len(edges)
+                edges.append(_Edge(size=label_width))
+            right = len(edges)
+            edges.append(_Edge(size=padding))
+            indices.append((left, label, right))
+
+        sizes = layout_resolve(width, edges)
+
+        slots: list[_Slot] = []
+        cursor = 0
+        for tab, (left_index, label_index, right_index) in zip(displayed, indices):
+            left_width = int(sizes[left_index])
+            label_width = 0 if label_index is None else int(sizes[label_index])
+            right_width = int(sizes[right_index])
+            start = cursor
+            end = start + left_width + label_width + right_width
+            slots.append(
+                _Slot(
+                    name=tab.name,
+                    label=tab.label,
+                    left=left_width,
+                    label_width=label_width,
+                    right=right_width,
+                    start=start,
+                    end=end,
+                )
+            )
+            cursor = end
+        return slots
+
+    def _highlight_range(self, slots: list[_Slot]) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges at the bar position."""
+        if not slots:
+            return (0, 0)
+        count = len(slots)
+        base = math.floor(self.bar_position)
+        fraction = self.bar_position - base
+        current = slots[int(base) % count].label_range
+        following = slots[(int(base) + 1) % count].label_range
+        start = current[0] + (following[0] - current[0]) * fraction
+        end = current[1] + (following[1] - current[1]) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        slots = self._layout(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for slot in slots:
+            if slot.name == self.active_tab_name:
+                # The active span carries no click action.
+                yield Segment(slot.text, active_style)
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{slot.name}')"}
+                )
+                padded = Text(
+                    slot.text,
+                    spans=[Span(0, len(slot.text), click_style)],
+                    end="",
+                    no_wrap=True,
+                )
+                yield from console.render(
+                    Opacity(padded, opacity=self.inactive_text_opacity), options
+                )
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(slots),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={slot.name: slot.selection_range for slot in slots},
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the keyboard (Left and Right to move, digit keys to
+    jump by position, and letter keys to search by first character) or with the
+    mouse. Tabs are identified by name, so the active tab is tracked by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. A non-empty value is used even if no
+            tab has that name.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Duration in seconds of the underline animation when
+            the active tab changes. Defaults to 0.3.
+        animation_function (str): Name of the easing function used for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Number of cells on each side of a label. Defaults
+            to ``None``, which shares the remaining width between the padding cells.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if active_tab:
+            initial_name = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(_displayed_index(tabs, initial_name))
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed position of the new active tab."""
+        self.animate(
+            "_bar_position",
+            float(_displayed_index(self.tabs, active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab in the full list with a given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list, and
+        compares case-insensitively. It never selects the active tab. If no other
+        tab matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.casefold()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.casefold().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full list.
+
+        Args:
+            tab_number (int): The 1-based position. A value above the tab count is
+                ignored. ``0`` selects the 10th tab when there are at least ten tabs,
+                and otherwise the last tab.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            tab = self.tabs[9] if len(self.tabs) >= 10 else self.tabs[-1]
+        else:
+            tab = self.tabs[tab_number - 1]
+        self._active_tab_name = tab.name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the target of tab click actions.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard input for the tabs.
+
+        Left and Right move to the previous or next tab, wrapping at either end. The
+        digits 1 to 9 activate the tab at that 1-based position, and 0 follows the rule
+        of activate_tab_by_number. Other keys activate the next tab whose label starts
+        with the key, when search_by_first_character is true. Escape removes focus from
+        the widget. Every key event is marked handled, and none is stopped, so
+        application bindings still receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
