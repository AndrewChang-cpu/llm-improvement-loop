@@ -0,0 +1,122 @@
+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(text: str) -> str:
+    return ANSI.sub("", text)
+
+
+def make_renderable(tabs, active_tab_name=None, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_construct_with_default_styles_and_empty_list():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._bar_position == 0.0
+
+
+def test_construct_with_default_styles_and_tabs():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs.find_tab_by_name("Two") == 1
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert tab == Tab("Home", "Home")
+    assert tab != Tab("Home", "other")
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    assert tabs._active_tab_name == "a"
+
+
+def test_active_tab_given_is_used():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_activate_tab_by_number_one_based_and_zero():
+    tabs = Tabs([Tab(str(number), str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "10"
+
+
+def test_activate_tab_by_number_zero_with_few_tabs_selects_last():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "b"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Alpha", "a"), Tab("beta", "b"), Tab("Apple", "c")],
+        active_tab="c",
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_activate_tab_by_first_char_no_match_keeps_active():
+    tabs = Tabs([Tab("Alpha", "a"), Tab("Beta", "b")], active_tab="b")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "b"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_row_then_full_width_underline():
+    text = plain(render(make_renderable([])))
+    assert text == "\n" + "━" * 100
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("one", "a"), Tab("two", "b"), Tab("three", "a")]
+    text = plain(render(make_renderable(tabs, active_tab_name="b")))
+    first_row = text.split("\n")[0]
+    assert first_row == " three  two "
