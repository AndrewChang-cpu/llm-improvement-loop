+def test_clickable_ranges_add_click_spans_last_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (2, 4)},
+        width=6,
+    )
