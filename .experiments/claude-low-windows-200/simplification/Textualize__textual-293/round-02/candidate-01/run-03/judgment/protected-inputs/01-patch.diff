+    click_spans = text.spans[-2:]
+    assert [(span.start, span.end) for span in click_spans] == [(0, 2), (2, 4)]
+    assert _click_meta(click_spans[0]) == {"@click": "range_clicked('one')"}
+    assert _click_meta(click_spans[1]) == {"@click": "range_clicked('two')"}
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        clickable_ranges={"one": (0, 2)},
+        width=6,
+    )
+    text = _first_text(bar)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert _click_meta(span).get("@click") is None
+
+
+def test_rejected_highlight_takes_early_path_without_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(4, 2),
+        clickable_ranges={"one": (0, 2)},
+        width=6,
+    )
+    text = _first_text(bar)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert _click_meta(span).get("@click") is None
+
+
+def test_zero_width_highlight_at_non_zero_position_keeps_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"one": (2, 2)},
+        width=6,
+    )
+    text = _first_text(bar)
+    assert _click_meta(text.spans[-1]) == {"@click": "range_clicked('one')"}
+    assert (text.spans[-1].start, text.spans[-1].end) == (2, 2)
