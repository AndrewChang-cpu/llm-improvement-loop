+    assert first_click.style.meta == {"@click": "range_clicked('home')"}
+    assert (second_click.start, second_click.end) == (2, 6)
+    assert isinstance(second_click.style, Style)
+    assert second_click.style.meta == {"@click": "range_clicked('docs')"}
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    early_path_ranges = [(0, 0), (-3, -1), (4, 2)]
+    for highlight_range in early_path_ranges:
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            clickable_ranges={"home": (0, 2)},
+            width=6,
+        )
+        item = _first_item(bar)
+        assert isinstance(item, Text)
+        assert item.plain == "━" * 6
+        assert item.spans
+        for span in item.spans:
+            assert isinstance(span.style, Style)
+            assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_gets_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"home": (0, 2)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    last_span = item.spans[-1]
+    assert isinstance(last_span.style, Style)
+    assert last_span.style.meta == {"@click": "range_clicked('home')"}
