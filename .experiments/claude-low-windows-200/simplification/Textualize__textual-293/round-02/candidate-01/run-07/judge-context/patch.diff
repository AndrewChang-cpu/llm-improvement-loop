+import io
+
+from rich.color import Color
+from rich.console import Console
+from rich.segment import Segment
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+CLICK_KEY = "@click"
+
+
+def _console(width=100):
+    return Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+
+
+def _segments(tabs, width=100):
+    console = _console(width)
+    return list(console.render(tabs.render(), console.options))
+
+
+def _rows(segments):
+    rows = [[]]
+    for segment in segments:
+        if segment.text == "\n":
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    return rows
+
+
+def _plain(row):
+    return "".join(segment.text for segment in row)
+
+
+def _cells(row):
+    cells = []
+    for segment in row:
+        for character in segment.text:
+            cells.append((character, segment.style))
+    return cells
+
+
+def _click_of(style):
+    assert isinstance(style, Style)
+    return style.meta.get(CLICK_KEY)
+
+
+def _triplet(color_text):
+    return Color.parse(color_text).triplet
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_and_representation():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "other")
+    assert "label='Home'" in repr(Tab("Home", "h"))
+    assert "name='h'" in repr(Tab("Home", "h"))
+
+
+def test_construction_with_empty_list_and_default_styles():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given_by_name():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    assert tabs._active_tab_name == "Docs"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicate_name():
+    tabs = Tabs([Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("unknown") == 0
+
+
+def test_activate_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")], active_tab="c")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_uses_one_based_positions():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    names = [f"t{index}" for index in range(12)]
+    tabs = Tabs([Tab(name) for name in names])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Home", "home"), Tab("Docs", "docs"), Tab("hello", "hello")],
+        active_tab="home",
+    )
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "hello"
+    tabs.activate_tab_by_first_char("D")
+    assert tabs._active_tab_name == "docs"
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "hello"
+
+
+def test_first_character_search_never_selects_active_tab_and_keeps_on_no_match():
+    tabs = Tabs([Tab("Docs", "docs"), Tab("Home", "home")], active_tab="docs")
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "docs"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "docs"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("Home", "home"), Tab("Docs", "docs")])
+    tabs.action_range_clicked("docs")
+    assert tabs._active_tab_name == "docs"
+
+
+def test_empty_tabs_render_empty_first_row_and_full_underline():
+    tabs = Tabs([])
+    assert _plain(_segments(tabs)) == "\n" + "━" * 100
+
+
+def test_duplicate_names_display_once_at_first_occurrence_with_last_label():
+    tabs = Tabs(
+        [Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")],
+        tab_padding=1,
+    )
+    rows = _rows(_segments(tabs))
+    assert _plain(rows[0]) == " Gamma  Beta "
+
+
+def test_flexible_padding_shares_free_width():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    rows = _rows(_segments(tabs, width=10))
+    assert _plain(rows[0]) == "  A    B  "
+
+
+def test_inactive_span_carries_click_action_and_is_dimmed():
+    tabs = Tabs([Tab("Home", "home"), Tab("Docs", "docs")], tab_padding=1)
+    segments = _segments(tabs)
+    rows = _rows(segments)
+    by_text = {segment.text: segment for segment in rows[0]}
+
+    inactive = by_text[" Docs "]
+    assert _click_of(inactive.style) == "range_clicked('docs')"
+    assert inactive.style.color.triplet != _triplet("#f0f0f0")
+
+    active = by_text[" Home "]
+    assert _click_of(active.style) is None
+    assert active.style.color.triplet == _triplet("#f0f0f0")
+
+
+def test_underline_highlights_active_tab_and_carries_click_actions():
+    tabs = Tabs([Tab("Home", "home"), Tab("Docs", "docs")], tab_padding=1)
+    rows = _rows(_segments(tabs, width=12))
+    cells = _cells(rows[1])
+
+    assert _plain(rows[1]) == "╸" + "━" * 4 + "╺" + "━" * 6
+    assert cells[2][1].color.triplet == _triplet("#1BB152")
+    assert _click_of(cells[0][1]) == "range_clicked('home')"
+    assert _click_of(cells[7][1]) == "range_clicked('docs')"
