diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..af80b6f
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,400 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import blend_style
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A single tab item for the Tabs widget.
+
+    Args:
+        label (str): The text shown on the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[tuple[str, str]]:
+    """Get one (name, label) pair per distinct name.
+
+    A name keeps the position of its first occurrence and shows the label of the
+    last Tab that has that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[tuple[str, str]]: The displayed (name, label) pairs, in display order.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        # Assigning to an existing key keeps its original position.
+        labels[tab.name] = tab.label
+    return list(labels.items())
+
+
+class _Edge:
+    """A flexible horizontal edge whose width is resolved by layout_resolve."""
+
+    def __init__(self) -> None:
+        self.size: int | None = None
+        self.fraction = 1
+        self.min_size = 1
+
+
+class TabsRenderable:
+    """Renderable that draws the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list. Only displayed tabs are drawn.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): Fractional index into the displayed tabs that places
+            the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans, before
+            the inactive opacity is applied.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab text.
+        tab_padding (int | None): Fixed number of padding cells on each side of a
+            label. When None or zero, padding fills the remaining width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _resolve_paddings(
+        self, displayed: list[tuple[str, str]], width: int
+    ) -> list[tuple[int, int]]:
+        """Get the (left, right) padding cell counts for each displayed tab.
+
+        Args:
+            displayed (list[tuple[str, str]]): Displayed (name, label) pairs.
+            width (int): The available width in cells.
+
+        Returns:
+            list[tuple[int, int]]: Padding sizes, one pair per displayed tab.
+        """
+        count = len(displayed)
+        if self.tab_padding:
+            return [(self.tab_padding, self.tab_padding)] * count
+
+        # Label edges have fixed widths, so only the padding edges are flexible.
+        label_total = sum(cell_len(label) for _, label in displayed)
+        sizes = layout_resolve(
+            width - label_total, [_Edge() for _ in range(2 * count)]
+        )
+        return [(sizes[2 * index], sizes[2 * index + 1]) for index in range(count)]
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        paddings = self._resolve_paddings(displayed, width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = blend_style(
+            console.get_style(self.inactive_tab_style), self.inactive_text_opacity
+        )
+
+        label_row = Text(end="\n", no_wrap=True, overflow="crop")
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        position = 0
+        for (name, label), (left, right) in zip(displayed, paddings):
+            label_start = position + left
+            label_end = label_start + cell_len(label)
+            selection_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[name] = (position, selection_end)
+
+            if name == self.active_tab_name:
+                span_style = active_style
+            else:
+                click_style = Style(meta={"@click": f"range_clicked('{name}')"})
+                span_style = inactive_style + click_style
+            # The padded span is one run, so its padding shares the label's style.
+            label_row.append(" " * left + label + " " * right, style=span_style)
+            position = selection_end
+
+        yield label_row
+
+        highlight_range = (0.0, 0.0)
+        count = len(displayed)
+        if count:
+            # Clamp so an out-of-range position still indexes a displayed tab.
+            position_value = min(max(self.bar_position, 0.0), count - 1)
+            index = int(position_value)
+            fraction = position_value - index
+            next_index = (index + 1) % count
+            start_a, end_a = label_ranges[index]
+            start_b, end_b = label_ranges[next_index]
+            highlight_range = (
+                start_a + (start_b - start_a) * fraction,
+                end_a + (end_b - end_a) * fraction,
+            )
+
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal tab bar with an animated underline.
+
+    Tabs are selected with the keyboard or the mouse. The active tab is shown by an
+    underline bar that slides to the newly active tab.
+
+    Args:
+        tabs (list[Tab]): The ordered tabs to show. Names need not be unique.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            None, which selects the first tab.
+        active_tab_style (StyleType): Style of the active tab label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults
+            to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Number of padding cells on each side of a label.
+            Defaults to None, which fits padding to the available width.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name = Reactive(None)
+    _bar_position = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            active_name: str | None = None
+        elif active_tab:
+            active_name = active_tab
+        else:
+            active_name = tabs[0].name
+        self._active_tab_name = active_name
+        self._bar_position = float(self._displayed_index(active_name))
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The tab name to look up.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the position of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index, or 0 if the name is not displayed.
+        """
+        names = [name for name, _ in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, compares
+        case-insensitively, and never selects the active tab. If no tab matches, the
+        active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        folded = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(folded):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        Numbers above the tab count are ignored. Number 0 activates the 10th tab when
+        there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0 for the rule above.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Invoked by clicks on a tab's selection range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the displayed index of the active tab.
+
+        Args:
+            tab_name (str | None): The name of the newly active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the tab bar has focus.
+
+        Right and Left move to the next or previous tab, wrapping at either end. Keys
+        0 through 9 activate tabs by position, as in ``activate_tab_by_number``. When
+        ``search_by_first_character`` is true, a letter key activates the next tab whose
+        label starts with that letter. Escape removes focus from the widget. Every key
+        event is marked handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
