@@ -0,0 +1,180 @@
+import io
+
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def _tabs(*tabs: Tab, **kwargs) -> Tabs:
+    return Tabs(list(tabs), **kwargs)
+
+
+def _console(width: int = 40) -> Console:
+    return Console(width=width, file=io.StringIO(), color_system="truecolor")
+
+
+def _parts(renderable: TabsRenderable, width: int = 40):
+    """Return the label row Text and the underline bar for a TabsRenderable."""
+    console = _console(width)
+    row, bar = list(renderable.__rich_console__(console, console.options))
+    return row, bar
+
+
+def _plain(renderable, width: int = 40) -> str:
+    console = _console(width)
+    segments = console.render(renderable, console.options)
+    return "".join(segment.text for segment in segments)
+
+
+def _click(span) -> str | None:
+    assert isinstance(span.style, Style)
+    return span.style.meta.get("@click")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "start").name == "start"
+
+
+def test_tab_equality_compares_label_and_name():
+    assert Tab("a") == Tab("a", "a")
+    assert Tab("a") != Tab("a", "b")
+
+
+def test_tab_text_form_is_label_and_repr_shows_both_fields():
+    tab = Tab("Home", "start")
+    assert str(tab) == "Home"
+    assert "Home" in repr(tab) and "start" in repr(tab)
+
+
+def test_construction_with_default_styles_succeeds():
+    assert isinstance(Tabs([]), Tabs)
+    assert isinstance(_tabs(Tab("One")), Tabs)
+
+
+def test_render_returns_tabs_renderable():
+    assert isinstance(_tabs(Tab("One")).render(), TabsRenderable)
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = _tabs(Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x"))
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = _tabs(Tab("A"), Tab("B"), Tab("C"), active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_by_number_one_based():
+    tabs = _tabs(Tab("A"), Tab("B"), Tab("C"))
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_by_number_above_count_is_ignored():
+    tabs = _tabs(Tab("A"), Tab("B"), Tab("C"), active_tab="B")
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_by_number_zero_fewer_than_ten_selects_last():
+    tabs = _tabs(Tab("A"), Tab("B"), Tab("C"))
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_by_number_zero_with_ten_selects_tenth():
+    tabs = _tabs(*[Tab(f"t{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t9"
+
+
+def test_first_character_search_starts_after_active_and_wraps():
+    tabs = _tabs(Tab("Apple"), Tab("Banana"), Tab("Avocado"), active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active():
+    tabs = _tabs(Tab("Apple"), Tab("Banana"), active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active():
+    tabs = _tabs(Tab("Apple"), Tab("Banana"), active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = _tabs(Tab("One", "x"), Tab("Two", "y"))
+    tabs.action_range_clicked("y")
+    assert tabs._active_tab_name == "y"
+
+
+def test_no_tabs_row_is_empty_and_underline_is_full_width():
+    row, bar = _parts(_tabs().render())
+    assert row.plain == ""
+    assert _plain(bar, width=10) == "━" * 10
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = _tabs(Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x"))
+    row, _ = _parts(tabs.render())
+    assert "One" not in row.plain
+    assert "Three" in row.plain
+    assert row.plain.count("Two") == 1
+
+
+def test_auto_fit_padding_distributes_remaining_width():
+    tabs = _tabs(Tab("A"), Tab("BB"))
+    row, _ = _parts(tabs.render(), width=20)
+    assert row.plain == " " * 4 + "A" + " " * 8 + "BB" + " " * 5
+
+
+def test_inactive_padded_span_has_click_action_and_dimming():
+    tabs = _tabs(Tab("One"), Tab("Two"), active_tab="One", tab_padding=1)
+    row, _ = _parts(tabs.render())
+    active, inactive = row.spans[0], row.spans[1]
+    assert isinstance(inactive.style, Style)
+    assert row.plain[inactive.start : inactive.end] == " Two "
+    assert _click(inactive) == "range_clicked('Two')"
+    assert _click(active) is None
+
+
+def test_inactive_text_is_dimmed_relative_to_resolved_style():
+    tabs = _tabs(Tab("One"), Tab("Two"), active_tab="One", tab_padding=1)
+    row, _ = _parts(tabs.render())
+    console = _console()
+    full = console.get_style("#f0f0f0 on #021720")
+    inactive = row.spans[1].style
+    assert inactive.color.triplet != full.color.triplet
+
+
+def test_underline_highlights_active_tab_and_has_click_ranges_for_all_tabs():
+    tabs = _tabs(Tab("A", "x"), Tab("B", "y"), active_tab="y", tab_padding=1)
+    _, bar = _parts(tabs.render())
+    text = _plain(bar, width=40)
+    assert text[4] == "━"
+    assert text[3] == "╸"
+    assert text[5] == "╺"
+
+    console = _console()
+    bar_text = list(bar.__rich_console__(console, console.options))[0]
+    first, second = bar_text.spans[-2], bar_text.spans[-1]
+    assert (first.start, first.end) == (0, 3)
+    assert _click(first) == "range_clicked('x')"
+    assert (second.start, second.end) == (3, 6)
+    assert _click(second) == "range_clicked('y')"
