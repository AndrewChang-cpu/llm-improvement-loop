+class ConsoleDouble:
+    def get_style(self, style):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+class OptionsDouble:
+    def __init__(self, max_width):
+        self.max_width = max_width
+
+
+def yielded_items(bar, max_width=6):
+    return list(bar.__rich_console__(ConsoleDouble(), OptionsDouble(max_width)))
+
+
+def click_meta(span):
+    assert isinstance(span.style, Style)
+    return span.style.meta
+
+
+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (4, 6)},
+        width=6,
+    )
+    items = yielded_items(bar)
+
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    first, second = text.spans[-2:]
+    assert (first.start, first.end) == (0, 2)
+    assert (second.start, second.end) == (4, 6)
+    assert click_meta(first) == {"@click": "range_clicked('first')"}
+    assert click_meta(second) == {"@click": "range_clicked('second')"}
+
+
+def test_highlight_middle_plain_text_has_half_glyphs_at_edges():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    (text,) = yielded_items(bar)
+
+    assert text.plain == "━╸━━╺━"
+
+
+@pytest.mark.parametrize(
+    "highlight_range",
+    [(0, 0), (4, 2), (-5, -2)],
+)
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"a": (0, 2)},
+        width=6,
+    )
+    items = yielded_items(bar)
+
+    assert len(items) == 1
+    text = items[0]
+    assert text.plain == "━" * 6
+    for span in text.spans:
+        assert click_meta(span) == {}
+
+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"a": (0, 2)},
+        width=6,
+    )
+    (text,) = yielded_items(bar)
+
+    assert text.plain == "━╸╺━━━"
+    span = text.spans[-1]
+    assert (span.start, span.end) == (0, 2)
+    assert click_meta(span) == {"@click": "range_clicked('a')"}
