+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_SGR = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(text):
+    return ANSI_SGR.sub("", text)
+
+
+def segments_of(renderable):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def test_construction_with_empty_and_populated_tab_lists():
+    Tabs([])
+    Tabs([Tab("One"), Tab("Two", "two")])
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "first").name == "first"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("A") == Tab("A", "A")
+    assert Tab("A") != Tab("A", "b")
+    assert str(Tab("A", "b")) == "A"
+    assert "label='A'" in repr(Tab("A", "b"))
+    assert "name='b'" in repr(Tab("A", "b"))
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B"), Tab("C", "x")])
+
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("B") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_active_tab_option_is_honoured():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_unknown_active_tab_is_kept_as_given():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+
+    assert tabs._active_tab_name == "zzz"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_follows_position_rules():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 13)])
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot"), Tab("Cherry")])
+
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apricot"
+
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_changes_nothing():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Banana")
+
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_no_tabs_renders_empty_row_and_full_width_underline():
+    lines = plain(render(Tabs([]).render())).split("\n")
+
+    assert lines == ["", "━" * 100]
+
+
+def test_duplicate_names_display_once_at_first_occurrence_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B"), Tab("C", "x")], tab_padding=1)
+
+    lines = plain(render(tabs.render())).split("\n")
+
+    assert lines[0] == " C  B "
+
+
+def test_underline_highlights_active_tab_span():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B", tab_padding=1)
+
+    lines = plain(render(tabs.render())).split("\n")
+
+    assert lines[0] == " A  B  C "
+    assert lines[1] == "━━━╸━╺" + "━" * 94
+
+
+def test_inactive_padded_span_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="A", tab_padding=1)
+
+    segments = segments_of(tabs.render())
+    inactive = [segment for segment in segments if segment.text == " B "]
+
+    assert len(inactive) == 1
+    style = inactive[0].style
+    assert isinstance(style, Style)
+    assert style.meta == {"@click": "range_clicked('B')"}
+    original = Color.parse("#f0f0f0")
+    assert style.color.triplet != original.triplet
