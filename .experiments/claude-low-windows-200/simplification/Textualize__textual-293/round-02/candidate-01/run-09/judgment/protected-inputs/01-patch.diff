@@ -0,0 +1,146 @@
+import io
+import re
+from typing import List, Tuple
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_SGR = re.compile(r"\x1b\[[0-9;]*m")
+
+Cell = Tuple[str, dict]
+
+
+def rows_of(renderable, width: int) -> List[List[Cell]]:
+    """Render to rows of (character, click metadata) cells, split on newlines."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    rows: List[List[Cell]] = [[]]
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n":
+            rows.append([])
+            continue
+        meta = segment.style.meta if segment.style else {}
+        rows[-1].extend((character, meta) for character in segment.text)
+    return rows
+
+
+def row_text(row: List[Cell]) -> str:
+    return "".join(character for character, _ in row)
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_text_and_repr():
+    assert Tab("a") == Tab("a", "a")
+    assert Tab("a") != Tab("a", "b")
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_empty_list_and_default_styles():
+    assert Tabs([]) is not None
+    assert Tabs([Tab("a"), Tab("b")]) is not None
+
+
+def test_find_tab_by_name_returns_first_duplicate_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_at_either_end():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")], active_tab="c")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number_follows_position_rule():
+    tabs = Tabs([Tab(f"Tab {n}", f"t{n}") for n in range(1, 13)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "t3"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+    tabs.activate_tab_by_number(13)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_key_zero_with_fewer_than_ten_tabs_selects_last_tab():
+    tabs = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_first_char_search_is_case_insensitive_wraps_and_skips_active():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Avocado"), Tab("banana")], active_tab="Apple"
+    )
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("a"), Tab("b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_row_layout_is_empty_then_full_inactive_bar():
+    plain = render(Tabs([]).render())
+    plain = ANSI_SGR.sub("", plain)
+    assert plain == "\n" + "━" * 100
+
+
+def test_label_row_uses_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    rows = rows_of(tabs.render(), 30)
+    assert row_text(rows[0]) == " Home  Docs "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")], tab_padding=1
+    )
+    rows = rows_of(tabs.render(), 12)
+    assert row_text(rows[0]) == " Three  Two "
+    # The active name "x" sits under the displayed "Three" slot (columns 1 to 6).
+    assert row_text(rows[1]) == "╸━━━━━╺━━━━━"
+
+
+def test_inactive_padding_cells_share_click_action_and_active_does_not():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y")], tab_padding=1)
+    rows = rows_of(tabs.render(), 12)
+    label_row = rows[0]
+    # Active "One" spans columns 0 to 4 with no click action.
+    assert "@click" not in label_row[1][1]
+    # Inactive "Two" spans columns 5 to 9; its padding cells carry the click action.
+    for column in (5, 6, 7, 8, 9):
+        assert label_row[column][1] == {"@click": "range_clicked('y')"}
+
+
+def test_underline_click_spans_cover_selection_range_of_inactive_tab():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y")], tab_padding=1)
+    rows = rows_of(tabs.render(), 12)
+    bar_row = rows[1]
+    for column in (5, 6, 7, 8, 9):
+        assert bar_row[column][1] == {"@click": "range_clicked('y')"}
+
+
+def test_unmatched_active_tab_keeps_bar_at_index_zero():
+    tabs = Tabs([Tab("a"), Tab("b")], active_tab="zzz", tab_padding=1)
+    rows = rows_of(tabs.render(), 10)
+    assert row_text(rows[1]) == "╸━╺" + "━" * 7
