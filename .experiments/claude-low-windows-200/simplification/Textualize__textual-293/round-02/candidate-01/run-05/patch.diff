+def test_highlight_edges_use_half_cell_glyphs():
+    bar = UnderlineBar(highlight_range=(2, 4), width=6)
+    text = render_items(bar)[0]
+    assert text.plain == "━╸━━╺━"
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        width=6,
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+    )
+    items = render_items(bar)
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert isinstance(span.style, Style)
+        assert span.style.meta.get("@click") is None
+
+
+def test_rejected_highlight_has_no_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(4, 2),
+        width=6,
+        clickable_ranges={"first": (0, 3)},
+    )
+    text = render_items(bar)[0]
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert isinstance(span.style, Style)
