@@ -0,0 +1,420 @@
+from __future__ import annotations
+
+import math
+from typing import NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import _get_blended_style_cached
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A single tab in a Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str | None): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Slot(NamedTuple):
+    """Computed layout of one displayed tab, in cell columns."""
+
+    name: str
+    label: str
+    left: int
+    right: int
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+
+
+class _Edge:
+    """A flexible layout edge for the shared layout resolver."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_labels(tabs: list[Tab]) -> dict[str, str]:
+    """Map each distinct name to the label of its last tab.
+
+    Dictionary insertion keeps each name at its first occurrence, while later
+    duplicates overwrite the label, so the last tab's label wins.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return labels
+
+
+def _dim_style(style: Style, opacity: float) -> Style:
+    """Blend a resolved style's foreground toward its background.
+
+    Styles without RGB triplets are returned unchanged, matching Opacity.
+    """
+    fg, bg = style.color, style.bgcolor
+    if fg and fg.triplet and bg and bg.triplet:
+        return style + _get_blended_style_cached(
+            fg_color=fg, bg_color=bg, opacity=opacity
+        )
+    return style
+
+
+def _range_clicked_meta(name: str) -> Style:
+    return Style(meta={"@click": f"range_clicked('{name}')"})
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted underline.
+        inactive_tab_style (StyleType): Style of inactive padded spans.
+        inactive_bar_style (StyleType): Style of the non-highlighted underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive spans.
+        tab_padding (int | None): Fixed padding per side, or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_Slot]:
+        """Compute label and selection ranges for each displayed tab.
+
+        Label widths are fixed. Padding edges are fixed when tab_padding is
+        positive, otherwise they share the remaining width via the layout resolver.
+        """
+        displayed = list(_displayed_labels(self.tabs).items())
+        label_widths = [cell_len(label) for _, label in displayed]
+
+        if self.tab_padding and self.tab_padding > 0:
+            paddings = [self.tab_padding] * (2 * len(displayed))
+        else:
+            flexible = [_Edge() for _ in range(2 * len(displayed))]
+            remaining = width - sum(label_widths)
+            paddings = layout_resolve(remaining, flexible)
+
+        slots: list[_Slot] = []
+        offset = 0
+        for index, ((name, label), label_width) in enumerate(
+            zip(displayed, label_widths)
+        ):
+            left = paddings[2 * index]
+            right = paddings[2 * index + 1]
+            label_start = offset + left
+            label_end = label_start + label_width
+            span_end = label_end + right
+            slots.append(
+                _Slot(
+                    name=name,
+                    label=label,
+                    left=left,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(offset, span_end),
+                )
+            )
+            offset = span_end
+        return slots
+
+    def _highlight_range(self, slots: list[_Slot]) -> tuple[float, float]:
+        """Interpolate the highlight between the floor index and the next index.
+
+        The next index wraps to the first tab after the last one.
+        """
+        if not slots:
+            return (0, 0)
+        floor = math.floor(self.bar_position)
+        fraction = self.bar_position - floor
+        current = slots[floor % len(slots)].label_range
+        following = slots[(floor + 1) % len(slots)].label_range
+        start = current[0] + (following[0] - current[0]) * fraction
+        end = current[1] + (following[1] - current[1]) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        slots = self._layout(width)
+
+        label_row = Text(end="\n", no_wrap=True, overflow="crop")
+        for slot in slots:
+            if slot.name == self.active_tab_name:
+                style = console.get_style(self.active_tab_style)
+            else:
+                style = _dim_style(
+                    console.get_style(self.inactive_tab_style),
+                    self.inactive_text_opacity,
+                ) + _range_clicked_meta(slot.name)
+            label_row.append(" " * slot.left + slot.label + " " * slot.right, style)
+        yield label_row
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(slots),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges={slot.name: slot.selection_range for slot in slots},
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are identified by name. Duplicate names are shown once, at the first
+    occurrence, with the label of the last tab that has that name.
+
+    Args:
+        tabs (list[Tab]): The ordered tabs to show.
+        active_tab (str | None): The name of the initially active tab. Used when
+            non-empty and defaults to the first tab's name otherwise. A name that
+            matches no tab is kept, and the underline sits at index 0.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted underline. Defaults to
+            ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the non-highlighted underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation, in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None): Cells of padding on each side of a label. ``None``
+            or zero fits the padding to the available width, with a minimum of one
+            cell per side. Defaults to None.
+        search_by_first_character (bool): When True, pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._display_index(initial_name))
+
+    def _display_index(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs, or 0 if absent."""
+        names = list(_displayed_labels(self.tabs))
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str): The name to look up.
+
+        Returns:
+            int: Index of the first tab in the full list with that name, or 0 if none.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full list active, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full list active, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full list,
+        compares case-insensitively, and never selects the active tab. Nothing
+        changes when no tab matches or when search_by_first_character is False.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        if not self.search_by_first_character:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position, using the key-press numbering rules.
+
+        Args:
+            tab_number (int): A 1-based position. Zero selects the 10th tab when there
+                are at least ten tabs, otherwise the last tab. Numbers above the tab
+                count are ignored.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Invoked by clicks on the tab or underline.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed index of the new active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._display_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget receives them.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and Left move to the next or previous tab, wrapping at either end.
+        - The digits 1 through 9 activate the tab at that 1-based position, and 0
+          follows the rules of ``activate_tab_by_number``.
+        - Any other single-character key starts a first-character search when
+          ``search_by_first_character`` is True.
+
+        Every key event is marked handled by preventing its default action. Propagation
+        is not stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
