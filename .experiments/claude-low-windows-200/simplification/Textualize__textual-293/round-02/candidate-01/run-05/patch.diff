+import io
+
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+
+def render_items(tabs, width=40):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(tabs.render().__rich_console__(console, console.options))
+
+
+def active_name(tabs):
+    return tabs._active_tab_name
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert tab == Tab("Home", "Home")
+    assert tab != Tab("Home", "other")
+    assert "Home" in repr(tab)
+
+
+def test_construct_with_empty_and_populated_tab_lists():
+    Tabs([])
+    Tabs([Tab("One")], active_tab="One")
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "b")])
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], tab_padding=1
+    )
+    label_row = render_items(tabs)[0]
+    assert label_row.plain == " Three  Two "
+
+
+def test_no_tabs_renders_empty_label_row_and_full_width_underline():
+    label_row, underline = render_items(Tabs([]), width=10)
+    assert label_row.plain == ""
+    assert underline.plain == "━" * 10
+    for span in underline.spans:
+        assert isinstance(span.style, Style)
+        assert span.style.meta.get("@click") is None
+
+
+def test_padded_span_shares_style_and_click_action():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], tab_padding=1)
+    label_row = render_items(tabs)[0]
+    assert label_row.plain == " One  Two "
+    assert len(label_row.spans) == 2
+    active, inactive = label_row.spans
+    assert isinstance(active.style, Style)
+    assert isinstance(inactive.style, Style)
+    assert (active.start, active.end) == (0, 5)
+    assert active.style.meta.get("@click") is None
+    assert (inactive.start, inactive.end) == (5, 11)
+    assert inactive.style.meta == {"@click": "range_clicked('b')"}
+    assert inactive.style.color != Style.parse("#f0f0f0").color
+
+
+def test_flexible_padding_fills_width_with_carried_fraction():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    label_row = render_items(tabs, width=40)[0]
+    first, second = label_row.spans
+    assert (first.start, first.end) == (0, 20)
+    assert (second.start, second.end) == (20, 40)
+
+
+def test_underline_highlights_active_label_and_clicks_include_active_tab():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "c")],
+        active_tab="b",
+        tab_padding=1,
+    )
+    label_row, underline = render_items(tabs)
+    assert label_row.plain == " One  Two  Three "
+    assert underline.plain[5] == "╸"
+    assert underline.plain[6:9] == "━━━"
+    assert underline.plain[9] == "╺"
+    clicks = underline.spans[-3:]
+    assert [(span.start, span.end) for span in clicks] == [(0, 5), (5, 10), (10, 18)]
+    assert [span.style.meta["@click"] for span in clicks] == [
+        "range_clicked('a')",
+        "range_clicked('b')",
+        "range_clicked('c')",
+    ]
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "c")])
+    tabs.activate_next_tab()
+    assert active_name(tabs) == "b"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert active_name(tabs) == "a"
+    tabs.activate_previous_tab()
+    assert active_name(tabs) == "c"
+
+
+def test_activate_tab_by_number_rules():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "c")])
+    tabs.activate_tab_by_number(2)
+    assert active_name(tabs) == "b"
+    tabs.activate_tab_by_number(9)
+    assert active_name(tabs) == "b"
+    tabs.activate_tab_by_number(0)
+    assert active_name(tabs) == "c"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab_when_ten_or_more():
+    tabs = Tabs([Tab(f"T{index}", f"t{index}") for index in range(1, 12)])
+    tabs.activate_tab_by_number(0)
+    assert active_name(tabs) == "t10"
+
+
+def test_first_character_search_wraps_and_skips_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert active_name(tabs) == "apricot"
+    tabs.activate_tab_by_first_char("A")
+    assert active_name(tabs) == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert active_name(tabs) == "Apple"
+
+
+def test_first_character_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana")], search_by_first_character=False
+    )
+    tabs.activate_tab_by_first_char("b")
+    assert active_name(tabs) == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    tabs.action_range_clicked("b")
+    assert active_name(tabs) == "b"
