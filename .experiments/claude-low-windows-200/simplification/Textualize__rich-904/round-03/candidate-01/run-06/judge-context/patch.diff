+class VerticalCenter(JupyterMixin):
+    """Vertically aligns a renderable within the console height.
+
+    Args:
+        renderable (RenderableType): A console renderable.
+    """
+
+    def __init__(self, renderable: "RenderableType") -> None:
+        self.renderable = renderable
+
+    def __repr__(self) -> str:
+        return f"{self.__class__.__name__}({self.renderable!r})"
+
+    def __rich_console__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> "RenderResult":
+        lines = console.render_lines(self.renderable, options, pad=False)
+        new_line = Segment.line()
+        height = console.size.height
+        line_count = len(lines)
+        top_space = (height - line_count) // 2
+        bottom_space = height - top_space - line_count - 1
+
+        if top_space > 0:
+            yield Segment("\n" * top_space)
+        for line in lines:
+            yield from line
+            yield new_line
+        if bottom_space > 0:
+            yield Segment("\n" * bottom_space)
+
+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        measurement = Measurement.get(console, self.renderable, max_width)
+        return measurement
+
+
