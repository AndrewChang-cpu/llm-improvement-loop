 import pytest
 
 from rich.console import Console
-from rich.align import Align
+from rich.align import Align, VerticalCenter
 from rich.measure import Measurement
 
 
@@ -87,3 +87,37 @@ def test_shortcuts():
     assert Align.right("foo").renderable == "foo"
     assert Align.center("foo").align == "center"
     assert Align.center("foo").renderable == "foo"
+
+
+def test_align_repr():
+    assert repr(Align("foo", "left")).startswith("Align(")
+    assert repr(Align("foo", "center")).startswith("Align(")
+    assert repr(Align("foo", "right")).startswith("Align(")
+    assert repr(Align("foo", "left")) == "Align('foo', 'left')"
+
+
+def test_vertical_center_repr():
+    assert repr(VerticalCenter("foo")) == "VerticalCenter('foo')"
+
+
+def test_vertical_center_render():
+    console = Console(file=io.StringIO(), width=10, height=6, color_system=None)
+    console.begin_capture()
+    console.print(VerticalCenter("foo"))
+    result = console.end_capture()
+    assert result == "\n\nfoo\n\n\n"
+
+
+def test_vertical_center_measure():
+    console = Console(file=io.StringIO())
+    _min, _max = Measurement.get(console, VerticalCenter("foo"), console.width)
+    assert _min == 3
+    assert _max == 3
+
+
+def test_align_measured_constrain():
+    console = Console(file=io.StringIO(), width=20)
+    console.begin_capture()
+    console.print(Align("foo bar", "right"))
+    result = console.end_capture()
+    assert result == " " * 13 + "foo bar\n"
