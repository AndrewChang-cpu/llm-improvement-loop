@@ -151,6 +152,37 @@ class Tree(JupyterMixin):
                 guide_style_stack.push(get_style(node.guide_style))
                 push(iter(loop_last(node.children)))
 
+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        minimum = 0
+        maximum = 0
+        get_measurement = Measurement.get
+        stack: List[Iterator[Tree]] = []
+        level = 0
+        node: Optional[Tree] = self
+
+        while node is not None:
+            label_minimum, label_maximum = get_measurement(
+                console, node.label, max_width
+            )
+            indent = level * 4
+            minimum = max(minimum, label_minimum + indent)
+            maximum = max(maximum, label_maximum + indent)
+
+            if node.expanded and node.children:
+                stack.append(iter(node.children))
+                level += 1
+
+            node = None
+            while stack:
+                next_node = next(stack[-1], None)
+                if next_node is not None:
+                    node = next_node
+                    break
+                stack.pop()
+                level -= 1
+
+        return Measurement(minimum, maximum)
+
 
