--- a/tests/test_align.py
+++ b/tests/test_align.py
@@ -3,7 +3,7 @@ import io
 import pytest
 
 from rich.console import Console
-from rich.align import Align
+from rich.align import Align, VerticalCenter
 from rich.measure import Measurement
 
 
@@ -87,3 +87,42 @@ def test_shortcuts():
     assert Align.right("foo").renderable == "foo"
     assert Align.center("foo").align == "center"
     assert Align.center("foo").renderable == "foo"
+
+
+def test_repr():
+    assert repr(Align("foo", "left")) == "Align('foo', 'left')"
+    assert repr(Align("foo", "center")) == "Align('foo', 'center')"
+    assert repr(Align("foo", "right")) == "Align('foo', 'right')"
+    assert repr(VerticalCenter("foo")) == "VerticalCenter('foo')"
+
+
+def test_vertical_center_render():
+    console = Console(file=io.StringIO(), height=6, color_system=None)
+    console.begin_capture()
+    console.print(VerticalCenter("foo"), end="")
+    result = console.end_capture()
+    assert result == "\n\nfoo\n\n\n"
+
+
+def test_vertical_center_no_padding_when_full():
+    console = Console(file=io.StringIO(), height=2, color_system=None)
+    console.begin_capture()
+    console.print(VerticalCenter("foo\nbar"), end="")
+    result = console.end_capture()
+    assert result == "foo\nbar\n"
+
+
+def test_vertical_center_measure():
+    console = Console(file=io.StringIO(), width=20)
+    _min, _max = Measurement.get(console, VerticalCenter("foo"), 20)
+    assert _min == 3
+    assert _max == 3
+
+
+def test_align_constrains_to_measured_maximum():
+    console = Console(file=io.StringIO(), width=20)
+    console.begin_capture()
+    console.print(Align("foo", "center"))
+    result = console.end_capture()
+    # "foo" measures 3 wide, so it is centered as a 3-cell block in 20 cells
+    assert result == "        foo         \n"
