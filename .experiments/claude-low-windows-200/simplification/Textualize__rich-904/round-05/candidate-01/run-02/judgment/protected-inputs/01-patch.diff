@@ -151,6 +152,31 @@ class Tree(JupyterMixin):
                 guide_style_stack.push(get_style(node.guide_style))
                 push(iter(loop_last(node.children)))
 
+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        stack: List[Iterator[Tree]] = [iter([self])]
+        push = stack.append
+        pop = stack.pop
+        level = 0
+        minimum = 0
+        maximum = 0
+
+        while stack:
+            try:
+                node = next(stack[-1])
+            except StopIteration:
+                pop()
+                level -= 1
+                continue
+            indent = level * 4
+            label_measurement = Measurement.get(console, node.label, max_width)
+            minimum = max(minimum, label_measurement.minimum + indent)
+            maximum = max(maximum, label_measurement.maximum + indent)
+            if node.expanded and node.children:
+                level += 1
+                push(iter(node.children))
+
+        return Measurement(minimum, maximum)
+
 
 if __name__ == "__main__":  # pragma: no cover
 
