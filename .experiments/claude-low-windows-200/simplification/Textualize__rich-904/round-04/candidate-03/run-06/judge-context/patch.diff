@@ -87,3 +87,42 @@ def test_shortcuts():
     assert Align.right("foo").renderable == "foo"
     assert Align.center("foo").align == "center"
     assert Align.center("foo").renderable == "foo"
+
+
+def test_align_repr():
+    assert repr(Align("foo", "left")) == "Align('foo', 'left')"
+    assert repr(Align("foo", "center")) == "Align('foo', 'center')"
+    assert repr(Align("foo", "right")) == "Align('foo', 'right')"
+
+
+def test_vertical_center_repr():
+    assert repr(VerticalCenter("foo")) == "VerticalCenter('foo')"
+
+
+def test_vertical_center():
+    console = Console(file=io.StringIO(), width=10, height=6, color_system=None)
+    console.begin_capture()
+    console.print(VerticalCenter("foo"))
+    result = console.end_capture()
+    assert result == "\n\nfoo\n\n\n"
+
+
+def test_vertical_center_measure():
+    console = Console(file=io.StringIO())
+    assert Measurement.get(console, VerticalCenter("foo"), 80) == (3, 3)
+
+
+def test_align_constrains_shrink_to_fit_renderable():
+    from rich.tree import Tree
+
+    tree = Tree("foo")
+    tree.add("bar")
+    tree.add("musroom risotto")
+    console = Console(file=io.StringIO(), width=40, color_system=None)
+    console.begin_capture()
+    console.print(Align(tree, "center"))
+    result = console.end_capture()
+    lines = result.splitlines()
+    # Tree is 19 cells wide, so centering leaves 10 cells of left padding
+    assert lines[0].startswith(" " * 10 + "foo")
+    assert lines[1].startswith(" " * 10 + "├── bar")
