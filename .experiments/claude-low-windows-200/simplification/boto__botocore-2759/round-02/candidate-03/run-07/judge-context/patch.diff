+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            mock.Mock(),
+            mock.Mock(),
+            mock.Mock(),
+            self.config_store,
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            client_config=Config(),
+            config_store=self.config_store,
+        )
+
+    def _make_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            self.resolver,
+            client_config=client_config,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        params = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': 'https://my.legacy.endpoint.com',
+        }
+        params.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **params
+        )
+
+    def test_default_inputs_produce_expected_builtins(self):
+        result = self._compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.AWS_REGION], 'ca-central-1'
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_FIPS])
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT]
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_S3_ACCELERATE])
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP])
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_config_store_fips_true_sets_use_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_USE_FIPS])
+
+    def test_config_store_fips_false_leaves_use_fips_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_FIPS])
+
+    def test_s3_control_with_s3_dualstack_setting_enables_dualstack(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_s3_control_with_s3_dualstack_off_leaves_dualstack_false(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': False})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_other_service_ignores_s3_dualstack_setting(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertFalse(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_us_west_2_default_sts_configuration_is_global(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_eu_south_1_sts_is_not_global(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_us_west_2_regional_sts_setting_is_not_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_s3_predicate_true_sets_s3_global_with_single_call(self):
+        s3_config = {}
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self._compute(s3_config=s3_config)
+        predicate.assert_called_once_with('ca-central-1', s3_config)
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_s3_accelerate_setting_passes_through(self):
+        for value in (True, False):
+            with self.subTest(value=value):
+                result = self._compute(
+                    s3_config={'use_accelerate_endpoint': value}
+                )
+                self.assertEqual(
+                    result[EndpointResolverBuiltins.AWS_S3_ACCELERATE], value
+                )
+
+    def test_path_addressing_style_forces_path_style(self):
+        result = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+
+    def test_auto_and_virtual_addressing_styles_disable_path_style(self):
+        for style in ('auto', 'virtual'):
+            with self.subTest(style=style):
+                result = self._compute(s3_config={'addressing_style': style})
+                self.assertFalse(
+                    result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+                )
+
+    def test_use_arn_region_false_disables_both_arn_region_builtins(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION]
+        )
+        self.assertFalse(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+
+    def test_use_arn_region_true_enables_both_arn_region_builtins(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertTrue(result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertTrue(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+
+    def test_mrap_setting_passes_through(self):
+        for value in (True, False):
+            with self.subTest(value=value):
+                result = self._compute(
+                    s3_config={'s3_disable_multiregion_access_points': value}
+                )
+                self.assertEqual(
+                    result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], value
+                )
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.endpoint.com',
+        )
+
+    def test_custom_data_without_client_url_returns_legacy_url(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://my.legacy.endpoint.com',
+        )
+
+    def test_bundled_data_without_client_url_omits_sdk_endpoint(self):
+        result = self._compute()
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
