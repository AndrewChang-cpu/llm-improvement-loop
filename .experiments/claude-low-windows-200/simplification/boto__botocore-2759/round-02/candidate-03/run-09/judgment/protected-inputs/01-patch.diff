+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = self._make_bridge(Config())
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _make_bridge(self, client_config):
+        return ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_inputs_produce_expected_builtins(self):
+        builtins = self._compute()
+        self.assertEqual(builtins[EndpointResolverBuiltins.AWS_REGION],
+                         'ca-central-1')
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE],
+                      False)
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP],
+                      False)
+        self.assertIsNone(builtins[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_config_store_fips_true_enables_fips_builtin(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_config_store_fips_false_leaves_fips_builtin_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+
+    def test_s3_control_with_s3_dualstack_true_enables_dualstack(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        builtins = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True
+        )
+
+    def test_s3_control_with_s3_dualstack_false_disables_dualstack(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': False})
+        )
+        builtins = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_other_service_ignores_s3_dualstack_true_setting(self):
+        bridge = self._make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        builtins = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_us_west_2_default_sts_configuration_is_global(self):
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+
+    def test_eu_south_1_sts_is_not_global(self):
+        builtins = self._compute(region_name='eu-south-1')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_us_west_2_regional_sts_configuration_is_not_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+
+    def test_s3_predicate_true_sets_s3_global_with_single_call(self):
+        s3_config = {}
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self._compute(s3_config=s3_config)
+        predicate.assert_called_once_with('ca-central-1', s3_config)
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+
+    def test_use_accelerate_endpoint_true_passes_through(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE],
+                      True)
+
+    def test_use_accelerate_endpoint_false_passes_through(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE],
+                      False)
+
+    def test_path_addressing_style_forces_path_style(self):
+        builtins = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], True
+        )
+
+    def test_auto_and_virtual_addressing_styles_do_not_force_path_style(self):
+        for style in ('auto', 'virtual'):
+            builtins = self._compute(s3_config={'addressing_style': style})
+            self.assertIs(
+                builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE],
+                False,
+            )
+
+    def test_use_arn_region_false_disables_both_arn_region_builtins(self):
+        builtins = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+
+    def test_use_arn_region_true_enables_both_arn_region_builtins(self):
+        builtins = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            True,
+        )
+
+    def test_mrap_disabled_true_passes_through(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP],
+                      True)
+
+    def test_mrap_disabled_false_passes_through(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP],
+                      False)
+
+    def test_client_endpoint_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self._compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.endpoint.com',
+        )
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self._compute()
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_bundled_data_without_client_url_leaves_sdk_endpoint_absent(self):
+        builtins = self._compute()
+        self.assertIsNone(builtins[EndpointResolverBuiltins.SDK_ENDPOINT])
