+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint resolver builtin values for one client.
+
+        All eleven builtins are computed on every call, regardless of
+        ``service_name``. Keys are ``EndpointResolverBuiltins`` members.
+
+        ``SDK::Endpoint`` precedence: a truthy ``client_endpoint_url``
+        wins. Otherwise ``legacy_endpoint_url`` is used when custom
+        endpoint data is in use, and the value is None (absent) when
+        bundled endpoint data is in use.
+        """
+        use_fips = endpoint_bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = endpoint_bridge._resolve_use_dualstack_endpoint(
+            service_name
+        )
+        use_global_sts = self._should_set_global_sts_endpoint(
+            region_name, None, None
+        )
+        use_global_s3 = self._should_force_s3_global(region_name, s3_config)
+        if client_endpoint_url:
+            sdk_endpoint = client_endpoint_url
+        elif not endpoint_bridge.endpoint_resolver.uses_builtin_data:
+            sdk_endpoint = legacy_endpoint_url
+        else:
+            sdk_endpoint = None
+        path_style = s3_config.get('addressing_style') == 'path'
+        return {
+            EPRBuiltins.AWS_REGION: region_name,
+            EPRBuiltins.AWS_USE_FIPS: use_fips or False,
+            EPRBuiltins.AWS_USE_DUALSTACK: use_dualstack or False,
+            EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: use_global_sts,
+            EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: use_global_s3,
+            EPRBuiltins.AWS_S3_ACCELERATE: s3_config.get(
+                'use_accelerate_endpoint', False
+            ),
+            EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: path_style,
+            EPRBuiltins.AWS_S3_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', True
+            ),
+            EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', False
+            ),
+            EPRBuiltins.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+            EPRBuiltins.SDK_ENDPOINT: sdk_endpoint,
+        }
