+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            None,
+            None,
+            None,
+            self.config_store,
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+
+    def _make_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        call_kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self._make_bridge(),
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': LEGACY_URL,
+        }
+        call_kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **call_kwargs
+        )
+
+    def test_default_scenario_computes_all_builtins(self):
+        result = self._compute()
+        self.assertEqual(result[EPRB.AWS_REGION], 'ca-central-1')
+        self.assertFalse(result[EPRB.AWS_USE_FIPS])
+        self.assertFalse(result[EPRB.AWS_USE_DUALSTACK])
+        self.assertTrue(result[EPRB.AWS_STS_USE_GLOBAL_ENDPOINT])
+        self.assertFalse(result[EPRB.AWS_S3_USE_GLOBAL_ENDPOINT])
+        self.assertFalse(result[EPRB.AWS_S3_ACCELERATE])
+        self.assertFalse(result[EPRB.AWS_S3_FORCE_PATH_STYLE])
+        self.assertTrue(result[EPRB.AWS_S3_USE_ARN_REGION])
+        self.assertFalse(result[EPRB.AWS_S3CONTROL_USE_ARN_REGION])
+        self.assertFalse(result[EPRB.AWS_S3_DISABLE_MRAP])
+        self.assertIsNone(result[EPRB.SDK_ENDPOINT])
+
+    def test_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertTrue(result[EPRB.AWS_USE_FIPS])
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertFalse(result[EPRB.AWS_USE_FIPS])
+
+    def test_s3_service_dualstack_true_from_client_s3_config(self):
+        bridge = self._make_bridge(
