+
+    def test_virtual_addressing_style_gives_force_path_style_false(self):
+        B = EndpointResolverBuiltins
+        result = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(result[B.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_use_arn_region_false_gives_both_arn_region_false(self):
+        B = EndpointResolverBuiltins
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(result[B.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(result[B.AWS_S3CONTROL_USE_ARN_REGION], False)
+
+    def test_use_arn_region_true_gives_both_arn_region_true(self):
+        B = EndpointResolverBuiltins
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(result[B.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[B.AWS_S3CONTROL_USE_ARN_REGION], True)
+
+    def test_mrap_disabled_true_passes_through(self):
+        B = EndpointResolverBuiltins
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(result[B.AWS_S3_DISABLE_MRAP], True)
+
+    def test_mrap_disabled_false_passes_through(self):
+        B = EndpointResolverBuiltins
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(result[B.AWS_S3_DISABLE_MRAP], False)
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        B = EndpointResolverBuiltins
+        self.resolver.uses_builtin_data = False
+        result = self._compute(client_endpoint_url='https://client.endpoint')
+        self.assertEqual(result[B.SDK_ENDPOINT], 'https://client.endpoint')
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        B = EndpointResolverBuiltins
+        self.resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(
+            result[B.SDK_ENDPOINT], 'https://my.legacy.endpoint.com'
+        )
+
+    def test_bundled_data_without_client_url_leaves_sdk_endpoint_absent(self):
+        B = EndpointResolverBuiltins
+        result = self._compute()
+        self.assertIsNone(result[B.SDK_ENDPOINT])
