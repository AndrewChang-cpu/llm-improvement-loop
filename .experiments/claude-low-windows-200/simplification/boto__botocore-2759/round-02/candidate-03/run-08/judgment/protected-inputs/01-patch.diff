+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=client_config or Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _builtins(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self._bridge(),
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_scenario_produces_expected_builtins(self):
+        builtins = self._builtins()
+        self.assertEqual(builtins['AWS::Region'], 'ca-central-1')
+        self.assertIs(builtins['AWS::UseFIPS'], False)
+        self.assertIs(builtins['AWS::UseDualStack'], False)
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], True)
+        self.assertIs(builtins['AWS::S3::UseGlobalEndpoint'], False)
+        self.assertIs(builtins['AWS::S3::Accelerate'], False)
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], False)
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], True)
+        self.assertIs(builtins['AWS::S3Control::UseArnRegion'], False)
+        self.assertIs(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+        self.assertIsNone(builtins['SDK::Endpoint'])
+
+    def test_config_store_use_fips_true_sets_fips_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._builtins()
+        self.assertIs(builtins['AWS::UseFIPS'], True)
+
+    def test_config_store_use_fips_false_sets_fips_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._builtins()
+        self.assertIs(builtins['AWS::UseFIPS'], False)
+
+    def test_s3_control_service_with_client_dualstack_true(self):
+        bridge = self._bridge(Config(s3={'use_dualstack_endpoint': True}))
+        builtins = self._builtins(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(builtins['AWS::UseDualStack'], True)
+
+    def test_s3_control_service_with_client_dualstack_false(self):
+        bridge = self._bridge(Config(s3={'use_dualstack_endpoint': False}))
+        builtins = self._builtins(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(builtins['AWS::UseDualStack'], False)
+
+    def test_other_service_ignores_s3_dualstack_setting(self):
+        bridge = self._bridge(Config(s3={'use_dualstack_endpoint': True}))
+        builtins = self._builtins(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertIs(builtins['AWS::UseDualStack'], False)
+
+    def test_us_west_2_default_sts_configuration_is_global(self):
+        builtins = self._builtins(region_name='us-west-2')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_eu_south_1_sts_is_not_global(self):
+        builtins = self._builtins(region_name='eu-south-1')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_us_west_2_regional_sts_configuration_is_not_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._builtins(region_name='us-west-2')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_predicate_true_sets_s3_global_and_calls_predicate_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self._builtins()
+        self.assertIs(builtins['AWS::S3::UseGlobalEndpoint'], True)
+        predicate.assert_called_once_with('ca-central-1', {})
+
+    def test_use_accelerate_endpoint_true_passes_through(self):
+        builtins = self._builtins(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(builtins['AWS::S3::Accelerate'], True)
+
+    def test_use_accelerate_endpoint_false_passes_through(self):
+        builtins = self._builtins(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(builtins['AWS::S3::Accelerate'], False)
+
+    def test_addressing_style_path_forces_path_style(self):
+        builtins = self._builtins(s3_config={'addressing_style': 'path'})
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], True)
+
+    def test_addressing_style_auto_does_not_force_path_style(self):
+        builtins = self._builtins(s3_config={'addressing_style': 'auto'})
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], False)
+
+    def test_addressing_style_virtual_does_not_force_path_style(self):
+        builtins = self._builtins(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], False)
+
+    def test_use_arn_region_false_disables_both_arn_region_builtins(self):
+        builtins = self._builtins(s3_config={'use_arn_region': False})
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], False)
+        self.assertIs(builtins['AWS::S3Control::UseArnRegion'], False)
+
+    def test_use_arn_region_true_enables_both_arn_region_builtins(self):
+        builtins = self._builtins(s3_config={'use_arn_region': True})
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], True)
+        self.assertIs(builtins['AWS::S3Control::UseArnRegion'], True)
+
+    def test_disable_mrap_true_passes_through(self):
+        builtins = self._builtins(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints'], True
+        )
+
+    def test_disable_mrap_false_passes_through(self):
+        builtins = self._builtins(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self._builtins(
+            client_endpoint_url='https://client.example.com'
+        )
+        self.assertEqual(
+            builtins['SDK::Endpoint'], 'https://client.example.com'
+        )
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self._builtins()
+        self.assertEqual(builtins['SDK::Endpoint'], self.legacy_url)
+
+    def test_bundled_data_without_client_url_has_absent_sdk_endpoint(self):
+        builtins = self._builtins()
+        self.assertIsNone(builtins['SDK::Endpoint'])
