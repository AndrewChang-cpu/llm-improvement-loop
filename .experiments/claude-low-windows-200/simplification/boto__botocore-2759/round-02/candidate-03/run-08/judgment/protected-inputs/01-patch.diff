+class EndpointResolverBuiltins(str, Enum):
+    """Builtin names consumed by endpoint rulesets.
+
+    Each member equals its string value. Comments give the meaning and
+    type of each builtin.
+    """
+
+    # Region name of the client. String.
+    AWS_REGION = 'AWS::Region'
+    # Whether FIPS endpoints are requested. Boolean.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Whether DualStack endpoints are requested. Boolean.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Whether the global STS endpoint is used. Boolean.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Whether the global S3 endpoint is used. Boolean.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Whether S3 Transfer Acceleration is requested. Boolean.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Whether S3 path-style addressing is forced. Boolean.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Whether the region in an S3 ARN is used. Boolean by default; the raw
+    # configuration value otherwise.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Whether the region in an S3 Control ARN is used. Boolean by default;
+    # the raw configuration value otherwise.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Whether multi-region access points are disabled for S3. Boolean.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Endpoint URL supplied by the SDK. String, or absent. A client endpoint
+    # URL takes precedence; otherwise the legacy endpoint URL is used when
+    # custom endpoint data is in use.
+    SDK_ENDPOINT = 'SDK::Endpoint'
