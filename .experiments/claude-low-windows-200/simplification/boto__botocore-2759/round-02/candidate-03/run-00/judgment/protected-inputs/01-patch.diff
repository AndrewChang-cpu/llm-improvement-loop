+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            mock.Mock(),
+            mock.Mock(),
+            mock.Mock(),
+            self.config_store,
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(self, **overrides):
+        call_kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        call_kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **call_kwargs
+        )
+
+    def test_default_values_for_bundled_data_without_client_url(self):
+        builtins = self.compute()
+        self.assertEqual(builtins[EPRBuiltins.AWS_REGION], 'ca-central-1')
+        self.assertFalse(builtins[EPRBuiltins.AWS_USE_FIPS])
+        self.assertFalse(builtins[EPRBuiltins.AWS_USE_DUALSTACK])
+        self.assertTrue(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT])
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT])
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3_ACCELERATE])
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE])
+        self.assertTrue(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION])
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP])
+        self.assertIsNone(builtins[EPRBuiltins.SDK_ENDPOINT])
+
+    def test_use_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self.compute()
+        self.assertTrue(builtins[EPRBuiltins.AWS_USE_FIPS])
+
+    def test_use_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self.compute()
+        self.assertFalse(builtins[EPRBuiltins.AWS_USE_FIPS])
+
+    def test_s3_control_dualstack_true_from_client_config_s3(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self.compute(service_name='s3-control')
+        self.assertTrue(builtins[EPRBuiltins.AWS_USE_DUALSTACK])
+
+    def test_s3_control_dualstack_false_from_client_config_s3(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self.compute(service_name='s3-control')
+        self.assertFalse(builtins[EPRBuiltins.AWS_USE_DUALSTACK])
+
+    def test_other_service_ignores_dualstack_from_client_config_s3(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self.compute(service_name='other-service')
+        self.assertFalse(builtins[EPRBuiltins.AWS_USE_DUALSTACK])
+
+    def test_sts_global_in_us_west_2_with_default_sts_configuration(self):
+        builtins = self.compute(region_name='us-west-2')
+        self.assertTrue(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT])
+
+    def test_sts_not_global_in_eu_south_1_with_default_sts_configuration(self):
+        builtins = self.compute(region_name='eu-south-1')
+        self.assertFalse(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT])
+
+    def test_sts_not_global_in_us_west_2_with_regional_sts_configuration(self):
