+    def test_use_arn_region_false_applies_to_both_arn_builtins(self):
+        builtins = self.compute(s3_config={'use_arn_region': False})
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION])
+
+    def test_use_arn_region_true_applies_to_both_arn_builtins(self):
+        builtins = self.compute(s3_config={'use_arn_region': True})
+        self.assertTrue(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertTrue(builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION])
+
+    def test_disable_mrap_true_passes_through(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP])
+
+    def test_disable_mrap_false_passes_through(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP])
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute(
+            client_endpoint_url='https://client.endpoint.example.com'
+        )
+        self.assertEqual(
+            builtins[EPRBuiltins.SDK_ENDPOINT],
+            'https://client.endpoint.example.com',
+        )
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute()
+        self.assertEqual(builtins[EPRBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_bundled_data_without_client_url_is_absent_despite_legacy(self):
+        builtins = self.compute()
+        self.assertIsNone(builtins[EPRBuiltins.SDK_ENDPOINT])
