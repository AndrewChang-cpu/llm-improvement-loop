+class EndpointResolverBuiltins(str, enum.Enum):
+    """Builtin names consumed by endpoint rulesets.
+
+    Each member's value is the builtin name as written in endpoint rulesets.
+    """
+
+    # String: the region name passed to client creation.
+    AWS_REGION = 'AWS::Region'
+    # Boolean: whether FIPS endpoints are requested.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Boolean: whether DualStack endpoints are requested.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Boolean: whether STS uses the global endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Boolean: whether S3 uses the global endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Boolean: whether S3 accelerate endpoints are requested.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Boolean: whether S3 path-style addressing is forced.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Boolean by default; raw config value otherwise: whether S3 ARNs
+    # use the region from the ARN.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Boolean by default; raw config value otherwise: whether S3Control
+    # ARNs use the region from the ARN.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Boolean: whether S3 multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # String, or absent (None). A truthy client endpoint URL takes
+    # precedence. Otherwise the legacy endpoint URL is used when custom
+    # endpoint data is in use, and the value is absent when bundled
+    # endpoint data is in use.
+    SDK_ENDPOINT = 'SDK::Endpoint'
