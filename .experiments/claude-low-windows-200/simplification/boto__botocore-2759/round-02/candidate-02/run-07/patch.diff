+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=botocore.config.Config(),
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        client_endpoint_url=None,
+        legacy_endpoint_url=None,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        if legacy_endpoint_url is None:
+            legacy_endpoint_url = self.legacy_url
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=self.bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=legacy_endpoint_url,
+        )
+
+    def test_default_builtins_with_bundled_data_and_legacy_url(self):
+        result = self.compute()
+        self.assertEqual(result[EPRBuiltins.AWS_REGION], 'ca-central-1')
+        self.assertFalse(result[EPRBuiltins.AWS_USE_FIPS])
+        self.assertFalse(result[EPRBuiltins.AWS_USE_DUALSTACK])
+        self.assertTrue(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT])
+        self.assertFalse(result[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT])
+        self.assertFalse(result[EPRBuiltins.AWS_S3_ACCELERATE])
+        self.assertFalse(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE])
+        self.assertTrue(result[EPRBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertFalse(result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION])
+        self.assertFalse(result[EPRBuiltins.AWS_S3_DISABLE_MRAP])
+        self.assertIsNone(result[EPRBuiltins.SDK_ENDPOINT])
+
+    def test_use_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertTrue(result[EPRBuiltins.AWS_USE_FIPS])
+
+    def test_use_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertFalse(result[EPRBuiltins.AWS_USE_FIPS])
+
+    def test_s3_control_dualstack_true_from_client_s3_config(self):
+        self.bridge.client_config = botocore.config.Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertTrue(result[EPRBuiltins.AWS_USE_DUALSTACK])
+
+    def test_s3_control_dualstack_false_from_client_s3_config(self):
+        self.bridge.client_config = botocore.config.Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertFalse(result[EPRBuiltins.AWS_USE_DUALSTACK])
+
+    def test_other_service_ignores_client_s3_dualstack_setting(self):
+        self.bridge.client_config = botocore.config.Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self.compute(service_name='other-service')
+        self.assertFalse(result[EPRBuiltins.AWS_USE_DUALSTACK])
+
+    def test_sts_global_for_us_west_2_default_configuration(self):
+        result = self.compute(region_name='us-west-2')
+        self.assertTrue(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT])
+
+    def test_sts_not_global_for_eu_south_1(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertFalse(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT])
+
+    def test_sts_regional_setting_disables_global_in_us_west_2(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self.compute(region_name='us-west-2')
+        self.assertFalse(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT])
+
+    def test_s3_global_predicate_called_once_and_true_is_used(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self.compute(region_name='us-east-1')
+        predicate.assert_called_once_with('us-east-1', {})
+        self.assertTrue(result[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT])
+
+    def test_accelerate_true_passes_through(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertTrue(result[EPRBuiltins.AWS_S3_ACCELERATE])
+
+    def test_accelerate_false_passes_through(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertFalse(result[EPRBuiltins.AWS_S3_ACCELERATE])
+
+    def test_mrap_true_passes_through(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(result[EPRBuiltins.AWS_S3_DISABLE_MRAP])
+
+    def test_mrap_false_passes_through(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(result[EPRBuiltins.AWS_S3_DISABLE_MRAP])
+
+    def test_addressing_style_path_forces_path_style(self):
+        result = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertTrue(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE])
+
+    def test_addressing_style_auto_does_not_force_path_style(self):
+        result = self.compute(s3_config={'addressing_style': 'auto'})
+        self.assertFalse(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE])
+
+    def test_addressing_style_virtual_does_not_force_path_style(self):
+        result = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertFalse(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE])
+
+    def test_use_arn_region_false_disables_both_arn_region_builtins(self):
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertFalse(result[EPRBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertFalse(result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION])
+
+    def test_use_arn_region_true_enables_both_arn_region_builtins(self):
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertTrue(result[EPRBuiltins.AWS_S3_USE_ARN_REGION])
+        self.assertTrue(result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION])
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self.compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            result[EPRBuiltins.SDK_ENDPOINT], 'https://client.endpoint.com'
+        )
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(
+            result[EPRBuiltins.SDK_ENDPOINT], 'https://my.legacy.endpoint.com'
+        )
+
+    def test_region_builtin_is_region_argument_as_given(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertEqual(result[EPRBuiltins.AWS_REGION], 'eu-south-1')
