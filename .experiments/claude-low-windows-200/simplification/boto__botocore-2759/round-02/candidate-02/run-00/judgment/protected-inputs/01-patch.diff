+class EndpointResolverBuiltins(str, enum.Enum):
+    """Builtin names consumed by endpoint rulesets, with their meaning."""
+
+    # The region name for the client, as given at client creation.
+    # Type: string.
+    AWS_REGION = 'AWS::Region'
+    # Whether FIPS endpoints are requested. Type: boolean.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Whether DualStack endpoints are requested. Type: boolean.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Whether STS should use the global endpoint. Type: boolean.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Whether S3 should use the global endpoint. Type: boolean.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Whether S3 Transfer Acceleration is requested. Type: boolean.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Whether S3 path-style addressing is forced. Type: boolean.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Whether S3 uses the ARN region. Type: boolean by default, otherwise
+    # the raw configuration value.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Whether S3Control uses the ARN region. Type: boolean by default,
+    # otherwise the raw configuration value.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Whether S3 multi-region access points are disabled. Type: boolean.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # The SDK endpoint: a client endpoint URL if one is given, otherwise
+    # the legacy endpoint URL when custom endpoint data is in use. Absent
+    # (None) otherwise. Type: string, or absent.
+    SDK_ENDPOINT = 'SDK::Endpoint'
