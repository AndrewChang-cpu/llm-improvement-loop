+class EndpointResolverBuiltins(str, Enum):
+    """Builtin names consumed by endpoint rulesets.
+
+    Each member's value is the builtin name used by endpoint rulesets.
+    """
+
+    # AWS::Region - string. The region name the client was created with.
+    AWS_REGION = 'AWS::Region'
+    # AWS::UseFIPS - boolean. Whether FIPS endpoints are requested.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # AWS::UseDualStack - boolean. Whether DualStack endpoints are requested.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # AWS::STS::UseGlobalEndpoint - boolean. Whether STS uses the global
+    # endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # AWS::S3::UseGlobalEndpoint - boolean. Whether S3 uses the global
+    # endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # AWS::S3::Accelerate - boolean. Whether S3 accelerate is enabled.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # AWS::S3::ForcePathStyle - boolean. Whether S3 uses path-style
+    # addressing.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # AWS::S3::UseArnRegion - boolean by default; the raw configured value
+    # when set. Whether S3 uses the region from an ARN.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # AWS::S3Control::UseArnRegion - boolean by default; the raw configured
+    # value when set. Whether S3 Control uses the region from an ARN.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # AWS::S3::DisableMultiRegionAccessPoints - boolean. Whether
+    # multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # SDK::Endpoint - string, or absent. The endpoint URL the SDK resolved.
+    SDK_ENDPOINT = 'SDK::Endpoint'
