+class EndpointResolverBuiltins(str, enum.Enum):
+    """Builtin names that endpoint rulesets consume."""
+
+    # Type: string. The region name passed to client creation.
+    AWS_REGION = 'AWS::Region'
+    # Type: boolean. Whether FIPS endpoints are requested.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Type: boolean. Whether DualStack endpoints are requested.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Type: boolean. Whether STS uses the global endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Type: boolean. Whether S3 uses the global endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Type: boolean. Whether S3 transfer acceleration is enabled.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Type: boolean. Whether S3 uses path-style addressing.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Type: boolean by default; the raw config value otherwise.
+    # Whether S3 ARNs use the region embedded in the ARN.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Type: boolean by default; the raw config value otherwise.
+    # Whether S3Control ARNs use the region embedded in the ARN.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Type: boolean. Whether S3 multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Type: string, or absent. The SDK endpoint URL. A client endpoint
+    # URL takes precedence over the legacy endpoint URL, which is used
+    # only when custom endpoint data is in use.
+    SDK_ENDPOINT = 'SDK::Endpoint'
