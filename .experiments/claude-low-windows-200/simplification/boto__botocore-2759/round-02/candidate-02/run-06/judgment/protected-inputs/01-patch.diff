+
+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=Config(),
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        client_endpoint_url=None,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=self.bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=self.legacy_url,
+        )
+
+    def test_bundled_data_with_legacy_url_and_no_client_url_has_defaults(
+        self,
+    ):
+        builtins = self._compute()
+        self.assertEqual(builtins['AWS::Region'], 'ca-central-1')
+        self.assertFalse(builtins['AWS::UseFIPS'])
+        self.assertFalse(builtins['AWS::UseDualStack'])
+        self.assertTrue(builtins['AWS::STS::UseGlobalEndpoint'])
+        self.assertFalse(builtins['AWS::S3::UseGlobalEndpoint'])
+        self.assertFalse(builtins['AWS::S3::Accelerate'])
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+        self.assertTrue(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3::DisableMultiRegionAccessPoints'])
+        self.assertIsNone(builtins['SDK::Endpoint'])
+
+    def test_config_store_use_fips_true_sets_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertTrue(builtins['AWS::UseFIPS'])
+
+    def test_config_store_use_fips_false_leaves_fips_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertFalse(builtins['AWS::UseFIPS'])
+
+    def test_s3_control_client_config_dualstack_true_sets_dualstack(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self._compute(service_name='s3-control')
+        self.assertTrue(builtins['AWS::UseDualStack'])
+
+    def test_s3_control_client_config_dualstack_false_clears_dualstack(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self._compute(service_name='s3-control')
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_other_service_ignores_s3_client_config_dualstack(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self._compute(service_name='other-service')
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_us_west_2_default_sts_configuration_is_global(self):
+        builtins = self._compute(region_name='us-west-2')
+        self.assertTrue(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_eu_south_1_sts_is_not_global(self):
+        builtins = self._compute(region_name='eu-south-1')
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_us_west_2_sts_regional_configuration_is_not_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(region_name='us-west-2')
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_s3_global_predicate_true_is_called_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self._compute(region_name='us-east-1')
+        self.assertTrue(builtins['AWS::S3::UseGlobalEndpoint'])
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_s3_accelerate_true_passes_through(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertTrue(builtins['AWS::S3::Accelerate'])
+
+    def test_s3_accelerate_false_passes_through(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertFalse(builtins['AWS::S3::Accelerate'])
+
+    def test_s3_mrap_disabled_true_passes_through(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(builtins['AWS::S3::DisableMultiRegionAccessPoints'])
+
+    def test_s3_mrap_disabled_false_passes_through(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(builtins['AWS::S3::DisableMultiRegionAccessPoints'])
+
+    def test_addressing_style_path_forces_path_style(self):
+        builtins = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertTrue(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_addressing_style_auto_and_virtual_do_not_force_path_style(self):
+        for style in ('auto', 'virtual'):
+            with self.subTest(addressing_style=style):
+                builtins = self._compute(
+                    s3_config={'addressing_style': style}
+                )
+                self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_use_arn_region_false_sets_both_arn_regions_false(self):
+        builtins = self._compute(s3_config={'use_arn_region': False})
+        self.assertFalse(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_use_arn_region_true_sets_both_arn_regions_true(self):
+        builtins = self._compute(s3_config={'use_arn_region': True})
+        self.assertTrue(builtins['AWS::S3::UseArnRegion'])
+        self.assertTrue(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_client_endpoint_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        client_url = 'https://client.endpoint.com'
+        builtins = self._compute(client_endpoint_url=client_url)
+        self.assertEqual(builtins['SDK::Endpoint'], client_url)
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self._compute()
+        self.assertEqual(builtins['SDK::Endpoint'], self.legacy_url)
