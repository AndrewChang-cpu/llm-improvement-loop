+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint ruleset builtin values for one client.
+
+        Every call computes all of the builtins, whatever the service name.
+        The returned mapping has one key per EPRBuiltins member, and the
+        values are as follows:
+
+        - AWS_REGION is region_name, unchanged.
+        - AWS_USE_FIPS and AWS_USE_DUALSTACK are booleans. Falsy lookups
+          from the endpoint bridge become False.
+        - AWS_STS_USE_GLOBAL_ENDPOINT and AWS_S3_USE_GLOBAL_ENDPOINT come
+          from the existing STS and S3 global-endpoint predicates.
+        - AWS_S3_ACCELERATE, AWS_S3_FORCE_PATH_STYLE, AWS_S3_USE_ARN_REGION,
+          AWS_S3CONTROL_USE_ARN_REGION, and AWS_S3_DISABLE_MRAP are read
+          from s3_config. The ARN region values are passed through as the
+          raw config value when one is set, and default to True for S3 and
+          False for S3Control.
+        - SDK_ENDPOINT is a string or None. A truthy client_endpoint_url
+          takes precedence. Otherwise, if the resolver uses custom endpoint
+          data, legacy_endpoint_url is used, which may be None. Otherwise
+          the value is None.
+
+        :type region_name: str
+        :param region_name: The region name for the client.
+
+        :type service_name: str
+        :param service_name: The name of the service being created.
+
+        :type s3_config: dict
+        :param s3_config: The S3 configuration. It may be empty.
+
+        :type endpoint_bridge: ClientEndpointBridge
+        :param endpoint_bridge: The bridge used for the FIPS and DualStack
+            lookups and for the resolver's bundled-data flag.
+
+        :type client_endpoint_url: str
+        :param client_endpoint_url: The endpoint URL passed to client
+            creation, or None.
+
+        :type legacy_endpoint_url: str
+        :param legacy_endpoint_url: The URL from legacy endpoint resolution,
+            or None.
+
+        :rtype: dict
+        :return: A mapping from EPRBuiltins members to their values.
+        """
+        use_fips = endpoint_bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = endpoint_bridge._resolve_use_dualstack_endpoint(
+            service_name
+        )
+        uses_builtin_data = endpoint_bridge.endpoint_resolver.uses_builtin_data
+        if client_endpoint_url:
+            sdk_endpoint = client_endpoint_url
+        elif not uses_builtin_data:
+            sdk_endpoint = legacy_endpoint_url
+        else:
+            sdk_endpoint = None
+        sts_global = self._should_set_global_sts_endpoint(
+            region_name, None, None
+        )
+        s3_global = self._should_force_s3_global(region_name, s3_config)
+        return {
+            EPRBuiltins.AWS_REGION: region_name,
+            EPRBuiltins.AWS_USE_FIPS: bool(use_fips),
+            EPRBuiltins.AWS_USE_DUALSTACK: bool(use_dualstack),
+            EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: sts_global,
+            EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: s3_global,
+            EPRBuiltins.AWS_S3_ACCELERATE: s3_config.get(
+                'use_accelerate_endpoint', False
+            ),
+            EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            EPRBuiltins.AWS_S3_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', True
+            ),
+            EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', False
+            ),
+            EPRBuiltins.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+            EPRBuiltins.SDK_ENDPOINT: sdk_endpoint,
+        }
