+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_scenario_returns_expected_builtins(self):
+        builtins = self.compute()
+        self.assertEqual(builtins['AWS::Region'], 'ca-central-1')
+        self.assertFalse(builtins['AWS::UseFIPS'])
+        self.assertFalse(builtins['AWS::UseDualStack'])
+        self.assertTrue(builtins['AWS::STS::UseGlobalEndpoint'])
+        self.assertFalse(builtins['AWS::S3::UseGlobalEndpoint'])
+        self.assertFalse(builtins['AWS::S3::Accelerate'])
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+        self.assertTrue(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+        self.assertFalse(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints']
+        )
+        self.assertIsNone(builtins['SDK::Endpoint'])
+
+    def test_config_store_use_fips_true_sets_use_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self.compute()
+        self.assertTrue(builtins['AWS::UseFIPS'])
+
+    def test_config_store_use_fips_false_sets_use_fips_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self.compute()
+        self.assertFalse(builtins['AWS::UseFIPS'])
+
+    def test_s3_control_client_config_s3_dualstack_true_sets_dualstack(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self.compute(service_name='s3-control')
+        self.assertTrue(builtins['AWS::UseDualStack'])
+
+    def test_s3_control_client_config_s3_dualstack_false_clears_dualstack(
+        self,
+    ):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self.compute(service_name='s3-control')
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_other_service_client_config_s3_dualstack_true_is_ignored(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self.compute(service_name='other-service')
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_us_west_2_default_sts_configuration_uses_global_sts(self):
+        builtins = self.compute(region_name='us-west-2')
+        self.assertTrue(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_eu_south_1_default_sts_configuration_is_not_global(self):
+        builtins = self.compute(region_name='eu-south-1')
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_us_west_2_regional_sts_configuration_is_not_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self.compute(region_name='us-west-2')
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_s3_predicate_true_sets_s3_global_and_calls_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self.compute(region_name='us-east-1')
+        self.assertTrue(builtins['AWS::S3::UseGlobalEndpoint'])
+        self.assertEqual(predicate.call_count, 1)
+
+    def test_s3_accelerate_true_passes_through(self):
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertTrue(builtins['AWS::S3::Accelerate'])
+
+    def test_s3_accelerate_false_passes_through(self):
+        builtins = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertFalse(builtins['AWS::S3::Accelerate'])
+
+    def test_s3_addressing_style_path_sets_force_path_style(self):
+        builtins = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertTrue(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_s3_addressing_style_auto_clears_force_path_style(self):
+        builtins = self.compute(s3_config={'addressing_style': 'auto'})
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_s3_addressing_style_virtual_clears_force_path_style(self):
+        builtins = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_use_arn_region_false_clears_both_arn_region_builtins(self):
+        builtins = self.compute(s3_config={'use_arn_region': False})
+        self.assertFalse(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_use_arn_region_true_sets_both_arn_region_builtins(self):
+        builtins = self.compute(s3_config={'use_arn_region': True})
+        self.assertTrue(builtins['AWS::S3::UseArnRegion'])
+        self.assertTrue(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_s3_disable_mrap_true_passes_through(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(builtins['AWS::S3::DisableMultiRegionAccessPoints'])
+
+    def test_s3_disable_mrap_false_passes_through(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints']
+        )
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute(
+            client_endpoint_url='https://client.endpoint.example'
+        )
+        self.assertEqual(
+            builtins['SDK::Endpoint'], 'https://client.endpoint.example'
+        )
+
+    def test_custom_endpoint_data_without_client_url_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute()
+        self.assertEqual(builtins['SDK::Endpoint'], self.legacy_url)
