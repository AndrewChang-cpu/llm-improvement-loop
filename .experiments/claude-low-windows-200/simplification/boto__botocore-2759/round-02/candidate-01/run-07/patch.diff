+class EndpointResolverBuiltins(str, Enum):
+    """Builtin names consumed by endpoint rulesets.
+
+    Each member's value is the builtin name used in endpoint rulesets.
+    """
+
+    # AWS::Region. Type: string. The region name as given.
+    AWS_REGION = 'AWS::Region'
+    # AWS::UseFIPS. Type: boolean. Whether FIPS endpoints are requested.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # AWS::UseDualStack. Type: boolean. Whether DualStack endpoints are
+    # requested.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # AWS::STS::UseGlobalEndpoint. Type: boolean. Whether STS should use
+    # the global endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # AWS::S3::UseGlobalEndpoint. Type: boolean. Whether S3 should use the
+    # global endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # AWS::S3::Accelerate. Type: boolean. Whether S3 Transfer Acceleration
+    # is requested.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # AWS::S3::ForcePathStyle. Type: boolean. Whether S3 path-style
+    # addressing is requested.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # AWS::S3::UseArnRegion. Type: boolean by default; the raw config
+    # value when one is set. Whether S3 uses the region from an ARN.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # AWS::S3Control::UseArnRegion. Type: boolean by default; the raw
+    # config value when one is set. Whether S3 Control uses the region
+    # from an ARN.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # AWS::S3::DisableMultiRegionAccessPoints. Type: boolean. Whether
+    # multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # SDK::Endpoint. Type: string, or absent. The client endpoint URL if
+    # truthy; otherwise the legacy endpoint URL when custom endpoint data
+    # is in use; otherwise absent.
+    SDK_ENDPOINT = 'SDK::Endpoint'
