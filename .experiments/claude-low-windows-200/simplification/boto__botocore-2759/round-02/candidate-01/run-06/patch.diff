+            builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False
+        )
+
+    def test_s3_addressing_style_path_forces_path_style(self):
+        builtins = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], True
+        )
+
+    def test_s3_addressing_style_virtual_does_not_force_path_style(self):
+        builtins = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+        )
+
+    def test_use_arn_region_false_disables_both_arn_region_builtins(self):
+        builtins = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+
+    def test_use_arn_region_true_enables_both_arn_region_builtins(self):
+        builtins = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            True,
+        )
+
+    def test_s3_disable_mrap_true_passes_through(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], True
+        )
+
+    def test_s3_disable_mrap_false_passes_through(self):
+        builtins = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False
+        )
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute(
+            client_endpoint_url='https://client.endpoint.example.com'
+        )
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.endpoint.example.com',
+        )
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute()
