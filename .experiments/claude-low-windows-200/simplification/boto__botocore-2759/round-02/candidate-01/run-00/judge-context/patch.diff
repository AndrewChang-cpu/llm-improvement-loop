+class EndpointResolverBuiltins(str, Enum):
+    """Builtin names consumed by endpoint rulesets.
+
+    Each member compares equal to its string value.
+    """
+
+    # Region name for the request. Type: string.
+    AWS_REGION = 'AWS::Region'
+    # Whether FIPS endpoints are requested. Type: boolean.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Whether DualStack endpoints are requested. Type: boolean.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Whether the STS global endpoint is used. Type: boolean.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Whether the S3 global endpoint is used. Type: boolean.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Whether S3 Transfer Acceleration is used. Type: boolean.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Whether S3 path-style addressing is forced. Type: boolean.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Whether S3 ARN region is used. Type: boolean by default; the raw
+    # configuration value when one is supplied.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Whether S3Control ARN region is used. Type: boolean by default; the
+    # raw configuration value when one is supplied.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Whether S3 Multi-Region Access Points are disabled. Type: boolean.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # SDK-supplied endpoint URL. Type: string, or absent.
+    SDK_ENDPOINT = 'SDK::Endpoint'
