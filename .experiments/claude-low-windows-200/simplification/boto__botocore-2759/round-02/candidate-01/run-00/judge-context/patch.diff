+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=None,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        client_endpoint_url=None,
+        legacy_endpoint_url=None,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        if legacy_endpoint_url is None:
+            legacy_endpoint_url = self.legacy_url
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=self.bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=legacy_endpoint_url,
+        )
+
+    def test_default_builtins_with_bundled_data_and_legacy_url(self):
+        builtins = self.compute()
+        self.assertEqual(builtins[EPRBuiltins.AWS_REGION], 'ca-central-1')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], False)
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], False)
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_ACCELERATE], False)
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(
+            builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False
+        )
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
+        self.assertIsNone(builtins[EPRBuiltins.SDK_ENDPOINT])
+
+    def test_use_fips_config_store_value_is_passed_through(self):
+        for value, expected in [(True, True), (False, False)]:
+            with self.subTest(value=value):
+                self.config_store.set_config_variable(
+                    'use_fips_endpoint', value
+                )
+                builtins = self.compute()
+                self.assertIs(builtins[EPRBuiltins.AWS_USE_FIPS], expected)
+
+    def test_s3_control_client_dualstack_true_and_false_are_passed_through(
+        self,
+    ):
+        for value, expected in [(True, True), (False, False)]:
+            with self.subTest(value=value):
+                self.bridge.client_config = Config(
+                    s3={'use_dualstack_endpoint': value}
+                )
+                builtins = self.compute(service_name='s3-control')
+                self.assertIs(
+                    builtins[EPRBuiltins.AWS_USE_DUALSTACK], expected
+                )
+
+    def test_dualstack_is_false_for_other_service_with_client_dualstack(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self.compute(service_name='other-service')
+        self.assertIs(builtins[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_true_for_us_west_2_with_default_sts_configuration(
+        self,
+    ):
+        builtins = self.compute(region_name='us-west-2')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_global_false_for_eu_south_1_region(self):
+        builtins = self.compute(region_name='eu-south-1')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_global_false_for_us_west_2_with_regional_sts_setting(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self.compute(region_name='us-west-2')
+        self.assertIs(builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_true_when_s3_predicate_returns_true(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            builtins = self.compute(region_name='us-east-1')
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_s3_accelerate_config_value_is_passed_through(self):
+        for value in (True, False):
+            with self.subTest(value=value):
+                builtins = self.compute(
+                    s3_config={'use_accelerate_endpoint': value}
+                )
+                self.assertIs(builtins[EPRBuiltins.AWS_S3_ACCELERATE], value)
+
+    def test_s3_force_path_style_true_for_path_addressing_style(self):
+        builtins = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+
+    def test_s3_force_path_style_false_for_auto_and_virtual_addressing(self):
+        for style in ('auto', 'virtual'):
