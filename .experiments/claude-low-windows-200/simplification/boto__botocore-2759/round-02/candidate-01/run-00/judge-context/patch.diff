+
+    def test_arn_region_config_value_sets_both_arn_region_builtins(self):
+        for value in (False, True):
+            with self.subTest(use_arn_region=value):
+                builtins = self.compute(s3_config={'use_arn_region': value})
+                self.assertIs(
+                    builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION], value
+                )
+                self.assertIs(
+                    builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], value
+                )
+
+    def test_mrap_disable_config_value_is_passed_through(self):
+        for value in (True, False):
+            with self.subTest(value=value):
+                builtins = self.compute(
+                    s3_config={'s3_disable_multiregion_access_points': value}
+                )
+                self.assertIs(builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP], value)
+
+    def test_sdk_endpoint_is_client_url_with_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        client_url = 'https://client.endpoint.example.com'
+        builtins = self.compute(client_endpoint_url=client_url)
+        self.assertEqual(builtins[EPRBuiltins.SDK_ENDPOINT], client_url)
+
+    def test_sdk_endpoint_is_legacy_url_with_custom_endpoint_data(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute()
+        self.assertEqual(builtins[EPRBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_sdk_endpoint_is_absent_with_bundled_data_and_legacy_url(self):
+        builtins = self.compute()
+        self.assertIsNone(builtins[EPRBuiltins.SDK_ENDPOINT])
