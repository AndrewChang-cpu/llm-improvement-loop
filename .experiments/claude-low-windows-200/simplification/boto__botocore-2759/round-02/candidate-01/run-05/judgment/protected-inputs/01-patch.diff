+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute endpoint ruleset builtin values for one client.
+
+        Returns a mapping keyed by EPRBuiltins members. The SDK endpoint
+        is the client endpoint URL when it is truthy; otherwise the legacy
+        endpoint URL when custom endpoint data is in use; otherwise absent.
+        Values are read from the bridge and the S3 and STS predicates.
+        """
+        builtins = {}
+        builtins[EPRBuiltins.AWS_REGION] = region_name
+        builtins[EPRBuiltins.AWS_USE_FIPS] = bool(
+            endpoint_bridge._resolve_endpoint_variant_config_var(
+                'use_fips_endpoint'
+            )
+        )
+        builtins[EPRBuiltins.AWS_USE_DUALSTACK] = bool(
+            endpoint_bridge._resolve_use_dualstack_endpoint(service_name)
+        )
+        builtins[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT] = bool(
+            self._should_set_global_sts_endpoint(region_name, None, None)
+        )
+        builtins[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT] = bool(
+            self._should_force_s3_global(region_name, s3_config)
+        )
+        builtins[EPRBuiltins.AWS_S3_ACCELERATE] = s3_config.get(
+            'use_accelerate_endpoint', False
+        )
+        builtins[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE] = (
+            s3_config.get('addressing_style') == 'path'
+        )
+        builtins[EPRBuiltins.AWS_S3_USE_ARN_REGION] = s3_config.get(
+            'use_arn_region', True
+        )
+        builtins[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION] = s3_config.get(
+            'use_arn_region', False
+        )
+        builtins[EPRBuiltins.AWS_S3_DISABLE_MRAP] = s3_config.get(
+            's3_disable_multiregion_access_points', False
+        )
+        sdk_endpoint = None
+        if client_endpoint_url:
+            sdk_endpoint = client_endpoint_url
+        elif not endpoint_bridge.endpoint_resolver.uses_builtin_data:
+            sdk_endpoint = legacy_endpoint_url
+        if sdk_endpoint is not None:
+            builtins[EPRBuiltins.SDK_ENDPOINT] = sdk_endpoint
+        return builtins
