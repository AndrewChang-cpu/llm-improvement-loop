+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            event_emitter=self.event_emitter,
+            user_agent=None,
+            response_parser_factory=mock.Mock(),
+            loader=mock.Mock(),
+            exceptions_factory=mock.Mock(),
+            config_store=self.config_store,
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+
+    def _compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        client_config=None,
+        client_endpoint_url=None,
+        legacy_endpoint_url='https://my.legacy.endpoint.com',
+        uses_builtin_data=True,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        if client_config is None:
+            client_config = Config()
+        self.resolver.uses_builtin_data = uses_builtin_data
+        bridge = ClientEndpointBridge(
+            endpoint_resolver=self.resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=legacy_endpoint_url,
+        )
+
+    def test_default_scenario_with_bundled_data_omits_sdk_endpoint(self):
+        builtins = self._compute()
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.AWS_REGION], 'ca-central-1'
+        )
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT],
+            True,
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT],
+            False,
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+        self.assertIs(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False
+        )
+        self.assertNotIn(EndpointResolverBuiltins.SDK_ENDPOINT, builtins)
+
+    def test_config_store_use_fips_true_sets_use_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_config_store_use_fips_false_clears_use_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertIs(builtins[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+
+    def test_s3control_client_config_dualstack_true_sets_dualstack(self):
+        builtins = self._compute(
+            service_name='s3-control',
+            client_config=Config(s3={'use_dualstack_endpoint': True}),
