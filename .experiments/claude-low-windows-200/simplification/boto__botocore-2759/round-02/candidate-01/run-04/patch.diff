+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            None,
+            None,
+            None,
+            self.config_store,
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = self._make_bridge()
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _make_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_scenario_produces_expected_builtins(self):
+        result = self._compute()
+        self.assertEqual(result['AWS::Region'], 'ca-central-1')
+        self.assertFalse(result['AWS::UseFIPS'])
+        self.assertFalse(result['AWS::UseDualStack'])
+        self.assertTrue(result['AWS::STS::UseGlobalEndpoint'])
+        self.assertFalse(result['AWS::S3::UseGlobalEndpoint'])
+        self.assertFalse(result['AWS::S3::Accelerate'])
+        self.assertFalse(result['AWS::S3::ForcePathStyle'])
+        self.assertTrue(result['AWS::S3::UseArnRegion'])
+        self.assertFalse(result['AWS::S3Control::UseArnRegion'])
+        self.assertFalse(result['AWS::S3::DisableMultiRegionAccessPoints'])
+        self.assertIsNone(result['SDK::Endpoint'])
+
+    def test_config_store_use_fips_true_sets_fips_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertTrue(result['AWS::UseFIPS'])
+
+    def test_config_store_use_fips_false_sets_fips_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertFalse(result['AWS::UseFIPS'])
+
+    def test_s3_control_client_s3_dualstack_true_sets_dualstack_true(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertTrue(result['AWS::UseDualStack'])
+
+    def test_s3_control_client_s3_dualstack_false_sets_dualstack_false(self):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': False})
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertFalse(result['AWS::UseDualStack'])
+
+    def test_other_service_client_s3_dualstack_true_sets_dualstack_false(
+        self,
+    ):
+        bridge = self._make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertFalse(result['AWS::UseDualStack'])
+
+    def test_us_west_2_default_sts_configuration_is_global(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertTrue(result['AWS::STS::UseGlobalEndpoint'])
+
+    def test_eu_south_1_default_sts_configuration_is_not_global(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertFalse(result['AWS::STS::UseGlobalEndpoint'])
+
+    def test_us_west_2_regional_sts_configuration_is_not_global(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertFalse(result['AWS::STS::UseGlobalEndpoint'])
+
+    def test_s3_predicate_true_sets_s3_global_and_calls_once(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self._compute(region_name='us-west-2')
+        self.assertTrue(result['AWS::S3::UseGlobalEndpoint'])
+        predicate.assert_called_once_with('us-west-2', {})
+
+    def test_use_accelerate_true_passes_through(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertTrue(result['AWS::S3::Accelerate'])
+
+    def test_use_accelerate_false_passes_through(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertFalse(result['AWS::S3::Accelerate'])
+
+    def test_addressing_style_path_sets_force_path_style_true(self):
+        result = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertTrue(result['AWS::S3::ForcePathStyle'])
+
+    def test_addressing_style_auto_sets_force_path_style_false(self):
+        result = self._compute(s3_config={'addressing_style': 'auto'})
+        self.assertFalse(result['AWS::S3::ForcePathStyle'])
+
+    def test_addressing_style_virtual_sets_force_path_style_false(self):
+        result = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertFalse(result['AWS::S3::ForcePathStyle'])
+
+    def test_use_arn_region_false_sets_both_arn_region_false(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertFalse(result['AWS::S3::UseArnRegion'])
+        self.assertFalse(result['AWS::S3Control::UseArnRegion'])
+
+    def test_use_arn_region_true_sets_both_arn_region_true(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertTrue(result['AWS::S3::UseArnRegion'])
+        self.assertTrue(result['AWS::S3Control::UseArnRegion'])
+
+    def test_disable_mrap_true_passes_through(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(result['AWS::S3::DisableMultiRegionAccessPoints'])
+
+    def test_disable_mrap_false_passes_through(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(result['AWS::S3::DisableMultiRegionAccessPoints'])
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self._compute(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            result['SDK::Endpoint'], 'https://client.endpoint.com'
+        )
+
+    def test_custom_data_without_client_url_returns_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(result['SDK::Endpoint'], self.legacy_url)
+
+    def test_bundled_data_without_client_url_returns_absent_endpoint(self):
+        result = self._compute()
+        self.assertIsNone(result['SDK::Endpoint'])
