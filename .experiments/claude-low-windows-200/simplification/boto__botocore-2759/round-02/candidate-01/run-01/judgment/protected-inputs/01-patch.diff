+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            mock.Mock(HierarchicalEmitter),
+            None,
+            mock.Mock(),
+            mock.Mock(),
+            mock.Mock(),
+            self.config_store,
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=None,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def compute(self, **overrides):
+        call_kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': 'https://my.legacy.endpoint.com',
+        }
+        call_kwargs.update(overrides)
+        method = self.args_create.compute_endpoint_resolver_builtin_defaults
+        return method(**call_kwargs)
+
+    def test_default_builtins_with_bundled_data(self):
+        result = self.compute()
+        expected = {
+            EndpointResolverBuiltins.AWS_REGION: 'ca-central-1',
+            EndpointResolverBuiltins.AWS_USE_FIPS: False,
+            EndpointResolverBuiltins.AWS_USE_DUALSTACK: False,
+            EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: True,
+            EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: False,
+            EndpointResolverBuiltins.AWS_S3_ACCELERATE: False,
+            EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE: False,
+            EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION: True,
+            EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION: False,
+            EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP: False,
+            EndpointResolverBuiltins.SDK_ENDPOINT: None,
+        }
+        self.assertEqual(result, expected)
+
+    def test_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], False)
+
+    def test_fips_not_suppressed_by_custom_endpoint_data(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_FIPS], True)
+
+    def test_dualstack_true_for_s3_control_from_client_s3_config(self):
+        bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=Config(s3={'use_dualstack_endpoint': True}),
+            config_store=self.config_store,
+        )
+        result = self.compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_false_for_s3_control_from_client_s3_config(self):
+        bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=Config(s3={'use_dualstack_endpoint': False}),
+            config_store=self.config_store,
+        )
+        result = self.compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_USE_DUALSTACK], False
+        )
+
+    def test_dualstack_ignored_for_other_service(self):
+        bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=Config(use_dualstack_endpoint=True),
+            config_store=self.config_store,
+        )
+        result = self.compute(
