+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=None,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        client_endpoint_url=None,
+        legacy_endpoint_url=None,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=self.bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=legacy_endpoint_url,
+        )
+
+    def test_defaults_with_bundled_data_and_legacy_url(self):
+        builtins = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertEqual(builtins['AWS::Region'], 'ca-central-1')
+        self.assertIs(builtins['AWS::UseFIPS'], False)
+        self.assertIs(builtins['AWS::UseDualStack'], False)
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], True)
+        self.assertIs(builtins['AWS::S3::UseGlobalEndpoint'], False)
+        self.assertIs(builtins['AWS::S3::Accelerate'], False)
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], False)
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], True)
+        self.assertIs(builtins['AWS::S3Control::UseArnRegion'], False)
+        self.assertIs(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+        self.assertIsNone(builtins['SDK::Endpoint'])
+
+    def test_config_store_use_fips_true_sets_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self._compute()
+        self.assertIs(builtins['AWS::UseFIPS'], True)
+
+    def test_config_store_use_fips_false_leaves_fips_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self._compute()
+        self.assertIs(builtins['AWS::UseFIPS'], False)
+
+    def test_s3_control_client_config_dualstack_true_sets_dualstack(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(builtins['AWS::UseDualStack'], True)
+
+    def test_s3_control_client_config_dualstack_false_clears_dualstack(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self._compute(service_name='s3-control')
+        self.assertIs(builtins['AWS::UseDualStack'], False)
+
+    def test_other_service_client_config_dualstack_true_is_not_dualstack(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        builtins = self._compute(service_name='other-service')
+        self.assertIs(builtins['AWS::UseDualStack'], False)
+
+    def test_us_west_2_default_sts_config_is_global(self):
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_eu_south_1_default_sts_config_is_regional(self):
+        builtins = self._compute(region_name='eu-south-1')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_us_west_2_regional_sts_config_is_regional(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self._compute(region_name='us-west-2')
+        self.assertIs(builtins['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_predicate_true_sets_s3_global_with_single_call(self):
+        s3_config = {'use_accelerate_endpoint': True}
+        with mock.patch.object(
+            self.args_create,
+            '_should_force_s3_global',
+            return_value=True,
+        ) as predicate:
+            builtins = self._compute(s3_config=s3_config)
+        self.assertIs(builtins['AWS::S3::UseGlobalEndpoint'], True)
+        predicate.assert_called_once_with('ca-central-1', s3_config)
+
+    def test_s3_accelerate_true_passes_through(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(builtins['AWS::S3::Accelerate'], True)
+
+    def test_s3_accelerate_false_passes_through(self):
+        builtins = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(builtins['AWS::S3::Accelerate'], False)
+
+    def test_s3_addressing_style_path_forces_path_style(self):
+        builtins = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], True)
+
+    def test_s3_addressing_style_virtual_does_not_force_path_style(self):
+        builtins = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(builtins['AWS::S3::ForcePathStyle'], False)
+
+    def test_use_arn_region_false_sets_both_arn_region_false(self):
+        builtins = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], False)
+        self.assertIs(builtins['AWS::S3Control::UseArnRegion'], False)
+
+    def test_use_arn_region_true_sets_both_arn_region_true(self):
+        builtins = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(builtins['AWS::S3::UseArnRegion'], True)
+        self.assertIs(builtins['AWS::S3Control::UseArnRegion'], True)
+
+    def test_mrap_disabled_true_passes_through(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints'], True
+        )
+
+    def test_mrap_disabled_false_passes_through(self):
+        builtins = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.resolver.uses_builtin_data = False
+        client_url = 'https://client.endpoint.com'
+        builtins = self._compute(
+            client_endpoint_url=client_url,
+            legacy_endpoint_url=self.legacy_url,
+        )
+        self.assertEqual(builtins['SDK::Endpoint'], client_url)
+
+    def test_custom_data_without_client_url_uses_legacy_url(self):
+        self.resolver.uses_builtin_data = False
+        builtins = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertEqual(builtins['SDK::Endpoint'], self.legacy_url)
+
+    def test_bundled_data_without_client_url_has_absent_sdk_endpoint(self):
+        builtins = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertIsNone(builtins['SDK::Endpoint'])
