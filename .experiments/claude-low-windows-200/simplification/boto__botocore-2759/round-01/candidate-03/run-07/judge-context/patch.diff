+class EndpointResolverBuiltins(str, enum.Enum):
+    """Names of the builtin inputs consumed by endpoint rulesets."""
+
+    # Region name the client is created for. Type: string.
+    AWS_REGION = 'AWS::Region'
+    # Whether FIPS endpoints are requested. Type: boolean.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Whether DualStack endpoints are requested. Type: boolean.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Whether STS uses the global endpoint. Type: boolean.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Whether S3 uses the global endpoint. Type: boolean.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Whether S3 transfer acceleration is enabled. Type: boolean.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Whether S3 uses path-style addressing. Type: boolean.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Whether S3 ARNs use the ARN region. Type: boolean by default,
+    # otherwise the raw configured value.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Whether S3Control ARNs use the ARN region. Type: boolean by default,
+    # otherwise the raw configured value.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Whether S3 multi-region access points are disabled. Type: boolean.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Endpoint URL from the SDK: the client endpoint URL if set, otherwise
+    # the legacy endpoint URL when custom endpoint data is in use, otherwise
+    # absent (None). Type: string, or absent.
+    SDK_ENDPOINT = 'SDK::Endpoint'
