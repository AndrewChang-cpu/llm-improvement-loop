+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint ruleset builtin values for one client.
+
+        All builtins are computed regardless of ``service_name``. The
+        result is keyed by ``EndpointResolverBuiltins`` members.
+
+        :param s3_config: Mapping of S3 configuration; may be empty.
+        :param client_endpoint_url: URL passed to client creation, if any.
+        :param legacy_endpoint_url: URL from legacy endpoint resolution,
+            if any.
+        """
+        use_fips = (
+            endpoint_bridge._resolve_endpoint_variant_config_var(
+                'use_fips_endpoint'
+            )
+            or False
+        )
+        use_dualstack = (
+            endpoint_bridge._resolve_use_dualstack_endpoint(service_name)
+            or False
+        )
+        sts_global = self._should_set_global_sts_endpoint(
+            region_name, None, None
+        )
+        s3_global = self._should_force_s3_global(region_name, s3_config)
+        return {
+            EPRBuiltins.AWS_REGION: region_name,
+            EPRBuiltins.AWS_USE_FIPS: use_fips,
+            EPRBuiltins.AWS_USE_DUALSTACK: use_dualstack,
+            EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: sts_global,
+            EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: s3_global,
+            EPRBuiltins.AWS_S3_ACCELERATE: s3_config.get(
+                'use_accelerate_endpoint', False
+            ),
+            EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            EPRBuiltins.AWS_S3_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', True
+            ),
+            EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: s3_config.get(
+                'use_arn_region', False
+            ),
+            EPRBuiltins.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+            EPRBuiltins.SDK_ENDPOINT: self._compute_sdk_endpoint(
+                endpoint_bridge, client_endpoint_url, legacy_endpoint_url
+            ),
+        }
+
+    def _compute_sdk_endpoint(
+        self, endpoint_bridge, client_endpoint_url, legacy_endpoint_url
+    ):
+        # A client endpoint URL takes precedence. Otherwise the legacy
+        # endpoint URL is used only when custom endpoint data is in use;
+        # with bundled data the value is absent (None).
+        if client_endpoint_url:
+            return client_endpoint_url
+        if not endpoint_bridge.endpoint_resolver.uses_builtin_data:
+            return legacy_endpoint_url
+        return None
