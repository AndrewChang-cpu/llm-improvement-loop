+class EndpointResolverBuiltins(str, enum.Enum):
+    """Named builtin inputs consumed by endpoint rulesets."""
+
+    # AWS::Region - the region name given at client creation. string
+    AWS_REGION = 'AWS::Region'
+    # AWS::UseFIPS - whether FIPS endpoints are requested. boolean
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # AWS::UseDualStack - whether DualStack endpoints are requested. boolean
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # AWS::STS::UseGlobalEndpoint - whether STS uses the global endpoint.
+    # boolean
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # AWS::S3::UseGlobalEndpoint - whether S3 uses the global endpoint.
+    # boolean
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # AWS::S3::Accelerate - whether S3 accelerate endpoints are used. boolean
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # AWS::S3::ForcePathStyle - whether S3 path-style addressing is forced.
+    # boolean
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # AWS::S3::UseArnRegion - whether S3 uses the region from ARNs. boolean
+    # by default; the raw config value when one is set.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # AWS::S3Control::UseArnRegion - whether S3 Control uses the region from
+    # ARNs. boolean by default; the raw config value when one is set.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # AWS::S3::DisableMultiRegionAccessPoints - whether MRAP is disabled.
+    # boolean
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # SDK::Endpoint - the endpoint URL. string, or absent. The client
+    # endpoint URL wins; otherwise the legacy endpoint URL is used when
+    # custom endpoint data is in use; otherwise the value is absent.
+    SDK_ENDPOINT = 'SDK::Endpoint'
