+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.region = 'ca-central-1'
+        self.service = 'fooservice'
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(self, **overrides):
+        kwargs = {
+            'region_name': self.region,
+            'service_name': self.service,
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        method = self.args_create.compute_endpoint_resolver_builtin_defaults
+        return method(**kwargs)
+
+    def test_defaults_with_bundled_data_and_legacy_url_present(self):
+        result = self.compute()
+        self.assertEqual(
+            result,
+            {
+                EPRBuiltins.AWS_REGION: 'ca-central-1',
+                EPRBuiltins.AWS_USE_FIPS: False,
+                EPRBuiltins.AWS_USE_DUALSTACK: False,
+                EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: True,
+                EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: False,
+                EPRBuiltins.AWS_S3_ACCELERATE: False,
+                EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: False,
+                EPRBuiltins.AWS_S3_USE_ARN_REGION: True,
+                EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: False,
+                EPRBuiltins.AWS_S3_DISABLE_MRAP: False,
+                EPRBuiltins.SDK_ENDPOINT: None,
+            },
+        )
+
+    def test_legacy_url_used_as_sdk_endpoint_with_custom_endpoint_data(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(result[EPRBuiltins.SDK_ENDPOINT], self.legacy_url)
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self.compute(client_endpoint_url='https://client.example')
+        self.assertEqual(
+            result[EPRBuiltins.SDK_ENDPOINT], 'https://client.example'
+        )
+
+    def test_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertIs(result[EPRBuiltins.AWS_USE_FIPS], True)
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertIs(result[EPRBuiltins.AWS_USE_FIPS], False)
+
+    def test_dualstack_true_for_s3control_from_client_s3_config(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        result = self.compute(service_name='s3-control')
+        self.assertIs(result[EPRBuiltins.AWS_USE_DUALSTACK], True)
+
+    def test_dualstack_false_for_s3control_from_client_s3_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertIs(result[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_dualstack_false_for_other_service_with_client_s3_config(self):
+        self.bridge.client_config = Config(s3={'use_dualstack_endpoint': True})
+        result = self.compute(service_name='other-service')
+        self.assertIs(result[EPRBuiltins.AWS_USE_DUALSTACK], False)
+
+    def test_sts_global_in_us_west_2_with_default_sts_config(self):
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], True)
+
+    def test_sts_not_global_in_eu_south_1(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertIs(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_sts_not_global_in_us_west_2_with_regional_sts_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result[EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT], False)
+
+    def test_s3_global_when_s3_predicate_returns_true(self):
+        predicate = mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        )
+        with predicate as mocked:
+            result = self.compute(region_name='us-east-1')
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT], True)
+        mocked.assert_called_once_with('us-east-1', {})
+
+    def test_accelerate_true_from_s3_config(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(result[EPRBuiltins.AWS_S3_ACCELERATE], True)
+
+    def test_accelerate_false_from_s3_config(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(result[EPRBuiltins.AWS_S3_ACCELERATE], False)
+
+    def test_force_path_style_true_for_path_addressing(self):
+        result = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], True)
+
+    def test_force_path_style_false_for_virtual_addressing(self):
+        result = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_force_path_style_false_for_auto_addressing(self):
+        result = self.compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(result[EPRBuiltins.AWS_S3_FORCE_PATH_STYLE], False)
+
+    def test_arn_region_false_disables_s3_and_s3control(self):
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_ARN_REGION], False)
+        self.assertIs(result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], False)
+
+    def test_arn_region_true_enables_s3_and_s3control(self):
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(result[EPRBuiltins.AWS_S3_USE_ARN_REGION], True)
+        self.assertIs(result[EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION], True)
+
+    def test_multi_region_access_points_disabled_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(result[EPRBuiltins.AWS_S3_DISABLE_MRAP], True)
+
+    def test_multi_region_access_points_enabled_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(result[EPRBuiltins.AWS_S3_DISABLE_MRAP], False)
