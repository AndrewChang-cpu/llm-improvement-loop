+class EndpointResolverBuiltins(str, Enum):
+    """Names of the builtin inputs consumed by endpoint rulesets."""
+
+    # Region name for the client, as given at client creation. string
+    AWS_REGION = 'AWS::Region'
+    # Whether FIPS endpoints are requested. boolean
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Whether DualStack endpoints are requested. boolean
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Whether STS should use the global endpoint. boolean
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Whether S3 should use the global endpoint. boolean
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Whether S3 accelerate endpoints are requested. boolean
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Whether S3 path-style addressing is requested. boolean
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Whether S3 uses the ARN region. boolean by default, raw config
+    # value otherwise
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Whether S3 Control uses the ARN region. boolean by default, raw
+    # config value otherwise
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Whether S3 multi-region access points are disabled. boolean
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Endpoint URL set by the SDK. string, or absent. A client endpoint
+    # URL takes precedence; otherwise the legacy endpoint URL is used
+    # when custom endpoint data is in use.
+    SDK_ENDPOINT = 'SDK::Endpoint'
