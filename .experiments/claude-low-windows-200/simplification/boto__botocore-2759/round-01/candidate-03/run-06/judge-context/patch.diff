+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=None,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def compute(self, **overrides):
+        call_kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        call_kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **call_kwargs
+        )
+
+    def test_default_builtins_with_bundled_data(self):
+        result = self.compute()
+        self.assertEqual(result['AWS::Region'], 'ca-central-1')
+        self.assertFalse(result['AWS::UseFIPS'])
+        self.assertFalse(result['AWS::UseDualStack'])
+        self.assertTrue(result['AWS::STS::UseGlobalEndpoint'])
+        self.assertFalse(result['AWS::S3::UseGlobalEndpoint'])
+        self.assertFalse(result['AWS::S3::Accelerate'])
+        self.assertFalse(result['AWS::S3::ForcePathStyle'])
+        self.assertTrue(result['AWS::S3::UseArnRegion'])
+        self.assertFalse(result['AWS::S3Control::UseArnRegion'])
+        self.assertFalse(result['AWS::S3::DisableMultiRegionAccessPoints'])
+        self.assertIsNone(result['SDK::Endpoint'])
+
+    def test_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertTrue(result['AWS::UseFIPS'])
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertFalse(result['AWS::UseFIPS'])
+
+    def test_dualstack_true_for_s3_control_from_client_s3_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertTrue(result['AWS::UseDualStack'])
+
+    def test_dualstack_false_for_s3_control_from_client_s3_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertFalse(result['AWS::UseDualStack'])
+
+    def test_dualstack_false_for_other_service_from_client_s3_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self.compute(service_name='other-service')
+        self.assertFalse(result['AWS::UseDualStack'])
+
+    def test_sts_global_for_us_west_2_with_default_configuration(self):
+        result = self.compute(region_name='us-west-2')
+        self.assertTrue(result['AWS::STS::UseGlobalEndpoint'])
+
+    def test_sts_regional_for_eu_south_1_with_default_configuration(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertFalse(result['AWS::STS::UseGlobalEndpoint'])
+
+    def test_sts_regional_for_us_west_2_with_regional_configuration(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self.compute(region_name='us-west-2')
+        self.assertFalse(result['AWS::STS::UseGlobalEndpoint'])
+
+    def test_s3_global_when_s3_predicate_returns_true(self):
+        with mock.patch.object(
+            self.args_create,
+            '_should_force_s3_global',
+            return_value=True,
+        ) as predicate:
+            result = self.compute(region_name='us-east-1')
+        self.assertTrue(result['AWS::S3::UseGlobalEndpoint'])
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_accelerate_true_from_s3_config(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertTrue(result['AWS::S3::Accelerate'])
+
+    def test_accelerate_false_from_s3_config(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertFalse(result['AWS::S3::Accelerate'])
+
+    def test_force_path_style_true_for_path_addressing_style(self):
+        result = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertTrue(result['AWS::S3::ForcePathStyle'])
+
+    def test_force_path_style_false_for_auto_addressing_style(self):
+        result = self.compute(s3_config={'addressing_style': 'auto'})
+        self.assertFalse(result['AWS::S3::ForcePathStyle'])
+
+    def test_force_path_style_false_for_virtual_addressing_style(self):
+        result = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertFalse(result['AWS::S3::ForcePathStyle'])
+
+    def test_arn_region_false_disables_both_arn_region_builtins(self):
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertFalse(result['AWS::S3::UseArnRegion'])
+        self.assertFalse(result['AWS::S3Control::UseArnRegion'])
+
+    def test_arn_region_true_enables_both_arn_region_builtins(self):
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertTrue(result['AWS::S3::UseArnRegion'])
+        self.assertTrue(result['AWS::S3Control::UseArnRegion'])
+
+    def test_multiregion_access_points_true_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(result['AWS::S3::DisableMultiRegionAccessPoints'])
+
+    def test_multiregion_access_points_false_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(result['AWS::S3::DisableMultiRegionAccessPoints'])
+
+    def test_client_endpoint_url_wins_over_custom_data_and_legacy_url(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute(client_endpoint_url='https://client.url')
+        self.assertEqual(result['SDK::Endpoint'], 'https://client.url')
+
+    def test_legacy_url_used_with_custom_data_and_no_client_url(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(result['SDK::Endpoint'], self.legacy_url)
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        result = self.compute()
+        self.assertIsNone(result['SDK::Endpoint'])
