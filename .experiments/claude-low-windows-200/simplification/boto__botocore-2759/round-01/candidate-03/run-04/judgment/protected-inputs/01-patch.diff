+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint ruleset builtin values for a client.
+
+        Returns a mapping whose keys are the EndpointResolverBuiltins
+        members. Every call computes all of them, regardless of
+        service_name.
+
+        :param s3_config: Mapping of S3 configuration; may be empty.
+        :param endpoint_bridge: ClientEndpointBridge used for the FIPS and
+            DualStack lookups and for the bundled-data flag of its
+            endpoint resolver.
+        :param client_endpoint_url: Endpoint URL passed to client creation.
+        :param legacy_endpoint_url: Endpoint URL produced by legacy
+            endpoint resolution, or None.
+        """
+        use_fips = endpoint_bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = endpoint_bridge._resolve_use_dualstack_endpoint(
+            service_name
+        )
+        sts_global = self._should_set_global_sts_endpoint(
+            region_name, None, None
+        )
+        s3_global = self._should_force_s3_global(region_name, s3_config)
+        s3_arn_region = s3_config.get('use_arn_region', True)
+        s3control_arn_region = s3_config.get('use_arn_region', False)
+        return {
+            EPRBuiltins.SDK_ENDPOINT: self._compute_sdk_endpoint(
+                endpoint_bridge, client_endpoint_url, legacy_endpoint_url
+            ),
+            EPRBuiltins.AWS_REGION: region_name,
+            EPRBuiltins.AWS_USE_FIPS: use_fips or False,
+            EPRBuiltins.AWS_USE_DUALSTACK: use_dualstack or False,
+            EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: sts_global,
+            EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: s3_global,
+            EPRBuiltins.AWS_S3_ACCELERATE: s3_config.get(
+                'use_accelerate_endpoint', False
+            ),
+            EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: (
+                s3_config.get('addressing_style') == 'path'
+            ),
+            EPRBuiltins.AWS_S3_USE_ARN_REGION: s3_arn_region,
+            EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: s3control_arn_region,
+            EPRBuiltins.AWS_S3_DISABLE_MRAP: s3_config.get(
+                's3_disable_multiregion_access_points', False
+            ),
+        }
+
+    def _compute_sdk_endpoint(
+        self, endpoint_bridge, client_endpoint_url, legacy_endpoint_url
+    ):
+        # A client endpoint URL takes precedence. The legacy endpoint URL
+        # is used only with custom endpoint data; otherwise the value is
+        # absent.
+        if client_endpoint_url:
+            return client_endpoint_url
+        if not endpoint_bridge.endpoint_resolver.uses_builtin_data:
+            return legacy_endpoint_url
+        return None
