+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            None,
+            None,
+            None,
+            self.config_store,
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        client_endpoint_url=None,
+        legacy_endpoint_url=None,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=self.bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=legacy_endpoint_url,
+        )
+
+    def test_default_values_with_bundled_data_and_legacy_url(self):
+        result = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertEqual(
+            result,
+            {
+                'AWS::Region': 'ca-central-1',
+                'AWS::UseFIPS': False,
+                'AWS::UseDualStack': False,
+                'AWS::STS::UseGlobalEndpoint': True,
+                'AWS::S3::UseGlobalEndpoint': False,
+                'AWS::S3::Accelerate': False,
+                'AWS::S3::ForcePathStyle': False,
+                'AWS::S3::UseArnRegion': True,
+                'AWS::S3Control::UseArnRegion': False,
+                'AWS::S3::DisableMultiRegionAccessPoints': False,
+                'SDK::Endpoint': None,
+            },
+        )
+
+    def test_fips_enabled_in_config_store_gives_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertIs(result['AWS::UseFIPS'], True)
+
+    def test_fips_disabled_in_config_store_gives_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertIs(result['AWS::UseFIPS'], False)
+
+    def test_s3control_with_client_s3_dualstack_true_gives_true(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self._compute(service_name='s3-control')
+        self.assertIs(result['AWS::UseDualStack'], True)
+
+    def test_s3control_with_client_s3_dualstack_false_gives_false(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self._compute(service_name='s3-control')
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_other_service_with_client_s3_dualstack_true_gives_false(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self._compute(service_name='other-service')
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_sts_global_in_us_west_2_with_default_configuration(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_sts_not_global_in_eu_south_1(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_sts_not_global_in_us_west_2_with_regional_sts_configuration(
+        self,
+    ):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_predicate_true_gives_s3_global_and_calls_predicate_once(
+        self,
+    ):
+        s3_config = {}
+        with mock.patch.object(
