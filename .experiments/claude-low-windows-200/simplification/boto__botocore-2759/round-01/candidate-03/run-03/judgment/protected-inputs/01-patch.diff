+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.endpoint_bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_endpoint_url = 'https://my.legacy.endpoint.com'
+
+    def compute_builtins(self, **override_kwargs):
+        call_kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.endpoint_bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_endpoint_url,
+        }
+        call_kwargs.update(**override_kwargs)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **call_kwargs
+        )
+
+    def test_bundled_endpoint_data_defaults_leave_sdk_endpoint_absent(self):
+        builtins = self.compute_builtins()
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.AWS_REGION], 'ca-central-1'
+        )
+        self.assertFalse(builtins[EndpointResolverBuiltins.AWS_USE_FIPS])
+        self.assertFalse(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+        self.assertTrue(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT]
+        )
+        self.assertFalse(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE])
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+        self.assertTrue(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION]
+        )
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP]
+        )
+        self.assertIsNone(builtins[EndpointResolverBuiltins.SDK_ENDPOINT])
+
+    def test_config_store_use_fips_true_enables_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self.compute_builtins()
+        self.assertTrue(builtins[EndpointResolverBuiltins.AWS_USE_FIPS])
+
+    def test_config_store_use_fips_false_disables_fips(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self.compute_builtins()
+        self.assertFalse(builtins[EndpointResolverBuiltins.AWS_USE_FIPS])
+
+    def test_s3_control_client_dualstack_true_enables_dualstack(self):
+        self.endpoint_bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self.compute_builtins(service_name='s3-control')
+        self.assertTrue(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_s3_control_client_dualstack_false_disables_dualstack(self):
+        self.endpoint_bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        builtins = self.compute_builtins(service_name='s3-control')
+        self.assertFalse(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_other_service_client_s3_dualstack_true_ignored(self):
+        self.endpoint_bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        builtins = self.compute_builtins(service_name='other-service')
+        self.assertFalse(builtins[EndpointResolverBuiltins.AWS_USE_DUALSTACK])
+
+    def test_sts_global_for_us_west_2_default_configuration(self):
+        builtins = self.compute_builtins(region_name='us-west-2')
+        self.assertTrue(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_sts_not_global_for_eu_south_1(self):
+        builtins = self.compute_builtins(region_name='eu-south-1')
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_sts_regional_configuration_disables_global_for_us_west_2(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self.compute_builtins(region_name='us-west-2')
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT]
+        )
+
+    def test_s3_predicate_true_sets_s3_global_with_single_call(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as mock_predicate:
+            builtins = self.compute_builtins()
+        self.assertTrue(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT]
+        )
+        mock_predicate.assert_called_once_with('ca-central-1', {})
+
+    def test_s3_accelerate_true_passes_through(self):
+        builtins = self.compute_builtins(
+            s3_config={'use_accelerate_endpoint': True}
+        )
+        self.assertTrue(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE])
+
+    def test_s3_accelerate_false_passes_through(self):
+        builtins = self.compute_builtins(
+            s3_config={'use_accelerate_endpoint': False}
+        )
+        self.assertFalse(builtins[EndpointResolverBuiltins.AWS_S3_ACCELERATE])
+
+    def test_s3_addressing_style_path_enables_force_path_style(self):
+        builtins = self.compute_builtins(
+            s3_config={'addressing_style': 'path'}
+        )
+        self.assertTrue(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+
+    def test_s3_addressing_style_auto_disables_force_path_style(self):
+        builtins = self.compute_builtins(
+            s3_config={'addressing_style': 'auto'}
+        )
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+
+    def test_s3_addressing_style_virtual_disables_force_path_style(self):
+        builtins = self.compute_builtins(
+            s3_config={'addressing_style': 'virtual'}
+        )
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE]
+        )
+
+    def test_use_arn_region_false_disables_both_arn_region_builtins(self):
+        builtins = self.compute_builtins(s3_config={'use_arn_region': False})
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION]
+        )
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+
+    def test_use_arn_region_true_enables_both_arn_region_builtins(self):
+        builtins = self.compute_builtins(s3_config={'use_arn_region': True})
+        self.assertTrue(
+            builtins[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION]
+        )
+        self.assertTrue(
+            builtins[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION]
+        )
+
+    def test_s3_disable_mrap_true_passes_through(self):
+        builtins = self.compute_builtins(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP])
+
+    def test_s3_disable_mrap_false_passes_through(self):
+        builtins = self.compute_builtins(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(
+            builtins[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP]
+        )
+
+    def test_client_endpoint_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute_builtins(
+            client_endpoint_url='https://client.endpoint.com'
+        )
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.endpoint.com',
+        )
+
+    def test_custom_endpoint_data_uses_legacy_endpoint_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute_builtins()
+        self.assertEqual(
+            builtins[EndpointResolverBuiltins.SDK_ENDPOINT],
+            self.legacy_endpoint_url,
+        )
