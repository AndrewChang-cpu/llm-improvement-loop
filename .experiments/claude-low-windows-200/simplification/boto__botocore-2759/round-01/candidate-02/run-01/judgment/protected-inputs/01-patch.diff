+    def compute_endpoint_resolver_builtin_defaults(
+        self,
+        region_name,
+        service_name,
+        s3_config,
+        endpoint_bridge,
+        client_endpoint_url,
+        legacy_endpoint_url,
+    ):
+        """Compute the endpoint ruleset builtin values for one client.
+
+        Returns a mapping keyed by EPRBuiltins members, with all eleven
+        entries present regardless of service name. SDK::Endpoint is the
+        client endpoint URL when one is given. Otherwise it is the legacy
+        endpoint URL when the resolver uses custom endpoint data, and
+        absent (None) when it uses bundled data.
+        """
+        resolver = endpoint_bridge.endpoint_resolver
+        if client_endpoint_url:
+            sdk_endpoint = client_endpoint_url
+        elif not resolver.uses_builtin_data:
+            sdk_endpoint = legacy_endpoint_url
+        else:
+            sdk_endpoint = None
+
+        use_fips = endpoint_bridge._resolve_endpoint_variant_config_var(
+            'use_fips_endpoint'
+        )
+        use_dualstack = endpoint_bridge._resolve_use_dualstack_endpoint(
+            service_name
+        )
+        sts_global = self._should_set_global_sts_endpoint(
+            region_name, None, None
+        )
+        s3_global = self._should_force_s3_global(region_name, s3_config)
+
+        accelerate = s3_config.get('use_accelerate_endpoint', False)
+        force_path_style = s3_config.get('addressing_style') == 'path'
+        s3_arn = s3_config.get('use_arn_region', True)
+        s3control_arn = s3_config.get('use_arn_region', False)
+        disable_mrap = s3_config.get(
+            's3_disable_multiregion_access_points', False
+        )
+
+        return {
+            EPRBuiltins.AWS_REGION: region_name,
+            EPRBuiltins.AWS_USE_FIPS: use_fips or False,
+            EPRBuiltins.AWS_USE_DUALSTACK: use_dualstack or False,
+            EPRBuiltins.AWS_STS_USE_GLOBAL_ENDPOINT: sts_global,
+            EPRBuiltins.AWS_S3_USE_GLOBAL_ENDPOINT: s3_global,
+            EPRBuiltins.AWS_S3_ACCELERATE: accelerate,
+            EPRBuiltins.AWS_S3_FORCE_PATH_STYLE: force_path_style,
+            EPRBuiltins.AWS_S3_USE_ARN_REGION: s3_arn,
+            EPRBuiltins.AWS_S3CONTROL_USE_ARN_REGION: s3control_arn,
+            EPRBuiltins.AWS_S3_DISABLE_MRAP: disable_mrap,
+            EPRBuiltins.SDK_ENDPOINT: sdk_endpoint,
+        }
