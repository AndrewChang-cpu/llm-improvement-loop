+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.creator = args.ClientArgsCreator(
+            event_emitter=self.event_emitter,
+            user_agent=None,
+            response_parser_factory=mock.Mock(),
+            loader=mock.Mock(),
+            exceptions_factory=mock.Mock(),
+            config_store=self.config_store,
+        )
+
+    def make_bridge(self, client_config=None):
+        return ClientEndpointBridge(
+            endpoint_resolver=self.resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.make_bridge(),
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': 'https://my.legacy.endpoint.com',
+        }
+        kwargs.update(overrides)
+        return self.creator.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_builtins_with_bundled_data(self):
+        result = self.compute()
+        self.assertEqual(result['AWS::Region'], 'ca-central-1')
+        self.assertIs(result['AWS::UseFIPS'], False)
+        self.assertIs(result['AWS::UseDualStack'], False)
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], False)
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+        self.assertIsNone(result['SDK::Endpoint'])
+
+    def test_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertIs(result['AWS::UseFIPS'], True)
+
+    def test_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertIs(result['AWS::UseFIPS'], False)
+
+    def test_dualstack_true_for_s3_control_from_client_config(self):
+        bridge = self.make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self.compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(result['AWS::UseDualStack'], True)
+
+    def test_dualstack_false_for_s3_control_from_client_config(self):
+        bridge = self.make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': False})
+        )
+        result = self.compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_dualstack_false_for_other_service_with_s3_client_config(self):
+        bridge = self.make_bridge(
+            client_config=Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self.compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_sts_global_endpoint_true_in_us_west_2_default_config(self):
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_sts_global_endpoint_false_in_eu_south_1(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_sts_global_endpoint_false_in_us_west_2_with_regional_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_global_endpoint_true_when_predicate_true(self):
+        with mock.patch.object(
+            args.ClientArgsCreator,
+            '_should_force_s3_global',
+            return_value=True,
+        ) as predicate:
+            result = self.compute()
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], True)
+        predicate.assert_called_once_with('ca-central-1', {})
+
+    def test_s3_accelerate_true_from_s3_config(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(result['AWS::S3::Accelerate'], True)
+
+    def test_s3_accelerate_false_from_s3_config(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+
+    def test_s3_force_path_style_true_for_path_addressing(self):
+        result = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], True)
+
+    def test_s3_force_path_style_false_for_auto_addressing(self):
+        result = self.compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+
+    def test_s3_force_path_style_false_for_virtual_addressing(self):
+        result = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+
+    def test_arn_region_false_disables_s3_and_s3control(self):
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(result['AWS::S3::UseArnRegion'], False)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+
+    def test_arn_region_true_enables_s3_and_s3control(self):
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], True)
+
+    def test_mrap_true_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], True
+        )
+
+    def test_mrap_false_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data_and_legacy(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute(
+            client_endpoint_url='https://client.endpoint.com',
+        )
+        self.assertEqual(
+            result['SDK::Endpoint'], 'https://client.endpoint.com'
+        )
+
+    def test_sdk_endpoint_legacy_url_used_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(
+            result['SDK::Endpoint'], 'https://my.legacy.endpoint.com'
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        result = self.compute()
+        self.assertIsNone(result['SDK::Endpoint'])
