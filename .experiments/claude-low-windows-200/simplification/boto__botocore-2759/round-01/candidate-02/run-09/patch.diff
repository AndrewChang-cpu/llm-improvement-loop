+
+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.endpoint_bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=None,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_endpoint_url = 'https://my.legacy.endpoint.com'
+
+    def compute_builtins(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.endpoint_bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_endpoint_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_builtins(self):
+        builtins = self.compute_builtins()
+        self.assertEqual(len(builtins), 11)
+        self.assertEqual(builtins['AWS::Region'], 'ca-central-1')
+        self.assertFalse(builtins['AWS::UseFIPS'])
+        self.assertFalse(builtins['AWS::UseDualStack'])
+        self.assertTrue(builtins['AWS::STS::UseGlobalEndpoint'])
+        self.assertFalse(builtins['AWS::S3::UseGlobalEndpoint'])
+        self.assertFalse(builtins['AWS::S3::Accelerate'])
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+        self.assertTrue(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+        self.assertFalse(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints']
+        )
+        self.assertIsNone(builtins['SDK::Endpoint'])
+
+    def test_fips_true_from_config_store_use_fips_endpoint_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        builtins = self.compute_builtins()
+        self.assertTrue(builtins['AWS::UseFIPS'])
+
+    def test_fips_false_from_config_store_use_fips_endpoint_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        builtins = self.compute_builtins()
+        self.assertFalse(builtins['AWS::UseFIPS'])
+
+    def test_dualstack_true_for_s3_control_with_s3_client_config_true(self):
+        config = Config(s3={'use_dualstack_endpoint': True})
+        self.endpoint_bridge.client_config = config
+        builtins = self.compute_builtins(service_name='s3-control')
+        self.assertTrue(builtins['AWS::UseDualStack'])
+
+    def test_dualstack_false_for_s3_control_with_s3_client_config_false(self):
+        config = Config(s3={'use_dualstack_endpoint': False})
+        self.endpoint_bridge.client_config = config
+        builtins = self.compute_builtins(service_name='s3-control')
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_dualstack_false_for_other_service_with_s3_client_config_true(
+        self,
+    ):
+        config = Config(s3={'use_dualstack_endpoint': True})
+        self.endpoint_bridge.client_config = config
+        builtins = self.compute_builtins(service_name='other-service')
+        self.assertFalse(builtins['AWS::UseDualStack'])
+
+    def test_sts_global_true_in_us_west_2_with_default_sts_config(self):
+        builtins = self.compute_builtins(region_name='us-west-2')
+        self.assertTrue(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_sts_global_false_in_eu_south_1_with_default_sts_config(self):
+        builtins = self.compute_builtins(region_name='eu-south-1')
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_sts_global_false_in_us_west_2_with_regional_sts_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        builtins = self.compute_builtins(region_name='us-west-2')
+        self.assertFalse(builtins['AWS::STS::UseGlobalEndpoint'])
+
+    def test_s3_global_true_when_s3_predicate_returns_true(self):
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global'
+        ) as predicate:
+            predicate.return_value = True
+            builtins = self.compute_builtins(region_name='us-east-1')
+        self.assertTrue(builtins['AWS::S3::UseGlobalEndpoint'])
+        predicate.assert_called_once()
+
+    def test_s3_accelerate_true_when_use_accelerate_endpoint_true(self):
+        builtins = self.compute_builtins(
+            s3_config={'use_accelerate_endpoint': True}
+        )
+        self.assertTrue(builtins['AWS::S3::Accelerate'])
+
+    def test_s3_accelerate_false_when_use_accelerate_endpoint_false(self):
+        builtins = self.compute_builtins(
+            s3_config={'use_accelerate_endpoint': False}
+        )
+        self.assertFalse(builtins['AWS::S3::Accelerate'])
+
+    def test_force_path_style_true_when_addressing_style_path(self):
+        builtins = self.compute_builtins(
+            s3_config={'addressing_style': 'path'}
+        )
+        self.assertTrue(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_force_path_style_false_when_addressing_style_auto(self):
+        builtins = self.compute_builtins(
+            s3_config={'addressing_style': 'auto'}
+        )
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_force_path_style_false_when_addressing_style_virtual(self):
+        builtins = self.compute_builtins(
+            s3_config={'addressing_style': 'virtual'}
+        )
+        self.assertFalse(builtins['AWS::S3::ForcePathStyle'])
+
+    def test_arn_region_false_disables_s3_and_s3control(self):
+        builtins = self.compute_builtins(s3_config={'use_arn_region': False})
+        self.assertFalse(builtins['AWS::S3::UseArnRegion'])
+        self.assertFalse(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_arn_region_true_enables_s3_and_s3control(self):
+        builtins = self.compute_builtins(s3_config={'use_arn_region': True})
+        self.assertTrue(builtins['AWS::S3::UseArnRegion'])
+        self.assertTrue(builtins['AWS::S3Control::UseArnRegion'])
+
+    def test_mrap_disabled_true_when_s3_disable_multiregion_true(self):
+        builtins = self.compute_builtins(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertTrue(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints']
+        )
+
+    def test_mrap_disabled_false_when_s3_disable_multiregion_false(self):
+        builtins = self.compute_builtins(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertFalse(
+            builtins['AWS::S3::DisableMultiRegionAccessPoints']
+        )
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data_and_legacy(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        client_url = 'https://client.endpoint.com'
+        builtins = self.compute_builtins(client_endpoint_url=client_url)
+        self.assertEqual(builtins['SDK::Endpoint'], client_url)
+
+    def test_sdk_endpoint_legacy_url_with_custom_data_and_no_client_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        builtins = self.compute_builtins()
+        self.assertEqual(
+            builtins['SDK::Endpoint'], self.legacy_endpoint_url
+        )
+
+    def test_sdk_endpoint_absent_with_bundled_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = True
+        builtins = self.compute_builtins()
+        self.assertIsNone(builtins['SDK::Endpoint'])
