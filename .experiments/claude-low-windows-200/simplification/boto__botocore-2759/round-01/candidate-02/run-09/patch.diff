+class EndpointResolverBuiltins(str, Enum):
+    """Builtin parameter names consumed by endpoint rulesets."""
+
+    # AWS::Region - str. The region name passed to client creation.
+    AWS_REGION = 'AWS::Region'
+    # AWS::UseFIPS - bool. Whether FIPS endpoint variants are requested.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # AWS::UseDualStack - bool. Whether DualStack endpoint variants are used.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # AWS::STS::UseGlobalEndpoint - bool. Whether STS uses the global endpoint.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # AWS::S3::UseGlobalEndpoint - bool. Whether S3 uses the global endpoint.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # AWS::S3::Accelerate - bool. Whether S3 accelerate endpoints are used.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # AWS::S3::ForcePathStyle - bool. Whether S3 path-style addressing is used.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # AWS::S3::UseArnRegion - bool by default, raw config value otherwise.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # AWS::S3Control::UseArnRegion - bool by default, raw config value
+    # otherwise.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # AWS::S3::DisableMultiRegionAccessPoints - bool. Whether MRAP is disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # SDK::Endpoint - str or absent. The endpoint URL chosen by the SDK.
+    SDK_ENDPOINT = 'SDK::Endpoint'
