+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter,
+            None,
+            None,
+            None,
+            None,
+            self.config_store,
+        )
+        self.resolver = mock.Mock()
+        self.resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.resolver,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(self, **overrides):
+        kwargs = {
+            'region_name': 'ca-central-1',
+            'service_name': 'fooservice',
+            's3_config': {},
+            'endpoint_bridge': self.bridge,
+            'client_endpoint_url': None,
+            'legacy_endpoint_url': self.legacy_url,
+        }
+        kwargs.update(overrides)
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            **kwargs
+        )
+
+    def test_default_builtins(self):
+        result = self._compute()
+        self.assertEqual(result['AWS::Region'], 'ca-central-1')
+        self.assertIs(result['AWS::UseFIPS'], False)
+        self.assertIs(result['AWS::UseDualStack'], False)
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], False)
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+        self.assertIsNone(result['SDK::Endpoint'])
+
+    def test_all_builtins_present_for_s3_service(self):
+        result = self._compute(service_name='s3')
+        self.assertEqual(len(result), 11)
+
+    def test_use_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertIs(result['AWS::UseFIPS'], True)
+
+    def test_use_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertIs(result['AWS::UseFIPS'], False)
+
+    def test_s3control_dualstack_true_from_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self._compute(service_name='s3-control')
+        self.assertIs(result['AWS::UseDualStack'], True)
+
+    def test_s3control_dualstack_false_from_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': False}
+        )
+        result = self._compute(service_name='s3-control')
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_other_service_dualstack_true_from_client_config(self):
+        self.bridge.client_config = Config(
+            s3={'use_dualstack_endpoint': True}
+        )
+        result = self._compute(service_name='other-service')
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_sts_global_true_us_west_2_default_config(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_sts_global_false_eu_south_1(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_sts_global_false_us_west_2_regional_config(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_global_true_calls_predicate_once(self):
+        with mock.patch.object(
+            self.args_create,
+            '_should_force_s3_global',
+            return_value=True,
+        ) as predicate:
+            result = self._compute(region_name='us-east-1')
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], True)
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_accelerate_true_passthrough(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(result['AWS::S3::Accelerate'], True)
+
+    def test_accelerate_false_passthrough(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+
+    def test_force_path_style_true_for_path_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], True)
+
+    def test_force_path_style_false_for_auto_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+
+    def test_force_path_style_false_for_virtual_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+
+    def test_use_arn_region_false_disables_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(result['AWS::S3::UseArnRegion'], False)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+
+    def test_use_arn_region_true_enables_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], True)
+
+    def test_mrap_true_passthrough(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], True
+        )
+
+    def test_mrap_false_passthrough(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+
+    def test_sdk_endpoint_client_url_wins_over_custom_data_and_legacy(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute(client_endpoint_url='https://client.url')
+        self.assertEqual(result['SDK::Endpoint'], 'https://client.url')
+
+    def test_sdk_endpoint_custom_data_no_client_url_uses_legacy(self):
+        self.resolver.uses_builtin_data = False
+        result = self._compute()
+        self.assertEqual(result['SDK::Endpoint'], self.legacy_url)
+
+    def test_sdk_endpoint_bundled_data_no_client_url_is_absent(self):
+        self.resolver.uses_builtin_data = True
+        result = self._compute()
+        self.assertIsNone(result['SDK::Endpoint'])
