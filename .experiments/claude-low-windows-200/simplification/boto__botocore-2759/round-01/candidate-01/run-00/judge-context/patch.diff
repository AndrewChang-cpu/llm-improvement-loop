+class EndpointResolverBuiltins(str, Enum):
+    """Builtin names consumed by endpoint rulesets."""
+
+    # Region name the client was created with (string).
+    AWS_REGION = 'AWS::Region'
+    # Whether FIPS endpoints are used (boolean).
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Whether DualStack endpoints are used (boolean).
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Whether the STS global endpoint is used (boolean).
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Whether the S3 global endpoint is used (boolean).
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Whether S3 accelerate endpoints are used (boolean).
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Whether S3 path-style addressing is forced (boolean).
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Whether S3 ARNs use the ARN region (boolean by default, raw config
+    # value otherwise).
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Whether S3Control ARNs use the ARN region (boolean by default, raw
+    # config value otherwise).
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Whether S3 multi-region access points are disabled (boolean).
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Endpoint URL override for the SDK (string, or absent).
+    SDK_ENDPOINT = 'SDK::Endpoint'
