+
+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.event_emitter = mock.Mock(HierarchicalEmitter)
+        self.config_store = ConfigValueStore()
+        self.args_create = args.ClientArgsCreator(
+            self.event_emitter, None, None, None, None, self.config_store
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=Config(),
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+        self.legacy_url = 'https://my.legacy.endpoint.com'
+
+    def _compute(
+        self,
+        region_name='ca-central-1',
+        service_name='fooservice',
+        s3_config=None,
+        endpoint_bridge=None,
+        client_endpoint_url=None,
+        legacy_endpoint_url=None,
+    ):
+        if s3_config is None:
+            s3_config = {}
+        if endpoint_bridge is None:
+            endpoint_bridge = self.bridge
+        return self.args_create.compute_endpoint_resolver_builtin_defaults(
+            region_name=region_name,
+            service_name=service_name,
+            s3_config=s3_config,
+            endpoint_bridge=endpoint_bridge,
+            client_endpoint_url=client_endpoint_url,
+            legacy_endpoint_url=legacy_endpoint_url,
+        )
+
+    def test_default_builtins_for_bundled_data_and_legacy_url(self):
+        result = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertEqual(result['AWS::Region'], 'ca-central-1')
+        self.assertIs(result['AWS::UseFIPS'], False)
+        self.assertIs(result['AWS::UseDualStack'], False)
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], False)
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+        self.assertIsNone(result['SDK::Endpoint'])
+
+    def test_use_fips_true_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self._compute()
+        self.assertIs(result['AWS::UseFIPS'], True)
+
+    def test_use_fips_false_from_config_store(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self._compute()
+        self.assertIs(result['AWS::UseFIPS'], False)
+
+    def test_s3_control_dualstack_true_from_client_config_s3(self):
+        bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=Config(s3={'use_dualstack_endpoint': True}),
+            config_store=self.config_store,
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(result['AWS::UseDualStack'], True)
+
+    def test_s3_control_dualstack_false_from_client_config_s3(self):
+        bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=Config(s3={'use_dualstack_endpoint': False}),
+            config_store=self.config_store,
+        )
+        result = self._compute(
+            service_name='s3-control', endpoint_bridge=bridge
+        )
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_other_service_ignores_client_config_s3_dualstack(self):
+        bridge = ClientEndpointBridge(
+            self.endpoint_resolver,
+            client_config=Config(s3={'use_dualstack_endpoint': True}),
+            config_store=self.config_store,
+        )
+        result = self._compute(
+            service_name='other-service', endpoint_bridge=bridge
+        )
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_sts_global_endpoint_true_in_legacy_global_region(self):
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_sts_global_endpoint_false_in_non_legacy_region(self):
+        result = self._compute(region_name='eu-south-1')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_sts_global_endpoint_false_when_sts_regional(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self._compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_global_endpoint_calls_predicate_once_when_true(self):
+        s3_config = {}
+        with mock.patch.object(
+            self.args_create, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self._compute(
+                region_name='us-east-1', s3_config=s3_config
+            )
+        predicate.assert_called_once_with('us-east-1', s3_config)
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], True)
+
+    def test_s3_accelerate_true_passes_through(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(result['AWS::S3::Accelerate'], True)
+
+    def test_s3_accelerate_false_passes_through(self):
+        result = self._compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+
+    def test_s3_force_path_style_true_for_path_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], True)
+
+    def test_s3_force_path_style_false_for_auto_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'auto'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+
+    def test_s3_force_path_style_false_for_virtual_addressing(self):
+        result = self._compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+
+    def test_use_arn_region_false_applies_to_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': False})
+        self.assertIs(result['AWS::S3::UseArnRegion'], False)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+
+    def test_use_arn_region_true_applies_to_s3_and_s3control(self):
+        result = self._compute(s3_config={'use_arn_region': True})
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], True)
+
+    def test_mrap_disabled_true_passes_through(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], True
+        )
+
+    def test_mrap_disabled_false_passes_through(self):
+        result = self._compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self._compute(
+            client_endpoint_url='https://client.endpoint.com',
+            legacy_endpoint_url=self.legacy_url,
+        )
+        self.assertEqual(
+            result['SDK::Endpoint'], 'https://client.endpoint.com'
+        )
+
+    def test_legacy_url_used_for_custom_data_without_client_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertEqual(result['SDK::Endpoint'], self.legacy_url)
+
+    def test_sdk_endpoint_absent_for_bundled_data_with_legacy_url(self):
+        result = self._compute(legacy_endpoint_url=self.legacy_url)
+        self.assertIsNone(result['SDK::Endpoint'])
