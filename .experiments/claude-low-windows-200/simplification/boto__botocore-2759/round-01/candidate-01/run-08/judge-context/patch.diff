+class EndpointResolverBuiltins(str, Enum):
+    """Builtin names consumed by endpoint rulesets."""
+
+    # Type: string. The region name.
+    AWS_REGION = 'AWS::Region'
+    # Type: boolean. Whether FIPS endpoints are used.
+    AWS_USE_FIPS = 'AWS::UseFIPS'
+    # Type: boolean. Whether DualStack endpoints are used.
+    AWS_USE_DUALSTACK = 'AWS::UseDualStack'
+    # Type: boolean. Whether the STS global endpoint is used.
+    AWS_STS_USE_GLOBAL_ENDPOINT = 'AWS::STS::UseGlobalEndpoint'
+    # Type: boolean. Whether the S3 global endpoint is used.
+    AWS_S3_USE_GLOBAL_ENDPOINT = 'AWS::S3::UseGlobalEndpoint'
+    # Type: boolean. Whether S3 Transfer Acceleration is used.
+    AWS_S3_ACCELERATE = 'AWS::S3::Accelerate'
+    # Type: boolean. Whether S3 path-style addressing is forced.
+    AWS_S3_FORCE_PATH_STYLE = 'AWS::S3::ForcePathStyle'
+    # Type: boolean by default, raw config value otherwise. Whether the
+    # ARN region is used for S3 ARNs.
+    AWS_S3_USE_ARN_REGION = 'AWS::S3::UseArnRegion'
+    # Type: boolean by default, raw config value otherwise. Whether the
+    # ARN region is used for S3Control ARNs.
+    AWS_S3CONTROL_USE_ARN_REGION = 'AWS::S3Control::UseArnRegion'
+    # Type: boolean. Whether multi-region access points are disabled.
+    AWS_S3_DISABLE_MRAP = 'AWS::S3::DisableMultiRegionAccessPoints'
+    # Type: string, or absent. The SDK endpoint URL. A client endpoint
+    # URL takes precedence; otherwise the legacy endpoint URL is used
+    # when the resolver uses custom endpoint data.
+    SDK_ENDPOINT = 'SDK::Endpoint'
