+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], True
+        )
+
+    def test_s3_force_path_style_with_virtual_addressing(self):
+        result = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_FORCE_PATH_STYLE], False
+        )
+
+    def test_arn_region_false_in_s3_config_disables_both(self):
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], False
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            False,
+        )
+
+    def test_arn_region_true_in_s3_config_enables_both(self):
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_USE_ARN_REGION], True
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3CONTROL_USE_ARN_REGION],
+            True,
+        )
+
+    def test_mrap_true_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], True
+        )
+
+    def test_mrap_false_from_s3_config(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            result[EndpointResolverBuiltins.AWS_S3_DISABLE_MRAP], False
+        )
+
+    def test_sdk_endpoint_prefers_client_url_over_custom_data_and_legacy(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute(client_endpoint_url='https://client.url')
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT],
+            'https://client.url',
+        )
+
+    def test_sdk_endpoint_is_legacy_url_with_custom_data(self):
+        self.resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(
+            result[EndpointResolverBuiltins.SDK_ENDPOINT], self.legacy_url
+        )
+
+    def test_sdk_endpoint_is_absent_with_bundled_data_and_legacy_url(self):
+        result = self.compute()
+        self.assertIsNone(result[EndpointResolverBuiltins.SDK_ENDPOINT])
