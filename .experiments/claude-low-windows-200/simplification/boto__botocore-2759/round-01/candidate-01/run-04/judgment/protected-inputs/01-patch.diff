+
+class TestEndpointResolverBuiltins(unittest.TestCase):
+    def setUp(self):
+        self.config_store = ConfigValueStore()
+        self.creator = args.ClientArgsCreator(
+            event_emitter=mock.Mock(spec=HierarchicalEmitter),
+            user_agent=None,
+            response_parser_factory=mock.Mock(),
+            loader=mock.Mock(),
+            exceptions_factory=mock.Mock(),
+            config_store=self.config_store,
+        )
+        self.endpoint_resolver = mock.Mock()
+        self.endpoint_resolver.uses_builtin_data = True
+        self.endpoint_bridge = self.make_bridge(Config())
+
+    def make_bridge(self, client_config):
+        return ClientEndpointBridge(
+            self.endpoint_resolver,
+            scoped_config=None,
+            client_config=client_config,
+            default_endpoint=None,
+            service_signing_name=None,
+            config_store=self.config_store,
+        )
+
+    def compute(self, **overrides):
+        params = dict(
+            region_name='ca-central-1',
+            service_name='fooservice',
+            s3_config={},
+            endpoint_bridge=self.endpoint_bridge,
+            client_endpoint_url=None,
+            legacy_endpoint_url='https://my.legacy.endpoint.com',
+        )
+        params.update(overrides)
+        return self.creator.compute_endpoint_resolver_builtin_defaults(
+            **params
+        )
+
+    def test_default_inputs_give_default_builtins(self):
+        result = self.compute()
+        self.assertEqual(result['AWS::Region'], 'ca-central-1')
+        self.assertIs(result['AWS::UseFIPS'], False)
+        self.assertIs(result['AWS::UseDualStack'], False)
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], False)
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+        self.assertIs(result['AWS::S3::DisableMultiRegionAccessPoints'], False)
+        self.assertIsNone(result['SDK::Endpoint'])
+
+    def test_use_fips_config_store_true_gives_use_fips_true(self):
+        self.config_store.set_config_variable('use_fips_endpoint', True)
+        result = self.compute()
+        self.assertIs(result['AWS::UseFIPS'], True)
+
+    def test_use_fips_config_store_false_gives_use_fips_false(self):
+        self.config_store.set_config_variable('use_fips_endpoint', False)
+        result = self.compute()
+        self.assertIs(result['AWS::UseFIPS'], False)
+
+    def test_s3_control_client_config_dualstack_true_gives_true(self):
+        self.endpoint_bridge = self.make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertIs(result['AWS::UseDualStack'], True)
+
+    def test_s3_control_client_config_dualstack_false_gives_false(self):
+        self.endpoint_bridge = self.make_bridge(
+            Config(s3={'use_dualstack_endpoint': False})
+        )
+        result = self.compute(service_name='s3-control')
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_other_service_client_config_s3_dualstack_true_gives_false(self):
+        self.endpoint_bridge = self.make_bridge(
+            Config(s3={'use_dualstack_endpoint': True})
+        )
+        result = self.compute(service_name='other-service')
+        self.assertIs(result['AWS::UseDualStack'], False)
+
+    def test_sts_global_true_for_us_west_2_default_configuration(self):
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], True)
+
+    def test_sts_global_false_for_eu_south_1(self):
+        result = self.compute(region_name='eu-south-1')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_sts_global_false_for_us_west_2_regional_sts_endpoints(self):
+        self.config_store.set_config_variable(
+            'sts_regional_endpoints', 'regional'
+        )
+        result = self.compute(region_name='us-west-2')
+        self.assertIs(result['AWS::STS::UseGlobalEndpoint'], False)
+
+    def test_s3_global_true_when_predicate_returns_true(self):
+        with mock.patch.object(
+            self.creator, '_should_force_s3_global', return_value=True
+        ) as predicate:
+            result = self.compute(region_name='us-east-1')
+        self.assertIs(result['AWS::S3::UseGlobalEndpoint'], True)
+        predicate.assert_called_once_with('us-east-1', {})
+
+    def test_s3_accelerate_true_from_s3_config_gives_true(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': True})
+        self.assertIs(result['AWS::S3::Accelerate'], True)
+
+    def test_s3_accelerate_false_from_s3_config_gives_false(self):
+        result = self.compute(s3_config={'use_accelerate_endpoint': False})
+        self.assertIs(result['AWS::S3::Accelerate'], False)
+
+    def test_s3_addressing_style_path_gives_force_path_style_true(self):
+        result = self.compute(s3_config={'addressing_style': 'path'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], True)
+
+    def test_s3_addressing_style_virtual_gives_force_path_style_false(self):
+        result = self.compute(s3_config={'addressing_style': 'virtual'})
+        self.assertIs(result['AWS::S3::ForcePathStyle'], False)
+
+    def test_s3_use_arn_region_false_gives_both_arn_region_false(self):
+        result = self.compute(s3_config={'use_arn_region': False})
+        self.assertIs(result['AWS::S3::UseArnRegion'], False)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], False)
+
+    def test_s3_use_arn_region_true_gives_both_arn_region_true(self):
+        result = self.compute(s3_config={'use_arn_region': True})
+        self.assertIs(result['AWS::S3::UseArnRegion'], True)
+        self.assertIs(result['AWS::S3Control::UseArnRegion'], True)
+
+    def test_s3_disable_mrap_true_gives_true(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': True}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], True
+        )
+
+    def test_s3_disable_mrap_false_gives_false(self):
+        result = self.compute(
+            s3_config={'s3_disable_multiregion_access_points': False}
+        )
+        self.assertIs(
+            result['AWS::S3::DisableMultiRegionAccessPoints'], False
+        )
+
+    def test_client_url_wins_over_custom_data_and_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self.compute(client_endpoint_url='https://client.example')
+        self.assertEqual(result['SDK::Endpoint'], 'https://client.example')
+
+    def test_custom_data_without_client_url_gives_legacy_url(self):
+        self.endpoint_resolver.uses_builtin_data = False
+        result = self.compute()
+        self.assertEqual(
+            result['SDK::Endpoint'], 'https://my.legacy.endpoint.com'
+        )
+
+    def test_bundled_data_legacy_url_gives_absent_sdk_endpoint(self):
+        result = self.compute()
+        self.assertIsNone(result['SDK::Endpoint'])
