+    def set_window_title(self, title: str) -> bool:
+        """Set the terminal window title.
+
+        Rich cannot restore titles; true means only the control was written.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            bool: True if written, False if the output is not a terminal.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
