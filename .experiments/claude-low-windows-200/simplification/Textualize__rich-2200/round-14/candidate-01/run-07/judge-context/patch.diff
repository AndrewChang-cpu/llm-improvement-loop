diff --git a/rich/console.py b/rich/console.py
index c2b1995..dc9f4bb 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1151,6 +1151,22 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the terminal window title.
+
+        Rich cannot restore titles; true means only the control was written.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            bool: True if the control was written, False if not a terminal.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
