diff --git a/rich/console.py b/rich/console.py
index c2b1995..2d93100 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1151,6 +1151,23 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the title of the terminal window.
+
+        Rich cannot restore titles. A return value of True means only the control
+        was written, not that the title changed.
+
+        Args:
+            title (str): The new terminal window title.
+
+        Returns:
+            bool: True if the control code was written, False if not a terminal.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
