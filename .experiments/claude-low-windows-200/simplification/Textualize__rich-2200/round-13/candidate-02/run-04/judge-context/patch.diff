+    def set_window_title(self, title: str) -> bool:
+        """Set the terminal window title.
+
+        Rich cannot restore titles; true only means the control was written.
+
+        Args:
+            title (str): The title text to set.
+
+        Returns:
+            bool: True if the control was written, False when not a terminal.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
