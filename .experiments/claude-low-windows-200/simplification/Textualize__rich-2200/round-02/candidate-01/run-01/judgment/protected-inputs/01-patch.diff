--- a/rich/console.py
+++ b/rich/console.py
@@ -1151,6 +1151,26 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the terminal window title.
+
+        Rich cannot restore the previous title, so the new title persists after the
+        application exits. Some shells reset the title around each command, but most
+        do not. Some terminals need configuration or lack title support. Other software
+        may overwrite the title at any time.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            bool: True if the title control was written. This does not confirm that
+                the title changed.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
