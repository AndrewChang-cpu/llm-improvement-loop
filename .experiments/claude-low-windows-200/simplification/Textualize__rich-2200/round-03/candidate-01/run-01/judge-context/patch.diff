diff --git a/rich/console.py b/rich/console.py
index c2b1995..6afce1e 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1151,6 +1151,27 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the terminal window title.
+
+        Rich cannot restore the previous title, so the new title persists after
+        the application exits. Some shells reset the title for each command, but
+        most do not. Some terminals need configuration or lack title support.
+        Other software may overwrite the title at any time.
+
+        Args:
+            title (str): The new terminal window title.
+
+        Returns:
+            bool: True if the title control was written, meaning the sequence was
+                sent. It does not confirm that the title changed. False if the
+                console is not a terminal, in which case nothing was written.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
