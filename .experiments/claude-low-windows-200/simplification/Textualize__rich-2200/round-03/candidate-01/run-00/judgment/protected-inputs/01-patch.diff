diff --git a/rich/console.py b/rich/console.py
index c2b1995..71c6ef0 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1151,6 +1151,28 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the terminal window title.
+
+        Rich cannot restore the previous title, so the new title persists after the
+        application exits. Some shells reset the title for each command, but most do
+        not. Some terminals need configuration to allow title changes, and some
+        do not support them at all. Other software may overwrite the title at any
+        time.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            bool: True if the title control was written, False if the console is not
+            a terminal. True means only that the control was written, not that the
+            title changed.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
