@@ -1151,6 +1151,23 @@ class Console:
             return True
         return False
 
+    def set_window_title(self, title: str) -> bool:
+        """Set the title of the terminal window.
+
+        Rich cannot restore the previous title. Shells may reset it, terminals may
+        need configuration or lack support, and other software may overwrite it.
+
+        Args:
+            title (str): The new window title.
+
+        Returns:
+            bool: True if the control was written, otherwise False.
+        """
+        if self.is_terminal:
+            self.control(Control.title(title))
+            return True
+        return False
+
