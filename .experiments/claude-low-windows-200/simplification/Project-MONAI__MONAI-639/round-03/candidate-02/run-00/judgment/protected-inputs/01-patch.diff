+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, transform(img)))
+
+    def test_slicing(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x[:, :, 10:20, 5:30])
+        result = transform(img)
+        expected = img[:, :, 10:20, 5:30]
+        self.assertEqual(result.shape, expected.shape)
+        self.assertTrue(np.allclose(result, expected))
+
+
+if __name__ == "__main__":
+    unittest.main()
