+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_func_keys_view(self):
+        data = {"img": self.imt}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        out = lambd(data)
+        self.assertTrue(np.allclose(self.imt, out["img"]))
+
+    def test_slicing_func(self):
+        data = {"img": self.imt, "label": self.segn}
+        lambd = Lambdad(keys=("img",), func=lambda x: x[:, :, 10:50, 5:40])
+        out = lambd(data)
+        expected = self.imt[:, :, 10:50, 5:40]
+        self.assertGreater(out["img"].size, 0)
+        self.assertEqual(out["img"].shape, expected.shape)
+        self.assertTrue(np.allclose(expected, out["img"]))
+        # unlisted entry is preserved and the caller's mapping is not modified
+        self.assertTrue(np.allclose(self.segn, out["label"]))
+        self.assertEqual(data["img"].shape, self.imt.shape)
+        self.assertTrue(np.allclose(self.imt, data["img"]))
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
