+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity_func(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slicing_func(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x[:, :, 10:50, 5:40])
+        out = lambd(img)
+        expected = img[:, :, 10:50, 5:40]
+        self.assertGreater(out.size, 0)
+        self.assertEqual(out.shape, expected.shape)
+        self.assertTrue(np.allclose(expected, out))
+
+
+if __name__ == "__main__":
+    unittest.main()
