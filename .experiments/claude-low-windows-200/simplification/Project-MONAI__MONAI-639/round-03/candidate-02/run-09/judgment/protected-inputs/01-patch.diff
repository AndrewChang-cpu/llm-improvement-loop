+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:3, 2:5])(data)
+        self.assertTrue(np.allclose(img[:, :, 1:3, 2:5], result["img"]))
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        data = {"img": img, "label": "text"}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:3, 2:5])(data)
+        self.assertEqual(result["label"], "text")
+        self.assertTrue(np.allclose(img[:, :, 1:3, 2:5], result["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
