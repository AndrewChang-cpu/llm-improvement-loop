+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_slice(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x[:, :, 2:10, 4:20])(img)
+        np.testing.assert_array_equal(result, img[:, :, 2:10, 4:20])
+        self.assertGreater(result.size, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
