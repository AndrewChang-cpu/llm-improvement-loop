+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambdad(keys=["img"], func=lambda x: x)
+        result = lambd({"img": img})
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_identity_keys_view(self):
+        data = {"img": self.imt}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        self.assertTrue(np.allclose(self.imt, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])
+        result = lambd({"img": img})
+        expected = img[:, :, 10:20, 5:15]
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(expected, result["img"]))
+
+    def test_slicing_keys_view(self):
+        data = {"img": self.imt}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])
+        result = lambd(data)
+        self.assertTrue(np.allclose(self.imt[:, :, 10:20, 5:15], result["img"]))
+
+    def test_unlisted_key_preserved_and_input_unmodified(self):
+        img = self.imt.copy()
+        data = {"img": img, "label": "text"}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])
+        result = lambd(data)
+        self.assertEqual(result["label"], "text")
+        self.assertTrue(np.allclose(img, data["img"]))
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
