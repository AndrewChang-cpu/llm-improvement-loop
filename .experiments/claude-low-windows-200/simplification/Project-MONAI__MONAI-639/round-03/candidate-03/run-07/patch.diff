+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])(data)
+        expected = self.imt[:, :, 10:50, 5:30]
+        self.assertEqual(result["img"].shape, expected.shape)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+
+    def test_unlisted_key_preserved(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        original_img = self.imt.copy()
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        self.assertIs(result["seg"], self.seg1)
+        # the caller's mapping and its array are not modified
+        self.assertIs(data["img"], self.imt)
+        np.testing.assert_allclose(data["img"], original_img)
+
+
+if __name__ == "__main__":
+    unittest.main()
