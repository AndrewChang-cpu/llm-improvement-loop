+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_identity_keys_view(self):
+        # the image is the sole entry, so the keys view lists only the image
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_slice(self):
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=lambda x: x[:, :, 10:20, 5:30])(data)
+        expected = self.imt[:, :, 10:20, 5:30]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+
+    def test_slice_keeps_unlisted_and_original(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=("img",), func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:20, 5:30])
+        self.assertIs(result["seg"], self.segn)
+        # the caller's mapping is not modified
+        self.assertIs(data["img"], self.imt)
+
+    def test_iterable_callable_applied_whole(self):
+        class IterableCallable:
+            def __init__(self):
+                self.calls = 0
+
+            def __call__(self, x):
+                self.calls += 1
+                return x
+
+            def __iter__(self):
+                return iter(())
+
+        func = IterableCallable()
+        data = {"a": self.imt, "b": self.segn}
+        result = Lambdad(keys=("a", "b"), func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_array_equal(result["a"], self.imt)
+        np.testing.assert_array_equal(result["b"], self.segn)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func="not callable")
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=(), func=lambda x: x)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
