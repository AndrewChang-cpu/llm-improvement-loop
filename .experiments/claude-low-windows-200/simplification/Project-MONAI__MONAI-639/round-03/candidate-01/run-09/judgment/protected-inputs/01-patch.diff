+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        # slice only the spatial axes so the batch and channel axes stay whole
+        result = Lambdad(keys=data.keys(), func=lambda x: x[..., 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], img[..., 10:20, 5:15])
+        self.assertGreater(result["img"].size, 0)
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], img[..., 10:20, 5:15])
+        np.testing.assert_array_equal(result["seg"], seg)
+        # the caller's mapping is not modified
+        np.testing.assert_array_equal(data["img"], img)
+        self.assertIs(data["seg"], seg)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func=1)
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
