+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        result = lambd(img)
+        self.assertIs(result, img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slicing(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x[:, :, 10:20, 5:15])
+        expected = img[:, :, 10:20, 5:15]
+        result = lambd(img)
+        self.assertEqual(result.shape, (1, 1, 10, 10))
+        self.assertTrue(np.allclose(expected, result))
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
