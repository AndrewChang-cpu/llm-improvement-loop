+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CountingIterableCallable:
+    """Callable that is also iterable; used to check it is applied whole."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+    def __iter__(self):
+        return iter((1, 2, 3))
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        lambd = Lambdad(keys=["img"], func=lambda x: x)
+        result = lambd(data)
+        self.assertIsNot(result, data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing_keys_view(self):
+        # the sole entry is the image, so passing the keys view is safe here
+        img = self.imt
+        data = {"img": img}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])
+        expected = img[:, :, 10:20, 5:15]
+        result = lambd(data)
+        self.assertEqual(result["img"].shape, (1, 1, 10, 10))
+        self.assertTrue(np.allclose(expected, result["img"]))
+
+    def test_slicing_preserves_unlisted_and_original(self):
+        img = self.imt.copy()
+        seg = self.segn.copy()
+        data = {"img": img, "seg": seg}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])
+        result = lambd(data)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], result["img"]))
+        self.assertTrue(np.array_equal(seg, result["seg"]))
+        # the caller's mapping is not modified
+        self.assertTrue(np.array_equal(self.imt, data["img"]))
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_iterable_callable_applied_whole(self):
+        func = _CountingIterableCallable()
+        data = {"img": self.imt, "seg": self.segn}
+        lambd = Lambdad(keys=["img", "seg"], func=func)
+        result = lambd(data)
+        self.assertEqual(func.calls, 2)
+        self.assertTrue(np.array_equal(self.imt, result["img"]))
+        self.assertTrue(np.array_equal(self.segn, result["seg"]))
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
