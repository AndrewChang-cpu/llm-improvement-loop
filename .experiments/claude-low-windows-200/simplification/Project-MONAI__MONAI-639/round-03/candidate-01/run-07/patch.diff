+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(func=lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slice(self):
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        result = Lambda(func=lambda x: x[:, :, 10:20, 5:15])(self.imt)
+        expected = self.imt[:, :, 10:20, 5:15]
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, expected)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
diff --git a/tests/test_lambdad.py b/tests/test_lambdad.py
