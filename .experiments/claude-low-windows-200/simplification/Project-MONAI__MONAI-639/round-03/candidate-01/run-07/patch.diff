index 0000000..bc2221c
--- /dev/null
+++ b/tests/test_lambdad.py
@@ -0,0 +1,83 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """A callable that is also iterable; it must still be applied as one callable."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[:, :, 10:20, 5:15]
+
+    def __iter__(self):
+        return iter([1, 2])
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slice(self):
+        data = {"img": self.imt}
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        expected = self.imt[:, :, 10:20, 5:15]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+
+    def test_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:15])
+
+    def test_unlisted_key_preserved_and_input_unchanged(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:15])
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        np.testing.assert_allclose(data["img"], self.imt)
+        np.testing.assert_allclose(data["seg"], self.seg1)
+
+    def test_iterable_callable_applied_whole_per_key(self):
+        func = _IterableCallable()
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:15])
+        np.testing.assert_allclose(result["seg"], self.seg1[:, :, 10:20, 5:15])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
