@@ -413,6 +414,35 @@ class ConcatItemsd(MapTransform):
         return d
 
 
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+
+    Example:
+        >>> data = {"img": np.array([[[0, 1, 2, 3]]])}
+        >>> Lambdad(keys="img", func=lambda x: x[:, :, 1:3])(data)["img"]
+        array([[[1, 2]]])
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: the callable applied to the value of each listed key. It is applied whole,
+                once per key, even if it is iterable.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func=func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
