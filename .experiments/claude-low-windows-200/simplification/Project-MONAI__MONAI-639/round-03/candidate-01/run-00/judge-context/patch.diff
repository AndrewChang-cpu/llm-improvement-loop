+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambdad(keys=["img"], func=lambda x: x)({"img": img})
+        np.testing.assert_allclose(result["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])({"img": img})
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:15])
+
+    def test_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:15])
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        seg = self.seg1
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:15])
+        self.assertIs(result["seg"], seg)
+
+    def test_original_not_modified(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        self.assertIsNot(result, data)
+        self.assertIs(data["img"], img)
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_iterable_callable_applied_whole(self):
+        calls = []
+
+        class IterableCallable:
+            def __iter__(self):
+                raise AssertionError("callable must not be iterated")
+
+            def __call__(self, x):
+                calls.append(x)
+                return x
+
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img", "seg"], func=IterableCallable())(data)
+        self.assertEqual(len(calls), 2)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.seg1)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
