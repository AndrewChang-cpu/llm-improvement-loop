diff --git a/monai/transforms/utility/array.py b/monai/transforms/utility/array.py
index 5b2eb42..523ef04 100644
--- a/monai/transforms/utility/array.py
+++ b/monai/transforms/utility/array.py
@@ -291,3 +291,25 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+
+    Example:
+        >>> img = np.array([[[0, 1, 2, 3]]])
+        >>> Lambda(func=lambda x: x[:, :, 1:3])(img)
+        array([[[1, 2]]])
+
+    Args:
+        func: the callable applied to the input value. It is called as ``func(img)``
+            and its return value is returned unchanged.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
