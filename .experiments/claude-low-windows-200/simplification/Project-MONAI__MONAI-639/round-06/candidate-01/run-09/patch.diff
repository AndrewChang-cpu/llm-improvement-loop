+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        out = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertTrue(np.allclose(img, out["img"]))
+
+    def test_slice(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        out = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        expected = img[:, :, 10:20, 5:15]
+        self.assertGreater(out["img"].size, 0)
+        self.assertTrue(np.allclose(expected, out["img"]))
+
+    def test_unlisted_entries_preserved(self):
+        img = self.imt
+        other = np.arange(6)
+        data = {"img": img, "other": other}
+        out = Lambdad(keys="img", func=lambda x: x[:, :, 10:20, 5:15])(data)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], out["img"]))
+        self.assertIs(out["other"], other)
+        self.assertIs(data["img"], img)
+        self.assertEqual(data["img"].shape, img.shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
