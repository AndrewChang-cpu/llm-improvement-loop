+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        out = Lambda(lambda x: x)(img)
+        self.assertTrue(np.allclose(img, out))
+
+    def test_slice(self):
+        img = self.imt
+        out = Lambda(lambda x: x[:, :, 10:20, 5:15])(img)
+        expected = img[:, :, 10:20, 5:15]
+        self.assertGreater(out.size, 0)
+        self.assertTrue(np.allclose(expected, out))
+
+
+if __name__ == "__main__":
+    unittest.main()
