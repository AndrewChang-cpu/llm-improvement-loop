+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """Callable that is also iterable, used to check that it is never split per key."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __iter__(self):
+        return iter((1, 2, 3))
+
+    def __call__(self, x):
+        self.calls.append(x)
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        data = {"img": self.imt}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        self.assertTrue(np.allclose(self.imt, result["img"]))
+
+    def test_identity_preserves_unlisted(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        lambd = Lambdad(keys=["img"], func=lambda x: x)
+        result = lambd(data)
+        self.assertTrue(np.allclose(self.imt, result["img"]))
+        self.assertTrue(np.allclose(self.seg1, result["seg"]))
+
+    def test_slicing_keys_view(self):
+        data = {"img": self.imt}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])
+        result = lambd(data)
+        expected = self.imt[:, :, 10:50, 5:30]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+
+    def test_slicing_preserves_unlisted_and_input(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])
+        result = lambd(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        # the caller's mapping is not modified
+        self.assertIs(data["img"], self.imt)
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_iterable_callable_applied_whole(self):
+        func = _IterableCallable()
+        data = {"img": self.imt, "seg": self.seg1}
+        lambd = Lambdad(keys=("img", "seg"), func=func)
+        result = lambd(data)
+        self.assertEqual(len(func.calls), 2)
+        self.assertIs(func.calls[0], self.imt)
+        self.assertIs(func.calls[1], self.seg1)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.seg1)
+
+
+if __name__ == "__main__":
+    unittest.main()
