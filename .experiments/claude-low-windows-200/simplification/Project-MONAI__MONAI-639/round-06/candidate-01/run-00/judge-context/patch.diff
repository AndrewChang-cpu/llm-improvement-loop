+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(lambda x: x)
+        result = lambd(img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slicing(self):
+        img = self.imt
+        lambd = Lambda(lambda x: x[:, :, 10:50, 5:30])
+        result = lambd(img)
+        expected = img[:, :, 10:50, 5:30]
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
