+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to each of the listed keys.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.array([[0, 1, 2], [3, 4, 5]]), "seg": np.array([[9, 9, 9], [9, 9, 9]])}
+            out = Lambdad(keys="img", func=lambda x: x[:, 1:])(data)
+            # out["img"] is array([[1, 2], [4, 5]]), out["seg"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each listed item. It must be callable, otherwise an
+            AssertionError is raised at construction. A list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
