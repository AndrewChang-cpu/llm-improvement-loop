         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input and return its result unchanged.
+    The callable is applied as-is, so any transformation expressible as a function can be used.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.array([[0, 1, 2], [3, 4, 5]])
+            out = Lambda(func=lambda x: x[:, 1:])(img)
+            # out is array([[1, 2], [4, 5]])
+
+    Args:
+        func: callable applied to the input image. It must be callable, otherwise an
+            AssertionError is raised at construction.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
