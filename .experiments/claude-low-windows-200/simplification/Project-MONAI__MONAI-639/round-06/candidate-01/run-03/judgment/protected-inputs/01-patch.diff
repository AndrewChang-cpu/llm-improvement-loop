+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class IterableCallable:
+    """Callable that is also iterable, used to check the callable is never split per key."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[:, :, 10:50, 5:30]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "seg": self.segn}
+        result = Lambdad(keys=("img",), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], img)
+        np.testing.assert_allclose(result["seg"], self.segn)
+        self.assertIsNot(result, data)
+
+    def test_identity_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img, "seg": self.segn}
+        result = Lambdad(keys=("img",), func=lambda x: x[:, :, 10:50, 5:30])(data)
+        expected = img[:, :, 10:50, 5:30]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+        np.testing.assert_allclose(result["seg"], self.segn)
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_slice_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+
+    def test_iterable_callable_applied_whole(self):
+        func = IterableCallable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=("img", "seg"), func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 10:50, 5:30])
+
+
+if __name__ == "__main__":
+    unittest.main()
