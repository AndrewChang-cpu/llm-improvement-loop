+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class CountingIterableCallable:
+    """Callable that is also iterable; used to check it is passed whole and called once per key."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x + 1
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_identity_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=("img",), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+
+    def test_slicing_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:20, 5:15])
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(data["img"], self.imt)
+
+    def test_slicing_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=("img",), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:20, 5:15])
+        np.testing.assert_array_equal(result["seg"], self.segn)
+        np.testing.assert_array_equal(data["img"], self.imt)
+
+    def test_iterable_callable_applied_whole_once_per_key(self):
+        func = CountingIterableCallable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=("img", "seg"), func=func)(data)
+        np.testing.assert_array_equal(result["img"], self.imt + 1)
+        np.testing.assert_array_equal(result["seg"], self.segn + 1)
+        self.assertEqual(func.calls, 2)
+
+
+if __name__ == "__main__":
+    unittest.main()
