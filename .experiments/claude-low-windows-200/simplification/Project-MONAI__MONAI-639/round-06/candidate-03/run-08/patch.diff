+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def identity(x):
+    return x
+
+
+def spatial_slice(x):
+    # keep batch and channel axes whole, slice only the spatial axes
+    return x[:, :, 10:50, 5:30]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=identity)(img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slice(self):
+        img = self.imt
+        result = Lambda(func=spatial_slice)(img)
+        expected = img[:, :, 10:50, 5:30]
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
