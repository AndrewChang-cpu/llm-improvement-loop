+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def identity(x):
+    return x
+
+
+def spatial_slice(x):
+    # keep batch and channel axes whole, slice only the spatial axes
+    return x[:, :, 10:50, 5:30]
+
+
+class CountingCallable:
+    """Iterable callable that records every item it is called with."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls.append(x)
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "label": "tag"}
+        result = Lambdad(keys=["img"], func=identity)(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+        self.assertEqual(result["label"], "tag")
+        self.assertIsNot(result, data)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=spatial_slice)(data)
+        expected = img[:, :, 10:50, 5:30]
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(expected, result["img"]))
+        # the caller's mapping is unchanged
+        self.assertTrue(np.array_equal(img, data["img"]))
+
+    def test_slice_preserves_unlisted(self):
+        img = self.imt
+        data = {"img": img, "label": "tag"}
+        result = Lambdad(keys=["img"], func=spatial_slice)(data)
+        self.assertTrue(np.allclose(img[:, :, 10:50, 5:30], result["img"]))
+        self.assertEqual(result["label"], "tag")
+        self.assertTrue(np.array_equal(img, data["img"]))
+
+    def test_iterable_callable_applied_whole(self):
+        func = CountingCallable()
+        data = {"a": 1, "b": 2, "c": 3}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertEqual(func.calls, [1, 2])
+        self.assertEqual(result, {"a": 1, "b": 2, "c": 3})
+
+
+if __name__ == "__main__":
+    unittest.main()
