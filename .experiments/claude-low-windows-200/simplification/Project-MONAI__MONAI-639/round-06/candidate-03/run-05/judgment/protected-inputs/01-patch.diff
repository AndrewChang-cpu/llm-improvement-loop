+
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same callable is applied
+    to the item of each listed key.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(6).reshape(1, 2, 3), "label": "unchanged"}
+            out = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:])(data)
+            print(out["img"].tolist())  # [[[1, 2], [4, 5]]]
+            print(out["label"])  # unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each listed item; it receives the item and returns the transformed value.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
