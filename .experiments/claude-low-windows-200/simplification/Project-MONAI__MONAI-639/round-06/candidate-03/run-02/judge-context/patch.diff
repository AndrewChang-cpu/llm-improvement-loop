+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        transform = Lambda(lambda x: x)
+        result = transform(img)
+        np.testing.assert_allclose(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping batch and channel axes whole
+        transform = Lambda(lambda x: x[:, :, 1:-1, 2:-2])
+        result = transform(img)
+        self.assertTrue(result.size > 0)
+        np.testing.assert_allclose(result, img[:, :, 1:-1, 2:-2])
+
+
+if __name__ == "__main__":
+    unittest.main()
