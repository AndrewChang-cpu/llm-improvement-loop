+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_identity_keys_view(self):
+        # the image is the sole entry, so a keys view can be used safely
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only spatial axes so batch and channel axes are kept whole
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+        self.assertTrue(result["img"].size > 0)
+
+    def test_slicing_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(result["seg"], self.seg1)
+
+    def test_original_mapping_untouched(self):
+        data = {"img": self.imt}
+        Lambdad(keys="img", func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(data["img"], self.imt)
+
+
+if __name__ == "__main__":
+    unittest.main()
