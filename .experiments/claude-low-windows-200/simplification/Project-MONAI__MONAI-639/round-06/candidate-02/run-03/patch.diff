+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same function is
+    applied to the item under each of the listed keys.
+
+    Example:
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(6).reshape(2, 3), "label": 1}
+            result = Lambdad(keys="img", func=lambda x: x[:, 1:])(data)
+            print(result["img"])
+            # [[1 2]
+            #  [4 5]]
+            print(result["label"])
+            # 1
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: function applied to each item under the listed keys. It must be callable.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
