     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the whole input. The function receives the input
+    unchanged and its return value is the output of this transform.
+
+    Example:
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(6).reshape(2, 3)
+            print(Lambda(lambda x: x[:, 1:])(img))
+            # [[1 2]
+            #  [4 5]]
+
+    Args:
+        func: function to be applied to the input. It must be callable.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
