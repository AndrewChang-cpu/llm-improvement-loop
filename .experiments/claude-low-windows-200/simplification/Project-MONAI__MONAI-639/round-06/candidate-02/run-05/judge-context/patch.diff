@@ -291,3 +291,27 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the whole input and return its result.
+
+    Example:
+        .. code-block:: python
+
+            lambd = Lambda(func=lambda x: x[:, 1:])
+            result = lambd(np.array([[1, 2, 3]]))  # [[2, 3]]
+
+    Args:
+        func: callable applied to the input. It receives the whole input and returns the transformed value.
+            It must be callable, otherwise an AssertionError is raised at construction.
+
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
