+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same callable is applied
+    to every listed key. The input mapping is not modified; a new dictionary is returned.
+
+    Example:
+        .. code-block:: python
+
+            lambd = Lambdad(keys=["img"], func=lambda x: x[:, 1:])
+            result = lambd({"img": np.array([[1, 2, 3]])})  # result["img"] is [[2, 3]]
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each listed item. It receives the whole item and returns the transformed value.
+            It must be callable, otherwise an AssertionError is raised at construction.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
