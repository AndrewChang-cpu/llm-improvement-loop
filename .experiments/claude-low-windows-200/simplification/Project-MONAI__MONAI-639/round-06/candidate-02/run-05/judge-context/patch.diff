+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        # a keys view is used here because the image is the sole entry
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 10:20, 5:30])
+
+    def test_unlisted_preserved(self):
+        data = {"img": self.imt, "other": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 10:20, 5:30])
+        np.testing.assert_allclose(result["other"], self.segn)
+        # the original mapping is untouched
+        np.testing.assert_allclose(data["img"], self.imt)
+
+
+if __name__ == "__main__":
+    unittest.main()
