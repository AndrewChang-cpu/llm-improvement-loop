+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        # slice only spatial axes so batch and channel axes are kept whole
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 4:-4, 8:-8])(data)
+        expected = img[:, :, 4:-4, 8:-8]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+        # the caller's mapping is left unchanged
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 4:-4, 8:-8])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 4:-4, 8:-8])
+
+    def test_unlisted_entries_preserved(self):
+        img = self.imt
+        label = "label"
+        data = {"img": img, "label": label}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 4:-4, 8:-8])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 4:-4, 8:-8])
+        self.assertEqual(result["label"], label)
+        np.testing.assert_array_equal(data["img"], img)
+
+
+if __name__ == "__main__":
+    unittest.main()
