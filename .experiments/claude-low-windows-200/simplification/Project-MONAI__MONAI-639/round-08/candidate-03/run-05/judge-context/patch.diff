+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes (last two) so the result is non-empty
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[..., 10:20, 5:15])
+        self.assertGreater(result["img"].size, 0)
+        # the original mapping is left untouched
+        np.testing.assert_array_equal(data["img"], self.imt)
+
+    def test_unlisted_entry_preserved(self):
+        # keys name only the image, so the string entry must pass through unchanged
+        data = {"img": self.imt, "name": "case_001"}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[..., 10:20, 5:15])
+        self.assertEqual(result["name"], "case_001")
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
