+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to every item listed in ``keys``.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(16).reshape(1, 4, 4), "seg": np.zeros((1, 4, 4))}
+            transform = Lambdad(keys=["img", "seg"], func=lambda x: x[..., 1:3, 0:2])
+            out = transform(data)  # out["img"] and out["seg"] have shape (1, 2, 2)
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to each listed item. It receives the whole item and returns the transformed value.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
