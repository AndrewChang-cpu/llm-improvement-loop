@@ -0,0 +1,75 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """A callable that is also iterable, to check it is applied whole rather than split."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter(())
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], img)
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img, "label": "kept"}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], img[..., 10:20, 5:30])
+        self.assertGreater(result["img"].size, 0)
+        self.assertEqual(result["label"], "kept")
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_iterable_callable_applied_whole(self):
+        img = self.imt
+        func = _IterableCallable()
+        data = {"img": img, "seg": img}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], img)
+        np.testing.assert_allclose(result["seg"], img)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
