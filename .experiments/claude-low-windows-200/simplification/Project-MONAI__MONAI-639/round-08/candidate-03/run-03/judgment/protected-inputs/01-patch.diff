+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x)
+        np.testing.assert_allclose(transform(img), img)
+
+    def test_slicing(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x[..., 10:40, 5:25])
+        np.testing.assert_allclose(transform(img), img[..., 10:40, 5:25])
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
