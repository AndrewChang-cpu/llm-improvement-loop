@@ -0,0 +1,76 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class CountingIterableCallable:
+    """Callable that is also iterable, used to check that the whole callable is never split."""
+
+    def __init__(self, func):
+        self.func = func
+        self.calls = 0
+
+    def __iter__(self):
+        return iter((self.func,))
+
+    def __call__(self, x):
+        self.calls += 1
+        return self.func(x)
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], img)
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[..., 10:40, 5:25])(data)
+        np.testing.assert_allclose(result["img"], img[..., 10:40, 5:25])
+        self.assertEqual(result["img"].shape, img[..., 10:40, 5:25].shape)
+
+    def test_unlisted_preserved_and_original_untouched(self):
+        img = self.imt
+        seg = self.seg1
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:40, 5:25])(data)
+        np.testing.assert_allclose(result["img"], img[..., 10:40, 5:25])
+        np.testing.assert_allclose(result["seg"], seg)
+        np.testing.assert_allclose(data["img"], img)
+        self.assertIs(data["seg"], seg)
+
+    def test_iterable_callable_applied_whole(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        func = CountingIterableCallable(lambda x: x[..., 10:40, 5:25])
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], img[..., 10:40, 5:25])
+        np.testing.assert_allclose(result["seg"], self.seg1[..., 10:40, 5:25])
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
