+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Apply the same user-supplied function to each item listed in ``keys``.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            # keep only the spatial slice [10:20, 5:15] of each listed array
+            transform = Lambdad(keys=["img", "seg"], func=lambda x: x[..., 10:20, 5:15])
+            out = transform({"img": np.zeros((1, 32, 32)), "seg": np.zeros((1, 32, 32))})
+            # out["img"] and out["seg"] have shape (1, 10, 10)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: function applied to each listed item. It receives the whole item and returns the transformed value.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
