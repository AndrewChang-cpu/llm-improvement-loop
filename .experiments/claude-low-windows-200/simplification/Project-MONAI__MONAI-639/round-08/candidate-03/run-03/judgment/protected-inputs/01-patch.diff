     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the whole input and return its result.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            # keep only the spatial slice [10:20, 5:15] of a channel-first array
+            transform = Lambda(func=lambda x: x[..., 10:20, 5:15])
+            out = transform(np.zeros((1, 32, 32)))  # shape (1, 10, 10)
+
+    Args:
+        func: function applied to the input. It receives the whole input and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
