+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        identity = Lambda(func=lambda x: x)
+        result = identity(img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        slicing = Lambda(func=lambda x: x[:, :, 10:50, 5:30])
+        result = slicing(img)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_array_equal(result, img[:, :, 10:50, 5:30])
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=5)
+
+
+if __name__ == "__main__":
+    unittest.main()
