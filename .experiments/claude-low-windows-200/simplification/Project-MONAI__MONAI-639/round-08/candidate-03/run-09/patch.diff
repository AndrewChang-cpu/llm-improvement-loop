+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        data["seg"] = self.segn
+        identity = Lambdad(keys=["img"], func=lambda x: x)
+        result = identity(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], img)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+
+    def test_slicing(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        data["seg"] = self.segn
+        slicing = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])
+        result = slicing(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:50, 5:30])
+        np.testing.assert_array_equal(result["seg"], self.segn)
+        # the original mapping is left untouched
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_keys_view(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        slicing = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])
+        result = slicing(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:50, 5:30])
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=5)
+
+
+if __name__ == "__main__":
+    unittest.main()
