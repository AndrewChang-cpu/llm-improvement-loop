+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def _slice_spatial(x):
+    # slice only the spatial axes, keeping batch and channel axes whole
+    return x[:, :, 10:50, 5:30]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], img)
+        # unlisted entry is preserved
+        np.testing.assert_allclose(result["seg"], self.segn)
+        # original mapping untouched
+        self.assertIs(data["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=_slice_spatial)(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:50, 5:30])
+        self.assertGreater(result["img"].size, 0)
+        # unlisted entry is preserved
+        np.testing.assert_allclose(result["seg"], self.segn)
+        # original mapping untouched
+        self.assertEqual(data["img"].shape, img.shape)
+
+    def test_keys_view(self):
+        # image is the sole entry, so slicing the keys view is safe
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=_slice_spatial)(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
