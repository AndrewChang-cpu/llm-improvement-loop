+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _slice_spatial(x):
+    # slice only the spatial axes, keeping batch and channel axes whole
+    return x[:, :, 10:50, 5:30]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slice(self):
+        img = self.imt
+        lambd = Lambda(_slice_spatial)
+        result = lambd(img)
+        np.testing.assert_allclose(result, img[:, :, 10:50, 5:30])
+        self.assertGreater(result.size, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
