+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        lambd = Lambdad(keys=["img"], func=lambda x: x)
+        data = {"img": self.imt}
+        result = lambd(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        self.assertIsNot(result, data)
+
+    def test_identity_keys_view(self):
+        lambd = Lambdad(keys={"img": 0}.keys(), func=lambda x: x)
+        result = lambd({"img": self.imt})
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice spatial axes only, keeping batch and channel axes whole
+        lambd = Lambdad(keys=["img"], func=lambda x: x[..., 2:10, 3:20])
+        data = {"img": self.imt}
+        result = lambd(data)
+        expected = self.imt[..., 2:10, 3:20]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+        # the original mapping is left untouched
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_unlisted_entry_preserved(self):
+        lambd = Lambdad(keys="img", func=lambda x: x[..., 2:10, 3:20])
+        data = {"img": self.imt, "seg": self.segn}
+        result = lambd(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 2:10, 3:20])
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+
+if __name__ == "__main__":
+    unittest.main()
