+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to every key listed in ``keys``.
+
+    Example:
+
+        .. code-block:: python
+
+            # slice the spatial axes of the "img" array, keeping the channel axis whole
+            lambd = Lambdad(keys="img", func=lambda x: x[:, 1:3, 1:3])
+            out = lambd({"img": np.zeros((1, 4, 4)), "seg": np.zeros((1, 4, 4))})
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable applied to each item listed in ``keys``, must be callable.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
