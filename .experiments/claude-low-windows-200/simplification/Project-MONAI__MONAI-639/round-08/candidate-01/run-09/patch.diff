@@ -291,3 +291,28 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image.
+    The callable is applied to the whole input, so it can be any function on arrays or tensors.
+
+    Example:
+
+        .. code-block:: python
+
+            # slice the spatial axes of a (channel, height, width) array, keeping the channel axis whole
+            lambd = Lambda(lambda x: x[:, 1:3, 1:3])
+            out = lambd(np.zeros((1, 4, 4)))  # shape: (1, 2, 2)
+
+    Args:
+        func: the callable to apply to the input image, must be callable.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
