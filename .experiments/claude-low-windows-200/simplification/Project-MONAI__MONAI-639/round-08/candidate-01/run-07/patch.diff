+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes so batch and channel axes are kept whole
+        result = Lambda(lambda x: x[:, :, 10:50, 5:30])(self.imt)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, self.imt[:, :, 10:50, 5:30])
+
+
+if __name__ == "__main__":
+    unittest.main()
