+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes so batch and channel axes are kept whole
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+
+    def test_keys_view_and_original_untouched(self):
+        # a keys view is used only here, where the image is the sole entry
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_unlisted_entry_preserved(self):
+        # keys name only the image, so the other entry must pass through unchanged
+        data = {"img": self.imt, "meta": "unchanged"}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])(data)
+        self.assertEqual(result["meta"], "unchanged")
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+
+
+if __name__ == "__main__":
+    unittest.main()
