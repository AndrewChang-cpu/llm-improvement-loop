@@ -291,3 +291,26 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image.
+
+    Example (array input with a slicing callable)::
+
+        >>> import numpy as np
+        >>> from monai.transforms import Lambda
+        >>> img = np.random.rand(1, 1, 8, 8)
+        >>> out = Lambda(lambda x: x[:, :, 2:6, 2:6])(img)
+
+    Args:
+        func: callable applied to the input image; its result is returned.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
