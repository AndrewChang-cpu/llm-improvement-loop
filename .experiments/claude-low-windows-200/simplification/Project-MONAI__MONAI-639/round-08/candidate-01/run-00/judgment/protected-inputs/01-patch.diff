+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(lambda x: x)(img)
+        np.testing.assert_allclose(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = Lambda(lambda x: x[:, :, 10:50, 5:30])(img)
+        np.testing.assert_allclose(result, img[:, :, 10:50, 5:30])
+
+
+if __name__ == "__main__":
+    unittest.main()
