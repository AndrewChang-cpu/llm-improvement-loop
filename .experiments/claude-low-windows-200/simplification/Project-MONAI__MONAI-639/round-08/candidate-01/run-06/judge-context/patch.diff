+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        # unlisted entry is preserved unchanged
+        np.testing.assert_allclose(result["seg"], self.seg1)
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        # the original mapping is left untouched
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_keys_view(self):
+        # image is the sole entry, so slicing a keys view is safe
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
