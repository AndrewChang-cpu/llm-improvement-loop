     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input data.
+
+    For example, a slicing callable applied to a channel-first array keeps the
+    batch and channel axes whole:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(2 * 3 * 4).reshape(2, 3, 4)
+            transform = Lambda(func=lambda x: x[:, 1:, :2])
+            out = transform(img)  # shape (2, 2, 2)
+
+    Args:
+        func: callable applied to the input data. Must be callable.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
