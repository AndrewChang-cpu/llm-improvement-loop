@@ -291,3 +291,26 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image and return its result. For example,
+    a slicing callable applied to a channel-first array:
+
+    .. code-block:: python
+
+        >>> img = np.arange(24).reshape(1, 4, 6)
+        >>> Lambda(lambda x: x[:, 1:3, 2:5])(img).shape
+        (1, 2, 3)
+
+    Args:
+        func: callable applied to the input image.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
