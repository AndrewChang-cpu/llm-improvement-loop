+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        out = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(out, data)
+        self.assertTrue(np.allclose(img, out["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        out = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:10, 3:11])(data)
+        self.assertIsNot(out, data)
+        self.assertGreater(out["img"].size, 0)
+        self.assertTrue(np.allclose(img[:, :, 2:10, 3:11], out["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        data = {"img": img, "label": "meta"}
+        out = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:10, 3:11])(data)
+        self.assertEqual(out["label"], "meta")
+        self.assertTrue(np.allclose(img[:, :, 2:10, 3:11], out["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
