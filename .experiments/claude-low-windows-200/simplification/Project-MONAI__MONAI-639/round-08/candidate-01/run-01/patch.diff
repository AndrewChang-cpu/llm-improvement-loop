+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slicing(self):
+        img = self.imt
+        lambd = Lambda(lambda x: x[:, :, 2:10, 3:11])
+        result = lambd(img)
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(img[:, :, 2:10, 3:11], result))
+
+
+if __name__ == "__main__":
+    unittest.main()
