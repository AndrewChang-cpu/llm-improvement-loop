         return d
 
 
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to every item listed in ``keys``.
+
+    For example, a slicing callable applied to array inputs:
+
+        .. code-block:: python
+
+            data = {"img": np.random.rand(1, 1, 128, 64), "seg": np.zeros((1, 1, 128, 64))}
+            result = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:10, 3:12])(data)  # "seg" is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable to apply to each item listed in ``keys``.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
