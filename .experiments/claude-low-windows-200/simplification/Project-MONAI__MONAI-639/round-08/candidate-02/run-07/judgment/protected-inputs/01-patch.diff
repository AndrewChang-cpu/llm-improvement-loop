+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(func=lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slicing(self):
+        # slice the spatial axes only, keeping the batch and channel axes whole
+        result = Lambda(func=lambda x: x[:, :, 10:50, 5:30])(self.imt)
+        expected = self.imt[:, :, 10:50, 5:30]
+        self.assertTrue(result.size > 0)
+        np.testing.assert_allclose(result, expected)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
