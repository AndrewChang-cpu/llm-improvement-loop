@@ -0,0 +1,74 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CountingIterable:
+    """Callable that is also iterable; used to check the callable is applied whole, never iterated."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[:, :, 10:50, 5:30]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_slicing(self):
+        # slice the spatial axes only, keeping the batch and channel axes whole
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])(data)
+        expected = self.imt[:, :, 10:50, 5:30]
+        self.assertTrue(result["img"].size > 0)
+        np.testing.assert_allclose(result["img"], expected)
+        # unlisted entry is preserved unchanged, original mapping is untouched
+        self.assertIs(result["seg"], self.segn)
+        self.assertIs(data["img"], self.imt)
+        self.assertIsNot(result, data)
+
+    def test_keys_view(self):
+        # the image is the sole entry, so slicing a keys view only touches the image
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        self.assertIs(data["img"], self.imt)
+
+    def test_iterable_callable_applied_whole(self):
+        func = _CountingIterable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 10:50, 5:30])
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
