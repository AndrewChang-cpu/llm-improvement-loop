+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to every item listed in ``keys``; the callable is never split or iterated.
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambdad
+
+        data = {"img": np.zeros((1, 1, 8, 8)), "seg": np.zeros((1, 1, 8, 8))}
+        # slice the spatial axes only, keeping the batch and channel axes whole
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:6, 2:6])(data)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each item listed in ``keys``.
+            It must be callable, otherwise an AssertionError is raised.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func=func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
