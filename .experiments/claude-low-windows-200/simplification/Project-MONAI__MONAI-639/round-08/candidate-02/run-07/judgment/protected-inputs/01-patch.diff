     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image.
+    The callable is applied to the whole input, so it can be any function, for example a slicing operation:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambda
+
+        img = np.zeros((1, 1, 8, 8))
+        # slice the spatial axes only, keeping the batch and channel axes whole
+        result = Lambda(func=lambda x: x[:, :, 2:6, 2:6])(img)
+
+    Args:
+        func: callable applied to the input image. It must be callable, otherwise an AssertionError is raised.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
