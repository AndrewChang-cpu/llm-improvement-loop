@@ -291,3 +291,28 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda or function to the input data.
+
+    For example, slice an array in its spatial dimensions and keep the batch and channel axes::
+
+        >>> from monai.transforms import Lambda
+        >>> img = np.random.rand(1, 1, 128, 64)
+        >>> result = Lambda(lambda x: x[..., 10:50, 5:30])(img)
+        >>> result.shape
+        (1, 1, 40, 25)
+
+    Args:
+        func: the callable to apply to the input data. Must be callable; it is applied to the
+            input as a whole, so iterable callables are not split.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
