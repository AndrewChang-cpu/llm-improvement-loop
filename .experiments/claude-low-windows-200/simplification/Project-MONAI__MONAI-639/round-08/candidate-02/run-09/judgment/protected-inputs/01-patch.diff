+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "label": "unchanged"}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], img)
+        self.assertEqual(result["label"], "unchanged")
+        self.assertEqual(data["label"], "unchanged")
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping batch and channel axes whole
+        data = {"img": img, "label": "unchanged"}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:50, 5:30])(data)
+        self.assertEqual(result["img"].shape, (1, 1, 40, 25))
+        np.testing.assert_array_equal(result["img"], img[..., 10:50, 5:30])
+        self.assertEqual(result["label"], "unchanged")
+        # the caller's mapping is left untouched
+        self.assertIs(data["img"], img)
+
+    def test_slicing_keys_view(self):
+        img = self.imt
+        # the image is the sole entry, so slicing a keys view is safe here
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[..., 10:50, 5:30])(data)
+        np.testing.assert_array_equal(result["img"], img[..., 10:50, 5:30])
+
+
+if __name__ == "__main__":
+    unittest.main()
