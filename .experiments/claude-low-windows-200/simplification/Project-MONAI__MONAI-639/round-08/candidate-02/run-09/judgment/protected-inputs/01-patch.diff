+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Apply the same user-defined callable to every item listed in `keys`.
+
+    For example, slice the spatial dimensions of the array stored under key "img"::
+
+        >>> from monai.transforms import Lambdad
+        >>> data = {"img": np.random.rand(1, 1, 128, 64)}
+        >>> result = Lambdad(keys="img", func=lambda x: x[..., 10:50, 5:30])(data)
+        >>> result["img"].shape
+        (1, 1, 40, 25)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable to apply to each listed item. It is applied to each item as a whole,
+            so iterable callables are not split. Must be callable.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
