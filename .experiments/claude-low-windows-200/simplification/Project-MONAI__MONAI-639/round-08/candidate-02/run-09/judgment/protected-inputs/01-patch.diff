+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(lambda x: x)(img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping batch and channel axes whole
+        result = Lambda(lambda x: x[..., 10:50, 5:30])(img)
+        self.assertEqual(result.shape, (1, 1, 40, 25))
+        np.testing.assert_array_equal(result, img[..., 10:50, 5:30])
+
+
+if __name__ == "__main__":
+    unittest.main()
