+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to every key in ``keys``.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.random.rand(1, 1, 64, 48)}  # batch, channel, height, width
+            # slice only the spatial axes, keeping batch and channel axes whole
+            cropper = Lambdad(keys="img", func=lambda x: x[:, :, 10:20, 5:15])
+            out = cropper(data)  # out["img"] has shape (1, 1, 10, 10)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable function applied to each item listed in ``keys``.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
