+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        out = Lambda(lambda x: x)(img)
+        self.assertTrue(np.allclose(img, out))
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping batch and channel axes whole
+        out = Lambda(lambda x: x[:, :, 10:20, 5:15])(img)
+        self.assertEqual(out.size, 1 * 1 * 10 * 10)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], out))
+
+
+if __name__ == "__main__":
+    unittest.main()
