+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CountingIterableCallable:
+    """Callable that is also iterable; used to check that it is applied whole, not iterated."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        yield from ()
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        out = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertTrue(np.allclose(img, out["img"]))
+
+    def test_identity_preserves_other_entries(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        out = Lambdad(keys=["img"], func=lambda x: x)(data)
+        self.assertTrue(np.allclose(img, out["img"]))
+        self.assertIs(out["seg"], data["seg"])
+
+    def test_slicing_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        # slice only the spatial axes, keeping batch and channel axes whole
+        out = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        self.assertEqual(out["img"].size, 1 * 1 * 10 * 10)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], out["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_slicing_preserves_other_entries(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        out = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], out["img"]))
+        self.assertIs(out["seg"], data["seg"])
+        self.assertEqual(data["img"].shape, img.shape)
+
+    def test_iterable_callable_applied_whole_per_key(self):
+        func = _CountingIterableCallable()
+        data = {"img": self.imt, "seg": self.seg1}
+        out = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        self.assertTrue(np.allclose(self.imt, out["img"]))
+        self.assertTrue(np.allclose(self.seg1, out["seg"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
