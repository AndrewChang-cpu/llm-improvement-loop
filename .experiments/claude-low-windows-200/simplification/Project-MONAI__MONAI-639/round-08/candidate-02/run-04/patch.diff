+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CountingIterableCallable:
+    """Callable that is also iterable, used to check that func is never split or iterated."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter(())
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "name": "case_01"}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], img)
+        self.assertEqual(result["name"], "case_01")
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "name": "case_01"}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:40])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:50, 5:40])
+        self.assertEqual(result["name"], "case_01")
+        # the original mapping is left untouched
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:50, 5:40])
+
+    def test_iterable_callable_applied_whole(self):
+        func = _CountingIterableCallable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
