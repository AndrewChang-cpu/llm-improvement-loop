     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input data and return its result.
+
+    For example, slicing the spatial axes of a channel-first array while keeping
+    the batch and channel axes whole:
+
+    .. code-block:: python
+
+        >>> transform = Lambda(lambda x: x[:, :, 10:50, 5:40])
+        >>> transform(np.zeros((1, 1, 128, 64))).shape
+        (1, 1, 40, 35)
+
+    Args:
+        func: callable applied to the input data, must be callable.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
