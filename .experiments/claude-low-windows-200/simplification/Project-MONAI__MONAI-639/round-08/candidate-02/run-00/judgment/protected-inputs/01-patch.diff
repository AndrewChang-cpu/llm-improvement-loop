     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input, for example to slice an array.
+
+    Example:
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.random.rand(1, 64, 64)  # channel-first array
+            out = Lambda(lambda x: x[:, 16:48, 16:48])(img)  # shape (1, 32, 32)
+
+    Args:
+        func: the callable to apply to the input. It must be callable, otherwise
+            an AssertionError is raised at construction.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
