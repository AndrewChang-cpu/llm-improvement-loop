+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slicing(self):
+        # slice spatial axes only, keep batch and channel axes whole so the result is non-empty
+        result = Lambda(lambda x: x[:, :, 16:48, 8:40])(self.imt)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, self.imt[:, :, 16:48, 8:40])
+
+
+if __name__ == "__main__":
+    unittest.main()
