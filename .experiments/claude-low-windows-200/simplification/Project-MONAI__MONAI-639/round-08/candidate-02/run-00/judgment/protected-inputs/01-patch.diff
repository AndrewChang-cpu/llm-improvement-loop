+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_slicing(self):
+        # slice spatial axes only, keep batch and channel axes whole so the result is non-empty
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x[:, :, 16:48, 8:40])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 16:48, 8:40])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 16:48, 8:40])
+
+    def test_keys_view_and_original_untouched(self):
+        # the image is the sole entry, so slicing never hits a string value
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 16:48, 8:40])(data)
+        self.assertIsInstance(result, dict)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 16:48, 8:40])
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_alias(self):
+        from monai.transforms import LambdaD, LambdaDict
+
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
