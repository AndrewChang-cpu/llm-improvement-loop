@@ -0,0 +1,71 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.segn)
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        # slice only the spatial axes, keeping batch and channel axes whole
+        data = {"img": self.imt, "seg": self.segn}
+        result = LambdaD(keys=["img", "seg"], func=lambda x: x[:, :, 10:20, 5:])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 10:20, 5:])
+        # original mapping must be left untouched
+        np.testing.assert_allclose(data["img"], self.imt)
+        np.testing.assert_allclose(data["seg"], self.segn)
+
+    def test_keys_view(self):
+        # the image is the sole entry of this mapping; its keys view names only the image,
+        # so the unlisted "seg" entry must be preserved unchanged
+        keys = {"img": self.imt}.keys()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=keys, func=lambda x: x[:, :, 10:20, 5:])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:])
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_iterable_callable_applied_whole(self):
+        # an iterable callable must be applied whole, once per listed key, never iterated
+        calls = []
+
+        class IterableCallable:
+            def __iter__(self):
+                raise AssertionError("callable must not be iterated")
+
+            def __call__(self, x):
+                calls.append(x)
+                return x[:, :, 10:20, 5:]
+
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=IterableCallable())(data)
+        self.assertEqual(len(calls), 2)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 10:20, 5:])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
