+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """Callable that must be applied whole; iterating it is an error."""
+
+    def __call__(self, x):
+        return x * 2
+
+    def __iter__(self):
+        raise AssertionError("callable must not be iterated")
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "label": "meta"}
+        transform = Lambdad(keys=["img"], func=lambda x: x)
+        result = transform(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        self.assertEqual(result["label"], "meta")
+
+    def test_slicing(self):
+        data = {"img": self.imt, "label": "meta"}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:30])
+        result = transform(data)
+        expected = self.imt[:, :, 10:20, 5:30]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+        # unlisted entries are preserved and the caller's mapping is untouched
+        self.assertEqual(result["label"], "meta")
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_keys_view_identity(self):
+        data = {"img": self.imt}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_keys_view_slicing(self):
+        data = {"img": self.imt}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:30])
+        result = transform(data)
+        expected = self.imt[:, :, 10:20, 5:30]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+
+    def test_iterable_callable_applied_once_per_key(self):
+        data = {"a": self.imt, "b": self.imt}
+        transform = Lambdad(keys=["a", "b"], func=_IterableCallable())
+        result = transform(data)
+        np.testing.assert_allclose(result["a"], self.imt * 2)
+        np.testing.assert_allclose(result["b"], self.imt * 2)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
