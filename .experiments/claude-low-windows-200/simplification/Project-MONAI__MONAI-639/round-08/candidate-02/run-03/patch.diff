@@ -291,3 +291,29 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input data, for quick one-off transforms
+    without writing a new transform class.
+
+    For example, slicing the spatial axes of a channel-first array while keeping
+    the batch and channel axes whole:
+
+    .. code-block:: python
+
+        from monai.transforms import Lambda
+        transform = Lambda(lambda x: x[:, :, 10:20, 5:30])
+        result = transform(np.zeros((1, 1, 64, 48)))  # shape (1, 1, 10, 25)
+
+    Args:
+        func: the callable applied to the input; must be callable.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
