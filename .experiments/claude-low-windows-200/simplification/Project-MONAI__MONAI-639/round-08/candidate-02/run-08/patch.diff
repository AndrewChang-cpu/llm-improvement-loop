     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input data, returning its result.
+
+    For example, slicing the spatial axes of a channel-first array of shape (1, 1, 128, 64):
+
+    .. code-block:: python
+
+        from monai.transforms import Lambda
+
+        transform = Lambda(lambda x: x[:, :, 10:50, 5:30])
+        out = transform(np.zeros((1, 1, 128, 64)))  # out.shape == (1, 1, 40, 25)
+
+    Args:
+        func: the callable to apply to the input data. It must be callable, otherwise an
+            ``AssertionError`` is raised at construction.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
