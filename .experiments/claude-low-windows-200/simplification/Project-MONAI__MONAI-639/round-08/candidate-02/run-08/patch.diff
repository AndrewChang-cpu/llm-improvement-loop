@@ -0,0 +1,85 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """Callable that is also iterable, used to check that Lambdad passes it whole."""
+
+    def __init__(self):
+        self.received = []
+
+    def __iter__(self):
+        raise AssertionError("callable must not be iterated")
+
+    def __call__(self, x):
+        self.received.append(x)
+        return x * 2
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        # the image is the sole entry, so a keys view can be used
+        data = {"img": self.imt}
+        identity = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = identity(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_identity_keeps_unlisted(self):
+        data = {"img": self.imt, "label": "name"}
+        identity = Lambdad(keys=["img"], func=lambda x: x)
+        result = identity(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        self.assertEqual(result["label"], "name")
+
+    def test_slicing_keys_view(self):
+        # the image is the sole entry, so a keys view can be used
+        data = {"img": self.imt}
+        slicer = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])
+        result = slicer(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        # the original mapping is untouched
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_slicing_keeps_unlisted(self):
+        data = {"img": self.imt, "label": "name"}
+        slicer = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])
+        result = slicer(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        self.assertEqual(result["label"], "name")
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_iterable_callable_applied_whole(self):
+        func = _IterableCallable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        # applied once per listed key, each time to the whole item
+        self.assertEqual(len(func.received), 2)
+        self.assertIs(func.received[0], data["img"])
+        self.assertIs(func.received[1], data["seg"])
+        np.testing.assert_allclose(result["img"], self.imt * 2)
+        np.testing.assert_allclose(result["seg"], self.segn * 2)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
