@@ -0,0 +1,91 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CallableIterable:
+    """A callable that is also iterable; it must be applied whole."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x + 1
+
+    def __iter__(self):
+        return iter((1, 2, 3))
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_slicing(self):
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 10:20, 5:30])
+
+    def test_returns_new_mapping_and_keeps_input(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x[:, :, 10:20, 5:30])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(data["img"], self.imt)
+        np.testing.assert_allclose(data["seg"], self.segn)
+
+    def test_unlisted_key_preserved(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+
+    def test_alias(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_callable_iterable_applied_whole(self):
+        func = _CallableIterable()
+        data = {"a": np.array([1.0, 2.0]), "b": np.array([3.0])}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        np.testing.assert_allclose(result["a"], np.array([2.0, 3.0]))
+        np.testing.assert_allclose(result["b"], np.array([4.0]))
+        self.assertEqual(func.calls, 2)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=5)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_missing_key_raises(self):
+        with self.assertRaises(KeyError):
+            Lambdad(keys=["missing"], func=lambda x: x)({"img": self.imt})
+
+
+if __name__ == "__main__":
+    unittest.main()
