+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableAddOne:
+    """A callable that is also iterable; it must be applied whole, never iterated."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x + 1
+
+    def __iter__(self):
+        return iter(())
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys="img", func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys="img", func=lambda x: x[:, :, 2:10, 4:20])(data)
+        expected = img[:, :, 2:10, 4:20]
+        self.assertEqual(result["img"].shape, (1, 1, 8, 16))
+        np.testing.assert_array_equal(result["img"], expected)
+
+    def test_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:10, 4:20])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 2:10, 4:20])
+
+    def test_unlisted_key_preserved_and_input_unchanged(self):
+        img = self.imt.copy()
+        data = {"img": self.imt, "meta": "text"}
+        result = Lambdad(keys=("img",), func=lambda x: x[:, :, 2:10, 4:20])(data)
+        self.assertIsNot(result, data)
+        self.assertEqual(result["meta"], "text")
+        np.testing.assert_array_equal(result["img"], img[:, :, 2:10, 4:20])
+        self.assertEqual(data["img"].shape, img.shape)
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_iterable_callable_applied_whole_per_key(self):
+        img = self.imt
+        func = _IterableAddOne()
+        data = {"a": img, "b": img}
+        result = Lambdad(keys=("a", "b"), func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_array_equal(result["a"], img + 1)
+        np.testing.assert_array_equal(result["b"], img + 1)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func=5)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=(), func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
