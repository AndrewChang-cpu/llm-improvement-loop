+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.allclose(self.imt, result["img"]))
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        original = self.imt.copy()
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])
+        result = transform(data)
+        expected = self.imt[:, :, 10:50, 5:30]
+        self.assertEqual(result["img"].shape, expected.shape)
+        self.assertTrue(np.allclose(result["img"], expected))
+        # the caller's mapping is not modified
+        self.assertTrue(np.allclose(data["img"], original))
+
+    def test_unlisted_key_preserved(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        original_seg = self.seg1.copy()
+        transform = Lambdad(keys=("img",), func=lambda x: x[:, :, 10:50, 5:30])
+        result = transform(data)
+        self.assertTrue(np.allclose(result["img"], self.imt[:, :, 10:50, 5:30]))
+        self.assertTrue(np.allclose(result["seg"], original_seg))
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=("img",), func="not callable")
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=(), func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
