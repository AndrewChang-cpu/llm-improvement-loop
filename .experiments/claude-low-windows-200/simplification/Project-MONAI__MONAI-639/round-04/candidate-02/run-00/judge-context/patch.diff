+class Lambdad(MapTransform):
+    """
+    Apply the same user-supplied callable to each of the specified keys of the data dictionary.
+    Each value is passed whole to the callable, and the callable's result replaces it in a copy of the dictionary.
+
+    Example:
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            transform = Lambdad(keys=["img"], func=lambda x: x[1:3])
+            result = transform({"img": np.array([0, 1, 2, 3])})  # result["img"] is array([1, 2])
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of each key. Its return value is used unchanged.
+            A list or tuple of callables is not supported.
+
+    Raises:
+        AssertionError: ``func`` must be callable.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
