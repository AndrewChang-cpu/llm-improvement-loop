+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CallableIterable:
+    """A callable that is also iterable; it must be applied whole, not element by element."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls.append(x)
+        return x + 1
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:50, 5:30])(data)
+        expected = self.imt[..., 10:50, 5:30]
+        self.assertEqual(result["img"].shape, (1, 1, 40, 25))
+        np.testing.assert_array_equal(result["img"], expected)
+
+    def test_keys_view_and_alias(self):
+        # the image is the sole entry, so the keys view covers only the image
+        data = {"img": self.imt}
+        result = LambdaD(keys=data.keys(), func=lambda x: x[..., 10:50, 5:30])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[..., 10:50, 5:30])
+
+    def test_unlisted_entry_preserved_and_input_unchanged(self):
+        label = "not an array"
+        data = {"img": self.imt, "label": label}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:50, 5:30])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[..., 10:50, 5:30])
+        self.assertEqual(result["label"], label)
+        self.assertIs(data["img"], self.imt)
+        self.assertEqual(data["img"].shape, (1, 1) + self.im_shape)
+
+    def test_callable_iterable_applied_whole(self):
+        func = _CallableIterable()
+        data = {"a": 0, "b": 10}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertEqual(result, {"a": 1, "b": 11})
+        self.assertEqual(func.calls, [0, 10])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
