+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class IterableCallable:
+    """Callable that is also iterable; it must still be applied whole."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x + 1
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+        self.assertIsNot(result, data)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[..., 2:10, 3:20])(data)
+        expected = img[..., 2:10, 3:20]
+        self.assertEqual(result["img"].shape, expected.shape)
+        self.assertTrue(np.allclose(expected, result["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 2:10, 3:20])(data)
+        self.assertTrue(np.allclose(img[..., 2:10, 3:20], result["img"]))
+        self.assertTrue(np.allclose(seg, result["seg"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_iterable_callable_applied_whole(self):
+        func = IterableCallable()
+        data = {"a": np.zeros(2), "b": np.ones(2)}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        self.assertTrue(np.allclose(result["a"], np.ones(2)))
+        self.assertTrue(np.allclose(result["b"], np.ones(2) * 2))
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=3)
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
