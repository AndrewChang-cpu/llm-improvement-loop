+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to each listed key. For example, slicing the spatial axes of each listed item:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambdad
+
+        crop = Lambdad(keys=["img"], func=lambda x: x[..., 2:10, 3:20])
+        out = crop({"img": np.zeros((1, 3, 16, 32))})  # out["img"].shape == (1, 3, 8, 17)
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to the value of each listed key; it is used whole for every key,
+                even if it is also iterable.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
