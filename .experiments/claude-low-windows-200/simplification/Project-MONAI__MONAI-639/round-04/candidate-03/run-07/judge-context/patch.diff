@@ -0,0 +1,80 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CallableIterable:
+    """A callable that is also iterable; it must be applied whole, not iterated."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[..., 10:40, 5:50]
+
+    def __iter__(self):
+        return iter(())
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        self.assertIs(result["img"], img)
+        self.assertIsNot(result, data)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:40, 5:50])(data)
+        np.testing.assert_allclose(result["img"], img[..., 10:40, 5:50])
+        # the caller's mapping is not modified
+        self.assertIs(data["img"], img)
+        self.assertEqual(data["img"].shape, img.shape)
+
+    def test_unlisted_key_preserved(self):
+        seg = self.segn
+        data = {"img": self.imt, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:40, 5:50])(data)
+        self.assertIs(result["seg"], seg)
+        np.testing.assert_allclose(result["img"], self.imt[..., 10:40, 5:50])
+
+    def test_callable_iterable_applied_whole(self):
+        func = _CallableIterable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], self.imt[..., 10:40, 5:50])
+        np.testing.assert_allclose(result["seg"], self.segn[..., 10:40, 5:50])
+
+    def test_alias(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
