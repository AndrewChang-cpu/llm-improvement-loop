+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        self.assertIs(result, img)
+
+    def test_slice(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x[..., 10:40, 5:50])(img)
+        np.testing.assert_allclose(result, img[..., 10:40, 5:50])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
