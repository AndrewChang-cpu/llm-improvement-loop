@@ -0,0 +1,78 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """A callable that is also iterable; it must be applied whole, not iterated."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[..., 1:5, 2:6]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        out = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(out, data)
+        np.testing.assert_allclose(out["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes, leaving the leading batch and channel axes whole
+        data = {"img": self.imt}
+        out = Lambdad(keys=data.keys(), func=lambda x: x[..., 1:5, 2:6])(data)
+        np.testing.assert_allclose(out["img"], self.imt[..., 1:5, 2:6])
+        self.assertEqual(out["img"].shape, (1, 1, 4, 4))
+        # the caller's mapping is not modified
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_unlisted_key_preserved(self):
+        data = {"img": self.imt, "label": self.segn}
+        out = Lambdad(keys=["img"], func=lambda x: x[..., 1:5, 2:6])(data)
+        np.testing.assert_allclose(out["img"], self.imt[..., 1:5, 2:6])
+        np.testing.assert_allclose(out["label"], self.segn)
+
+    def test_iterable_callable_applied_whole(self):
+        data = {"img": self.imt, "label": self.segn}
+        func = _IterableCallable()
+        out = Lambdad(keys=["img", "label"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(out["img"], self.imt[..., 1:5, 2:6])
+        np.testing.assert_allclose(out["label"], self.segn[..., 1:5, 2:6])
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=3)
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
