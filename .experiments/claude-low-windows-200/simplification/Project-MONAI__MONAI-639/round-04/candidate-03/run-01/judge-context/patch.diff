@@ -291,3 +291,27 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input and return what it returns.
+    The input is passed to the callable unchanged, and its return value is returned as is.
+
+    Example:
+
+        .. code-block:: python
+
+            lambd = Lambda(func=lambda x: x[:2])
+            lambd(np.array([1, 2, 3, 4]))  # array([1, 2])
+
+    Args:
+        func: callable applied to the input. A non-callable value raises ``AssertionError``.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
