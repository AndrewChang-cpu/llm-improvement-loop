+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(func=lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes, leaving the leading batch and channel axes whole
+        result = Lambda(func=lambda x: x[..., 1:5, 2:6])(self.imt)
+        np.testing.assert_allclose(result, self.imt[..., 1:5, 2:6])
+        self.assertEqual(result.shape, (1, 1, 4, 4))
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
