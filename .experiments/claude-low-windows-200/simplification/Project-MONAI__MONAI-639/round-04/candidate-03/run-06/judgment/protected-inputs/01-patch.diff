+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to each listed key of the input mapping.
+
+    Example:
+
+        .. code-block:: python
+
+            img = np.arange(16).reshape(1, 4, 4)
+            transform = Lambdad(keys=["img"], func=lambda x: x[:, 1:3, 1:3])
+            out = transform({"img": img})  # out["img"] is [[[5, 6], [9, 10]]]
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each listed item. It receives one item and its return value
+            replaces that item in the output mapping.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
