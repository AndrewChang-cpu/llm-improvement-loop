     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input and return what it returns.
+    The input is passed to the callable unchanged and the result is returned unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            img = np.arange(16).reshape(1, 4, 4)
+            # slice the spatial axes, leaving the leading axis whole
+            transform = Lambda(func=lambda x: x[:, 1:3, 1:3])
+            out = transform(img)  # out is [[[5, 6], [9, 10]]]
+
+    Args:
+        func: callable applied to the input. Its return value is returned by this transform.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
