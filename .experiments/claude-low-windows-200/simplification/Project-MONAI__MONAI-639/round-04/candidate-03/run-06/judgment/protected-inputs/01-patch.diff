+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], img)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "meta": "info"}
+        # explicit keys so the non-array entry is not passed to the callable
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:20, 5:15])(data)
+        # slice only the spatial axes, the leading batch and channel axes stay whole
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:15])
+        self.assertEqual(result["meta"], "info")
+        # the caller's mapping is not modified
+        self.assertIs(data["img"], img)
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+    def test_iterable_callable_applied_whole(self):
+        class CountingIterable:
+            def __init__(self):
+                self.calls = 0
+
+            def __call__(self, x):
+                self.calls += 1
+                return x
+
+            def __iter__(self):
+                return iter([1, 2, 3])
+
+        func = CountingIterable()
+        data = {"a": self.imt, "b": self.imt}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["a"], self.imt)
+        np.testing.assert_allclose(result["b"], self.imt)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=3)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
