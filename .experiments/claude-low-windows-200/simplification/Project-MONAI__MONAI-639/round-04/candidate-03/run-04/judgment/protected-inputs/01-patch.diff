+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity_callable(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x)
+        self.assertIs(transform(img), img)
+
+    def test_slicing_callable(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x[:, :, 10:20, 5:15])
+        result = transform(img)
+        expected = img[:, :, 10:20, 5:15]
+        self.assertEqual(result.shape, expected.shape)
+        self.assertTrue(np.allclose(result, expected))
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
