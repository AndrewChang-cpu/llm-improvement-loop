+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[..., 2:10, 3:20])(data)
+        np.testing.assert_array_equal(result["img"], img[..., 2:10, 3:20])
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys="img", func=lambda x: x[..., 2:10, 3:20])(data)
+        np.testing.assert_array_equal(result["img"], img[..., 2:10, 3:20])
+        np.testing.assert_array_equal(result["seg"], seg)
+        np.testing.assert_array_equal(data["img"], img)
+        np.testing.assert_array_equal(data["seg"], seg)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func=5)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=(), func=lambda x: x)
+
+    def test_iterable_callable_applied_whole(self):
+        class IterableCallable:
+            def __init__(self):
+                self.calls = 0
+
+            def __iter__(self):
+                return iter([])
+
+            def __call__(self, x):
+                self.calls += 1
+                return x[..., 2:10, 3:20]
+
+        func = IterableCallable()
+        img = self.imt
+        data = {"a": img, "b": img}
+        result = Lambdad(keys=("a", "b"), func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_array_equal(result["a"], img[..., 2:10, 3:20])
+        np.testing.assert_array_equal(result["b"], img[..., 2:10, 3:20])
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
