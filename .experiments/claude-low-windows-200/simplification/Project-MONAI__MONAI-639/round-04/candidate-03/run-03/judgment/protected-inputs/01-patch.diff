+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.utility.array.Lambda`.
+    Applies the same callable to each listed key of the data mapping.
+
+    Example:
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            transform = Lambdad(keys="img", func=lambda x: x[:2])
+            out = transform({"img": np.array([1, 2, 3]), "seg": np.array([4, 5, 6])})
+            print(out["img"])  # [1 2]
+            print(out["seg"])  # [4 5 6]
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of each listed key.
+            It is used whole for every key; lists or tuples of callables are not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
