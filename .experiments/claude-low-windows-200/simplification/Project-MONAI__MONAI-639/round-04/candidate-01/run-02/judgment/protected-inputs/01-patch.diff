+class Lambdad(MapTransform):
+    """
+    Apply the same caller-supplied callable to each of the specified items in the data dictionary.
+    The callable receives the value of each key separately.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(24).reshape(1, 2, 3, 4), "label": np.zeros((1, 1))}
+            transform = Lambdad(keys=["img"], func=lambda x: x[..., 1:3])
+            out = transform(data)  # out["img"] has shape (1, 2, 3, 2); out["label"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of each key. It receives the whole value, and the value it
+            returns is stored under that key in the output.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
