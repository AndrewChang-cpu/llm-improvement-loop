+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertIsNot(result, data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img, "label": self.segn}
+        transform = Lambdad(keys=["img"], func=lambda x: x[..., 10:50, 5:40])
+        result = transform(data)
+        expected = img[..., 10:50, 5:40]
+        self.assertGreater(result["img"].size, 0)
+        self.assertEqual(result["img"].shape, expected.shape)
+        self.assertTrue(np.allclose(result["img"], expected))
+        # unlisted entry is preserved unchanged
+        self.assertTrue(np.array_equal(result["label"], self.segn))
+        # caller's mapping is not modified
+        self.assertTrue(np.allclose(data["img"], img))
+        self.assertIs(data["label"], self.segn)
+
+
+if __name__ == "__main__":
+    unittest.main()
