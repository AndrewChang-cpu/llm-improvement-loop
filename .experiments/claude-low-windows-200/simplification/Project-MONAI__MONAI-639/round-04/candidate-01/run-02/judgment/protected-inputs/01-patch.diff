         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a caller-supplied callable to the input value and return its result unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(24).reshape(1, 2, 3, 4)
+            transform = Lambda(func=lambda x: x[..., 1:3])
+            out = transform(img)  # out has shape (1, 2, 3, 2)
+
+    Args:
+        func: callable applied to the input. It receives the whole input, and the value it returns is returned as is.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
