@@ -0,0 +1,70 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class CountingIterableCallable:
+    """A callable that is also iterable; it must be applied whole and counted once per call."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+    def __iter__(self):
+        return iter([1, 2])
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_keys_view(self):
+        # the image is the sole entry, so a keys view names only the image
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:20, 5:15])
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.segn}
+        # an explicit keys collection naming only the image leaves the other entry unchanged
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        expected = self.imt[:, :, 10:20, 5:15]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(data["img"], self.imt)
+
+    def test_iterable_callable_applied_whole(self):
+        func = CountingIterableCallable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
