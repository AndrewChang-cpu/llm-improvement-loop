+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same callable is applied
+    to the value of every listed key.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(12).reshape(1, 3, 4)}
+            result = Lambdad(keys="img", func=lambda x: x[:, 1:, :2])(data)
+            # result["img"] has shape (1, 2, 2) and equals [[[4, 5], [8, 9]]]
+            # data["img"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of each listed key. It is used whole for every key;
+            a list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambda_transform = Lambda(func=func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambda_transform(d[key])
+        return d
+
+
