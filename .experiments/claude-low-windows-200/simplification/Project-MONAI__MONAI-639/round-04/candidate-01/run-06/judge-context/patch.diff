     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(12).reshape(1, 3, 4)
+            result = Lambda(func=lambda x: x[:, 1:, :2])(img)
+            # result has shape (1, 2, 2) and equals [[[4, 5], [8, 9]]]
+
+    Args:
+        func: callable applied to the input value. It is stored as given and used whole.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
