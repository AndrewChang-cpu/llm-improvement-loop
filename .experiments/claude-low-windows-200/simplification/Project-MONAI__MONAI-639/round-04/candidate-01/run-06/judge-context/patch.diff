@@ -0,0 +1,84 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """A callable that is also iterable; it records every call it receives."""
+
+    def __init__(self):
+        self.calls = []
+
+    def __call__(self, x):
+        self.calls.append(x)
+        return x
+
+    def __iter__(self):
+        return iter(())
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes so the batch and channel axes stay whole
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:-2, 2:-2])(data)
+        expected = self.imt[:, :, 2:-2, 2:-2]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+
+    def test_keys_view(self):
+        # the image is the sole entry, so the keys view lists only the image key
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:-2, 2:-2])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 2:-2, 2:-2])
+
+    def test_unlisted_key_preserved_and_input_untouched(self):
+        original = self.imt.copy()
+        other = "label"
+        data = {"img": self.imt, other: self.segn}
+        result = Lambdad(keys="img", func=lambda x: x[:, :, 2:-2, 2:-2])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 2:-2, 2:-2])
+        self.assertIs(result[other], self.segn)
+        np.testing.assert_array_equal(data["img"], original)
+
+    def test_iterable_callable_applied_whole_per_key(self):
+        func = _IterableCallable()
+        data = {"a": self.imt, "b": self.segn}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertEqual(len(func.calls), 2)
+        self.assertIs(func.calls[0], self.imt)
+        self.assertIs(func.calls[1], self.segn)
+        np.testing.assert_array_equal(result["a"], self.imt)
+        np.testing.assert_array_equal(result["b"], self.segn)
+
+    def test_non_callable_func_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys_raise(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
