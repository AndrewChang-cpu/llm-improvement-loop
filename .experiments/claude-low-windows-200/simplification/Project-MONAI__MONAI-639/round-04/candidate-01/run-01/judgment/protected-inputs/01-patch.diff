+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.utility.array.Lambda`.
+    Apply the same callable to the value of each listed key. The input mapping is not modified;
+    a shallow copy with the transformed values is returned.
+
+    Example:
+        .. code-block:: python
+
+            data = {"img": np.array([[0, 1, 2, 3]])}
+            transform = Lambdad(keys="img", func=lambda x: x[:, 1:3])
+            transform(data)["img"]  # array([[1, 2]])
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of each listed key; must be callable, else AssertionError is raised.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
