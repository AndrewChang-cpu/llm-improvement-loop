+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CountingIterableCallable:
+    """A callable that is also iterable; it must be applied whole, once per listed key."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[:, :, 10:20, 5:30]
+
+    def __iter__(self):
+        return iter([])
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes so the batch and channel axes stay whole and the result is non-empty
+        expected = self.imt[:, :, 10:20, 5:30]
+        self.assertGreater(expected.size, 0)
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_array_equal(result["img"], expected)
+
+    def test_keys_view(self):
+        # the sole entry is the image, so passing the keys view is safe here
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:20, 5:30])
+
+    def test_unlisted_key_preserved_and_input_unmodified(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=("img",), func=lambda x: x[:, :, 10:20, 5:30])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:20, 5:30])
+        np.testing.assert_array_equal(result["seg"], self.seg1)
+        # the caller's mapping is not modified
+        np.testing.assert_array_equal(data["img"], self.imt)
+        np.testing.assert_array_equal(data["seg"], self.seg1)
+
+    def test_iterable_callable_applied_whole(self):
+        func = _CountingIterableCallable()
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=("img", "seg"), func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:20, 5:30])
+        np.testing.assert_array_equal(result["seg"], self.seg1[:, :, 10:20, 5:30])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=self.imt)
+
+
+if __name__ == "__main__":
+    unittest.main()
