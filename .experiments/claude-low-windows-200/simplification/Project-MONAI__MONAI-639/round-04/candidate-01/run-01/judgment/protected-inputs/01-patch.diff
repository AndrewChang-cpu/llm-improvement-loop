+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(func=lambda x: x)(self.imt)
+        np.testing.assert_array_equal(result, self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes so the batch and channel axes stay whole and the result is non-empty
+        expected = self.imt[:, :, 10:20, 5:30]
+        self.assertGreater(expected.size, 0)
+        result = Lambda(func=lambda x: x[:, :, 10:20, 5:30])(self.imt)
+        np.testing.assert_array_equal(result, expected)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=self.imt)
+
+
+if __name__ == "__main__":
+    unittest.main()
