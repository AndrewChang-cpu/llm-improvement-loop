@@ -291,3 +291,27 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda function to the input data.
+
+    Example:
+
+        >>> lambd = Lambda(lambda x: x[:, 1:4, ::-1])
+        >>> out = lambd(np.zeros((1, 5, 6)))
+        >>> out.shape
+        (1, 3, 6)
+
+    Args:
+        func: user-defined callable applied to the input data. It must be callable,
+            and it receives the whole input and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
