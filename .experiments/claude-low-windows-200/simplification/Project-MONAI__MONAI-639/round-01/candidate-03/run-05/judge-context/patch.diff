+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], img)
+        self.assertIsNot(result, data)
+
+    def test_slicing_keys_view(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:100, ::-1])
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:100, ::-1])
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        meta = "metadata"
+        data = {"img": img, "meta": meta}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:100, ::-1])
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:100, ::-1])
+        self.assertEqual(result["meta"], meta)
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
