+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        data = {"img": self.imt}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing_keys_view(self):
+        data = {"img": self.imt}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[..., 10:100, ::-2])
+        result = lambd(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 10:100, ::-2])
+
+    def test_unlisted_key_preserved(self):
+        data = {"img": self.imt, "meta": "info"}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[..., 10:100, ::-2])
+        result = lambd(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 10:100, ::-2])
+        self.assertEqual(result["meta"], "info")
+        self.assertIs(data["img"], self.imt)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
