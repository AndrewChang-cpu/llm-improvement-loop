+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slice_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:100, ::-2])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:100, ::-2])
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        data = {"img": img, "meta": "info"}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:100, ::-2])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:100, ::-2])
+        self.assertEqual(result["meta"], "info")
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
