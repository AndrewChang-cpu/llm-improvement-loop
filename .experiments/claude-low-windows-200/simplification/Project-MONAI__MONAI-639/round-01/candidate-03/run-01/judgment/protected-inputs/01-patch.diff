+class Lambdad(MapTransform):
+    """
+    Apply the same user-supplied callable to each specified key of the data mapping.
+    The callable is applied to each listed value as a whole, and the input mapping is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(12).reshape(1, 3, 4), "label": 1}
+            out = Lambdad(keys="img", func=lambda x: x[:, 1:, ::2])(data)
+            # out["img"] has shape (1, 2, 2); out["label"] is unchanged
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: a callable applied to every listed item, e.g. ``lambda x: x[:, 1:, ::2]``.
+                A single callable is applied to each key; a list or tuple of callables is not supported.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
