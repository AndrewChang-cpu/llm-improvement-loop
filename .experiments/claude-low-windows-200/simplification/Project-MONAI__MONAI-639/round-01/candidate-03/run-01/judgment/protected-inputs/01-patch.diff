+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The callable receives the whole input and its return value is passed through unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(12).reshape(1, 3, 4)
+            out = Lambda(func=lambda x: x[:, 1:, ::2])(img)
+            # out has shape (1, 2, 2)
+    """
+
+    def __init__(self, func: Callable):
+        """
+        Args:
+            func: a callable applied to the input value, e.g. ``lambda x: x[:, 1:, ::2]``.
+                It receives the input and returns the transformed value.
+        """
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
