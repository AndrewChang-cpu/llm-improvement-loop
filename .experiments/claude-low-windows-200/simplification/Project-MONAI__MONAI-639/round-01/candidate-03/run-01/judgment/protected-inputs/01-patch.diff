+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        self.assertTrue(result is img)
+
+    def test_slice(self):
+        img = self.imt
+        func = lambda x: x[:, :, 1:, ::-2]  # noqa: E731
+        result = Lambda(func=func)(img)
+        np.testing.assert_allclose(result, img[:, :, 1:, ::-2])
+
+
+if __name__ == "__main__":
+    unittest.main()
