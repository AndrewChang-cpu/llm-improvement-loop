@@ -413,6 +414,33 @@ class ConcatItemsd(MapTransform):
         return d
 
 
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to each of the configured keys.
+
+    Example:
+        >>> lambd = Lambdad(keys=["img"], func=lambda x: x[..., 1:-1])
+        >>> out = lambd({"img": np.zeros((1, 1, 8, 8))})  # out["img"] has shape (1, 1, 8, 6)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable applied to the value of every configured key. It receives the value
+            and returns the transformed value.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
