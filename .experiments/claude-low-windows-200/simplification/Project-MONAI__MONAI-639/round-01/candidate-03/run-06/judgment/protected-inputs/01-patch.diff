+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[..., 10:-10, ::-2])
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], img[..., 10:-10, ::-2])
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        data = {"img": img, "meta": "info"}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[..., 10:-10, ::-2])
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], img[..., 10:-10, ::-2])
+        self.assertEqual(result["meta"], "info")
+
+
+if __name__ == "__main__":
+    unittest.main()
