+import unittest
+
+import numpy as np
+from parameterized import parameterized
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+TEST_CASES = [
+    ("identity", lambda x: x),
+    ("slicing", lambda x: x[..., 1:, ::-2]),
+]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    @parameterized.expand(TEST_CASES)
+    def test_correct_results(self, _, func):
+        lambd = Lambda(func)
+        expected = func(self.imt)
+        result = lambd(self.imt)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
