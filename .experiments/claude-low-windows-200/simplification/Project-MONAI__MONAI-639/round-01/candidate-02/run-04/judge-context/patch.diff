+
+import unittest
+
+import numpy as np
+from parameterized import parameterized
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+TEST_CASES = [
+    ("identity", lambda x: x),
+    ("slicing", lambda x: x[..., 1:, ::-2]),
+]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    @parameterized.expand(TEST_CASES)
+    def test_correct_results(self, _, func):
+        # keys view of a mapping whose only entry is the image
+        keys = {"img": self.imt}.keys()
+        lambd = Lambdad(keys, func)
+        result = lambd({"img": self.imt})
+        self.assertTrue(np.allclose(func(self.imt), result["img"]))
+
+    @parameterized.expand(TEST_CASES)
+    def test_unlisted_entry_preserved(self, _, func):
+        # the extra entry is outside the configured keys and must be left untouched
+        lambd = Lambdad(keys=["img"], func=func)
+        data = {"img": self.imt, "meta": "unchanged"}
+        result = lambd(data)
+        self.assertTrue(np.allclose(func(self.imt), result["img"]))
+        self.assertEqual(result["meta"], "unchanged")
+        self.assertTrue(np.array_equal(self.imt, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
