+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice(x):
+    # slice spatial axes only; leading batch and channel axes are kept whole
+    return x[..., 10:, ::-1]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(_identity)(self.imt)
+        self.assertTrue((result == self.imt).all())
+
+    def test_slice(self):
+        result = Lambda(_slice)(self.imt)
+        expected = self.imt[..., 10:, ::-1]
+        self.assertGreater(result.size, 0)
+        self.assertTrue((result == expected).all())
+
+
+if __name__ == "__main__":
+    unittest.main()
