@@ -291,3 +291,23 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined callable to the input value. The callable receives the whole input
+    and its return value is returned unchanged.
+
+    For example, a callable such as ``lambda x: x[..., 10:]`` returns the slice that it computes.
+
+    Args:
+        func: a callable applied to the input value in ``__call__``. It must be callable
+            (checked with ``callable``); a non-callable value raises ``AssertionError``.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
