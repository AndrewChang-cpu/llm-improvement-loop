+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice(x):
+    # slice spatial axes only; leading batch and channel axes are kept whole
+    return x[..., 10:, ::-1]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=_identity)(data)
+        self.assertTrue((result["img"] == self.imt).all())
+
+    def test_slice(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=_slice)(data)
+        expected = self.imt[..., 10:, ::-1]
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue((result["img"] == expected).all())
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "meta": "info"}
+        result = Lambdad(keys=["img"], func=_slice)(data)
+        expected = self.imt[..., 10:, ::-1]
+        self.assertTrue((result["img"] == expected).all())
+        self.assertEqual(result["meta"], "info")
+        self.assertIs(data["img"], self.imt)
+        self.assertEqual(data["meta"], "info")
+
+
+if __name__ == "__main__":
+    unittest.main()
