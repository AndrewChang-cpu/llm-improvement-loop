+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same callable is applied
+    to the value of each listed key.
+
+    For example, with ``keys="img"`` and ``func=lambda x: x[..., ::-1]``, the value stored under
+    ``"img"`` in the returned dictionary is the input array reversed along its last axis.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: a callable applied to the value of every listed key. It is passed whole to
+                :py:class:`monai.transforms.Lambda` for each key; a list or tuple of callables
+                is not supported.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
