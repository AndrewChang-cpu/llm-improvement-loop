+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Apply the same callable to each listed key of the data dictionary.
+    The callable receives each value whole, and the result replaces that value in a shallow copy of the dictionary.
+
+    Example:
+        .. code-block:: python
+
+            transform = Lambdad(keys="img", func=lambda x: x[:, 10:20])
+            out = transform({"img": np.zeros((1, 64, 32)), "label": "abc"})
+            # out["img"].shape is (1, 10, 32); out["label"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable applied to every listed key. A list or tuple of callables is not supported.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
