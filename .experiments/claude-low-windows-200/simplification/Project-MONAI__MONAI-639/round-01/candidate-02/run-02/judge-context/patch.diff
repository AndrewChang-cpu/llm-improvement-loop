+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_lambdad(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        identity = Lambdad(keys=data.keys(), func=lambda x: x)
+        self.assertTrue(np.allclose(img, identity(data)["img"]))
+
+    def test_slicing_lambdad(self):
+        img = self.imt
+        expected = img[:, :, 10:100, ::-2]
+        data = dict()
+        data["img"] = img
+        slicer = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:100, ::-2])
+        result = slicer(data)["img"]
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(expected, result))
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        data = {"img": img, "meta": "info"}
+        slicer = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:100, ::-2])
+        result = slicer(data)
+        self.assertEqual(result["meta"], "info")
+        self.assertTrue(np.allclose(img[:, :, 10:100, ::-2], result["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
