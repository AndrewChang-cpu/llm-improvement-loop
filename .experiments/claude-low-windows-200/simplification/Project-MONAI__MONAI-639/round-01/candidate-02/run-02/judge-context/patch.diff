+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity_lambda(self):
+        img = self.imt
+        identity = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, identity(img)))
+
+    def test_slicing_lambda(self):
+        img = self.imt
+        expected = img[:, :, 10:100, ::-2]
+        slicer = Lambda(func=lambda x: x[:, :, 10:100, ::-2])
+        result = slicer(img)
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
