+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to each of the listed keys.
+    The input mapping is shallow-copied and is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:, ::-2])
+            out = transform({"img": np.zeros((1, 1, 8, 8)), "label": 1})
+            # out["img"].shape == (1, 1, 6, 4); out["label"] == 1
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of every listed key. A list or tuple of
+            callables is not supported; an iterable callable is applied whole.
+            It must be callable, otherwise an AssertionError is raised.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
