         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The input is passed to the callable unchanged, and the result is returned unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            transform = Lambda(lambda x: x[:, :, 2:, ::-2])
+            out = transform(np.zeros((1, 1, 8, 8)))  # out.shape == (1, 1, 6, 4)
+
+    Args:
+        func: callable applied to the input value, e.g. ``lambda x: x[:, :, 2:, ::-2]``.
+            It must be callable, otherwise an AssertionError is raised.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
