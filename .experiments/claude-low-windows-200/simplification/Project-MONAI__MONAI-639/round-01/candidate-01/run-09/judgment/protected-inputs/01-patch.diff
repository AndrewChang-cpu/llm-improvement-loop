+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice_spatial(x):
+    # slice only the spatial axes, keeping the leading batch and channel axes whole
+    return x[:, :, 2:-2, ::-2]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(data.keys(), func=_identity)(data)
+        np.testing.assert_equal(result["img"], self.imt)
+
+    def test_slice_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(data.keys(), func=_slice_spatial)(data)
+        np.testing.assert_equal(result["img"], self.imt[:, :, 2:-2, ::-2])
+
+    def test_unlisted_key_preserved(self):
+        meta = "metadata"
+        data = {"img": self.imt, "meta": meta}
+        result = Lambdad(keys=["img"], func=_slice_spatial)(data)
+        np.testing.assert_equal(result["img"], self.imt[:, :, 2:-2, ::-2])
+        self.assertEqual(result["meta"], meta)
+        # the caller's mapping is not modified
+        self.assertIs(data["img"], self.imt)
+        self.assertEqual(data["meta"], meta)
+
+
+if __name__ == "__main__":
+    unittest.main()
