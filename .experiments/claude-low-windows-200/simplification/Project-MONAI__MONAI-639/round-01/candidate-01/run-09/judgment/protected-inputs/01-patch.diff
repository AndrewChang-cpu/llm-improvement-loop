+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice_spatial(x):
+    # slice only the spatial axes, keeping the leading batch and channel axes whole
+    return x[:, :, 2:-2, ::-2]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(_identity)(self.imt)
+        np.testing.assert_equal(result, self.imt)
+
+    def test_slice(self):
+        result = Lambda(_slice_spatial)(self.imt)
+        np.testing.assert_equal(result, self.imt[:, :, 2:-2, ::-2])
+
+
+if __name__ == "__main__":
+    unittest.main()
