+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        lambdad = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambdad(data)
+        self.assertTrue(np.allclose(self.imt, result["img"]))
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        lambdad = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, ::-2])
+        result = lambdad(data)
+        expected = self.imt[:, :, 10:50, ::-2]
+        self.assertTrue(np.allclose(expected, result["img"]))
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "meta": "unchanged"}
+        lambdad = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, ::-2])
+        result = lambdad(data)
+        self.assertTrue(np.allclose(self.imt[:, :, 10:50, ::-2], result["img"]))
+        self.assertEqual(result["meta"], "unchanged")
+        self.assertTrue(np.allclose(self.imt, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
