@@ -291,3 +291,27 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The callable receives the whole input and its return value is passed through unchanged.
+
+    Example::
+
+        >>> transform = Lambda(func=lambda x: x[:, 1:3])
+        >>> transform(np.zeros((2, 4, 4))).shape
+        (2, 2, 4)
+
+    Args:
+        func: callable applied to the input value. It must be callable; a non-callable value
+            raises ``AssertionError`` at construction.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
