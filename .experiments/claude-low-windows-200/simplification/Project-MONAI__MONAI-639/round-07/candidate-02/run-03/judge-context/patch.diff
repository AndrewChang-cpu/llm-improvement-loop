+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing_keys_view(self):
+        # the image is the sole entry, so a keys view can be used as keys
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:40])
+        # the caller's mapping is left unchanged
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_slicing_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:40])
+        np.testing.assert_allclose(result["seg"], self.segn)
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
