@@ -0,0 +1,81 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class CountingIterableCallable:
+    """Callable that is also iterable, used to check the callable is applied whole."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[:, :, 2:10, 3:20]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_slicing(self):
+        # slice spatial axes only, keeping batch and channel axes whole
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:10, 3:20])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 2:10, 3:20])
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "seg": self.segn}
+        Lambdad(keys=["img"], func=lambda x: x[:, :, 2:10, 3:20])(data)
+        # original mapping is not modified
+        np.testing.assert_allclose(data["img"], self.imt)
+        np.testing.assert_allclose(data["seg"], self.segn)
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:10, 3:20])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_keys_view(self):
+        # a keys view is used only when the image is the sole entry
+        data = {"img": self.imt}
+        result = Lambdad(keys={"img": 0}.keys(), func=lambda x: x[:, :, 2:10, 3:20])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 2:10, 3:20])
+
+    def test_iterable_callable_applied_whole(self):
+        func = CountingIterableCallable()
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 2:10, 3:20])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 2:10, 3:20])
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
