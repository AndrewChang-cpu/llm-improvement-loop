@@ -0,0 +1,74 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class IterableCallable:
+    """A callable that is also iterable, used to check that it is applied whole."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x * 2
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        # a keys view is used here because the image is the sole entry
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing_keys_view(self):
+        # a keys view is used here because the image is the sole entry
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])(data)
+        # listed key is transformed
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, 5:30])
+        # unlisted key is unchanged
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        # the caller's mapping is untouched
+        self.assertIs(data["img"], self.imt)
+        self.assertIs(data["seg"], self.seg1)
+        self.assertIsNot(result, data)
+
+    def test_iterable_callable_applied_whole(self):
+        func = IterableCallable()
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        # applied once per listed key, to the whole item
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], self.imt * 2)
+        np.testing.assert_allclose(result["seg"], self.seg1 * 2)
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
