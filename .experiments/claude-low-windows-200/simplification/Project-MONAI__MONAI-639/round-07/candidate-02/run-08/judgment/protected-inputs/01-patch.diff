@@ -291,3 +291,22 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda function or callable to the input data.
+    The output is the result of ``func`` applied to the input, for example:
+    ``Lambda(lambda x: x[:, 1:3])(np.array([[0, 1, 2, 3], [4, 5, 6, 7]]))`` returns ``array([[1, 2], [5, 6]])``.
+
+    Args:
+        func: the callable (for example, a lambda function) to apply to the input data.
+            It must be callable; otherwise an ``AssertionError`` is raised at construction.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
