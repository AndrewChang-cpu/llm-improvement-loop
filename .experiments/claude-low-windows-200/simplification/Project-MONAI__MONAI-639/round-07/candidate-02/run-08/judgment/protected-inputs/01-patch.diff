+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to every item listed in ``keys``, for example:
+    ``Lambdad(keys="img", func=lambda x: x[:, 1:3])({"img": np.array([[0, 1, 2, 3], [4, 5, 6, 7]])})["img"]``
+    returns ``array([[1, 2], [5, 6]])``.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: the callable (for example, a lambda function) applied to each item listed in ``keys``.
+                The callable is applied whole to each item, and must be callable; otherwise an
+                ``AssertionError`` is raised at construction.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
