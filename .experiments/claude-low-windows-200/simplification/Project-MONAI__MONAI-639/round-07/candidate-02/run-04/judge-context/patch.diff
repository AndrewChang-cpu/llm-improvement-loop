+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CountingIterableCallable:
+    """Callable that is also iterable, used to check it is passed whole and not split per key."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x[:, :, 10:20, 5:30]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], img)
+        self.assertIsNot(result, data)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:30])
+
+    def test_unlisted_entries_preserved(self):
+        img = self.imt
+        seg = self.seg1
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:30])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(result["seg"], seg)
+        np.testing.assert_allclose(data["img"], img)
+        np.testing.assert_allclose(data["seg"], seg)
+
+    def test_iterable_callable_applied_whole_per_key(self):
+        img = self.imt
+        seg = self.seg1
+        func = _CountingIterableCallable()
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(result["seg"], seg[:, :, 10:20, 5:30])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
