     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input data.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(6).reshape(1, 2, 3)
+            transform = Lambda(func=lambda x: x[:, :, 1:])
+            out = transform(img)  # shape (1, 2, 2), values [[[1, 2], [4, 5]]]
+
+    Args:
+        func: callable to apply to the input. Must be callable, otherwise an
+            AssertionError is raised at construction.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
