+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(6).reshape(1, 2, 3)}
+            transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:])
+            out = transform(data)  # out["img"] has shape (1, 2, 2), values [[[1, 2], [4, 5]]]
+            # data["img"] is unchanged
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to each listed item, passed whole to
+                :py:class:`monai.transforms.Lambda`. Must be callable, otherwise an
+                AssertionError is raised at construction.
+
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
