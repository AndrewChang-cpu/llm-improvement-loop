@@ -0,0 +1,79 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class CountingCallable:
+    """Iterable callable that counts how many times it is called."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes, keeping batch and channel axes whole
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:15])
+
+    def test_keys_view(self):
+        # the image is the sole entry, so a keys view can be used safely
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:15])
+
+    def test_unlisted_entries_preserved(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:15])
+        np.testing.assert_allclose(result["seg"], self.segn)
+        # the caller's mapping and its image are left untouched
+        np.testing.assert_allclose(data["img"], self.imt)
+        self.assertIsNot(result, data)
+
+    def test_iterable_callable_applied_whole(self):
+        func = CountingCallable()
+        data = {"a": self.imt, "b": self.segn}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["a"], self.imt)
+        np.testing.assert_allclose(result["b"], self.segn)
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
