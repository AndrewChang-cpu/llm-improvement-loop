+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], img)
+        self.assertIsNot(result, data)
+
+    def test_slicing_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:50, 5:40])
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_unlisted_entries_preserved(self):
+        img = self.imt
+        seg = self.seg1
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:50, 5:40])
+        np.testing.assert_allclose(result["seg"], seg)
+        np.testing.assert_allclose(data["img"], img)
+        np.testing.assert_allclose(data["seg"], seg)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func=None)
+
+
+if __name__ == "__main__":
+    unittest.main()
