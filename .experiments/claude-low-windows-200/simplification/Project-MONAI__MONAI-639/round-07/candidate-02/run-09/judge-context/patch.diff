+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The callable is applied
+    to the value of each listed key, and the results are stored under the same keys.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.array([[1, 2, 3], [4, 5, 6]]), "label": np.array([0, 1])}
+            result = Lambdad(keys="img", func=lambda x: x[:, 1:])(data)
+            # result["img"] is [[2, 3], [5, 6]]; result["label"] is unchanged [0, 1]
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: the callable applied to the value of each key. It is applied to the whole value,
+                not split per key, so lists or tuples of callables are not supported.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
