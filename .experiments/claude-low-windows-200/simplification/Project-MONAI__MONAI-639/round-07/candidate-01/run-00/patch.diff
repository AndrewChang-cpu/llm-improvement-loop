+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:50, 5:40])
+        # the caller's mapping is left untouched
+        np.testing.assert_array_equal(data["img"], self.imt)
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:50, 5:40])
+        self.assertIs(result["seg"], self.segn)
+
+    def test_iterable_callable_applied_whole(self):
+        class Recorder:
+            def __init__(self):
+                self.calls = []
+
+            def __call__(self, x):
+                self.calls.append(x)
+                return x
+
+            def __iter__(self):
+                return iter(())
+
+        recorder = Recorder()
+        data = {"img": self.imt, "seg": self.segn}
+        Lambdad(keys=["img", "seg"], func=recorder)(data)
+        self.assertEqual(len(recorder.calls), 2)
+        self.assertIs(recorder.calls[0], self.imt)
+        self.assertIs(recorder.calls[1], self.segn)
+
+
+if __name__ == "__main__":
+    unittest.main()
