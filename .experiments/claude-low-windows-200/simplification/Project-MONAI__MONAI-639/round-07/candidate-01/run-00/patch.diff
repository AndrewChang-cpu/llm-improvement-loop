+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same callable is applied to
+    every listed key, and a new dictionary is returned; the input mapping is not modified.
+
+    Example:
+        >>> lambd = Lambdad(keys=["img"], func=lambda x: x[:2])
+        >>> out = lambd({"img": np.array([1, 2, 3]), "label": 0})
+        >>> out["img"]
+        array([1, 2])
+        >>> out["label"]
+        0
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each listed item as a whole. Lists or tuples of callables are not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
