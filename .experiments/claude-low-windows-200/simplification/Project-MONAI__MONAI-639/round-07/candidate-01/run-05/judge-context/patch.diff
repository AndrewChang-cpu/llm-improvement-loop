+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(lambda x: x)(img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_slice(self):
+        img = self.imt
+        result = Lambda(lambda x: x[:, :, 1:60, 2:30])(img)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_array_equal(result, img[:, :, 1:60, 2:30])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda("not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
