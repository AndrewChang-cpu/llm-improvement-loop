+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:60, 2:30])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], img[:, :, 1:60, 2:30])
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_unlisted_entries_preserved(self):
+        img = self.imt
+        seg = self.seg1
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:60, 2:30])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 1:60, 2:30])
+        np.testing.assert_array_equal(result["seg"], seg)
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_iterable_callable_applied_whole_per_key(self):
+        calls = []
+
+        class Recorder:
+            def __iter__(self):
+                return iter([1, 2, 3])
+
+            def __call__(self, x):
+                calls.append(x)
+                return x
+
+        img = self.imt
+        seg = self.seg1
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img", "seg"], func=Recorder())(data)
+        self.assertEqual(len(calls), 2)
+        self.assertIs(calls[0], img)
+        self.assertIs(calls[1], seg)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=[lambda x: x])
+
+
+if __name__ == "__main__":
+    unittest.main()
