+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        self.assertIsNot(result, data)
+        self.assertTrue(result["img"] is img)
+
+    def test_slice_preserves_unlisted(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])
+        result = lambd(data)
+        self.assertIsNot(result, data)
+        self.assertEqual(result["img"].shape, (1, 1, 10, 10))
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue((result["img"] == img[:, :, 10:20, 5:15]).all())
+        self.assertTrue(result["seg"] is seg)
+        self.assertEqual(data["img"].shape, img.shape)
+        self.assertTrue(data["img"] is img)
+
+
+if __name__ == "__main__":
+    unittest.main()
