+# limitations under the License.
+
+import unittest
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        result = lambd(img)
+        self.assertTrue(result is img)
+
+    def test_slice(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x[:, :, 10:20, 5:15])
+        result = lambd(img)
+        self.assertGreater(result.size, 0)
+        self.assertEqual(result.shape, (1, 1, 10, 10))
+        self.assertTrue((result == img[:, :, 10:20, 5:15]).all())
+
+
+if __name__ == "__main__":
+    unittest.main()
