+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_lambda_identity(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, transform(img)))
+
+    def test_lambda_slice(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x[:, :, 10:20, 5:15])
+        out = transform(img)
+        self.assertGreater(out.size, 0)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], out))
+
+    def test_lambda_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
