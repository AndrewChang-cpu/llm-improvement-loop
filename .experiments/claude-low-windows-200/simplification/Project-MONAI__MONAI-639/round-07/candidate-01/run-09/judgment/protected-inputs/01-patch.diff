+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _CountingIterableCallable:
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter((1, 2))
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_lambdad_identity(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        out = transform(data)
+        self.assertTrue(np.allclose(img, out["img"]))
+
+    def test_lambdad_slice(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])
+        out = transform(data)
+        self.assertGreater(out["img"].size, 0)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], out["img"]))
+
+    def test_lambdad_unlisted_preserved(self):
+        img = self.imt
+        other = np.arange(6)
+        data = {"img": img, "other": other}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])
+        out = transform(data)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], out["img"]))
+        self.assertIs(out["other"], other)
+        self.assertIs(data["img"], img)
+        self.assertEqual(out["other"].tolist(), [0, 1, 2, 3, 4, 5])
+
+    def test_lambdad_iterable_callable_applied_whole(self):
+        func = _CountingIterableCallable()
+        data = {"a": np.array([1, 2]), "b": np.array([3, 4])}
+        transform = Lambdad(keys=("a", "b"), func=func)
+        out = transform(data)
+        self.assertEqual(func.calls, 2)
+        self.assertEqual(out["a"].tolist(), [1, 2])
+        self.assertEqual(out["b"].tolist(), [3, 4])
+
+    def test_lambdad_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
