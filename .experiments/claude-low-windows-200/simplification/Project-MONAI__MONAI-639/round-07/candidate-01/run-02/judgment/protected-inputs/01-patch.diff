+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(lambda x: x)(img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slicing(self):
+        img = self.imt
+        # slice spatial axes only, keep batch and channel axes whole
+        result = Lambda(lambda x: x[..., 10:100, 5:50])(img)
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(img[..., 10:100, 5:50], result))
+
+
+if __name__ == "__main__":
+    unittest.main()
