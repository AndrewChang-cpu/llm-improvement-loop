+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys="img", func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        # slice spatial axes only, keep batch and channel axes whole
+        result = Lambdad(keys=data.keys(), func=lambda x: x[..., 10:100, 5:50])(data)
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(img[..., 10:100, 5:50], result["img"]))
+        # the caller's mapping is left unchanged
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_unlisted_preserved(self):
+        img = self.imt
+        other = np.arange(4)
+        data = {"img": img, "other": other}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:100, 5:50])(data)
+        self.assertTrue(np.allclose(img[..., 10:100, 5:50], result["img"]))
+        self.assertIs(result["other"], other)
+
+
+if __name__ == "__main__":
+    unittest.main()
