     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda or callable function to the input data.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            x = np.array([1, 2, 3, 4])
+            result = Lambda(func=lambda x: x[:2])(x)
+            # result: [1, 2]
+
+    Args:
+        func: Lambda/function to be applied on the input data. It is called with the
+            input as its single positional argument, and its result is returned.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
