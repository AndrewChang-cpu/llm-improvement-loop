+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to every listed key, returning a new dictionary;
+    the input dictionary is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.array([1, 2, 3, 4]), "label": np.array([0, 1, 0, 1])}
+            result = Lambdad(keys="img", func=lambda x: x[:2])(data)
+            # result["img"]: [1, 2]; result["label"] is unchanged: [0, 1, 0, 1]
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: Lambda/function to be applied on each item listed in ``keys``.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
