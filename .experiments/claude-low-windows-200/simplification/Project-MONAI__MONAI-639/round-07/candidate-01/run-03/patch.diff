+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slice(self):
+        # slice only spatial axes, keep batch and channel axes whole
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:60, 5:40])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:60, 5:40])
+        self.assertGreater(result["img"].size, 0)
+
+    def test_keys_view_and_unlisted_preserved(self):
+        # a keys view is used only here because the image is the sole entry
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:60, 5:40])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:60, 5:40])
+        # the original mapping is left untouched
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "label": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:60, 5:40])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:60, 5:40])
+        np.testing.assert_allclose(result["label"], self.segn)
+        self.assertIsNot(result, data)
+
+
+if __name__ == "__main__":
+    unittest.main()
