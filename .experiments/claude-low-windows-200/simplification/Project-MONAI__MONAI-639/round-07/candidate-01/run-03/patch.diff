+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(func=lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slice(self):
+        # slice only spatial axes, keep batch and channel axes whole
+        result = Lambda(func=lambda x: x[:, :, 10:60, 5:40])(self.imt)
+        np.testing.assert_allclose(result, self.imt[:, :, 10:60, 5:40])
+        self.assertGreater(result.size, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
