+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:-1, 1:-1])
+        result = lambd(data)
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(img[:, :, 1:-1, 1:-1], result["img"]))
+        # unlisted entries are preserved and the input mapping is left untouched
+        self.assertIs(result["seg"], data["seg"])
+        self.assertIs(data["img"], img)
+
+
+if __name__ == "__main__":
+    unittest.main()
