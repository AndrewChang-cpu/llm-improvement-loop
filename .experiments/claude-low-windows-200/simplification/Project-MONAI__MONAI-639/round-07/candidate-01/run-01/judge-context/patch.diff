+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slice(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x[:, :, 1:-1, 1:-1])
+        result = lambd(img)
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(img[:, :, 1:-1, 1:-1], result))
+
+
+if __name__ == "__main__":
+    unittest.main()
