@@ -291,3 +291,27 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined function to the whole input, and return the function's result.
+    The function receives the entire input, for example::
+
+        import numpy as np
+        from monai.transforms import Lambda
+
+        img = np.arange(16).reshape(1, 4, 4)
+        slice_fn = Lambda(lambda x: x[:, 1:3, 1:3])
+        out = slice_fn(img)  # shape (1, 2, 2)
+
+    Args:
+        func: Callable applied to the input; its return value is the transform's output.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
