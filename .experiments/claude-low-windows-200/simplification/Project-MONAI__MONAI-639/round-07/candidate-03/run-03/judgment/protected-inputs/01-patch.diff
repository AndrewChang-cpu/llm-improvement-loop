+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The function is applied
+    to the value of each listed key, and receives the whole value (not split per key).
+    For example, applying a slicing function to the image::
+
+        import numpy as np
+        from monai.transforms import Lambdad
+
+        data = {"img": np.arange(16).reshape(1, 4, 4), "seg": np.zeros((1, 4, 4))}
+        out = Lambdad(keys="img", func=lambda x: x[:, 1:3, 1:3])(data)
+        # out["img"] has shape (1, 2, 2); out["seg"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: Callable applied to each listed item; its return value replaces the item.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
