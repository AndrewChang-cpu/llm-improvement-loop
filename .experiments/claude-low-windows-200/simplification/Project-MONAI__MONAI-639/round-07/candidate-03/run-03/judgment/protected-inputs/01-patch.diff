+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class IterableCallable:
+    """A callable that is also iterable, to check it is applied whole rather than split per key."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x + 1
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], img)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:40])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:50, 5:40])
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:40])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:50, 5:40])
+        np.testing.assert_allclose(result["seg"], seg)
+        # original mapping is untouched
+        self.assertEqual(data["img"].shape, img.shape)
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_keys_view_sole_entry(self):
+        img = self.imt
+        data = {"img": img}
+        result = LambdaD(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:40])(data)
+        np.testing.assert_allclose(result["img"], img[:, :, 10:50, 5:40])
+
+    def test_alias(self):
+        self.assertIs(LambdaDict, Lambdad)
+        self.assertIs(LambdaD, Lambdad)
+
+    def test_iterable_callable_applied_whole(self):
+        func = IterableCallable()
+        data = {"a": np.array([1.0]), "b": np.array([2.0])}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["a"], np.array([2.0]))
+        np.testing.assert_allclose(result["b"], np.array([3.0]))
+
+
+if __name__ == "__main__":
+    unittest.main()
