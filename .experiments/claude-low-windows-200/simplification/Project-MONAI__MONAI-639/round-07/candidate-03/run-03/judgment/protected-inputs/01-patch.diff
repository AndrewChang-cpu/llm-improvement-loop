+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(lambda x: x)(img)
+        np.testing.assert_allclose(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only spatial axes so the result is non-empty
+        result = Lambda(lambda x: x[:, :, 10:50, 5:40])(img)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, img[:, :, 10:50, 5:40])
+
+
+if __name__ == "__main__":
+    unittest.main()
