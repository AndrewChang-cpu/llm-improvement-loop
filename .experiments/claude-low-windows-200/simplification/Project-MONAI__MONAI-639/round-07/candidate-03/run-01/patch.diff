+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCallable:
+    """Callable that is also iterable; Lambdad must pass it whole, never iterate it."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __call__(self, x):
+        self.calls += 1
+        return x + 1
+
+    def __iter__(self):
+        raise AssertionError("callable must not be iterated")
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        self.assertTrue(np.array_equal(result["img"], img))
+        self.assertIs(result["seg"], self.seg1)
+        self.assertIsNot(result, data)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 8:24, 4:20])(data)
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.array_equal(result["img"], img[:, :, 8:24, 4:20]))
+        self.assertIs(result["seg"], self.seg1)
+        self.assertIs(data["img"], img)
+
+    def test_slice_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 8:24, 4:20])(data)
+        self.assertTrue(np.array_equal(result["img"], img[:, :, 8:24, 4:20]))
+
+    def test_iterable_callable_applied_whole_per_key(self):
+        func = _IterableCallable()
+        data = {"a": np.zeros(2), "b": np.zeros(2)}
+        result = Lambdad(keys=["a", "b"], func=func)(data)
+        self.assertTrue(np.array_equal(result["a"], np.ones(2)))
+        self.assertTrue(np.array_equal(result["b"], np.ones(2)))
+        self.assertEqual(func.calls, 2)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
