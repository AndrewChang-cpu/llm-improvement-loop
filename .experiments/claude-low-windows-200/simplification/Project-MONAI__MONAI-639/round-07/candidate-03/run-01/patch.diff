+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(lambda x: x)(img)
+        self.assertTrue(np.array_equal(img, result))
+
+    def test_slice(self):
+        img = self.imt
+        result = Lambda(lambda x: x[:, :, 8:24, 4:20])(img)
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.array_equal(result, img[:, :, 8:24, 4:20]))
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda("not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
