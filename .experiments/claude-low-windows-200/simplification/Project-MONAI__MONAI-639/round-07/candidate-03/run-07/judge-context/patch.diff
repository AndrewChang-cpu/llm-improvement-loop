         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda function to the input data.
+    The callable receives the whole input and returns the transformed value.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(16).reshape(1, 4, 4)
+            transform = Lambda(func=lambda x: x[:, 1:3, 1:3])
+            out = transform(img)  # shape (1, 2, 2)
+
+    Args:
+        func: user-defined callable to apply to the input data. Must be callable.
+
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
