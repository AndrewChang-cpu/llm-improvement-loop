+class Lambdad(MapTransform):
+    """
+    Apply a user-defined lambda function to the items specified by ``keys`` in the data dictionary.
+    The callable is applied to each listed item as a whole and returns the transformed value.
+    The input dictionary is not modified; a shallow copy is returned.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(16).reshape(1, 4, 4)}
+            transform = Lambdad(keys="img", func=lambda x: x[:, 1:3, 1:3])
+            out = transform(data)  # out["img"] has shape (1, 2, 2)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: user-defined callable to apply to each item. Must be callable.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
