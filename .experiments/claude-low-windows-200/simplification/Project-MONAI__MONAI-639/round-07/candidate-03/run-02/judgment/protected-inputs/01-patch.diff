@@ -0,0 +1,71 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import LambdaD
+from tests.utils import NumpyImageTestCase2D
+
+
+class _IterableCounter:
+    """Callable that is also iterable; counts how many times it is called."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter(())
+
+    def __call__(self, x):
+        self.calls += 1
+        return x + 1
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = LambdaD(keys=["img", "seg"], func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.segn)
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.segn}
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = LambdaD(keys="img", func=lambda x: x[:, :, 1:-1, 2:-2])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 1:-1, 2:-2])
+        # unlisted entry is preserved
+        np.testing.assert_allclose(result["seg"], self.segn)
+        # original mapping is untouched
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_keys_view_slicing(self):
+        # image is the sole entry, so slicing a keys view is safe here
+        data = {"img": self.imt}
+        result = LambdaD(keys=data.keys(), func=lambda x: x[:, :, 1:-1, 2:-2])(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 1:-1, 2:-2])
+
+    def test_iterable_callable_applied_whole(self):
+        func = _IterableCounter()
+        data = {"img": self.imt, "seg": self.segn}
+        result = LambdaD(keys=["img", "seg"], func=func)(data)
+        # applied once per listed key, to each whole item
+        self.assertEqual(func.calls, 2)
+        np.testing.assert_allclose(result["img"], self.imt + 1)
+        np.testing.assert_allclose(result["seg"], self.segn + 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
