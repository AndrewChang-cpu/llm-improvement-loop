+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        transform = Lambda(lambda x: x)
+        self.assertTrue(np.allclose(img, transform(img)))
+
+    def test_slicing(self):
+        img = self.imt
+        transform = Lambda(lambda x: x[:, :, 2:10, 3:20])
+        result = transform(img)
+        self.assertTrue(np.allclose(result, img[:, :, 2:10, 3:20]))
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda("not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
