+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        transform = Lambdad(keys="img", func=lambda x: x)
+        result = transform({"img": img})
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        transform = Lambdad(keys="img", func=lambda x: x[:, :, 2:10, 3:20])
+        result = transform({"img": img})
+        self.assertTrue(np.allclose(result["img"], img[:, :, 2:10, 3:20]))
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        label = self.seg1
+        data = {"img": img, "label": label}
+        original = dict(data)
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:10, 3:20])
+        result = transform(data)
+        self.assertIsNot(result, data)
+        self.assertTrue(np.allclose(result["img"], img[:, :, 2:10, 3:20]))
+        self.assertIs(result["label"], label)
+        # caller's mapping is untouched
+        self.assertIs(data["img"], original["img"])
+        self.assertTrue(np.allclose(data["img"], img))
+
+    def test_keys_view(self):
+        img = self.imt
+        transform = Lambdad(keys={"img": 0}.keys(), func=lambda x: x[:, :, 2:10, 3:20])
+        result = transform({"img": img})
+        self.assertTrue(np.allclose(result["img"], img[:, :, 2:10, 3:20]))
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func=123)
+
+
+if __name__ == "__main__":
+    unittest.main()
