+
+import unittest
+import numpy as np
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def identity(x):
+    return x
+
+
+def spatial_slice(x):
+    # slice only spatial axes, keeping batch and channel axes whole
+    return x[:, :, 10:20, 5:30]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(identity)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slicing(self):
+        result = Lambda(spatial_slice)(self.imt)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, self.imt[:, :, 10:20, 5:30])
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda("not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
