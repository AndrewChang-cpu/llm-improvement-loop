+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+import numpy as np
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+def identity(x):
+    return x
+
+
+def spatial_slice(x):
+    # slice only spatial axes, keeping batch and channel axes whole
+    return x[:, :, 10:20, 5:30]
+
+
+class IterableSlicer(list):
+    """A callable that is also iterable; it must be applied whole, not per element."""
+
+    def __call__(self, x):
+        return x[:, :, 10:20, 5:30]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=identity)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys="img", func=spatial_slice)(data)
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+
+    def test_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=spatial_slice)(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+
+    def test_unlisted_entries_preserved(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        original_img = self.imt.copy()
+        result = Lambdad(keys=["img"], func=spatial_slice)(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        # caller's mapping and array are untouched
+        self.assertIs(data["img"], self.imt)
+        np.testing.assert_allclose(data["img"], original_img)
+
+    def test_iterable_callable_applied_whole(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=["img", "seg"], func=IterableSlicer())(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20, 5:30])
+        np.testing.assert_allclose(result["seg"], self.seg1[:, :, 10:20, 5:30])
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func="not callable")
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=identity)
+
+
+if __name__ == "__main__":
+    unittest.main()
