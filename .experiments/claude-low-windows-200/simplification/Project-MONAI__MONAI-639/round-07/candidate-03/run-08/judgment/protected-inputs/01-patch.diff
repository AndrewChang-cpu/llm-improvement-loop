+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class CountingIterableCallable:
+    """Callable that is also iterable, used to check that Lambdad applies it whole."""
+
+    def __init__(self):
+        self.calls = 0
+
+    def __iter__(self):
+        return iter([1, 2, 3])
+
+    def __call__(self, x):
+        self.calls += 1
+        return x
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "label": "unchanged"}
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:10, 3:20])(data)
+        expected = img[:, :, 2:10, 3:20]
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(expected, result["img"]))
+        # unlisted entry preserved, original mapping untouched
+        self.assertEqual(result["label"], "unchanged")
+        self.assertIs(data["img"], img)
+        self.assertEqual(data["label"], "unchanged")
+
+    def test_iterable_callable_applied_whole(self):
+        img = self.imt
+        func = CountingIterableCallable()
+        data = {"img": img, "seg": img}
+        result = Lambdad(keys=["img", "seg"], func=func)(data)
+        self.assertEqual(func.calls, 2)
+        self.assertIs(result["img"], img)
+        self.assertIs(result["seg"], img)
+
+
+if __name__ == "__main__":
+    unittest.main()
