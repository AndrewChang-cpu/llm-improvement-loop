+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slicing(self):
+        img = self.imt
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = Lambda(func=lambda x: x[:, :, 2:10, 3:20])(img)
+        expected = img[:, :, 2:10, 3:20]
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
