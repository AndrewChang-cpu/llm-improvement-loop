@@ -291,3 +291,28 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image and return its result.
+
+    For example, with an array input and a slicing callable:
+
+    .. code-block:: python
+
+        >>> img = np.array([[0, 1, 2, 3], [4, 5, 6, 7]])
+        >>> Lambda(lambda x: x[:, 1:3])(img)
+        array([[1, 2],
+               [5, 6]])
+
+    Args:
+        func: the callable to be applied to the input image. Must be callable.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
