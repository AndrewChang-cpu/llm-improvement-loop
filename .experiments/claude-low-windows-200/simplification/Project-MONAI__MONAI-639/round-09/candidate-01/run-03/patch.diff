+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+import numpy as np
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        # the image is the sole entry, so a keys view is valid here
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        original = self.imt.copy()
+        # keys name only the image, so the unlisted "seg" entry must be preserved
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:20])
+        np.testing.assert_allclose(result["seg"], self.seg1)
+        np.testing.assert_allclose(data["img"], original)
+
+
+if __name__ == "__main__":
+    unittest.main()
