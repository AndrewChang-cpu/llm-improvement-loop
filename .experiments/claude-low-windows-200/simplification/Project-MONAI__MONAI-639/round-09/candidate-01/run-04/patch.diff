--- a/monai/transforms/utility/array.py
+++ b/monai/transforms/utility/array.py
@@ -291,3 +291,28 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input data. For example, a slicing function can be used to
+    keep only part of an array:
+
+    .. code-block:: python
+
+        from monai.transforms import Lambda
+
+        # keep the first two channels and the first 10 rows of a channel-first array
+        transform = Lambda(lambda x: x[:2, :10])
+        out = transform(np.zeros((3, 20, 20)))  # shape (2, 10, 20)
+
+    Args:
+        func: the callable to apply to the input data. It is called as ``func(img)``.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
