@@ -413,6 +414,37 @@ class ConcatItemsd(MapTransform):
         return d
 
 
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. For example, a slicing function
+    applied to the "img" entry of a dictionary:
+
+    .. code-block:: python
+
+        from monai.transforms import Lambdad
+
+        # keep the first two channels and the first 10 rows of the "img" array
+        transform = Lambdad(keys="img", func=lambda x: x[:2, :10])
+        out = transform({"img": np.zeros((3, 20, 20))})  # out["img"].shape == (2, 10, 20)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable to apply to each item. It is passed whole to
+            :py:class:`monai.transforms.Lambda`, even if it is iterable.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
 IdentityD = IdentityDict = Identityd
