+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.random.rand(1, 10, 12), "label": 1}
+            transform = Lambdad(keys="img", func=lambda x: x[:, 2:5, 3:7])
+            out = transform(data)  # out["img"] shape: (1, 3, 4); out["label"] unchanged
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to each item selected by ``keys``; any callable is passed whole to ``func``.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
