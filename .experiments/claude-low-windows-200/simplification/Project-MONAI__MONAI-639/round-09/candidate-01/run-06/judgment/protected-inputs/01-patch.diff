     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image. For example, a slicing callable
+    keeps only the requested region of an array input:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambda
+
+        img = np.arange(16).reshape(1, 4, 4)
+        out = Lambda(lambda x: x[:, 1:3, 1:3])(img)  # shape (1, 2, 2)
+
+    Args:
+        func: Callable applied to the input image. It is passed whole, even if it is iterable.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
