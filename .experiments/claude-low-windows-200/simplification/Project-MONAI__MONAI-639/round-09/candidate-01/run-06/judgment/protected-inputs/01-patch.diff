+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. Apply a user-supplied callable
+    to each item listed in ``keys``. For example, a slicing callable keeps only the requested region
+    of an array input:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambdad
+
+        data = {"img": np.arange(16).reshape(1, 4, 4), "seg": np.arange(16).reshape(1, 4, 4)}
+        out = Lambdad(keys="img", func=lambda x: x[:, 1:3, 1:3])(data)  # out["img"] has shape (1, 2, 2)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: Callable applied to each item listed in ``keys``. It is passed whole, even if it is iterable.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
