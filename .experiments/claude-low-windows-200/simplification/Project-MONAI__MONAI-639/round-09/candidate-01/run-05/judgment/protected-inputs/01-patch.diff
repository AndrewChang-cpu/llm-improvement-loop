+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slicing_unlisted_preserved(self):
+        img = self.imt
+        other = np.ones((2, 2), dtype=np.float32)
+        data = {"img": img, "other": other}
+        original_img = img.copy()
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 10:50, 5:30])(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], img[..., 10:50, 5:30])
+        self.assertGreater(result["img"].size, 0)
+        self.assertIs(result["other"], other)
+        # the caller's mapping and image are untouched
+        self.assertIs(data["img"], img)
+        np.testing.assert_array_equal(data["img"], original_img)
+
+
+if __name__ == "__main__":
+    unittest.main()
