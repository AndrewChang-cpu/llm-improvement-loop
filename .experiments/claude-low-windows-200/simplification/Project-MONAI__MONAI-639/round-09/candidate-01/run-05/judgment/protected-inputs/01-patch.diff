+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Apply the user-supplied callable to each item listed in ``keys`` and store the result under the same key.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(24).reshape(2, 3, 4)}
+            result = Lambdad(keys="img", func=lambda x: x[:, 1:3, 0:2])(data)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each listed item. Must be callable; otherwise an AssertionError is raised
+            at construction.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambda_transform = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambda_transform(d[key])
+        return d
+
+
