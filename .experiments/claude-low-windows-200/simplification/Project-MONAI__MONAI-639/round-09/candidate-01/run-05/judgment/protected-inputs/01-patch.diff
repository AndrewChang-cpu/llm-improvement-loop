     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image and return its result.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(24).reshape(2, 3, 4)
+            result = Lambda(func=lambda x: x[:, 1:3, 0:2])(img)
+
+    Args:
+        func: callable applied to the input image. Its return value is returned unchanged.
+            Must be callable; otherwise an AssertionError is raised at construction.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
