+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_callable(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        self.assertIsNot(result, data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing_callable(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        original = img.copy()
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:60, 4:50])
+        result = lambd(data)
+        self.assertTrue(np.allclose(img[:, :, 2:60, 4:50], result["img"]))
+        # the caller's mapping is left unchanged
+        self.assertTrue(np.allclose(original, data["img"]))
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:60, 4:50])
+        result = lambd(data)
+        self.assertTrue(np.allclose(img[:, :, 2:60, 4:50], result["img"]))
+        self.assertTrue(np.allclose(seg, result["seg"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
