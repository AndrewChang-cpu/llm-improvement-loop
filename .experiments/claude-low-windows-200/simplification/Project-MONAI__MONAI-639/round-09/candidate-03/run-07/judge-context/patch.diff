+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity_callable(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slicing_callable(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x[:, :, 2:60, 4:50])
+        self.assertTrue(np.allclose(img[:, :, 2:60, 4:50], lambd(img)))
+
+
+if __name__ == "__main__":
+    unittest.main()
