+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to every item listed in ``keys``, for example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        data = {"img": np.zeros((1, 1, 8, 8)), "seg": np.zeros((1, 1, 8, 8))}
+        out = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:6, 2:6])(data)
+        # out["img"] has shape (1, 1, 4, 4); out["seg"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each item listed in ``keys``, must be callable.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
