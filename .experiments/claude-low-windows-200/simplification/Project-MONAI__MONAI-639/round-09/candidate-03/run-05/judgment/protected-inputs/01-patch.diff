@@ -413,6 +414,33 @@ class ConcatItemsd(MapTransform):
         return d
 
 
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same callable is applied
+    to every item listed in `keys`. For example, slicing the spatial axes of the items stored under
+    "img" and "seg" while keeping the batch and channel axes whole:
+
+    .. code-block:: python
+
+        Lambdad(keys=["img", "seg"], func=lambda x: x[:, :, 2:8, 3:9])(data)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable to apply to each item listed in `keys`.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
