+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=["img"], func=lambda x: x)
+        output = transform(data)
+        self.assertTrue(np.allclose(img, output["img"]))
+
+    def test_identity_keys_view(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        output = transform(data)
+        self.assertTrue(np.allclose(img, output["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:8, 3:9])
+        output = transform(data)
+        self.assertTrue(np.allclose(img[:, :, 2:8, 3:9], output["img"]))
+
+    def test_slicing_keys_view(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:8, 3:9])
+        output = transform(data)
+        self.assertTrue(np.allclose(img[:, :, 2:8, 3:9], output["img"]))
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        data["other"] = img.copy()
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:8, 3:9])
+        output = transform(data)
+        self.assertTrue(np.allclose(img[:, :, 2:8, 3:9], output["img"]))
+        self.assertTrue(np.allclose(img, output["other"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
