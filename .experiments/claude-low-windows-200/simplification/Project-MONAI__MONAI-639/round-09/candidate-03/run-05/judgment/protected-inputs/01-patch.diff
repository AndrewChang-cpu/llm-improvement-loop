@@ -291,3 +291,26 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input image. The callable receives the whole input
+    and its result is returned, so any indexing, slicing or other logic it implements is applied
+    to the image. For example, slicing the spatial axes of a channel-first image while keeping
+    the batch and channel axes whole:
+
+    .. code-block:: python
+
+        Lambda(lambda x: x[:, 2:8, 3:9])(np.zeros((1, 1, 10, 10)))  # output shape: (1, 1, 6, 6)
+
+    Args:
+        func: the callable to apply to the input image.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
