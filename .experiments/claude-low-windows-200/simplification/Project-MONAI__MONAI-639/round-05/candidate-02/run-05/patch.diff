@@ -291,3 +291,32 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input and return its result.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            transform = Lambda(func=lambda x: x[:, 1:])
+            out = transform(np.zeros((1, 3, 4)))
+            # out has shape (1, 2, 4)
+
+    """
+
+    def __init__(self, func: Callable):
+        """
+        Args:
+            func: callable applied to the input. It receives the whole input and returns the transformed value.
+        """
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
