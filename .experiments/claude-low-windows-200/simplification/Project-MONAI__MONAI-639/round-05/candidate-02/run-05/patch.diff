+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "label": "meta"}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:-1, 2:-2])
+        result = transform(data)
+        self.assertTrue(np.allclose(img[:, :, 1:-1, 2:-2], result["img"]))
+        self.assertEqual(result["label"], "meta")
+        self.assertEqual(data["img"].shape, img.shape)
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
