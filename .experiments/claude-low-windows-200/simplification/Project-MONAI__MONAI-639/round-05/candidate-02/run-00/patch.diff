+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "other": "unchanged"}
+        # only "img" is listed, so "other" must be preserved as is
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])
+        result = lambd(data)
+        expected = img[:, :, 10:50, 5:30]
+        self.assertEqual(result["img"].shape, expected.shape)
+        self.assertTrue(np.allclose(expected, result["img"]))
+        self.assertEqual(result["other"], "unchanged")
+        # the caller's mapping must not be modified
+        self.assertIs(data["img"], img)
+
+
+if __name__ == "__main__":
+    unittest.main()
