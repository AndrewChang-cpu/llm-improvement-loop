+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes so batch and channel axes stay whole
+        lambd = Lambda(func=lambda x: x[:, :, 10:50, 5:30])
+        expected = img[:, :, 10:50, 5:30]
+        result = lambd(img)
+        self.assertEqual(result.shape, expected.shape)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
