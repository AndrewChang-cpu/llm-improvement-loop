+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_func(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing_func(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, 5:30])
+        result = transform(data)
+        self.assertTrue(result["img"].size > 0)
+        self.assertTrue(np.allclose(img[:, :, 10:50, 5:30], result["img"]))
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        data = {"img": img, "name": "case_01"}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, 5:30])
+        result = transform(data)
+        self.assertEqual(result["name"], "case_01")
+        self.assertTrue(np.allclose(img[:, :, 10:50, 5:30], result["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
