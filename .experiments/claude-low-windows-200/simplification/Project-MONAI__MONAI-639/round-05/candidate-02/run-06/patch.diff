+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:, 1:])
+        result = transform(data)
+        self.assertTrue(np.allclose(img[:, :, 1:, 1:], result["img"]))
+        self.assertGreater(result["img"].size, 0)
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        other = "other"
+        data = {"img": img, other: "unchanged"}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:, 1:])
+        result = transform(data)
+        self.assertEqual(result[other], "unchanged")
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_not_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=None)
+
+
+if __name__ == "__main__":
+    unittest.main()
