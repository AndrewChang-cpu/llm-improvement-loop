     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input and return its result.
+    The callable receives the whole input and its return value is passed on unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.array([[1, 2, 3], [4, 5, 6]])
+            result = Lambda(lambda x: x[:, 1:])(img)
+            # result is [[2, 3], [5, 6]]
+
+    Args:
+        func: callable applied to the input; it receives the value it is given and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
