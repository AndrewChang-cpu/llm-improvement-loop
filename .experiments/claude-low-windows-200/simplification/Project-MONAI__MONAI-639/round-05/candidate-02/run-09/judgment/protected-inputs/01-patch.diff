+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        np.testing.assert_allclose(result, img)
+
+    def test_slice(self):
+        img = self.imt
+        # slice spatial axes only, keeping batch and channel axes whole
+        result = Lambda(func=lambda x: x[:, :, 10:20, 5:30])(img)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, img[:, :, 10:20, 5:30])
+
+
+if __name__ == "__main__":
+    unittest.main()
