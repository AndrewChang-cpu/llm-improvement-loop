+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def _slice_spatial(x):
+    # slice only the last two (spatial) axes, keeping batch and channel axes whole
+    return x[..., 2:10, 4:20]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=_slice_spatial)(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 2:10, 4:20])
+        self.assertEqual(result["img"].shape, self.imt[..., 2:10, 4:20].shape)
+        # unlisted entry is preserved unchanged
+        np.testing.assert_allclose(result["seg"], self.segn)
+        # original mapping is untouched
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_keys_view(self):
+        # the image is the sole entry, so a keys view is safe to use
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=_slice_spatial)(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 2:10, 4:20])
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
