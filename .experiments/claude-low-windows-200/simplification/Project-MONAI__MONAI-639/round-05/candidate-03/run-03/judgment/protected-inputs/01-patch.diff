+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _slice_spatial(x):
+    # slice only the last two (spatial) axes, keeping batch and channel axes whole
+    return x[..., 2:10, 4:20]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slicing(self):
+        result = Lambda(_slice_spatial)(self.imt)
+        expected = self.imt[..., 2:10, 4:20]
+        self.assertEqual(result.shape, expected.shape)
+        np.testing.assert_allclose(result, expected)
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda("not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
