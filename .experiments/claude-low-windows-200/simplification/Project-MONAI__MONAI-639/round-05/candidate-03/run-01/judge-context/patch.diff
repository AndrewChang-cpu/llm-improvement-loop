+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(lambda x: x)(img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, leaving the batch and channel axes whole
+        result = Lambda(lambda x: x[:, :, 10:20, 5:15])(img)
+        expected = img[:, :, 10:20, 5:15]
+        self.assertEqual(result.shape, expected.shape)
+        self.assertTrue(result.size > 0)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
