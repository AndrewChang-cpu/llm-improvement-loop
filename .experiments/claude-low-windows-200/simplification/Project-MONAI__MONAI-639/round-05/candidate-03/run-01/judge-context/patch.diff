     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the whole input. The callable receives the input
+    and returns the transformed value.
+
+    For example, a slicing callable applied to a 2D array:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambda
+
+        img = np.array([[1, 2, 3], [4, 5, 6]])
+        out = Lambda(lambda x: x[:, 1:])(img)
+        # out.tolist() == [[2, 3], [5, 6]]
+
+    Args:
+        func: callable applied to the input; it is used whole, even if it is also iterable.
+
+    Raises:
+        AssertionError: func must be callable.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
