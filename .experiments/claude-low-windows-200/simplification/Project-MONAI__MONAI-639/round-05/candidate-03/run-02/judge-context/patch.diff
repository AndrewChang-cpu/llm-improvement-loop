+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes so batch and channel axes stay whole
+        data = {"img": self.imt}
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 2:20, 4:40])(data)
+        expected = self.imt[..., 2:20, 4:40]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_allclose(result["img"], expected)
+
+    def test_keys_view(self):
+        # the image is the sole entry, so a keys view can be used safely
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[..., 2:20, 4:40])(data)
+        np.testing.assert_allclose(result["img"], self.imt[..., 2:20, 4:40])
+
+    def test_unlisted_entry_preserved(self):
+        # the caller's mapping must be untouched, and unlisted entries preserved
+        data = {"img": self.imt, "label": "text"}
+        original_img = self.imt.copy()
+        result = Lambdad(keys=["img"], func=lambda x: x[..., 2:20, 4:40])(data)
+        np.testing.assert_allclose(result["img"], original_img[..., 2:20, 4:40])
+        self.assertEqual(result["label"], "text")
+        np.testing.assert_allclose(data["img"], original_img)
+        self.assertEqual(data["img"].shape, original_img.shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
