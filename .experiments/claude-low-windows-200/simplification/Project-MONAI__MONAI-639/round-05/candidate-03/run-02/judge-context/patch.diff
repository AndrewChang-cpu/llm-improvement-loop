@@ -291,3 +291,28 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the whole input.
+    For example, slicing the first two elements of an array:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambda
+
+        transform = Lambda(func=lambda x: x[:2])
+        transform(np.array([1, 2, 3, 4]))  # array([1, 2])
+
+    Args:
+        func: the callable applied to the input; it receives the input and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
