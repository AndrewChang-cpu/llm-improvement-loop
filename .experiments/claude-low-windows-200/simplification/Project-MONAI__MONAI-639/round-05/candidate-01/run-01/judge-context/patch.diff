+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to each listed item.
+
+    Example:
+
+        .. code-block:: python
+
+            data = {"img": np.arange(16).reshape(1, 4, 4), "seg": np.arange(16).reshape(1, 4, 4)}
+            result = Lambdad(keys=["img"], func=lambda x: x[..., 1:3, 1:3])(data)
+            # result["img"] is [[[5, 6], [9, 10]]]; result["seg"] is data["seg"], unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: a callable applied to each listed item; its return value replaces that item.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
