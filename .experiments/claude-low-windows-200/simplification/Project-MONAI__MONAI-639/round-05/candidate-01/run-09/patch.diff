+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(lambda x: x)(self.imt)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slice(self):
+        # slice only the spatial axes so batch and channel axes stay whole
+        result = Lambda(lambda x: x[:, :, 2:-2, 3:-3])(self.imt)
+        np.testing.assert_allclose(result, self.imt[:, :, 2:-2, 3:-3])
+        self.assertGreater(result.size, 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
