+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+        self.assertIsNot(result, data)
+
+    def test_slice(self):
+        img = self.imt
+        label = self.segn
+        data = {"img": img, "label": label}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:20, 5:15])
+        result = transform(data)
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(img[:, :, 10:20, 5:15], result["img"]))
+        self.assertTrue(np.array_equal(label, result["label"]))
+        self.assertTrue(np.array_equal(img, data["img"]))
+        self.assertTrue(np.array_equal(label, data["label"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
