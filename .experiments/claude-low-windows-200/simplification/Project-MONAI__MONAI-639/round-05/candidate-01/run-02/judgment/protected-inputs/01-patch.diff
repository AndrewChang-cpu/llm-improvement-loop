+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        original = dict(data)
+        result = Lambdad(keys=("img",), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], img)
+        np.testing.assert_array_equal(result["seg"], seg)
+        # the caller's mapping is left untouched
+        self.assertIs(data["img"], original["img"])
+        self.assertIs(data["seg"], original["seg"])
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        expected = img[:, :, 10:20, 5:15]
+        self.assertGreater(result["img"].size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+
+    def test_slicing_preserves_unlisted(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=("img",), func=lambda x: x[:, :, 10:20, 5:15])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:20, 5:15])
+        np.testing.assert_array_equal(result["seg"], seg)
+        self.assertIs(data["img"], img)
+
+
+if __name__ == "__main__":
+    unittest.main()
