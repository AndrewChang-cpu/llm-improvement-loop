+class Lambdad(MapTransform):
+    """
+    Apply the same user-supplied callable to each listed key of the data dictionary.
+
+    For example:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambdad
+
+        data = {"img": np.arange(24).reshape(1, 2, 3, 4), "label": "x"}
+        out = Lambdad(keys="img", func=lambda x: x[:, :, 1:, ::2])(data)
+        # out["img"].shape is (1, 2, 2, 2); out["label"] is unchanged
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to every item listed in `keys`. A list or tuple
+                of callables is not supported.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
