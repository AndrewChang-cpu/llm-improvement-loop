+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice(x):
+    return x[:, :, 2:, ::-2]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=_identity)
+        result = lambd(img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slicing(self):
+        img = self.imt
+        lambd = Lambda(func=_slice)
+        result = lambd(img)
+        expected = img[:, :, 2:, ::-2]
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(expected, result))
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
