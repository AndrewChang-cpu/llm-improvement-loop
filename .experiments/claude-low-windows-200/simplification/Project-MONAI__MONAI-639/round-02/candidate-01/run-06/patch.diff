+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import LambdaD, LambdaDict, Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice(x):
+    return x[:, :, 2:, ::-2]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=_identity)
+        result = lambd(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        lambd = Lambdad(keys=data.keys(), func=_slice)
+        result = lambd(data)
+        expected = img[:, :, 2:, ::-2]
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(expected, result["img"]))
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        original = img.copy()
+        data = {"img": img, "meta": "unchanged"}
+        lambd = Lambdad(keys=["img"], func=_slice)
+        result = lambd(data)
+        self.assertEqual(result["meta"], "unchanged")
+        self.assertTrue(np.allclose(img[:, :, 2:, ::-2], result["img"]))
+        self.assertTrue(np.array_equal(original, data["img"]))
+        self.assertIsNot(result, data)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=_identity)
+
+
+if __name__ == "__main__":
+    unittest.main()
