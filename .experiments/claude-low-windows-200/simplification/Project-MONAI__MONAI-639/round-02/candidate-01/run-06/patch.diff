+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to each of the configured keys.
+
+    Example:
+
+        .. code-block:: python
+
+            lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:, ::2])
+            out = lambd({"img": np.zeros((1, 1, 4, 6))})  # out["img"].shape == (1, 1, 3, 3)
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to each item under the configured keys.
+                A list or tuple of callables is not supported.
+
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func=func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
