+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slicing(self):
+        img = self.imt
+
+        def func(x):
+            return x[:, :, 5:, ::-2]
+
+        lambd = Lambda(func=func)
+        result = lambd(img)
+        expected = img[:, :, 5:, ::-2]
+        self.assertGreater(result.size, 0)
+        self.assertEqual(result.shape, expected.shape)
+        self.assertTrue(np.allclose(result, expected))
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
