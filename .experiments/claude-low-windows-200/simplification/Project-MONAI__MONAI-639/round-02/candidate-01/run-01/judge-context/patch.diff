+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _slice_spatial(x):
+    # keep the batch and channel axes whole; slice the spatial axes only
+    return x[:, :, 5:100, ::-2]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        np.testing.assert_array_equal(lambd(img), img)
+
+    def test_slicing(self):
+        img = self.imt
+        lambd = Lambda(func=_slice_spatial)
+        np.testing.assert_array_equal(lambd(img), img[:, :, 5:100, ::-2])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
