+class Lambdad(MapTransform):
+    """
+    Apply the same user-supplied callable to each listed key of a dictionary and return a new dictionary.
+    The input dictionary is shallow-copied, so the original is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            data = {"img": np.arange(24).reshape(1, 2, 3, 4), "label": 0}
+            result = Lambdad(keys="img", func=lambda x: x[:, 1:, ::2])(data)
+            # result["img"] has shape (1, 1, 2, 4); result["label"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to each listed item. A list or tuple of callables is not supported.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
