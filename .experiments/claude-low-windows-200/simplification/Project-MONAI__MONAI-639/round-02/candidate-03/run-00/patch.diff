+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import LambdaD, LambdaDict, Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice(x):
+    # slice spatial axes only; leading batch and channel axes are kept whole
+    return x[:, :, 10:100, ::-2]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=_identity)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_slice(self):
+        data = {"img": self.imt}
+        original = data["img"]
+        result = Lambdad(keys=data.keys(), func=_slice)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:100, ::-2])
+        self.assertIs(data["img"], original)
+
+    def test_unlisted_key_preserved(self):
+        data = {"img": self.imt, "extra": "meta"}
+        result = Lambdad(keys=["img"], func=_slice)(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:100, ::-2])
+        self.assertEqual(result["extra"], "meta")
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
