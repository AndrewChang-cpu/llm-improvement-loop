+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _identity(x):
+    return x
+
+
+def _slice(x):
+    # slice spatial axes only; leading batch and channel axes are kept whole
+    return x[:, :, 10:100, ::-2]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=_identity)(img)
+        self.assertIs(result, img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_slice(self):
+        img = self.imt
+        result = Lambda(func=_slice)(img)
+        np.testing.assert_array_equal(result, img[:, :, 10:100, ::-2])
+
+
+if __name__ == "__main__":
+    unittest.main()
