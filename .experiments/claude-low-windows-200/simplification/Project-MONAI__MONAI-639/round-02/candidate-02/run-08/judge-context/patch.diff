+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.array_equal(result["img"], img))
+
+    def test_slice(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:, ::-2])
+        result = transform(data)
+        expected = img[:, :, 2:, ::-2]
+        self.assertTrue(np.array_equal(result["img"], expected))
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        data["meta"] = "unchanged"
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:, ::-2])
+        result = transform(data)
+        self.assertTrue(np.array_equal(result["img"], img[:, :, 2:, ::-2]))
+        self.assertEqual(result["meta"], "unchanged")
+        self.assertTrue(np.array_equal(data["img"], img))
+
+
+if __name__ == "__main__":
+    unittest.main()
