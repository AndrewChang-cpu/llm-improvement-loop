+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        self.assertIsNot(result, data)
+        self.assertIs(result["img"], img)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, ::-2])
+        result = lambd(data)
+        expected = img[:, :, 10:50, ::-2]
+        self.assertTrue(result["img"].size > 0)
+        self.assertTrue(np.array_equal(result["img"], expected))
+        self.assertTrue(np.array_equal(data["img"], img))
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        data = {"img": img, "extra": "meta"}
+        lambd = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, ::-2])
+        result = lambd(data)
+        self.assertEqual(result["extra"], "meta")
+        self.assertTrue(np.array_equal(result["img"], img[:, :, 10:50, ::-2]))
+        self.assertIs(data["img"], img)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
