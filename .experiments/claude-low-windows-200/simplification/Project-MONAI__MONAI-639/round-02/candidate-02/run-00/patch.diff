+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. Applies the same callable
+    to the value of each listed key.
+
+    Example:
+        >>> lambdad = Lambdad(keys=["img"], func=lambda x: x[1:3])
+        >>> out = lambdad({"img": np.array([0, 1, 2, 3])})
+        >>> out["img"]
+        array([1, 2])
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to the value of each listed key.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func=func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
