+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity_callable(self):
+        img = self.imt
+        lambda_t = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, lambda_t(img)))
+
+    def test_slicing_callable(self):
+        img = self.imt
+        lambda_t = Lambda(func=lambda x: x[..., 10:100, ::-2])
+        result = lambda_t(img)
+        expected = img[..., 10:100, ::-2]
+        self.assertEqual(result.shape, expected.shape)
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
