@@ -291,3 +291,25 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+
+    Example:
+        >>> img = np.zeros((1, 1, 4))
+        >>> lambda_t = Lambda(func=lambda x: x[..., 1:3])
+        >>> lambda_t(img).shape
+        (1, 1, 2)
+
+    Args:
+        func: callable applied to the input value; its return value is returned unchanged.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
