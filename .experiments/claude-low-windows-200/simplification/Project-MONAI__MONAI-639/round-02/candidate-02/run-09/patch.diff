+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_callable(self):
+        img = self.imt
+        data = {"img": img}
+        lambda_t = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambda_t(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing_callable(self):
+        img = self.imt
+        data = {"img": img}
+        lambda_t = Lambdad(keys=data.keys(), func=lambda x: x[..., 10:100, ::-2])
+        result = lambda_t(data)
+        expected = img[..., 10:100, ::-2]
+        self.assertEqual(result["img"].shape, expected.shape)
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(expected, result["img"]))
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        extra = np.arange(5)
+        data = {"img": img, "extra": extra}
+        lambda_t = Lambdad(keys=["img"], func=lambda x: x[..., 10:100, ::-2])
+        result = lambda_t(data)
+        self.assertIs(result["extra"], extra)
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
