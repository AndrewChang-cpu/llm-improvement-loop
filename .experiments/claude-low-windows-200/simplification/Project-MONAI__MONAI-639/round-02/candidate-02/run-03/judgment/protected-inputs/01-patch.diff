+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_slice(self):
+        img = self.imt
+        data = dict()
+        data["img"] = img
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:100, ::-2])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:100, ::-2])
+        self.assertGreater(result["img"].size, 0)
+        # the original mapping is not modified
+        self.assertIs(data["img"], img)
+
+    def test_unlisted_key_preserved(self):
+        img = self.imt
+        extra = 7
+        data = {"img": img, "extra": extra}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:100, ::-2])(data)
+        np.testing.assert_array_equal(result["img"], img[:, :, 10:100, ::-2])
+        self.assertEqual(result["extra"], extra)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
