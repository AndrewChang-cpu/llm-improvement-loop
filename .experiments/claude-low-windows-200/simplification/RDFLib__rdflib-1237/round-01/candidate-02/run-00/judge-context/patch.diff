+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_prefix_contains(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "full URI beginning with namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text itself should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "SHACL URI should be a member of SH",
+        )
+
+    def test_rdfs_closed_contains(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined RDFS term should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with defined term text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with defined term text should not be a member",
+        )
+
+    def test_rdf_closed_contains(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined RDF term should be a member of RDF",
+        )
+        self.assertFalse(
+            RDF._1 in RDF,
+            "container membership property should not be a member of RDF",
+        )
+
