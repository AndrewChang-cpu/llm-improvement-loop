+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
+from rdflib.term import Literal
 from rdflib.term import URIRef
 
 
@@ -112,3 +113,54 @@ class NamespacePrefixTest(unittest.TestCase):
             add_not_in_namespace("givenName"),
             URIRef("http://xmlns.com/foaf/0.1/givenName"),
         )
+
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "the namespace text itself should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "a SHACL URI should be a member of SH",
+        )
+
+    def test_rdfs_closed_membership(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "a defined RDFS term should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "a term sharing the RDFS base but not defined should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "a plain string should not be a member of RDFS",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "a Literal with the term text should not be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#_1") in RDFS,
+            "a container membership property should not be a member of RDFS",
+        )
+
+    def test_rdf_closed_membership(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "a defined RDF term should be a member of RDF",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "a container membership property should not be a member of RDF",
+        )
