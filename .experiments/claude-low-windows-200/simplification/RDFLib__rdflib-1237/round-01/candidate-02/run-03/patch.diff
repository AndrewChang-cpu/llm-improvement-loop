diff --git a/rdflib/namespace.py b/rdflib/namespace.py
index aa1b4d0..20e29ab 100644
--- a/rdflib/namespace.py
+++ b/rdflib/namespace.py
@@ -142,6 +142,19 @@ class Namespace(str):
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
+    def __contains__(self, ref):
+        """
+        Prefix membership: ``ref`` belongs to this namespace when its text
+        begins with the namespace text.
+
+        >>> n = Namespace("http://example.org/")
+        >>> "http://example.org/thing" in n
+        True
+        >>> "http://example.org" in n
+        False
+        """
+        return ref.startswith(self)
+
 
 class URIPattern(str):
 
@@ -214,8 +227,22 @@ class ClosedNamespace(object):
     def __dir__(self):
         return list(self._ClosedNamespace__uris)
 
+    def __contains__(self, ref):
+        """
+        Closed membership: ``ref`` must be a URIRef equal (node-type-aware)
+        to one of the full URIs of the defined terms.
+
+        >>> RDFS = ClosedNamespace(
+        ...     URIRef("http://www.w3.org/2000/01/rdf-schema#"), ["label"])
+        >>> URIRef("http://www.w3.org/2000/01/rdf-schema#label") in RDFS
+        True
+        >>> "http://www.w3.org/2000/01/rdf-schema#label" in RDFS
+        False
+        """
+        return any(ref == uri for uri in self.__uris.values())
+
     def _ipython_key_completions_(self):
-        return dir(self)
+        return dir(str(self.uri))
 
 
 class _RDFNamespace(ClosedNamespace):
