+from rdflib.namespace import FOAF, RDF, RDFS, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_contains_prefix_positive(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with namespace text should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text itself should be a member",
+        )
+
+    def test_namespace_contains_prefix_negative(self):
+        ns = Namespace("http://example.org/")
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "URI merely containing namespace text should not be a member",
+        )
+
+    def test_rdfs_closed_contains(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined RDFS term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with same text as a term should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with same text as a term should not be a member",
+        )
+
+    def test_rdf_closed_contains(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined RDF term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership property should not be a member",
+        )
+
