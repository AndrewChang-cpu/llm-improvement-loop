+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_contains_prefix(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "a reference equal to the namespace text should be a member",
+        )
+
+    def test_sh_contains(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "a SHACL URI should be a member of SH",
+        )
+
+    def test_rdfs_closed_contains(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "a defined RDFS term should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "an undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "a plain string should not be a member of RDFS",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "a Literal should not be a member of RDFS",
+        )
+
+    def test_rdf_closed_contains(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "a defined RDF term should be a member of RDF",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "a container membership property should not be a member of RDF",
+        )
+
