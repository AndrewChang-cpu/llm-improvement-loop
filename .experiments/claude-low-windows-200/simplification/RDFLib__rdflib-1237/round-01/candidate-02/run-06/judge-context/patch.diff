+class NamespaceMembershipTest(unittest.TestCase):
+    def test_prefix_membership_positive(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with namespace text should be a member",
+        )
+
+    def test_prefix_membership_proper_prefix_negative(self):
+        ns = Namespace("http://example.org/")
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of namespace text should not be a member",
+        )
+
+    def test_prefix_membership_self(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text should be a member of itself",
+        )
+
+    def test_rdfs_closed_membership_positive(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined RDFS term should be a member",
+        )
+
+    def test_rdfs_closed_membership_undefined_term_negative(self):
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+
+    def test_rdfs_closed_membership_non_uriref_negative(self):
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "plain string should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "Literal with identical text should not be a member",
+        )
+
+    def test_rdf_closed_membership_positive(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined RDF term should be a member",
+        )
