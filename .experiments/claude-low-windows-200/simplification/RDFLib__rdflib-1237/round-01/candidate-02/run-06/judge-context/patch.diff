         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """
+        Prefix membership: ``ref in ns`` is True when the text of ``ref``
+        begins with the namespace text.
+
+        >>> from rdflib.term import URIRef
+        >>> n = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/thing") in n
+        True
+        >>> URIRef("http://example.org") in n
+        False
+        """
+        return ref.startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
@@ -211,11 +225,27 @@ class ClosedNamespace(object):
     def __repr__(self):
         return "rdf.namespace.ClosedNamespace(%r)" % str(self.uri)
 
+    def __contains__(self, ref):
+        """
+        Closed membership: ``ref in ns`` is True only when ``ref`` is a
+        URIRef equal (node-type-aware) to one of the stored term URIs.
+
+        >>> from rdflib.term import URIRef
+        >>> ns = ClosedNamespace(URIRef("http://example.org/"), ["a"])
+        >>> URIRef("http://example.org/a") in ns
+        True
+        >>> URIRef("http://example.org/b") in ns
+        False
+        >>> "http://example.org/a" in ns
+        False
+        """
+        return any(ref == uri for uri in self.__uris.values())
+
     def __dir__(self):
         return list(self._ClosedNamespace__uris)
 
     def _ipython_key_completions_(self):
-        return dir(self)
+        return dir(self.uri)
 
 
 class _RDFNamespace(ClosedNamespace):
