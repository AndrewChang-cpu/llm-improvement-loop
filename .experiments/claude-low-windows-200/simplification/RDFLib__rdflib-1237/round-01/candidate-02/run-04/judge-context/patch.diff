+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        """Namespace membership is a prefix test on the reference's text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "the namespace text itself should be a member",
+        )
+
+    def test_closed_namespace_membership(self):
+        """RDFS membership is closed: only defined terms are members"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "a term sharing the base URI but not defined should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "a plain string with term text should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "a Literal with term text should not be a member",
+        )
+
+    def test_rdf_closed_namespace_membership(self):
+        """RDF membership is closed for defined terms"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership properties are not stored members",
+        )
+
+    def test_sh_namespace_membership(self):
+        """SH is a Namespace, so membership is a prefix test"""
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "a URI beginning with the SHACL namespace should be a member",
+        )
+
