+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        """Namespace membership is a text-prefix test on the reference"""
+        ex = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ex,
+            "full URI beginning with namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ex,
+            "proper prefix of namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ex,
+            "URI merely containing namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ex,
+            "reference equal to namespace text should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "SHACL URI should be a member of SH",
+        )
+
+    def test_rdfs_closed_membership(self):
+        """ClosedNamespace membership requires a defined term URIRef"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined term rdfs:label should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the base should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#_1") in RDFS,
+            "container membership property should not be a closed member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "plain string with defined term text should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "Literal with defined term text should not be a member",
+        )
+
+    def test_rdf_closed_membership(self):
+        """RDF closed membership accepts defined RDF terms"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined term rdf:type should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership property should not be a closed member",
+        )
+
