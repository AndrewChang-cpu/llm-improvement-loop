+class NamespaceMembershipTest(unittest.TestCase):
+    def test_prefix_membership_positive(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+
+    def test_prefix_membership_proper_prefix_negative(self):
+        ns = Namespace("http://example.org/")
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+
+    def test_prefix_membership_self(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "the namespace text itself should be a member",
+        )
+
+    def test_prefix_membership_sh(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "a SHACL URI should be a member of SH",
+        )
+
+    def test_closed_membership_rdfs_defined(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "a defined RDFS term should be a member of RDFS",
+        )
+
+    def test_closed_membership_rdfs_undefined(self):
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "a term sharing the RDFS base but not defined should not be a member",
+        )
+
+    def test_closed_membership_rdfs_plain_string(self):
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "a plain string with a defined term's text should not be a member",
+        )
+
+    def test_closed_membership_rdfs_literal(self):
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "a Literal with a defined term's text should not be a member",
+        )
+
+    def test_closed_membership_rdf_defined(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "a defined RDF term should be a member of RDF",
+        )
+
+    def test_closed_membership_container_property(self):
+        self.assertFalse(
+            RDF._1 in RDF,
+            "a container membership property is not a stored term",
+        )
+
+    def test_closed_membership_returns_bool(self):
+        self.assertIs(RDFS.label in RDFS, True)
+        self.assertIs(URIRef("http://example.org/x") in RDFS, False)
