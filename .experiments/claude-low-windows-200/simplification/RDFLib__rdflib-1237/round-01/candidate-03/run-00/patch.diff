+
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with namespace text should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text itself should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "URI containing but not beginning with namespace text is not a member",
+        )
+
+    def test_sh_prefix_membership(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "sh:example should be a member of SH",
+        )
+
+    def test_rdfs_closed_membership(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "rdfs:example shares the base but is not defined",
+        )
+
+    def test_rdfs_non_uriref_membership(self):
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string equal to a term URI is not a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal equal to a term URI is not a member",
+        )
+
+    def test_rdf_closed_membership(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type should be a member of RDF",
+        )
+        self.assertFalse(
+            RDF._1 in RDF,
+            "container membership property is not a stored term",
+        )
