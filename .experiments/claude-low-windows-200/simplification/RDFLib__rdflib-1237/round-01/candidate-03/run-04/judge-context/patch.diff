+
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text itself should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of the namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("urn:http://example.org/thing") in ns,
+            "URI containing but not beginning with namespace text is not a member",
+        )
+
+    def test_closed_namespace_membership(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined RDFS term should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "plain Literal with a defined term's text should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with a defined term's text should not be a member",
+        )
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined RDF term should be a member of RDF",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership property is not a stored term",
+        )
+
+    def test_shacl_namespace_membership(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "SHACL URI should be a member of SH",
+        )
