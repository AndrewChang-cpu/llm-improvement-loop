+    def __contains__(self, ref):
+        """
+        Prefix membership: True if ``ref`` begins with this namespace's text.
+
+        >>> from rdflib import Namespace, URIRef
+        >>> n = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/thing") in n
+        True
+        >>> URIRef("http://example.org") in n
+        False
+        """
+        return ref.startswith(self)
