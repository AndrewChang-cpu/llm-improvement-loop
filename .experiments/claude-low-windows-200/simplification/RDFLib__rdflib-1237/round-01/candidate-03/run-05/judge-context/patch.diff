@@ -211,11 +224,18 @@ class ClosedNamespace(object):
     def __repr__(self):
         return "rdf.namespace.ClosedNamespace(%r)" % str(self.uri)
 
+    def __contains__(self, ref):
+        """
+        Closed membership: True only if ``ref`` is a URIRef equal to a stored
+        term URI. Shared base text alone does not count.
+        """
+        return any(uri == ref for uri in self.__uris.values())
+
     def __dir__(self):
         return list(self._ClosedNamespace__uris)
 
