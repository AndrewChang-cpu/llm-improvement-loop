+class NamespaceMembershipTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "full URI beginning with namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "reference equal to namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("urn:x/http://example.org/thing") in ns,
+            "URI containing namespace text but not beginning with it",
+        )
+
+    def test_shacl_prefix_membership(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "SHACL term should be a member of SH",
+        )
+
+    def test_rdfs_closed_membership(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined term rdfs:label should be a member of RDFS",
+        )
+        self.assertFalse(
+            RDFS.example in RDFS,
+            "rdfs:example shares base but is not defined",
+        )
+
+    def test_rdfs_closed_membership_non_uriref(self):
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with defined term text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with defined term text should not be a member",
+        )
+
+    def test_rdf_closed_membership(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined term rdf:type should be a member of RDF",
+        )
+
+    def test_container_property_not_closed_member(self):
+        self.assertFalse(
+            RDF._1 in RDF,
+            "container membership property is not a stored term",
+        )
