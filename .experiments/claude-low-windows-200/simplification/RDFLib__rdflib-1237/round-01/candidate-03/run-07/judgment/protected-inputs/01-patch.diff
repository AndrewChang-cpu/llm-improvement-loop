+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_in_prefix_positive(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with namespace text should be a member",
+        )
+
+    def test_in_prefix_negative_proper_prefix(self):
+        ns = Namespace("http://example.org/")
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "A proper prefix of the namespace text should not be a member",
+        )
+
+    def test_in_prefix_self(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "A reference equal to the namespace text should be a member",
+        )
+
+    def test_in_prefix_sh(self):
+        self.assertTrue(
+            SH.example in SH,
+            "sh:example should be a member of SH",
+        )
+
+    def test_in_closed_rdfs_positive(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member of RDFS",
+        )
+
+    def test_in_closed_rdfs_negative_undefined(self):
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "An undefined term sharing the base URI should not be a member",
+        )
+
+    def test_in_closed_rdfs_non_uriref(self):
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "A plain string with a defined term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "A Literal with a defined term's text should not be a member",
+        )
+
+    def test_in_closed_rdf_positive(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member of RDF",
+        )
+
+    def test_in_closed_rdf_container_property(self):
+        self.assertFalse(
+            RDF._1 in RDF,
+            "Container membership properties are not stored terms",
+        )
+
     def test_compute_qname(self):
