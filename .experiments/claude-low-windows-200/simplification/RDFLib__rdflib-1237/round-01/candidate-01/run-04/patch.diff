+
+    def test_namespace_prefix_membership(self):
+        """A reference is a member when it begins with the namespace text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "reference equal to namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "URI containing namespace text but not beginning with it",
+        )
+
+    def test_shacl_prefix_membership(self):
+        """A SHACL URI is a member of the SH namespace"""
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#NodeShape") in SH,
+            "SHACL URI should be a member of SH",
+        )
+
+    def test_rdfs_closed_membership(self):
+        """Defined RDFS terms are members; undefined ones are not"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing RDFS base should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "plain Literal with term text should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with term text should not be a member",
+        )
+
+    def test_rdf_closed_membership(self):
+        """Defined RDF terms are members; container properties are not"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type should be a member of RDF",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership property should not be a member",
+        )
