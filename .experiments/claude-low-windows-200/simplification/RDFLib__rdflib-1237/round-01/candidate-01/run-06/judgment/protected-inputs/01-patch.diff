@@ -205,6 +217,21 @@ class ClosedNamespace(object):
             except KeyError as e:
                 raise AttributeError(e)
 
+    def __contains__(self, ref):
+        """Closed membership: True only if ``ref`` is a URIRef equal to a
+        stored term URI. Container properties such as ``rdf:_1`` are not
+        stored, so they are not members.
+
+        >>> from rdflib import URIRef
+        >>> from rdflib.namespace import RDFS
+        >>> URIRef("http://www.w3.org/2000/01/rdf-schema#label") in RDFS
+        True
+        >>> URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS
+        False
+        """
+        # URIRef is on the left so its node-type-aware __eq__ runs first.
+        return any(uri == ref for uri in self.__uris.values())
+
     def __str__(self):
         return str(self.uri)
 
