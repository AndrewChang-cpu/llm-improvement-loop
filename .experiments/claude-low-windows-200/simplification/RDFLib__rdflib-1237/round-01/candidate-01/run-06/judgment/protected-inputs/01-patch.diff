+
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        # proper prefix of the namespace text: reversed direction would wrongly pass
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "a reference equal to the namespace text should be a member",
+        )
+        self.assertTrue(
+            SH.NodeShape in SH,
+            "a SHACL term should be a member of the SHACL namespace",
+        )
+
+    def test_rdfs_closed_membership(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "an undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "a Literal with the term text should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "a plain string with the term text should not be a member",
+        )
+
+    def test_rdf_closed_membership(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership properties are not stored terms",
+        )
