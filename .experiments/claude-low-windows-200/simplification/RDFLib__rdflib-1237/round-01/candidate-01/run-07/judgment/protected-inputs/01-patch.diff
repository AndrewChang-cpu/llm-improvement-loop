 class NamespacePrefixTest(unittest.TestCase):
@@ -112,3 +112,57 @@ class NamespacePrefixTest(unittest.TestCase):
             add_not_in_namespace("givenName"),
             URIRef("http://xmlns.com/foaf/0.1/givenName"),
         )
+
+    def test_namespace_prefix_membership(self):
+        """Prefix membership on an open Namespace"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        # the namespace text without its trailing slash is a proper prefix
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "the namespace text itself should be a member",
+        )
+
+    def test_shacl_namespace_membership(self):
+        """SH is an open Namespace; prefix membership applies"""
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#NodeShape") in SH,
+            "a URI beginning with the SHACL namespace should be a member",
+        )
+
+    def test_rdfs_closed_membership(self):
+        """Closed membership on RDFS"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "a defined RDFS term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "an undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "a plain string with a term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "a Literal with a term's text should not be a member",
+        )
+
+    def test_rdf_closed_membership(self):
+        """Closed membership on RDF, including container membership properties"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "a defined RDF term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "a container membership property should not be a member",
+        )
