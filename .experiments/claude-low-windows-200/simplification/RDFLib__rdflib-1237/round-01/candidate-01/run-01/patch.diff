 class NamespacePrefixTest(unittest.TestCase):
@@ -112,3 +112,50 @@ class NamespacePrefixTest(unittest.TestCase):
             add_not_in_namespace("givenName"),
             URIRef("http://xmlns.com/foaf/0.1/givenName"),
