@@ -142,6 +142,20 @@ class Namespace(str):
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
+    def __contains__(self, ref):
+        """
+        Prefix membership: True when the reference's text begins with
+        this namespace's text.
+
+        >>> from rdflib import Namespace
+        >>> ns = Namespace("http://example.org/")
+        >>> "http://example.org/thing" in ns
+        True
+        >>> "http://example.org" in ns
+        False
+        """
+        return bool(ref.startswith(self))
+
 
 class URIPattern(str):
 
@@ -196,6 +210,13 @@ class ClosedNamespace(object):
     def __getitem__(self, key, default=None):
         return self.term(key)
 
+    def __contains__(self, ref):
+        """
+        Closed membership: True only when ref is a URIRef equal to one of
+        the full term URIs defined for this namespace.
+        """
+        return any(uri == ref for uri in self.__uris.values())
+
     def __getattr__(self, name):
         if name.startswith("__"):  # ignore any special Python names!
             raise AttributeError
