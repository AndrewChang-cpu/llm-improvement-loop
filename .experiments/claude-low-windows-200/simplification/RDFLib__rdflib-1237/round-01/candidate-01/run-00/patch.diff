+from rdflib.namespace import FOAF, RDF, RDFS, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        """Namespace membership is a prefix test on the reference's text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "a reference equal to the namespace text should be a member",
+        )
+
+    def test_closed_namespace_membership(self):
+        """ClosedNamespace membership requires a defined term URIRef"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "an undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "a Literal with the text of a term URI should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "a plain string with the text of a term URI should not be a member",
+        )
+
+    def test_rdf_closed_namespace_membership(self):
+        """RDF membership for defined terms, and not for container properties"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "a container membership property should not be a member",
+        )
+
