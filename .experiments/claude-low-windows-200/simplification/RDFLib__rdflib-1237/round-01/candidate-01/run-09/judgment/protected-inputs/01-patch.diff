+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_contains_prefix(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "a URI containing but not beginning with the text is not a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "a reference equal to the namespace text should be a member",
+        )
+
+    def test_shacl_namespace_contains(self):
+        self.assertTrue(
+            URIRef(SH.NodeShape) in SH,
+            "a SHACL term URI should be a member of SH",
+        )
+
+    def test_rdfs_closed_contains(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "an undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "a Literal with the term text should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "a plain string with the term text should not be a member",
+        )
+
+    def test_rdf_closed_contains(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
+        self.assertFalse(
+            RDF._1 in RDF,
+            "a container membership property is not a stored term",
+        )
+
