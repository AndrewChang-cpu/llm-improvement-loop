+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,85 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:seqWithAlt sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMoreInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:oneOrMoreIri sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOneIri sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:noRest sh:path _:noRestL1 .
+_:noRestL1 rdf:first ex:p ; rdf:rest _:noRestL2 .
+_:noRestL2 rdf:first ex:q .
+ex:emptyList sh:path () .
+ex:oneItemSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.seq, EX.p / EX.q / EX.r),
+        (EX.seqWithAlt, EX.p / (EX.q | EX.r)),
+        (EX.inv, ~EX.p),
+        (EX.zeroOrMoreInv, ~EX.p * "*"),
+        (EX.oneOrMoreIri, EX.p * "+"),  # type: ignore[operator]
+        (EX.zeroOrOneIri, EX.p * "?"),  # type: ignore[operator]
+        (EX.noRest, EX.p / EX.q),
+        (EX.emptyList, SHACLPathError),
+        (EX.oneItemSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneItemAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    plain = "http://example.org/p"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, plain)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
