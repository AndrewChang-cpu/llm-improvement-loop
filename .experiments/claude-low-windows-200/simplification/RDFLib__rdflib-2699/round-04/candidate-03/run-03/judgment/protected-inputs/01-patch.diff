@@ -0,0 +1,104 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a SHACL path structure is malformed."""
+
+
+def _is_node(value: object) -> bool:
+    return isinstance(value, Node)
+
+
+# The recursive conversion of SHACL path structures into property paths follows
+# the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following, where each nested path is
+    itself a valid SHACL path:
+
+    * an IRI, which denotes a plain predicate;
+    * an RDF list of two or more paths, which denotes a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of two or more paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``
+      or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The graph holding the shapes. It is only read.
+    :param path_identifier: The object node of a ``sh:path`` triple.
+    :return: A ``URIRef`` for a plain predicate, or a ``Path`` for a complex
+        path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path structure is malformed or the input is
+        not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if not _is_node(path_identifier):
+        raise SHACLPathError(
+            f"Not a node, so not a valid SHACL path: {path_identifier!r}"
+        )
+
+    # An IRI is a path of length one, unless it is rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list of paths: sequence path.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "A sequence path must have at least two items: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: an RDF list of paths.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "An alternative path must have at least two items: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..54d9a3f
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq3 sh:path ( ex:a ex:b ex:c ) .
+ex:seqNested sh:path ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:inverseZeroOrMore sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:openList sh:path _:l1 .
+_:l1 rdf:first ex:a ; rdf:rest _:l2 .
+_:l2 rdf:first ex:b .
+ex:nilPath sh:path () .
+ex:seqOne sh:path ( ex:a ) .
+ex:seqWithNil sh:path ( ex:a () ) .
+ex:altEmpty sh:path [ sh:alternativePath () ] .
+ex:altOne sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknownBlank sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param("iri", EX.p, id="iri"),
+        pytest.param("seq3", EX.a / EX.b / EX.c, id="sequence-of-three"),
+        pytest.param(
+            "seqNested", EX.a / (EX.b | EX.c), id="sequence-with-nested-alternative"
+        ),
+        pytest.param("inverse", ~EX.p, id="inverse"),
+        pytest.param(
+            "zeroOrMore",
+            EX.p * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            "oneOrMore",
+            EX.p * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            "zeroOrOne",
+            EX.p * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param("inverseZeroOrMore", ~EX.p * "*", id="zero-or-more-of-inverse"),
+        pytest.param("openList", EX.a / EX.b, id="list-without-rdf-rest"),
+        pytest.param("nilPath", SHACLPathError, id="rdf-nil-as-path"),
+        pytest.param("seqOne", SHACLPathError, id="sequence-one-item"),
+        pytest.param("seqWithNil", SHACLPathError, id="nil-as-sequence-item"),
+        pytest.param("altEmpty", SHACLPathError, id="alternative-empty"),
+        pytest.param("altOne", SHACLPathError, id="alternative-one-item"),
+        pytest.param("unknownBlank", SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literal", TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triples_before = set(shapes)
+    path_node = shapes.value(EX[shape], SH.path)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+    assert set(shapes) == triples_before
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(shapes: Graph, value: object) -> None:
+    triples_before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, value)  # type: ignore[arg-type]
+    assert set(shapes) == triples_before
