@@ -0,0 +1,92 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import BNode, Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+# The recursive procedure below follows the SHACL-to-SPARQL property path
+# conversion in pyshacl, which is the basis of this implementation.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is an IRI naming a plain predicate, or a blank node
+    (or RDF list) that is one of: a sequence (an RDF list of at least two
+    paths), an alternative (``sh:alternativePath`` whose value is an RDF
+    list of at least two paths), an inverse (``sh:inversePath``), or a
+    modifier (``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``). Nested paths are parsed recursively.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the object node of a ``sh:path`` triple.
+    :return: a ``URIRef`` for a plain predicate, or a ``Path`` for a
+        complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path structure is malformed or the input
+        is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if not isinstance(path_identifier, (URIRef, BNode)):
+        raise SHACLPathError(
+            f"Not a node, cannot be a SHACL path: {path_identifier!r}"
+        )
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list: sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
new file mode 100644
index 0000000..ab7af56
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+from contextlib import suppress
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:sequence_of_inverse sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modified_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:open_list sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+ex:nil_path sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:nil_item_sequence sh:path ( ex:p1 () ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal_path sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        ("iri", EX.p1),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("nested_sequence", EX.p1 / (EX.p2 | EX.p3)),
+        ("sequence_of_inverse", EX.p1 / (~EX.p2)),
+        ("inverse", ~EX.p1),
+        ("zero_or_more", EX.p1 * "*"),  # type: ignore[operator]
+        ("one_or_more", EX.p1 * "+"),  # type: ignore[operator]
+        ("zero_or_one", EX.p1 * "?"),  # type: ignore[operator]
+        ("modified_inverse", (~EX.p1) * "*"),
+        ("open_list", EX.p1 / EX.p2),
+        ("nil_path", SHACLPathError),
+        ("one_item_sequence", SHACLPathError),
+        ("nil_item_sequence", SHACLPathError),
+        ("empty_alternative", SHACLPathError),
+        ("one_item_alternative", SHACLPathError),
+        ("unrecognized", SHACLPathError),
+        ("literal_path", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("value", [None, "p1"])
+def test_non_node_input_raises(shapes_graph: Graph, value: Optional[str]) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, value)  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for path_node in list(shapes_graph.objects(predicate=SH.path)):
+        with suppress(SHACLPathError, TypeError):
+            parse_shacl_path(shapes_graph, path_node)
+    assert set(shapes_graph) == before
