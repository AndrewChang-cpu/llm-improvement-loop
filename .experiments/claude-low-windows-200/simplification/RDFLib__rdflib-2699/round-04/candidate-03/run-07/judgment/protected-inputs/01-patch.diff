@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:a ex:b ex:c ) .
+ex:sequenceNoRest sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:sequenceNested sh:path ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySequence sh:path ( ) .
+ex:oneItemSequence sh:path ( ex:a ) .
+ex:emptyAlternative sh:path [ sh:alternativePath ( ) ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unrecognized sh:path [ ex:other ex:a ] .
+ex:literal sh:path "p" .
+"""
+
+Expected = Union[URIRef, Path, Type[Exception]]
+
+VALID_CASES: list[tuple[URIRef, Expected]] = [
+    (EX.iri, EX.p),
+    (EX.sequence, EX.a / EX.b / EX.c),
+    (EX.sequenceNoRest, EX.a / EX.b),
+    (EX.sequenceNested, EX.a / (EX.b | EX.c)),
+    (EX.inverse, ~EX.p),
+    (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+    (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+    (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+    (EX.modifiedInverse, (~EX.p) * "+"),
+    (EX.alternative, EX.a | EX.b),
+]
+
+INVALID_CASES: list[tuple[URIRef, Expected]] = [
+    (EX.nilPath, SHACLPathError),
+    (EX.emptySequence, SHACLPathError),
+    (EX.oneItemSequence, SHACLPathError),
+    (EX.emptyAlternative, SHACLPathError),
+    (EX.oneItemAlternative, SHACLPathError),
+    (EX.unrecognized, SHACLPathError),
+    (EX.literal, TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    VALID_CASES + INVALID_CASES,
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Expected,
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+def test_parse_shacl_path_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape, _ in VALID_CASES + INVALID_CASES:
+        path_node = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
+
+
+def test_parse_shacl_path_rejects_non_node_input(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    plain_string = "http://example.org/shapes#p"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, plain_string)  # type: ignore[arg-type]
