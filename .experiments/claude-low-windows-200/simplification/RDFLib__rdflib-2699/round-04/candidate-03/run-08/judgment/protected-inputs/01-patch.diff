+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a SHACL path structure is malformed."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a SHACL ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is an IRI naming a plain predicate, or a blank node
+    (or RDF list) built from the SHACL path predicates ``sh:inversePath``,
+    ``sh:alternativePath``, ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` and
+    ``sh:zeroOrOnePath``, or an RDF list of at least two paths forming a
+    sequence path. ``rdf:nil`` is never a valid path.
+
+    :param shapes_graph: The graph holding the shapes. It is only read.
+    :param path_identifier: The path node, i.e. the object of the ``sh:path``
+        triple. It must be an IRI or a blank node; a Literal is rejected.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` instance for a complex path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path structure is malformed or the input
+        is not a node.
+    """
+    # 1. Literals are never valid paths.
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+
+    # 2. An IRI is a plain predicate, except rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Anything that is not a node (e.g. None or a plain string) must not reach
+    # the triple lookups below, where None would act as a wildcard.
+    if not isinstance(path_identifier, Node):  # type: ignore[unreachable]
+        raise SHACLPathError(
+            f"Not a node, so not a SHACL path: {path_identifier!r}"
+        )
+
+    # 3. An RDF list is a sequence path (rdf:first).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"SHACL sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # 4. sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # 5. sh:alternativePath (value is an RDF list)
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "SHACL alternative path needs at least two items: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # 6. Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    # 7. Nothing recognized.
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
