+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from typing import List, Optional, Set, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:simple sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:open_list sh:path _:l1 .
+_:l1 rdf:first ex:p1 ;
+    rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:inverse_zero_or_more sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:empty_list sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal_path sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.bind("ex", EX)
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _path_of(graph: Graph, shape_name: str) -> Optional[Node]:
+    return graph.value(EX[shape_name], SH.path)
+
+
+VALID_CASES: List[Tuple[str, Union[URIRef, Path]]] = [
+    ("simple", EX.p),
+    ("sequence", EX.p1 / EX.p2 / EX.p3),
+    ("nested_sequence", EX.p1 / (EX.p2 / EX.p3)),
+    ("open_list", EX.p1 / EX.p2),
+    ("alternative", EX.p1 | EX.p2),
+    ("inverse", ~EX.p),
+    ("zero_or_more", EX.p * "*"),  # type: ignore[operator]
+    ("one_or_more", EX.p * "+"),  # type: ignore[operator]
+    ("zero_or_one", EX.p * "?"),  # type: ignore[operator]
+    ("inverse_zero_or_more", ~EX.p * "*"),
+]
+
+INVALID_CASES: List[Tuple[str, Type[Exception]]] = [
+    ("empty_list", SHACLPathError),  # rdf:nil as a path, and an empty sequence
+    ("one_item_sequence", SHACLPathError),
+    ("empty_alternative", SHACLPathError),
+    ("one_item_alternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal_path", TypeError),
+]
+
+ALL_CASES: List[Tuple[str, Union[URIRef, Path, Type[Exception]]]] = [
+    *VALID_CASES,
+    *INVALID_CASES,
+]
+ALL_SHAPE_NAMES = [name for name, _ in ALL_CASES]
+
+
+@pytest.mark.parametrize("shape_name, expected", ALL_CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = _path_of(shapes_graph, shape_name)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("shape_name", ALL_SHAPE_NAMES)
+def test_parse_does_not_modify_graph(shapes_graph: Graph, shape_name: str) -> None:
+    before: Set[Tuple[Node, Node, Node]] = set(shapes_graph)
+    path_node = _path_of(shapes_graph, shape_name)
+    try:
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    except (SHACLPathError, TypeError):
+        pass
+    assert set(shapes_graph) == before
+
+
+def test_none_input_raises_shacl_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+
+
+def test_string_input_raises_shacl_error(shapes_graph: Graph) -> None:
+    plain: str = "http://example.org/p"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, plain)  # type: ignore[arg-type]
