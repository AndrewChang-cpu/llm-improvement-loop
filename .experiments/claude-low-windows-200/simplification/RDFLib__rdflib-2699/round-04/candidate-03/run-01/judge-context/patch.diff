index 0000000..34b1d0f
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:plain sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nestedSequence sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ) .
+ex:truncatedList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:emptyList sh:path ( ) .
+ex:nil sh:path rdf:nil .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:singleCellList sh:path [ rdf:first ex:p1 ] .
+ex:emptyAlternative sh:path [ sh:alternativePath ( ) ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("plain", EX.p1),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("inverse", ~EX.p1),
+        ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+        ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+        ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+        ("alternative", EX.p1 | EX.p2),
+        ("modifiedInverse", (~EX.p1) * "*"),
+        ("nestedSequence", EX.p1 / ~EX.p2),
+        ("truncatedList", EX.p1 / EX.p2),
+        ("emptyList", SHACLPathError),
+        ("nil", SHACLPathError),
+        ("oneItemSequence", SHACLPathError),
+        ("singleCellList", SHACLPathError),
+        ("emptyAlternative", SHACLPathError),
+        ("oneItemAlternative", SHACLPathError),
+        ("unrecognized", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: object
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("sequence", "emptyList", "literal", "unrecognized"):
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
