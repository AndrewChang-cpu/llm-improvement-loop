@@ -0,0 +1,112 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:plain sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:sequence_with_inverse sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ) .
+ex:unterminated_sequence sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifier_of_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+
+ex:nil_path sh:path rdf:nil .
+ex:empty_list sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:unrelated ex:p ] .
+ex:literal_path sh:path "ex:p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        (EX.plain, EX.p),
+        (EX.sequence, EX.p1 / EX.p2 / EX.p3),
+        (EX.nested_sequence, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.sequence_with_inverse, EX.p1 / ~EX.p2),
+        (EX.unterminated_sequence, EX.p1 / EX.p2),
+        (EX.inverse, ~EX.p),
+        (EX.zero_or_more, EX.p * "*"),  # type: ignore[operator]
+        (EX.one_or_more, EX.p * "+"),  # type: ignore[operator]
+        (EX.zero_or_one, EX.p * "?"),  # type: ignore[operator]
+        (EX.modifier_of_inverse, ~EX.p * "*"),
+        (EX.alternative, EX.p1 | EX.p2),
+    ],
+)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected_exception"),
+    [
+        (EX.nil_path, SHACLPathError),
+        (EX.empty_list, SHACLPathError),
+        (EX.one_item_sequence, SHACLPathError),
+        (EX.empty_alternative, SHACLPathError),
+        (EX.one_item_alternative, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal_path, TypeError),
+    ],
+)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected_exception: type[Exception],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(expected_exception):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    plain_string = "http://example.org/p"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, plain_string)  # type: ignore[arg-type]
+
+
+def test_parser_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for path_node in list(shapes_graph.objects(predicate=SH.path)):
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
