@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from typing import List, Optional, Set, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/shapes#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p .
+ex:seqShape sh:path (ex:a ex:b ex:c) .
+ex:nestedSeqShape sh:path (ex:a [ sh:alternativePath (ex:b ex:c) ]) .
+ex:invShape sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInvShape sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:altShape sh:path [ sh:alternativePath (ex:a ex:b) ] .
+ex:noTailShape sh:path _:l1 .
+_:l1 rdf:first ex:a ; rdf:rest _:l2 .
+_:l2 rdf:first ex:b .
+
+ex:nilShape sh:path () .
+ex:oneSeqShape sh:path (ex:a) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneAltShape sh:path [ sh:alternativePath (ex:a) ] .
+ex:unknownShape sh:path [ ex:foo ex:bar ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+PathOrError = Union[URIRef, Path, Type[Exception]]
+
+CASES: List[Tuple[URIRef, PathOrError]] = [
+    (EX.iriShape, EX.p),
+    (EX.seqShape, EX.a / EX.b / EX.c),
+    (EX.nestedSeqShape, EX.a / (EX.b | EX.c)),
+    (EX.invShape, ~EX.p),
+    (EX.zeroOrMoreShape, EX.p * "*"),  # type: ignore[operator]
+    (EX.oneOrMoreShape, EX.p * "+"),  # type: ignore[operator]
+    (EX.zeroOrOneShape, EX.p * "?"),  # type: ignore[operator]
+    (EX.modInvShape, ~EX.p * "+"),
+    (EX.altShape, EX.a | EX.b),
+    (EX.noTailShape, EX.a / EX.b),
+    (EX.nilShape, SHACLPathError),
+    (EX.oneSeqShape, SHACLPathError),
+    (EX.emptyAltShape, SHACLPathError),
+    (EX.oneAltShape, SHACLPathError),
+    (EX.unknownShape, SHACLPathError),
+    (EX.literalShape, TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(("shape", "expected"), CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: PathOrError,
+) -> None:
+    path: Optional[Node] = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("node", [None, "http://example.org/shapes#p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+def test_shapes_graph_is_not_modified(shapes_graph: Graph) -> None:
+    before: Set[Tuple[Node, Node, Node]] = set(shapes_graph)
+    for shape, _ in CASES:
+        path: Optional[Node] = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
