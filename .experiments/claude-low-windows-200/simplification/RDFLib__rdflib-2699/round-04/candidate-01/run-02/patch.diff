index 0000000..8707cfd
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shapes#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:nestedAlt sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=TURTLE, format="turtle")
+    return g
+
+
+VALID_CASES: list = [
+    ("iri", EX.p1),
+    ("seq", EX.p1 / EX.p2 / EX.p3),
+    ("nestedSeq", EX.p1 / (EX.p2 / EX.p3)),
+    ("nestedAlt", EX.p1 / (EX.p2 | EX.p3)),
+    ("openList", EX.p1 / EX.p2),
+    ("inverse", ~EX.p1),
+    ("alt", EX.p1 | EX.p2),
+    ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+    ("modInverse", (~EX.p1) * "+"),
+]
+
+INVALID_CASES: list = [
+    ("nilPath", SHACLPathError),
+    ("emptySeq", SHACLPathError),
+    ("oneSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneAlt", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+]
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    VALID_CASES + INVALID_CASES,
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes.value(EX[shape_name], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+def test_literal_path_raises_type_error(shapes: Graph) -> None:
+    path_node = shapes.value(EX.literal, SH.path)
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/shapes#p1"])
+def test_non_node_input_raises_shacl_error(shapes: Graph, bad_node: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_node)  # type: ignore[arg-type]
+
+
+def test_graph_is_not_modified(shapes: Graph) -> None:
+    before = set(shapes)
+    for name in ("nilPath", "unrecognized", "oneSeq"):
+        path_node = shapes.value(EX[name], SH.path)
+        with pytest.raises(SHACLPathError):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
