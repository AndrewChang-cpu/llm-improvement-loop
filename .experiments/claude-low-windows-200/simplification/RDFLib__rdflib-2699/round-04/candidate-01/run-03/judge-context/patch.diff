@@ -0,0 +1,101 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    - an IRI (other than ``rdf:nil``), which is returned unchanged
+    - an RDF list of two or more valid paths, a sequence path
+    - a blank node with ``sh:inversePath`` to a valid path
+    - a blank node with ``sh:alternativePath`` to an RDF list of two or
+      more valid paths, an alternative path
+    - a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` to a valid path, a modifier path
+
+    The parser only reads from the graph and never modifies it.
+
+    Based on the SHACL-to-SPARQL path conversion in pyshacl.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a ``URIRef`` for a plain predicate, or a ``Path`` for a
+        complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the node is not a valid SHACL path, including
+        when it is not a node at all.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            "Literals are not valid SHACL paths: %r" % (path_identifier,)
+        )
+    # Checked through an ``object`` alias so the type checker keeps this branch.
+    # Without it, None would act as a wildcard in the triple lookups below.
+    candidate: object = path_identifier
+    if not isinstance(candidate, Node):
+        raise SHACLPathError("SHACL path must be a node, got %r" % (candidate,))
+
+    # A plain predicate IRI; rdf:nil denotes an empty list, not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # A sequence path, given as an RDF list.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "Sequence path must have at least two items: %r"
+                % (path_identifier,)
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath, whose value is an RDF list.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alt_items = list(shapes_graph.items(alternative_value))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                "Alternative path must have at least two items: %r"
+                % (path_identifier,)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # sh:zeroOrMorePath -> "*", sh:oneOrMorePath -> "+", sh:zeroOrOnePath -> "?"
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..7807ab5
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from typing import Any, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p .
+ex:seq3 sh:path ( ex:a ex:b ex:c ) .
+ex:seqNested sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:seqWithAlt sh:path ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] ) .
+ex:seqNoRest sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:a ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknownBlank sh:path [ ex:other ex:a ] .
+ex:literalPath sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("simple", EX.p),
+    ("seq3", EX.a / EX.b / EX.c),
+    ("seqNested", EX.a / (EX.b / EX.c)),
+    ("seqWithAlt", EX.a / (EX.b | EX.c)),
+    ("seqNoRest", EX.a / EX.b),
+    ("alt", EX.a | EX.b),
+    ("inverse", ~EX.p),
+    ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+    ("modInverse", (~EX.p) * "*"),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("emptySeq", SHACLPathError),
+    ("oneSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneAlt", SHACLPathError),
+    ("unknownBlank", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.mark.parametrize(("name", "expected"), VALID_CASES)
+def test_shacl_path(shapes: Graph, name: str, expected: Any) -> None:
+    node = shapes.value(EX[name], SH.path)
+    result = parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(("name", "exc_type"), INVALID_CASES)
+def test_invalid_shacl_path(shapes: Graph, name: str, exc_type: type) -> None:
+    node = shapes.value(EX[name], SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("node", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_error(shapes: Graph, node: Any) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for name, _ in VALID_CASES:
+        node = shapes.value(EX[name], SH.path)
+        parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    for name, exc_type in INVALID_CASES:
+        node = shapes.value(EX[name], SH.path)
+        with pytest.raises(exc_type):
+            parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    assert set(shapes) == before
