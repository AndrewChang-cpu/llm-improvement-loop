index 0000000..06a6093
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,99 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:inversePath ex:p4 ]
+) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modified_inverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:tail_cell_without_rest sh:path ( ex:p1 ex:p2 ) .
+ex:empty sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "p1" .
+"""
+
+# Each case maps a shape name to either the expected parsed path or the
+# exception type that parsing must raise.
+CASES: List[Tuple[str, Union[URIRef, Path, Type[Exception]]]] = [
+    ("iri", EX.p1),
+    ("sequence", EX.p1 / EX.p2 / EX.p3),
+    ("nested", EX.p1 / (EX.p2 | EX.p3) / ~EX.p4),
+    ("inverse", ~EX.p1),
+    ("zero_or_more", EX.p1 * "*"),  # type: ignore[operator]
+    ("one_or_more", EX.p1 * "+"),  # type: ignore[operator]
+    ("zero_or_one", EX.p1 * "?"),  # type: ignore[operator]
+    ("modified_inverse", (~EX.p1) * "+"),
+    ("alternative", EX.p1 | EX.p2),
+    ("tail_cell_without_rest", EX.p1 / EX.p2),
+    ("empty", SHACLPathError),
+    ("one_item_sequence", SHACLPathError),
+    ("empty_alternative", SHACLPathError),
+    ("one_item_alternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(("shape", "expected"), CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_error(
+    shapes_graph: Graph,
+    bad_node: object,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_node)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape, _ in CASES:
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
