index 0000000..9dfb353
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:a ex:b ex:c ) .
+ex:seqNoRest sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:nestedSeq sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:invSeq sh:path ( ex:a [ sh:inversePath ex:b ] ) .
+ex:zom sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oom sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zoo sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:invZom sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:emptyList sh:path () .
+ex:oneSeq sh:path ( ex:a ) .
+ex:seqWithNil sh:path ( ex:a () ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "x" .
+ex:nilPath sh:path rdf:nil .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.seq, EX.a / EX.b / EX.c),
+        (EX.seqNoRest, EX.a / EX.b),
+        (EX.nestedSeq, EX.a / (EX.b / EX.c)),
+        (EX.alt, EX.a | EX.b),
+        (EX.inv, ~EX.p),
+        (EX.invSeq, EX.a / ~EX.b),
+        (EX.zom, EX.p * "*"),  # type: ignore[operator]
+        (EX.oom, EX.p * "+"),  # type: ignore[operator]
+        (EX.zoo, EX.p * "?"),  # type: ignore[operator]
+        (EX.invZom, (~EX.p) * "*"),
+    ],
+)
+def test_parse_shacl_path_valid(
+    graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_identifier = graph.value(shape, SH.path)
+    result = parse_shacl_path(graph, path_identifier)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(
+    "shape, expected_exception",
+    [
+        (EX.nilPath, SHACLPathError),
+        (EX.emptyList, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.seqWithNil, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path_invalid(
+    graph: Graph,
+    shape: URIRef,
+    expected_exception: type[Exception],
+) -> None:
+    path_identifier = graph.value(shape, SH.path)
+    with pytest.raises(expected_exception):
+        parse_shacl_path(graph, path_identifier)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/shapes#p"])
+def test_parse_shacl_path_non_node_raises(graph: Graph, bad_input: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_does_not_modify_graph(graph: Graph) -> None:
+    before = set(graph)
+    for shape in (EX.iri, EX.seq, EX.inv, EX.zom, EX.emptyList, EX.unknown):
+        path_identifier = graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(graph, path_identifier)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(graph) == before
