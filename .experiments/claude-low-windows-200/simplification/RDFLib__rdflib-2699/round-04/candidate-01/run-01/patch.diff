@@ -0,0 +1,98 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure is malformed."""
+
+
+# The conversion of SHACL paths into property paths follows the approach used
+# by pyshacl when translating SHACL paths to SPARQL property paths.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI, which denotes a plain predicate;
+    * an RDF list of two or more paths, which denotes a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of two or more paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a ``URIRef`` for a plain predicate, or a ``Path`` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a literal.
+    :raises SHACLPathError: if the path structure is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}",
+        )
+    if not isinstance(path_identifier, Node):
+        # None and plain strings have no triples, but None would act as a
+        # wildcard in graph lookups, so reject non-nodes explicitly.
+        raise SHACLPathError(
+            f"Expected an RDF node as SHACL path, got {path_identifier!r}",
+        )
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list: sequence path (sh:path list of predicates)
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items],
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(alt_items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items],
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
