+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,96 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node cannot be parsed as a SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI (a plain predicate); an RDF list
+    of at least two paths (a sequence path); a blank node with
+    ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of at least two
+    paths), or one of ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``. The empty list ``rdf:nil`` is not a valid path.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a URIRef for a plain predicate, or a Path for a complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path structure is malformed or unrecognized.
+    """
+    # The SHACL-to-SPARQL path conversion in pyshacl was the basis for this parser.
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}",
+        )
+    node: object = path_identifier
+    if not isinstance(node, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {node!r}")
+
+    # An IRI is a plain predicate, except for rdf:nil which denotes an empty list.
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # sequence path: an RDF list of paths (rdf:first / rdf:rest)
+    if shapes_graph.value(node, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(node))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {node!r}",
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items],
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(node, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of paths
+    alternative_list = shapes_graph.value(node, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {node!r}",
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items],
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..ab0775c
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,122 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shacl-test#")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/shacl-test#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seqWithAlt sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:openSeq sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "text" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected, error",
+    [
+        pytest.param("iri", EX.p, None, id="iri"),
+        pytest.param("seq", EX.p1 / EX.p2 / EX.p3, None, id="sequence"),
+        pytest.param(
+            "nestedSeq", EX.p1 / (EX.p2 / EX.p3), None, id="nested-sequence"
+        ),
+        pytest.param(
+            "seqWithAlt", EX.p1 / (EX.p2 | EX.p3), None, id="sequence-with-alternative"
+        ),
+        pytest.param("openSeq", EX.p1 / EX.p2, None, id="open-ended-list"),
+        pytest.param("inv", ~EX.p, None, id="inverse"),
+        pytest.param("alt", EX.p1 | EX.p2, None, id="alternative"),
+        pytest.param(
+            "star",
+            EX.p * "*",  # type: ignore[operator]
+            None,
+            id="zero-or-more",
+        ),
+        pytest.param(
+            "plus",
+            EX.p * "+",  # type: ignore[operator]
+            None,
+            id="one-or-more",
+        ),
+        pytest.param(
+            "opt",
+            EX.p * "?",  # type: ignore[operator]
+            None,
+            id="zero-or-one",
+        ),
+        pytest.param("invStar", ~EX.p * "*", None, id="zero-or-more-inverse"),
+        pytest.param("nilPath", None, SHACLPathError, id="rdf-nil-empty-sequence"),
+        pytest.param("oneSeq", None, SHACLPathError, id="one-item-sequence"),
+        pytest.param("emptyAlt", None, SHACLPathError, id="empty-alternative"),
+        pytest.param("oneAlt", None, SHACLPathError, id="one-item-alternative"),
+        pytest.param("unknown", None, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literal", None, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    if error is not None:
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+
+
+def test_non_node_input_raises_shacl_path_error(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "ex:p")  # type: ignore[arg-type]
+
+
+def test_literal_argument_raises_type_error(shapes: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes, Literal("text"))
+
+
+def test_parser_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in ("iri", "seq", "nilPath", "unknown", "literal"):
+        path_node = shapes.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes) == before
