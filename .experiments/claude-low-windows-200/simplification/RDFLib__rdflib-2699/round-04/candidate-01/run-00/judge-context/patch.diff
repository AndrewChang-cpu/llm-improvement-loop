+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The path conversion below is based on the SHACL-to-SPARQL path conversion
+# implemented in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib predicate.
+
+    A valid SHACL path is one of:
+
+    * an IRI, which denotes a plain predicate;
+    * an RDF list of two or more valid paths, which denotes a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF list
+      of two or more valid paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath`` pointing to a valid path.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a ``URIRef`` for a plain predicate, or a ``Path`` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a literal.
+    :raises SHACLPathError: if the path structure is malformed or unrecognized.
+    """
+    # Typed as object so that the non-Node check below stays reachable for
+    # callers that pass None or other non-node values.
+    node: object = path_identifier
+    if isinstance(node, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {node!r}")
+    if not isinstance(node, Node):
+        raise SHACLPathError(f"Not a valid SHACL path node: {node!r}")
+
+    # An IRI is a plain predicate, except rdf:nil which is an empty list.
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # sequence path: an RDF list (rdf:first links)
+    if shapes_graph.value(node, RDF.first) is not None:
+        items = list(shapes_graph.items(node))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}: "
+                f"{node!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: an RDF list of alternatives
+    alternatives_head = shapes_graph.value(node, SH.alternativePath)
+    if alternatives_head is not None:
+        alternatives = list(shapes_graph.items(alternatives_head))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got "
+                f"{len(alternatives)}: {node!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, alt) for alt in alternatives]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
