+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,103 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not form a valid SHACL path."""
+
+
+# The recursive procedure below is based on the SHACL-to-SPARQL path
+# conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI, which denotes a plain predicate;
+    * an RDF list of at least two paths, which denotes a sequence path;
+    * a blank node with ``sh:inversePath``, whose value is a path;
+    * a blank node with ``sh:alternativePath``, whose value is an RDF list
+      of at least two paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath``, whose value is a path.
+
+    ``rdf:nil`` is not a valid path, and a literal is not a valid path.
+
+    :param shapes_graph: the graph holding the shapes. It is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a URIRef for a plain predicate, or a Path for a complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path structure is malformed or the
+        input is not a node.
+    """
+    if not isinstance(path_identifier, Node):
+        # None or a plain string has no triples; never pass None on as a
+        # wildcard to the graph lookups below.
+        raise SHACLPathError(  # type: ignore[unreachable]
+            f"Not a node, so not a SHACL path: {path_identifier!r}"
+        )
+
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # A plain predicate.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # A sequence path, written as an RDF list.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath, whose value is an RDF list.
+    alternative = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative is not None:
+        alternatives = list(shapes_graph.items(alternative))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..2a0c668
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,110 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ex:p4 ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverse_zero_or_more sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:open_list sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+
+ex:nil_path sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:nil_sequence_item sh:path ( ex:p1 () ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal_path sh:path "not a path" .
+"""
+
+VALID_CASES = [
+    (EX.iri, EX.p1),
+    (EX.sequence, EX.p1 / EX.p2 / EX.p3),
+    (EX.nested_sequence, EX.p1 / (EX.p2 | EX.p3) / EX.p4),
+    (EX.inverse, ~EX.p1),
+    (EX.zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.inverse_zero_or_more, ~EX.p1 * "*"),
+    (EX.alternative, EX.p1 | EX.p2),
+    (EX.open_list, EX.p1 / EX.p2),
+]
+
+INVALID_CASES = [
+    (EX.nil_path, SHACLPathError),
+    (EX.one_item_sequence, SHACLPathError),
+    (EX.nil_sequence_item, SHACLPathError),
+    (EX.empty_alternative, SHACLPathError),
+    (EX.one_item_alternative, SHACLPathError),
+    (EX.unrecognized, SHACLPathError),
+    (EX.literal_path, TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph, shape: URIRef, expected: Union[URIRef, Path]
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    assert parse_shacl_path(shapes_graph, path_node) == expected
+
+
+@pytest.mark.parametrize(("shape", "error"), INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph, shape: URIRef, error: type[Exception]
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(error):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_none_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+
+
+def test_plain_string_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "p1")  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    shapes = [shape for shape, _ in VALID_CASES] + [
+        shape for shape, _ in INVALID_CASES
+    ]
+    for shape in shapes:
+        path_node = shapes_graph.value(shape, SH.path)
+        assert path_node is not None
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
