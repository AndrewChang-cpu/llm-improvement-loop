@@ -0,0 +1,85 @@
+"""Utilities for working with SHACL shapes graphs."""
+from __future__ import annotations
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure is malformed."""
+
+
+# The parsing approach follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> URIRef | Path:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI, which names a plain predicate;
+    * an RDF list of at least two paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, with ``sh:alternativePath``
+      (an RDF list of at least two paths), or with one of
+      ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The graph holding the shapes. It is only read.
+    :param path_identifier: The object node of the ``sh:path`` triple.
+    :return: A URIRef for a plain predicate, or a Path for a complex path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path structure is malformed.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {path_identifier!r}")
+
+    # An IRI is a plain predicate; rdf:nil is an empty list, not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list (rdf:first / rdf:rest).
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: an RDF list of alternatives.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..38cb6a1
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,78 @@
+from __future__ import annotations
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ex:p4 ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverse_zero_or_more sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:open_tail_list sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:empty_list sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        ("iri", EX.p1),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("nested", EX.p1 / (EX.p2 | EX.p3) / EX.p4),
+        ("inverse", ~EX.p1),
+        ("zero_or_more", EX.p1 * "*"),  # type: ignore[operator]
+        ("one_or_more", EX.p1 * "+"),  # type: ignore[operator]
+        ("zero_or_one", EX.p1 * "?"),  # type: ignore[operator]
+        ("inverse_zero_or_more", (~EX.p1) * "*"),
+        ("open_tail_list", EX.p1 / EX.p2),
+        ("empty_list", SHACLPathError),
+        ("one_item_sequence", SHACLPathError),
+        ("empty_alternative", SHACLPathError),
+        ("one_item_alternative", SHACLPathError),
+        ("unrecognized", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: URIRef | Path | type[SHACLPathError] | type[TypeError],
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        return
+    assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "p1"])
+def test_non_node_input_raises(shapes: Graph, bad_input: str | None) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
