index 0000000..1c386ed
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seqWithAlt sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:tailSeq sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreInv sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path ( ) .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "abc" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("iri", EX.p1),
+        ("seq", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSeq", EX.p1 / (EX.p2 / EX.p3)),
+        ("seqWithAlt", EX.p1 / (EX.p2 | EX.p3)),
+        ("tailSeq", EX.p1 / EX.p2),
+        ("inv", ~EX.p1),
+        ("alt", EX.p1 | EX.p2),
+        ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+        ("oneOrMoreInv", (~EX.p1) * "+"),
+        ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+        ("nilPath", SHACLPathError),
+        ("emptySeq", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    assert path_node is not None
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+    assert set(shapes_graph) == before
+
+
+def test_none_and_string_are_shacl_errors(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    plain_string = "http://example.org/p1"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, plain_string)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_literal_is_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("abc"))
