@@ -0,0 +1,98 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import BNode, Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a plain predicate;
+    * an RDF list of two or more valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of two or more valid paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath`` pointing to a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the value of ``sh:path``. It may
+        be an :class:`~rdflib.term.URIRef` or a :class:`~rdflib.term.BNode`.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path. The result can be used
+        with :class:`~rdflib.graph.Graph` methods, and its ``n3()`` output is a
+        valid SPARQL property path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or unrecognized, or if
+        ``path_identifier`` is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}",
+        )
+    if not isinstance(path_identifier, (URIRef, BNode)):
+        raise SHACLPathError(
+            f"Path must be an IRI or blank node, not {path_identifier!r}",
+        )
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list: sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items: {path_identifier!r}",
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items: {path_identifier!r}",
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..65005c3
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.graph import Graph
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+from rdflib.term import URIRef
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSeq sh:path (
+    ex:p
+    [ sh:inversePath ex:q ]
+    [ sh:alternativePath ( ex:r ex:s ) ]
+) .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:dangling sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected", "error"),
+    [
+        ("iri", EX.p, None),
+        ("seq", EX.p / EX.q / EX.r, None),
+        ("nestedSeq", EX.p / ~EX.q / (EX.r | EX.s), None),
+        ("alt", EX.p | EX.q, None),
+        ("inv", ~EX.p, None),
+        ("zeroOrMore", EX.p * "*", None),  # type: ignore[operator]
+        ("oneOrMore", EX.p * "+", None),  # type: ignore[operator]
+        ("zeroOrOne", EX.p * "?", None),  # type: ignore[operator]
+        ("modInv", ~EX.p * "*", None),
+        ("dangling", EX.p / EX.q, None),
+        ("nilPath", None, SHACLPathError),
+        ("oneSeq", None, SHACLPathError),
+        ("emptyAlt", None, SHACLPathError),
+        ("oneAlt", None, SHACLPathError),
+        ("unknown", None, SHACLPathError),
+        ("literal", None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    before = set(shapes)
+    node = shapes.value(EX[shape], SH.path)
+    if error is None:
+        result = parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+        assert result == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    bad_input: str,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
