+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,90 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node cannot be parsed as a SHACL path."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of: an IRI naming a plain predicate (other than
+    ``rdf:nil``); an RDF list of two or more paths, which is a sequence path;
+    a blank node with ``sh:inversePath``; a blank node with
+    ``sh:alternativePath`` whose value is an RDF list of two or more paths; or
+    a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``. Nested paths are parsed recursively.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It is an :class:`~rdflib.term.URIRef`, a blank node or a
+        :class:`~rdflib.term.Literal`.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path. The result can be used
+        with :class:`~rdflib.graph.Graph` methods and its ``n3()`` output is a
+        valid SPARQL property path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path is malformed or unrecognized, or if
+        ``path_identifier`` is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"{path_identifier!r} is not a node")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    # sequence path: an RDF list (sh:path ( p1 p2 ... ))
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path {path_identifier!r} needs at least two items"
+            )
+        return paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+    # inverse path: sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+    # alternative path: sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"alternative path {path_identifier!r} needs at least two items"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+    # modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+    raise SHACLPathError(f"unrecognized SHACL path node {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..a5a0b4d
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,122 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:altInSeqShape sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifiedInverseShape sh:path [
+    sh:zeroOrMorePath [ sh:inversePath ex:p1 ]
+] .
+ex:openListShape sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+
+ex:nilShape sh:path () .
+ex:oneItemSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:other ex:p1 ] .
+ex:literalShape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.iriShape, EX.p1, id="iri"),
+        pytest.param(EX.seqShape, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nestedSeqShape,
+            EX.p1 / (EX.p2 / EX.p3),
+            id="nested-sequence",
+        ),
+        pytest.param(
+            EX.altInSeqShape,
+            EX.p1 / (EX.p2 | EX.p3),
+            id="alternative-in-sequence",
+        ),
+        pytest.param(EX.inverseShape, ~EX.p1, id="inverse"),
+        pytest.param(
+            EX.zeroOrMoreShape,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMoreShape,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOneShape,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.modifiedInverseShape,
+            (~EX.p1) * "*",
+            id="modifier-of-inverse",
+        ),
+        pytest.param(EX.openListShape, EX.p1 / EX.p2, id="open-ended-list"),
+        pytest.param(EX.nilShape, SHACLPathError, id="rdf-nil-empty-sequence"),
+        pytest.param(EX.oneItemSeqShape, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAltShape, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneItemAltShape, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknownShape, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literalShape, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes.value(shape, SH.path)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises(shapes: Graph, bad_input: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
+
+
+def test_graph_is_not_modified(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in (EX.nilShape, EX.unknownShape, EX.seqShape):
+        path_node = shapes.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(shapes) == before
