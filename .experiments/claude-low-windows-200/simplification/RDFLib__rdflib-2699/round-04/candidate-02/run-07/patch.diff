@@ -0,0 +1,100 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value is not a valid SHACL property path."""
+
+
+# The SHACL path parser below is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into a URIRef or a Path.
+
+    A valid SHACL path is one of: an IRI naming a plain predicate (other than
+    ``rdf:nil``); an RDF list of two or more valid paths, denoting a sequence
+    path; a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+    list of two or more valid paths), or one of ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, i.e. the object of a ``sh:path``
+        triple. It may be a :class:`~rdflib.term.URIRef`, a
+        :class:`~rdflib.term.BNode`, or a :class:`~rdflib.term.Literal`.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path is malformed or the input is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, cannot be a SHACL path: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first: an RDF list used as a sequence path.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alt_items = list(shapes_graph.items(alternative_list))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..56012b2
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+P1 = EX.p1
+P2 = EX.p2
+P3 = EX.p3
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seqAltShape sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:invShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInvShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:openListShape sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+
+# Invalid shapes.
+ex:emptySeqShape sh:path () .
+ex:oneSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:unknown ex:p1 ] .
+ex:literalShape sh:path "p1" .
+"""
+
+CYCLIC_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:cyclicShape sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 ; rdf:rest _:c1 .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        (EX.iriShape, P1),
+        (EX.seqShape, P1 / P2 / P3),
+        (EX.nestedSeqShape, P1 / (P2 / P3)),
+        (EX.seqAltShape, P1 / (P2 | P3)),
+        (EX.invShape, ~P1),
+        (EX.zeroOrMoreShape, P1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMoreShape, P1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOneShape, P1 * "?"),  # type: ignore[operator]
+        (EX.modInvShape, (~P1) * "*"),
+        (EX.altShape, P1 | P2),
+        (EX.openListShape, P1 / P2),
+        # rdf:nil as a path and an empty sequence list are the same Turtle `()`.
+        (EX.emptySeqShape, SHACLPathError),
+        (EX.oneSeqShape, SHACLPathError),
+        (EX.emptyAltShape, SHACLPathError),
+        (EX.oneAltShape, SHACLPathError),
+        (EX.unknownShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/p1"])
+def test_non_node_input_raises(shapes_graph: Graph, value: object) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, value)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_cyclic_rest_chain_raises_value_error() -> None:
+    graph = Graph()
+    graph.parse(data=CYCLIC_TTL, format="turtle")
+    path_node = graph.value(EX.cyclicShape, SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
