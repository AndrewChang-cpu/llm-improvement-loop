+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path node is not a valid SHACL path."""
+
+
+# The conversion of SHACL paths to SPARQL property paths is based on the
+# implementation in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> URIRef | Path:
+    """
+    Parse the object of a ``sh:path`` triple into a predicate usable with rdflib.
+
+    A valid SHACL path is one of:
+
+    * an IRI, which is returned as a ``URIRef``;
+    * an RDF list of two or more paths, which is a sequence path;
+    * a node with ``sh:inversePath``, which is an inverse path;
+    * a node with ``sh:alternativePath`` whose value is an RDF list of two or
+      more paths, which is an alternative path;
+    * a node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath``, which is a modifier path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, i.e. the object of a ``sh:path``
+        triple, as a :class:`~rdflib.term.URIRef`, blank node or
+        :class:`~rdflib.term.Literal`.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, cannot be a SHACL path: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first marks an RDF list, i.e. a sequence path
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..d6014b4
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:open_sequence sh:path _:open .
+_:open rdf:first ex:p1 ; rdf:rest _:last .
+_:last rdf:first ex:p2 .
+ex:empty_list sh:path () .
+ex:single_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:single_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modified_inverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:unrecognized sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.sequence, EX.p1 / EX.p2 / EX.p3),
+        (EX.nested_sequence, EX.p1 / (EX.p2 | EX.p3)),
+        (EX.open_sequence, EX.p1 / EX.p2),
+        (EX.inverse, ~EX.p),
+        (EX.zero_or_more, EX.p * "*"),  # type: ignore[operator]
+        (EX.one_or_more, EX.p * "+"),  # type: ignore[operator]
+        (EX.zero_or_one, EX.p * "?"),  # type: ignore[operator]
+        (EX.modified_inverse, (~EX.p) * "+"),
+        (EX.empty_list, SHACLPathError),
+        (EX.single_sequence, SHACLPathError),
+        (EX.empty_alternative, SHACLPathError),
+        (EX.single_alternative, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: URIRef | Path | type[Exception],
+) -> None:
+    path_node = shapes.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    bad_input: str | None,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
+
+
+def test_literal_input_raises_type_error(shapes: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes, Literal("p"))
+
+
+def test_parser_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in (EX.sequence, EX.empty_list, EX.unrecognized, EX.inverse):
+        path_node = shapes.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(shapes) == before
