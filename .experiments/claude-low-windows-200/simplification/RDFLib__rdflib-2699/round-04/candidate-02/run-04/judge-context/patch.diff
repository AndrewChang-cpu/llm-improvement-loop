index 0000000..e90280c
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:valid_iri sh:path ex:p .
+ex:valid_seq sh:path ( ex:p ex:q ex:r ) .
+ex:valid_nested_seq sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:valid_alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:valid_seq_alt sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:valid_inv sh:path [ sh:inversePath ex:p ] .
+ex:valid_star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:valid_plus_inv sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:valid_opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:valid_open_list sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+ex:invalid_nil sh:path () .
+ex:invalid_seq_one sh:path ( ex:p ) .
+ex:invalid_alt_empty sh:path [ sh:alternativePath () ] .
+ex:invalid_alt_one sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:invalid_blank sh:path [ ex:unknown ex:p ] .
+ex:invalid_literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.valid_iri, EX.p),
+        (EX.valid_seq, EX.p / EX.q / EX.r),
+        (EX.valid_nested_seq, EX.p / (EX.q / EX.r)),
+        (EX.valid_alt, EX.p | EX.q),
+        (EX.valid_seq_alt, EX.p / (EX.q | EX.r)),
+        (EX.valid_inv, ~EX.p),
+        (EX.valid_star, EX.p * "*"),  # type: ignore[operator]
+        (EX.valid_plus_inv, (~EX.p) * "+"),
+        (EX.valid_opt, EX.p * "?"),  # type: ignore[operator]
+        (EX.valid_open_list, EX.p / EX.q),
+        (EX.invalid_nil, SHACLPathError),
+        (EX.invalid_seq_one, SHACLPathError),
+        (EX.invalid_alt_empty, SHACLPathError),
+        (EX.invalid_alt_one, SHACLPathError),
+        (EX.invalid_blank, SHACLPathError),
+        (EX.invalid_literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    node = shapes.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+        return
+    assert parse_shacl_path(shapes, node) == expected  # type: ignore[arg-type]
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p")  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in set(shapes.subjects(SH.path, None)):
+        node = shapes.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes) == before
