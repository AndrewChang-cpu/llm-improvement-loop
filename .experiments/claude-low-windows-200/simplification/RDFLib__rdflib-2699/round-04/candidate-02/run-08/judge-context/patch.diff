@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The procedure below is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is an IRI (a plain predicate), an RDF list of two or more
+    valid paths (a sequence), a blank node with ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of two or more valid paths), or one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, ``sh:zeroOrOnePath`` applied to
+    a valid path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The node that is the value of ``sh:path``, given as
+        a :class:`~rdflib.term.URIRef`, :class:`~rdflib.term.BNode` or
+        :class:`~rdflib.term.Literal`.
+    :returns: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If the path node is a Literal.
+    :raises SHACLPathError: If the path is malformed or unrecognized, or if the
+        input is not an RDF node.
+    """
+    node: object = path_identifier
+    if not isinstance(node, Node):
+        raise SHACLPathError(f"SHACL path must be an RDF node, not {node!r}")
+    if isinstance(node, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # RDF list: sequence path
+    if shapes_graph.value(node, RDF.first) is not None:
+        items = list(shapes_graph.items(node))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: RDF list of two or more paths
+    alternatives = shapes_graph.value(node, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got {len(alt_items)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
