index 0000000..269b424
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = "http://example.org/"
+A = URIRef(EX + "a")
+B = URIRef(EX + "b")
+C = URIRef(EX + "c")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:a .
+ex:seq sh:path ( ex:a ex:b ex:c ) .
+ex:nestedSeq sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:seqWithAlt sh:path ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] ) .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:inv sh:path [ sh:inversePath ex:a ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:a ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:a ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:a ] .
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ] .
+ex:openList sh:path _:open1 .
+_:open1 rdf:first ex:a ; rdf:rest _:open2 .
+_:open2 rdf:first ex:b .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:a ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown sh:path [ ex:other ex:a ] .
+ex:literal sh:path "x" .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def shape(name: str) -> URIRef:
+    return URIRef(EX + name)
+
+
+@pytest.mark.parametrize(
+    "name, expected",
+    [
+        ("iri", A),
+        ("seq", A / B / C),
+        ("nestedSeq", A / (B / C)),
+        ("seqWithAlt", A / (B | C)),
+        ("alt", A | B),
+        ("inv", ~A),
+        ("star", A * "*"),  # type: ignore[operator]
+        ("plus", A * "+"),  # type: ignore[operator]
+        ("opt", A * "?"),  # type: ignore[operator]
+        ("invStar", (~A) * "*"),
+        ("openList", A / B),
+        ("nilPath", SHACLPathError),
+        ("emptySeq", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    name: str,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    before = set(graph)
+    value = graph.value(shape(name), SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(graph, value)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(graph, value) == expected  # type: ignore[arg-type]
+    assert set(graph) == before
+
+
+def test_literal_path_raises_type_error(graph: Graph) -> None:
+    value = graph.value(shape("literal"), SH.path)
+    with pytest.raises(TypeError):
+        parse_shacl_path(graph, value)  # type: ignore[arg-type]
+
+
+def test_none_raises_shacl_path_error(graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, None)  # type: ignore[arg-type]
+
+
+def test_plain_string_raises_shacl_path_error(graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, "http://example.org/a")  # type: ignore[arg-type]
+
+
+def test_cyclic_list_is_not_wrapped(graph: Graph) -> None:
+    cyc = Graph()
+    cyc.parse(
+        data="""
+        @prefix ex: <http://example.org/> .
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+        ex:s sh:path _:l1 .
+        _:l1 rdf:first ex:a ; rdf:rest _:l1 .
+        """,
+        format="turtle",
+    )
+    value = cyc.value(shape("s"), SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(cyc, value)  # type: ignore[arg-type]
