index 0000000..b4598e4
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nested sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:openList sh:path _:l1 .
+_:l1 rdf:first ex:p ; rdf:rest _:l2 .
+_:l2 rdf:first ex:q .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path ( ) .
+ex:oneSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literalPath sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p),
+    ("seq", EX.p / EX.q / EX.r),
+    ("nested", EX.p / (EX.q | EX.r)),
+    ("inverse", ~EX.p),
+    ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+    ("modInverse", (~EX.p) * "+"),
+    ("alt", EX.p | EX.q),
+    ("openList", EX.p / EX.q),
+]
+
+INVALID_CASES: list[tuple[str, Type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("emptySeq", SHACLPathError),
+    ("oneSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneAlt", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.mark.parametrize(("name", "expected"), VALID_CASES)
+def test_valid_paths(shapes: Graph, name: str, expected: Union[URIRef, Path]) -> None:
+    node = shapes.value(EX[name], SH.path)
+    assert parse_shacl_path(shapes, node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(("name", "exc"), INVALID_CASES)
+def test_invalid_paths(shapes: Graph, name: str, exc: Type[Exception]) -> None:
+    node = shapes.value(EX[name], SH.path)
+    with pytest.raises(exc):
+        parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.com/p")  # type: ignore[arg-type]
+
+
+def test_literal_node_raises_type_error(shapes: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes, Literal("p"))
+
+
+def test_parse_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for name, _ in VALID_CASES:
+        node = shapes.value(EX[name], SH.path)
+        parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    for name, exc in INVALID_CASES:
+        node = shapes.value(EX[name], SH.path)
+        with pytest.raises(exc):
+            parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    assert set(shapes) == before
