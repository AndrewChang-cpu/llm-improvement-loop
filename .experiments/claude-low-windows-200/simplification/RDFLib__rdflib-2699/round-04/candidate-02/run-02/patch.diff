@@ -0,0 +1,103 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Union
+
+from rdflib import Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+if TYPE_CHECKING:
+    from rdflib.graph import Graph
+
+
+class SHACLPathError(Exception):
+    """Raised when a node cannot be parsed as a SHACL path."""
+
+
+def _as_node(value: object) -> Node:
+    if not isinstance(value, Node):
+        raise SHACLPathError(f"SHACL path must be an RDF node, got {value!r}")
+    return value
+
+
+# The parsing logic follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is either an IRI (a plain predicate), an RDF list of
+    at least two valid paths (a sequence path), a blank node with a
+    ``sh:inversePath``, a blank node with a ``sh:alternativePath`` whose value
+    is an RDF list of at least two valid paths, or a blank node with one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The node that is the value of ``sh:path``.
+    :returns: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises SHACLPathError: If the node is not a valid SHACL path.
+    :raises TypeError: If the node is a :class:`~rdflib.term.Literal`.
+    """
+    node = _as_node(path_identifier)
+
+    if isinstance(node, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # RDF list: sequence path
+    if shapes_graph.value(node, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(node))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "Sequence path needs at least two items, got "
+                f"{len(sequence_items)} in {node!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, i) for i in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(node, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(node, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "Alternative path needs at least two items, got "
+                f"{len(alternative_items)} in {node!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..c7f5cbb
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p .
+ex:sequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedShape sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ex:p4 ) .
+ex:inverseShape sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverseShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:openListShape sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:nilShape sh:path rdf:nil .
+ex:emptySequenceShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:p1 ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath rdf:nil ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:other ex:p ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+VALID_SHAPES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iriShape", EX.p),
+    ("sequenceShape", EX.p1 / EX.p2 / EX.p3),
+    ("nestedShape", EX.p1 / (EX.p2 | EX.p3) / EX.p4),
+    ("inverseShape", ~EX.p),
+    ("zeroOrMoreShape", EX.p * "*"),  # type: ignore[operator]
+    ("oneOrMoreShape", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOneShape", EX.p * "?"),  # type: ignore[operator]
+    ("modifiedInverseShape", (~EX.p) * "*"),
+    ("openListShape", EX.p1 / EX.p2),
+]
+
+INVALID_SHAPES: list[tuple[str, Type[Exception]]] = [
+    ("nilShape", SHACLPathError),
+    ("emptySequenceShape", SHACLPathError),
+    ("oneItemSequenceShape", SHACLPathError),
+    ("emptyAlternativeShape", SHACLPathError),
+    ("oneItemAlternativeShape", SHACLPathError),
+    ("unknownShape", SHACLPathError),
+    ("literalShape", TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected", "error"),
+    [(name, expected, None) for name, expected in VALID_SHAPES]
+    + [(name, None, error) for name, error in INVALID_SHAPES],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if error is None:
+        assert expected is not None
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+        return
+    with pytest.raises(error):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: Optional[str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for name, _ in VALID_SHAPES:
+        node = shapes_graph.value(EX[name], SH.path)
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    for name, error in INVALID_SHAPES:
+        node = shapes_graph.value(EX[name], SH.path)
+        with pytest.raises(error):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
