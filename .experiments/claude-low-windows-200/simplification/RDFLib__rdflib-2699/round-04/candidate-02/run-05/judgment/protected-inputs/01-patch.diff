@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node cannot be parsed as a SHACL path."""
+
+
+# The recursive procedure below follows the SHACL-to-SPARQL path conversion
+# in pyshacl, which is the basis for this parser.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI (other than ``rdf:nil``), which is a
+    plain predicate; an RDF list of two or more valid paths, which is a
+    sequence path; a blank node with ``sh:inversePath``; a blank node with
+    ``sh:alternativePath`` whose value is an RDF list of two or more valid
+    paths; or a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``
+    or ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: the graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path, usable with
+        :class:`~rdflib.graph.Graph` methods.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed, unrecognized, or the
+        input is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"not a node: {path_identifier!r}")
+
+    # A plain predicate IRI.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first marks an RDF list, which is a sequence path (sh:path list).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath, whose value is an RDF list.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..0bdf01e
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,97 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSeq sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:seqAlt sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:openList sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:nilItem sh:path ( ex:p rdf:nil ) .
+ex:oneSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected, error",
+    [
+        pytest.param("iri", EX.p, None, id="iri"),
+        pytest.param("seq", EX.p / EX.q / EX.r, None, id="sequence"),
+        pytest.param("nestedSeq", EX.p / (EX.q / EX.r), None, id="nested-sequence"),
+        pytest.param("seqAlt", EX.p / (EX.q | EX.r), None, id="sequence-alternative"),
+        pytest.param("openList", EX.p / EX.q, None, id="open-ended-list"),
+        pytest.param("inv", ~EX.p, None, id="inverse"),
+        pytest.param("star", EX.p * "*", None, id="star"),  # type: ignore[operator]
+        pytest.param("plus", EX.p * "+", None, id="plus"),  # type: ignore[operator]
+        pytest.param("opt", EX.p * "?", None, id="opt"),  # type: ignore[operator]
+        pytest.param("invStar", (~EX.p) * "*", None, id="modifier-of-inverse"),
+        pytest.param("alt", EX.p | EX.q, None, id="alternative"),
+        pytest.param("nilPath", None, SHACLPathError, id="rdf-nil-path"),
+        pytest.param("emptySeq", None, SHACLPathError, id="empty-sequence"),
+        pytest.param("nilItem", None, SHACLPathError, id="rdf-nil-sequence-item"),
+        pytest.param("oneSeq", None, SHACLPathError, id="one-item-sequence"),
+        pytest.param("emptyAlt", None, SHACLPathError, id="empty-alternative"),
+        pytest.param("oneAlt", None, SHACLPathError, id="one-item-alternative"),
+        pytest.param("unknown", None, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literal", None, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape_name: str,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    shape = EX[shape_name]
+    before = set(shapes)
+    path_node = shapes.value(shape, SH.path)  # type: ignore[arg-type]
+    if error is None:
+        assert expected is not None
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("bad", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_error(shapes: Graph, bad: Optional[str]) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad)  # type: ignore[arg-type]
+    assert set(shapes) == before
