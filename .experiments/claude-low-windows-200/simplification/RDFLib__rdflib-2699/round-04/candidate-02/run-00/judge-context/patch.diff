+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The SHACL-to-SPARQL path conversion in pyshacl was the basis for the
+# recognized path forms below.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI naming a plain predicate; an RDF
+    list of two or more valid paths, which is a sequence path; a blank node
+    with ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of two or
+    more valid paths), or one of ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``,
+    or ``sh:zeroOrOnePath`` whose value is a valid path. ``rdf:nil`` is not a
+    valid path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The node that is the value of ``sh:path``, given
+        as an IRI, blank node, or :class:`~rdflib.term.Literal`.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path. Either can be used
+        as a predicate in :class:`~rdflib.graph.Graph` methods.
+    :raises TypeError: If ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized, or if
+        ``path_identifier`` is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):  # type: ignore[unreachable]
+        raise SHACLPathError(f"not a node: {path_identifier!r}")
+
+    # A plain predicate. rdf:nil is an empty list, not a predicate.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first marks an RDF list: sequence path (no SHACL predicate).
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternatives = list(shapes_graph.items(alternative_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alternatives]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..593a1c7
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:iriShape sh:path ex:p1 .
+ex:sequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequenceShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:sequenceOfAlternativeShape sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifiedInverseShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:tailListShape sh:path _:tail1 .
+_:tail1 rdf:first ex:p1 ; rdf:rest _:tail2 .
+_:tail2 rdf:first ex:p2 .
+
+ex:emptySequenceShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:p1 ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognizedShape sh:path [ ex:other ex:p1 ] .
+ex:literalShape sh:path "ex:p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iriShape, EX.p1),
+        (EX.sequenceShape, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSequenceShape, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.alternativeShape, EX.p1 | EX.p2),
+        (EX.sequenceOfAlternativeShape, EX.p1 / (EX.p2 | EX.p3)),
+        (EX.inverseShape, ~EX.p1),
+        (EX.zeroOrMoreShape, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMoreShape, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOneShape, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modifiedInverseShape, (~EX.p1) * "*"),
+        (EX.tailListShape, EX.p1 / EX.p2),
+    ],
+)
+def test_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(
+    "shape, exc_type",
+    [
+        (EX.emptySequenceShape, SHACLPathError),
+        (EX.oneItemSequenceShape, SHACLPathError),
+        (EX.emptyAlternativeShape, SHACLPathError),
+        (EX.oneItemAlternativeShape, SHACLPathError),
+        (EX.unrecognizedShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    exc_type: type[Exception],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    bad_input: str | None,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in (EX.emptySequenceShape, EX.unrecognizedShape, EX.iriShape):
+        path_node = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(shapes_graph) == before
