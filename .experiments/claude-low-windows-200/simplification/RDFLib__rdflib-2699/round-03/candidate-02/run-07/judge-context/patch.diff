+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The parsing rules follow pyshacl's conversion of SHACL paths to SPARQL paths.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the value of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following: an IRI naming a plain
+    predicate; an RDF list of two or more paths, which is a sequence path;
+    a blank node with ``sh:inversePath``; a blank node with
+    ``sh:alternativePath`` whose RDF list has two or more paths; or a blank
+    node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+    ``sh:zeroOrOnePath``. Each nested value is a valid SHACL path itself.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the object node of the ``sh:path`` triple, which
+        is an IRI or blank node. A :class:`~rdflib.term.Literal` raises
+        :exc:`TypeError`.
+    :returns: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises SHACLPathError: if the value is not a valid SHACL path.
+    :raises TypeError: if the value is a :class:`~rdflib.term.Literal`.
+    """
+    # Narrowed through object so that non-node inputs (None, plain strings)
+    # are checked at runtime rather than trusted as Node.
+    node: object = path_identifier
+
+    if isinstance(node, Literal):
+        raise TypeError("Literals are not valid SHACL paths: %r" % (node,))
+
+    if not isinstance(node, Node):
+        raise SHACLPathError(
+            "Not a SHACL path node, so it matches no path form: %r" % (node,)
+        )
+
+    # A plain predicate IRI is its own path; rdf:nil is an empty list.
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # RDF list used as a sequence path.
+    first = shapes_graph.value(node, RDF.first)
+    if first is not None:
+        sequence = list(shapes_graph.items(node))
+        if len(sequence) < 2:
+            raise SHACLPathError(
+                "SHACL sequence path needs at least two items, got %d: %r"
+                % (len(sequence), node)
+            )
+        return paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence]
+        )
+
+    # sh:inversePath
+    inverse = shapes_graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath, whose value is an RDF list of paths.
+    alternatives_list = shapes_graph.value(node, SH.alternativePath)
+    if alternatives_list is not None:
+        alternatives = list(shapes_graph.items(alternatives_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "SHACL alternative path needs at least two items, got %d: %r"
+                % (len(alternatives), node)
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (node,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
