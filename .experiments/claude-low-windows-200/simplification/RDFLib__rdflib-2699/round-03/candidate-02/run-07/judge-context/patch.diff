index 0000000..457c269
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,152 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shapes#")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.com/shapes#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iriShape sh:path ex:p1 .
+
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:invShape sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt3Shape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAltShape sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        ( ex:p1 ex:p2 )
+    )
+] .
+
+ex:starShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:plusShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:optShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modInvShape sh:path [
+    sh:zeroOrMorePath [ sh:inversePath ex:p1 ]
+] .
+
+ex:tailShape sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:nilShape sh:path () .
+
+ex:emptySeqShape sh:path () .
+
+ex:oneSeqShape sh:path ( ex:p1 ) .
+
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+
+ex:oneAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknownShape sh:path [ ex:unknownPredicate ex:p1 ] .
+
+ex:literalShape sh:path "not a path" .
+"""
+
+Expected = Union[URIRef, Path]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.bind("ex", EX)
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+VALID_CASES: list[tuple[str, Expected]] = [
+    ("iriShape", EX.p1),
+    ("seqShape", EX.p1 / EX.p2 / EX.p3),
+    ("nestedSeqShape", EX.p1 / (EX.p2 / EX.p3)),
+    ("invShape", ~EX.p1),
+    ("alt3Shape", EX.p1 | EX.p2 | EX.p3),
+    ("nestedAltShape", EX.p1 | (EX.p2 | EX.p3) | (EX.p1 / EX.p2)),
+    ("starShape", EX.p1 * "*"),  # type: ignore[operator]
+    ("plusShape", EX.p1 * "+"),  # type: ignore[operator]
+    ("optShape", EX.p1 * "?"),  # type: ignore[operator]
+    ("modInvShape", (~EX.p1) * "*"),
+    ("tailShape", EX.p1 / EX.p2),
+]
+
+
+@pytest.mark.parametrize("shape_name, expected", VALID_CASES)
+def test_valid_shacl_path(shapes: Graph, shape_name: str, expected: Expected) -> None:
+    path_node = shapes.value(EX[shape_name], SH.path)
+    assert path_node is not None
+    assert parse_shacl_path(shapes, path_node) == expected
+
+
+INVALID_CASES: list[tuple[str, Type[Exception]]] = [
+    ("nilShape", SHACLPathError),
+    ("emptySeqShape", SHACLPathError),
+    ("oneSeqShape", SHACLPathError),
+    ("emptyAltShape", SHACLPathError),
+    ("oneAltShape", SHACLPathError),
+    ("unknownShape", SHACLPathError),
+    ("literalShape", TypeError),
+]
+
+
+@pytest.mark.parametrize("shape_name, exc_type", INVALID_CASES)
+def test_invalid_shacl_path(
+    shapes: Graph, shape_name: str, exc_type: Type[Exception]
+) -> None:
+    path_node = shapes.value(EX[shape_name], SH.path)
+    assert path_node is not None
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes, path_node)
+
+
+def test_none_is_not_a_wildcard(shapes: Graph) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_plain_string_is_rejected(shapes: Graph) -> None:
+    before = set(shapes)
+    text = str(EX.p1)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, text)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_missing_shape_lookup_is_rejected(shapes: Graph) -> None:
+    missing = shapes.value(EX.noSuchShape, SH.path)
+    assert missing is None
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, missing)  # type: ignore[arg-type]
+
+
+def test_failed_parse_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    path_node = shapes.value(EX.seqShape, SH.path)
+    assert path_node is not None
+    assert parse_shacl_path(shapes, path_node) == EX.p1 / EX.p2 / EX.p3
+    bad_node = shapes.value(EX.oneSeqShape, SH.path)
+    assert bad_node is not None
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_node)
+    assert set(shapes) == before
