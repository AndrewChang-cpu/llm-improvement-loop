@@ -0,0 +1,99 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is an IRI for a plain predicate, or a blank node (or
+    RDF list) using one of the SHACL path forms: an RDF list of two or more
+    paths (sequence), ``sh:inversePath``, an ``sh:alternativePath`` list of
+    two or more paths, or ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It must be a node (IRI or blank node). A
+        :class:`~rdflib.term.Literal` raises :class:`TypeError`.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises SHACLPathError: if the node is not a valid SHACL path.
+    :raises TypeError: if the node is a literal.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        # A non-node (such as None) must not reach the graph lookups below,
+        # because None there would act as a wildcard.
+        raise SHACLPathError(f"Not a SHACL path node: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first: an RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got {len(items)}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..052eb38
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shapes#")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/shapes#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:sequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequenceShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:danglingShape sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternativeShape sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ( ex:p4 ex:p5 ) )
+] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:combinedShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:emptyListShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:p1 ) .
+ex:nilItemShape sh:path ( ex:p1 () ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:unknown ex:value ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iriShape, EX.p1),
+        (EX.sequenceShape, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSequenceShape, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.danglingShape, EX.p1 / EX.p2),
+        (EX.inverseShape, ~EX.p1),
+        (EX.alternativeShape, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAlternativeShape, EX.p1 | (EX.p2 | EX.p3) | (EX.p4 / EX.p5)),
+        (EX.zeroOrMoreShape, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMoreShape, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOneShape, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.combinedShape, (~EX.p1) * "*"),
+    ],
+)
+def test_parse_valid_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(
+    "shape, exc_type",
+    [
+        (EX.emptyListShape, SHACLPathError),
+        (EX.oneItemSequenceShape, SHACLPathError),
+        (EX.nilItemShape, SHACLPathError),
+        (EX.emptyAlternativeShape, SHACLPathError),
+        (EX.oneItemAlternativeShape, SHACLPathError),
+        (EX.unknownShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_invalid_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    exc_type: Type[Exception],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "bad_input",
+    [None, "http://example.com/shapes#p1"],
+)
+def test_parse_non_node_input(
+    shapes_graph: Graph,
+    bad_input: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_rdf_nil_as_path(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
+
+
+def test_parse_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    parse_shacl_path(shapes_graph, EX.p1)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
+    assert set(shapes_graph) == before
