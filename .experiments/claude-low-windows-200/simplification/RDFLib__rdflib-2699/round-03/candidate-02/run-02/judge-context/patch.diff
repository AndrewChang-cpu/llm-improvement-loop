@@ -0,0 +1,89 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path is malformed or unsupported."""
+
+
+# The parsing approach follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a SHACL ``sh:path`` triple into a path usable as a
+    predicate.
+
+    A valid SHACL path is either an IRI (a plain predicate), a blank node or
+    list that is a sequence path (an RDF list of at least two paths), an
+    inverse path, an alternative path (``sh:alternativePath`` with an RDF list
+    of at least two paths), or a modifier path (``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``).
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, which is the value of ``sh:path``.
+        It must be a :class:`~rdflib.term.URIRef` or blank node.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # sequence path: RDF list via rdf:first
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # inverse path: sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # alternative path: sh:alternativePath with an RDF list
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..cbf4450
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,93 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:noRestShape sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+ex:invShape sh:path [ sh:inversePath ex:p1 ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAltShape sh:path [ sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) ) ] .
+ex:zomShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oomShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zoShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:combinedShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nilShape sh:path rdf:nil .
+ex:emptySeqShape sh:path () .
+ex:oneSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:other ex:p1 ] .
+ex:literalShape sh:path "abc" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        ("iriShape", EX.p1),
+        ("seqShape", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSeqShape", EX.p1 / (EX.p2 / EX.p3)),
+        ("noRestShape", EX.p1 / EX.p2),
+        ("invShape", ~EX.p1),
+        ("altShape", EX.p1 | EX.p2 | EX.p3),
+        ("nestedAltShape", EX.p1 | (EX.p2 / EX.p3)),
+        ("zomShape", EX.p1 * "*"),  # type: ignore[operator]
+        ("oomShape", EX.p1 * "+"),  # type: ignore[operator]
+        ("zoShape", EX.p1 * "?"),  # type: ignore[operator]
+        ("combinedShape", ~EX.p1 * "*"),
+        ("nilShape", SHACLPathError),
+        ("emptySeqShape", SHACLPathError),
+        ("oneSeqShape", SHACLPathError),
+        ("emptyAltShape", SHACLPathError),
+        ("oneAltShape", SHACLPathError),
+        ("unknownShape", SHACLPathError),
+        ("literalShape", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    shape = EX[shape_name]
+    path_node = shapes.value(shape, SH.path)
+    triples_before = len(shapes)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert len(shapes) == triples_before
+
+
+def test_non_node_input(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p1")  # type: ignore[arg-type]
