@@ -0,0 +1,84 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value does not describe a valid SHACL path."""
+
+
+# The approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the value of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of: an IRI (a plain predicate); an RDF list
+    of two or more paths (a sequence path); a blank node with
+    ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of two or more
+    paths), or one of ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+    ``sh:zeroOrOnePath``. The forms nest recursively.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The object node of a ``sh:path`` triple, not the
+        shape subject.
+    :returns: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the value is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"{path_identifier!r} is not a valid SHACL path node")
+
+    # rdf:first: an RDF list used as a sequence path
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        members = list(shapes_graph.items(path_identifier))
+        if len(members) < 2:
+            raise SHACLPathError("A sequence path needs at least two items")
+        return SequencePath(
+            *(parse_shacl_path(shapes_graph, member) for member in members)
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of alternatives
+    alternatives_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_list is not None:
+        alternatives = list(shapes_graph.items(alternatives_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError("An alternative path needs at least two items")
+        return AlternativePath(
+            *(parse_shacl_path(shapes_graph, alt) for alt in alternatives)
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..83c3182
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shapes/> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ex:c ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] ex:d )
+] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:starInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:seqInAlt sh:path [
+    sh:alternativePath ( [ sh:inversePath ex:p ] ( ex:p1 ex:p2 ) )
+] .
+
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    # A list whose final cell has rdf:first but no rdf:rest.
+    g.parse(
+        data="""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+        @prefix ex: <http://example.org/shapes/> .
+        _:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+        _:l2 rdf:first ex:p2 .
+        ex:openList sh:path _:l1 .
+        """,
+        format="turtle",
+    )
+    return g
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected", "error"),
+    [
+        ("iri", EX.p, None),
+        ("seq", EX.p1 / EX.p2 / EX.p3, None),
+        ("nestedSeq", EX.p1 / (EX.p2 / EX.p3), None),
+        ("openList", EX.p1 / EX.p2, None),
+        ("inv", ~EX.p, None),
+        ("alt", EX.a | EX.b | EX.c, None),
+        ("nestedAlt", EX.a | (EX.b | EX.c) | EX.d, None),
+        ("star", EX.p * "*", None),  # type: ignore[operator]
+        ("plus", EX.p * "+", None),  # type: ignore[operator]
+        ("opt", EX.p * "?", None),  # type: ignore[operator]
+        ("starInv", (~EX.p) * "*", None),
+        ("seqInAlt", (~EX.p) | (EX.p1 / EX.p2), None),
+        ("emptySeq", None, SHACLPathError),
+        ("oneSeq", None, SHACLPathError),
+        ("emptyAlt", None, SHACLPathError),
+        ("oneAlt", None, SHACLPathError),
+        ("unknown", None, SHACLPathError),
+        ("literal", None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape: str,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    path_node = graph.value(EX[shape], SH.path)
+    before = set(graph)
+    if error is None:
+        assert parse_shacl_path(graph, path_node) == expected  # type: ignore[arg-type]
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+    assert set(graph) == before
+
+
+def test_missing_shape_raises(graph: Graph) -> None:
+    missing = graph.value(EX.missing, SH.path)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, missing)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/shapes/p"])
+def test_non_node_input_raises(graph: Graph, value: Union[None, str]) -> None:
+    before = set(graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, value)  # type: ignore[arg-type]
+    assert set(graph) == before
