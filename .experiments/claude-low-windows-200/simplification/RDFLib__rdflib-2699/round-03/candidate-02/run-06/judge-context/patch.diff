index 0000000..6170fe5
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,130 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shapes#")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/shapes#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt3 sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:altNestedInSeq sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifierOfInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:missingRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:nilOrEmptySeq sh:path () .
+ex:oneItemSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literalPath sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected, error",
+    [
+        pytest.param(EX.iri, EX.p1, None, id="iri"),
+        pytest.param(EX.seq3, EX.p1 / EX.p2 / EX.p3, None, id="sequence"),
+        pytest.param(
+            EX.seqNested,
+            EX.p1 / (EX.p2 / EX.p3),
+            None,
+            id="nested-sequence",
+        ),
+        pytest.param(EX.inverse, ~EX.p1, None, id="inverse"),
+        pytest.param(EX.alt3, EX.p1 | EX.p2 | EX.p3, None, id="alternative"),
+        pytest.param(
+            EX.altNestedInSeq,
+            EX.p1 / (EX.p2 | EX.p3),
+            None,
+            id="alternative-in-sequence",
+        ),
+        pytest.param(
+            EX.zeroOrMore,
+            EX.p1 * "*",  # type: ignore[operator]
+            None,
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMore,
+            EX.p1 * "+",  # type: ignore[operator]
+            None,
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOne,
+            EX.p1 * "?",  # type: ignore[operator]
+            None,
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.modifierOfInverse,
+            (~EX.p1) * "*",
+            None,
+            id="modifier-of-inverse",
+        ),
+        pytest.param(EX.missingRest, EX.p1 / EX.p2, None, id="list-without-rest"),
+        pytest.param(EX.nilOrEmptySeq, None, SHACLPathError, id="nil-or-empty-seq"),
+        pytest.param(EX.oneItemSeq, None, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlt, None, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneItemAlt, None, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unrecognized, None, SHACLPathError, id="unrecognized-node"),
+        pytest.param(EX.literalPath, None, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, None],
+    error: Optional[Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    if error is None:
+        result = parse_shacl_path(
+            shapes_graph,
+            shapes_graph.value(shape, SH.path),  # type: ignore[arg-type]
+        )
+        assert result == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(
+                shapes_graph,
+                shapes_graph.value(shape, SH.path),  # type: ignore[arg-type]
+            )
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(
+    "path_value",
+    [
+        pytest.param(None, id="none"),
+        pytest.param("ex:p1", id="plain-string"),
+    ],
+)
+def test_non_node_input_raises(shapes_graph: Graph, path_value: object) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_value)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
