@@ -0,0 +1,99 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The parsing approach follows pyshacl's conversion of SHACL paths to SPARQL.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI naming a plain predicate; an RDF list
+    of two or more paths (a sequence path); a blank node with ``sh:inversePath``;
+    a blank node with ``sh:alternativePath`` whose RDF list has two or more paths;
+    or a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+    ``sh:zeroOrOnePath``. Each nested value is itself a path, parsed recursively.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes. It
+        is only read, never modified.
+    :param path_identifier: The path node, an IRI, blank node, or
+        :class:`~rdflib.term.Literal`, that is the value of ``sh:path``.
+    :return: The :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized, or if
+        ``path_identifier`` is not a node.
+    """
+    # Typed as object so that non-node inputs such as None are caught here
+    # rather than being treated as wildcards by the graph lookups below.
+    candidate: object = path_identifier
+    if not isinstance(candidate, Node):
+        raise SHACLPathError(
+            f"Path value {candidate!r} is not a node and matches no SHACL path form"
+        )
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first marks a sequence path, given as an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "A sequence path needs at least two items, found "
+                f"{len(sequence_items)}: {path_identifier!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath marks an inverse path.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath marks an alternative path, given as an RDF list.
+    alternatives_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_list is not None:
+        alternative_items = list(shapes_graph.items(alternatives_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items, found "
+                f"{len(alternative_items)}: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath marks a path repeated zero or more times ("*").
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath marks a path repeated one or more times ("+").
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath marks a path matched zero or one times ("?").
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
