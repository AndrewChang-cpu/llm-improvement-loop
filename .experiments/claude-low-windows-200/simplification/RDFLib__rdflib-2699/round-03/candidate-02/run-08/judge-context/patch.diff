index 0000000..6d1c8db
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import BNode, Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        ( ex:p4 ex:p5 )
+    )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverseZeroOrMore sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected, error",
+    [
+        ("iri", EX.p1, None),
+        ("sequence", EX.p1 / EX.p2 / EX.p3, None),
+        ("nestedSequence", EX.p1 / (EX.p2 / EX.p3), None),
+        ("inverse", ~EX.p1, None),
+        ("alternative", EX.p1 | EX.p2 | EX.p3, None),
+        (
+            "nestedAlternative",
+            EX.p1 | (EX.p2 | EX.p3) | (EX.p4 / EX.p5),
+            None,
+        ),
+        ("zeroOrMore", EX.p1 * "*", None),  # type: ignore[operator]
+        ("oneOrMore", EX.p1 * "+", None),  # type: ignore[operator]
+        ("zeroOrOne", EX.p1 * "?", None),  # type: ignore[operator]
+        ("inverseZeroOrMore", (~EX.p1) * "*", None),
+        ("emptyList", None, SHACLPathError),
+        ("oneItemSequence", None, SHACLPathError),
+        ("emptyAlternative", None, SHACLPathError),
+        ("oneItemAlternative", None, SHACLPathError),
+        ("unrecognized", None, SHACLPathError),
+        ("literal", None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, None],
+    error: Optional[Type[Exception]],
+) -> None:
+    before = set(shapes)
+    path_node = shapes.value(EX[shape], SH.path)
+    assert path_node is not None
+    if error is None:
+        assert expected is not None
+        assert parse_shacl_path(shapes, path_node) == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path_node)
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("bad", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(shapes: Graph, bad: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad)  # type: ignore[arg-type]
+
+
+def test_list_final_cell_without_rest_is_read() -> None:
+    graph = Graph()
+    cell = BNode()
+    graph.add((EX.shape, SH.path, cell))
+    graph.add((cell, RDF.first, EX.p1))
+    rest = BNode()
+    graph.add((cell, RDF.rest, rest))
+    graph.add((rest, RDF.first, EX.p2))
+    assert parse_shacl_path(graph, cell) == EX.p1 / EX.p2
