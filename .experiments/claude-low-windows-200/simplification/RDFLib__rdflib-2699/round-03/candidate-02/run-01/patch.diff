@@ -0,0 +1,104 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import BNode, Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path is malformed or unusable."""
+
+
+# The path parsing below is based on the SHACL-to-SPARQL path conversion in
+# pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into a predicate.
+
+    A valid SHACL path is either an IRI (a plain predicate), or a blank node
+    using one of the SHACL path forms: an RDF list of at least two items
+    (a sequence path), ``sh:inversePath``, ``sh:alternativePath`` whose value
+    is an RDF list of at least two items, or ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``. Nested paths are parsed
+    recursively.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The node that is the value of ``sh:path``, an
+        :class:`~rdflib.term.URIRef` or :class:`~rdflib.term.BNode`.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or not recognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths: %r" % (path_identifier,))
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Only blank nodes can carry path structure. Checking here also keeps
+    # None and plain strings out of the graph lookups below, where None
+    # would act as a wildcard.
+    if not isinstance(path_identifier, BNode):
+        raise SHACLPathError(
+            "Not a recognized SHACL path node: %r" % (path_identifier,)
+        )
+
+    # Sequence path: the node is the head of an RDF list (rdf:first).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "A sequence path needs two items: %r" % (path_identifier,)
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs two items: %r" % (path_identifier,)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..20faebf
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,142 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:IriShape sh:path ex:p1 .
+ex:SequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:NestedSequenceShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:OpenListShape sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:InverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:AlternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:NestedAlternativeShape sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:ZeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:OneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:ZeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:InverseModifierShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:SequenceWithModifierShape sh:path ( ex:p1 [ sh:oneOrMorePath ex:p2 ] ) .
+ex:EmptyListShape sh:path () .
+ex:OneItemSequenceShape sh:path ( ex:p1 ) .
+ex:EmptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:OneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:UnknownShape sh:path [ ex:other ex:p1 ] .
+ex:LiteralShape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected", "error"),
+    [
+        pytest.param(EX.IriShape, EX.p1, None, id="iri"),
+        pytest.param(EX.SequenceShape, EX.p1 / EX.p2 / EX.p3, None, id="sequence"),
+        pytest.param(
+            EX.NestedSequenceShape,
+            EX.p1 / (EX.p2 / EX.p3),
+            None,
+            id="nested-sequence",
+        ),
+        pytest.param(EX.OpenListShape, EX.p1 / EX.p2, None, id="open-list"),
+        pytest.param(EX.InverseShape, ~EX.p1, None, id="inverse"),
+        pytest.param(
+            EX.AlternativeShape, EX.p1 | EX.p2 | EX.p3, None, id="alternative"
+        ),
+        pytest.param(
+            EX.NestedAlternativeShape,
+            EX.p1 | (EX.p2 | EX.p3),
+            None,
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.ZeroOrMoreShape,
+            EX.p1 * "*",  # type: ignore[operator]
+            None,
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.OneOrMoreShape,
+            EX.p1 * "+",  # type: ignore[operator]
+            None,
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.ZeroOrOneShape,
+            EX.p1 * "?",  # type: ignore[operator]
+            None,
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.InverseModifierShape,
+            (~EX.p1) * "*",
+            None,
+            id="inverse-under-modifier",
+        ),
+        pytest.param(
+            EX.SequenceWithModifierShape,
+            EX.p1 / (EX.p2 * "+"),  # type: ignore[operator]
+            None,
+            id="modifier-in-sequence",
+        ),
+        pytest.param(EX.EmptyListShape, None, SHACLPathError, id="empty-list"),
+        pytest.param(
+            EX.OneItemSequenceShape, None, SHACLPathError, id="one-item-sequence"
+        ),
+        pytest.param(
+            EX.EmptyAlternativeShape, None, SHACLPathError, id="empty-alternative"
+        ),
+        pytest.param(
+            EX.OneItemAlternativeShape,
+            None,
+            SHACLPathError,
+            id="one-item-alternative",
+        ),
+        pytest.param(EX.UnknownShape, None, SHACLPathError, id="unrecognized-bnode"),
+        pytest.param(EX.LiteralShape, None, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    before = set(shapes)
+    path_node = shapes.value(shape, SH.path)
+    if error is None:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/shapes#p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph, value: Optional[str]
+) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, value)  # type: ignore[arg-type]
+    assert set(shapes) == before
