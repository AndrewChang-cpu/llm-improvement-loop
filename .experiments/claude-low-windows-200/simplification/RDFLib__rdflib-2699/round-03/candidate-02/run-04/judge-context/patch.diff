index 0000000..77f2bcc
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,88 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path expression is malformed or unsupported."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is an IRI (a plain predicate), or a blank node or
+    list that uses one of the SHACL path forms: a sequence (an RDF list of
+    at least two paths), an inverse (``sh:inversePath``), an alternative
+    (``sh:alternativePath``, an RDF list of at least two paths), or a
+    modifier (``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``). The parser only reads from the graph.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It must be a :class:`~rdflib.term.URIRef` or a blank node.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or not recognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"expected a node as SHACL path, got {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of at least two paths.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of at least two paths.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alt_items = list(shapes_graph.items(alternative_list))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"alternative path needs at least two items, got {len(alt_items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath "*", sh:oneOrMorePath "+",
+    # sh:zeroOrOnePath "?".
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..258a97c
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shapes#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_seq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nested_alt sh:path [
+    sh:alternativePath ( ( ex:p1 ex:p2 ) ex:p3 ex:p4 )
+] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverse_star sh:path [
+    sh:zeroOrMorePath [ sh:inversePath ex:p1 ]
+] .
+ex:dangling sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+ex:empty_seq sh:path () .
+ex:one_seq sh:path ( ex:p1 ) .
+ex:empty_alt sh:path [ sh:alternativePath () ] .
+ex:one_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p1),
+    ("seq", EX.p1 / EX.p2 / EX.p3),
+    ("nested_seq", EX.p1 / (EX.p2 / EX.p3)),
+    ("inverse", ~EX.p1),
+    ("alt", EX.p1 | EX.p2 | EX.p3),
+    ("nested_alt", ((EX.p1 / EX.p2) | EX.p3) | EX.p4),
+    ("zero_or_more", EX.p1 * "*"),  # type: ignore[operator]
+    ("one_or_more", EX.p1 * "+"),  # type: ignore[operator]
+    ("zero_or_one", EX.p1 * "?"),  # type: ignore[operator]
+    ("inverse_star", (~EX.p1) * "*"),
+    ("dangling", EX.p1 / EX.p2),
+]
+
+INVALID_CASES: list[tuple[str, Type[Exception]]] = [
+    ("empty_seq", SHACLPathError),
+    ("one_seq", SHACLPathError),
+    ("empty_alt", SHACLPathError),
+    ("one_alt", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    VALID_CASES + INVALID_CASES,
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    shape = EX[shape_name]
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    before = set(shapes_graph)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)
+        assert result == expected
+        assert result.n3() == expected.n3()
+    assert set(shapes_graph) == before
+
+
+def test_rdf_nil_is_not_a_path(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
+
+
+def test_none_raises_shacl_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+
+
+def test_plain_string_raises_shacl_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(
+            shapes_graph, "http://example.org/shapes#p1"  # type: ignore[arg-type]
+        )
+
+
+def test_literal_raises_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("p1"))
