+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modinv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+
+ex:unclosed sh:path _:cell1 .
+_:cell1 rdf:first ex:p1 ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:p2 .
+
+ex:nilpath sh:path rdf:nil .
+ex:emptyseq sh:path () .
+ex:oneseq sh:path ( ex:p1 ) .
+ex:emptyalt sh:path [ sh:alternativePath () ] .
+ex:onealt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p1),
+    ("seq", EX.p1 / EX.p2 / EX.p3),
+    ("nested", EX.p1 / (EX.p2 | EX.p3)),
+    ("inv", ~EX.p1),
+    ("star", EX.p1 * "*"),  # type: ignore[operator]
+    ("plus", EX.p1 * "+"),  # type: ignore[operator]
+    ("opt", EX.p1 * "?"),  # type: ignore[operator]
+    ("modinv", ~EX.p1 * "*"),
+    ("alt", EX.p1 | EX.p2),
+    ("unclosed", EX.p1 / EX.p2),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("nilpath", SHACLPathError),
+    ("emptyseq", SHACLPathError),
+    ("oneseq", SHACLPathError),
+    ("emptyalt", SHACLPathError),
+    ("onealt", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize("shape_name, expected", VALID_CASES)
+def test_valid_shacl_paths(
+    shapes_graph: Graph, shape_name: str, expected: Union[URIRef, Path]
+) -> None:
+    path_node = shapes_graph.value(EX[shape_name], SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("shape_name, exc_type", INVALID_CASES)
+def test_invalid_shacl_paths(
+    shapes_graph: Graph, shape_name: str, exc_type: type[Exception]
+) -> None:
+    path_node = shapes_graph.value(EX[shape_name], SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_error(
+    shapes_graph: Graph, bad_input: str | None
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for name, _ in VALID_CASES:
+        node = shapes_graph.value(EX[name], SH.path)
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    for name, exc_type in INVALID_CASES:
+        node = shapes_graph.value(EX[name], SH.path)
+        with pytest.raises(exc_type):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
