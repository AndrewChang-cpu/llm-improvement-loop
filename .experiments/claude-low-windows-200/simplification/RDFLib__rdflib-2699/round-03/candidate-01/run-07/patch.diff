+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into a predicate usable with rdflib.
+
+    A valid SHACL path is one of:
+
+    * an IRI, which is returned unchanged;
+    * an RDF list of two or more paths, meaning a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF list
+      of two or more paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The path node, i.e. the object of a ``sh:path``
+        triple. It may be an IRI, a blank node or a literal.
+    :return: The IRI itself as a :class:`~rdflib.term.URIRef`, or a
+        :class:`~rdflib.paths.Path` instance for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized, or if
+        ``path_identifier`` is not a node.
+    """
+    # Typed as object so the node check below is meaningful at runtime: None
+    # and plain strings must not reach graph lookups, where None acts as a
+    # wildcard.
+    candidate: object = path_identifier
+    if not isinstance(candidate, Node):
+        raise SHACLPathError(f"SHACL path must be a node, got {candidate!r}")
+
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"literals are not valid SHACL paths, got {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list: a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items, got {len(items)} "
+                f"in {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternatives = list(shapes_graph.items(alternative_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "alternative path needs at least two items, got "
+                f"{len(alternatives)} in {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..05d36e9
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:a ex:b ex:c ) .
+ex:nestedSeq sh:path ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] ) .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modOfInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:tailList sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:nil sh:path () .
+ex:oneItemSeq sh:path ( ex:a ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown sh:path [ ex:other ex:x ] .
+ex:literal sh:path "text" .
+ex:cyclic sh:path _:cyc .
+_:cyc rdf:first ex:a ; rdf:rest _:cyc .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p),
+    ("seq", EX.a / EX.b / EX.c),
+    ("nestedSeq", EX.a / (EX.b | EX.c)),
+    ("inv", ~EX.p),
+    ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+    ("modOfInv", ~EX.p * "*"),
+    ("alt", EX.a | EX.b),
+    ("tailList", EX.a / EX.b),
+]
+
+INVALID_CASES: list[tuple[str, Type[Exception]]] = [
+    ("nil", SHACLPathError),
+    ("oneItemSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneItemAlt", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph, shape: str, expected: Union[URIRef, Path]
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(("shape", "exc_type"), INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph, shape: str, exc_type: Type[Exception]
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_cyclic_list_raises_value_error(shapes_graph: Graph) -> None:
+    path_node = shapes_graph.value(EX.cyclic, SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: Union[None, str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    shape_names = [name for name, _ in VALID_CASES] + [
+        name for name, _ in INVALID_CASES
+    ]
+    for shape in shape_names:
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
