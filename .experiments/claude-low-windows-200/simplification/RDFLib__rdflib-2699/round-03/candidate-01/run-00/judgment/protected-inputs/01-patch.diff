index 0000000..e9d74cf
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,126 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_seq sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:open_list sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifier_of_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:empty_seq sh:path ( ) .
+ex:one_seq sh:path ( ex:p1 ) .
+ex:empty_alt sh:path [ sh:alternativePath ( ) ] .
+ex:one_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:notAPath ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param(EX.iri, EX.p1, id="iri"),
+        pytest.param(
+            EX.seq,
+            EX.p1 / EX.p2 / EX.p3,  # type: ignore[operator]
+            id="sequence",
+        ),
+        pytest.param(
+            EX.nested_seq,
+            EX.p1 / (EX.p2 | EX.p3),  # type: ignore[operator]
+            id="nested-sequence-with-alternative",
+        ),
+        pytest.param(
+            EX.open_list,
+            EX.p1 / EX.p2,  # type: ignore[operator]
+            id="open-ended-list",
+        ),
+        pytest.param(
+            EX.inverse,
+            ~EX.p1,  # type: ignore[operator]
+            id="inverse",
+        ),
+        pytest.param(
+            EX.zero_or_more,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.one_or_more,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zero_or_one,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.modifier_of_inverse,
+            (~EX.p1) * "*",  # type: ignore[operator]
+            id="modifier-of-inverse",
+        ),
+        pytest.param(EX.empty_seq, SHACLPathError, id="empty-sequence-and-rdf-nil"),
+        pytest.param(EX.one_seq, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.empty_alt, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.one_alt, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknown, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("node", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    node: Union[None, str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+def test_parsing_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for path_node in shapes_graph.objects(predicate=SH.path):
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (TypeError, SHACLPathError):
+            pass
+    assert set(shapes_graph) == before
