index 0000000..c6a5b1f
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSeq sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:tail sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.iri, EX.p, id="iri"),
+        pytest.param(EX.seq, EX.p / EX.q / EX.r, id="sequence"),
+        pytest.param(EX.nestedSeq, EX.p / (EX.q | EX.r), id="nested-sequence"),
+        pytest.param(EX.inv, ~EX.p, id="inverse"),
+        pytest.param(EX.star, EX.p * "*", id="zero-or-more"),  # type: ignore[operator]
+        pytest.param(EX.plus, EX.p * "+", id="one-or-more"),  # type: ignore[operator]
+        pytest.param(EX.opt, EX.p * "?", id="zero-or-one"),  # type: ignore[operator]
+        pytest.param(EX.invStar, (~EX.p) * "*", id="modifier-of-inverse"),
+        pytest.param(EX.tail, EX.p / EX.q, id="list-without-rest"),
+        pytest.param(EX.alt, EX.p | EX.q, id="alternative"),
+        pytest.param(EX.nilPath, SHACLPathError, id="rdf-nil-or-empty-sequence"),
+        pytest.param(EX.oneSeq, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlt, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneAlt, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknown, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(graph, path_node) == expected  # type: ignore[arg-type]
+
+
+def test_non_node_inputs_raise_shacl_path_error(graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, "http://example.org/p")  # type: ignore[arg-type]
+
+
+def test_parser_leaves_graph_unchanged(graph: Graph) -> None:
+    before = set(graph)
+    for shape in set(graph.subjects(SH.path, None)):
+        path_node = graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(graph) == before
