index 0000000..1cda0ed
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,91 @@
+from __future__ import annotations
+
+from typing import Optional, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:IRIShape sh:path ex:p .
+ex:SequenceShape sh:path ( ex:a ex:b ex:c ) .
+ex:NestedSequenceShape sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:AlternativeShape sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:InverseShape sh:path [ sh:inversePath ex:p ] .
+ex:ZeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:OneOrMoreShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:ZeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:ModifiedInverseShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:TruncatedSequenceShape sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+
+ex:NilShape sh:path () .
+ex:OneItemSequenceShape sh:path ( ex:a ) .
+ex:EmptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:OneItemAlternativeShape sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:UnrecognizedShape sh:path [ ex:unknown ex:a ] .
+ex:LiteralShape sh:path "abc" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.IRIShape, EX.p),
+        (EX.SequenceShape, EX.a / EX.b / EX.c),
+        (EX.NestedSequenceShape, EX.a / (EX.b / EX.c)),
+        (EX.AlternativeShape, EX.a | EX.b),
+        (EX.InverseShape, ~EX.p),
+        (EX.ZeroOrMoreShape, EX.p * "*"),  # type: ignore[operator]
+        (EX.OneOrMoreShape, EX.p * "+"),  # type: ignore[operator]
+        (EX.ZeroOrOneShape, EX.p * "?"),  # type: ignore[operator]
+        (EX.ModifiedInverseShape, ~EX.p * "*"),
+        (EX.TruncatedSequenceShape, EX.a / EX.b),
+        (EX.NilShape, SHACLPathError),
+        (EX.OneItemSequenceShape, SHACLPathError),
+        (EX.EmptyAlternativeShape, SHACLPathError),
+        (EX.OneItemAlternativeShape, SHACLPathError),
+        (EX.UnrecognizedShape, SHACLPathError),
+        (EX.LiteralShape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    before = set(shapes)
+    path_node = shapes.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    bad_input: Optional[str],
+) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
+    assert set(shapes) == before
