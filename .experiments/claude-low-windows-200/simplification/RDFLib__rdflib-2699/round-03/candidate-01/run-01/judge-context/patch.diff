+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure is malformed or unsupported."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI denoting a plain predicate, or a
+    blank node (or RDF list) describing a complex path: an RDF list of
+    paths (a sequence path), ``sh:inversePath``, ``sh:alternativePath``
+    (an RDF list of paths), or one of ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath`` and ``sh:zeroOrOnePath``. Sequence and alternative
+    lists must contain at least two items, and ``rdf:nil`` is not a valid
+    path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The :class:`~rdflib.term.Node` that is the value
+        of ``sh:path``, i.e. the object of the ``sh:path`` triple.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized, or if
+        ``path_identifier`` is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            f"Non-node input is not a valid SHACL path: {path_identifier!r}"
+        )
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list of paths: a sequence path (no SHACL term; RDF list only)
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return paths.MulPath(
+            parse_shacl_path(shapes_graph, zero_or_more_value), "*"
+        )
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return paths.MulPath(
+            parse_shacl_path(shapes_graph, one_or_more_value), "+"
+        )
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return paths.MulPath(
+            parse_shacl_path(shapes_graph, zero_or_one_value), "?"
+        )
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..e305922
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,117 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.com/shacl/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/shacl/> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:sequenceNoRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nested sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:inversePath ex:p3 ]
+    ex:p4
+) .
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:unknown ex:p1 ] .
+ex:literal sh:path "ex:p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+def _path_of(graph: Graph, shape: URIRef) -> Node:
+    path_node = graph.value(shape, SH.path)
+    assert path_node is not None
+    return path_node
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p1),
+    ("sequence", EX.p1 / EX.p2 / EX.p3),
+    ("sequenceNoRest", EX.p1 / EX.p2),
+    ("inverse", ~EX.p1),
+    ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+    ("alternative", EX.p1 | EX.p2),
+    ("modifiedInverse", (~EX.p1) * "*"),
+    ("nested", (EX.p1 | EX.p2) / (~EX.p3) / EX.p4),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("emptyList", SHACLPathError),
+    ("oneItemSequence", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("oneItemAlternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize(("shape_name", "expected"), VALID_CASES)
+def test_valid_shacl_path(
+    shapes_graph: Graph, shape_name: str, expected: Union[URIRef, Path]
+) -> None:
+    path_node = _path_of(shapes_graph, EX[shape_name])
+    assert parse_shacl_path(shapes_graph, path_node) == expected
+
+
+@pytest.mark.parametrize(("shape_name", "exc_type"), INVALID_CASES)
+def test_invalid_shacl_path(
+    shapes_graph: Graph, shape_name: str, exc_type: type[Exception]
+) -> None:
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, _path_of(shapes_graph, EX[shape_name]))
+
+
+def test_missing_shape_lookup_raises(shapes_graph: Graph) -> None:
+    missing_path = shapes_graph.value(EX.missing, SH.path)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, missing_path)  # type: ignore[arg-type]
+
+
+def test_none_input_raises(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+
+
+def test_plain_string_input_raises(shapes_graph: Graph) -> None:
+    plain = "http://example.com/shacl/p1"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, plain)  # type: ignore[arg-type]
+
+
+def test_parser_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    parse_shacl_path(shapes_graph, _path_of(shapes_graph, EX.nested))
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, _path_of(shapes_graph, EX.emptyList))
+    assert set(shapes_graph) == before
