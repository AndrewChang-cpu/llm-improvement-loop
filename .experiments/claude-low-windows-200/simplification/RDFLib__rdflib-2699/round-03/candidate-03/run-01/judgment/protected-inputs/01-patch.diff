+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# Based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI naming a plain predicate; an RDF list
+    of two or more paths, denoting a sequence path; a blank node with
+    ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of two or more
+    paths), or one of ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` and
+    ``sh:zeroOrOnePath``. Paths nest recursively.
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The node that is the value of ``sh:path``, i.e. the
+        object of the ``sh:path`` triple, not the shape subject.
+    :returns: The IRI itself for a plain predicate, or a
+        :class:`~rdflib.paths.Path` instance (e.g.
+        :class:`~rdflib.paths.SequencePath`) for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or the input is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        # A plain predicate; rdf:nil is the empty list, not a path.
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    if not isinstance(path_identifier, Node):
+        # None and plain strings are not nodes; never query the graph with
+        # them, since None would act as a wildcard.
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {path_identifier!r}")
+
+    # rdf:first: an RDF list denoting a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath: inverse of the parsed value.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of two or more paths.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        items = list(shapes_graph.items(alternative_value))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath: modifier paths.
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..d2e67ef
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,136 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriPath sh:path ex:p1 .
+
+ex:sequencePath sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSequencePath sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inversePath sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alternativePath sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlternativePath sh:path [
+    sh:alternativePath (
+        ex:p1
+        ( ex:p2 ex:p3 )
+        [ sh:alternativePath ( ex:p4 ex:p5 ) ]
+    )
+] .
+
+ex:zeroOrMorePath sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMorePath sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOnePath sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifiedInversePath sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:openListPath sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+
+ex:nilPath sh:path () .
+
+ex:oneItemSequencePath sh:path ( ex:p1 ) .
+
+ex:emptyAlternativePath sh:path [ sh:alternativePath () ] .
+
+ex:oneItemAlternativePath sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknownBlankNodePath sh:path [ ex:other ex:p1 ] .
+
+ex:literalPath sh:path "p1" .
+"""
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+def _p(name: str) -> URIRef:
+    return URIRef("http://example.com/" + name)
+
+
+VALID_CASES: List[Tuple[str, Union[URIRef, Path]]] = [
+    ("iriPath", _p("p1")),
+    ("sequencePath", _p("p1") / _p("p2") / _p("p3")),
+    ("nestedSequencePath", _p("p1") / (_p("p2") / _p("p3"))),
+    ("inversePath", ~_p("p1")),
+    ("alternativePath", _p("p1") | _p("p2") | _p("p3")),
+    (
+        "nestedAlternativePath",
+        _p("p1") | (_p("p2") / _p("p3")) | (_p("p4") | _p("p5")),
+    ),
+    ("zeroOrMorePath", _p("p1") * "*"),  # type: ignore[operator]
+    ("oneOrMorePath", _p("p1") * "+"),  # type: ignore[operator]
+    ("zeroOrOnePath", _p("p1") * "?"),  # type: ignore[operator]
+    ("modifiedInversePath", (~_p("p1")) * "*"),
+    ("openListPath", _p("p1") / _p("p2")),
+]
+
+INVALID_CASES: List[Tuple[str, Type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("oneItemSequencePath", SHACLPathError),
+    ("emptyAlternativePath", SHACLPathError),
+    ("oneItemAlternativePath", SHACLPathError),
+    ("unknownBlankNodePath", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path],
+) -> None:
+    node = shapes_graph.value(_p(shape), SH.path)
+    result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(("shape", "expected_exc"), INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected_exc: Type[Exception],
+) -> None:
+    node = shapes_graph.value(_p(shape), SH.path)
+    with pytest.raises(expected_exc):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+def test_none_and_string_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "p1")  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape, _ in VALID_CASES:
+        node = shapes_graph.value(_p(shape), SH.path)
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    for shape, exc in INVALID_CASES:
+        node = shapes_graph.value(_p(shape), SH.path)
+        with pytest.raises(exc):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
