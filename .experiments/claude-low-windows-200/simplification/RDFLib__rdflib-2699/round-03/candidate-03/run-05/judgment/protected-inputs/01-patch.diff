+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,88 @@
+"""Utilities for working with SHACL shapes graphs."""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib predicate.
+
+    A valid SHACL path is either an IRI naming a plain predicate, or a blank
+    node using one of the SHACL path forms: an RDF list of paths (a sequence),
+    ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of paths),
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``.
+    Sequences and alternatives must contain at least two items. The empty
+    list, ``rdf:nil``, is not a valid path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The node that is the value of ``sh:path``: a
+        :class:`~rdflib.term.URIRef` or blank node. A
+        :class:`~rdflib.term.Literal` raises ``TypeError``.
+    :returns: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path. The ``n3()`` output of
+        the result is usable as a SPARQL property path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the input is not a node, or is not a valid
+        SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first: a sequence path, given as an RDF list
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of paths
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..f080880
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,112 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:invShape sh:path [ sh:inversePath ex:p1 ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAltShape sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInvShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqWithInvShape sh:path ( [ sh:inversePath ex:p1 ] ex:p2 ) .
+ex:openListShape sh:path _:cell1 .
+_:cell1 rdf:first ex:p1 ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:p2 .
+
+ex:nilShape sh:path () .
+ex:oneItemSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:foo ex:bar ] .
+ex:literalShape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+# Operators applied to a bare IRI are reported by the type checker, so those
+# lines carry an operator ignore.
+VALID_CASES: List[Tuple[str, Union[URIRef, Path]]] = [
+    ("iriShape", EX.p1),
+    ("seqShape", EX.p1 / EX.p2 / EX.p3),  # type: ignore[operator]
+    ("nestedSeqShape", EX.p1 / (EX.p2 / EX.p3)),  # type: ignore[operator]
+    ("invShape", ~EX.p1),  # type: ignore[operator]
+    ("altShape", EX.p1 | EX.p2 | EX.p3),  # type: ignore[operator]
+    ("nestedAltShape", EX.p1 | (EX.p2 | EX.p3)),  # type: ignore[operator]
+    ("zeroOrMoreShape", EX.p1 * "*"),  # type: ignore[operator]
+    ("oneOrMoreShape", EX.p1 * "+"),  # type: ignore[operator]
+    ("zeroOrOneShape", EX.p1 * "?"),  # type: ignore[operator]
+    ("modInvShape", (~EX.p1) * "*"),  # type: ignore[operator]
+    ("seqWithInvShape", (~EX.p1) / EX.p2),  # type: ignore[operator]
+    ("openListShape", EX.p1 / EX.p2),  # type: ignore[operator]
+]
+
+INVALID_CASES: List[Tuple[str, Type[Exception]]] = [
+    ("nilShape", SHACLPathError),
+    ("oneItemSeqShape", SHACLPathError),
+    ("emptyAltShape", SHACLPathError),
+    ("oneItemAltShape", SHACLPathError),
+    ("unknownShape", SHACLPathError),
+    ("literalShape", TypeError),
+]
+
+
+@pytest.mark.parametrize("shape_name, expected", VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph, shape_name: str, expected: Union[URIRef, Path]
+) -> None:
+    before = set(shapes_graph)
+    result = parse_shacl_path(
+        shapes_graph,
+        shapes_graph.value(EX[shape_name], SH.path),  # type: ignore[arg-type]
+    )
+    assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("shape_name, exc_type", INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph, shape_name: str, exc_type: Type[Exception]
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(exc_type):
+        parse_shacl_path(
+            shapes_graph,
+            shapes_graph.value(EX[shape_name], SH.path),  # type: ignore[arg-type]
+        )
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: object
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
