@@ -0,0 +1,103 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Union
+
+from rdflib import Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+if TYPE_CHECKING:
+    from rdflib import Graph
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a SHACL shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a SHACL ``sh:path`` triple into an rdflib path.
+
+    The path identifier must be the object node of a ``sh:path`` triple.
+    A valid SHACL path is one of:
+
+    - an IRI other than ``rdf:nil``, which is returned unchanged;
+    - an RDF list of at least two paths, which is a sequence path;
+    - a blank node with ``sh:inversePath``, which is an inverse path;
+    - a blank node with ``sh:alternativePath`` whose value is an RDF list of
+      at least two paths, which is an alternative path;
+    - a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath``, which is a modifier path.
+
+    This follows the path handling of pyshacl's SHACL-to-SPARQL conversion.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, an IRI, blank node or
+        :class:`~rdflib.term.Literal`.
+    :return: the :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if the path node is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path node is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a SHACL path node: {path_identifier!r}")
+
+    # A plain predicate IRI is the path itself.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list used as a sequence path.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath, whose value is an RDF list
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..c9632ab
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,145 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+
+EX = Namespace("http://example.org/")
+
+TURTLE_SHAPES = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p .
+ex:nilShape sh:path () .
+ex:seqShape sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSeqShape sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:oneSeqShape sh:path ( ex:p ) .
+ex:tailShape sh:path _:tailCell1 .
+_:tailCell1 rdf:first ex:p ; rdf:rest _:tailCell2 .
+_:tailCell2 rdf:first ex:q .
+ex:inverseShape sh:path [ sh:inversePath ex:p ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+ex:nestedAltShape sh:path [
+    sh:alternativePath ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] )
+] .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneAltShape sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInverseShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:unrecognizedShape sh:path [ ex:other ex:p ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=TURTLE_SHAPES, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.iriShape, EX.p, id="iri"),
+        pytest.param(
+            EX.seqShape,
+            SequencePath(EX.p, EX.q, EX.r),
+            id="three-item-sequence",
+        ),
+        pytest.param(
+            EX.nestedSeqShape,
+            EX.p / (EX.q / EX.r),
+            id="nested-sequence",
+        ),
+        pytest.param(EX.tailShape, EX.p / EX.q, id="list-without-final-rest"),
+        pytest.param(EX.inverseShape, ~EX.p, id="inverse"),
+        pytest.param(
+            EX.altShape,
+            AlternativePath(EX.p, EX.q, EX.r),
+            id="three-item-alternative",
+        ),
+        pytest.param(
+            EX.nestedAltShape,
+            EX.p | (EX.q | EX.r),
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.zeroOrMoreShape,
+            EX.p * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMoreShape,
+            EX.p * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOneShape,
+            EX.p * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.modInverseShape,
+            (~EX.p) * "*",
+            id="modifier-of-inverse",
+        ),
+        pytest.param(EX.nilShape, SHACLPathError, id="rdf-nil-as-path"),
+        pytest.param(EX.oneSeqShape, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAltShape, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneAltShape, SHACLPathError, id="one-item-alternative"),
+        pytest.param(
+            EX.unrecognizedShape,
+            SHACLPathError,
+            id="unrecognized-blank-node",
+        ),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+        assert result == expected
+
+
+def test_literal_path_raises_type_error(shapes_graph: Graph) -> None:
+    path = shapes_graph.value(EX.literalShape, SH.path)
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+
+
+def test_none_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+
+
+def test_plain_string_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "http://example.org/p")  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    alt_path = shapes_graph.value(EX.altShape, SH.path)
+    nil_path = shapes_graph.value(EX.nilShape, SH.path)
+    parse_shacl_path(shapes_graph, EX.p)
+    parse_shacl_path(shapes_graph, alt_path)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, nil_path)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
