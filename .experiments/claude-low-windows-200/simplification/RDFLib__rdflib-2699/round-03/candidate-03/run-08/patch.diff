+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """
+    Raised when a SHACL path node is malformed, empty, or unrecognized.
+    """
+
+
+# The SHACL path parsing below is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into a predicate usable with rdflib.
+
+    A valid SHACL path is either an IRI (a plain predicate), or a blank node
+    describing a complex path: an RDF list of paths (a sequence), an
+    ``sh:inversePath``, an ``sh:alternativePath`` list, or one of the modifiers
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` and ``sh:zeroOrOnePath``.
+    Sequences and alternatives must contain at least two items.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It must be a :class:`~rdflib.term.URIRef` or a blank node;
+        a :class:`~rdflib.term.Literal` is rejected.
+    :return: the :class:`~rdflib.term.URIRef` itself for a plain predicate,
+        or a :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path is malformed or unrecognized, or if the
+        input is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths: %r" % (path_identifier,))
+
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError("SHACL path must be a node, got %r" % (path_identifier,))
+
+    # A plain predicate IRI is the path itself; rdf:nil is an empty list.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list: a sequence path. Count all items before parsing any of them.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "sequence path needs at least two items, got %d: %r"
+                % (len(items), path_identifier)
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: an RDF list of alternatives.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                "alternative path needs at least two items, got %d: %r"
+                % (len(alt_items), path_identifier)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..9ce750a
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,117 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iriPath sh:path ex:p1 .
+ex:seqPath sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqPath sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSeqPath sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+ex:invPath sh:path [ sh:inversePath ex:p1 ] .
+ex:altPath sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAltPath sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:zeroOrMorePath sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMorePath sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOnePath sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInvPath sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeqPath sh:path ( ) .
+ex:oneSeqPath sh:path ( ex:p1 ) .
+ex:emptyAltPath sh:path [ sh:alternativePath ( ) ] .
+ex:oneAltPath sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownPath sh:path [ ex:other ex:p1 ] .
+ex:literalPath sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+VALID_PATHS: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iriPath", EX.p1),
+    ("seqPath", EX.p1 / EX.p2 / EX.p3),
+    ("nestedSeqPath", EX.p1 / (EX.p2 / EX.p3)),
+    ("openSeqPath", EX.p1 / EX.p2),
+    ("invPath", ~EX.p1),
+    ("altPath", EX.p1 | EX.p2 | EX.p3),
+    ("nestedAltPath", EX.p1 | (EX.p2 | EX.p3)),
+    ("zeroOrMorePath", EX.p1 * "*"),  # type: ignore[operator]
+    ("oneOrMorePath", EX.p1 * "+"),  # type: ignore[operator]
+    ("zeroOrOnePath", EX.p1 * "?"),  # type: ignore[operator]
+    ("modInvPath", (~EX.p1) * "*"),
+]
+
+INVALID_PATHS: list[tuple[str, Type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("emptySeqPath", SHACLPathError),
+    ("oneSeqPath", SHACLPathError),
+    ("emptyAltPath", SHACLPathError),
+    ("oneAltPath", SHACLPathError),
+    ("unknownPath", SHACLPathError),
+]
+
+
+@pytest.mark.parametrize("shape, expected", VALID_PATHS)
+def test_valid_shacl_path(
+    shapes_graph: Graph, shape: str, expected: Union[URIRef, Path]
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("shape, exc", INVALID_PATHS)
+def test_invalid_shacl_path(
+    shapes_graph: Graph, shape: str, exc: Type[Exception]
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    with pytest.raises(exc):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_literal_path_raises_type_error(shapes_graph: Graph) -> None:
+    path_node = shapes_graph.value(EX.literalPath, SH.path)
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_none_path_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+
+
+def test_string_path_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    bad_path = "http://example.org/shapes#p1"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_path)  # type: ignore[arg-type]
+
+
+def test_graph_is_unchanged_after_parsing(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for _, path_node in shapes_graph.subject_objects(SH.path):
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
