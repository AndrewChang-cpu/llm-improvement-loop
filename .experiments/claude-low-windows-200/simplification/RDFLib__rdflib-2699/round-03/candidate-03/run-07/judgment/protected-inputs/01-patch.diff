@@ -0,0 +1,93 @@
+"""Utilities for working with SHACL shapes graphs."""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The parser below is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI, which is a plain predicate;
+    * an RDF list of two or more paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of two or more paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``
+      or ``sh:zeroOrOnePath``.
+
+    ``rdf:nil`` is not a valid path. Literals are not valid paths either.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The node that is the value of ``sh:path``: an
+        IRI, a blank node, or a literal.
+    :return: The :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a valid SHACL path node: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first: sequence path given as an RDF list
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: RDF list of two or more paths
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..f752d85
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import RDF, BNode, Graph, Literal, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = "http://example.org/"
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:iriShape sh:path ex:p .
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:invShape sh:path [ sh:inversePath ex:p ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAltShape sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ( ex:p3 ex:p4 ) ) ] )
+] .
+ex:zeroShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:optShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:combinedShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:nilShape sh:path () .
+ex:oneSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:other ex:p ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    # An RDF list whose final cell has rdf:first but no rdf:rest.
+    cell1 = BNode()
+    cell2 = BNode()
+    g.add((URIRef(EX + "openListShape"), SH.path, cell1))
+    g.add((cell1, RDF.first, URIRef(EX + "p1")))
+    g.add((cell1, RDF.rest, cell2))
+    g.add((cell2, RDF.first, URIRef(EX + "p2")))
+    return g
+
+
+def _p(name: str) -> URIRef:
+    return URIRef(EX + name)
+
+
+CASES: List[Tuple[str, Union[URIRef, Path, Type[Exception]]]] = [
+    ("iriShape", _p("p")),
+    ("seqShape", _p("p1") / _p("p2") / _p("p3")),
+    ("nestedSeqShape", _p("p1") / (_p("p2") / _p("p3"))),
+    ("invShape", ~_p("p")),
+    ("altShape", _p("p1") | _p("p2") | _p("p3")),
+    ("nestedAltShape", _p("p1") | (_p("p2") | (_p("p3") / _p("p4")))),
+    ("zeroShape", _p("p") * "*"),  # type: ignore[operator]
+    ("oneShape", _p("p") * "+"),  # type: ignore[operator]
+    ("optShape", _p("p") * "?"),  # type: ignore[operator]
+    ("combinedShape", ~_p("p") * "*"),
+    ("openListShape", _p("p1") / _p("p2")),
+    ("nilShape", SHACLPathError),
+    ("oneSeqShape", SHACLPathError),
+    ("emptyAltShape", SHACLPathError),
+    ("oneAltShape", SHACLPathError),
+    ("unknownShape", SHACLPathError),
+    ("literalShape", TypeError),
+]
+
+
+@pytest.mark.parametrize("shape, expected", CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(_p(shape), SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        parsed = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert parsed == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "plain string"])
+def test_non_node_input_raises_shacl_error(
+    shapes_graph: Graph,
+    bad_input: str,
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_literal_node_raises_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("text"))
