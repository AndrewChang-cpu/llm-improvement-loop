index 0000000..53d30f1
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,88 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:tailSeqShape sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:combinedShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nilShape sh:path rdf:nil .
+ex:emptySeqShape sh:path () .
+ex:oneSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:other ex:p1 ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected, error",
+    [
+        ("iriShape", EX.p1, None),
+        ("seqShape", EX.p1 / EX.p2, None),
+        ("nestedSeqShape", EX.p1 / (EX.p2 / EX.p3), None),
+        ("tailSeqShape", EX.p1 / EX.p2, None),
+        ("inverseShape", ~EX.p1, None),
+        ("altShape", EX.p1 | EX.p2 | EX.p3, None),
+        ("zeroOrMoreShape", EX.p1 * "*", None),  # type: ignore[operator]
+        ("oneOrMoreShape", EX.p1 * "+", None),  # type: ignore[operator]
+        ("zeroOrOneShape", EX.p1 * "?", None),  # type: ignore[operator]
+        ("combinedShape", ~EX.p1 * "*", None),
+        ("nilShape", None, SHACLPathError),
+        ("emptySeqShape", None, SHACLPathError),
+        ("oneSeqShape", None, SHACLPathError),
+        ("emptyAltShape", None, SHACLPathError),
+        ("oneAltShape", None, SHACLPathError),
+        ("unknownShape", None, SHACLPathError),
+        ("literalShape", None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape_name: str,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    before = set(graph)
+    path_node = graph.value(EX[shape_name], SH.path)
+    if error is not None:
+        with pytest.raises(error):
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(graph, path_node) == expected  # type: ignore[arg-type]
+    assert set(graph) == before
+
+
+def test_non_node_inputs_raise_shacl_path_error(graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, "http://example.org/p1")  # type: ignore[arg-type]
