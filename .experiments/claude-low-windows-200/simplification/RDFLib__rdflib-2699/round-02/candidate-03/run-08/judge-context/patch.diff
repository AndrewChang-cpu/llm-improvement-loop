index 0000000..4311cac
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from typing import Union, Type
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:starInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqAltMod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath ex:p3 ]
+) .
+ex:noRest sh:path _:n1 .
+_:n1 rdf:first ex:p1 ; rdf:rest _:n2 .
+_:n2 rdf:first ex:p2 .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "http://example.org/p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p1),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.inv, ~EX.p1),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.star, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.plus, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.opt, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.starInv, (~EX.p1) * "*"),
+        (EX.seqAltMod, (EX.p1 | EX.p2) / (EX.p3 * "*")),  # type: ignore[operator]
+        (EX.noRest, EX.p1 / EX.p2),
+        (EX.nilPath, SHACLPathError),
+        (EX.emptySeq, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes)
+    path = shapes.value(shape, SH.path)
+    assert path is not None
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path)
+    else:
+        result = parse_shacl_path(shapes, path)
+        assert result == expected
+        assert isinstance(result, type(expected))
+    assert set(shapes) == before
+
+
+def test_none_is_not_a_wildcard(shapes: Graph) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_plain_string_is_rejected(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p1")  # type: ignore[arg-type]
