@@ -0,0 +1,107 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib import paths as paths_module
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import BNode, Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path node is not a valid SHACL path."""
+
+
+# The SHACL path parser below is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI other than ``rdf:nil`` (a simple
+    path); a blank node that is an RDF list of two or more valid paths (a
+    sequence path); a blank node with ``sh:inversePath``; a blank node with
+    ``sh:alternativePath`` whose RDF list holds two or more valid paths; or a
+    blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``. Nested values are parsed recursively with the same
+    rules.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, that is the object of a ``sh:path``
+        triple. It must be a :class:`~rdflib.term.URIRef` or a blank node.
+    :return: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or not recognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    if not isinstance(path_identifier, BNode):
+        raise SHACLPathError(f"{path_identifier!r} is not a valid SHACL path node")
+
+    # RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"Sequence path {path_identifier!r} must have at least two items"
+            )
+        return paths_module.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return paths_module.InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path {path_identifier!r} must have at least two items"
+            )
+        return paths_module.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return paths_module.MulPath(
+            parse_shacl_path(shapes_graph, zero_or_more_value), "*"
+        )
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return paths_module.MulPath(
+            parse_shacl_path(shapes_graph, one_or_more_value), "+"
+        )
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return paths_module.MulPath(
+            parse_shacl_path(shapes_graph, zero_or_one_value), "?"
+        )
+
+    raise SHACLPathError(f"Unrecognized SHACL path node {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..e5a40e8
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,147 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ex:p3 ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        [ sh:zeroOrMorePath ex:p4 ]
+    )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqWithAlt sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:noRestList sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneItemSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownBlank sh:path [ ex:foo ex:bar ] .
+ex:literalPath sh:path "text" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        pytest.param(EX.simple, EX.p1, id="simple-iri"),
+        pytest.param(EX.seq, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nestedSeq,
+            EX.p1 / ~EX.p2 / EX.p3,
+            id="sequence-with-inverse",
+        ),
+        pytest.param(EX.inverse, ~EX.p1, id="inverse"),
+        pytest.param(EX.alt, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+        pytest.param(
+            EX.nestedAlt,
+            EX.p1 | (EX.p2 | EX.p3) | (EX.p4 * "*"),  # type: ignore[operator]
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.zeroOrMore,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMore,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOne,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.modInverse,
+            (~EX.p1) * "*",
+            id="modifier-of-inverse",
+        ),
+        pytest.param(
+            EX.seqWithAlt,
+            (EX.p1 | EX.p2) / (EX.p3 * "+"),  # type: ignore[operator]
+            id="sequence-with-alternative-and-modifier",
+        ),
+        pytest.param(
+            EX.noRestList,
+            EX.p1 / EX.p2,
+            id="list-ending-without-rest",
+        ),
+        pytest.param(EX.nilPath, SHACLPathError, id="rdf-nil-as-path"),
+        pytest.param(EX.emptySeq, SHACLPathError, id="empty-sequence"),
+        pytest.param(EX.oneItemSeq, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlt, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneItemAlt, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknownBlank, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literalPath, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    assert path_node is not None
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_node: object
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_node)  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for resource in (EX.seq, EX.nilPath, EX.unknownBlank):
+        path_node = shapes_graph.value(resource, SH.path)
+        assert path_node is not None
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except SHACLPathError:
+            pass
+    assert set(shapes_graph) == before
