index 0000000..4c3418d
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,101 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:simple sh:path ex:p1 .
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seqNested sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) ) .
+ex:seqNoRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:altNested sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:zom sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oom sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zoo sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqAlt sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:nilPath sh:path rdf:nil .
+ex:seqEmpty sh:path ( ) .
+ex:seqOne sh:path ( ex:p1 ) .
+ex:altEmpty sh:path [ sh:alternativePath ( ) ] .
+ex:altOne sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:notAPathPredicate ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "resource, expected, error",
+    [
+        (EX.simple, EX.p1, None),
+        (EX.seq3, EX.p1 / EX.p2 / EX.p3, None),
+        (EX.seqNested, EX.p1 / ~EX.p2 / (EX.p3 / EX.p4), None),
+        (EX.seqNoRest, EX.p1 / EX.p2, None),
+        (EX.inv, ~EX.p1, None),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3, None),
+        (EX.altNested, EX.p1 | (EX.p2 | EX.p3), None),
+        (EX.zom, EX.p1 * "*", None),  # type: ignore[operator]
+        (EX.oom, EX.p1 * "+", None),  # type: ignore[operator]
+        (EX.zoo, EX.p1 * "?", None),  # type: ignore[operator]
+        (EX.modInv, (~EX.p1) * "*", None),
+        (EX.seqAlt, (EX.p1 | EX.p2) / (EX.p3 * "+"), None),  # type: ignore[operator]
+        (EX.nilPath, None, SHACLPathError),
+        (EX.seqEmpty, None, SHACLPathError),
+        (EX.seqOne, None, SHACLPathError),
+        (EX.altEmpty, None, SHACLPathError),
+        (EX.altOne, None, SHACLPathError),
+        (EX.unknown, None, SHACLPathError),
+        (EX.literal, None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    assert path_node is not None
+    triples_before = set(shapes_graph)
+    if error is None:
+        assert expected is not None
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes_graph, path_node)
+    assert set(shapes_graph) == triples_before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: Optional[str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
