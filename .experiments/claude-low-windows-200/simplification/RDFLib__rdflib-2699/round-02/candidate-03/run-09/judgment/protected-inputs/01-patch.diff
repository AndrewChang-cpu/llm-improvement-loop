+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of two or more valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` to a valid path;
+    * a blank node with ``sh:alternativePath`` to an RDF list of two or
+      more valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` to a valid path.
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The node that is the value of ``sh:path``. It must
+        be an IRI or a blank node; a :class:`~rdflib.term.Literal` raises
+        :class:`TypeError`.
+    :return: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path is malformed or the input is not a
+        node of the shapes graph.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if path_identifier is None:
+        # None would act as a wildcard in Graph.value, so reject it up front.
+        raise SHACLPathError("None is not a valid SHACL path")
+
+    if isinstance(path_identifier, URIRef):
+        # Simple path: an IRI, except rdf:nil which denotes an empty list.
+        if path_identifier == RDF.nil:
+            raise SHACLPathError(
+                "rdf:nil is not a valid SHACL path; it denotes an empty list"
+            )
+        return path_identifier
+
+    # Sequence path: the node is an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternatives = list(shapes_graph.items(alternative_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "Alternative path must have at least two items, got "
+                f"{len(alternatives)}: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, a) for a in alternatives]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..6fcebdc
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,141 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+
+ex:seq_three sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seq_nested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seq_with_alt sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath [ sh:inversePath ex:p3 ] ]
+) .
+ex:seq_chain_no_rest sh:path _:chain1 .
+_:chain1 rdf:first ex:p1 ;
+    rdf:rest _:chain2 .
+_:chain2 rdf:first ex:p2 .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt_three sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:alt_nested sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifier_inverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:empty_list sh:path () .
+ex:one_item_seq sh:path ( ex:p1 ) .
+ex:empty_alt sh:path [ sh:alternativePath () ] .
+ex:one_item_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown_bnode sh:path [ ex:unrelated ex:p1 ] .
+ex:literal_path sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+def path_of(graph: Graph, shape: URIRef) -> URIRef | Path:
+    value = graph.value(shape, SH.path)
+    assert value is not None
+    return parse_shacl_path(graph, value)
+
+
+VALID_CASES: list[tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.iri, EX.p1),
+    (EX.seq_three, EX.p1 / EX.p2 / EX.p3),
+    (EX.seq_nested, EX.p1 / (EX.p2 / EX.p3)),
+    (
+        EX.seq_with_alt,
+        (EX.p1 | EX.p2) / (~EX.p3 * "*"),
+    ),
+    (EX.seq_chain_no_rest, EX.p1 / EX.p2),
+    (EX.inverse, ~EX.p1),
+    (EX.alt_three, EX.p1 | EX.p2 | EX.p3),
+    (EX.alt_nested, EX.p1 | (EX.p2 | EX.p3)),
+    (EX.zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.modifier_inverse, (~EX.p1) * "+"),
+]
+
+INVALID_CASES: list[tuple[URIRef, type[Exception]]] = [
+    (EX.empty_list, SHACLPathError),
+    (EX.one_item_seq, SHACLPathError),
+    (EX.empty_alt, SHACLPathError),
+    (EX.one_item_alt, SHACLPathError),
+    (EX.unknown_bnode, SHACLPathError),
+    (EX.literal_path, TypeError),
+]
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    VALID_CASES,
+    ids=[str(shape).rsplit("/", 1)[-1] for shape, _ in VALID_CASES],
+)
+def test_valid_shacl_paths(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    assert path_of(shapes_graph, shape) == expected
+
+
+@pytest.mark.parametrize(
+    "shape, exc_type",
+    INVALID_CASES,
+    ids=[str(shape).rsplit("/", 1)[-1] for shape, _ in INVALID_CASES],
+)
+def test_invalid_shacl_paths(
+    shapes_graph: Graph,
+    shape: URIRef,
+    exc_type: type[Exception],
+) -> None:
+    value = shapes_graph.value(shape, SH.path)
+    assert value is not None
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, value)
+
+
+def test_rdf_nil_as_path_raises(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_error(
+    shapes_graph: Graph,
+    bad_input: object,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_graph_unchanged_after_failed_parse(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    value = shapes_graph.value(EX.one_item_alt, SH.path)
+    assert value is not None
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, value)
+    assert set(shapes_graph) == before
