index 0000000..634a5dd
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p .
+ex:nil sh:path () .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:seqNested sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:seqOne sh:path ( ex:p ) .
+ex:seqPartial sh:path _:partial1 .
+_:partial1 rdf:first ex:p ; rdf:rest _:partial2 .
+_:partial2 rdf:first ex:q .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+ex:altEmpty sh:path [ sh:alternativePath () ] .
+ex:altOne sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:mixed sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] [ sh:oneOrMorePath ex:s ] ) .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+"""
+
+# A modifier on a bare IRI uses the str operator on URIRef, which the type
+# checker reports; a modifier on an inverse path needs no comment.
+MIXED_EXPECTED = EX.p / (EX.q | EX.r) / (EX.s * "+")  # type: ignore[operator]
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.simple, EX.p),
+        (EX.seq, EX.p / EX.q / EX.r),
+        (EX.seqNested, EX.p / EX.q / EX.r),
+        (EX.seqPartial, EX.p / EX.q),
+        (EX.inv, ~EX.p),
+        (EX.alt, EX.p | EX.q | EX.r),
+        (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+        (EX.modifiedInv, (~EX.p) * "*"),
+        (EX.mixed, MIXED_EXPECTED),
+        (EX.nil, SHACLPathError),
+        (EX.seqOne, SHACLPathError),
+        (EX.altEmpty, SHACLPathError),
+        (EX.altOne, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    graph: Graph,
+    bad_node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, bad_node)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(graph: Graph) -> None:
+    before = set(graph)
+    for shape in list(graph.subjects(SH.path)):
+        path_node = graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(graph) == before
