@@ -0,0 +1,93 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path in a shapes graph is malformed or unusable."""
+
+
+# The SHACL path parsing below is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI (a simple predicate, other than
+    ``rdf:nil``), or a blank node that is an RDF list used as a sequence path
+    (at least two items), carries ``sh:inversePath``, carries
+    ``sh:alternativePath`` whose RDF list has at least two items, or carries
+    one of ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+    ``sh:zeroOrOnePath``. Nested values are parsed recursively.
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The node that is the value of ``sh:path``.
+    :return: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or the node is not a
+        usable path node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"{path_identifier!r} is not a valid SHACL path node")
+
+    # RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path {path_identifier!r} must have at least two items"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternatives_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_list is not None:
+        alt_items = list(shapes_graph.items(alternatives_list))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"alternative path {path_identifier!r} must have at least two items"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..e9d6ba1
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_iri sh:path ex:a .
+ex:s_nil sh:path () .
+ex:s_seq sh:path ( ex:a ex:b ex:c ) .
+ex:s_seq_nested sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:s_seq_one sh:path ( ex:a ) .
+ex:s_seq_open sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:s_inv sh:path [ sh:inversePath ex:a ] .
+ex:s_alt sh:path [ sh:alternativePath ( ex:a ex:b ex:c ) ] .
+ex:s_alt_nested sh:path [
+    sh:alternativePath ( ex:a ( ex:b ex:c ) ex:d )
+] .
+ex:s_alt_empty sh:path [ sh:alternativePath () ] .
+ex:s_alt_one sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:s_zero_or_more sh:path [ sh:zeroOrMorePath ex:a ] .
+ex:s_one_or_more sh:path [ sh:oneOrMorePath ex:a ] .
+ex:s_zero_or_one sh:path [ sh:zeroOrOnePath ex:a ] .
+ex:s_mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ] .
+ex:s_seq_mixed sh:path (
+    ex:a
+    [ sh:alternativePath ( ex:b ex:c ) ]
+    [ sh:oneOrMorePath ex:d ]
+) .
+ex:s_unknown sh:path [ ex:unrelated ex:a ] .
+ex:s_literal sh:path "abc" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.s_iri, EX.a, id="iri"),
+        pytest.param(EX.s_nil, SHACLPathError, id="nil-as-path"),
+        pytest.param(EX.s_seq, EX.a / EX.b / EX.c, id="sequence"),
+        pytest.param(EX.s_seq_nested, EX.a / (EX.b / EX.c), id="nested-sequence"),
+        pytest.param(EX.s_seq_one, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.s_seq_open, EX.a / EX.b, id="open-list-sequence"),
+        pytest.param(EX.s_inv, ~EX.a, id="inverse"),
+        pytest.param(EX.s_alt, EX.a | EX.b | EX.c, id="alternative"),
+        pytest.param(
+            EX.s_alt_nested,
+            EX.a | (EX.b / EX.c) | EX.d,
+            id="nested-alternative",
+        ),
+        pytest.param(EX.s_alt_empty, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.s_alt_one, SHACLPathError, id="one-item-alternative"),
+        pytest.param(
+            EX.s_zero_or_more,
+            EX.a * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.s_one_or_more,
+            EX.a * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.s_zero_or_one,
+            EX.a * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(EX.s_mod_inv, (~EX.a) * "*", id="modifier-of-inverse"),
+        pytest.param(
+            EX.s_seq_mixed,
+            EX.a / (EX.b | EX.c) / (EX.d * "+"),  # type: ignore[operator]
+            id="sequence-with-alternative-and-modifier",
+        ),
+        pytest.param(EX.s_unknown, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.s_literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/a"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    bad_input: object,
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
