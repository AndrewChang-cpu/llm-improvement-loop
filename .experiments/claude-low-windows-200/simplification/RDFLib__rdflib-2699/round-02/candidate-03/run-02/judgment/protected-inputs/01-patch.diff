@@ -0,0 +1,94 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import BNode, Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a SHACL ``sh:path`` triple into a predicate.
+
+    A valid SHACL path is either an IRI that is not ``rdf:nil`` (a simple
+    path), or a blank node that is an RDF list of at least two paths
+    (a sequence path), carries ``sh:inversePath``, carries
+    ``sh:alternativePath`` pointing to an RDF list of at least two paths,
+    or carries one of ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath`` pointing to a path. Paths nest recursively.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It must be a :class:`~rdflib.term.URIRef` or a
+        :class:`~rdflib.term.BNode`.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` instance for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: for any other value that is not a valid SHACL path.
+
+    Implementation based on the SHACL-to-SPARQL path conversion in pyshacl.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}"
+        )
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    if not isinstance(path_identifier, BNode):
+        raise SHACLPathError(f"Not a valid SHACL path node: {path_identifier!r}")
+
+    # RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternative_items = list(shapes_graph.items(alternative_value))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..271e538
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_iri sh:path ex:p1 .
+ex:s_nil sh:path () .
+ex:s_seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:s_seq_one sh:path ( ex:p1 ) .
+ex:s_seq_nested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:s_seq_no_rest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:s_inv sh:path [ sh:inversePath ex:p1 ] .
+ex:s_alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:s_alt_empty sh:path [ sh:alternativePath () ] .
+ex:s_alt_one sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:s_zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:s_one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:s_zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:s_mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:s_seq_mixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:s_unknown sh:path [ ex:other ex:p1 ] .
+ex:s_literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.s_iri, EX.p1),
+        (EX.s_seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.s_seq_nested, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.s_seq_no_rest, EX.p1 / EX.p2),
+        (EX.s_inv, ~EX.p1),
+        (EX.s_alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.s_zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.s_one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.s_zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.s_mod_inv, ~EX.p1 * "*"),
+        (
+            EX.s_seq_mixed,
+            (EX.p1 | EX.p2) / (EX.p3 * "+"),  # type: ignore[operator]
+        ),
+    ],
+)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(
+    "shape, exc",
+    [
+        (EX.s_nil, SHACLPathError),
+        (EX.s_seq_one, SHACLPathError),
+        (EX.s_alt_empty, SHACLPathError),
+        (EX.s_alt_one, SHACLPathError),
+        (EX.s_unknown, SHACLPathError),
+        (EX.s_literal, TypeError),
+    ],
+)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    exc: Type[Exception],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(exc):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_missing_path_is_rejected(shapes_graph: Graph) -> None:
+    path_node = shapes_graph.value(EX.s_missing, SH.path)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_plain_string_is_rejected(shapes_graph: Graph) -> None:
+    not_a_node = "http://example.org/p1"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, not_a_node)  # type: ignore[arg-type]
+
+
+def test_none_is_rejected(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+
+
+def test_literal_node_raises_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("x"))
+
+
+def test_parse_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in (EX.s_seq_one, EX.s_alt_empty, EX.s_seq_mixed):
+        path_node = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(shapes_graph) == before
