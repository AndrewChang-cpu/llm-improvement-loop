@@ -0,0 +1,98 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a SHACL ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of two or more valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of two or more valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    The shapes graph is only read, never modified.
+
+    :param shapes_graph: The graph holding the SHACL shapes.
+    :param path_identifier: The node that is the value of ``sh:path``.
+    :return: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"{path_identifier!r} is not a valid SHACL path")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Complex path: a blank node. Each lookup below is narrowed before use.
+
+    # RDF list used as a sequence path.
+    first = shapes_graph.value(path_identifier, RDF.first)
+    if first is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path {path_identifier!r} must have at least two items"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath, whose value is an RDF list
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"alternative path {path_identifier!r} must have at least two items"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(
+        f"blank node {path_identifier!r} is not a recognized SHACL path"
+    )
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..b1db79e
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,123 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p .
+ex:emptyList sh:path () .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:seqNested sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:seqInverse sh:path ( ex:p [ sh:inversePath ex:q ] ex:r ) .
+ex:seqOpenEnd sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+ex:seqMix sh:path (
+    ex:p [ sh:alternativePath ( ex:q ex:r ) ] [ sh:oneOrMorePath ex:s ]
+) .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+ex:altNested sh:path [
+    sh:alternativePath ( ex:p [ sh:inversePath ex:q ] ( ex:r ex:s ) )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:nilAsPath sh:path rdf:nil .
+ex:oneItemSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknownBlank sh:path [ ex:other ex:p ] .
+ex:literalPath sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+def _path_of(graph: Graph, shape: URIRef) -> Node:
+    path = graph.value(shape, SH.path)
+    assert path is not None
+    return path
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.seq, EX.p / EX.q / EX.r),
+        (EX.seqNested, EX.p / (EX.q / EX.r)),
+        (EX.seqInverse, EX.p / ~EX.q / EX.r),
+        (EX.seqOpenEnd, EX.p / EX.q),
+        (EX.seqMix, EX.p / (EX.q | EX.r) / (EX.s * "+")),  # type: ignore[operator]
+        (EX.inv, ~EX.p),
+        (EX.alt, EX.p | EX.q | EX.r),
+        (EX.altNested, EX.p | ~EX.q | (EX.r / EX.s)),
+        (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+        (EX.modInverse, ~EX.p * "*"),
+    ],
+)
+def test_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    result = parse_shacl_path(shapes_graph, _path_of(shapes_graph, shape))
+    assert result == expected
+
+
+@pytest.mark.parametrize(
+    "shape, exception_type",
+    [
+        (EX.nilAsPath, SHACLPathError),
+        (EX.emptyList, SHACLPathError),
+        (EX.oneItemSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneItemAlt, SHACLPathError),
+        (EX.unknownBlank, SHACLPathError),
+        (EX.literalPath, TypeError),
+    ],
+)
+def test_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    exception_type: Type[Exception],
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(exception_type):
+        parse_shacl_path(shapes_graph, _path_of(shapes_graph, shape))
+    assert set(shapes_graph) == before
+
+
+def test_non_node_input_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "ex:p")  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_iri_result_is_the_same_iri(shapes_graph: Graph) -> None:
+    result = parse_shacl_path(shapes_graph, _path_of(shapes_graph, EX.iri))
+    assert isinstance(result, URIRef)
+    assert result == EX.p
