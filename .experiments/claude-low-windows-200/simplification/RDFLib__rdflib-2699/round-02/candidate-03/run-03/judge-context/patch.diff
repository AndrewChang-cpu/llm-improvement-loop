+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib import paths as _paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import BNode, Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path node is malformed or unusable."""
+
+
+# The parsing approach follows the SHACL-to-SPARQL path conversion in pyshacl,
+# which this function is based on.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a SHACL ``sh:path`` triple into a predicate usable
+    with rdflib Graph methods.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` pointing to a valid path;
+    * a blank node with ``sh:alternativePath`` pointing to an RDF list of at
+      least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` pointing to a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of the ``sh:path``
+        triple. It is an :class:`~rdflib.term.URIRef` or a blank node; a
+        :class:`~rdflib.term.Literal` is rejected with a ``TypeError``.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path is malformed or unusable.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths: %r" % (path_identifier,))
+
+    # Simple path: an IRI that is not rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Only blank nodes remain valid. Anything else (for example None or a plain
+    # string) is rejected here, because a None subject would act as a wildcard
+    # in the graph lookups below.
+    if not isinstance(path_identifier, BNode):
+        raise SHACLPathError("not a valid SHACL path node: %r" % (path_identifier,))
+
+    # Sequence path: an RDF list, identified by its rdf:first link.
+    first = shapes_graph.value(path_identifier, RDF.first)
+    if first is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "sequence path %r must have at least two items, found %d"
+                % (path_identifier, len(sequence_items))
+            )
+        return _paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # Inverse path: sh:inversePath.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return _paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "alternative path %r must have at least two items, found %d"
+                % (path_identifier, len(alternative_items))
+            )
+        return _paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return _paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return _paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return _paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(
+        "blank node %r is not a recognized SHACL path" % (path_identifier,)
+    )
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
