index 0000000..6a6d8a6
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nested_alternative sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ex:p4 )
+] .
+
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifier_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:sequence_mixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:open_list sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:nil_path sh:path () .
+
+ex:one_item_sequence sh:path ( ex:p1 ) .
+
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknown_blank sh:path [ sh:minCount 1 ] .
+
+ex:literal_path sh:path "http://example.org/p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+VALID_CASES: list[tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.simple, EX.p1),
+    (EX.sequence, EX.p1 / EX.p2 / EX.p3),
+    (EX.nested_sequence, EX.p1 / (EX.p2 / EX.p3)),
+    (EX.inverse, ~EX.p1),
+    (EX.alternative, EX.p1 | EX.p2 | EX.p3),
+    (EX.nested_alternative, EX.p1 | (EX.p2 | EX.p3) | EX.p4),
+    (EX.zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.modifier_inverse, ~EX.p1 * "*"),
+    (EX.sequence_mixed, (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+    (EX.open_list, EX.p1 / EX.p2),
+]
+
+INVALID_CASES: list[tuple[URIRef, type[Exception]]] = [
+    (EX.nil_path, SHACLPathError),
+    (EX.one_item_sequence, SHACLPathError),
+    (EX.empty_alternative, SHACLPathError),
+    (EX.one_item_alternative, SHACLPathError),
+    (EX.unknown_blank, SHACLPathError),
+    (EX.literal_path, TypeError),
+]
+
+
+@pytest.mark.parametrize("shape, expected", VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("shape, exc", INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    exc: type[Exception],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(exc):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "p1")  # type: ignore[arg-type]
+
+
+def test_literal_path_is_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("http://example.org/p1"))
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape, _ in VALID_CASES:
+        path_node = shapes_graph.value(shape, SH.path)
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    for shape, exc in INVALID_CASES:
+        path_node = shapes_graph.value(shape, SH.path)
+        with pytest.raises(exc):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
