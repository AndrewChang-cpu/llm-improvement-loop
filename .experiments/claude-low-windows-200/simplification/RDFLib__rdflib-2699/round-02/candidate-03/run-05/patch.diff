index 0000000..d7c0fbe
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import RDF, Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TTL = f"""
+@prefix ex: <{EX}> .
+@prefix sh: <{SH}> .
+@prefix rdf: <{RDF}> .
+
+ex:simple sh:path ex:p1 .
+ex:seq sh:path (ex:p1 ex:p2 ex:p3) .
+ex:nestedSeq sh:path (ex:p1 (ex:p2 ex:p3) ex:p4) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath (ex:p1 ex:p2 ex:p3) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqAltMod sh:path (
+    ex:p1
+    [ sh:alternativePath (ex:p2 ex:p3) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path (ex:p1) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath (ex:p1) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+def _path_of(graph: Graph, shape: URIRef) -> Union[URIRef, Path]:
+    path_node = graph.value(shape, SH.path)
+    assert path_node is not None
+    return parse_shacl_path(graph, path_node)
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.simple, EX.p1),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3) / EX.p4),
+        (EX.inverse, ~EX.p1),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.zeroOrMore, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modInv, (~EX.p1) * "*"),
+        (
+            EX.seqAltMod,
+            EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+"),  # type: ignore[operator]
+        ),
+        (EX.openList, EX.p1 / EX.p2),
+    ],
+)
+def test_parse_valid_shacl_path(
+    shapes: Graph, shape: URIRef, expected: Union[URIRef, Path]
+) -> None:
+    assert _path_of(shapes, shape) == expected
+
+
+@pytest.mark.parametrize(
+    "shape, exc_type",
+    [
+        (EX.nilPath, SHACLPathError),
+        (EX.emptySeq, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_invalid_shacl_path(
+    shapes: Graph, shape: URIRef, exc_type: Type[Exception]
+) -> None:
+    before = set(shapes)
+    with pytest.raises(exc_type):
+        _path_of(shapes, shape)
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/p1"])
+def test_parse_non_node_raises_shacl_path_error(shapes: Graph, bad_node: str) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
