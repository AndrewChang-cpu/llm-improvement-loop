+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when the value of a ``sh:path`` is not a valid SHACL path."""
+
+
+# The implementation is based on pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the value of a ``sh:path`` triple into an rdflib predicate or path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI naming a plain predicate;
+    * an RDF list of two or more paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list of
+      two or more paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read and is never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple.
+    :return: the :class:`~rdflib.term.URIRef` itself for a plain predicate, or
+        a :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path node is malformed or not recognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths: %r" % (path_identifier,))
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    # A non-node input (None, a plain string) must not reach the graph lookups
+    # below, since None would act as a wildcard there.
+    if not isinstance(path_identifier, Node):  # type: ignore[unreachable]
+        raise SHACLPathError("Not a SHACL path node: %r" % (path_identifier,))
+
+    # Sequence path: the node is an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "A SHACL sequence path needs at least two items: %r"
+                % (path_identifier,)
+            )
+        return paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # Inverse path.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: the value of sh:alternativePath is an RDF list.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "A SHACL alternative path needs at least two items: %r"
+                % (path_identifier,)
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # Modifier paths.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
