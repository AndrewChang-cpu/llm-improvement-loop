@@ -0,0 +1,96 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The conversion of SHACL paths is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into a predicate usable with
+    :class:`~rdflib.graph.Graph` methods.
+
+    A valid SHACL path is either an IRI (a plain predicate), or a blank node
+    that is an RDF list (a sequence path), or a blank node carrying one of
+    ``sh:inversePath``, ``sh:alternativePath`` (whose value is an RDF list),
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+    Sequence and alternative lists must contain at least two items.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the path node, i.e. the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the node is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    # Guard against non-node inputs (e.g. None or plain strings), which would
+    # otherwise act as wildcards in graph lookups.
+    candidate: object = path_identifier
+    if not isinstance(candidate, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {candidate!r}")
+
+    # A plain predicate; rdf:nil is an empty list, not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of at least two paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence = list(shapes_graph.items(path_identifier))
+        if len(sequence) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(sequence)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, n) for n in sequence])
+
+    # Inverse path: sh:inversePath.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternatives_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_list is not None:
+        alternatives = list(shapes_graph.items(alternatives_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(alternatives)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, n) for n in alternatives]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..0e1a728
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,121 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import RDF, Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_seq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nested_alt sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:zero sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:open_list sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:nil_path sh:path rdf:nil .
+ex:empty_seq sh:path () .
+ex:one_seq sh:path ( ex:p1 ) .
+ex:empty_alt sh:path [ sh:alternativePath () ] .
+ex:one_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+ExpectedPath = Union[URIRef, Path, Type[Exception]]
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    shapes = Graph()
+    shapes.parse(data=SHAPES_TURTLE, format="turtle")
+    return shapes
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.iri, EX.p1, id="iri"),
+        pytest.param(EX.seq, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(EX.nested_seq, EX.p1 / (EX.p2 / EX.p3), id="nested-sequence"),
+        pytest.param(EX.inv, ~EX.p1, id="inverse"),
+        pytest.param(EX.alt, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+        pytest.param(
+            EX.nested_alt,
+            EX.p1 | (EX.p2 / EX.p3) | ~EX.p4,
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.zero,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.one,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.opt,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(EX.mod_inv, ~EX.p1 * "*", id="modifier-of-inverse"),
+        pytest.param(EX.open_list, EX.p1 / EX.p2, id="list-without-final-rest"),
+        pytest.param(EX.nil_path, SHACLPathError, id="rdf-nil-iri"),
+        pytest.param(EX.empty_seq, SHACLPathError, id="empty-sequence"),
+        pytest.param(EX.one_seq, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.empty_alt, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.one_alt, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknown, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape: URIRef,
+    expected: ExpectedPath,
+) -> None:
+    path = graph.value(shape, SH.path)
+    assert path is not None
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(graph, path)
+    else:
+        assert parse_shacl_path(graph, path) == expected
+
+
+def test_non_node_inputs_raise_shacl_path_error(graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, "http://example.org/p1")  # type: ignore[arg-type]
+
+
+def test_parsing_does_not_change_graph(graph: Graph) -> None:
+    before = set(graph)
+    for shape in graph.subjects(SH.path, None):
+        path = graph.value(shape, SH.path)
+        assert path is not None
+        try:
+            parse_shacl_path(graph, path)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(graph) == before
+    assert (EX.nil_path, SH.path, RDF.nil) in graph
