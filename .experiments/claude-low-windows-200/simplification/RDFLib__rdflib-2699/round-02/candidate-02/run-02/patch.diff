index 0000000..6526042
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p ) .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSeq sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) ex:p4 )
+] .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "abc" .
+"""
+
+VALID_CASES: List[Tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p),
+    ("seq", EX.p1 / EX.p2 / EX.p3),
+    ("nestedSeq", EX.p1 / (EX.p2 / EX.p3)),
+    ("openSeq", EX.p1 / EX.p2),
+    ("inverse", ~EX.p),
+    ("alt", EX.p1 | EX.p2 | EX.p3),
+    ("nestedAlt", EX.p1 | (EX.p2 / EX.p3) | EX.p4),
+    ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+    ("modInverse", (~EX.p) * "*"),
+]
+
+INVALID_CASES: List[Tuple[str, Type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("emptySeq", SHACLPathError),
+    ("oneSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneAlt", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literal", TypeError),
+]
+
+ALL_SHAPES = [name for name, _ in VALID_CASES]
+ALL_SHAPES += [name for name, _ in INVALID_CASES]
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_parse_valid_shacl_path(
+    graph: Graph, shape: str, expected: Union[URIRef, Path]
+) -> None:
+    path = graph.value(EX[shape], SH.path)
+    assert parse_shacl_path(graph, path) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(("shape", "exc_type"), INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    graph: Graph, shape: str, exc_type: Type[Exception]
+) -> None:
+    path = graph.value(EX[shape], SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(graph, path)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_parse_non_node_input(graph: Graph, bad_input: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(graph: Graph) -> None:
+    before = set(graph)
+    for shape in ALL_SHAPES:
+        path = graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(graph, path)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(graph) == before
