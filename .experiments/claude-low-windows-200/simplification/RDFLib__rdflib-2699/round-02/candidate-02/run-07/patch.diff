index 0000000..101452c
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:no_rest_sequence sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nested_alternative sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ( ex:p1 ex:p2 ) )
+] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modified_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:empty_list sh:path () .
+ex:bad_one_sequence sh:path ( ex:p1 ) .
+ex:bad_empty_alternative sh:path [ sh:alternativePath () ] .
+ex:bad_one_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:bad_unknown sh:path [ ex:unrelated ex:p1 ] .
+ex:bad_literal sh:path "ex:p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param(EX.iri, EX.p1, id="iri"),
+        pytest.param(EX.sequence, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nested_sequence, EX.p1 / (EX.p2 / EX.p3), id="nested-sequence"
+        ),
+        pytest.param(EX.no_rest_sequence, EX.p1 / EX.p2, id="no-rest-sequence"),
+        pytest.param(EX.inverse, ~EX.p1, id="inverse"),
+        pytest.param(EX.alternative, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+        pytest.param(
+            EX.nested_alternative,
+            EX.p1 | (EX.p2 | EX.p3) | (EX.p1 / EX.p2),
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.zero_or_more,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.one_or_more,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zero_or_one,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(EX.modified_inverse, (~EX.p1) * "*", id="modified-inverse"),
+        pytest.param(EX.empty_list, SHACLPathError, id="rdf-nil-empty-sequence"),
+        pytest.param(EX.bad_one_sequence, SHACLPathError, id="one-item-sequence"),
+        pytest.param(
+            EX.bad_empty_alternative,
+            SHACLPathError,
+            id="empty-alternative",
+        ),
+        pytest.param(
+            EX.bad_one_alternative,
+            SHACLPathError,
+            id="one-item-alternative",
+        ),
+        pytest.param(EX.bad_unknown, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.bad_literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes)
+    path_node = shapes.value(shape, SH.path)
+    assert path_node is not None
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)
+    else:
+        assert parse_shacl_path(shapes, path_node) == expected
+    assert set(shapes) == before
