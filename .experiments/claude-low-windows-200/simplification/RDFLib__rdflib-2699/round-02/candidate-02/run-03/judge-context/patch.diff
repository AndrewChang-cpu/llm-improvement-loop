index 0000000..ac2ddc4
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,116 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_seq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nested_alt sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        [ sh:inversePath ex:p4 ]
+    )
+] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:open_list sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:nil_path sh:path () .
+ex:one_seq sh:path ( ex:p1 ) .
+ex:empty_alt sh:path [ sh:alternativePath () ] .
+ex:one_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "p1" .
+"""
+
+VALID_CASES: List[Tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.iri, EX.p1),
+    (EX.seq, EX.p1 / EX.p2 / EX.p3),
+    (EX.nested_seq, EX.p1 / (EX.p2 / EX.p3)),
+    (EX.inv, ~EX.p1),
+    (EX.alt, EX.p1 | EX.p2 | EX.p3),
+    (EX.nested_alt, EX.p1 | (EX.p2 | EX.p3) | ~EX.p4),
+    (EX.zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.mod_inv, (~EX.p1) * "*"),
+    (EX.open_list, EX.p1 / EX.p2),
+]
+
+INVALID_CASES: List[Tuple[URIRef, type[Exception]]] = [
+    (EX.nil_path, SHACLPathError),
+    (EX.one_seq, SHACLPathError),
+    (EX.empty_alt, SHACLPathError),
+    (EX.one_alt, SHACLPathError),
+    (EX.unknown, SHACLPathError),
+    (EX.literal, TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_parse_shacl_path_valid(
+    shapes: Graph, shape: URIRef, expected: Union[URIRef, Path]
+) -> None:
+    path = shapes.value(shape, SH.path)
+    assert parse_shacl_path(shapes, path) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(("shape", "exc_type"), INVALID_CASES)
+def test_parse_shacl_path_invalid(
+    shapes: Graph, shape: URIRef, exc_type: type[Exception]
+) -> None:
+    path = shapes.value(shape, SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes, path)  # type: ignore[arg-type]
+
+
+def test_missing_path_is_not_a_wildcard(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p1")  # type: ignore[arg-type]
+
+
+def test_literal_path_raises_type_error(shapes: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes, Literal("p1"))
+
+
+def test_parse_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape, _ in VALID_CASES:
+        path = shapes.value(shape, SH.path)
+        parse_shacl_path(shapes, path)  # type: ignore[arg-type]
+    for shape, exc_type in INVALID_CASES:
+        path = shapes.value(shape, SH.path)
+        with pytest.raises(exc_type):
+            parse_shacl_path(shapes, path)  # type: ignore[arg-type]
+    assert set(shapes) == before
