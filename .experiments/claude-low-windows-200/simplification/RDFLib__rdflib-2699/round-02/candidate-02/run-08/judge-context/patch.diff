@@ -0,0 +1,94 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI (a plain predicate), or a blank node
+    that is an RDF list of at least two paths (a sequence), carries
+    ``sh:inversePath``, carries ``sh:alternativePath`` pointing to an RDF list
+    of at least two paths, or carries ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath`` pointing to a path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the object node of a ``sh:path`` triple.
+    :return: the :class:`~rdflib.term.URIRef` itself for a plain predicate, or
+        a :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is not valid, including when
+        ``path_identifier`` is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path (empty list)")
+        return path_identifier
+
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, cannot be a SHACL path: {path_identifier!r}")
+
+    # Sequence path: an RDF list of paths.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: an RDF list of paths.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(alt_items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..f1ac882
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:alternativePath ( ex:p4 ex:p5 ) ] )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:danglingTail sh:path _:c1 .
+_:c1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ex:p1 ;
+    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:c2 .
+_:c2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ex:p2 .
+
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+P1 = EX.p1
+P2 = EX.p2
+P3 = EX.p3
+P4 = EX.p4
+P5 = EX.p5
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+def _path_of(graph: Graph, shape: Node) -> Union[URIRef, Path]:
+    path_node = graph.value(shape, SH.path)
+    assert path_node is not None
+    return parse_shacl_path(graph, path_node)
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, P1),
+        (EX.seq, P1 / P2 / P3),
+        (EX.nestedSeq, P1 / (P2 / P3)),
+        (EX.inv, ~P1),
+        (EX.alt, P1 | P2 | P3),
+        (EX.nestedAlt, P1 | (P2 / P3) | (P4 | P5)),
+        (EX.zeroOrMore, P1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, P1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, P1 * "?"),  # type: ignore[operator]
+        (EX.modInv, (~P1) * "*"),
+        (EX.danglingTail, P1 / P2),
+        (EX.emptySeq, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    if isinstance(expected, type):
+        path_node = shapes_graph.value(shape, SH.path)
+        assert path_node is not None
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert _path_of(shapes_graph, shape).n3() == expected.n3()
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_node: Optional[str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_node)  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in shapes_graph.subjects(SH.path, None):
+        try:
+            _path_of(shapes_graph, shape)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
