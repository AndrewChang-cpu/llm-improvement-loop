@@ -0,0 +1,98 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI naming a plain predicate, or a blank
+    node that is an RDF list of paths (a sequence path), or that carries one
+    of the SHACL path predicates ``sh:inversePath``, ``sh:alternativePath``,
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+    Sequence and alternative lists must contain at least two items.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the object node of a ``sh:path`` triple, i.e. the
+        path node itself, not the shape subject.
+    :returns: the :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` instance for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or not recognised.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}",
+        )
+
+    # Checked on an ``object``-typed alias so that the guard stays reachable.
+    # It is required because a ``None`` argument would act as a wildcard in
+    # the graph lookups below.
+    candidate: object = path_identifier
+    if not isinstance(candidate, Node):
+        raise SHACLPathError(f"Not a valid SHACL path node: {candidate!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first: the node is an RDF list, i.e. a sequence path
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: the value is an RDF list of alternatives
+    alternatives_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_value is not None:
+        alternatives = list(shapes_graph.items(alternatives_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alternatives]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath: modifier paths
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..78c2f58
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shapes#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_seq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:open_seq sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nested_alt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) )
+] .
+ex:zero sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:rdf_nil sh:path () .
+ex:seq_one sh:path ( ex:p1 ) .
+ex:alt_empty sh:path [ sh:alternativePath () ] .
+ex:alt_one sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+def _path_of(graph: Graph, shape: str) -> Node:
+    value = graph.value(EX[shape], SH.path)
+    assert value is not None
+    return value
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p1),
+    ("seq", EX.p1 / EX.p2 / EX.p3),
+    ("nested_seq", EX.p1 / (EX.p2 / EX.p3)),
+    ("open_seq", EX.p1 / EX.p2),
+    ("inv", ~EX.p1),
+    ("alt", EX.p1 | EX.p2 | EX.p3),
+    ("nested_alt", EX.p1 | ~EX.p2 | (EX.p3 / EX.p4)),
+    ("zero", EX.p1 * "*"),  # type: ignore[operator]
+    ("one", EX.p1 * "+"),  # type: ignore[operator]
+    ("opt", EX.p1 * "?"),  # type: ignore[operator]
+    ("mod_inv", (~EX.p1) * "*"),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("rdf_nil", SHACLPathError),
+    ("seq_one", SHACLPathError),
+    ("alt_empty", SHACLPathError),
+    ("alt_one", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize("shape, expected", VALID_CASES)
+def test_valid_shacl_paths(
+    shapes_graph: Graph, shape: str, expected: Union[URIRef, Path]
+) -> None:
+    result = parse_shacl_path(shapes_graph, _path_of(shapes_graph, shape))
+    assert result == expected
+    assert result.n3() == expected.n3()
+
+
+@pytest.mark.parametrize("shape, error", INVALID_CASES)
+def test_invalid_shacl_paths(
+    shapes_graph: Graph, shape: str, error: type[Exception]
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(error):
+        parse_shacl_path(shapes_graph, _path_of(shapes_graph, shape))
+    assert set(shapes_graph) == before
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "p1")  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_missing_lookup_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    missing = shapes_graph.value(EX.no_such_shape, SH.path)
+    assert missing is None
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, missing)  # type: ignore[arg-type]
