@@ -0,0 +1,100 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri_shape sh:path ex:a .
+ex:seq_shape sh:path ( ex:a ex:b ex:c ) .
+ex:seq_nested_shape sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:inverse_shape sh:path [ sh:inversePath ex:a ] .
+ex:alt_shape sh:path [ sh:alternativePath ( ex:a ex:b ex:c ) ] .
+ex:alt_nested_shape sh:path [ sh:alternativePath ( ex:a ( ex:b ex:c ) ) ] .
+ex:zero_or_more_shape sh:path [ sh:zeroOrMorePath ex:a ] .
+ex:one_or_more_shape sh:path [ sh:oneOrMorePath ex:a ] .
+ex:zero_or_one_shape sh:path [ sh:zeroOrOnePath ex:a ] .
+ex:mod_inverse_shape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ] .
+ex:seq_alt_mod_shape sh:path (
+    [ sh:alternativePath ( ex:a ex:b ) ]
+    [ sh:oneOrMorePath ex:c ]
+) .
+ex:nil_shape sh:path () .
+ex:one_item_seq_shape sh:path ( ex:a ) .
+ex:empty_alt_shape sh:path [ sh:alternativePath () ] .
+ex:one_item_alt_shape sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown_shape sh:path [ ex:unknown ex:b ] .
+ex:literal_shape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri_shape, EX.a),
+        (EX.seq_shape, EX.a / EX.b / EX.c),
+        (EX.seq_nested_shape, EX.a / (EX.b / EX.c)),
+        (EX.inverse_shape, ~EX.a),
+        (EX.alt_shape, EX.a | EX.b | EX.c),
+        (EX.alt_nested_shape, EX.a | (EX.b / EX.c)),
+        (EX.zero_or_more_shape, EX.a * "*"),  # type: ignore[operator]
+        (EX.one_or_more_shape, EX.a * "+"),  # type: ignore[operator]
+        (EX.zero_or_one_shape, EX.a * "?"),  # type: ignore[operator]
+        (EX.mod_inverse_shape, (~EX.a) * "*"),
+        (
+            EX.seq_alt_mod_shape,
+            (EX.a | EX.b) / (EX.c * "+"),  # type: ignore[operator]
+        ),
+        (EX.nil_shape, SHACLPathError),
+        (EX.one_item_seq_shape, SHACLPathError),
+        (EX.empty_alt_shape, SHACLPathError),
+        (EX.one_item_alt_shape, SHACLPathError),
+        (EX.unknown_shape, SHACLPathError),
+        (EX.literal_shape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/a"])
+def test_parse_shacl_path_non_node_input(shapes_graph: Graph, bad_node: str) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_node)  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in (EX.seq_shape, EX.inverse_shape, EX.nil_shape, EX.literal_shape):
+        path_node = shapes_graph.value(shape, SH.path)
+        assert path_node is not None
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
