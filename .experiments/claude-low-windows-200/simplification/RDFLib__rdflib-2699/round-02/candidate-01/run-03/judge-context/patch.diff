index 0000000..3863e65
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,98 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import TYPE_CHECKING, Union
+
+from rdflib import Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+if TYPE_CHECKING:
+    from rdflib.graph import Graph
+
+
+class SHACLPathError(Exception):
+    """Raised when a ``sh:path`` value in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the value of a ``sh:path`` triple into an RDFLib path object.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is returned unchanged;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two valid paths), ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the object node of a ``sh:path`` triple, i.e. the
+        path node itself, not the shape subject.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is not a valid SHACL path.
+
+    The implementation is based on pyshacl's SHACL-to-SPARQL path conversion.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path (empty sequence).")
+        return path_identifier
+
+    # RDF list used as a sequence path (rdf:first / rdf:rest).
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath (value is an RDF list)
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternatives = list(shapes_graph.items(alternative_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items, got "
+                f"{len(alternatives)}: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, a) for a in alternatives]
+        )
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..4b2af53
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+from typing import Optional, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/shapes/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:simple sh:path ex:p .
+ex:sequence sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSequence sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:mixed sh:path (
+    ex:p
+    [ sh:alternativePath ( ex:q ex:r ) ]
+    [ sh:oneOrMorePath ex:s ]
+) .
+ex:danglingList sh:path [
+    rdf:first ex:p ;
+    rdf:rest [ rdf:first ex:q ]
+] .
+ex:rdfNil sh:path rdf:nil .
+ex:emptySequence sh:path () .
+ex:oneItemSequence sh:path ( ex:p ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literalPath sh:path "abc" .
+"""
+
+
+# A modifier applied directly to a bare IRI is reported by the type checker.
+ZERO_OR_MORE = EX.p * "*"  # type: ignore[operator]
+ONE_OR_MORE = EX.p * "+"  # type: ignore[operator]
+ZERO_OR_ONE = EX.p * "?"  # type: ignore[operator]
+MIXED = EX.p / (EX.q | EX.r) / (EX.s * "+")  # type: ignore[operator]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected, error",
+    [
+        pytest.param(EX.simple, EX.p, None, id="simple"),
+        pytest.param(EX.sequence, EX.p / EX.q / EX.r, None, id="sequence"),
+        pytest.param(EX.nestedSequence, EX.p / (EX.q / EX.r), None, id="nested"),
+        pytest.param(EX.inverse, ~EX.p, None, id="inverse"),
+        pytest.param(EX.alternative, EX.p | EX.q | EX.r, None, id="alternative"),
+        pytest.param(EX.zeroOrMore, ZERO_OR_MORE, None, id="zero-or-more"),
+        pytest.param(EX.oneOrMore, ONE_OR_MORE, None, id="one-or-more"),
+        pytest.param(EX.zeroOrOne, ZERO_OR_ONE, None, id="zero-or-one"),
+        pytest.param(EX.modifiedInverse, (~EX.p) * "*", None, id="modified-inverse"),
+        pytest.param(
+            EX.mixed,
+            MIXED,
+            None,
+            id="mixed",
+        ),
+        pytest.param(EX.danglingList, EX.p / EX.q, None, id="dangling-list"),
+        pytest.param(EX.rdfNil, None, SHACLPathError, id="rdf-nil-path"),
+        pytest.param(EX.emptySequence, None, SHACLPathError, id="empty-sequence"),
+        pytest.param(EX.oneItemSequence, None, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlternative, None, SHACLPathError, id="empty-alternative"),
+        pytest.param(
+            EX.oneItemAlternative, None, SHACLPathError, id="one-item-alternative"
+        ),
+        pytest.param(EX.unrecognized, None, SHACLPathError, id="unrecognized-blank"),
+        pytest.param(EX.literalPath, None, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[type[Exception]],
+) -> None:
+    if error is None:
+        assert expected is not None
+        path_node = shapes.value(shape, SH.path)
+        assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+    else:
+        path_node = shapes.value(shape, SH.path)
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_node", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph, bad_node: Optional[str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_node)  # type: ignore[arg-type]
+
+
+def test_parsing_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in (EX.sequence, EX.danglingList, EX.rdfNil, EX.unrecognized):
+        path_node = shapes.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(shapes) == before
+    assert RDF.nil in set(shapes.objects())
