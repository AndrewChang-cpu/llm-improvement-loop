@@ -0,0 +1,97 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the value of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil`` (a simple path),
+    * an RDF list of two or more paths (a sequence path),
+    * a blank node with ``sh:inversePath`` (an inverse path),
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list of
+      two or more paths (an alternative path),
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` (a modifier path).
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, that is, the object of a
+        ``sh:path`` triple. Literals are rejected.
+    :returns: The :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: the node is an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got "
+                f"{len(sequence_items)} for {path_identifier!r}"
+            )
+        return paths.SequencePath(
+            *(parse_shacl_path(shapes_graph, item) for item in sequence_items)
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternatives_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_list is not None:
+        alternative_items = list(shapes_graph.items(alternatives_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got "
+                f"{len(alternative_items)} for {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *(parse_shacl_path(shapes_graph, item) for item in alternative_items)
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..7dcf31f
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import RDF, Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = f"""
+@prefix ex: <{EX}> .
+@prefix rdf: <{RDF._NS}> .
+@prefix sh: <{SH._NS}> .
+
+ex:simple sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSequence sh:path _:cell1 .
+_:cell1 rdf:first ex:p1 ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:p2 .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) ex:p4 )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:sequenceWithAlternativeAndModifier sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literalPath sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected", "error"),
+    [
+        (EX.simple, EX.p, None),
+        (EX.sequence, EX.p1 / EX.p2 / EX.p3, None),
+        (EX.nestedSequence, EX.p1 / (EX.p2 / EX.p3), None),
+        (EX.openSequence, EX.p1 / EX.p2, None),
+        (EX.inverse, ~EX.p, None),
+        (EX.alternative, EX.p1 | EX.p2 | EX.p3, None),
+        (EX.nestedAlternative, EX.p1 | (EX.p2 / EX.p3) | EX.p4, None),
+        (EX.zeroOrMore, EX.p * "*", None),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p * "+", None),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p * "?", None),  # type: ignore[operator]
+        (EX.modifiedInverse, (~EX.p) * "*", None),
+        (
+            EX.sequenceWithAlternativeAndModifier,
+            EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+"),  # type: ignore[operator]
+            None,
+        ),
+        (EX.emptyList, None, SHACLPathError),
+        (EX.oneItemSequence, None, SHACLPathError),
+        (EX.emptyAlternative, None, SHACLPathError),
+        (EX.oneItemAlternative, None, SHACLPathError),
+        (EX.unrecognized, None, SHACLPathError),
+        (EX.literalPath, None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    path = shapes.value(shape, SH.path)
+    if error is not None:
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path)  # type: ignore[arg-type]
+        return
+    assert expected is not None
+    assert parse_shacl_path(shapes, path) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_node", [None, "ex:p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    bad_node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_node)  # type: ignore[arg-type]
+
+
+def test_failed_parse_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    empty_path = shapes.value(EX.emptyList, SH.path)
+    unrecognized_path = shapes.value(EX.unrecognized, SH.path)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, empty_path)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, unrecognized_path)  # type: ignore[arg-type]
+    assert set(shapes) == before
