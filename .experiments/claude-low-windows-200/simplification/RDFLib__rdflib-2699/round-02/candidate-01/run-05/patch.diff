@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list of
+      at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the object node of the ``sh:path`` triple.
+    :return: the :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises SHACLPathError: if the node is not a valid SHACL path.
+    :raises TypeError: if the node is a :class:`~rdflib.term.Literal`.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # simple path
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # sequence path: an RDF list (rdf:first present)
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of alternatives
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternatives = list(shapes_graph.items(alternative_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alternatives]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..7a13c0a
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shacl-paths#")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shacl-paths#> .
+
+ex:iri sh:path ex:p1 .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSeq sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMix sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "not a path" .
+ex:rdfNil sh:path rdf:nil .
+ex:badSeqItem sh:path ( ex:p1 () ) .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+def path_of(graph: Graph, shape_name: str) -> Union[URIRef, Path]:
+    """Return the parsed result for the sh:path value of a named shape."""
+    path_node = graph.value(EX[shape_name], SH.path)
+    assert path_node is not None
+    return parse_shacl_path(graph, path_node)
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        ("iri", EX.p1),
+        ("seq3", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSeq", EX.p1 / (EX.p2 / EX.p3)),
+        ("openSeq", EX.p1 / EX.p2),
+        ("inv", ~EX.p1),
+        ("alt", EX.p1 | EX.p2 | EX.p3),
+        ("nestedAlt", EX.p1 | (EX.p2 | EX.p3)),
+        ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+        ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+        ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+        ("modInv", (~EX.p1) * "*"),
+        ("seqMix", EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+")),  # type: ignore[operator]
+    ],
+)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path],
+) -> None:
+    assert path_of(shapes_graph, shape_name) == expected
+
+
+@pytest.mark.parametrize(
+    "shape_name, exc_type",
+    [
+        ("rdfNil", SHACLPathError),
+        ("emptySeq", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("badSeqItem", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    exc_type: Type[Exception],
+) -> None:
+    with pytest.raises(exc_type):
+        path_of(shapes_graph, shape_name)
+
+
+def test_missing_and_non_node_inputs_raise_shacl_error(shapes_graph: Graph) -> None:
+    missing = shapes_graph.value(EX.missing, SH.path)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, missing)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    p1 = "http://example.org/shacl-paths#p1"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, p1)  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for name in ("seqMix", "nestedAlt", "modInv", "openSeq"):
+        path_of(shapes_graph, name)
+    for name in ("rdfNil", "emptyAlt", "unknown", "literal"):
+        with pytest.raises((SHACLPathError, TypeError)):
+            path_of(shapes_graph, name)
+    assert set(shapes_graph) == before
