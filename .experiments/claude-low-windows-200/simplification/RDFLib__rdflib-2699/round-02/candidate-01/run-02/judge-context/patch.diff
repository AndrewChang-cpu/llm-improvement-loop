@@ -0,0 +1,91 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI other than ``rdf:nil``, or a blank node
+    that is an RDF list of at least two paths (a sequence path), or that carries
+    one of ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of at least
+    two paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the node that is the value of ``sh:path``, passed
+        as the object of the triple rather than the shape subject.
+    :return: a :class:`~rdflib.term.URIRef` for a simple predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths: %r" % (path_identifier,))
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "A sequence path needs at least two items, got %d: %r"
+                % (len(sequence_items), path_identifier)
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternatives_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_list is not None:
+        alternative_items = list(shapes_graph.items(alternatives_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items, got %d: %r"
+                % (len(alternative_items), path_identifier)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..0819c7e
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,121 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ( ex:p4 ex:p5 ) )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:mixedSequence sh:path (
+    ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:danglingList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:nilPath sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:notAPath ex:p ] .
+ex:literalPath sh:path "ex:p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    shapes = Graph()
+    shapes.parse(data=SHAPES_TURTLE, format="turtle")
+    return shapes
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param(EX.iri, EX.p, id="iri"),
+        pytest.param(EX.sequence, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nestedSequence, EX.p1 / (EX.p2 / EX.p3), id="nested-sequence"
+        ),
+        pytest.param(EX.inverse, ~EX.p, id="inverse"),
+        pytest.param(EX.alternative, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+        pytest.param(
+            EX.nestedAlternative,
+            EX.p1 | (EX.p2 | EX.p3) | (EX.p4 / EX.p5),
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.zeroOrMore,
+            EX.p * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMore,
+            EX.p * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOne,
+            EX.p * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(EX.modifiedInverse, ~EX.p * "*", id="modifier-of-inverse"),
+        pytest.param(
+            EX.mixedSequence,
+            EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+"),  # type: ignore[operator]
+            id="mixed-sequence",
+        ),
+        pytest.param(EX.danglingList, EX.p1 / EX.p2, id="list-without-rest"),
+        pytest.param(EX.nilPath, SHACLPathError, id="nil-as-path"),
+        pytest.param(EX.oneItemSequence, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlternative, SHACLPathError, id="empty-alternative"),
+        pytest.param(
+            EX.oneItemAlternative, SHACLPathError, id="one-item-alternative"
+        ),
+        pytest.param(EX.unrecognized, SHACLPathError, id="unrecognized-node"),
+        pytest.param(EX.literalPath, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(graph)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(
+                graph, graph.value(shape, SH.path)  # type: ignore[arg-type]
+            )
+    else:
+        result = parse_shacl_path(
+            graph, graph.value(shape, SH.path)  # type: ignore[arg-type]
+        )
+        assert result == expected
+    assert set(graph) == before
+
+
+def test_non_node_inputs_raise_shacl_path_error(graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, "ex:p")  # type: ignore[arg-type]
