index 0000000..d12f5c1
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri_path sh:path ex:p1 .
+ex:seq_path sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_seq_path sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv_path sh:path [ sh:inversePath ex:p1 ] .
+ex:alt_path sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nested_alt_path sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:zero_or_more_path sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more_path sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one_path sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:combo_path sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath ex:p3 ]
+) .
+ex:mod_of_inv_path sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:missing_rest_path sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:nil_path sh:path rdf:nil .
+ex:empty_seq_path sh:path ( ) .
+ex:one_seq_path sh:path ( ex:p1 ) .
+ex:empty_alt_path sh:path [ sh:alternativePath ( ) ] .
+ex:one_alt_path sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown_path sh:path [ ex:other ex:p1 ] .
+ex:literal_path sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        (EX.iri_path, EX.p1),
+        (EX.seq_path, EX.p1 / EX.p2 / EX.p3),
+        (EX.nested_seq_path, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.inv_path, ~EX.p1),
+        (EX.alt_path, EX.p1 | EX.p2 | EX.p3),
+        (EX.nested_alt_path, EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+        (EX.zero_or_more_path, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.one_or_more_path, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zero_or_one_path, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.combo_path, (EX.p1 | EX.p2) / (EX.p3 * "*")),  # type: ignore[operator]
+        (EX.mod_of_inv_path, (~EX.p1) * "*"),
+        (EX.missing_rest_path, EX.p1 / EX.p2),
+        (EX.nil_path, SHACLPathError),
+        (EX.empty_seq_path, SHACLPathError),
+        (EX.one_seq_path, SHACLPathError),
+        (EX.empty_alt_path, SHACLPathError),
+        (EX.one_alt_path, SHACLPathError),
+        (EX.unknown_path, SHACLPathError),
+        (EX.literal_path, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triple_count = len(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        actual = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert actual == expected
+    assert len(shapes_graph) == triple_count
