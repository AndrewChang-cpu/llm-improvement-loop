index 0000000..00e9c6f
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,151 @@
+from __future__ import annotations
+
+from typing import Optional, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [ sh:alternativePath ( ex:p1 [ sh:inversePath ex:p2 ] ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqWithAltAndMod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:lastCellNoRest sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path ( ) .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literalPath sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected, error",
+    [
+        pytest.param(EX.simple, EX.p1, None, id="simple"),
+        pytest.param(EX.seq, EX.p1 / EX.p2 / EX.p3, None, id="sequence"),
+        pytest.param(
+            EX.nestedSeq,
+            EX.p1 / (EX.p2 / EX.p3),
+            None,
+            id="nested-sequence",
+        ),
+        pytest.param(EX.inv, ~EX.p1, None, id="inverse"),
+        pytest.param(EX.alt, EX.p1 | EX.p2 | EX.p3, None, id="alternative"),
+        pytest.param(
+            EX.nestedAlt,
+            EX.p1 | ~EX.p2,
+            None,
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.zeroOrMore,
+            EX.p1 * "*",  # type: ignore[operator]
+            None,
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMore,
+            EX.p1 * "+",  # type: ignore[operator]
+            None,
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOne,
+            EX.p1 * "?",  # type: ignore[operator]
+            None,
+            id="zero-or-one",
+        ),
+        pytest.param(EX.modInv, ~EX.p1 * "*", None, id="modifier-of-inverse"),
+        pytest.param(
+            EX.seqWithAltAndMod,
+            (EX.p1 | EX.p2) / (EX.p3 * "+"),  # type: ignore[operator]
+            None,
+            id="sequence-with-alternative-and-modifier",
+        ),
+        pytest.param(
+            EX.lastCellNoRest,
+            EX.p1 / EX.p2,
+            None,
+            id="list-last-cell-without-rest",
+        ),
+        pytest.param(EX.nilPath, None, SHACLPathError, id="rdf-nil-as-path"),
+        pytest.param(EX.emptySeq, None, SHACLPathError, id="empty-sequence"),
+        pytest.param(EX.oneSeq, None, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlt, None, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneAlt, None, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknown, None, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literalPath, None, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    if error is None:
+        assert expected is not None
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes_graph, path_node)
+
+
+@pytest.mark.parametrize(
+    "bad_node",
+    [
+        pytest.param("http://example.org/p1", id="plain-string"),
+        pytest.param(None, id="none"),
+    ],
+)
+def test_parse_shacl_path_non_node(shapes_graph: Graph, bad_node: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_node)  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_does_not_change_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in (EX.nilPath, EX.unknown, EX.seq, EX.inv):
+        path_node = shapes_graph.value(shape, SH.path)
+        assert path_node is not None
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except SHACLPathError:
+            pass
+    assert set(shapes_graph) == before
+
