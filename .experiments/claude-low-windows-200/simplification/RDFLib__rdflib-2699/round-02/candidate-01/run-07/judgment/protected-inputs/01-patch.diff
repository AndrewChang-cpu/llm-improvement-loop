index 0000000..cf390d5
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+from typing import List, Optional, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.com/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_iri sh:path ex:p1 .
+ex:s_seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:s_nested_seq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:s_inv sh:path [ sh:inversePath ex:p1 ] .
+ex:s_alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:s_nested_alt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) )
+] .
+ex:s_zero sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:s_one sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:s_opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:s_mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:s_seq_mixed sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:s_open_list sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+
+ex:s_empty_seq sh:path () .
+ex:s_one_seq sh:path ( ex:p1 ) .
+ex:s_empty_alt sh:path [ sh:alternativePath () ] .
+ex:s_one_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:s_unknown sh:path [ ex:other ex:p1 ] .
+ex:s_literal sh:path "not a path" .
+"""
+
+PathCase = Tuple[
+    URIRef,
+    Optional[Union[URIRef, Path]],
+    Optional[Type[Exception]],
+]
+
+CASES: List[PathCase] = [
+    (EX.s_iri, EX.p1, None),
+    (EX.s_seq, EX.p1 / EX.p2 / EX.p3, None),
+    (EX.s_nested_seq, EX.p1 / (EX.p2 / EX.p3), None),
+    (EX.s_inv, ~EX.p1, None),
+    (EX.s_alt, EX.p1 | EX.p2 | EX.p3, None),
+    (EX.s_nested_alt, EX.p1 | ~EX.p2 | (EX.p3 / EX.p4), None),
+    (EX.s_zero, EX.p1 * "*", None),  # type: ignore[operator]
+    (EX.s_one, EX.p1 * "+", None),  # type: ignore[operator]
+    (EX.s_opt, EX.p1 * "?", None),  # type: ignore[operator]
+    (EX.s_mod_inv, (~EX.p1) * "*", None),
+    (
+        EX.s_seq_mixed,
+        EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+"),  # type: ignore[operator]
+        None,
+    ),
+    (EX.s_open_list, EX.p1 / EX.p2, None),
+    (EX.s_empty_seq, None, SHACLPathError),
+    (EX.s_one_seq, None, SHACLPathError),
+    (EX.s_empty_alt, None, SHACLPathError),
+    (EX.s_one_alt, None, SHACLPathError),
+    (EX.s_unknown, None, SHACLPathError),
+    (EX.s_literal, None, TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize("shape, expected, error", CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if error is None:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
