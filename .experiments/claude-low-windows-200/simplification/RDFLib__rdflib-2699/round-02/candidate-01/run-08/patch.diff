@@ -0,0 +1,100 @@
+"""Utilities for working with SHACL shapes graphs."""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path is malformed or unrecognized."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    The parser only reads from the graph and does not modify it.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the node that is the object of a ``sh:path``
+        triple.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or unrecognized.
+
+    The implementation is based on the SHACL-to-SPARQL path conversion in
+    pyshacl.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}",
+        )
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # sequence path: an RDF list
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}",
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alt_items = list(shapes_graph.items(alternative_list))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}",
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..a6872e0
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,132 @@
+from __future__ import annotations
+
+from typing import Set, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seq_nested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seq_open_tail sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:alt_nested sh:path [
+    sh:alternativePath ( [ sh:alternativePath ( ex:p1 ex:p2 ) ] ex:p3 )
+] .
+
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modified_inverse sh:path [
+    sh:zeroOrMorePath [ sh:inversePath ex:p1 ]
+] .
+
+ex:seq_with_alt_and_mod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath ex:p3 ]
+) .
+
+ex:bad_nil sh:path rdf:nil .
+ex:bad_empty_seq sh:path ( ) .
+ex:bad_one_seq sh:path ( ex:p1 ) .
+ex:bad_empty_alt sh:path [ sh:alternativePath ( ) ] .
+ex:bad_one_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:bad_unknown sh:path [ ex:unrelated ex:p1 ] .
+ex:bad_literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.bind("ex", EX)
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+VALID_CASES: list[Tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.simple, EX.p1),
+    (EX.seq, EX.p1 / EX.p2 / EX.p3),
+    (EX.seq_nested, EX.p1 / (EX.p2 / EX.p3)),
+    (EX.seq_open_tail, EX.p1 / EX.p2),
+    (EX.inverse, ~EX.p1),
+    (EX.alt, EX.p1 | EX.p2 | EX.p3),
+    (EX.alt_nested, EX.p1 | EX.p2 | EX.p3),
+    (EX.zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.modified_inverse, (~EX.p1) * "*"),
+    (
+        EX.seq_with_alt_and_mod,
+        (EX.p1 | EX.p2) / (EX.p3 * "*"),  # type: ignore[operator]
+    ),
+]
+
+INVALID_CASES: list[Tuple[URIRef, Type[Exception]]] = [
+    (EX.bad_nil, SHACLPathError),
+    (EX.bad_empty_seq, SHACLPathError),
+    (EX.bad_one_seq, SHACLPathError),
+    (EX.bad_empty_alt, SHACLPathError),
+    (EX.bad_one_alt, SHACLPathError),
+    (EX.bad_unknown, SHACLPathError),
+    (EX.bad_literal, TypeError),
+]
+
+
+@pytest.mark.parametrize("shape, expected", VALID_CASES)
+def test_valid_paths(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    before: Set[object] = set(shapes)
+    path_node = shapes.value(shape, SH.path)
+    result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert result == expected
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("shape, exc_type", INVALID_CASES)
+def test_invalid_paths(
+    shapes: Graph,
+    shape: URIRef,
+    exc_type: Type[Exception],
+) -> None:
+    before: Set[object] = set(shapes)
+    path_node = shapes.value(shape, SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes: Graph) -> None:
+    before: Set[object] = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p1")  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_literal_is_type_error(shapes: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes, Literal("p1"))
