index 0000000..7a43bc9
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,101 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    The parser is based on the SHACL-to-SPARQL path conversion in pyshacl.
+    A valid SHACL path is either an IRI naming a plain predicate (other than
+    ``rdf:nil``), an RDF list of at least two paths (a sequence path), or a
+    blank node using one of the following predicates: ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of at least two paths),
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    The parser only reads ``shapes_graph`` and never changes it.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes
+        graph. It is only read.
+    :param path_identifier: the node that is the object of the ``sh:path``
+        triple: an IRI, a blank node, or a literal.
+    :returns: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a literal.
+    :raises SHACLPathError: if the node is not a valid SHACL path, including
+        when it is not a node at all.
+    """
+    # Typed as object so that the non-node check below is reachable for
+    # callers that pass values outside the declared type.
+    node: object = path_identifier
+
+    if isinstance(node, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+    if not isinstance(node, Node):
+        raise SHACLPathError(f"not a node, so not a SHACL path: {node!r}")
+
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # rdf:first: sequence path given as an RDF list
+    if shapes_graph.value(node, RDF.first) is not None:
+        items = list(shapes_graph.items(node))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path {node!r} must have at least two items, "
+                f"found {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: RDF list of alternatives
+    alternatives = shapes_graph.value(node, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"alternative path {node!r} must have at least two items, "
+                f"found {len(alt_items)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..3f93506
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seqWithInvShape sh:path ( [ sh:inversePath ex:p1 ] ex:p2 ) .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:invShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:invZeroOrMoreShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:noRestShape sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:emptySeqShape sh:path () .
+ex:oneItemSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownShape sh:path [ ex:other ex:p1 ] .
+ex:literalShape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iriShape", EX.p1),
+    ("seqShape", EX.p1 / EX.p2 / EX.p3),
+    ("nestedSeqShape", EX.p1 / (EX.p2 / EX.p3)),
+    ("seqWithInvShape", ~EX.p1 / EX.p2),
+    ("altShape", EX.p1 | EX.p2),
+    ("invShape", ~EX.p1),
+    ("zeroOrMoreShape", EX.p1 * "*"),  # type: ignore[operator]
+    ("oneOrMoreShape", EX.p1 * "+"),  # type: ignore[operator]
+    ("zeroOrOneShape", EX.p1 * "?"),  # type: ignore[operator]
+    ("invZeroOrMoreShape", ~EX.p1 * "*"),
+    ("noRestShape", EX.p1 / EX.p2),
+]
+
+INVALID_CASES: list[tuple[str, Type[Exception]]] = [
+    ("emptySeqShape", SHACLPathError),
+    ("oneItemSeqShape", SHACLPathError),
+    ("emptyAltShape", SHACLPathError),
+    ("oneItemAltShape", SHACLPathError),
+    ("unknownShape", SHACLPathError),
+    ("literalShape", TypeError),
+]
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_valid_shacl_path(
+    shapes_graph: Graph, shape: str, expected: Union[URIRef, Path]
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(EX[shape], SH.path)
+    result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(("shape", "exc_type"), INVALID_CASES)
+def test_invalid_shacl_path(
+    shapes_graph: Graph, shape: str, exc_type: Type[Exception]
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(EX[shape], SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_rdf_nil_path_raises(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: object
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_literal_input_raises_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("p1"))
