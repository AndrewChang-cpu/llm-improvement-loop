index 0000000..84c86e6
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_iri sh:path ex:p1 .
+
+ex:s_seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:s_seq_nested sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) ) .
+
+ex:s_alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+
+ex:s_inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:s_zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:s_one_or_more sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:s_zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:s_open_list sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:s_nil_path sh:path () .
+
+ex:s_one_seq sh:path ( ex:p1 ) .
+
+ex:s_empty_alt sh:path [ sh:alternativePath () ] .
+
+ex:s_one_alt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:s_unrecognized sh:path [ ex:other ex:p1 ] .
+
+ex:s_literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+# A modifier applied directly to a bare IRI is not typed as a path.
+ZERO_OR_MORE_P1 = EX.p1 * "*"  # type: ignore[operator]
+ZERO_OR_ONE_P1 = EX.p1 * "?"  # type: ignore[operator]
+
+VALID_CASES = [
+    pytest.param("s_iri", EX.p1, id="iri"),
+    pytest.param("s_seq", EX.p1 / EX.p2 / EX.p3, id="sequence"),
+    pytest.param(
+        "s_seq_nested",
+        EX.p1 / (~EX.p2) / (EX.p3 / EX.p4),
+        id="sequence-nested",
+    ),
+    pytest.param("s_alt", EX.p1 | EX.p2, id="alternative"),
+    pytest.param("s_inv", ~EX.p1, id="inverse"),
+    pytest.param("s_zero_or_more", ZERO_OR_MORE_P1, id="zero-or-more"),
+    pytest.param("s_one_or_more", (~EX.p1) * "+", id="one-or-more-inverse"),
+    pytest.param("s_zero_or_one", ZERO_OR_ONE_P1, id="zero-or-one"),
+    pytest.param("s_open_list", EX.p1 / EX.p2, id="open-list"),
+]
+
+INVALID_CASES = [
+    pytest.param("s_nil_path", SHACLPathError, id="nil-or-empty-sequence"),
+    pytest.param("s_one_seq", SHACLPathError, id="one-item-sequence"),
+    pytest.param("s_empty_alt", SHACLPathError, id="empty-alternative"),
+    pytest.param("s_one_alt", SHACLPathError, id="one-item-alternative"),
+    pytest.param("s_unrecognized", SHACLPathError, id="unrecognized-blank-node"),
+    pytest.param("s_literal", TypeError, id="literal"),
+]
+
+
+@pytest.mark.parametrize("shape_name, expected", VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path],
+) -> None:
+    shape = EX[shape_name]
+    node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("shape_name, error", INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    error: type[Exception],
+) -> None:
+    shape = EX[shape_name]
+    node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(error):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+def test_none_and_plain_string_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        plain = "http://example.org/p1"
+        parse_shacl_path(shapes_graph, plain)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape_name in ["s_seq_nested", "s_open_list", "s_inv"]:
+        node = shapes_graph.value(EX[shape_name], SH.path)
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    for shape_name in ["s_nil_path", "s_unrecognized", "s_one_alt"]:
+        node = shapes_graph.value(EX[shape_name], SH.path)
+        with pytest.raises(SHACLPathError):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
