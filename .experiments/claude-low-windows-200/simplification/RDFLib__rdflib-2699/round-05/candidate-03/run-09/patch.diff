+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import BNode, Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a SHACL shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI (a plain predicate), a blank node or
+    RDF list describing a sequence path (``rdf:first``/``rdf:rest`` list of at
+    least two items), ``sh:inversePath``, ``sh:alternativePath`` (an RDF list
+    of at least two items), or one of ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath`` and ``sh:zeroOrOnePath`` wrapping another path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the object of a ``sh:path``
+        triple. Must be a :class:`~rdflib.term.URIRef` or a
+        :class:`~rdflib.term.BNode`.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the node is not a usable SHACL path.
+
+    This implementation is based on the SHACL-to-SPARQL path conversion in
+    pyshacl.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, (URIRef, BNode)):
+        raise SHACLPathError(f"non-node input is not a SHACL path: {path_identifier!r}")
+
+    # Plain predicate, or the empty list which is not a valid path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # sh:path as an RDF list: sequence path (rdf:first/rdf:rest).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        sequence = list(shapes_graph.items(path_identifier))
+        if len(sequence) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath (an RDF list of at least two items)
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternatives = list(shapes_graph.items(alternative_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
