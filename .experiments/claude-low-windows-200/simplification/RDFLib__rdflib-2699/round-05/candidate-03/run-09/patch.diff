index 0000000..4c9d4de
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,106 @@
+from __future__ import annotations
+
+from typing import List, Optional, Set, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = "http://example.org/"
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+
+ex:sequence sh:path ( ex:p ex:q ex:r ) .
+
+ex:nestedSequence sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ex:s ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+
+ex:oneOrMoreInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ( ex:p ex:q ) ] .
+
+ex:openList sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+
+ex:nilPath sh:path rdf:nil .
+
+ex:emptySequence sh:path () .
+
+ex:oneItemSequence sh:path ( ex:p ) .
+
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+
+ex:unrecognized sh:path [ ex:foo ex:bar ] .
+
+ex:literal sh:path "http://example.org/p" .
+"""
+
+P, Q, R, S = URIRef(EX + "p"), URIRef(EX + "q"), URIRef(EX + "r"), URIRef(EX + "s")
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+def shape(name: str) -> URIRef:
+    return URIRef(EX + name)
+
+
+CASES: List[Tuple[str, Union[URIRef, Path, Type[Exception]]]] = [
+    ("iri", P),
+    ("sequence", P / Q / R),
+    ("nestedSequence", P / (Q | R) / S),
+    ("inverse", ~P),
+    ("zeroOrMore", P * "*"),  # type: ignore[operator]
+    ("oneOrMoreInverse", (~P) * "+"),
+    ("zeroOrOne", (P / Q) * "?"),
+    ("openList", P / Q),
+    ("nilPath", SHACLPathError),
+    ("emptySequence", SHACLPathError),
+    ("oneItemSequence", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("oneItemAlternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize(("name", "expected"), CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before: Set[Tuple[Node, Node, Node]] = set(shapes_graph)
+    path_node: Optional[Node] = shapes_graph.value(shape(name), SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/p"])
+def test_non_node_input_raises(shapes_graph: Graph, value: Optional[str]) -> None:
+    before: Set[Tuple[Node, Node, Node]] = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, value)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
