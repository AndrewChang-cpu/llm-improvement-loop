index 0000000..356cc68
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+# Modifiers applied to a bare IRI: URIRef has no typed multiplication operator.
+ZERO_OR_MORE_P1 = EX.p1 * "*"  # type: ignore[operator]
+ZERO_OR_ONE_P1 = EX.p1 * "?"  # type: ignore[operator]
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.com/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:emptySequence sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:unknown ex:p1 ] .
+ex:literal sh:path "ex:p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.iri, EX.p1, id="iri"),
+        pytest.param(EX.sequence, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nestedSequence,
+            EX.p1 / (EX.p2 | EX.p3),
+            id="nested-sequence-with-alternative",
+        ),
+        pytest.param(EX.inverse, ~EX.p1, id="inverse"),
+        pytest.param(EX.zeroOrMore, ZERO_OR_MORE_P1, id="zero-or-more"),
+        pytest.param(EX.oneOrMore, (~EX.p1) * "+", id="one-or-more-inverse"),
+        pytest.param(EX.zeroOrOne, ZERO_OR_ONE_P1, id="zero-or-one"),
+        pytest.param(EX.alternative, EX.p1 | EX.p2, id="alternative"),
+        pytest.param(EX.openList, EX.p1 / EX.p2, id="list-without-final-rest"),
+        pytest.param(EX.emptySequence, SHACLPathError, id="empty-sequence-is-nil"),
+        pytest.param(EX.oneItemSequence, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlternative, SHACLPathError, id="empty-alternative"),
+        pytest.param(
+            EX.oneItemAlternative, SHACLPathError, id="one-item-alternative"
+        ),
+        pytest.param(EX.unrecognized, SHACLPathError, id="unrecognized-node"),
+        pytest.param(EX.literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    before = set(shapes_graph)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+def test_rdf_nil_as_path_is_rejected(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
+
+
+@pytest.mark.parametrize("node", [None, "ex:p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    node: Optional[str],
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
