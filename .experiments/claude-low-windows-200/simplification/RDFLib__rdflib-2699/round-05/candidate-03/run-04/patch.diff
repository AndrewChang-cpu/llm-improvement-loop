index 0000000..7d29562
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iriShape sh:path ex:p .
+ex:sequenceShape sh:path ( ex:p ex:q ex:r ) .
+ex:openListShape sh:path _:cell1 .
+_:cell1 rdf:first ex:p ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:q .
+ex:nestedShape sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:inverseShape sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ( ex:p ex:q ) ] .
+ex:oneOrMoreInverseShape sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:zeroOrOneAlternativeShape sh:path [
+    sh:zeroOrOnePath [ sh:alternativePath ( ex:p ex:q ) ]
+] .
+ex:nestedModifierShape sh:path [
+    sh:zeroOrMorePath [ sh:oneOrMorePath ( ex:p ex:q ) ]
+] .
+
+ex:nilShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:p ) .
+ex:nilItemSequenceShape sh:path ( ex:p () ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unrecognizedShape sh:path [ ex:other ex:p ] .
+ex:literalShape sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        (EX.iriShape, EX.p),
+        (EX.sequenceShape, EX.p / EX.q / EX.r),
+        (EX.openListShape, EX.p / EX.q),
+        (EX.nestedShape, EX.p / (EX.q | EX.r)),
+        (EX.alternativeShape, EX.p | EX.q),
+        (EX.inverseShape, ~EX.p),
+        (EX.zeroOrMoreShape, (EX.p / EX.q) * "*"),
+        (EX.oneOrMoreInverseShape, (~EX.p) * "+"),
+        (EX.zeroOrOneAlternativeShape, (EX.p | EX.q) * "?"),
+        (EX.nestedModifierShape, ((EX.p / EX.q) * "+") * "*"),
+    ],
+)
+def test_parse_shacl_path_valid(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    assert parse_shacl_path(shapes_graph, path_node) == expected
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected_error"),
+    [
+        (EX.nilShape, SHACLPathError),
+        (EX.oneItemSequenceShape, SHACLPathError),
+        (EX.nilItemSequenceShape, SHACLPathError),
+        (EX.emptyAlternativeShape, SHACLPathError),
+        (EX.oneItemAlternativeShape, SHACLPathError),
+        (EX.unrecognizedShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_shacl_path_invalid(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected_error: Type[Exception],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    with pytest.raises(expected_error):
+        parse_shacl_path(shapes_graph, path_node)
+    assert set(shapes_graph) == before
+
+
+def test_parse_shacl_path_rejects_non_nodes(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "ex:p")  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_parse_shacl_path_cyclic_list_raises_value_error() -> None:
+    g = Graph()
+    g.parse(
+        data="""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+        @prefix ex: <http://example.org/> .
+        ex:loop sh:path _:a .
+        _:a rdf:first ex:p ; rdf:rest _:b .
+        _:b rdf:first ex:q ; rdf:rest _:a .
+        """,
+        format="turtle",
+    )
+    path_node = g.value(EX.loop, SH.path)
+    assert path_node is not None
+    with pytest.raises(ValueError):
+        parse_shacl_path(g, path_node)
