index 0000000..52a9682
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,106 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_iri sh:path ex:p .
+ex:s_inv sh:path [ sh:inversePath ex:p ] .
+ex:s_seq sh:path ( ex:p ex:q ex:r ) .
+ex:s_seq_nested sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ex:s ) .
+ex:s_alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:s_star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:s_plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:s_opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:s_star_alt sh:path [ sh:zeroOrMorePath [ sh:alternativePath ( ex:p ex:q ) ] ] .
+ex:s_star_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:s_open sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+
+ex:s_empty sh:path () .
+ex:s_seq_one sh:path ( ex:p ) .
+ex:s_alt_empty sh:path [ sh:alternativePath () ] .
+ex:s_alt_one sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:s_unknown sh:path [ ex:foo ex:bar ] .
+ex:s_literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("s_iri", EX.p),
+        ("s_inv", ~EX.p),
+        ("s_seq", EX.p / EX.q / EX.r),
+        ("s_seq_nested", EX.p / (EX.q | EX.r) / EX.s),
+        ("s_alt", EX.p | EX.q),
+        ("s_star", EX.p * "*"),  # type: ignore[operator]
+        ("s_plus", EX.p * "+"),  # type: ignore[operator]
+        ("s_opt", EX.p * "?"),  # type: ignore[operator]
+        ("s_star_alt", (EX.p | EX.q) * "*"),
+        ("s_star_inv", (~EX.p) * "*"),
+        ("s_open", EX.p / EX.q),
+        ("s_empty", SHACLPathError),
+        ("s_seq_one", SHACLPathError),
+        ("s_alt_empty", SHACLPathError),
+        ("s_alt_one", SHACLPathError),
+        ("s_unknown", SHACLPathError),
+        ("s_literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.com/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    bad_input: str,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("s_iri", "s_empty", "s_unknown", "s_literal"):
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
+
+
+def test_literal_path_is_type_error_not_shacl_error(shapes_graph: Graph) -> None:
+    literal = shapes_graph.value(EX.s_literal, SH.path)
+    assert isinstance(literal, Literal)
+    with pytest.raises(TypeError) as info:
+        parse_shacl_path(shapes_graph, literal)
+    assert not isinstance(info.value, SHACLPathError)
