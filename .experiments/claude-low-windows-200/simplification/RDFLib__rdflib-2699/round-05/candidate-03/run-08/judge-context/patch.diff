@@ -0,0 +1,100 @@
+"""Contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+# The path parsing below follows the SHACL-to-SPARQL path conversion in pyshacl,
+# which this module is based on.
+
+
+class SHACLPathError(Exception):
+    """Raised when a node is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is an IRI, an RDF list of at least two paths (a sequence
+    path), a blank node with ``sh:inversePath`` or ``sh:alternativePath`` (an
+    RDF list of at least two paths), or a blank node with ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath`` wrapping another path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` that holds the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the object of the ``sh:path``
+        triple. It is an IRI or a blank node; a literal is rejected.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if ``path_identifier`` is not a node, is ``rdf:nil``,
+        is a list with too few items, or is not a recognized path.
+    """
+    node: object = path_identifier
+
+    if isinstance(node, Literal):
+        raise TypeError(f"literals are not valid SHACL paths: {node!r}")
+    if not isinstance(node, Node):
+        raise SHACLPathError(f"not a node, so not a SHACL path: {node!r}")
+
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # rdf:first marks an RDF list, read as a sequence path
+    if (node, RDF.first, None) in shapes_graph:
+        sequence_items = list(shapes_graph.items(node))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"sequence path {node!r} must have at least two items, "
+                f"found {len(sequence_items)}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse = shapes_graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath, whose value is an RDF list
+    alternatives = shapes_graph.value(node, SH.alternativePath)
+    if alternatives is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"alternative path {node!r} must have at least two items, "
+                f"found {len(alternative_items)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..966c33b
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,89 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:sequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:sequenceWithAlternativeShape sh:path
+    ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ex:p4 ) .
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreInverseShape sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:openListShape sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:emptySequenceShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:p1 ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognizedShape sh:path [ ex:other ex:p1 ] .
+ex:literalShape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iriShape, EX.p1),
+        (EX.sequenceShape, EX.p1 / EX.p2 / EX.p3),
+        (EX.sequenceWithAlternativeShape, EX.p1 / (EX.p2 | EX.p3) / EX.p4),
+        (EX.inverseShape, ~EX.p1),
+        (EX.zeroOrMoreShape, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMoreInverseShape, (~EX.p1) * "+"),
+        (EX.zeroOrOneShape, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.alternativeShape, EX.p1 | EX.p2),
+        (EX.openListShape, EX.p1 / EX.p2),
+        (EX.emptySequenceShape, SHACLPathError),
+        (EX.oneItemSequenceShape, SHACLPathError),
+        (EX.emptyAlternativeShape, SHACLPathError),
+        (EX.oneItemAlternativeShape, SHACLPathError),
+        (EX.unrecognizedShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes.value(shape, SH.path)
+    before = set(shapes)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    bad_input: Optional[str],
+) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
+    assert set(shapes) == before
