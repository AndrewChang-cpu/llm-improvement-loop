index 0000000..13f59a2
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,101 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union, cast
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not describe a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    The parsing follows pyshacl's SHACL-to-SPARQL path conversion. A valid
+    SHACL path is one of:
+
+    - an IRI naming a plain predicate (``rdf:nil`` is not allowed);
+    - an RDF list of at least two paths, read as a sequence path;
+    - a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two paths), ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    The parser only reads ``shapes_graph`` and never changes it.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It must already be fully loaded.
+    :param path_identifier: the node that is the object of the ``sh:path``
+        triple. It is an IRI, a blank node, or a :class:`~rdflib.term.Literal`
+        (which is rejected).
+    :returns: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a literal.
+    :raises SHACLPathError: if the node is not a valid SHACL path, including
+        when it is not a node at all.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+    # Runtime guard for callers that bypass the annotation (None, plain strings).
+    if not isinstance(cast(object, path_identifier), Node):
+        raise SHACLPathError(f"not a graph node: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list (rdf:first / rdf:rest chain).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items],
+        )
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items],
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..b01b509
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSeq sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+
+ex:openSeq sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqPlus sh:path [ sh:oneOrMorePath ( ex:p1 ex:p2 ) ] .
+
+ex:nil sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+VALID_CASES: List[Tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.iri, EX.p1),
+    (EX.seq, EX.p1 / EX.p2 / EX.p3),
+    (EX.nestedSeq, EX.p1 / (EX.p2 | EX.p3)),
+    (EX.openSeq, EX.p1 / EX.p2),
+    (EX.inv, ~EX.p1),
+    (EX.alt, EX.p1 | EX.p2),
+    (EX.star, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.plus, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.opt, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.invStar, (~EX.p1) * "*"),
+    (EX.seqPlus, (EX.p1 / EX.p2) * "+"),
+]
+
+INVALID_CASES: List[Tuple[URIRef, Type[Exception]]] = [
+    (EX.nil, SHACLPathError),
+    (EX.emptySeq, SHACLPathError),
+    (EX.oneSeq, SHACLPathError),
+    (EX.emptyAlt, SHACLPathError),
+    (EX.oneAlt, SHACLPathError),
+    (EX.unknown, SHACLPathError),
+    (EX.literal, TypeError),
+]
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    VALID_CASES,
+)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected_exc"),
+    INVALID_CASES,
+)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected_exc: Type[Exception],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(expected_exc):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "ex:p1", Literal("x")])
+def test_parse_non_node_input_is_rejected(
+    shapes_graph: Graph,
+    bad_input: Union[None, str, Literal],
+) -> None:
+    before = set(shapes_graph)
+    if isinstance(bad_input, Literal):
+        with pytest.raises(TypeError):
+            parse_shacl_path(shapes_graph, bad_input)
+    else:
+        with pytest.raises(SHACLPathError):
+            parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
