index 0000000..f44dc61
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,201 @@
+from __future__ import annotations
+
+from typing import Callable, Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+
+ex:sequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSequenceShape sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ex:p3 ) .
+
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMoreInverseShape sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:zeroOrOneAlternativeShape sh:path [
+    sh:zeroOrOnePath [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+] .
+
+ex:oneOrMoreSequenceShape sh:path [ sh:oneOrMorePath ( ex:p1 ex:p2 ) ] .
+
+ex:truncatedListShape sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:nilShape sh:path rdf:nil .
+
+ex:emptySequenceShape sh:path ( ) .
+
+ex:oneItemSequenceShape sh:path ( ex:p1 ) .
+
+ex:emptyAlternativeShape sh:path [ sh:alternativePath ( ) ] .
+
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unrecognizedShape sh:path [ ex:other ex:p1 ] .
+
+ex:literalShape sh:path "not a path" .
+"""
+
+PathGetter = Callable[[Graph], Optional[Union[Node, str]]]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    ("get_path", "expected", "error"),
+    [
+        pytest.param(
+            lambda g: g.value(EX.iriShape, SH.path),
+            EX.p1,
+            None,
+            id="iri",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.sequenceShape, SH.path),
+            EX.p1 / EX.p2 / EX.p3,
+            None,
+            id="sequence",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.nestedSequenceShape, SH.path),
+            EX.p1 / ~EX.p2 / EX.p3,
+            None,
+            id="sequence-with-inverse",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.alternativeShape, SH.path),
+            EX.p1 | EX.p2,
+            None,
+            id="alternative",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.inverseShape, SH.path),
+            ~EX.p1,
+            None,
+            id="inverse",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.zeroOrMoreShape, SH.path),
+            EX.p1 * "*",  # type: ignore[operator]
+            None,
+            id="zero-or-more",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.oneOrMoreInverseShape, SH.path),
+            (~EX.p1) * "+",
+            None,
+            id="one-or-more-inverse",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.zeroOrOneAlternativeShape, SH.path),
+            (EX.p1 | EX.p2) * "?",
+            None,
+            id="zero-or-one-alternative",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.oneOrMoreSequenceShape, SH.path),
+            (EX.p1 / EX.p2) * "+",
+            None,
+            id="one-or-more-sequence",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.truncatedListShape, SH.path),
+            EX.p1 / EX.p2,
+            None,
+            id="list-without-final-rest",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.nilShape, SH.path),
+            None,
+            SHACLPathError,
+            id="rdf-nil-as-path",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.emptySequenceShape, SH.path),
+            None,
+            SHACLPathError,
+            id="empty-sequence",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.oneItemSequenceShape, SH.path),
+            None,
+            SHACLPathError,
+            id="one-item-sequence",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.emptyAlternativeShape, SH.path),
+            None,
+            SHACLPathError,
+            id="empty-alternative",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.oneItemAlternativeShape, SH.path),
+            None,
+            SHACLPathError,
+            id="one-item-alternative",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.unrecognizedShape, SH.path),
+            None,
+            SHACLPathError,
+            id="unrecognized-blank-node",
+        ),
+        pytest.param(
+            lambda g: g.value(EX.literalShape, SH.path),
+            None,
+            TypeError,
+            id="literal",
+        ),
+        pytest.param(
+            lambda _g: None,
+            None,
+            SHACLPathError,
+            id="none",
+        ),
+        pytest.param(
+            lambda _g: str(EX.p1),
+            None,
+            SHACLPathError,
+            id="plain-string",
+        ),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    get_path: PathGetter,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    before = set(shapes)
+    path_node = get_path(shapes)
+    if error is None:
+        assert expected is not None
+        assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
