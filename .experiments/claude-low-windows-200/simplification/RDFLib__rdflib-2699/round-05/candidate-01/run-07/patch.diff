index 0000000..1625a60
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from contextlib import suppress
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nested_seq sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:seq_no_rest sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+ex:seq_alt sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:nil_path sh:path () .
+ex:one_item_seq sh:path ( ex:p ) .
+ex:nil_item_seq sh:path ( ex:p ( ) ) .
+ex:empty_alt sh:path [ sh:alternativePath ( ) ] .
+ex:one_item_alt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal_path sh:path "p" .
+ex:cyclic sh:path _:cyc .
+_:cyc rdf:first ex:p ; rdf:rest _:cyc .
+"""
+
+CASES: List[Tuple[str, Union[URIRef, Path, Type[Exception]]]] = [
+    ("iri", EX.p),
+    ("seq", EX.p / EX.q / EX.r),
+    ("nested_seq", EX.p / (EX.q / EX.r)),
+    ("seq_no_rest", EX.p / EX.q),
+    ("seq_alt", EX.p / (EX.q | EX.r)),
+    ("alt", EX.p | EX.q),
+    ("inv", ~EX.p),
+    ("zero_or_more", EX.p * "*"),  # type: ignore[operator]
+    ("one_or_more", EX.p * "+"),  # type: ignore[operator]
+    ("zero_or_one", EX.p * "?"),  # type: ignore[operator]
+    ("mod_inv", (~EX.p) * "*"),
+    ("nil_path", SHACLPathError),
+    ("one_item_seq", SHACLPathError),
+    ("nil_item_seq", SHACLPathError),
+    ("empty_alt", SHACLPathError),
+    ("one_item_alt", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal_path", TypeError),
+    ("cyclic", ValueError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(("shape", "expected"), CASES)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+
+
+def test_none_input_raises_shacl_path_error(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+
+
+def test_plain_string_input_raises_shacl_path_error(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p")  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape, _ in CASES:
+        path_node = shapes.value(EX[shape], SH.path)
+        with suppress(Exception):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
