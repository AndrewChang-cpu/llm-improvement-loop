index 0000000..d22d121
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,116 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSequence sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:inverseZeroOrMore sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:unknown ex:value ] .
+ex:literal sh:path "not a path" .
+"""
+
+CYCLIC_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:cyclic sh:path _:a .
+_:a rdf:first ex:p1 ; rdf:rest _:b .
+_:b rdf:first ex:p2 ; rdf:rest _:a .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        ("iri", EX.p),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSequence", EX.p1 / (EX.p2 / EX.p3)),
+        ("openSequence", EX.p1 / EX.p2),
+        ("alternative", EX.p1 | EX.p2),
+        ("inverse", ~EX.p),
+        ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+        ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+        ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+        ("inverseZeroOrMore", ~EX.p * "*"),
+        ("emptyList", SHACLPathError),
+        ("oneItemSequence", SHACLPathError),
+        ("emptyAlternative", SHACLPathError),
+        ("oneItemAlternative", SHACLPathError),
+        ("unrecognized", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("path_identifier", [None, "http://example.com/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    path_identifier: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_identifier)  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for node in list(shapes_graph.objects(None, SH.path)):
+        try:
+            parse_shacl_path(shapes_graph, node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
+
+
+def test_cyclic_list_raises_value_error() -> None:
+    graph = Graph()
+    graph.parse(data=CYCLIC_TTL, format="turtle")
+    path_node = graph.value(EX.cyclic, SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
