@@ -0,0 +1,89 @@
+"""Contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The conversion of SHACL paths follows the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into a predicate or a path.
+
+    A valid SHACL path is one of the following: an IRI other than ``rdf:nil``;
+    an RDF list of at least two paths (a sequence path); a node with
+    ``sh:inversePath``; a node with ``sh:alternativePath`` whose value is an RDF
+    list of at least two paths; or a node with ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath`` whose value is a path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read and is never modified.
+    :param path_identifier: the object node of a ``sh:path`` triple.
+    :returns: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the input is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"A Literal cannot be a SHACL path: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path.")
+        return path_identifier
+
+    # Sequence path: an RDF list (rdf:first / rdf:rest) of path items.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path {path_identifier!r} needs at least two items, "
+                f"found {len(items)}."
+            )
+        return SequencePath(*(parse_shacl_path(shapes_graph, item) for item in items))
+
+    # Inverse path: sh:inversePath.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath, an RDF list of path items.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path {path_identifier!r} needs at least two items, "
+                f"found {len(items)}."
+            )
+        return AlternativePath(
+            *(parse_shacl_path(shapes_graph, item) for item in items)
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
