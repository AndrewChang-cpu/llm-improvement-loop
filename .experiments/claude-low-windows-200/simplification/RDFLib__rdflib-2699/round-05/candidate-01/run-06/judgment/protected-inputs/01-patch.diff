+"""Utilities for working with SHACL shapes graphs."""
+from __future__ import annotations
+
+from typing import Union, cast
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a SHACL shapes graph is not a valid SHACL path."""
+
+
+# The parsing logic below is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is returned unchanged;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two valid paths), ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``, whose value is a valid
+      path (for the alternative case, the list of valid paths).
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The object node of a ``sh:path`` triple.
+    :returns: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises SHACLPathError: If the node is not a valid SHACL path.
+    :raises TypeError: If the node is a :class:`~rdflib.term.Literal`.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literal {path_identifier!r} cannot be used as a SHACL path")
+
+    # Widened with cast so that non-node inputs such as None are rejected here,
+    # rather than matched as wildcards by the graph lookups below.
+    candidate = cast(object, path_identifier)
+    if not isinstance(candidate, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {candidate!r}")
+
+    # IRI: a plain predicate. rdf:nil is an empty list, not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil cannot be used as a SHACL path")
+        return path_identifier
+
+    # rdf:first: an RDF list forming a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path {path_identifier!r} must have at least two items, "
+                f"found {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of alternatives.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternatives = list(shapes_graph.items(alternative_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"Alternative path {path_identifier!r} must have at least two "
+                f"items, found {len(alternatives)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
