index 0000000..7a0760d
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+import contextlib
+from typing import List, Optional, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.com/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSequence sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] )
+] .
+ex:openList sh:path _:open1 .
+_:open1 rdf:first ex:p ; rdf:rest _:open2 .
+_:open2 rdf:first ex:q .
+
+ex:emptySequence sh:path () .
+ex:oneItemSequence sh:path ( ex:p ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+ex:cyclic sh:path _:cycle .
+_:cycle rdf:first ex:p ; rdf:rest _:cycle .
+"""
+
+VALID_CASES: List[Tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p),
+    ("sequence", EX.p / EX.q / EX.r),
+    ("nestedSequence", EX.p / (EX.q / EX.r)),
+    ("inverse", ~EX.p),
+    ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+    ("modifiedInverse", (~EX.p) * "*"),
+    ("alternative", EX.p | EX.q),
+    ("nestedAlternative", EX.p | (EX.q | EX.r)),
+    ("openList", EX.p / EX.q),
+]
+
+INVALID_CASES: List[Tuple[str, Type[Exception]]] = [
+    ("emptySequence", SHACLPathError),
+    ("oneItemSequence", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("oneItemAlternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal", TypeError),
+    ("cyclic", ValueError),
+]
+
+SHAPE_NAMES = [name for name, _ in VALID_CASES] + [name for name, _ in INVALID_CASES]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_parse_valid_path(
+    shapes: Graph, shape: str, expected: Union[URIRef, Path]
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize(("shape", "expected_exception"), INVALID_CASES)
+def test_parse_invalid_path(
+    shapes: Graph, shape: str, expected_exception: Type[Exception]
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    with pytest.raises(expected_exception):
+        parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("path_identifier", [None, "http://example.com/p"])
+def test_non_node_input_raises(shapes: Graph, path_identifier: Optional[str]) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, path_identifier)  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in SHAPE_NAMES:
+        path_node = shapes.value(EX[shape], SH.path)
+        with contextlib.suppress(SHACLPathError, TypeError, ValueError):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
