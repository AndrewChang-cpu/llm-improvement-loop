+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,98 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path is malformed or cannot be parsed."""
+
+
+# The conversion of SHACL paths into rdflib paths follows the approach used by
+# pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is either an IRI naming a plain predicate, or a blank
+    node or RDF list built from the SHACL path forms: a sequence (an RDF list
+    of at least two paths), ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+    list of at least two paths), or ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath`` wrapping a path. The
+    empty list ``rdf:nil`` is never a valid path.
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The object node of the ``sh:path`` triple.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path, usable with
+        :class:`~rdflib.graph.Graph` methods.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed, unrecognized, or the
+        input is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"a Literal cannot be a SHACL path: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            f"path identifier must be a graph node, got {path_identifier!r}"
+        )
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "sequence path must have at least two items, "
+                f"found {len(sequence_items)}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of paths.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternatives = list(shapes_graph.items(alternative_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "alternative path must have at least two items, "
+                f"found {len(alternatives)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..7aae850
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ( ex:p1 ex:p2 ) ex:p3 ) .
+ex:sequence_with_alternative sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifier_of_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:open_list sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:empty_sequence sh:path () .
+ex:nil_sequence_item sh:path ( ex:p1 () ) .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:unrelated ex:p1 ] .
+ex:literal sh:path "ex:p1" .
+ex:cyclic sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 ; rdf:rest _:c1 .
+"""
+
+# Bare IRIs have no static operator support, so operator expressions on them
+# need type-ignores. Once ignored, the result is Any and later operators are
+# accepted without further ignores.
+INVERSE_P1 = ~EX.p1  # type: ignore[operator]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p1),
+        (EX.sequence, EX.p1 / EX.p2 / EX.p3),  # type: ignore[operator]
+        (EX.nested_sequence, EX.p1 / EX.p2 / EX.p3),  # type: ignore[operator]
+        (
+            EX.sequence_with_alternative,
+            EX.p1 / (EX.p2 | EX.p3),  # type: ignore[operator]
+        ),
+        (EX.inverse, INVERSE_P1),
+        (EX.alternative, EX.p1 | EX.p2),  # type: ignore[operator]
+        (EX.zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modifier_of_inverse, INVERSE_P1 * "*"),
+        (EX.open_list, EX.p1 / EX.p2),  # type: ignore[operator]
+        (EX.empty_sequence, SHACLPathError),
+        (EX.nil_sequence_item, SHACLPathError),
+        (EX.one_item_sequence, SHACLPathError),
+        (EX.empty_alternative, SHACLPathError),
+        (EX.one_item_alternative, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal, TypeError),
+        (EX.cyclic, ValueError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("identifier", [None, "http://example.com/p1"])
+def test_non_node_input_raises(
+    shapes_graph: Graph,
+    identifier: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, identifier)  # type: ignore[arg-type]
