index 0000000..41bdd93
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,99 @@
+from __future__ import annotations
+
+import contextlib
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:noRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+ex:cyclic sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 ; rdf:rest _:c1 .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.noRest, EX.p1 / EX.p2),
+        (EX.inv, ~EX.p),
+        (EX.alt, EX.p1 | EX.p2),
+        (EX.star, EX.p * "*"),  # type: ignore[operator]
+        (EX.plus, EX.p * "+"),  # type: ignore[operator]
+        (EX.opt, EX.p * "?"),  # type: ignore[operator]
+        (EX.invStar, ~EX.p * "*"),
+        (EX.nilPath, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+        (EX.cyclic, ValueError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+def test_parse_non_node_inputs_raise(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "http://example.org/p")  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in set(shapes_graph.subjects(SH.path, None)):
+        node = shapes_graph.value(shape, SH.path)
+        with contextlib.suppress(SHACLPathError, TypeError, ValueError):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
