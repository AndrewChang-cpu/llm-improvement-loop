@@ -0,0 +1,97 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import List, Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import BNode, Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path in a shapes graph is malformed or unsupported."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a SHACL ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is either an IRI other than ``rdf:nil``, or a blank node
+    that is one of: an RDF list of at least two paths (a sequence path), an
+    ``sh:inversePath``, an ``sh:alternativePath`` whose value is an RDF list of
+    at least two paths, or an ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath`` whose value is a path.
+
+    The shapes graph is only read, never modified.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the object node of the ``sh:path`` triple.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"SHACL path must not be a literal: {path_identifier!r}")
+
+    # Declared as object so the runtime check stays reachable for mypy.
+    candidate: object = path_identifier
+    if not isinstance(candidate, Node):
+        raise SHACLPathError(f"SHACL path must be a node, got {candidate!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of paths (rdf:first / rdf:rest).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path must have at least two items, got {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of paths.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alt_items = list(shapes_graph.items(alternative_value))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"alternative path must have at least two items, got {len(alt_items)}"
+            )
+        parsed_alternatives: List[Union[URIRef, Path]] = [
+            parse_shacl_path(shapes_graph, i) for i in alt_items
+        ]
+        return AlternativePath(*parsed_alternatives)
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    if isinstance(path_identifier, BNode):
+        raise SHACLPathError(
+            f"blank node {path_identifier!r} has no recognized SHACL path predicate"
+        )
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..90f6310
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+ZERO_OR_MORE_IRI = EX.p * "*"  # type: ignore[operator]
+ONE_OR_MORE_IRI = EX.p * "+"  # type: ignore[operator]
+ZERO_OR_ONE_IRI = EX.p * "?"  # type: ignore[operator]
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSeq sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInv sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:noRest sh:path _:c1 .
+_:c1 rdf:first ex:p ;
+     rdf:rest _:c2 .
+_:c2 rdf:first ex:q .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path ( ) .
+ex:oneSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param("iri", EX.p, id="iri"),
+        pytest.param("seq", EX.p / EX.q / EX.r, id="sequence"),
+        pytest.param("nestedSeq", EX.p / (EX.q | EX.r), id="sequence-with-alternative"),
+        pytest.param("inv", ~EX.p, id="inverse"),
+        pytest.param("zeroOrMore", ZERO_OR_MORE_IRI, id="zero-or-more-iri"),
+        pytest.param("oneOrMore", ONE_OR_MORE_IRI, id="one-or-more-iri"),
+        pytest.param("zeroOrOne", ZERO_OR_ONE_IRI, id="zero-or-one-iri"),
+        pytest.param("modInv", (~EX.p) * "+", id="modifier-of-inverse"),
+        pytest.param("alt", EX.p | EX.q, id="alternative"),
+        pytest.param("noRest", EX.p / EX.q, id="list-without-rest"),
+        pytest.param("nilPath", SHACLPathError, id="rdf-nil-path"),
+        pytest.param("emptySeq", SHACLPathError, id="empty-sequence"),
+        pytest.param("oneSeq", SHACLPathError, id="one-item-sequence"),
+        pytest.param("emptyAlt", SHACLPathError, id="empty-alternative"),
+        pytest.param("oneAlt", SHACLPathError, id="one-item-alternative"),
+        pytest.param("unknown", SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literal", TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_object = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_object)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_object)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises(
+    shapes_graph: Graph, bad_input: Union[None, str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("seq", "nilPath", "unknown", "literal"):
+        path_object = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_object)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
