@@ -0,0 +1,93 @@
+"""
+Contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path is malformed or unsupported."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is either an IRI other than ``rdf:nil``, an RDF list
+    of at least two paths (a sequence path), or a blank node with one of the
+    predicates ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of at
+    least two paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The object node of the ``sh:path`` triple.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"A Literal cannot be a SHACL path: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {path_identifier!r}")
+
+    # A plain predicate IRI.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # An RDF list is a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*(parse_shacl_path(shapes_graph, i) for i in items))
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *(parse_shacl_path(shapes_graph, i) for i in alt_items)
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
new file mode 100644
index 0000000..9ec04e1
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,88 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:plain sh:path ex:p .
+ex:sequence sh:path ( ex:p ex:q ex:r ) .
+ex:nested sh:path ( ex:p [ sh:alternativePath ( [ sh:inversePath ex:q ] ex:r ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:openList sh:path _:c1 .
+_:c1 rdf:first ex:p ; rdf:rest _:c2 .
+_:c2 rdf:first ex:q .
+
+ex:nilIri sh:path rdf:nil .
+ex:emptySequence sh:path ( ) .
+ex:oneSequence sh:path ( ex:p ) .
+ex:emptyAlternative sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknownNode sh:path [ ex:other ex:p ] .
+ex:literalPath sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+CASES: List[Tuple[str, Union[URIRef, Path, Type[Exception]]]] = [
+    ("plain", EX.p),
+    ("sequence", EX.p / EX.q / EX.r),
+    ("nested", EX.p / (~EX.q | EX.r)),
+    ("inverse", ~EX.p),
+    ("zeroOrMore", (~EX.p) * "*"),
+    ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+    ("alternative", EX.p | EX.q),
+    ("openList", EX.p / EX.q),
+    ("nilIri", SHACLPathError),
+    ("emptySequence", SHACLPathError),
+    ("oneSequence", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("oneAlternative", SHACLPathError),
+    ("unknownNode", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.mark.parametrize("shape, expected", CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_parse_shacl_path_rejects_non_nodes(
+    shapes_graph: Graph, bad_input: Union[None, str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
