index 0000000..f1face9
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,95 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shacl-path#")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shacl-path#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSequence sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ; rdf:rest [ rdf:first ex:p3 ] ]
+] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:zeroOrMoreInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nil sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ sh:unknownPredicate ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        ("iri", EX.p1),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSequence", EX.p1 / (EX.p2 / EX.p3)),
+        ("openSequence", EX.p1 / EX.p2 / EX.p3),
+        ("alternative", EX.p1 | EX.p2),
+        ("nestedAlternative", EX.p1 | (EX.p2 | EX.p3)),
+        ("inverse", ~EX.p1),
+        ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+        ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+        ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+        ("zeroOrMoreInverse", (~EX.p1) * "*"),
+        ("nil", SHACLPathError),
+        ("oneItemSequence", SHACLPathError),
+        ("emptyAlternative", SHACLPathError),
+        ("oneItemAlternative", SHACLPathError),
+        ("unrecognized", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes)
+    node = shapes.value(EX[shape_name], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes, node) == expected  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_non_node_input_raises(shapes: Graph) -> None:
+    before = set(shapes)
+    plain = "http://example.org/shacl-path#p1"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, plain)  # type: ignore[arg-type]
+    assert set(shapes) == before
