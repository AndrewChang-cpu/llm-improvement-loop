@@ -0,0 +1,99 @@
+"""
+Utilities for SHACL shapes graphs.
+"""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node cannot be parsed as a SHACL path."""
+
+
+# The path parser follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is an IRI (other than ``rdf:nil``), a blank node
+    describing a sequence (an RDF list of at least two paths), an
+    alternative (``sh:alternativePath`` naming an RDF list of at least two
+    paths), an inverse (``sh:inversePath``), or a modifier path
+    (``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``).
+
+    :param shapes_graph: the graph holding the shapes. It is only read,
+        never modified.
+    :param path_identifier: the node that is the value of ``sh:path``.
+        It must be an IRI, a blank node or a Literal.
+    :returns: a ``URIRef`` for a plain predicate, or a ``Path`` for a
+        complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the node is not a valid SHACL path, including
+        when it is not a node at all.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            "Literals are not valid SHACL paths: %s" % (path_identifier,)
+        )
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            "Not a node, so not a SHACL path: %r" % (path_identifier,)
+        )
+
+    # sequence path: an RDF list of paths
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        sequence = list(shapes_graph.items(path_identifier))
+        if len(sequence) < 2:
+            raise SHACLPathError(
+                "A sequence path needs at least two items: %s" % (path_identifier,)
+            )
+        return paths.SequencePath(
+            *(parse_shacl_path(shapes_graph, item) for item in sequence)
+        )
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives_list is not None:
+        alternatives = list(shapes_graph.items(alternatives_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items: %s"
+                % (path_identifier,)
+            )
+        return paths.AlternativePath(
+            *(parse_shacl_path(shapes_graph, item) for item in alternatives)
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %s" % (path_identifier,))
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..74018d6
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:Simple sh:path ex:p .
+ex:Sequence sh:path ( ex:p ex:q ex:r ) .
+ex:SequenceWithAlternative sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:SequenceWithoutRest sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+ex:Inverse sh:path [ sh:inversePath ex:p ] .
+ex:Alternative sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:ZeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:OneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:ZeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:OneOrMoreOfInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:NilPath sh:path () .
+ex:OneItemSequence sh:path ( ex:p ) .
+ex:EmptyAlternative sh:path [ sh:alternativePath () ] .
+ex:OneItemAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:UnrecognizedNode sh:path [ ex:foo ex:bar ] .
+ex:LiteralPath sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+CASES = [
+    pytest.param(EX.Simple, EX.p, id="iri"),
+    pytest.param(EX.Sequence, EX.p / EX.q / EX.r, id="sequence"),
+    pytest.param(
+        EX.SequenceWithAlternative,
+        EX.p / (EX.q | EX.r),
+        id="sequence-with-alternative",
+    ),
+    pytest.param(EX.SequenceWithoutRest, EX.p / EX.q, id="list-without-rest"),
+    pytest.param(EX.Inverse, ~EX.p, id="inverse"),
+    pytest.param(EX.Alternative, EX.p | EX.q, id="alternative"),
+    pytest.param(
+        EX.ZeroOrMore,
+        EX.p * "*",  # type: ignore[operator]
+        id="zero-or-more",
+    ),
+    pytest.param(
+        EX.OneOrMore,
+        EX.p * "+",  # type: ignore[operator]
+        id="one-or-more",
+    ),
+    pytest.param(
+        EX.ZeroOrOne,
+        EX.p * "?",  # type: ignore[operator]
+        id="zero-or-one",
+    ),
+    pytest.param(EX.OneOrMoreOfInverse, ~EX.p * "+", id="modifier-of-inverse"),
+    pytest.param(EX.NilPath, SHACLPathError, id="rdf-nil-as-path"),
+    pytest.param(EX.OneItemSequence, SHACLPathError, id="one-item-sequence"),
+    pytest.param(EX.EmptyAlternative, SHACLPathError, id="empty-alternative"),
+    pytest.param(EX.OneItemAlternative, SHACLPathError, id="one-item-alternative"),
+    pytest.param(EX.UnrecognizedNode, SHACLPathError, id="unrecognized-node"),
+    pytest.param(EX.LiteralPath, TypeError, id="literal"),
+]
+
+
+@pytest.mark.parametrize("shape, expected", CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        return
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("path_identifier", [None, "http://example.org/p"])
+def test_non_node_input_raises(
+    shapes_graph: Graph, path_identifier: Optional[str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_identifier)  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_shapes_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in list(shapes_graph.subjects(SH.path)):
+        path_node = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
