index 0000000..86b7bbf
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,88 @@
+"""Utilities for SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into a predicate or Path.
+
+    A valid SHACL path is either an IRI (a plain predicate), or a blank node
+    or RDF list that is one of: a sequence (an RDF list of at least two
+    paths), an inverse path (``sh:inversePath``), an alternative path (an
+    ``sh:alternativePath`` RDF list of at least two paths), or a modifier path
+    (``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``).
+    ``rdf:nil`` is not a valid path. Nested errors propagate unchanged.
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The node that is the value of ``sh:path``: an IRI,
+        a blank node, or a Literal. Literals raise ``TypeError``.
+    :return: A ``URIRef`` for a plain predicate, or a ``Path`` for a complex
+        path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the node is not a usable SHACL path.
+    :raises ValueError: If an RDF list contains a cyclic ``rdf:rest`` chain.
+    """
+    # Derived from pyshacl's SHACL-to-SPARQL path conversion.
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            f"Not a node, so it cannot be a SHACL path: {path_identifier!r}"
+        )
+    # A plain IRI is a predicate path; rdf:nil is an empty list, not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    # RDF list (rdf:first / rdf:rest) is a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*(parse_shacl_path(shapes_graph, i) for i in items))
+    # sh:inversePath
+    inverse_of = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_of is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_of))
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *(parse_shacl_path(shapes_graph, i) for i in alt_items)
+        )
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..e51afe5
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,98 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shacl#")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/shacl#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nested sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:openList sh:path _:c1 .
+_:c1 rdf:first ex:p ; rdf:rest _:c2 .
+_:c2 rdf:first ex:q .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "bad" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        pytest.param("iri", EX.p, id="iri"),
+        pytest.param("seq", EX.p / EX.q / EX.r, id="sequence"),
+        pytest.param("nested", EX.p / (EX.q | EX.r), id="nested-alternative"),
+        pytest.param("openList", EX.p / EX.q, id="list-without-final-rest"),
+        pytest.param("inv", ~EX.p, id="inverse"),
+        pytest.param("invStar", (~EX.p) * "*", id="zero-or-more-of-inverse"),
+        pytest.param("alt", EX.p | EX.q, id="alternative"),
+        pytest.param("star", EX.p * "*", id="zero-or-more"),  # type: ignore[operator]
+        pytest.param("plus", EX.p * "+", id="one-or-more"),  # type: ignore[operator]
+        pytest.param("opt", EX.p * "?", id="zero-or-one"),  # type: ignore[operator]
+        pytest.param("nilPath", SHACLPathError, id="empty-parens-nil"),
+        pytest.param("oneSeq", SHACLPathError, id="one-item-sequence"),
+        pytest.param("emptyAlt", SHACLPathError, id="empty-alternative"),
+        pytest.param("oneAlt", SHACLPathError, id="one-item-alternative"),
+        pytest.param("unknown", SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literal", TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(EX[shape_name], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(
+    "bad_input",
+    [
+        pytest.param(None, id="none"),
+        pytest.param("http://example.org/shacl#p", id="plain-string"),
+    ],
+)
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: Optional[str]
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
