+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,99 @@
+"""
+Utilities for SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import BNode, Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path node is not a valid SHACL path."""
+
+
+# The recursive path handling below is based on pyshacl's conversion of SHACL
+# paths to SPARQL property paths.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is a URIRef (a plain predicate), a blank node with
+    ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of at least two
+    paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``,
+    or an RDF list of at least two paths, which is a sequence path. Lists and
+    nested paths are parsed recursively. ``rdf:nil`` is never a valid path.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a URIRef for a plain predicate, or a Path for a complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the node is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    if not isinstance(path_identifier, BNode):
+        raise SHACLPathError(
+            f"Not a node that can be a SHACL path: {path_identifier!r}"
+        )
+
+    # RDF list: a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items: "
+                f"{path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths.MulPath(
+            parse_shacl_path(shapes_graph, zero_or_more), paths.ZeroOrMore
+        )
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths.MulPath(
+            parse_shacl_path(shapes_graph, one_or_more), paths.OneOrMore
+        )
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths.MulPath(
+            parse_shacl_path(shapes_graph, zero_or_one), paths.ZeroOrOne
+        )
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
new file mode 100644
index 0000000..eb1db49
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverse_zero_or_more sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:open_list sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:empty_parens sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "ex:p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.iri, EX.p1, id="iri"),
+        pytest.param(EX.sequence, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nested_sequence,
+            EX.p1 / (EX.p2 | EX.p3),
+            id="nested-sequence-with-alternative",
+        ),
+        pytest.param(EX.inverse, ~EX.p1, id="inverse"),
+        pytest.param(
+            EX.zero_or_more,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.one_or_more,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zero_or_one,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.inverse_zero_or_more,
+            ~EX.p1 * "*",
+            id="zero-or-more-of-inverse",
+        ),
+        pytest.param(EX.alternative, EX.p1 | EX.p2, id="alternative"),
+        pytest.param(EX.open_list, EX.p1 / EX.p2, id="list-without-rest"),
+        pytest.param(EX.empty_parens, SHACLPathError, id="rdf-nil-and-empty-sequence"),
+        pytest.param(EX.one_item_sequence, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.empty_alternative, SHACLPathError, id="empty-alternative"),
+        pytest.param(
+            EX.one_item_alternative, SHACLPathError, id="one-item-alternative"
+        ),
+        pytest.param(EX.unrecognized, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triples_before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == triples_before
+
+
+@pytest.mark.parametrize("node", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    node: Union[None, str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
