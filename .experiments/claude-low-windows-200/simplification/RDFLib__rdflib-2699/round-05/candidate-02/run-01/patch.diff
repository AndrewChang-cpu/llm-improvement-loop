+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,97 @@
+"""
+Utilities for SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib import paths as _paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a sh:path value is not a valid SHACL path."""
+
+
+# The path parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a SHACL ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is an IRI (a plain predicate), or a blank node that is
+    one of: an RDF list of two or more paths (a sequence), an ``sh:inversePath``
+    holder, an ``sh:alternativePath`` holder with an RDF list of two or more
+    paths, or a holder of ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``. ``rdf:nil`` is never a valid path.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a URIRef for a plain predicate, otherwise a Path object whose
+        ``n3()`` output is a valid SPARQL property path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the node is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            "Literals are not valid SHACL paths: %r" % (path_identifier,)
+        )
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            "Not a graph node, cannot be a SHACL path: %r" % (path_identifier,)
+        )
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list: sequence path
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "A sequence path needs at least two items: %r" % (path_identifier,)
+            )
+        return _paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return _paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items: %r"
+                % (path_identifier,)
+            )
+        return _paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return _paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return _paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return _paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..7099f50
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_iri sh:path ex:p1 .
+ex:s_seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:s_seq_nested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:s_alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:s_inv sh:path [ sh:inversePath ex:p1 ] .
+ex:s_zero sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:s_one sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:s_optional sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:s_mod_inv sh:path [ sh:zeroOrOnePath [ sh:inversePath ex:p1 ] ] .
+ex:s_inv_mod sh:path [ sh:inversePath [ sh:oneOrMorePath ex:p1 ] ] .
+ex:s_norest sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:s_nil sh:path () .
+ex:s_seq1 sh:path ( ex:p1 ) .
+ex:s_alt_empty sh:path [ sh:alternativePath () ] .
+ex:s_alt1 sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:s_unknown sh:path [ ex:foo ex:bar ] .
+ex:s_lit sh:path "ex:p1" .
+ex:s_nopath a sh:NodeShape .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+VALID_CASES = [
+    ("s_iri", EX.p1),
+    ("s_seq3", EX.p1 / EX.p2 / EX.p3),
+    ("s_seq_nested", EX.p1 / (EX.p2 / EX.p3)),
+    ("s_alt", EX.p1 | EX.p2),
+    ("s_inv", ~EX.p1),
+    ("s_zero", EX.p1 * "*"),  # type: ignore[operator]
+    ("s_one", EX.p1 * "+"),  # type: ignore[operator]
+    ("s_optional", EX.p1 * "?"),  # type: ignore[operator]
+    ("s_mod_inv", (~EX.p1) * "?"),
+    ("s_inv_mod", ~(EX.p1 * "+")),  # type: ignore[operator]
+    ("s_norest", EX.p1 / EX.p2),
+]
+
+INVALID_CASES = [
+    # "()" is rdf:nil; it covers both rdf:nil-as-path and empty sequence.
+    ("s_nil", SHACLPathError),
+    ("s_seq1", SHACLPathError),
+    ("s_alt_empty", SHACLPathError),
+    ("s_alt1", SHACLPathError),
+    ("s_unknown", SHACLPathError),
+    ("s_lit", TypeError),
+]
+
+
+@pytest.mark.parametrize(
+    ("shape_name", "expected"),
+    VALID_CASES + INVALID_CASES,
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape_name], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises(shapes_graph: Graph, bad_input: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_missing_sh_path_raises(shapes_graph: Graph) -> None:
+    path_node = shapes_graph.value(EX.s_nopath, SH.path)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_parser_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape_name, _ in VALID_CASES + INVALID_CASES:
+        path_node = shapes_graph.value(EX[shape_name], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
