index 0000000..06f914a
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from typing import Optional, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+PREFIX_NS = "http://example.org/"
+
+SHAPES_TTL = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:Simple sh:path ex:p1 .
+ex:Sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:NestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:AlternativeInSequence sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:Inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:Alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:ZeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:OneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:ZeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:ModifiedInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:OpenEndedSequence sh:path _:openHead .
+_:openHead rdf:first ex:p1 ; rdf:rest _:openMid .
+_:openMid rdf:first ex:p2 ; rdf:rest _:openTail .
+_:openTail rdf:first ex:p3 .
+ex:NilPath sh:path () .
+ex:OneItemSequence sh:path ( ex:p1 ) .
+ex:EmptyAlternative sh:path [ sh:alternativePath () ] .
+ex:OneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:UnrecognizedBlank sh:path [ ex:unrelated ex:p1 ] .
+ex:LiteralPath sh:path "ex:p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _ex(name: str) -> URIRef:
+    return URIRef(PREFIX_NS + name)
+
+
+P1 = _ex("p1")
+P2 = _ex("p2")
+P3 = _ex("p3")
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("Simple", P1),
+    ("Sequence", P1 / P2 / P3),
+    ("NestedSequence", P1 / (P2 / P3)),
+    ("AlternativeInSequence", P1 / (P2 | P3)),
+    ("Inverse", ~P1),
+    ("Alternative", P1 | P2),
+    ("ZeroOrMore", P1 * "*"),  # type: ignore[operator]
+    ("OneOrMore", P1 * "+"),  # type: ignore[operator]
+    ("ZeroOrOne", P1 * "?"),  # type: ignore[operator]
+    ("ModifiedInverse", ~P1 * "+"),
+    ("OpenEndedSequence", P1 / P2 / P3),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("NilPath", SHACLPathError),
+    ("OneItemSequence", SHACLPathError),
+    ("EmptyAlternative", SHACLPathError),
+    ("OneItemAlternative", SHACLPathError),
+    ("UnrecognizedBlank", SHACLPathError),
+    ("LiteralPath", TypeError),
+]
+
+
+def _path_of(shapes: Graph, name: str) -> Optional[Node]:
+    return shapes.value(_ex(name), SH.path)
+
+
+@pytest.mark.parametrize("name, expected", VALID_CASES)
+def test_valid_shacl_path(
+    shapes: Graph, name: str, expected: Union[URIRef, Path]
+) -> None:
+    result = parse_shacl_path(shapes, _path_of(shapes, name))  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("name, exc_type", INVALID_CASES)
+def test_invalid_shacl_path(
+    shapes: Graph, name: str, exc_type: type[Exception]
+) -> None:
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes, _path_of(shapes, name))  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph, bad_input: Optional[str]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
+
+
+def test_parser_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for name, _ in VALID_CASES + INVALID_CASES:
+        try:
+            parse_shacl_path(shapes, _path_of(shapes, name))  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes) == before
