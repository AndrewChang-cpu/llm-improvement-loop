+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,96 @@
+"""Utilities for SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure is malformed or unrecognized."""
+
+
+# The path grammar and parsing approach follow the SHACL-to-SPARQL path
+# conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is an IRI (a plain predicate), an RDF list of two or
+    more paths (a sequence path), a blank node with ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of two or more paths), or one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``
+    wrapping another path. ``rdf:nil`` is never a valid path.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``, not
+        the shape subject.
+    :return: a ``URIRef`` for a plain predicate, or a ``Path`` for a complex
+        path that can be used with Graph methods.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path is malformed, unrecognized, or is not
+        a node at all.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths: %r" % (path_identifier,))
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError("SHACL path must be a node, got %r" % (path_identifier,))
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of paths.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "Sequence path needs at least two items, got %d: %r"
+                % (len(items), path_identifier)
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "Alternative path needs at least two items, got %d: %r"
+                % (len(items), path_identifier)
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..4798209
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,91 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:sequenceWithAlternative sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverseZeroOrMore sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:emptyParens sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literalPath sh:path "not a path" .
+"""
+
+CASES = [
+    ("iri", EX.p1),
+    ("sequence", EX.p1 / EX.p2 / EX.p3),
+    ("sequenceWithAlternative", EX.p1 / (EX.p2 | EX.p3)),
+    ("inverse", ~EX.p1),
+    ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+    ("inverseZeroOrMore", (~EX.p1) * "*"),
+    ("alternative", EX.p1 | EX.p2),
+    ("openList", EX.p1 / EX.p2),
+    ("emptyParens", SHACLPathError),
+    ("oneItemSequence", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("oneItemAlternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    CASES,
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes)
+    path_node = shapes.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes) == before
+
+
+def test_non_node_input_raises(shapes: Graph) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p1")  # type: ignore[arg-type]
+    assert set(shapes) == before
