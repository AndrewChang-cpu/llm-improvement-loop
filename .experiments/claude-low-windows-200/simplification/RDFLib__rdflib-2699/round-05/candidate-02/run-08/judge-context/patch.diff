index 0000000..409afb8
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openList sh:path _:cell1 .
+_:cell1 rdf:first ex:p1 ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:p2 .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:invStar sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected, error",
+    [
+        ("iri", EX.p1, None),
+        ("seq", EX.p1 / EX.p2 / EX.p3, None),
+        ("nestedSeq", EX.p1 / EX.p2 / EX.p3, None),
+        ("openList", EX.p1 / EX.p2, None),
+        ("alt", EX.p1 | EX.p2, None),
+        ("inv", ~EX.p1, None),
+        ("star", EX.p1 * "*", None),  # type: ignore[operator]
+        ("plus", EX.p1 * "+", None),  # type: ignore[operator]
+        ("opt", EX.p1 * "?", None),  # type: ignore[operator]
+        ("invStar", ~EX.p1 * "*", None),
+        ("nilPath", None, SHACLPathError),
+        ("emptySeq", None, SHACLPathError),
+        ("oneSeq", None, SHACLPathError),
+        ("emptyAlt", None, SHACLPathError),
+        ("oneAlt", None, SHACLPathError),
+        ("unknown", None, SHACLPathError),
+        ("literal", None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Optional[Union[URIRef, Path]],
+    error: Optional[Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if error is None:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    else:
+        with pytest.raises(error):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "bad_input",
+    [None, "http://example.org/p1"],
+)
+def test_parse_shacl_path_rejects_non_nodes(
+    shapes_graph: Graph, bad_input: object
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("nilPath", "unknown", "literal", "seq"):
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
+    assert (EX.nilPath, SH.path, RDF.nil) in shapes_graph
