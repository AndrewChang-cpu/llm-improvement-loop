@@ -0,0 +1,97 @@
+"""Utilities for SHACL shapes graphs."""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node cannot be parsed as a SHACL path."""
+
+
+# The recursive path conversion below follows the SHACL-to-SPARQL path
+# conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse a SHACL path node into an RDFLib predicate or path object.
+
+    A valid SHACL path is an IRI naming a predicate, an RDF list of two or
+    more paths (a sequence path), a blank node with ``sh:inversePath``, a
+    blank node with ``sh:alternativePath`` whose value is an RDF list of two
+    or more paths, or a blank node with ``sh:zeroOrMorePath``,
+    ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath`` whose value is a valid path.
+    ``rdf:nil`` is never a valid path.
+
+    :param shapes_graph: The loaded shapes graph. It is only read, never
+        modified.
+    :param path_identifier: The node that is the object of a ``sh:path``
+        triple. Literals are rejected.
+    :returns: A ``URIRef`` for a plain predicate, or a ``Path`` for a complex
+        path. The ``n3()`` output of the result is a valid SPARQL property
+        path.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the node is not a node, is ``rdf:nil``, is a
+        sequence or alternative with fewer than two items, or is not a
+        recognized path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths: %r" % (path_identifier,))
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError("SHACL path must be a node, got %r" % (path_identifier,))
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first marks an RDF list, which is read as a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "sequence path needs at least two items, got %d: %r"
+                % (len(sequence_items), path_identifier)
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "alternative path needs at least two items, got %d: %r"
+                % (len(alternative_items), path_identifier)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError("unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
