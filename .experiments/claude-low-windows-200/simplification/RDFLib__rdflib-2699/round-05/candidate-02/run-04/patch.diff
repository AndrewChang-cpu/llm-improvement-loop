index 0000000..1565d3f
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,88 @@
+"""Utilities for SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not form a valid SHACL path."""
+
+
+# The recognized path forms follow the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse a SHACL path node into an RDFLib predicate or Path object.
+
+    A valid SHACL path is one of:
+
+    * an IRI, which is a plain predicate;
+    * an RDF list of two or more paths, which is a sequence path;
+    * a blank node with sh:inversePath, sh:alternativePath (an RDF list of
+      two or more paths), sh:zeroOrMorePath, sh:oneOrMorePath, or
+      sh:zeroOrOnePath.
+
+    :param shapes_graph: the graph holding the shapes. It is only read,
+        never modified.
+    :param path_identifier: the object of a sh:path triple.
+    :return: a URIRef for a plain predicate, or a Path object for a complex
+        path.
+    :raises TypeError: if path_identifier is a Literal.
+    :raises SHACLPathError: if path_identifier is not a usable SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            f"SHACL path must be an RDF node, not {path_identifier!r}"
+        )
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    # rdf:first marks an RDF list, i.e. a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path {path_identifier!r} needs at least two items"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path {path_identifier!r} needs at least two items"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+    raise SHACLPathError(f"Unrecognized SHACL path node {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..58e9b89
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,93 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:sequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequenceShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openListShape sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverseModifierShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:emptyListShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:p1 ) .
+ex:nilInSequenceShape sh:path ( ex:p1 () ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognizedShape sh:path [ ex:unrelated ex:p1 ] .
+ex:literalShape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iriShape, EX.p1),
+        (EX.sequenceShape, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSequenceShape, EX.p1 / EX.p2 / EX.p3),
+        (EX.openListShape, EX.p1 / EX.p2),
+        (EX.alternativeShape, EX.p1 | EX.p2),
+        (EX.inverseShape, ~EX.p1),
+        (EX.zeroOrMoreShape, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMoreShape, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOneShape, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.inverseModifierShape, ~EX.p1 * "*"),
+        (EX.emptyListShape, SHACLPathError),
+        (EX.oneItemSequenceShape, SHACLPathError),
+        (EX.nilInSequenceShape, SHACLPathError),
+        (EX.emptyAlternativeShape, SHACLPathError),
+        (EX.oneItemAlternativeShape, SHACLPathError),
+        (EX.unrecognizedShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triples_before = set(shapes)
+    path_node = shapes.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes) == triples_before
+
+
+@pytest.mark.parametrize("node", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, node)  # type: ignore[arg-type]
