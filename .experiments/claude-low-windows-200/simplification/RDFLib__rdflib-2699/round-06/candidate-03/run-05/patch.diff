index 0000000..46f274e
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,101 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:Iri sh:path ex:p .
+ex:Seq3 sh:path ( ex:p ex:q ex:r ) .
+ex:SeqNested sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:SeqAlt sh:path ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ) .
+ex:Inverse sh:path [ sh:inversePath ex:p ] .
+ex:Alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:ZeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:OneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:ZeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:ModOfInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:InverseOfAlt sh:path [ sh:inversePath [ sh:alternativePath ( ex:p ex:q ) ] ] .
+
+ex:NilPath sh:path () .
+ex:EmptySeq sh:path () .
+ex:OneItemSeq sh:path ( ex:p ) .
+ex:EmptyAlt sh:path [ sh:alternativePath () ] .
+ex:OneItemAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:UnknownBNode sh:path [ ex:unknown ex:x ] .
+ex:LiteralPath sh:path 42 .
+ex:NilInSeq sh:path ( ex:p () ) .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+def _parse_shape(graph: Graph, shape: str) -> Union[URIRef, Path]:
+    path_node = graph.value(EX[shape], SH.path)
+    return parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("Iri", EX.p),
+        ("Seq3", EX.p / EX.q / EX.r),
+        ("SeqNested", EX.p / (EX.q / EX.r)),
+        ("SeqAlt", EX.p / (EX.q | EX.r)),
+        ("Inverse", ~EX.p),
+        ("Alt", EX.p | EX.q),
+        ("ZeroOrMore", EX.p * "*"),  # type: ignore[operator]
+        ("OneOrMore", EX.p * "+"),  # type: ignore[operator]
+        ("ZeroOrOne", EX.p * "?"),  # type: ignore[operator]
+        ("ModOfInverse", ~EX.p * "*"),
+        ("InverseOfAlt", ~(EX.p | EX.q)),
+        ("NilPath", SHACLPathError),
+        ("EmptySeq", SHACLPathError),
+        ("OneItemSeq", SHACLPathError),
+        ("EmptyAlt", SHACLPathError),
+        ("OneItemAlt", SHACLPathError),
+        ("UnknownBNode", SHACLPathError),
+        ("LiteralPath", TypeError),
+        ("NilInSeq", SHACLPathError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            _parse_shape(shapes_graph, shape)
+        return
+    assert _parse_shape(shapes_graph, shape) == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises(shapes_graph: Graph, bad_input: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_graph_is_not_modified(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("NilPath", "OneItemSeq", "UnknownBNode"):
+        with pytest.raises(SHACLPathError):
+            _parse_shape(shapes_graph, shape)
+    _parse_shape(shapes_graph, "Seq3")
+    assert set(shapes_graph) == before
