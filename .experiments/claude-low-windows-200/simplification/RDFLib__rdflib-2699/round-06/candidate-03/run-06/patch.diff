@@ -0,0 +1,92 @@
+"""Utilities for working with SHACL shapes graphs."""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure is malformed or unusable."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is an IRI that is not ``rdf:nil``, or a blank node
+    describing a sequence (an RDF list of at least two paths), an inverse,
+    an alternative (an RDF list of at least two paths), or a ``*``, ``+``
+    or ``?`` modifier of another path. Literals are rejected with
+    ``TypeError``; every other malformed input raises
+    :class:`SHACLPathError`.
+
+    The shapes graph is only read, never modified.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: The object of a ``sh:path`` triple.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    """
+    # The raw value is widened to object so that None and plain strings are
+    # rejected at runtime, not treated as wildcards by graph lookups.
+    candidate: object = path_identifier
+    if isinstance(candidate, Literal):
+        raise TypeError(f"SHACL path must not be a literal: {candidate!r}")
+    if not isinstance(candidate, Node):
+        raise SHACLPathError(f"Not a usable SHACL path node: {candidate!r}")
+    node: Node = candidate
+
+    # A plain predicate.
+    if isinstance(node, URIRef):
+        if node == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return node
+
+    # A sequence path, written as an RDF list.
+    if shapes_graph.value(node, RDF.first) is not None:
+        items = list(shapes_graph.items(node))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: {node!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath, whose value is an RDF list.
+    alternatives = shapes_graph.value(node, SH.alternativePath)
+    if alternatives is not None:
+        options = list(shapes_graph.items(alternatives))
+        if len(options) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(options)}: "
+                f"{node!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, o) for o in options])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
