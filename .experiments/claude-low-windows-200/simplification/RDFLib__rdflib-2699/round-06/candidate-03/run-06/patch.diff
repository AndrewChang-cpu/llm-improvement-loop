index 0000000..5f8d6ad
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,103 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:seqNested sh:path ( ex:p [ sh:inversePath ex:q ] ) .
+ex:seqNoRest sh:path _:c1 .
+_:c1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ex:p ;
+    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:c2 .
+_:c2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ex:q .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:altSeq sh:path [ sh:alternativePath ( ( ex:p ex:q ) ex:r ) ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:starInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:nil sh:path () .
+ex:oneSeq sh:path ( ex:p ) .
+ex:nilInSeq sh:path ( ex:p () ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        ("iri", EX.p),
+        ("seq", EX.p / EX.q / EX.r),
+        ("seqNested", EX.p / ~EX.q),
+        ("seqNoRest", EX.p / EX.q),
+        ("inv", ~EX.p),
+        ("alt", EX.p | EX.q),
+        ("altSeq", (EX.p / EX.q) | EX.r),
+        ("star", EX.p * "*"),  # type: ignore[operator]
+        ("plus", EX.p * "+"),  # type: ignore[operator]
+        ("opt", EX.p * "?"),  # type: ignore[operator]
+        ("starInv", ~EX.p * "*"),
+        ("nil", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("nilInSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad", [None, "http://example.org/p"])
+def test_non_node_inputs_are_rejected(
+    shapes_graph: Graph,
+    bad: Union[None, str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad)  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("nil", "nilInSeq", "emptyAlt", "literal", "seq", "starInv"):
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
