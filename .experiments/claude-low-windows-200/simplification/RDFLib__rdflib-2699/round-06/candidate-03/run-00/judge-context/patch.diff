index 0000000..a72d6f3
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,120 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iriShape sh:path ex:p .
+ex:sequenceShape sh:path ( ex:a ex:b ex:c ) .
+ex:nestedSequenceShape sh:path ( ex:a [ sh:inversePath ex:b ] ) .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:alternativeInSequenceShape sh:path ( [ sh:alternativePath ( ex:a ex:b ) ] ex:c ) .
+ex:inverseShape sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverseShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:nilShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:a ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unrecognizedShape sh:path [ ex:other ex:x ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param(EX.iriShape, EX.p, id="iri"),
+        pytest.param(EX.sequenceShape, EX.a / EX.b / EX.c, id="sequence"),
+        pytest.param(
+            EX.nestedSequenceShape, EX.a / ~EX.b, id="sequence-with-inverse"
+        ),
+        pytest.param(EX.alternativeShape, EX.a | EX.b, id="alternative"),
+        pytest.param(
+            EX.alternativeInSequenceShape,
+            (EX.a | EX.b) / EX.c,
+            id="alternative-in-sequence",
+        ),
+        pytest.param(EX.inverseShape, ~EX.p, id="inverse"),
+        pytest.param(
+            EX.zeroOrMoreShape,
+            EX.p * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMoreShape,
+            EX.p * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOneShape,
+            EX.p * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.modifiedInverseShape, (~EX.p) * "*", id="modifier-of-inverse"
+        ),
+        pytest.param(EX.nilShape, SHACLPathError, id="nil-or-empty-sequence"),
+        pytest.param(
+            EX.oneItemSequenceShape, SHACLPathError, id="one-item-sequence"
+        ),
+        pytest.param(
+            EX.emptyAlternativeShape, SHACLPathError, id="empty-alternative"
+        ),
+        pytest.param(
+            EX.oneItemAlternativeShape, SHACLPathError, id="one-item-alternative"
+        ),
+        pytest.param(
+            EX.unrecognizedShape, SHACLPathError, id="unrecognized-node"
+        ),
+        pytest.param(EX.literalShape, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triples_before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == triples_before
+
+
+@pytest.mark.parametrize(
+    "path_identifier",
+    [
+        pytest.param(None, id="none"),
+        pytest.param("http://example.org/p", id="plain-string"),
+    ],
+)
+def test_parse_shacl_path_rejects_non_node(
+    shapes_graph: Graph,
+    path_identifier: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_identifier)  # type: ignore[arg-type]
