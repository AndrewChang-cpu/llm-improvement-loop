index 0000000..29372c0
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:a .
+ex:seq sh:path ( ex:a ex:b ex:c ) .
+ex:seqNested sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:altNested sh:path [ sh:alternativePath ( ex:a [ sh:zeroOrOnePath ex:b ] ) ] .
+ex:inv sh:path [ sh:inversePath ex:a ] .
+ex:zom sh:path [ sh:zeroOrMorePath ex:a ] .
+ex:oom sh:path [ sh:oneOrMorePath ex:a ] .
+ex:zoo sh:path [ sh:zeroOrOnePath ex:a ] .
+ex:zomInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ] .
+ex:seqMixed sh:path ( [ sh:inversePath ex:a ] [ sh:oneOrMorePath ex:b ] ) .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:a ) .
+ex:nilInSeq sh:path ( ex:a () ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "ex" .
+ex:cycle sh:path _:cyc .
+_:cyc rdf:first ex:a ; rdf:rest _:cyc .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("iri", EX.a),
+        ("seq", EX.a / EX.b / EX.c),
+        ("seqNested", EX.a / (EX.b / EX.c)),
+        ("alt", EX.a | EX.b),
+        ("altNested", EX.a | (EX.b * "?")),  # type: ignore[operator]
+        ("inv", ~EX.a),
+        ("zom", EX.a * "*"),  # type: ignore[operator]
+        ("oom", EX.a * "+"),  # type: ignore[operator]
+        ("zoo", EX.a * "?"),  # type: ignore[operator]
+        ("zomInv", (~EX.a) * "*"),
+        ("seqMixed", (~EX.a) / (EX.b * "+")),  # type: ignore[operator]
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path],
+) -> None:
+    node = shapes_graph.value(EX[shape], SH.path)
+    assert parse_shacl_path(shapes_graph, node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(
+    "shape, exc_type",
+    [
+        ("nilPath", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("nilInSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+        ("literal", TypeError),
+        ("cycle", ValueError),
+    ],
+)
+def test_parse_shacl_path_invalid(
+    shapes_graph: Graph,
+    shape: str,
+    exc_type: type[Exception],
+) -> None:
+    node = shapes_graph.value(EX[shape], SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_non_node_inputs(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "http://example.org/a")  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("seq", "alt", "zomInv", "nilPath", "unknown", "cycle"):
+        node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        except (SHACLPathError, ValueError):
+            pass
+    assert set(shapes_graph) == before
