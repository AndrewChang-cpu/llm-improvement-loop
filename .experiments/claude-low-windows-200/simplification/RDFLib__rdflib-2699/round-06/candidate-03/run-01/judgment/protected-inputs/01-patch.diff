index 0000000..c2fdc1b
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:alternative_of_sequence sh:path [ sh:alternativePath ( ( ex:p1 ex:p2 ) ex:p3 ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifier_of_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:rdf_nil sh:path rdf:nil .
+ex:empty_sequence sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:sequence_with_nil_item sh:path ( ex:p1 () ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:nested_error sh:path [ sh:inversePath () ] .
+ex:unrecognized_blank_node sh:path [ ex:unknown ex:p ] .
+ex:literal_path sh:path "ex:p" .
+ex:cyclic_list sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 ; rdf:rest _:c1 .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        ("iri", EX.p),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("nested_sequence", EX.p1 / (EX.p2 / EX.p3)),
+        ("alternative", EX.p1 | EX.p2),
+        ("alternative_of_sequence", (EX.p1 / EX.p2) | EX.p3),
+        ("inverse", ~EX.p),
+        ("zero_or_more", EX.p * "*"),  # type: ignore[operator]
+        ("one_or_more", EX.p * "+"),  # type: ignore[operator]
+        ("zero_or_one", EX.p * "?"),  # type: ignore[operator]
+        ("modifier_of_inverse", (~EX.p) * "*"),
+        ("rdf_nil", SHACLPathError),
+        ("empty_sequence", SHACLPathError),
+        ("one_item_sequence", SHACLPathError),
+        ("sequence_with_nil_item", SHACLPathError),
+        ("empty_alternative", SHACLPathError),
+        ("one_item_alternative", SHACLPathError),
+        ("nested_error", SHACLPathError),
+        ("unrecognized_blank_node", SHACLPathError),
+        ("literal_path", TypeError),
+        ("cyclic_list", ValueError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    node = shapes_graph.value(EX[shape_name], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises(shapes_graph: Graph, bad_input: Optional[str]) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_returns_iri_unchanged(shapes_graph: Graph) -> None:
+    node = shapes_graph.value(EX.iri, SH.path)
+    result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert result is node
+
+
+def test_parse_result_has_sparql_n3(shapes_graph: Graph) -> None:
+    node = shapes_graph.value(EX.sequence, SH.path)
+    result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert result.n3() == (EX.p1 / EX.p2 / EX.p3).n3()
+
+
+def test_parse_result_works_with_graph_methods(shapes_graph: Graph) -> None:
+    data = Graph()
+    data.add((EX.a, EX.p1, EX.b))
+    data.add((EX.b, EX.p2, EX.c))
+    data.add((EX.c, EX.p3, EX.d))
+    node = shapes_graph.value(EX.sequence, SH.path)
+    result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    # Graph.objects is annotated with Node but accepts a Path at runtime.
+    objects = set(data.objects(EX.a, result))  # type: ignore[arg-type]
+    assert objects == {EX.d}
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in list(shapes_graph.subjects(SH.path)):
+        node = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError, ValueError):
+            pass
+    assert set(shapes_graph) == before
