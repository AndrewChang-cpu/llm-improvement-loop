index 0000000..77a1c99
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSeqShape sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:invShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:combinedShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:nilShape sh:path () .
+ex:singleSeqShape sh:path ( ex:p1 ) .
+ex:nilItemSeqShape sh:path ( ex:p1 () ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:singleAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:nilAltShape sh:path [ sh:alternativePath ( ex:p1 () ) ] .
+ex:nilInvShape sh:path [ sh:inversePath () ] .
+ex:unknownShape sh:path [ ex:unrelated ex:p1 ] .
+ex:literalShape sh:path "p1" .
+ex:cyclicShape sh:path _:cycle .
+_:cycle rdf:first ex:p1 ; rdf:rest _:cycle .
+"""
+
+VALID_CASES: list[tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.iriShape, EX.p1),
+    (EX.seqShape, EX.p1 / EX.p2 / EX.p3),
+    (EX.nestedSeqShape, EX.p1 / (EX.p2 / EX.p3)),
+    (EX.openSeqShape, EX.p1 / EX.p2),
+    (EX.altShape, EX.p1 | EX.p2),
+    (EX.invShape, ~EX.p1),
+    (EX.zeroOrMoreShape, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.oneOrMoreShape, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.zeroOrOneShape, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.combinedShape, (~EX.p1) * "*"),
+]
+
+INVALID_CASES: list[tuple[URIRef, Type[Exception]]] = [
+    # () is rdf:nil, which is both an invalid path and an empty sequence.
+    (EX.nilShape, SHACLPathError),
+    (EX.singleSeqShape, SHACLPathError),
+    (EX.nilItemSeqShape, SHACLPathError),
+    (EX.emptyAltShape, SHACLPathError),
+    (EX.singleAltShape, SHACLPathError),
+    (EX.nilAltShape, SHACLPathError),
+    (EX.nilInvShape, SHACLPathError),
+    (EX.unknownShape, SHACLPathError),
+    (EX.literalShape, TypeError),
+    (EX.cyclicShape, ValueError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize("shape, expected", VALID_CASES)
+def test_parse_valid_paths(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("shape, error", INVALID_CASES)
+def test_parse_invalid_paths(
+    shapes_graph: Graph,
+    shape: URIRef,
+    error: Type[Exception],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(error):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_parse_non_node_inputs_raise(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(
+            shapes_graph,
+            "http://example.org/p1",  # type: ignore[arg-type]
+        )
+
+
+def test_parse_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for path_node in list(shapes_graph.objects(None, SH.path)):
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (SHACLPathError, TypeError, ValueError):
+            pass
+    assert set(shapes_graph) == before
+
+
+def test_parsed_sequence_path_works_with_graph_methods(
+    shapes_graph: Graph,
+) -> None:
+    data = Graph()
+    data.add((EX.a, EX.p1, EX.b))
+    data.add((EX.b, EX.p2, EX.c))
+    path_node = shapes_graph.value(EX.openSeqShape, SH.path)
+    path = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(data.objects(EX.a, path)) == {EX.c}
