@@ -0,0 +1,87 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure is malformed or unusable."""
+
+
+# The recursive parsing approach follows pyshacl's SHACL-to-SPARQL path
+# conversion, which this function is based on.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI other than ``rdf:nil``, an RDF list
+    of at least two valid paths (a sequence path), or a blank node using one
+    of ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of at least two
+    valid paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``. Literals raise :exc:`TypeError`; every other
+    malformed or unusable input raises :exc:`SHACLPathError`.
+
+    The shapes graph is only read, never modified.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: The object of a ``sh:path`` triple, as a
+        :class:`~rdflib.term.Node`.
+    :returns: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"SHACL path must not be a literal: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"SHACL path is not a node: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        # RDF list: a sequence path.
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        # sh:inversePath
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse_value))
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        # sh:alternativePath
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"alternative path needs at least two items: {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        # sh:zeroOrMorePath
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        # sh:oneOrMorePath
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        # sh:zeroOrOnePath
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..4e744fa
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,92 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri_shape sh:path ex:p1 .
+ex:empty_sequence_shape sh:path () .
+ex:one_item_sequence_shape sh:path ( ex:p1 ) .
+ex:sequence_shape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence_shape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:sequence_with_alternative_shape sh:path (
+    ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+) .
+ex:alternative_shape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:empty_alternative_shape sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative_shape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:inverse_shape sh:path [ sh:inversePath ex:p1 ] .
+ex:zero_or_more_shape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more_shape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one_shape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverse_zero_or_more_shape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:unrecognized_shape sh:path [ ex:unexpected ex:p1 ] .
+ex:literal_shape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("iri_shape", EX.p1),
+        # rdf:nil is both the empty list and the invalid path it denotes.
+        ("empty_sequence_shape", SHACLPathError),
+        ("one_item_sequence_shape", SHACLPathError),
+        ("sequence_shape", EX.p1 / EX.p2 / EX.p3),
+        ("nested_sequence_shape", EX.p1 / (EX.p2 / EX.p3)),
+        ("sequence_with_alternative_shape", EX.p1 / (EX.p2 | EX.p3)),
+        ("alternative_shape", EX.p1 | EX.p2),
+        ("empty_alternative_shape", SHACLPathError),
+        ("one_item_alternative_shape", SHACLPathError),
+        ("inverse_shape", ~EX.p1),
+        ("zero_or_more_shape", EX.p1 * "*"),  # type: ignore[operator]
+        ("one_or_more_shape", EX.p1 * "+"),  # type: ignore[operator]
+        ("zero_or_one_shape", EX.p1 * "?"),  # type: ignore[operator]
+        ("inverse_zero_or_more_shape", (~EX.p1) * "*"),
+        ("unrecognized_shape", SHACLPathError),
+        ("literal_shape", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triples_before = set(shapes_graph)
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == triples_before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises(
+    shapes_graph: Graph,
+    bad_input: Union[None, str],
+) -> None:
+    triples_before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == triples_before
