index 0000000..0dd3648
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,91 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:sequenceShape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequenceShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:inverseShape sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifiedInverseShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sequenceWithInverseShape sh:path ( [ sh:inversePath ex:p1 ] ex:p2 ) .
+ex:emptyListShape sh:path () .
+ex:oneItemSequenceShape sh:path ( ex:p1 ) .
+ex:nilItemShape sh:path ( ex:p1 () ) .
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognizedShape sh:path [ ex:unrelated ex:value ] .
+ex:literalShape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iriShape, EX.p1),
+        (EX.sequenceShape, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSequenceShape, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.alternativeShape, EX.p1 | EX.p2),
+        (EX.inverseShape, ~EX.p1),
+        (EX.zeroOrMoreShape, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMoreShape, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOneShape, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modifiedInverseShape, (~EX.p1) * "*"),
+        (EX.sequenceWithInverseShape, (~EX.p1) / EX.p2),
+        (EX.emptyListShape, SHACLPathError),
+        (EX.oneItemSequenceShape, SHACLPathError),
+        (EX.nilItemShape, SHACLPathError),
+        (EX.emptyAlternativeShape, SHACLPathError),
+        (EX.oneItemAlternativeShape, SHACLPathError),
+        (EX.unrecognizedShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+def test_rejects_non_node_inputs(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(
+            shapes_graph, "http://example.org/p1"  # type: ignore[arg-type]
+        )
+    assert set(shapes_graph) == before
