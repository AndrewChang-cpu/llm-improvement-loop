index 0000000..e2f5003
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_seq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:seq_with_alt sh:path ( ex:p1 [ sh:alternativePath ( ex:a ex:b ) ] ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modified_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:nil_path sh:path () .
+ex:seq_with_nil_item sh:path ( ex:p1 () ) .
+ex:one_item_seq sh:path ( ex:p1 ) .
+ex:empty_alt sh:path [ sh:alternativePath () ] .
+ex:one_item_alt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal_path sh:path "http://example.org/p" .
+"""
+
+CYCLIC_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:cyclic sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 ; rdf:rest _:l1 .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nested_seq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.alt, EX.a | EX.b),
+        (EX.seq_with_alt, EX.p1 / (EX.a | EX.b)),
+        (EX.inverse, ~EX.p),
+        (EX.zero_or_more, EX.p * "*"),  # type: ignore[operator]
+        (EX.one_or_more, EX.p * "+"),  # type: ignore[operator]
+        (EX.zero_or_one, EX.p * "?"),  # type: ignore[operator]
+        (EX.modified_inverse, ~EX.p * "*"),
+        (EX.nil_path, SHACLPathError),
+        (EX.seq_with_nil_item, SHACLPathError),
+        (EX.one_item_seq, SHACLPathError),
+        (EX.empty_alt, SHACLPathError),
+        (EX.one_item_alt, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal_path, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        actual = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert actual == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p"])
+def test_non_node_input_raises(shapes: Graph, bad_input: Union[None, str]) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad_input)  # type: ignore[arg-type]
+
+
+def test_cyclic_list_raises_value_error() -> None:
+    graph = Graph().parse(data=CYCLIC_TTL, format="turtle")
+    path_node = graph.value(EX.cyclic, SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in shapes.subjects(SH.path, None):
+        path_node = shapes.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes) == before
