@@ -0,0 +1,96 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """
+    Raised when an object of a ``sh:path`` triple is not a valid SHACL path.
+    """
+
+
+# The SHACL-to-path conversion below is based on the approach used by pyshacl's
+# SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI (a plain predicate), a non-empty RDF
+    list of valid paths (a sequence path), a blank node with ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of at least two valid paths), or one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath`` wrapping
+    a valid path. The parser only reads from the graph and never modifies it.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: The node that is the object of a ``sh:path`` triple.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or is not a recognised
+        SHACL path, including non-node inputs.
+    :raises ValueError: If an RDF list contains a cyclic ``rdf:rest`` chain.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literal is not a valid SHACL path: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        message = f"Not a node: {path_identifier!r}"
+        raise SHACLPathError(message)  # type: ignore[unreachable]
+
+    # A predicate IRI; rdf:nil is the empty list and is never a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # An RDF list of paths forming a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath, whose value is an RDF list of paths.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognised SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..2a694c7
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,114 @@
+from __future__ import annotations
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shacl/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/shacl/> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modified_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sequence_with_alternative sh:path ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ) .
+
+ex:nil_path sh:path () .
+ex:one_item_sequence sh:path ( ex:p1 ) .
+ex:empty_alternative sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal_path sh:path "p1" .
+"""
+
+VALID_CASES: list[tuple[str, URIRef | Path]] = [
+    ("iri", EX.p1),
+    ("sequence", EX.p1 / EX.p2 / EX.p3),
+    ("nested_sequence", EX.p1 / (EX.p2 / EX.p3)),
+    ("inverse", ~EX.p1),
+    ("alternative", EX.p1 | EX.p2),
+    ("zero_or_more", EX.p1 * "*"),  # type: ignore[operator]
+    ("one_or_more", EX.p1 * "+"),  # type: ignore[operator]
+    ("zero_or_one", EX.p1 * "?"),  # type: ignore[operator]
+    ("modified_inverse", (~EX.p1) * "*"),
+    ("sequence_with_alternative", EX.p1 / (EX.p2 | EX.p3)),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("nil_path", SHACLPathError),
+    ("one_item_sequence", SHACLPathError),
+    ("empty_alternative", SHACLPathError),
+    ("one_item_alternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal_path", TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES)
+def test_parse_shacl_path_valid(
+    shapes: Graph, shape: str, expected: URIRef | Path
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize(("shape", "exc_type"), INVALID_CASES)
+def test_parse_shacl_path_invalid(
+    shapes: Graph, shape: str, exc_type: type[Exception]
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    before = set(shapes)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/shacl/p1"])
+def test_parse_shacl_path_non_node(shapes: Graph, value: str | None) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, value)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_parse_shacl_path_cyclic_list_raises_value_error() -> None:
+    graph = Graph()
+    graph.parse(
+        data="""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+        @prefix ex: <http://example.org/shacl/> .
+
+        ex:cyclic sh:path _:l .
+        _:l rdf:first ex:p1 ; rdf:rest _:l .
+        """,
+        format="turtle",
+    )
+    path_node = graph.value(EX.cyclic, SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+
+
+def test_literal_path_is_type_error_not_shacl_error() -> None:
+    graph = Graph()
+    with pytest.raises(TypeError) as info:
+        parse_shacl_path(graph, Literal("p1"))
+    assert not isinstance(info.value, SHACLPathError)
