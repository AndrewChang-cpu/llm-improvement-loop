@@ -0,0 +1,90 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The SHACL path parser below is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of the following, applied recursively:
+
+    * an IRI other than ``rdf:nil``, which is returned unchanged;
+    * an RDF list of two or more paths, a sequence path;
+    * a node with ``sh:inversePath``, an inverse path;
+    * a node with ``sh:alternativePath`` whose value is an RDF list of two
+      or more paths, an alternative path;
+    * a node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath``, a modifier path.
+
+    :param shapes_graph: the graph holding the shapes. It is only read,
+        never modified.
+    :param path_identifier: the object node of a ``sh:path`` triple.
+    :return: a :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path. Its ``n3()`` output
+        is a valid SPARQL property path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the node is not a valid SHACL path, including
+        ``rdf:nil`` and non-node input.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"SHACL path must not be a literal: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"SHACL path is not a graph node: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+    # rdf:first marks an RDF list, i.e. a sequence path.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path needs at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse_value))
+    # sh:alternativePath
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternatives = list(shapes_graph.items(alternative_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"alternative path needs at least two items: {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+    raise SHACLPathError(f"unrecognized SHACL path: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
