index 0000000..32e35f4
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,128 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSequence sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:oneOrMoreInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:nilPath sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "http://example.org/p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("iri", EX.p1),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSequence", EX.p1 / (EX.p2 / EX.p3)),
+        ("openSequence", EX.p1 / EX.p2),
+        ("alternative", EX.p1 | EX.p2),
+        ("inverse", ~EX.p1),
+        ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+        ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+        ("oneOrMoreInverse", (~EX.p1) * "+"),
+        ("nilPath", SHACLPathError),
+        ("oneItemSequence", SHACLPathError),
+        ("emptyAlternative", SHACLPathError),
+        ("oneItemAlternative", SHACLPathError),
+        ("unrecognized", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        return
+    assert parse_shacl_path(shapes_graph, node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/p1"])
+def test_non_node_input_raises(shapes_graph: Graph, value: Optional[str]) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, value)  # type: ignore[arg-type]
+
+
+def test_shapes_graph_is_not_modified(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    shapes = [
+        "iri",
+        "sequence",
+        "nestedSequence",
+        "openSequence",
+        "alternative",
+        "inverse",
+        "zeroOrMore",
+        "zeroOrOne",
+        "oneOrMoreInverse",
+        "nilPath",
+        "oneItemSequence",
+        "emptyAlternative",
+        "oneItemAlternative",
+        "unrecognized",
+        "literal",
+    ]
+    for shape in shapes:
+        node = shapes_graph.value(EX[shape], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
+
+
+def test_n3_is_usable_as_sparql_property_path(shapes_graph: Graph) -> None:
+    data = Graph()
+    data.parse(
+        data="""
+        @prefix ex: <http://example.org/> .
+        ex:a ex:p1 ex:b .
+        ex:b ex:p2 ex:c .
+        ex:c ex:p3 ex:d .
+        """,
+        format="turtle",
+    )
+    path = parse_shacl_path(
+        shapes_graph,
+        shapes_graph.value(EX["sequence"], SH.path),  # type: ignore[arg-type]
+    )
+    query = f"SELECT ?o WHERE {{ <{EX.a}> {path.n3()} ?o }}"
+    results = {row[0] for row in data.query(query)}
+    assert results == {EX.d}
