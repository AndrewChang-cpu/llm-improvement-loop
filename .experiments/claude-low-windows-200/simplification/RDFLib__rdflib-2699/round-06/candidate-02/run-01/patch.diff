@@ -0,0 +1,90 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a shapes graph node cannot be parsed as a SHACL path."""
+
+
+# The conversion of SHACL paths into SPARQL property paths is based on
+# pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of the following. An IRI names a plain
+    predicate. A blank node or RDF list describes a complex path: a sequence
+    (an RDF list of at least two paths), an inverse (``sh:inversePath``), an
+    alternative (``sh:alternativePath``, an RDF list of at least two paths),
+    or a modifier (``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``). ``rdf:nil`` is never a valid path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The object node of a ``sh:path`` triple.
+    :return: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the node is not a usable SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"A SHACL path cannot be a literal: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):  # type: ignore[unreachable]
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first: the node is an RDF list describing a sequence path.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*(parse_shacl_path(shapes_graph, item) for item in items))
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: the value is an RDF list of alternative paths.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *(parse_shacl_path(shapes_graph, item) for item in alternative_items)
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
new file mode 100644
index 0000000..5c769e2
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,143 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri_shape sh:path ex:p1 .
+
+ex:sequence_shape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nested_sequence_shape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:tail_sequence_shape sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:alternative_shape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+
+ex:inverse_shape sh:path [ sh:inversePath ex:p1 ] .
+
+ex:inverse_sequence_shape sh:path [ sh:inversePath ( ex:p1 ex:p2 ) ] .
+
+ex:zero_or_more_shape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:one_or_more_shape sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zero_or_one_shape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifier_of_inverse_shape sh:path [
+    sh:zeroOrMorePath [ sh:inversePath ex:p1 ]
+] .
+
+ex:nil_shape sh:path () .
+
+ex:one_item_sequence_shape sh:path ( ex:p1 ) .
+
+ex:empty_alternative_shape sh:path [ sh:alternativePath () ] .
+
+ex:one_item_alternative_shape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unrecognized_shape sh:path [ ex:unrelated ex:p1 ] .
+
+ex:literal_shape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param(EX.iri_shape, EX.p1, id="iri"),
+        pytest.param(EX.sequence_shape, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nested_sequence_shape, EX.p1 / (EX.p2 / EX.p3), id="nested-sequence"
+        ),
+        pytest.param(EX.tail_sequence_shape, EX.p1 / EX.p2, id="list-without-rest"),
+        pytest.param(EX.alternative_shape, EX.p1 | EX.p2, id="alternative"),
+        pytest.param(EX.inverse_shape, ~EX.p1, id="inverse"),
+        pytest.param(
+            EX.inverse_sequence_shape, ~(EX.p1 / EX.p2), id="inverse-sequence"
+        ),
+        pytest.param(
+            EX.zero_or_more_shape,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.one_or_more_shape,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zero_or_one_shape,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(
+            EX.modifier_of_inverse_shape, (~EX.p1) * "*", id="modifier-of-inverse"
+        ),
+        pytest.param(EX.nil_shape, SHACLPathError, id="nil-or-empty-sequence"),
+        pytest.param(
+            EX.one_item_sequence_shape, SHACLPathError, id="one-item-sequence"
+        ),
+        pytest.param(
+            EX.empty_alternative_shape, SHACLPathError, id="empty-alternative"
+        ),
+        pytest.param(
+            EX.one_item_alternative_shape, SHACLPathError, id="one-item-alternative"
+        ),
+        pytest.param(
+            EX.unrecognized_shape, SHACLPathError, id="unrecognized-blank-node"
+        ),
+        pytest.param(EX.literal_shape, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(
+    "path_identifier",
+    [
+        pytest.param(None, id="none"),
+        pytest.param("http://example.org/p1", id="plain-string"),
+    ],
+)
+def test_parse_shacl_path_rejects_non_nodes(
+    shapes_graph: Graph,
+    path_identifier: Optional[str],
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_identifier)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
