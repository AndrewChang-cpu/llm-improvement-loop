index 0000000..d2de999
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = "http://example.org/"
+P1 = URIRef(EX + "p1")
+P2 = URIRef(EX + "p2")
+P3 = URIRef(EX + "p3")
+
+DATA = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path ( ) .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:nilInSeq sh:path ( ex:p1 ( ) ) .
+ex:emptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "p1" .
+ex:cyclic sh:path [ rdf:first ex:p1 ; rdf:rest _:c2 ] .
+_:c2 rdf:first ex:p2 ; rdf:rest _:c1 .
+_:c1 rdf:first ex:p3 ; rdf:rest _:c2 .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=DATA, format="turtle")
+
+
+def _shape(name: str) -> URIRef:
+    return URIRef(EX + name)
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", P1),
+    ("seq", P1 / P2 / P3),
+    ("nested", P1 / (P2 / P3)),
+    ("alt", P1 | P2),
+    ("inv", ~P1),
+    ("zeroOrMore", P1 * "*"),  # type: ignore[operator]
+    ("oneOrMore", P1 * "+"),  # type: ignore[operator]
+    ("zeroOrOne", P1 * "?"),  # type: ignore[operator]
+    ("modInv", (~P1) * "*"),
+    ("openList", P1 / P2),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("emptySeq", SHACLPathError),
+    ("oneSeq", SHACLPathError),
+    ("nilInSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneAlt", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize("name, expected", VALID_CASES)
+def test_parse_valid_path(
+    shapes_graph: Graph, name: str, expected: Union[URIRef, Path]
+) -> None:
+    node = shapes_graph.value(_shape(name), SH.path)
+    result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("name, exc_type", INVALID_CASES)
+def test_parse_invalid_path(
+    shapes_graph: Graph, name: str, exc_type: type[Exception]
+) -> None:
+    node = shapes_graph.value(_shape(name), SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("bad_input", [None, "p1"])
+def test_parse_non_node_input(shapes_graph: Graph, bad_input: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_cyclic_rdf_rest_raises_value_error(shapes_graph: Graph) -> None:
+    node = shapes_graph.value(_shape("cyclic"), SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for name, _ in VALID_CASES + INVALID_CASES:
+        node = shapes_graph.value(_shape(name), SH.path)
+        try:
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError, ValueError):
+            pass
+    assert set(shapes_graph) == before
