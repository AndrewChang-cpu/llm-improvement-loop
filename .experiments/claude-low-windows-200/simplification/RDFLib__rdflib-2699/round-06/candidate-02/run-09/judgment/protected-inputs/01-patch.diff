index 0000000..5fab118
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,110 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import RDF, BNode, Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:s_iri sh:path ex:p .
+ex:s_seq sh:path ( ex:a ex:b ex:c ) .
+ex:s_nested_seq sh:path ( ( ex:a ex:b ) ex:c ) .
+ex:s_alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:s_inv sh:path [ sh:inversePath ex:a ] .
+ex:s_zero sh:path [ sh:zeroOrMorePath ex:a ] .
+ex:s_one sh:path [ sh:oneOrMorePath ex:a ] .
+ex:s_opt sh:path [ sh:zeroOrOnePath ex:a ] .
+ex:s_nested_mod sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ] .
+ex:s_no_rest sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+
+ex:s_nil sh:path () .
+ex:s_seq_one sh:path ( ex:a ) .
+ex:s_alt_empty sh:path [ sh:alternativePath () ] .
+ex:s_alt_one sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:s_unknown sh:path [ ex:notAPath ex:a ] .
+ex:s_literal sh:path "a literal" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("s_iri", EX.p),
+        ("s_seq", EX.a / EX.b / EX.c),
+        ("s_nested_seq", (EX.a / EX.b) / EX.c),
+        ("s_alt", EX.a | EX.b),
+        ("s_inv", ~EX.a),
+        ("s_zero", EX.a * "*"),  # type: ignore[operator]
+        ("s_one", EX.a * "+"),  # type: ignore[operator]
+        ("s_opt", EX.a * "?"),  # type: ignore[operator]
+        ("s_nested_mod", (~EX.a) * "*"),
+        ("s_no_rest", EX.a / EX.b),
+    ],
+)
+def test_parse_valid(shapes: Graph, shape: str, expected: Union[URIRef, Path]) -> None:
+    before = set(shapes)
+    result = parse_shacl_path(
+        shapes, shapes.value(EX[shape], SH.path)  # type: ignore[arg-type]
+    )
+    assert result == expected
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize(
+    "shape, exc",
+    [
+        ("s_nil", SHACLPathError),
+        ("s_seq_one", SHACLPathError),
+        ("s_alt_empty", SHACLPathError),
+        ("s_alt_one", SHACLPathError),
+        ("s_unknown", SHACLPathError),
+        ("s_literal", TypeError),
+    ],
+)
+def test_parse_invalid(shapes: Graph, shape: str, exc: Type[Exception]) -> None:
+    before = set(shapes)
+    with pytest.raises(exc):
+        parse_shacl_path(
+            shapes, shapes.value(EX[shape], SH.path)  # type: ignore[arg-type]
+        )
+    assert set(shapes) == before
+
+
+def test_non_node_inputs_raise(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.org/p")  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(
+            shapes, shapes.value(EX.missing, SH.path)  # type: ignore[arg-type]
+        )
+
+
+def test_cyclic_list_raises_value_error() -> None:
+    g = Graph()
+    head = BNode()
+    second = BNode()
+    g.add((head, RDF.first, EX.a))
+    g.add((head, RDF.rest, second))
+    g.add((second, RDF.first, EX.b))
+    g.add((second, RDF.rest, head))
+    with pytest.raises(ValueError):
+        parse_shacl_path(g, head)
