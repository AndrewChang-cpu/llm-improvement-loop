@@ -0,0 +1,91 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not describe a valid SHACL path."""
+
+
+# The parsing rules follow pyshacl's conversion of SHACL paths to SPARQL paths.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a plain predicate;
+    * an RDF list of at least two paths, which is a sequence path;
+    * a node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of
+      at least two paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath``, whose value is parsed recursively.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The object node of a ``sh:path`` triple.
+    :returns: A :class:`~rdflib.term.URIRef` for a plain predicate, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the node does not describe a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"A SHACL path cannot be a literal: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Re-bind through an object-typed name so that non-node inputs such as None
+    # or plain strings are rejected before any graph lookup, where None would
+    # otherwise act as a wildcard.
+    node: object = path_identifier
+    if not isinstance(node, Node):
+        raise SHACLPathError(f"Not a node, so not a SHACL path: {node!r}")
+
+    # rdf:first marks an RDF list, which is a sequence path.
+    if shapes_graph.value(node, RDF.first) is not None:
+        items = list(shapes_graph.items(node))
+        if len(items) < 2:
+            raise SHACLPathError(f"A sequence path needs at least two items: {node}")
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(node, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {node}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(node, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(node, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(node, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {node!r}")
diff --git a/test/test_extras/test_extras_shacl.py b/test/test_extras/test_extras_shacl.py
