index 0000000..178f181
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,129 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p .
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p ) .
+ex:sequence sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSequence sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:openSequence sh:path _:open1 .
+_:open1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ex:p ;
+    <http://www.w3.org/1999/02/22-rdf-syntax-ns#rest> _:open2 .
+_:open2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#first> ex:q .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:inverseOfModifier sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+"""
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("iri", EX.p),
+    ("sequence", EX.p / EX.q / EX.r),
+    ("nestedSequence", EX.p / (EX.q / EX.r)),
+    ("openSequence", EX.p / EX.q),
+    ("alternative", EX.p | EX.q),
+    ("inverse", ~EX.p),
+    ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+    ("inverseOfModifier", ~EX.p * "*"),
+]
+
+INVALID_CASES: list[tuple[str, Type[Exception]]] = [
+    ("emptyList", SHACLPathError),
+    ("oneItemSequence", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("oneItemAlternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+@pytest.mark.parametrize("shape, expected", VALID_CASES)
+def test_parse_valid_path(
+    shapes: Graph,
+    shape: str,
+    expected: Union[URIRef, Path],
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("shape, expected_error", INVALID_CASES)
+def test_parse_invalid_path(
+    shapes: Graph,
+    shape: str,
+    expected_error: Type[Exception],
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    with pytest.raises(expected_error):
+        parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+
+
+def test_parse_rdf_nil_is_not_a_path(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(
+            shapes,
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"),
+        )
+
+
+@pytest.mark.parametrize("not_a_node", [None, "http://example.org/p"])
+def test_parse_non_node_raises(shapes: Graph, not_a_node: str | None) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, not_a_node)  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape, _ in VALID_CASES:
+        path_node = shapes.value(EX[shape], SH.path)
+        parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    for shape, error in INVALID_CASES:
+        path_node = shapes.value(EX[shape], SH.path)
+        with pytest.raises(error):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+def test_parse_cyclic_list_raises_value_error() -> None:
+    cyclic = Graph().parse(
+        data="""
+        @prefix ex: <http://example.org/> .
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+        ex:shape sh:path _:a .
+        _:a rdf:first ex:p ; rdf:rest _:b .
+        _:b rdf:first ex:q ; rdf:rest _:a .
+        """,
+        format="turtle",
+    )
+    path_node = cyclic.value(EX.shape, SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(cyclic, path_node)  # type: ignore[arg-type]
