+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,96 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iriShape sh:path ex:p .
+ex:seqShape sh:path ( ex:a ex:b ex:c ) .
+ex:nestedSeqShape sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:openSeqShape sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:invShape sh:path [ sh:inversePath ex:p ] .
+ex:starShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plusShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:optShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:invStarShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:nilShape sh:path rdf:nil .
+ex:emptySeqShape sh:path () .
+ex:oneSeqShape sh:path ( ex:a ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneAltShape sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknownShape sh:path [ ex:other ex:x ] .
+ex:literalShape sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.bind("ex", EX)
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("iriShape", EX.p),
+        ("seqShape", EX.a / EX.b / EX.c),
+        ("nestedSeqShape", EX.a / (EX.b / EX.c)),
+        ("openSeqShape", EX.a / EX.b),
+        ("altShape", EX.a | EX.b),
+        ("invShape", ~EX.p),
+        ("starShape", EX.p * "*"),  # type: ignore[operator]
+        ("plusShape", EX.p * "+"),  # type: ignore[operator]
+        ("optShape", EX.p * "?"),  # type: ignore[operator]
+        ("invStarShape", (~EX.p) * "*"),
+        ("nilShape", SHACLPathError),
+        ("emptySeqShape", SHACLPathError),
+        ("oneSeqShape", SHACLPathError),
+        ("emptyAltShape", SHACLPathError),
+        ("oneAltShape", SHACLPathError),
+        ("unknownShape", SHACLPathError),
+        ("literalShape", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("value", [None, "http://example.org/p"])
+def test_parse_non_node_raises(shapes_graph: Graph, value: Optional[str]) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, value)  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for path_node in list(shapes_graph.objects(predicate=SH.path)):
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
