index 0000000..dafb578
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,112 @@
+from __future__ import annotations
+
+from typing import Iterator, Optional, Type, Union
+
+import pytest
+
+from rdflib import RDF, BNode, Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+P = URIRef("http://example.com/p")
+Q = URIRef("http://example.com/q")
+R = URIRef("http://example.com/r")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.com/> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nested_seq sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:zero_or_more sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:one_or_more sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zero_or_one sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:zom_of_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:mixed sh:path ( [ sh:inversePath ex:p ] [ sh:zeroOrMorePath ex:q ] ) .
+
+ex:nil_path sh:path () .
+ex:one_item_seq sh:path ( ex:p ) .
+ex:empty_alt sh:path [ sh:alternativePath () ] .
+ex:one_item_alt sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown_bnode sh:path [ ex:foo ex:bar ] .
+ex:literal_path sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Iterator[Graph]:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+
+    # A list whose final cell has rdf:first but no rdf:rest.
+    cell_1 = BNode()
+    cell_2 = BNode()
+    g.add((cell_1, RDF.first, P))
+    g.add((cell_1, RDF.rest, cell_2))
+    g.add((cell_2, RDF.first, Q))
+    g.add((EX.open_seq, SH.path, cell_1))
+    yield g
+
+
+@pytest.mark.parametrize(
+    "name, expected",
+    [
+        ("iri", P),
+        ("seq", P / Q / R),
+        ("nested_seq", P / (Q / R)),
+        ("alt", P | Q),
+        ("inv", ~P),
+        ("zero_or_more", P * "*"),  # type: ignore[operator]
+        ("one_or_more", P * "+"),  # type: ignore[operator]
+        ("zero_or_one", P * "?"),  # type: ignore[operator]
+        ("zom_of_inv", (~P) * "*"),
+        ("mixed", (~P) / (Q * "*")),  # type: ignore[operator]
+        ("open_seq", P / Q),
+        ("nil_path", SHACLPathError),
+        ("one_item_seq", SHACLPathError),
+        ("empty_alt", SHACLPathError),
+        ("one_item_alt", SHACLPathError),
+        ("unknown_bnode", SHACLPathError),
+        ("literal_path", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    name: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(EX[name], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+        assert type(result) is type(expected)
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("value", [None, "http://example.com/p"])
+def test_non_node_raises(shapes_graph: Graph, value: Optional[str]) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, value)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
+
+
+def test_cyclic_rest_raises_value_error() -> None:
+    g = Graph()
+    cell_1 = BNode()
+    cell_2 = BNode()
+    g.add((cell_1, RDF.first, P))
+    g.add((cell_1, RDF.rest, cell_2))
+    g.add((cell_2, RDF.first, Q))
+    g.add((cell_2, RDF.rest, cell_1))
+    with pytest.raises(ValueError):
+        parse_shacl_path(g, cell_1)
