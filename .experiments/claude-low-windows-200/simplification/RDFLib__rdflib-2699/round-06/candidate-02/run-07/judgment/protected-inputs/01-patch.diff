index 0000000..ad4e803
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,122 @@
+from __future__ import annotations
+
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:a ex:b ex:c ) .
+ex:nested sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:openList sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ) ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:invZeroOrMore sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:mixed sh:path ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] [ sh:inversePath ex:d ] ) .
+
+ex:emptySequence sh:path () .
+ex:nilItem sh:path ( ex:a () ) .
+ex:oneItemSequence sh:path ( ex:a ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unrecognized sh:path [ ex:other ex:a ] .
+ex:literal sh:path "not a path" .
+"""
+
+VALID_CASES: List[Tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.iri, EX.p),
+    (EX.seq, EX.a / EX.b / EX.c),
+    (EX.nested, EX.a / (EX.b / EX.c)),
+    (EX.openList, EX.a / EX.b),
+    (EX.alt, EX.a | EX.b),
+    (EX.inv, ~EX.p),
+    (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+    (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+    (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+    (EX.invZeroOrMore, ~EX.p * "*"),
+    (EX.mixed, EX.a / (EX.b | EX.c) / ~EX.d),
+]
+
+INVALID_CASES: List[Tuple[URIRef, Type[Exception]]] = [
+    (EX.emptySequence, SHACLPathError),
+    (EX.nilItem, SHACLPathError),
+    (EX.oneItemSequence, SHACLPathError),
+    (EX.emptyAlternative, SHACLPathError),
+    (EX.oneItemAlternative, SHACLPathError),
+    (EX.unrecognized, SHACLPathError),
+    (EX.literal, TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize("shape, expected", VALID_CASES)
+def test_parse_valid_path(
+    shapes_graph: Graph, shape: URIRef, expected: Union[URIRef, Path]
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("shape, exception_type", INVALID_CASES)
+def test_parse_invalid_path(
+    shapes_graph: Graph, shape: URIRef, exception_type: Type[Exception]
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    with pytest.raises(exception_type):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+
+
+def test_non_node_input_raises(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    plain_string = "http://example.org/p"
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, plain_string)  # type: ignore[arg-type]
+
+
+def test_cyclic_list_raises_value_error() -> None:
+    graph = Graph().parse(
+        data="""
+        @prefix ex: <http://example.org/> .
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+        ex:cyclic sh:path _:l .
+        _:l rdf:first ex:a ; rdf:rest _:l .
+        """,
+        format="turtle",
+    )
+    path_node = graph.value(EX.cyclic, SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+
+
+def test_parsing_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape, _ in VALID_CASES:
+        path_node = shapes_graph.value(shape, SH.path)
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    for shape, exception_type in INVALID_CASES:
+        path_node = shapes_graph.value(shape, SH.path)
+        with pytest.raises(exception_type):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
