index 0000000..080d3a2
--- /dev/null
+++ b/test/test_extras/test_extras_shacl.py
@@ -0,0 +1,98 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSequence sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:alternative sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:inverseModified sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:noRestSequence sh:path _:cell1 .
+_:cell1 rdf:first ex:p ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:q .
+ex:emptySequence sh:path () .
+ex:oneItemSequence sh:path ( ex:p ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknownBlankNode sh:path [ ex:other ex:p ] .
+ex:literal sh:path "http://example.org/p" .
+ex:cyclic sh:path _:loop .
+_:loop rdf:first ex:p ; rdf:rest _:loop .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    return Graph().parse(data=SHAPES_TURTLE, format="turtle")
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        ("iri", EX.p),
+        ("sequence", EX.p / EX.q / EX.r),
+        ("nestedSequence", EX.p / (EX.q / EX.r)),
+        ("noRestSequence", EX.p / EX.q),
+        ("alternative", EX.p | EX.q),
+        ("inverse", ~EX.p),
+        ("zeroOrMore", EX.p * "*"),  # type: ignore[operator]
+        ("oneOrMore", EX.p * "+"),  # type: ignore[operator]
+        ("zeroOrOne", EX.p * "?"),  # type: ignore[operator]
+        ("inverseModified", (~EX.p) * "*"),
+        ("emptySequence", SHACLPathError),
+        ("oneItemSequence", SHACLPathError),
+        ("emptyAlternative", SHACLPathError),
+        ("oneItemAlternative", SHACLPathError),
+        ("unknownBlankNode", SHACLPathError),
+        ("literal", TypeError),
+        ("cyclic", ValueError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    node = shapes.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes, node) == expected  # type: ignore[arg-type]
+
+
+@pytest.mark.parametrize("node", [None, "http://example.org/p"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, node)  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    for node in list(shapes.objects(None, SH.path)):
+        try:
+            parse_shacl_path(shapes, node)
+        except (TypeError, SHACLPathError, ValueError):
+            pass
+    assert set(shapes) == before
