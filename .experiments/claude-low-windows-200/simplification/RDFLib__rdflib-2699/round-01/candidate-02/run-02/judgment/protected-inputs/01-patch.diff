index 0000000..6d9f840
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,91 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is either an IRI other than ``rdf:nil`` (a simple
+    path), or a blank node that is an RDF list of two or more paths (a
+    sequence path), or a blank node carrying ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of two or more paths), or one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The node that is the value of ``sh:path``. It
+        must be a node of ``shapes_graph``, not the shape subject.
+    :return: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path structure is malformed or not
+        recognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+
+    # A simple path: an IRI other than rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # A sequence path: an RDF list with at least two items.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"sequence path {path_identifier!r} must have at least two items, "
+                f"found {len(sequence_items)}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, i) for i in sequence_items]
+        )
+
+    # sh:inversePath
+    if (inverse := shapes_graph.value(path_identifier, SH.inversePath)) is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: an RDF list with at least two items.
+    if (
+        alternatives := shapes_graph.value(path_identifier, SH.alternativePath)
+    ) is not None:
+        alternative_items = list(shapes_graph.items(alternatives))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"alternative path {path_identifier!r} must have at least two items, "
+                f"found {len(alternative_items)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alternative_items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, and sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..bfafa57
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shapes#")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSequence sh:path ( ( ex:p1 ex:p2 ) ex:p3 ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:sequenceOfAlternativeAndModifier sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:openEndedList sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:nilPath sh:path rdf:nil .
+
+ex:emptySequence sh:path () .
+
+ex:oneItemSequence sh:path ( ex:p1 ) .
+
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unrecognizedNode sh:path [ ex:unknown ex:p1 ] .
+
+ex:literalPath sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        (EX.simple, EX.p1),
+        (EX.sequence, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSequence, (EX.p1 / EX.p2) / EX.p3),
+        (EX.inverse, ~EX.p1),
+        (EX.alternative, EX.p1 | EX.p2 | EX.p3),
+        (EX.zeroOrMore, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modifiedInverse, (~EX.p1) * "*"),
+        (
+            EX.sequenceOfAlternativeAndModifier,
+            (EX.p1 | EX.p2) / (EX.p3 * "+"),  # type: ignore[operator]
+        ),
+        (EX.openEndedList, EX.p1 / EX.p2),
+        (EX.nilPath, SHACLPathError),
+        (EX.emptySequence, SHACLPathError),
+        (EX.oneItemSequence, SHACLPathError),
+        (EX.emptyAlternative, SHACLPathError),
+        (EX.oneItemAlternative, SHACLPathError),
+        (EX.unrecognizedNode, SHACLPathError),
+        (EX.literalPath, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
