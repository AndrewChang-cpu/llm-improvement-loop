+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,92 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib predicate or path.
+
+    A valid SHACL path is one of: an IRI (a simple predicate); an RDF list of
+    two or more paths (a sequence path); a blank node with ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of two or more paths), or one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the shapes graph to read. It is only read, never
+        modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It is an IRI, a blank node, or a Literal.
+    :return: the IRI itself as a :class:`~rdflib.term.URIRef` for a simple
+        predicate, or a :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal.
+    :raises SHACLPathError: if the path is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"sequence path {path_identifier!r} must have at least two items"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of paths.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"alternative path {path_identifier!r} must have at least two items"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..8afd40e
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,121 @@
+from __future__ import annotations
+
+from typing import Optional, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shacl-test/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/shacl-test/> .
+
+ex:simple sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sequenceMix sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literalPath sh:path "p1" .
+"""
+
+VALID_CASES = [
+    pytest.param(EX.simple, EX.p1, id="simple"),
+    pytest.param(EX.sequence, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+    pytest.param(EX.nestedSequence, EX.p1 / (EX.p2 / EX.p3), id="nested-sequence"),
+    pytest.param(EX.openList, EX.p1 / EX.p2, id="list-without-rest"),
+    pytest.param(EX.inverse, ~EX.p1, id="inverse"),
+    pytest.param(EX.alternative, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+    pytest.param(
+        EX.nestedAlternative,
+        EX.p1 | ~EX.p2 | (EX.p3 / EX.p4),
+        id="nested-alternative",
+    ),
+    pytest.param(
+        EX.zeroOrMore,
+        EX.p1 * "*",  # type: ignore[operator]
+        id="zero-or-more",
+    ),
+    pytest.param(
+        EX.oneOrMore,
+        EX.p1 * "+",  # type: ignore[operator]
+        id="one-or-more",
+    ),
+    pytest.param(
+        EX.zeroOrOne,
+        EX.p1 * "?",  # type: ignore[operator]
+        id="zero-or-one",
+    ),
+    pytest.param(EX.modifiedInverse, (~EX.p1) * "*", id="modifier-of-inverse"),
+    pytest.param(
+        EX.sequenceMix,
+        EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+"),  # type: ignore[operator]
+        id="sequence-with-alternative-and-modifier",
+    ),
+]
+
+INVALID_CASES = [
+    pytest.param(EX.emptyList, SHACLPathError, id="empty-list-rdf-nil"),
+    pytest.param(EX.oneItemSequence, SHACLPathError, id="one-item-sequence"),
+    pytest.param(EX.emptyAlternative, SHACLPathError, id="empty-alternative"),
+    pytest.param(EX.oneItemAlternative, SHACLPathError, id="one-item-alternative"),
+    pytest.param(EX.unrecognized, SHACLPathError, id="unrecognized-blank-node"),
+    pytest.param(EX.literalPath, TypeError, id="literal"),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_CASES + INVALID_CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("path_node", [None, "not-a-node"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    path_node: Optional[str],
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
