index 0000000..b81c6f3
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,113 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ( ex:p1 ex:p2 ) )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqWithAltMod sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:openList sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:notAPath ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param(EX.iri, EX.p1, id="iri"),
+        pytest.param(EX.seq, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3), id="nested-sequence"),
+        pytest.param(EX.inv, ~EX.p1, id="inverse"),
+        pytest.param(EX.alt, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+        pytest.param(
+            EX.nestedAlt,
+            EX.p1 | (EX.p2 | EX.p3) | (EX.p1 / EX.p2),
+            id="nested-alternative",
+        ),
+        pytest.param(
+            EX.zeroOrMore,
+            EX.p1 * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            EX.oneOrMore,
+            EX.p1 * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            EX.zeroOrOne,
+            EX.p1 * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param(EX.modInv, (~EX.p1) * "*", id="modifier-of-inverse"),
+        pytest.param(
+            EX.seqWithAltMod,
+            EX.p1 / (EX.p2 | EX.p3) / (EX.p3 * "+"),  # type: ignore[operator]
+            id="sequence-with-alternative-and-modifier",
+        ),
+        pytest.param(EX.openList, EX.p1 / EX.p2, id="open-list-end-cell"),
+        pytest.param(EX.nilPath, SHACLPathError, id="rdf-nil-path"),
+        pytest.param(EX.emptySeq, SHACLPathError, id="empty-sequence"),
+        pytest.param(EX.oneSeq, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptyAlt, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneAlt, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknown, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literal, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+        assert repr(result) == repr(expected)
