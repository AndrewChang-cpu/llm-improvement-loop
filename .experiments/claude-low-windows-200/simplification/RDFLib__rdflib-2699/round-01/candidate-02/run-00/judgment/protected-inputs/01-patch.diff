@@ -0,0 +1,88 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# Based on pyshacl's conversion of SHACL paths to SPARQL property paths.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a SHACL ``sh:path`` triple into an RDFLib predicate.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a simple path;
+    * an RDF list of at least two paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list of
+      at least two paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the object node of the ``sh:path`` triple, not the
+        shape subject.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is structurally invalid.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("literals are not valid SHACL paths: %r" % path_identifier)
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # A sequence path is an RDF list of at least two paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "a sequence path needs at least two items, got %d: %r"
+                % (len(items), path_identifier)
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    if (inner := shapes_graph.value(path_identifier, SH.inversePath)) is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inner))
+
+    # sh:alternativePath, whose value is an RDF list of at least two paths.
+    if (alt := shapes_graph.value(path_identifier, SH.alternativePath)) is not None:
+        alternatives = list(shapes_graph.items(alt))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "an alternative path needs at least two items, got %d: %r"
+                % (len(alternatives), path_identifier)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, a) for a in alternatives]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath and sh:zeroOrOnePath are modifiers.
+    if (inner := shapes_graph.value(path_identifier, SH.zeroOrMorePath)) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, inner), "*")
+    if (inner := shapes_graph.value(path_identifier, SH.oneOrMorePath)) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, inner), "+")
+    if (inner := shapes_graph.value(path_identifier, SH.zeroOrOnePath)) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, inner), "?")
+
+    raise SHACLPathError("unrecognized SHACL path: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
