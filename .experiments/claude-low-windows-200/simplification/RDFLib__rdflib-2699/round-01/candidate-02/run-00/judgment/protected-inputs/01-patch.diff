index 0000000..48fde34
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:shape_simple sh:path ex:p1 .
+ex:shape_sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:shape_nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:shape_open_list sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+ex:shape_inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:shape_alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:shape_nested_alternative sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:shape_zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:shape_one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:shape_zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:shape_modifier_inverse sh:path [
+    sh:zeroOrMorePath [ sh:inversePath ex:p1 ]
+] .
+ex:shape_sequence_mixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:shape_empty_list sh:path () .
+ex:shape_one_item_sequence sh:path ( ex:p1 ) .
+ex:shape_empty_alternative sh:path [ sh:alternativePath () ] .
+ex:shape_one_item_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:shape_unrecognized sh:path [ ex:other ex:p1 ] .
+ex:shape_literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.shape_simple, EX.p1),
+        (EX.shape_sequence, EX.p1 / EX.p2 / EX.p3),
+        (EX.shape_nested_sequence, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.shape_open_list, EX.p1 / EX.p2),
+        (EX.shape_inverse, ~EX.p1),
+        (EX.shape_alternative, EX.p1 | EX.p2 | EX.p3),
+        (EX.shape_nested_alternative, EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+        (EX.shape_zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.shape_one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.shape_zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.shape_modifier_inverse, (~EX.p1) * "*"),
+        (
+            EX.shape_sequence_mixed,
+            (EX.p1 | EX.p2) / (EX.p3 * "+"),  # type: ignore[operator]
+        ),
+        (EX.shape_empty_list, SHACLPathError),
+        (EX.shape_one_item_sequence, SHACLPathError),
+        (EX.shape_empty_alternative, SHACLPathError),
+        (EX.shape_one_item_alternative, SHACLPathError),
+        (EX.shape_unrecognized, SHACLPathError),
+        (EX.shape_literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triples_before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == triples_before
+
+
+@pytest.mark.parametrize("path_node", [None, "x"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    path_node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
