index 0000000..04418d5
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri_shape sh:path ex:p1 .
+ex:sequence_shape sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nested_sequence_shape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:open_list_shape sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse_shape sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative_shape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nested_alternative_shape sh:path [
+    sh:alternativePath ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) )
+] .
+ex:zero_or_more_shape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:one_or_more_shape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zero_or_one_shape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modified_inverse_shape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sequence_of_forms_shape sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:empty_list_shape sh:path () .
+ex:one_item_sequence_shape sh:path ( ex:p1 ) .
+ex:empty_alternative_shape sh:path [ sh:alternativePath () ] .
+ex:one_item_alternative_shape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized_shape sh:path [ ex:unknown ex:p1 ] .
+ex:literal_shape sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri_shape, EX.p1),
+        (EX.sequence_shape, EX.p1 / EX.p2 / EX.p3),
+        (EX.nested_sequence_shape, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.open_list_shape, EX.p1 / EX.p2),
+        (EX.inverse_shape, ~EX.p1),
+        (EX.alternative_shape, EX.p1 | EX.p2 | EX.p3),
+        (
+            EX.nested_alternative_shape,
+            EX.p1 | ~EX.p2 | (EX.p3 / EX.p4),
+        ),
+        (EX.zero_or_more_shape, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.one_or_more_shape, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zero_or_one_shape, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modified_inverse_shape, ~EX.p1 * "*"),
+        (
+            EX.sequence_of_forms_shape,
+            (EX.p1 | EX.p2) / (EX.p3 * "+"),  # type: ignore[operator]
+        ),
+        (EX.empty_list_shape, SHACLPathError),
+        (EX.one_item_sequence_shape, SHACLPathError),
+        (EX.empty_alternative_shape, SHACLPathError),
+        (EX.one_item_alternative_shape, SHACLPathError),
+        (EX.unrecognized_shape, SHACLPathError),
+        (EX.literal_shape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    triples_before = set(shapes)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(
+                shapes, shapes.value(shape, SH.path)  # type: ignore[arg-type]
+            )
+    else:
+        result = parse_shacl_path(
+            shapes, shapes.value(shape, SH.path)  # type: ignore[arg-type]
+        )
+        assert result == expected
+    assert set(shapes) == triples_before
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "p1")  # type: ignore[arg-type]
