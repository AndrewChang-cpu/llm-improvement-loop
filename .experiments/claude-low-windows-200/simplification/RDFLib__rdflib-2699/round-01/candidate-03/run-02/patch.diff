index 0000000..335d687
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,106 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path (ex:p1 ex:p2 ex:p3) .
+ex:nested sh:path (ex:p1 (ex:p2 ex:p3)) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath (ex:p1 ex:p2 ex:p3) ] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:combo sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqalt sh:path (
+    ex:p1
+    [ sh:alternativePath (ex:p2 ex:p3) ]
+    [ sh:zeroOrMorePath ex:p4 ]
+) .
+ex:open sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+
+ex:nil sh:path () .
+ex:oneseq sh:path (ex:p1) .
+ex:emptyalt sh:path [ sh:alternativePath () ] .
+ex:onealt sh:path [ sh:alternativePath (ex:p1) ] .
+ex:unrec sh:path [ ex:foo ex:bar ] .
+ex:lit sh:path "literal" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("iri", EX.p1),
+        ("seq", EX.p1 / EX.p2 / EX.p3),
+        ("nested", EX.p1 / (EX.p2 / EX.p3)),
+        ("inv", ~EX.p1),
+        ("alt", EX.p1 | EX.p2 | EX.p3),
+        ("star", EX.p1 * "*"),  # type: ignore[operator]
+        ("plus", EX.p1 * "+"),  # type: ignore[operator]
+        ("opt", EX.p1 * "?"),  # type: ignore[operator]
+        ("combo", (~EX.p1) * "*"),
+        ("seqalt", EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "*")),  # type: ignore[operator]
+        ("open", EX.p1 / EX.p2),
+        ("nil", SHACLPathError),
+        ("oneseq", SHACLPathError),
+        ("emptyalt", SHACLPathError),
+        ("onealt", SHACLPathError),
+        ("unrec", SHACLPathError),
+        ("lit", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_error(
+    shapes_graph: Graph, bad_input: object
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parsing_does_not_change_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ["iri", "seq", "nested", "inv", "alt", "combo", "seqalt", "open"]:
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    for shape in ["nil", "oneseq", "emptyalt", "onealt", "unrec", "lit"]:
+        path_node = shapes_graph.value(EX[shape], SH.path)
+        with pytest.raises((SHACLPathError, TypeError)):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
