@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value of ``sh:path`` is not a valid SHACL path."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list of two or more valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (whose value
+      is an RDF list of two or more valid paths), ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the value of ``sh:path``.
+        It must be an IRI or a blank node; a :class:`~rdflib.term.Literal`
+        raises :class:`TypeError`.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple predicate path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternatives = list(shapes_graph.items(alternative_list))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, "
+                f"got {len(alternatives)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, a) for a in alternatives]
+        )
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..5b1269c
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,115 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt3 sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:altNested sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        ( ex:p4 ex:p5 )
+    )
+] .
+ex:zom sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oom sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zoo sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath ex:p3 ]
+) .
+ex:openTail sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:nil sh:path () .
+ex:seq1 sh:path ( ex:p1 ) .
+ex:altEmpty sh:path [ sh:alternativePath () ] .
+ex:alt1 sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _path_of(shapes: Graph, shape: URIRef) -> Node:
+    node = shapes.value(shape, SH.path)
+    assert node is not None
+    return node
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        (EX.iri, EX.p1),
+        (EX.seq3, EX.p1 / EX.p2 / EX.p3),
+        (EX.seqNested, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.inv, ~EX.p1),
+        (EX.alt3, EX.p1 | EX.p2 | EX.p3),
+        (EX.altNested, EX.p1 | (EX.p2 | EX.p3) | (EX.p4 / EX.p5)),
+        (EX.zom, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oom, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zoo, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modInv, (~EX.p1) * "*"),
+        (EX.seqMixed, (EX.p1 | EX.p2) / (EX.p3 * "*")),  # type: ignore[operator]
+        (EX.openTail, EX.p1 / EX.p2),
+        (EX.nil, SHACLPathError),
+        (EX.seq1, SHACLPathError),
+        (EX.altEmpty, SHACLPathError),
+        (EX.alt1, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = _path_of(shapes, shape)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)
+    else:
+        assert parse_shacl_path(shapes, path_node) == expected
+
+
+def test_none_and_string_are_shacl_path_errors(shapes: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "http://example.com/p1")  # type: ignore[arg-type]
+
+
+def test_parse_leaves_graph_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    for shape in (EX.seq3, EX.inv, EX.nil, EX.literal):
+        path_node = _path_of(shapes, shape)
+        try:
+            parse_shacl_path(shapes, path_node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes) == before
