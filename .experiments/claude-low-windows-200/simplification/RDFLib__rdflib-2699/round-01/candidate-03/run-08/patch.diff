index 0000000..9a08ea6
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+ONE_OR_MORE_P4 = EX.p4 * "+"  # type: ignore[operator]
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shapes#> .
+
+ex:simple sh:path ex:p1 .
+ex:emptyList sh:path () .
+ex:singleSeq sh:path ( ex:p1 ) .
+ex:seqWithNil sh:path ( ex:p1 () ) .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:tailNoRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:singleAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:mixed sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:unknownBlank sh:path [ ex:foo ex:p1 ] .
+ex:literalPath sh:path "abc" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.simple, EX.p1),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.tailNoRest, EX.p1 / EX.p2),
+        (EX.inverse, ~EX.p1),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.zeroOrMore, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modInverse, (~EX.p1) * "*"),
+        (EX.mixed, EX.p1 / (EX.p2 | EX.p3) / ONE_OR_MORE_P4),
+        (EX.emptyList, SHACLPathError),
+        (EX.singleSeq, SHACLPathError),
+        (EX.seqWithNil, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.singleAlt, SHACLPathError),
+        (EX.unknownBlank, SHACLPathError),
+        (EX.literalPath, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        return
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/shapes#p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    bad_input: object,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for path_node in list(shapes_graph.objects(predicate=SH.path)):
+        try:
+            parse_shacl_path(shapes_graph, path_node)
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
