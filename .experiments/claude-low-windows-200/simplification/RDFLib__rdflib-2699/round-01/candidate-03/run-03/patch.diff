index 0000000..038a53b
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,104 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifierOfInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:sequenceWithAlternatives sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:openList sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.simple, EX.p),
+        (EX.sequence, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSequence, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.inverse, ~EX.p),
+        (EX.alternative, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAlternative, EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+        (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+        (EX.modifierOfInverse, (~EX.p) * "*"),
+        (
+            EX.sequenceWithAlternatives,
+            EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+"),  # type: ignore[operator]
+        ),
+        (EX.openList, EX.p1 / EX.p2),
+        (EX.emptyList, SHACLPathError),
+        (EX.oneItemSequence, SHACLPathError),
+        (EX.emptyAlternative, SHACLPathError),
+        (EX.oneItemAlternative, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(graph)
+    path_node = graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(graph, path_node) == expected  # type: ignore[arg-type]
+    assert set(graph) == before
+
+
+@pytest.mark.parametrize("node", [None, "plain string"])
+def test_non_node_input_raises_shacl_path_error(
+    graph: Graph, node: Union[None, str]
+) -> None:
+    before = set(graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, node)  # type: ignore[arg-type]
+    assert set(graph) == before
