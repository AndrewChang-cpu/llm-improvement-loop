@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p .
+ex:seqShape sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSeqShape sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:invShape sh:path [ sh:inversePath ex:p ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInvShape sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p ] ] .
+ex:combinedShape sh:path (
+    [ sh:alternativePath ( ex:p ex:q ) ]
+    [ sh:zeroOrMorePath ex:r ]
+) .
+ex:danglingListShape sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+
+ex:nilShape sh:path () .
+ex:oneItemSeqShape sh:path ( ex:p ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAltShape sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknownShape sh:path [ ex:notAPath ex:p ] .
+ex:literalShape sh:path "bad" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param("iriShape", EX.p, id="iri"),
+        pytest.param("seqShape", EX.p / EX.q / EX.r, id="sequence"),
+        pytest.param("nestedSeqShape", EX.p / (EX.q / EX.r), id="nested-sequence"),
+        pytest.param("invShape", ~EX.p, id="inverse"),
+        pytest.param("altShape", EX.p | EX.q | EX.r, id="alternative"),
+        pytest.param(
+            "zeroOrMoreShape",
+            EX.p * "*",  # type: ignore[operator]
+            id="zero-or-more",
+        ),
+        pytest.param(
+            "oneOrMoreShape",
+            EX.p * "+",  # type: ignore[operator]
+            id="one-or-more",
+        ),
+        pytest.param(
+            "zeroOrOneShape",
+            EX.p * "?",  # type: ignore[operator]
+            id="zero-or-one",
+        ),
+        pytest.param("modInvShape", (~EX.p) * "+", id="modifier-of-inverse"),
+        pytest.param(
+            "combinedShape",
+            (EX.p | EX.q) / (EX.r * "*"),  # type: ignore[operator]
+            id="sequence-of-alternative-and-modifier",
+        ),
+        pytest.param("danglingListShape", EX.p / EX.q, id="list-ending-without-rest"),
+        pytest.param("nilShape", SHACLPathError, id="rdf-nil-as-path"),
+        pytest.param("oneItemSeqShape", SHACLPathError, id="one-item-sequence"),
+        pytest.param("emptyAltShape", SHACLPathError, id="empty-alternative"),
+        pytest.param("oneItemAltShape", SHACLPathError, id="one-item-alternative"),
+        pytest.param("unknownShape", SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literalShape", TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        return
+    assert parse_shacl_path(shapes, path_node) == expected  # type: ignore[arg-type]
+
+
+def test_non_node_inputs_raise_and_graph_is_unchanged(shapes: Graph) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, "ex:p")  # type: ignore[arg-type]
+    for shape in ("nilShape", "oneItemSeqShape", "unknownShape"):
+        path_node = shapes.value(EX[shape], SH.path)
+        with pytest.raises(SHACLPathError):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    assert set(shapes) == before
