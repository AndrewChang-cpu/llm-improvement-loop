index 0000000..c48eb48
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,126 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:combined sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:openList sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+
+ex:nilPath sh:path () .
+
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+
+ex:singleSequence sh:path ( ex:p1 ) .
+
+ex:singleAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unrecognized sh:path [ ex:foo ex:p1 ] .
+
+ex:literalPath sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def path_node(graph: Graph, shape: URIRef) -> Node:
+    node = graph.value(shape, SH.path)
+    assert node is not None
+    return node
+
+
+CASES: list[tuple[str, object]] = [
+    ("simple", EX.p1),
+    ("sequence", EX.p1 / EX.p2 / EX.p3),
+    ("nestedSequence", EX.p1 / (EX.p2 / EX.p3)),
+    ("inverse", ~EX.p1),
+    ("alternative", EX.p1 | EX.p2 | EX.p3),
+    ("nestedAlternative", EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+    ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+    ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+    ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+    ("modifiedInverse", (~EX.p1) * "*"),
+    ("combined", (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+    ("openList", EX.p1 / EX.p2),
+    ("nilPath", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("singleSequence", SHACLPathError),
+    ("singleAlternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.mark.parametrize(("shape", "expected"), CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    node = path_node(shapes_graph, EX[shape])
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)
+    else:
+        result = parse_shacl_path(shapes_graph, node)
+        assert result == expected
+        assert result.n3() == expected.n3()
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad", [None, "http://example.org/p1"])
+def test_non_node_raises(shapes_graph: Graph, bad: object) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad)  # type: ignore[arg-type]
+
+
+def test_rdf_nil_is_rejected(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
