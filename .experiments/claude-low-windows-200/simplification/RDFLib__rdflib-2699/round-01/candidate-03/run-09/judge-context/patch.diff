@@ -0,0 +1,98 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not form a valid SHACL path."""
+
+
+# The parsing procedure is based on pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a simple path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, that is, the object of the
+        ``sh:path`` triple.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if ``path_identifier`` is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..456dac3
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:simple sh:path ex:p .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSeq sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:seqAlt sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:other ex:p ] .
+ex:literal sh:path "p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        (EX.simple, EX.p),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.openSeq, EX.p1 / EX.p2),
+        (EX.inv, ~EX.p),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAlt, EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+        (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+        (EX.modInv, (~EX.p) * "*"),
+        (EX.seqAlt, EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+")),  # type: ignore[operator]
+        (EX.nilPath, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "http://example.org/p")  # type: ignore[arg-type]
+
+
+def test_parsing_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in list(shapes_graph.subjects(SH.path)):
+        path_node = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
