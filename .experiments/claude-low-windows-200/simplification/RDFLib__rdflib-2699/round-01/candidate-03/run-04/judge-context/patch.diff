index 0000000..d9f02d6
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,105 @@
+from __future__ import annotations
+
+import contextlib
+from typing import List, Tuple, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:altNested sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMix sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:noRest sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+VALID_AND_INVALID: List[Tuple[URIRef, Union[URIRef, Path, Type[Exception]]]] = [
+    (EX.simple, EX.p1),
+    (EX.seq, EX.p1 / EX.p2 / EX.p3),
+    (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+    (EX.inv, ~EX.p1),
+    (EX.alt, EX.p1 | EX.p2 | EX.p3),
+    (EX.altNested, EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+    (EX.zeroOrMore, EX.p1 * "*"),  # type: ignore[operator]
+    (EX.oneOrMore, EX.p1 * "+"),  # type: ignore[operator]
+    (EX.zeroOrOne, EX.p1 * "?"),  # type: ignore[operator]
+    (EX.modInv, ~EX.p1 * "*"),
+    (EX.seqMix, (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+    (EX.noRest, EX.p1 / EX.p2),
+    (EX.nilPath, SHACLPathError),
+    (EX.oneSeq, SHACLPathError),
+    (EX.emptyAlt, SHACLPathError),
+    (EX.oneAlt, SHACLPathError),
+    (EX.unknown, SHACLPathError),
+    (EX.literal, TypeError),
+]
+
+
+@pytest.mark.parametrize(("shape", "expected"), VALID_AND_INVALID)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad", [None, "p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes: Graph,
+    bad: Union[None, str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, bad)  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes: Graph) -> None:
+    before = set(shapes)
+    for path_node in list(shapes.objects(None, SH.path)):
+        with contextlib.suppress(SHACLPathError, TypeError):
+            parse_shacl_path(shapes, path_node)
+    assert set(shapes) == before
