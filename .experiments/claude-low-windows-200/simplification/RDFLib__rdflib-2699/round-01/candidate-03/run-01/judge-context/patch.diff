@@ -0,0 +1,89 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path node is malformed or unusable."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI other than ``rdf:nil`` (a simple
+    path), or a blank node that is an RDF list of at least two paths
+    (a sequence), carries ``sh:inversePath``, carries ``sh:alternativePath``
+    whose RDF list has at least two paths, or carries one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the value of ``sh:path``.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path {path_identifier!r} must have at least two items"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # Inverse path: sh:inversePath.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path {path_identifier!r} must have at least two items"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..e279683
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_simple sh:path ex:p1 .
+ex:s_sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:s_nested_sequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:s_inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:s_alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:s_nested_alternative sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:s_zero_or_more sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:s_one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:s_zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:s_modifier_inverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:s_sequence_mixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    ex:p3
+    [ sh:zeroOrMorePath ex:p4 ]
+) .
+ex:s_open_list sh:path _:l1 .
+_:l1 rdf:first ex:p1 ; rdf:rest _:l2 .
+_:l2 rdf:first ex:p2 .
+
+ex:s_nil sh:path () .
+ex:s_single_sequence sh:path ( ex:p1 ) .
+ex:s_empty_alternative sh:path [ sh:alternativePath () ] .
+ex:s_single_alternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:s_unrecognized sh:path [ ex:unknown ex:p1 ] .
+ex:s_literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.s_simple, EX.p1),
+        (EX.s_sequence, EX.p1 / EX.p2 / EX.p3),
+        (EX.s_nested_sequence, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.s_inverse, ~EX.p1),
+        (EX.s_alternative, EX.p1 | EX.p2 | EX.p3),
+        (EX.s_nested_alternative, EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+        (EX.s_zero_or_more, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.s_one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.s_zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.s_modifier_inverse, (~EX.p1) * "*"),
+        (
+            EX.s_sequence_mixed,
+            (EX.p1 | EX.p2) / EX.p3 / (EX.p4 * "*"),  # type: ignore[operator]
+        ),
+        (EX.s_open_list, EX.p1 / EX.p2),
+        (EX.s_nil, SHACLPathError),
+        (EX.s_single_sequence, SHACLPathError),
+        (EX.s_empty_alternative, SHACLPathError),
+        (EX.s_single_alternative, SHACLPathError),
+        (EX.s_unrecognized, SHACLPathError),
+        (EX.s_literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = graph.value(shape, SH.path)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+def test_non_node_inputs_raise_shacl_path_error(graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(graph, "http://example.com/p1")  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(graph: Graph) -> None:
+    before = set(graph)
+    for shape in (EX.s_sequence, EX.s_nil, EX.s_open_list, EX.s_literal):
+        path_node = graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(graph) == before
