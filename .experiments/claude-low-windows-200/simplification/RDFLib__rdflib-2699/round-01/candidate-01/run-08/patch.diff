index 0000000..7fe3b8d
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shapes/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.com/shapes/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:sequence sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSequence sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:openSequence sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p [ sh:alternativePath ( ex:q ex:r ) ] ex:s )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:sequenceOfAlternativeAndModifier sh:path (
+    [ sh:alternativePath ( ex:p ex:q ) ] [ sh:oneOrMorePath ex:r ]
+) .
+
+ex:emptyList sh:path () .
+ex:oneItemSequence sh:path ( ex:p ) .
+ex:nilItem sh:path ( ex:p () ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.sequence, EX.p / EX.q / EX.r),
+        (EX.nestedSequence, EX.p / (EX.q / EX.r)),
+        (EX.openSequence, EX.p / EX.q),
+        (EX.inverse, ~EX.p),
+        (EX.alternative, EX.p | EX.q | EX.r),
+        (EX.nestedAlternative, EX.p | (EX.q | EX.r) | EX.s),
+        (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+        (EX.modifiedInverse, (~EX.p) * "*"),
+        (
+            EX.sequenceOfAlternativeAndModifier,
+            (EX.p | EX.q) / (EX.r * "+"),  # type: ignore[operator]
+        ),
+        (EX.emptyList, SHACLPathError),
+        (EX.oneItemSequence, SHACLPathError),
+        (EX.nilItem, SHACLPathError),
+        (EX.emptyAlternative, SHACLPathError),
+        (EX.oneItemAlternative, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("path_node", [None, "x"])
+def test_parse_shacl_path_rejects_non_nodes(
+    shapes_graph: Graph,
+    path_node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
