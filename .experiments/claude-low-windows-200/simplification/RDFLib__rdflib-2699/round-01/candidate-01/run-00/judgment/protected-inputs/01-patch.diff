index 0000000..113f2a4
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,91 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a SHACL shapes graph is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of two or more valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of two or more valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    The shapes graph is only read, never modified.
+
+    :param shapes_graph: The graph holding the shapes. It must be fully loaded.
+    :param path_identifier: The path node, which is the object of a ``sh:path``
+        triple and not the shape subject.
+    :returns: A :class:`~rdflib.term.URIRef` for a simple predicate path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If ``path_identifier`` is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..8416f31
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,87 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriShape sh:path ex:p1 .
+ex:seqShape sh:path ( ex:p1 ex:p2 ) .
+ex:nestedSeqShape sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:invShape sh:path [ sh:inversePath ex:p1 ] .
+ex:altShape sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAltShape sh:path [ sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) ) ] .
+ex:starShape sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plusShape sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:optShape sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:invStarShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqAltShape sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:openListShape sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:nilShape sh:path () .
+ex:oneItemSeqShape sh:path ( ex:p1 ) .
+ex:emptyAltShape sh:path [ sh:alternativePath () ] .
+ex:oneItemAltShape sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownBlankShape sh:path [ ex:unknown ex:p1 ] .
+ex:literalShape sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        (EX.iriShape, EX.p1),
+        (EX.seqShape, EX.p1 / EX.p2),
+        (EX.nestedSeqShape, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.invShape, ~EX.p1),
+        (EX.altShape, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAltShape, EX.p1 | (EX.p2 / EX.p3)),
+        (EX.starShape, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.plusShape, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.optShape, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.invStarShape, ~EX.p1 * "*"),
+        (EX.seqAltShape, (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+        (EX.openListShape, EX.p1 / EX.p2),
+        (EX.nilShape, SHACLPathError),
+        (EX.oneItemSeqShape, SHACLPathError),
+        (EX.emptyAltShape, SHACLPathError),
+        (EX.oneItemAltShape, SHACLPathError),
+        (EX.unknownBlankShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        return
+    result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert result == expected
