@@ -0,0 +1,99 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+# The parsing logic below is based on the SHACL-to-SPARQL path conversion
+# in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of: an IRI other than ``rdf:nil`` (a simple
+    path); an RDF list of at least two paths (a sequence path); a blank node
+    with ``sh:inversePath``; a blank node with ``sh:alternativePath`` whose
+    RDF list holds at least two paths; or a blank node with
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+    Nested paths are parsed recursively.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple, as a :class:`~rdflib.term.URIRef` or blank node.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    # A simple path: an IRI other than rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # A sequence path: an RDF list of paths, with at least two items.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got "
+                f"{len(sequence_items)} for {path_identifier}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # An inverse path: sh:inversePath.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # An alternative path: sh:alternativePath over an RDF list, with at least
+    # two items.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got "
+                f"{len(alternative_items)} for {path_identifier}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # A modifier path: sh:zeroOrMorePath maps to "*".
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # A modifier path: sh:oneOrMorePath maps to "+".
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # A modifier path: sh:zeroOrOnePath maps to "?".
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..88fdb37
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,94 @@
+from __future__ import annotations
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seqNoRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt3 sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:altNested sh:path [
+    sh:alternativePath ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:nilPath sh:path () .
+ex:seq1 sh:path ( ex:p1 ) .
+ex:altEmpty sh:path [ sh:alternativePath () ] .
+ex:alt1 sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literalPath sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.simple, EX.p1),
+        (EX.seq3, EX.p1 / EX.p2 / EX.p3),
+        (EX.seqNested, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.seqNoRest, EX.p1 / EX.p2),
+        (EX.inverse, ~EX.p1),
+        (EX.alt3, EX.p1 | EX.p2 | EX.p3),
+        (EX.altNested, EX.p1 | ~EX.p2 | (EX.p3 / EX.p4)),
+        (EX.zeroOrMore, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modInverse, ~EX.p1 * "*"),
+        (EX.seqMixed, (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+        (EX.nilPath, SHACLPathError),
+        (EX.seq1, SHACLPathError),
+        (EX.altEmpty, SHACLPathError),
+        (EX.alt1, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literalPath, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: URIRef | Path | type[Exception],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("path_node", [None, "p1"])
+def test_parse_non_node_input(shapes_graph: Graph, path_node: str | None) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
