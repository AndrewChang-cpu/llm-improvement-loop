index 0000000..8d0ee64
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,89 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a SHACL shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate;
+    * an RDF list of at least two paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two paths), ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    The parser only reads from the graph and keeps no state.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple, as a :class:`~rdflib.term.URIRef` or blank node.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is not valid SHACL.
+    """
+    # Implementation based on pyshacl's SHACL-to-SPARQL path conversion.
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of at least two paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # sh:alternativePath: an RDF list of at least two paths.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # sh:zeroOrMorePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    # sh:oneOrMorePath
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..b456bd0
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,84 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.com/> .
+
+ex:simple sh:path ex:p1 .
+ex:rdfNil sh:path () .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:oneItemSeq sh:path ( ex:p1 ) .
+ex:partialSeq sh:path _:cell1 .
+_:cell1 rdf:first ex:p1 ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:p2 .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMix sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "x" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    ("resource", "expected"),
+    [
+        (EX.simple, EX.p1),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.partialSeq, EX.p1 / EX.p2),
+        (EX.inv, ~EX.p1),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.zeroOrMore, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modInv, ~EX.p1 * "*"),
+        (EX.seqMix, (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+        (EX.rdfNil, SHACLPathError),
+        (EX.oneItemSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneItemAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(resource, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
