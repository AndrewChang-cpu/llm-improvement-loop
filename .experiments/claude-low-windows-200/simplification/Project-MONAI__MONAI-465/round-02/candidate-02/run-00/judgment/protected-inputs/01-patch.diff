+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "dataset.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"training": [{"image": "imagesTr/img0.nii", "label": "labelsTr/lbl0.nii", "extra": "keep"}]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/lbl0.nii")))
+            self.assertEqual(result[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"training": [{"image": "img0.nii", "label": 2}]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img0.nii")
+            abs_label = os.path.join(tempdir, "lbl0.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["img0.nii", "img1.nii"]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
