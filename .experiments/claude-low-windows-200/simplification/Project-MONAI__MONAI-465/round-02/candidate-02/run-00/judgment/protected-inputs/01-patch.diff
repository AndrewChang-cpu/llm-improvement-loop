+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all string paths.
+        base_dir (str): directory that relative paths are joined to.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {type(element).__name__}: {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Entries are read from the list stored under ``data_list_key``. The "image" field of every
+    item is resolved against ``base_dir``. The "label" field is resolved only when ``is_segmentation``
+    is True; when it is False, the stored label (for example an integer class id) is left unchanged.
+    Other fields are kept verbatim. Items without "image" or "label" are not errors.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist holds segmentation labels. If True, "label" must be
+            a string or a list of strings and is resolved against ``base_dir``. If False, "label" is not
+            checked or resolved. Defaults to True.
+        data_list_key (str): top-level key in the datalist that holds the entries. Defaults to "training".
+            When it is "test", each entry is a plain path string and is converted to an item with only an
+            "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means
+            the directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same fields as the input
+        item. "image" (and "label" in segmentation mode) hold resolved paths: a normalized string, or a list
+        of normalized strings with the same length and order as the input list. Absolute paths stay absolute.
+
+    Example::
+
+        items = load_decathalon_datalist("/data/task/dataset.json", data_list_key="training")
+        # items[0]["image"] -> "/data/task/imagesTr/case_0.nii.gz"
+
+    Raises:
+        ValueError: if the datalist file does not exist, the top-level object is not a mapping, the key is
+            missing, an item is not a mapping, or a path value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict):
+        raise ValueError(f"datalist top-level value must be a JSON object: {data_list_file_path}")
+    if data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' must hold a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(f"datalist item must be a mapping, got {type(item).__name__}: {item!r}")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir)
+        result.append(resolved)
+    return result
