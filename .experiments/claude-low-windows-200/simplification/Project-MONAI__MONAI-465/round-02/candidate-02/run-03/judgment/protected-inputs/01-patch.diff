+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the stored path value, either a string or a list of strings.
+        base_dir: directory that relative paths are joined to.
+        field: name of the item field being resolved, used in error messages.
+        file_path: datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements in datalist file {file_path} must be strings, got {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{field}' in datalist file {file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False,
+            "label" is left exactly as stored, whatever its type (for example an integer class id).
+            Default is True.
+        data_list_key (str): top-level key holding the list of entries. Default is "training".
+            When it equals "test", each plain path string is converted to an item with only an "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Default is None,
+            which uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same fields as the input item.
+        The "image" field, and the "label" field in segmentation mode, hold resolved paths: a string, or a list
+        of strings with the same length and order as the input list. All other fields are unchanged.
+
+    Example::
+
+        [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an "image"
+            (or segmentation "label") value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file {data_list_file_path}.")
+
+    items = json_data[data_list_key]
+    if not isinstance(items, list):
+        raise ValueError(f"Data list key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in items]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under '{data_list_key}' in datalist file {data_list_file_path} must be a mapping."
+            )
+        new_item = dict(item)
+        if "image" in item:
+            new_item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            new_item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        result.append(new_item)
+    return result
