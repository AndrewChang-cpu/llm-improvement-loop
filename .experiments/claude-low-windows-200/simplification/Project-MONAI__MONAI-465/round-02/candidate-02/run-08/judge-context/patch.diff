+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii", "label": "labelsTr/case0.nii", "fold": 0},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/case0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/case0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii", "label": 1},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/case0.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tempdir, "case0.nii")
+            label = os.path.join(tempdir, "label0.nii")
+            datalist = {"training": [{"image": image, "label": label}]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["case0.nii", "case1.nii"]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "test", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "case0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
