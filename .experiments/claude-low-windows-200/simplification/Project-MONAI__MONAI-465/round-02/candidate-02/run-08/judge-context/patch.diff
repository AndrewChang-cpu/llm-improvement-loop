+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string of a list of path strings, against `base_dir`.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all strings.
+        base_dir (str): directory used to resolve relative paths.
+
+    Returns:
+        the normalized path as a string, or a list of normalized paths with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {type(element).__name__}: {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is left exactly as stored (for example, an integer class id) and not type-checked.
+            Default is True.
+        data_list_key (str): top-level key in the datalist that holds the list of entries. Default is "training".
+            When it is "test", each entry is a plain path string and is converted to an item with only an
+            "image" field.
+        base_dir (str): directory used to resolve relative paths. If None, the directory of
+            `data_list_file_path` is used. Default is None.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same fields as the input item.
+        The "image" field, and the "label" field when `is_segmentation` is True, hold resolved paths: either a
+        normalized string, or a list of normalized strings with the same length and order as the input list.
+        All other fields are unchanged. For example::
+
+            [{"image": "/data/imagesTr/case0.nii", "label": "/data/labelsTr/case0.nii", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, `data_list_key` is missing, an item is not a mapping,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is missing from file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"data list key '{data_list_key}' must hold a list in file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        items: List[Any] = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(f"each data list item must be a mapping, got {type(item).__name__}: {item!r}")
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir)
+        result.append(item)
+    return result
