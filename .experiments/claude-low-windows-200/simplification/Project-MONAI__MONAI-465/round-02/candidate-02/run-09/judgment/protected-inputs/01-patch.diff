+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value: a string path, or a list whose elements are all strings.
+        base_dir: directory that relative paths are joined with.
+        field: name of the field being resolved, used in error messages.
+        data_list_file_path: datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist {data_list_file_path} must be a string or a list of strings, "
+        f"found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the image and label information of a Medical Segmentation Decathlon style datalist.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, "label" is resolved as a path
+            and must be a string or a list of strings. If False, "label" is returned exactly as stored, whatever
+            its type (for example an integer class id). Defaults to True.
+        data_list_key (str): key under the top-level object whose value is the list of entries. Defaults to
+            "training". If it equals "test", each entry is a plain path string and is converted to an item
+            holding only the "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same fields as the input entry.
+        "image" holds the resolved path, and in segmentation mode "label" holds the resolved path too. Each is a
+        string, or a list of strings with the same length and order as the input list. Other fields are unchanged.
+
+    Example::
+
+        {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0}]}
+
+        loads as ``[{"image": "<base_dir>/img0.nii.gz", "label": "<base_dir>/seg0.nii.gz", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, cannot be parsed as a JSON object, lacks ``data_list_key``,
+            or contains an item that is not a mapping or has a path value of the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Datalist file {data_list_file_path} does not contain the key '{data_list_key}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist {data_list_file_path} must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist {data_list_file_path} must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in entry:
+            item["image"] = _resolve_path(entry["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in entry:
+            item["label"] = _resolve_path(entry["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
