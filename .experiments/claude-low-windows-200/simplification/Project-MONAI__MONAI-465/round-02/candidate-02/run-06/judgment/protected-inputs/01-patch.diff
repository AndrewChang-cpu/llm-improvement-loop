+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+
+    Args:
+        value: a path string, or a list whose elements are all path strings.
+        base_dir: directory that relative paths are joined to.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of
+            each item is a string or list of strings and is resolved against ``base_dir``. If False, the
+            "label" field is left exactly as stored, whatever its type (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist holding the entries. Defaults to "training".
+            If it is "test", each entry is a plain path string and is converted into an item whose only
+            field is "image".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            which means the directory containing ``data_list_file_path``.
+
+    Returns:
+        List[Dict[str, Any]]: the processed items in their original order. Each item is a dict with the
+        same fields as the input item. "image" and, in segmentation mode, "label" hold resolved paths,
+        either as a string or as a list of the same length and order as the input. All other fields are
+        unchanged. For example::
+
+            [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, has an item
+            that is not a mapping, or has a path value of the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' is missing from datalist file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' must hold a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(f"datalist item must be a mapping, got {item!r} in file: {data_list_file_path}")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir)
+        result.append(processed)
+    return result
