+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str) -> Union[str, List[str]]:
+    """Resolve a string or list-of-strings path value against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; must exist.
+        is_segmentation (bool): if True, "label" values are resolved as paths and must be strings or lists
+            of strings. If False, "label" is left exactly as stored (e.g. an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key holding the list of entries, such as "training" or "test".
+            Defaults to "training". Entries under "test" are plain path strings and are converted to
+            items holding only "image".
+        base_dir (str): directory that relative paths are joined to. Defaults to None, which means the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order. Each dict keeps the fields of its input item; "image" (and
+        "label" in segmentation mode) hold resolved paths, as a string or as a list of the same length and
+        order as the input. Other fields are unchanged.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", data_list_key="training", base_dir="/data")
+            # [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}, ...]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"data_list_key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"entries under key '{data_list_key}' must be a list in file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"each datalist item must be a mapping, got {item!r} in file: {data_list_file_path}")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        items.append(new_item)
+    return items
