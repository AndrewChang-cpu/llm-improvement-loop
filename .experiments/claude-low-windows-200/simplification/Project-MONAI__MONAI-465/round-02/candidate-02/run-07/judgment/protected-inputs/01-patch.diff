+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "dataset.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/a.nii", "label": "labelsTr/a.nii", "fold": 0},
+                ]
+            }
+            path = _write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/a.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/a.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/a.nii", "label": 1},
+                    {"image": "imagesTr/b.nii", "label": 0},
+                ]
+            }
+            path = _write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/a.nii")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/b.nii")))
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "img.nii")
+            label = os.path.join(tmp, "lbl.nii")
+            datalist = {"training": [{"image": image, "label": label}]}
+            path = _write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(image))
+            self.assertEqual(items[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imagesTs/a.nii", "imagesTs/b.nii"]}
+            path = _write_datalist(tmp, datalist)
+            items = load_decathalon_datalist(path, True, "test", tmp)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0], {"image": os.path.normpath(os.path.join(tmp, "imagesTs/a.nii"))})
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
