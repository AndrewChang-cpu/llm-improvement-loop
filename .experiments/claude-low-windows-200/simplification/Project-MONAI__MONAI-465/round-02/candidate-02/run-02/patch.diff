+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str) -> Union[str, List[str]]:
+    """Resolve a path string, or each string in a list of path strings, against base_dir."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list) and all(isinstance(element, str) for element in value):
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' value {value!r} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist is for segmentation. When True, "image" and "label" are
+            resolved as paths and must be strings or lists of strings. When False, only "image" is resolved and
+            "label" is left exactly as stored, whatever its type (for example an integer class id).
+        data_list_key (str): key under which the list of entries is stored. Defaults to "training". When the key
+            is "test", the entries are plain path strings and each becomes an item with only an "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None, which
+            means the directory containing data_list_file_path.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as its input
+        entry. "image" (and "label" in segmentation mode) holds a normalized path string, or a list of normalized
+        path strings with the same length and order as the input list. All other fields are copied unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an entry is not a mapping, or a
+            path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for entry in entries:
+        if not isinstance(entry, Mapping):
+            raise ValueError(f"Entry {entry!r} under key '{data_list_key}' in {data_list_file_path} is not a mapping.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label")
+        items.append(item)
+    return items
