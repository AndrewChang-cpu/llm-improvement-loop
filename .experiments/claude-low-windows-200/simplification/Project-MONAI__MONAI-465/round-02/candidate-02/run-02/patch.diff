+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [{"image": "imgs/case0.nii.gz", "label": "labels/case0.nii.gz", "fold": 0}],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"training": [{"image": "imgs/case0.nii.gz", "label": 3}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            image_path = os.path.join(tmp_dir, "case0.nii.gz")
+            label_path = os.path.join(tmp_dir, "case0_label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, is_segmentation=True, data_list_key="training")
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"test": ["imgs/case0.nii.gz", "imgs/case1.nii.gz"]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tmp_dir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(list(result[0].keys()), ["image"])
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
