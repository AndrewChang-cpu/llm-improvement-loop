+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, "label" is resolved
+            as a path (a string or a list of strings). If False, "label" is left exactly as stored,
+            so classification labels such as integer class ids pass through unchanged. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries, e.g. "training" or "test".
+            If it is "test", each entry is a plain path string and is converted to an item holding only
+            "image". Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the
+            directory portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order. Each dict keeps the fields of its input entry. "image" is
+        resolved to a normalized path, as is "label" when ``is_segmentation`` is True. A path value that is
+        a list stays a list of the same length and order. All other fields are unchanged.
+
+        Example::
+
+            [{"image": "/data/imgs/case0.nii.gz", "label": "/data/labels/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as file:
+        data = json.load(file)
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"data list key '{data_list_key}' is missing from file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"data list key '{data_list_key}' must hold a list in file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in items:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"data list item must be a mapping, got {item!r} in file: {data_list_file_path}")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir)
+        result.append(resolved)
+    return result
