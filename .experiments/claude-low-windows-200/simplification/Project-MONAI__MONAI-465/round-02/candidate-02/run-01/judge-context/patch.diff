+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized; absolute strings stay absolute.
+    Lists are resolved element by element and keep their length and order.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory used to resolve relative paths.
+        field (str): name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list elements must be strings, got {type(element).__name__}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its items with
+    ``image`` (and, in segmentation mode, ``label``) paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, resolve the "label" field of each item as a path.
+            If False, "label" is left exactly as stored (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+            When it equals "test", each plain path string is converted to an item with only an "image" field.
+        base_dir (str): directory used to resolve relative paths. If None, the directory portion of
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list with one dictionary per entry, in the original order. Each dictionary keeps the field
+        names of the input item. "image" (and "label" in segmentation mode) hold resolved paths, either
+        as a string or as a list of the same length and order as the input. All other fields are unchanged.
+
+    Example::
+
+        [
+            {"image": "/data/imgs/case_0.nii.gz", "label": "/data/labels/case_0.nii.gz", "extra": 1},
+        ]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in datalist file '{data_list_file_path}' must be a mapping.")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, "image")
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, "label")
+        items.append(resolved)
+    return items
