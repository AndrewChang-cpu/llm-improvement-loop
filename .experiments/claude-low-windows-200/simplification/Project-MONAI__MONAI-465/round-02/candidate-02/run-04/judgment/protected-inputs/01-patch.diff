+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized; absolute strings stay absolute.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the labels are segmentation paths. If True, the "label" field of each
+            item is resolved as a path (a string or a list of strings). If False, "label" is left exactly as
+            stored, whatever its type, such as an integer class id. Default is True.
+        data_list_key (str): key in the top-level JSON object that holds the list of entries. Default is "training".
+            If it is "test", each entry is a plain path string and is converted to an item with only an "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the directory
+            containing ``data_list_file_path`` is used. Default is None.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or an
+            "image" or path "label" value is not a string or a list of strings.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same fields as the input entry.
+        "image" and, when ``is_segmentation`` is True, "label" hold resolved paths, as a string or as a list of
+        the same length and order as the input. All other fields are unchanged. For example::
+
+            [{"image": "/data/img0.nii", "label": "/data/seg0.nii", "fold": 0}]
+
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"data list key '{data_list_key}' is missing in file: {data_list_file_path}")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"data list key '{data_list_key}' must hold a list in file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"data list entry must be a mapping, got {item!r} in file: {data_list_file_path}")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        items.append(new_item)
+    return items
