+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    Lists are resolved element by element, keeping their length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{field}' in datalist file {file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{field}' in datalist file {file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Entries are read from the list stored under ``data_list_key``. The ``"image"`` field of each
+    entry is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; when False it is left exactly as stored, whatever its type (for
+    example an integer class label). Other fields are kept unchanged. If ``data_list_key`` is
+    ``"test"``, each entry is a plain path string and is converted to an item holding only an
+    ``"image"`` field before any other processing.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve the ``"label"`` field. Default is True. When False,
+            ``"label"`` values are returned unchanged and are not type-checked.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Default is
+            ``"training"``. Pass ``"test"`` for a datalist whose entries are plain image path strings.
+        base_dir (str): directory that relative paths are resolved against. Default is None, which
+            uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, in the same order as the datalist entries. Each dict has the input field names.
+        ``"image"`` is a resolved path string, or a list of resolved path strings of the same length and
+        order as the input. In segmentation mode ``"label"`` is resolved in the same way. For example,
+        ``[{"image": "/data/imgs/a.nii", "label": "/data/labels/a.nii", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the JSON does not contain ``data_list_key``, an item is
+            not a mapping, or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Each item in '{data_list_key}' of datalist file {data_list_file_path} must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
