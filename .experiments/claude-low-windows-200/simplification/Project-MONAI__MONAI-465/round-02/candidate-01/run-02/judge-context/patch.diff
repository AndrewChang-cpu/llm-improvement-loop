+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/a.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 3},
+                    {"image": "imgs/b.nii", "label": 1},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs/b.nii")))
+            self.assertEqual(result[1]["label"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "a.nii")
+            label_path = os.path.join(tempdir, "a_label.nii")
+            datalist = {
+                "training": [
+                    {"image": image_path, "label": label_path},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imgs/a.nii",
+                    "imgs/b.nii",
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "imgs/a.nii"))})
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
