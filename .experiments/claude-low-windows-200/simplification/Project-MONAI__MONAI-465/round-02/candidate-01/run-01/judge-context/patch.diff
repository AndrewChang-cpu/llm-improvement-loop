+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path string, or each string of a list of paths, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of field '{field}' in {data_list_file_path} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must exist.
+        is_segmentation (bool): if True, "label" is a path (or list of paths) and is resolved against
+            ``base_dir``. If False, "label" is left exactly as stored, e.g. an integer class label.
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries,
+            e.g. "training" or "validation". When it equals "test", each entry is a plain path string
+            and is converted to an item containing only "image". Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict keeps the input field names. "image" is
+        resolved, and "label" is resolved only when ``is_segmentation`` is True. A resolved path is a
+        normalized string, or a list of normalized strings with the same length and order as the input
+        list. Any other fields are returned unchanged. For example, with ``is_segmentation=True`` an entry
+        ``{"image": "img0.nii", "label": "lbl0.nii", "name": "case0"}`` resolved against ``/data``
+        becomes ``{"image": "/data/img0.nii", "label": "/data/lbl0.nii", "name": "case0"}``.
+
+    Raises:
+        ValueError: if the file does not exist, lacks ``data_list_key``, the entries are not a list,
+            an item is not a mapping, or a path value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is not found in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist file {data_list_file_path} must be a mapping.")
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
