+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized; lists are resolved element by element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element {element!r} must be a string, got {type(element).__name__}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value {value!r} must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Entries are read from the list stored under ``data_list_key``. The ``"image"`` field of every item is resolved
+    against ``base_dir``. The ``"label"`` field is resolved only when ``is_segmentation`` is True; when it is False
+    the label is returned exactly as stored (for example, an integer class label). Other fields are kept unchanged.
+    If ``data_list_key`` is ``"test"``, each plain string entry is wrapped as an image-only item ``{"image": entry}``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; must exist.
+        is_segmentation (bool): if True, resolve the "label" field of each item as a path; if False, leave "label"
+            unchanged. Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+            A datalist without this key raises a ValueError.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, meaning the directory
+            containing ``data_list_file_path``. Absolute paths are kept absolute.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the input field names: "image", and "label" in
+        segmentation mode, hold resolved paths as a string or a list of the same length and order as the input.
+        For example, ``[{"image": "/data/imgs/a.nii", "label": "/data/labels/a.nii", "name": "case0"}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is not
+            a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in file {data_list_file_path} must be a mapping.")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir)
+        output.append(resolved)
+    return output
