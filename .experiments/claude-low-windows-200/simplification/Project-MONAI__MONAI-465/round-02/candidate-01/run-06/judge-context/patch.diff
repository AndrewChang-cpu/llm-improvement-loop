+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path string against ``base_dir``, or each string of a list of path strings.
+
+    Args:
+        value: a string, or a list of strings, to resolve.
+        base_dir: directory that relative paths are joined to.
+        field: name of the datalist field being resolved, used in error messages.
+        file_path: datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of field '{field}' in {file_path} must be a string.")
+        return [_resolve_path(element, base_dir, field, file_path) for element in value]
+    if not isinstance(value, str):
+        raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings, got {value!r}.")
+    return os.path.normpath(os.path.join(base_dir, value))
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries are read from the list stored under ``data_list_key``. The ``"image"`` field of each
+    entry is resolved against ``base_dir``. In segmentation mode, the ``"label"`` field is resolved the
+    same way. In classification mode (``is_segmentation=False``) the ``"label"`` field is returned
+    exactly as stored, whatever its type. All other fields are kept unchanged. When ``data_list_key``
+    is ``"test"``, each plain string entry is converted to an item holding only an ``"image"`` field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each entry as a path, and require
+            it to be a string or list of strings. If False, leave ``"label"`` unchanged. Defaults to True.
+        data_list_key (str): key under the top-level JSON object whose value is the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are joined to. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list with one dict per entry, in the original order. Each dict has the input field names.
+        ``"image"``, and ``"label"`` in segmentation mode, hold resolved paths. A path field is a string
+        when the input was a string, or a list of the same length and order when the input was a list.
+        For example, ``[{"image": "/data/imagesTr/img0.nii.gz", "label": "/data/labelsTr/lbl0.nii.gz"}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path
+            field has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as file:
+        data = json.load(file)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from data list file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Entry {entry!r} under key '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        item = dict(entry)
+        if "image" in entry:
+            item["image"] = _resolve_path(entry["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in entry:
+            item["label"] = _resolve_path(entry["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
