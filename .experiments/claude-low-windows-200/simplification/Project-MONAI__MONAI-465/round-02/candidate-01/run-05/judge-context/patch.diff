+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a path value (a string, or a list of strings) against ``base_dir``.
+
+    A string is joined with ``base_dir`` and normalized. A list keeps its length and order, and each
+    element is resolved independently. Any other type raises ValueError.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list elements must be strings in datalist file {data_list_file_path}, "
+                    f"found {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' must be a string or a list of strings in datalist file {data_list_file_path}, "
+        f"found {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Entries are read from the list stored under ``data_list_key``. When ``is_segmentation`` is True, the
+    "image" and "label" values of each entry are resolved as paths. When it is False, only "image" is
+    resolved and "label" is kept exactly as stored, so classification labels such as integers pass through
+    unchanged. All other fields are kept unchanged. If ``data_list_key`` is "test", each entry is a plain
+    path string and is converted to an item whose only field is "image".
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve "label" as a path. Default is True. When False, "label"
+            is left exactly as stored, whatever its type.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Default is "training".
+            Use "test" for datalists that hold plain image path strings.
+        base_dir (str): directory that relative paths are resolved against. Default is None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order, one per entry. Each dict keeps the input field names. "image"
+        holds a resolved path, or a list of resolved paths of the same length and order as the input. In
+        segmentation mode, "label" is resolved in the same way. For example, an entry
+        ``{"image": "img0.nii", "label": "lbl0.nii", "fold": 0}`` with base_dir ``/data`` becomes
+        ``{"image": "/data/img0.nii", "label": "/data/lbl0.nii", "fold": 0}``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path
+            value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in datalist file {data_list_file_path}.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each entry must be a mapping in datalist file {data_list_file_path}.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+    return items
