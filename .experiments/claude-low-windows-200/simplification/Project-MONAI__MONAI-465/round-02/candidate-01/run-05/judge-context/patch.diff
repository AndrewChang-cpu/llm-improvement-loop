+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/img0.nii", "label": "lbls/./lbl0.nii", "fold": 0},
+                    {
+                        "image": ["imgs/img1a.nii", "imgs/img1b.nii"],
+                        "label": "lbls//lbl1.nii",
+                    },
+                ],
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbls/lbl0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imgs/img1a.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "imgs/img1b.nii")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp_dir, "lbls/lbl1.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"training": [{"image": "img0.nii", "label": 1, "name": "cat"}]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tmp_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["name"], "cat")
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img0.nii")
+            abs_label = os.path.join(tmp_dir, "lbl0.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/test0.nii", "imgs/test1.nii"]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/test0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
