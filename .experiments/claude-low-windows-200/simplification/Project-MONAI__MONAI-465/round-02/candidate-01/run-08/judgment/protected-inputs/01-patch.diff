+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    A string is joined with ``base_dir`` and normalized; absolute strings stay absolute.
+    A list is resolved element by element, keeping its length and order.
+    Any other type raises ValueError.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path
+            and must be a string or list of strings. If False, "label" is left exactly as stored
+            (for example an integer class label) and is not type-checked. Default True.
+        data_list_key (str): top-level key whose value holds the list of entries, such as "training"
+            or "validation". If it is "test", each entry is a plain path string and is converted to an
+            item with only an "image" field. Default "training".
+        base_dir (str): directory that relative paths are resolved against. Default None, which uses
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list with one dict per entry, in the original order. Each dict keeps the input field names.
+        "image" (and "label" in segmentation mode) hold resolved paths: a normalized string, or a list
+        of normalized strings of the same length and order as the input. All other fields are unchanged.
+        For example, ``{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0}``.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, has an
+            entry that is not a mapping, or has an "image" or "label" value of the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in {data_list_file_path} must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each entry under '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
