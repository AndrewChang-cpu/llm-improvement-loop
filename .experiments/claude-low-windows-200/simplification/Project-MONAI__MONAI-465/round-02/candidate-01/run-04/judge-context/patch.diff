+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0},
+                    {"image": "./sub//img1.nii.gz", "label": "sub/seg1.nii.gz", "fold": 1},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "sub", "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "sub", "seg1.nii.gz")))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 0},
+                    {"image": "img1.nii.gz", "label": 2},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img0.nii.gz")
+            abs_label = os.path.join(tempdir, "seg0.nii.gz")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "img0.nii.gz",
+                    "img1.nii.gz",
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(set(result[0].keys()), {"image"})
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
