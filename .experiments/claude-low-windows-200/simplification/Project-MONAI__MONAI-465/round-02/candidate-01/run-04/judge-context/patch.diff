+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, value))
+
+
+def _resolve_field(item: Dict[str, Any], field: str, base_dir: str, data_list_file_path: str) -> None:
+    """Resolve ``item[field]`` in place; it must be a string or a list of strings."""
+    value = item[field]
+    if isinstance(value, str):
+        item[field] = _resolve_path(value, base_dir)
+    elif isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements must be strings in data list file {data_list_file_path}, "
+                    f"got {type(element).__name__}: {element!r}"
+                )
+        item[field] = [_resolve_path(element, base_dir) for element in value]
+    else:
+        raise ValueError(
+            f"'{field}' must be a string or list of strings in data list file {data_list_file_path}, "
+            f"got {type(value).__name__}: {value!r}"
+        )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the image and label paths of a Medical Segmentation Decathlon style datalist JSON file.
+
+    Entries are read from the value stored under ``data_list_key``. Each entry must be a mapping. Its
+    ``"image"`` value is resolved against ``base_dir``, and its ``"label"`` value is resolved too when
+    ``is_segmentation`` is True. When ``is_segmentation`` is False the ``"label"`` value is returned
+    exactly as stored, whatever its type, for example an integer class index. All other fields are kept
+    unchanged. If ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to
+    an item whose only field is ``"image"``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, ``"label"`` values are
+            resolved as paths and must be strings or lists of strings. If False, ``"label"`` is passed
+            through unchanged. Default is True.
+        data_list_key (str): top-level key whose value holds the list of entries. Default is "training".
+            Use "test" for a datalist of image paths only.
+        base_dir (Optional[str]): directory that relative paths are joined to. Default is None, which
+            uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list with one dictionary per entry, in the original order. Each dictionary keeps the field names
+        of its entry. ``"image"`` is a normalized path string or a list of normalized path strings of the
+        same length and order as the input. In segmentation mode, ``"label"`` has the same form. For
+        example, ``[{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, has an entry
+            that is not a mapping, or has an ``"image"`` or segmentation ``"label"`` value that is not a
+            string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist: Any = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"data list file {data_list_file_path} has no key '{data_list_key}'.")
+
+    entries: Any = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"'{data_list_key}' in data list file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"each entry in data list file {data_list_file_path} must be a mapping, got {entry!r}.")
+        item = dict(entry)
+        if "image" in item:
+            _resolve_field(item, "image", base_dir, data_list_file_path)
+        if is_segmentation and "label" in item:
+            _resolve_field(item, "label", base_dir, data_list_file_path)
+        items.append(item)
+
+    return items
