+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": os.path.join("imgs", "a.nii"),
+                        "label": os.path.join("labs", ".", "a.nii"),
+                        "name": "case_a",
+                    },
+                    {
+                        "image": [os.path.join("imgs", "b0.nii"), os.path.join("imgs", "b1.nii")],
+                        "label": os.path.join("labs", "b.nii"),
+                    },
+                ]
+            }
+            path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, True, "training", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labs", "a.nii")))
+            self.assertEqual(result[0]["name"], "case_a")
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imgs", "b0.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "imgs", "b1.nii")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp_dir, "labs", "b.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "a.nii", "label": 1},
+                    {"image": "b.nii", "label": 0},
+                ]
+            }
+            path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, False, "training", tmp_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "a.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "b.nii")))
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img.nii")
+            abs_label = os.path.join(tmp_dir, "lab.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "a.nii",
+                    "b.nii",
+                ]
+            }
+            path = _write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, True, "test", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "a.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
