+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single path string with base_dir and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_value(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """Resolve a path value that is either a string or a list of strings, element by element."""
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' in '{data_list_file_path}' must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(
+        f"'{field}' in '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must name an existing file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path and must be a string
+            or list of strings. If False, "label" is left exactly as stored, whatever its type (for example an
+            integer classification label). The "image" field is always resolved.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries, default "training".
+            If it is "test", each plain string entry is converted to an item whose only field is "image".
+        base_dir (str): directory that relative paths are resolved against. Default is None, which means the
+            directory portion of data_list_file_path. Absolute paths are kept absolute.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as the input
+        entry. "image" holds the resolved path, and "label" holds the resolved path when is_segmentation is True.
+        A resolved value is a normalized string, or a list of normalized strings of the same length and order as
+        the input list. All other fields are copied unchanged. For example, the entry
+        {"image": "imgs/a.nii", "label": "labs/a.nii", "name": "a"} with base_dir "/data" becomes
+        {"image": "/data/imgs/a.nii", "label": "/data/labs/a.nii", "name": "a"}.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path value
+            is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Data list file '{data_list_file_path}' does not contain key '{data_list_key}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Entries under key '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in '{data_list_file_path}' must be a mapping, "
+                f"got {type(item).__name__}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_value(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_value(new_item["label"], base_dir, "label", data_list_file_path)
+        output.append(new_item)
+    return output
