+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imgs/a.nii.gz",
+                        "label": "./labels//a.nii.gz",
+                        "fold": 1,
+                    }
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "./labels//a.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "a.nii.gz",
+                        "label": 3,
+                    },
+                    {
+                        "image": "b.nii.gz",
+                        "label": 0,
+                    },
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "a.nii.gz")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "b.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "img.nii.gz")
+            label_path = os.path.join(tempdir, "seg.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            result = load_decathalon_datalist(file_path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imgs/t1.nii.gz",
+                    "imgs/t2.nii.gz",
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(set(result[0].keys()), {"image"})
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/t1.nii.gz")))
+        finally:
+            for name in os.listdir(tempdir):
+                os.remove(os.path.join(tempdir, name))
+            os.rmdir(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
