+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+
+    Args:
+        value: a string or a list of strings.
+        base_dir: directory that relative paths are joined with.
+        field: name of the datalist field being resolved, used in error messages.
+        file_path: datalist file path, used in error messages.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of '{field}' in {file_path} must be a string.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    In segmentation mode (``is_segmentation=True``) both "image" and "label" fields are resolved. In classification
+    mode (``is_segmentation=False``) only "image" is resolved and "label" is returned exactly as stored, whatever
+    its type. Other fields are never modified. Entries under the "test" key are plain path strings and are
+    converted to items containing only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, resolve "label" as a path (string or list of strings). If False, leave
+            "label" unchanged. Defaults to True.
+        data_list_key (str): top-level key in the datalist holding the list of entries. Defaults to "training".
+            The key must exist in the file, so a datalist with only a "test" key needs ``data_list_key="test"``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning the directory
+            portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the fields of its input entry. "image", and "label"
+        in segmentation mode, hold resolved paths as a string or as a list of the same length and order as the
+        input. For example, with ``base_dir="/data"`` an entry ``{"image": "img.nii", "label": "seg.nii", "name": "a"}``
+        becomes ``{"image": "/data/img.nii", "label": "/data/seg.nii", "name": "a"}``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each entry under '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, "label", data_list_file_path)
+        items.append(out)
+    return items
