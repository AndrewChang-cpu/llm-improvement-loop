+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a path string against ``base_dir``. A list of strings is resolved element by element.
+    Absolute paths are returned unchanged apart from normalization.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' contains a non-string element {element!r}.")
+        return [_resolve_path(element, base_dir, field) for element in value]
+    raise ValueError(f"Field '{field}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field is resolved as a path. If False, the label is
+            returned exactly as stored, so classification labels such as integer class ids are kept.
+            Defaults to True.
+        data_list_key (str): key under which the list of entries is stored in the datalist. Use "test" for
+            the test split, whose entries are plain path strings. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the field names of its entry.
+        The "image" field, and the "label" field in segmentation mode, hold a normalized path string, or a list of
+        normalized path strings of the same length and order as the input list. All other fields are unchanged.
+        Entries under the "test" key are converted to dicts with only an "image" field.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path field is
+            not a string or a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("datalist.json", is_segmentation=True, data_list_key="training")
+        # items[0] -> {"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz"}
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Entry {entry!r} in file '{data_list_file_path}' is not a mapping.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label")
+        items.append(item)
+    return items
