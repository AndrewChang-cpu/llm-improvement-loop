+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "./images//img0.nii",
+                        "label": "labels/lbl0.nii",
+                        "name": "case0",
+                    },
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "images", "img0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels", "lbl0.nii")))
+            self.assertEqual(items[0]["name"], "case0")
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "images/img0.nii",
+                        "label": 1,
+                    },
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, False, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "images", "img0.nii")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img0.nii")
+            abs_label = os.path.join(tmp_dir, "lbl0.nii")
+            datalist = {
+                "training": [
+                    {
+                        "image": abs_image,
+                        "label": abs_label,
+                    },
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "images/img0.nii",
+                    "images/img1.nii",
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "test", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "images", "img0.nii")))
+            self.assertEqual(set(items[0].keys()), {"image"})
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
