+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_field(value: Any, field: str, base_dir: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a path-valued field, which is either a string or a list of strings."""
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist {file_path} must be a string or a list of strings, "
+                    f"found element of type {type(element).__name__}."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist {file_path} must be a string or a list of strings, "
+        f"found type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is treated as a path (string or list of
+            strings) and resolved against ``base_dir``. If False, the "label" value is left exactly as stored,
+            so classification labels such as integer class ids are preserved. Defaults to True.
+        data_list_key (str): top-level key in the datalist that holds the list of entries. Defaults to "training".
+            If it is "test", each entry is a plain path string and is converted to an item with only an "image"
+            field, regardless of ``is_segmentation``.
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the input field names. The "image"
+        field, and the "label" field in segmentation mode, hold a resolved path string, or a list of resolved path
+        strings of the same length and order as the input list. All other fields are unchanged. For example::
+
+            [{"image": "/data/imagesTr/a.nii.gz", "label": "/data/labelsTr/a.nii.gz", "fold": 1}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the datalist, if an
+            entry is not a mapping, or if a path-valued field is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each entry in datalist file {data_list_file_path} must be a mapping, found {entry!r}.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_field(item["image"], "image", base_dir, data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_field(item["label"], "label", base_dir, data_list_file_path)
+        items.append(item)
+
+    return items
