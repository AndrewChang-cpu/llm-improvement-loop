+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            data = {
+                "training": [
+                    {
+                        "image": "imagesTr/a.nii.gz",
+                        "label": "labelsTr/a.nii.gz",
+                        "name": "case_a",
+                    }
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            items = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/a.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/a.nii.gz")))
+            self.assertEqual(items[0]["name"], "case_a")
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            data = {"training": [{"image": "imagesTr/a.nii.gz", "label": 2}]}
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            items = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/a.nii.gz")))
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            image_path = os.path.join(tmp_dir, "img.nii.gz")
+            label_path = os.path.join(tmp_dir, "lbl.nii.gz")
+            data = {"training": [{"image": image_path, "label": label_path}]}
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            items = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+            self.assertTrue(os.path.isabs(items[0]["image"]))
+            self.assertTrue(os.path.isabs(items[0]["label"]))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            data = {"test": ["imagesTs/t0.nii.gz", "imagesTs/t1.nii.gz"]}
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            items = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0], {"image": os.path.normpath(os.path.join(tmp_dir, "imagesTs/t0.nii.gz"))})
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
