+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a single path string, or each string element of a list of paths, against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined to.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {type(element).__name__}: {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    In segmentation mode (``is_segmentation=True``) both the "image" and "label" fields of each item are
+    resolved against ``base_dir``. In classification mode (``is_segmentation=False``) only "image" is resolved and
+    the "label" value is returned exactly as stored, so integer class ids stay integers and class-name strings
+    stay unchanged. Other fields are never modified.
+
+    If ``data_list_key`` is "test", each plain string entry is converted to an item holding only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key whose value holds the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None, which
+            uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict keeps the input field names. "image" (and "label"
+        in segmentation mode) hold a resolved path string, or a list of resolved path strings of the same length
+        and order as the input list. For example:
+        ``[{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' is missing from datalist file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value under key '{data_list_key}' must be a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"datalist item must be a mapping, got {type(item).__name__}: {item!r}")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir)
+        items.append(processed)
+    return items
