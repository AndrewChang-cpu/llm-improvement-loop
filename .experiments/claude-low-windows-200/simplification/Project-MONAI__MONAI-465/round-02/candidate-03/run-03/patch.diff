+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/a.nii.gz",
+                        "label": "labelsTr/a.nii.gz",
+                        "fold": 0,
+                    }
+                ]
+            }
+            path = os.path.join(tmp_dir, "dataset.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/a.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/a.nii.gz", "label": 1},
+                    {"image": "imagesTr/b.nii.gz", "label": 0},
+                ]
+            }
+            path = os.path.join(tmp_dir, "dataset.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/a.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "image.nii.gz")
+            label_path = os.path.join(tmp_dir, "label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            path = os.path.join(tmp_dir, "dataset.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imagesTs/a.nii.gz", "imagesTs/b.nii.gz"]}
+            path = os.path.join(tmp_dir, "dataset.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTs/a.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
