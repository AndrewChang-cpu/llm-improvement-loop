+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string, or a list of strings) against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized independently.
+    """
+    if isinstance(path, str):
+        return os.path.normpath(os.path.join(base_dir, path))
+    if isinstance(path, list):
+        for element in path:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in datalist '{file_path}' must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in path]
+    raise ValueError(f"Field '{field}' value {path!r} in datalist '{file_path}' must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its items with
+    image (and, in segmentation mode, label) paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path and
+            validated as a string or list of strings. If False, the "label" field is returned exactly
+            as stored (for example, an integer class id or a class-name string).
+            Default is True.
+        data_list_key (str): key under the top-level JSON object that holds the list of entries.
+            Default is "training". If it equals "test", each entry is a plain path string and is
+            converted to an item containing only the "image" field.
+        base_dir (str): directory that relative paths are resolved against. Default is None, which
+            uses the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the input field names;
+        "image" (and "label" in segmentation mode) holds the resolved path as a string, or as a list
+        of resolved paths with the same length and order as the input list. All other fields are
+        returned unchanged. For example::
+
+            [{"image": "/data/imgs/case0.nii.gz", "label": "/data/lbls/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist '{data_list_file_path}' must be a mapping.")
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, "label", data_list_file_path)
+        items.append(out)
+
+    return items
