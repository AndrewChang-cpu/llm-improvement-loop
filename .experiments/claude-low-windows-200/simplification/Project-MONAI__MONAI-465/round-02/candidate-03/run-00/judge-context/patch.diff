+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imgs/img0.nii.gz", "label": "lbls/./lbl0.nii.gz", "fold": "0"},
+                ]
+            }
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=True, data_list_key="training", base_dir=tempdir
+            )
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "lbls/lbl0.nii.gz")))
+            self.assertEqual(result[0]["fold"], "0")
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"training": [{"image": "img0.nii.gz", "label": 3}]}
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=False, data_list_key="training", base_dir=tempdir
+            )
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img0.nii.gz")
+            abs_label = os.path.join(tempdir, "lbl0.nii.gz")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["img0.nii.gz", "img1.nii.gz"]}
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(data_list_file_path=path, data_list_key="test", base_dir=tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(set(result[0].keys()), {"image"})
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
