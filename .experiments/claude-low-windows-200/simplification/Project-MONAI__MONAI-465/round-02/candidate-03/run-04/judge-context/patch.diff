+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_field(value: Any, base_dir: str, field: str) -> Any:
+    """
+    Resolve a path value that is either a string or a list of strings.
+
+    Lists are resolved element by element; each element is an independent path.
+    """
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' must be a string, got {type(element).__name__}: {element!r}"
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(f"'{field}' must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Each entry under ``data_list_key`` is returned as a new dictionary with the same field names. The
+    ``"image"`` field is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is returned exactly as stored, so integer class ids and
+    class-name strings are kept unchanged. All other fields are copied unchanged. A path value may be a
+    string, which is joined with ``base_dir`` and normalized, or a list of strings, where each element is
+    resolved independently and the order and length are kept. When ``data_list_key`` is ``"test"``, each
+    plain string entry is first wrapped as ``{"image": entry}``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path. If False, leave the label
+            unchanged, whatever its type. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to ``"training"``.
+            Pass ``"test"`` explicitly for a datalist that only has a ``"test"`` key.
+        base_dir (str): directory that relative paths are joined to. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``, without converting it to an absolute path.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the input field names.
+        ``"image"`` (and ``"label"`` in segmentation mode) holds a resolved path string, or a list of resolved
+        path strings of the same length and order as the input list. For the ``"test"`` key, each dictionary
+        has only the ``"image"`` field.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", ...}, ...]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' must be a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Item {index} in '{data_list_key}' of datalist file {data_list_file_path} must be a mapping, "
+                f"got {type(entry).__name__}: {entry!r}"
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_field(item["image"], base_dir, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_field(item["label"], base_dir, "label")
+        items.append(item)
+
+    return items
