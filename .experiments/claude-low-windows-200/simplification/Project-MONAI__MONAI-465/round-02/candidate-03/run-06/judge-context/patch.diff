+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": "labs/a.nii", "extra": "keep"},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "training", tmp)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labs/a.nii")))
+            self.assertEqual(result[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 1},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, False, "training", tmp)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "a.nii")
+            label = os.path.join(tmp, "a_label.nii")
+            datalist = {"training": [{"image": image, "label": label}]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/a.nii", "imgs/b.nii"]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tmp, "imgs/a.nii"))})
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
