+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single string path with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_field(value: Any, field: str, base_dir: str, data_list_file_path: str) -> Any:
+    """Resolve a "image" or "label" value that is a string or a list of strings."""
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list elements must be strings in datalist file {data_list_file_path}, "
+                    f"got {type(element).__name__}."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(
+        f"Field '{field}' must be a string or a list of strings in datalist file {data_list_file_path}, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is returned exactly as stored, whatever its type (e.g. an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist holding the list of entries. Defaults to "training".
+            If it equals "test", each entry is a plain path string and is converted to an item with only the
+            "image" field.
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary keeps the input field names.
+        "image" (and "label" in segmentation mode) holds the resolved path as a string, or as a list of resolved
+        paths with the same length and order as the input list. All other fields are unchanged. Example::
+
+            [{"image": "/data/imgs/a.nii", "label": "/data/labs/a.nii", "extra": "kept"}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, Mapping) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each entry in datalist file {data_list_file_path} must be a mapping, got {item!r}.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_field(new_item["image"], "image", base_dir, data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_field(new_item["label"], "label", base_dir, data_list_file_path)
+        items.append(new_item)
+
+    return items
