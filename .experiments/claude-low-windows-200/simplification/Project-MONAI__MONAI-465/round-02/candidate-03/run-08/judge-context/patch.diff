+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+__all__ = ["load_decathalon_datalist"]
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is returned exactly as stored (for example, an integer class id or a class-name string)
+            and is not type-checked. Defaults to True.
+        data_list_key (str): top-level key in the datalist that holds the list of entries. Defaults to "training".
+            When it equals "test", each plain path string entry is converted to an item with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps all fields of its entry. The "image"
+        field, and the "label" field when ``is_segmentation`` is True, hold normalized paths: a string when the
+        input was a string, or a list of the same length and order when the input was a list of strings. Other
+        fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path value is
+            neither a string nor a list of strings.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+            # items[0]["image"] and items[0]["label"] are normalized paths under the datalist's directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, Mapping) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' is not a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    fields = ["image", "label"] if is_segmentation else ["image"]
+
+    items: List[Dict[str, Any]] = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, Mapping):
+            raise ValueError(f"Entry {index} in datalist file '{data_list_file_path}' is not a mapping.")
+
+        item = dict(entry)
+        for field in fields:
+            if field not in item:
+                continue
+            value = item[field]
+            if isinstance(value, str):
+                item[field] = _resolve_path(value, base_dir)
+            elif isinstance(value, list):
+                for element in value:
+                    if not isinstance(element, str):
+                        raise ValueError(
+                            f"Element {element!r} of '{field}' in entry {index} of datalist file "
+                            f"'{data_list_file_path}' is not a string."
+                        )
+                item[field] = [_resolve_path(element, base_dir) for element in value]
+            else:
+                raise ValueError(
+                    f"'{field}' in entry {index} of datalist file '{data_list_file_path}' must be a string or a "
+                    f"list of strings, got {type(value).__name__}."
+                )
+        items.append(item)
+
+    return items
