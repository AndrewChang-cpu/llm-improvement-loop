+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list) and all(isinstance(v, str) for v in value):
+        return [os.path.normpath(os.path.join(base_dir, v)) for v in value]
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is left exactly as stored (for example an integer class id or a class-name string).
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries. If it is "test",
+            each plain string entry is converted to an item holding only the "image" field. Defaults to "training".
+        base_dir (str): directory that relative "image" and "label" paths are joined with. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the field names of its entry. The
+        "image" value is a resolved path string, or a list of resolved path strings of the same length and order
+        as the input. In segmentation mode the "label" value has the same form. All other fields are unchanged.
+        Example: ``[{"image": "/data/img0.nii.gz", "label": "/data/lbl0.nii.gz", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, Mapping) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist {data_list_file_path}")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist {data_list_file_path} must map to a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Item under '{data_list_key}' in datalist {data_list_file_path} must be a mapping, got {item!r}"
+            )
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, data_list_file_path, "label")
+        items.append(resolved)
+    return items
