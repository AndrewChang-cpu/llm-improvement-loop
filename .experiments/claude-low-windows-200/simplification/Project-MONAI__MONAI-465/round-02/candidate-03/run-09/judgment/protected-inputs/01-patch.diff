+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value against ``base_dir``. A string is joined with ``base_dir`` and normalized.
+    A list must contain only strings; each element is resolved independently, keeping length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Path list entries must be strings in datalist file {data_list_file_path}, got {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Path value must be a string or a list of strings in datalist file {data_list_file_path}, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with
+    ``image`` (and, in segmentation mode, ``label``) paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist, otherwise a ValueError is raised.
+        is_segmentation (bool): if True, the ``label`` field of each item is resolved as a path. If False, the
+            ``label`` is left exactly as stored (for example an integer class id or a class-name string) and
+            is not type-checked. Defaults to True.
+        data_list_key (str): top-level key under which the list of entries is stored, e.g. "training",
+            "validation" or "test". Defaults to "training". When the key is "test", each plain path entry is
+            converted into an item whose only field is ``image``, regardless of ``is_segmentation``.
+        base_dir (str): directory that relative paths are resolved against. If None, the directory portion of
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the field names of the input.
+        ``image`` (and ``label`` in segmentation mode) holds a normalized path string, or a list of normalized
+        path strings with the same length and order as the input list. All other fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # e.g. [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a
+            path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as file:
+        data = json.load(file)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key {data_list_key} is missing in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key {data_list_key} in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each datalist item must be a mapping in datalist file {data_list_file_path}.")
+
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path)
+        items.append(item)
+
+    return items
