+import json
+import os
+
+
+def _resolve_path_value(value, base_dir, data_list_file_path, data_list_key):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): path or list of paths to resolve.
+        base_dir (str): directory used to join relative paths.
+        data_list_file_path (str): datalist file, used in error messages.
+        data_list_key (str): key holding the value, used in error messages.
+
+    Returns:
+        str or list of str: normalized path(s), with the same list length and order.
+
+    Raises:
+        ValueError: if the value is not a string or a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{data_list_key}' in datalist file '{data_list_file_path}' "
+                    "must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Value {value!r} of '{data_list_key}' in datalist file '{data_list_file_path}' "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load the image and label information of a Medical Segmentation Decathlon datalist JSON file.
+
+    The entries under ``data_list_key`` are returned as a list of dictionaries in the original order.
+    Each entry's "image" value, and its "label" value in segmentation mode, is resolved against ``base_dir``:
+    a relative string is joined with ``base_dir`` and normalized, an absolute string stays absolute, and a
+    list of strings has each element resolved independently. Other fields are returned unchanged. Neither
+    "image" nor "label" is required. In classification mode the "label" value is returned as stored, and it
+    may be any JSON value. If ``data_list_key`` is "test", each entry is a plain path string and is returned
+    as ``{"image": resolved_path}``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file, must name an existing file.
+        is_segmentation (bool): if True, resolve "label" values as paths and require them to be strings or lists
+            of strings; if False, leave "label" values as stored. Defaults to True.
+        data_list_key (str): key of the top-level object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, which uses the directory
+            portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        list of dict: one dictionary per entry, in the original order, with resolved "image" (and "label" in
+        segmentation mode) values and all other fields kept verbatim.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if ``data_list_key`` is missing, if an entry
+            is not a mapping, or if an image or segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        try:
+            json_data = json.load(f)
+        except ValueError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    data = json_data[data_list_key]
+    if not isinstance(data, list):
+        raise ValueError(f"Value of '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        data = [{"image": entry} for entry in data]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    results = []
+    for item in data:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} of '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, data_list_file_path, "label")
+        results.append(processed)
+    return results
