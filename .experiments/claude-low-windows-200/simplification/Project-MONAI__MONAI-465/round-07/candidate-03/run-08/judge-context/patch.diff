+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = self._write_datalist(
+                tmp, {"training": [{"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 0}]}
+            )
+            result = load_decathalon_datalist(datalist, True, "training", tmp)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labels", "a.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = self._write_datalist(tmp, {"training": [{"image": "imgs/a.nii", "label": 2}]})
+            result = load_decathalon_datalist(datalist, False, "training", tmp)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "a.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "image.nii")
+            label = os.path.join(tmp, "label.nii")
+            datalist = self._write_datalist(tmp, {"training": [{"image": image, "label": label}]})
+            result = load_decathalon_datalist(datalist, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = self._write_datalist(tmp, {"test": ["imgs/t0.nii", "imgs/t1.nii"]})
+            result = load_decathalon_datalist(datalist, data_list_key="test", base_dir=tmp)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "t0.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
