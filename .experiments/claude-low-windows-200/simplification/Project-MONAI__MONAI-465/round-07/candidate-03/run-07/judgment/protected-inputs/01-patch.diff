+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, key: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory used to join relative paths.
+        data_list_file_path (str): datalist file, used in error messages.
+        key (str): item key being resolved, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{key}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{key}' value {value!r} in {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The datalist's top-level object must contain ``data_list_key`` with a list of entries. For the
+    ``"test"`` key, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Each entry must be a mapping. Its ``"image"`` value is always resolved when present. Its ``"label"``
+    value is resolved only when ``is_segmentation`` is True; otherwise it is left as stored, so
+    classification labels may be any JSON value, such as an integer class id. All other fields are kept
+    unchanged.
+
+    A path value may be a string or a list of strings. A string is joined with ``base_dir`` and normalized,
+    and an absolute string stays absolute. Each element of a list is resolved independently, keeping length
+    and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. Must name an existing file.
+        is_segmentation (bool): if True, resolve the ``"label"`` value of each item. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries, such as ``"training"`` or
+            ``"test"``. Defaults to ``"training"``.
+        base_dir (Optional[str]): directory used to resolve relative paths. If None, the directory portion
+            of ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        List[Dict[str, Any]]: processed items, in the original order. Each item is a dict copy of the
+        stored entry, with its ``"image"`` and, in segmentation mode, ``"label"`` values resolved.
+
+    Raises:
+        ValueError: if the file does not exist, ``data_list_key`` is missing, an entry is not a mapping,
+            or an image or segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Entry {entry!r} under key '{data_list_key}' in datalist file {data_list_file_path} "
+                f"must be a mapping, got {type(entry).__name__}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+
+    return items
