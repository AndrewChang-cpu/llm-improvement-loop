+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "extra": "keep"}]},
+            )
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tempdir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "seg0.nii.gz")))
+            self.assertEqual(result[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {"training": [{"image": ["a.nii.gz", "b.nii.gz"], "label": 3}]},
+            )
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tempdir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(
+                result[0]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "a.nii.gz")),
+                    os.path.normpath(os.path.join(tempdir, "b.nii.gz")),
+                ],
+            )
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tempdir, "img0.nii.gz")
+            label = os.path.join(tempdir, "seg0.nii.gz")
+            path = self._write_datalist(tempdir, {"training": [{"image": image, "label": label}]})
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tempdir, {"test": ["img0.nii.gz", "img1.nii.gz"]})
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
