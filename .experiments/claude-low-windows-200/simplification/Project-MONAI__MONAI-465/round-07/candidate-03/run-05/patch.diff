+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, data_list_file_path: str, key: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): the stored path or list of paths.
+        base_dir (str): directory used to join relative paths.
+        data_list_file_path (str): datalist file, used in error messages.
+        key (str): datalist key the entry belongs to, used in error messages.
+        field (str): item field name (e.g. "image"), used in error messages.
+
+    Returns:
+        str or list of str: normalized path(s), same type and order as ``value``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements must be strings in datalist '{data_list_file_path}' "
+                    f"under key '{key}', got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' must be a string or list of strings in datalist '{data_list_file_path}' "
+        f"under key '{key}', got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The datalist's ``data_list_key`` must hold a list of entries. For the ``"test"`` key, each
+    entry is a plain path string and is wrapped as ``{"image": entry}``. Otherwise each entry must
+    be a mapping. The ``"image"`` value is always resolved. The ``"label"`` value is resolved only
+    when ``is_segmentation`` is True; otherwise it is returned as stored, so classification labels
+    may be any JSON value (for example an integer class id). Other fields are kept unchanged.
+    Neither ``"image"`` nor ``"label"`` is required.
+
+    A path value may be a string or a list of strings. Strings are joined with ``base_dir`` and
+    normalized; absolute strings stay absolute. Each element of a list is resolved independently,
+    and the list length and order are preserved.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must be an existing file.
+        is_segmentation (bool): if True, resolve the ``"label"`` values as paths; defaults to True.
+        data_list_key (str): top-level key holding the list of entries; defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        list of dict: processed items in the original order. Each item is a dict with resolved
+        ``"image"`` (str or list of str) and, in segmentation mode, resolved ``"label"`` values,
+        plus any other fields unchanged.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, the top-level object is not a
+            mapping or lacks ``data_list_key``, the entries are not a list, an item is not a mapping,
+            or a path value has an invalid type. The message names the file, key, or value.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    try:
+        with open(data_list_file_path) as f:
+            json_data = json.load(f)
+    except ValueError as e:
+        raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(
+                processed["image"], base_dir, data_list_file_path, data_list_key, "image"
+            )
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(
+                processed["label"], base_dir, data_list_file_path, data_list_key, "label"
+            )
+        result.append(processed)
+    return result
