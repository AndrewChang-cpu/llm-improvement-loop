+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, True)
+        return tmp_dir
+
+    def _write_json(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = self._make_dir()
+        data = {
+            "training": [{"image": "img0.nii", "label": "seg0.nii", "extra": 1}],
+        }
+        path = self._write_json(tmp_dir, data)
+        base_dir = os.path.join(tmp_dir, "base")
+        result = load_decathalon_datalist(path, True, "training", base_dir)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "seg0.nii")))
+        self.assertEqual(result[0]["extra"], 1)
+
+    def test_cls_values(self):
+        tmp_dir = self._make_dir()
+        data = {
+            "training": [{"image": "img0.nii", "label": 3}, {"image": ["a.nii", "b.nii"], "label": 0}],
+        }
+        path = self._write_json(tmp_dir, data)
+        base_dir = os.path.join(tmp_dir, "base")
+        result = load_decathalon_datalist(path, False, "training", base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii")))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 3)
+        self.assertEqual(
+            result[1]["image"],
+            [os.path.normpath(os.path.join(base_dir, "a.nii")), os.path.normpath(os.path.join(base_dir, "b.nii"))],
+        )
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_dir()
+        image_path = os.path.join(tmp_dir, "img0.nii")
+        label_path = os.path.join(tmp_dir, "seg0.nii")
+        data = {"training": [{"image": image_path, "label": label_path}]}
+        path = self._write_json(tmp_dir, data)
+        result = load_decathalon_datalist(path, True, "training", None)
+
+        self.assertTrue(os.path.isabs(result[0]["image"]))
+        self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+        self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_dir()
+        data = {"test": ["img0.nii", "img1.nii"]}
+        path = self._write_json(tmp_dir, data)
+        base_dir = os.path.join(tmp_dir, "base")
+        result = load_decathalon_datalist(path, True, "test", base_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii")))
+        self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
