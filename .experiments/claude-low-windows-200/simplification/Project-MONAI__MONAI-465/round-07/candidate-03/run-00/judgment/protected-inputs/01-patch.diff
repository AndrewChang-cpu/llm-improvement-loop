+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_decathalon_json(directory, content):
+    path = os.path.join(directory, "dataset.json")
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, self.tmp_dir, ignore_errors=True)
+
+    def test_seg_values(self):
+        content = {
+            "training": [
+                {"image": "imagesTr/img0.nii.gz", "label": "labelsTr/lbl0.nii.gz", "fold": 0},
+                {"image": "imagesTr/img1.nii.gz", "label": "labelsTr/lbl1.nii.gz", "fold": 1},
+            ]
+        }
+        path = _write_decathalon_json(self.tmp_dir, content)
+        result = load_decathalon_datalist(path, True, "training", self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/img0.nii.gz")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/lbl0.nii.gz")))
+        self.assertEqual(result[0]["fold"], 0)
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTr/img1.nii.gz")))
+        self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(self.tmp_dir, "labelsTr/lbl1.nii.gz")))
+        self.assertEqual(result[1]["fold"], 1)
+
+    def test_cls_values(self):
+        content = {
+            "training": [
+                {"image": "img0.nii.gz", "label": 0},
+                {"image": ["img1a.nii.gz", "img1b.nii.gz"], "label": 3},
+            ]
+        }
+        path = _write_decathalon_json(self.tmp_dir, content)
+        result = load_decathalon_datalist(path, False, "training", self.tmp_dir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "img0.nii.gz")))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 0)
+        self.assertEqual(
+            result[1]["image"],
+            [
+                os.path.normpath(os.path.join(self.tmp_dir, "img1a.nii.gz")),
+                os.path.normpath(os.path.join(self.tmp_dir, "img1b.nii.gz")),
+            ],
+        )
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["label"], 3)
+
+    def test_seg_no_basedir(self):
+        abs_image = os.path.join(self.tmp_dir, "img0.nii.gz")
+        abs_label = os.path.join(self.tmp_dir, "lbl0.nii.gz")
+        content = {"training": [{"image": abs_image, "label": abs_label}]}
+        path = _write_decathalon_json(self.tmp_dir, content)
+        result = load_decathalon_datalist(path, True, "training", None)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        content = {"test": ["imagesTs/test0.nii.gz", "imagesTs/test1.nii.gz"]}
+        path = _write_decathalon_json(self.tmp_dir, content)
+        result = load_decathalon_datalist(path, True, "test", self.tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "imagesTs/test0.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
