+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, key: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string or a list of strings holding relative or absolute paths.
+        base_dir (str): directory that relative paths are joined with.
+        key (str): name of the datalist field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized string for a string input, or a list of normalized strings (same length and order)
+        for a list input.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Elements of '{key}' in {data_list_file_path} must be strings, got {element!r}.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"'{key}' in {data_list_file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object whose ``data_list_key`` value is a list of entries. For the
+    ``"test"`` key, each entry is a plain path string and is wrapped as ``{"image": entry}``. Every other
+    entry must be an object. Its ``"image"`` value, and its ``"label"`` value when ``is_segmentation`` is
+    True, is resolved to a path (or a list of paths). Other fields are returned unchanged.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, ``"label"`` is resolved as a path (string or list of strings).
+            If False, ``"label"`` is returned as stored, so classification labels may be any JSON value
+            such as an integer class id. Defaults to True.
+        data_list_key (str): top-level key whose value holds the entries, e.g. ``"training"`` or
+            ``"test"``. Defaults to ``"training"``.
+        base_dir (Optional[str]): directory that relative paths are joined with. If None, the directory
+            portion of ``data_list_file_path`` is used (not made absolute). Defaults to None.
+
+    Returns:
+        List[Dict[str, Any]]: the processed items, in the original order. Each item is a dict with
+        resolved ``"image"`` (and, in segmentation mode, ``"label"``) fields. Neither key is required.
+        Resolved paths are strings, or lists of strings when the stored value is a list.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, has an entry
+            that is not a mapping, or has an image or segmentation label that is not a string or a list
+            of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file {data_list_file_path} is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed_items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under '{data_list_key}' in datalist file {data_list_file_path} must be a mapping, "
+                f"got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(processed["label"], base_dir, "label", data_list_file_path)
+        processed_items.append(processed)
+
+    return processed_items
