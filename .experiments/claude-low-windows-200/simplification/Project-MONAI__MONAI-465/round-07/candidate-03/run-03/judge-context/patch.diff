+import json
+import os
+
+
+def _resolve_path(value, base_dir, key, data_list_file_path):
+    """
+    Resolve a path value, or each path in a list of paths, against ``base_dir``.
+
+    Args:
+        value (str or list of str): path or list of paths to resolve.
+        base_dir (str): directory joined with relative paths; absolute paths are kept as they are.
+        key (str): name of the datalist field, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path, or a list of normalized paths with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{key}' in {data_list_file_path} must be a string, "
+                    f"but got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Value of '{key}' in {data_list_file_path} must be a string or a list of strings, "
+        f"but got {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The file must be a JSON object containing ``data_list_key``, whose value is a list of entries. For the
+    ``"test"`` key, each entry is a plain path string and is wrapped as ``{"image": entry}``. Every other entry
+    must be a JSON object. Its ``"image"`` value is resolved (a string or a list of strings), and its ``"label"``
+    value is resolved only when ``is_segmentation`` is True. Any other fields are kept verbatim. Keys that are
+    absent are not required.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve each ``"label"`` value as a string or list of strings. If False,
+            leave ``"label"`` unchanged, so classification labels such as integer class ids are returned as stored.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries, for example ``"training"`` or
+            ``"test"``. Defaults to ``"training"``.
+        base_dir (str): directory that relative paths are joined with. Absolute paths are kept as they are.
+            If None, the directory portion of ``data_list_file_path`` is used (not made absolute). Defaults to None.
+
+    Returns:
+        list: processed items in the original order. Each item is a dict with the same fields as its datalist
+        entry, where ``"image"`` (and ``"label"`` in segmentation mode) hold a normalized path string or a list of
+        normalized path strings.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an entry
+            that is not a mapping, or an image or segmentation label that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+    with open(data_list_file_path, encoding="utf-8") as file:
+        try:
+            json_data = json.load(file)
+        except json.JSONDecodeError as err:
+            raise ValueError(f"Data list file {data_list_file_path} is not valid JSON: {err}") from err
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file {data_list_file_path}.")
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Value of key '{data_list_key}' in data list file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for index, item in enumerate(data_list):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {index} of key '{data_list_key}' in data list file {data_list_file_path} must be a "
+                f"mapping, but got {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
