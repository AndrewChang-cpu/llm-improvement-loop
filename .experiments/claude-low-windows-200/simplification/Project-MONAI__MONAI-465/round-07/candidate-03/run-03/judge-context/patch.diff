+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w", encoding="utf-8") as file:
+        json.dump(content, file)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tempdir,
+                {"training": [{"image": "imgs/a.nii", "label": "labels/a.nii", "extra": 7}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/a.nii")))
+            self.assertEqual(result[0]["extra"], 7)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tempdir,
+                {
+                    "training": [
+                        {"image": "imgs/a.nii", "label": 2},
+                        {"image": ["imgs/b.nii", "imgs/c.nii"], "label": 0},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/a.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "imgs/b.nii")),
+                    os.path.normpath(os.path.join(tempdir, "imgs/c.nii")),
+                ],
+            )
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "img.nii")
+            label_path = os.path.join(tempdir, "lbl.nii")
+            path = _write_datalist(tempdir, {"training": [{"image": image_path, "label": label_path}]})
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(tempdir, {"test": ["imgs/t0.nii", "imgs/t1.nii"]})
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/t0.nii")))
+            self.assertEqual(set(result[0].keys()), {"image"})
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
