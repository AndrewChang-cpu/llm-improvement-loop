+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": "imgs/a.nii.gz", "label": "labels/a.nii.gz", "extra": 1}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", tmp_dir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels/a.nii.gz")))
+            self.assertEqual(result[0]["extra"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": "imgs/a.nii.gz", "label": 2}, {"image": ["x/1.nii", "x/2.nii"], "label": 0}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", tmp_dir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "x/1.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "x/2.nii")),
+                ],
+            )
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp_dir, "image.nii.gz")
+            label = os.path.join(tmp_dir, "label.nii.gz")
+            path = self._write_datalist(tmp_dir, {"training": [{"image": image, "label": label}]})
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmp_dir, {"test": ["imgs/t1.nii.gz", "imgs/t2.nii.gz"]})
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/t1.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
