+import json
+import os
+
+
+def _resolve_path(value, base_dir, key, data_list_file_path):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): path or list of paths to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        key (str): name of the datalist field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized paths, with the same type and order as ``value``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{key}' in data list file '{data_list_file_path}' "
+                    "must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Value {value!r} of '{key}' in data list file '{data_list_file_path}' "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load the Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary. The "image" field is always resolved.
+    The "label" field is resolved only when ``is_segmentation`` is True; otherwise it is kept as stored, so
+    classification labels may be any JSON value (for example an integer class id). Other fields are kept
+    unchanged. The "test" key holds plain path strings, which are wrapped as items with only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether the labels are segmentation paths to resolve. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        list of dict: processed items, in the original order. Each item has resolved "image" (and, in
+        segmentation mode, "label") fields. A resolved path is a string, or a list of strings with the
+        same length and order as the stored value.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an image
+            or segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in data list file '{data_list_file_path}' must be a mapping.")
+
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
