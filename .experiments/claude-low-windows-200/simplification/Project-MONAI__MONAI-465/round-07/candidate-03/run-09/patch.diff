+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, key: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value from a Decathalon datalist entry.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        key (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: the normalized path, or a list of normalized paths in the same order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list whose elements are all strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{key}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{key}' value {value!r} in {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object with the key ``data_list_key`` whose value is a list of entries.
+    For the ``"test"`` key, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Every other entry must be a JSON object. Its ``"image"`` value, when present, is resolved. Its ``"label"``
+    value is resolved only when ``is_segmentation`` is True; otherwise it is kept exactly as stored, so
+    classification labels may be any JSON value, such as an integer class id. Other fields are kept unchanged.
+
+    A resolved path is a string joined with ``base_dir`` and normalized; absolute strings stay absolute.
+    A list of strings is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. Must name an existing file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each item; if False, leave it as stored.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory used to resolve relative paths. If None, the directory portion of
+            ``data_list_file_path`` is used (not made absolute). Defaults to None.
+
+    Returns:
+        List[Dict[str, Any]]: processed items, one dict per entry, in the original order. Each dict contains the
+        entry's fields with ``"image"`` (and ``"label"`` in segmentation mode) resolved to a string or a list
+        of strings.
+
+    Raises:
+        ValueError: if the file does not exist, ``data_list_key`` is missing, an item is not a mapping, or an
+            image or segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping, "
+                f"got {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_decathalon_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_decathalon_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
