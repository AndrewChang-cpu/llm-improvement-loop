+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": "img.nii.gz", "label": "lbl.nii.gz", "extra": "keep"}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", tmp_dir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbl.nii.gz")))
+            self.assertEqual(items[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": "img.nii.gz", "label": 2}]},
+            )
+            items = load_decathalon_datalist(path, False, "training", tmp_dir)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img.nii.gz")))
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img.nii.gz")
+            abs_label = os.path.join(tmp_dir, "lbl.nii.gz")
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": abs_image, "label": abs_label}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmp_dir, {"test": ["t1.nii.gz", "t2.nii.gz"]})
+            items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "t1.nii.gz")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
