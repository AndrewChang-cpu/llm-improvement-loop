+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _type_error_message(name: str, key: str, file_path: str, value: Any) -> str:
+    """
+    Build the error message for a value that is not a string or list of strings.
+
+    Args:
+        name (str): field name of the value, such as "image" or "label".
+        key (str): datalist key of the entry.
+        file_path (str): datalist file path.
+        value (Any): offending value.
+
+    Returns:
+        str: error message naming the field, key, file and value.
+    """
+    return f"Field '{name}' in key '{key}' of file '{file_path}' must be a string or list of strings, found {value!r}."
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, key: str, name: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (str or list of str): path string or list of path strings to resolve.
+        base_dir (str): directory used to join relative paths.
+        file_path (str): datalist file path, used in error messages.
+        key (str): datalist key of the entry, used in error messages.
+        name (str): field name of the value, used in error messages.
+
+    Returns:
+        str or list of str: normalized paths; absolute paths are kept absolute.
+
+    Raises:
+        ValueError: if the value is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(_type_error_message(name, key, file_path, element))
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(_type_error_message(name, key, file_path, value))
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary. The ``"image"`` value is
+    resolved against ``base_dir``. In segmentation mode the ``"label"`` value is resolved too;
+    otherwise it is left exactly as stored, so classification labels may be any JSON value
+    such as an integer class id. Other fields are kept unchanged. Neither key is required.
+    If ``data_list_key`` is ``"test"``, the entries are plain path strings and each one is
+    wrapped as ``{"image": path}`` before resolution.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the labels are segmentation paths to resolve.
+            Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        list of dict: processed items in the original order. A string value is resolved to
+        a normalized path; a list value is resolved element by element, keeping its length and order.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``,
+            contains a non-mapping item, or has an image or segmentation label that is not
+            a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        try:
+            data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            message = f"Item {item!r} under key '{data_list_key}' in '{data_list_file_path}' is not a mapping."
+            raise ValueError(message)
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(
+                processed["image"],
+                base_dir,
+                data_list_file_path,
+                data_list_key,
+                "image",
+            )
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(
+                processed["label"],
+                base_dir,
+                data_list_file_path,
+                data_list_key,
+                "label",
+            )
+        result.append(processed)
+    return result
