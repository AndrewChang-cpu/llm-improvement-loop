+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_decathalon_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp(prefix="decathalon_")
+        try:
+            path = self._write_decathalon_datalist(
+                tmp,
+                {"training": [{"image": "imgs/a.nii", "label": "labels/a.nii", "extra": 7}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", tmp)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "labels/a.nii")))
+            self.assertEqual(items[0]["extra"], 7)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp(prefix="decathalon_")
+        try:
+            path = self._write_decathalon_datalist(
+                tmp,
+                {"training": [{"image": "imgs/a.nii", "label": 2}, {"image": "imgs/b.nii", "label": 0}]},
+            )
+            items = load_decathalon_datalist(path, False, "training", tmp)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii")))
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp, "imgs/b.nii")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp(prefix="decathalon_")
+        try:
+            image_path = os.path.join(tmp, "a.nii")
+            label_path = os.path.join(tmp, "a_label.nii")
+            path = self._write_decathalon_datalist(
+                tmp,
+                {"training": [{"image": image_path, "label": label_path}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp(prefix="decathalon_")
+        try:
+            path = self._write_decathalon_datalist(
+                tmp,
+                {"test": ["imgs/t0.nii", "imgs/t1.nii"]},
+            )
+            items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/t0.nii")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
