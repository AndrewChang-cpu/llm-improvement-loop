+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Strings are joined with `base_dir` and normalized; absolute strings stay absolute.
+    Lists are resolved element by element, keeping length and order.
+
+    Args:
+        value (str or list of str): the stored path value.
+        base_dir (str): directory the relative paths are joined with.
+        field (str): name of the datalist key holding `value`, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        The resolved path string, or a list of resolved path strings.
+
+    Raises:
+        ValueError: if `value` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{field}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{field}' in {data_list_file_path} must be a string or list of strings, "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the image and label paths of a Medical Segmentation Decathlon datalist JSON file.
+
+    The top-level object of the file must contain `data_list_key`, whose value is a list of entries.
+    If `data_list_key` is "test", each entry is a plain path string and is wrapped as an item
+    holding only an "image" field, regardless of `is_segmentation`.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the entries are for segmentation. If True, "label" is resolved
+            as a path (it must be a string or list of strings). If False, "label" is left exactly as stored
+            and may be any JSON value, such as an integer class id. Defaults to True.
+        data_list_key (str): key of the datalist holding the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion
+            of `data_list_file_path` is used (not made absolute). Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. "image" and, in segmentation
+        mode, "label" are resolved to paths (a string, or a list of strings with the same length and
+        order). Neither key is required. All other fields are kept unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks `data_list_key`, an entry is
+            not a mapping, or an image or segmentation label is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    try:
+        with open(data_list_file_path, "r") as f:
+            data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"Datalist file {data_list_file_path} is not valid JSON: {e}") from e
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under '{data_list_key}' in datalist file {data_list_file_path} "
+                f"must be a mapping, got {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
