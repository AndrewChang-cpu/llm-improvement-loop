+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_key: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the path string or list of path strings to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the item field being resolved, used in error messages.
+        data_list_key (str): key of the datalist the value came from, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is not a string or a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{field}' under key '{data_list_key}' in "
+                    f"'{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' under key '{data_list_key}' in '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object with ``data_list_key`` mapping to a list of entries. For the key
+    ``"test"`` each entry is a plain path string and is wrapped as ``{"image": entry}``. Otherwise each entry must
+    be a mapping. Its ``"image"`` value is resolved when present. Its ``"label"`` value is resolved only when
+    ``is_segmentation`` is True and the field is present. Neither field is required, and all other fields are
+    returned unchanged. Image and segmentation label values must be strings or lists of strings. Classification
+    labels are not type-checked.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve the ``"label"`` field of each entry. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning the directory
+            that contains ``data_list_file_path``.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order. Each dictionary holds the entry's fields with
+        ``"image"`` (and ``"label"`` in segmentation mode) replaced by normalized paths. Paths are strings, or lists
+        of strings with the same length and order as the input list.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains entries or
+            path values of an unexpected type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+    try:
+        with open(data_list_file_path, "r") as f:
+            json_data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"Data list file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file '{data_list_file_path}' must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(f"Entry {index} under key '{data_list_key}' in '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_key, data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_key, data_list_file_path)
+        processed.append(new_item)
+    return processed
