+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        path = self._write_datalist({"training": [{"image": "img0.nii.gz", "label": "lbl0.nii.gz", "extra": 7}]})
+        items = load_decathalon_datalist(path, True, "training", self.tmp_dir)
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "img0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(self.tmp_dir, "lbl0.nii.gz")))
+        self.assertEqual(items[0]["extra"], 7)
+
+    def test_cls_values(self):
+        path = self._write_datalist({"training": [{"image": "img0.nii.gz", "label": 2}]})
+        items = load_decathalon_datalist(path, False, "training", self.tmp_dir)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "img0.nii.gz")))
+        self.assertEqual(items[0]["label"], 2)
+        self.assertIsInstance(items[0]["label"], int)
+
+    def test_seg_no_basedir(self):
+        image = os.path.join(self.tmp_dir, "img.nii.gz")
+        label = os.path.join(self.tmp_dir, "lbl.nii.gz")
+        path = self._write_datalist({"training": [{"image": image, "label": label}]})
+        items = load_decathalon_datalist(path, True, "training", None)
+        self.assertEqual(items[0]["image"], os.path.normpath(image))
+        self.assertEqual(items[0]["label"], os.path.normpath(label))
+
+    def test_seg_no_labels(self):
+        path = self._write_datalist({"test": ["t0.nii.gz", "t1.nii.gz"]})
+        items = load_decathalon_datalist(path, True, "test", self.tmp_dir)
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(self.tmp_dir, "t0.nii.gz")))
+        self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
