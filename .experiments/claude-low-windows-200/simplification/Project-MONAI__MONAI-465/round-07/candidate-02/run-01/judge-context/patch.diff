+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the datalist field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list elements of '{field}' in {file_path} must be strings, got {type(element).__name__}: "
+                    f"{element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{field}' in {file_path} must be a string or a list of strings, got {type(value).__name__}: {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must contain a top-level JSON object with the key ``data_list_key`` whose value is a list of entries.
+    Each non-``"test"`` entry must be a mapping. Its ``"image"`` field is resolved, and in segmentation mode its
+    ``"label"`` field is resolved too. A field may be a string or a list of strings; each list element is resolved
+    independently and the length and order are kept. Neither field is required. In classification mode the
+    ``"label"`` field is kept unchanged and may hold any JSON value. All other fields are kept verbatim.
+
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``
+    before validation, regardless of ``is_segmentation``.
+
+    Relative paths are joined with ``base_dir`` and normalized. Absolute paths stay absolute.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether to resolve the ``"label"`` field as a segmentation mask. Defaults to True.
+        data_list_key (str): top-level key whose value holds the entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, meaning the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of processed item dictionaries, in the same order as the entries in the file.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if the top-level object lacks
+            ``data_list_key``, if an entry is not a mapping, or if an image or segmentation label is not a
+            string or a list of strings.
+    """
+    if not isinstance(data_list_file_path, str) or not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file {data_list_file_path!r} does not exist")
+
+    try:
+        with open(data_list_file_path, "r") as f:
+            json_data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"datalist file {data_list_file_path} is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file {data_list_file_path}")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"entry {index} under key '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"got {type(item).__name__}: {item!r}"
+            )
+        result = dict(item)
+        if "image" in result:
+            result["image"] = _resolve_path(result["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in result:
+            result["label"] = _resolve_path(result["label"], base_dir, "label", data_list_file_path)
+        processed.append(result)
+    return processed
