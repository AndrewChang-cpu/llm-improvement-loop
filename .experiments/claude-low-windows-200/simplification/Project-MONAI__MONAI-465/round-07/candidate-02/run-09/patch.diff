+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, key: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        key (str): datalist key the entry belongs to, used in error messages.
+        field (str): name of the item field being resolved, used in error messages.
+
+    Returns:
+        A normalized string path, or a list of normalized string paths with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in key '{key}' of {file_path} must be a string or a list of strings, "
+                    f"found element {element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in key '{key}' of {file_path} must be a string or a list of strings, found {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key`` whose value is a list of entries. Each entry must be
+    a JSON object. The ``"image"`` field is resolved in every mode. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; in classification mode it is kept unchanged and may hold any JSON value.
+    Fields that are absent are not required and are not added. All other fields are kept verbatim.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as an item whose only
+    field is ``"image"``, regardless of ``is_segmentation``.
+
+    Paths are resolved as follows: a string is joined with ``base_dir`` and normalized, so an absolute string stays
+    absolute. A list must contain only strings, and each element is resolved independently with the same rules.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve ``"label"`` fields as paths. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, meaning the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary holds the entry's fields with
+        resolved ``"image"`` (and, in segmentation mode, ``"label"``) values, where a value is a string or a list of
+        strings of the same length as the input.
+
+    Raises:
+        ValueError: if the datalist file does not exist or is not valid JSON, if ``data_list_key`` is missing, if an
+            entry is not a JSON object, or if an image or segmentation label is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        try:
+            data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file is not valid JSON: {data_list_file_path}") from e
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list of entries")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    fields = ["image", "label"] if is_segmentation else ["image"]
+    items: List[Dict[str, Any]] = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Entry {index} under key '{data_list_key}' in {data_list_file_path} must be a JSON object, "
+                f"found {entry!r}"
+            )
+        item = dict(entry)
+        for field in fields:
+            if field in item:
+                item[field] = _resolve_path(item[field], base_dir, data_list_file_path, data_list_key, field)
+        items.append(item)
+
+    return items
