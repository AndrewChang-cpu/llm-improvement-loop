+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "extra": 5}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", tmp_dir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "seg0.nii.gz")))
+            self.assertEqual(items[0]["extra"], 5)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": "img0.nii.gz", "label": 1}, {"image": "img1.nii.gz", "label": 0}]},
+            )
+            items = load_decathalon_datalist(path, False, "training", tmp_dir)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "img1.nii.gz")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 1)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "image.nii.gz")
+            abs_label = os.path.join(tmp_dir, "label.nii.gz")
+            path = self._write_datalist(tmp_dir, {"training": [{"image": abs_image, "label": abs_label}]})
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmp_dir, {"test": ["img0.nii.gz", "img1.nii.gz"]})
+            items = load_decathalon_datalist(path, True, "test", tmp_dir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
