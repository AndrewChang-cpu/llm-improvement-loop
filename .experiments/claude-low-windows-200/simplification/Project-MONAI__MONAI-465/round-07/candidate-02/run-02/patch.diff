+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {"training": [{"image": "img0.nii.gz", "label": "lbl0.nii.gz", "fold": 1}]}
+            path = self._write_datalist(tmp_dir, data)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbl0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {"training": [{"image": "img0.nii.gz", "label": 1}, {"image": "img1.nii.gz", "label": 0}]}
+            path = self._write_datalist(tmp_dir, data)
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp_dir, "img0.nii.gz")
+            label = os.path.join(tmp_dir, "lbl0.nii.gz")
+            data = {"training": [{"image": image, "label": label}]}
+            path = self._write_datalist(tmp_dir, data)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {"test": ["img0.nii.gz", "img1.nii.gz"]}
+            path = self._write_datalist(tmp_dir, data)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
