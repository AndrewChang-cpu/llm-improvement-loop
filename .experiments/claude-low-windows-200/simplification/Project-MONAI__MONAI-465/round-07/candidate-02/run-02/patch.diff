+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str, key: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value (str or list of str): path or list of paths to resolve
+        base_dir (str): directory used to join relative paths
+        key (str): name of the datalist field being resolved, used in error messages
+        file_path (str): datalist file path, used in error messages
+
+    Returns:
+        (str or list of str): normalized paths, with the same type and length as `value`
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"every element of '{key}' in datalist file '{file_path}' must be a string, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"'{key}' in datalist file '{file_path}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The top-level JSON object must contain `data_list_key`, whose value is a list of entries. For the key "test",
+    each entry is a plain path string and is wrapped as an item with only an "image" field. Each other entry must be
+    a mapping. Its "image" field is resolved, and in segmentation mode its "label" field is resolved too. Neither
+    field is required. Values may be a string or a list of strings; each list element is resolved independently.
+    Relative paths are joined with `base_dir` and normalized, while absolute paths are kept as they are. Other
+    fields are kept unchanged. In classification mode, "label" is not resolved and may hold any JSON value.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file, which must exist
+        is_segmentation (bool): whether to resolve the "label" field of each item as a path. Defaults to True.
+        data_list_key (str): key in the top-level JSON object holding the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, which means the directory
+            containing `data_list_file_path`.
+
+    Returns:
+        (list of dict): processed items in the original order of the datalist. Each item is a dict containing the
+        resolved "image" (and, in segmentation mode, "label") fields plus any other fields from the entry.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if `data_list_key` is missing, if an item is
+            not a mapping, or if an image or segmentation label is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    try:
+        with open(data_list_file_path) as f:
+            json_data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list of entries.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(f"every entry in datalist file '{data_list_file_path}' must be a mapping, got {item!r}.")
+        processed = dict(item)
+        fields = ["image", "label"] if is_segmentation else ["image"]
+        for field in fields:
+            if field in processed:
+                processed[field] = _resolve_path(processed[field], base_dir, field, data_list_file_path)
+        result.append(processed)
+    return result
