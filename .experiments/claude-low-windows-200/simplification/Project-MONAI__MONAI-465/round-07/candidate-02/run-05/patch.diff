+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): the path or list of paths to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the datalist field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is not a string or a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements in datalist file '{data_list_file_path}' must be strings, "
+                    f"got {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, got {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The top-level JSON object must contain ``data_list_key`` whose value is a list of entries. For the key ``"test"``,
+    each entry is a plain path string and is wrapped as ``{"image": entry}``. For other keys, each entry must be a
+    JSON object. Its ``"image"`` value, if present, is resolved as a string or a list of strings. Its ``"label"``
+    value is resolved the same way only when ``is_segmentation`` is True; in classification mode the label is kept
+    unchanged and may be any JSON value. All other fields are kept verbatim. Neither ``"image"`` nor ``"label"`` is
+    required.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths stay absolute. List elements are each
+    resolved independently, and their length and order are preserved.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must name an existing file.
+        is_segmentation (bool): whether entries are segmentation cases, so that ``"label"`` is resolved as a path.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries, such as ``"training"`` or
+            ``"test"``. Defaults to ``"training"``.
+        base_dir (str, optional): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory containing ``data_list_file_path``.
+
+    Returns:
+        list of dict: the processed items, in the same order as in the datalist. Each item is a dict whose
+        ``"image"`` (and, in segmentation mode, ``"label"``) values are normalized paths or lists of paths.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if ``data_list_key`` is missing, if an entry is
+            not a mapping, or if an image or segmentation label is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist")
+    try:
+        with open(data_list_file_path) as f:
+            datalist = json.load(f)
+    except (OSError, ValueError) as e:
+        raise ValueError(f"datalist file '{data_list_file_path}' could not be read as JSON: {e}") from e
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"datalist file '{data_list_file_path}' does not contain key '{data_list_key}'")
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file '{data_list_file_path}' must map to a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"entries under key '{data_list_key}' in datalist file '{data_list_file_path}' must be objects, "
+                f"got {item!r}"
+            )
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, "label", data_list_file_path)
+        processed.append(out)
+    return processed
