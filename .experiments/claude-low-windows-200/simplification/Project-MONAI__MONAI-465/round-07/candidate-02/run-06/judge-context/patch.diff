+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, key: str, file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        key (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized string path, or a list of normalized string paths with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{key}' in datalist '{file_path}' must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{key}' in datalist '{file_path}' must be a string or a list of strings, found {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object whose ``data_list_key`` value is a list of entries. Each entry is
+    a mapping. If ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as
+    ``{"image": entry}`` before validation, so label-less test entries are accepted.
+
+    In segmentation mode, both ``"image"`` and ``"label"`` are resolved. In classification mode, only
+    ``"image"`` is resolved and ``"label"`` is kept unchanged, so its value may be any JSON value. Other fields
+    are always kept unchanged. Neither ``"image"`` nor ``"label"`` is required.
+
+    A path value that is a string is joined with ``base_dir`` and normalized; an absolute string stays absolute.
+    A path value that is a list of strings has each element resolved independently, keeping length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether the entries are segmentation entries, so that ``"label"`` is resolved as a
+            path. Defaults to True.
+        data_list_key (str): key in the top-level object whose value is the list of entries. Defaults to
+            ``"training"``.
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, which uses the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        List[Dict[str, Any]]: one dictionary per entry, in the original order. For the ``"test"`` key, each
+        dictionary holds only the resolved ``"image"`` field. For other keys, each dictionary holds all fields of
+        the original entry, with path fields resolved.
+
+    Raises:
+        ValueError: if the file does not exist, is not a JSON object, lacks ``data_list_key``, has an entry that
+            is not a mapping, or has a path field that is not a string or a list of strings. The message names the
+            offending file, key, or value.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Datalist file '{data_list_file_path}' must contain a top-level JSON object.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry in datalist file '{data_list_file_path}' must be a JSON object, found {item!r}."
+            )
+
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
