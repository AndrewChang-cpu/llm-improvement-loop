+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        data_list_file_path (str): datalist file name, used in error messages.
+        field (str): name of the item field being resolved, used in error messages.
+
+    Returns:
+        str or list of str: normalized path for a string, or a list of normalized paths
+        with the same length and order for a list.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' in datalist file {data_list_file_path} must be a string, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in datalist file {data_list_file_path} must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its items with resolved paths.
+
+    The file must contain a top-level object with the key ``data_list_key`` whose value is a list of entries.
+    For the key "test", each entry is a plain path string and is wrapped as an item with only an "image" field.
+    Every other entry must be an object. The "image" field is resolved in all modes. The "label" field is
+    resolved only when ``is_segmentation`` is True; for classification, labels are returned unchanged and may be
+    any JSON value. Other fields are kept verbatim. A string path is joined with ``base_dir`` and normalized,
+    and an absolute path stays absolute. A list of paths is resolved element by element, keeping its length and
+    order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the items are segmentation items, in which case "label" is resolved.
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value holds the entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        list of dict: processed items in the original order. Each item is a dict containing the fields of the
+        original entry, with "image" (and "label" in segmentation mode) replaced by resolved paths. Items from
+        the "test" key contain only the "image" field.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an entry
+            that is not an object, or an image or segmentation label that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        try:
+            json_data = json.load(f)
+        except ValueError as e:
+            raise ValueError(f"Datalist file {data_list_file_path} is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Every entry under key '{data_list_key}' in datalist file {data_list_file_path} must be an object, "
+                f"got {entry!r}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+    return items
