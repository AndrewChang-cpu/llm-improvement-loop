+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory: str, name: str, content: dict) -> str:
+    path = os.path.join(directory, name)
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tmpdir,
+                "seg.json",
+                {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 1}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", tmpdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmpdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmpdir, "seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_cls_values(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tmpdir,
+                "cls.json",
+                {"training": [{"image": "img0.nii.gz", "label": 3}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", tmpdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmpdir, "img0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 3)
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_seg_no_basedir(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmpdir, "img0.nii.gz")
+            abs_label = os.path.join(tmpdir, "seg0.nii.gz")
+            path = _write_datalist(
+                tmpdir,
+                "abs.json",
+                {"training": [{"image": abs_image, "label": abs_label}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_seg_no_labels(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tmpdir,
+                "test.json",
+                {"test": ["t0.nii.gz", "t1.nii.gz"]},
+            )
+            result = load_decathalon_datalist(path, True, "test", tmpdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmpdir, "t0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmpdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
