+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, where: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string or a list of path strings against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        where (str): description of the location of ``value``, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"{where} must be a string or a list of strings; list element {element!r} is not.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"{where} must be a string or a list of strings; got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key`` mapping to a list of entries. For the key ``"test"``,
+    each entry is a plain path string, which is wrapped as an item ``{"image": entry}``. Otherwise each entry must be
+    an object. In segmentation mode, the ``"image"`` and ``"label"`` values are resolved; in classification mode only
+    ``"image"`` is resolved and ``"label"`` is returned unchanged, with any JSON value allowed. Neither field is
+    required. Other fields are kept verbatim. A string path is joined with ``base_dir`` and normalized, and an absolute
+    path stays absolute. A list of paths is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must name an existing file.
+        is_segmentation (bool): whether the entries are segmentation items, so that ``"label"`` is resolved as a path.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to ``"training"``.
+        base_dir (Optional[str]): directory used to resolve relative paths. Defaults to None, meaning the directory
+            containing ``data_list_file_path``.
+
+    Returns:
+        List[Dict[str, Any]]: the processed items, in the original order. Each item is a dictionary with the resolved
+        ``"image"`` (and, in segmentation mode, ``"label"``) values and all other fields copied unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or an image or
+            segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list file '{data_list_file_path}' has no key '{data_list_key}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file '{data_list_file_path}' must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    fields_to_resolve = ("image", "label") if is_segmentation else ("image",)
+
+    processed: List[Dict[str, Any]] = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in data list file '{data_list_file_path}' must be a mapping."
+            )
+        result = dict(item)
+        for field in fields_to_resolve:
+            if field in result:
+                where = f"Field '{field}' of item {index} under key '{data_list_key}' in '{data_list_file_path}'"
+                result[field] = _resolve_path(result[field], base_dir, where)
+        processed.append(result)
+
+    return processed
