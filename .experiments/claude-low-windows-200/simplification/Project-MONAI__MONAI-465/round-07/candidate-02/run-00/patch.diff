+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against `base_dir`.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory against which relative paths are joined.
+        field (str): name of the datalist field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        (str or list of str): the normalized path, or a list of normalized paths with the same order and length.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Datalist '{file_path}': list elements for key '{field}' must be strings, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Datalist '{file_path}': value for key '{field}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The top-level JSON object must contain `data_list_key`, whose value is a list of entries. When `data_list_key`
+    is "test", each entry is a plain path string and is wrapped as an item with only an "image" field, regardless of
+    `is_segmentation`. Every item must be a mapping. The "image" field, when present, is resolved. In segmentation
+    mode the "label" field, when present, is also resolved. Values are resolved as follows: a string is joined with
+    `base_dir` and normalized (an absolute string stays absolute), and a list of strings has each element resolved
+    independently, keeping its length and order. Other fields are kept unchanged. Classification labels are not
+    type-checked and are kept as they are.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the items are segmentation cases, in which case "label" is resolved as a
+            path. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory against which relative paths are resolved. Defaults to None, meaning the directory
+            containing `data_list_file_path` (not made absolute).
+
+    Returns:
+        (list of dict): the processed items, in the original order. Each item is a dict holding the original fields,
+        with "image" (and "label" in segmentation mode) replaced by resolved path strings or lists of path strings
+        when present.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks `data_list_key`, contains a non-mapping item,
+            or has an "image" or segmentation "label" value that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item in key '{data_list_key}' of datalist file '{data_list_file_path}' must be a mapping."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path_value(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path_value(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+    return processed
