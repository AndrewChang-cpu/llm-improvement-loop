+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        data_list_file_path (str): datalist file path, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"List elements of field '{field}' in '{data_list_file_path}' must be strings, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in '{data_list_file_path}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its image and label paths.
+
+    The top-level JSON object must contain ``data_list_key``, whose value is a list of entries. If
+    ``data_list_key`` is "test", each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Otherwise each entry must be a JSON object.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths are kept absolute. A value
+    may be a string or a list of strings, and list elements are resolved independently. Other fields in
+    each entry are returned unchanged. Labels are only resolved when ``is_segmentation`` is True; in
+    classification mode the "label" field is kept as-is, and its value may be any JSON value. Entries
+    without "image" or "label" are accepted.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether "label" fields are path(s) to be resolved. Defaults to True.
+        data_list_key (str): key in the JSON object whose list of entries is loaded. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, which means the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        a list of dicts, one per entry, in the original order. Each dict holds the entry's fields, with
+        "image" (and "label" in segmentation mode) replaced by resolved path string(s).
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or an
+            image or segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Top-level JSON value in '{data_list_file_path}' must be an object.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each entry under key '{data_list_key}' in '{data_list_file_path}' must be an object.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
