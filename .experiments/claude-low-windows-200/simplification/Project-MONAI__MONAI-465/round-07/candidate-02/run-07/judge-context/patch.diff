+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            content = {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0}]}
+            path = self._write_datalist(tmpdir, content)
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmpdir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmpdir, "img0.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmpdir, "seg0.nii.gz")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_cls_values(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmpdir, {"training": [{"image": "img0.nii.gz", "label": 1}]})
+            items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmpdir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmpdir, "img0.nii.gz")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 1)
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_seg_no_basedir(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmpdir, "img0.nii.gz")
+            label = os.path.join(tmpdir, "seg0.nii.gz")
+            path = self._write_datalist(tmpdir, {"training": [{"image": image, "label": label}]})
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(image))
+            self.assertEqual(items[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_seg_no_labels(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmpdir, {"test": ["img0.nii.gz", "img1.nii.gz"]})
+            items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmpdir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmpdir, "img0.nii.gz")))
+        finally:
+            shutil.rmtree(tmpdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
