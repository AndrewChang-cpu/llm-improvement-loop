+import json
+import os
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: "str | None" = None,
+) -> list:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The top-level object must contain ``data_list_key`` whose value is a list of entries. When the key is
+    "test", each entry is a plain path string and is wrapped as an item whose only field is "image".
+    Every other entry must be an object. Its "image" value is resolved, and its "label" value is resolved
+    only when ``is_segmentation`` is True; otherwise the label is left exactly as stored, so classification
+    labels may be any JSON value. Other fields are kept verbatim. Items that lack "image" or "label" are
+    accepted. A string path is joined with ``base_dir`` and normalized, an absolute path stays absolute,
+    and a list of strings is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file, which must exist.
+        is_segmentation (bool): whether "label" values are segmentation paths to resolve. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        list: the processed items as dictionaries, in their original order. Each item is a dictionary,
+        including the items built from a "test" key, which contain only an "image" field.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, the key is missing or not a list,
+            an item is not a mapping, or an image or segmentation label is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+    try:
+        with open(data_list_file_path, "r", encoding="utf-8") as f:
+            data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"Datalist file is not valid JSON: {data_list_file_path}: {e}") from e
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' must be a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item must be a mapping in datalist file: {data_list_file_path}: {item!r}")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
+
+
+def _resolve_path(value, base_dir, data_list_file_path, field):
+    """Resolve a string or list-of-strings path value against ``base_dir``; raise ValueError otherwise."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' must be a string in datalist file: {data_list_file_path}: {element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{field}' must be a string or list of strings in datalist file: {data_list_file_path}: {value!r}"
+    )
