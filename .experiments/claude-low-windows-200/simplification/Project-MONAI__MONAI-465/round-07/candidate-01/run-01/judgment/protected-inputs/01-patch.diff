+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            datalist = os.path.join(tmpdir, "dl.json")
+            with open(datalist, "w") as f:
+                json.dump(
+                    {"training": [{"image": "imgs/a.nii.gz", "label": "labs/a.nii.gz", "extra": "x"}]},
+                    f,
+                )
+            items = load_decathalon_datalist(datalist, True, "training", tmpdir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmpdir, "imgs/a.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmpdir, "labs/a.nii.gz")))
+            self.assertEqual(items[0]["extra"], "x")
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_cls_values(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            datalist = os.path.join(tmpdir, "dl.json")
+            with open(datalist, "w") as f:
+                json.dump({"training": [{"image": "imgs/a.nii.gz", "label": 3}]}, f)
+            items = load_decathalon_datalist(datalist, False, "training", tmpdir)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmpdir, "imgs/a.nii.gz")))
+            self.assertEqual(items[0]["label"], 3)
+            self.assertIsInstance(items[0]["label"], int)
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_seg_no_basedir(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmpdir, "a.nii.gz")
+            label_path = os.path.join(tmpdir, "a_label.nii.gz")
+            datalist = os.path.join(tmpdir, "dl.json")
+            with open(datalist, "w") as f:
+                json.dump({"training": [{"image": image_path, "label": label_path}]}, f)
+            items = load_decathalon_datalist(datalist, True, "training", base_dir=None)
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmpdir)
+
+    def test_seg_no_labels(self):
+        tmpdir = tempfile.mkdtemp()
+        try:
+            datalist = os.path.join(tmpdir, "dl.json")
+            with open(datalist, "w") as f:
+                json.dump({"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]}, f)
+            items = load_decathalon_datalist(datalist, data_list_key="test", base_dir=tmpdir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(list(items[0].keys()), ["image"])
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmpdir, "imgs/t0.nii.gz")))
+        finally:
+            shutil.rmtree(tmpdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
