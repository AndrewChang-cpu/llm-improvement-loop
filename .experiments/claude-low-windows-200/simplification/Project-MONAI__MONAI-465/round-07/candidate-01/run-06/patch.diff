+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_json(directory, name, content):
+    path = os.path.join(directory, name)
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = _write_json(
+                tempdir,
+                "datalist.json",
+                {
+                    "training": [
+                        {"image": "imgs/case0.nii.gz", "label": "labels/case0.nii.gz", "fold": 1},
+                    ]
+                },
+            )
+            items = load_decathalon_datalist(datalist, True, "training", tempdir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/case0.nii.gz")))
+            self.assertEqual(items[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = _write_json(
+                tempdir,
+                "datalist.json",
+                {"training": [{"image": "case0.nii.gz", "label": 3}, {"image": "case1.nii.gz", "label": 0}]},
+            )
+            items = load_decathalon_datalist(datalist, False, "training", tempdir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "case0.nii.gz")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 3)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "case0.nii.gz")
+            label_path = os.path.join(tempdir, "case0_seg.nii.gz")
+            datalist = _write_json(
+                tempdir,
+                "datalist.json",
+                {"training": [{"image": image_path, "label": label_path}]},
+            )
+            items = load_decathalon_datalist(datalist, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = _write_json(
+                tempdir,
+                "datalist.json",
+                {"test": ["case0.nii.gz", "case1.nii.gz"]},
+            )
+            items = load_decathalon_datalist(datalist, data_list_key="test", base_dir=tempdir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "case0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
