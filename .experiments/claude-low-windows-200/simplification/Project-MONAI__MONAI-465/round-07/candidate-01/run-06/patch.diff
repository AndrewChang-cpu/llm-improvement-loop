+import os
+import json
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): a string path or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        field (str): name of the datalist field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        the normalized string path, or a list of normalized string paths with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"but a list element is {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, but is {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The file must contain a top-level object whose ``data_list_key`` value is a list of entries. If
+    ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as an item whose only
+    field is ``"image"``. Otherwise each entry must be a mapping.
+
+    The ``"image"`` field of every item is resolved when present. In segmentation mode the ``"label"`` field
+    is resolved when present; otherwise it is returned as stored. Resolution joins a string with ``base_dir``
+    and normalizes it, leaving absolute strings absolute. A list of strings is resolved element by element,
+    keeping its length and order. All other fields are returned unchanged. Neither ``"image"`` nor
+    ``"label"`` is required.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; it must exist.
+        is_segmentation (bool): if True, resolve ``"label"`` values as paths and require them to be strings or
+            lists of strings. If False, leave ``"label"`` values unchanged, so classification labels may be any
+            JSON value. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to ``"training"``.
+        base_dir (str): directory used to resolve relative paths. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order. Each dictionary is a copy of the entry with
+        its resolved ``"image"`` (and, in segmentation mode, ``"label"``) fields replaced.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or an image or
+            segmentation label value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file {data_list_file_path} must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Entry {entry!r} under key '{data_list_key}' in {data_list_file_path} must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
