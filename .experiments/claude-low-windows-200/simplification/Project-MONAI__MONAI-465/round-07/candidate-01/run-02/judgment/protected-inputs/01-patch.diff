+import json
+import os
+
+
+def _resolve_path(value, base_dir: str, where: str):
+    """
+    Resolve a path value, or a list of path values, against ``base_dir``.
+
+    A string is joined with ``base_dir`` and normalized; an absolute string stays absolute.
+    A list must contain only strings, and each element is resolved independently, keeping
+    the length and order of the list.
+
+    Args:
+        value (str or list of str): the stored path value to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        where (str): description of the value's location, used in error messages.
+
+    Returns:
+        str or list of str: the resolved path, or a list of resolved paths.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of list in {where} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Value {value!r} in {where} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+) -> list:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must be a JSON object whose ``data_list_key`` value is a list of entries. For the
+    ``"test"`` key, each plain path string is wrapped as an item with only an ``"image"`` field.
+    Every other entry must be a mapping. Its ``"image"`` value, when present, is resolved as a
+    path or list of paths. Its ``"label"`` value is resolved the same way only when
+    ``is_segmentation`` is True; otherwise it is kept exactly as stored, so classification labels
+    may be any JSON value. All other fields are kept unchanged.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether ``"label"`` values are segmentation paths to resolve.
+            Defaults to True.
+        data_list_key (str): top-level key holding the list of entries, such as ``"training"``
+            or ``"test"``. Defaults to ``"training"``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which
+            uses the directory portion of ``data_list_file_path``, not made absolute.
+
+    Returns:
+        list: the processed items, in their original order. Each item is a dict; for the
+        ``"test"`` key, each dict has only an ``"image"`` field.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    fields = ["image", "label"] if is_segmentation else ["image"]
+    items = []
+    for index, item in enumerate(entries):
+        where = f"item {index} under key '{data_list_key}' in data list file '{data_list_file_path}'"
+        if not isinstance(item, dict):
+            raise ValueError(f"Entry {where} must be a mapping, got {item!r}.")
+        processed = dict(item)
+        for field in fields:
+            if field in processed:
+                processed[field] = _resolve_path(processed[field], base_dir, f"key '{field}' of {where}")
+        items.append(processed)
+    return items
