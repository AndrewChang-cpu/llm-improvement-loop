+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            path = _write_datalist(
+                tempdir,
+                {
+                    "training": [
+                        {"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 1},
+                        {"image": ["./img1a.nii.gz", "img1b.nii.gz"], "label": "./seg1.nii.gz"},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "img1a.nii.gz")),
+                    os.path.normpath(os.path.join(tempdir, "img1b.nii.gz")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "seg1.nii.gz")))
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            path = _write_datalist(
+                tempdir,
+                {"training": [{"image": "img0.nii.gz", "label": 1}, {"image": "img1.nii.gz", "label": 0}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            image_path = os.path.join(tempdir, "img0.nii.gz")
+            label_path = os.path.join(tempdir, "seg0.nii.gz")
+            path = _write_datalist(tempdir, {"training": [{"image": image_path, "label": label_path}]})
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            path = _write_datalist(tempdir, {"test": ["img0.nii.gz", "img1.nii.gz"]})
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "img0.nii.gz"))})
+            self.assertEqual(result[1], {"image": os.path.normpath(os.path.join(tempdir, "img1.nii.gz"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
