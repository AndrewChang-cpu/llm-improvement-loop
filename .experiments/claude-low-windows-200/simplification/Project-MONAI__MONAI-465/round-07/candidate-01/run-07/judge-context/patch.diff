+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "training": [
+                        {"image": "imagesTr/img0.nii", "label": "labelsTr/seg0.nii", "fold": 0},
+                    ]
+                },
+            )
+            items = load_decathalon_datalist(path, True, "training", tmp_dir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/img0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/seg0.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "training": [
+                        {"image": "img0.nii", "label": 1},
+                        {"image": "img1.nii", "label": 0},
+                    ]
+                },
+            )
+            items = load_decathalon_datalist(path, False, "training", tmp_dir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp_dir, "img0.nii")
+            label = os.path.join(tmp_dir, "seg0.nii")
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "training": [
+                        {"image": image, "label": label},
+                    ]
+                },
+            )
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(image))
+            self.assertEqual(items[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "test": [
+                        "img0.nii",
+                        "img1.nii",
+                    ]
+                },
+            )
+            items = load_decathalon_datalist(path, True, "test", tmp_dir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
