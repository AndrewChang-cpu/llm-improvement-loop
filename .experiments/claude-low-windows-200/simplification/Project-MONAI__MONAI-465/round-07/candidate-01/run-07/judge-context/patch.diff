+import json
+import os
+
+
+def _resolve_path(value, base_dir: str, file_path: str, key: str, field: str):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): path or list of paths stored in the datalist
+        base_dir (str): directory used to join relative paths
+        file_path (str): datalist file path, used in error messages
+        key (str): datalist key the item belongs to, used in error messages
+        field (str): name of the field being resolved, used in error messages
+
+    Returns:
+        (str or list of str): normalized path, or list of normalized paths in the original order
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in key '{key}' of file '{file_path}' "
+                    "must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' value {value!r} in key '{key}' of file '{file_path}' must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: str = None,
+) -> list:
+    """
+    Load the Medical Segmentation Decathlon datalist JSON file and return per-case items with resolved paths.
+
+    The file must contain a top-level object with ``data_list_key`` mapping to a list of entries. If
+    ``data_list_key`` is "test", each entry is a plain path string and is wrapped as an item with only an
+    "image" field. Entries under any other key must be objects. The "image" value is resolved in all cases.
+    The "label" value is resolved only when ``is_segmentation`` is True; otherwise it is left as stored, so
+    classification labels may be any JSON value. All other fields are kept unchanged. Items without "image"
+    or "label" are accepted.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file
+        is_segmentation (bool): whether "label" values are file paths to be resolved, default True
+        data_list_key (str): key in the top-level object holding the list of entries, default "training"
+        base_dir (str): directory used to resolve relative paths, default None meaning the directory of
+            ``data_list_file_path``
+
+    Returns:
+        list of dict: one dict per entry, in the original order. Each dict holds the resolved "image" (and
+        "label" in segmentation mode) plus any other fields of the entry. Path values are strings or lists
+        of strings, with each list element resolved independently.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not an object, or an
+            "image" or segmentation "label" value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Entry {entry!r} in key '{data_list_key}' of datalist file '{data_list_file_path}' must be an object."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, data_list_key, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, data_list_key, "label")
+        items.append(item)
+
+    return items
