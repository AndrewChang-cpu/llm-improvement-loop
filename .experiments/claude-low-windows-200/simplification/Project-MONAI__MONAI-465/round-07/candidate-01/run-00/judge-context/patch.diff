+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, key: str, field: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        key (str): datalist key being loaded, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        the resolved string, or a list of resolved strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is not a string or a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements in '{key}' of '{file_path}' must be strings, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"'{field}' in '{key}' of '{file_path}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary. The "image" field is always
+    resolved. The "label" field is resolved only when ``is_segmentation`` is True; otherwise it is
+    returned as stored, so classification labels may be any JSON value. Other fields are kept verbatim.
+    Entries under the "test" key are plain path strings, so each one is wrapped as ``{"image": entry}``
+    before resolution. Path values are either strings, which are joined with ``base_dir`` and normalized,
+    or lists of strings, whose elements are each resolved independently.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether the labels are segmentation paths to resolve. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping,
+            or an image or segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in '{data_list_file_path}' must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {index} under '{data_list_key}' in '{data_list_file_path}' must be a mapping, "
+                f"got {type(item).__name__}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(
+                new_item["image"], base_dir, data_list_file_path, data_list_key, "image"
+            )
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(
+                new_item["label"], base_dir, data_list_file_path, data_list_key, "label"
+            )
+        processed.append(new_item)
+
+    return processed
