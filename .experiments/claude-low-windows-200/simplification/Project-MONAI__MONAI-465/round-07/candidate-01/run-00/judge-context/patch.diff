+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imgs/case0.nii.gz", "label": "labels/case0.nii.gz", "fold": 0},
+                    {"image": "./imgs//case1.nii.gz", "label": "labels/case1.nii.gz", "fold": 1},
+                ]
+            }
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imgs/case0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labels/case0.nii.gz")),
+                    "fold": 0,
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "./imgs//case1.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labels/case1.nii.gz")),
+                    "fold": 1,
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "case0.nii.gz", "label": 0},
+                    {"image": ["a.nii.gz", "b.nii.gz"], "label": 3},
+                ]
+            }
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+            expected = [
+                {"image": os.path.normpath(os.path.join(tempdir, "case0.nii.gz")), "label": 0},
+                {
+                    "image": [
+                        os.path.normpath(os.path.join(tempdir, "a.nii.gz")),
+                        os.path.normpath(os.path.join(tempdir, "b.nii.gz")),
+                    ],
+                    "label": 3,
+                },
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tempdir, "case0.nii.gz")
+            label = os.path.join(tempdir, "label0.nii.gz")
+            content = {"training": [{"image": image, "label": label}]}
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result, [{"image": image, "label": label}])
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["case0.nii.gz", "case1.nii.gz"]}
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "test", tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "case0.nii.gz")))
+            self.assertEqual(len(result), 2)
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
