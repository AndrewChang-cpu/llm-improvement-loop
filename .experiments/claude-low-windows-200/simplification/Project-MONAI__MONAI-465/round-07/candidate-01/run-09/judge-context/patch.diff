+import json
+import os
+
+
+def _resolve_path(value, base_dir: str, field: str, data_list_file_path: str):
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value (str or list of str): the stored path value to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the datalist field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path(s), with the same type and order as `value`.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: "str | None" = None,
+) -> list[dict]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its entries with resolved paths.
+
+    The entries stored under `data_list_key` are processed in their original order. The "image" value of each
+    entry is resolved against `base_dir`. When `is_segmentation` is True, the "label" value is resolved as well;
+    otherwise it is returned exactly as stored, which allows classification labels of any JSON type. Other fields
+    are kept unchanged. Entries are not required to contain "image" or "label". If `data_list_key` is "test", the
+    entries are plain path strings and each is wrapped as an item with only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory to resolve relative paths against. If None, the directory portion of
+            `data_list_file_path` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict holds the entry's fields with the "image"
+        value (and the "label" value in segmentation mode) replaced by resolved path strings, or lists of resolved
+        path strings when the stored value is a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, `data_list_key` is missing, an entry is not a mapping,
+            or an image or segmentation label is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Entry {index} under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
