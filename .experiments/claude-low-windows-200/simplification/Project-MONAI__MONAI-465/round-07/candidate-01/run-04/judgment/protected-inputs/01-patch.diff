+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_json(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": "labels/a.nii.gz", "extra": 1},
+                    {"image": "imgs/b.nii.gz", "label": "labels/b.nii.gz", "extra": 2},
+                ]
+            }
+            path = self._write_json(tempdir, data)
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imgs/a.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labels/a.nii.gz")),
+                    "extra": 1,
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imgs/b.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labels/b.nii.gz")),
+                    "extra": 2,
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": 0},
+                    {"image": ["imgs/b0.nii.gz", "imgs/b1.nii.gz"], "label": 3},
+                ]
+            }
+            path = self._write_json(tempdir, data)
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/a.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "imgs/b0.nii.gz")),
+                    os.path.normpath(os.path.join(tempdir, "imgs/b1.nii.gz")),
+                ],
+            )
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 3)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tempdir, "a.nii.gz")
+            label = os.path.join(tempdir, "a_label.nii.gz")
+            data = {"training": [{"image": image, "label": label}]}
+            path = self._write_json(tempdir, data)
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], image)
+            self.assertEqual(result[0]["label"], label)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]}
+            path = self._write_json(tempdir, data)
+            result = load_decathalon_datalist(path, True, "test", tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/t0.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs/t1.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
