+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str, key: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a path string or a list of path strings against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element of '{key}' in '{file_path}' must be a string, got {element!r}.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"'{key}' in '{file_path}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the items of a Medical Segmentation Decathlon datalist JSON file.
+
+    Each entry under ``data_list_key`` is returned as a dictionary. The ``"image"`` value is resolved
+    against ``base_dir``; when ``is_segmentation`` is True the ``"label"`` value is resolved too, otherwise
+    it is returned exactly as stored. Other fields are kept unchanged. Values that are strings are joined
+    with ``base_dir`` and normalized, absolute strings stay absolute, and lists of strings are resolved
+    element by element. When ``data_list_key`` is ``"test"``, each plain string entry is wrapped as
+    ``{"image": entry}`` before resolution.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must name an existing file.
+        is_segmentation (bool): if True, resolve the ``"label"`` value as a path; if False, leave it
+            unchanged. Defaults to True.
+        data_list_key (str): top-level key in the JSON object whose value is the list of entries.
+            Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. If None, the directory portion of
+            ``data_list_file_path`` is used (not made absolute). Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary holds the
+        resolved ``"image"`` (and ``"label"`` in segmentation mode, when present) plus any other fields.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an
+            image or segmentation label is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item in '{data_list_key}' of '{data_list_file_path}' must be a mapping, got {item!r}.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
