+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, key: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        key (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        (str or list of str): normalized path, or a list of normalized paths with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"every element of '{key}' in {file_path} must be a string, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{key}' in {file_path} must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The file must contain a top-level object with the key `data_list_key` whose value is a list of entries. When
+    `data_list_key` is "test", each entry is a plain path string and is wrapped as an item with only an "image" field.
+
+    For each item, the "image" value is resolved, and the "label" value is resolved only when `is_segmentation` is
+    True; otherwise it is left as stored. Missing "image" or "label" fields are not an error. All other fields are
+    kept unchanged. A path value may be a string or a list of strings; each element is resolved independently.
+    Relative paths are joined with `base_dir`, and absolute paths stay absolute.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether "label" values are file paths to be resolved. Defaults to True. When False,
+            labels are returned as stored, which allows classification labels of any JSON type.
+        data_list_key (str): key in the top-level object holding the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory portion of
+            `data_list_file_path`, which is not made absolute.
+
+    Returns:
+        (list of dict): the processed items in their original order. Each item is a dict containing the fields of its
+        entry, with "image" (and "label" in segmentation mode) replaced by resolved paths.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path value is not
+            a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value of key '{data_list_key}' in {data_list_file_path} must be a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"every entry under key '{data_list_key}' in {data_list_file_path} must be an object")
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
