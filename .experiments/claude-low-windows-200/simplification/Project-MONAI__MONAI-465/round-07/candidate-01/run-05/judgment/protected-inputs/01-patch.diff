+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, data):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(data, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": "imagesTr/img0.nii.gz", "label": "labelsTr/lbl0.nii.gz", "fold": 0},
+                    {"image": ["imagesTr/a.nii.gz", "imagesTr/b.nii.gz"], "label": "labelsTr/./lbl1.nii.gz"},
+                ]
+            }
+            path = self._write_datalist(tempdir, data)
+            items = load_decathalon_datalist(path, True, "training", tempdir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/img0.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/lbl0.nii.gz")))
+            self.assertEqual(items[0]["fold"], 0)
+            self.assertEqual(
+                items[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "imagesTr/a.nii.gz")),
+                    os.path.normpath(os.path.join(tempdir, "imagesTr/b.nii.gz")),
+                ],
+            )
+            self.assertEqual(items[1]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/lbl1.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 1},
+                    {"image": "img1.nii.gz", "label": 0},
+                ]
+            }
+            path = self._write_datalist(tempdir, data)
+            items = load_decathalon_datalist(path, False, "training", tempdir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii.gz")))
+            self.assertEqual(items[1]["label"], 0)
+            self.assertIsInstance(items[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tempdir, "img0.nii.gz")
+            label = os.path.join(tempdir, "lbl0.nii.gz")
+            data = {"training": [{"image": image, "label": label}]}
+            path = self._write_datalist(tempdir, data)
+            items = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], image)
+            self.assertEqual(items[0]["label"], label)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data = {"test": ["imagesTs/t0.nii.gz", "imagesTs/t1.nii.gz"]}
+            path = self._write_datalist(tempdir, data)
+            items = load_decathalon_datalist(path, True, "test", tempdir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/t0.nii.gz")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
