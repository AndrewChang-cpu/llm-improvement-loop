+
+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_json(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            content = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 0},
+                ]
+            }
+            path = _write_json(tmp_dir, content)
+            base_dir = os.path.join(tmp_dir, "data")
+            result = load_decathalon_datalist(path, True, "training", base_dir)
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(base_dir, "imagesTr/case_0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(base_dir, "labelsTr/case_0.nii.gz")),
+                    "fold": 0,
+                }
+            ]
+            self.assertEqual(result, expected)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            content = {
+                "training": [
+                    {"image": "case_0.nii.gz", "label": 1},
+                    {"image": ["case_1_a.nii.gz", "case_1_b.nii.gz"], "label": 0},
+                ]
+            }
+            path = _write_json(tmp_dir, content)
+            base_dir = os.path.join(tmp_dir, "data")
+            result = load_decathalon_datalist(path, False, "training", base_dir)
+            expected = [
+                {"image": os.path.normpath(os.path.join(base_dir, "case_0.nii.gz")), "label": 1},
+                {
+                    "image": [
+                        os.path.normpath(os.path.join(base_dir, "case_1_a.nii.gz")),
+                        os.path.normpath(os.path.join(base_dir, "case_1_b.nii.gz")),
+                    ],
+                    "label": 0,
+                },
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            image_path = os.path.join(tmp_dir, "image.nii.gz")
+            label_path = os.path.join(tmp_dir, "label.nii.gz")
+            content = {"training": [{"image": image_path, "label": label_path}]}
+            path = _write_json(tmp_dir, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+            expected = [{"image": image_path, "label": label_path}]
+            self.assertEqual(result, expected)
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            content = {"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]}
+            path = _write_json(tmp_dir, content)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+            expected_first = os.path.normpath(os.path.join(tmp_dir, "imagesTs/case_0.nii.gz"))
+            self.assertEqual(result[0]["image"], expected_first)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(list(result[0].keys()), ["image"])
+
+
+if __name__ == "__main__":
+    unittest.main()
