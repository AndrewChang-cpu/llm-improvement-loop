+import json
+import os
+
+
+def _resolve_path(value, base_dir, field_name, file_path):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): the stored path or list of paths.
+        base_dir (str): directory that relative paths are joined with.
+        field_name (str): name of the item field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path, or a list of normalized paths with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field_name}' in datalist {file_path} must be a string or list of strings, "
+                    f"found element {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field_name}' in datalist {file_path} must be a string or list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return per-case items with resolved paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary. The "image" field is always resolved when present.
+    The "label" field is resolved only when ``is_segmentation`` is True; otherwise it is returned exactly as stored,
+    so classification labels may be any JSON value. All other fields are kept verbatim. Entries under the "test"
+    key are plain path strings; each one is wrapped as an item whose only field is "image" before resolution.
+
+    Path values are joined with ``base_dir`` and normalized; absolute paths stay absolute. A list of paths is
+    resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. Must name an existing file.
+        is_segmentation (bool): whether "label" fields are paths to be resolved. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory
+            portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        list of dict: processed items in the original order, each a dictionary with resolved "image" and,
+        in segmentation mode, resolved "label" fields.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an
+            entry that is not a mapping or a path value that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    try:
+        with open(data_list_file_path, "r", encoding="utf-8") as f:
+            json_data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"Datalist file is not valid JSON: {data_list_file_path}: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' must map to a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Entry under key '{data_list_key}' in datalist file {data_list_file_path} must be a mapping, "
+                f"found {entry!r}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
