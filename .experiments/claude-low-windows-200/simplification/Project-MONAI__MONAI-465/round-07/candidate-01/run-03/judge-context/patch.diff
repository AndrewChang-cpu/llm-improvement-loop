+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "extra": 1},
+                    {"image": "./imagesTr//case_1.nii.gz", "label": "labelsTr/case_1.nii.gz"},
+                ]
+            }
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imagesTr/case_0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labelsTr/case_0.nii.gz")),
+                    "extra": 1,
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "./imagesTr//case_1.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labelsTr/case_1.nii.gz")),
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "case_0.nii.gz", "label": 0},
+                    {"image": "case_1.nii.gz", "label": 2},
+                ]
+            }
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+            expected = [
+                {"image": os.path.join(tempdir, "case_0.nii.gz"), "label": 0},
+                {"image": os.path.join(tempdir, "case_1.nii.gz"), "label": 2},
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "case_0.nii.gz")
+            label_path = os.path.join(tempdir, "case_0_label.nii.gz")
+            content = {"training": [{"image": image_path, "label": label_path}]}
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+            expected = [{"image": image_path, "label": label_path}]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["case_0.nii.gz", "case_1.nii.gz"]}
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "test", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.join(tempdir, "case_0.nii.gz"))
+            self.assertEqual(result[1]["image"], os.path.join(tempdir, "case_1.nii.gz"))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
