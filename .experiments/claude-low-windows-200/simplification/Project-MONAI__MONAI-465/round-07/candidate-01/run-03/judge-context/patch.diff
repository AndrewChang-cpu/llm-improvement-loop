+import json
+import os
+
+
+def _resolve_path(value, base_dir, file_path, key):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): the stored path or paths.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        key (str): entry key the value belongs to, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same order and length.
+
+    Raises:
+        ValueError: if ``value`` is not a string, or a list containing non-string elements.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"List under key '{key}' in '{file_path}' must contain only strings, got {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Value under key '{key}' in '{file_path}' must be a string or a list of strings, got {value!r}.")
+
+
+def _process_item(item, base_dir, file_path, is_segmentation):
+    """
+    Return a copy of one datalist entry with its path fields resolved.
+
+    Args:
+        item (dict): a single datalist entry.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        is_segmentation (bool): whether "label" is a path to resolve.
+
+    Returns:
+        A new dict with "image" resolved when present, "label" resolved in segmentation mode when present,
+        and all other fields unchanged.
+
+    Raises:
+        ValueError: if ``item`` is not a mapping or a path value is invalid.
+    """
+    if not isinstance(item, dict):
+        raise ValueError(f"Entry in '{file_path}' must be a mapping, got {item!r}.")
+    processed = dict(item)
+    if "image" in processed:
+        processed["image"] = _resolve_path(processed["image"], base_dir, file_path, "image")
+    if is_segmentation and "label" in processed:
+        processed["label"] = _resolve_path(processed["label"], base_dir, file_path, "label")
+    return processed
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: "str | None" = None,
+) -> "list[dict]":
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key`` whose value is a list of entries. When
+    ``data_list_key`` is "test", each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Every entry must be a mapping. Its "image" value is resolved when present. Its "label" value is resolved
+    only in segmentation mode, otherwise it is left as stored. Other fields are kept unchanged. A path value
+    may be a string or a list of strings; relative strings are joined with ``base_dir`` and normalized,
+    absolute strings stay absolute, and list elements are resolved independently.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve "label" as a path. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the resolved "image" (and
+        "label" in segmentation mode) plus any other fields from the entry. For the "test" key, each dict
+        has only the resolved "image" field.
+
+    Raises:
+        ValueError: if the file does not exist, ``data_list_key`` is missing, an entry is not a mapping,
+            or a path value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file '{data_list_file_path}' must hold a list.")
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+    return [_process_item(item, base_dir, data_list_file_path, is_segmentation) for item in data_list]
