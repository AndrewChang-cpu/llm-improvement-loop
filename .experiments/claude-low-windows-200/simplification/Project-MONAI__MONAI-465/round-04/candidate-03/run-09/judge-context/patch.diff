+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list elements of field '{field}' in {file_path} must be strings, "
+                    f"got {type(element).__name__}: {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"field '{field}' in {file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The datalist is a JSON object whose ``data_list_key`` entry is a list of items. Each item is a
+    mapping with an "image" field and, in segmentation mode, a "label" field. Relative paths are
+    joined with ``base_dir`` and normalized; absolute paths stay absolute. Other fields are kept as stored.
+
+    If ``data_list_key`` is "test", the entries are plain path strings; each is wrapped as an item
+    with only an "image" field, regardless of ``is_segmentation``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): if True, the "label" field is resolved as a path (a string or a list
+            of strings). If False, "label" is left exactly as stored, so classification labels such as
+            integer class ids are preserved. Defaults to True.
+        data_list_key (str): key in the top-level JSON object whose value is the list of items.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same field names as the
+        input item; "image", and "label" in segmentation mode, hold resolved paths. For example:
+        ``[{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a
+            "image" or "label" value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"value of data_list_key '{data_list_key}' in {data_list_file_path} must be a list, "
+            f"got {type(entries).__name__}"
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"item {index} under data_list_key '{data_list_key}' in {data_list_file_path} "
+                f"must be a mapping, got {type(item).__name__}: {item!r}"
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
