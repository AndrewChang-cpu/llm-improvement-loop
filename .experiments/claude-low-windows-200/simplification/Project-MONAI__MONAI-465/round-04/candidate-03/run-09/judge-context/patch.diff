+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": "segs/a.nii", "fold": 0},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "segs/a.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 3},
+                    {"image": ["imgs/b.nii", "imgs/c.nii"], "label": 1},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imgs/b.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "imgs/c.nii")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            abs_image = os.path.join(tmp_dir, "img.nii")
+            abs_label = os.path.join(tmp_dir, "seg.nii")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, data_list_key="training", base_dir=None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            content = {"test": ["a.nii", "b.nii"]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "a.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
