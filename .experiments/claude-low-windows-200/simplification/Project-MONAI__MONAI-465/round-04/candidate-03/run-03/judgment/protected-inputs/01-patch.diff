+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized string path, or a list of normalized string paths in the same order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list whose elements are all strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' must contain only strings, "
+                    f"got element {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of
+            each item is resolved as a path, and must be a string or list of strings. If False, "label"
+            is returned exactly as stored, and may be any JSON value such as an integer class id.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. If it equals "test",
+            each entry is a plain path string and is wrapped as an item with only an "image" field.
+            Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. If None, the directory
+            portion of ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order of the datalist. Each dict has the same field names as the
+        input entry, and its "image" field (and "label" field in segmentation mode) holds a resolved path
+        or list of resolved paths. Other fields are kept verbatim. For example, with
+        ``is_segmentation=True`` an entry ``{"image": "a.nii", "label": "b.nii", "fold": 0}`` in the datalist
+        at ``/data/list.json`` becomes ``{"image": "/data/a.nii", "label": "/data/b.nii", "fold": 0}``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            field has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Data list key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list, "
+            f"got {entries!r}."
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist file '{data_list_file_path}' must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
