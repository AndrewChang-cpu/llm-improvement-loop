+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """Resolve a path value (string or list of strings) against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in datalist '{file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in datalist '{file_path}' must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with its
+    ``"image"`` field (and, in segmentation mode, its ``"label"`` field)
+    resolved to paths under ``base_dir``. Other fields are kept verbatim.
+    Entries under the ``"test"`` key are plain path strings and are wrapped
+    as ``{"image": entry}`` before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must exist.
+        is_segmentation (bool): if True, the ``"label"`` field is resolved as a path
+            (a string or list of strings). If False, ``"label"`` is left exactly as
+            stored, so classification labels such as integer class ids are preserved.
+            Defaults to True.
+        data_list_key (str): key in the top-level JSON object whose value is the list
+            of entries to load. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None,
+            the directory portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the original order. Each dictionary has the same
+        field names as the input entry, with ``"image"`` (and ``"label"`` in
+        segmentation mode) holding resolved paths. For example::
+
+            [{"image": "/data/imagesTr/case0.nii", "label": "/data/labelsTr/case0.nii", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an entry
+            is not a mapping, or a path field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each entry under key '{data_list_key}' in '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+    return processed
