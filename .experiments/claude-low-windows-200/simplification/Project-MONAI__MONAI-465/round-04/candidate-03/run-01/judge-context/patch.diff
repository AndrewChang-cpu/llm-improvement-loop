+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": "./imagesTr/case0.nii", "label": "labelsTr//case0.nii", "fold": 1},
+                ]
+            }
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "./imagesTr/case0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr//case0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"training": [{"image": "img/case0.nii", "label": 3}]}
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, False, "training", base_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img/case0.nii")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "case0.nii")
+            abs_label = os.path.join(tempdir, "case0_label.nii")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"test": ["imagesTs/case0.nii", "imagesTs/case1.nii"]}
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "test", base_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/case0.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
