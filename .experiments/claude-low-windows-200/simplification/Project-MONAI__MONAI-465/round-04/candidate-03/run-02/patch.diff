+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"training": [{"image": "img.nii", "label": "seg.nii", "fold": 1}]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+            result = load_decathalon_datalist(datalist_path, True, "training", tempdir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "seg.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"training": [{"image": "img.nii", "label": 3}]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+            result = load_decathalon_datalist(datalist_path, False, "training", tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img.nii")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img.nii")
+            abs_label = os.path.join(tempdir, "seg.nii")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"test": ["img_a.nii", "img_b.nii"]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+            result = load_decathalon_datalist(datalist_path, True, "test", tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_a.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
