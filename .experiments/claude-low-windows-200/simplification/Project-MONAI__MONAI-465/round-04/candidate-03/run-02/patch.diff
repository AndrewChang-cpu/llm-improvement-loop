+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a string or list-of-strings path value against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"list element {element!r} in file '{file_path}' must be a string")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value {value!r} in file '{file_path}' must be a string or list of strings")
+
+
+def _check_path_value(value: Any, field: str, file_path: str) -> None:
+    """Check that a field value is a string or a list of strings."""
+    if isinstance(value, str):
+        return
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"list element {element!r} of field '{field}' in file '{file_path}' must be a string")
+        return
+    raise ValueError(f"field '{field}' in file '{file_path}' must be a string or list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path
+            and must be a string or list of strings. If False, "label" is left exactly as stored
+            (for example, an integer class id for classification).
+        data_list_key (str): key under the top-level object whose value is the list of entries.
+            Defaults to "training". If it is "test", each entry is a plain path string and is
+            wrapped as an item with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None,
+            meaning the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, in the original order of the datalist. Each dictionary keeps the
+        input field names; "image" and, in segmentation mode, "label" hold resolved paths. Paths
+        are normalized and absolute paths stay absolute. Other fields are kept verbatim.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or
+            an "image" or segmentation "label" value is not a string or list of strings.
+
+    Example:
+        A datalist with ``{"training": [{"image": "a.nii", "label": "a_seg.nii", "fold": 0}]}``
+        loaded from ``/data/dataset.json`` returns
+        ``[{"image": "/data/a.nii", "label": "/data/a_seg.nii", "fold": 0}]``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' is missing in datalist file '{data_list_file_path}'")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"item {item!r} in datalist file '{data_list_file_path}' must be a mapping")
+        out = dict(item)
+        if "image" in out:
+            _check_path_value(out["image"], "image", data_list_file_path)
+            out["image"] = _resolve_path(out["image"], base_dir, data_list_file_path)
+        if is_segmentation and "label" in out:
+            _check_path_value(out["label"], "label", data_list_file_path)
+            out["label"] = _resolve_path(out["label"], base_dir, data_list_file_path)
+        result.append(out)
+    return result
