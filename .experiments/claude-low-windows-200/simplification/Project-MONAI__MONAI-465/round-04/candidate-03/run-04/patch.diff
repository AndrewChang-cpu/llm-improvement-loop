+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the same order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list "
+                    f"of strings, but a list element is {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"but got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key``, whose value is a list of entries.
+    Each non-"test" entry is an object. Its "image" field is resolved as a path (a string or a
+    list of strings). Its "label" field is resolved as a path only when ``is_segmentation`` is True;
+    otherwise it is kept exactly as stored, so classification labels such as integer class ids
+    are unchanged. Other fields are kept verbatim. Missing "image" or "label" fields are not an error.
+
+    When ``data_list_key`` equals "test", each entry is a plain path string, and it is wrapped
+    as an item whose only field is "image". This applies regardless of ``is_segmentation``.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths stay absolute.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether the items are for segmentation. When True, "label" is resolved
+            as a path. When False, "label" is left unchanged. Defaults to True.
+        data_list_key (str): key in the top-level JSON object that holds the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which
+            means the directory portion of ``data_list_file_path``, without making it absolute.
+
+    Raises:
+        ValueError: when the file does not exist, is not valid JSON, lacks ``data_list_key``, or
+            contains an entry or a path value that does not have the expected type.
+
+    Returns:
+        a list of dicts in the original order, one per entry, using the input field names. "image"
+        (and "label" in segmentation mode) hold resolved paths. For example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Datalist file '{data_list_file_path}' must contain a JSON object at the top level.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each entry in datalist file '{data_list_file_path}' must be an object, got {item!r}.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+    return processed
