+# limitations under the License.
+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(path, content):
+    with open(path, "w") as f:
+        json.dump(content, f)
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(
+                datalist_path,
+                {"training": [{"image": "imgs/case0.nii", "label": "labels/case0.nii", "fold": 1}]},
+            )
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels/case0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(
+                datalist_path,
+                {"training": [{"image": "imgs/case0.nii", "label": 3}, {"image": "imgs/case1.nii", "label": 0}]},
+            )
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case1.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            abs_image = os.path.join(tmp_dir, "img.nii")
+            abs_label = os.path.join(tmp_dir, "lbl.nii")
+            _write_datalist(datalist_path, {"training": [{"image": abs_image, "label": abs_label}]})
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(datalist_path, {"test": ["imgs/case0.nii", "imgs/case1.nii"]})
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tmp_dir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
