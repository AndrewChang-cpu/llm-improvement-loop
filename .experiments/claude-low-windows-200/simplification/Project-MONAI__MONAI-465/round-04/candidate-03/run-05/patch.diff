+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": "lbl0.nii.gz", "fold": 0},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "lbl0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": ["img0.nii.gz", "img1.nii.gz"], "label": 3},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(
+                result[0]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "img0.nii.gz")),
+                    os.path.normpath(os.path.join(tempdir, "img1.nii.gz")),
+                ],
+            )
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 3)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            abs_image = os.path.join(tempdir, "img0.nii.gz")
+            abs_label = os.path.join(tempdir, "lbl0.nii.gz")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            content = {"test": ["img0.nii.gz", "img1.nii.gz"]}
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
