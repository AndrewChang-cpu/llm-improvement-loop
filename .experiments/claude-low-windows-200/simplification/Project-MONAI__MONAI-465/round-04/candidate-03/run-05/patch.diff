+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string or a list of path strings against ``base_dir``.
+
+    Args:
+        value (Any): a string, or a list whose elements are all strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"element of field '{field}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}: {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"field '{field}' in {data_list_file_path} must be a string or list of strings, "
+        f"got {type(value).__name__}: {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a top-level JSON object with the key ``data_list_key``, whose value is a list of entries.
+    Each entry is an object whose ``"image"`` field is a string or list of strings. When ``is_segmentation`` is True,
+    the ``"label"`` field is also resolved as a string or list of strings. When ``is_segmentation`` is False, the
+    ``"label"`` field is left exactly as stored, so it can be any JSON value such as an integer class id. Other
+    fields are kept verbatim. If ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped
+    as an object with only an ``"image"`` field before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; it must exist.
+        is_segmentation (bool): whether to resolve the ``"label"`` field as a path. Defaults to True.
+        data_list_key (str): key in the JSON object holding the list of entries. Defaults to ``"training"``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``, without making it absolute.
+
+    Returns:
+        A list of dicts, in the original order of the entries, with the input field names. ``"image"`` and, in
+        segmentation mode, ``"label"`` hold resolved paths. For example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: when the file does not exist, the key is missing, an entry is not a mapping, or a path field
+            is not a string or list of strings.
+
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing in datalist file {data_list_file_path}")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file {data_list_file_path} must hold a list")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each entry under key '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"got {type(item).__name__}: {item!r}"
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+    return processed
