+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file '{file_path}' "
+                    "must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The datalist file must be a JSON object containing ``data_list_key`` whose value is a list of entries.
+    Each entry is an object; its "image" field, and its "label" field in segmentation mode, is resolved
+    against ``base_dir``. Relative paths are joined with ``base_dir`` and normalized, absolute paths are kept
+    absolute, and a list of paths is resolved element by element, keeping its length and order.
+
+    When ``is_segmentation`` is True, "label" is resolved as a path. When it is False, "label" is left exactly
+    as stored, so classification labels such as integer class ids are preserved. Other fields are kept verbatim.
+    When ``data_list_key`` is "test", each entry is a plain path string used as the "image" field.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation, so that "label" is resolved as a path.
+            Set to False for classification, where "label" is returned unchanged. Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value is the list of entries. Defaults to
+            "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as the input
+        entry, with "image" and, in segmentation mode, "label" holding resolved paths. For example::
+
+            [{"image": "/data/imagesTr/case0.nii", "label": "/data/labelsTr/case0.nii", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, lacks ``data_list_key``, has an entry that is not an
+            object, or has an "image" or segmentation "label" value that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, Mapping) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be an object."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
