+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of strings, against ``base_dir``.
+
+    Args:
+        value (Any): a string, or a list of strings, to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the same order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+                    f"found element {element!r} of type {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"found {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The datalist's ``data_list_key`` entry is a list of items. Each item is a mapping whose
+    ``"image"`` field is resolved to a path. When ``is_segmentation`` is True, the ``"label"``
+    field is resolved too; when it is False, ``"label"`` is left exactly as stored, so it can be
+    any JSON value such as an integer class id. Other fields are kept unchanged. If the key is
+    ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}`` first.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, ``"label"``
+            values are resolved as paths and must be a string or a list of strings. If False,
+            ``"label"`` values are returned unchanged. Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value holds the items.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None,
+            which uses the directory portion of ``data_list_file_path``. Absolute paths are
+            kept absolute.
+
+    Raises:
+        ValueError: when the file does not exist, is not valid JSON, lacks ``data_list_key``,
+            an item is not a mapping, or a path value is not a string or list of strings.
+
+    Returns:
+        a list of dictionaries in the original order, with the input field names. ``"image"``
+        and, in segmentation mode, ``"label"`` hold resolved path strings or lists of path
+        strings. For example::
+
+            [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    items = json_data[data_list_key]
+    if not isinstance(items, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in items]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in items:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, found {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        result.append(processed)
+    return result
