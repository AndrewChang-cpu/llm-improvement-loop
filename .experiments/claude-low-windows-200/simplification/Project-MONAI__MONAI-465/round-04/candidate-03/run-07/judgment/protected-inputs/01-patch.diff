+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            data = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "extra": 7},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            base_dir = os.path.join(tmp_dir, "data")
+            result = load_decathalon_datalist(datalist_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["extra"], 7)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            data = {
+                "training": [
+                    {"image": "case_0.nii.gz", "label": 2},
+                    {"image": ["case_1_a.nii.gz", "case_1_b.nii.gz"], "label": 0},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            base_dir = os.path.join(tmp_dir, "data")
+            result = load_decathalon_datalist(datalist_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "case_0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "case_1_a.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "case_1_b.nii.gz")),
+                ],
+            )
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            abs_image = os.path.join(tmp_dir, "image.nii.gz")
+            abs_label = os.path.join(tmp_dir, "label.nii.gz")
+            data = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            data = {"test": ["imagesTs/case_0.nii.gz", "imagesTs/case_1.nii.gz"]}
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            base_dir = os.path.join(tmp_dir, "data")
+            result = load_decathalon_datalist(datalist_path, True, "test", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/case_0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
