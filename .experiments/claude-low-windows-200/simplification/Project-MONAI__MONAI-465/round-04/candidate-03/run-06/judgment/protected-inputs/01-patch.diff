+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 1},
+                    {"image": "./sub//img1.nii.gz", "label": "seg1.nii.gz"},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                file_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "sub", "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp_dir, "seg1.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 0},
+                    {"image": "img1.nii.gz", "label": 2},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                file_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img0.nii.gz")
+            abs_label = os.path.join(tmp_dir, "seg0.nii.gz")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["img0.nii.gz", "img1.nii.gz"]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
