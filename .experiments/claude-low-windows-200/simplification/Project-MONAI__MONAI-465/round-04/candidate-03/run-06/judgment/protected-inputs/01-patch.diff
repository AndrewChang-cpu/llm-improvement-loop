+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of paths, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in datalist file '{data_list_file_path}' "
+                    "must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in datalist file '{data_list_file_path}' "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with the same field names.
+    The "image" field is always resolved to a path. In segmentation mode the "label" field is
+    resolved too; in classification mode it is left exactly as stored (for example an integer
+    class id). Any other fields are kept unchanged. A "test" key holds plain path strings, which
+    are wrapped as items whose only field is "image".
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the "label" field of each item as a path, which
+            must then be a string or list of strings. If False, "label" is not resolved and may be
+            any JSON value. Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory
+            portion of ``data_list_file_path`` is used. Absolute paths are kept absolute.
+            Defaults to None.
+
+    Returns:
+        A list of dictionaries in the original order, for example
+        ``[{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 1}]``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, does not contain ``data_list_key``,
+            or contains an item or path value of an unexpected type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, Mapping) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
