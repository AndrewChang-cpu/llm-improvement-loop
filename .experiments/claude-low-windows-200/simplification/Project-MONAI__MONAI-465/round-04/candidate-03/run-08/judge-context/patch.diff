+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": "imagesTr/img0.nii", "label": "labelsTr/lbl0.nii", "extra": 7}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", tmp_dir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/lbl0.nii")))
+            self.assertEqual(result[0]["extra"], 7)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": ["a.nii", "b.nii"], "label": 2}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", tmp_dir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(
+                result[0]["image"],
+                [os.path.normpath(os.path.join(tmp_dir, "a.nii")), os.path.normpath(os.path.join(tmp_dir, "b.nii"))],
+            )
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img0.nii")
+            abs_label = os.path.join(tmp_dir, "lbl0.nii")
+            path = self._write_datalist(tmp_dir, {"training": [{"image": abs_image, "label": abs_label}]})
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmp_dir, {"test": ["img0.nii", "img1.nii"]})
+            result = load_decathalon_datalist(path, True, "test", tmp_dir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
