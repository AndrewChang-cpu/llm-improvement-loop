+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory to join relative paths with.
+        field (str): name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list whose elements are all strings.
+
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"element {element!r} of field '{field}' must be a string")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"field '{field}' value {value!r} must be a string or a list of strings")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The value under ``data_list_key`` must be a list of entries. Each entry must be a mapping. The "image" field is
+    always resolved to a path. The "label" field is resolved only when ``is_segmentation`` is True; in classification
+    mode it is returned exactly as stored, so integer class ids stay integers. Other fields are kept unchanged.
+    When ``data_list_key`` is "test", each entry is a plain path string and is wrapped as ``{"image": entry}``
+    before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the "label" field as a path. If False, leave "label" unchanged.
+            Defaults to True.
+        data_list_key (str): key in the JSON top-level object that holds the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the input field names, with
+        "image" (and "label" in segmentation mode) holding resolved paths: a normalized string, or a list of
+        normalized strings in the same order as the input. Absolute paths stay absolute.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("/data/dataset.json", data_list_key="training")
+            # [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz"}, ...]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file '{data_list_file_path}'")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"item {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping"
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label")
+        result.append(processed)
+    return result
