+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined to.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is not a string or a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of field '{field}' in {data_list_file_path} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the entries are segmentation entries. If True, the "label" field of
+            each item is resolved as a path. If False, "label" is left exactly as stored, so classification
+            labels such as integer class ids are kept unchanged.
+        data_list_key (str): top-level key whose value is the list of entries, default "training".
+            If it equals "test", each entry is a plain path string used as the "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None, which
+            means the directory of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict keeps the input field names. The "image" field,
+        and the "label" field in segmentation mode, hold normalized paths. A value given as a list resolves to
+        a list of the same length and order. All other fields are copied unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path value
+            is not a string or a list of strings.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+            # items[0]["image"] and items[0]["label"] are normalized paths
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, Mapping) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file {data_list_file_path}.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Entry {item!r} under key '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        if "image" not in item:
+            raise ValueError(
+                f"Entry {dict(item)!r} under key '{data_list_key}' in {data_list_file_path} has no 'image'."
+            )
+
+        resolved = dict(item)
+        resolved["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            resolved["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+
+    return items
