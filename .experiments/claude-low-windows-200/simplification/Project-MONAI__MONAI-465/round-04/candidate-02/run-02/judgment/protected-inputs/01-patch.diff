+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string or a list of path strings against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all strings.
+        base_dir (str): directory that relative paths are joined with.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element {element!r} must be a string, got {type(element).__name__}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value {value!r} must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key``, whose value is a list of entries. When
+    ``data_list_key`` is "test", each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    The "image" field of every item is always resolved. The "label" field is resolved only when
+    ``is_segmentation`` is True; in classification mode it is left exactly as stored, so integer class ids
+    stay integers. Other fields are left unchanged. A field that is absent from an item is skipped.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether "label" holds paths to be resolved. Defaults to True. When False,
+            "label" is not resolved and may hold any JSON value.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+            The key "test" is treated as plain path strings.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory portion of ``data_list_file_path``. Absolute paths are kept absolute.
+
+    Raises:
+        ValueError: when the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+
+    Returns:
+        a list of dicts in the original order, using the input field names. Resolved "image" values, and
+        "label" values in segmentation mode, are normalized path strings, or lists of normalized path strings
+        of the same length as the input. Other fields are unchanged. For example::
+
+            [{"image": "/data/imgs/a.nii", "label": "/data/labs/a.nii", "fold": 1}]
+
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in file '{data_list_file_path}' must be a mapping."
+            )
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir)
+        items.append(resolved)
+
+    return items
