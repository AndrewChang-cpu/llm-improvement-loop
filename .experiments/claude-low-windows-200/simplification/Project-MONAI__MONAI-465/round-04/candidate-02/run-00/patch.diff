+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized string path, or a list of normalized string paths with the same length and order as ``value``.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file {file_path} must be a list of strings, "
+                    f"but it contains {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file {file_path} must be a string or a list of strings, but got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    In segmentation mode (``is_segmentation=True``), the "image" and "label" fields of each item are resolved.
+    In classification mode, only the "image" field is resolved and "label" is left exactly as stored, so it may
+    be any JSON value such as an integer class id. Other fields are never changed. Entries under the ``"test"``
+    key are plain path strings; each one is converted to an item whose only field is "image".
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of each
+            item is resolved as a path, and it must be a string or a list of strings. If False, "label" is
+            left unchanged. Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value is the list of entries.
+            Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. If None, the directory
+            portion of ``data_list_file_path`` is used. Absolute paths are kept absolute. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the same order as the datalist entries. Each dictionary has the same field
+        names as its input entry. The "image" field, and the "label" field in segmentation mode, hold the
+        resolved paths as a normalized string or as a list of normalized strings with the same length as the
+        input. All other fields are unchanged. For example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the top-level
+            object, if an entry is not a mapping, or if a path value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in datalist file {data_list_file_path} "
+                f"must be a mapping, but got {item!r}."
+            )
+        processed = dict(item)
+        if "image" not in processed:
+            raise ValueError(
+                f"Entry under key '{data_list_key}' in datalist file {data_list_file_path} has no 'image'."
+            )
+        processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
