+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+
+    Args:
+        value (Any): a string or a list of strings to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the datalist field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for index, element in enumerate(value):
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {index} of field '{field}' in datalist file '{file_path}' must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is an object whose "image" field (and "label" field in
+    segmentation mode) is resolved to a path under ``base_dir``. Entries under the "test" key are
+    plain path strings; each one is converted to an object with only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must name an existing file.
+        is_segmentation (bool): whether the entries are segmentation items. If True, the "label"
+            field is resolved as a path. If False, "label" is left exactly as stored, so it can be
+            any JSON value such as an integer class id. Default is True.
+        data_list_key (str): top-level key whose value is the list of entries. Default is "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. If None, the
+            directory portion of ``data_list_file_path`` is used, without making it absolute.
+            Absolute paths are kept absolute. Default is None.
+
+    Returns:
+        List[Dict[str, Any]]: the processed items, in the original order. Each item is a dict with
+        the same field names as the input. "image", and "label" in segmentation mode, hold resolved
+        paths: a string, or a list of strings with the same length and order as the input list.
+        Other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, lacks ``data_list_key``, has an entry that
+            is not a mapping, or has a path field that is neither a string nor a list of strings.
+
+    Example::
+
+        {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0}]}
+
+    loads to ``[{"image": "<dir>/img0.nii.gz", "label": "<dir>/seg0.nii.gz", "fold": 0}]``
+    when ``<dir>`` is the directory of the datalist file.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, Mapping):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {type(entry).__name__}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
