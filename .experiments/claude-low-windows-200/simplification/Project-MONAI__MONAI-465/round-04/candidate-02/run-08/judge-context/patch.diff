+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imgs/img0.nii.gz", "label": "./segs//seg0.nii.gz", "fold": 0},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "./segs//seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 1},
+                    {"image": "img1.nii.gz", "label": 0},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            abs_image = os.path.join(tmp_dir, "img0.nii.gz")
+            abs_label = os.path.join(tmp_dir, "seg0.nii.gz")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"test": ["img0.nii.gz", "img1.nii.gz"]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
