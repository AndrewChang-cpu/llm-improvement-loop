+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            datalist = {
+                "training": [
+                    {"image": "./imgs/case0.nii", "label": "labels//case0.nii", "fold": 1},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                file_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=base_dir,
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "./imgs/case0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels//case0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 2},
+                    {"image": "imgs/b.nii", "label": 0},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                file_path,
+                is_segmentation=False,
+                data_list_key="training",
+                base_dir=base_dir,
+            )
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/b.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "image.nii")
+            label_path = os.path.join(tmp_dir, "label.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            datalist = {"test": ["a.nii", "b.nii"]}
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, data_list_key="test", base_dir=base_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "a.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
