+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Union[str, List[str]]): a path string, or a list of path strings. Each list element is resolved
+            independently.
+        base_dir (str): directory to join relative paths with.
+
+    Raises:
+        ValueError: when ``value`` is not a string, or a list containing non-string elements.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for elem in value:
+            if not isinstance(elem, str):
+                raise ValueError(f"list path elements must be strings, got {type(elem).__name__}: {elem!r}")
+        return [os.path.normpath(os.path.join(base_dir, elem)) for elem in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): whether the entries are segmentation items. When True, the "label" field is
+            resolved as a path (string or list of strings). When False, "label" is left exactly as stored, so
+            classification labels such as integer class ids are kept. Default is True.
+        data_list_key (str): top-level key whose value is the list of entries. Default is "training".
+            When it equals "test", each entry is a plain path string and is converted to an item with only an
+            "image" field.
+        base_dir (str): directory that relative paths are joined with. Default is None, meaning the directory
+            portion of ``data_list_file_path`` (not made absolute).
+
+    Raises:
+        ValueError: when the file does not exist, the JSON lacks ``data_list_key``, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+
+    Returns:
+        a list of dictionaries in the original order, with the input field names. "image" (and "label" in
+        segmentation mode) hold resolved paths, either as a string or as a list of the same length as the input.
+        Other fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are normalized paths relative to the datalist directory.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value under key '{data_list_key}' must be a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each datalist item must be a mapping, got {type(item).__name__} in {data_list_file_path}"
+            )
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir)
+        items.append(out)
+    return items
