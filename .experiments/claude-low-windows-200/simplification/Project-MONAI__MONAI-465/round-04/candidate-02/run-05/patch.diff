+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path(s) with the same length and order as the input.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list "
+                    f"of strings, but found element {element!r} of type {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"but found {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of
+            each item is resolved as a path (a string or a list of strings). If False, "label" is left
+            exactly as stored, so classification labels such as integer class ids keep their type.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. If it is "test", each
+            entry is a plain path string and is converted to an item with only an "image" field.
+            Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the
+            directory portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as the input entry.
+        The "image" field, and the "label" field in segmentation mode, hold resolved paths: a normalized
+        string, or a list of normalized strings of the same length as the input. Relative paths are joined
+        with ``base_dir`` and absolute paths are kept absolute. Other fields are returned unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imgs/case0.nii", "label": "/data/labels/case0.nii", "fold": 0}, ...]
+
+    Raises:
+        ValueError: if the file does not exist, the JSON lacks ``data_list_key``, an item is not a
+            mapping, or a resolved path field is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, but found {entry!r}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
