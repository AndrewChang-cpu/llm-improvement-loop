+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "./imgs//case0.nii",
+                        "label": "labels/case0.nii",
+                        "fold": 0,
+                    }
+                ]
+            }
+            path = os.path.join(tmp_dir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels", "case0.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.png", "label": 3},
+                    {"image": "imgs/b.png", "label": 0},
+                ]
+            }
+            path = os.path.join(tmp_dir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(path, False, "training", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.png")))
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "b.png")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 3)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img.nii")
+            abs_label = os.path.join(tmp_dir, "seg.nii")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            path = os.path.join(tmp_dir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imgs/t0.nii",
+                    "imgs/t1.nii",
+                ]
+            }
+            path = os.path.join(tmp_dir, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(path, True, "test", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "t0.nii")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
