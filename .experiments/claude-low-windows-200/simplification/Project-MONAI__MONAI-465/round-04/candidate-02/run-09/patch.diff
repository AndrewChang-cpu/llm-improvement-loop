+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path string or a list of path strings against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all strings.
+        base_dir (str): directory that relative paths are joined with.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized string path, or a list of normalized string paths with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is not a string, or a list containing non-string elements.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Path list elements must be strings in datalist '{data_list_file_path}', got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Path values must be a string or a list of strings in datalist '{data_list_file_path}', got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must name an existing file.
+        is_segmentation (bool): whether the datalist is for segmentation. Defaults to True. When True, the
+            "label" field of each item is resolved as a path. When False, "label" is left exactly as stored,
+            so classification labels such as integer class ids are preserved.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+            When the key is "test", each entry is a plain path string and is wrapped into an item with
+            only an "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            which means the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries in the original order of the datalist. Each dictionary keeps the input field
+        names. The "image" field, and the "label" field in segmentation mode, hold normalized paths. A path
+        field holds a string, or a list of strings with the same length as the input list. Absolute paths
+        are kept absolute, and relative paths are joined with ``base_dir``. Other fields are unchanged.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", data_list_key="training", base_dir="/data")
+            # [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}, ...]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in datalist file '{data_list_file_path}'.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item must be a mapping in datalist file '{data_list_file_path}', got {item!r}.")
+        result = dict(item)
+        if "image" in result:
+            result["image"] = _resolve_path(result["image"], base_dir, data_list_file_path)
+        if is_segmentation and "label" in result:
+            result["label"] = _resolve_path(result["label"], base_dir, data_list_file_path)
+        items.append(result)
+
+    return items
