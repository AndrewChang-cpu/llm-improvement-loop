+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value (str or list of str): the path or list of paths to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        data_list_file_path (str): datalist file, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        (str or list of str): normalized paths, with the same type and length as `value`.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file {data_list_file_path} must be a list of strings, "
+                    f"found element {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file {data_list_file_path} must be a string or a list of strings, "
+        f"found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False,
+            "label" is left exactly as stored, so classification labels such as integer class ids are kept.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. If it is "test", each entry
+            is a plain path string and is converted to an item with only an "image" field. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion of
+            `data_list_file_path` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict keeps the input field names. The "image" field,
+        and the "label" field when `is_segmentation` is True, hold normalized paths. A path given as a list
+        keeps its length and order. Absolute paths stay absolute. Other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or a list of strings.
+
+    Example::
+
+        [
+            {"image": "/data/img0.nii", "label": "/data/lab0.nii", "fold": 0},
+            {"image": ["/data/t1.nii", "/data/t2.nii"], "label": "/data/lab1.nii", "fold": 1},
+        ]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, Mapping):
+            raise ValueError(
+                f"Item {entry!r} under key '{data_list_key}' in datalist file {data_list_file_path} "
+                "must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+    return items
