+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or a list of path strings, against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all string paths.
+        base_dir (str): directory that relative paths are joined with.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        str or list of str: normalized paths with the same length and order as the input.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"list element {element!r} must be a string path, got {type(element).__name__}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value {value!r} must be a string or a list of strings, got {type(value).__name__}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must name an existing file.
+        is_segmentation (bool): whether the entries are segmentation cases. If True, the "label" field of each
+            item is resolved as a path (string or list of strings). If False, "label" is left exactly as stored,
+            so classification labels such as integer class ids are kept unchanged. Defaults to True.
+        data_list_key (str): top-level key in the JSON object whose value is the list of entries.
+            If it equals "test", each plain path string entry is converted to an item with only an "image"
+            field. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: when the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+
+    Returns:
+        list of dict: the processed items in their original order. Each item keeps the input field names.
+        The "image" field, and the "label" field in segmentation mode, hold resolved paths: a normalized
+        string, or a list of normalized strings with the same length as the input. Other fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("datalist.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "/data/imagesTr/case0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"item {item!r} in datalist file '{data_list_file_path}' must be a mapping.")
+        processed = dict(item)
+        processed["image"] = _resolve_path(item.get("image"), base_dir)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir)
+        items.append(processed)
+    return items
