+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp,
+                {
+                    "training": [
+                        {"image": "./imagesTr//case0.nii.gz", "label": "labelsTr/./case0.nii.gz", "fold": 1},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp,
+                {
+                    "training": [
+                        {"image": "imagesTr/case0.nii.gz", "label": 0},
+                        {"image": "imagesTr/case1.nii.gz", "label": 2},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case1.nii.gz")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 2)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "case0.nii.gz")
+            label = os.path.join(tmp, "case0_seg.nii.gz")
+            path = self._write_datalist(tmp, {"training": [{"image": image, "label": label}]})
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmp, {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]})
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs/case0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
