+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a single path string or a list of path strings against ``base_dir``.
+
+    Args:
+        value (Any): a string, or a list whose elements are all strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the datalist field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a new list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file {file_path} "
+                    f"must be a string, got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file {file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the entries are segmentation pairs. If True, the "label" field
+            of each item is resolved as a path. If False, "label" is left exactly as stored, so it may be
+            any JSON value such as an integer class id. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. If it equals "test", each
+            entry is a plain path string and is converted to an item holding only "image". Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the fields of its entry. The
+        "image" field, and the "label" field in segmentation mode, hold normalized paths: a string for a
+        string input, or a list of the same length and order for a list input. Other fields are unchanged.
+        For example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, lacks ``data_list_key``, holds an item that is not a mapping,
+            or holds an ``image`` or segmentation ``label`` value that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list, "
+            f"got {type(entries).__name__}."
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in datalist file {data_list_file_path} "
+                f"must be a mapping, got {type(entry).__name__}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
