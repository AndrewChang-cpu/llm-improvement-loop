+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_json(path, obj):
+    with open(path, "w") as f:
+        json.dump(obj, f)
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, True)
+        datalist = os.path.join(tmp, "datalist.json")
+        _write_json(
+            datalist,
+            {
+                "training": [
+                    {
+                        "image": ["./imgs//a.nii", "b.nii"],
+                        "label": "lbl.nii",
+                        "modality": "CT",
+                    }
+                ]
+            },
+        )
+
+        items = load_decathalon_datalist(
+            data_list_file_path=datalist,
+            is_segmentation=True,
+            data_list_key="training",
+            base_dir=tmp,
+        )
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(
+            items[0]["image"],
+            [
+                os.path.normpath(os.path.join(tmp, "imgs", "a.nii")),
+                os.path.normpath(os.path.join(tmp, "b.nii")),
+            ],
+        )
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "lbl.nii")))
+        self.assertEqual(items[0]["modality"], "CT")
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, True)
+        datalist = os.path.join(tmp, "datalist.json")
+        _write_json(
+            datalist,
+            {
+                "training": [
+                    {"image": "img.nii", "label": 3},
+                ]
+            },
+        )
+
+        items = load_decathalon_datalist(
+            data_list_file_path=datalist,
+            is_segmentation=False,
+            data_list_key="training",
+            base_dir=tmp,
+        )
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img.nii")))
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[0]["label"], 3)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, True)
+        datalist = os.path.join(tmp, "datalist.json")
+        abs_image = os.path.join(tmp, "img.nii")
+        abs_label = os.path.join(tmp, "lbl.nii")
+        _write_json(
+            datalist,
+            {
+                "training": [
+                    {
+                        "image": abs_image,
+                        "label": abs_label,
+                    }
+                ]
+            },
+        )
+
+        items = load_decathalon_datalist(
+            data_list_file_path=datalist,
+            is_segmentation=True,
+            data_list_key="training",
+            base_dir=None,
+        )
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, True)
+        datalist = os.path.join(tmp, "datalist.json")
+        _write_json(
+            datalist,
+            {
+                "test": [
+                    "x.nii",
+                    "y.nii",
+                ]
+            },
+        )
+
+        items = load_decathalon_datalist(
+            data_list_file_path=datalist,
+            data_list_key="test",
+            base_dir=tmp,
+        )
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "x.nii")))
+        self.assertEqual(set(items[0].keys()), {"image"})
+
+
+if __name__ == "__main__":
+    unittest.main()
