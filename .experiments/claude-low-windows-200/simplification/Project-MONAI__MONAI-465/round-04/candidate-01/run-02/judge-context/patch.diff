+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' in datalist file '{file_path}' must be a string, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"'{field}' in datalist file '{file_path}' must be a string or list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its items with paths resolved.
+
+    The datalist file must contain a top-level object with the key `data_list_key`, whose value is a list of
+    entries. Each entry is an object whose "image" field is a string or list of strings. In segmentation mode the
+    "label" field is also resolved and must be a string or list of strings. In classification mode the "label" field
+    is left exactly as stored. Other fields are preserved unchanged. If `data_list_key` is "test", each entry is a
+    plain path string and is wrapped as an item whose only field is "image".
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, resolve the "label" field as a path; if False, leave it unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value holds the entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. If None, the directory portion of
+            `data_list_file_path` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the input field names. "image" (and
+        "label" in segmentation mode) hold normalized paths, either as a string or as a list of the same length
+        as the input list. For example, `[{"image": "/data/img.nii", "label": ["/data/lbl.nii"], "name": "case0"}]`.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping, "
+                f"got {item!r}."
+            )
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+
+    return items
