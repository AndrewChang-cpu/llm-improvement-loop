+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path_value(value: Any, base_dir: str, file_path: str, field: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{file_path}' must be a string or list of strings, "
+                    f"found element {element!r} of type {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist '{file_path}' must be a string or list of strings, "
+        f"found {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the image and label paths from a Medical Segmentation Decathlon style datalist JSON file.
+
+    Relative paths are resolved against ``base_dir``, or against the directory of the datalist file
+    when ``base_dir`` is None. Absolute paths are kept absolute. Each resolved path is normalized.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is a normalized path string, and items[0]["label"] is too.
+
+    The return value is a list of dictionaries in the original order of the datalist. Each dictionary
+    keeps the field names of its entry. The "image" field holds a resolved path string or a list of
+    resolved path strings with the same length as the input. In segmentation mode the "label" field
+    is resolved the same way. In classification mode "label" is left exactly as stored. Other fields
+    are not changed. When ``data_list_key`` is "test", each entry is a plain path string and is
+    returned as a dictionary with only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): when True, resolve the "label" field as a path. When False, leave
+            "label" unchanged, which allows non-path labels for classification. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory used to resolve relative paths. When None, the directory
+            of ``data_list_file_path`` is used. Defaults to None.
+
+    Raises:
+        ValueError: when the datalist file does not exist, when ``data_list_key`` is missing from the
+            datalist, when an item is not a mapping, or when a path field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in datalist file '{data_list_file_path}' must be a mapping, found {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
