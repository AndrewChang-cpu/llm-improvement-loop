+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                data_list_file_path=file_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(
+                result[0]["image"],
+                os.path.normpath(os.path.join(tempdir, "imagesTr/case_0.nii.gz")),
+            )
+            self.assertEqual(
+                result[0]["label"],
+                os.path.normpath(os.path.join(tempdir, "labelsTr/case_0.nii.gz")),
+            )
+            self.assertEqual(result[0]["fold"], 0)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "images/a.nii.gz", "label": 1},
+                    {"image": "images/b.nii.gz", "label": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                data_list_file_path=file_path,
+                is_segmentation=False,
+                data_list_key="training",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "images/a.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "images/b.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            image_path = os.path.join(tempdir, "case_0.nii.gz")
+            label_path = os.path.join(tempdir, "case_0_label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                data_list_file_path=file_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=None,
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "test": [
+                    "imagesTs/case_0.nii.gz",
+                    "imagesTs/case_1.nii.gz",
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                data_list_file_path=file_path,
+                is_segmentation=True,
+                data_list_key="test",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(
+                result[0]["image"],
+                os.path.normpath(os.path.join(tempdir, "imagesTs/case_0.nii.gz")),
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
