+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, key: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in item of key '{key}' "
+                    f"of datalist '{file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in item of key '{key}' of datalist '{file_path}' "
+        f"must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each item of the returned list is a copy of the stored entry in which ``image`` (and ``label``
+    in segmentation mode) hold resolved paths. Relative paths are joined with ``base_dir`` and
+    normalized; absolute paths stay absolute. List values are resolved element by element and keep
+    their length and order. Other fields are preserved unchanged.
+
+    When ``data_list_key`` is ``"test"``, the entries are plain path strings; each one is wrapped
+    as an item ``{"image": path}`` before resolution, regardless of ``is_segmentation``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, ``label`` is resolved as a path and must be a string or a
+            list of strings. If False, ``label`` is left exactly as stored and may be any JSON value.
+            Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which
+            uses the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        A list of dicts in the original order. For example, with ``is_segmentation=True`` and
+        ``base_dir="/data"``, the entry ``{"image": "a.nii", "label": "b.nii", "id": 1}`` becomes
+        ``{"image": "/data/a.nii", "label": "/data/b.nii", "id": 1}``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the JSON has no ``data_list_key``, an item
+            is not a mapping, or a path field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from datalist '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Item {item!r} of key '{data_list_key}' in datalist '{data_list_file_path}' must be a mapping."
+            )
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, data_list_file_path, data_list_key, "image")
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, data_list_file_path, data_list_key, "label")
+        result.append(out)
+    return result
