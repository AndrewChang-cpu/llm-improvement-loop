+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii", "label": "lbl0.nii", "extra": 3},
+                    {"image": "./sub//img1.nii", "label": "lbl1.nii", "extra": "x"},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "lbl0.nii")))
+            self.assertEqual(result[0]["extra"], 3)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "sub", "img1.nii")))
+            self.assertEqual(result[1]["extra"], "x")
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": ["a.nii", "b.nii"], "label": 1},
+                    {"image": ["c.nii", "d.nii"], "label": 0},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, False, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(
+                result[0]["image"],
+                [os.path.normpath(os.path.join(tmp, "a.nii")), os.path.normpath(os.path.join(tmp, "b.nii"))],
+            )
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "img0.nii")
+            abs_label = os.path.join(tmp, "lbl0.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["img0.nii", "img1.nii"]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
