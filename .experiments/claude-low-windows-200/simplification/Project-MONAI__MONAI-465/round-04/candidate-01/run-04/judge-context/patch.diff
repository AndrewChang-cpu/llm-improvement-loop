+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in '{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in '{data_list_file_path}' must be a string or list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each item of the returned list is a dictionary with the same field names as the input entry.
+    The "image" field is always resolved against ``base_dir``. The "label" field is resolved only
+    when ``is_segmentation`` is True; in classification mode it is kept exactly as stored (for
+    example an integer). Other fields are preserved unchanged. Path values may be a string or a
+    list of strings; each string in a list is resolved independently, keeping length and order.
+    Entries under the "test" key are plain path strings and are wrapped as ``{"image": path}``.
+
+    For example, a datalist entry ``{"image": "img.nii", "label": "lbl.nii", "fold": 0}`` loaded with
+    ``base_dir="/data"`` returns ``[{"image": "/data/img.nii", "label": "/data/lbl.nii", "fold": 0}]``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must name an existing file.
+        is_segmentation (bool): if True, resolve the "label" field of each item as a path. If False,
+            the "label" field is left exactly as stored and is not type-checked. Defaults to True.
+        data_list_key (str): top-level key in the JSON object holding the list of entries.
+            Defaults to "training". If it equals "test", each entry is a plain path string.
+        base_dir (str): directory against which relative paths are resolved. Defaults to None,
+            meaning the directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is not a string or list of strings.
+
+    Returns:
+        List[Dict[str, Any]]: processed items in original order.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        datalist = json.load(file)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Item {entry!r} in '{data_list_file_path}' under key '{data_list_key}' is not a mapping.")
+
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
