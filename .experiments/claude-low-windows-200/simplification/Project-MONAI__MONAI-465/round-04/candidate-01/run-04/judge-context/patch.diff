+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imgs/case0.nii",
+                        "label": "./labels//case0.nii",
+                        "fold": 1,
+                    },
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/case0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "a.nii", "label": 2},
+                    {"image": "b.nii", "label": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "a.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "b.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "image.nii")
+            abs_label = os.path.join(tempdir, "label.nii")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "case_a.nii",
+                    "case_b.nii",
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "case_a.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
