+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in datalist file '{data_list_file_path}' "
+                    "must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in datalist file '{data_list_file_path}' "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each returned item is a dictionary with the same field names as the stored entry. The "image" field
+    is always resolved. In segmentation mode the "label" field is resolved too; in classification mode
+    it is returned exactly as stored, so it may be any JSON value. All other fields are kept unchanged.
+    Entries under the "test" key are plain path strings and are wrapped as ``{"image": entry}``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, resolve the "label" field as a path string or list of path strings.
+            If False, leave "label" unchanged, so classification labels are not type-checked.
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON file that holds the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are joined to. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the same order as the datalist entries. Each dictionary holds the
+        resolved "image" value (and the resolved "label" value in segmentation mode) as a normalized
+        path string, or as a list of normalized path strings of the same length and order as the input.
+        For example, ``[{"image": "/data/img.nii", "label": "/data/seg.nii", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an entry is not a mapping,
+            or a path field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each datalist entry in '{data_list_file_path}' must be a mapping, got {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
