+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """Resolve a path string, or each string in a list of path strings, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must contain only strings, "
+                    f"found element of type {type(element).__name__}: {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or list of strings, "
+        f"found {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dict with its original field names. The
+    ``image`` field is always resolved against ``base_dir``. The ``label`` field is resolved only
+    when ``is_segmentation`` is True; in classification mode it is returned exactly as stored.
+    Any other fields are preserved unchanged. A path value may be a string or a list of strings;
+    list elements are resolved independently and keep their length and order.
+
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as
+    ``{"image": path}`` before resolution, regardless of ``is_segmentation``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, resolve the "label" field as a path (string or list of strings).
+            If False, "label" is left exactly as stored and not type-checked. Defaults to True.
+        data_list_key (str): top-level key in the JSON file that holds the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, defaults to the
+            directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        List[Dict[str, Any]]: processed items in their original order. For example, with
+        ``is_segmentation=True`` an item might look like
+        ``{"image": "/data/imagesTr/a.nii", "label": "/data/labelsTr/a.nii", "fold": 0}``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, cannot be parsed as JSON, lacks
+            ``data_list_key``, or contains an item that is not a mapping or has path values
+            that are not strings or lists of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in {data_list_file_path} must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Each entry under '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"found {type(item).__name__}: {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        output.append(processed)
+
+    return output
