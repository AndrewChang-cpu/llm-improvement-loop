+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {
+                    "training": [
+                        {"image": "img0.nii", "label": "lbl0.nii", "fold": 1},
+                        {"image": "./sub//img1.nii", "label": "lbl1.nii", "fold": 2},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "lbl0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "sub", "img1.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "lbl1.nii")))
+            self.assertEqual(result[1]["fold"], 2)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {
+                    "training": [
+                        {"image": ["a.nii", "b.nii"], "label": 3},
+                        {"image": "c.nii", "label": 0},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(
+                result[0]["image"],
+                [os.path.normpath(os.path.join(tempdir, "a.nii")), os.path.normpath(os.path.join(tempdir, "b.nii"))],
+            )
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "c.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img0.nii")
+            abs_label = os.path.join(tempdir, "lbl0.nii")
+            path = self._write_datalist(
+                tempdir,
+                {"training": [{"image": abs_image, "label": abs_label}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {"test": ["img0.nii", "img1.nii"]},
+            )
+            result = load_decathalon_datalist(path, True, "test", tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
