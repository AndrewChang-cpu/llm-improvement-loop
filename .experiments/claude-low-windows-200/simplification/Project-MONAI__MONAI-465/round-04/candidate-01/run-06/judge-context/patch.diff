+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the path string, or list of path strings, to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        data_list_file_path (str): datalist file path, used in error messages.
+        field (str): name of the field holding ``value``, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for index, element in enumerate(value):
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {index} of field '{field}' in '{data_list_file_path}' must be a string, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in '{data_list_file_path}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The datalist must be a JSON object containing ``data_list_key``. Its value is a list of entries.
+    Each entry under a key other than "test" is an object whose "image" (and, in segmentation mode,
+    "label") field is a path string or a list of path strings. Entries under "test" are plain path
+    strings; each is wrapped as an item whose only field is "image".
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must name an existing file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of
+            each item is resolved as a path. If False, "label" is left exactly as stored, so classification
+            labels may be any JSON value. Default is True.
+        data_list_key (str): top-level key whose value holds the entries. Default is "training".
+            Use "test" for a datalist of plain path strings.
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Default is None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the input field names and
+        any extra fields unchanged. The "image" value, and the "label" value in segmentation mode, is a
+        normalized path string, or a list of normalized path strings of the same length as the input list.
+        For example, ``[{"image": "/data/img0.nii", "label": "/data/lbl0.nii", "fold": 1}]``.
+
+    Raises:
+        ValueError: when the file does not exist, is not valid JSON, lacks ``data_list_key``, the entries
+            are not a list, an item is not a mapping, or a path value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Item {entry!r} under key '{data_list_key}' in '{data_list_file_path}' must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+    return items
