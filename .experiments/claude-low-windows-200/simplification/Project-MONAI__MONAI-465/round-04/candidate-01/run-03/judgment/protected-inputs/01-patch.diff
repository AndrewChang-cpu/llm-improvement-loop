+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): the stored path value.
+        base_dir (str): directory that relative paths are joined to.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path(s), with the same type and length as ``value``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for index, element in enumerate(value):
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {index} of field '{field}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object with the key ``data_list_key``, whose value is a list of entries.
+    For the ``"test"`` key, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    For any other key, each entry must be an object with an ``"image"`` field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the ``"label"`` field of each item is resolved as a path;
+            if False (classification), ``"label"`` is left exactly as stored and may be any JSON value.
+            Default is True.
+        data_list_key (str): top-level key of the datalist holding the entries. Default is "training".
+        base_dir (str, optional): directory that relative paths are resolved against. Default is None,
+            which uses the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        list of dict: the processed items, in the original order. Each item keeps all of its fields;
+        ``"image"``, and ``"label"`` in segmentation mode, hold resolved paths as a string or a list of
+        strings with the same length and order as the input. Other fields are unchanged.
+        For example, ``[{"image": "/data/img0.nii", "label": "/data/seg0.nii", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path field has an unsupported type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"got {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        output.append(processed)
+
+    return output
