+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "./imgs//img0.nii", "label": "segs/./seg0.nii", "fold": 0},
+                    {"image": "imgs/img1.nii", "label": "segs/seg1.nii", "fold": 1},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=tmp_dir,
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "segs/seg0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img1.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp_dir, "segs/seg1.nii")))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imgs/img0.nii", "label": 1},
+                    {"image": "imgs/img1.nii", "label": 0},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=False,
+                data_list_key="training",
+                base_dir=tmp_dir,
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img1.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img0.nii")
+            abs_label = os.path.join(tmp_dir, "seg0.nii")
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=None,
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"test": ["imgs/img0.nii", "imgs/img1.nii"]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                data_list_key="test",
+                base_dir=tmp_dir,
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
