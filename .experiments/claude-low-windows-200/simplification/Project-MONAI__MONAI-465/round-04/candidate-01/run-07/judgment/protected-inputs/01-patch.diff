+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            content = {
+                "training": [
+                    {
+                        "image": "./imgs//img0.nii",
+                        "label": "labels/lbl0.nii",
+                        "extra": "keep",
+                    },
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", tmp)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labels", "lbl0.nii")))
+            self.assertEqual(result[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            content = {
+                "training": [
+                    {
+                        "image": ["img0.nii", "img1.nii"],
+                        "label": 3,
+                    },
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, False, "training", tmp)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(
+                result[0]["image"],
+                [os.path.normpath(os.path.join(tmp, "img0.nii")), os.path.normpath(os.path.join(tmp, "img1.nii"))],
+            )
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            abs_image = os.path.join(tmp, "img0.nii")
+            abs_label = os.path.join(tmp, "lbl0.nii")
+            content = {
+                "training": [
+                    {
+                        "image": abs_image,
+                        "label": abs_label,
+                    },
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            content = {
+                "test": [
+                    "img0.nii",
+                    "img1.nii",
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "test", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
