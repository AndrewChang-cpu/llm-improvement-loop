+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, field: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' must be a string or list of strings, "
+                    f"found list element {element!r} of type {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or list of strings, "
+        f"found {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with the same field names as the input.
+    The ``"image"`` field is always resolved. The ``"label"`` field is resolved only when ``is_segmentation``
+    is True; in classification mode it is left exactly as stored, so it may be any JSON value.
+    Other fields are preserved unchanged. When ``data_list_key`` is ``"test"``, each plain string entry is
+    wrapped as ``{"image": entry}`` before resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. The file must exist.
+        is_segmentation (bool): whether to resolve the "label" field. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, which
+            means the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, in the original order. ``"image"``, and ``"label"`` in segmentation mode,
+        hold a normalized path string, or a list of normalized path strings with the same length as the input.
+        Absolute paths stay absolute.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path field is neither a string nor a list of strings.
+
+    Example:
+        With ``base_dir`` omitted and the datalist located in ``/data``, an entry
+        ``{"image": "img0.nii", "label": ["lbl0.nii"], "extra": 1}`` becomes
+        ``{"image": "/data/img0.nii", "label": ["/data/lbl0.nii"], "extra": 1}``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        content = json.load(f)
+
+    if not isinstance(content, dict) or data_list_key not in content:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = content[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, found {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
