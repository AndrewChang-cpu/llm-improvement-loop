+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            datalist = {
+                "training": [
+                    {
+                        "image": "./imgs//img0.nii.gz",
+                        "label": "labels/./seg0.nii.gz",
+                        "fold": 1,
+                    },
+                    {
+                        "image": "imgs/img1.nii.gz",
+                        "label": "labels/seg1.nii.gz",
+                        "fold": 2,
+                    },
+                ]
+            }
+            file_path = os.path.join(tmp, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "./imgs//img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labels/./seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imgs/img1.nii.gz")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp, "labels/seg1.nii.gz")))
+            self.assertEqual(result[1]["fold"], 2)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 0},
+                    {"image": "img1.nii.gz", "label": 3},
+                ]
+            }
+            file_path = os.path.join(tmp, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], 3)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            abs_image = os.path.join(tmp, "img0.nii.gz")
+            abs_label = os.path.join(tmp, "seg0.nii.gz")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            file_path = os.path.join(tmp, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            datalist = {"test": ["img0.nii.gz", "img1.nii.gz"]}
+            file_path = os.path.join(tmp, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
