+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory to join relative paths with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        (str or list of str): normalized path string, or a list of normalized
+        path strings with the same length and order as the input list.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in {file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in {file_path} must be a string or list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each item of the list under ``data_list_key`` is returned as a new dictionary with the
+    same field names. The "image" field is always resolved to a path. The "label" field is
+    resolved only when ``is_segmentation`` is True; in classification mode it is kept as stored.
+    Other fields are kept unchanged. Entries under the "test" key are plain path strings and
+    are wrapped as ``{"image": entry}`` before processing.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether to resolve the "label" field as a path. If True, "label"
+            must be a string or list of strings. If False, "label" is kept exactly as stored and
+            may be any JSON value. Default is True.
+        data_list_key (str): key in the datalist whose value is the list of entries. Default is
+            "training". When it is "test", each entry is treated as an image path.
+        base_dir (str): directory that relative paths are resolved against. Default is None,
+            which uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        (list of dict): the processed items, in their original order. Each "image" value, and
+        each "label" value in segmentation mode, is a normalized path string, or a list of
+        normalized path strings with the same length as the input list. For example,
+        ``{"image": "/data/img.nii", "label": ["/data/seg1.nii", "/data/seg2.nii"], "fold": 0}``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a
+            mapping, or a path value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file {data_list_file_path}.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
