+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": "labelsTr/case0.nii.gz", "fold": 0},
+                ]
+            }
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": 2},
+                    {"image": "imagesTr/case1.nii.gz", "label": 0},
+                ]
+            }
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imagesTr/case1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "imagesTr", "case0.nii.gz")
+            abs_label = os.path.join(tmp_dir, "labelsTr", "case0.nii.gz")
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]}
+            with open(list_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(list_path, True, "test", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/case0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
