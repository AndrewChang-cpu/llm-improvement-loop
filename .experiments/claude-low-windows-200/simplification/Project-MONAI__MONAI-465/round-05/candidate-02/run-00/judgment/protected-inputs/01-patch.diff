+
+import json
+import os
+
+
+def _resolve_decathalon_path(value, base_dir, data_list_file_path):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (str or list of str): path string, or list of path strings.
+        base_dir (str): directory used to resolve relative paths.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path(s), in the same structure as ``value``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list element {element!r} in datalist file {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"path value {value!r} in datalist file {data_list_file_path} must be a string or list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def _process_decathalon_item(item, is_segmentation, base_dir, data_list_file_path):
+    """
+    Validate one datalist item and resolve its ``image`` and, in segmentation mode, ``label`` paths.
+
+    Args:
+        item (dict): datalist entry; must be a mapping.
+        is_segmentation (bool): whether to resolve ``label`` as a path.
+        base_dir (str): directory used to resolve relative paths.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        dict: a copy of ``item`` with resolved paths.
+    """
+    if not isinstance(item, dict):
+        raise ValueError(
+            f"datalist entry {item!r} in datalist file {data_list_file_path} must be a mapping, "
+            f"got {type(item).__name__}."
+        )
+    processed = dict(item)
+    if "image" in processed:
+        processed["image"] = _resolve_decathalon_path(processed["image"], base_dir, data_list_file_path)
+    if is_segmentation and "label" in processed:
+        processed["label"] = _resolve_decathalon_path(processed["label"], base_dir, data_list_file_path)
+    return processed
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a top-level JSON object with the key ``data_list_key`` whose value is a list of entries.
+    Each entry is a mapping; its ``image`` field is resolved against ``base_dir``. When ``is_segmentation`` is True,
+    its ``label`` field is resolved as well. A ``label`` field is left exactly as stored when ``is_segmentation``
+    is False, which is the classification case where labels may be any JSON value such as an integer class id.
+    Other fields are kept verbatim. Missing ``image`` or ``label`` fields are not an error.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``
+    before validation, so the returned items have only an ``image`` field.
+
+    Path values are resolved as follows: a string is joined with ``base_dir`` and normalized, and absolute strings
+    stay absolute; a list has each element resolved independently, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. Must name an existing file.
+        is_segmentation (bool): if True, resolve ``label`` fields as paths and require them to be strings or lists
+            of strings. If False, ``label`` values are returned unchanged. Defaults to True.
+        data_list_key (str): top-level key whose value holds the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory portion
+            of ``data_list_file_path``.
+
+    Returns:
+        list: processed items in the original order. Each item is a dict with resolved ``image`` (and, in
+        segmentation mode, ``label``) values, plus any other fields kept verbatim. Example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, is not a JSON object containing ``data_list_key``, or if any entry
+            or path value fails validation.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"datalist file {data_list_file_path} does not contain key {data_list_key!r}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"value of key {data_list_key!r} in datalist file {data_list_file_path} must be a list, "
+            f"got {type(entries).__name__}."
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    return [_process_decathalon_item(item, is_segmentation, base_dir, data_list_file_path) for item in entries]
