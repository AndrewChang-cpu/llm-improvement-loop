+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+
+    Returns:
+        str or list of str: normalized path(s), with list order and length preserved.
+
+    Raises:
+        ValueError: if ``value`` is not a string, or a list whose elements are all strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"path list elements must be strings, got {element!r} of type {type(element).__name__}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or list of strings, got {value!r} of type {type(value).__name__}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object with the key ``data_list_key`` whose value is a list of entries.
+    For the ``"test"`` key, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Otherwise each entry must be a mapping. Its ``"image"`` field is resolved, and its ``"label"`` field is
+    resolved only when ``is_segmentation`` is true. Other fields are kept unchanged.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, ``"label"`` values must be strings or lists of strings and are resolved.
+            If False (classification), ``"label"`` is left exactly as stored, such as an integer class id.
+            Defaults to True.
+        data_list_key (str): top-level key whose value holds the entries. Defaults to "training".
+        base_dir (Optional[str]): directory used to resolve relative paths. If None, the directory portion of
+            ``data_list_file_path`` is used (without making it absolute). Defaults to None.
+
+    Returns:
+        List[Dict[str, Any]]: processed items in the original order. Each item is a dict with resolved
+        ``"image"`` (and, in segmentation mode, ``"label"``) values, where a string path becomes a normalized
+        string and a list of paths becomes a list of normalized strings. Extra fields are kept verbatim.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+            # items[0] -> {"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", ...}
+
+    Raises:
+        ValueError: if the file does not exist, cannot be parsed as JSON, lacks ``data_list_key``, or contains
+            an entry or path value that fails validation.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value for key '{data_list_key}' must be a list in datalist file: {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each entry under key '{data_list_key}' must be a mapping, got {item!r} in {data_list_file_path}"
+            )
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir)
+        processed.append(item)
+    return processed
