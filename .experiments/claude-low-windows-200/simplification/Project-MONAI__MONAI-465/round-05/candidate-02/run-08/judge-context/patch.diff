+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path, or a list of normalized paths in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in {file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The datalist is a JSON object whose ``data_list_key`` entry holds a list of items. Each
+    non-"test" item is an object whose "image" field is a string or a list of strings. In
+    segmentation mode the "label" field is also a string or a list of strings and is resolved;
+    in classification mode "label" is left exactly as stored (it may be any JSON value, such as
+    an integer class id). Other fields are kept verbatim. Missing "image" or "label" fields are
+    not an error.
+
+    For the "test" key, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the "label" field as a path; if False, leave
+            "label" unchanged. Defaults to True.
+        data_list_key (str): key of the datalist object whose value is the list of items.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which
+            uses the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        list of dict: the processed items, in the original order. Each item is a new dictionary
+        with the same keys as the stored item; "image" (and "label" in segmentation mode) hold
+        normalized paths, either as a string or as a list of strings in the original order.
+        For the "test" key, each item is a dictionary with the single key "image".
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+            # items[0]["image"] and items[0]["label"] are normalized paths relative to the datalist directory
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not an object,
+            or a path field has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in datalist file {data_list_file_path} "
+                f"must be an object, got {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
