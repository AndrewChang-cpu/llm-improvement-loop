+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_datalist_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to resolve relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' contains a non-string "
+                    f"element: {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key``, whose value is a list of entries.
+    Entries under the key ``"test"`` are plain path strings and are wrapped as ``{"image": path}``.
+    Every other entry must be a mapping. Its ``"image"`` field is resolved when present. Its
+    ``"label"`` field is resolved only when ``is_segmentation`` is true; otherwise it is left exactly
+    as stored, so classification labels such as integer class ids are kept unchanged. Other fields
+    are kept verbatim.
+
+    Path values are joined with ``base_dir`` and normalized. Absolute paths stay absolute. A list of
+    paths is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether the labels are segmentation paths. If True, ``"label"`` is
+            resolved as a path or list of paths. If False, ``"label"`` is returned unchanged. Defaults to True.
+        data_list_key (str): key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory used to resolve relative paths. Defaults to None, which means
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        List[Dict[str, Any]]: the processed items, in the original order. Each item is a dict that
+        contains the resolved fields and any extra fields from the datalist. For example,
+        ``[{"image": "/data/img0.nii", "label": "/data/seg0.nii", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an
+            ``"image"`` or segmentation ``"label"`` value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list of entries."
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_datalist_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_datalist_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
