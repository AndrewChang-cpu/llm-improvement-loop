+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(path, content):
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            _write_datalist(
+                datalist_path,
+                {
+                    "training": [
+                        {"image": "./imgs//a.nii", "label": "lbls/../lbls/a_seg.nii", "fold": 0},
+                        {"image": "imgs/b.nii", "label": "lbls/b_seg.nii", "fold": 1},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(datalist_path, True, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "lbls/a_seg.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imgs/b.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp, "lbls/b_seg.nii")))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            _write_datalist(
+                datalist_path,
+                {
+                    "training": [
+                        {"image": "imgs/a.nii", "label": 2},
+                        {"image": "imgs/b.nii", "label": 0},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(datalist_path, False, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imgs/b.nii")))
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            abs_image = os.path.join(tmp, "a.nii")
+            abs_label = os.path.join(tmp, "a_seg.nii")
+            _write_datalist(datalist_path, {"training": [{"image": abs_image, "label": abs_label}]})
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            _write_datalist(datalist_path, {"test": ["imgs/t0.nii", "imgs/t1.nii"]})
+            result = load_decathalon_datalist(datalist_path, True, "test", tmp)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/t0.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
