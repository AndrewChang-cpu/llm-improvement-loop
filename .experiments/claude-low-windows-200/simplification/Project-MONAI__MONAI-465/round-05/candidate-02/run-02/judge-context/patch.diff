+import json
+import os
+from typing import Any, List, Optional
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list whose elements are all strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file '{file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Any]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object with the key ``data_list_key`` whose value is a list
+    of entries. Entries under the ``"test"`` key are plain path strings and are wrapped as
+    ``{"image": entry}`` before processing. Every other entry must be a mapping.
+
+    In each item, the ``"image"`` field is resolved when present. The ``"label"`` field is resolved
+    only when ``is_segmentation`` is True; in classification mode it is left exactly as stored, so
+    it may be any JSON value such as an integer class id. All other fields are kept unchanged.
+    A string path is joined with ``base_dir`` and normalized; absolute paths stay absolute.
+    A list of paths is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field; otherwise leave it unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key whose value holds the entries. Defaults to "training".
+        base_dir (Optional[str]): directory used to resolve relative paths. Defaults to None, which
+            means the directory containing ``data_list_file_path``.
+
+    Returns:
+        List[Any]: the processed items, in their original order. Each item is a dict with the
+        resolved ``"image"`` (and, in segmentation mode, ``"label"``) fields plus any extra fields.
+        For the ``"test"`` key, each item is a dict with only the ``"image"`` field.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping,
+            or a path field is not a string or a list of strings.
+
+    Example::
+
+        [{"image": "/data/img0.nii", "label": "/data/lbl0.nii", "fold": 0}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        result = dict(item)
+        if "image" in result:
+            result["image"] = _resolve_path_value(result["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in result:
+            result["label"] = _resolve_path_value(result["label"], base_dir, "label", data_list_file_path)
+        processed.append(result)
+    return processed
