+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value taken from a datalist entry.
+
+    A string is joined with `base_dir` and normalized. A list is resolved element by element, keeping its length
+    and order; every element must be a string. Any other type is an error.
+
+    Args:
+        value (Any): the stored path value, a string or list of strings.
+        base_dir (str): directory used to resolve relative paths.
+        field (str): name of the datalist field being resolved, used in error messages.
+        file_path (str): path of the datalist file, used in error messages.
+
+    Returns:
+        (str or list of str): the resolved path, or a list of resolved paths.
+
+    Raises:
+        ValueError: if `value` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in data list file '{file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in data list file '{file_path}' must be a string or list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain `data_list_key`, whose value is a list of entries. Each non-"test" entry
+    is an object. Its "image" field is resolved and, when `is_segmentation` is True, its "label" field is resolved
+    too. In classification mode the "label" field is left exactly as stored, so it may be any JSON value such as an
+    integer class id. Other fields are kept unchanged. For the "test" key, each entry is a plain path string and is
+    wrapped as an item with the single field "image".
+
+    Path values are resolved as follows: a string is joined with `base_dir` and normalized, and absolute strings stay
+    absolute; a list of strings has each element resolved independently, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the "label" field as a path; if False, leave it unchanged.
+            Defaults to True.
+        data_list_key (str): key in the top-level JSON object whose value is the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means the
+            directory portion of `data_list_file_path`, without making it absolute.
+
+    Returns:
+        (list of dict): the processed items in their original order. Each item is a dict with the resolved "image"
+        field and, in segmentation mode, the resolved "label" field, plus any extra fields kept verbatim. Items for
+        the "test" key are dicts with only the "image" field. Example:
+        `[{"image": "/data/img0.nii", "label": "/data/seg0.nii", "fold": 1}]`
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path field is not a
+            string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} under key '{data_list_key}' in '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in item:
+            new_item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            new_item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+    return processed
