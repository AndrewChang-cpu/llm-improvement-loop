+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory used to resolve relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path, or a list of normalized paths in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file '{file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object whose ``data_list_key`` maps to a list of entries. For every key other than
+    ``"test"``, each entry is an object. Its ``"image"`` value is resolved as a path (string or list of strings).
+    If ``is_segmentation`` is True, its ``"label"`` value is resolved the same way; otherwise the label is kept
+    exactly as stored, so classification labels such as integer class ids are not type-checked or modified.
+    Missing ``"image"`` or ``"label"`` fields are not an error, and all other fields are kept verbatim.
+
+    For ``data_list_key == "test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``
+    before resolution, regardless of ``is_segmentation``.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths are kept absolute.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each item as a path. Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, which uses the directory
+            portion of ``data_list_file_path``.
+
+    Returns:
+        list of dict: the processed items in their original order. Each item is a dict with resolved ``"image"``
+        (and, in segmentation mode, ``"label"``) fields plus any extra fields from the datalist. For the
+        ``"test"`` key, each item is a dict containing only ``"image"``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, is not valid JSON, lacks ``data_list_key``, contains a
+            non-mapping item, or contains a path value that is not a string or list of strings.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+            # items[0] == {"image": "/data/imgs/case0.nii.gz", "label": "/data/labels/case0.nii.gz", "fold": 0}
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
