+# limitations under the License.
+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "./imgs//case1.nii.gz", "label": "labels/case1.nii.gz", "fold": 2},
+                ]
+            }
+            path = _write_datalist(tmp, content)
+            items = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=True, data_list_key="training", base_dir=tmp
+            )
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "case1.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "labels", "case1.nii.gz")))
+            self.assertEqual(items[0]["fold"], 2)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            content = {"training": [{"image": "case1.nii.gz", "label": 3}]}
+            path = _write_datalist(tmp, content)
+            items = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=False, data_list_key="training", base_dir=tmp
+            )
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "case1.nii.gz")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 3)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "img.nii.gz")
+            label = os.path.join(tmp, "lbl.nii.gz")
+            content = {"training": [{"image": image, "label": label}]}
+            path = _write_datalist(tmp, content)
+            items = load_decathalon_datalist(
+                data_list_file_path=path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "lbl.nii.gz")))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            content = {"test": ["t1.nii.gz", "t2.nii.gz"]}
+            path = _write_datalist(tmp, content)
+            items = load_decathalon_datalist(data_list_file_path=path, data_list_key="test", base_dir=tmp)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "t1.nii.gz")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
