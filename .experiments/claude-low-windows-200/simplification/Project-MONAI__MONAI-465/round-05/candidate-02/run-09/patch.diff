+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(path, content):
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(
+                list_path,
+                {
+                    "training": [
+                        {"image": "./imgs//case_0.nii.gz", "label": "labels/case_0.nii.gz", "fold": 1},
+                    ]
+                },
+            )
+            base_dir = os.path.join(tmp_dir, "base")
+            result = load_decathalon_datalist(list_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/case_0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(
+                list_path,
+                {
+                    "training": [
+                        {"image": "imgs/case_0.nii.gz", "label": 2},
+                        {"image": "imgs/case_1.nii.gz", "label": 0},
+                    ]
+                },
+            )
+            base_dir = os.path.join(tmp_dir, "base")
+            result = load_decathalon_datalist(list_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case_0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            image_path = os.path.join(tmp_dir, "case_0.nii.gz")
+            label_path = os.path.join(tmp_dir, "case_0_seg.nii.gz")
+            _write_datalist(list_path, {"training": [{"image": image_path, "label": label_path}]})
+            result = load_decathalon_datalist(list_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            list_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(list_path, {"test": ["imgs/case_0.nii.gz", "imgs/case_1.nii.gz"]})
+            base_dir = os.path.join(tmp_dir, "base")
+            result = load_decathalon_datalist(list_path, data_list_key="test", base_dir=base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case_0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
