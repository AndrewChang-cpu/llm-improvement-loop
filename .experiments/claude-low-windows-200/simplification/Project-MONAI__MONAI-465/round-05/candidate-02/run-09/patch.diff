+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_key: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_key (str): key of the entry list, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same order and length.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list whose elements are all strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for index, element in enumerate(value):
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {index} of field '{field}' under key '{data_list_key}' in "
+                    f"'{data_list_file_path}' must be a string, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' under key '{data_list_key}' in '{data_list_file_path}' must be a string "
+        f"or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key``, whose value is a list of entries.
+    Each entry is an object; its "image" field (and "label" field in segmentation mode) is resolved
+    against ``base_dir``. A string is joined with ``base_dir`` and normalized; absolute strings stay
+    absolute. A list is resolved element by element, keeping its length and order. Other fields are
+    kept verbatim. Missing "image" or "label" fields are not an error.
+
+    When ``is_segmentation`` is True, "label" must be a string or list of strings and is resolved.
+    When it is False, "label" is left exactly as stored, so it may be any JSON value such as an
+    integer class id.
+
+    When ``data_list_key`` is "test", each entry is a plain path string and is wrapped as an object
+    whose only field is "image" before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the datalist is for segmentation, so that "label" is resolved
+            as a path. Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            which means the directory portion of ``data_list_file_path``.
+
+    Returns:
+        a list of dicts, one per entry, in the original order. Each dict holds the entry's fields, with
+        resolved "image" (and "label" in segmentation mode) values. For example::
+
+            [{"image": "/data/imgs/case_0.nii.gz", "label": "/data/labels/case_0.nii.gz", "fold": 1}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not an object,
+            or a path value has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Top-level JSON value in '{data_list_file_path}' must be an object.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in '{data_list_file_path}' must be an object, "
+                f"got {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_key, data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_key, data_list_file_path)
+        processed.append(new_item)
+
+    return processed
