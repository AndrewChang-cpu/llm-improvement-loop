+import json
+import os
+
+
+def _resolve_path(value, base_dir, field, file_path):
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value: a string or list of strings holding the path(s) to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the original order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"element {element!r} of field '{field}' in datalist file {file_path} must be a string"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"field '{field}' in datalist file {file_path} must be a string or list of strings, got {value!r}"
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its entries with resolved paths.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; it must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False,
+            "label" is left exactly as stored, so classification labels such as integer class ids are kept.
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value is the list of entries.
+            Defaults to "training". When the key is "test", each entry is a plain path string and is wrapped
+            as an item with only an "image" field.
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion of
+            `data_list_file_path` is used (not made absolute). Defaults to None.
+
+    Returns:
+        list of dicts, one per entry, in the original order. Each dict is a copy of the stored entry with
+        "image" (and "label" in segmentation mode) replaced by a normalized path string, or a list of
+        normalized path strings if the stored value was a list. Other fields are kept verbatim. A missing
+        "image" or "label" field is not an error. For the "test" key, each dict has only an "image" field.
+
+        Example::
+
+            [{"image": "/data/imgs/case_0.nii.gz", "label": "/data/labels/case_0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the JSON does not contain `data_list_key`, an item is
+            not a mapping, or an "image" or segmentation "label" value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file {data_list_file_path} must hold a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"item {item!r} under key '{data_list_key}' in datalist file {data_list_file_path} must be a mapping"
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
