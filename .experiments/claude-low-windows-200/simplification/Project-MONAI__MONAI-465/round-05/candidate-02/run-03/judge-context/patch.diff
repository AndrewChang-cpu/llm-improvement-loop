+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(file_path, content):
+    with open(file_path, "w") as f:
+        json.dump(content, f)
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(
+                file_path,
+                {"training": [{"image": "imgs/./a.nii.gz", "label": "labels//a.nii.gz", "fold": 1}]},
+            )
+            base_dir = os.path.join(tmp_dir, "base")
+            result = load_decathalon_datalist(file_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/./a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels//a.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(
+                file_path,
+                {"training": [{"image": "imgs/b.nii.gz", "label": 2}, {"image": "imgs/c.nii.gz", "label": 0}]},
+            )
+            base_dir = os.path.join(tmp_dir, "base")
+            result = load_decathalon_datalist(file_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/b.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/c.nii.gz")))
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            abs_image = os.path.join(tmp_dir, "image.nii.gz")
+            abs_label = os.path.join(tmp_dir, "label.nii.gz")
+            _write_datalist(file_path, {"training": [{"image": abs_image, "label": abs_label}]})
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            _write_datalist(file_path, {"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]})
+            base_dir = os.path.join(tmp_dir, "base")
+            result = load_decathalon_datalist(file_path, True, "test", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/t0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
