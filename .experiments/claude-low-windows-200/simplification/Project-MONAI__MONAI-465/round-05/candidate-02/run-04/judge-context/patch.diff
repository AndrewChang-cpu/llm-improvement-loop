+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {
+                        "image": "./imgs//case0.nii.gz",
+                        "label": "labels/case0.nii.gz",
+                        "fold": 1,
+                    }
+                ]
+            }
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "./imgs//case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imgs/case0.nii.gz", "label": 2},
+                    {"image": "imgs/case1.nii.gz", "label": 0},
+                ]
+            }
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "image.nii.gz")
+            abs_label = os.path.join(tempdir, "label.nii.gz")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["imgs/test0.nii.gz", "imgs/test1.nii.gz"]}
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/test0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
