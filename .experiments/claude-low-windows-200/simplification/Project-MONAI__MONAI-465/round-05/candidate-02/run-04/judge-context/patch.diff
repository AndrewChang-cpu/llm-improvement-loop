+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized path, or list of normalized paths in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list whose elements are all strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in '{data_list_file_path}' must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object with ``data_list_key`` mapping to a list of entries.
+    For the key ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Otherwise each entry must be an object. Its ``"image"`` value is resolved when present.
+    Its ``"label"`` value is resolved only when ``is_segmentation`` is true; in classification
+    mode the label is left exactly as stored, so it may be any JSON value such as an integer.
+    Other fields are kept unchanged. A path value that is a string is joined with ``base_dir``
+    and normalized; absolute strings stay absolute. A list of strings is resolved element by element,
+    keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve the ``"label"`` field as a path (segmentation mode).
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which
+            means the directory portion of ``data_list_file_path``.
+
+    Returns:
+        list of dict: the processed items, in the original order. Each item is a dict holding the
+        entry's fields, with resolved ``"image"`` and, in segmentation mode, ``"label"`` values.
+
+    Example::
+
+        [{"image": "/data/imgs/case0.nii.gz", "label": "/data/labels/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, the entries are not valid,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Key '{data_list_key}' in '{data_list_file_path}' must map to a list of entries.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in '{data_list_file_path}' must be a mapping, "
+                f"got {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
