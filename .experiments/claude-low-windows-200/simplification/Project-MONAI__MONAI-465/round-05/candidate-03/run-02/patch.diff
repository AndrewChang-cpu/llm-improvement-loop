+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value against `base_dir`.
+
+    A string is joined with `base_dir` and normalized; an absolute string stays absolute. A list must contain only
+    strings, each resolved independently, keeping length and order. Any other type raises ValueError.
+
+    Args:
+        value (Any): the stored path value, a string or list of strings.
+        base_dir (str): directory against which relative paths are joined.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        (str or list of str): the resolved path or list of paths.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for elem in value:
+            if not isinstance(elem, str):
+                raise ValueError(f"Field '{field}' in {file_path} must be a list of strings, found element {elem!r}.")
+        return [os.path.normpath(os.path.join(base_dir, elem)) for elem in value]
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain `data_list_key`, whose value is a list of entries. For each entry, which
+    must be a mapping, the "image" field is resolved against `base_dir`. The "label" field is resolved only when
+    `is_segmentation` is True; in classification mode it is kept exactly as stored, for example as an integer class
+    id. Other fields are kept unchanged. When `data_list_key` is "test", each entry is a plain path string, which is
+    wrapped as an item whose only field is "image".
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must name an existing file.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): key in the JSON object holding the entry list. Defaults to "training".
+        base_dir (str): directory against which relative paths are resolved. Defaults to None, meaning the directory
+            containing `data_list_file_path`, taken without making it absolute.
+
+    Returns:
+        (list of dict): the processed items in their original order. Each is a dict with the input field names, where
+        "image", and "label" in segmentation mode, hold resolved paths (a string, or a list of strings).
+        For example, `[{"image": "/data/imagesTr/a.nii.gz", "label": "/data/labelsTr/a.nii.gz", "fold": 0}]`.
+
+    Raises:
+        ValueError: if the file does not exist, the JSON top level is not an object, `data_list_key` is missing or not
+            a list, an item is not a mapping, or a path value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+
+    if not isinstance(data, Mapping):
+        raise ValueError(f"Top-level JSON in {data_list_file_path} must be an object.")
+    if data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each entry under key '{data_list_key}' in {data_list_file_path} must be an object.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
