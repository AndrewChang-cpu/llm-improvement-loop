+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as file:
+        json.dump(content, file)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": "lbl0.nii.gz", "fold": 0},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=base_dir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "lbl0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 1},
+                    {"image": ["a.nii.gz", "b.nii.gz"], "label": 0},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=base_dir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "a.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "b.nii.gz")),
+                ],
+            )
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "image.nii.gz")
+            abs_label = os.path.join(tempdir, "label.nii.gz")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "test": [
+                    "t0.nii.gz",
+                    "t1.nii.gz",
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=base_dir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "t0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
