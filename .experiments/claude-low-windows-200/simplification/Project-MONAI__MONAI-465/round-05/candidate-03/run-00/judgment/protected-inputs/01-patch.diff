+
+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path_value(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """Resolve a path value (string or list of strings) against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' must contain only strings, "
+                    f"got element {element!r} of type {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or list of strings, "
+        f"got {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load the Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    Each entry of the list under ``data_list_key`` is returned as a dictionary with the same
+    field names. The ``"image"`` field is always resolved against ``base_dir``. The ``"label"``
+    field is resolved only when ``is_segmentation`` is True; otherwise it is kept as stored, so
+    classification labels such as integer class ids are unchanged. Other fields are kept verbatim.
+    Entries under the ``"test"`` key are plain path strings and are wrapped as ``{"image": path}``.
+
+    The return value is a list of dictionaries in the original order, for example
+    ``[{"image": "/data/img0.nii.gz", "label": "/data/lbl0.nii.gz", "fold": 0}]``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must exist.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key of the JSON object holding the entry list.
+            Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None,
+            meaning the directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, an item is
+            not a mapping, or a path field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        try:
+            json_data = json.load(file)
+        except json.JSONDecodeError as error:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {error}") from error
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Each entry in datalist file '{data_list_file_path}' must be a mapping, "
+                f"got {entry!r} of type {type(entry).__name__}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path_value(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path_value(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+
+    return items
