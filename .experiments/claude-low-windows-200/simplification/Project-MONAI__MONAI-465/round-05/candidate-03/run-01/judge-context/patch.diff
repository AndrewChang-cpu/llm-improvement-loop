+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): the stored path value
+        base_dir (str): directory that relative paths are joined with
+        data_list_file_path (str): datalist file path, used in error messages
+        field (str): name of the field being resolved, used in error messages
+
+    Returns:
+        (str or list of str): normalized resolved path(s), same type and order as ``value``
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file '{data_list_file_path}' "
+                    "must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict]:
+    """
+    Load the image and label lists of a Medical Segmentation Decathlon datalist JSON file.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with the same field names as the
+    input. The "image" field is always resolved against ``base_dir``. The "label" field is resolved
+    only when ``is_segmentation`` is True; in classification mode it is kept exactly as stored (for
+    example, an integer class id). Any other fields are kept verbatim. Relative paths are joined with
+    ``base_dir`` and normalized; absolute paths stay absolute. When ``data_list_key`` is "test", the
+    entries are plain path strings and each is wrapped as ``{"image": path}``.
+
+    Args:
+        data_list_file_path (str): path to the Decathalon datalist JSON file, must exist
+        is_segmentation (bool): whether the datalist is for segmentation, if True the "label" field is
+            resolved as a path, default True
+        data_list_key (str): key in the JSON top-level object holding the entry list, default "training"
+        base_dir (str, optional): directory to resolve relative paths against, default None, which uses
+            the directory portion of ``data_list_file_path``
+
+    Returns:
+        (list of dict): processed items in the original order, e.g.
+        ``[{"image": "/data/img0.nii", "label": "/data/lbl0.nii", "fold": 0}]``
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, has a
+            non-mapping item, or has an "image" or segmentation "label" value that is not a string or
+            list of strings
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        try:
+            data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
