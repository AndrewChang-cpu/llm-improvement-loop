+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory used to join relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements must be strings in datalist file {data_list_file_path}, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' must be a string or a list of strings in datalist file {data_list_file_path}, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key``. Its value is the list of entries.
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as
+    ``{"image": entry}``. Otherwise each entry must be a JSON object.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths are kept absolute.
+    The ``"image"`` field is always resolved. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; in classification mode it is left as stored (for example, an integer
+    class id). Other fields are kept verbatim. Missing ``"image"`` or ``"label"`` fields are not errors.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether the labels are segmentation paths to resolve. Defaults to True.
+            When False, ``"label"`` values are returned unchanged.
+        data_list_key (str): top-level key holding the entry list. Defaults to ``"training"``.
+            Use ``"test"`` for a datalist whose entries are plain image path strings.
+        base_dir (str): directory used to resolve relative paths. Defaults to None, which means the
+            directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        List[Dict[str, Any]]: processed items in their original order. Each item is a dict with the same
+        field names as the input. ``"image"``, and ``"label"`` in segmentation mode, hold resolved paths.
+        For example, ``[{"image": "/data/img0.nii", "label": "/data/label0.nii", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains
+            a non-mapping item or an ``"image"``/``"label"`` value of the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in datalist file {data_list_file_path}.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item must be a mapping in datalist file {data_list_file_path}, got {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
