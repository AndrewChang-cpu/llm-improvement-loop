+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory to join relative paths with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the resolved string, or a new list of resolved strings in the same order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements must be strings in datalist file {data_list_file_path}, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' must be a string or a list of strings in datalist file {data_list_file_path}, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the datalist of a Medical Segmentation Decathlon JSON file and resolve its paths.
+
+    Each item in the returned list is a dictionary with the same field names as the stored entry. The "image"
+    field is always resolved against ``base_dir``. The "label" field is resolved only when ``is_segmentation``
+    is True; otherwise it is kept exactly as stored (for example an integer class id). Other fields are kept
+    verbatim. Entries under the "test" key are plain path strings, so each is wrapped as ``{"image": path}``
+    before resolution. Items are returned in their original order.
+
+    Args:
+        data_list_file_path (str): path to the Decathalon datalist JSON file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation, so that "label" is resolved as a path.
+            Default is True.
+        data_list_key (str): key in the top-level JSON object whose value is the list of entries.
+            Default is "training".
+        base_dir (str, optional): directory that relative paths are joined with. Default is None, which uses the
+            directory portion of ``data_list_file_path``, without making it absolute.
+
+    Raises:
+        ValueError: when the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an item
+            that is not a mapping or has a path value that is not a string or list of strings.
+
+    Returns:
+        list of dict: the processed items, in original order. For example, a segmentation item may look like
+        ``{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' must hold a list in datalist file {data_list_file_path}.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each datalist item must be a mapping in datalist file {data_list_file_path}, got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
