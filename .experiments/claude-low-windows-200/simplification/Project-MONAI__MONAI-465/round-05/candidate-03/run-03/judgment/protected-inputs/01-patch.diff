+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _make_temp_dir(test_case):
+    tmp = tempfile.mkdtemp()
+    test_case.addCleanup(shutil.rmtree, tmp, True)
+    return tmp
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "dataset.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = _make_temp_dir(self)
+        path = _write_datalist(
+            tmp,
+            {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": "labelsTr/case0.nii.gz", "fold": 0},
+                    {"image": "imagesTr/case1.nii.gz", "label": "labelsTr/case1.nii.gz", "fold": 1},
+                ]
+            },
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+        expected = [
+            {
+                "image": os.path.normpath(os.path.join(tmp, "imagesTr/case0.nii.gz")),
+                "label": os.path.normpath(os.path.join(tmp, "labelsTr/case0.nii.gz")),
+                "fold": 0,
+            },
+            {
+                "image": os.path.normpath(os.path.join(tmp, "imagesTr/case1.nii.gz")),
+                "label": os.path.normpath(os.path.join(tmp, "labelsTr/case1.nii.gz")),
+                "fold": 1,
+            },
+        ]
+        self.assertEqual(result, expected)
+
+    def test_cls_values(self):
+        tmp = _make_temp_dir(self)
+        path = _write_datalist(
+            tmp,
+            {
+                "training": [
+                    {"image": "case0.nii.gz", "label": 0},
+                    {"image": "case1.nii.gz", "label": 2},
+                ]
+            },
+        )
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "case0.nii.gz")))
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "case1.nii.gz")))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 0)
+        self.assertIsInstance(result[1]["label"], int)
+        self.assertEqual(result[1]["label"], 2)
+
+    def test_seg_no_basedir(self):
+        tmp = _make_temp_dir(self)
+        abs_image = os.path.join(tmp, "case0.nii.gz")
+        abs_label = os.path.join(tmp, "case0_label.nii.gz")
+        path = _write_datalist(
+            tmp,
+            {"training": [{"image": abs_image, "label": abs_label}]},
+        )
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp = _make_temp_dir(self)
+        path = _write_datalist(
+            tmp,
+            {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]},
+        )
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs/case0.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
