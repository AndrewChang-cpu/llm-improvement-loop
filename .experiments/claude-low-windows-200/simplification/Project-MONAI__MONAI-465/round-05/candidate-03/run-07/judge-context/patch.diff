+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str, key: str) -> Any:
+    """
+    Resolve a path value against ``base_dir``. Strings are joined and normalized, absolute strings stay absolute,
+    and lists of strings are resolved element by element. Any other type raises ``ValueError``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element of '{field}' list in key '{key}' of file '{file_path}' must be a string, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in key '{key}' of file '{file_path}' must be a string or list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the datalist file of the Medical Segmentation Decathlon and return per-case items with paths resolved
+    against a base directory.
+
+    In segmentation mode (``is_segmentation=True``) both "image" and "label" are resolved as paths. In
+    classification mode only "image" is resolved and "label" is kept verbatim, so integer class ids stay integers.
+    Other fields are kept unchanged. For the "test" key, each entry is a plain path string and is wrapped as
+    ``{"image": path}``.
+
+    The return value is a list of dicts in the original order, with the input field names. "image" (and "label"
+    in segmentation mode) hold resolved paths: a string or a list of strings, depending on the input.
+
+    Args:
+        data_list_file_path (str): the path of the Decathalon datalist JSON file.
+        is_segmentation (bool): whether the datalist is for segmentation; if True, "label" is resolved as a path,
+            otherwise it is left as stored. Defaults to True.
+        data_list_key (str): the key in the JSON file whose value is the list of entries, e.g. "training" or
+            "test". Defaults to "training".
+        base_dir (str): the directory that relative paths are resolved against. If None, the directory of
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or list of strings.
+
+    Example:
+        >>> items = load_decathalon_datalist("dataset.json", data_list_key="training", base_dir="/data")
+        >>> items[0]["image"]  # e.g. "/data/imagesTr/case_000.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item in key '{data_list_key}' of file '{data_list_file_path}' must be a mapping, got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(
+                processed["image"], base_dir, "image", data_list_file_path, data_list_key
+            )
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(
+                processed["label"], base_dir, "label", data_list_file_path, data_list_key
+            )
+        output.append(processed)
+    return output
