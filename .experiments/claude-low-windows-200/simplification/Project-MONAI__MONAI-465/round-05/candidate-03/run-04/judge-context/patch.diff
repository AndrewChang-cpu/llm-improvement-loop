+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{field}' in {file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{field}' in {file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    In segmentation mode (``is_segmentation=True``) both "image" and "label" are resolved
+    against ``base_dir``; their values must be a string or a list of strings. In classification
+    mode (``is_segmentation=False``) only "image" is resolved, and "label" is kept exactly as
+    stored, so an integer class id stays an integer. Other fields are returned unchanged.
+    Missing "image" or "label" fields are not an error.
+
+    When ``data_list_key`` is "test", each entry is a plain path string and is wrapped as
+    ``{"image": entry}`` before processing, regardless of ``is_segmentation``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the labels are segmentation paths to resolve. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None,
+            which uses the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as the input entry,
+        with "image" (and "label" in segmentation mode) replaced by resolved paths. For example,
+        ``[{"image": "/data/img.nii", "label": "/data/lbl.nii", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the JSON lacks ``data_list_key``, an item is not a
+            mapping, or a path value has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in {data_list_file_path}.")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item in '{data_list_key}' of {data_list_file_path} must be a mapping, got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        result.append(processed)
+    return result
