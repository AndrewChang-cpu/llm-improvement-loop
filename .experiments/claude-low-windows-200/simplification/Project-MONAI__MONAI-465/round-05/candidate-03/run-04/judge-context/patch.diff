+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tmp,
+                {"training": [{"image": "img.nii", "label": "lbl.nii", "fold": 0}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "lbl.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tmp,
+                {"training": [{"image": "img.nii", "label": 1}, {"image": "img2.nii", "label": 0}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "img.nii")
+            abs_label = os.path.join(tmp, "lbl.nii")
+            path = _write_datalist(
+                tmp,
+                {"training": [{"image": abs_image, "label": abs_label}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(tmp, {"test": ["a.nii", "b.nii"]})
+            result = load_decathalon_datalist(path, True, "test", tmp)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "a.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
