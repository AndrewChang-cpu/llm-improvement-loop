+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, key: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        key (str): name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{key}' in datalist file {file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{key}' in datalist file {file_path} must be a string or a list of strings, got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the image and label paths of a Medical Segmentation Decathlon datalist JSON file.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with the same field names as the file.
+    The ``"image"`` field is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; in classification mode it is left as stored, so integer class ids stay integers.
+    Other fields are kept verbatim. Missing ``"image"`` or ``"label"`` fields are not an error. When
+    ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+
+    Returns a list of dictionaries in the original order, for example
+    ``[{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether to resolve the ``"label"`` field as a path. Defaults to True.
+        data_list_key (str): top-level key of the JSON object that holds the entry list. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, which uses
+            the directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: when the file does not exist, is not valid JSON, lacks ``data_list_key``, an item is not a
+            mapping, or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file not found: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item in '{data_list_key}' of datalist file {data_list_file_path} must be a mapping, "
+                f"got {type(item).__name__}."
+            )
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+    return items
