+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value against ``base_dir``. Strings are joined and normalized;
+    lists are resolved element by element. Any other type raises ``ValueError``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of field '{field}' in '{file_path}' must be a string.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' in '{file_path}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its items with
+    ``"image"`` (and, in segmentation mode, ``"label"``) resolved against ``base_dir``.
+
+    Each returned item is a dictionary with the same field names as the stored entry.
+    Other fields are kept verbatim. Items are returned in their original order. When
+    ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped
+    as ``{"image": path}`` before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; must exist.
+        is_segmentation (bool): if True, ``"label"`` is resolved as a path (string or list of strings).
+            If False (classification), ``"label"`` is left exactly as stored, e.g. an integer class id.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to ``"training"``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses
+            the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        List[Dict[str, Any]]: processed items in original order. For example,
+        ``[{"image": "/data/img0.nii.gz", "label": "/data/lbl0.nii.gz", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``,
+            or contains an item or path value of an unexpected type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in datalist file '{data_list_file_path}' must be a mapping, got {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
