+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory against which relative paths are joined.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings in the original order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' must contain only strings, "
+                    f"found element {element!r} of type {type(element).__name__}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"found {value!r} of type {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with the same field names.
+    The "image" field is always resolved against ``base_dir``. The "label" field is resolved only
+    when ``is_segmentation`` is True; otherwise it is returned as stored, so classification
+    labels such as integer class ids are kept unchanged. Other fields are kept verbatim.
+    Entries under the "test" key are plain path strings and are returned as dictionaries
+    with only an "image" field.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key whose value is the entry list. Defaults to "training".
+        base_dir (Optional[str]): directory against which relative paths are joined. If None,
+            defaults to the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries in the original order. For example, with
+        ``is_segmentation=True``, an entry ``{"image": "img.nii", "label": "lbl.nii", "fold": 0}``
+        in directory ``/data`` becomes ``{"image": "/data/img.nii", "label": "/data/lbl.nii", "fold": 0}``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, the entries are not a list,
+            an item is not a mapping, or a path value has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, found {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
