+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized string path, or a list of normalized string paths with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file '{file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key``, whose value is a list of entries.
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as
+    ``{"image": entry}``. Otherwise each entry must be a JSON object.
+
+    For every item, the ``"image"`` field is resolved against ``base_dir``. The ``"label"`` field
+    is resolved only when ``is_segmentation`` is True; in classification mode it is left as stored
+    and may hold any JSON value, such as an integer class id. Other fields are kept unchanged.
+    A path value may be a string, which is joined with ``base_dir`` and normalized (absolute
+    strings stay absolute), or a list of strings, where each element is resolved independently.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the items are segmentation items. If True, the ``"label"``
+            field is resolved as a path. Defaults to True.
+        data_list_key (str): key in the JSON object whose value holds the list of entries.
+            Defaults to "training".
+        base_dir (Optional[str]): directory used to resolve relative paths. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary has the same field names as the
+        input entry, with ``"image"`` (and ``"label"`` in segmentation mode) holding resolved paths.
+        For example, ``[{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz"}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a
+            path field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist file '{data_list_file_path}' must be a mapping.")
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
