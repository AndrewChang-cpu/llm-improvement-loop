+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": "img/0.nii.gz", "label": "seg/0.nii.gz", "fold": 1},
+                ]
+            }
+            with open(data_list_file, "w") as f:
+                json.dump(content, f)
+
+            base_dir = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(data_list_file, True, "training", base_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img/0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "seg/0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            content = {
+                "training": [
+                    {"image": "img/0.nii.gz", "label": 2},
+                    {"image": ["img/1a.nii.gz", "img/1b.nii.gz"], "label": 0},
+                ]
+            }
+            with open(data_list_file, "w") as f:
+                json.dump(content, f)
+
+            base_dir = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(data_list_file, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img/0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "img/1a.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "img/1b.nii.gz")),
+                ],
+            )
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            abs_image = os.path.join(tempdir, "img0.nii.gz")
+            abs_label = os.path.join(tempdir, "seg0.nii.gz")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(data_list_file, "w") as f:
+                json.dump(content, f)
+
+            result = load_decathalon_datalist(data_list_file, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            content = {"test": ["img/0.nii.gz", "img/1.nii.gz"]}
+            with open(data_list_file, "w") as f:
+                json.dump(content, f)
+
+            base_dir = os.path.join(tempdir, "root")
+            result = load_decathalon_datalist(data_list_file, data_list_key="test", base_dir=base_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img/0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
