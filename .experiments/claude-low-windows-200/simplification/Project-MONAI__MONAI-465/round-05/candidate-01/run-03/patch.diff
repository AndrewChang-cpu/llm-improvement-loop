+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tmp_dir, "data")
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "training": [
+                        {"image": "imagesTr/img0.nii.gz", "label": "labelsTr/seg0.nii.gz", "fold": 1},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", base)
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(base, "imagesTr/img0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(base, "labelsTr/seg0.nii.gz")),
+                    "fold": 1,
+                }
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tmp_dir, "data")
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "training": [
+                        {"image": "img0.nii.gz", "label": 2},
+                        {"image": ["a/img1.nii.gz", "./b//img2.nii.gz"], "label": 0},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, False, "training", base)
+            expected = [
+                {"image": os.path.normpath(os.path.join(base, "img0.nii.gz")), "label": 2},
+                {
+                    "image": [
+                        os.path.normpath(os.path.join(base, "a/img1.nii.gz")),
+                        os.path.normpath(os.path.join(base, "./b//img2.nii.gz")),
+                    ],
+                    "label": 0,
+                },
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp_dir, "img0.nii.gz")
+            label = os.path.join(tmp_dir, "seg0.nii.gz")
+            path = self._write_datalist(tmp_dir, {"training": [{"image": image, "label": label}]})
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result, [{"image": os.path.normpath(image), "label": os.path.normpath(label)}])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base = os.path.join(tmp_dir, "data")
+            path = self._write_datalist(tmp_dir, {"test": ["imagesTs/img0.nii.gz", "imagesTs/img1.nii.gz"]})
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=base)
+            self.assertEqual(
+                result[0]["image"],
+                os.path.normpath(os.path.join(base, "imagesTs/img0.nii.gz")),
+            )
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
