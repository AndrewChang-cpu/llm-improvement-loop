+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory the relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        the resolved string, or a list of resolved strings in the same order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, "
+                    f"but a list element has value {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, "
+        f"but got value {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the datalist of a Medical Segmentation Decathlon style JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key``, whose value is a list of entries.
+    If ``data_list_key`` is "test", each entry is a plain path string and is wrapped as
+    ``{"image": entry}``. Every other entry must be a JSON object.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of each
+            item is resolved as a path, and it must be a string or a list of strings. If False, "label" is kept
+            exactly as stored, and it may be any JSON value, such as an integer class id. Defaults to True.
+        data_list_key (str): key of the list of entries in the JSON object. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        A list of dictionaries, in the same order as the input entries. Each dictionary keeps the input field
+        names. The "image" field, and the "label" field in segmentation mode, hold the resolved paths: a string
+        when the input is a string, or a list of strings in the same order when the input is a list. Other
+        fields are unchanged. For example, ``[{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz"}]``.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or an item is not
+            a mapping or has a path value of the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping, "
+                f"but got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
