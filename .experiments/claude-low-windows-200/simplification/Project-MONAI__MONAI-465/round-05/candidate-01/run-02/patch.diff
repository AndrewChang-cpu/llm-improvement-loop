+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, key: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        file_path (str): datalist file path, used in error messages.
+        key (str): field name, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{key}' in '{file_path}' must be a string or a list of strings, "
+                    f"but a list element is {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{key}' in '{file_path}' must be a string or a list of strings, but got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with the same field names as
+    the file. The "image" field is always resolved. The "label" field is resolved only when
+    ``is_segmentation`` is True; in classification mode it is kept as stored, so integer class ids
+    stay integers. Other fields are kept verbatim. Relative paths are joined with ``base_dir`` and
+    normalized; absolute paths stay absolute.
+
+    When ``data_list_key`` is "test", the file holds plain path strings. Each string is wrapped
+    as ``{"image": path}`` before processing, regardless of ``is_segmentation``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the datalist holds segmentation labels. If True, the "label"
+            field of each entry is resolved against ``base_dir``. If False, the "label" field is
+            returned unchanged and may be any JSON value. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same
+        field names as its entry, with "image" (and "label" in segmentation mode) holding resolved paths.
+
+    Raises:
+        ValueError: when the file does not exist, the key is missing, an entry is not a mapping,
+            or a path value is not a string or a list of strings.
+
+    Example:
+        A datalist with ``{"training": [{"image": "a.nii.gz", "label": "a_seg.nii.gz"}]}`` loaded from
+        ``/data/datalist.json`` returns ``[{"image": "/data/a.nii.gz", "label": "/data/a_seg.nii.gz"}]``.
+
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in '{data_list_file_path}' must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Entry {entry!r} under key '{data_list_key}' in '{data_list_file_path}' must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        processed.append(item)
+    return processed
