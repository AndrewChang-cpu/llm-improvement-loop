+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {"training": [{"image": "img_a.nii", "label": "label_a.nii", "fold": 0}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "label_a.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {"training": [{"image": "img_a.nii", "label": 1}, {"image": "img_b.nii", "label": 2}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_a.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img_b.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertEqual(result[1]["label"], 2)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            image_path = os.path.join(tempdir, "img_a.nii")
+            label_path = os.path.join(tempdir, "label_a.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {"test": ["img_0.nii", "img_1.nii"]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_0.nii")))
+
+
+if __name__ == "__main__":
+    unittest.main()
