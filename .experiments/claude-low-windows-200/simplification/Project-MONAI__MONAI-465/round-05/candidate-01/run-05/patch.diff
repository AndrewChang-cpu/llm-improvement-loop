+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string or a list of strings.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{file_path}' must be a string or list of strings, "
+                    f"found list element {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' in datalist '{file_path}' must be a string or list of strings, found {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key`` whose value is a list of entries. For the key
+    ``"test"`` each entry is a plain path string and is wrapped as ``{"image": entry}``. Otherwise each entry
+    must be a mapping whose ``"image"`` value is a string or list of strings. In segmentation mode the
+    ``"label"`` value must also be a string or list of strings; in classification mode it is kept as stored
+    (for example an integer class id). Other fields are kept verbatim.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths stay absolute. A list of
+    paths is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether the entries are segmentation items. If True, the ``"label"`` field is
+            resolved as a path; if False, it is left unchanged. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to ``"training"``.
+        base_dir (str): directory that relative paths are resolved against. If None, the directory portion
+            of ``data_list_file_path`` is used (not made absolute). Defaults to None.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input entry, with
+        ``"image"`` (and ``"label"`` in segmentation mode) replaced by resolved paths. For the ``"test"`` key
+        each dict has only the ``"image"`` field.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an
+            item that is not a mapping or has a path field of the wrong type.
+
+    Example:
+        >>> items = load_decathalon_datalist("dataset.json", data_list_key="training", base_dir="/data")
+        >>> items[0]["image"]  # e.g. "/data/imagesTr/case_0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Datalist file '{data_list_file_path}' has no key '{data_list_key}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, found {item!r}."
+            )
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_decathalon_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_decathalon_path(out["label"], base_dir, "label", data_list_file_path)
+        processed.append(out)
+    return processed
