+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [{"image": "imagesTr/case_0.nii.gz", "label": "labelsTr/case_0.nii.gz", "fold": 1}]
+            }
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "case_0.nii.gz", "label": 0},
+                    {"image": "case_1.nii.gz", "label": 1},
+                ]
+            }
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "case_0.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "case_1.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 1)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "image.nii.gz")
+            label = os.path.join(tmp, "label.nii.gz")
+            content = {"training": [{"image": image, "label": label}]}
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            content = {"test": ["case_0.nii.gz", "case_1.nii.gz"]}
+            path = self._write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "case_0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
