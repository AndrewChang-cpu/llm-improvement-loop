+import json
+import os
+from collections.abc import Mapping
+
+
+def _resolve_decathalon_path(value, base_dir, key, file_path):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (str or list of str): path string, or list of path strings.
+        base_dir (str): directory that relative paths are joined with.
+        key (str): name of the datalist field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{key}' in datalist file '{file_path}' must be a string or a list of strings, "
+                    f"but a list element has value {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{key}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"but got value {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path,
+    is_segmentation=True,
+    data_list_key="training",
+    base_dir=None,
+):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key`` whose value is a list of entries.
+    Entries under the ``"test"`` key are plain path strings and are wrapped as ``{"image": entry}``.
+    Every other entry must be a mapping. Its ``"image"`` field is resolved against ``base_dir``.
+    When ``is_segmentation`` is True, its ``"label"`` field is resolved too; when False, ``"label"``
+    is left exactly as stored, so classification labels such as integer class ids are kept.
+    Other fields are kept unchanged. A field that is absent from an entry is not checked.
+
+    Path values are resolved as follows: a string is joined with ``base_dir`` and normalized, and an
+    absolute string stays absolute. A list of strings has each element resolved independently, keeping
+    its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. Must name an existing file.
+        is_segmentation (bool): whether to resolve the ``"label"`` field. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning the
+            directory portion of ``data_list_file_path``, not made absolute.
+
+    Returns:
+        list: processed items in the original order. Each item is a dict with the same field names as the
+        input entry. ``"image"``, and ``"label"`` in segmentation mode, hold resolved paths: a string or
+        a list of strings. For the ``"test"`` key, each item is a dict with only the ``"image"`` field.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a
+            path field is not a string or list of strings.
+
+    Example:
+        A datalist ``{"training": [{"image": "a.nii", "label": "a_seg.nii", "fold": 0}]}`` loaded from
+        ``/data/datalist.json`` returns ``[{"image": "/data/a.nii", "label": "/data/a_seg.nii", "fold": 0}]``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(
+            f"Data list under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list."
+        )
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in data_list:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, but got {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_decathalon_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_decathalon_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
