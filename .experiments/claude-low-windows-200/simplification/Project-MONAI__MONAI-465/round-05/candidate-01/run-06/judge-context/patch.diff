+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "training": [
+                        {"image": "imagesTr/a.nii", "label": "labelsTr/a.nii", "fold": 0},
+                        {"image": "imagesTr/./b.nii", "label": "labelsTr//b.nii", "fold": 1},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", base_dir)
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(base_dir, "imagesTr/a.nii")),
+                    "label": os.path.normpath(os.path.join(base_dir, "labelsTr/a.nii")),
+                    "fold": 0,
+                },
+                {
+                    "image": os.path.normpath(os.path.join(base_dir, "imagesTr/b.nii")),
+                    "label": os.path.normpath(os.path.join(base_dir, "labelsTr/b.nii")),
+                    "fold": 1,
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            path = self._write_datalist(
+                tmp_dir,
+                {
+                    "training": [
+                        {"image": "imagesTr/a.nii", "label": 0},
+                        {"image": "imagesTr/b.nii", "label": 3},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, False, "training", base_dir)
+            expected = [
+                {"image": os.path.normpath(os.path.join(base_dir, "imagesTr/a.nii")), "label": 0},
+                {"image": os.path.normpath(os.path.join(base_dir, "imagesTr/b.nii")), "label": 3},
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "a.nii")
+            label_path = os.path.join(tmp_dir, "a_seg.nii")
+            path = self._write_datalist(
+                tmp_dir,
+                {"training": [{"image": image_path, "label": label_path}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result, [{"image": image_path, "label": label_path}])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            path = self._write_datalist(
+                tmp_dir,
+                {"test": ["imagesTs/a.nii", "imagesTs/b.nii"]},
+            )
+            result = load_decathalon_datalist(path, True, "test", base_dir)
+            self.assertEqual(
+                result[0]["image"],
+                os.path.normpath(os.path.join(base_dir, "imagesTs/a.nii")),
+            )
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
