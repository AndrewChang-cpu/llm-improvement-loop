+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_datalist_path(value: Any, base_dir: str, data_list_file_path: str, data_list_key: str, field: str) -> Any:
+    """Resolve a single path string or a list of path strings against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in key '{data_list_key}' of file "
+                    f"'{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in key '{data_list_key}' of file '{data_list_file_path}' "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    The file must be a JSON object containing ``data_list_key``, whose value is a list of entries.
+    Each entry is a mapping; its ``"image"`` field (a string or list of strings) is resolved against
+    ``base_dir``. When ``is_segmentation`` is true, its ``"label"`` field is resolved the same way;
+    when it is false, the label is left exactly as stored (for example, an integer class id).
+    Other fields are kept verbatim. If ``data_list_key`` is ``"test"``, each entry is a plain path
+    string and is wrapped as ``{"image": entry}`` before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve the ``"label"`` field of each entry. Defaults to True.
+        data_list_key (str): top-level key in the JSON file holding the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, in the same order as the entries in the file. Each dict has the same field names
+        as the input entry, with ``"image"`` (and ``"label"`` in segmentation mode) replaced by resolved paths.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, or an entry or path value is invalid.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, Mapping):
+        raise ValueError(f"Data list file '{data_list_file_path}' must contain a JSON object at the top level.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, Mapping):
+            raise ValueError(
+                f"Entry {entry!r} in key '{data_list_key}' of data list file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_datalist_path(item["image"], base_dir, data_list_file_path, data_list_key, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_datalist_path(item["label"], base_dir, data_list_file_path, data_list_key, "label")
+        items.append(item)
+
+    return items
