+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {"training": [{"image": "img0.nii", "label": "lbl0.nii", "fold": 0}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, True, "training", tempdir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tempdir, "lbl0.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {"training": [{"image": "img0.nii", "label": 1}, {"image": "img1.nii", "label": 0}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, False, "training", tempdir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "img0.nii")
+            label_path = os.path.join(tempdir, "lbl0.nii")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {"test": ["img0.nii", "img1.nii"]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
