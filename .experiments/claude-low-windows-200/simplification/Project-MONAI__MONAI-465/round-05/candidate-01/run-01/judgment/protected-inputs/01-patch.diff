+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as file:
+        json.dump(content, file)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tmp,
+                {
+                    "training": [
+                        {"image": "./imagesTr/img0.nii", "label": "labelsTr/lbl0.nii", "fold": 1},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr", "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr", "lbl0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(
+                tmp,
+                {
+                    "training": [
+                        {"image": "img0.nii", "label": 2},
+                        {"image": ["a/img1.nii", "./b/img2.nii"], "label": 0},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp, "a", "img1.nii")),
+                    os.path.normpath(os.path.join(tmp, "b", "img2.nii")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "img0.nii")
+            label = os.path.join(tmp, "lbl0.nii")
+            path = _write_datalist(tmp, {"training": [{"image": image, "label": label}]})
+            result = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_datalist(tmp, {"test": ["imagesTs/t0.nii", "imagesTs/t1.nii"]})
+            result = load_decathalon_datalist(path, True, "test", tmp)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs", "t0.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
