+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(
+    value: Any, base_dir: str, data_list_file_path: str, data_list_key: str, field: str
+) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory the relative paths are joined with.
+        data_list_file_path (str): datalist file, used in error messages.
+        data_list_key (str): key of the entry the value belongs to, used in error messages.
+        field (str): name of the field holding the value, used in error messages.
+
+    Returns:
+        the resolved string, or a list of resolved strings in the same order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' under key '{data_list_key}' in '{data_list_file_path}' "
+                    f"must be a string or a list of strings, found list element {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' under key '{data_list_key}' in '{data_list_file_path}' "
+        f"must be a string or a list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key``, whose value is a list of entries.
+    For the key ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Every other entry must be a mapping. Its ``"image"`` field is resolved; its ``"label"`` field
+    is resolved only when ``is_segmentation`` is True, and is otherwise kept as stored. All other
+    fields are kept unchanged. A field that is absent from an entry is not added.
+
+    Path values may be strings or lists of strings. A string is joined with ``base_dir`` and
+    normalized, so an absolute string stays absolute. Each element of a list is resolved
+    independently, and the list keeps its length and order.
+
+    The return value is a list with one dict per entry, in the original order. The dicts use the
+    input field names, and their ``"image"`` (and, in segmentation mode, ``"label"``) values hold
+    resolved paths. For example, with ``base_dir="/data"`` and ``is_segmentation=True``, the entry
+    ``{"image": "imagesTr/a.nii", "label": "labelsTr/a.nii", "fold": 0}`` becomes
+    ``{"image": "/data/imagesTr/a.nii", "label": "/data/labelsTr/a.nii", "fold": 0}``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, ``"label"`` values must be strings or lists of strings and are
+            resolved against ``base_dir``. If False, ``"label"`` values are returned unchanged and may be
+            any JSON value, such as an integer class id. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to ``"training"``.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        List[Dict[str, Any]]: the processed entries, in original order.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an
+            entry or path value of an unsupported type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        data = json.load(file)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' was not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in '{data_list_file_path}' must be a mapping, "
+                f"found {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_decathalon_path(
+                new_item["image"], base_dir, data_list_file_path, data_list_key, "image"
+            )
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_decathalon_path(
+                new_item["label"], base_dir, data_list_file_path, data_list_key, "label"
+            )
+        processed.append(new_item)
+
+    return processed
