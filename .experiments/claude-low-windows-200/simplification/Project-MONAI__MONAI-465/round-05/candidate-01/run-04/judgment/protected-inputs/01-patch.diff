+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "img1.nii", "label": "seg1.nii", "fold": 0},
+                    {"image": ["a.nii", "b.nii"], "label": "seg2.nii"},
+                ]
+            }
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "seg1.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [os.path.normpath(os.path.join(tempdir, "a.nii")), os.path.normpath(os.path.join(tempdir, "b.nii"))],
+            )
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "seg2.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"training": [{"image": "img1.nii", "label": 2}, {"image": "img2.nii", "label": 0}]}
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img2.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img1.nii")
+            abs_label = os.path.join(tempdir, "seg1.nii")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["test1.nii", "test2.nii"]}
+            path = self._write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, True, "test", tempdir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "test1.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
