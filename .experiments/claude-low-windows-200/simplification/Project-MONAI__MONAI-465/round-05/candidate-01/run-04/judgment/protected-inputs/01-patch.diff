+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory to join relative paths with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+                    f"found list element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key``, whose value is a list of entries.
+    For ``data_list_key == "test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Otherwise each entry must be a JSON object. Its ``"image"`` field (when present) is resolved as a path
+    or list of paths. When ``is_segmentation`` is True, its ``"label"`` field (when present) is resolved
+    the same way. In classification mode (``is_segmentation`` False) the ``"label"`` value is left as stored,
+    and it may be any JSON value, such as an integer class id. All other fields are kept verbatim.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must exist.
+        is_segmentation (bool): whether labels are paths to resolve (segmentation mode). Defaults to True.
+            When False, the ``"label"`` field is not resolved or type-checked.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``. The directory is not made absolute.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the input field names, with ``"image"`` and,
+        in segmentation mode, ``"label"`` holding resolved paths (a string, or a list of strings if the
+        input was a list). For ``data_list_key == "test"``, each dict contains only the ``"image"`` field.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path
+            field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not contain key '{data_list_key}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
