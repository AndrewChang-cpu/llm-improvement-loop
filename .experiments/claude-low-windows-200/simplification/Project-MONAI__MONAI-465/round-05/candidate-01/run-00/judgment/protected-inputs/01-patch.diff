+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized string path, or a list of normalized string paths with the same order and length.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' contains a non-string "
+                    f"element: {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key`` whose value is a list of entries.
+    For ``data_list_key == "test"``, each entry is a plain path string and is wrapped as
+    ``{"image": entry}`` before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of
+            each item is resolved as a path (a string or list of strings). If False, "label" is left
+            exactly as stored, so classification labels such as integer class ids are kept. Defaults to True.
+        data_list_key (str): key in the JSON object that holds the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, defaults to the directory
+            portion of ``data_list_file_path``, not made absolute.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, has an item that
+            is not a mapping, or has a path value that is not a string or list of strings.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as the
+        input item. The "image" field, and the "label" field when ``is_segmentation`` is True, hold resolved
+        paths: a string stays a string, and a list of strings stays a list of the same length and order.
+        Other fields are kept verbatim. Items without an "image" or "label" field are not rejected.
+
+    Example:
+        With ``base_dir="/data"``, the datalist entry ``{"image": "imagesTr/a.nii", "label": "labelsTr/a.nii"}``
+        becomes ``{"image": "/data/imagesTr/a.nii", "label": "/data/labelsTr/a.nii"}`` in segmentation mode.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list, got {entries!r}."
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item in key '{data_list_key}' of datalist file '{data_list_file_path}' must be a mapping, "
+                f"got {item!r}."
+            )
+        new_item = dict(item)
+        fields = ["image", "label"] if is_segmentation else ["image"]
+        for field in fields:
+            if field in new_item:
+                new_item[field] = _resolve_path(new_item[field], base_dir, field, data_list_file_path)
+        processed.append(new_item)
+
+    return processed
