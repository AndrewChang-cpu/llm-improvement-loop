+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value (str or list of str): the path or list of paths to resolve.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        str or list of str: normalized resolved path(s), with the same structure as `value`.
+
+    Raises:
+        ValueError: if `value` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in '{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in '{data_list_file_path}' must be a string or list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object whose `data_list_key` entry is a list. Each entry is an object; its "image"
+    field (and "label" field in segmentation mode) is resolved against `base_dir`. A relative path is joined with
+    `base_dir` and normalized, an absolute path is kept absolute, and a list of paths is resolved element by element.
+    In segmentation mode, "label" is resolved as a path or list of paths. In classification mode, "label" is left
+    exactly as stored, so it may be any JSON value such as an integer class id. Other fields are kept verbatim, and
+    items without "image" or "label" are not rejected.
+
+    When `data_list_key` is "test", each entry is a plain path string, which is wrapped as an item with only an
+    "image" field before resolution.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether to resolve "label" as a path (True, the default) or leave it unchanged
+            (False, classification mode).
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses the
+            directory portion of `data_list_file_path`, without making it absolute.
+
+    Returns:
+        list of dict: the processed items, in the original order. Each item is a dict with the same field names as
+        the input entry, where "image" (and "label" in segmentation mode) hold resolved paths.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if `data_list_key` is missing, if an item is not
+            a mapping, or if a path field is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Data list file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in '{data_list_file_path}' must be a mapping, "
+                f"got {item!r}."
+            )
+        output = dict(item)
+        if "image" in output:
+            output["image"] = _resolve_path(output["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in output:
+            output["label"] = _resolve_path(output["label"], base_dir, "label", data_list_file_path)
+        processed.append(output)
+    return processed
