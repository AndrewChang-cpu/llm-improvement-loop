+
+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {
+                "training": [{"image": "img0.nii", "label": "label0.nii", "fold": 1}],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "label0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {
+                "training": [{"image": "img0.nii", "label": 1}, {"image": "img1.nii", "label": 0}],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=False,
+                data_list_key="training",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            image_path = os.path.join(tempdir, "img0.nii")
+            label_path = os.path.join(tempdir, "label0.nii")
+            datalist = {
+                "training": [{"image": image_path, "label": label_path}],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=None,
+            )
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {
+                "test": ["img0.nii", "img1.nii"],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path,
+                data_list_key="test",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+
+
+if __name__ == "__main__":
+    unittest.main()
