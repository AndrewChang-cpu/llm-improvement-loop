+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of paths, against ``base_dir``.
+
+    Args:
+        value (Any): a string path or a list of string paths.
+        base_dir (str): directory the paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"field '{field}' in datalist {file_path} contains a non-string element: {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"field '{field}' in datalist {file_path} must be a string or list of strings, got: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return per-case items with
+    the "image" (and, in segmentation mode, "label") paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field is resolved as a path. If False, the label
+            is left exactly as stored, so classification labels such as integers pass through unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key whose value holds the list of entries. Defaults to "training".
+            If it equals "test", each entry is a plain path string and is converted to an image-only item.
+        base_dir (str): directory that relative paths are joined with. If None, defaults to the directory
+            of ``data_list_file_path``. Absolute paths stay absolute.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same fields as its input item, with
+        "image" (and "label" in segmentation mode) replaced by resolved paths. A path given as a string
+        comes back as a string, and a path given as a list comes back as a list of resolved strings with
+        the same length and order. All other fields are kept unchanged.
+
+    Example::
+
+        {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0}]}
+
+        load_decathalon_datalist("/data/dataset.json") returns
+        [{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing from datalist {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"every item in datalist {data_list_file_path} must be a mapping, got: {item!r}")
+
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        result.append(new_item)
+
+    return result
