+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {
+                "training": [
+                    {
+                        "image": "./imagesTr//img0.nii.gz",
+                        "label": "labelsTr/seg0.nii.gz",
+                        "fold": 0,
+                    }
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=base_dir
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "./imagesTr//img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labelsTr/seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 1},
+                    {"image": ["img1.nii.gz", "img2.nii.gz"], "label": 3},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=base_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "img0.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "img1.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "img2.nii.gz")),
+                ],
+            )
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 3)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "img0.nii.gz")
+            label_path = os.path.join(tempdir, "seg0.nii.gz")
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            datalist = {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="test", base_dir=base_dir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertNotIn("label", result[0])
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imagesTs/case0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
