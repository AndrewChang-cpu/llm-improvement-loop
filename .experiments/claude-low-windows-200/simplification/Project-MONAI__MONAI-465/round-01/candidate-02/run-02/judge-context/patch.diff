+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized. Lists are resolved element by element.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist '{data_list_file_path}' "
+                    "must be a string."
+                )
+        return [_resolve_path(element, base_dir, field, data_list_file_path) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return per-case items with
+    image (and, in segmentation mode, label) paths resolved against ``base_dir``.
+
+    Entries are read from the ``data_list_key`` key of the JSON object. If ``data_list_key`` is ``"test"``,
+    each entry is a plain path string and is converted to an item containing only ``"image"``.
+    Other fields of each item are kept unchanged. The label is only resolved when ``is_segmentation`` is True;
+    otherwise it is returned exactly as stored, for example as an integer class id.
+
+    The return value is a list of dicts in the original order. Each dict has the same fields as the input item.
+    ``"image"`` (and ``"label"`` in segmentation mode) is a string if the input was a string, or a list of
+    resolved strings with the same length and order if the input was a list.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}, ...]
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): if True, resolve the "label" field as a path. If False, leave "label" unchanged.
+            Defaults to True.
+        data_list_key (str): key under which the list of entries is stored in the JSON object.
+            Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            which means the directory of the datalist file.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each item in datalist '{data_list_file_path}' must be a mapping, got {item!r}.")
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, "label", data_list_file_path)
+        result.append(out)
+    return result
