+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a single path string, or each string element of a list, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        return [_resolve_path(element, base_dir, field, file_path) for element in value]
+    raise ValueError(
+        f"Field '{field}' in data list file '{file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Entries are read from the list stored under ``data_list_key``. The "image" field of every item is resolved
+    against ``base_dir``, and so is the "label" field when ``is_segmentation`` is True. Each path is joined with
+    ``base_dir`` and normalized; an absolute path stays absolute. A list-valued path is resolved element by element,
+    keeping its length and order. All other fields are kept unchanged.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, "label" is resolved as a path.
+            If False, "label" is left exactly as stored, for example an integer class id. Defaults to True.
+        data_list_key (str): key under which the list of entries is stored. If it equals "test", each plain
+            string entry is converted to an image-only item ``{"image": entry}``. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses the
+            directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same fields as the input item.
+        "image", and "label" in segmentation mode, hold resolved paths: a string when the input was a string, or
+        a list of resolved strings with the same count and order when the input was a list.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, base_dir="/data/task01")
+        # items[0]["image"] is a normalized path under /data/task01
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing, if an item is not a
+            mapping, or if a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Data list key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Item {entry!r} under key '{data_list_key}' in data list file '{data_list_file_path}' "
+                "is not a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
