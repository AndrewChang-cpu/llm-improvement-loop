+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": "labels/a.nii", "fold": 0},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels/a.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 1},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, False, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            image_path = os.path.join(tmp_dir, "a.nii")
+            label_path = os.path.join(tmp_dir, "a_label.nii")
+            datalist = {
+                "training": [
+                    {"image": image_path, "label": label_path},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp_dir:
+            datalist = {
+                "test": ["imgs/a.nii", "imgs/b.nii"],
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "test", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii")))
+            self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
