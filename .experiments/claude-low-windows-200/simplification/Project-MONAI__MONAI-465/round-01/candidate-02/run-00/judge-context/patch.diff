+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against `base_dir`.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all strings.
+        base_dir (str): directory the relative paths are joined with.
+
+    Raises:
+        ValueError: when `value` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element must be a string, got {type(element).__name__}: {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return its items with resolved paths.
+
+    The entries under `data_list_key` are processed in order. Each item's "image" value is resolved against
+    `base_dir`. When `is_segmentation` is True, the "label" value is resolved too; when False, the label is
+    kept exactly as stored, so integer class ids and class-name strings are not altered. Any other field is
+    left unchanged. A path value can be a string or a list of strings; each list element is resolved
+    independently, and the output list keeps the same length and order. Items without "image" or "label"
+    are not rejected. If `data_list_key` is "test", each plain string entry is converted to an image-only
+    item ``{"image": entry}`` before resolution.
+
+    Example::
+
+        load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}, ...]
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key in the JSON object whose value is the list of entries.
+            Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            meaning the directory containing `data_list_file_path`.
+
+    Returns:
+        A list of dicts with the same field names as the input items. The "image" value, and the "label"
+        value in segmentation mode, is a string when the input was a string, or a list of resolved strings
+        with the same length and order when the input was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: when the file does not exist, `data_list_key` is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' is missing in file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"each item must be a mapping, got {type(item).__name__} in file: {data_list_file_path}")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir)
+        items.append(resolved)
+
+    return items
