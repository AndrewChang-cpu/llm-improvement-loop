+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value against ``base_dir``. A string is joined and normalized; a list
+    applies the same rule to each element independently, keeping length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element {element!r} must be a string, got {type(element).__name__}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value {value!r} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return its per-case items
+    with the "image" (and, in segmentation mode, "label") paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; it must exist.
+        is_segmentation (bool): if True, "label" is resolved as a path; if False, "label" is left
+            exactly as stored (for example an integer class id), and only "image" is resolved.
+            Default is True.
+        data_list_key (str): top-level key holding the list of entries. Default is "training".
+            When it is "test", each plain string entry is converted to an image-only item.
+        base_dir (str, optional): directory that relative paths are resolved against. Default is
+            None, meaning the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order. Each dict keeps the fields of its input item; "image"
+        (and "label" in segmentation mode) hold resolved paths, as a string if the input was a string
+        or as a list of resolved strings with the same count and order if the input was a list.
+        All other fields are unchanged. For example, with ``base_dir="/data"`` and an entry
+        ``{"image": "img/a.nii.gz", "label": "seg/a.nii.gz"}``, the result is
+        ``{"image": "/data/img/a.nii.gz", "label": "/data/seg/a.nii.gz"}``.
+
+    Raises:
+        ValueError: if the file does not exist, ``data_list_key`` is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' is missing from data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"data_list_key '{data_list_key}' in '{data_list_file_path}' must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"each item under '{data_list_key}' in '{data_list_file_path}' must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir)
+        result.append(processed)
+    return result
