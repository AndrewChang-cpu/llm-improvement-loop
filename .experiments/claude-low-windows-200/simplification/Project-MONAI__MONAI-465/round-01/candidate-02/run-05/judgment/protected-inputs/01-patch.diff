+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value against ``base_dir``. A string is joined with ``base_dir`` and normalized.
+    A list is resolved element by element, each element handled exactly like a single string.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element must be a string, got {element!r} of type {type(element)}.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Path value must be a string or list of strings, got {value!r} of type {type(value)}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with
+    the "image" (and, in segmentation mode, "label") paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): the path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, "label" is resolved as a
+            path. If False, "label" is returned exactly as stored, whatever its type (e.g. an integer class id).
+            Defaults to True.
+        data_list_key (str): the top-level key under which the list of entries is stored. Defaults to "training".
+            If it equals "test", each plain string entry is converted to an image-only item ``{"image": entry}``.
+        base_dir (str): the directory that relative paths are resolved against. If None, the directory portion
+            of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same fields as the input item.
+        "image" is a resolved path string, or a list of resolved path strings with the same count and order
+        if the input was a list. In segmentation mode, "label" is resolved the same way. All other fields are
+        unchanged.
+
+    Example::
+
+        # datalist.json: {"training": [{"image": "imgs/a.nii", "label": "labs/a.nii"}]}
+        items = load_decathalon_datalist("/data/datalist.json", base_dir="/data")
+        # items == [{"image": "/data/imgs/a.nii", "label": "/data/labs/a.nii"}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path, "r") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in datalist file {data_list_file_path}.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each datalist item must be a mapping, got {item!r} in {data_list_file_path}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir)
+        items.append(processed)
+    return items
