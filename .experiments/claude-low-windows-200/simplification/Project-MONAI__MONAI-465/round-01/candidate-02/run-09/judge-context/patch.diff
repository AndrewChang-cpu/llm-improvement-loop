+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path_value: Any, base_dir: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of paths, against ``base_dir``.
+
+    Args:
+        path_value (Any): a string path, or a list of string paths.
+        base_dir (str): directory the relative paths are joined with.
+
+    Raises:
+        ValueError: when ``path_value`` is neither a string nor a list of strings.
+    """
+    if isinstance(path_value, str):
+        return os.path.normpath(os.path.join(base_dir, path_value))
+    if isinstance(path_value, list):
+        resolved = []
+        for element in path_value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element must be a string, got {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {path_value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries are read from the top-level ``data_list_key`` of the JSON object, and other top-level
+    fields such as ``name``, ``labels`` or ``modality`` are ignored. Each entry must be a mapping. Its
+    ``"image"`` value is resolved against ``base_dir``. Its ``"label"`` value is resolved only when
+    ``is_segmentation`` is true; when it is false the label is returned exactly as stored, so an integer
+    class id stays an integer. All other fields are kept unchanged. Items without ``"image"`` or
+    ``"label"`` are accepted.
+
+    When ``data_list_key`` is ``"test"``, the entries are plain path strings and each one is converted
+    into an image-only item ``{"image": entry}`` before resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the labels are paths to resolve. Defaults to True.
+        data_list_key (str): top-level key in the datalist holding the entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            which means the directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same fields as the input entry. "image",
+        and "label" in segmentation mode, hold resolved paths: a string when the input was a string, or a
+        list of resolved strings with the same length and order when the input was a list.
+
+    Example::
+
+        {"training": [{"image": "img0.nii.gz", "label": "lbl0.nii.gz", "fold": 0}]}
+
+        loads as ``[{"image": "<base_dir>/img0.nii.gz", "label": "<base_dir>/lbl0.nii.gz", "fold": 0}]``.
+
+    Raises:
+        ValueError: when the file does not exist, ``data_list_key`` is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file {data_list_file_path} does not exist")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is not present in datalist file {data_list_file_path}")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"entries under key '{data_list_key}' in {data_list_file_path} must be a list")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(f"item {item!r} under key '{data_list_key}' in {data_list_file_path} is not a mapping")
+        resolved_item = dict(item)
+        if "image" in item:
+            resolved_item["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            resolved_item["label"] = _resolve_path(item["label"], base_dir)
+        items.append(resolved_item)
+    return items
