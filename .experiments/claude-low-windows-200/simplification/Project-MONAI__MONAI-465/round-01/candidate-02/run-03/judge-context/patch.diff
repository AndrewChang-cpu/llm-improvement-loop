+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "name": "demo",
+                "training": [
+                    {
+                        "image": "./imagesTr/a.nii",
+                        "label": "labelsTr//a.nii",
+                        "id": "case_a",
+                    }
+                ],
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as fp:
+                json.dump(datalist, fp)
+
+            result = load_decathalon_datalist(
+                file_path, is_segmentation=True, data_list_key="training", base_dir=tempdir
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "./imagesTr/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr//a.nii")))
+            self.assertEqual(result[0]["id"], "case_a")
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/a.nii", "label": 2},
+                    {"image": "imagesTr/b.nii", "label": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as fp:
+                json.dump(datalist, fp)
+
+            result = load_decathalon_datalist(
+                file_path, is_segmentation=False, data_list_key="training", base_dir=tempdir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/a.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/b.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            image_path = os.path.join(tempdir, "a.nii")
+            label_path = os.path.join(tempdir, "a_seg.nii")
+            datalist = {
+                "training": [
+                    {"image": image_path, "label": label_path},
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as fp:
+                json.dump(datalist, fp)
+
+            result = load_decathalon_datalist(file_path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(len(result), 1)
+            self.assertTrue(os.path.isabs(result[0]["image"]))
+            self.assertTrue(os.path.isabs(result[0]["label"]))
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "test": ["imagesTs/a.nii", "imagesTs/b.nii"],
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as fp:
+                json.dump(datalist, fp)
+
+            result = load_decathalon_datalist(file_path, is_segmentation=True, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/a.nii")))
+            self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
