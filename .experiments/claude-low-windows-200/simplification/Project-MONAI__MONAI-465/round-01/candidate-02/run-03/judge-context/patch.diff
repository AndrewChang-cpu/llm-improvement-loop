+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value against ``base_dir``. A string is joined and normalized; a list
+    has each of its string elements resolved independently, keeping order and length.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element must be a string, got {element!r} in {data_list_file_path}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value must be a string or list of strings, got {value!r} in {data_list_file_path}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return per-case items
+    whose "image" (and, in segmentation mode, "label") paths are resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; it must exist.
+        is_segmentation (bool): if True, "label" is resolved as a path. If False, "label" is
+            returned exactly as stored, whatever its type (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key under which the list of entries is stored.
+            Defaults to "training". If it equals "test", each plain string entry is converted
+            into an image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None,
+            which means the directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same fields as its input item,
+        with "image" (and "label" in segmentation mode) replaced by resolved paths: a string when
+        the input value was a string, or a list of resolved strings with the same length and order
+        when the input value was a list. All other fields are unchanged.
+
+    Example::
+
+        # datalist: {"training": [{"image": "imgs/a.nii", "label": "segs/a.nii", "id": "a"}]}
+        load_decathalon_datalist("/data/dataset.json", base_dir="/data")
+        # [{"image": "/data/imgs/a.nii", "label": "/data/segs/a.nii", "id": "a"}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as fp:
+        json_data = json.load(fp)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in {data_list_file_path}")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Data list item must be a mapping, got {item!r} in {data_list_file_path}")
+
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, data_list_file_path)
+        items.append(new_item)
+
+    return items
