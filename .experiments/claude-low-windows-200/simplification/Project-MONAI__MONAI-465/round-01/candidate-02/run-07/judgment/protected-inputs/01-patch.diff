+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "dataset.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "name": "demo",
+                "training": [
+                    {"image": "imgs/./a.nii", "label": "lbls//a.nii", "fold": 0},
+                ],
+            }
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, True, "training", tmp_dir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbls", "a.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii", "label": 1},
+                    {"image": "imgs/b.nii", "label": 0},
+                ],
+            }
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, False, "training", tmp_dir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "a.nii")
+            abs_label = os.path.join(tmp_dir, "a_label.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/a.nii", "imgs/b.nii"]}
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, True, "test", tmp_dir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(set(items[0].keys()), {"image"})
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
