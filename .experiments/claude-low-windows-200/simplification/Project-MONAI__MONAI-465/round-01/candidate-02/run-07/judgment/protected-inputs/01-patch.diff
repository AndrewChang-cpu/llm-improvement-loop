+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """Resolve a single path string, or each string in a list of path strings, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' in {file_path} has a non-string list element: {element!r}.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or list of strings, got: {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            label is left exactly as stored, whatever its type (for example an integer class id).
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+            When it equals "test", each plain string entry is converted to an image-only item ``{"image": entry}``.
+        base_dir (str): directory that relative "image" and "label" paths are resolved against. Defaults to None,
+            meaning the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order, one per entry. Each dict keeps the field names of its input item.
+        The "image" value, and the "label" value in segmentation mode, is a normalized path string if the input
+        was a string, or a list of normalized path strings with the same length and order if the input was a list.
+        All other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is the normalized path of the first image under the datalist's directory.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    data_list = json_data[data_list_key]
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in data_list:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Every item under key '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        result.append(new_item)
+    return result
