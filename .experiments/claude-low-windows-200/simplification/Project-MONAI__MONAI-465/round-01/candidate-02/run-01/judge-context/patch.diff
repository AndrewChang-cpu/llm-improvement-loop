+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+
+    Args:
+        value (Any): a string path or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{file_path}' must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist '{file_path}' must be a string or a list of strings, "
+        f"found {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries under ``data_list_key`` are read as a list of items. For each item, the "image" field is
+    resolved against ``base_dir``. In segmentation mode the "label" field is resolved too; when
+    ``is_segmentation`` is False the label is returned exactly as stored. All other fields are kept unchanged.
+    Items without "image" or "label" are accepted. When ``data_list_key`` is "test", each entry is a plain
+    path string and is converted to an image-only item ``{"image": entry}``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the "label" field holds paths to be resolved. Defaults to True.
+            When False, the "label" value is passed through unchanged, for example an integer class id.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. The output has the same field names as the
+        input items. "image", and "label" in segmentation mode, hold resolved paths: a string when the input
+        was a string, or a list of resolved strings with the same length and order when the input was a list.
+
+    Raises:
+        ValueError: if the file does not exist, ``data_list_key`` is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", base_dir="/data/task01")
+        # items[0]["image"] -> "/data/task01/imagesTr/case_0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Every item in datalist '{data_list_file_path}' must be a mapping, found {item!r}.")
+
+        new_item = dict(item)
+        if "image" in item:
+            new_item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            new_item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        output.append(new_item)
+
+    return output
