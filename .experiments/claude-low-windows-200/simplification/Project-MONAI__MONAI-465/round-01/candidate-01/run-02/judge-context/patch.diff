+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            content = {
+                "name": "unused",
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": "segs/a.nii.gz", "extra": "keep me"},
+                    {"image": "imgs/b.nii.gz", "label": "segs/b.nii.gz"},
+                ],
+            }
+            path = self._write_datalist(tmp_dir, content)
+            result = load_decathalon_datalist(path, True, "training", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "segs", "a.nii.gz")))
+            self.assertEqual(result[0]["extra"], "keep me")
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "b.nii.gz")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp_dir, "segs", "b.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": 1},
+                    {"image": "imgs/b.nii.gz", "label": 0},
+                ],
+            }
+            path = self._write_datalist(tmp_dir, content)
+            result = load_decathalon_datalist(path, False, "training", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "a.nii.gz")
+            label_path = os.path.join(tmp_dir, "a_seg.nii.gz")
+            content = {"training": [{"image": image_path, "label": label_path}]}
+            path = self._write_datalist(tmp_dir, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["imgs/a.nii.gz", "imgs/b.nii.gz"]}
+            path = self._write_datalist(tmp_dir, content)
+            result = load_decathalon_datalist(path, True, "test", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
