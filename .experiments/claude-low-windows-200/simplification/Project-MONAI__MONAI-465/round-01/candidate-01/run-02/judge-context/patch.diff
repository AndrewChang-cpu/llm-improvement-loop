+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the string, or list of strings, to resolve.
+        base_dir: directory that relative paths are joined with.
+        field: name of the item field being resolved, used in error messages.
+        file_path: datalist file path, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file {file_path} must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file {file_path} must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries under ``data_list_key`` are returned as a list of items, in their original order. The
+    "image" field of every item is resolved against ``base_dir``, and so is the "label" field when
+    ``is_segmentation`` is True. When ``is_segmentation`` is False the "label" field is left exactly as
+    stored, so an integer class id stays an integer and a class-name string stays unchanged. All other
+    fields are kept unchanged and are never path-joined. Items without "image" or "label" are not errors.
+    When ``data_list_key`` is "test", each entry is a plain path string and is converted to an item whose
+    only field is "image".
+
+    Each resolved path is a string if the input value was a string, or a list of strings with the same
+    length and order if the input value was a list. Each element of such a list is resolved independently.
+
+    Example::
+
+        {"training": [{"image": "imgs/a.nii.gz", "label": "segs/a.nii.gz", "id": 1}]}
+
+    loads as ``[{"image": "<base_dir>/imgs/a.nii.gz", "label": "<base_dir>/segs/a.nii.gz", "id": 1}]``
+    in segmentation mode, where ``<base_dir>`` is the normalized base directory.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must name an existing file.
+        is_segmentation (bool): when True, "label" values are resolved as paths. When False, "label" values
+            are returned unchanged and may be of any JSON type. Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means
+            the directory of ``data_list_file_path``.
+
+    Raises:
+        ValueError: when the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    data_list = json_data[data_list_key]
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in datalist file {data_list_file_path} must be a mapping, "
+                f"got {item!r}."
+            )
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+    return items
