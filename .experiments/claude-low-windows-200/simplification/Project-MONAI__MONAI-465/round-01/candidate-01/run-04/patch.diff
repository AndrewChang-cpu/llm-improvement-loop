+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string, or a list of strings) against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized independently.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list element {element!r} in {data_list_file_path} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with
+    the ``"image"`` (and, in segmentation mode, ``"label"``) paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): if True, the ``"label"`` field is resolved as a path. If False, the label is
+            returned exactly as stored, whatever its type (for example an integer class id or a class name).
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+            If it equals "test", each entry is a plain path string and is converted to an item whose only
+            field is "image".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means
+            the directory of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, in the original order of the datalist. Each dict has the same fields as its input
+        item. The "image" value, and the "label" value in segmentation mode, is a resolved path string if the
+        input was a string, or a list of resolved path strings with the same length and order if the input was
+        a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are normalized paths under the datalist directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item under '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+    return items
