+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "training": [
+                    {"image": "./imgs/case_0.nii", "label": "labels//case_0.nii", "extra": "keep"},
+                    {"image": "imgs/case_1.nii", "label": "labels/case_1.nii"},
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "./imgs/case_0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels//case_0.nii")))
+            self.assertEqual(result[0]["extra"], "keep")
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case_1.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(base_dir, "labels/case_1.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "training": [
+                    {"image": "imgs/case_0.nii", "label": 1},
+                    {"image": "imgs/case_1.nii", "label": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case_0.nii")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case_1.nii")))
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "case_0.nii")
+            label_path = os.path.join(tempdir, "case_0_label.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {"test": ["imgs/test_0.nii", "imgs/test_1.nii"]}
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, data_list_key="test", base_dir=base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/test_0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
