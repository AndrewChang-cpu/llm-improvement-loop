+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value, or each path in a list of path values, against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized; absolute strings stay absolute.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its per-case items with
+    image (and, in segmentation mode, label) paths resolved against a base directory.
+
+    Entries are read from the value under ``data_list_key``. Other top-level fields such as ``name``,
+    ``labels`` or ``modality`` are ignored. Each entry must be a mapping; its "image" field is resolved,
+    and its "label" field is resolved only when ``is_segmentation`` is True. When ``is_segmentation`` is
+    False the label is returned exactly as stored, so an integer class id stays an integer and a
+    class-name string is left unchanged. All other fields are copied unchanged, with no path joining.
+    Items without "image" or "label" are accepted.
+
+    If ``data_list_key`` is "test", the entries are plain path strings (the Decathalon test layout) and
+    each one is converted into an item whose only field is "image", regardless of ``is_segmentation``.
+
+    Path values are strings or lists of strings. A string is joined with ``base_dir`` and normalized, and
+    absolute strings stay absolute. A list is resolved element by element, so each element is an
+    independent path and the result keeps the same length and order as the input.
+
+    The return value is a list with one dict per entry, in the original order. Each dict has the same
+    field names as the input item. "image" (and "label" in segmentation mode) holds a resolved string
+    when the input was a string, or a list of resolved strings of the same length when the input was a list.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are paths under the datalist's directory
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist, otherwise a ValueError is raised.
+        is_segmentation (bool): if True, resolve the "label" field of each item as a path. If False, leave
+            the label unchanged, whatever its type. Defaults to True.
+        data_list_key (str): key in the top-level JSON object whose value is the list of entries. Use "test"
+            for a test list of plain path strings. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory of
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"datalist file {data_list_file_path} has no key '{data_list_key}'")
+
+    entries = datalist[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(f"item {index} in '{data_list_key}' of {data_list_file_path} must be a mapping")
+
+        processed = dict(item)
+        fields = ["image", "label"] if is_segmentation else ["image"]
+        for field in fields:
+            if field in processed:
+                processed[field] = _resolve_path(processed[field], base_dir)
+        items.append(processed)
+
+    return items
