+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, field: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    Each string is joined with ``base_dir`` and normalized independently.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' in datalist {file_path} must be a string or a list of strings.")
+        return [_resolve_path(element, base_dir, file_path, field) for element in value]
+    raise ValueError(f"Field '{field}' in datalist {file_path} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return its items with
+    image (and, in segmentation mode, label) paths resolved against a base directory.
+
+    Entries are read from the list stored under ``data_list_key``. When ``is_segmentation`` is True,
+    both the "image" and "label" fields are resolved as paths; when False, only "image" is resolved and
+    "label" is returned exactly as stored, whatever its type (for example an integer class id).
+    All other fields are kept unchanged. If ``data_list_key`` is "test", each entry is a plain path
+    string and is wrapped into an item containing only the "image" field.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which
+            means the directory containing the datalist file.
+
+    Returns:
+        A list with one dict per entry, in the original order. Each dict has the same fields as the
+        input entry. The "image" value, and the "label" value in segmentation mode, is a resolved path
+        string if the input was a string, or a list of resolved path strings with the same length and
+        order if the input was a list.
+
+    Example::
+
+        # datalist.json: {"training": [{"image": "imgs/a.nii", "label": "lbls/a.nii", "fold": 0}]}
+        items = load_decathalon_datalist("/data/datalist.json", base_dir="/data")
+        # items[0] == {"image": "/data/imgs/a.nii", "label": "/data/lbls/a.nii", "fold": 0}
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each entry under '{data_list_key}' in datalist {data_list_file_path} must be a mapping.")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, data_list_file_path, "label")
+        items.append(resolved)
+    return items
