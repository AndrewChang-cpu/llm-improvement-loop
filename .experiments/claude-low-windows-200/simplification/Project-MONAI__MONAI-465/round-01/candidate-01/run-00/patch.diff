+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": "labels/case0.nii", "fold": 0},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                file_path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels/case0.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": 3},
+                    {"image": "imgs/case1.nii", "label": 1},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                file_path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir
+            )
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii")))
+            self.assertEqual(items[0]["label"], 3)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["label"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "image.nii")
+            label_path = os.path.join(tmp_dir, "label.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/test0.nii", "imgs/test1.nii"]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0], {"image": os.path.normpath(os.path.join(tmp_dir, "imgs/test0.nii"))})
+            self.assertEqual(items[1], {"image": os.path.normpath(os.path.join(tmp_dir, "imgs/test1.nii"))})
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
