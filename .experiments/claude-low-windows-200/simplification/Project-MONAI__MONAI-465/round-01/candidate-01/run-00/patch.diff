+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the path string, or a list of path strings.
+        base_dir: directory to join the paths with.
+        field: name of the item field being resolved, used in error messages.
+        data_list_file_path: datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings in the same order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries are read from the top-level ``data_list_key`` of the JSON file. Other top-level fields
+    (name, description, labels, modality, counts) are ignored. Each entry must be a mapping. The
+    ``"image"`` field is always resolved against ``base_dir``. The ``"label"`` field is resolved only
+    when ``is_segmentation`` is True; when it is False, the label is kept exactly as stored, so an
+    integer class id stays an integer and a class-name string stays unchanged. Other fields are kept
+    verbatim and are not joined with ``base_dir``. Items without an ``"image"`` or ``"label"`` field
+    are accepted. When ``data_list_key`` is ``"test"``, each entry is a plain path string and is
+    converted to an item whose only field is ``"image"``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist, otherwise a ValueError is raised.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, ``"label"`` is resolved
+            against ``base_dir`` and must be a string or a list of strings. Defaults to True.
+        data_list_key (str): top-level key in the JSON file that holds the list of entries. Defaults to
+            "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            which uses the directory of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as the
+        input entry. ``"image"`` (and ``"label"`` in segmentation mode) hold a resolved path string if the
+        input value was a string, or a list of resolved path strings with the same length and order if the
+        input value was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the JSON does not contain ``data_list_key``, an entry is not
+            a mapping, or a path field is not a string or a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is the normalized path of the first image, resolved against the datalist directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each entry under '{data_list_key}' in {data_list_file_path} must be a mapping.")
+
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
