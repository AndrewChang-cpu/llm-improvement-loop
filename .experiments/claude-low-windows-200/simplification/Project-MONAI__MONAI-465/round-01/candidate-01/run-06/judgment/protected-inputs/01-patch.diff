+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": "labels/./a.nii.gz", "fold": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            base_dir = os.path.join(tempdir, "root")
+            items = load_decathalon_datalist(file_path, True, "training", base_dir)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/a.nii.gz")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/a.nii.gz", "label": 2},
+                    {"image": ["imgs/b.nii.gz", "imgs/c.nii.gz"], "label": "class_name"},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            base_dir = os.path.join(tempdir, "root")
+            items = load_decathalon_datalist(file_path, False, "training", base_dir)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii.gz")))
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(
+                items[1]["image"],
+                [
+                    os.path.normpath(os.path.join(base_dir, "imgs/b.nii.gz")),
+                    os.path.normpath(os.path.join(base_dir, "imgs/c.nii.gz")),
+                ],
+            )
+            self.assertEqual(items[1]["label"], "class_name")
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "a.nii.gz")
+            label_path = os.path.join(tempdir, "a_seg.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            items = load_decathalon_datalist(file_path, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/t1.nii.gz", "imgs/t2.nii.gz"]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+            base_dir = os.path.join(tempdir, "root")
+            items = load_decathalon_datalist(file_path, True, "test", base_dir)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(list(items[0].keys()), ["image"])
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/t1.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
