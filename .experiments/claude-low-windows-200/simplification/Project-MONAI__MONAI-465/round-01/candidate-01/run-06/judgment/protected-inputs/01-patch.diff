+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string of a list of paths, against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined with.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list element must be a string, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return its items with resolved paths.
+
+    The file must exist and contain a top-level object with ``data_list_key``. The value under that key is a list
+    of entries; each entry must be a mapping. The ``"image"`` field of every entry is resolved against ``base_dir``,
+    and the ``"label"`` field is resolved too when ``is_segmentation`` is True. A path is either a string or a list
+    of strings; each string is joined with ``base_dir`` and normalized, and list elements are resolved independently.
+    When ``is_segmentation`` is False, the label is returned exactly as stored, whatever its type, such as an integer
+    class id or a class-name string. All other fields are kept unchanged. Entries lacking ``"image"`` or ``"label"``
+    are not errors.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to an item whose only
+    field is ``"image"`` holding that string, before path resolution.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each item; if False, leave it unchanged.
+            Defaults to True.
+        data_list_key (str): key under the top-level object that holds the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same field names as its
+        input entry. Its ``"image"`` value, and in segmentation mode its ``"label"`` value, is a resolved string when
+        the input was a string, or a list of resolved strings with the same length and order when the input was a
+        list. All other fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are normalized paths under the datalist directory.
+
+    Raises:
+        ValueError: if the file does not exist, ``data_list_key`` is missing, an entry is not a mapping, or a path
+            value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"datalist entry must be a mapping, got {entry!r} in file: {data_list_file_path}")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir)
+        items.append(item)
+    return items
