+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii.gz", "label": "./labels//case0.nii.gz", "fold": 0},
+                    {"image": "imgs/case1.nii.gz", "label": "labels/case1.nii.gz", "fold": 1},
+                ]
+            }
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=tempdir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case1.nii.gz")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "labels/case1.nii.gz")))
+            self.assertEqual(result[1]["fold"], 1)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii.gz", "label": 2},
+                    {"image": "imgs/case1.nii.gz", "label": 0},
+                ]
+            }
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=tempdir
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            image_path = os.path.join(tempdir, "image.nii.gz")
+            label_path = os.path.join(tempdir, "label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=None
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {"test": ["imgs/test0.nii.gz", "imgs/test1.nii.gz"]}
+            datalist_path = os.path.join(tempdir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "imgs/test0.nii.gz"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
