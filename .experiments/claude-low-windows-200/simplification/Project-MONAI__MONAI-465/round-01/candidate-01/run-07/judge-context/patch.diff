+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of paths, against ``base_dir``.
+
+    Args:
+        value: a path string, or a list of path strings.
+        base_dir: directory that relative paths are joined to.
+
+    Returns:
+        a normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: when ``value`` is not a string or a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries under ``data_list_key`` are returned as a list of dictionaries in the original order.
+    The "image" field is always resolved against ``base_dir``. The "label" field is resolved only when
+    ``is_segmentation`` is True; otherwise it is kept exactly as stored, so integer class ids and
+    class-name strings are unchanged. Other fields are kept unchanged and are never path-joined.
+    Items without "image" or "label" are not errors. When ``data_list_key`` is "test", each entry is a
+    plain path string and is converted to an item whose only field is "image".
+
+    Each resolved path is a string if the input value was a string, or a list of strings with the same
+    length and order if the input value was a list. Relative paths are joined with ``base_dir`` and
+    normalized; absolute paths stay absolute.
+
+    Example::
+
+        {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0}]}
+
+    with ``base_dir`` "/data" returns ``[{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0}]``
+    (on POSIX systems).
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A ValueError is raised if it does not exist.
+        is_segmentation (bool): if True, resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which
+            means the directory of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as json_file:
+        json_data = json.load(json_file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' not found in datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"datalist item must be a mapping, got {item!r} in file: {data_list_file_path}")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        items.append(new_item)
+
+    return items
