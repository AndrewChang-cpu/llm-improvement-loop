+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string of a list of path strings, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list) and all(isinstance(element, str) for element in value):
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths against a base directory.
+
+    The file is parsed as a JSON object and the list of entries stored under ``data_list_key`` is used. Other top-level
+    fields of the file are ignored. If ``data_list_key`` is ``"test"``, each entry is a plain path string and is
+    converted to an item whose only field is ``"image"``. Each item must be a mapping. Its ``"image"`` field is always
+    resolved. Its ``"label"`` field is resolved only when ``is_segmentation`` is True; when False, the label is kept
+    exactly as stored, whatever its type. Fields that are not ``"image"`` or ``"label"`` are left unchanged. A path
+    value is either a string, which is joined with ``base_dir`` and normalized, or a list of strings, where each
+    element is resolved independently in the same way.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path (it must be a string or a list of
+            strings). If False, the ``"label"`` field is returned unchanged, for example an integer class id.
+            Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to ``"training"``.
+            Use ``"test"`` for a datalist whose test entries are plain path strings.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the directory
+            containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same fields as its input item. The
+        ``"image"`` field, and the ``"label"`` field in segmentation mode, hold resolved paths: a string if the input
+        was a string, or a list of resolved strings with the same length and order if the input was a list.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is not
+            a string or a list of strings.
+
+    Example::
+
+        {
+            "training": [
+                {"image": "imagesTr/case0.nii.gz", "label": "labelsTr/case0.nii.gz", "extra": "kept"}
+            ]
+        }
+
+        items = load_decathalon_datalist("dataset.json", base_dir="/data/task01")
+        # items[0]["image"] == "/data/task01/imagesTr/case0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in {data_list_file_path} must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under '{data_list_key}' in {data_list_file_path} must be a mapping, got {item!r}."
+            )
+
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+
+    return items
