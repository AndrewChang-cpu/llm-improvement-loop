+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": "lbl0.nii.gz", "extra": "kept"},
+                ]
+            }
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=tmp_dir,
+            )
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbl0.nii.gz")))
+            self.assertEqual(items[0]["extra"], "kept")
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 1},
+                ]
+            }
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=False,
+                data_list_key="training",
+                base_dir=tmp_dir,
+            )
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "img0.nii.gz")
+            abs_label = os.path.join(tmp_dir, "lbl0.nii.gz")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=None,
+            )
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": ["img0.nii.gz", "img1.nii.gz"],
+            }
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                datalist_path,
+                data_list_key="test",
+                base_dir=tmp_dir,
+            )
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
