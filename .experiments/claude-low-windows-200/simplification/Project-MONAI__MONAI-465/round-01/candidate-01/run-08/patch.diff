+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "./imagesTr//img0.nii", "label": "labelsTr/seg0.nii", "fold": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr", "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr", "seg0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/img0.nii", "label": 2},
+                    {"image": "imagesTr/img1.nii", "label": 0},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr", "img0.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            abs_image = os.path.join(tempdir, "img0.nii")
+            abs_label = os.path.join(tempdir, "seg0.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "seg0.nii")))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            datalist = {"test": ["imagesTs/img0.nii", "imagesTs/img1.nii"]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "imagesTs", "img0.nii"))})
+
+
+if __name__ == "__main__":
+    unittest.main()
