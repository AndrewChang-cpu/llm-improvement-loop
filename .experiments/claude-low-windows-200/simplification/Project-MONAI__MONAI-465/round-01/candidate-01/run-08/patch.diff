+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a single path value, or each path in a list of path values, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list element {element!r} in {file_path} is not a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file is read, and the entries under ``data_list_key`` are returned as a list of items. The ``"image"``
+    field of every item is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; when it is False the label is returned exactly as stored, so an integer class id
+    stays an integer and a class-name string stays unchanged. All other fields are kept unchanged. Items missing
+    ``"image"`` or ``"label"`` are not an error. A path value may be a string or a list of strings; each string
+    is joined with ``base_dir`` and normalized independently, so a list keeps its length and order.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to an item whose only
+    field is ``"image"``, regardless of ``is_segmentation``.
+
+    The return value is a list of dicts in the original order. Each dict has the same field names as the input item.
+    ``"image"`` (and ``"label"`` in segmentation mode) holds a resolved string if the input was a string, or a list
+    of resolved strings with the same length and order if the input was a list.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is the normalized path of the first image, relative to the datalist's directory
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. A missing file raises ValueError.
+        is_segmentation (bool): if True, resolve the "label" field as a path. If False, leave "label" unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value holds the entries. Defaults to "training".
+            If the key is missing from the file, ValueError is raised.
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each item under '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
