+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the path string, or a list of path strings resolved independently.
+        base_dir: directory that relative paths are joined with.
+        field: name of the item field being resolved, used in error messages.
+        data_list_file_path: datalist file path, used in error messages.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object whose entries live under ``data_list_key``. Other top-level fields
+    (name, description, labels, modality, counts) are ignored. Each entry must be a mapping. The
+    ``"image"`` field is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is true; when it is false, the label is returned exactly as stored, so an integer
+    class id stays an integer and a class-name string stays unchanged. Other fields are kept unchanged and
+    are never path-joined. Items without ``"image"`` or ``"label"`` are not errors.
+
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to an item whose
+    only field is ``"image"``, independent of ``is_segmentation``.
+
+    A path value is either a string, which is joined with ``base_dir`` and normalized, or a list of strings,
+    where each element is resolved independently in the same way. Absolute strings stay absolute.
+
+    The return value is a list of dicts in the original entry order. Each dict has the same field names as
+    its input item. ``"image"`` (and ``"label"`` in segmentation mode) holds a resolved path string, or a
+    list of resolved strings with the same length and order as the input list.
+
+    Example:
+        With ``/data/dataset.json`` containing ``{"training": [{"image": "imgs/a.nii.gz",
+        "label": "labels/a.nii.gz", "fold": 0}]}``, the call
+        ``load_decathalon_datalist("/data/dataset.json")`` returns
+        ``[{"image": "/data/imgs/a.nii.gz", "label": "/data/labels/a.nii.gz", "fold": 0}]``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must exist.
+        is_segmentation (bool): if True, resolve the "label" field as a path. If False, leave "label" unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+            Use "test" for a datalist whose entries are plain image path strings.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is not present in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each item in datalist file {data_list_file_path} must be a mapping, found {entry!r}.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
