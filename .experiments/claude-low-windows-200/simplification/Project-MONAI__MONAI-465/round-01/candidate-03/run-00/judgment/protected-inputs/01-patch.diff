+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a path value against ``base_dir``.
+
+    A string is joined with ``base_dir`` and normalized. A list is resolved element by element, each element
+    being a complete path resolved exactly as a single string would be.
+
+    Args:
+        value (Any): a path string or a list of path strings.
+        base_dir (str): directory against which relative paths are joined.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list, or a list contains a non-string element.
+
+    Returns:
+        a resolved path string, or a list of resolved path strings with the same order and length as the input.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"path list elements must be strings, got {type(element).__name__}: {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"path value must be a string or a list of strings, got {type(value).__name__}: {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return per-case items whose image and
+    label paths are resolved against ``base_dir``.
+
+    The entries are read from the key ``data_list_key`` of the top-level JSON object. When ``data_list_key`` is
+    ``"test"``, each entry is a plain path string and is converted to an item holding only an ``"image"`` field.
+    Each item must be a mapping. Its ``"image"`` field is always resolved when present. Its ``"label"`` field is
+    resolved only when ``is_segmentation`` is true; otherwise the label is returned exactly as stored, so an
+    integer class id stays an integer and a class name string stays unchanged. Other fields are never modified.
+    Path values may be a string or a list of strings; each list element is resolved independently.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. The file must exist.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each item; if False, leave it unchanged.
+            Defaults to True.
+        data_list_key (str): key under which the entries are stored in the datalist. Defaults to ``"training"``.
+        base_dir (Optional[str]): directory against which relative paths are joined. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the parsed JSON,
+            if an item is not a mapping, or if a path value is neither a string nor a list of strings.
+
+    Returns:
+        a list of dictionaries in the original entry order. Each dictionary has the same field names as its input
+        item. The ``"image"`` value, and the ``"label"`` value in segmentation mode, is a resolved path string when
+        the input was a string, or a list of resolved path strings with the same length and order when the input
+        was a list. All other fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=False, data_list_key="training")
+        # items[0]["image"] is a resolved path and items[0]["label"] is the stored label value unchanged
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as file:
+        json_data = json.load(file)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing from datalist file: {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"datalist item must be a mapping, got {type(item).__name__}: {item!r}")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir)
+        items.append(new_item)
+
+    return items
