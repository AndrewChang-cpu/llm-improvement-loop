+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": "labels/./case0.nii", "extra": "keep me"},
+                    {"image": "imgs//case1.nii", "label": "labels/case1.nii"},
+                ],
+            }
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tempdir, "labels/case0.nii")))
+            self.assertEqual(items[0]["extra"], "keep me")
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case1.nii")))
+            self.assertEqual(items[1]["label"], os.path.normpath(os.path.join(tempdir, "labels/case1.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": 1},
+                    {"image": "imgs/case1.nii", "label": 0},
+                ],
+            }
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=False,
+                data_list_key="training",
+                base_dir=tempdir,
+            )
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 1)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case1.nii")))
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "case0.nii")
+            abs_label = os.path.join(tempdir, "case0_label.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(
+                datalist_path,
+                is_segmentation=True,
+                data_list_key="training",
+                base_dir=None,
+            )
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/case0.nii", "imgs/case1.nii"]}
+            datalist_path = os.path.join(tempdir, "dataset.json")
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(list(items[0].keys()), ["image"])
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
