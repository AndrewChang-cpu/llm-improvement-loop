+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings in the same order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{field}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{field}' in {data_list_file_path} must be a string or a list of strings, got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Entries are read from the top-level ``data_list_key`` of the JSON file. The ``"image"`` field of each
+    item is always resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; when it is False the label is returned exactly as stored, so integer
+    class ids stay integers and class name strings stay unchanged. Other fields are kept unchanged.
+    Each path may be a string or a list of strings; each list element is resolved independently.
+    Items without an ``"image"`` or ``"label"`` field are not errors.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is converted to an item
+    whose only field is ``"image"``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path; if False, leave it unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON file holding the entry list. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries in the original entry order. Each dictionary has the same field names as its
+        input entry. The ``"image"`` value, and the ``"label"`` value in segmentation mode, is a normalized
+        path string when the input was a string, or a list of normalized path strings with the same length
+        and order when the input was a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, ``data_list_key`` is missing, an item is not a
+            mapping, or a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is the resolved image path for the first case
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Item {index} under '{data_list_key}' in {data_list_file_path} must be a mapping, "
+                f"got {type(entry).__name__}."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
