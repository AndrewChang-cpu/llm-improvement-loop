+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list contains a non-string element {element!r}: {value!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its items with paths resolved.
+
+    The entries under ``data_list_key`` are read from the JSON file. Each entry must be a mapping. Its "image" field
+    is always resolved against ``base_dir``. Its "label" field is resolved only when ``is_segmentation`` is True; when
+    False, the label is returned exactly as stored, so an integer class id stays an integer and a class name string
+    stays unchanged. Every other field is returned unchanged. A path value may be a string or a list of strings; each
+    string is resolved independently and the list keeps its length and order. If ``data_list_key`` is "test", each
+    entry is a plain path string and is converted to an item holding only the "image" field.
+
+    The ``base_dir`` defaults to the directory of ``data_list_file_path``. Items without an "image" or "label" field
+    are not an error.
+
+    The return value is a list of dictionaries, one per case, in the original order of the datalist. Each dictionary
+    has the same field names as its input entry. For example, with ``is_segmentation=True`` and a datalist entry
+    ``{"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz"}`` and ``base_dir="/data"``, the result contains
+    ``{"image": "/data/imagesTr/a.nii.gz", "label": "/data/labelsTr/a.nii.gz"}``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key in the JSON file that holds the entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, which means the
+            directory of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, ``data_list_key`` is missing from the JSON, an item is not a
+            mapping, or a path value is neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        json_data = json.load(file)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in datalist file '{data_list_file_path}' must be a mapping, got {item!r}")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir)
+        result.append(processed)
+    return result
