+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _join(base_dir, path):
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "name": "demo",
+                "training": [
+                    {
+                        "image": "imagesTr/case0.nii.gz",
+                        "label": "labelsTr/case0.nii.gz",
+                        "fold": 0,
+                    },
+                    {
+                        "image": ["imagesTr/case1_t1.nii.gz", "imagesTr/case1_t2.nii.gz"],
+                        "label": "./labelsTr//case1.nii.gz",
+                    },
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _join(base_dir, "imagesTr/case0.nii.gz"))
+            self.assertEqual(result[0]["label"], _join(base_dir, "labelsTr/case0.nii.gz"))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [_join(base_dir, "imagesTr/case1_t1.nii.gz"), _join(base_dir, "imagesTr/case1_t2.nii.gz")],
+            )
+            self.assertEqual(result[1]["label"], _join(base_dir, "labelsTr/case1.nii.gz"))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": 1},
+                    {"image": "imagesTr/case1.nii.gz", "label": 0},
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _join(base_dir, "imagesTr/case0.nii.gz"))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], _join(base_dir, "imagesTr/case1.nii.gz"))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "case0_image.nii.gz")
+            abs_label = os.path.join(tempdir, "case0_label.nii.gz")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], _join(tempdir, "case0_image.nii.gz"))
+            self.assertEqual(result[0]["label"], _join(tempdir, "case0_label.nii.gz"))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tempdir, "data")
+            datalist = {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], _join(base_dir, "imagesTs/case0.nii.gz"))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
