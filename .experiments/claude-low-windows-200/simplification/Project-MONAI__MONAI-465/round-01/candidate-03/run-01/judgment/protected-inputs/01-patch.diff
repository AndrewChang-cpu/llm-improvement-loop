+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value against ``base_dir``. A string is joined with ``base_dir`` and normalized.
+    A list must contain only strings; each element is resolved independently with the same rule.
+    Any other type raises a ValueError.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Path list element {element!r} in {value!r} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value {value!r} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathalon style datalist JSON file and return its per-case items with
+    the "image" (and, in segmentation mode, "label") paths resolved against ``base_dir``.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field is resolved as a path (a string or list of
+            strings). If False, the "label" field is returned exactly as stored, whatever its type,
+            such as an integer class id. Defaults to True.
+        data_list_key (str): top-level key holding the entry list. Defaults to "training". If it equals
+            "test", each entry is a plain path string and is converted to an item whose only field is "image".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, in the original order of the datalist entries. Each dict keeps the field names of
+        its input entry. The "image" value is a resolved path string, or a list of resolved path strings
+        with the same count and order as the input list. In segmentation mode the "label" value follows the
+        same rule. All other fields are copied unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is neither a string nor a list of strings.
+
+    Example:
+
+        .. code-block:: python
+
+            # datalist.json: {"training": [{"image": "imagesTr/a.nii.gz", "label": "labelsTr/a.nii.gz"}]}
+            items = load_decathalon_datalist("/data/task/datalist.json")
+            # items[0]["image"] == "/data/task/imagesTr/a.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Datalist item {item!r} in '{data_list_file_path}' must be a mapping.")
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir)
+        items.append(item)
+    return items
