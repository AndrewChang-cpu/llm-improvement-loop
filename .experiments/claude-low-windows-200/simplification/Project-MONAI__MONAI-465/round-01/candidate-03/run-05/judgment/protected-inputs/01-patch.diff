+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value against ``base_dir``. A string is joined and normalized; a list of strings
+    has each element resolved independently, keeping its length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list) and all(isinstance(element, str) for element in value):
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Entries are read from the key ``data_list_key`` (default ``"training"``). The ``"image"`` field of
+    every item is resolved against ``base_dir``. The ``"label"`` field is resolved only when
+    ``is_segmentation`` is True; otherwise it is kept exactly as stored, so integer class ids stay
+    integers. All other fields, including string fields, are left unchanged. If ``data_list_key`` is
+    ``"test"``, each entry is a plain path string and is wrapped as an image-only item.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve the ``"label"`` field. Defaults to True.
+        data_list_key (str): key under which the list of entries is stored. Defaults to ``"training"``.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            which uses the directory of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same fields as its input item. ``"image"``,
+        and ``"label"`` in segmentation mode, hold resolved paths: a string if the input was a string, or a
+        list of resolved strings with the same count and order if the input was a list.
+
+    Raises:
+        ValueError: if the file does not exist, ``data_list_key`` is missing, an item is not a mapping, or a
+            path value is neither a string nor a list of strings.
+
+    Example:
+        ``load_decathalon_datalist("dataset.json", data_list_key="training")`` returns items such as
+        ``{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    data_list = json_data[data_list_key]
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in data_list:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each item under key '{data_list_key}' in {data_list_file_path} must be a mapping.")
+
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
