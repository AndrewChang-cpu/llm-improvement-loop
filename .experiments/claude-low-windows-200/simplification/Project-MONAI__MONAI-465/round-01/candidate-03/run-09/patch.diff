+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string of a list of path strings, against ``base_dir``.
+    Each list element is a complete path and is resolved independently.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' contains a non-string element: {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its per-case items.
+
+    Entries are read from the top-level ``data_list_key`` of the JSON file. Other top-level fields are ignored.
+    The "image" field of every item is resolved against ``base_dir``, and so is the "label" field when
+    ``is_segmentation`` is True. When ``is_segmentation`` is False the label is returned exactly as stored,
+    so integer class ids stay integers and class name strings stay unchanged. All other fields are copied
+    unchanged. A path value may be a string or a list of strings; each list element is resolved independently
+    to a normalized path, so the list keeps its length and order. When ``data_list_key`` is "test", each entry
+    is a plain path string and is converted to an item holding only the "image" field.
+
+    The return value is a list of dictionaries in the original order of the datalist. Each dictionary has the
+    same field names as its input, with "image" (and "label" in segmentation mode) holding resolved paths: a
+    string when the input was a string, or a list of resolved strings with the same count and order when the
+    input was a list.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+            When False, the label is passed through unchanged and is not type-checked.
+        data_list_key (str): top-level key in the JSON file that holds the entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is a normalized path under the datalist directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in key '{data_list_key}' of '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        items.append(new_item)
+    return items
