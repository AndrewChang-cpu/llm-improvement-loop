+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": "labels/case0.nii", "extra": "keep"},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            items = load_decathalon_datalist(file_path, True, "training", base_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/case0.nii")))
+            self.assertEqual(items[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": 2},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            items = load_decathalon_datalist(file_path, False, "training", base_dir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii")))
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "abs_case0.nii")
+            abs_label = os.path.join(tempdir, "abs_label0.nii")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imgs/test0.nii",
+                    "imgs/test1.nii",
+                ]
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            base_dir = os.path.join(tempdir, "data")
+            items = load_decathalon_datalist(file_path, True, "test", base_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0], {"image": os.path.normpath(os.path.join(base_dir, "imgs/test0.nii"))})
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
