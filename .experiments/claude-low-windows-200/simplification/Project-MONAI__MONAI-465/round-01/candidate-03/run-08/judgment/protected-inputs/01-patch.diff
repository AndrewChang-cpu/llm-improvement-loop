+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Union[str, List[str]], base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a path value (a string or a list of strings) against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings, got {type(value)}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Read a Medical Segmentation Decathlon style datalist JSON file and return per-case items with resolved paths.
+
+    The entries live under ``data_list_key``. The ``"image"`` field of every item is resolved against ``base_dir``,
+    and in segmentation mode (``is_segmentation=True``) the ``"label"`` field is resolved too. A path value may be a
+    string, which is joined with ``base_dir`` and normalized, or a list of strings, where each element is resolved
+    independently in the same way. In classification mode (``is_segmentation=False``) the label is returned exactly
+    as stored, whatever its type, so an integer class id stays an integer. All other fields are kept unchanged.
+    Items lacking ``"image"`` or ``"label"`` are not errors. When ``data_list_key`` is ``"test"``, each entry is a
+    plain path string and is converted into an item whose only field is ``"image"``.
+
+    The return value is a list of dictionaries in the same order as the input entries. Each dictionary has the same
+    field names as its input item, with resolved paths in ``"image"`` (and ``"label"`` in segmentation mode).
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path. Defaults to True.
+        data_list_key (str): top-level key in the JSON file that holds the entry list. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the directory of
+            ``data_list_file_path`` is used.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the JSON, if an item
+            is not a mapping, or if a path value is neither a string nor a list of strings.
+
+    Example:
+        ``load_decathalon_datalist("/data/dataset.json", data_list_key="training")`` returns a list such as
+        ``[{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}]``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as file:
+        datalist = json.load(file)
+
+    if data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = datalist[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each item in {data_list_file_path} under key '{data_list_key}' must be a mapping.")
+
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
