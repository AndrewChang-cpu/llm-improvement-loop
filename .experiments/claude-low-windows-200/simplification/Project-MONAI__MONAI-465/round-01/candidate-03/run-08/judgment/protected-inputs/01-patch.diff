+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, tmp_dir, content):
+        file_path = os.path.join(tmp_dir, "datalist.json")
+        with open(file_path, "w") as file:
+            json.dump(content, file)
+        return file_path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"training": [{"image": "imgs/a.nii", "label": "labels/a.nii", "extra": "keep"}]}
+            file_path = self._write_datalist(tmp_dir, datalist)
+            base_dir = os.path.join(tmp_dir, "base")
+
+            result = load_decathalon_datalist(file_path, True, "training", base_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/a.nii")))
+            self.assertEqual(result[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"training": [{"image": "imgs/a.nii", "label": 3}]}
+            file_path = self._write_datalist(tmp_dir, datalist)
+            base_dir = os.path.join(tmp_dir, "base")
+
+            result = load_decathalon_datalist(file_path, False, "training", base_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "img.nii")
+            label_path = os.path.join(tmp_dir, "lbl.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = self._write_datalist(tmp_dir, datalist)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/t0.nii", "imgs/t1.nii"]}
+            file_path = self._write_datalist(tmp_dir, datalist)
+            base_dir = os.path.join(tmp_dir, "base")
+
+            result = load_decathalon_datalist(file_path, True, "test", base_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(base_dir, "imgs/t0.nii"))})
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
