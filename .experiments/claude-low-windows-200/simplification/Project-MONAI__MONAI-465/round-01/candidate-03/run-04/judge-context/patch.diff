+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str) -> Any:
+    """
+    Resolve a single path string, or each string of a list of paths, against ``base_dir``.
+
+    Args:
+        value: a string path, or a list whose elements are all string paths.
+        base_dir (str): directory the relative paths are joined with.
+        field (str): name of the datalist field, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' must be a string or a list of strings, found element {element!r}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' must be a string or a list of strings, found {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the label
+            is returned exactly as stored, whatever its type (for example an integer class id or a class name).
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist that holds the entries. Defaults to "training".
+            When it is "test", each entry is a plain path string and is converted to an item whose only field is
+            "image".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which means the directory
+            portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as its entry.
+        "image", and "label" when ``is_segmentation`` is True, hold resolved paths: a string when the input was a
+        string, or a list of resolved strings with the same length and order when the input was a list. All other
+        fields are copied unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            neither a string nor a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=False, data_list_key="training")
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as fp:
+        json_data = json.load(fp)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is not present in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item under key '{data_list_key}' must be a mapping, found {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label")
+        items.append(processed)
+    return items
