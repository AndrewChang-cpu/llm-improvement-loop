+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "dataset.json")
+    with open(path, "w") as fp:
+        json.dump(content, fp)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {
+                        "image": "imgs/a.nii",
+                        "label": "labs/a.nii",
+                        "extra": "keep",
+                    },
+                    {
+                        "image": ["imgs/b0.nii", "imgs/b1.nii"],
+                        "label": ["labs/b0.nii", "labs/b1.nii"],
+                    },
+                ],
+            }
+            path = _write_datalist(tempdir, content)
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tempdir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs", "a.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tempdir, "labs", "a.nii")))
+            self.assertEqual(items[0]["extra"], "keep")
+            self.assertEqual(
+                items[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "imgs", "b0.nii")),
+                    os.path.normpath(os.path.join(tempdir, "imgs", "b1.nii")),
+                ],
+            )
+            self.assertEqual(
+                items[1]["label"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "labs", "b0.nii")),
+                    os.path.normpath(os.path.join(tempdir, "labs", "b1.nii")),
+                ],
+            )
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"training": [{"image": "imgs/a.nii", "label": 1}, {"image": "imgs/b.nii", "label": 0}]}
+            path = _write_datalist(tempdir, content)
+            items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tempdir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs", "a.nii")))
+            self.assertEqual(items[0]["label"], 1)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tempdir, "imgs", "b.nii")))
+            self.assertEqual(items[1]["label"], 0)
+            self.assertIsInstance(items[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "img.nii")
+            label_path = os.path.join(tempdir, "lab.nii")
+            content = {"training": [{"image": image_path, "label": label_path}]}
+            path = _write_datalist(tempdir, content)
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+            self.assertTrue(os.path.isabs(items[0]["image"]))
+            self.assertTrue(os.path.isabs(items[0]["label"]))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"test": ["imgs/a.nii", "imgs/b.nii"]}
+            path = _write_datalist(tempdir, content)
+            items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0], {"image": os.path.normpath(os.path.join(tempdir, "imgs", "a.nii"))})
+            self.assertEqual(items[1], {"image": os.path.normpath(os.path.join(tempdir, "imgs", "b.nii"))})
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
