+import json
+import os
+from typing import Any, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value against ``base_dir``. A string is joined with ``base_dir`` and normalized.
+    A list must contain only strings; each element is resolved independently in the same way.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"List path element {element!r} must be a string, got {type(element).__name__}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Path value {value!r} must be a string or a list of strings, got {type(value).__name__}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[dict]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Entries are read from the top-level ``data_list_key`` (default "training"). The "image" field is always
+    resolved against ``base_dir``. The "label" field is resolved only when ``is_segmentation`` is True; when it is
+    False, the label is kept exactly as stored (for example an integer class id or a class name string).
+    All other fields are kept unchanged. If ``base_dir`` is None, the directory of ``data_list_file_path`` is used.
+    If ``data_list_key`` is "test", each entry is a plain path string and is converted to an item containing only
+    the "image" field before resolution.
+
+    Returns a list of dicts in the original order. Each dict has the same field names as its input entry, with
+    "image" (and "label" in segmentation mode) holding a resolved path string, or a list of resolved path strings
+    with the same length and order when the input was a list.
+
+    Example:
+
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+            # items[0]["image"] is the normalized path of the first image under the datalist's directory.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; it must exist.
+        is_segmentation (bool): if True, resolve the "label" field as a path; if False, leave labels unchanged.
+            Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory to resolve relative paths against. Defaults to None, meaning the
+            directory of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            neither a string nor a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key {data_list_key} is missing in data list file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key {data_list_key} in data list file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in data list file {data_list_file_path} must be a mapping.")
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir)
+        items.append(item)
+    return items
