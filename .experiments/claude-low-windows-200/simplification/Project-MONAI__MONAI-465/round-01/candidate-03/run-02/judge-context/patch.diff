+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imgs/img0.nii.gz",
+                        "label": "labels/./seg0.nii.gz",
+                        "fold": 0,
+                    },
+                    {
+                        "image": ["imgs/a.nii.gz", "imgs/b.nii.gz"],
+                        "label": ["labels/a.nii.gz", "labels/b.nii.gz"],
+                        "fold": 1,
+                    },
+                ],
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels/seg0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imgs/a.nii.gz")),
+                    os.path.normpath(os.path.join(tmp_dir, "imgs/b.nii.gz")),
+                ],
+            )
+            self.assertEqual(
+                result[1]["label"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "labels/a.nii.gz")),
+                    os.path.normpath(os.path.join(tmp_dir, "labels/b.nii.gz")),
+                ],
+            )
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii.gz", "label": 1},
+                    {"image": "img1.nii.gz", "label": 0},
+                ],
+            }
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tmp_dir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "img1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "image.nii.gz")
+            label_path = os.path.join(tmp_dir, "label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["img0.nii.gz", "img1.nii.gz"]}
+            file_path = os.path.join(tmp_dir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
