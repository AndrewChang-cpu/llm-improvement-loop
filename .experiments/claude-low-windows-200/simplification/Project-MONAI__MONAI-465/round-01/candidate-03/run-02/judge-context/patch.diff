+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """Resolve a string path, or each string in a list of paths, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of field '{field}' in {file_path} is not a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    The datalist is a JSON object whose entries live under ``data_list_key``. Each entry is a mapping
+    whose ``"image"`` field (and ``"label"`` field when ``is_segmentation`` is True) is a path string or a
+    list of path strings. Each such path is joined with ``base_dir`` and normalized; list elements are
+    resolved independently, never joined to each other. Other fields, including other string fields,
+    are kept unchanged. When ``is_segmentation`` is False, the ``"label"`` field is returned exactly as
+    stored, so integer class ids stay integers. When ``data_list_key`` is ``"test"``, each entry is a
+    plain path string and is wrapped into an item whose only field is ``"image"``. Items lacking
+    ``"image"`` or ``"label"`` are not errors.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the ``"label"`` field of each item is resolved as a path and must be
+            a string or a list of strings. If False, the label is passed through unchanged. Defaults to True.
+        data_list_key (str): key under which the entry list is stored in the datalist. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory containing
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as its
+        input entry. ``"image"``, and ``"label"`` in segmentation mode, hold a resolved path string when the
+        input was a string, or a list of resolved strings with the same length and order when the input was
+        a list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, ``data_list_key`` is missing, an entry is not a
+            mapping, or a path value is neither a string nor a list of strings.
+
+    Example:
+        A datalist containing ``{"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 0}]}``
+        loaded from ``/data/dl.json`` with no ``base_dir`` returns
+        ``[{"image": "/data/img0.nii.gz", "label": "/data/seg0.nii.gz", "fold": 0}]`` on POSIX systems.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Entries under key '{data_list_key}' in {data_list_file_path} must be a list.")
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for index, entry in enumerate(entries):
+        if data_list_key == "test":
+            entry = {"image": entry}
+        if not isinstance(entry, Mapping):
+            raise ValueError(f"Entry {index} under key '{data_list_key}' in {data_list_file_path} is not a mapping.")
+
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
