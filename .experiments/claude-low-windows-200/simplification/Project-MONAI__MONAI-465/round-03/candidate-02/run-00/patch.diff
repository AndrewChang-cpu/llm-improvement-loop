+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a single path string or a list of path strings against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list in datalist file '{file_path}' must contain only strings, "
+                    f"found {type(element).__name__}: {element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"found {type(value).__name__}: {value!r}"
+    )
+
+
+def _process_item(item: Any, base_dir: str, is_segmentation: bool, file_path: str) -> Dict[str, Any]:
+    """Return a copy of ``item`` with its path fields resolved."""
+    if not isinstance(item, Mapping):
+        raise ValueError(
+            f"Each datalist entry in '{file_path}' must be an object, found {type(item).__name__}: {item!r}"
+        )
+    processed = dict(item)
+    if "image" in processed:
+        processed["image"] = _resolve_path(processed["image"], base_dir, "image", file_path)
+    if is_segmentation and "label" in processed:
+        processed["label"] = _resolve_path(processed["label"], base_dir, "label", file_path)
+    return processed
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the label
+            is returned exactly as stored, whatever its type (for example an integer class id). Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value is the list of entries. Defaults to
+            "training". When it is "test", each plain string entry is wrapped as an item ``{"image": entry}``.
+        base_dir (str): directory that relative paths are joined to. Defaults to None, which uses the directory
+            portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or an
+            "image" or segmentation "label" value is not a string or a list of strings.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict has the same field names as the input entry.
+        "image", and "label" when ``is_segmentation`` is True, hold the resolved paths as a normalized string
+        or as a list of normalized strings of the same length and order as the input. All other fields are
+        unchanged. Relative paths are joined with ``base_dir``, and absolute paths are kept absolute.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", data_list_key="training")
+            # [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}, ...]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file not found: '{data_list_file_path}'")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Value for key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list, "
+            f"found {type(entries).__name__}"
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    return [_process_item(item, base_dir, is_segmentation, data_list_file_path) for item in entries]
