+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, file_path: str, field: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string or a list of path strings against ``base_dir``.
+    Each element is resolved independently; lists are never joined together.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+                    f"but a list element has type '{type(element).__name__}'."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"but found type '{type(value).__name__}'."
+    )
+
+
+def _convert_test_entries(entries: List[Any]) -> List[Dict[str, Any]]:
+    """
+    Wrap each plain entry from the "test" key as an image-only item.
+    """
+    return [{"image": entry} for entry in entries]
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): whether the items are for segmentation. If True, the "label" field of each
+            item is resolved as a path (a string or a list of strings). If False, the "label" field is left
+            exactly as stored, so classification labels such as integer class ids keep their type.
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value is the list of entries, usually
+            "training" or "test". Defaults to "training". If it equals "test", each entry is a plain path
+            string and is wrapped as an item with only an "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Absolute paths are never changed. Defaults to None.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an
+            item that is not a mapping, or a path field that is not a string or a list of strings.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict keeps the field names of the datalist entry.
+        The "image" field, and the "label" field in segmentation mode, hold resolved paths as a string or as
+        a list of the same length and order as the input. All other fields are unchanged. For example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not contain the key '{data_list_key}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list, "
+            f"but found type '{type(entries).__name__}'."
+        )
+
+    if data_list_key == "test":
+        items = _convert_test_entries(entries)
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in datalist file '{data_list_file_path}' must be "
+                f"a mapping, but found type '{type(item).__name__}'."
+            )
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, data_list_file_path, "label")
+        output.append(resolved)
+
+    return output
