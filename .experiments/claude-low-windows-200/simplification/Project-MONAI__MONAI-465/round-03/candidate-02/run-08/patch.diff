+import json
+import os
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            content = {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": "labelsTr/./case0.nii.gz", "fold": 0},
+                ]
+            }
+            path = _write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "training", tmp)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+
+    def test_cls_values(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            content = {
+                "training": [
+                    {"image": "images/a.nii.gz", "label": 3},
+                    {"image": "images/b.nii.gz", "label": 0},
+                ]
+            }
+            path = _write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, False, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "images/a.nii.gz")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "images/b.nii.gz")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            abs_image = os.path.join(tmp, "image.nii.gz")
+            abs_label = os.path.join(tmp, "label.nii.gz")
+            content = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        with tempfile.TemporaryDirectory() as tmp:
+            content = {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]}
+            path = _write_datalist(tmp, content)
+            result = load_decathalon_datalist(path, True, "test", tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs/case0.nii.gz")))
+            self.assertNotIn("label", result[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
