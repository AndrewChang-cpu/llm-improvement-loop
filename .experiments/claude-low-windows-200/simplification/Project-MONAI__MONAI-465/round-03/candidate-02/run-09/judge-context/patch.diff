+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str, key: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Each string is joined with ``base_dir`` and normalized. Lists are resolved element by element and
+    keep their length and order. Any other type raises ValueError.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for index, element in enumerate(value):
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {index} of field '{field}' under key '{key}' in {file_path} "
+                    f"must be a string, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' under key '{key}' in {file_path} must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is left exactly as stored, whatever its type (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value is the list of entries. Use "test" for
+            test entries, which are plain path strings and are wrapped as image-only items. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Absolute paths are kept absolute. Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary keeps the field names of
+        the input entry. The "image" field, and the "label" field in segmentation mode, hold resolved paths:
+        either a normalized string, or a list of normalized strings with the same length and order as the
+        input list. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an entry is not a mapping, or a
+            path field is neither a string nor a list of strings.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("datalist.json", is_segmentation=True, data_list_key="training")
+            # items[0]["image"] and items[0]["label"] are normalized paths under the datalist's directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in data list file {data_list_file_path} must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each entry under key '{data_list_key}' in {data_list_file_path} must be a mapping, got {item!r}."
+            )
+        resolved = dict(item)
+        if "image" in item:
+            resolved["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path, data_list_key)
+        if is_segmentation and "label" in item:
+            resolved["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path, data_list_key)
+        items.append(resolved)
+
+    return items
