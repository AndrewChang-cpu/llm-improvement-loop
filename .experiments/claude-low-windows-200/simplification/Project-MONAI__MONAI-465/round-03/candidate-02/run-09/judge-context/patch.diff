+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        path = self._write_datalist(
+            tmp,
+            {
+                "training": [
+                    {"image": "imgs/./img0.nii", "label": "labs//lab0.nii", "fold": 1},
+                ]
+            },
+        )
+
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/./img0.nii")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "labs//lab0.nii")))
+        self.assertEqual(items[0]["fold"], 1)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        path = self._write_datalist(
+            tmp,
+            {
+                "training": [
+                    {"image": "img0.nii", "label": 3},
+                    {"image": "img1.nii", "label": 0},
+                ]
+            },
+        )
+
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+        self.assertEqual(items[0]["label"], 3)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[1]["label"], 0)
+        self.assertIsInstance(items[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        abs_image = os.path.join(tmp, "image.nii")
+        abs_label = os.path.join(tmp, "label.nii")
+        path = self._write_datalist(
+            tmp,
+            {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ]
+            },
+        )
+
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        path = self._write_datalist(tmp, {"test": ["t0.nii", "t1.nii"]})
+
+        items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "t0.nii")))
+        self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
