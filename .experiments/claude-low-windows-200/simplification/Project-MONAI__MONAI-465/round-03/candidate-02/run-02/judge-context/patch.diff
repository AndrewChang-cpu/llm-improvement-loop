+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """Resolve a path value (a string or a list of strings) against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{file_path}' must be a string or a list of strings, "
+                    f"but a list element has type {type(element).__name__}: {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist '{file_path}' must be a string or a list of strings, "
+        f"but got type {type(value).__name__}: {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is returned exactly as stored, whatever its type (for example an integer class id).
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist whose value is the list of entries. Defaults to
+            "training". If it equals "test", each entry is a plain path string and is wrapped as an item
+            with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means
+            the directory containing ``data_list_file_path``. Absolute paths are kept absolute.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as the
+        input entry. The "image" field, and the "label" field when ``is_segmentation`` is True, hold resolved
+        paths: either a normalized string, or a list of normalized strings with the same length and order as
+        the input list. All other fields are unchanged.
+
+        Example::
+
+            [{"image": "/data/imgs/case0.nii.gz", "label": "/data/segs/case0.nii.gz", "fold": 1}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the datalist,
+            if an item is not a mapping, or if an image or label path is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list, "
+            f"but got type {type(entries).__name__}."
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a "
+                f"mapping, but got type {type(item).__name__}: {item!r}"
+            )
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+
+    return items
