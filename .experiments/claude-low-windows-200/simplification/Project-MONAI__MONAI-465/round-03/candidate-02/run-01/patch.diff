+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """Resolve a single path string, or each string in a list of path strings, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list in datalist file '{file_path}' must contain only strings, "
+                    f"found {type(element).__name__}: {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+        f"found {type(value).__name__}: {value!r}"
+    )
+
+
+def _check_mapping_item(item: Any, index: int, file_path: str) -> None:
+    if not isinstance(item, dict):
+        raise ValueError(
+            f"Entry {index} in datalist file '{file_path}' must be a mapping, found {type(item).__name__}: {item!r}"
+        )
+
+
+def _wrap_test_entry(entry: Any) -> Dict[str, Any]:
+    return {"image": entry}
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with its paths resolved against ``base_dir``.
+    In segmentation mode, the "label" field is resolved as a path. In classification mode, the "label" field is
+    returned exactly as stored, so it may be any JSON value, such as an integer class id. All other fields are
+    preserved unchanged.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must name an existing file.
+        is_segmentation (bool): if True, resolve the "label" field as a path or list of paths. If False, leave
+            the "label" field unchanged. Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries. If it is "test",
+            each entry is a plain path string and is converted to an item with only an "image" field.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are joined to. If None, the directory portion of
+            ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary holds the input fields.
+        "image" is a resolved path string or a list of resolved path strings of the same length as the input.
+        In segmentation mode, "label" has the same form. Other fields are unchanged. Paths are normalized, and
+        absolute paths stay absolute.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path field
+            is neither a string nor a list of strings.
+
+    Example:
+        A datalist with ``{"training": [{"image": "imgs/a.nii", "label": "labels/a.nii", "id": 1}]}`` at
+        ``/data/dl.json``, loaded with the defaults, returns
+        ``[{"image": "/data/imgs/a.nii", "label": "/data/labels/a.nii", "id": 1}]`` on POSIX systems.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list, "
+            f"found {type(entries).__name__}."
+        )
+
+    if data_list_key == "test":
+        items = [_wrap_test_entry(entry) for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for index, item in enumerate(items):
+        _check_mapping_item(item, index, data_list_file_path)
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        output.append(new_item)
+
+    return output
