+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "./imgs//a.nii", "label": "labels/a.nii", "extra": 5},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "training", tmp)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "a.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labels", "a.nii")))
+            self.assertEqual(result[0]["extra"], 5)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": ["imgs/a.nii", "imgs/b.nii"], "label": 2},
+                    {"image": "imgs/c.nii", "label": 0},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, False, "training", tmp)
+
+            self.assertEqual(len(result), 2)
+            expected_images = [
+                os.path.normpath(os.path.join(tmp, "imgs", "a.nii")),
+                os.path.normpath(os.path.join(tmp, "imgs", "b.nii")),
+            ]
+            self.assertEqual(result[0]["image"], expected_images)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imgs", "c.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "a.nii")
+            abs_label = os.path.join(tmp, "a_label.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imgs/t0.nii", "imgs/t1.nii"]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, True, "test", tmp)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "t0.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
