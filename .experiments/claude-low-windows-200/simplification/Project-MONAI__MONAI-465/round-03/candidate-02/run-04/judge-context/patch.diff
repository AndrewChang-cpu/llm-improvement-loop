+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            data = {
+                "training": [
+                    {
+                        "image": "imagesTr/case_0.nii.gz",
+                        "label": "labelsTr/./case_0.nii.gz",
+                        "fold": 0,
+                    },
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=True, data_list_key="training", base_dir=tmp
+            )
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            data = {
+                "training": [
+                    {"image": "imagesTr/case_0.nii.gz", "label": 2},
+                    {"image": "imagesTr/case_1.nii.gz", "label": 0},
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(
+                datalist_path, is_segmentation=False, data_list_key="training", base_dir=tmp
+            )
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case_0.nii.gz")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case_1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "case_0.nii.gz")
+            abs_label = os.path.join(tmp, "label_0.nii.gz")
+            datalist_path = os.path.join(tmp, "datalist.json")
+            data = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(datalist_path, is_segmentation=True, data_list_key="training")
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp, "datalist.json")
+            data = {
+                "test": [
+                    "imagesTs/case_0.nii.gz",
+                    "imagesTs/case_1.nii.gz",
+                ],
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(datalist_path, is_segmentation=True, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs/case_0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
