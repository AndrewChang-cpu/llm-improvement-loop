+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Resolve a single path string or a list of path strings against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, "
+                    f"found list element {element!r} of type {type(element).__name__}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, "
+        f"found {value!r} of type {type(value).__name__}."
+    )
+
+
+def _process_item(item: Any, base_dir: str, is_segmentation: bool, data_list_file_path: str) -> Dict[str, Any]:
+    """Validate one datalist item and resolve its path fields."""
+    if not isinstance(item, dict):
+        raise ValueError(
+            f"Each entry in datalist '{data_list_file_path}' must be a mapping, "
+            f"found {item!r} of type {type(item).__name__}."
+        )
+    result = dict(item)
+    if "image" in result:
+        result["image"] = _resolve_path(result["image"], base_dir, "image", data_list_file_path)
+    if is_segmentation and "label" in result:
+        result["label"] = _resolve_path(result["label"], base_dir, "label", data_list_file_path)
+    return result
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must name an existing file.
+        is_segmentation (bool): whether the entries are for segmentation. When True, the "label" field of each
+            item is resolved as a path (a string or a list of strings). When False, "label" is left exactly as
+            stored, so it may be any JSON value such as an integer class id. Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries. Defaults to
+            "training". If it equals "test", each entry is a plain path string and is wrapped as an item whose
+            only field is "image".
+        base_dir (str): directory that relative paths are joined with. Absolute paths are kept as they are.
+            If None, the directory portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order of the datalist. Each dict has the same field names as the input
+        item. "image" and, in segmentation mode, "label" hold resolved paths as a string or a list of strings
+        of the same length as the input. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an entry is not a mapping, or a
+            path field is not a string or a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz", "fold": 0}, ...]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    return [_process_item(item, base_dir, is_segmentation, data_list_file_path) for item in entries]
