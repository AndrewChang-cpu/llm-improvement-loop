+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _check_path_value(value: Any, field: str, file_path: str) -> None:
+    """Raise ValueError unless value is a string or a list of strings."""
+    if isinstance(value, str):
+        return
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list in datalist '{file_path}' must contain only strings, found {element!r}."
+                )
+        return
+    raise ValueError(
+        f"Field '{field}' in datalist '{file_path}' must be a string or a list of strings, found {value!r}."
+    )
+
+
+def _resolve_path(value: Any, base_dir: str) -> Any:
+    """Resolve a validated path string, or each string in a validated list, against base_dir independently."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. It must exist.
+        is_segmentation (bool): if True, the "label" field is treated as a path (or list of paths) and is resolved
+            against base_dir and type-checked. If False, "label" is returned exactly as stored, whatever its type,
+            which suits classification where labels are integer class ids. Default is True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries. Default is "training".
+            If it equals "test", each entry is a plain path string and is wrapped as an item holding only "image".
+        base_dir (str): directory that relative paths are joined to. Default is None, which uses the directory
+            portion of data_list_file_path.
+
+    Returns:
+        list of dict: one dict per entry, in the original order. Each dict keeps the input field names. The "image"
+        field, and "label" when is_segmentation is True, hold normalized paths as a string or as a list of the same
+        length and order as the input. Absolute paths stay absolute. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an "image" or
+            segmentation "label" value is not a string or list of strings.
+
+    Example:
+        >>> items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        >>> items[0]["image"], items[0]["label"]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Item in datalist file '{data_list_file_path}' must be a mapping, found {entry!r}.")
+        item = dict(entry)
+
+        if "image" in item:
+            _check_path_value(item["image"], "image", data_list_file_path)
+            item["image"] = _resolve_path(item["image"], base_dir)
+
+        if is_segmentation and "label" in item:
+            _check_path_value(item["label"], "label", data_list_file_path)
+            item["label"] = _resolve_path(item["label"], base_dir)
+
+        items.append(item)
+
+    return items
