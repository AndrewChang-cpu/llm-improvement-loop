+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, True)
+        return tmp_dir
+
+    def _write_datalist(self, tmp_dir, content):
+        file_path = os.path.join(tmp_dir, "datalist.json")
+        with open(file_path, "w") as f:
+            json.dump(content, f)
+        return file_path
+
+    def test_seg_values(self):
+        tmp_dir = self._make_dir()
+        file_path = self._write_datalist(
+            tmp_dir,
+            {"training": [{"image": "./imgs//img0.nii", "label": "segs/seg0.nii", "extra": 7}]},
+        )
+        result = load_decathalon_datalist(file_path, True, "training", tmp_dir)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "./imgs//img0.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "segs/seg0.nii")))
+        self.assertEqual(result[0]["extra"], 7)
+
+    def test_cls_values(self):
+        tmp_dir = self._make_dir()
+        file_path = self._write_datalist(
+            tmp_dir,
+            {"training": [{"image": "img0.nii", "label": 3}, {"image": "img1.nii", "label": 0}]},
+        )
+        result = load_decathalon_datalist(file_path, False, "training", tmp_dir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+        self.assertEqual(result[0]["label"], 3)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["label"], 0)
+        self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_dir()
+        abs_image = os.path.join(tmp_dir, "img0.nii")
+        abs_label = os.path.join(tmp_dir, "seg0.nii")
+        file_path = self._write_datalist(
+            tmp_dir,
+            {"training": [{"image": abs_image, "label": abs_label}]},
+        )
+        result = load_decathalon_datalist(file_path, True, "training", None)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_dir()
+        file_path = self._write_datalist(
+            tmp_dir,
+            {"test": ["img0.nii", "img1.nii"]},
+        )
+        result = load_decathalon_datalist(file_path, data_list_key="test", base_dir=tmp_dir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+
+
+if __name__ == "__main__":
+    unittest.main()
