+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, payload):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(payload, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp,
+                {
+                    "training": [
+                        {"image": "imgs/case0.nii", "label": "labels/case0.nii", "extra": "keep"},
+                    ],
+                },
+            )
+            items = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "labels", "case0.nii")))
+            self.assertEqual(items[0]["extra"], "keep")
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp,
+                {
+                    "training": [
+                        {"image": "imgs/case0.nii", "label": 3},
+                        {"image": "imgs/case1.nii", "label": 0},
+                    ],
+                },
+            )
+            items = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "case0.nii")))
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp, "imgs", "case1.nii")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 3)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tmp, "case0.nii")
+            label = os.path.join(tmp, "case0_label.nii")
+            path = self._write_datalist(
+                tmp,
+                {
+                    "training": [
+                        {"image": image, "label": label},
+                    ],
+                },
+            )
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(len(items), 1)
+            self.assertTrue(os.path.isabs(items[0]["image"]))
+            self.assertTrue(os.path.isabs(items[0]["label"]))
+            self.assertEqual(items[0]["image"], os.path.normpath(image))
+            self.assertEqual(items[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp,
+                {
+                    "test": [
+                        "imgs/test0.nii",
+                        "imgs/test1.nii",
+                    ],
+                },
+            )
+            items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "test0.nii")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
