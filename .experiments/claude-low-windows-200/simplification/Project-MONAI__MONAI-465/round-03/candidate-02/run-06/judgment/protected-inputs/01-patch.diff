+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a single path string, or each string of a list of paths, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist '{file_path}' must be a string or a list of strings, "
+                    f"but contains the non-string element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist '{file_path}' must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the items are for segmentation. If True, the "label" field of each
+            item is resolved as a path. If False, "label" is left exactly as stored, whatever its type,
+            e.g. an integer class id. Defaults to True.
+        data_list_key (str): top-level key of the datalist holding the list of entries. Entries under
+            "test" are plain path strings and are wrapped as ``{"image": entry}`` items. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Raises:
+        ValueError: if the datalist file does not exist, lacks ``data_list_key``, or contains an item that is
+            not a JSON object, or whose "image" (or, in segmentation mode, "label") value is not a string or a
+            list of strings.
+
+    Returns:
+        A list of dicts, in the same order as the datalist entries. Each dict has the same field names as the
+        input entry. "image" and, in segmentation mode, "label" hold the resolved paths, as a normalized string
+        or as a list of normalized strings of the same length and order as the input. All other fields are
+        copied unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "<datalist dir>/imgs/case0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        try:
+            data = json.load(f)
+        except ValueError as err:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {err}") from err
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list, "
+            f"got {type(entries).__name__}."
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a JSON object, got {type(item).__name__}."
+            )
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_path(resolved["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_path(resolved["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+
+    return items
