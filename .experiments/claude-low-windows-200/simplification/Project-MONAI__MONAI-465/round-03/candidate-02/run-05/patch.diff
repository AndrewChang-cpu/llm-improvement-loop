+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """Resolve a single path string, or each string in a list of paths, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' in datalist file '{file_path}' must be a string, got {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{field}' in datalist file '{file_path}' must be a string or a list of strings, got {value!r}.")
+
+
+def _resolve_item(item: Any, index: int, is_segmentation: bool, base_dir: str, file_path: str) -> Dict[str, Any]:
+    """Return a copy of one datalist item with its "image" (and "label" in segmentation mode) resolved."""
+    if not isinstance(item, Mapping):
+        raise ValueError(f"Entry {index} in datalist file '{file_path}' must be a mapping, got {type(item).__name__}.")
+    resolved = dict(item)
+    if "image" in item:
+        resolved["image"] = _resolve_path(item["image"], base_dir, "image", file_path)
+    if is_segmentation and "label" in item:
+        resolved["label"] = _resolve_path(item["label"], base_dir, "label", file_path)
+    return resolved
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    In segmentation mode, both "image" and "label" are resolved as paths. In classification mode, only "image" is
+    resolved and "label" is kept exactly as stored, so integer class ids stay integers. All other fields are kept
+    unchanged. Entries under the "test" key are plain path strings and are wrapped as ``{"image": entry}`` items.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, resolve "label" as a path (a string or a list of strings). If False,
+            leave "label" unchanged, whatever its type. Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value holds the entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, defaults to the directory
+            portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary has the same field names as
+        the input entry. "image" and, in segmentation mode, "label" hold the resolved paths, either as a string or
+        as a list of the same length as the input list. Relative paths are normalized after joining with
+        ``base_dir``, and absolute paths stay absolute.
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing, if an entry is not a
+            mapping, or if a path value is not a string or a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] and items[0]["label"] are resolved paths relative to the datalist's directory.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as file_handle:
+        json_data = json.load(file_handle)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    return [
+        _resolve_item(item, index, is_segmentation, base_dir, data_list_file_path)
+        for index, item in enumerate(entries)
+    ]
