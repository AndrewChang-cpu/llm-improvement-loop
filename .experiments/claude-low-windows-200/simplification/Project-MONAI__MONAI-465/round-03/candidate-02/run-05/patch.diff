+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        list_path = os.path.join(directory, "datalist.json")
+        with open(list_path, "w") as handle:
+            json.dump(content, handle)
+        return list_path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {"training": [{"image": "imgs/case0.nii", "label": "labels/case0.nii", "fold": 0}]}
+            list_path = self._write_datalist(tmp_dir, data)
+            base_dir = os.path.join(tmp_dir, "base")
+
+            items = load_decathalon_datalist(list_path, True, "training", base_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/case0.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {"training": [{"image": "imgs/case0.nii", "label": 2}, {"image": "imgs/case1.nii", "label": 0}]}
+            list_path = self._write_datalist(tmp_dir, data)
+            base_dir = os.path.join(tmp_dir, "base")
+
+            items = load_decathalon_datalist(list_path, False, "training", base_dir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii")))
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case1.nii")))
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+            self.assertIsInstance(items[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "image0.nii")
+            label_path = os.path.join(tmp_dir, "label0.nii")
+            data = {"training": [{"image": image_path, "label": label_path}]}
+            list_path = self._write_datalist(tmp_dir, data)
+
+            items = load_decathalon_datalist(list_path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {"test": ["imgs/test0.nii", "imgs/test1.nii"]}
+            list_path = self._write_datalist(tmp_dir, data)
+            base_dir = os.path.join(tmp_dir, "base")
+
+            items = load_decathalon_datalist(list_path, True, "test", base_dir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/test0.nii")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
