+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Union[str, List[str]]:
+    """Resolve a string or list-of-strings path value against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file '{data_list_file_path}' "
+                    "must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False
+            (classification), the "label" is returned exactly as stored, whatever its type. Defaults to True.
+        data_list_key (str): top-level key in the datalist whose value is the list of entries.
+            Defaults to "training". If it is "test", each entry is a plain path string and is wrapped
+            as an item with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which
+            means the directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path field is neither a string nor a list of strings.
+
+    Returns:
+        A list of dicts, in the original order of the datalist. Each dict keeps the field names of its
+        input item. "image", and "label" when ``is_segmentation`` is True, hold resolved paths: either a
+        normalized string or a list of normalized strings of the same length and order as the input.
+        All other fields are unchanged. Example::
+
+            [{"image": "/data/imgs/case0.nii", "label": "/data/labels/case0.nii", "fold": 1}]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, Mapping) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for index, item in enumerate(entries):
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {type(item).__name__}."
+            )
+        resolved = dict(item)
+        if "image" in item:
+            resolved["image"] = _resolve_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            resolved["label"] = _resolve_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(resolved)
+
+    return items
