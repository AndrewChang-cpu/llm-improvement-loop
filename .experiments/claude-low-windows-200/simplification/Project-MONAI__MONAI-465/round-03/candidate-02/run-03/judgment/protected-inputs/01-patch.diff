+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": "labels/case0.nii", "fold": 1},
+                ]
+            }
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, True, "training", base_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/case0.nii")))
+            self.assertEqual(items[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": 2},
+                    {"image": "imgs/case1.nii", "label": 0},
+                ]
+            }
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, False, "training", base_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case0.nii")))
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(base_dir, "imgs/case1.nii")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_abs = os.path.join(tmp_dir, "case0.nii")
+            label_abs = os.path.join(tmp_dir, "label0.nii")
+            datalist = {"training": [{"image": image_abs, "label": label_abs}]}
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(image_abs))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_abs))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            base_dir = os.path.join(tmp_dir, "data")
+            datalist = {"test": ["imgs/test0.nii", "imgs/test1.nii"]}
+            path = self._write_datalist(tmp_dir, datalist)
+            items = load_decathalon_datalist(path, True, "test", base_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/test0.nii")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
