+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/case0.nii.gz",
+                        "label": "./labelsTr//case0.nii.gz",
+                        "fold": 1,
+                    },
+                    {
+                        "image": "imagesTr/case1.nii.gz",
+                        "label": "labelsTr/case1.nii.gz",
+                        "fold": 2,
+                    },
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imagesTr", "case0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labelsTr", "case0.nii.gz")),
+                    "fold": 1,
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imagesTr", "case1.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labelsTr", "case1.nii.gz")),
+                    "fold": 2,
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": 0},
+                    {"image": "imagesTr/case1.nii.gz", "label": 3},
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            expected = [
+                {"image": os.path.normpath(os.path.join(tempdir, "imagesTr", "case0.nii.gz")), "label": 0},
+                {"image": os.path.normpath(os.path.join(tempdir, "imagesTr", "case1.nii.gz")), "label": 3},
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "case0.nii.gz")
+            abs_label = os.path.join(tempdir, "case0_label.nii.gz")
+            datalist = {
+                "training": [{"image": abs_image, "label": abs_label}],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result, [{"image": abs_image, "label": abs_label}])
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imagesTs/case0.nii.gz",
+                    "imagesTs/case1.nii.gz",
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "imagesTs", "case0.nii.gz"))})
+            self.assertEqual(result[1], {"image": os.path.normpath(os.path.join(tempdir, "imagesTs", "case1.nii.gz"))})
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
