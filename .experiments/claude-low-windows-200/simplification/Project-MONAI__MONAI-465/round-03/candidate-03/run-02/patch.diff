+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, value))
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """Resolve a string or a list of strings; raise ValueError for any other type."""
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' must be a string in datalist {data_list_file_path}, "
+                    f"got {type(element).__name__}."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(
+        f"'{field}' must be a string or a list of strings in datalist {data_list_file_path}, "
+        f"got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist is for segmentation. When True, the "label" field of each
+            item is resolved as a path like "image". When False, the label is kept exactly as stored, whatever
+            its type (for example, an integer class id). Defaults to True.
+        data_list_key (str): key under which the list of entries is stored in the JSON object. Defaults to
+            "training". When it equals "test", each plain entry is wrapped as an item with only an "image" field.
+        base_dir (str): directory against which relative paths are resolved. Defaults to None, meaning the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order of the datalist. Each dict keeps the input field names. The "image"
+        field, and the "label" field in segmentation mode, hold resolved paths: either a normalized string, or a
+        list of normalized strings with the same length and order as the input. All other fields are unchanged.
+
+    Example::
+
+        {"training": [{"image": "img0.nii", "label": "seg0.nii", "name": "case0"}]}
+
+        load_decathalon_datalist("/data/dl.json", base_dir="/data") returns
+        [{"image": "/data/img0.nii", "label": "/data/seg0.nii", "name": "case0"}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each datalist item must be a mapping in datalist {data_list_file_path}, "
+                f"got {type(item).__name__}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
