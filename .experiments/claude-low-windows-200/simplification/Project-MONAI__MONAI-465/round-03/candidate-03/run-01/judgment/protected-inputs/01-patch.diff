+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list whose elements are all strings.
+        base_dir (str): directory against which relative paths are joined.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list element {element!r} in {data_list_file_path} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' value {value!r} in {data_list_file_path} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field is resolved as a path. If False, the label is kept
+            exactly as stored, so it may be any JSON value such as an integer class id. Defaults to True.
+        data_list_key (str): top-level key under which the entries are stored. If it equals "test", each entry
+            is wrapped as an item whose only field is "image". Defaults to "training".
+        base_dir (str): directory against which relative paths are resolved. Defaults to None, which means the
+            directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or a list of strings.
+
+    Returns:
+        a list of dictionaries, one per entry, in the original order. Each dictionary has the input field names.
+        "image" (and "label" when ``is_segmentation`` is True) hold resolved paths, as a string or a list of
+        strings of the same length as the input. All other fields are unchanged.
+
+    Example:
+        .. code-block:: python
+
+            items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+            # items[0] -> {"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz"}
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist file {data_list_file_path} must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
