+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/case0.nii.gz",
+                        "label": "labelsTr/./case0.nii.gz",
+                        "fold": 1,
+                    },
+                ],
+            }
+            data_file = os.path.join(tempdir, "dataset.json")
+            with open(data_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_file, True, "training", tempdir)
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imagesTr/case0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labelsTr/./case0.nii.gz")),
+                    "fold": 1,
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "images/a.nii.gz", "label": 3},
+                    {"image": "images/b.nii.gz", "label": 0},
+                ],
+            }
+            data_file = os.path.join(tempdir, "dataset.json")
+            with open(data_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_file, False, "training", tempdir)
+            expected = [
+                {"image": os.path.normpath(os.path.join(tempdir, "images/a.nii.gz")), "label": 3},
+                {"image": os.path.normpath(os.path.join(tempdir, "images/b.nii.gz")), "label": 0},
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "case0.nii.gz")
+            abs_label = os.path.join(tempdir, "case0_label.nii.gz")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            data_file = os.path.join(tempdir, "dataset.json")
+            with open(data_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_file, True, "training", None)
+            expected = [{"image": os.path.normpath(abs_image), "label": os.path.normpath(abs_label)}]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]}
+            data_file = os.path.join(tempdir, "dataset.json")
+            with open(data_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_file, True, "test", tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/case0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
