+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imgs/case0.nii.gz", "label": "labels/./case0.nii.gz", "fold": 0},
+                    {"image": "imgs//case1.nii.gz", "label": "labels/case1.nii.gz", "fold": 1},
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imgs/case0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labels/case0.nii.gz")),
+                    "fold": 0,
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imgs/case1.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labels/case1.nii.gz")),
+                    "fold": 1,
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "case0.nii.gz", "label": 0},
+                    {"image": "case1.nii.gz", "label": 2},
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            expected = [
+                {"image": os.path.normpath(os.path.join(tempdir, "case0.nii.gz")), "label": 0},
+                {"image": os.path.normpath(os.path.join(tempdir, "case1.nii.gz")), "label": 2},
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "case0.nii.gz")
+            abs_label = os.path.join(tempdir, "case0_seg.nii.gz")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(result, [{"image": os.path.normpath(abs_image), "label": os.path.normpath(abs_label)}])
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["case0.nii.gz", "case1.nii.gz"]}
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            expected = [
+                {"image": os.path.normpath(os.path.join(tempdir, "case0.nii.gz"))},
+                {"image": os.path.normpath(os.path.join(tempdir, "case1.nii.gz"))},
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
