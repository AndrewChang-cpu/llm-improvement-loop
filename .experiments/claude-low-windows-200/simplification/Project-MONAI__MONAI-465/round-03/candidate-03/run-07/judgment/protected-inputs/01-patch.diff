+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list elements must be strings in datalist file {data_list_file_path}, "
+                    f"got {type(element).__name__}: {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' must be a string or a list of strings in datalist file {data_list_file_path}, "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load the image and label information of the Medical Segmentation Decathlon style datalist file.
+
+    Args:
+        data_list_file_path (str): the path to the json file of datalist.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field is resolved
+            as a path, and must be a string or a list of strings. If False, the "label" field is kept exactly
+            as stored, so it may be any JSON value, such as an integer class id. Default to True.
+        data_list_key (str): the key to store the list of entries in the json file. Default to "training".
+        base_dir (str): the base directory that relative paths in the datalist are resolved against.
+            If None, the directory of ``data_list_file_path`` is used. Default to None.
+
+    Returns:
+        A list of dictionaries, one per entry under ``data_list_key``, in the original order. Each dictionary
+        has the same field names as the input entry. The "image" field, and the "label" field in segmentation
+        mode, hold resolved paths as a string or as a list of the same length. All other fields are unchanged.
+        When ``data_list_key`` is "test", each entry is wrapped as a dictionary whose only field is "image".
+
+    Example::
+
+        [{"image": "/data/case0.nii.gz", "label": "/data/case0_seg.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: when the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item must be a mapping in datalist file {data_list_file_path}, got {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
