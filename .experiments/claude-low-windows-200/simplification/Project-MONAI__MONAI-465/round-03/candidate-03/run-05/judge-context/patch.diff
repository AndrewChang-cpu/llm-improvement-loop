+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/case_0.nii.gz",
+                        "label": "labelsTr/case_0.nii.gz",
+                        "name": "case_0",
+                    },
+                    {
+                        "image": "./imagesTr//case_1.nii.gz",
+                        "label": "labelsTr/./case_1.nii.gz",
+                        "name": "case_1",
+                    },
+                ],
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imagesTr/case_0.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labelsTr/case_0.nii.gz")),
+                    "name": "case_0",
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "./imagesTr//case_1.nii.gz")),
+                    "label": os.path.normpath(os.path.join(tempdir, "labelsTr/./case_1.nii.gz")),
+                    "name": "case_1",
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/case_0.nii.gz",
+                        "label": 0,
+                    },
+                    {
+                        "image": "imagesTr/case_1.nii.gz",
+                        "label": 2,
+                    },
+                ],
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imagesTr/case_0.nii.gz")),
+                    "label": 0,
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tempdir, "imagesTr/case_1.nii.gz")),
+                    "label": 2,
+                },
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "case_0.nii.gz")
+            label_path = os.path.join(tempdir, "case_0_label.nii.gz")
+            datalist = {
+                "training": [
+                    {
+                        "image": image_path,
+                        "label": label_path,
+                    },
+                ],
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            expected = [
+                {
+                    "image": os.path.normpath(image_path),
+                    "label": os.path.normpath(label_path),
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imagesTs/case_0.nii.gz",
+                    "imagesTs/case_1.nii.gz",
+                ],
+            }
+            file_path = os.path.join(tempdir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            expected = [
+                {"image": os.path.normpath(os.path.join(tempdir, "imagesTs/case_0.nii.gz"))},
+                {"image": os.path.normpath(os.path.join(tempdir, "imagesTs/case_1.nii.gz"))},
+            ]
+            self.assertEqual(result, expected)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/case_0.nii.gz")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
