+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str) -> Any:
+    """
+    Resolve a path value against ``base_dir``. A string is joined with ``base_dir`` and normalized;
+    a list of strings is resolved element by element, keeping length and order.
+
+    Args:
+        value (Any): a string path or a list of string paths.
+        base_dir (str): directory the relative paths are resolved against.
+        field (str): name of the datalist field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is not a string or a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Element {element!r} of field '{field}' must be a string, got {type(element)}.")
+        return [_resolve_path(element, base_dir, field) for element in value]
+    raise ValueError(f"Field '{field}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of each
+            item is resolved as a path. If False, "label" is kept exactly as stored, whatever its type,
+            e.g. an integer class id. Defaults to True.
+        data_list_key (str): key under the top-level JSON object that holds the list of entries.
+            Defaults to "training". When it is "test", each entry is wrapped as an item with only an
+            "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            meaning the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict has the same field names as the
+        input entry. The "image" field, and the "label" field in segmentation mode, hold resolved paths
+        as a string or as a list of strings of the same length as the input. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the datalist file does not exist, lacks ``data_list_key``, has a non-mapping item,
+            or has an "image"/"label" value that is not a string or a list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # [{"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}, ...]
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist file '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image")
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label")
+        items.append(new_item)
+    return items
