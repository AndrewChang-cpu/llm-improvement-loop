+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths resolved element by element.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in {data_list_file_path} must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' value {value!r} in {data_list_file_path} must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field of each
+            item is resolved as a path. If False, the "label" is kept exactly as stored, for example an
+            integer class id. Defaults to True.
+        data_list_key (str): key under which the list of entries is stored in the JSON file.
+            Defaults to "training". When it is "test", each entry is wrapped as an item with only an "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None, which
+            means the directory containing ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order of the datalist. Each dict keeps the input field names. The
+        "image" field holds a resolved path string, or a list of resolved path strings of the same length.
+        In segmentation mode the "label" field is resolved the same way. All other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or a list of strings.
+
+    Example::
+
+        >>> items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        >>> items[0]["image"], items[0]["label"]  # doctest: +SKIP
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Item {item!r} in datalist file {data_list_file_path} must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
