+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/img_0.nii",
+                        "label": "labelsTr/seg_0.nii",
+                        "fold": 0,
+                    },
+                    {
+                        "image": "./imagesTr//img_1.nii",
+                        "label": "./labelsTr//seg_1.nii",
+                        "fold": 1,
+                    },
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/img_0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/seg_0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/img_1.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/seg_1.nii")))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img_0.nii", "label": 0},
+                    {"image": "img_1.nii", "label": 3},
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, False, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_0.nii")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img_1.nii")))
+            self.assertEqual(result[1]["label"], 3)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img_0.nii")
+            abs_label = os.path.join(tempdir, "seg_0.nii")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imagesTs/img_0.nii",
+                    "imagesTs/img_1.nii",
+                ],
+            }
+            file_path = os.path.join(tempdir, "datalist.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(file_path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(list(result[0].keys()), ["image"])
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/img_0.nii")))
+            self.assertEqual(list(result[1].keys()), ["image"])
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/img_1.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
