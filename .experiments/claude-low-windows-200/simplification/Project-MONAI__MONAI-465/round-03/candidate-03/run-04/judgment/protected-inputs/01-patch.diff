+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: the stored path value, a string or a list of strings.
+        base_dir (str): directory that relative paths are joined to.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list element {element!r} in {data_list_file_path} must be a string.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' value {value!r} in {data_list_file_path} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field is a path and is resolved against ``base_dir``.
+            If False, the "label" field is kept exactly as stored, for example an integer class id.
+            Default is True.
+        data_list_key (str): top-level key holding the list of entries. Default is "training".
+            If it equals "test", each entry is a plain value wrapped as an item with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Default is None, meaning
+            the directory portion of ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping,
+            or a path value is not a string or a list of strings.
+
+    Returns:
+        A list of dictionaries in the original order. Each dictionary keeps the input field names. The
+        "image" field, and the "label" field in segmentation mode, hold resolved paths as a normalized
+        string or as a list of normalized strings of the same length as the input. All other fields are
+        unchanged. For example::
+
+            [{"image": "/data/img_0.nii", "label": "/data/seg_0.nii", "fold": 0}]
+
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in {data_list_file_path} under key '{data_list_key}' must be a mapping.")
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+    return items
