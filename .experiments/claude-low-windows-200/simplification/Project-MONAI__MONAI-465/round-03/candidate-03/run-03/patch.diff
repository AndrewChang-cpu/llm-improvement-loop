+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single string path with ``base_dir`` and normalize it."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """Resolve a string or list-of-strings path value; raise ValueError for any other type."""
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list element {element!r} in {data_list_file_path} must be a string.")
+            resolved.append(_resolve_path(element, base_dir))
+        return resolved
+    raise ValueError(f"Field '{field}' value {value!r} in {data_list_file_path} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" is kept exactly as stored (for example, an integer class id). Defaults to True.
+        data_list_key (str): key under which the list of entries is stored in the JSON file. If it is "test",
+            each entry is treated as a plain image path and wrapped as ``{"image": entry}``. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are resolved against. If None, the directory
+            portion of ``data_list_file_path`` is used. Defaults to None.
+
+    Returns:
+        A list of dicts in the original order of the datalist. Each dict keeps all fields of its entry. The
+        "image" field, and the "label" field when ``is_segmentation`` is True, hold resolved paths: either a
+        normalized string, or a list of normalized strings with the same length and order as the input list.
+        All other fields are unchanged.
+
+    Example:
+        .. code-block:: python
+
+            # datalist.json: {"training": [{"image": "img0.nii", "label": "seg0.nii", "name": "case0"}]}
+            items = load_decathalon_datalist("/data/datalist.json", data_list_key="training")
+            # items == [{"image": "/data/img0.nii", "label": "/data/seg0.nii", "name": "case0"}]
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path value
+            is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Data list item {item!r} in {data_list_file_path} must be a mapping.")
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path_value(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path_value(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
