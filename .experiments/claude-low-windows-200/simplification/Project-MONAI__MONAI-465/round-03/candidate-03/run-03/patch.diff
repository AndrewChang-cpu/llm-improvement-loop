+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _write_datalist(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/img0.nii", "label": "labelsTr/seg0.nii", "name": "case0"},
+                    {"image": "./imagesTr//img1.nii", "label": "labelsTr/seg1.nii", "name": "case1"},
+                ]
+            }
+            path = self._write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, True, "training", tmp_dir)
+
+            expected = [
+                {
+                    "image": os.path.normpath(os.path.join(tmp_dir, "imagesTr/img0.nii")),
+                    "label": os.path.normpath(os.path.join(tmp_dir, "labelsTr/seg0.nii")),
+                    "name": "case0",
+                },
+                {
+                    "image": os.path.normpath(os.path.join(tmp_dir, "imagesTr/img1.nii")),
+                    "label": os.path.normpath(os.path.join(tmp_dir, "labelsTr/seg1.nii")),
+                    "name": "case1",
+                },
+            ]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"training": [{"image": "img0.nii", "label": 0}, {"image": "img1.nii", "label": 3}]}
+            path = self._write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, False, "training", tmp_dir)
+
+            expected = [
+                {"image": os.path.normpath(os.path.join(tmp_dir, "img0.nii")), "label": 0},
+                {"image": os.path.normpath(os.path.join(tmp_dir, "img1.nii")), "label": 3},
+            ]
+            self.assertEqual(result, expected)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_abs = os.path.join(tmp_dir, "img0.nii")
+            label_abs = os.path.join(tmp_dir, "seg0.nii")
+            datalist = {"training": [{"image": image_abs, "label": label_abs}]}
+            path = self._write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            expected = [{"image": os.path.normpath(image_abs), "label": os.path.normpath(label_abs)}]
+            self.assertEqual(result, expected)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": ["imagesTs/img0.nii", "imagesTs/img1.nii"]
+            }
+            path = self._write_datalist(tmp_dir, datalist)
+            result = load_decathalon_datalist(path, True, "test", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(list(result[0].keys()), ["image"])
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTs/img0.nii")))
+            self.assertEqual(list(result[1].keys()), ["image"])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
