+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/img0.nii",
+                        "label": "labelsTr/lbl0.nii",
+                        "fold": 0,
+                    },
+                    {
+                        "image": "./imagesTr//img1.nii",
+                        "label": "labelsTr/lbl1.nii",
+                        "fold": 1,
+                    },
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/lbl0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/img1.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/lbl1.nii")))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img0.nii", "label": 0},
+                    {"image": "img1.nii", "label": 2},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tempdir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tempdir, "img0.nii")
+            abs_label = os.path.join(tempdir, "lbl0.nii")
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["img0.nii", "img1.nii"]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(set(result[0].keys()), {"image"})
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
