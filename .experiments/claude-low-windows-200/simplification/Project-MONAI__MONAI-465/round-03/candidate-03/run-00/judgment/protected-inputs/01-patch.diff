+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """
+    Join a single path string with ``base_dir`` and normalize the result.
+    Absolute paths are returned normalized, unchanged in location.
+    """
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_path_value(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value that is either a string or a list of strings.
+    Each list element is resolved independently; the list length and order are kept.
+    """
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in {data_list_file_path} must be a string, "
+                    f"got {type(element).__name__}."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field is resolved as a path. If False, the label is kept
+            exactly as stored, whatever its type (for example an integer class id). Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+            If it equals "test", each entry is wrapped as an item with only an "image" field.
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None,
+            meaning the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the input field names. The "image"
+        field (and, when ``is_segmentation`` is True, the "label" field) holds a resolved path as a string or as a
+        list of strings with the same length as the input. All other fields are unchanged. Absolute paths stay
+        absolute.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "<datalist dir>/imagesTr/case_000.nii.gz"
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each entry in {data_list_file_path} must be a mapping, got {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path_value(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path_value(processed["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
