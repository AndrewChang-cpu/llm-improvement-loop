+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value: a string path, or a list of string paths.
+        base_dir: directory that relative paths are joined with.
+        field: name of the field being resolved, used in error messages.
+        data_list_file_path: datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings of the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list element {element!r} in {data_list_file_path} must be a string.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' value {value!r} in {data_list_file_path} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the "label" field is resolved
+            as a path and must be a string or a list of strings. If False, "label" is kept exactly as stored,
+            for example an integer class id. Defaults to True.
+        data_list_key (str): key under the top-level object that holds the list of entries. Defaults to "training".
+            If it equals "test", each entry is a plain image path and is wrapped as an item with only an "image"
+            field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order, one per entry, with the input field names. The "image" field, and
+        the "label" field when ``is_segmentation`` is True, hold resolved paths as a string or a list of strings
+        of the same length as the input. All other fields are unchanged.
+
+    Example:
+        A datalist ``{"training": [{"image": "img.nii", "label": "seg.nii", "fold": 0}]}`` with ``base_dir``
+        "/data" returns ``[{"image": "/data/img.nii", "label": "/data/seg.nii", "fold": 0}]``.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in {data_list_file_path} must hold a list of entries.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in {data_list_file_path} must be a mapping, got {item!r}.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
