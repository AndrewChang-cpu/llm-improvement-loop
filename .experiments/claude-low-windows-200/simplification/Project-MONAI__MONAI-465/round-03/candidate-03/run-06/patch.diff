+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "./imagesTr/case_0.nii",
+                        "label": "labelsTr//case_0.nii",
+                        "fold": 0,
+                    },
+                ]
+            }
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/case_0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/case_0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "case_0.nii", "label": 2},
+                    {"image": ["case_1a.nii", "case_1b.nii"], "label": 0},
+                ]
+            }
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, False, "training", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "case_0.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(
+                result[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tempdir, "case_1a.nii")),
+                    os.path.normpath(os.path.join(tempdir, "case_1b.nii")),
+                ],
+            )
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "case_0.nii")
+            label_path = os.path.join(tempdir, "label_0.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, True, "training", None)
+
+            self.assertEqual(result[0]["image"], image_path)
+            self.assertEqual(result[0]["label"], label_path)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "case_0.nii",
+                    "case_1.nii",
+                ]
+            }
+            data_list_file = os.path.join(tempdir, "datalist.json")
+            with open(data_list_file, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(data_list_file, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0], {"image": os.path.normpath(os.path.join(tempdir, "case_0.nii"))})
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
