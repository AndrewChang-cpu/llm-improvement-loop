+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": "labelsTr/case0.nii.gz", "fold": 0},
+                    {"image": "./imagesTr//case1.nii.gz", "label": "labelsTr/case1.nii.gz", "fold": 1},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case1.nii.gz")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tmp, "labelsTr/case1.nii.gz")))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "imagesTr/case0.nii.gz", "label": 1},
+                    {"image": "imagesTr/case1.nii.gz", "label": 0},
+                ]
+            }
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], 1)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "imagesTr/case1.nii.gz")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            image_name = "case0.nii.gz"
+            label_name = "case0_label.nii.gz"
+            abs_image = os.path.join(tmp, image_name)
+            abs_label = os.path.join(tmp, label_name)
+            datalist = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            datalist = {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]}
+            path = os.path.join(tmp, "datalist.json")
+            with open(path, "w") as f:
+                json.dump(datalist, f)
+
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imagesTs/case0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
