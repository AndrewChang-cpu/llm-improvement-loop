+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path string, or each string in a list of path strings, against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list elements must be strings in datalist file '{data_list_file_path}', "
+                    f"got {type(element).__name__}: {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' must be a string or a list of strings in datalist file '{data_list_file_path}', "
+        f"got {type(value).__name__}: {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; must exist.
+        is_segmentation (bool): if True, "label" is resolved as a path (string or list of strings);
+            if False, "label" is kept exactly as stored, for example an integer class id.
+        data_list_key (str): top-level key holding the list of entries, default "training".
+            If it equals "test", each entry is a plain path string and is converted to an item
+            with only an "image" field.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which
+            uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps all fields of its
+        entry. "image" is always resolved, and "label" is resolved when ``is_segmentation`` is True.
+        A resolved value is a normalized path string, or a list of normalized path strings of the
+        same length and order as the input list. For example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz"}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' must hold a list in datalist file '{data_list_file_path}'.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(f"Each datalist item must be a mapping in datalist file '{data_list_file_path}'.")
+        out = dict(item)
+        if "image" in item:
+            out["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            out["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        output.append(out)
+    return output
