+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, value))
+
+
+def _resolve_field(value: Any, field: str, base_dir: str, data_list_file_path: str) -> Any:
+    """Resolve a "image" or "label" value that is a string or a list of strings."""
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' in {data_list_file_path} must be a string, got {element!r}."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(f"'{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, "label" is resolved as a path (string or list of strings) and validated.
+            If False, "label" is left exactly as stored, so classification labels such as integer ids are kept.
+            Defaults to True.
+        data_list_key (str): top-level key under which the entries are stored. Defaults to "training".
+            When it equals "test", each entry is a plain path string and is converted to an item with only "image".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning the directory
+            portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original entry order. Each dict keeps the input field names. "image" and, in
+        segmentation mode, "label" hold resolved paths, either as a string or as a list of the same length and
+        order as the input. All other fields are preserved unchanged.
+
+    Example::
+
+        {"training": [{"image": "img.nii", "label": "seg.nii", "fold": 0}]}
+        # loads to [{"image": "<base_dir>/img.nii", "label": "<base_dir>/seg.nii", "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, the JSON is invalid, the key is missing, an item is not a mapping,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict):
+        raise ValueError(f"Datalist file {data_list_file_path} must contain a JSON object at the top level.")
+    if data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Entries under key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    fields = ["image", "label"] if is_segmentation else ["image"]
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each item in datalist file {data_list_file_path} must be a mapping, got {entry!r}.")
+        item = dict(entry)
+        for field in fields:
+            if field in item:
+                item[field] = _resolve_field(item[field], field, base_dir, data_list_file_path)
+        items.append(item)
+    return items
