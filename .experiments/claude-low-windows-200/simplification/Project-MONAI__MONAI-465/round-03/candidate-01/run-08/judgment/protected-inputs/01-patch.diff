+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img_0.nii", "label": "seg_0.nii", "fold": 0},
+                    {"image": "img_1.nii", "label": "seg_1.nii", "fold": 1},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "seg_0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img_1.nii")))
+            self.assertEqual(result[1]["label"], os.path.normpath(os.path.join(tempdir, "seg_1.nii")))
+            self.assertEqual(result[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img_0.nii", "label": 0},
+                    {"image": "img_1.nii", "label": 2},
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, False, "training", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_0.nii")))
+            self.assertEqual(result[0]["label"], 0)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img_1.nii")))
+            self.assertEqual(result[1]["label"], 2)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tempdir, "img_0.nii")
+            label_path = os.path.join(tempdir, "seg_0.nii")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, True, "training", base_dir=None)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "img_0.nii",
+                    "img_1.nii",
+                ]
+            }
+            path = _write_datalist(tempdir, datalist)
+            result = load_decathalon_datalist(path, data_list_key="test", base_dir=tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img_0.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
