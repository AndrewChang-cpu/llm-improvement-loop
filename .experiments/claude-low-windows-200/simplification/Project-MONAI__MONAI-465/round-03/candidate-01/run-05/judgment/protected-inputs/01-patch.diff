+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single string path with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_field(item: Dict[str, Any], field: str, base_dir: str, data_list_file_path: str) -> None:
+    """Resolve ``item[field]`` in place; the value must be a string or a list of strings."""
+    value = item[field]
+    if isinstance(value, str):
+        item[field] = _resolve_path(value, base_dir)
+    elif isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list elements must be strings in datalist file {data_list_file_path}, "
+                    f"got {type(element).__name__}: {element!r}"
+                )
+        item[field] = [_resolve_path(element, base_dir) for element in value]
+    else:
+        raise ValueError(
+            f"Field '{field}' must be a string or a list of strings in datalist file {data_list_file_path}, "
+            f"got {type(value).__name__}: {value!r}"
+        )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): whether the label field is resolved as a path. If True, each item's "label"
+            must be a string or a list of strings and is resolved against ``base_dir``. If False, the label
+            is returned exactly as stored, so classification labels such as integer class ids are kept.
+            Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+            When it equals "test", each entry is a plain path string and is converted to an item
+            with only the "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order, with the input field names. "image" (and "label" when
+        ``is_segmentation`` is True) hold resolved paths: a string, or a list of the same length and order
+        as the input list. All other fields are kept unchanged. For example::
+
+            [{"image": "/data/img0.nii", "label": "/data/seg0.nii", "extra": "kept"}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, cannot be parsed as JSON, lacks ``data_list_key``,
+            or contains an invalid item or field value.
+
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file {data_list_file_path}")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in datalist file {data_list_file_path}")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Each datalist item must be a mapping in datalist file {data_list_file_path}, "
+                f"got {type(item).__name__}: {item!r}"
+            )
+        item = dict(item)
+        if "image" in item:
+            _resolve_field(item, "image", base_dir, data_list_file_path)
+        if is_segmentation and "label" in item:
+            _resolve_field(item, "label", base_dir, data_list_file_path)
+        result.append(item)
+    return result
