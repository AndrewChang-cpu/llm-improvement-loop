+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _make_dir(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, True)
+        return tmp
+
+    def test_seg_values(self):
+        tmp = self._make_dir()
+        content = {
+            "training": [
+                {"image": "./imgs//img0.nii", "label": "segs/../seg0.nii", "extra": "kept"},
+            ]
+        }
+        path = _write_datalist(tmp, content)
+
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "imgs", "img0.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp, "seg0.nii")))
+        self.assertEqual(result[0]["extra"], "kept")
+
+    def test_cls_values(self):
+        tmp = self._make_dir()
+        content = {
+            "training": [
+                {"image": "img0.nii", "label": 3},
+                {"image": "img1.nii", "label": 0},
+            ]
+        }
+        path = _write_datalist(tmp, content)
+
+        result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+        self.assertEqual(result[0]["label"], 3)
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp, "img1.nii")))
+        self.assertEqual(result[1]["label"], 0)
+        self.assertIsInstance(result[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp = self._make_dir()
+        image_name = os.path.join(tmp, "img.nii")
+        label_name = os.path.join(tmp, "seg.nii")
+        content = {"training": [{"image": image_name, "label": label_name}]}
+        path = _write_datalist(tmp, content)
+
+        result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(image_name))
+        self.assertEqual(result[0]["label"], os.path.normpath(label_name))
+        self.assertTrue(os.path.isabs(result[0]["image"]))
+        self.assertTrue(os.path.isabs(result[0]["label"]))
+
+    def test_seg_no_labels(self):
+        tmp = self._make_dir()
+        content = {
+            "test": [
+                "t0.nii",
+                "t1.nii",
+            ]
+        }
+        path = _write_datalist(tmp, content)
+
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp, "t0.nii")))
+
+
+if __name__ == "__main__":
+    unittest.main()
