+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """
+    Join a single path string with ``base_dir`` and normalize the result.
+    An absolute ``path`` is returned as its normalized form, unchanged by ``base_dir``.
+    """
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_field(value: Any, base_dir: str, field: str, key: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value that is either a string or a list of strings.
+    Lists are resolved element by element; their length and order are preserved.
+    """
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in '{key}' of {data_list_file_path} "
+                    "must be a string."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(
+        f"Field '{field}' value {value!r} in '{key}' of {data_list_file_path} "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is treated as a path
+            (string or list of strings) and resolved. If False, the "label" field is left exactly
+            as stored, so classification labels such as integer class ids are kept as they are.
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON object that holds the list of entries.
+            Defaults to "training". If it is "test", each entry is a plain path string that is
+            converted to an item with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None,
+            which uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, in the same order as the input entries. Each dict keeps the input field
+        names. The "image" field, and the "label" field in segmentation mode, hold normalized paths
+        as a string or as a list of strings of the same length and order as the input. All other
+        fields are preserved unchanged. For example::
+
+            [{"image": "/data/imgs/case0.nii.gz", "label": "/data/lbls/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a
+            mapping, or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' in {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in '{data_list_key}' of {data_list_file_path} must be a mapping.")
+
+        new_item = dict(item)
+        if "image" in item:
+            new_item["image"] = _resolve_field(item["image"], base_dir, "image", data_list_key, data_list_file_path)
+        if is_segmentation and "label" in item:
+            new_item["label"] = _resolve_field(item["label"], base_dir, "label", data_list_key, data_list_file_path)
+        items.append(new_item)
+
+    return items
