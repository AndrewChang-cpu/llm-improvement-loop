+
+import json
+import os
+
+
+def _resolve_single_path(path, base_dir, file_path, field):
+    """Join a single string path with ``base_dir`` and normalize the result."""
+    if not isinstance(path, str):
+        raise ValueError(f"Field '{field}' in item of '{file_path}' must be a string, got {type(path).__name__}.")
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_path_value(value, base_dir, file_path, field):
+    """Resolve a string or a list of strings, each element resolved independently."""
+    if isinstance(value, str):
+        return _resolve_single_path(value, base_dir, file_path, field)
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of list field '{field}' in '{file_path}' must be a string, "
+                    f"got {type(element).__name__}."
+                )
+            resolved.append(_resolve_single_path(element, base_dir, file_path, field))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in '{file_path}' must be a string or a list of strings, got {type(value).__name__}."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """Load a Medical Segmentation Decathlon style datalist and resolve its image and label paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path (string or list
+            of strings). If False, the "label" field is left exactly as stored, for example an integer class id.
+            Defaults to True.
+        data_list_key (str): top-level key of the datalist holding the entries. Defaults to "training".
+            When it equals "test", each entry is a plain path string and is converted to an item with only
+            an "image" field.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, in the order of the datalist entries. Each dictionary keeps the field names of
+        the input. "image" holds a resolved path, and in segmentation mode "label" holds a resolved path too.
+        A path is a string, or a list of strings of the same length and order as the input list. Other fields
+        are copied unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "/data/imagesTr/case_0.nii.gz"
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(f"Each item under key '{data_list_key}' in '{data_list_file_path}' must be a mapping.")
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path_value(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path_value(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+
+    return items
