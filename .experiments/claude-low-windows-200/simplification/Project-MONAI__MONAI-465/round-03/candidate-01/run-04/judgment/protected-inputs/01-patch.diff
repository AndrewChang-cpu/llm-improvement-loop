+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _is_str_list(value: Any) -> bool:
+    """Return True if ``value`` is a list whose elements are all strings."""
+    return isinstance(value, list) and all(isinstance(v, str) for v in value)
+
+
+def _resolve_field(item: Dict[str, Any], field: str, base_dir: str, data_list_file_path: str) -> None:
+    """Resolve the path value stored under ``field`` in ``item`` in place.
+
+    The value must be a string or a list of strings. A list is resolved element by element,
+    preserving length and order. Missing fields are left untouched.
+    """
+    if field not in item:
+        return
+    value = item[field]
+    if isinstance(value, str):
+        item[field] = _resolve_path(value, base_dir)
+    elif _is_str_list(value):
+        item[field] = [_resolve_path(v, base_dir) for v in value]
+    else:
+        raise ValueError(
+            f"'{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, "
+            f"got {type(value).__name__}: {value!r}"
+        )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file. Must exist.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path
+            (string or list of strings). If False, "label" is returned exactly as stored, so it
+            may be any JSON value such as an integer class id. Defaults to True.
+        data_list_key (str): top-level key in the datalist holding the entries. Defaults to "training".
+            When it is "test", each entry is a plain path string and is converted into an item
+            with only an "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None,
+            which uses the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the fields of its
+        entry; "image" (and "label" in segmentation mode) hold resolved paths, either as a string
+        or as a list of the same length and order as the input. Other fields are unchanged.
+        For example::
+
+            [{"image": "/data/img0.nii", "label": ["/data/lbl0.nii", "/data/lbl0b.nii"], "fold": 0}]
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``,
+            or contains an item or path value of the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        items: List[Any] = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each entry under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {type(item).__name__}: {item!r}"
+            )
+        item = dict(item)
+        _resolve_field(item, "image", base_dir, data_list_file_path)
+        if is_segmentation:
+            _resolve_field(item, "label", base_dir, data_list_file_path)
+        result.append(item)
+    return result
