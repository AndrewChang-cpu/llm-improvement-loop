+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "imgs/img0.nii", "label": "lbls/lbl0.nii", "fold": 0},
+                    {"image": "./imgs//img1.nii", "label": "lbls/lbl1.nii", "fold": 1},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(datalist_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(out), 2)
+            self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img0.nii")))
+            self.assertEqual(out[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbls/lbl0.nii")))
+            self.assertEqual(out[0]["fold"], 0)
+            self.assertEqual(out[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/img1.nii")))
+            self.assertEqual(out[1]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "training": [
+                    {"image": "img0.nii", "label": 1},
+                    {"image": "img1.nii", "label": 0},
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(datalist_path, False, "training", tmp_dir)
+
+            self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+            self.assertEqual(out[0]["label"], 1)
+            self.assertIsInstance(out[0]["label"], int)
+            self.assertEqual(out[1]["image"], os.path.normpath(os.path.join(tmp_dir, "img1.nii")))
+            self.assertEqual(out[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            img_path = os.path.join(tmp_dir, "img0.nii")
+            lbl_path = os.path.join(tmp_dir, "lbl0.nii")
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {"training": [{"image": img_path, "label": lbl_path}]}
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(out[0]["image"], os.path.normpath(img_path))
+            self.assertEqual(out[0]["label"], os.path.normpath(lbl_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "datalist.json")
+            datalist = {
+                "test": [
+                    "test0.nii",
+                    "test1.nii",
+                ]
+            }
+            with open(datalist_path, "w") as f:
+                json.dump(datalist, f)
+
+            out = load_decathalon_datalist(datalist_path, True, "test", tmp_dir)
+
+            self.assertEqual(out[0]["image"], os.path.normpath(os.path.join(tmp_dir, "test0.nii")))
+            self.assertNotIn("label", out[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
