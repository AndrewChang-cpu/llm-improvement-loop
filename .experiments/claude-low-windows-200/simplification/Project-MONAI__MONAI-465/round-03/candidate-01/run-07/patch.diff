+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """Resolve a single string path against ``base_dir``, or each string of a list of paths."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"Field '{field}' list element {element!r} in {data_list_file_path} must be a string.")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"Field '{field}' value {value!r} in {data_list_file_path} must be a string or a list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" value is kept exactly as stored (for example an integer class id) and is not type-checked.
+            Defaults to True.
+        data_list_key (str): top-level key in the JSON object holding the list of entries. Defaults to "training".
+            If it equals "test", each entry is a plain path string and is converted to an item with only the
+            "image" field.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the directory
+            portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts in the original order of the datalist. Each dict keeps all fields of its entry. The
+        "image" field is always resolved, and the "label" field is resolved when ``is_segmentation`` is True.
+        A resolved value is a normalized path string, or a list of normalized path strings with the same length
+        and order as the input list. Example::
+
+            [{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or a path
+            value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(f"Item {item!r} in datalist file {data_list_file_path} must be a mapping.")
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, "label", data_list_file_path)
+        result.append(out)
+
+    return result
