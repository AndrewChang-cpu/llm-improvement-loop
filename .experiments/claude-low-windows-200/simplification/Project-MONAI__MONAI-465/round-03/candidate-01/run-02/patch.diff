+
+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single string path with base_dir and normalize the result. Absolute paths stay absolute."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_field(value: Any, base_dir: str, field: str, file_path: str) -> Union[str, List[str]]:
+    """Resolve a "image" or "label" value that is a string or a list of strings."""
+    if isinstance(value, str):
+        return _resolve_path(value, base_dir)
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element must be a string in datalist file {file_path}, got {element!r}."
+                )
+        return [_resolve_path(element, base_dir) for element in value]
+    raise ValueError(
+        f"Field '{field}' must be a string or a list of strings in datalist file {file_path}, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path. If False, the
+            "label" field is kept exactly as stored, so classification labels such as integer class ids are allowed.
+        data_list_key (str): key under which the list of entries is stored. Defaults to "training". When it is
+            "test", each entry is a plain path string and is converted to an item containing only "image".
+        base_dir (Optional[str]): directory that relative paths are resolved against. Defaults to None, which uses
+            the directory portion of data_list_file_path.
+
+    Returns:
+        A list of dicts with the same field names as the input entries, in the original order. The "image" field,
+        and the "label" field in segmentation mode, hold resolved paths. Each is a string, or a list of strings
+        with the same length and order as the input. Other fields are copied unchanged. For example::
+
+            [{"image": "/data/imgs/case0.nii", "label": "/data/lbls/case0.nii", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or the
+            "image" or "label" value has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}.")
+
+    with open(data_list_file_path) as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Data list key '{data_list_key}' is missing in datalist file {data_list_file_path}.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Data list key '{data_list_key}' must hold a list in datalist file {data_list_file_path}.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item must be a mapping in datalist file {data_list_file_path}, got {item!r}.")
+        resolved = dict(item)
+        if "image" in resolved:
+            resolved["image"] = _resolve_field(resolved["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in resolved:
+            resolved["label"] = _resolve_field(resolved["label"], base_dir, "label", data_list_file_path)
+        items.append(resolved)
+    return items
