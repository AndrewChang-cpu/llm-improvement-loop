+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_datalist(directory, content):
+    path = os.path.join(directory, "datalist.json")
+    with open(path, "w") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": "lbls/./case0.nii", "fold": 0},
+                ]
+            }
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tempdir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imgs/case0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "lbls/case0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {"training": [{"image": "img0.nii", "label": 1}, {"image": "img1.nii", "label": 3}]}
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tempdir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "img0.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tempdir, "img1.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 1)
+            self.assertEqual(result[1]["label"], 3)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tempdir, "image.nii")
+            label = os.path.join(tempdir, "label.nii")
+            content = {"training": [{"image": image, "label": label}]}
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+            self.assertEqual(result[0]["image"], os.path.normpath(image))
+            self.assertEqual(result[0]["label"], os.path.normpath(label))
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            content = {
+                "test": [
+                    "case0.nii",
+                    "case1.nii",
+                ]
+            }
+            path = _write_datalist(tempdir, content)
+            result = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=tempdir)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "case0.nii")))
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
