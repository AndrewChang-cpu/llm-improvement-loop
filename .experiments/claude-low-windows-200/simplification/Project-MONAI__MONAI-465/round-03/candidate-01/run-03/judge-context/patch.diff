+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": "imagesTr/case0.nii",
+                        "label": "labelsTr/case0.nii",
+                        "fold": 0,
+                    },
+                ],
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/case0.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": "img/a.nii", "label": 3},
+                    {"image": ["img/b0.nii", "img/b1.nii"], "label": 1},
+                ],
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, False, "training", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img/a.nii")))
+            self.assertEqual(items[0]["label"], 3)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(
+                items[1]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "img/b0.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "img/b1.nii")),
+                ],
+            )
+            self.assertEqual(items[1]["label"], 1)
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "case0_image.nii")
+            abs_label = os.path.join(tmp_dir, "case0_label.nii")
+            datalist = {
+                "training": [
+                    {"image": abs_image, "label": abs_label},
+                ],
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "test": [
+                    "imagesTs/case0.nii",
+                    "imagesTs/case1.nii",
+                ],
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "test", tmp_dir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTs/case0.nii")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
