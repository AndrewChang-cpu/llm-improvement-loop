+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, name: str, file_path: str) -> Any:
+    """Resolve a single path string, or each string in a list of path strings, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{name}' list entries must be strings in datalist file {file_path}, "
+                    f"found {type(element).__name__}: {element!r}"
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"'{name}' must be a string or a list of strings in datalist file {file_path}, "
+        f"found {type(value).__name__}: {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path
+            and must be a string or a list of strings. If False, "label" is kept exactly as stored,
+            for example an integer class id, and is not type-checked. Defaults to True.
+        data_list_key (str): top-level key under which the list of entries is stored.
+            Defaults to "training". When the key is "test", each entry is a plain path string and
+            is converted to an item holding only the "image" field.
+        base_dir (str): directory that relative paths are resolved against. Defaults to None,
+            meaning the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps every field of its entry.
+        The "image" field, and the "label" field in segmentation mode, hold resolved paths: either a
+        normalized string, or a list of normalized strings with the same length and order as the input.
+        Other fields are unchanged. For example::
+
+            [{"image": "/data/imagesTr/case0.nii", "label": "/data/labelsTr/case0.nii", "fold": 0}]
+
+    Raises:
+        ValueError: if the datalist file does not exist, if ``data_list_key`` is missing from the
+            JSON object, or if an item or a path value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        datalist = json.load(f)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"data_list_key '{data_list_key}' not found in datalist file {data_list_file_path}")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"data_list_key '{data_list_key}' must hold a list in datalist file {data_list_file_path}, "
+            f"found {type(entries).__name__}"
+        )
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"each datalist item must be a mapping in datalist file {data_list_file_path}, "
+                f"found {type(entry).__name__}: {entry!r}"
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(item)
+
+    return items
