+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(path: str, base_dir: str) -> str:
+    """Join a single path string with ``base_dir`` and normalize the result."""
+    return os.path.normpath(os.path.join(base_dir, path))
+
+
+def _resolve_field(item: Dict[str, Any], field: str, base_dir: str, data_list_file_path: str) -> None:
+    """Resolve ``item[field]`` in place, which must be a string or a list of strings."""
+    value = item[field]
+    if isinstance(value, str):
+        item[field] = _resolve_path(value, base_dir)
+    elif isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list elements must be strings in datalist file {data_list_file_path}, "
+                    f"got {element!r}."
+                )
+        item[field] = [_resolve_path(element, base_dir) for element in value]
+    else:
+        raise ValueError(
+            f"Field '{field}' must be a string or a list of strings in datalist file {data_list_file_path}, "
+            f"got {value!r}."
+        )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its image and label paths.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file.
+        is_segmentation (bool): if True, the "label" field of each item is resolved as a path (string or list of
+            strings). If False, "label" is left exactly as stored, so it may be any JSON value such as an integer
+            class id. Default is True.
+        data_list_key (str): top-level key in the JSON object holding the list of entries. If it is "test", each
+            entry is a plain path string and is converted to an item with only an "image" field. Default is "training".
+        base_dir (str): directory that relative paths are resolved against. If None, the directory portion of
+            ``data_list_file_path`` is used. Default is None.
+
+    Returns:
+        A list of dicts, in the same order as the datalist entries. Each dict keeps the fields of its entry. The
+        "image" field, and the "label" field in segmentation mode, hold resolved paths: a normalized string, or a
+        list of normalized strings of the same length and order as the input list. Other fields are unchanged.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] -> "/data/imagesTr/case_0.nii.gz"
+        # items[0]["label"] -> "/data/labelsTr/case_0.nii.gz"
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an item is not a mapping, or an
+            image or label value has the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file {data_list_file_path}.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' must hold a list in datalist file {data_list_file_path}.")
+
+    if data_list_key == "test":
+        items: List[Any] = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    output: List[Dict[str, Any]] = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each entry must be a mapping in datalist file {data_list_file_path}, got {item!r}.")
+        new_item = dict(item)
+        if "image" in new_item:
+            _resolve_field(new_item, "image", base_dir, data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            _resolve_field(new_item, "label", base_dir, data_list_file_path)
+        output.append(new_item)
+
+    return output
