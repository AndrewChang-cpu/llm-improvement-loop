+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def _make_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, ignore_errors=True)
+        return tmp_dir
+
+    def _write_json(self, directory, data):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(data, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = self._make_dir()
+        data = {
+            "training": [
+                {
+                    "image": "imagesTr/case_0.nii.gz",
+                    "label": "labelsTr/case_0.nii.gz",
+                    "patient": "p0",
+                },
+            ],
+        }
+        path = self._write_json(tmp_dir, data)
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp_dir)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["patient"], "p0")
+
+    def test_cls_values(self):
+        tmp_dir = self._make_dir()
+        data = {
+            "training": [
+                {"image": "imagesTr/case_0.nii.gz", "label": 1},
+                {"image": "imagesTr/case_1.nii.gz", "label": 0},
+            ],
+        }
+        path = self._write_json(tmp_dir, data)
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/case_0.nii.gz")))
+        self.assertEqual(items[0]["label"], 1)
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/case_1.nii.gz")))
+        self.assertEqual(items[1]["label"], 0)
+        self.assertIsInstance(items[1]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_dir()
+        image_path = os.path.join(tmp_dir, "case_0_image.nii.gz")
+        label_path = os.path.join(tmp_dir, "case_0_label.nii.gz")
+        data = {"training": [{"image": image_path, "label": label_path}]}
+        path = self._write_json(tmp_dir, data)
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+        self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        self.assertTrue(os.path.isabs(items[0]["image"]))
+        self.assertTrue(os.path.isabs(items[0]["label"]))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_dir()
+        data = {
+            "test": [
+                "imagesTs/case_0.nii.gz",
+                "imagesTs/case_1.nii.gz",
+            ],
+        }
+        path = self._write_json(tmp_dir, data)
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="test", base_dir=tmp_dir)
+
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTs/case_0.nii.gz")))
+        self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
