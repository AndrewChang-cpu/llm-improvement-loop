+import json
+import os
+from collections.abc import Mapping
+from typing import Any, List, Optional, Union
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Union[str, List[str]]:
+    """Resolve a single path string, or each string in a list of paths, against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"List elements of '{field}' in data list file '{data_list_file_path}' must be strings, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in data list file '{data_list_file_path}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Any]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a JSON object holding a list under ``data_list_key``. Each entry of that list must be
+    a JSON object. Its "image" value is resolved, and its "label" value is also resolved when ``is_segmentation``
+    is True; in classification mode the "label" value is kept unchanged and may be any JSON value, such as an
+    integer class id. Other fields are kept verbatim. Relative paths are joined with ``base_dir`` and normalized;
+    absolute paths are kept absolute. A value may be a string or a list of strings, and each list element is
+    resolved independently. If ``data_list_key`` is "test", each entry is a plain path string holding the image,
+    and the returned items contain only the resolved "image" field.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the entries are segmentation entries. Defaults to True. When True, the
+            "label" field is resolved as a path; when False, it is left unchanged.
+        data_list_key (str): top-level key in the JSON file whose value is the list of entries. Defaults to
+            "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory portion
+            of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, in the original order of the datalist. Each dictionary has the same field names as
+        its input entry, with "image" (and "label" in segmentation mode) resolved to path strings or lists of path
+        strings.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks the top-level object or ``data_list_key``,
+            or contains an entry or path value of the wrong type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Data list file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, Mapping):
+        raise ValueError(f"Data list file '{data_list_file_path}' must contain a JSON object at the top level.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in data list file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Entries under key '{data_list_key}' in data list file '{data_list_file_path}' must be objects, "
+                f"got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
