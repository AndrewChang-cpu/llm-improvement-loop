+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list "
+                    f"of strings, found list element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, "
+        f"found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key`` whose value is a list of entries. When
+    ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as an item with only an
+    ``"image"`` field. Every other entry must be a JSON object.
+
+    In segmentation mode (``is_segmentation=True``), both ``"image"`` and ``"label"`` are resolved; each must be
+    a string or a list of strings. In classification mode (``is_segmentation=False``), only ``"image"`` is
+    resolved and ``"label"`` is returned unchanged, so it may be any JSON value such as an integer class id.
+    Fields that are not resolved are kept verbatim. Fields that are absent are not required and are skipped.
+
+    Path resolution joins each path with ``base_dir`` and normalizes the result. Absolute paths stay absolute.
+    A list of paths is resolved element by element.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve ``"label"`` as a path. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. Defaults to None, which uses
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dictionaries, one per entry, in the original order. Each dictionary keeps the input field names,
+        with resolved ``"image"`` and, in segmentation mode, resolved ``"label"`` values.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an ``"image"``
+            value (or a ``"label"`` value in segmentation mode) is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        datalist = json.load(file)
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not contain the key '{data_list_key}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+
+    return result
