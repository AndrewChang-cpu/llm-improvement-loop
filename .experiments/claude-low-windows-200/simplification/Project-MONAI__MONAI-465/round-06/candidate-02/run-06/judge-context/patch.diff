+import json
+import os
+
+
+def _resolve_decathalon_path(value, base_dir, data_list_file_path, data_list_key):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Strings are joined with ``base_dir`` and normalized; absolute strings are kept absolute.
+    Lists must contain only strings, and each element is resolved independently.
+
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list elements of key '{data_list_key}' in file '{data_list_file_path}' "
+                    f"must be strings, got {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"value of key '{data_list_key}' in file '{data_list_file_path}' must be a string "
+        f"or a list of strings, got {value!r}"
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The datalist must be a JSON object containing ``data_list_key``, whose value is a list of entries.
+    If ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as an item
+    with only an ``"image"`` field. Every other entry must be a JSON object. Its ``"image"`` value is
+    resolved as a string or a list of strings. In segmentation mode (``is_segmentation=True``), its
+    ``"label"`` value is resolved the same way; in classification mode the label is left unchanged and
+    may be any JSON value, such as an integer class id. Other fields are kept verbatim. Items that lack
+    ``"image"`` or ``"label"`` are not rejected.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each item as a path (string or
+            list of strings). If False, leave ``"label"`` unchanged. Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        list: the processed items, in the same order as the input entries. Each item is a dict with the
+        same field names as the input, where ``"image"`` (and ``"label"`` in segmentation mode) holds the
+        resolved path string or list of path strings.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path
+            value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file '{data_list_file_path}'")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"item in key '{data_list_key}' of datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {item!r}"
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(
+                processed["image"], base_dir, data_list_file_path, data_list_key
+            )
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(
+                processed["label"], base_dir, data_list_file_path, data_list_key
+            )
+        result.append(processed)
+    return result
