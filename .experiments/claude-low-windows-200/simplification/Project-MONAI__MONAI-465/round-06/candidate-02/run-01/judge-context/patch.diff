+import json
+import os
+from collections.abc import Mapping
+
+
+def _resolve_path(value, base_dir, field, data_list_file_path):
+    """Resolve a single path value or a list of path values against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list in {data_list_file_path} must contain only strings, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in {data_list_file_path} must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    The datalist file is parsed as JSON and the list stored under ``data_list_key`` is read.
+    Each entry must be a mapping. Its "image" value is resolved against ``base_dir``, and
+    its "label" value is resolved only when ``is_segmentation`` is True; other fields are kept
+    unchanged. If ``data_list_key`` is "test", each entry is a plain path string and is
+    wrapped as ``{"image": entry}`` before validation.
+
+    Args:
+        data_list_file_path (str): path to the JSON datalist file; must name an existing file.
+        is_segmentation (bool): when True, "label" values must be a string or list of strings and are
+            resolved as paths. When False, "label" is not checked or resolved and may be any JSON value,
+            such as an integer class id. Defaults to True.
+        data_list_key (str): key in the top-level JSON object whose value is the list of entries.
+            Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning the
+            directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        A list of dicts, in the original order of the datalist. Each dict has the input field names,
+        with "image" resolved and, in segmentation mode, "label" resolved. Resolved values are normalized
+        path strings, or lists of them when the input was a list.
+
+    Raises:
+        ValueError: if the datalist file does not exist, the key is missing, an entry is not a mapping,
+            or a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Each entry under '{data_list_key}' in '{data_list_file_path}' must be an object, got {item!r}."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
