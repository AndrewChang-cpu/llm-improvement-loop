+import json
+import os
+
+
+def _resolve_path(value, base_dir, data_list_file_path, field_name):
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    A string is joined with ``base_dir`` and normalized; an absolute string stays absolute.
+    A list must contain only strings, and each element is resolved independently.
+
+    Args:
+        value (str or list of str): the path value to resolve.
+        base_dir (str): directory used as the base for relative paths.
+        data_list_file_path (str): datalist file, used in error messages.
+        field_name (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        str or list of str: the resolved path(s), in the same shape as ``value``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field_name}' list in {data_list_file_path} must contain only strings, got {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"'{field_name}' in {data_list_file_path} must be a string or list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key`` whose value is a list of entries.
+    If ``data_list_key`` is "test", each entry is a plain path string and is wrapped as an
+    item with only an "image" field. Every other entry must be a mapping. Its "image" value
+    (a string or list of strings) is resolved against ``base_dir``. In segmentation mode
+    (``is_segmentation=True``) its "label" value (a string or list of strings) is resolved too;
+    in classification mode the "label" value is left unchanged and may be any JSON value,
+    such as an integer class id. Other fields are kept verbatim.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, "label" values are resolved as paths and type-checked
+            as strings or lists of strings. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning
+            the directory portion of ``data_list_file_path``.
+
+    Returns:
+        list: the processed items, in original order. Each item is a dict with the input field
+        names, where "image" (and "label" in segmentation mode) hold resolved path strings or
+        lists of path strings.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``,
+            or contains an item or path value of an unexpected type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing in datalist file {data_list_file_path}")
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file {data_list_file_path} must hold a list")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(f"each item in datalist file {data_list_file_path} must be a mapping, got {item!r}")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        result.append(processed)
+    return result
