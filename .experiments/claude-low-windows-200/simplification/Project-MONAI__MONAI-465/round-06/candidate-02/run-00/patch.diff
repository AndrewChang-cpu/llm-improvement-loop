+import json
+import os
+from collections.abc import Mapping
+
+
+def _resolve_path(value, base_dir, file_path, key, field):
+    """Resolve a single path value or a list of path values against ``base_dir``."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list elements of '{field}' in key '{key}' of file '{file_path}' must be strings, "
+                    f"got {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in key '{key}' of file '{file_path}' must be a string or list of strings, got {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path,
+    is_segmentation=True,
+    data_list_key="training",
+    base_dir=None,
+):
+    """Load a Medical Segmentation Decathlon style datalist and resolve its paths.
+
+    The datalist file is parsed as JSON and the list stored under ``data_list_key`` is returned as a list of
+    items, in the original order. Each non-"test" entry is a mapping whose "image" field is resolved, and whose
+    "label" field is resolved only when ``is_segmentation`` is True. Other fields are kept verbatim. Entries under
+    the "test" key are plain path strings, which are wrapped as ``{"image": path}`` before resolution.
+
+    A path value is either a string or a list of strings. Strings are joined with ``base_dir`` and normalized;
+    absolute strings stay absolute. Each element of a list is resolved independently.
+
+    In classification mode (``is_segmentation=False``) the "label" field is not resolved or type-checked, so it may
+    hold any JSON value, such as an integer class id.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve "label" fields as paths (segmentation) or leave them unchanged
+            (classification). Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``, without making it absolute.
+
+    Returns:
+        list of dict: the processed items in original order, each a dict with the input field names, with the
+        resolved "image" and, in segmentation mode, "label" fields.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, contains a non-mapping
+            item, or has an "image" or segmentation "label" value that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file '{data_list_file_path}' does not exist")
+
+    try:
+        with open(data_list_file_path, "r") as f:
+            json_data = json.load(f)
+    except ValueError as e:
+        raise ValueError(f"data list file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"data list key '{data_list_key}' not found in file '{data_list_file_path}'")
+
+    data = json_data[data_list_key]
+    if not isinstance(data, list):
+        raise ValueError(f"value of key '{data_list_key}' in file '{data_list_file_path}' must be a list")
+
+    if data_list_key == "test":
+        data = [{"image": entry} for entry in data]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result = []
+    for item in data:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"item {item!r} under key '{data_list_key}' in file '{data_list_file_path}' must be a mapping"
+            )
+        processed = dict(item)
+        fields = ["image", "label"] if is_segmentation else ["image"]
+        for field in fields:
+            if field in processed:
+                processed[field] = _resolve_path(processed[field], base_dir, data_list_file_path, data_list_key, field)
+        result.append(processed)
+    return result
