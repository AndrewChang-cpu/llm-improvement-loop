+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as file:
+            json.dump(content, file)
+        return path
+
+    def test_seg_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {
+                    "training": [
+                        {"image": "imagesTr/case0.nii.gz", "label": "labelsTr/case0.nii.gz", "fold": 1},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(path, True, "training", tempdir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTr/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tempdir, "labelsTr/case0.nii.gz")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_cls_values(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {"training": [{"image": "images/case0.nii.gz", "label": 3}]},
+            )
+            result = load_decathalon_datalist(path, False, "training", tempdir)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "images/case0.nii.gz")))
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[0]["label"], int)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_basedir(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            image = os.path.join(tempdir, "case0_image.nii.gz")
+            label = os.path.join(tempdir, "case0_label.nii.gz")
+            path = self._write_datalist(
+                tempdir,
+                {"training": [{"image": image, "label": label}]},
+            )
+            result = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], image)
+            self.assertEqual(result[0]["label"], label)
+        finally:
+            shutil.rmtree(tempdir)
+
+    def test_seg_no_labels(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tempdir,
+                {"test": ["imagesTs/case0.nii.gz", "imagesTs/case1.nii.gz"]},
+            )
+            result = load_decathalon_datalist(path, True, "test", tempdir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tempdir, "imagesTs/case0.nii.gz")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tempdir)
+
+
+if __name__ == "__main__":
+    unittest.main()
