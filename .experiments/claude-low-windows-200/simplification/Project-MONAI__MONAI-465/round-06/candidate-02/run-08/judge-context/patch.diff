+
+import json
+import os
+
+
+def _resolve_path(value, base_dir, field, file_path):
+    """Resolve a single path value or a list of path values against `base_dir`."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' list element {element!r} in datalist file '{file_path}' is not a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' value {value!r} in datalist file '{file_path}' must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must contain a JSON object holding the list of entries under `data_list_key`. For every entry
+    that is a mapping, the "image" field is resolved against `base_dir`. When `is_segmentation` is True, the
+    "label" field is resolved in the same way; when it is False, "label" is left unchanged and may hold any
+    JSON value, such as an integer class id. All other fields are kept verbatim. If `data_list_key` is "test",
+    each entry is a plain path string and is wrapped as an item whose only field is "image".
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve "label" fields as paths. Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning the directory
+            portion of `data_list_file_path`.
+
+    Returns:
+        list: the processed items, in the original order. Each item is a dict with the same field names as the
+        input entry, where "image" (and "label" in segmentation mode) hold the resolved path string or list of
+        path strings.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if `data_list_key` is missing, or if an
+            entry or a path value has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as file:
+        try:
+            datalist = json.load(file)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(datalist, dict) or data_list_key not in datalist:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = datalist[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        item = dict(item)
+        if "image" in item:
+            item["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        processed.append(item)
+    return processed
