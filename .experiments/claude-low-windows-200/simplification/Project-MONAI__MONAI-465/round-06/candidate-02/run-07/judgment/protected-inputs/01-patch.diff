+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_path_value(value: Any, base_dir: str, data_list_file_path: str, key: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value (a string or a list of strings) against `base_dir`.
+    Raises ValueError if the value is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"list elements of '{key}' in datalist '{data_list_file_path}' must be strings, got {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{key}' in datalist '{data_list_file_path}' must be a string or a list of strings, got {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and return its entries with resolved paths.
+
+    The top-level JSON object must contain `data_list_key`, whose value is a list of entries. When
+    `data_list_key` is "test", each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Each entry must be a mapping. Its "image" value is resolved, and in segmentation mode its "label" value
+    is resolved too. A string path is joined with `base_dir` and normalized, while an absolute path is kept
+    absolute. A list of paths is resolved element by element. Other fields are kept unchanged. In
+    classification mode, "label" is not resolved and may hold any JSON value, such as an integer class id.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the entries are segmentation items. If True, "label" values are
+            resolved as paths and must be strings or lists of strings. If False, "label" is left unchanged.
+            Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which means the
+            directory portion of `data_list_file_path`.
+
+    Returns:
+        List[Dict[str, Any]]: the processed items, in their original order. Each item is a dict with the same
+        field names as the input entry, where "image" (and "label" in segmentation mode) holds the resolved
+        path string or list of path strings.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if `data_list_key` is missing, if an entry
+            is not a mapping, or if a path value has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist")
+
+    with open(data_list_file_path, "r") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"datalist file '{data_list_file_path}' does not contain key '{data_list_key}'")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for entry in entries:
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"entries under key '{data_list_key}' in datalist file '{data_list_file_path}' must be mappings, "
+                f"got {entry!r}"
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path_value(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path_value(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+
+    return items
