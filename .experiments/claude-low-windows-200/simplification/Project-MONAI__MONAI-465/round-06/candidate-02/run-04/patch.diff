+import json
+import os
+from typing import Dict, List, Optional
+
+
+def _resolve_path(value, base_dir: str, field: str, data_list_file_path: str):
+    """
+    Resolve a path value, or a list of path values, against ``base_dir``.
+
+    Strings are joined with ``base_dir`` and normalized; absolute strings stay absolute.
+    Lists are resolved element by element and must contain only strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"elements of '{field}' must be strings in data list file '{data_list_file_path}', "
+                    f"got {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' must be a string or list of strings in data list file '{data_list_file_path}', got {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict]:
+    """
+    Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The file must be a JSON object whose ``data_list_key`` entry is a list of items. Each item must be a
+    mapping. Its ``"image"`` value is resolved, and in segmentation mode its ``"label"`` value is resolved
+    too; in classification mode the label is left unchanged and may be any JSON value, such as an integer
+    class id. A ``"label"`` or ``"image"`` field that is absent is simply skipped. Other fields are kept
+    verbatim. When ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as an
+    item whose only field is ``"image"``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve ``"label"`` values as paths, default True. If False,
+            labels are returned unchanged.
+        data_list_key (str): key in the JSON object whose value is the list of entries, default "training".
+        base_dir (str, optional): directory that relative paths are joined with. Defaults to None, which
+            uses the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        A list of dicts in the original order. Each dict has the same field names as its input item, with
+        ``"image"`` (and ``"label"`` in segmentation mode) resolved to a string path or a list of string paths.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if ``data_list_key`` is missing, if an
+            item is not a mapping, or if a path value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file '{data_list_file_path}' does not exist")
+
+    with open(data_list_file_path, "r") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"data list file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in data list file '{data_list_file_path}'")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value of key '{data_list_key}' in data list file '{data_list_file_path}' must be a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"each item under key '{data_list_key}' in data list file '{data_list_file_path}' "
+                f"must be a mapping, got {item!r}"
+            )
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+    return items
