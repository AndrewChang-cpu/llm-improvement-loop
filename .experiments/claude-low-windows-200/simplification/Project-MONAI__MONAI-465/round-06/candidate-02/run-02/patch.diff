+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """Resolve a path value (string or list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): a string path or a list of string paths.
+        base_dir (str): directory the relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file, used in error messages.
+
+    Returns:
+        (str or list of str): the normalized path(s), absolute paths are kept absolute.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"field '{field}' in datalist '{data_list_file_path}' must contain only strings, "
+                    f"got {element!r}"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"field '{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, got {value!r}"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """Load a Medical Segmentation Decathlon style datalist JSON file and resolve its paths.
+
+    The entries stored under ``data_list_key`` are returned in their original order. Each entry must be a mapping
+    whose "image" value is a string or a list of strings. In segmentation mode (``is_segmentation=True``) the "label"
+    value must also be a string or a list of strings and is resolved the same way. In classification mode the
+    "label" value is returned unchanged, so it may be any JSON value such as an integer class id. Any other fields
+    are kept verbatim. If ``data_list_key`` is "test", each entry is a plain path string and is wrapped as an item
+    whose only field is "image", regardless of ``is_segmentation``.
+
+    Paths are resolved by joining them with ``base_dir`` and normalizing the result. Absolute paths are kept absolute.
+    Missing fields are not checked and are left out of the output.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the "label" field holds segmentation paths to resolve. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        (list of dict): the processed items in original order. Each item is a dict with the same field names as the
+        input, with resolved "image" and, in segmentation mode, resolved "label".
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value has an
+            invalid type. The message names the offending file, key or value.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist")
+
+    with open(data_list_file_path, "r") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing in datalist '{data_list_file_path}'")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist '{data_list_file_path}' must hold a list of entries")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"entry in key '{data_list_key}' of datalist '{data_list_file_path}' must be a mapping, got {item!r}"
+            )
+        out = dict(item)
+        if "image" in out:
+            out["image"] = _resolve_path(out["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in out:
+            out["label"] = _resolve_path(out["label"], base_dir, "label", data_list_file_path)
+        processed.append(out)
+    return processed
