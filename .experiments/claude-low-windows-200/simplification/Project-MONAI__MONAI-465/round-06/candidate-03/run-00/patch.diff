+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, data_list_file_path: str, data_list_key: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        data_list_file_path (str): datalist file, used in error messages.
+        data_list_key (str): key holding the entry, used in error messages.
+
+    Returns:
+        A normalized path string, or a list of normalized path strings in the same order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{data_list_key}' in datalist file '{data_list_file_path}' "
+                    "must be a string"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Value {value!r} of '{data_list_key}' in datalist file '{data_list_file_path}' "
+        "must be a string or a list of strings"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key`` whose value is a list of entries. For the
+    key ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+
+    Every item must be a mapping. ``"image"`` is resolved when present. ``"label"`` is resolved only when
+    ``is_segmentation`` is True; otherwise it is kept exactly as stored, so classification labels may be any
+    JSON value such as an integer class id. All other fields are kept verbatim. Paths are resolved by joining
+    them with ``base_dir`` and normalizing; absolute paths stay absolute. A list of paths is resolved element
+    by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path (or list of paths).
+            Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory
+            portion of ``data_list_file_path``.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the input field names.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an image or
+            segmentation label value is not a string or list of strings.
+
+    Example:
+        >>> items = load_decathalon_datalist("/data/Task01/dataset.json", data_list_key="training")
+        >>> items[0]["image"]  # doctest: +SKIP
+        '/data/Task01/imagesTr/case_000.nii.gz'
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {item!r} of '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping"
+            )
+        output = dict(item)
+        if "image" in output:
+            output["image"] = _resolve_decathalon_path(output["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in output:
+            output["label"] = _resolve_decathalon_path(output["label"], base_dir, data_list_file_path, "label")
+        processed.append(output)
+    return processed
