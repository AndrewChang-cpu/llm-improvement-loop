+
+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_json(path, content):
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            _write_json(
+                datalist_path,
+                {
+                    "training": [
+                        {"image": "imgs/case0.nii", "label": "lbls/case0.nii", "fold": 0},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(datalist_path, True, "training", tmp_dir)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbls/case0.nii")))
+            self.assertEqual(result[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            _write_json(
+                datalist_path,
+                {
+                    "training": [
+                        {"image": "imgs/case0.nii", "label": 3},
+                        {"image": "imgs/case1.nii", "label": 0},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(datalist_path, False, "training", tmp_dir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case0.nii")))
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/case1.nii")))
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[0]["label"], 3)
+            self.assertIsInstance(result[1]["label"], int)
+            self.assertEqual(result[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            abs_image = os.path.join(tmp_dir, "case0.nii")
+            abs_label = os.path.join(tmp_dir, "case0_label.nii")
+            _write_json(
+                datalist_path,
+                {
+                    "training": [
+                        {"image": abs_image, "label": abs_label},
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            _write_json(
+                datalist_path,
+                {
+                    "test": [
+                        "imgs/t0.nii",
+                        "imgs/t1.nii",
+                    ]
+                },
+            )
+            result = load_decathalon_datalist(datalist_path, data_list_key="test", base_dir=tmp_dir)
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs/t0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir, ignore_errors=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
