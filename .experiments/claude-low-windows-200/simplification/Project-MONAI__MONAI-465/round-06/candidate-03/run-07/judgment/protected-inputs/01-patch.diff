+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or list of strings.
+        base_dir (str): directory used to resolve relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"element {element!r} of field '{field}' in datalist file {data_list_file_path} "
+                    "must be a string"
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"field '{field}' value {value!r} in datalist file {data_list_file_path} "
+        "must be a string or a list of strings"
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return per-case items with resolved paths.
+
+    The entries under ``data_list_key`` are processed in their original order. For the key ``"test"``, each
+    entry is a plain path string and is wrapped as an item ``{"image": entry}`` before processing. Each item
+    must be a mapping. Its ``"image"`` value is resolved against ``base_dir`` when present. In segmentation
+    mode, its ``"label"`` value is also resolved when present; otherwise ``"label"`` is kept exactly as stored,
+    so classification labels may be any JSON value such as an integer class id. All other fields are kept
+    verbatim. A path value may be a string, which is joined with ``base_dir`` and normalized (an absolute
+    string stays absolute), or a list of strings, where each element is resolved independently and the
+    length and order are kept.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, the ``"label"`` values are
+            resolved as paths and must be strings or lists of strings. If False, ``"label"`` values are returned
+            unchanged. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries, for example ``"training"`` or
+            ``"test"``. Defaults to ``"training"``.
+        base_dir (str): directory used to resolve relative paths. If None, the directory portion of
+            ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        list of dict: the processed items, in the original order. Each item keeps the input field names.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value
+            is not a string or list of strings.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", True, "training")
+        # items[0]["image"] is the normalized path of the first image, resolved against the datalist directory
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file {data_list_file_path} does not exist")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file {data_list_file_path}")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"entry {item!r} under key '{data_list_key}' in datalist file {data_list_file_path} "
+                "must be a mapping"
+            )
+        out = dict(item)
+        if "image" in item:
+            out["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            out["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        processed.append(out)
+    return processed
