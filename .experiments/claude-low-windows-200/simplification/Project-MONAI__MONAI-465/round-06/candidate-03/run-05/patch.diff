+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, file_path: str, key: str) -> Union[str, List[str]]:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value; a string or a list of strings.
+        base_dir (str): directory used to join relative paths.
+        file_path (str): datalist file path, used in error messages.
+        key (str): field name the value came from, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of key '{key}' in datalist file '{file_path}' must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Value {value!r} of key '{key}' in datalist file '{file_path}' must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The file must hold a JSON object whose ``data_list_key`` value is a list of entries. Each entry must be a
+    mapping. The ``"image"`` value is resolved in all modes. In segmentation mode (``is_segmentation=True``) the
+    ``"label"`` value is resolved too; in classification mode it is left exactly as stored, so integer class ids
+    stay integers. Other fields are kept unchanged. Image and label values may be a string or a list of strings;
+    a list is resolved element by element, keeping its length and order. Items without ``"image"`` or ``"label"``
+    are accepted.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``
+    before validation, regardless of ``is_segmentation``.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths are kept absolute. If ``base_dir`` is
+    None, the directory portion of ``data_list_file_path`` is used.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the labels are segmentation labels, which are resolved as paths. Defaults
+            to True.
+        data_list_key (str): key in the JSON object holding the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory of
+            ``data_list_file_path``.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, has an entry that is
+            not a mapping, or has an image or segmentation label that is not a string or list of strings.
+
+    Returns:
+        a list of dicts, one per entry in the original order, keeping the input field names. For example, with
+        ``{"training": [{"image": "a.nii", "label": "b.nii"}]}`` in ``/data/dl.json`` and ``base_dir=None``, the
+        result is ``[{"image": "/data/a.nii", "label": "/data/b.nii"}]``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r") as f:
+        try:
+            data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+
+    return items
