+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            data = {
+                "training": [
+                    {"image": "imagesTr/img0.nii", "label": "labelsTr/lbl0.nii", "fold": 1},
+                ]
+            }
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(result), 1)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/img0.nii")))
+            self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labelsTr/lbl0.nii")))
+            self.assertEqual(result[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            data = {
+                "training": [
+                    {"image": "imagesTr/img0.nii", "label": 2},
+                    {"image": "imagesTr/img1.nii", "label": 0},
+                ]
+            }
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(datalist_path, False, "training", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/img0.nii")))
+            self.assertEqual(result[0]["label"], 2)
+            self.assertIsInstance(result[0]["label"], int)
+            self.assertEqual(result[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTr/img1.nii")))
+            self.assertEqual(result[1]["label"], 0)
+            self.assertIsInstance(result[1]["label"], int)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            abs_image = os.path.join(tmp_dir, "img0.nii")
+            abs_label = os.path.join(tmp_dir, "lbl0.nii")
+            data = {"training": [{"image": abs_image, "label": abs_label}]}
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "training", None)
+
+            self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist_path = os.path.join(tmp_dir, "dataset.json")
+            data = {"test": ["imagesTs/img0.nii", "imagesTs/img1.nii"]}
+            with open(datalist_path, "w", encoding="utf-8") as f:
+                json.dump(data, f)
+
+            result = load_decathalon_datalist(datalist_path, True, "test", tmp_dir)
+
+            self.assertEqual(len(result), 2)
+            self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imagesTs/img0.nii")))
+            self.assertNotIn("label", result[0])
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
