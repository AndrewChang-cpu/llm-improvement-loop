+import json
+import os
+from typing import Any, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory used to join relative paths.
+        data_list_file_path (str): datalist file path, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        str or list of str: normalized paths, with the same length and order as a list input.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' in datalist file '{data_list_file_path}' "
+                    "must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Value {value!r} of field '{field}' in datalist file '{data_list_file_path}' "
+        "must be a string or a list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Any]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return per-case items with resolved paths.
+
+    The top-level JSON object must contain ``data_list_key`` whose value is a list of entries. If
+    ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    Every other entry must be a JSON object. Its ``"image"`` value (when present) is resolved. Its ``"label"``
+    value (when present) is resolved only when ``is_segmentation`` is True; otherwise it is kept exactly as
+    stored, so classification labels may be any JSON value, such as an integer class id. All other fields are
+    kept unchanged. A path value may be a string or a list of strings; each element is resolved independently.
+
+    Relative paths are joined with ``base_dir`` and normalized; absolute paths stay absolute.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", is_segmentation=True, data_list_key="training")
+        # items[0]["image"] is a resolved path, e.g. "/data/imagesTr/case_0.nii.gz"
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether ``"label"`` values are resolved as paths. Defaults to True.
+        data_list_key (str): top-level key whose list of entries is loaded. Defaults to ``"training"``.
+        base_dir (str): directory used to resolve relative paths. Defaults to None, which means the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        list: processed items in the original order. Each item is a dict that keeps the input field names;
+        for the ``"test"`` key, each item is a dict with only the ``"image"`` field.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path
+            value is not a string or a list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        data = json.load(f)
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must map to a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_decathalon_path(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_decathalon_path(item["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+
+    return items
