+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, field: str, data_list_file_path: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path or a list of string paths.
+        base_dir (str): directory used to resolve relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the resolved string, or a new list of resolved strings in the same order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Decathalon datalist '{data_list_file_path}': list elements of field '{field}' "
+                    f"must be strings, got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Decathalon datalist '{data_list_file_path}': field '{field}' must be a string or list of strings, "
+        f"got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items
+    with their paths resolved.
+
+    Each entry under ``data_list_key`` is returned as a dictionary with the same field names as
+    the input. When ``is_segmentation`` is True, the "image" and "label" values are resolved
+    against ``base_dir``. When it is False, only "image" is resolved and "label" is kept exactly
+    as stored, so classification labels may be any JSON value such as an integer class id.
+    Other fields are kept verbatim. Items without "image" or "label" are accepted.
+
+    If ``data_list_key`` is "test", each plain string entry is wrapped as ``{"image": entry}``
+    before resolution, regardless of ``is_segmentation``.
+
+    Relative paths are joined with ``base_dir``, and the result is normalized. Absolute paths
+    stay absolute. A list of paths is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether the datalist is for segmentation, so "label" is resolved
+            as a path. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, which uses the
+            directory portion of ``data_list_file_path`` without making it absolute.
+
+    Raises:
+        ValueError: if the file does not exist, the top-level object lacks ``data_list_key``, an
+            item is not a mapping, or a path value is not a string or list of strings.
+
+    Returns:
+        list of dict: processed items in their original order. For example, with a segmentation
+        datalist containing ``{"image": "img.nii", "label": "seg.nii", "fold": 0}`` and base_dir
+        ``"/data"``, the item becomes ``{"image": "/data/img.nii", "label": "/data/seg.nii", "fold": 0}``.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Decathalon datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        content = json.load(f)
+
+    if not isinstance(content, dict) or data_list_key not in content:
+        raise ValueError(f"Decathalon datalist file '{data_list_file_path}' has no key '{data_list_key}'.")
+
+    entries = content[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(
+            f"Decathalon datalist file '{data_list_file_path}': key '{data_list_key}' must hold a list of entries."
+        )
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for index, item in enumerate(items):
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Decathalon datalist file '{data_list_file_path}' key '{data_list_key}': "
+                f"item {index} must be a mapping, got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(processed["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(processed["label"], base_dir, "label", data_list_file_path)
+        result.append(processed)
+    return result
