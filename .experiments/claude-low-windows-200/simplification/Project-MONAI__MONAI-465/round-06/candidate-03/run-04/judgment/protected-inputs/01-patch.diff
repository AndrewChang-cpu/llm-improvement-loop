+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(
+    value: Any, base_dir: str, field: str, data_list_file_path: str, data_list_key: str
+) -> Any:
+    """
+    Resolve a single path value or a list of path values against `base_dir`.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        field (str): name of the field being resolved, used in error messages.
+        data_list_file_path (str): datalist file path, used in error messages.
+        data_list_key (str): key holding the entries, used in error messages.
+
+    Returns:
+        (str or list of str): normalized path(s), with list order and length preserved.
+
+    Raises:
+        ValueError: if `value` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' under key '{data_list_key}' in "
+                    f"'{data_list_file_path}' must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' under key '{data_list_key}' in '{data_list_file_path}' must be a string "
+        f"or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The entries under `data_list_key` are processed in their original order. Each entry must be a mapping. The
+    "image" field is resolved when present. When `is_segmentation` is True, the "label" field is resolved when
+    present; otherwise it is left exactly as stored, so classification labels may be any JSON value. All other fields
+    are kept unchanged. For the "test" key, the entries are plain path strings, and each one is wrapped as an item
+    whose only field is "image" before processing.
+
+    Relative paths are joined with `base_dir` and normalized; absolute paths are kept absolute. A list of paths is
+    resolved element by element.
+
+    Example:
+        ``load_decathalon_datalist("dataset.json", data_list_key="training", base_dir="/data")`` returns items such
+        as ``{"image": "/data/imagesTr/case0.nii.gz", "label": "/data/labelsTr/case0.nii.gz"}``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): whether to resolve the "label" field as a path. Defaults to True.
+        data_list_key (str): top-level key whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory
+            portion of `data_list_file_path`.
+
+    Returns:
+        (list of dict): processed items in the original order, with the same field names as the input.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or an image or
+            segmentation label is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed_items: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Item {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(
+                processed["image"], base_dir, "image", data_list_file_path, data_list_key
+            )
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(
+                processed["label"], base_dir, "label", data_list_file_path, data_list_key
+            )
+        processed_items.append(processed)
+
+    return processed_items
