+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, field: str, file_path: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory used to join relative paths.
+        field (str): name of the field being resolved, used in error messages.
+        file_path (str): datalist file path, used in error messages.
+
+    Returns:
+        the normalized path string, or a list of normalized path strings with the same length and order.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' in datalist file '{file_path}' must be a string or a list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The top-level JSON object must contain ``data_list_key``, whose value is the list of entries. When
+    ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as an item whose only
+    field is ``"image"``. Otherwise each entry must be a JSON object.
+
+    Every ``"image"`` value is resolved. A ``"label"`` value is resolved only when ``is_segmentation`` is True;
+    otherwise it is left exactly as stored, so classification labels may be any JSON value such as an integer
+    class id. In segmentation mode, ``"label"`` must be a string or a list of strings. Other fields are kept
+    verbatim. Items without ``"image"`` or ``"label"`` are accepted.
+
+    Path values that are strings are joined with ``base_dir`` and normalized; absolute strings stay absolute.
+    List values are resolved element by element, keeping length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file. It must name an existing file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each item as a path. Defaults to True.
+        data_list_key (str): key in the top-level object whose value is the list of entries. Defaults to
+            ``"training"``.
+        base_dir (Optional[str]): directory used to resolve relative paths. Defaults to None, which uses the
+            directory portion of ``data_list_file_path``.
+
+    Returns:
+        a list of processed items in the same order as the input entries. Each item is a dictionary keeping
+        the input field names, with ``"image"`` (and ``"label"`` in segmentation mode) resolved.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an entry
+            or path value of an unsupported type.
+
+    Example:
+        >>> items = load_decathalon_datalist("dataset.json", data_list_key="training")
+        >>> items[0]["image"]  # doctest: +SKIP
+        '/data/imagesTr/case_0.nii.gz'
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        try:
+            data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(data, dict):
+        raise ValueError(f"Top-level content of datalist file '{data_list_file_path}' must be a JSON object.")
+    if data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} in key '{data_list_key}' of datalist file '{data_list_file_path}' must be a mapping."
+            )
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_decathalon_path(new_item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_decathalon_path(new_item["label"], base_dir, "label", data_list_file_path)
+        processed.append(new_item)
+
+    return processed
