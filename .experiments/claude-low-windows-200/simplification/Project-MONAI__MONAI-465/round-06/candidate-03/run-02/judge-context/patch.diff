+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {
+                        "image": os.path.join("imgs", "case_0.nii.gz"),
+                        "label": os.path.join("labels", "case_0.nii.gz"),
+                        "fold": 0,
+                    }
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case_0.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "labels", "case_0.nii.gz")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {
+                "training": [
+                    {"image": os.path.join("imgs", "case_0.nii.gz"), "label": 2},
+                    {"image": os.path.join("imgs", "case_1.nii.gz"), "label": 0},
+                ]
+            }
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, False, "training", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case_0.nii.gz")))
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case_1.nii.gz")))
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            image_path = os.path.join(tmp_dir, "case_0.nii.gz")
+            label_path = os.path.join(tmp_dir, "case_0_label.nii.gz")
+            datalist = {"training": [{"image": image_path, "label": label_path}]}
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "training", None)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+            self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            datalist = {"test": [os.path.join("imgs", "case_0.nii.gz"), os.path.join("imgs", "case_1.nii.gz")]}
+            file_path = os.path.join(tmp_dir, "dataset.json")
+            with open(file_path, "w") as f:
+                json.dump(datalist, f)
+
+            items = load_decathalon_datalist(file_path, True, "test", tmp_dir)
+
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case_0.nii.gz")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
