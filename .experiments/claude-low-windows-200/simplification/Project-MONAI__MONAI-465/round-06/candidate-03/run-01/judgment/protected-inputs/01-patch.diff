+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(
+    value: Any, base_dir: str, data_list_file_path: str, data_list_key: str, field: str
+) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against `base_dir`.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory used to join relative paths.
+        data_list_file_path (str): datalist file, used in error messages.
+        data_list_key (str): key of the entry, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        A resolved path string, or a list of resolved path strings in the original order.
+
+    Raises:
+        ValueError: if `value` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' under key '{data_list_key}' in datalist file "
+                    f"'{data_list_file_path}' must be a string."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a string "
+        f"or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its entries with resolved paths.
+
+    The entries stored under `data_list_key` are processed in their original order. For a key equal to "test",
+    each entry is a plain path string and is wrapped as an item with only an "image" field. Each item must be a
+    mapping. Its "image" field is resolved when present. When `is_segmentation` is True, its "label" field is
+    resolved when present; otherwise the label is returned exactly as stored, and may be any JSON value such as an
+    integer class id. Other fields are kept verbatim. A string path is joined with `base_dir` and normalized, and an
+    absolute path stays absolute. A list of paths is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether the "label" field is a segmentation label to resolve. Defaults to True.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Defaults to "training".
+        base_dir (str): directory used to resolve relative paths. Defaults to None, meaning the directory portion
+            of `data_list_file_path`.
+
+    Returns:
+        A list of dicts, one per entry, in the original order. Each dict keeps the input field names, with
+        "image" (and "label" in segmentation mode) resolved to a string or a list of strings.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an item is not a mapping, or a path value is
+            not a string or a list of strings.
+
+    Example:
+        >>> items = load_decathalon_datalist("/data/Task01/dataset.json", True, "training")
+        >>> items[0]["image"], items[0]["label"]  # doctest: +SKIP
+        ('/data/Task01/imagesTr/case_000.nii.gz', '/data/Task01/labelsTr/case_000.nii.gz')
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    fields = ["image", "label"] if is_segmentation else ["image"]
+
+    processed: List[Dict[str, Any]] = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        new_item = dict(item)
+        for field in fields:
+            if field in new_item:
+                new_item[field] = _resolve_decathalon_path(
+                    new_item[field], base_dir, data_list_file_path, data_list_key, field
+                )
+        processed.append(new_item)
+
+    return processed
