+import json
+import os
+from typing import Optional
+
+
+def _resolve_decathalon_path(value, base_dir: str, location: str, field: str):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value (str or list of str): path value as stored in the datalist.
+        base_dir (str): directory that relative paths are joined with.
+        location (str): description of the entry, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        (str or list of str): normalized path, or list of normalized paths in the original order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        if not all(isinstance(element, str) for element in value):
+            raise ValueError(f"Field '{field}' in {location} must be a string or list of strings, got {value!r}.")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"Field '{field}' in {location} must be a string or list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> list:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    Relative paths in ``"image"`` and, in segmentation mode, ``"label"`` are joined with ``base_dir`` and normalized.
+    Absolute paths are kept absolute. A list of paths is resolved element by element and keeps its order.
+    If ``is_segmentation`` is False, ``"label"`` is returned exactly as stored (for example, an integer class id).
+    Other fields are kept verbatim. If ``data_list_key`` is ``"test"``, the entries are plain path strings and
+    each one is wrapped as ``{"image": path}``.
+
+    Example::
+
+        items = load_decathalon_datalist("dataset.json", data_list_key="training")
+        # items[0] -> {"image": "/data/imagesTr/case_0.nii.gz", "label": "/data/labelsTr/case_0.nii.gz"}
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path; if False, leave it unchanged.
+            Default is True.
+        data_list_key (str): top-level key whose value is the list of entries, such as "training" or "test".
+            Default is "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion of
+            ``data_list_file_path`` is used. Default is None.
+
+    Returns:
+        (list of dict): one dict per entry, in the original order, with the input field names kept.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an entry
+            that is not a mapping or has an image or segmentation label that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Decathalon datalist file '{data_list_file_path}' does not exist.")
+
+    try:
+        with open(data_list_file_path, "r") as file:
+            json_data = json.load(file)
+    except (OSError, ValueError) as e:
+        raise ValueError(f"Decathalon datalist file '{data_list_file_path}' could not be read as JSON: {e}") from e
+
+    if not isinstance(json_data, dict):
+        raise ValueError(f"Decathalon datalist file '{data_list_file_path}' must contain a JSON object.")
+    if data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in Decathalon datalist file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in Decathalon datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, item in enumerate(entries):
+        location = f"entry {index} under key '{data_list_key}' in Decathalon datalist file '{data_list_file_path}'"
+        if not isinstance(item, dict):
+            raise ValueError(f"The {location} must be a mapping, got {item!r}.")
+
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_decathalon_path(item["image"], base_dir, location, "image")
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_decathalon_path(item["label"], base_dir, location, "label")
+        items.append(processed)
+
+    return items
