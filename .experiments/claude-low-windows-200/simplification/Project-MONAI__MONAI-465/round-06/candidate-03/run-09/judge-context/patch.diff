+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(
+    value: Any,
+    base_dir: str,
+    data_list_file_path: str,
+    data_list_key: str,
+    field: str,
+) -> Any:
+    """
+    Resolve a path value from a datalist entry against ``base_dir``.
+
+    A string is joined with ``base_dir`` and normalized. A list must contain only strings, and each
+    element is resolved independently with its length and order preserved.
+
+    Args:
+        value (Any): the stored path value, a string or a list of strings.
+        base_dir (str): directory the relative paths are joined with.
+        data_list_file_path (str): path of the datalist file, used in error messages.
+        data_list_key (str): key of the datalist the entry belongs to, used in error messages.
+        field (str): name of the field holding ``value``, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of field '{field}' under key '{data_list_key}' "
+                    f"in file '{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"Field '{field}' under key '{data_list_key}' in file '{data_list_file_path}' "
+        f"must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its per-case items with resolved paths.
+
+    The entries under ``data_list_key`` are read in their original order. Each entry must be a mapping; its
+    "image" value (and, in segmentation mode, its "label" value) is resolved against ``base_dir``. A string is
+    joined with ``base_dir`` and normalized, an absolute string stays absolute, and a list of strings is resolved
+    element by element. Missing "image" or "label" fields are not an error, and all other fields are kept verbatim.
+    When ``is_segmentation`` is False, the "label" value is returned exactly as stored, so classification labels
+    may be any JSON value, such as an integer class id.
+
+    When ``data_list_key`` is "test", each entry is a plain path string and is wrapped as an item whose only
+    field is "image" before any other processing.
+
+    Args:
+        data_list_file_path (str): path of the datalist JSON file, which must exist.
+        is_segmentation (bool): whether the "label" values are resolved as segmentation paths. Defaults to True.
+        data_list_key (str): key of the datalist whose entries are loaded. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, meaning the directory
+            portion of ``data_list_file_path``, which is not made absolute.
+
+    Returns:
+        A list of dictionaries, one per entry in their original order. Each dictionary keeps the input field
+        names, with "image" (and "label" in segmentation mode) replaced by resolved paths.
+
+    Raises:
+        ValueError: when the file does not exist or is not valid JSON, when the top-level object or the value
+            under ``data_list_key`` has the wrong shape, when an entry is not a mapping, or when an image value
+            or a segmentation label is not a string or a list of strings.
+
+    Example:
+        >>> items = load_decathalon_datalist("/data/dataset.json", data_list_key="training")  # doctest: +SKIP
+        >>> items[0]["image"]  # doctest: +SKIP
+        '/data/imagesTr/case_000.nii.gz'
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    try:
+        with open(data_list_file_path, "r", encoding="utf-8") as f:
+            data = json.load(f)
+    except (OSError, ValueError) as e:
+        raise ValueError(f"Datalist file '{data_list_file_path}' could not be read as JSON: {e}") from e
+
+    if not isinstance(data, dict):
+        raise ValueError(f"Top-level content of datalist file '{data_list_file_path}' must be a JSON object.")
+    if data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value under key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        items = [{"image": entry} for entry in entries]
+    else:
+        items = entries
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in items:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        result = dict(item)
+        if "image" in item:
+            result["image"] = _resolve_decathalon_path(
+                item["image"], base_dir, data_list_file_path, data_list_key, "image"
+            )
+        if is_segmentation and "label" in item:
+            result["label"] = _resolve_decathalon_path(
+                item["label"], base_dir, data_list_file_path, data_list_key, "label"
+            )
+        processed.append(result)
+    return processed
