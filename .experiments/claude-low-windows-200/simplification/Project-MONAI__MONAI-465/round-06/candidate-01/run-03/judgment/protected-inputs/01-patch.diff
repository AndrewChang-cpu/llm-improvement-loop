+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp,
+                {"training": [{"image": "imgs/a.nii.gz", "label": "labs/a.nii.gz", "fold": 0}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii.gz")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "labs/a.nii.gz")))
+            self.assertEqual(items[0]["fold"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(
+                tmp,
+                {"training": [{"image": "imgs/a.nii.gz", "label": 2}, {"image": "imgs/b.nii.gz", "label": 0}]},
+            )
+            items = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/a.nii.gz")))
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp, "imgs/b.nii.gz")))
+            self.assertEqual(items[1]["label"], 0)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "image.nii.gz")
+            abs_label = os.path.join(tmp, "label.nii.gz")
+            path = self._write_datalist(tmp, {"training": [{"image": abs_image, "label": abs_label}]})
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = self._write_datalist(tmp, {"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]})
+            items = load_decathalon_datalist(path, True, "test", tmp)
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "imgs/t0.nii.gz")))
+            self.assertNotIn("label", items[0])
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
