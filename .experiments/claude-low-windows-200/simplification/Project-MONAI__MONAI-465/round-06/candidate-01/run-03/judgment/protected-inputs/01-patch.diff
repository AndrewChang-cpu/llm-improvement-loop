+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, owner: str) -> Any:
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+
+    Args:
+        value: a string path, or a list whose elements are all strings.
+        base_dir: directory that relative paths are joined with.
+        owner: description of the field, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"{owner} list elements must be strings, got {element!r}")
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(f"{owner} must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must be a JSON object containing ``data_list_key`` whose value is a list of entries.
+    For the ``"test"`` key, each entry is a plain path string and is wrapped as ``{"image": entry}``.
+    For every other key, each entry must be a mapping. Its ``"image"`` field is resolved, and its
+    ``"label"`` field is resolved only when ``is_segmentation`` is true; other fields are kept verbatim.
+    Paths may be strings or lists of strings and are joined with ``base_dir`` and normalized;
+    absolute paths are kept absolute.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, "label" is resolved as a path (string or list of strings).
+            If False (classification), "label" is left as stored and may be any JSON value.
+            Defaults to True.
+        data_list_key (str): key in the JSON object whose value holds the entries. Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, meaning
+            the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        List[Dict[str, Any]]: processed items in the original order. Each item is a dict with the
+        same keys as the stored entry (for the "test" key, a dict with only "image").
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, an item
+            is not a mapping, or an "image" (or segmentation "label") value is not a string or list
+            of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file '{data_list_file_path}' does not exist.")
+    try:
+        with open(data_list_file_path, "r") as f:
+            json_data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"data_list_key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"key '{data_list_key}' in datalist file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"each item in key '{data_list_key}' of '{data_list_file_path}' must be a mapping.")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_decathalon_path(
+                new_item["image"], base_dir, f"'image' in datalist file '{data_list_file_path}'"
+            )
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_decathalon_path(
+                new_item["label"], base_dir, f"'label' in datalist file '{data_list_file_path}'"
+            )
+        processed.append(new_item)
+    return processed
