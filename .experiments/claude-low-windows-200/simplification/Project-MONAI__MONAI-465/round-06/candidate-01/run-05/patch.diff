+import json
+import os
+from typing import Any, Dict, List, Optional, Union
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, data_list_file_path: str, key: str) -> Union[str, List[str]]:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path or a list of string paths.
+        base_dir (str): directory the relative paths are joined with.
+        data_list_file_path (str): datalist file, used in error messages.
+        key (str): item field name, used in error messages.
+
+    Returns:
+        str or list of str: normalized paths, same type and length as ``value``.
+
+    Raises:
+        ValueError: if ``value`` is neither a string nor a list of strings.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(f"list elements of '{key}' in {data_list_file_path} must be strings, got {element!r}")
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{key}' in {data_list_file_path} must be a string or a list of strings, got {value!r}")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict]:
+    """
+    Load the Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether entries are segmentation items. If True, the "label" field of
+            each item is resolved against ``base_dir``. If False, "label" is left exactly as stored
+            (for example an integer class id). "image" is always resolved. Default is True.
+        data_list_key (str): top-level key whose value is the list of entries. Default is "training".
+            If it equals "test", each entry is a plain path string and is wrapped as
+            ``{"image": entry}`` before processing.
+        base_dir (str): directory that relative paths are joined with. If None, the directory portion
+            of ``data_list_file_path`` is used (not made absolute). Default is None.
+
+    Returns:
+        list of dict: one dict per entry, in the original order. Each dict keeps all fields of the
+        original entry; "image" is resolved to a string or list of strings, and "label" is resolved
+        to a string or list of strings only in segmentation mode. Other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or an
+            entry or path value has an invalid type.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"datalist file does not exist: {data_list_file_path}")
+
+    try:
+        with open(data_list_file_path, "r") as f:
+            data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"datalist file {data_list_file_path} is not valid JSON: {e}") from e
+
+    if not isinstance(data, dict) or data_list_key not in data:
+        raise ValueError(f"key '{data_list_key}' not found in datalist file {data_list_file_path}")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value of key '{data_list_key}' in {data_list_file_path} must be a list")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    processed = []
+    for item in entries:
+        if not isinstance(item, dict):
+            raise ValueError(f"each entry under '{data_list_key}' in {data_list_file_path} must be an object")
+        new_item = dict(item)
+        if "image" in new_item:
+            new_item["image"] = _resolve_decathalon_path(new_item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in new_item:
+            new_item["label"] = _resolve_decathalon_path(new_item["label"], base_dir, data_list_file_path, "label")
+        processed.append(new_item)
+    return processed
