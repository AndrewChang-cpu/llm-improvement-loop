+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, base_dir: str, data_list_file_path: str, key: str) -> Any:
+    """
+    Resolve a path value against `base_dir`.
+
+    A string is joined with `base_dir` and normalized; absolute strings stay absolute. A list must contain only
+    strings, each resolved independently, keeping length and order. Any other type raises a ValueError.
+
+    Args:
+        value (Any): the stored path value, a string or list of strings.
+        base_dir (str): directory the relative paths are resolved against.
+        data_list_file_path (str): datalist file the value came from, used in error messages.
+        key (str): the field name the value belongs to, used in error messages.
+
+    Returns:
+        (str or list of str): the resolved path or list of resolved paths.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{key}' in {data_list_file_path} must be a string, got {value!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{key}' value {value!r} in {data_list_file_path} must be a string or list of strings.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its items with paths resolved.
+
+    The file must be a JSON object containing `data_list_key` whose value is a list of entries. Each entry must be
+    a mapping. Its "image" value is resolved against `base_dir`; in segmentation mode its "label" value is resolved
+    too. In classification mode the "label" value is left as stored, and it may be any JSON value such as an integer
+    class id. Other fields are kept verbatim. Fields that are absent are not required and are not added.
+
+    When `data_list_key` is "test", each entry is a plain path string, wrapped as an item whose only field is
+    "image" before validation.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file; it must exist.
+        is_segmentation (bool): whether to resolve "label" values as paths. Default is True. If False, "label" is
+            returned unchanged.
+        data_list_key (str): key in the JSON object whose value is the list of entries. Default is "training".
+        base_dir (str): directory that relative paths are resolved against. Default is None, which uses the
+            directory portion of `data_list_file_path`, not made absolute.
+
+    Returns:
+        (list of dict): the processed items, in the original order. Each item is a dict with resolved "image" (and,
+        in segmentation mode, "label") values plus any other fields from the entry.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or a path value is
+            not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    with open(data_list_file_path, encoding="utf-8") as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Value of key '{data_list_key}' in datalist file {data_list_file_path} must be a list.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(f"Entry {item!r} under key '{data_list_key}' in {data_list_file_path} must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
