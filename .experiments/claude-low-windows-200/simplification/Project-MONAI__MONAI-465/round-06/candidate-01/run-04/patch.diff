+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": "imgs/case0.nii", "label": "lbls/case0.nii", "fold": 0},
+                    {"image": "./imgs//case1.nii", "label": "lbls/case1.nii", "fold": 1},
+                ]
+            }
+            path = self._write_datalist(tmp_dir, data)
+            items = load_decathalon_datalist(path, True, "training", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbls", "case0.nii")))
+            self.assertEqual(items[0]["fold"], 0)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "case1.nii")))
+            self.assertEqual(items[1]["label"], os.path.normpath(os.path.join(tmp_dir, "lbls", "case1.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_cls_values(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {
+                "training": [
+                    {"image": ["imgs/a.nii", "imgs/b.nii"], "label": 2},
+                    {"image": "imgs/c.nii", "label": 0},
+                ]
+            }
+            path = self._write_datalist(tmp_dir, data)
+            items = load_decathalon_datalist(path, False, "training", tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(
+                items[0]["image"],
+                [
+                    os.path.normpath(os.path.join(tmp_dir, "imgs", "a.nii")),
+                    os.path.normpath(os.path.join(tmp_dir, "imgs", "b.nii")),
+                ],
+            )
+            self.assertIsInstance(items[0]["label"], int)
+            self.assertEqual(items[0]["label"], 2)
+            self.assertIsInstance(items[1]["label"], int)
+            self.assertEqual(items[1]["label"], 0)
+            self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "c.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp_dir, "image.nii")
+            abs_label = os.path.join(tmp_dir, "label.nii")
+            data = {"training": [{"image": abs_image, "label": abs_label}]}
+            path = self._write_datalist(tmp_dir, data)
+            items = load_decathalon_datalist(path, True, "training", None)
+
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+    def test_seg_no_labels(self):
+        tmp_dir = tempfile.mkdtemp()
+        try:
+            data = {"test": ["imgs/t0.nii", "imgs/t1.nii"]}
+            path = self._write_datalist(tmp_dir, data)
+            items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+
+            self.assertEqual(len(items), 2)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "imgs", "t0.nii")))
+        finally:
+            shutil.rmtree(tmp_dir)
+
+
+if __name__ == "__main__":
+    unittest.main()
