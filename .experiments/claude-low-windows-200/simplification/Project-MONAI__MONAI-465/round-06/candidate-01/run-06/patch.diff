+import json
+import os
+
+
+def _resolve_path(value, base_dir, field, data_list_file_path):
+    """
+    Resolve a path value (a string or a list of strings) against ``base_dir``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Element {element!r} of '{field}' in datalist '{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in datalist '{data_list_file_path}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(data_list_file_path, is_segmentation=True, data_list_key="training", base_dir=None):
+    """
+    Load the image and label paths from a Medical Segmentation Decathlon datalist JSON file.
+
+    Each entry under ``data_list_key`` is returned as a new dictionary (in original order) in which
+    ``"image"`` is resolved against ``base_dir``. ``"label"`` is resolved too, but only when
+    ``is_segmentation`` is True; in classification mode it is left exactly as stored. All other
+    fields are kept verbatim. Entries under the ``"test"`` key are plain path strings and are wrapped
+    as ``{"image": entry}`` before processing.
+
+    Path values are joined with ``base_dir`` and normalized. Absolute paths stay absolute. A list of
+    paths is resolved element by element, keeping its length and order.
+
+    Args:
+        data_list_file_path (str): path to the Decathalon datalist JSON file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field as a path (string or list of
+            strings); if False, leave ``"label"`` unchanged, which allows classification labels such as
+            integer class ids. Defaults to True.
+        data_list_key (str): top-level key of the JSON object that holds the list of entries,
+            e.g. "training", "validation" or "test". Defaults to "training".
+        base_dir (str): directory that relative paths are resolved against. Defaults to None, which
+            means the directory containing ``data_list_file_path``.
+
+    Returns:
+        list: one dictionary per entry, in the original order. Each dictionary has its ``"image"``
+        (and, in segmentation mode, ``"label"``) resolved to a string, or to a list of strings when
+        the stored value is a list. Other fields are unchanged.
+
+    Raises:
+        ValueError: if the file does not exist, the key is missing, an entry is not a mapping, or an
+            ``"image"`` value (or a segmentation ``"label"`` value) is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    with open(data_list_file_path) as f:
+        json_data = json.load(f)
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' is missing from datalist '{data_list_file_path}'.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist '{data_list_file_path}' must hold a list of entries.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(
+                f"Entry {item!r} under key '{data_list_key}' in datalist '{data_list_file_path}' must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in item:
+            processed["image"] = _resolve_path(item["image"], base_dir, "image", data_list_file_path)
+        if is_segmentation and "label" in item:
+            processed["label"] = _resolve_path(item["label"], base_dir, "label", data_list_file_path)
+        items.append(processed)
+
+    return items
