+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp, ignore_errors=True)
+        return tmp
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp = self._make_dir()
+        path = self._write_datalist(tmp, {"training": [{"image": "img0.nii.gz", "label": "seg0.nii.gz", "fold": 1}]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=tmp)
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii.gz")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "seg0.nii.gz")))
+        self.assertEqual(items[0]["fold"], 1)
+
+    def test_cls_values(self):
+        tmp = self._make_dir()
+        path = self._write_datalist(
+            tmp, {"training": [{"image": "img0.nii.gz", "label": 0}, {"image": "img1.nii.gz", "label": 2}]}
+        )
+        items = load_decathalon_datalist(path, is_segmentation=False, data_list_key="training", base_dir=tmp)
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii.gz")))
+        self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp, "img1.nii.gz")))
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[0]["label"], 0)
+        self.assertIsInstance(items[1]["label"], int)
+        self.assertEqual(items[1]["label"], 2)
+
+    def test_seg_no_basedir(self):
+        tmp = self._make_dir()
+        image = os.path.join(tmp, "img0.nii.gz")
+        label = os.path.join(tmp, "seg0.nii.gz")
+        path = self._write_datalist(tmp, {"training": [{"image": image, "label": label}]})
+        items = load_decathalon_datalist(path, is_segmentation=True, data_list_key="training", base_dir=None)
+        self.assertEqual(items[0]["image"], os.path.normpath(image))
+        self.assertEqual(items[0]["label"], os.path.normpath(label))
+
+    def test_seg_no_labels(self):
+        tmp = self._make_dir()
+        path = self._write_datalist(tmp, {"test": ["img0.nii.gz", "img1.nii.gz"]})
+        items = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp)
+        self.assertEqual(len(items), 2)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
