+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, True)
+        return tmp_dir
+
+    def _write_datalist(self, directory, content):
+        path = os.path.join(directory, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = self._make_dir()
+        path = self._write_datalist(
+            tmp_dir,
+            {"training": [{"image": "img0.nii", "label": "seg0.nii", "extra": 5}]},
+        )
+        result = load_decathalon_datalist(path, True, "training", tmp_dir)
+
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(tmp_dir, "seg0.nii")))
+        self.assertEqual(result[0]["extra"], 5)
+
+    def test_cls_values(self):
+        tmp_dir = self._make_dir()
+        path = self._write_datalist(
+            tmp_dir,
+            {"training": [{"image": "img0.nii", "label": 1}]},
+        )
+        result = load_decathalon_datalist(path, False, "training", tmp_dir)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+        self.assertEqual(result[0]["label"], 1)
+        self.assertIsInstance(result[0]["label"], int)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_dir()
+        abs_image = os.path.join(tmp_dir, "img0.nii")
+        abs_label = os.path.join(tmp_dir, "seg0.nii")
+        path = self._write_datalist(
+            tmp_dir,
+            {"training": [{"image": abs_image, "label": abs_label}]},
+        )
+        result = load_decathalon_datalist(path, True, "training", None)
+
+        self.assertEqual(result[0]["image"], os.path.normpath(abs_image))
+        self.assertEqual(result[0]["label"], os.path.normpath(abs_label))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_dir()
+        path = self._write_datalist(
+            tmp_dir,
+            {"test": ["img0.nii", "img1.nii"]},
+        )
+        result = load_decathalon_datalist(path, data_list_key="test", base_dir=tmp_dir)
+
+        self.assertEqual(len(result), 2)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+
+
+if __name__ == "__main__":
+    unittest.main()
