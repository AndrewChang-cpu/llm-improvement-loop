+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path_value(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a path value against ``base_dir``. A string is joined and normalized; a list of
+    strings is resolved element by element. Any other type raises ``ValueError``.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Every element of '{field}' in '{data_list_file_path}' must be a string, got {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(f"'{field}' in '{data_list_file_path}' must be a string or a list of strings, got {value!r}.")
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and return its items with paths
+    resolved against a base directory.
+
+    Args:
+        data_list_file_path (str): path to the Decathlon datalist JSON file.
+        is_segmentation (bool): whether the datalist is for segmentation. If True, "label" is
+            resolved as a path (string or list of strings). If False, "label" is left as stored,
+            so classification labels such as integer class ids are kept verbatim. Defaults to True.
+        data_list_key (str): key in the top-level JSON object whose value is the list of entries.
+            If it equals "test", each entry is a plain path string and is wrapped as
+            ``{"image": entry}``. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. If None, the directory
+            portion of ``data_list_file_path`` is used, without making it absolute. Defaults to None.
+
+    Returns:
+        List[Dict[str, Any]]: the processed items, in their original order. Each item is a copy of
+        the stored entry with "image" resolved (when present), and "label" resolved when
+        ``is_segmentation`` is True (when present). All other fields are kept unchanged.
+
+    Raises:
+        ValueError: if the file does not exist or is not valid JSON, if ``data_list_key`` is missing,
+            if an item is not a mapping, or if a path value is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Data list file '{data_list_file_path}' does not exist.")
+
+    try:
+        with open(data_list_file_path, "r", encoding="utf-8") as f:
+            json_data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"Data list file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Data list key '{data_list_key}' not found in file '{data_list_file_path}'.")
+
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Value of key '{data_list_key}' in file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for index, entry in enumerate(entries):
+        if not isinstance(entry, dict):
+            raise ValueError(
+                f"Item {index} under key '{data_list_key}' in file '{data_list_file_path}' must be a mapping."
+            )
+        item = dict(entry)
+        if "image" in item:
+            item["image"] = _resolve_path_value(item["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in item:
+            item["label"] = _resolve_path_value(item["label"], base_dir, data_list_file_path, "label")
+        items.append(item)
+    return items
