+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+def _write_json(directory, file_name, content):
+    path = os.path.join(directory, file_name)
+    with open(path, "w", encoding="utf-8") as f:
+        json.dump(content, f)
+    return path
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def test_seg_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_json(
+                tmp,
+                "datalist.json",
+                {"training": [{"image": "img0.nii", "label": "seg0.nii", "fold": 1}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", tmp)
+            self.assertEqual(len(items), 1)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp, "seg0.nii")))
+            self.assertEqual(items[0]["fold"], 1)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_cls_values(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_json(
+                tmp,
+                "datalist.json",
+                {"training": [{"image": "img0.nii", "label": 3}]},
+            )
+            items = load_decathalon_datalist(path, False, "training", tmp)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+            self.assertEqual(items[0]["label"], 3)
+            self.assertIsInstance(items[0]["label"], int)
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_basedir(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            abs_image = os.path.join(tmp, "img0.nii")
+            abs_label = os.path.join(tmp, "seg0.nii")
+            path = _write_json(
+                tmp,
+                "datalist.json",
+                {"training": [{"image": abs_image, "label": abs_label}]},
+            )
+            items = load_decathalon_datalist(path, True, "training", None)
+            self.assertEqual(items[0]["image"], os.path.normpath(abs_image))
+            self.assertEqual(items[0]["label"], os.path.normpath(abs_label))
+        finally:
+            shutil.rmtree(tmp)
+
+    def test_seg_no_labels(self):
+        tmp = tempfile.mkdtemp()
+        try:
+            path = _write_json(tmp, "datalist.json", {"test": ["img0.nii", "img1.nii"]})
+            items = load_decathalon_datalist(path, True, "test", tmp)
+            self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp, "img0.nii")))
+        finally:
+            shutil.rmtree(tmp)
+
+
+if __name__ == "__main__":
+    unittest.main()
