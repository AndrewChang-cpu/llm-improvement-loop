+import json
+import os
+from collections.abc import Mapping
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_path(value: Any, key: str, base_dir: str, data_list_file_path: str) -> Any:
+    """Resolve a string or list of strings against ``base_dir``; raise ValueError for other types."""
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"element {element!r} of '{key}' in data list file '{data_list_file_path}' must be a string."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{key}' value {value!r} in data list file '{data_list_file_path}' must be a string or list of strings."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    Each entry under ``data_list_key`` is returned as a dictionary. The ``"image"`` value is resolved
+    against ``base_dir``. The ``"label"`` value is resolved only when ``is_segmentation`` is True;
+    otherwise it is returned as stored (for example, an integer class id). Other fields are kept verbatim.
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as
+    ``{"image": entry}`` before processing.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): whether to resolve the ``"label"`` field as a path. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries. Defaults to "training".
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses
+            the directory portion of ``data_list_file_path`` (not made absolute).
+
+    Returns:
+        List[Dict[str, Any]]: processed items in their original order. Each item is a dictionary
+        with resolved ``"image"`` (and ``"label"`` in segmentation mode) values, where a path value
+        is a string or a list of strings.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or
+            contains an item that is not a mapping or a path value that is not a string or list of strings.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"data list file '{data_list_file_path}' does not exist.")
+    with open(data_list_file_path, "r", encoding="utf-8") as f:
+        try:
+            json_data = json.load(f)
+        except json.JSONDecodeError as e:
+            raise ValueError(f"data list file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, Mapping) or data_list_key not in json_data:
+        raise ValueError(f"key '{data_list_key}' is missing from data list file '{data_list_file_path}'.")
+    entries = json_data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"value of key '{data_list_key}' in data list file '{data_list_file_path}' must be a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"item {item!r} under key '{data_list_key}' in data list file '{data_list_file_path}' "
+                "must be a mapping."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_path(processed["image"], "image", base_dir, data_list_file_path)
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_path(processed["label"], "label", base_dir, data_list_file_path)
+        items.append(processed)
+    return items
