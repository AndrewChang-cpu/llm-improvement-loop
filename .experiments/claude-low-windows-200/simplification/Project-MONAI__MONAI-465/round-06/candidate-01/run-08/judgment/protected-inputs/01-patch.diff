+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def _make_dir(self):
+        tmp_dir = tempfile.mkdtemp()
+        self.addCleanup(shutil.rmtree, tmp_dir, True)
+        return tmp_dir
+
+    def _write_json(self, tmp_dir, content):
+        path = os.path.join(tmp_dir, "datalist.json")
+        with open(path, "w", encoding="utf-8") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        tmp_dir = self._make_dir()
+        path = self._write_json(
+            tmp_dir,
+            {"training": [{"image": "img0.nii", "label": "lbl0.nii", "fold": 2}]},
+        )
+        items = load_decathalon_datalist(path, True, "training", tmp_dir)
+        self.assertEqual(len(items), 1)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+        self.assertEqual(items[0]["label"], os.path.normpath(os.path.join(tmp_dir, "lbl0.nii")))
+        self.assertEqual(items[0]["fold"], 2)
+
+    def test_cls_values(self):
+        tmp_dir = self._make_dir()
+        path = self._write_json(
+            tmp_dir,
+            {"training": [{"image": "img0.nii", "label": 1}, {"image": "img1.nii", "label": 0}]},
+        )
+        items = load_decathalon_datalist(path, False, "training", tmp_dir)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "img0.nii")))
+        self.assertEqual(items[1]["image"], os.path.normpath(os.path.join(tmp_dir, "img1.nii")))
+        self.assertIsInstance(items[0]["label"], int)
+        self.assertEqual(items[0]["label"], 1)
+        self.assertEqual(items[1]["label"], 0)
+
+    def test_seg_no_basedir(self):
+        tmp_dir = self._make_dir()
+        image_path = os.path.join(tmp_dir, "img0.nii")
+        label_path = os.path.join(tmp_dir, "lbl0.nii")
+        path = self._write_json(
+            tmp_dir,
+            {"training": [{"image": image_path, "label": label_path}]},
+        )
+        items = load_decathalon_datalist(path, True, "training", None)
+        self.assertEqual(items[0]["image"], os.path.normpath(image_path))
+        self.assertEqual(items[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        tmp_dir = self._make_dir()
+        path = self._write_json(
+            tmp_dir,
+            {"test": ["test0.nii", "test1.nii"]},
+        )
+        items = load_decathalon_datalist(path, True, "test", tmp_dir)
+        self.assertEqual(items[0]["image"], os.path.normpath(os.path.join(tmp_dir, "test0.nii")))
+        self.assertNotIn("label", items[0])
+
+
+if __name__ == "__main__":
+    unittest.main()
