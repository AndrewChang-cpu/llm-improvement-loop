+import json
+import os
+from collections.abc import Mapping
+from typing import Optional
+
+
+def _resolve_decathalon_path(value: object, base_dir: str, data_list_file_path: str, field: str) -> object:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (object): a string path, or a list of string paths.
+        base_dir (str): directory that relative paths are joined with.
+        data_list_file_path (str): datalist file path, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Raises:
+        ValueError: when ``value`` is neither a string nor a list of strings.
+
+    Returns:
+        the resolved string, or a list of resolved strings of the same length and order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        resolved = []
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"'{field}' list elements in datalist file '{data_list_file_path}' must be strings, "
+                    f"got {element!r}."
+                )
+            resolved.append(os.path.normpath(os.path.join(base_dir, element)))
+        return resolved
+    raise ValueError(
+        f"'{field}' in datalist file '{data_list_file_path}' must be a string or a list of strings, got {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> list:
+    """
+    Load the Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The file must contain a top-level object with the key ``data_list_key`` whose value is a list of entries.
+    Each entry is a mapping; its ``"image"`` field is resolved against ``base_dir``. When ``is_segmentation``
+    is True, its ``"label"`` field is resolved too; otherwise ``"label"`` is kept as stored (for example an
+    integer class id). Other fields are kept verbatim. Fields that are absent are not required.
+
+    When ``data_list_key`` is ``"test"``, each entry is a plain path string and is wrapped as
+    ``{"image": entry}`` before processing, regardless of ``is_segmentation``.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve the ``"label"`` field of each item as a path (a string or
+            list of strings). If False, leave ``"label"`` unchanged. Defaults to True.
+        data_list_key (str): top-level key holding the list of entries, for example ``"training"`` or
+            ``"test"``. Defaults to ``"training"``.
+        base_dir (str): directory that relative paths are joined with. Defaults to None, which uses the
+            directory portion of ``data_list_file_path`` (not made absolute).
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``, or contains an
+            item that is not a mapping or a path field with an invalid type.
+
+    Returns:
+        list: the processed items, in the original order. Each item is a dict copy of the entry with the
+        resolved ``"image"`` (and ``"label"`` in segmentation mode) fields.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file '{data_list_file_path}' does not exist.")
+
+    try:
+        with open(data_list_file_path, "r") as f:
+            data = json.load(f)
+    except json.JSONDecodeError as e:
+        raise ValueError(f"Datalist file '{data_list_file_path}' is not valid JSON: {e}") from e
+
+    if not isinstance(data, Mapping) or data_list_key not in data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file '{data_list_file_path}'.")
+
+    entries = data[data_list_key]
+    if not isinstance(entries, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file '{data_list_file_path}' must hold a list.")
+
+    if data_list_key == "test":
+        entries = [{"image": entry} for entry in entries]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    items = []
+    for item in entries:
+        if not isinstance(item, Mapping):
+            raise ValueError(
+                f"Each item under key '{data_list_key}' in datalist file '{data_list_file_path}' "
+                f"must be a mapping, got {item!r}."
+            )
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(processed["label"], base_dir, data_list_file_path, "label")
+        items.append(processed)
+    return items
