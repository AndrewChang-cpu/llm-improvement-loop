+import json
+import os
+from typing import Any, Dict, List, Optional
+
+
+def _resolve_decathalon_path(value: Any, base_dir: str, data_list_file_path: str, field: str) -> Any:
+    """
+    Resolve a single path value or a list of path values against ``base_dir``.
+
+    Args:
+        value (Any): a string path, or a list of string paths.
+        base_dir (str): directory to join relative paths with.
+        data_list_file_path (str): datalist file path, used in error messages.
+        field (str): name of the field being resolved, used in error messages.
+
+    Returns:
+        the resolved string, or a new list of resolved strings in the same order.
+    """
+    if isinstance(value, str):
+        return os.path.normpath(os.path.join(base_dir, value))
+    if isinstance(value, list):
+        for element in value:
+            if not isinstance(element, str):
+                raise ValueError(
+                    f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, "
+                    f"found element {element!r}."
+                )
+        return [os.path.normpath(os.path.join(base_dir, element)) for element in value]
+    raise ValueError(
+        f"Field '{field}' in {data_list_file_path} must be a string or a list of strings, found {value!r}."
+    )
+
+
+def load_decathalon_datalist(
+    data_list_file_path: str,
+    is_segmentation: bool = True,
+    data_list_key: str = "training",
+    base_dir: Optional[str] = None,
+) -> List[Dict[str, Any]]:
+    """
+    Load a Medical Segmentation Decathlon datalist JSON file and resolve its paths.
+
+    The top-level JSON object must contain ``data_list_key`` whose value is a list of entries.
+    If ``data_list_key`` is "test", each entry is a plain path string and is wrapped as
+    ``{"image": entry}`` before processing. Each item's "image" is resolved against ``base_dir``.
+    In segmentation mode, "label" is also resolved; in classification mode it is left as stored,
+    so integer class ids remain integers. All other fields are returned unchanged. "image" and
+    "label" are optional; only the ones present are resolved.
+
+    Args:
+        data_list_file_path (str): path to the datalist JSON file.
+        is_segmentation (bool): if True, resolve "label" as a path (string or list of strings);
+            if False, leave "label" unchanged. Defaults to True.
+        data_list_key (str): key in the top-level JSON object holding the list of entries.
+            Defaults to "training".
+        base_dir (Optional[str]): directory that relative paths are joined with. If None, the
+            directory portion of ``data_list_file_path`` is used (not made absolute). Defaults to None.
+
+    Returns:
+        List[Dict[str, Any]]: processed items, in the original order. Each item is a dict with
+        resolved "image" (and "label" in segmentation mode) paths, plus any other fields kept verbatim.
+
+    Raises:
+        ValueError: if the file does not exist, is not valid JSON, lacks ``data_list_key``,
+            or contains an item that is not a mapping or has an invalid path value.
+    """
+    if not os.path.isfile(data_list_file_path):
+        raise ValueError(f"Datalist file {data_list_file_path} does not exist.")
+
+    try:
+        with open(data_list_file_path, "r") as f:
+            json_data = json.load(f)
+    except ValueError as e:
+        raise ValueError(f"Datalist file {data_list_file_path} is not valid JSON: {e}") from e
+
+    if not isinstance(json_data, dict) or data_list_key not in json_data:
+        raise ValueError(f"Key '{data_list_key}' not found in datalist file {data_list_file_path}.")
+
+    data_list = json_data[data_list_key]
+    if not isinstance(data_list, list):
+        raise ValueError(f"Key '{data_list_key}' in datalist file {data_list_file_path} must hold a list.")
+
+    if data_list_key == "test":
+        data_list = [{"image": entry} for entry in data_list]
+
+    if base_dir is None:
+        base_dir = os.path.dirname(data_list_file_path)
+
+    result: List[Dict[str, Any]] = []
+    for item in data_list:
+        if not isinstance(item, dict):
+            raise ValueError(f"Each item in {data_list_file_path} under key '{data_list_key}' must be a mapping.")
+        processed = dict(item)
+        if "image" in processed:
+            processed["image"] = _resolve_decathalon_path(processed["image"], base_dir, data_list_file_path, "image")
+        if is_segmentation and "label" in processed:
+            processed["label"] = _resolve_decathalon_path(processed["label"], base_dir, data_list_file_path, "label")
+        result.append(processed)
+    return result
