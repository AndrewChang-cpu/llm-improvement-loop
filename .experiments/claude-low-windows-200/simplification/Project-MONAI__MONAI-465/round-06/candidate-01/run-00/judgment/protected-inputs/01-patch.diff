+import json
+import os
+import shutil
+import tempfile
+import unittest
+
+from monai.data import load_decathalon_datalist
+
+
+class TestLoadDecathalonDatalist(unittest.TestCase):
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _write_datalist(self, content):
+        path = os.path.join(self.tmp_dir, "datalist.json")
+        with open(path, "w") as f:
+            json.dump(content, f)
+        return path
+
+    def test_seg_values(self):
+        base_dir = os.path.join(self.tmp_dir, "data")
+        path = self._write_datalist({"training": [{"image": "imgs/a.nii.gz", "label": "labels/a.nii.gz", "fold": 1}]})
+        result = load_decathalon_datalist(path, True, "training", base_dir)
+        self.assertEqual(len(result), 1)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii.gz")))
+        self.assertEqual(result[0]["label"], os.path.normpath(os.path.join(base_dir, "labels/a.nii.gz")))
+        self.assertEqual(result[0]["fold"], 1)
+
+    def test_cls_values(self):
+        base_dir = os.path.join(self.tmp_dir, "data")
+        path = self._write_datalist({"training": [{"image": "imgs/a.nii.gz", "label": 3}]})
+        result = load_decathalon_datalist(path, False, "training", base_dir)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/a.nii.gz")))
+        self.assertIsInstance(result[0]["label"], int)
+        self.assertEqual(result[0]["label"], 3)
+
+    def test_seg_no_basedir(self):
+        image_path = os.path.join(self.tmp_dir, "a.nii.gz")
+        label_path = os.path.join(self.tmp_dir, "a_label.nii.gz")
+        path = self._write_datalist({"training": [{"image": image_path, "label": label_path}]})
+        result = load_decathalon_datalist(path, True, "training", None)
+        self.assertEqual(result[0]["image"], os.path.normpath(image_path))
+        self.assertEqual(result[0]["label"], os.path.normpath(label_path))
+
+    def test_seg_no_labels(self):
+        base_dir = os.path.join(self.tmp_dir, "data")
+        path = self._write_datalist({"test": ["imgs/t0.nii.gz", "imgs/t1.nii.gz"]})
+        result = load_decathalon_datalist(path, True, "test", base_dir)
+        self.assertEqual(result[0]["image"], os.path.normpath(os.path.join(base_dir, "imgs/t0.nii.gz")))
+
+
+if __name__ == "__main__":
+    unittest.main()
