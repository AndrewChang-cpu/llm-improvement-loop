+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_index_patches(item):
+    # module-level so that the dataset can be pickled for spawned DataLoader workers
+    for index, char in enumerate(item):
+        yield (char, index)
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcd", "efghij", "klmnopq"]
+        expected = sorted("".join(items))
+        ds = GridPatchDataset(dataset=items, patch_iter=_char_index_patches, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        output = [char for batch in DataLoader(ds, batch_size=3, num_workers=num_workers) for char in batch]
+
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), expected)
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process
+        single_batches = []
+        for batch in DataLoader(ds, batch_size=2, num_workers=0):
+            patches, coords = batch
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            single_batches.append((patches, coords))
+
+        patches, coords = single_batches[-1]
+        np.testing.assert_allclose(patches[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(patches[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0)
+        expected_coords = [[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]]
+        self.assertEqual(coords.tolist(), expected_coords)
+
+        # two workers, reusing the same dataset, transform and generator
+        if sys.platform != "win32":
+            multi_batches = []
+            for batch in DataLoader(ds, batch_size=2, num_workers=2):
+                patches, coords = batch
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                multi_batches.append((patches, coords))
+
+            self.assertEqual(len(multi_batches), len(single_batches))
+            patches, coords = multi_batches[-1]
+            self.assertEqual(coords.tolist(), expected_coords)
+            np.testing.assert_allclose(patches[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3, atol=0)
+            np.testing.assert_allclose(
+                patches[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3, atol=0
+            )
+
+    def test_missing_length(self):
+        class _NoLength:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        ds = GridPatchDataset(dataset=_NoLength(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
