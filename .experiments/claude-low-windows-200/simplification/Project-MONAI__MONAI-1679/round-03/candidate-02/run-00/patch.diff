+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # each patch has shape (1, 2, 2); its coordinates have shape (3, 2), one row per dimension
+        # including the channel, and each row is [start, stop] in the original image
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # two workers split the two images between them
