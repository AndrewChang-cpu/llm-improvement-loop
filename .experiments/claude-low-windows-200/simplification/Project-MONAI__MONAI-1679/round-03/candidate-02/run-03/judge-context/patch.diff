+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patch_iter(item):
+    # module level so that it can be pickled for multi-worker DataLoaders
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["abcd", "efgh"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=_char_patch_iter, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = [c for batch in loader for c in batch]
+        expected = "".join(test_data)
+        self.assertEqual(sorted(output), sorted(expected))
+        self.assertEqual(len(output), len(expected))
+
+    def test_missing_length(self):
+        # a generator has no len(), so the dataset must refuse to iterate
+        dataset = GridPatchDataset(dataset=(s for s in ["ab"]), patch_iter=_char_patch_iter)
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4) for _ in range(2)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = list(loader)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = batches[-1]
+        np.testing.assert_allclose(
+            patches[0][0].numpy(), np.array([[1.7413, 2.7413], [5.7413, 6.7413]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_allclose(
+            patches[1][0].numpy(), np.array([[9.1419, 10.1419], [13.1419, 14.1419]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_array_equal(coords[0].numpy(), np.array([[0, 1], [0, 2], [2, 4]]))
+        np.testing.assert_array_equal(coords[1].numpy(), np.array([[0, 1], [2, 4], [2, 4]]))
+        single_coords = coords.numpy()
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+            batches = list(loader)
+            for patches, _ in batches:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+            patches, coords = batches[-1]
+            np.testing.assert_array_equal(coords.numpy(), single_coords)
+            np.testing.assert_allclose(
+                patches[0][0].numpy(), np.array([[2.3944, 3.3944], [6.3944, 7.3944]]), rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                patches[1][0].numpy(), np.array([[10.6551, 11.6551], [14.6551, 15.6551]]), rtol=1e-3, atol=0
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
