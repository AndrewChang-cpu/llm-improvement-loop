+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_iter(item):
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class NoLengthDataset:
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcd", "efghij", "kl"]
+        expected = [c for item in items for c in item]
+        dataset = GridPatchDataset(dataset=items, patch_iter=char_patch_iter, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for batch in loader:
+            output.extend(batch)
+
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        for patches, coords in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+        final_patches, final_coords = batches[-1][0].numpy(), batches[-1][1].numpy()
+
+        expected_patches = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        np.testing.assert_allclose(final_patches, expected_patches, rtol=1e-5, atol=0)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_array_equal(final_coords, expected_coords)
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            batches_mp = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            self.assertEqual(len(batches_mp), len(batches))
+            for patches, coords in batches_mp:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            final_patches_mp, final_coords_mp = batches_mp[-1][0].numpy(), batches_mp[-1][1].numpy()
+
+            expected_patches_mp = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            np.testing.assert_allclose(final_patches_mp, expected_patches_mp, rtol=1e-3, atol=0)
+            np.testing.assert_array_equal(final_coords_mp, expected_coords)
+
+    def test_missing_length(self):
+        dataset = GridPatchDataset(dataset=NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as context:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(context.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
