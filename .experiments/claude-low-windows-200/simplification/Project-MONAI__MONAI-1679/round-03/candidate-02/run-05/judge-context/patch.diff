+import os
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patch_gen(item):
+    # module-level so that the dataset can be pickled for multi-process loading under the spawn start method
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcd", "efg", "hi"]
+        num_workers = 0 if os.name == "nt" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=_char_patch_gen, with_coordinates=False)
+
+        output = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            output.extend(batch)
+
+        expected = sorted("".join(items))
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process: 2 images x 4 patches, batch size 2
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        self.assertEqual(len(batches), 4)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = batches[-1]
+        patches, coords = patches.numpy(), coords.numpy()
+        np.testing.assert_allclose(patches[0, 0], [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(patches[1, 0], [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords[0], [[0, 1], [0, 2], [2, 4]])
+        np.testing.assert_array_equal(coords[1], [[0, 1], [2, 4], [2, 4]])
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if os.name != "nt":
+            batches_mp = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            self.assertEqual(len(batches_mp), 4)
+            for patches, _ in batches_mp:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+            patches, coords = batches_mp[-1]
+            patches, coords = patches.numpy(), coords.numpy()
+            np.testing.assert_array_equal(coords[0], [[0, 1], [0, 2], [2, 4]])
+            np.testing.assert_array_equal(coords[1], [[0, 1], [2, 4], [2, 4]])
+            np.testing.assert_allclose(patches[0, 0], [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3, atol=0)
+            np.testing.assert_allclose(patches[1, 0], [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3, atol=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
