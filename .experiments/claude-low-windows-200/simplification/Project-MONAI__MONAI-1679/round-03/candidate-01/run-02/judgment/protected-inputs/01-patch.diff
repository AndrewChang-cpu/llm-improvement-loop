+import sys
+import unittest
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+
+from monai.data import GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patches(item):
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcd", "efg", "hijkl"]
+        dataset = GridPatchDataset(dataset=items, patch_iter=char_patches, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = [char for batch in loader for char in batch]
+        self.assertEqual(sorted(output), sorted("".join(items)))
+        self.assertEqual(len(output), len("".join(items)))
+
+    def test_missing_length(self):
+        class NoLength:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(dataset=NoLength(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = list(loader)
+        for patch, _ in batches:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+        patch, coords = batches[-1]
+        np.testing.assert_allclose(
+            patch[0, 0].numpy(), np.array([[1.7413, 2.7413], [5.7413, 6.7413]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_allclose(
+            patch[1, 0].numpy(), np.array([[9.1419, 10.1419], [13.1419, 14.1419]]), rtol=1e-5, atol=0
+        )
+        self.assertEqual(coords[0].tolist(), [[0, 1], [0, 2], [2, 4]])
+        self.assertEqual(coords[1].tolist(), [[0, 1], [2, 4], [2, 4]])
+        single_coords = coords
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+            batches = list(loader)
+            for patch, _ in batches:
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+            patch, coords = batches[-1]
+            self.assertEqual(coords.tolist(), single_coords.tolist())
+            np.testing.assert_allclose(
+                patch[0, 0].numpy(), np.array([[2.3944, 3.3944], [6.3944, 7.3944]]), rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                patch[1, 0].numpy(), np.array([[10.6551, 11.6551], [14.6551, 15.6551]]), rtol=1e-3, atol=0
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
