+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_generator(item):
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcdef", "ghijk", "lmnopqr"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=char_generator, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = [char for batch in loader for char in batch]
+        expected = [char for item in items for char in item]
+        self.assertEqual(sorted(output), sorted(expected))
+        self.assertEqual(len(output), len(expected))
+
+    def test_missing_length(self):
+        class NoLength:
+            def __getitem__(self, index):
+                return index
+
+        with self.assertRaises(NotImplementedError) as context:
+            GridPatchDataset(dataset=NoLength(), patch_iter=char_generator)
+        self.assertIn("image dataset must implement `len()`.", str(context.exception))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4) for _ in range(2)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process block
+        for patch, coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+        patch, coords = patch.numpy(), coords.numpy()
+
+        expected_patch = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        np.testing.assert_allclose(patch, expected_patch, rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords[0], [[0, 1], [0, 2], [2, 4]])
+        np.testing.assert_array_equal(coords[1], [[0, 1], [2, 4], [2, 4]])
+
+        if sys.platform == "win32":
+            return
+
+        # two-worker block, reusing the same dataset, transform and generator objects
+        for patch, coords_mp in DataLoader(dataset, batch_size=2, num_workers=2):
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+        patch, coords_mp = patch.numpy(), coords_mp.numpy()
+
+        expected_mp_patch = np.array(
+            [
+                [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+            ]
+        )
+        np.testing.assert_allclose(patch, expected_mp_patch, rtol=1e-3, atol=0)
+        np.testing.assert_array_equal(coords_mp, coords)
+
+
+if __name__ == "__main__":
+    unittest.main()
