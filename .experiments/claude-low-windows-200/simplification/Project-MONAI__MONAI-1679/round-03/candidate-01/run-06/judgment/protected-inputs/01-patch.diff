+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _iter_chars(item):
+    """Patch generator yielding one (character, index) tuple per character of a string item."""
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcdefg", "hijklmn", "opqrstu"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=_iter_chars, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = sorted(char for batch in loader for char in batch)
+
+        self.assertEqual(output, sorted("".join(items)))
+        self.assertEqual(len(output), sum(len(item) for item in items))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process block
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = list(loader)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = batches[-1]
+        expected = np.array([[[1.7413, 2.7413], [5.7413, 6.7413]], [[9.1419, 10.1419], [13.1419, 14.1419]]])
+        np.testing.assert_allclose(patches.numpy()[:, 0], expected, rtol=1e-5, atol=0)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+        # two-worker block, reuses the same dataset, transform and generator objects
+        if sys.platform == "win32":
+            return
+        loader = DataLoader(dataset, batch_size=2, num_workers=2)
+        batches = list(loader)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = batches[-1]
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+        expected = np.array([[[2.3944, 3.3944], [6.3944, 7.3944]], [[10.6551, 11.6551], [14.6551, 15.6551]]])
+        np.testing.assert_allclose(patches.numpy()[:, 0], expected, rtol=1e-3, atol=0)
+
+    def test_missing_length(self):
+        class _NoLength:
+            def __getitem__(self, index):
+                return np.zeros((1, 2, 2))
+
+        dataset = GridPatchDataset(dataset=_NoLength(), patch_iter=PatchIter(patch_size=(1, 1)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
