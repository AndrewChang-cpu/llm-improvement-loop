+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches sampled on a contiguous grid from each image of an input dataset. The patches are generated by a
+    patch generator, such as :py:class:`PatchIter`, and each patch can be post-processed by a transform.
+
+    Each patch has the full channel dimension and the spatial size requested by the patch generator, and is taken from
+    a padded copy of the image so that border patches are valid. When `with_coordinates` is True, each element is a
+    ``(patch, coordinates)`` pair, where the coordinates are an integer array of shape (dimensions including channel, 2)
+    giving the ``[start, stop]`` of each dimension in the original image.
+
+    For example, for single-channel 2D images of shape (1, 4, 4), with a patch size of (2, 2) and start position
+    (0, 0), each patch has shape (1, 2, 2) and its coordinates have shape (3, 2):
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator, the channel is not part of patch_size
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+    """
