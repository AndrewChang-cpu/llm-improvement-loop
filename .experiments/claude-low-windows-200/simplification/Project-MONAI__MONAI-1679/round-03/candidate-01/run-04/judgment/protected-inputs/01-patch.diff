+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patches(item):
+    # module-level so that it can be pickled for multi-worker data loaders
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcd", "efg", "hij"]
+        expected = sorted(c for item in items for c in item)
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        dataset = GridPatchDataset(dataset=items, patch_iter=_char_patches, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        out = []
+        for batch in loader:
+            out.extend(batch)
+
+        self.assertEqual(len(out), len(expected))
+        self.assertEqual(sorted(out), expected)
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process block
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = list(loader)
+        self.assertEqual(len(batches), 4)
+        for patch, _ in batches:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+        patch, coords = batches[-1]
+        np.testing.assert_allclose(
+            patch[0, 0].numpy(), np.array([[1.7413, 2.7413], [5.7413, 6.7413]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_allclose(
+            patch[1, 0].numpy(), np.array([[9.1419, 10.1419], [13.1419, 14.1419]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_array_equal(coords[0].numpy(), np.array([[0, 1], [0, 2], [2, 4]]))
+        np.testing.assert_array_equal(coords[1].numpy(), np.array([[0, 1], [2, 4], [2, 4]]))
+
+        # two-worker block, reuses the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+            batches_mp = list(loader)
+            self.assertEqual(len(batches_mp), 4)
+            for patch, _ in batches_mp:
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+            patch_mp, coords_mp = batches_mp[-1]
+            np.testing.assert_array_equal(coords_mp.numpy(), coords.numpy())
+            np.testing.assert_allclose(
+                patch_mp[0, 0].numpy(), np.array([[2.3944, 3.3944], [6.3944, 7.3944]]), rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                patch_mp[1, 0].numpy(), np.array([[10.6551, 11.6551], [14.6551, 15.6551]]), rtol=1e-3, atol=0
+            )
+
+    def test_missing_len(self):
+        class _NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(dataset=_NoLen(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
