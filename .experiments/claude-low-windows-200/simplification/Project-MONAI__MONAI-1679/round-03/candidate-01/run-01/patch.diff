+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def character_patches(item):
+    """Patch generator yielding one (character, index) tuple per character of the item."""
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["test1", "test22", "test333"]
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=character_patches, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = [char for batch in loader for char in batch]
+        expected = [char for item in test_data for char in item]
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process data loader
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = list(loader)
+        self.assertEqual(len(batches), 4)
+        for patch, _ in batches:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+        patch, coords = batches[-1]
+        np.testing.assert_allclose(patch[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(patch[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0)
+        expected_coords = np.array([[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]])
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+        if sys.platform == "win32":
+            return
+
+        # two-worker data loader, reusing the same dataset, transform and generator objects
+        mp_loader = DataLoader(dataset, batch_size=2, num_workers=2)
+        mp_batches = list(mp_loader)
+        self.assertEqual(len(mp_batches), 4)
+        for mp_patch, _ in mp_batches:
+            self.assertEqual(tuple(mp_patch.shape), (2, 1, 2, 2))
+
+        mp_patch, mp_coords = mp_batches[-1]
+        np.testing.assert_array_equal(mp_coords.numpy(), coords.numpy())
+        np.testing.assert_allclose(mp_patch[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3)
+        np.testing.assert_allclose(mp_patch[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
