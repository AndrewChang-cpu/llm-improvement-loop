+class GridPatchDataset(IterableDataset):
+    """
+    Yields grid-sampled patches from the images of an input dataset. A patch generator (for example ``PatchIter``)
+    produces the patches of each image, and an optional transform is applied to each patch on its own.
+
+    Each patch has the channel dimension and the requested spatial size, e.g. a single-channel 2D image gives
+    patches of shape (1, height, width). Coordinates are an integer array of shape (dimensions including channel, 2),
+    where row i is ``[start_i, stop_i]`` in the original unpadded image. The channel row is ``[0, C]``.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 2D images of shape (1, 4, 4)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches from start position (0, 0) of the channel-first image
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset, each element is a (patch, coordinates) pair
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # two-worker data loader, each batch holds 2 patches and their coordinates
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
