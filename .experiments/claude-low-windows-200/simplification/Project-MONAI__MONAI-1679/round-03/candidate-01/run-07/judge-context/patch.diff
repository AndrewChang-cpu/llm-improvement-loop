+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. Each image item is sampled by a patch generator, such as
+    `PatchIter`, in a contiguous grid sampling scheme, and each patch can be transformed individually.
+
+    Each patch has the full channel dimension and the spatial size chosen by the patch generator. With
+    `with_coordinates` True, each element is a (patch, coordinates) pair. The coordinates are an integer array of shape
+    (dimensions including channel, 2) with one row per dimension, where row i is ``[start_i, stop_i]`` in the original
+    unpadded image. The channel row is always ``[0, C]``. Stop can exceed the image extent for border patches.
+
+    For example, to sample 2x2 patches from single-channel 4x4 images, with a per-patch intensity shift and two
+    workers:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 spatial patches, grid sampling from position (0, 0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset, 4 patches per image
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
+
+    def __init__(
