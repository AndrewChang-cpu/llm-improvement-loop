+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patches(item):
+    # one (character, index) tuple per character of the image item
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class _NoLengthDataset:
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["abcdefgh", "ijklmn", "opqrst"]
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=_char_patches, with_coordinates=False)
+        # the spawn start method is used on Windows, so use a single process there
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        result = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(batch)
+
+        expected = sorted("".join(test_data))
+        self.assertEqual(len(result), len(expected))
+        self.assertEqual(sorted(result), expected)
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        # two single-channel 4x4 images with values 0 to 15
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process block
+        for patch, coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+        expected_patch = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_allclose(patch.numpy(), expected_patch, rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+        single_coords = coords.numpy()
+
+        # two-worker block, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            for patch, coords in DataLoader(dataset, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+            expected_patch_mp = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            np.testing.assert_array_equal(coords.numpy(), single_coords)
+            np.testing.assert_allclose(patch.numpy(), expected_patch_mp, rtol=1e-3, atol=0)
+
+    def test_missing_length(self):
+        dataset = GridPatchDataset(dataset=_NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as context:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(context.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
