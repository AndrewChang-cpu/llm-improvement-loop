+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator, and an optional transform is applied to each patch. Each image item is a single
+    channel-first array. The patch generator is typically a :py:class:`PatchIter`, which fixes the patch size and start
+    position. The transform receives only the patch, never the coordinates.
+
+    With the default ``with_coordinates=True`` each element is a ``(patch, coordinates)`` pair. The coordinates are an
+    integer array of shape (dimensions including channel, 2), where each row is the ``[start, stop]`` of that dimension
+    in the original, unpadded image. For example, a one-channel 4x4 image sampled with 2x2 patches gives patches of
+    shape (1, 2, 2) and coordinates of shape (3, 2), with channel row ``[0, 1]``.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # grid of 2x2 patches starting at position (0, 0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each image gives four patches, so eight patches in total
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
