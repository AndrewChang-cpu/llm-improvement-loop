+import sys
+import unittest
+
+import numpy as np
+from torch.utils.data import DataLoader
+
+from monai.data import GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_iter(item):
+    # module-level so that it can be pickled by the spawn start method of multi-worker data loaders
+    for index, char in enumerate(item):
+        yield (char, index)
+
+
+class _NoLengthDataset:
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["test", "string"]
+        ds = GridPatchDataset(dataset=items, patch_iter=_char_iter, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(ds, batch_size=3, num_workers=num_workers)
+
+        output = [char for batch in loader for char in batch]
+        expected = [char for item in items for char in item]
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process
+        last_batch = None
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_batch = (patches, coords)
+        patches, coords = last_batch
+        np.testing.assert_allclose(patches[0].numpy(), [[[1.7413, 2.7413], [5.7413, 6.7413]]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(patches[1].numpy(), [[[9.1419, 10.1419], [13.1419, 14.1419]]], rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+        np.testing.assert_array_equal(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+        single_process_coords = coords.numpy()
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            last_batch = None
+            for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                last_batch = (patches, coords)
+            patches, coords = last_batch
+            np.testing.assert_array_equal(coords.numpy(), single_process_coords)
+            np.testing.assert_allclose(patches[0].numpy(), [[[2.3944, 3.3944], [6.3944, 7.3944]]], rtol=1e-3, atol=0)
+            np.testing.assert_allclose(
+                patches[1].numpy(), [[[10.6551, 11.6551], [14.6551, 15.6551]]], rtol=1e-3, atol=0
+            )
+
+    def test_missing_length(self):
+        ds = GridPatchDataset(dataset=_NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as context:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`.", str(context.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
