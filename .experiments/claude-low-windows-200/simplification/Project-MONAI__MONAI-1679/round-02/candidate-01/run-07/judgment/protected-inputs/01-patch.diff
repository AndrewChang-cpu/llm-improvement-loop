+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# coordinates of the final batch, shape (2 patches, 3 dimensions including channel, [start, stop])
+EXPECTED_COORDS = np.array([[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]])
+
+
+def char_iter(item):
+    # module-level patch generator: one (character, index) tuple per character of the item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        expected = sorted("".join(test_dataset))
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_iter, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), expected)
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        # image dataset
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shifts
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process
+        for item in DataLoader(ds, batch_size=2, shuffle=False, num_workers=0):
+            np.testing.assert_equal(tuple(item[0].shape), (2, 1, 2, 2))
+        np.testing.assert_allclose(
+            item[0][0].numpy(), np.array([[[1.7413, 2.7413], [5.7413, 6.7413]]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_allclose(
+            item[0][1].numpy(), np.array([[[9.1419, 10.1419], [13.1419, 14.1419]]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_equal(item[1].numpy(), EXPECTED_COORDS)
+
+        if sys.platform != "win32":
+            # two workers, reusing the same dataset, transform and generator objects
+            for item in DataLoader(ds, batch_size=2, shuffle=False, num_workers=2):
+                np.testing.assert_equal(tuple(item[0].shape), (2, 1, 2, 2))
+            np.testing.assert_equal(item[1].numpy(), EXPECTED_COORDS)
+            np.testing.assert_allclose(
+                item[0][0].numpy(), np.array([[[2.3944, 3.3944], [6.3944, 7.3944]]]), rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                item[0][1].numpy(), np.array([[[10.6551, 11.6551], [14.6551, 15.6551]]]), rtol=1e-3, atol=0
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
