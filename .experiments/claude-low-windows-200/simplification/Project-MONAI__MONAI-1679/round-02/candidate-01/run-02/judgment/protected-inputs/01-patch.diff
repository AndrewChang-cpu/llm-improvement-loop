+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_generator(item):
+    # yields one (character, index) tuple per character of the item
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class NoLengthDataset:
+    # image dataset which does not implement len()
+    def __getitem__(self, index):
+        return np.zeros((1, 2, 2))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_generator, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        self.assertEqual(len(output), 15)
+        self.assertEqual(sorted(output), sorted("vwxyzhelloworld"))
+
+    def test_loading_array(self):
+        # image dataset
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator and patch-level intensity shifts
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=0):
+            np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+        # final batch: patches from the second image
+        np.testing.assert_allclose(
+            patches[0].numpy(), np.array([[[1.7413, 2.7413], [5.7413, 6.7413]]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_allclose(
+            patches[1].numpy(), np.array([[[9.1419, 10.1419], [13.1419, 14.1419]]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_equal(coords[0].numpy(), np.array([[0, 1], [0, 2], [2, 4]]))
+        np.testing.assert_equal(coords[1].numpy(), np.array([[0, 1], [2, 4], [2, 4]]))
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            for mp_patches, mp_coords in DataLoader(ds, batch_size=2, num_workers=2):
+                np.testing.assert_equal(tuple(mp_patches.shape), (2, 1, 2, 2))
+            np.testing.assert_allclose(
+                mp_patches[0].numpy(), np.array([[[2.3944, 3.3944], [6.3944, 7.3944]]]), rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                mp_patches[1].numpy(), np.array([[[10.6551, 11.6551], [14.6551, 15.6551]]]), rtol=1e-3, atol=0
+            )
+            np.testing.assert_equal(mp_coords.numpy(), coords.numpy())
+
+    def test_missing_length(self):
+        ds = GridPatchDataset(dataset=NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(ds)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
