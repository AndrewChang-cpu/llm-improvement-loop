+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_iter(item):
+    # module-level so that it can be pickled for multi-worker loading under the spawn start method
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class _NoLenDataset:
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abc", "defg", "hi"]
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        dataset = GridPatchDataset(dataset=items, patch_iter=_char_iter, with_coordinates=False)
+        output = [c for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers) for c in batch]
+
+        self.assertEqual(len(output), len("".join(items)))
+        self.assertEqual(sorted(output), sorted("".join(items)))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process loading
+        num_batches = 0
+        for item in DataLoader(dataset, batch_size=2, num_workers=0):
+            num_batches += 1
+            self.assertEqual(tuple(item[0].shape), (2, 1, 2, 2))
+        self.assertEqual(num_batches, 4)
+
+        expected_patches = np.array([[[[1.7413, 2.7413], [5.7413, 6.7413]]], [[[9.1419, 10.1419], [13.1419, 14.1419]]]])
+        np.testing.assert_allclose(item[0].numpy(), expected_patches, rtol=1e-5, atol=0)
+        expected_coords = np.array([[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]])
+        np.testing.assert_array_equal(item[1].numpy(), expected_coords)
+
+        # two-worker loading, reusing the same dataset, transform and generator objects
+        if sys.platform == "win32":
+            return
+        num_batches = 0
+        for item in DataLoader(dataset, batch_size=2, num_workers=2):
+            num_batches += 1
+            self.assertEqual(tuple(item[0].shape), (2, 1, 2, 2))
+        self.assertEqual(num_batches, 4)
+
+        np.testing.assert_array_equal(item[1].numpy(), expected_coords)
+        expected_patches_2w = np.array(
+            [[[[2.3944, 3.3944], [6.3944, 7.3944]]], [[[10.6551, 11.6551], [14.6551, 15.6551]]]]
+        )
+        np.testing.assert_allclose(item[0].numpy(), expected_patches_2w, rtol=1e-3, atol=0)
+
+    def test_missing_length(self):
+        dataset = GridPatchDataset(dataset=_NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
