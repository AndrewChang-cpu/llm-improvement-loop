+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_iter(item):
+    # module-level so that it can be pickled by the DataLoader workers under the spawn start method
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_iter, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        expected = sorted("".join(test_dataset))
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process block
+        single = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        for patch, _ in single:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+        patch, coords = single[-1]
+        expected_patch = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        np.testing.assert_allclose(patch.numpy(), expected_patch, rtol=1e-5, atol=0)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+        # two-worker block, reuses the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            parallel = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            self.assertEqual(len(parallel), len(single))
+            for patch, _ in parallel:
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+            patch, coords = parallel[-1]
+            np.testing.assert_array_equal(coords.numpy(), expected_coords)
+            expected_parallel = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            np.testing.assert_allclose(patch.numpy(), expected_parallel, rtol=1e-3, atol=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
