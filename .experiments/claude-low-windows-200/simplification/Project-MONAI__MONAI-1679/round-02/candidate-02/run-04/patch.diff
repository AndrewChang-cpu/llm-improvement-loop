+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_iter(item):
+    # module-level so that it can be pickled for multi-worker data loaders
+    for index, char in enumerate(item):
+        yield (char, index)
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["test_string1", "test_string2", "test_string3"]
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=_char_iter, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        result = [item for batch in loader for item in batch]
+        expected = [char for text in test_data for char in text]
+        self.assertEqual(len(result), len(expected))
+        self.assertEqual(sorted(result), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process loading
+        expected_coords = np.array([[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]])
+        expected_patch = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        patch, coords = None, None
+        for patch, coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+        np.testing.assert_allclose(patch.numpy(), expected_patch, rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+        # two-worker loading, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            expected_patch_workers = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            patch, coords = None, None
+            for patch, coords in DataLoader(dataset, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+            np.testing.assert_array_equal(coords.numpy(), expected_coords)
+            np.testing.assert_allclose(patch.numpy(), expected_patch_workers, rtol=1e-3, atol=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
