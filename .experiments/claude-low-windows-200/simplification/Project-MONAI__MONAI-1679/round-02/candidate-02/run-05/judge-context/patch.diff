+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_iter(item):
+    # one (character, index) tuple per character of the item
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["test", "patch", "grid", "dataset"]
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        ds = GridPatchDataset(dataset=items, patch_iter=char_patch_iter, with_coordinates=False)
+        loader = DataLoader(ds, batch_size=3, num_workers=num_workers)
+
+        output = [char for batch in loader for char in batch]
+        expected = [char for item in items for char in item]
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process
+        last_patch, last_coords = None, None
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+            last_patch, last_coords = patch, coords
+
+        np.testing.assert_allclose(last_patch[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(last_patch[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(last_coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+        np.testing.assert_array_equal(last_coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            last_patch, last_coords = None, None
+            for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+                last_patch, last_coords = patch, coords
+
+            np.testing.assert_array_equal(last_coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+            np.testing.assert_array_equal(last_coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+            np.testing.assert_allclose(
+                last_patch[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                last_patch[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3, atol=0
+            )
+
+    def test_missing_len(self):
+        # an iterator has no len(), so iteration must fail with a clear message
+        ds = GridPatchDataset(dataset=iter([np.zeros((1, 4, 4))]), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
