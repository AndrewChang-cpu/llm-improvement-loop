+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an image dataset. Each image is passed to a patch generator, such as
+    :py:class:`PatchIter`, which samples it on a contiguous grid. Each patch can then be transformed by `transform`.
+    Patches are taken with the full channel extent and the requested spatial size. Patch values are views into a
+    padded copy of the image, so in-place changes do not alter the source image.
+
+    By default each element is a (patch, coordinates) pair. The coordinates are an integer array with one row per
+    dimension, channel included, and each row is ``[start, stop]`` of that dimension in the original image. For
+    example, with a patch shape of (1, 2, 2) from a channel-first 2D image, the coordinates have shape (3, 2).
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # grid patch generator: 2x2 spatial patches starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each patch has shape (1, 2, 2), and its coordinates have shape (3, 2)
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
