+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def pick_chars(item):
+    # generator yielding one (character, index) tuple per character of the item
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class NoLenDataset:
+    # image dataset without `len()`
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        dataset = GridPatchDataset(dataset=test_dataset, patch_iter=pick_chars, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        result = []
+        for item in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(item)
+
+        self.assertEqual(sorted(result), sorted("".join(test_dataset)))
+        self.assertEqual(len(result), sum(len(s) for s in test_dataset))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process block
+        single_batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        for patches, _ in single_batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = single_batches[-1]
+        np.testing.assert_allclose(patches[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(patches[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+        np.testing.assert_array_equal(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+
+        # two-worker block, reuses the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            multi_batches = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            self.assertEqual(len(multi_batches), len(single_batches))
+            for patches, _ in multi_batches:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+            patches, coords = multi_batches[-1]
+            np.testing.assert_array_equal(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+            np.testing.assert_array_equal(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+            np.testing.assert_allclose(patches[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3, atol=0)
+            np.testing.assert_allclose(
+                patches[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3, atol=0
+            )
+
+    def test_missing_len(self):
+        dataset = GridPatchDataset(dataset=NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
