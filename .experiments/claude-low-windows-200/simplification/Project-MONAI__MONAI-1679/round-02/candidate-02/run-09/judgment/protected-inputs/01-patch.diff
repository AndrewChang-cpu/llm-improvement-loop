+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset, using grid sampling. The patches are produced by a
+    patch generator, such as `PatchIter`, and each patch can be post-processed by a transform.
+
+    Each item of `dataset` is a single channel-first image. The patch generator is called once per item and yields
+    (patch, coordinates) tuples. The transform, if set, is applied to each patch alone. With `with_coordinates` true
+    (the default) the dataset yields (transformed patch, coordinates) pairs, otherwise only the transformed patch.
+    Coordinates are an integer array with one row per dimension, channel included, giving the [start, stop] of that
+    dimension in the original image. The channel row is always [0, C] for C channels.
+
+    For example, with two single-channel 4x4 images, patches of shape (1, 2, 2) and coordinates of shape (3, 2):
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # first patch coordinates: channel [0, 1], then rows (dimension 1 and 2) [0, 2], [0, 2]
+        patch, coords = next(iter(patch_iter(images[0])))
+        print(coords.tolist())
+
+        >>> [[0, 1], [0, 2], [0, 2]]
+
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
