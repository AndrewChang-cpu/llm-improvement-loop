+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. A patch generator (such as :py:class:`PatchIter`)
+    samples each image item in a contiguous grid, and an optional transform is applied to each patch on its own.
+
+    For example, to sample 2x2 patches from two single-channel 4x4 images, shifting the intensity of each patch:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset, each item is a channel-first array
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator, 2x2 spatial patches starting from position (0, 0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset, with coordinates by default
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each image gives four patches of shape (1, 2, 2), with coordinates of shape (3, 2)
+        for patch, coords in DataLoader(ds, batch_size=4, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([4, 1, 2, 2]) torch.Size([4, 3, 2])
+        >>> torch.Size([4, 1, 2, 2]) torch.Size([4, 3, 2])
+
+    Each patch has the channel dimension and the requested spatial size. Each coordinate array has one row per
+    dimension, channel included, and each row is ``[start, stop]`` in the original, unpadded image. The channel row
+    is ``[0, C]``. Set `with_coordinates` to False to yield only the patches.
