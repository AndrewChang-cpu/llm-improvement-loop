+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# expected values for the final batch of the two images in `test_loading_array`
+EXPECTED_PATCH = np.array(
+    [
+        [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+        [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+    ]
+)
+EXPECTED_COORDS = np.array(
+    [
+        [[0, 1], [0, 2], [2, 4]],
+        [[0, 1], [2, 4], [2, 4]],
+    ]
+)
+# two-worker values for the final batch, these differ from the single-process values
+EXPECTED_PATCH_TWO_WORKERS = np.array(
+    [
+        [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+        [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+    ]
+)
+
+
+def _char_iter(item):
+    # patch generator yielding one (character, index) tuple per character of the item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class _NoLenDataset:
+    # image dataset which does not implement `len()`
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=_char_iter, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        expected = sorted("".join(test_dataset))
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process loading
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        for patch, _ in batches:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+        patch, coords = batches[-1]
+        np.testing.assert_allclose(np.asarray(patch), EXPECTED_PATCH, rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(np.asarray(coords), EXPECTED_COORDS)
+
+        # two-worker loading, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            batches = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            self.assertEqual(len(batches), 4)
+            for patch, _ in batches:
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+            patch, coords = batches[-1]
+            np.testing.assert_array_equal(np.asarray(coords), EXPECTED_COORDS)
+            np.testing.assert_allclose(np.asarray(patch), EXPECTED_PATCH_TWO_WORKERS, rtol=1e-3, atol=0)
+
+    def test_missing_len(self):
+        dataset = GridPatchDataset(dataset=_NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
