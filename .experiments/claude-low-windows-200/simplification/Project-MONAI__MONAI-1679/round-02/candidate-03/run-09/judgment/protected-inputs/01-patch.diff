+
+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_iter(item):
+    """Module-level patch generator, so it can be pickled for spawned workers."""
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcdefgh", "ijklmnop", "qrstuvwx"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=_char_iter, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = [char for batch in loader for char in batch]
+
+        self.assertEqual(len(output), 24)
+        self.assertEqual(sorted(output), sorted("".join(items)))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process block
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        last_patches, last_coords = None, None
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+
+        np.testing.assert_allclose(
+            last_patches[0, 0].numpy(), np.array([[1.7413, 2.7413], [5.7413, 6.7413]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_allclose(
+            last_patches[1, 0].numpy(), np.array([[9.1419, 10.1419], [13.1419, 14.1419]]), rtol=1e-5, atol=0
+        )
+        np.testing.assert_array_equal(last_coords[0].numpy(), np.array([[0, 1], [0, 2], [2, 4]]))
+        np.testing.assert_array_equal(last_coords[1].numpy(), np.array([[0, 1], [2, 4], [2, 4]]))
+
+        # two-worker block, reuses the same dataset, transform and generator objects
+        if sys.platform == "win32":
+            return
+        loader = DataLoader(dataset, batch_size=2, num_workers=2)
+        last_patches, last_coords = None, None
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+
+        np.testing.assert_allclose(
+            last_patches[0, 0].numpy(), np.array([[2.3944, 3.3944], [6.3944, 7.3944]]), rtol=1e-3, atol=0
+        )
+        np.testing.assert_allclose(
+            last_patches[1, 0].numpy(), np.array([[10.6551, 11.6551], [14.6551, 15.6551]]), rtol=1e-3, atol=0
+        )
+        np.testing.assert_array_equal(last_coords[0].numpy(), np.array([[0, 1], [0, 2], [2, 4]]))
+        np.testing.assert_array_equal(last_coords[1].numpy(), np.array([[0, 1], [2, 4], [2, 4]]))
+
+
+if __name__ == "__main__":
+    unittest.main()
