+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_generator(item):
+    # module-scope so that the two-worker DataLoader can pickle the dataset under the spawn start method
+    for index, char in enumerate(item):
+        yield (char, index)
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abc", "defg", "hi"]
+        dataset = GridPatchDataset(dataset=items, patch_iter=_char_generator, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for batch in loader:
+            output.extend(batch)
+
+        self.assertEqual(len(output), 9)
+        self.assertEqual(sorted(output), sorted("".join(items)))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = list(loader)
+        self.assertEqual(len(batches), 4)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = batches[-1]
+        np.testing.assert_allclose(patches[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(patches[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+        np.testing.assert_array_equal(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+            batches = list(loader)
+            self.assertEqual(len(batches), 4)
+            for patches, _ in batches:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+            patches, coords = batches[-1]
+            np.testing.assert_array_equal(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+            np.testing.assert_array_equal(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+            np.testing.assert_allclose(
+                patches[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                patches[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3, atol=0
+            )
+
+    def test_missing_len(self):
+        class _IterableOnly:
+            def __iter__(self):
+                return iter([np.zeros((1, 4, 4))])
+
+        dataset = GridPatchDataset(dataset=_IterableOnly(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
