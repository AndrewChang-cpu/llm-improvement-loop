+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. Each image item is passed to a patch generator, such
+    as :py:class:`PatchIter`, which samples patches in a contiguous grid. Each patch is then transformed by `transform`
+    (if set) and yielded together with its coordinates (if `with_coordinates` is True).
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import ShiftIntensity
+
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches grid sampled from position (0, 0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = ShiftIntensity(offset=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each patch has shape (1, 2, 2) and each coordinate array has shape (3, 2): one row per dimension
+        # including the channel, each row is [start, stop]
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
