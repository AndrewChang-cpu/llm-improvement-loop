+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_generator(item):
+    # patch generator yielding (character, index) tuples, one per character of the item
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_generator, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        self.assertEqual(sorted(output), sorted("".join(test_dataset)))
+        self.assertEqual(len(output), 15)
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process: check the shape of every batch, then the final batch
+        for item in DataLoader(ds, batch_size=2, shuffle=False, num_workers=0):
+            np.testing.assert_equal(tuple(item[0].shape), (2, 1, 2, 2))
+        np.testing.assert_allclose(
+            np.asarray(item[0][0]),
+            np.array([[[1.7413, 2.7413], [5.7413, 6.7413]]]),
+            rtol=1e-5,
+        )
+        np.testing.assert_allclose(
+            np.asarray(item[0][1]),
+            np.array([[[9.1419, 10.1419], [13.1419, 14.1419]]]),
+            rtol=1e-5,
+        )
+        np.testing.assert_equal(np.asarray(item[1][0]), np.array([[0, 1], [0, 2], [2, 4]]))
+        np.testing.assert_equal(np.asarray(item[1][1]), np.array([[0, 1], [2, 4], [2, 4]]))
+
+        # two workers, reusing the same objects (no seeding between the blocks)
+        if sys.platform != "win32":
+            for item in DataLoader(ds, batch_size=2, shuffle=False, num_workers=2):
+                np.testing.assert_equal(tuple(item[0].shape), (2, 1, 2, 2))
+            np.testing.assert_allclose(
+                np.asarray(item[0][0]),
+                np.array([[[2.3944, 3.3944], [6.3944, 7.3944]]]),
+                rtol=1e-3,
+            )
+            np.testing.assert_allclose(
+                np.asarray(item[0][1]),
+                np.array([[[10.6551, 11.6551], [14.6551, 15.6551]]]),
+                rtol=1e-3,
+            )
+            np.testing.assert_equal(np.asarray(item[1][0]), np.array([[0, 1], [0, 2], [2, 4]]))
+            np.testing.assert_equal(np.asarray(item[1][1]), np.array([[0, 1], [2, 4], [2, 4]]))
+
+
+if __name__ == "__main__":
+    unittest.main()
