+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patch_iter(item):
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcde", "fghij", "klmno"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=_char_patch_iter, with_coordinates=False)
+
+        result = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(batch)
+
+        expected = sorted("".join(items))
+        self.assertEqual(sorted(result), expected)
+        self.assertEqual(len(result), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process iteration
+        last_batch = None
+        for batch in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(batch[0].shape), (2, 1, 2, 2))
+            last_batch = batch
+
+        patches, coords = last_batch[0].numpy(), last_batch[1].numpy()
+        expected_patches = np.array(
+            [
+                [[1.7413, 2.7413], [5.7413, 6.7413]],
+                [[9.1419, 10.1419], [13.1419, 14.1419]],
+            ]
+        )
+        np.testing.assert_allclose(patches[:, 0], expected_patches, rtol=1e-5, atol=0)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_array_equal(coords, expected_coords)
+
+        # two-worker iteration, reusing the same dataset, transform and generator objects
+        if sys.platform != "win32":
+            last_batch = None
+            for batch in DataLoader(dataset, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(batch[0].shape), (2, 1, 2, 2))
+                last_batch = batch
+
+            patches, coords = last_batch[0].numpy(), last_batch[1].numpy()
+            expected_patches = np.array(
+                [
+                    [[2.3944, 3.3944], [6.3944, 7.3944]],
+                    [[10.6551, 11.6551], [14.6551, 15.6551]],
+                ]
+            )
+            np.testing.assert_allclose(patches[:, 0], expected_patches, rtol=1e-3, atol=0)
+            np.testing.assert_array_equal(coords, expected_coords)
+
+    def test_missing_len(self):
+        class NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(dataset=NoLen(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
