+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator, and each patch can be post-processed by a transform. For example, to sample 2x2
+    patches from single-channel 4x4 images, shifting the intensity of each patch and loading with two workers:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shifts
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has shape (channel, height, width), so a batch of patches has shape (batch, 1, 2, 2). Each coordinate
+    array has one row per dimension including the channel dimension, holding ``[start, stop]`` in the original
+    image frame, so each coordinate array has shape (3, 2) and its channel row is ``[0, 1]``.
