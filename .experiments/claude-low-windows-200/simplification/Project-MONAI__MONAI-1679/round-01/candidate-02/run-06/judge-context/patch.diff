+import platform
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_index_generator(item):
+    """Yields one (character, index) tuple per character of a string item."""
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class NoLengthDataset:
+    """Image dataset which does not implement `len()`."""
+
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcdefgh", "ijklm", "nopq"]
+        num_workers = 0 if platform.system() == "Windows" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=char_index_generator, with_coordinates=False)
+
+        output = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            output.extend(batch)
+
+        expected = [char for item in items for char in item]
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+
+        # single process
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        for patch, _ in batches:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+        patch, coords = batches[-1]
+        expected_patches = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        np.testing.assert_allclose(patch.numpy(), expected_patches, rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+        # two workers, reusing the same dataset, transform and generator objects
+        if platform.system() != "Windows":
+            batches = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            for patch, _ in batches:
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+            patch, coords = batches[-1]
+            expected_patches = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            np.testing.assert_allclose(patch.numpy(), expected_patches, rtol=1e-3, atol=0)
+            np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+    def test_missing_length(self):
+        dataset = GridPatchDataset(dataset=NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
