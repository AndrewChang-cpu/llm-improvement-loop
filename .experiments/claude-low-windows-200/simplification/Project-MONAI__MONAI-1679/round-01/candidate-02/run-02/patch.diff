+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_iter(item):
+    # module-level generator so that it can be pickled for worker processes
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abcdefghij", "klmnopqrs", "tuvwxyz"]
+        expected = sorted("".join(items))
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=char_patch_iter, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for chunk in loader:
+            output.extend(chunk)
+
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process: final batch holds the 3rd and 4th patches of the second image
+        expected_coords = [[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]]
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = []
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            batches.append((patches, coords))
+        self.assertEqual(len(batches), 4)
+
+        patches, coords = batches[-1]
+        expected_patch_0 = np.array([[1.7413, 2.7413], [5.7413, 6.7413]])
+        expected_patch_1 = np.array([[9.1419, 10.1419], [13.1419, 14.1419]])
+        np.testing.assert_allclose(patches[0, 0].numpy(), expected_patch_0, rtol=1e-5, atol=0)
+        np.testing.assert_allclose(patches[1, 0].numpy(), expected_patch_1, rtol=1e-5, atol=0)
+        self.assertEqual(coords[0].tolist(), expected_coords[0])
+        self.assertEqual(coords[1].tolist(), expected_coords[1])
+
+        if sys.platform == "win32":
+            return
+
+        # two workers, reusing the same dataset, transform and generator objects without reseeding
+        loader = DataLoader(dataset, batch_size=2, num_workers=2)
+        batches = []
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            batches.append((patches, coords))
+        self.assertEqual(len(batches), 4)
+
+        patches, coords = batches[-1]
+        expected_patch_0 = np.array([[2.3944, 3.3944], [6.3944, 7.3944]])
+        expected_patch_1 = np.array([[10.6551, 11.6551], [14.6551, 15.6551]])
+        np.testing.assert_allclose(patches[0, 0].numpy(), expected_patch_0, rtol=1e-3, atol=0)
+        np.testing.assert_allclose(patches[1, 0].numpy(), expected_patch_1, rtol=1e-3, atol=0)
+        self.assertEqual(coords[0].tolist(), expected_coords[0])
+        self.assertEqual(coords[1].tolist(), expected_coords[1])
+
+
+if __name__ == "__main__":
+    unittest.main()
