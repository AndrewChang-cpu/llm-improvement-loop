+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items of an input dataset. The patches are chosen by a patch generator, such as
+    :py:class:`PatchIter`, in a contiguous grid sampling scheme. Each patch can be transformed individually by
+    `transform`, and is yielded with its coordinates in the source image by default.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images, each channel-first with shape (1, 4, 4)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 spatial patches starting at (0, 0) of the full (channel-first) array
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each patch has the full channel extent, shape (1, 2, 2), and its coordinates have shape (3, 2):
+        # rows for the channel, dimension 1 and dimension 2, each as [start, stop] in the original image
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
