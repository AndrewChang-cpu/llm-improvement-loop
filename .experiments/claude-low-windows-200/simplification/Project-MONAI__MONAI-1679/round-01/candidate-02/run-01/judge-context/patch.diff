+import sys
+import unittest
+
+import numpy as np
+from torch.utils.data import DataLoader
+
+from monai.data import GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patch_iter(item):
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        workers = 0 if sys.platform == "win32" else 2
+        items = ["abcde", "fghi", "jklmno"]
+        dataset = GridPatchDataset(dataset=items, patch_iter=_char_patch_iter, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=workers)
+        output = [char for batch in loader for char in batch]
+        expected = "".join(items)
+        self.assertEqual(sorted(output), sorted(expected))
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single process
+        num_batches = 0
+        for patches, coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            num_batches += 1
+        self.assertEqual(num_batches, 4)
+        expected_patches = np.array([[[1.7413, 2.7413], [5.7413, 6.7413]], [[9.1419, 10.1419], [13.1419, 14.1419]]])
+        np.testing.assert_allclose(patches[:, 0].numpy(), expected_patches, rtol=1e-5, atol=0)
+        expected_coords = [[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]]
+        self.assertEqual(coords.tolist(), expected_coords)
+
+        # two workers, reusing the same dataset, transform and generator objects (no seeding in between)
+        if sys.platform != "win32":
+            num_batches = 0
+            for patches, coords in DataLoader(dataset, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                num_batches += 1
+            self.assertEqual(num_batches, 4)
+            expected_patches_2w = np.array(
+                [[[2.3944, 3.3944], [6.3944, 7.3944]], [[10.6551, 11.6551], [14.6551, 15.6551]]]
+            )
+            np.testing.assert_allclose(patches[:, 0].numpy(), expected_patches_2w, rtol=1e-3, atol=0)
+            self.assertEqual(coords.tolist(), expected_coords)
+
+
+if __name__ == "__main__":
+    unittest.main()
