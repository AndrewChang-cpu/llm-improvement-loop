+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. The patches are chosen by a patch generator, such as
+    :py:class:`PatchIter`, in a contiguous grid sampling scheme. Each patch can then be transformed by a per-patch
+    transform. The transform receives only the patch.
+
+    Each image item is a single channel-first array. The patch generator returns (patch, coordinates) tuples, and the
+    dataset yields them as ``(transformed patch, coordinates)`` pairs when `with_coordinates` is True, or as just the
+    transformed patch otherwise. A patch has the full channel dimension and the requested spatial size, for example
+    a one-channel 4x4 image sampled with a patch size of 2x2 yields patches of shape (1, 2, 2). Its coordinates are an
+    integer array of shape (3, 2), one row per dimension counting the channel, holding ``[start, stop]`` per dimension.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # grid patches of size 2x2 starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
+        """
+        Args:
+            dataset: the image dataset to read image items from, it must support `len()`.
+            patch_iter: a callable that takes one image item and returns an iterable of tuples. The first element of
+                each tuple is the patch and the second is its coordinate array, as yielded by
+                :py:class:`PatchIter`. Only the first two elements are used.
+            transform: a transform applied to each patch alone, it never receives the tuple or the coordinates.
+            with_coordinates: if True, each dataset element is a ``(patch, coordinates)`` pair, otherwise it is the
+                patch only. Defaults to True.
+        """
+        self.dataset = dataset
+        self.patch_iter = patch_iter
+        self.transform = transform
+        self.with_coordinates = with_coordinates
+
     def __iter__(self):
+        if not hasattr(self.dataset, "__len__"):
+            raise NotImplementedError("image dataset must implement `len()`.")
+
         worker_info = torch.utils.data.get_worker_info()
