+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_with_index(item):
+    # patch generator yielding one (character, index) tuple per character of the item
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        dataset = GridPatchDataset(dataset=test_dataset, patch_iter=char_with_index, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for batch in loader:
+            output.extend(batch)
+
+        expected = [char for item in test_dataset for char in item]
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process loading
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        batches = list(loader)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        last_patches, last_coords = batches[-1]
+        expected_patches = np.array(
+            [[[[1.7413, 2.7413], [5.7413, 6.7413]]], [[[9.1419, 10.1419], [13.1419, 14.1419]]]]
+        )
+        expected_coords = np.array([[[0, 1], [0, 2], [2, 4]], [[0, 1], [2, 4], [2, 4]]])
+        np.testing.assert_allclose(last_patches.numpy(), expected_patches, rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(last_coords.numpy(), expected_coords)
+
+        if sys.platform != "win32":
+            # two-worker loading, reusing the same dataset, transform and generator objects
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+            batches = list(loader)
+            for patches, _ in batches:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+            last_patches, last_coords_2w = batches[-1]
+            expected_patches_2w = np.array(
+                [[[[2.3944, 3.3944], [6.3944, 7.3944]]], [[[10.6551, 11.6551], [14.6551, 15.6551]]]]
+            )
+            np.testing.assert_array_equal(last_coords_2w.numpy(), last_coords.numpy())
+            np.testing.assert_allclose(last_patches.numpy(), expected_patches_2w, rtol=1e-3, atol=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
