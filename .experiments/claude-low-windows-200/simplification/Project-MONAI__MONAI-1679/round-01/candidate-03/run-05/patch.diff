+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_iter(item):
+    # module-level patch generator so that it can be pickled for multi-worker loaders
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        ds = GridPatchDataset(dataset=test_dataset, patch_iter=char_iter, with_coordinates=False)
+        loader = DataLoader(ds, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for chunk in loader:
+            output.extend(chunk)
+
+        self.assertEqual(len(output), sum(len(s) for s in test_dataset))
+        self.assertEqual(sorted(output), sorted("".join(test_dataset)))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process loading
+        loader = DataLoader(ds, batch_size=2, num_workers=0)
+        last_patches, last_coords = None, None
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches.numpy(), coords.numpy()
+
+        expected_coords_first = np.array([[0, 1], [0, 2], [2, 4]])
+        expected_coords_second = np.array([[0, 1], [2, 4], [2, 4]])
+        np.testing.assert_array_equal(last_coords[0], expected_coords_first)
+        np.testing.assert_array_equal(last_coords[1], expected_coords_second)
+
+        expected_first = np.array([[[1.7413, 2.7413], [5.7413, 6.7413]]])
+        expected_second = np.array([[[9.1419, 10.1419], [13.1419, 14.1419]]])
+        np.testing.assert_allclose(last_patches[0], expected_first, rtol=1e-5, atol=0)
+        np.testing.assert_allclose(last_patches[1], expected_second, rtol=1e-5, atol=0)
+
+        if sys.platform == "win32":
+            return
+
+        # two-worker loading, reusing the same dataset, transform and generator objects
+        loader = DataLoader(ds, batch_size=2, num_workers=2)
+        last_patches, last_coords = None, None
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches.numpy(), coords.numpy()
+
+        np.testing.assert_array_equal(last_coords[0], expected_coords_first)
+        np.testing.assert_array_equal(last_coords[1], expected_coords_second)
+
+        expected_first = np.array([[[2.3944, 3.3944], [6.3944, 7.3944]]])
+        expected_second = np.array([[[10.6551, 11.6551], [14.6551, 15.6551]]])
+        np.testing.assert_allclose(last_patches[0], expected_first, rtol=1e-3, atol=0)
+        np.testing.assert_allclose(last_patches[1], expected_second, rtol=1e-3, atol=0)
+
+    def test_missing_length(self):
+        class NoLength:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        ds = GridPatchDataset(dataset=NoLength(), patch_iter=PatchIter(patch_size=(2, 2)), with_coordinates=False)
+        with self.assertRaises(NotImplementedError) as context:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`.", str(context.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
