+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator, `patch_iter`, and each patch is optionally post-processed by `transform`.
+
+    Each image item is a single channel-first image. Its patches have the full channel extent and the requested spatial
+    size. With ``with_coordinates`` (the default) each element is a ``(patch, coordinates)`` pair, where coordinates is
+    an integer array of shape (number of dimensions including channel, 2) holding ``[start, stop]`` per dimension in
+    the original unpadded frame.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # two single-channel 2D images, each of shape (1, 4, 4)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # grid of 2x2 patches, starting at the origin of the full channel-first array
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0, 0))
+        # patch-level intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has shape (1, 2, 2), the channel plus the 2x2 spatial patch size. Each coordinate array has shape (3, 2),
+    one ``[start, stop]`` row for the channel, the first spatial dimension and the second spatial dimension.
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
+        """
+        Initializes this dataset in terms of the input image dataset, a patch generator and an optional per-patch
