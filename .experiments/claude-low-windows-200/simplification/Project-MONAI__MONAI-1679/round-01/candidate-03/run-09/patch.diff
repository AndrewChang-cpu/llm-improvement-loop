+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patches(item):
+    # module-level so that the dataset can be pickled for spawned workers
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_strings = ["abc", "defg"]
+        dataset = GridPatchDataset(dataset=test_strings, patch_iter=char_patches, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        result = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(batch)
+
+        expected = sorted("".join(test_strings))
+        self.assertEqual(sorted(result), expected)
+        self.assertEqual(len(result), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process: every batch has shape (2, 1, 2, 2), check the final batch
+        last_patches, last_coords = None, None
+        for patches, coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches.numpy(), coords.numpy()
+
+        expected_patches = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_allclose(last_patches, expected_patches, rtol=1e-5, atol=0)
+        np.testing.assert_array_equal(last_coords, expected_coords)
+
+        # two workers reuse the same dataset, transform and generator objects, without reseeding
+        if sys.platform != "win32":
+            worker_patches, worker_coords = None, None
+            for patches, coords in DataLoader(dataset, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                worker_patches, worker_coords = patches.numpy(), coords.numpy()
+
+            expected_worker_patches = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            np.testing.assert_array_equal(worker_coords, last_coords)
+            np.testing.assert_allclose(worker_patches, expected_worker_patches, rtol=1e-3, atol=0)
+
+
+if __name__ == "__main__":
+    unittest.main()
