+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. The patches are chosen by a patch generator, such as
+    `PatchIter`, which performs grid sampling over each image item. An optional transform is then applied to each patch.
+
+    Each image item is a single channel-first array. For a one-channel 2D image of shape (1, 4, 4) with a patch size
+    of (2, 2), each patch has shape (1, 2, 2) and its coordinate array has shape (3, 2). The rows of the coordinate
+    array are the channel, dimension 1 and dimension 2, each given as ``[start, stop]`` in the original image frame.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches starting at (0, 0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # first batch of patches and their coordinates from two workers
+        patches, coords = next(iter(DataLoader(ds, batch_size=2, num_workers=2)))
+        print(patches.shape, coords.shape)
+
