+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an input dataset, using grid sampling. The patches are generated by a
+    patch generator (for example :py:class:`PatchIter`), and each patch can then be transformed by a per-patch
+    transform. Each image item is a single channel-first array, for example a one-channel 2D image of shape
+    (1, 4, 4) has three dimensions and its coordinates have three rows.
+
+    With ``with_coordinates=True`` (default) each element is a ``(patch, coordinates)`` pair, where the coordinates
+    are an integer array of shape (dimensions, 2) holding ``[start, stop]`` of each dimension in the original image,
+    including the channel dimension. The transform is applied to the patch only.
+
+    For example, to sample 2x2 patches from two single-channel 4x4 images:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches starting from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # two worker processes
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
