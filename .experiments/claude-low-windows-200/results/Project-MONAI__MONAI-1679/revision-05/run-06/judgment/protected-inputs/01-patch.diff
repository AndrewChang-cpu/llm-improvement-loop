+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_iter(item):
+    # one (character, index) tuple per character of the string item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class NoLenImages:
+    # image dataset which does not implement len()
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4), dtype=np.float32)
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["test_string1", "test_string2", "test_string3"]
+        dataset = GridPatchDataset(dataset=items, patch_iter=char_patch_iter, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for chunk in loader:
+            output.extend(chunk)
+
+        expected = sorted(c for item in items for c in item)
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=np.float32).reshape(1, 4, 4) for _ in range(2)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        for patch, _ in batches:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+        patch, coords = batches[-1]
+        expected_patch = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        np.testing.assert_allclose(patch.numpy(), expected_patch, rtol=1e-5, atol=0)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+        # two workers, reusing the same objects (non-Windows platforms only)
+        if sys.platform != "win32":
+            batches = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            for patch, _ in batches:
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+            patch, coords = batches[-1]
+            expected_patch = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            np.testing.assert_allclose(patch.numpy(), expected_patch, rtol=1e-3, atol=0)
+            np.testing.assert_array_equal(coords.numpy(), expected_coords)
+
+    def test_missing_len(self):
+        dataset = GridPatchDataset(dataset=NoLenImages(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
