+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_iter(item):
+    # one (character, index) tuple per character of the string item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        dataset = GridPatchDataset(dataset=test_dataset, patch_iter=char_iter, with_coordinates=False)
+        n_workers = 0 if sys.platform == "win32" else 2
+        result = []
+        for item in DataLoader(dataset, batch_size=3, num_workers=n_workers):
+            result.extend(item)
+        expected = [c for s in test_dataset for c in s]
+        self.assertEqual(sorted(result), sorted(expected))
+        self.assertEqual(len(result), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process loading
+        last_patches, last_coords = None, None
+        for patches, coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+
+        np.testing.assert_allclose(last_patches[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(
+            last_patches[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0
+        )
+        self.assertEqual(last_coords[0].tolist(), [[0, 1], [0, 2], [2, 4]])
+        self.assertEqual(last_coords[1].tolist(), [[0, 1], [2, 4], [2, 4]])
+
+        # two-worker loading, reusing the same dataset, transform and patch generator objects
+        if sys.platform != "win32":
+            last_patches, last_coords = None, None
+            for patches, coords in DataLoader(dataset, batch_size=2, num_workers=2):
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                last_patches, last_coords = patches, coords
+
+            np.testing.assert_allclose(
+                last_patches[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3, atol=0
+            )
+            np.testing.assert_allclose(
+                last_patches[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3, atol=0
+            )
+            self.assertEqual(last_coords[0].tolist(), [[0, 1], [0, 2], [2, 4]])
+            self.assertEqual(last_coords[1].tolist(), [[0, 1], [2, 4], [2, 4]])
+
+
+if __name__ == "__main__":
+    unittest.main()
