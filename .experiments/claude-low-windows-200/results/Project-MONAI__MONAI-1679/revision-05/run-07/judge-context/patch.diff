+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an image dataset. The patches are chosen by a patch generator, such as
+    :py:class:`PatchIter`, which samples each image in a contiguous grid. An optional `transform` is applied to each
+    patch on its own. Each element is a (patch, coordinates) pair, or only the patch when `with_coordinates` is False.
+
+    Each image item is a channel-first array and its channel dimension is yielded whole. For example, two
+    single-channel 4x4 images sampled with 2x2 patches give eight patches of shape (1, 2, 2). Their coordinates have
+    shape (3, 2): one row per dimension including the channel, so the channel row is `[0, 1]` and each spatial row is a
+    `[start, stop]` pair in the unpadded image, such as `[0, 2]` or `[2, 4]`. The following example iterates them
+    through a two-worker data loader:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
