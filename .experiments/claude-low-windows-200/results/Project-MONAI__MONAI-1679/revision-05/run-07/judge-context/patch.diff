+
+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_iter(item):
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["abcd", "efg", "hi"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=char_patch_iter, with_coordinates=False)
+        output = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            output.extend(batch)
+        expected = sorted("".join(test_data))
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), expected)
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process block
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        num_batches = 0
+        last_patches, last_coords = None, None
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+            num_batches += 1
+        self.assertEqual(num_batches, 4)
+        np.testing.assert_allclose(last_patches[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(
+            last_patches[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=1e-5, atol=0
+        )
+        np.testing.assert_allclose(last_coords[0].numpy(), [[0, 1], [0, 2], [2, 4]], rtol=1e-5, atol=0)
+        np.testing.assert_allclose(last_coords[1].numpy(), [[0, 1], [2, 4], [2, 4]], rtol=1e-5, atol=0)
+
+        # two-worker block, reuses the same dataset, transform and patch generator objects
+        if sys.platform != "win32":
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+            num_batches = 0
+            last_patches, last_coords = None, None
+            for patches, coords in loader:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                last_patches, last_coords = patches, coords
+                num_batches += 1
+            self.assertEqual(num_batches, 4)
+            np.testing.assert_allclose(last_coords[0].numpy(), [[0, 1], [0, 2], [2, 4]], rtol=1e-5, atol=0)
+            np.testing.assert_allclose(last_coords[1].numpy(), [[0, 1], [2, 4], [2, 4]], rtol=1e-5, atol=0)
+            np.testing.assert_allclose(last_patches[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=1e-3)
+            np.testing.assert_allclose(last_patches[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
