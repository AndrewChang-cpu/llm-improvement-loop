+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patch_iter(item):
+    # module-level so that it can be pickled for multi-process data loading
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class _NoLenDataset:
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["abc", "de", "fghi"]
+        ds = GridPatchDataset(dataset=items, patch_iter=_char_patch_iter, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(ds, batch_size=3, num_workers=num_workers)
+
+        result = sorted(x for batch in loader for x in batch)
+        expected = sorted(c for s in items for c in s)
+        self.assertEqual(result, expected)
+        self.assertEqual(len(result), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process block
+        loader = DataLoader(ds, batch_size=2, num_workers=0)
+        last_patches, last_coords = None, None
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+
+        expected_coords_first = [[0, 1], [0, 2], [2, 4]]
+        expected_coords_second = [[0, 1], [2, 4], [2, 4]]
+        np.testing.assert_array_equal(last_coords[0].numpy(), expected_coords_first)
+        np.testing.assert_array_equal(last_coords[1].numpy(), expected_coords_second)
+
+        expected_first = [[1.7413, 2.7413], [5.7413, 6.7413]]
+        expected_second = [[9.1419, 10.1419], [13.1419, 14.1419]]
+        np.testing.assert_allclose(last_patches[0, 0].numpy(), expected_first, rtol=1e-5, atol=0)
+        np.testing.assert_allclose(last_patches[1, 0].numpy(), expected_second, rtol=1e-5, atol=0)
+
+        # two-worker block, reuses the same dataset, transform and patch generator objects
+        if sys.platform != "win32":
+            loader = DataLoader(ds, batch_size=2, num_workers=2)
+            last_patches, last_coords = None, None
+            for patches, coords in loader:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                last_patches, last_coords = patches, coords
+
+            np.testing.assert_array_equal(last_coords[0].numpy(), expected_coords_first)
+            np.testing.assert_array_equal(last_coords[1].numpy(), expected_coords_second)
+
+            expected_first_mw = [[2.3944, 3.3944], [6.3944, 7.3944]]
+            expected_second_mw = [[10.6551, 11.6551], [14.6551, 15.6551]]
+            np.testing.assert_allclose(last_patches[0, 0].numpy(), expected_first_mw, rtol=1e-3, atol=0)
+            np.testing.assert_allclose(last_patches[1, 0].numpy(), expected_second_mw, rtol=1e-3, atol=0)
+
+    def test_missing_len(self):
+        ds = GridPatchDataset(dataset=_NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(ds)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
