+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator (for example :py:class:`PatchIter`), and each patch can be post-processed by a
+    transform applied to the patch alone.
+
+    Each element is a patch with the full channel dimension and the requested spatial size, or a
+    ``(patch, coordinates)`` pair when `with_coordinates` is True. The coordinates are an integer array with one row
+    per dimension of the image item, including the channel dimension. Each row holds the start and stop of that
+    dimension for the patch in the original, unpadded image.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset of two single-channel 4x4 images
+        image = np.arange(16, dtype=float).reshape(1, 4, 4)
+        images = [image, image]
+        # grid patch generator with 2x2 patches
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each patch has shape (1, 2, 2) and its coordinates have shape (3, 2)
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
