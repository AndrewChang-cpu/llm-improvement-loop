+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_index_generator(item):
+    """Module-level patch generator: yields one (character, index) tuple per character of the item."""
+    return ((c, i) for i, c in enumerate(item))
+
+
+class _NoLenDataset:
+    """Image dataset without ``__len__``."""
+
+    def __init__(self, items):
+        self.items = items
+
+    def __getitem__(self, index):
+        return self.items[index]
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        data = ["test", "patch", "grid", "dataset", "monai"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=data, patch_iter=_char_index_generator, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        result = []
+        total_len = 0
+        for batch in loader:
+            result.extend(batch)
+            total_len += len(batch)
+
+        expected = list("".join(data))
+        self.assertEqual(sorted(result), sorted(expected))
+        self.assertEqual(total_len, len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+
+        # single-process block
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+
+        batches = list(loader)
+        for patch, _ in batches:
+            self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+        patch, coords = batches[-1]
+        np.testing.assert_allclose(patch[0, 0, 0].numpy(), [1.7413, 2.7413], atol=1e-5)
+        np.testing.assert_allclose(patch[0, 0, 1].numpy(), [5.7413, 6.7413], atol=1e-5)
+        np.testing.assert_allclose(patch[1, 0, 0].numpy(), [9.1419, 10.1419], atol=1e-5)
+        np.testing.assert_allclose(patch[1, 0, 1].numpy(), [13.1419, 14.1419], atol=1e-5)
+        np.testing.assert_allclose(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]], atol=1e-5)
+        np.testing.assert_allclose(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]], atol=1e-5)
+
+        # two-worker block (non-Windows only)
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+            patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+            dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+
+            batches = list(loader)
+            for patch, _ in batches:
+                self.assertEqual(tuple(patch.shape), (2, 1, 2, 2))
+
+            patch, coords = batches[-1]
+            np.testing.assert_allclose(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]], atol=1e-5)
+            np.testing.assert_allclose(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]], atol=1e-5)
+            np.testing.assert_allclose(patch[0, 0, 0].numpy(), [2.3944, 3.3944], atol=1e-3)
+            np.testing.assert_allclose(patch[0, 0, 1].numpy(), [6.3944, 7.3944], atol=1e-3)
+            np.testing.assert_allclose(patch[1, 0, 0].numpy(), [10.6551, 11.6551], atol=1e-3)
+            np.testing.assert_allclose(patch[1, 0, 1].numpy(), [14.6551, 15.6551], atol=1e-3)
+
+    def test_missing_len_raises(self):
+        dataset = GridPatchDataset(dataset=_NoLenDataset(["abc"]), patch_iter=_char_index_generator)
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
