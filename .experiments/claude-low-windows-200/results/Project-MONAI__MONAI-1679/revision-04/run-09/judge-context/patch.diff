+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_index_generator(item):
+    # module-level patch generator: yields one (character, index) tuple per character of the item
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class NoLengthDataset:
+    # image dataset that supports indexing but not len()
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        ds = GridPatchDataset(dataset=test_dataset, patch_iter=char_index_generator, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(ds, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+
+        expected = sorted("".join(test_dataset))
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # grid patch generator: 2x2 patches starting at (0, 0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process loading
+        batches = list(DataLoader(ds, batch_size=2, num_workers=0))
+        self.assertEqual(len(batches), 4)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = batches[-1]
+        expected_patches = np.array(
+            [
+                [[1.7413, 2.7413], [5.7413, 6.7413]],
+                [[9.1419, 10.1419], [13.1419, 14.1419]],
+            ]
+        )
+        np.testing.assert_allclose(np.asarray(patches)[:, 0], expected_patches, rtol=0, atol=1e-5)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_equal(np.asarray(coords), expected_coords)
+
+        # two-worker loading, with its own pinned patch values
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+            patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+            patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+            ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+            batches = list(DataLoader(ds, batch_size=2, num_workers=2))
+            self.assertEqual(len(batches), 4)
+            for patches, _ in batches:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+            patches, coords = batches[-1]
+            expected_patches = np.array(
+                [
+                    [[2.3944, 3.3944], [6.3944, 7.3944]],
+                    [[10.6551, 11.6551], [14.6551, 15.6551]],
+                ]
+            )
+            np.testing.assert_allclose(np.asarray(patches)[:, 0], expected_patches, rtol=0, atol=1e-3)
+            np.testing.assert_equal(np.asarray(coords), expected_coords)
+
+    def test_missing_len(self):
+        ds = GridPatchDataset(dataset=NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(ds)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
