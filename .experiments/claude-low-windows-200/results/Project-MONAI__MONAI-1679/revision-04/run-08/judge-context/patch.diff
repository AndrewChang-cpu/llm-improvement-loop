+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
+        """
+        Initializes this dataset in terms of the input image dataset, a patch generator and an optional per-patch
+        transform.
+
+        Args:
+            dataset: the image dataset to read image data from; each item is a single image and the dataset must
