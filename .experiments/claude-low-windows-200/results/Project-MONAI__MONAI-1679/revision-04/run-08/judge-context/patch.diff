+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_iter(item):
+    # module-level generator so that it can be pickled for multi-worker data loading
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class NoLenDataset:
+    # image dataset which does not implement `len()`
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_patch_iter, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        expected = sorted("".join(test_dataset))
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len("".join(test_dataset)))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+
+        # single-process block
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        patches, coords = batches[-1]
+        np.testing.assert_allclose(
+            patches[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=0, atol=1e-5
+        )
+        np.testing.assert_allclose(
+            patches[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=0, atol=1e-5
+        )
+        np.testing.assert_allclose(coords[0].numpy(), [[0, 1], [0, 2], [2, 4]], rtol=0, atol=1e-5)
+        np.testing.assert_allclose(coords[1].numpy(), [[0, 1], [2, 4], [2, 4]], rtol=0, atol=1e-5)
+
+        # two-worker block
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+            transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+            dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+            batches_mp = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            self.assertEqual(len(batches_mp), len(batches))
+            for patches_mp, _ in batches_mp:
+                self.assertEqual(tuple(patches_mp.shape), (2, 1, 2, 2))
+
+            patches_mp, coords_mp = batches_mp[-1]
+            np.testing.assert_allclose(coords_mp[0].numpy(), [[0, 1], [0, 2], [2, 4]], rtol=0, atol=1e-5)
+            np.testing.assert_allclose(coords_mp[1].numpy(), [[0, 1], [2, 4], [2, 4]], rtol=0, atol=1e-5)
+            np.testing.assert_allclose(
+                patches_mp[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=0, atol=1e-3
+            )
+            np.testing.assert_allclose(
+                patches_mp[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=0, atol=1e-3
+            )
+
+    def test_missing_len(self):
+        dataset = GridPatchDataset(dataset=NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
