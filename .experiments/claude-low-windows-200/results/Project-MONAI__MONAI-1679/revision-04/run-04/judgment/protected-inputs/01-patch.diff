+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_with_index(item):
+    # patch generator: one (character, index) tuple per character of the string item
+    return ((c, i) for i, c in enumerate(item))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=test_dataset, patch_iter=char_with_index, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=workers)
+        output = []
+        for item in loader:
+            output.extend(item)
+        expected = list("".join(test_dataset))
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), sorted(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process loading
+        last = None
+        for batch in DataLoader(dataset, batch_size=2, num_workers=0):
+            patches, coords = batch
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last = (patches.numpy(), coords.numpy())
+
+        patches, coords = last
+        expected_patches = np.array(
+            [
+                [[1.7413, 2.7413], [5.7413, 6.7413]],
+                [[9.1419, 10.1419], [13.1419, 14.1419]],
+            ]
+        )
+        np.testing.assert_allclose(patches[:, 0], expected_patches, rtol=0, atol=1e-5)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_allclose(coords, expected_coords, rtol=0, atol=1e-5)
+
+        # two-worker loading, not run on Windows
+        if sys.platform != "win32":
+            last = None
+            for batch in DataLoader(dataset, batch_size=2, num_workers=2):
+                patches, coords = batch
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+                last = (patches.numpy(), coords.numpy())
+
+            patches, coords = last
+            expected_patches_2w = np.array(
+                [
+                    [[2.3944, 3.3944], [6.3944, 7.3944]],
+                    [[10.6551, 11.6551], [14.6551, 15.6551]],
+                ]
+            )
+            np.testing.assert_allclose(patches[:, 0], expected_patches_2w, rtol=0, atol=1e-3)
+            np.testing.assert_allclose(coords, expected_coords, rtol=0, atol=1e-5)
+
+
+if __name__ == "__main__":
+    unittest.main()
