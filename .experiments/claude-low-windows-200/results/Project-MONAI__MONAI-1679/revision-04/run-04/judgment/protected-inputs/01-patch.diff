+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an image dataset. The patches are chosen by a patch generator in a contiguous
+    grid sampling scheme, and each patch is optionally transformed by a per-patch transform. Each yielded element is
+    the transformed patch, or a (patch, coordinates) pair when `with_coordinates` is True. The coordinates are an
+    integer array of shape (ndim, 2), one ``[start, stop]`` row per dimension including the channel dimension.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each image gives four patches, the patches and their coordinates are batched by the data loader
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has shape (1, 2, 2), the channel dimension followed by the spatial patch size. Its coordinates have
+    shape (3, 2), where the rows are the channel ``[0, 1]`` and the start and stop of each spatial dimension in the
+    unpadded image.
+    """
