+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_gen(item):
+    """Patch generator for string items: one (character, index) tuple per character."""
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["sdfsdf", "sdfs", "dfgfdgdkfg", "abc", "xyzw"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=char_patch_gen, with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = [char for batch in loader for char in batch]
+        expected = "".join(test_data)
+        self.assertEqual(sorted(output), sorted(expected))
+        self.assertEqual(len(output), len(expected))
+
+    def test_missing_len(self):
+        class NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(dataset=NoLen(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+    def _run_loader(self, num_workers):
+        """Seeds determinism, builds the loader, checks every batch shape and returns the final (patches, coords)."""
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=np.float32).reshape(1, 4, 4), np.arange(16, dtype=np.float32).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+        loader = DataLoader(dataset, batch_size=2, num_workers=num_workers)
+
+        last = None
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last = (patches.numpy(), coords.numpy())
+        return last
+
+    def test_loading_array(self):
+        # single process
+        patches, coords = self._run_loader(num_workers=0)
+        np.testing.assert_allclose(patches[0, 0], [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=0, atol=1e-5)
+        np.testing.assert_allclose(patches[1, 0], [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=0, atol=1e-5)
+        np.testing.assert_allclose(coords[0], [[0, 1], [0, 2], [2, 4]], rtol=0, atol=1e-5)
+        np.testing.assert_allclose(coords[1], [[0, 1], [2, 4], [2, 4]], rtol=0, atol=1e-5)
+
+        # two workers, not run on Windows
+        if sys.platform != "win32":
+            patches, coords = self._run_loader(num_workers=2)
+            np.testing.assert_allclose(coords[0], [[0, 1], [0, 2], [2, 4]], rtol=0, atol=1e-5)
+            np.testing.assert_allclose(coords[1], [[0, 1], [2, 4], [2, 4]], rtol=0, atol=1e-5)
+            np.testing.assert_allclose(patches[0, 0], [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=0, atol=1e-3)
+            np.testing.assert_allclose(patches[1, 0], [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
