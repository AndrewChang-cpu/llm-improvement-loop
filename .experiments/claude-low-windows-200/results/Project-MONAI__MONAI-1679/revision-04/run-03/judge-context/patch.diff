+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an image dataset. The patches are chosen in a contiguous grid sampling scheme
+    by a patch generator (for example :py:class:`PatchIter`), and each patch is optionally transformed by a per-patch
+    transform. By default each element is a ``(patch, coordinates)`` pair, where the coordinates are an integer array
+    with one row per dimension of the image (channel first) giving the ``[start, stop]`` of the patch in the original
+    image. Set `with_coordinates` to False to yield only the patches.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # grid of 2x2 patches starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has shape (1, 2, 2) (channel, height, width). Each coordinate array has shape (3, 2) with rows
+    ``[channel, height, width]`` and columns ``[start, stop]``, for example ``[[0, 1], [0, 2], [0, 2]]`` for the first
+    patch of an image.
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
