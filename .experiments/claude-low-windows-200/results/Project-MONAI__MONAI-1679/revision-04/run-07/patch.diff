+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an input dataset, using grid sampling. The patch geometry comes from a patch
+    generator (for example ``PatchIter``) and each patch can be post-processed by a transform applied to that patch.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset of single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches, starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset, coordinates are yielded by default
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each patch has shape (1, 2, 2) and its coordinates have shape (3, 2)
+        # the dataset yields 4 patches per image, so 8 in total
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each coordinate array has one row per dimension of the image, including the channel dimension, and each row holds
+    ``[start, stop]`` of the patch in that dimension in the original image frame. For the first patch above the
+    coordinates are ``[[0, 1], [0, 2], [0, 2]]``.
