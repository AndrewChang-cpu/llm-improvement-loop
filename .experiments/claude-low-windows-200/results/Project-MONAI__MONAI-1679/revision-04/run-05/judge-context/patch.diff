+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def iter_chars(item):
+    # custom patch generator: one (character, index) tuple per character of the item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class NoLengthDataset:
+    # image dataset which does not implement len()
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=iter_chars, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        expected = sorted("vwxyzhelloworld")
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator and per-patch intensity shift
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process: check all batch shapes, then the final batch values and coordinates
+        last_batch = None
+        for batch in DataLoader(ds, batch_size=2, num_workers=0):
+            patch, coords = batch
+            np.testing.assert_equal(tuple(patch.shape), (2, 1, 2, 2))
+            last_batch = (patch, coords)
+
+        patch, coords = last_batch
+        expected_patch = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        np.testing.assert_allclose(patch.numpy(), expected_patch, rtol=0, atol=1e-5)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_equal(coords.numpy(), expected_coords)
+
+        # two workers: check batch shapes and final batch coordinates, patch values pinned separately
+        if sys.platform != "win32":
+            last_batch = None
+            for batch in DataLoader(ds, batch_size=2, num_workers=2):
+                patch, coords = batch
+                np.testing.assert_equal(tuple(patch.shape), (2, 1, 2, 2))
+                last_batch = (patch, coords)
+
+            patch, coords = last_batch
+            np.testing.assert_allclose(coords.numpy(), expected_coords, rtol=0, atol=1e-5)
+            expected_patch_workers = np.array(
+                [
+                    [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                    [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                ]
+            )
+            np.testing.assert_allclose(patch.numpy(), expected_patch_workers, rtol=0, atol=1e-3)
+
+    def test_missing_length(self):
+        ds = GridPatchDataset(dataset=NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
