+import sys
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _string_generator(item):
+    # one (item, index) tuple per string item
+    yield item, len(item)
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        input_strings = ["test string1", "test string2", "test string3", "test string4", "test string5"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=input_strings, patch_iter=_string_generator, with_coordinates=False)
+        result = []
+        for item in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(item)
+        self.assertEqual(sorted(result), sorted(input_strings))
+        self.assertEqual(len(result), len(input_strings))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=np.float32).reshape(1, 4, 4),
+            np.arange(16, 32, dtype=np.float32).reshape(1, 4, 4),
+        ]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # expected coordinates per image in visit order: (dim 1 range, dim 2 range)
+        expected_spatial = [((0, 2), (0, 2)), ((2, 4), (0, 2)), ((0, 2), (2, 4)), ((2, 4), (2, 4))]
+
+        # single process
+        patches, coords = [], []
+        for p, c in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(p.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(c.shape), (2, 3, 2))
+            patches.append(p.numpy())
+            coords.append(c.numpy())
+        patches = np.concatenate(patches)
+        coords = np.concatenate(coords)
+
+        for i in range(len(images) * len(expected_spatial)):
+            image_id, patch_id = divmod(i, len(expected_spatial))
+            self.assertEqual(coords[i][0].tolist(), [0, 1])
+            (r0, r1), (c0, c1) = expected_spatial[patch_id]
+            self.assertEqual(coords[i][1].tolist(), [r0, r1])
+            self.assertEqual(coords[i][2].tolist(), [c0, c1])
+            # the random shift is constant within a patch, so removing it gives the source values
+            raw = images[image_id][:, r0:r1, c0:c1]
+            shift = patches[i] - raw
+            self.assertTrue(np.allclose(shift, shift.flat[0], atol=1e-5))
+
+        if sys.platform != "win32":
+            # two workers should produce the same set of patch locations and source values
+            multi_coords, multi_patches = [], []
+            for p, c in DataLoader(dataset, batch_size=2, num_workers=2):
+                multi_patches.append(p.numpy())
+                multi_coords.append(c.numpy())
+            multi_patches = np.concatenate(multi_patches)
+            multi_coords = np.concatenate(multi_coords)
+            self.assertEqual(
+                sorted(c.tolist() for c in multi_coords), sorted(c.tolist() for c in coords)
+            )
+            for p, c in zip(multi_patches, multi_coords):
+                # each patch must match a source image region up to a constant shift
+                (r0, r1), (c0, c1) = c[1], c[2]
+                matched = any(
+                    np.allclose(
+                        (p - img[:, r0:r1, c0:c1]),
+                        (p - img[:, r0:r1, c0:c1]).flat[0],
+                        atol=1e-3,
+                    )
+                    for img in images
+                )
+                self.assertTrue(matched, f"no source image matches patch at coordinates {c.tolist()}")
+
+    def test_default_coordinates_collate(self):
+        images = [np.arange(16, dtype=np.float32).reshape(1, 4, 4)]
+        dataset = GridPatchDataset(dataset=images, patch_iter=PatchIter(patch_size=(2, 2)))
+        for patch, coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertIsInstance(coords, torch.Tensor)
+            self.assertEqual(tuple(coords.shape), (2, 3, 2))
+
+
+if __name__ == "__main__":
+    unittest.main()
