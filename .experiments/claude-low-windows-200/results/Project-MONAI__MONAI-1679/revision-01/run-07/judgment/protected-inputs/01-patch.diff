+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an image dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator (for example :py:class:`PatchIter`), and each patch can be post-processed by a
+    transform applied to the patch alone.
+
+    Each dataset element is a patch when `with_coordinates` is False, or a ``(patch, coordinates)`` pair when it is
+    True. Coordinates are an integer array with one ``[start, stop]`` row per dimension of the image item, including
+    the channel dimension, in the original unpadded frame.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each image yields 4 patches of shape (1, 2, 2), so there are 8 patches in total
+        for patch, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
+
+    def __init__(
