+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+TEST_CASE_COORDS = [
+    [[0, 1], [0, 2], [0, 2]],
+    [[0, 1], [2, 4], [0, 2]],
+    [[0, 1], [0, 2], [2, 4]],
+    [[0, 1], [2, 4], [2, 4]],
+]
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        class _Gen:
+            """Patch generator yielding (item, index) tuples."""
+
+            def __call__(self, item):
+                for i in range(2):
+                    yield item, i
+
+        test_data = ["test_1", "test_2", "test_3", "test_4", "test_5"]
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=_Gen(), with_coordinates=False)
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for batch in loader:
+            output.extend(batch)
+
+        expected = sorted(x for x in test_data for _ in range(2))
+        self.assertEqual(len(output), len(expected))
+        self.assertEqual(sorted(output), expected)
+
+    def test_loading_array(self):
+        images = [np.arange(16, dtype=np.float32).reshape(1, 4, 4) for _ in range(2)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+
+        # reference transform: same seed and same visit order as the dataset's transform
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        transform.set_random_state(seed=1234)
+        ref_transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ref_transform.set_random_state(seed=1234)
+
+        expected_patches = []
+        for image in images:
+            for patch, _ in patch_iter(image):
+                expected_patches.append(ref_transform(np.array(patch)))
+        expected_patches = np.stack(expected_patches)
+
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+
+        patches, coords = [], []
+        for patch_batch, coord_batch in loader:
+            self.assertEqual(tuple(patch_batch.shape), (2, 1, 2, 2))
+            patches.append(patch_batch.numpy())
+            coords.append(coord_batch.numpy())
+        patches = np.concatenate(patches)
+        coords = np.concatenate(coords)
+
+        np.testing.assert_allclose(patches, expected_patches, rtol=1e-5, atol=1e-5)
+        expected_coords = np.tile(np.array(TEST_CASE_COORDS), (len(images), 1, 1))
+        np.testing.assert_equal(coords, expected_coords)
+
+        if sys.platform != "win32":
+            # multi-worker run must produce the same set of patches as the single-process run
+            plain = GridPatchDataset(dataset=images, patch_iter=patch_iter, with_coordinates=False)
+            single = [p for p in plain]
+            multi = []
+            for batch in DataLoader(plain, batch_size=2, num_workers=2):
+                multi.extend(list(batch.numpy()))
+            self.assertEqual(len(multi), len(single))
+
+            def _key(a):
+                return tuple(np.round(a.flatten(), 6))
+
+            for a, b in zip(sorted(single, key=_key), sorted(multi, key=_key)):
+                np.testing.assert_allclose(a, b, rtol=1e-3, atol=1e-3)
+
+    def test_default_coordinates_batch(self):
+        images = [np.arange(16, dtype=np.float32).reshape(1, 4, 4) for _ in range(2)]
+        dataset = GridPatchDataset(dataset=images, patch_iter=PatchIter(patch_size=(2, 2), start_pos=(0, 0)))
+        for patch_batch, coord_batch in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(coord_batch.shape), (2, 3, 2))
+            self.assertEqual(tuple(patch_batch.shape), (2, 1, 2, 2))
+
+    def test_no_length_raises(self):
+        class _NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(dataset=_NoLen(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as ctx:
+            list(dataset)
+        self.assertIn("must implement `len()`", str(ctx.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
