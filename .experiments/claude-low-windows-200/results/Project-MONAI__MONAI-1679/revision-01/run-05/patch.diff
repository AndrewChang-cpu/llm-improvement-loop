+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patches(item):
+    # custom patch generator: yields (patch, index) tuples, one per character of the string item
+    return [(c, i) for i, c in enumerate(item)]
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_patches, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        expected = sorted("".join(test_dataset))
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        # two identical 1x4x4 images, 2x2 grid patches from the origin, one random shift per patch
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # grid visit order for each 4x4 image: (dim 1 range, dim 2 range)
+        ranges = [((0, 2), (0, 2)), ((2, 4), (0, 2)), ((0, 2), (2, 4)), ((2, 4), (2, 4))]
+        expected_coords = []
+        for _ in images:
+            for (r0, r1), (c0, c1) in ranges:
+                expected_coords.append([[0, 1], [r0, r1], [c0, c1]])
+        expected_coords = np.asarray(expected_coords)
+
+        def check_patches(patches, coords, tol):
+            self.assertEqual(len(patches), len(expected_coords))
+            for patch, coord in zip(patches, coords):
+                np.testing.assert_equal(tuple(patch.shape), (1, 2, 2))
+                (r0, r1), (c0, c1) = coord[1], coord[2]
+                raw = images[0][:, r0:r1, c0:c1]  # both images are identical
+                # the transform shifts the whole patch by one constant offset in [-1, 1]
+                diff = patch - raw
+                np.testing.assert_allclose(diff, np.full_like(diff, diff.flat[0]), atol=tol)
+                self.assertLessEqual(abs(float(diff.flat[0])), 1.0 + tol)
+
+        # single process: exact visit order
+        all_patches, all_coords = [], []
+        for patches, coords in DataLoader(ds, batch_size=2, shuffle=False, num_workers=0):
+            np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+            all_patches.extend(list(np.asarray(patches)))
+            all_coords.extend(list(np.asarray(coords)))
+        np.testing.assert_equal(np.asarray(all_coords), expected_coords)
+        check_patches(all_patches, all_coords, 1e-5)
+
+        if sys.platform != "win32":
+            # two workers: same patches, order may differ across workers
+            multi_patches, multi_coords = [], []
+            for patches, coords in DataLoader(ds, batch_size=2, shuffle=False, num_workers=2):
+                np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+                multi_patches.extend(list(np.asarray(patches)))
+                multi_coords.extend(list(np.asarray(coords)))
+            self.assertEqual(
+                sorted(c.tolist() for c in multi_coords), sorted(c.tolist() for c in expected_coords)
+            )
+            check_patches(multi_patches, multi_coords, 1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
