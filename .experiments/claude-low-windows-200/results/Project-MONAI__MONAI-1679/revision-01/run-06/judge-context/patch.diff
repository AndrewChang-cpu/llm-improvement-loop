+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an image dataset. The patches are chosen in a contiguous grid sampling scheme
+    by a patch generator (for example `PatchIter`), and each patch is optionally post-processed by a transform.
+
+    The patch generator is called once per image item and must yield tuples whose first element is the patch and whose
+    second element is the coordinates of that patch. The transform is applied to the patch alone.
+
+    For example, to sample 2x2 patches from two single-channel 4x4 images, shift the intensity of each patch and
+    iterate with two data-loader workers:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import ShiftIntensity
+
+        # image dataset, each item is a channel-first array of shape (1, 4, 4)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 spatial patches starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = ShiftIntensity(offset=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has shape (channel, 2, 2). Its coordinates are an integer array of shape (3, 2) with one row per
+    dimension, including the channel dimension, holding the start and stop of that dimension in the original image,
+    for example ``[[0, 1], [0, 2], [0, 2]]`` for the first patch of each image.
+    """
+
+    def __init__(
