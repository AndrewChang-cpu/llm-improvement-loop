+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patches(item):
+    # patch generator yielding (character, index) tuples for each character of a string item
+    return ((c, i) for i, c in enumerate(item))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        expected = sorted("".join(test_dataset))
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_patches, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        # two single-channel 4x4 images with values 0..15
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # expected spatial coordinates of the four patches of each image, in visit order (dim 1 varies fastest)
+        expected_spatial = [[[0, 2], [0, 2]], [[2, 4], [0, 2]], [[0, 2], [2, 4]], [[2, 4], [2, 4]]]
+        expected_coords = np.array([[[0, 1]] + spatial for spatial in expected_spatial] * len(images))
+
+        def check_patch(patch, coords, atol):
+            patch = np.asarray(patch)
+            coords = np.asarray(coords)
+            np.testing.assert_equal(patch.shape, (1, 2, 2))
+            np.testing.assert_equal(coords.shape, (3, 2))
+            # the patch is the unshifted grid patch from the image plus one constant intensity offset
+            (r0, r1), (c0, c1) = coords[1], coords[2]
+            base = images[0][:, r0:r1, c0:c1]
+            diff = patch - base
+            np.testing.assert_allclose(diff, np.full_like(diff, diff.flat[0]), atol=atol)
+
+        # single process
+        patches, coords = [], []
+        for batch_patches, batch_coords in DataLoader(ds, batch_size=2, num_workers=0):
+            np.testing.assert_equal(tuple(batch_patches.shape), (2, 1, 2, 2))
+            patches.extend(np.asarray(batch_patches))
+            coords.extend(np.asarray(batch_coords))
+        self.assertEqual(len(patches), 8)
+        np.testing.assert_equal(np.stack(coords), expected_coords)
+        for patch, coord in zip(patches, coords):
+            check_patch(patch, coord, atol=1e-5)
+
+        if sys.platform != "win32":
+            # two workers must produce the same set of patch coordinates, each with a constant intensity offset
+            worker_patches, worker_coords = [], []
+            for batch_patches, batch_coords in DataLoader(ds, batch_size=2, num_workers=2):
+                np.testing.assert_equal(tuple(batch_patches.shape), (2, 1, 2, 2))
+                worker_patches.extend(np.asarray(batch_patches))
+                worker_coords.extend(np.asarray(batch_coords))
+            self.assertEqual(len(worker_patches), 8)
+            self.assertEqual(
+                sorted(tuple(c.flatten()) for c in worker_coords), sorted(tuple(c.flatten()) for c in coords)
+            )
+            for patch, coord in zip(worker_patches, worker_coords):
+                check_patch(patch, coord, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
