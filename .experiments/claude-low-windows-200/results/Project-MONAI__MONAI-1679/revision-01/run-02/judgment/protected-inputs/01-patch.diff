+import sys
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# expected coordinates of the four 2x2 patches of a 4x4 image, in visit order (first spatial dimension fastest).
+# rows: channel [0, 1], then dimension 1 range, then dimension 2 range
+EXPECTED_COORDS = np.array(
+    [
+        [[0, 1], [0, 2], [0, 2]],
+        [[0, 1], [2, 4], [0, 2]],
+        [[0, 1], [0, 2], [2, 4]],
+        [[0, 1], [2, 4], [2, 4]],
+    ],
+    dtype=np.int64,
+)
+
+
+def _make_shift(seed: int = 1234) -> RandShiftIntensity:
+    transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+    transform.set_random_state(seed=seed)
+    return transform
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["a", "b", "c", "d", "e", "f", "g"]
+
+        def _patch_gen(item):
+            for i in range(2):
+                yield item, i
+
+        workers = 0 if sys.platform == "win32" else 2
+        ds = GridPatchDataset(dataset=items, patch_iter=_patch_gen, with_coordinates=False)
+
+        output = []
+        for batch in DataLoader(ds, batch_size=3, num_workers=workers):
+            output.extend(batch)
+
+        self.assertEqual(len(output), len(items) * 2)
+        self.assertEqual(sorted(output), sorted(items * 2))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=np.float32).reshape(1, 4, 4),
+            np.arange(16, dtype=np.float32).reshape(1, 4, 4) + 100.0,
+        ]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+
+        # single process: expected patches apply the same seeded shift in the same order
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=_make_shift())
+        batches = list(DataLoader(ds, batch_size=2, num_workers=0))
+
+        self.assertEqual(len(batches), 4)
+        for patches, coords in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(coords.shape), (2, 3, 2))
+
+        expected_transform = _make_shift()
+        expected_patches, expected_coords = [], []
+        for img in images:
+            for coord in EXPECTED_COORDS:
+                slices = (slice(None), slice(coord[1][0], coord[1][1]), slice(coord[2][0], coord[2][1]))
+                expected_patches.append(expected_transform(img[slices].copy()))
+                expected_coords.append(coord)
+
+        actual_patches = torch.cat([p for p, _ in batches]).numpy()
+        actual_coords = torch.cat([c for _, c in batches]).numpy()
+        np.testing.assert_allclose(actual_patches, np.stack(expected_patches), rtol=0, atol=1e-5)
+        np.testing.assert_array_equal(actual_coords, np.stack(expected_coords))
+
+        if sys.platform != "win32":
+            # two workers: the seeds differ per worker, so compare the patches with the shift removed
+            ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=_make_shift())
+            worker_batches = list(DataLoader(ds, batch_size=2, num_workers=2))
+            worker_patches = torch.cat([p for p, _ in worker_batches]).numpy()
+            worker_coords = torch.cat([c for _, c in worker_batches]).numpy()
+
+            self.assertEqual(len(worker_patches), len(expected_patches))
+            self.assertEqual(
+                sorted(tuple(c.flatten()) for c in worker_coords),
+                sorted(tuple(c.flatten()) for c in expected_coords),
+            )
+            for patch, coord in zip(worker_patches, worker_coords):
+                matches = []
+                for img in images:
+                    slices = (slice(None), slice(coord[1][0], coord[1][1]), slice(coord[2][0], coord[2][1]))
+                    diff = patch - img[slices]
+                    if np.ptp(diff) < 1e-3 and abs(diff.mean()) <= 1.0 + 1e-3:
+                        matches.append(img)
+                self.assertEqual(len(matches), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
