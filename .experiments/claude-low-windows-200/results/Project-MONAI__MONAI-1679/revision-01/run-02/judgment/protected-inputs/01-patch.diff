+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an image dataset. The patches are chosen in a contiguous grid sampling scheme
+    by a patch generator, and each patch can be transformed individually. Each image item is a single channel-first
+    array. The patch generator, for example :py:class:`PatchIter`, takes one image item and yields tuples whose first
+    element is the patch and whose second element is the coordinates of that patch in the image.
+
+    With ``with_coordinates=True`` (the default) each element is a ``(patch, coordinates)`` pair. The coordinates are
+    an integer array of shape (ndim, 2), where ndim includes the channel dimension. Row i is ``[start, stop]`` for
+    dimension i in the original, unpadded image. The channel row is ``[0, C]`` for C channels. For example, a 1-channel
+    4x4 image sampled with a 2x2 patch gives patches of shape (1, 2, 2) and coordinates of shape (3, 2), such as
+    ``[[0, 1], [0, 2], [0, 2]]``.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4) + 16.0]
+        # patch generator: 2x2 patches starting from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # iterate with two data-loader workers
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+            break
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
+        """
+        Args:
