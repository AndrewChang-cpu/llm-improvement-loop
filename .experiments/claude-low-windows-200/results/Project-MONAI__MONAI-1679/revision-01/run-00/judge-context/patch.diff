+
+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# expected coordinates per 4x4 image, in visit order; rows are channel, dim 1 and dim 2 as [start, stop]
+EXPECTED_COORDS = np.asarray(
+    [
+        [[0, 1], [0, 2], [0, 2]],
+        [[0, 1], [2, 4], [0, 2]],
+        [[0, 1], [0, 2], [2, 4]],
+        [[0, 1], [2, 4], [2, 4]],
+    ]
+)
+
+
+def identity_generator(item):
+    # yields (item, index) tuples over a sequence of items
+    for i, x in enumerate(item):
+        yield x, i
+
+
+def expected_patch(image, coords):
+    # unshifted patch of `image` at the given coordinates
+    return image[:, coords[1][0] : coords[1][1], coords[2][0] : coords[2][1]]
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["test_string1", "test_string2", "test_string3", "test_string4"]
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=identity_generator, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+        output = []
+        total_len = 0
+        for chunk in loader:
+            output.extend(chunk)
+            total_len += len(chunk)
+        self.assertEqual(sorted(output), sorted("".join(test_data)))
+        self.assertEqual(total_len, sum(len(s) for s in test_data))
+
+    def test_loading_array(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process: check batch shapes, patch values and coordinates
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+        patches_all, coords_all = [], []
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(coords.shape), (2, 3, 2))
+            patches_all.append(patches.numpy())
+            coords_all.append(coords.numpy())
+        patches_all = np.concatenate(patches_all)
+        coords_all = np.concatenate(coords_all)
+
+        for i in range(len(images)):
+            for j in range(len(EXPECTED_COORDS)):
+                k = i * len(EXPECTED_COORDS) + j
+                np.testing.assert_array_equal(coords_all[k], EXPECTED_COORDS[j])
+                # the transform adds one constant shift to each patch, drawn from [-1, 1]
+                diff = patches_all[k] - expected_patch(images[i], EXPECTED_COORDS[j])
+                self.assertLessEqual(float(np.max(np.abs(diff.ravel()[0] - diff))), 1e-5)
+                self.assertLessEqual(abs(diff.ravel()[0]), 1.0 + 1e-5)
+
+        # multiple workers should produce the same set of patches as a single process
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            loader = DataLoader(dataset, batch_size=2, num_workers=2)
+            multi_patches = []
+            multi_coords = []
+            for patches, coords in loader:
+                multi_patches.append(patches.numpy())
+                multi_coords.append(coords.numpy())
+            multi_patches = np.concatenate(multi_patches)
+            multi_coords = np.concatenate(multi_coords)
+
+            self.assertEqual(multi_patches.shape, patches_all.shape)
+            # remove each patch's constant shift before comparing values, since shifts depend on worker RNG state
+            def unshift(p):
+                return p - p.ravel()[0]
+
+            def sort_key(arr):
+                return sorted(tuple(np.round(unshift(p), 3).ravel()) for p in arr)
+
+            single_vals = [unshift(p) for p in patches_all]
+            multi_vals = [unshift(p) for p in multi_patches]
+            self.assertEqual(len(sort_key(single_vals)), len(sort_key(multi_vals)))
+            np.testing.assert_allclose(
+                np.asarray(sort_key(multi_vals)), np.asarray(sort_key(single_vals)), rtol=1e-3, atol=1e-3
+            )
+            self.assertEqual(
+                sorted(tuple(c.ravel()) for c in multi_coords), sorted(tuple(c.ravel()) for c in coords_all)
+            )
+
+
+if __name__ == "__main__":
+    unittest.main()
