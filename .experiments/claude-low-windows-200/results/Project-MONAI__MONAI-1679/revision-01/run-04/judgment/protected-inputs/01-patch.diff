+import sys
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["test_string1", "test_string2", "test_string3", "test_string4", "test_string5"]
+
+        def _gen(item):
+            # two patches per image item, each carrying the item string
+            for i in range(2):
+                yield (item, i)
+
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=_gen, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        output = []
+        for chunk in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            output.extend(chunk)
+
+        self.assertEqual(sorted(output), sorted(test_data * 2))
+        self.assertEqual(len(output), 2 * len(test_data))
+
+    def test_loading_array(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_intensity.set_random_state(seed=1234)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # expected values: apply an identically seeded transform to the raw patches in the same visit order
+        expected_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        expected_intensity.set_random_state(seed=1234)
+        expected_patches, expected_coords = [], []
+        for image in images:
+            for patch, coords in patch_iter(image):
+                expected_patches.append(expected_intensity(patch))
+                expected_coords.append(coords)
+
+        expected_grid = [
+            np.array([[0, 1], [0, 2], [0, 2]]),
+            np.array([[0, 1], [2, 4], [0, 2]]),
+            np.array([[0, 1], [0, 2], [2, 4]]),
+            np.array([[0, 1], [2, 4], [2, 4]]),
+        ]
+
+        # single process: torch DataLoader is used so the transform's seed is not reset by monai's DataLoader
+        batches = list(torch.utils.data.DataLoader(dataset, batch_size=2, num_workers=0))
+        self.assertEqual(len(batches), 4)
+        for patch_batch, coords_batch in batches:
+            self.assertEqual(tuple(patch_batch.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(coords_batch.shape), (2, 3, 2))
+
+        patches = torch.cat([b[0] for b in batches]).numpy()
+        coords = torch.cat([b[1] for b in batches]).numpy()
+        self.assertEqual(len(patches), len(expected_patches))
+        for i in range(len(patches)):
+            np.testing.assert_allclose(patches[i], expected_patches[i], rtol=0, atol=1e-5)
+            np.testing.assert_equal(coords[i], expected_coords[i])
+            np.testing.assert_equal(coords[i], expected_grid[i % 4])
+
+        if sys.platform != "win32":
+            # two workers: the same underlying patches must be produced. Worker-side random states differ, so
+            # each patch is checked to equal its raw patch plus a constant shift.
+            raw_patches = {}
+            for image in images:
+                for patch, c in patch_iter(image):
+                    raw_patches.setdefault(tuple(c.flatten().tolist()), []).append(patch)
+
+            multi_patches, multi_coords = [], []
+            for patch_batch, coords_batch in DataLoader(dataset, batch_size=2, num_workers=2):
+                multi_patches.extend(patch_batch.numpy())
+                multi_coords.extend(coords_batch.numpy())
+            self.assertEqual(len(multi_patches), len(patches))
+
+            for p, c in zip(multi_patches, multi_coords):
+                key = tuple(c.flatten().tolist())
+                self.assertIn(key, raw_patches)
+                raw = raw_patches[key].pop(0)
+                diff = p - raw
+                np.testing.assert_allclose(diff, np.full_like(diff, diff.flat[0]), rtol=0, atol=1e-3)
+                self.assertLessEqual(abs(diff.flat[0]), 1.0 + 1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
