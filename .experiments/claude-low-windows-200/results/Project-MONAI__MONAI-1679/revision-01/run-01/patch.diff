+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an image dataset. The patches are chosen in a contiguous grid sampling scheme
+    by a patch generator, such as :py:class:`PatchIter`, and each patch can be post-processed by a transform.
+    Each item of the image dataset is a single channel-first image.
+
+    For example, to sample 2x2 grid patches from two single-channel 4x4 images, with a random intensity shift applied
+    to each patch and coordinates yielded with each patch:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: each item is one channel-first image
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 grid patches starting from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # iterate with two workers; each patch has shape (1, 2, 2) and its coordinates have shape (3, 2)
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each coordinates array is an integer array with one row per dimension of the image, including the channel
+    dimension. Row i is ``[start, stop]`` for dimension i in the original, unpadded image. For the first patch above
+    the coordinates are ``[[0, 1], [0, 2], [0, 2]]``: the channel row, then the rows and columns ``0:2``.
+    """
+
+    def __init__(
