+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _gen_item_index(item):
+    # custom patch generator: one (item, index) tuple per string item
+    yield item, 0
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["test_string1", "test_string2", "test_string3", "test_string4", "test_string5", "test_string6"]
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=_gen_item_index, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        output = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            output.extend(batch)
+        self.assertEqual(len(output), len(test_data))
+        self.assertEqual(sorted(output), sorted(test_data))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+            np.arange(16, dtype=float).reshape(1, 4, 4) + 100.0,
+        ]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # expected patches and coordinates in visit order (first spatial dimension varies fastest)
+        expected_ranges = [((0, 2), (0, 2)), ((2, 4), (0, 2)), ((0, 2), (2, 4)), ((2, 4), (2, 4))]
+        expected_coords = np.array([[[0, 1], [h0, h1], [w0, w1]] for (h0, h1), (w0, w1) in expected_ranges])
+
+        # single process
+        patches, coords = [], []
+        for batch_patches, batch_coords in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(batch_patches.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(batch_coords.shape), (2, 3, 2))
+            patches.extend(batch_patches.numpy())
+            coords.extend(batch_coords.numpy())
+
+        self.assertEqual(len(patches), 8)
+        for i, (patch, coord) in enumerate(zip(patches, coords)):
+            image = images[i // 4]
+            (h0, h1), (w0, w1) = expected_ranges[i % 4]
+            orig = image[:, h0:h1, w0:w1]
+            # the random shift is constant over each patch and lies in [-1, 1]
+            shift = (patch - orig).flat[0]
+            np.testing.assert_allclose(patch, orig + shift, rtol=0, atol=1e-5)
+            self.assertLessEqual(abs(shift), 1.0 + 1e-5)
+            np.testing.assert_array_equal(coord, expected_coords[i % 4])
+
+        # multi-process: each patch must still be a shifted version of a source patch, and coordinates must
+        # cover the same grid as the single-process run
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            mp_patches, mp_coords = [], []
+            for batch_patches, batch_coords in DataLoader(dataset, batch_size=2, num_workers=2):
+                mp_patches.extend(batch_patches.numpy())
+                mp_coords.extend(batch_coords.numpy())
+            self.assertEqual(len(mp_patches), 8)
+            self.assertEqual(
+                sorted(map(lambda c: c.tolist(), mp_coords)), sorted(map(lambda c: c.tolist(), coords))
+            )
+            for patch, coord in zip(mp_patches, mp_coords):
+                (_, _), (h0, h1), (w0, w1) = coord.tolist()
+                matched = False
+                for image in images:
+                    orig = image[:, h0:h1, w0:w1]
+                    shift = (patch - orig).flat[0]
+                    if np.allclose(patch, orig + shift, rtol=0, atol=1e-3) and abs(shift) <= 1.0 + 1e-3:
+                        matched = True
+                        break
+                self.assertTrue(matched)
+
+
+if __name__ == "__main__":
+    unittest.main()
