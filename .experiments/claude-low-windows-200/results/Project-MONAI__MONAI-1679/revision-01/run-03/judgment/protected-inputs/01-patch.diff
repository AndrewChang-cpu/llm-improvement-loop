+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _patch_gen(item):
+    yield (item, 0)
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        input_strings = [f"test_string{i}" for i in range(10)]
+        dataset = GridPatchDataset(dataset=input_strings, patch_iter=_patch_gen, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        result = []
+        for chunk in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(chunk)
+
+        self.assertEqual(len(result), len(input_strings))
+        self.assertEqual(sorted(result), sorted(input_strings))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+            np.arange(16, 32, dtype=float).reshape(1, 4, 4),
+        ]
+        # visit order: first spatial dimension varies fastest
+        spatial_starts = [(0, 0), (2, 0), (0, 2), (2, 2)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        def expected_coords(d1, d2):
+            return np.array([[0, 1], [d1, d1 + 2], [d2, d2 + 2]])
+
+        def base_patch(img_idx, d1, d2):
+            return images[img_idx][:, d1 : d1 + 2, d2 : d2 + 2]
+
+        def check_shift(patch, base, tol):
+            # the transform adds one constant shift (drawn from [-1, 1]) to the whole patch
+            diff = patch - base
+            self.assertTrue(np.allclose(diff, diff.flat[0], atol=tol))
+            self.assertLessEqual(abs(float(diff.flat[0])), 1.0 + tol)
+
+        # single process: exact batch shapes, exact coordinates in order, values shifted from the source
+        pairs = []
+        for batch in DataLoader(dataset, batch_size=2):
+            patches, coords = batch
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(coords.shape), (2, 3, 2))
+            pairs.extend(zip(patches.numpy(), coords.numpy()))
+
+        self.assertEqual(len(pairs), 8)
+        for k, (patch, coord) in enumerate(pairs):
+            img_idx, pos = divmod(k, 4)
+            d1, d2 = spatial_starts[pos]
+            np.testing.assert_array_equal(coord, expected_coords(d1, d2))
+            check_shift(patch, base_patch(img_idx, d1, d2), tol=1e-5)
+
+        # multiple workers must produce the same set of patches as a single process
+        if sys.platform != "win32":
+            multi = []
+            for batch in DataLoader(dataset, batch_size=2, num_workers=2):
+                patches, coords = batch
+                multi.extend(zip(patches.numpy(), coords.numpy()))
+
+            self.assertEqual(len(multi), 8)
+            for patch, coord in multi:
+                # coordinates do not identify the image, so accept the patch if it matches either image
+                matched = False
+                for img_idx in range(len(images)):
+                    d1, d2 = int(coord[1][0]), int(coord[2][0])
+                    base = base_patch(img_idx, d1, d2)
+                    diff = patch - base
+                    if np.allclose(diff, diff.flat[0], atol=1e-3) and abs(float(diff.flat[0])) <= 1.0 + 1e-3:
+                        matched = True
+                        break
+                self.assertTrue(matched)
+
+    def test_no_transform_passes_patches_unchanged(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+        dataset = GridPatchDataset(dataset=images, patch_iter=PatchIter(patch_size=(2, 2)), with_coordinates=False)
+        patches = list(dataset)
+        self.assertEqual(len(patches), 4)
+        np.testing.assert_array_equal(patches[1], images[0][:, 2:4, 0:2])
+
+    def test_dataset_without_len_raises(self):
+        class _NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 2, 2))
+
+        dataset = GridPatchDataset(dataset=_NoLen(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaisesRegex(NotImplementedError, "must implement `len()`"):
+            next(iter(dataset))
+
+
+if __name__ == "__main__":
+    unittest.main()
