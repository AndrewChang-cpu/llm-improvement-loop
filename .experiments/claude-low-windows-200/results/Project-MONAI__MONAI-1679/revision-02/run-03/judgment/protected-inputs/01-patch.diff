+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# coordinates for the four 2x2 patches of a 4x4 image in visit order; each row is [start, stop] for one dimension
+# (channel row first), so the spatial rows are (dim1 range, dim2 range)
+EXPECTED_COORDS = np.asarray(
+    [
+        [[0, 1], [0, 2], [0, 2]],
+        [[0, 1], [2, 4], [0, 2]],
+        [[0, 1], [0, 2], [2, 4]],
+        [[0, 1], [2, 4], [2, 4]],
+    ],
+    dtype=int,
+)
+# expected patch values, shape (num_images * 4, 1, 2, 2), for two 1x4x4 images with
+# RandShiftIntensity(offsets=1.0, prob=1.0) under set_determinism(seed=1234).
+# TODO: not filled in. These must be recorded from a verified run of the test pipeline; they were not computed here.
+EXPECTED_PATCHES = None
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = [f"item_{i}" for i in range(10)]
+
+        def patch_gen(item):
+            # one (item, index) tuple per image item; the second element is ignored when coordinates are off
+            return [(item, 0)]
+
+        num_workers = 0 if sys.platform == "win32" else 2
+        ds = GridPatchDataset(dataset=items, patch_iter=patch_gen, with_coordinates=False)
+        loader = DataLoader(ds, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for batch in loader:
+            output.extend(batch)
+
+        self.assertEqual(len(output), len(items))
+        self.assertEqual(sorted(output), sorted(items))
+
+    def test_loading_array(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # set determinism before constructing the loader, since the zero-worker loader reseeds the dataset
+        set_determinism(seed=1234)
+        loader = DataLoader(ds, batch_size=2, num_workers=0)
+        batches = list(loader)
+
+        self.assertEqual(len(batches), 4)
+        patches = []
+        coords = []
+        for patch_batch, coord_batch in batches:
+            self.assertEqual(tuple(patch_batch.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(coord_batch.shape), (2, 3, 2))
+            patches.append(patch_batch.numpy())
+            coords.append(coord_batch.numpy())
+        patches = np.concatenate(patches)
+        coords = np.concatenate(coords)
+
+        # coordinates are the same for every image
+        for i in range(len(images)):
+            np.testing.assert_array_equal(coords[i * 4 : (i + 1) * 4], EXPECTED_COORDS)
+
+        self.assertIsNotNone(EXPECTED_PATCHES, "EXPECTED_PATCHES must be recorded from a verified run")
+        np.testing.assert_allclose(patches, EXPECTED_PATCHES, rtol=1e-5, atol=1e-5)
+
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            multi = DataLoader(ds, batch_size=2, num_workers=2)
+            multi_patches = []
+            multi_coords = []
+            for patch_batch, coord_batch in multi:
+                multi_patches.append(patch_batch.numpy())
+                multi_coords.append(coord_batch.numpy())
+            multi_patches = np.concatenate(multi_patches)
+            multi_coords = np.concatenate(multi_coords)
+
+            def _order(c):
+                return sorted(range(len(c)), key=lambda k: tuple(c[k].ravel()))
+
+            single_order = _order(coords)
+            multi_order = _order(multi_coords)
+            np.testing.assert_array_equal(coords[single_order], multi_coords[multi_order])
+            np.testing.assert_allclose(patches[single_order], multi_patches[multi_order], rtol=1e-3, atol=1e-3)
+
+    def test_missing_len(self):
+        class NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        ds = GridPatchDataset(dataset=NoLen(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
