+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an input dataset. The patches are chosen in a contiguous grid sampling scheme
+    by a patch generator (for example `PatchIter`), and each patch can be post-processed by a transform.
+
+    Each dataset element is a patch, or a ``(patch, coordinates)`` pair when `with_coordinates` is True. The patch has
+    the full channel dimension followed by the requested spatial size, for example (1, 2, 2) for single-channel 2D
+    patches. The coordinates are an integer array with one row per dimension of the image, including the channel
+    dimension, where each row is ``[start, stop]`` of that dimension in the original image. For example, a 2D
+    single-channel patch has coordinates of shape (3, 2), with the channel row ``[0, 1]``.
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset of single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4) + 100]
+        # grid of 2x2 patches starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # 4 patches per image, 8 in total
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
