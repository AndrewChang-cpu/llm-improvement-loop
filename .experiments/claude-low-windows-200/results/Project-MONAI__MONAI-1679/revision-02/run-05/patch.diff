+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _string_patch_gen(item):
+    # one (patch, index) tuple per image item, the patch is the string itself
+    yield item, 0
+
+
+class _NoLenDataset:
+    """image dataset without ``__len__``"""
+
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = [f"test{i}" for i in range(10)]
+        workers = 0 if sys.platform == "win32" else 2
+        ds = GridPatchDataset(dataset=items, patch_iter=_string_patch_gen, with_coordinates=False)
+        out = []
+        for batch in DataLoader(ds, batch_size=3, num_workers=workers):
+            out.extend(batch)
+        self.assertEqual(sorted(out), sorted(items))
+        self.assertEqual(len(out), len(items))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+            np.arange(16, dtype=float).reshape(1, 4, 4) + 16.0,
+        ]
+        # expected coordinates of the four 2x2 patches of each image, in visit order (first spatial dim fastest),
+        # each row is [start, stop] for channel, dimension 1 and dimension 2
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [0, 2]],
+                [[0, 1], [2, 4], [0, 2]],
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+
+        def make_ds():
+            return GridPatchDataset(
+                dataset=images,
+                patch_iter=PatchIter(patch_size=(2, 2), start_pos=(0, 0)),
+                transform=RandShiftIntensity(offsets=1.0, prob=1.0),
+            )
+
+        # determinism is set before the loader is built, the loader must not reseed the transform afterwards
+        set_determinism(seed=1234)
+        patches, coords = [], []
+        for p, c in DataLoader(make_ds(), batch_size=2, num_workers=0):
+            self.assertEqual(tuple(p.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(c.shape), (2, 3, 2))
+            patches.extend(p.numpy())
+            coords.extend(c.numpy())
+        self.assertEqual(len(patches), 8)
+
+        for i in range(8):
+            # coordinates of the patch within its source image
+            np.testing.assert_array_equal(coords[i], expected_coords[i % 4])
+            img = images[i // 4]
+            (r0, r1), (c0, c1) = coords[i][1], coords[i][2]
+            source = img[:, r0:r1, c0:c1]
+            # the transform adds one random offset in [-1, 1] to the whole patch
+            diff = patches[i] - source
+            self.assertLessEqual(float(np.ptp(diff)), 1e-5)
+            self.assertLessEqual(abs(float(diff.flat[0])), 1.0 + 1e-5)
+
+        if sys.platform != "win32":
+            # two workers must produce the same patch locations, each patch shifted by its own offset
+            set_determinism(seed=1234)
+            worker_coords = []
+            worker_patches = []
+            for p, c in DataLoader(make_ds(), batch_size=2, num_workers=2):
+                worker_patches.extend(p.numpy())
+                worker_coords.extend(c.numpy())
+            self.assertEqual(len(worker_patches), 8)
+            self.assertEqual(
+                sorted(tuple(x.flatten()) for x in worker_coords), sorted(tuple(x.flatten()) for x in coords)
+            )
+            for p, c in zip(worker_patches, worker_coords):
+                # the patch must match its coordinates in one of the source images, up to a constant offset
+                (r0, r1), (c0, c1) = c[1], c[2]
+                matched = False
+                for img in images:
+                    diff = p - img[:, r0:r1, c0:c1]
+                    if float(np.ptp(diff)) <= 1e-3 and abs(float(diff.flat[0])) <= 1.0 + 1e-3:
+                        matched = True
+                        break
+                self.assertTrue(matched, f"patch with coords {c.tolist()} not from a source image")
+
+    def test_missing_len(self):
+        ds = GridPatchDataset(dataset=_NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)), with_coordinates=False)
+        with self.assertRaises(NotImplementedError) as cm:
+            list(ds)
+        self.assertEqual(str(cm.exception), "image dataset must implement `len()`")
+
+
+if __name__ == "__main__":
+    unittest.main()
