+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _pair_generator(item):
+    """patch generator yielding (item, index) tuples for a single item"""
+    yield item, 0
+
+
+class _NoLenDataset:
+    """image dataset without a length"""
+
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["test1", "test2", "test3", "test4", "test5", "test6", "test7", "test8", "test9", "test10"]
+        workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=items, patch_iter=_pair_generator, with_coordinates=False)
+        result = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=workers):
+            result.extend(batch)
+        self.assertEqual(sorted(result), sorted(items))
+        self.assertEqual(len(result), len(items))
+
+    def test_loading_array(self):
+        # set determinism before the loader is constructed, the zero-worker loader reseeds the dataset
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, 32, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # expected coordinates of the four patches of each 4x4 image, in visit order (channel row first)
+        expected_coords = [
+            [[0, 1], [0, 2], [0, 2]],
+            [[0, 1], [2, 4], [0, 2]],
+            [[0, 1], [0, 2], [2, 4]],
+            [[0, 1], [2, 4], [2, 4]],
+        ]
+        # source patches of the first image in visit order, the shift applied to each must be a single scalar
+        source = images[0][0]
+        expected_source = [source[0:2, 0:2], source[2:4, 0:2], source[0:2, 2:4], source[2:4, 2:4]]
+
+        patches, coords = [], []
+        for p, c in DataLoader(dataset, batch_size=2, num_workers=0):
+            self.assertEqual(tuple(p.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(c.shape), (2, 3, 2))
+            patches.append(p.numpy())
+            coords.append(c.numpy())
+        patches = np.concatenate(patches)
+        coords = np.concatenate(coords)
+
+        self.assertEqual(len(patches), 8)
+        for i in range(4):
+            np.testing.assert_array_equal(coords[i], np.asarray(expected_coords[i]))
+            np.testing.assert_array_equal(coords[i + 4], np.asarray(expected_coords[i]))
+            shift = patches[i, 0] - expected_source[i]
+            # every value in a patch receives the same offset, drawn from uniform(-1, 1)
+            np.testing.assert_allclose(shift, np.full_like(shift, shift.flat[0]), atol=1e-5)
+            self.assertLessEqual(abs(shift.flat[0]), 1.0 + 1e-5)
+
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            multi_patches, multi_coords = [], []
+            for p, c in DataLoader(dataset, batch_size=2, num_workers=2):
+                multi_patches.append(p.numpy())
+                multi_coords.append(c.numpy())
+            multi_patches = np.concatenate(multi_patches).reshape(8, -1)
+            multi_coords = np.concatenate(multi_coords).reshape(8, -1)
+            flat_patches = patches.reshape(8, -1)
+            flat_coords = coords.reshape(8, -1)
+            # compare the sets of patches and coordinates, ignoring visit order across workers
+            np.testing.assert_array_equal(
+                flat_coords[np.lexsort(flat_coords.T[::-1])], multi_coords[np.lexsort(multi_coords.T[::-1])]
+            )
+            np.testing.assert_allclose(
+                flat_patches[np.lexsort(flat_patches.T[::-1])],
+                multi_patches[np.lexsort(multi_patches.T[::-1])],
+                atol=1e-3,
+            )
+
+    def test_missing_length(self):
+        dataset = GridPatchDataset(dataset=_NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
