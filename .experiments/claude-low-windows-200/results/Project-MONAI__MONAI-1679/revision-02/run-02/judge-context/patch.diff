+                :py:class:`monai.data.PatchIter` for grid sampling of channel-first arrays.
+            transform: transform applied to each patch alone (not to the tuple or the coordinates). Defaults to None.
+            with_coordinates: whether to yield ``(patch, coordinates)`` pairs instead of only the patch.
+                Defaults to True.
+        """
+        self.dataset = dataset
+        self.patch_iter = patch_iter
+        self.transform = transform
+        self.with_coordinates = with_coordinates
+
