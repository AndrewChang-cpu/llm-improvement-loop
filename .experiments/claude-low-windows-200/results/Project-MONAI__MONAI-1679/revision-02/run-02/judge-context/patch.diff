+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an input image dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator, and each patch is optionally processed by a per-patch transform. By default each
+    element is a ``(patch, coordinates)`` pair, where the coordinates are an integer array with one row per dimension
+    of the image (channel included), each row holding ``[start, stop]`` in the original image frame.
+
+    Example, two single-channel 4x4 images, 2x2 patches and a random intensity shift per patch:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches from the image, starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # patch-level intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # each image yields 4 patches, so 8 patches in total, iterated with two workers
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has shape (1, 2, 2) with the channel dimension, and its coordinates have shape (3, 2): the channel row
+    is [0, 1] and the spatial rows give the ``[start, stop]`` of each spatial dimension.
+
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
