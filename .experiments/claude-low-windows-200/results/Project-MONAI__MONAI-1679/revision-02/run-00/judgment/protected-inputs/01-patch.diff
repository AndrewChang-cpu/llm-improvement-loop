+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# expected coordinates of the four 2x2 patches of a 1x4x4 image, in visit order (first spatial dimension fastest),
+# each row is [start, stop] for the channel, dimension 1 and dimension 2
+EXPECTED_COORDS = np.array(
+    [
+        [[0, 1], [0, 2], [0, 2]],
+        [[0, 1], [2, 4], [0, 2]],
+        [[0, 1], [0, 2], [2, 4]],
+        [[0, 1], [2, 4], [2, 4]],
+    ]
+)
+
+
+def _is_shifted_patch(patch, coords, images, atol):
+    """returns True if `patch` equals a source region of one of `images` plus a single constant offset"""
+    for img in images:
+        src = img[coords[0, 0] : coords[0, 1], coords[1, 0] : coords[1, 1], coords[2, 0] : coords[2, 1]]
+        diff = patch - src
+        if np.allclose(diff, diff.flat[0], atol=atol):
+            return True
+    return False
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["test1", "test2", "test3", "test4", "test5", "test6", "test7", "test8", "test9"]
+
+        def patch_gen(item):
+            yield (item, 0)
+
+        num_workers = 0 if sys.platform == "win32" else 2
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=patch_gen, with_coordinates=False)
+
+        result = []
+        for chunk in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(chunk)
+
+        self.assertEqual(len(result), len(test_data))
+        self.assertEqual(sorted(result), sorted(test_data))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+            np.arange(16, 32, dtype=float).reshape(1, 4, 4),
+        ]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+
+        # single process: determinism is set before the loader is constructed, since the loader reseeds the dataset
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+        set_determinism(seed=1234)
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+
+        # 2 images x 4 patches, batches of 2
+        self.assertEqual(len(batches), 4)
+        for patches, coords in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            self.assertEqual(tuple(coords.shape), (2, 3, 2))
+
+        # visit order is per image, four patches each
+        all_coords = np.concatenate([coords.numpy() for _, coords in batches])
+        for i in range(2):
+            np.testing.assert_equal(all_coords[4 * i : 4 * i + 4], EXPECTED_COORDS)
+
+        # each patch is its source region shifted by one constant offset
+        all_patches = np.concatenate([patches.numpy() for patches, _ in batches])
+        for patch, coords in zip(all_patches, all_coords):
+            self.assertTrue(_is_shifted_patch(patch, coords, images, atol=1e-5))
+
+        # multi-process: same coordinates, and each patch is shifted by one constant offset
+        if sys.platform != "win32":
+            dataset_mw = GridPatchDataset(dataset=images, patch_iter=PatchIter((2, 2), (0, 0)), transform=transform)
+            set_determinism(seed=1234)
+            batches_mw = list(DataLoader(dataset_mw, batch_size=2, num_workers=2))
+            self.assertEqual(len(batches_mw), 4)
+
+            all_coords_mw = np.concatenate([coords.numpy() for _, coords in batches_mw])
+            self.assertEqual(
+                sorted(map(lambda c: c.tobytes(), all_coords_mw)), sorted(map(lambda c: c.tobytes(), all_coords))
+            )
+            all_patches_mw = np.concatenate([patches.numpy() for patches, _ in batches_mw])
+            for patch, coords in zip(all_patches_mw, all_coords_mw):
+                self.assertTrue(_is_shifted_patch(patch, coords, images, atol=1e-3))
+
+    def test_patch_without_coordinates(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+        dataset = GridPatchDataset(dataset=images, patch_iter=PatchIter((2, 2), (0, 0)), with_coordinates=False)
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        self.assertEqual(len(batches), 2)
+        for patches in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+    def test_missing_len(self):
+        class _NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(dataset=_NoLen(), patch_iter=PatchIter((2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
