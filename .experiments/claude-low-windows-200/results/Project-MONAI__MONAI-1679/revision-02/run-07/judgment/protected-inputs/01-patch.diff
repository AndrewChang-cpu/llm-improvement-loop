+import re
+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _expected_coords(d1_range, d2_range):
+    """Coordinate array (channel, dim1, dim2) rows for a 1-channel 4x4 image patch."""
+    return np.array([[0, 1], list(d1_range), list(d2_range)], dtype=int)
+
+
+# visit order for a 4x4 image with 2x2 patches: first spatial dimension varies fastest
+_EXPECTED_COORDS = [
+    _expected_coords((0, 2), (0, 2)),
+    _expected_coords((2, 4), (0, 2)),
+    _expected_coords((0, 2), (2, 4)),
+    _expected_coords((2, 4), (2, 4)),
+]
+_EXPECTED_COORDS_KEYS = [tuple(c.flatten().tolist()) for c in _EXPECTED_COORDS]
+
+
+def _key(coords):
+    """Hashable key for a coordinate array."""
+    return tuple(np.asarray(coords).flatten().tolist())
+
+
+def _source_patch(image, k):
+    """Unshifted source patch of visit index `k` (0-3) for a 1x4x4 image with 2x2 patches."""
+    row = 2 if k in (1, 3) else 0
+    col = 2 if k in (2, 3) else 0
+    return image[:, row : row + 2, col : col + 2]
+
+
+class _NoLenDataset:
+    """Image dataset that does not support len()."""
+
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        data = [f"item_{i}" for i in range(10)]
+
+        # custom patch generator: yields (item, index) tuples over string items
+        def patch_iter(item):
+            return [(item, 0)]
+
+        dataset = GridPatchDataset(dataset=data, patch_iter=patch_iter, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        output = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            output.extend(batch)
+
+        self.assertEqual(sorted(output), sorted(data))
+        self.assertEqual(len(output), len(data))
+
+    def test_loading_array(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+
+        # determinism must be set before the DataLoader is constructed (it reseeds with num_workers=0)
+        set_determinism(seed=1234)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+
+        self.assertEqual(len(batches), 4)
+        patches = np.concatenate([b[0].numpy() for b in batches])
+        coords = np.concatenate([b[1].numpy() for b in batches])
+        self.assertEqual(patches.shape, (8, 1, 2, 2))
+        for b in batches:
+            self.assertEqual(tuple(b[0].shape), (2, 1, 2, 2))
+
+        # patches are visited per image in grid order, each shifted by a single random offset from [-1, 1]
+        for i, image in enumerate(images):
+            for k in range(4):
+                source = _source_patch(image, k)
+                shift = patches[4 * i + k] - source
+                self.assertTrue(np.allclose(shift, shift.flat[0], atol=1e-5))
+                self.assertTrue(-1.0 - 1e-5 <= shift.flat[0] <= 1.0 + 1e-5)
+                np.testing.assert_allclose(coords[4 * i + k], _EXPECTED_COORDS[k])
+
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+            multi = list(DataLoader(dataset, batch_size=2, num_workers=2))
+            multi_patches = np.concatenate([b[0].numpy() for b in multi])
+            multi_coords = np.concatenate([b[1].numpy() for b in multi])
+            self.assertEqual(multi_patches.shape, (8, 1, 2, 2))
+            # each patch location is produced exactly once across the workers
+            self.assertEqual(sorted(map(_key, multi_coords)), sorted(map(_key, coords)))
+            # each worker patch equals the source patch at its location plus one constant offset
+            for p, c in zip(multi_patches, multi_coords):
+                k = _EXPECTED_COORDS_KEYS.index(_key(c))
+                matches = [
+                    np.allclose(p - _source_patch(image, k), (p - _source_patch(image, k)).flat[0], atol=1e-3)
+                    for image in images
+                ]
+                self.assertTrue(any(matches))
+
+    def test_missing_len(self):
+        dataset = GridPatchDataset(dataset=_NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaisesRegex(NotImplementedError, re.escape("image dataset must implement `len()`")):
+            list(dataset)
+
+
+if __name__ == "__main__":
+    unittest.main()
