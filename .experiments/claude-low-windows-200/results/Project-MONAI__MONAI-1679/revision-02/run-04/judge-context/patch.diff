+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_generator(item):
+    # yields one (character, index) tuple per character of a string item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class NoLenDataset:
+    # an image dataset that does not implement len()
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_generator, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.append("".join(item))
+        # total length equals the number of characters across all items
+        self.assertEqual(sum(len(o) for o in output), sum(len(s) for s in test_dataset))
+        self.assertEqual(sorted("".join(output)), sorted("".join(test_dataset)))
+
+    def test_loading_array(self):
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # expected coordinates per patch: channel row [0, 1], then (dim 1 range, dim 2 range) in visit order
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [0, 2]],
+                [[0, 1], [2, 4], [0, 2]],
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        # base (unshifted) patches in visit order for one image
+        base_patches = [
+            np.array([[[0.0, 1.0], [4.0, 5.0]]]),
+            np.array([[[8.0, 9.0], [12.0, 13.0]]]),
+            np.array([[[2.0, 3.0], [6.0, 7.0]]]),
+            np.array([[[10.0, 11.0], [14.0, 15.0]]]),
+        ]
+
+        def check_patches(patches, coords):
+            # each patch is its base patch plus one constant shift in (-1, 1), as drawn by RandShiftIntensity
+            for k in range(4):
+                patch = patches[k]
+                shift = patch - base_patches[k % 4]
+                self.assertTrue(np.allclose(shift, shift.flat[0], atol=1e-5))
+                self.assertLess(abs(float(shift.flat[0])), 1.0 + 1e-5)
+                np.testing.assert_equal(coords[k], expected_coords[k % 4])
+
+        # single process: batches of shape (2, 1, 2, 2)
+        all_patches, all_coords = [], []
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=0):
+            np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+            np.testing.assert_equal(tuple(coords.shape), (2, 3, 2))
+            all_patches.extend(patches.numpy())
+            all_coords.extend(coords.numpy())
+        self.assertEqual(len(all_patches), 8)
+        for img_idx in range(2):
+            check_patches(all_patches[img_idx * 4 : (img_idx + 1) * 4], all_coords[img_idx * 4 : (img_idx + 1) * 4])
+
+        if sys.platform != "win32":
+            # two workers should produce the same set of patch coordinates as a single process
+            worker_coords = []
+            for _, coords in DataLoader(ds, batch_size=2, num_workers=2):
+                worker_coords.extend(coords.numpy())
+            self.assertEqual(sorted(c.tolist() for c in worker_coords), sorted(c.tolist() for c in all_coords))
+
+    def test_no_length_raises(self):
+        ds = GridPatchDataset(dataset=NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertEqual(str(cm.exception), "image dataset must implement `len()`")
+
+
+if __name__ == "__main__":
+    unittest.main()
