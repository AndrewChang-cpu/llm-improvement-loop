+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# Expected patches (order: image 0 patches in visit order, then image 1) for `test_loading_array` with
+# `set_determinism(seed=1234)` and `RandShiftIntensity(offsets=1.0, prob=1.0)`.
+# PLACEHOLDER: these values were NOT computed (the environment did not allow running code). Replace the NaN array
+# with the literal values from one run of `test_loading_array` before relying on this test.
+EXPECTED_PATCHES = np.full((8, 1, 2, 2), np.nan)
+
+# Coordinates of the four 2x2 patches of one 1x4x4 image, in visit order (first spatial dimension varies fastest).
+# Each row is [start, stop] of a dimension in the original frame: channel, dimension 1, dimension 2.
+EXPECTED_COORDS_ONE_IMAGE = np.array(
+    [
+        [[0, 1], [0, 2], [0, 2]],
+        [[0, 1], [2, 4], [0, 2]],
+        [[0, 1], [0, 2], [2, 4]],
+        [[0, 1], [2, 4], [2, 4]],
+    ]
+)
+
+
+def _collect(loader):
+    patches, coords = [], []
+    for patch_batch, coord_batch in loader:
+        patches.append(patch_batch.numpy())
+        coords.append(coord_batch.numpy())
+    return np.concatenate(patches), np.concatenate(coords)
+
+
+def _char_generator(item):
+    # custom patch generator over string items, yields (item, index) tuples
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class _IterableOnlyImages:
+    # image dataset which supports iteration but not `len()`
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(
+            dataset=test_dataset, patch_iter=_char_generator, with_coordinates=False
+        )
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.append("".join(item))
+        joined = "".join(output)
+        self.assertEqual(sorted(joined), sorted("".join(test_dataset)))
+        self.assertEqual(len(joined), len("".join(test_dataset)))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+            np.arange(16, dtype=float).reshape(1, 4, 4) + 16,
+        ]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # set determinism after the transform is built and before the loader is constructed, since a zero-worker
+        # DataLoader reseeds randomizable components when it is constructed
+        set_determinism(seed=1234)
+        patches, coords = _collect(DataLoader(ds, batch_size=2, num_workers=0))
+
+        self.assertEqual(patches.shape, (8, 1, 2, 2))
+        np.testing.assert_allclose(patches, EXPECTED_PATCHES, rtol=0, atol=1e-5)
+
+        self.assertEqual(coords.shape, (8, 3, 2))
+        np.testing.assert_array_equal(coords, np.concatenate([EXPECTED_COORDS_ONE_IMAGE] * 2))
+
+        # the default batching of coordinates must also give shape (batch, 3, 2) per batch
+        for batch in DataLoader(ds, batch_size=2, num_workers=0):
+            self.assertEqual(batch[1].shape, (2, 3, 2))
+
+        if sys.platform != "win32":
+            # without a transform the patches are deterministic, so the two-worker run must match single process
+            plain = GridPatchDataset(dataset=images, patch_iter=patch_iter)
+            single_p, single_c = _collect(DataLoader(plain, batch_size=2, num_workers=0))
+            multi_p, multi_c = _collect(DataLoader(plain, batch_size=2, num_workers=2))
+            single_order = np.lexsort(single_p.reshape(len(single_p), -1).T)
+            multi_order = np.lexsort(multi_p.reshape(len(multi_p), -1).T)
+            np.testing.assert_allclose(multi_p[multi_order], single_p[single_order], rtol=0, atol=1e-3)
+            np.testing.assert_array_equal(multi_c[multi_order], single_c[single_order])
+
+    def test_missing_len(self):
+        ds = GridPatchDataset(dataset=_IterableOnlyImages(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
