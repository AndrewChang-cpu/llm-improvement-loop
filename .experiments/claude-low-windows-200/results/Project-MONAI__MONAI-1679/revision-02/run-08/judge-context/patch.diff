+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an input dataset. The patches are chosen in a contiguous grid sampling scheme
+    by a patch generator (for example :py:class:`PatchIter`), and each patch is optionally processed by a transform.
+    By default each element is a ``(patch, coordinates)`` pair, where the coordinates are an integer array of shape
+    (number of dimensions, 2) giving the start and stop of each dimension (including the channel dimension) of the patch
+    in the original image frame.
+
+    The following example builds two single-channel 4x4 images, takes 2x2 patches with a start position of (0, 0),
+    applies a random intensity shift to each patch, and iterates the dataset with a two-worker data loader:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches, start position (0, 0) in the channel-first array
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        loader = DataLoader(ds, batch_size=2, num_workers=2)
+        patches, coords = next(iter(loader))
+        print(patches.shape)
+
+        >>> torch.Size([2, 1, 2, 2])
+
+        print(coords.shape)
+
+        >>> torch.Size([2, 3, 2])
+
+    Each patch has shape (channel, patch height, patch width), so here (1, 2, 2). Each coordinate array has one row
+    per dimension of the image including the channel dimension, so here 3 rows of ``[start, stop]``. The channel row is
+    ``[0, 1]`` and the spatial rows give the patch extents, for example ``[0, 2]`` and ``[0, 2]`` for the first patch.
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
+        """
+        Args:
