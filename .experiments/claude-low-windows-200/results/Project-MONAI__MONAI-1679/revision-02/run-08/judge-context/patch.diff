+import sys
+import unittest
+
+import numpy as np
+import torch
+from torch.utils.data import DataLoader
+
+from monai.data import GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+# Expected patch values for `test_loading_array`, shape (8, 1, 2, 2) in visit order (image 0 then image 1).
+# TODO: these literal constants have not been filled in; they must be taken from a verified run of
+# `test_loading_array` with seed 1234 and the RandShiftIntensity configuration used there.
+EXPECTED_PATCH_VALUES = None
+
+# Expected coordinates for one 1x4x4 image in visit order: rows are channel, dimension 1, dimension 2.
+EXPECTED_COORDS = np.array(
+    [
+        [[0, 1], [0, 2], [0, 2]],
+        [[0, 1], [2, 4], [0, 2]],
+        [[0, 1], [0, 2], [2, 4]],
+        [[0, 1], [2, 4], [2, 4]],
+    ],
+    dtype=int,
+)
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        items = ["test string1", "test string2", "test string3", "test string4", "test string5"]
+
+        def _gen(item):
+            yield item, 0
+
+        dataset = GridPatchDataset(items, _gen, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        total = 0
+        for batch in loader:
+            total += len(batch)
+            output.extend(batch)
+        self.assertEqual(total, len(items))
+        self.assertEqual(sorted(output), sorted(items))
+
+    def test_loading_array(self):
+        images = [
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+            np.arange(16, 32, dtype=float).reshape(1, 4, 4),
+        ]
+
+        def _make_loader(num_workers):
+            set_determinism(seed=1234)
+            patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+            transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+            dataset = GridPatchDataset(images, patch_iter, transform=transform)
+            return DataLoader(dataset, batch_size=2, num_workers=num_workers)
+
+        # single process
+        patches, coords = [], []
+        for batch_patches, batch_coords in _make_loader(0):
+            self.assertEqual(tuple(batch_patches.shape), (2, 1, 2, 2))
+            patches.append(batch_patches)
+            coords.append(batch_coords)
+        patches = torch.cat(patches).numpy()
+        coords = torch.cat(coords).numpy()
+
+        self.assertEqual(coords.shape, (8, 3, 2))
+        for i in range(2):
+            np.testing.assert_array_equal(coords[i * 4 : (i + 1) * 4], EXPECTED_COORDS)
+        np.testing.assert_allclose(patches, EXPECTED_PATCH_VALUES, rtol=0, atol=1e-5)
+
+        if sys.platform != "win32":
+            # two workers should produce the same patches as a single process
+            multi_patches = []
+            for batch_patches, _ in _make_loader(2):
+                multi_patches.append(batch_patches)
+            multi_patches = torch.cat(multi_patches).numpy()
+            self.assertEqual(multi_patches.shape, (8, 1, 2, 2))
+            np.testing.assert_allclose(
+                np.sort(multi_patches.ravel()),
+                np.sort(np.asarray(EXPECTED_PATCH_VALUES).ravel()),
+                rtol=0,
+                atol=1e-3,
+            )
+
+    def test_missing_len_raises(self):
+        class _NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(_NoLen(), PatchIter(patch_size=(2, 2)), with_coordinates=False)
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
