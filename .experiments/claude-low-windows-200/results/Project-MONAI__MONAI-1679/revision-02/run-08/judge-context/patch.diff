+                is the built-in generator.
+            transform: transform applied to each patch alone (it never receives the coordinates). Defaults to None.
+            with_coordinates: if True (default), each element is a ``(patch, coordinates)`` pair. If False, each element
+                is the patch only.
+        """
+        self.dataset = dataset
+        self.patch_iter = patch_iter
+        self.transform = transform
+        self.with_coordinates = with_coordinates
+
