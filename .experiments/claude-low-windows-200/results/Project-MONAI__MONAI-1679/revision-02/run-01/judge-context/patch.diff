+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def pairs_generator(item):
+    # yields (item, index) tuples for each element of a string item
+    return ((c, i) for i, c in enumerate(item))
+
+
+class NoLengthDataset:
+    # an image dataset that does not support len()
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=pairs_generator, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.append("".join(item))
+        joined = "".join(output)
+        self.assertEqual(len(joined), sum(len(s) for s in test_dataset))
+        self.assertEqual(sorted(joined), sorted("".join(test_dataset)))
+
+    def _expected_coords(self, image_shape, patch_size):
+        # expected (channels + spatial, 2) coordinate arrays in visit order, first spatial dimension fastest
+        c = image_shape[0]
+        coords = []
+        for start_c in range(0, image_shape[2], patch_size[1]):
+            for start_r in range(0, image_shape[1], patch_size[0]):
+                coords.append(
+                    np.array(
+                        [
+                            [0, c],
+                            [start_r, start_r + patch_size[0]],
+                            [start_c, start_c + patch_size[1]],
+                        ]
+                    )
+                )
+        return coords
+
+    def test_loading_array(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        expected = self._expected_coords((1, 4, 4), (2, 2))
+        # single process: patches of image 0 then image 1, batches of 2
+        all_patches, all_coords = [], []
+        for patches, coords in DataLoader(ds, batch_size=2, shuffle=False, num_workers=0):
+            np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+            np.testing.assert_equal(tuple(coords.shape), (2, 3, 2))
+            all_patches.extend(patches.numpy())
+            all_coords.extend(coords.numpy())
+
+        self.assertEqual(len(all_patches), 8)
+        for i, (patch, coord) in enumerate(zip(all_patches, all_coords)):
+            image = images[i // 4]
+            np.testing.assert_equal(coord, expected[i % 4])
+            (r0, r1), (c0, c1) = coord[1:]
+            base = image[:, r0:r1, c0:c1]
+            shift = patch - base
+            # one constant shift per patch, drawn from the RandShiftIntensity range
+            np.testing.assert_allclose(shift, np.full_like(shift, shift.flat[0]), atol=1e-5)
+            self.assertLessEqual(abs(shift.flat[0]), 1.0 + 1e-5)
+
+        if sys.platform != "win32":
+            # two workers produce the same set of patches and coordinates
+            multi_patches, multi_coords = [], []
+            for patches, coords in DataLoader(ds, batch_size=2, shuffle=False, num_workers=2):
+                np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+                multi_patches.extend(patches.numpy())
+                multi_coords.extend(coords.numpy())
+            self.assertEqual(len(multi_patches), 8)
+            # the same set of coordinates is covered, with each index visited exactly once
+            def key(c):
+                return tuple(c.flatten().tolist())
+
+            self.assertEqual(sorted(key(c) for c in multi_coords), sorted(key(c) for c in expected * 2))
+            for patch, coord in zip(multi_patches, multi_coords):
+                (r0, r1), (c0, c1) = coord[1:]
+                matched = [images[k][:, r0:r1, c0:c1] for k in range(2)]
+                shifts = [patch - b for b in matched]
+                ok = [
+                    np.allclose(s, np.full_like(s, s.flat[0]), atol=1e-3) and abs(s.flat[0]) <= 1.0 + 1e-3
+                    for s in shifts
+                ]
+                self.assertTrue(any(ok))
+
+    def test_missing_len(self):
+        ds = GridPatchDataset(dataset=NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
