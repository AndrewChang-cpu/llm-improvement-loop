+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an input dataset. The patches are chosen in a contiguous grid sampling scheme
+    by a patch generator, such as :py:class:`PatchIter`, and each patch can be post-processed by a transform. Each
+    image item is a single channel-first image. The dataset is split across data-loader workers so that each index is
+    visited by exactly one worker.
+
+    Each element is a ``(patch, coordinates)`` pair when `with_coordinates` is True (the default), or only the patch
+    otherwise. The coordinates are an integer array of shape ``(channels + spatial dimensions, 2)`` where each row
+    holds the start and stop of that dimension for the patch in the original image frame, so the first row is
+    ``[0, C]`` for an image with ``C`` channels. For a single-channel 4x4 image sampled with 2x2 patches, the patch
+    shape is ``(1, 2, 2)`` and the coordinates are ``[[0, 1], [0, 2], [0, 2]]`` for the first patch.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # iterate with two workers, each yielding (patch, coordinates) pairs
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
