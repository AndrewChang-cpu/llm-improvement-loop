+class TestGridPatchDataset(unittest.TestCase):
+    def test_patch_transform(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+        ds = GridPatchDataset(images, patch_size=(2, 2), transform=lambda patches: tuple(p + 100 for p in patches))
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        for item in items:
+            self.assertIsInstance(item, tuple)
+            np.testing.assert_equal(item[0].min() >= 100, True)
+
+    def test_coordinates(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+        ds = GridPatchDataset(images, patch_size=(2, 2), with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        coords = sorted(tuple(c) for _, c in items)
+        self.assertEqual(coords, [(0, 0, 0), (0, 0, 2), (0, 2, 0), (0, 2, 2)])
+        for patches, coord in items:
+            self.assertEqual(len(patches), 1)
+            np.testing.assert_equal(tuple(patches[0].shape), (1, 2, 2))
+            # the patch content must match the array at the reported coordinate
+            h, w = coord[1], coord[2]
+            np.testing.assert_allclose(patches[0], images[0][:, h : h + 2, w : w + 2])
+
+
