+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+from monai.transforms import Lambda
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        self.images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+
+    def test_patches_and_coordinates(self):
+        ds = GridPatchDataset(self.images, patch_size=(2, 2))
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        patches, coords = items[0]
+        self.assertEqual(len(patches), 1)
+        self.assertEqual(tuple(patches[0].shape), (1, 2, 2))
+        self.assertEqual(coords, ((0, 0, 0),))
+        self.assertEqual([c[0] for _, c in items], [(0, 0, 0), (0, 2, 0), (0, 0, 2), (0, 2, 2)])
+
+    def test_without_coordinates(self):
+        ds = GridPatchDataset(self.images, patch_size=(2, 2), with_coordinates=False)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        self.assertEqual(len(items[0]), 1)
+        self.assertEqual(tuple(items[0][0].shape), (1, 2, 2))
+
+    def test_patch_transform(self):
+        ds = GridPatchDataset(
+            self.images,
+            patch_size=(2, 2),
+            transform=Lambda(lambda patches: tuple(p + 100 for p in patches)),
+            with_coordinates=True,
+        )
+        for patches, coords in ds:
+            self.assertTrue(np.all(patches[0] >= 100))
+            # coordinates are not affected by the patch transform
+            self.assertEqual(len(coords[0]), 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
