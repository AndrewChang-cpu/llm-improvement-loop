+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        self.image = np.arange(16, dtype=np.float32).reshape(1, 4, 4)
+        self.dataset = [(self.image,)]
+
+    def test_patches_without_coordinates(self):
+        ds = GridPatchDataset(self.dataset, patch_size=(2, 2), with_coordinates=False)
+        patches = list(ds)
+        self.assertEqual(len(patches), 4)
+        for p in patches:
+            self.assertEqual(p[0].shape, (1, 2, 2))
+
+    def test_patches_with_coordinates(self):
+        ds = GridPatchDataset(self.dataset, patch_size=(2, 2), with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        locations = []
+        for patches, loc in items:
+            self.assertEqual(patches[0].shape, (1, 2, 2))
+            locations.append(tuple(int(v) for v in loc))
+            # the patch content must match the array at the reported location
+            r, c = loc
+            np.testing.assert_array_equal(patches[0], self.image[:, r : r + 2, c : c + 2])
+        self.assertEqual(sorted(locations), [(0, 0), (0, 2), (2, 0), (2, 2)])
+
+    def test_patch_transform(self):
+        def double(patches):
+            return tuple(p * 2 for p in patches)
+
+        ds = GridPatchDataset(self.dataset, patch_size=(2, 2), transform=double, with_coordinates=False)
+        for patches in ds:
+            self.assertEqual(patches[0].shape, (1, 2, 2))
+            self.assertTrue(np.all(patches[0] % 2 == 0))
+
+    def test_transform_and_coordinates(self):
+        ds = GridPatchDataset(
+            self.dataset,
+            patch_size=(2, 2),
+            transform=lambda patches: tuple(p + 1 for p in patches),
+            with_coordinates=True,
+        )
+        for patches, loc in ds:
+            r, c = loc
+            np.testing.assert_array_equal(patches[0], self.image[:, r : r + 2, c : c + 2] + 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
