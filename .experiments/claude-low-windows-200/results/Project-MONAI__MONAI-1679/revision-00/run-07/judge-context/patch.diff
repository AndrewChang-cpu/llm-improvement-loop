+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        # one channel, 4 long; with patch size 2 and zero padding the grid positions are (padded) starts 2 and 4
+        self.arr = np.array([[0, 1, 2, 3]], dtype=np.float32)
+
+    def test_default_output_unchanged(self):
+        ds = GridPatchDataset([(self.arr,)], patch_size=(2,), mode="constant")
+        items = list(ds)
+        self.assertEqual(len(items), 2)
+        np.testing.assert_allclose(items[0][0], [[1, 2]])
+        np.testing.assert_allclose(items[1][0], [[3, 0]])
+
+    def test_with_coordinates(self):
+        ds = GridPatchDataset([(self.arr,)], patch_size=(2,), mode="constant", with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 2)
+        coords, patches = items[0]
+        self.assertEqual(tuple(coords), (0, 0))
+        np.testing.assert_allclose(patches[0], [[1, 2]])
+        coords, patches = items[1]
+        self.assertEqual(tuple(coords), (0, 2))
+        np.testing.assert_allclose(patches[0], [[3, 0]])
+
+    def test_transform_applied_to_patches(self):
+        def add_one(patches):
+            return tuple(p + 1 for p in patches)
+
+        ds = GridPatchDataset([(self.arr,)], patch_size=(2,), mode="constant", transform=add_one)
+        items = list(ds)
+        np.testing.assert_allclose(items[0][0], [[2, 3]])
+        np.testing.assert_allclose(items[1][0], [[4, 1]])
+
+    def test_transform_and_coordinates(self):
+        def add_one(patches):
+            return tuple(p + 1 for p in patches)
+
+        ds = GridPatchDataset(
+            [(self.arr,)], patch_size=(2,), mode="constant", transform=add_one, with_coordinates=True
+        )
+        items = list(ds)
+        self.assertEqual(tuple(items[1][0]), (0, 2))
+        np.testing.assert_allclose(items[1][1][0], [[4, 1]])
+
+
+if __name__ == "__main__":
+    unittest.main()
