+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        self.arr = np.arange(16, dtype=float).reshape(1, 4, 4)
+        self.dataset = [[self.arr]]
+
+    def test_no_coordinates(self):
+        ds = GridPatchDataset(dataset=self.dataset, patch_size=(2, 2), mode="constant")
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        for item in items:
+            self.assertEqual(len(item), 1)
+            self.assertIsInstance(item[0], np.ndarray)
+        np.testing.assert_allclose(items[0][0], np.array([[[0.0, 1.0], [4.0, 5.0]]]))
+
+    def test_with_coordinates(self):
+        ds = GridPatchDataset(dataset=self.dataset, patch_size=(2, 2), mode="constant", with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        patch, coords = items[0][0]
+        np.testing.assert_allclose(patch, np.array([[[0.0, 1.0], [4.0, 5.0]]]))
+        self.assertEqual(tuple(coords), (0, 0, 0))
+
+    def test_patch_transform(self):
+        ds = GridPatchDataset(
+            dataset=self.dataset,
+            patch_size=(2, 2),
+            mode="constant",
+            transform=lambda x: x + 100.0,
+            with_coordinates=True,
+        )
+        patch, coords = next(iter(ds))[0]
+        np.testing.assert_allclose(patch, np.array([[[100.0, 101.0], [104.0, 105.0]]]))
+        self.assertEqual(tuple(coords), (0, 0, 0))
+
+
+if __name__ == "__main__":
+    unittest.main()
