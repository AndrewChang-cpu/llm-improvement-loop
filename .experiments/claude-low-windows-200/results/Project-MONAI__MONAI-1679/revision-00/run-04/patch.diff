+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+from monai.transforms import Lambda
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def test_patch_count_and_shape(self):
+        images = [np.arange(16, dtype=np.float32).reshape(1, 4, 4)]
+        ds = GridPatchDataset(dataset=[images], patch_size=(2, 2), mode="constant")
+        patches = [p[0] for p in ds]
+        self.assertEqual(len(patches), 4)
+        for p in patches:
+            self.assertEqual(p.shape, (1, 2, 2))
+
+    def test_patch_transform(self):
+        images = [np.ones((1, 4, 4), dtype=np.float32)]
+        ds = GridPatchDataset(
+            dataset=[images], patch_size=(2, 2), mode="constant", transform=Lambda(lambda x: x * 3)
+        )
+        for (patch,) in ds:
+            np.testing.assert_allclose(patch, np.full((1, 2, 2), 3.0))
+
+    def test_coordinates(self):
+        images = [np.arange(16, dtype=np.float32).reshape(1, 4, 4)]
+        ds = GridPatchDataset(dataset=[images], patch_size=(2, 2), mode="constant", with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        for (patches, coords) in items:
+            (patch,) = patches
+            (coord,) = coords
+            # coordinates locate the patch in the original (unpadded) array
+            np.testing.assert_allclose(patch, images[0][coord])
+            self.assertEqual(len(coord), 3)
+
+    def test_coordinates_with_padding(self):
+        images = [np.arange(4, dtype=np.float32).reshape(1, 4)]
+        ds = GridPatchDataset(dataset=[images], patch_size=(3,), mode="constant", with_coordinates=True)
+        for (patches, coords) in ds:
+            (patch,) = patches
+            (coord,) = coords
+            self.assertEqual(patch.shape, (1, 3))
+            # the spatial slice has the patch size, and it may extend beyond the array bounds
+            self.assertEqual(coord[-1].stop - coord[-1].start, 3)
+
+
+if __name__ == "__main__":
+    unittest.main()
