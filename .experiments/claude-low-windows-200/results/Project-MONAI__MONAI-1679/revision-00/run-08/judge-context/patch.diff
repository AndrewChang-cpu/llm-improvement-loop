+class TestGridPatchDataset(unittest.TestCase):
+    def test_patches_without_coordinates(self):
+        img = np.arange(16, dtype=float).reshape(1, 4, 4)
+        ds = GridPatchDataset(dataset=[img], patch_size=(2, 2))
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        for patches in items:
+            self.assertIsInstance(patches, tuple)
+            self.assertEqual(patches[0].shape, (1, 2, 2))
+
+    def test_patches_with_coordinates(self):
+        img = np.arange(16, dtype=float).reshape(1, 4, 4)
+        ds = GridPatchDataset(dataset=[img], patch_size=(2, 2), with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        for patches, coords in items:
+            self.assertEqual(len(coords), 1)
+            start = coords[0]
+            self.assertEqual(len(start), 3)
+            r, c = start[1], start[2]
+            np.testing.assert_equal(patches[0], img[:, r : r + 2, c : c + 2])
+
+    def test_patch_transform(self):
+        img = np.arange(16, dtype=float).reshape(1, 4, 4)
+
+        def shift(patches):
+            return tuple(p + 100.0 for p in patches)
+
+        ds = GridPatchDataset(dataset=[img], patch_size=(2, 2), transform=shift, with_coordinates=True)
+        for patches, coords in ds:
+            start = coords[0]
+            r, c = start[1], start[2]
+            np.testing.assert_allclose(patches[0], img[:, r : r + 2, c : c + 2] + 100.0)
+
+
