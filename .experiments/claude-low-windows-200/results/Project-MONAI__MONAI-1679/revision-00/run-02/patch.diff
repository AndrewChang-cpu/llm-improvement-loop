+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        self.image = np.arange(16, dtype=np.float32).reshape(1, 4, 4)
+        self.label = np.arange(16, dtype=np.float32).reshape(1, 4, 4) + 100
+        self.data = [(self.image, self.label)]
+
+    def test_default_output_is_patch_tuple(self):
+        ds = GridPatchDataset(self.data, patch_size=(2, 2))
+        items = list(ds)
+        self.assertEqual(len(items), 4 * 4)  # wrap mode: one patch per grid position
+        for item in items:
+            self.assertIsInstance(item, tuple)
+            self.assertEqual(len(item), 2)
+            self.assertEqual(item[0].shape, (1, 2, 2))
+            self.assertEqual(item[1].shape, (1, 2, 2))
+
+    def test_with_coordinates(self):
+        ds = GridPatchDataset(self.data, patch_size=(2, 2), with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 16)
+        for patches, coords in items:
+            self.assertEqual(len(patches), 2)
+            self.assertEqual(len(coords), 2)
+            for c in coords:
+                self.assertEqual(c.shape, (3,))
+        # the first patch of the image starts at the origin
+        patches, coords = items[0]
+        np.testing.assert_array_equal(coords[0], np.array([0, 0, 0]))
+        np.testing.assert_array_equal(patches[0], self.image[:, 0:2, 0:2])
+
+    def test_coordinates_match_patch_content(self):
+        ds = GridPatchDataset(self.data, patch_size=(2, 2), mode="constant", with_coordinates=True)
+        for patches, coords in ds:
+            start = coords[0]
+            # coordinates index the unpadded image, so the patch must match the image window at that position
+            # when the window lies inside the image
+            if np.all(start >= 0) and np.all(start[1:] + 2 <= 4):
+                np.testing.assert_array_equal(patches[0], self.image[:, start[1] : start[1] + 2, start[2] : start[2] + 2])
+
+    def test_patch_transform_applied(self):
+        def add_one(patches):
+            return tuple(p + 1 for p in patches)
+
+        ds = GridPatchDataset(self.data, patch_size=(2, 2), transform=add_one)
+        items = list(ds)
+        np.testing.assert_array_equal(items[0][0], self.image[:, 0:2, 0:2] + 1)
+        np.testing.assert_array_equal(items[0][1], self.label[:, 0:2, 0:2] + 1)
+
+    def test_transform_not_applied_to_coordinates(self):
+        def zero(patches):
+            return tuple(p * 0 for p in patches)
+
+        ds = GridPatchDataset(self.data, patch_size=(2, 2), transform=zero, with_coordinates=True)
+        for patches, coords in ds:
+            self.assertTrue(np.all(patches[0] == 0))
+            self.assertEqual(coords[0].dtype, np.int64)
+
+
+if __name__ == "__main__":
+    unittest.main()
