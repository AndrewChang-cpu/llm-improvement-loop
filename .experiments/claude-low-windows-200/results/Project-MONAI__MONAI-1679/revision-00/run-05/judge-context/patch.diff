+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        self.arr = np.arange(16, dtype=np.float32).reshape(1, 4, 4)
+        self.dataset = [(self.arr,)]
+
+    def test_patches_without_coordinates(self):
+        ds = GridPatchDataset(self.dataset, patch_size=(2, 2), with_coordinates=False)
+        patches = list(ds)
+        self.assertEqual(len(patches), 4)
+        for p in patches:
+            self.assertEqual(len(p), 1)
+            self.assertEqual(p[0].shape, (1, 2, 2))
+
+    def test_coordinates_are_patch_starts(self):
+        ds = GridPatchDataset(self.dataset, patch_size=(2, 2), with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        coords = [c for _, c in items]
+        self.assertEqual(coords, [(0, 0), (0, 2), (2, 0), (2, 2)])
+        for (patches, _), c in items:
+            np.testing.assert_array_equal(patches[0][0], self.arr[0, c[0] : c[0] + 2, c[1] : c[1] + 2])
+
+    def test_transform_applied_to_patches(self):
+        def add_one(patches):
+            return tuple(p + 1 for p in patches)
+
+        ds = GridPatchDataset(self.dataset, patch_size=(2, 2), transform=add_one, with_coordinates=False)
+        for p in ds:
+            self.assertTrue(p[0].min() >= 1)
+        first = next(iter(ds))
+        np.testing.assert_array_equal(first[0], self.arr[:, :2, :2] + 1)
+
+    def test_transform_with_coordinates(self):
+        ds = GridPatchDataset(self.dataset, patch_size=(2, 2), transform=lambda ps: ps, with_coordinates=True)
+        for (patches, coords) in ds:
+            self.assertEqual(len(coords), 2)
+            self.assertEqual(patches[0].shape, (1, 2, 2))
+
+
+if __name__ == "__main__":
+    unittest.main()
