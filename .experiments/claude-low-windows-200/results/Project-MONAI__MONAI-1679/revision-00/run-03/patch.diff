+
+import unittest
+
+import numpy as np
+
+from monai.data import GridPatchDataset
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        self.image = np.arange(16, dtype=np.float32).reshape(1, 4, 4)
+        self.label = self.image + 100
+
+    def test_default_yields_patch_tuples(self):
+        ds = GridPatchDataset([(self.image, self.label)], patch_size=(2, 2))
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        for patches in items:
+            self.assertEqual(len(patches), 2)
+            self.assertEqual(patches[0].shape, (1, 2, 2))
+            self.assertEqual(patches[1].shape, (1, 2, 2))
+
+    def test_with_coordinates(self):
+        ds = GridPatchDataset([(self.image, self.label)], patch_size=(2, 2), with_coordinates=True)
+        items = list(ds)
+        self.assertEqual(len(items), 4)
+        coords_seen = set()
+        for patches, coords in items:
+            self.assertEqual(len(coords), 2)
+            self.assertTrue(all(isinstance(c, slice) for c in coords))
+            # patch content must match the array at the reported location
+            np.testing.assert_array_equal(patches[0], self.image[(slice(None),) + coords])
+            np.testing.assert_array_equal(patches[1], self.label[(slice(None),) + coords])
+            coords_seen.add((coords[0].start, coords[1].start))
+        self.assertEqual(coords_seen, {(0, 0), (0, 2), (2, 0), (2, 2)})
+
+    def test_patch_transform(self):
+        def add_one(patches):
+            return tuple(p + 1 for p in patches)
+
+        ds = GridPatchDataset([(self.image, self.label)], patch_size=(2, 2), transform=add_one)
+        for patches in ds:
+            self.assertEqual(patches[0].shape, (1, 2, 2))
+            self.assertTrue(np.all(patches[0] >= 1))
+
+    def test_transform_not_applied_to_coordinates(self):
+        def add_one(patches):
+            return tuple(p + 1 for p in patches)
+
+        ds = GridPatchDataset(
+            [(self.image, self.label)], patch_size=(2, 2), transform=add_one, with_coordinates=True
+        )
+        for (patches, coords) in ds:
+            np.testing.assert_array_equal(patches[0], self.image[(slice(None),) + coords] + 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
