+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter, iter_patch
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+class _CharGenerator:
+    """Custom patch generator: yields one (character, index) tuple per character of an item."""
+
+    def __call__(self, item):
+        for i, ch in enumerate(item):
+            yield ch, i
+
+
+class _NoLength:
+    """Image dataset without len()."""
+
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(None)
+
+    def test_shape(self):
+        items = ["abcdefgh", "ijklmnopq", "rstuvwxyz"]
+        ds = GridPatchDataset(dataset=items, patch_iter=_CharGenerator(), with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        chunks = list(DataLoader(ds, batch_size=3, num_workers=num_workers))
+        flat = sorted(c for chunk in chunks for c in chunk)
+        self.assertEqual(len(flat), sum(len(s) for s in items))
+        self.assertEqual(flat, sorted(c for s in items for c in s))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        transform = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+
+        # single-process block
+        loader = DataLoader(ds, batch_size=2, num_workers=0)
+        batches = list(loader)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+        patches, coords = batches[-1]
+        expected_patches = np.array(
+            [
+                [[1.7413, 2.7413], [5.7413, 6.7413]],
+                [[9.1419, 10.1419], [13.1419, 14.1419]],
+            ]
+        )
+        np.testing.assert_allclose(patches.numpy()[:, 0], expected_patches, atol=1e-5)
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_allclose(coords.numpy(), expected_coords, atol=1e-5)
+
+        # two-worker block
+        if sys.platform != "win32":
+            ds2 = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=transform)
+            batches2 = list(DataLoader(ds2, batch_size=2, num_workers=2))
+            self.assertEqual(len(batches2), len(batches))
+            for patches2, _ in batches2:
+                self.assertEqual(tuple(patches2.shape), (2, 1, 2, 2))
+            patches2, coords2 = batches2[-1]
+            np.testing.assert_allclose(coords2.numpy(), expected_coords, atol=1e-5)
+            expected_patches2 = np.array(
+                [
+                    [[2.3944, 3.3944], [6.3944, 7.3944]],
+                    [[10.6551, 11.6551], [14.6551, 15.6551]],
+                ]
+            )
+            np.testing.assert_allclose(patches2.numpy()[:, 0], expected_patches2, atol=1e-3)
+
+    def test_default_coordinates_are_pairs(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+        ds = GridPatchDataset(dataset=images, patch_iter=PatchIter(patch_size=(2, 2)))
+        for patch, coords in ds:
+            self.assertEqual(tuple(patch.shape), (1, 2, 2))
+            self.assertEqual(tuple(coords.shape), (3, 2))
+            self.assertEqual(coords.tolist()[0], [0, 1])
+
+    def test_transform_receives_single_patch(self):
+        seen = []
+
+        def record(patch):
+            seen.append(patch)
+            return patch
+
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+        ds = GridPatchDataset(dataset=images, patch_iter=PatchIter(patch_size=(2, 2)), transform=record)
+        list(ds)
+        self.assertEqual(len(seen), 4)
+        for p in seen:
+            self.assertIsInstance(p, np.ndarray)
+            self.assertEqual(p.shape, (1, 2, 2))
+
+    def test_no_length_raises(self):
+        ds = GridPatchDataset(dataset=_NoLength(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(ds))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+    def test_patch_iter_start_pos_uses_channel_entry(self):
+        arr = np.arange(20 * 20 * 20, dtype=float).reshape(1, 20, 20, 20)
+        expected = list(iter_patch(arr, (10, 10, 10), (0, 4, 4, 4), False))
+        got = list(PatchIter(patch_size=(10, 10, 10), start_pos=(0, 4, 4, 4))(arr))
+        self.assertEqual(len(expected), len(got))
+        for (p1, c1), (p2, c2) in zip(expected, got):
+            np.testing.assert_array_equal(p1, p2)
+            np.testing.assert_array_equal(c1, c2)
+
+
+if __name__ == "__main__":
+    unittest.main()
