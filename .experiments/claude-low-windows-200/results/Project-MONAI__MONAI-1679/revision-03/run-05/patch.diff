+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_patches(item):
+    """Custom patch generator: yields one (character, index) tuple per character of the string item."""
+    for index, char in enumerate(item):
+        yield char, index
+
+
+class _NoLengthDataset:
+    """Image dataset which does not implement ``len()``."""
+
+    def __init__(self, data):
+        self.data = data
+
+    def __getitem__(self, index):
+        return self.data[index]
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["test1", "test2", "test3", "test4"]
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=_char_patches, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+
+        result = []
+        for batch in DataLoader(dataset, batch_size=3, num_workers=num_workers):
+            result.extend(batch)
+
+        expected = sorted("".join(test_data))
+        self.assertEqual(len(result), len(expected))
+        self.assertEqual(sorted(result), expected)
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        shift_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=shift_intensity)
+
+        batches = list(DataLoader(dataset, batch_size=2, num_workers=0))
+        self.assertEqual(len(batches), 4)
+        for patches, _ in batches:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+        final_patches, final_coords = batches[-1]
+        np.testing.assert_allclose(
+            final_patches[0, 0].numpy(), [[1.7413, 2.7413], [5.7413, 6.7413]], rtol=0, atol=1e-5
+        )
+        np.testing.assert_allclose(
+            final_patches[1, 0].numpy(), [[9.1419, 10.1419], [13.1419, 14.1419]], rtol=0, atol=1e-5
+        )
+        np.testing.assert_array_equal(final_coords[0].numpy(), [[0, 1], [0, 2], [2, 4]])
+        np.testing.assert_array_equal(final_coords[1].numpy(), [[0, 1], [2, 4], [2, 4]])
+
+        if sys.platform != "win32":
+            set_determinism(seed=1234)
+            worker_dataset = GridPatchDataset(
+                dataset=images,
+                patch_iter=PatchIter(patch_size=(2, 2), start_pos=(0, 0)),
+                transform=RandShiftIntensity(offsets=1.0, prob=1.0),
+            )
+            worker_batches = list(DataLoader(worker_dataset, batch_size=2, num_workers=2))
+            self.assertEqual(len(worker_batches), 4)
+            for patches, _ in worker_batches:
+                self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+
+            worker_patches, worker_coords = worker_batches[-1]
+            np.testing.assert_allclose(worker_coords.numpy(), final_coords.numpy(), rtol=0, atol=1e-5)
+            np.testing.assert_allclose(
+                worker_patches[0, 0].numpy(), [[2.3944, 3.3944], [6.3944, 7.3944]], rtol=0, atol=1e-3
+            )
+            np.testing.assert_allclose(
+                worker_patches[1, 0].numpy(), [[10.6551, 11.6551], [14.6551, 15.6551]], rtol=0, atol=1e-3
+            )
+
+    def test_missing_length(self):
+        dataset = GridPatchDataset(
+            dataset=_NoLengthDataset([np.zeros((1, 4, 4))]), patch_iter=PatchIter(patch_size=(2, 2))
+        )
+        with self.assertRaises(NotImplementedError) as cm:
+            next(iter(dataset))
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
