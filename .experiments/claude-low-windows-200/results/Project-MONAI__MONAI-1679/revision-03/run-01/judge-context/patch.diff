+                is the built-in patch generator.
+            transform: a MONAI transform applied to each patch alone. Defaults to None, which leaves patches unchanged.
+            with_coordinates: if True (default), yield ``(patch, coordinates)`` pairs; if False, yield only the patches.
+        """
+        self.dataset = dataset
+        self.patch_iter = patch_iter
+        self.transform = transform
+        self.with_coordinates = with_coordinates
