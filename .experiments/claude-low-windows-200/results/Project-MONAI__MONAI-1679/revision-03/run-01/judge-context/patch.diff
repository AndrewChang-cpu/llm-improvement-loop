+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_data = ["vwnaiogrtfkymj", "hrmbdagpgjmaeh", "nlcfpdzbldhlipe"]
+
+        def chars_iter(item):
+            for index, character in enumerate(item):
+                yield character, index
+
+        dataset = GridPatchDataset(dataset=test_data, patch_iter=chars_iter, with_coordinates=False)
+        num_workers = 0 if sys.platform == "win32" else 2
+        loader = DataLoader(dataset, batch_size=3, num_workers=num_workers)
+
+        output = []
+        for chunk in loader:
+            output.extend(chunk)
+
+        self.assertEqual(len(output), sum(len(s) for s in test_data))
+        self.assertEqual(sorted(output), sorted("".join(test_data)))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        images = [
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+            np.arange(16, dtype=float).reshape(1, 4, 4),
+        ]
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+        loader = DataLoader(dataset, batch_size=2, num_workers=0)
+
+        last_patches, last_coords = None, None
+        num_batches = 0
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+            num_batches += 1
+        self.assertEqual(num_batches, 4)
+
+        expected_patches = np.array(
+            [
+                [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+            ]
+        )
+        np.testing.assert_allclose(np.asarray(last_patches), expected_patches, atol=1e-5)
+
+        expected_coords = np.array(
+            [
+                [[0, 1], [0, 2], [2, 4]],
+                [[0, 1], [2, 4], [2, 4]],
+            ]
+        )
+        np.testing.assert_allclose(np.asarray(last_coords), expected_coords, atol=1e-5)
+
+        if sys.platform == "win32":
+            return
+
+        # two-worker run: the random shifts are drawn under worker seeding, so patch values are pinned separately
+        set_determinism(seed=1234)
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        dataset = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+        loader = DataLoader(dataset, batch_size=2, num_workers=2)
+
+        last_patches, last_coords = None, None
+        num_batches = 0
+        for patches, coords in loader:
+            self.assertEqual(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+            num_batches += 1
+        self.assertEqual(num_batches, 4)
+
+        np.testing.assert_allclose(np.asarray(last_coords), expected_coords, atol=1e-5)
+
+        expected_worker_patches = np.array(
+            [
+                [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+            ]
+        )
+        np.testing.assert_allclose(np.asarray(last_patches), expected_worker_patches, atol=1e-3)
+
+    def test_missing_len(self):
+        class NoLenDataset:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        dataset = GridPatchDataset(dataset=NoLenDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(dataset)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
