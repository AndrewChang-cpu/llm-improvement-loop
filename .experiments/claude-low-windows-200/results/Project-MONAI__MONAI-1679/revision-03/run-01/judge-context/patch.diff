+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from image items read from an input dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator, such as :py:class:`PatchIter`, and each patch can be post-processed by a transform.
+
+    Each image item is a single channel-first array. The patch generator is called once per item, and every patch it
+    yields is passed through ``transform`` on its own. When ``with_coordinates`` is True (the default), each element is
+    a ``(patch, coordinates)`` pair, where ``coordinates`` is an integer array of shape (ndim, 2) holding the start and
+    stop of each dimension (including the channel dimension) of the patch in the original, unpadded image.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # grid sampler: 2x2 patches, starting at the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the patch dataset
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # iterate with two workers
+        loader = DataLoader(ds, batch_size=2, num_workers=2)
+        patches, coords = next(iter(loader))
+
+        patches.shape
+        >>> torch.Size([2, 1, 2, 2])
+
+        coords.shape
+        >>> torch.Size([2, 3, 2])
+
+    Each patch has shape (1, 2, 2), the channel dimension followed by the spatial size. Each coordinate array has shape
+    (3, 2): one ``[start, stop]`` row for the channel dimension and one row for each spatial dimension.
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
