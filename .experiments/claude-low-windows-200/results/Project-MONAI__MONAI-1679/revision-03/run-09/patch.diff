+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches starting from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # grid patch dataset, each element is a (patch, coordinates) pair
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        loader = DataLoader(ds, batch_size=2, num_workers=2)
+        patch, coords = next(iter(loader))
+        print(patch.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has the full channel dimension and the requested spatial size, so a 1-channel 4x4 image with 2x2 patches
+    gives patches of shape (1, 2, 2). Each coordinate array has shape (3, 2), with one ``[start, stop]`` row per
+    dimension including the channel dimension, in the frame of the original image. For example, the top-left patch has
+    coordinates ``[[0, 1], [0, 2], [0, 2]]``.
