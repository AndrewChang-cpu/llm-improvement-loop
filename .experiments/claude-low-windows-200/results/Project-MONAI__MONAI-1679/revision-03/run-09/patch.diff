+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def _char_generator(item):
+    # yields one (character, index) tuple per character of the string item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=_char_generator, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+
+        expected = [c for s in test_dataset for c in s]
+        self.assertEqual(sorted(output), sorted(expected))
+        self.assertEqual(len(output), len(expected))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single-process loading
+        batches = list(DataLoader(ds, batch_size=2, num_workers=0))
+        for patch, _ in batches:
+            np.testing.assert_equal(tuple(patch.shape), (2, 1, 2, 2))
+        patch, coords = batches[-1]
+        np.testing.assert_allclose(
+            patch.numpy(),
+            np.array(
+                [
+                    [[[1.7413, 2.7413], [5.7413, 6.7413]]],
+                    [[[9.1419, 10.1419], [13.1419, 14.1419]]],
+                ]
+            ),
+            rtol=0,
+            atol=1e-5,
+        )
+        np.testing.assert_allclose(
+            coords.numpy(),
+            np.array(
+                [
+                    [[0, 1], [0, 2], [2, 4]],
+                    [[0, 1], [2, 4], [2, 4]],
+                ]
+            ),
+            rtol=0,
+            atol=1e-5,
+        )
+
+        if sys.platform != "win32":
+            # two-worker loading, the random shift is drawn under worker seeding so patch values differ
+            batches = list(DataLoader(ds, batch_size=2, num_workers=2))
+            for patch, _ in batches:
+                np.testing.assert_equal(tuple(patch.shape), (2, 1, 2, 2))
+            patch, coords = batches[-1]
+            np.testing.assert_allclose(
+                coords.numpy(),
+                np.array(
+                    [
+                        [[0, 1], [0, 2], [2, 4]],
+                        [[0, 1], [2, 4], [2, 4]],
+                    ]
+                ),
+                rtol=0,
+                atol=1e-5,
+            )
+            np.testing.assert_allclose(
+                patch.numpy(),
+                np.array(
+                    [
+                        [[[2.3944, 3.3944], [6.3944, 7.3944]]],
+                        [[[10.6551, 11.6551], [14.6551, 15.6551]]],
+                    ]
+                ),
+                rtol=0,
+                atol=1e-3,
+            )
+        set_determinism(seed=None)
+
+    def test_missing_len(self):
+        class _NoLen:
+            def __getitem__(self, index):
+                return np.zeros((1, 4, 4))
+
+        ds = GridPatchDataset(dataset=_NoLen(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as ctx:
+            list(ds)
+        self.assertIn("image dataset must implement `len()`.", str(ctx.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
