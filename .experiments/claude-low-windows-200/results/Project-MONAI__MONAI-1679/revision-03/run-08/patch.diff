+class GridPatchDataset(IterableDataset):
+    """
+    Yields patches from images read from an input dataset. The patches are chosen in a contiguous grid sampling
+    scheme by a patch generator (for example :py:class:`PatchIter`), and each patch can be transformed by a
+    per-patch transform. The transform is applied to the patch alone, so it never sees the coordinates.
+
+    Example:
+
+    .. code-block:: python
+
+        import numpy as np
+
+        from monai.data import DataLoader, GridPatchDataset, PatchIter
+        from monai.transforms import RandShiftIntensity
+
+        # image dataset: two single-channel 4x4 images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4),
+                  np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches starting from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        # construct the grid patch dataset, coordinates are yielded by default
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # iterate with two workers, each batch holds 2 patches
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+            print(patches.shape, coords.shape)
+
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+        >>> torch.Size([2, 1, 2, 2]) torch.Size([2, 3, 2])
+
+    Each patch has the full channel dimension, so its shape is (1, 2, 2). Each coordinate array has one row per
+    dimension of the image, including the channel: the channel row is ``[0, 1]`` and each spatial row is the
+    ``[start, stop]`` of the patch in the original image, for example ``[[0, 1], [0, 2], [0, 2]]`` for the first
+    patch of each image.
+    """
+
+    def __init__(
+        self,
+        dataset: Sequence,
+        patch_iter: Callable,
+        transform: Optional[Callable] = None,
+        with_coordinates: bool = True,
+    ) -> None:
