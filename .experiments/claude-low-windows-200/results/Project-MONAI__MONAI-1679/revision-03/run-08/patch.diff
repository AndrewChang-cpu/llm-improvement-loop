+            with_coordinates: if True, each dataset element is a ``(patch, coordinates)`` pair. If False, each
+                dataset element is the patch only. Defaults to True.
+        """
+        self.dataset = dataset
+        self.patch_iter = patch_iter
+        self.transform = transform
+        self.with_coordinates = with_coordinates
