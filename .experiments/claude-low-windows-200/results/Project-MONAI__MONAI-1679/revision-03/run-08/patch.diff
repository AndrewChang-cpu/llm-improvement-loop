+import sys
+import unittest
+
+import numpy as np
+
+from monai.data import DataLoader, GridPatchDataset, PatchIter
+from monai.transforms import RandShiftIntensity
+from monai.utils import set_determinism
+
+
+def char_patch_iter(item):
+    # yields one (character, index) tuple per character of a string item
+    for i, c in enumerate(item):
+        yield c, i
+
+
+class NoLengthDataset:
+    # image dataset supporting indexing but not len()
+    def __getitem__(self, index):
+        return np.zeros((1, 4, 4))
+
+
+class TestGridPatchDataset(unittest.TestCase):
+    def setUp(self):
+        set_determinism(seed=1234)
+
+    def tearDown(self):
+        set_determinism(seed=None)
+
+    def test_shape(self):
+        test_dataset = ["vwxyz", "hello", "world"]
+
+        result = GridPatchDataset(dataset=test_dataset, patch_iter=char_patch_iter, with_coordinates=False)
+
+        output = []
+        n_workers = 0 if sys.platform == "win32" else 2
+        for item in DataLoader(result, batch_size=3, num_workers=n_workers):
+            output.extend(item)
+        expected = sorted("".join(test_dataset))
+        self.assertEqual(sorted(output), expected)
+        self.assertEqual(len(output), len("".join(test_dataset)))
+
+    def test_loading_array(self):
+        set_determinism(seed=1234)
+        # image dataset: two 1x4x4 float images
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4), np.arange(16, dtype=float).reshape(1, 4, 4)]
+        # patch generator: 2x2 patches from the origin
+        patch_iter = PatchIter(patch_size=(2, 2), start_pos=(0, 0))
+        # per-patch intensity shift
+        patch_intensity = RandShiftIntensity(offsets=1.0, prob=1.0)
+        ds = GridPatchDataset(dataset=images, patch_iter=patch_iter, transform=patch_intensity)
+
+        # single process
+        last_patches, last_coords = None, None
+        for patches, coords in DataLoader(ds, batch_size=2, num_workers=0):
+            np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+            last_patches, last_coords = patches, coords
+        np.testing.assert_allclose(
+            last_patches[0, 0].numpy(), np.array([[1.7413, 2.7413], [5.7413, 6.7413]]), rtol=1e-5
+        )
+        np.testing.assert_allclose(
+            last_patches[1, 0].numpy(), np.array([[9.1419, 10.1419], [13.1419, 14.1419]]), rtol=1e-5
+        )
+        np.testing.assert_allclose(
+            last_coords[0].numpy(), np.array([[0, 1], [0, 2], [2, 4]]), rtol=1e-5
+        )
+        np.testing.assert_allclose(
+            last_coords[1].numpy(), np.array([[0, 1], [2, 4], [2, 4]]), rtol=1e-5
+        )
+
+        # two workers
+        if sys.platform != "win32":
+            last_patches, last_coords = None, None
+            for patches, coords in DataLoader(ds, batch_size=2, num_workers=2):
+                np.testing.assert_equal(tuple(patches.shape), (2, 1, 2, 2))
+                last_patches, last_coords = patches, coords
+            np.testing.assert_allclose(
+                last_coords[0].numpy(), np.array([[0, 1], [0, 2], [2, 4]]), rtol=1e-5
+            )
+            np.testing.assert_allclose(
+                last_coords[1].numpy(), np.array([[0, 1], [2, 4], [2, 4]]), rtol=1e-5
+            )
+            np.testing.assert_allclose(
+                last_patches[0, 0].numpy(), np.array([[2.3944, 3.3944], [6.3944, 7.3944]]), rtol=1e-3
+            )
+            np.testing.assert_allclose(
+                last_patches[1, 0].numpy(), np.array([[10.6551, 11.6551], [14.6551, 15.6551]]), rtol=1e-3
+            )
+
+    def test_coordinates(self):
+        images = [np.arange(16, dtype=float).reshape(1, 4, 4)]
+        ds = GridPatchDataset(dataset=images, patch_iter=PatchIter(patch_size=(2, 2), start_pos=(0, 0)))
+        expected = [
+            [[0, 1], [0, 2], [0, 2]],
+            [[0, 1], [2, 4], [0, 2]],
+            [[0, 1], [0, 2], [2, 4]],
+            [[0, 1], [2, 4], [2, 4]],
+        ]
+        outputs = list(ds)
+        self.assertEqual(len(outputs), 4)
+        for (patch, coords), exp in zip(outputs, expected):
+            self.assertEqual(tuple(patch.shape), (1, 2, 2))
+            self.assertEqual(tuple(coords.shape), (3, 2))
+            np.testing.assert_equal(coords, np.array(exp))
+
+    def test_missing_len(self):
+        ds = GridPatchDataset(dataset=NoLengthDataset(), patch_iter=PatchIter(patch_size=(2, 2)))
+        with self.assertRaises(NotImplementedError) as cm:
+            list(ds)
+        self.assertIn("image dataset must implement `len()`.", str(cm.exception))
+
+
+if __name__ == "__main__":
+    unittest.main()
