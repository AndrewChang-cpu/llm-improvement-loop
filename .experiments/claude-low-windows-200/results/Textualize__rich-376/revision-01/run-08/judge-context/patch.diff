+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo", "bar", sep="-", end="!\n")
+    assert console.file.getvalue() == "foo-bar!\n"
+
+
+def test_out_no_wrap_or_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] :smiley:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smiley:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=10)
+    console.out({"a": [1, 2, 3]})
+    assert console.file.getvalue() == str({"a": [1, 2, 3]}) + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_values_plain_text():
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    console.out("foo 1", highlight=True)
+    console.out("foo 2", highlight=None)
+    console.out("foo 3", highlight=False)
+    assert console.file.getvalue() == "foo 1\nfoo 2\nfoo 3\n"
+
+
+def test_out_render_hook_runs():
+    class CountHook(RenderHook):
+        def __init__(self):
+            self.count = 0
+
+        def process_renderables(self, renderables):
+            self.count += 1
+            return renderables
+
+    hook = CountHook()
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(hook)
+    console.out("foo")
+    console.pop_render_hook()
+    assert hook.count == 1
+    assert console.file.getvalue() == "foo\n"
+
+    assert console.out("bar") is None
+
+
