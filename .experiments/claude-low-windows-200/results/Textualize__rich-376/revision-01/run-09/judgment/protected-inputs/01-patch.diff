diff --git a/rich/console.py b/rich/console.py
index 64d0109..32cddc9 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,44 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output raw text to the console (low level alternative to print).
+
+        Objects are converted to strings with normal string conversion and joined
+        with ``sep``. The text is written as plain text: no pretty printing, no word
+        wrapping, no cropping, no markup and no emoji code replacement. A basic
+        style may be applied, and highlighting is optional.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. Passing ``True``
+                forces highlighting, ``False`` disables it, and ``None`` uses the console
+                default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            sep=sep,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..e99da68 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,135 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def _recording_hook():
+    from rich.console import RenderHook
+
+    class Recorder(RenderHook):
+        def __init__(self):
+            self.renderables = []
+
+        def process_renderables(self, renderables):
+            renderables = list(renderables)
+            self.renderables.extend(renderables)
+            return renderables
+
+    return Recorder()
+
+
+def test_out_sep_end_no_wrap():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_default_sep_and_end():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("foo", 1, None)
+    assert console.file.getvalue() == "foo 1 None\n"
+
+
+def test_out_empty_does_not_use_print_blank_line():
+    console = Console(file=io.StringIO(), width=80)
+    console.out()
+    no_objects = console.file.getvalue()
+    console = Console(file=io.StringIO(), width=80)
+    console.out("")
+    assert no_objects == console.file.getvalue()
+
+
+def test_out_no_markup_or_emoji():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] :smile:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smile:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=80)
+    console.out({"a": [1, 2]}, highlight=False)
+    assert console.file.getvalue() == str({"a": [1, 2]}) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("abcdefghijklmnopqrstuvwxyz", highlight=False)
+    assert console.file.getvalue() == "abcdefghijklmnopqrstuvwxyz\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=80)
+    assert console.out("foo") is None
+
+
+def test_out_style_matches_print():
+    def make():
+        return Console(
+            file=io.StringIO(),
+            force_terminal=True,
+            legacy_windows=False,
+            color_system="truecolor",
+            width=80,
+        )
+
+    out_console = make()
+    out_console.out("foo", style="bold", highlight=False)
+    print_console = make()
+    print_console.print(
+        "foo",
+        style="bold",
+        highlight=False,
+        markup=False,
+        emoji=False,
+        no_wrap=True,
+        overflow="ignore",
+        crop=False,
+    )
+    assert out_console.file.getvalue() == print_console.file.getvalue()
+    assert out_console.file.getvalue() != "foo\n"
+
+
+def test_out_highlight_default_forces_highlighting():
+    from rich.text import Text
+
+    recorder = _recording_hook()
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    console.push_render_hook(recorder)
+    console.out("foo 123")
+    texts = [r for r in recorder.renderables if isinstance(r, Text)]
+    assert texts and texts[0].spans
+
+
+def test_out_highlight_none_uses_console_default():
+    from rich.text import Text
+
+    recorder = _recording_hook()
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    console.push_render_hook(recorder)
+    console.out("foo 123", highlight=None)
+    texts = [r for r in recorder.renderables if isinstance(r, Text)]
+    assert texts and not texts[0].spans
+
+
+def test_out_highlight_false_disables_highlighting():
+    from rich.text import Text
+
+    recorder = _recording_hook()
+    console = Console(file=io.StringIO(), width=80, highlight=True)
+    console.push_render_hook(recorder)
+    console.out("foo 123", highlight=False)
+    texts = [r for r in recorder.renderables if isinstance(r, Text)]
+    assert texts and not texts[0].spans
+
+
+def test_out_render_hooks_run():
+    from rich.text import Text
+
+    recorder = _recording_hook()
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(recorder)
+    console.out("foo")
+    assert any(isinstance(r, Text) and r.plain == "foo" for r in recorder.renderables)
+
+
