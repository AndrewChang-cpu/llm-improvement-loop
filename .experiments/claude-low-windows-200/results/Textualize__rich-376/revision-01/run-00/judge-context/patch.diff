diff --git a/rich/console.py b/rich/console.py
index 64d0109..3d8d039 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,42 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output to the terminal as plain text, without pretty printing.
+
+        Each object is converted to a string with normal string conversion and the
+        results are joined with ``sep``. The text is written through :meth:`print`
+        with emoji and markup disabled, word wrapping disabled, and cropping
+        disabled, so it is written as-is. Only a basic style and highlighting are applied.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. Defaults to True.
+                Pass ``None`` to use the console default, or ``False`` to disable highlighting.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..dd747fc 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,94 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out_sep_end_no_wrap():
+    console = Console(file=io.StringIO(), width=10, color_system=None)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects_writes_end():
+    console = Console(file=io.StringIO(), width=10, color_system=None)
+    console.out(end="X")
+    assert console.file.getvalue() == "X"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.out("[bold]foo[/bold] :smiley:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smiley:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.out({"a": [1, 2]})
+    assert console.file.getvalue() == str({"a": [1, 2]}) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10, color_system=None)
+    console.out("foo bar baz egg")
+    assert console.file.getvalue() == "foo bar baz egg\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    assert console.out("foo") is None
+
+
+def test_out_highlight_default_forces_highlight():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, highlight=False, legacy_windows=False
+    )
+    console.out(42)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false_disables_highlight():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, highlight=True, legacy_windows=False
+    )
+    console.out(42, highlight=False)
+    assert console.file.getvalue() == "42\n"
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(
+        file=io.StringIO(), force_terminal=True, highlight=False, legacy_windows=False
+    )
+    console.out(42, highlight=None)
+    assert console.file.getvalue() == "42\n"
+
+    console = Console(
+        file=io.StringIO(), force_terminal=True, highlight=True, legacy_windows=False
+    )
+    console.out(42, highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_render_hook():
+    from rich.console import RenderHook
+
+    calls = []
+
+    class Hook(RenderHook):
+        def process_renderables(self, renderables):
+            calls.append(len(renderables))
+            return renderables
+
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.push_render_hook(Hook())
+    console.out("foo")
+    assert calls
+    assert console.file.getvalue() == "foo\n"
+
+
