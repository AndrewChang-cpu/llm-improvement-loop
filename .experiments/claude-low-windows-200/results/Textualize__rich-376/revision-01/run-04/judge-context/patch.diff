+class _SpanCollector:
+    """Render hook that records the Text renderables passed to print."""
+
+    def __init__(self):
+        self.texts = []
+
+    def process_renderables(self, renderables):
+        self.texts.extend(r for r in renderables if isinstance(r, Text))
+        return renderables
+
+
+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo barX"
+
+
+def test_out_no_wrap_and_sep_end():
+    console = Console(file=io.StringIO(), width=10)
+    console.out(*["foo bar"] * 5, sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_default_end_and_sep():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("a", "b")
+    assert console.file.getvalue() == "a b\n"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] :smile:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smile:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=10)
+    value = list(range(30))
+    console.out(value)
+    assert console.file.getvalue() == str(value) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("x" * 25)
+    assert console.file.getvalue() == "x" * 25 + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default_forces_highlight():
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    collector = _SpanCollector()
+    console.push_render_hook(collector)
+    console.out("foo 123")
+    assert any(text.spans for text in collector.texts)
+
+
+def test_out_highlight_false_disables_highlight():
+    console = Console(file=io.StringIO(), width=80, highlight=True)
+    collector = _SpanCollector()
+    console.push_render_hook(collector)
+    console.out("foo 123", highlight=False)
+    assert all(not text.spans for text in collector.texts)
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    collector = _SpanCollector()
+    console.push_render_hook(collector)
+    console.out("foo 123", highlight=None)
+    assert all(not text.spans for text in collector.texts)
+
+    console = Console(file=io.StringIO(), width=80, highlight=True)
+    collector = _SpanCollector()
+    console.push_render_hook(collector)
+    console.out("foo 123", highlight=None)
+    assert any(text.spans for text in collector.texts)
+
+
+def test_out_render_hooks_run():
+    console = Console(file=io.StringIO(), width=80)
+    collector = _SpanCollector()
+    console.push_render_hook(collector)
+    console.out("foo")
+    assert collector.texts
+    assert console.file.getvalue() == "foo\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=80)
+    assert console.out("foo") is None
+
+
