@@ -70,6 +70,14 @@ The :meth:`~rich.console.Console.log` methods offers the same capabilities as pr
 To help with debugging, the log() method has a ``log_locals`` parameter. If you set this to ``True``, Rich will display a table of local variables where the method was called.
 
 
+Low level output
+----------------
+
+The :meth:`~rich.console.Console.out` method is a lower-level alternative to print and log. It converts each object to a string with ``str()``, joins them with ``sep``, and writes the result as plain text followed by ``end``. Use it when you want raw text without Rich's formatting.
+
+``out`` does not pretty print containers, does not word wrap, does not crop to the console width, does not interpret console markup, and does not replace emoji codes. It does apply a basic ``style`` and, by default, syntax highlighting (set ``highlight=False`` to turn highlighting off, or ``highlight=None`` to use the console's setting). Output still passes through the console's render hooks and buffer, just like print.
+
+
 Justify / Alignment
 -------------------
 
diff --git a/rich/console.py b/rich/console.py
index 64d0109..53c75c4 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,43 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Write raw text to the console (low level output).
+
+        Objects are converted with ``str()`` and joined with ``sep``. The result is
+        written through :meth:`print` with no pretty printing, no word wrapping,
+        no cropping, no markup, and no emoji code replacement. Only basic style and
+        highlighting are applied.
+
+        Args:
+            objects (positional args): Objects to write as plain text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. True forces
+                highlighting, False disables it, and ``None`` uses the console default.
+                Defaults to True.
+        """
+        raw = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..76c834e 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,85 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out_sep_end_no_wrap():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects_writes_end():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+    console.out(end="!")
+    assert console.file.getvalue() == "\n" + "!"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] :smile:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smile:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=80)
+    console.out({"a": [1, 2]})
+    assert console.file.getvalue() == str({"a": [1, 2]}) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("0123456789ABCDEF")
+    assert console.file.getvalue() == "0123456789ABCDEF\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_false_is_plain():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out(1, highlight=False)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_highlight_default_forces_highlighting():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out(1)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out(1, highlight=None)
+    assert console.file.getvalue() == "1\n"
+
+
+def test_out_render_hook_runs():
+    from rich.console import RenderHook
+
+    seen = []
+
+    class Recorder(RenderHook):
+        def process_renderables(self, renderables):
+            seen.append(len(renderables))
+            return renderables
+
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(Recorder())
+    console.out("foo")
+    console.pop_render_hook()
+    assert seen
+    assert console.file.getvalue() == "foo\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=80)
+    assert console.out("foo") is None
+
+
