diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..f0f6e5a 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,81 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out_sep_end_no_wrap():
+    console = Console(file=io.StringIO(), width=10, color_system=None)
+    console.out("foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo barX"
+    console.file.seek(0)
+    console.file.truncate()
+    console.out(*["foo bar"] * 5, sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), color_system=None)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), color_system=None)
+    console.out("[bold]foo[/bold] :smile:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smile:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), color_system=None, width=80)
+    console.out({"a": 1})
+    assert console.file.getvalue() == "{'a': 1}\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), color_system=None)
+    assert console.out("foo") is None
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default_forces_highlight():
+    # Console highlighting disabled; out's default (True) forces it on.
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("None")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=False)
+    console.out("None", highlight=None)
+    assert console.file.getvalue() == "None\n"
+
+
+def test_out_highlight_false():
+    console = Console(file=io.StringIO(), color_system="truecolor", highlight=True)
+    console.out("None", highlight=False)
+    assert console.file.getvalue() == "None\n"
+
+
+def test_out_render_hook():
+    class RecordingHook:
+        def __init__(self):
+            self.seen = []
+
+        def process_renderables(self, renderables):
+            self.seen.extend(renderables)
+            return renderables
+
+    console = Console(file=io.StringIO(), color_system=None)
+    hook = RecordingHook()
+    console.push_render_hook(hook)
+    console.out("foo")
+    assert hook.seen
+    assert console.file.getvalue() == "foo\n"
+
+
