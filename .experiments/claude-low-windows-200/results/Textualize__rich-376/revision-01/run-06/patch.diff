@@ -116,6 +116,87 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out_sep_end_no_wrap():
+    console = Console(file=io.StringIO(), width=10, color_system=None)
+    console.out("foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), color_system=None)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.out("[bold]foo[/bold] :vampire:", highlight=False)
+    assert console.file.getvalue() == "[bold]foo[/bold] :vampire:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=20, color_system=None)
+    console.out({"a": 1, "b": 2}, highlight=False)
+    assert console.file.getvalue() == "{'a': 1, 'b': 2}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=5, color_system=None)
+    console.out("foobarbaz", highlight=False)
+    assert console.file.getvalue() == "foobarbaz\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default_forces_highlighting():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", highlight=False
+    )
+    console.out("value 42")
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false_disables_highlighting():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("value 42", highlight=False)
+    assert console.file.getvalue() == "value 42\n"
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(
+        file=io.StringIO(), color_system="truecolor", highlight=False
+    )
+    console.out("value 42", highlight=None)
+    assert console.file.getvalue() == "value 42\n"
+
+
+def test_out_render_hook():
+    from rich.console import RenderHook
+
+    seen = []
+
+    class Recorder(RenderHook):
+        def process_renderables(self, renderables):
+            seen.append(len(renderables))
+            return renderables
+
+    console = Console(file=io.StringIO(), color_system=None)
+    console.push_render_hook(Recorder())
+    console.out("foo", highlight=False)
+    console.pop_render_hook()
+    assert seen
+    assert console.file.getvalue() == "foo\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), color_system=None)
+    assert console.out("foo", highlight=False) is None
+
