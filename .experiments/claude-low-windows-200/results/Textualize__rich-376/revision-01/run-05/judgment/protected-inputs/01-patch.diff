diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..247496e 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,100 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out_sep_end_no_wrap():
+    console = Console(file=io.StringIO(), width=10, color_system=None)
+    console.out("foo bar", "foo bar", sep=".", end="X")
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == (
+        "foo bar.foo bar" + "X" + "foo bar.foo bar.foo bar.foo bar.foo barX"
+    )
+
+
+def test_out_default_sep_and_end():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.out("foo", 1, None)
+    console.out()
+    assert console.file.getvalue() == "foo 1 None\n\n"
+
+
+def test_out_no_markup_or_emoji():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.out("[bold]foo[/bold] :smiley:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smiley:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.out({"a": [1, 2]})
+    assert console.file.getvalue() == str({"a": [1, 2]}) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10, color_system=None)
+    console.out("0123456789abcdef")
+    assert console.file.getvalue() == "0123456789abcdef\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "foo\n"
+    console.out("foo", style=Style(bold=True), highlight=False)
+    assert console.file.getvalue() == "foo\nfoo\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    assert console.out("foo") is None
+
+
+class _SpanRecorder:
+    def __init__(self):
+        self.span_counts = []
+
+    def process_renderables(self, renderables):
+        for renderable in renderables:
+            if hasattr(renderable, "spans"):
+                self.span_counts.append(len(renderable.spans))
+        return renderables
+
+
+def test_out_highlight_default_forces_highlighting():
+    console = Console(
+        file=io.StringIO(), width=80, color_system=None, highlight=False
+    )
+    recorder = _SpanRecorder()
+    console._render_hooks.append(recorder)
+    console.out("123")
+    assert recorder.span_counts and recorder.span_counts[0] > 0
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(
+        file=io.StringIO(), width=80, color_system=None, highlight=False
+    )
+    recorder = _SpanRecorder()
+    console._render_hooks.append(recorder)
+    console.out("123", highlight=None)
+    assert recorder.span_counts and recorder.span_counts[0] == 0
+
+
+def test_out_highlight_false_disables_highlighting():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    recorder = _SpanRecorder()
+    console._render_hooks.append(recorder)
+    console.out("123", highlight=False)
+    assert recorder.span_counts and recorder.span_counts[0] == 0
+
+
+def test_out_render_hooks_run():
+    console = Console(file=io.StringIO(), width=80, color_system=None)
+    recorder = _SpanRecorder()
+    console._render_hooks.append(recorder)
+    console.out("foo")
+    assert len(recorder.span_counts) >= 1
+
+
