diff --git a/rich/console.py b/rich/console.py
index 64d0109..c76c06b 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,44 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Optional[Union[str, Style]] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output raw text to the console with low-level control.
+
+        Unlike print, objects are not pretty printed, word wrapped, cropped, or
+        interpreted as markup, and emoji codes are not replaced. Objects are
+        converted with str() and joined with ``sep``. Highlighting and a basic
+        style may be applied. Output still goes through print, so render hooks
+        and the buffer are used as normal.
+
+        Args:
+            objects (positional args): Objects to write as plain text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write after the output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, ``False`` to disable,
+                or ``None`` to use the console default. Defaults to True.
+        """
+        raw_output = sep.join(str(object) for object in objects)
+        self.print(
+            raw_output,
+            sep=sep,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
