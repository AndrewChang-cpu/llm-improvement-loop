diff --git a/rich/console.py b/rich/console.py
index 64d0109..646b485 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,38 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Optional[Union[str, Style]] = None,
+        highlight: Optional[bool] = None,
+    ) -> None:
+        """Output to the terminal. This is a low-level way of writing to the terminal which unlike
+        :meth:`~rich.console.Console.print` won't pretty print, wrap text, or apply markup, emoji,
+        or cropping. Only an optional style and automatic highlighting are applied.
+
+        Args:
+            objects (positional args): Objects to output to the terminal. Each is converted with ``str()``.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, or ``None`` to use console default. Defaults to ``None``.
+        """
+        raw_output: str = sep.join(str(_object) for _object in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..a6bc67b 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,24 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", "bar", sep="-", end="!")
+    assert console.file.getvalue() == "foo-bar!"
+
+
+def test_out_no_markup_or_emoji():
+    console = Console(file=io.StringIO(), color_system=None)
+    console.out("[b]foo[/b] :vampire:")
+    assert console.file.getvalue() == "[b]foo[/b] :vampire:\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
 def test_show_cursor():
     console = Console(file=io.StringIO(), force_terminal=True, legacy_windows=False)
     console.show_cursor(False)
