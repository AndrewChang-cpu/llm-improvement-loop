diff --git a/rich/console.py b/rich/console.py
index 64d0109..811d06d 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,38 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: bool = None,
+    ) -> None:
+        """Output to the terminal. This is a low-level way of writing to the terminal which unlike
+        :meth:`~rich.console.Console.print` won't pretty print, wrap text, or apply markup, but will
+        optionally apply highlighting and a basic style.
+
+        Args:
+            objects (positional args): Objects to write to the terminal. Each object is converted to a string with ``str()``.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, or ``None`` to use console default. Defaults to ``None``.
+        """
+        raw_output: str = sep.join(str(_object) for _object in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..c0c8a7e 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,30 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", "bar", sep="-", end="!\n")
+    assert console.file.getvalue() == "foo-bar!\n"
+
+
+def test_out_no_markup_or_emoji():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("[bold]foo[/bold] :smile:", highlight=False)
+    assert console.file.getvalue() == "[bold]foo[/bold] :smile:\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_no_wrap_or_crop():
+    console = Console(file=io.StringIO(), color_system="truecolor", width=10)
+    console.out("abcdefghijklmnopqrstuvwxyz", highlight=False)
+    assert console.file.getvalue() == "abcdefghijklmnopqrstuvwxyz\n"
+
+
 def test_show_cursor():
     console = Console(file=io.StringIO(), force_terminal=True, legacy_windows=False)
     console.show_cursor(False)
