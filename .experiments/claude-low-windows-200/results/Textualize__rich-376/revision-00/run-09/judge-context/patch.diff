diff --git a/rich/console.py b/rich/console.py
index 64d0109..1fe214d 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1012,6 +1012,31 @@ class Console:
             self._buffer.append(Segment.control(str(control_codes)))
             self._check_buffer()
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Optional[Union[str, Style]] = None,
+    ) -> None:
+        """Output raw text to the console, with optional simple styling.
+
+        This is a low-level alternative to :meth:`print`. Objects are converted to
+        strings and joined with ``sep``. No markup, emoji, highlighting, word wrapping
+        or cropping is applied.
+
+        Args:
+            objects (positional args): Objects to output.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+        """
+        text = sep.join(str(obj) for obj in objects) + end
+        if text:
+            segment_style = self.get_style(style) if style is not None else None
+            self._buffer.append(Segment(text, segment_style))
+            self._check_buffer()
+
     def print(
         self,
         *objects: Any,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..8187445 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -116,6 +116,24 @@ def test_print_style():
     assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
 
 
+def test_out():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", "bar", sep="-", end="!")
+    assert console.file.getvalue() == "foo-bar!"
+
+
+def test_out_no_markup():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("[bold]foo[/bold]")
+    assert console.file.getvalue() == "[bold]foo[/bold]\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
 def test_show_cursor():
