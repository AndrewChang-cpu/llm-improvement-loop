diff --git a/rich/console.py b/rich/console.py
index 64d0109..d3e86b5 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,38 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep=" ",
+        end="\n",
+        style: Union[str, Style] = None,
+        highlight: bool = None,
+    ) -> None:
+        """Output to the terminal. This is a low-level way of writing to the terminal which unlike
+        :meth:`~rich.console.Console.print` won't pretty print, wrap text, or apply markup, but will
+        optionally apply simple styling.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between print data. Defaults to " ".
+            end (str, optional): String to write at end of print data. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, or ``None`` to use console default. Defaults to ``None``.
+        """
+        raw_output: str = sep.join(str(_object) for _object in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..1c7d2c2 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -350,6 +350,15 @@ def test_bell() -> None:
     assert console.end_capture() == "\x07"
 
 
+def test_out() -> None:
+    console = Console(force_terminal=True, color_system="truecolor")
+    console.begin_capture()
+    console.out("Hello", "[bold]World", style="bold red", sep=" ", end="!\n")
+    result = console.end_capture()
+    assert "Hello [bold]World!" in result
+    assert "\x1b[1;31m" in result or "\x1b[31;1m" in result
+
+
 def test_pager() -> None:
     console = Console()
 
