diff --git a/rich/console.py b/rich/console.py
index 64d0109..f10e735 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,38 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: bool = None,
+    ) -> None:
+        """Output to the terminal. This is a low-level way of writing to the terminal which unlike
+        :meth:`~rich.console.Console.print` won't pretty print, wrap text, or apply markup, but will
+        optionally apply highlighting and a basic style.
+
+        Args:
+            objects (positional args): Objects to write to the terminal. Each is converted to a string with ``str()``.
+            sep (str, optional): String to write between print data. Defaults to " ".
+            end (str, optional): String to write at end of print data. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, or ``None`` to use console default. Defaults to ``None``.
+        """
+        raw_output: str = sep.join(str(_object) for _object in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..bc4b160 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -370,3 +370,27 @@ def test_pager() -> None:
         console.print("[bold link https:/example.org]Hello World")
 
     assert pager_content == "Hello World\n"
+
+
+def test_out() -> None:
+    console = Console(
+        file=io.StringIO(), force_terminal=False, color_system=None, width=80
+    )
+    console.out("Hello", "World", sep=", ", end="!\n")
+    assert console.file.getvalue() == "Hello, World!\n"  # type: ignore
+
+
+def test_out_markup_and_emoji_not_processed() -> None:
+    console = Console(
+        file=io.StringIO(), force_terminal=False, color_system=None, width=80
+    )
+    console.out("[bold]Hi :smiley:")
+    assert console.file.getvalue() == "[bold]Hi :smiley:\n"  # type: ignore
+
+
+def test_out_no_wrap_or_crop() -> None:
+    console = Console(
+        file=io.StringIO(), force_terminal=False, color_system=None, width=10
+    )
+    console.out("abcdefghijklmnopqrstuvwxyz")
+    assert console.file.getvalue() == "abcdefghijklmnopqrstuvwxyz\n"  # type: ignore
