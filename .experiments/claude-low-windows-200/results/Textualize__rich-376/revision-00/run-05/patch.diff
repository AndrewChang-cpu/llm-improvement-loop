+def test_out() -> None:
+    console = Console(file=io.StringIO(), color_system=None)
+    console.out("foo", "[bold]bar[/bold]", 1, sep="-", end="!\n")
+    assert console.file.getvalue() == "foo-[bold]bar[/bold]-1!\n"
+
+
+def test_out_style() -> None:
+    console = Console(file=io.StringIO(), force_terminal=True, color_system="standard")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
