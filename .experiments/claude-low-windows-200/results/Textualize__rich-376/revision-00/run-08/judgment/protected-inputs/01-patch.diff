diff --git a/docs/source/console.rst b/docs/source/console.rst
index a3c690c..d4acb19 100644
--- a/docs/source/console.rst
+++ b/docs/source/console.rst
@@ -52,6 +52,10 @@ To write rich content to the terminal use the :meth:`~rich.console.Console.print
     console.print(locals())
     console.print("FOO", style="white on blue")
 
+For low-level output, use :meth:`~rich.console.Console.out`. It converts its arguments to strings and writes them without pretty printing, word wrapping, markup, or emoji replacement. It only applies a simple style::
+
+    console.out("Hello", "World", style="bold")
+
 You can also use :meth:`~rich.console.Console.print` to render objects that support the :ref:`protocol`, which includes Rich's built in objects such as :class:`~rich.text.Text`, :class:`~rich.table.Table`, and :class:`~rich.syntax.Syntax` -- or other custom objects.
 
 
diff --git a/rich/console.py b/rich/console.py
index 64d0109..978a471 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,38 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Optional[Union[str, Style]] = None,
+        highlight: Optional[bool] = None,
+    ) -> None:
+        """Output to the terminal. This is a low-level way of writing to the terminal which unlike
+        :meth:`~rich.console.Console.print` won't pretty print, wrap text, or interpret markup or emoji.
+        Only a simple style is applied to the output.
+
+        Args:
+            objects (positional args): Objects to output to the terminal. Each is converted to a string.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting, or ``None`` to use console default. Defaults to ``None``.
+        """
+        raw_output: str = sep.join(str(_object) for _object in objects)
+        self.print(
+            raw_output,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+            end=end,
+        )
+
     def print_exception(
         self,
         *,
diff --git a/tests/test_console.py b/tests/test_console.py
index eca3000..14bdfc3 100644
--- a/tests/test_console.py
+++ b/tests/test_console.py
@@ -370,3 +370,32 @@ def test_pager() -> None:
         console.print("[bold link https:/example.org]Hello World")
 
     assert pager_content == "Hello World\n"
+
+
+def test_out():
+    console = Console(file=io.StringIO(), force_terminal=False, color_system=None)
+    console.out("Hello", "World")
+    assert console.file.getvalue() == "Hello World\n"
+
+
+def test_out_no_markup_or_emoji():
+    console = Console(file=io.StringIO(), force_terminal=False, color_system=None)
+    console.out("[bold]Hello :smiley:", end="")
+    assert console.file.getvalue() == "[bold]Hello :smiley:"
+
+
+def test_out_sep_and_end():
+    console = Console(file=io.StringIO(), force_terminal=False, color_system=None)
+    console.out("a", 1, None, sep="-", end="!\n")
+    assert console.file.getvalue() == "a-1-None!\n"
+
+
+def test_out_style():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="standard",
+        legacy_windows=False,
+    )
+    console.out("Hello", style="bold")
+    assert console.file.getvalue() == "\x1b[1mHello\x1b[0m\n"
