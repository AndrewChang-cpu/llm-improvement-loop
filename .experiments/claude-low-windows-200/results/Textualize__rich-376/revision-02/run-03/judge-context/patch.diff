+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out(*["foo bar"] * 5, sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_defaults():
+    console = Console(file=io.StringIO(), width=20)
+    console.out("a", 1, None)
+    assert console.file.getvalue() == "a 1 None\n"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=20)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=20)
+    assert console.out("foo") is None
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), width=40)
+    console.out("[bold]foo[/bold] [red]bar", ":thumbs_up: :smile:")
+    assert (
+        console.file.getvalue() == "[bold]foo[/bold] [red]bar :thumbs_up: :smile:\n"
+    )
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=40)
+    console.out([1, 2, {"a": "b"}])
+    assert console.file.getvalue() == "[1, 2, {'a': 'b'}]\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("x" * 30)
+    assert console.file.getvalue() == "x" * 30 + "\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO(), width=20)
+    hook = _RecordingHook()
+    console.push_render_hook(hook)
+    console.out("foo")
+    console.pop_render_hook()
+    assert console.file.getvalue() == "foo\n"
+    texts = [r for r in hook.renderables if isinstance(r, Text)]
+    assert [t.plain for t in texts] == ["foo"]
+
+
+def _highlighted(console_highlight, out_highlight=True):
+    """Return True if out applied highlight spans to its text."""
+    console = Console(file=io.StringIO(), width=20, highlight=console_highlight)
+    hook = _RecordingHook()
+    console.push_render_hook(hook)
+    if out_highlight is True:
+        console.out("1")
+    else:
+        console.out("1", highlight=out_highlight)
+    console.pop_render_hook()
+    texts = [r for r in hook.renderables if isinstance(r, Text)]
+    return any(t.spans for t in texts)
+
+
+def test_out_highlight_default_forces_on():
+    assert _highlighted(console_highlight=False) is True
+
+
+def test_out_highlight_none_uses_console_default():
+    assert _highlighted(console_highlight=False, out_highlight=None) is False
+    assert _highlighted(console_highlight=True, out_highlight=None) is True
+
+
+def test_out_highlight_false_disables():
+    assert _highlighted(console_highlight=True, out_highlight=False) is False
+
+
