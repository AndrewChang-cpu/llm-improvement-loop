+class _RecordingHook(RenderHook):
+    """Render hook that records the renderables it receives."""
+
+    def __init__(self):
+        self.renderables = []
+
+    def process_renderables(self, renderables):
+        self.renderables.extend(renderables)
+        return renderables
 
 
