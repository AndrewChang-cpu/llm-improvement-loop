diff --git a/rich/console.py b/rich/console.py
index 64d0109..d108187 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,42 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Output raw text to the console (low level alternative to print).
+
+        Each object is converted to a string with ``str()`` and the results are
+        joined with ``sep``. The text is written through :meth:`print` with no
+        pretty printing, no word wrapping, no cropping, no markup and no emoji
+        code replacement. Only basic styling and highlighting are applied.
+
+        Args:
+            objects (positional args): Objects to write to the terminal.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): True to force highlighting, False to disable it,
+                or None to use the console default. Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
