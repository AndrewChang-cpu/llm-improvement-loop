+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    result = console.out(
+        "foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X"
+    )
+    assert result is None
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO())
+    console.out("[bold]foo[/bold] :smiley:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smiley:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO())
+    console.out([1, 2], {"a": 1})
+    assert console.file.getvalue() == "[1, 2] {'a': 1}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=5)
+    console.out("abcdefghij")
+    assert console.file.getvalue() == "abcdefghij\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def _bold_highlighter(text):
+    highlighted = Text(str(text))
+    highlighted.stylize("bold")
+    return highlighted
+
+
+def test_out_highlight_default_forces_highlighting():
+    console = Console(
+        file=io.StringIO(),
+        color_system="truecolor",
+        highlight=False,
+        highlighter=_bold_highlighter,
+    )
+    console.out("foo")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(
+        file=io.StringIO(),
+        color_system="truecolor",
+        highlight=False,
+        highlighter=_bold_highlighter,
+    )
+    console.out("foo", highlight=None)
+    assert console.file.getvalue() == "foo\n"
+
+    console = Console(
+        file=io.StringIO(),
+        color_system="truecolor",
+        highlight=True,
+        highlighter=_bold_highlighter,
+    )
+    console.out("foo", highlight=None)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_false_disables_highlighting():
+    console = Console(
+        file=io.StringIO(),
+        color_system="truecolor",
+        highlight=True,
+        highlighter=_bold_highlighter,
+    )
+    console.out("foo", highlight=False)
+    assert console.file.getvalue() == "foo\n"
+
+
+class _CountingRenderHook(RenderHook):
+    def __init__(self) -> None:
+        self.calls = 0
+
+    def process_renderables(self, renderables):
+        self.calls += 1
+        return renderables
+
+
+def test_out_render_hook():
+    console = Console(file=io.StringIO())
+    hook = _CountingRenderHook()
+    console.push_render_hook(hook)
+    console.out("foo")
+    assert hook.calls == 1
+    assert console.file.getvalue() == "foo\n"
+
+
