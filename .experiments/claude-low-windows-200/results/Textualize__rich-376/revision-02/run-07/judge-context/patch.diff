+def test_out():
+    console = Console(file=io.StringIO(), width=10, highlight=False)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_empty():
+    console = Console(file=io.StringIO(), width=10, highlight=False)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO(), width=10, highlight=False)
+    assert console.out("foo") is None
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    console.out({"a": 1, "b": [1, 2]})
+    assert console.file.getvalue() == "{'a': 1, 'b': [1, 2]}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10, highlight=False)
+    console.out("0123456789ABCDEFGHIJ")
+    assert console.file.getvalue() == "0123456789ABCDEFGHIJ\n"
+
+
+def test_out_markup_literal():
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    console.out("[bold]foo[/bold]")
+    assert console.file.getvalue() == "[bold]foo[/bold]\n"
+
+
+def test_out_emoji_literal():
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    console.out("smile :smile:")
+    assert console.file.getvalue() == "smile :smile:\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+def test_out_highlight_default_forces_highlight():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        highlight=False,
+    )
+    console.out(123)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_highlight_false():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        highlight=True,
+    )
+    console.out(123, highlight=False)
+    assert console.file.getvalue() == "123\n"
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        highlight=False,
+    )
+    console.out(123, highlight=None)
+    assert console.file.getvalue() == "123\n"
+
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        legacy_windows=False,
+        highlight=True,
+    )
+    console.out(123, highlight=None)
+    assert "\x1b[" in console.file.getvalue()
+
+
+def test_out_render_hook():
+    class RecordingHook(RenderHook):
+        def __init__(self):
+            self.calls = 0
+
+        def process_renderables(self, renderables):
+            self.calls += 1
+            return renderables
+
+    hook = RecordingHook()
+    console = Console(file=io.StringIO(), width=80, highlight=False)
+    console.push_render_hook(hook)
+    console.out("foo")
+    assert hook.calls == 1
+    assert console.file.getvalue() == "foo\n"
+
+
