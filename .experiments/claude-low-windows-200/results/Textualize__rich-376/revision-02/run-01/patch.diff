diff --git a/rich/console.py b/rich/console.py
index 64d0109..ae667cc 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,41 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Write raw text to the console (low level output).
+
+        Unlike print, objects are not pretty printed, word wrapped, cropped, or
+        interpreted as markup or emoji codes. Each object is converted to a string
+        with str() and the results are joined with ``sep``. The text is written
+        through print, so render hooks and the buffer are still used.
+
+        Args:
+            objects (positional args): Objects to write as plain text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. True forces highlighting, False disables it, or ``None`` to use the console default. Defaults to True.
+        """
+        raw = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
