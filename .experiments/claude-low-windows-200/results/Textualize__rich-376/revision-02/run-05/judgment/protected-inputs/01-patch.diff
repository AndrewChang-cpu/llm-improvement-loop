diff --git a/rich/console.py b/rich/console.py
index 64d0109..2fb64d5 100644
--- a/rich/console.py
+++ b/rich/console.py
@@ -1093,6 +1093,43 @@ class Console:
             else:
                 self._buffer.extend(new_segments)
 
+    def out(
+        self,
+        *objects: Any,
+        sep: str = " ",
+        end: str = "\n",
+        style: Union[str, Style] = None,
+        highlight: Optional[bool] = True,
+    ) -> None:
+        """Write raw text to the console.
+
+        This is a low-level alternative to print. Objects are converted to strings with
+        normal string conversion and joined with ``sep``. The text is not pretty printed,
+        is not word wrapped or cropped, and markup and emoji codes are not processed.
+        Basic styling and highlighting are supported.
+
+        Args:
+            objects (positional args): Objects to write as plain text.
+            sep (str, optional): String to write between objects. Defaults to " ".
+            end (str, optional): String to write at end of output. Defaults to "\\n".
+            style (Union[str, Style], optional): A style to apply to output. Defaults to None.
+            highlight (Optional[bool], optional): Enable automatic highlighting. Set to True to
+                force highlighting, False to disable it, or ``None`` to use the console default.
+                Defaults to True.
+        """
+        raw_output = sep.join(str(obj) for obj in objects)
+        self.print(
+            raw_output,
+            end=end,
+            style=style,
+            highlight=highlight,
+            emoji=False,
+            markup=False,
+            no_wrap=True,
+            overflow="ignore",
+            crop=False,
+        )
+
     def print_exception(
         self,
         *,
