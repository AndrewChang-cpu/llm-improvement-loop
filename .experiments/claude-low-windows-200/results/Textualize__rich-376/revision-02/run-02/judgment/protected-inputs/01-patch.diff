+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("foo bar", "foo bar", "foo bar", "foo bar", "foo bar", sep=".", end="X")
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_no_objects():
+    console = Console(file=io.StringIO(), width=10)
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_returns_none():
+    console = Console(file=io.StringIO())
+    assert console.out("foo") is None
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO(), width=80)
+    console.out("[bold]foo[/bold] :smile:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smile:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=80)
+    console.out({"a": [1, 2]})
+    assert console.file.getvalue() == "{'a': [1, 2]}\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=10)
+    console.out("0123456789ABCDEFGHIJ")
+    assert console.file.getvalue() == "0123456789ABCDEFGHIJ\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor")
+    console.out("foo", style="bold")
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+class _SpanRecorder(RenderHook):
+    def __init__(self) -> None:
+        self.spans = []
+
+    def process_renderables(self, renderables):
+        for renderable in renderables:
+            if isinstance(renderable, Text):
+                self.spans.extend(renderable.spans)
+        return renderables
+
+
+def test_out_highlight_default_forces_highlight():
+    console = Console(file=io.StringIO(), highlight=False)
+    recorder = _SpanRecorder()
+    console.push_render_hook(recorder)
+    console.out("123")
+    assert len(recorder.spans) > 0
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(file=io.StringIO(), highlight=False)
+    recorder = _SpanRecorder()
+    console.push_render_hook(recorder)
+    console.out("123", highlight=None)
+    assert recorder.spans == []
+
+    console = Console(file=io.StringIO(), highlight=True)
+    recorder = _SpanRecorder()
+    console.push_render_hook(recorder)
+    console.out("123", highlight=None)
+    assert len(recorder.spans) > 0
+
+
+def test_out_highlight_false_disables_highlight():
+    console = Console(file=io.StringIO(), highlight=True)
+    recorder = _SpanRecorder()
+    console.push_render_hook(recorder)
+    console.out("123", highlight=False)
+    assert recorder.spans == []
+
+
+def test_out_render_hook():
+    class AddLine(RenderHook):
+        def process_renderables(self, renderables):
+            return renderables + [Text("hook")]
+
+    console = Console(file=io.StringIO(), width=80)
+    console.push_render_hook(AddLine())
+    console.out("foo")
+    assert console.file.getvalue() == "foo\nhook\n"
+
+
