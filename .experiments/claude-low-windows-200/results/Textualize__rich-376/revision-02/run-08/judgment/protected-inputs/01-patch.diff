+def test_out():
+    console = Console(file=io.StringIO(), width=10)
+    result = console.out(*["foo bar"] * 5, sep=".", end="X")
+    assert result is None
+    assert console.file.getvalue() == "foo bar.foo bar.foo bar.foo bar.foo barX"
+
+
+def test_out_empty():
+    console = Console(file=io.StringIO())
+    console.out()
+    assert console.file.getvalue() == "\n"
+
+
+def test_out_markup_and_emoji_literal():
+    console = Console(file=io.StringIO())
+    console.out("[bold]foo[/bold]", ":smiley:")
+    assert console.file.getvalue() == "[bold]foo[/bold] :smiley:\n"
+
+
+def test_out_no_pretty_print():
+    console = Console(file=io.StringIO(), width=10)
+    console.out(list(range(30)))
+    assert console.file.getvalue() == str(list(range(30))) + "\n"
+
+
+def test_out_no_crop():
+    console = Console(file=io.StringIO(), width=5)
+    console.out("foobarbaz")
+    assert console.file.getvalue() == "foobarbaz\n"
+
+
+def test_out_style():
+    console = Console(file=io.StringIO(), color_system="truecolor", force_terminal=True)
+    console.out("foo", style="bold", highlight=False)
+    assert console.file.getvalue() == "\x1b[1mfoo\x1b[0m\n"
+
+
+class _CollectRenderables(RenderHook):
+    def __init__(self) -> None:
+        self.seen: list = []
+
+    def process_renderables(self, renderables):
+        self.seen.extend(renderables)
+        return renderables
+
+
+def _has_highlight_spans(console: Console, *args, **kwargs) -> bool:
+    hook = _CollectRenderables()
+    console.push_render_hook(hook)
+    console.out(*args, **kwargs)
+    console.pop_render_hook()
+    texts = [item for item in hook.seen if isinstance(item, Text)]
+    return any(text.spans for text in texts)
+
+
+def test_out_highlight_default_forces_highlight():
+    console = Console(file=io.StringIO(), highlight=False)
+    assert _has_highlight_spans(console, 1)
+
+
+def test_out_highlight_none_uses_console_default():
+    console = Console(file=io.StringIO(), highlight=False)
+    assert not _has_highlight_spans(console, 1, highlight=None)
+    console = Console(file=io.StringIO(), highlight=True)
+    assert _has_highlight_spans(console, 1, highlight=None)
+
+
+def test_out_highlight_false_disables_highlight():
+    console = Console(file=io.StringIO(), highlight=True)
+    assert not _has_highlight_spans(console, 1, highlight=False)
+
+
+def test_out_render_hook_runs():
+    console = Console(file=io.StringIO())
+    hook = _CollectRenderables()
+    console.push_render_hook(hook)
+    console.out("foo")
+    console.pop_render_hook()
+    texts = [item for item in hook.seen if isinstance(item, Text)]
+    assert any(text.plain == "foo" for text in texts)
+    assert console.file.getvalue() == "foo\n"
+
+
