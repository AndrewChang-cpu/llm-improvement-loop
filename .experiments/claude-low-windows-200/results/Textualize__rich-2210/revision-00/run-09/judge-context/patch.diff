--- a/rich/progress.py
+++ b/rich/progress.py
@@ -687,8 +687,23 @@ class TaskProgressColumn(TextColumn):
         markup: bool = True,
         highlighter: Optional[Highlighter] = None,
         table_column: Optional[Column] = None,
