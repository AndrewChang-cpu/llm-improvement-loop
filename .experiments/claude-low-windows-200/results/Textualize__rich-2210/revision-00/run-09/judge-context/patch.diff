     ) -> None:
+        """A column displaying the progress of a task.
+
+        Args:
+            text_format (str, optional): Format for the percentage text when total is known.
+            text_format_no_percentage (str, optional): Format used when total is unknown.
+            style (StyleType, optional): Style of the column text.
+            justify (JustifyMethod, optional): Text justification.
+            markup (bool, optional): Enable console markup in the format. Defaults to True.
+            highlighter (Highlighter, optional): Optional highlighter.
+            table_column (Column, optional): Table column to use.
+            show_speed (bool, optional): Show speed in iterations per second when the total
+                is not known. Defaults to False.
+        """
         self.text_format_no_percentage = text_format_no_percentage
