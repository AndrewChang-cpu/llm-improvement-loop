diff --git a/test/test_prepared_update.py b/test/test_prepared_update.py
new file mode 100644
index 0000000..ea5d724
--- /dev/null
+++ b/test/test_prepared_update.py
@@ -0,0 +1,117 @@
+import copy
+
+from rdflib import Graph, Literal, Namespace, Variable
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:a ex:p "1" . ex:b ex:p "2" . }
+"""
+
+
+def test_prepare_then_update_graph():
+    g = Graph()
+    upd = prepareUpdate(INSERT_TWO)
+    g.update(upd)
+    assert len(g) == 2
+
+
+def test_reuse_across_graphs_and_repeated_application():
+    upd = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(upd)
+    g2.update(upd)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    g1.update(upd)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_init_ns_resolves_prefixes():
+    upd = prepareUpdate(
+        'INSERT DATA { ex:a ex:p "1" . }', initNs={"ex": "http://example.org/"}
+    )
+    g = Graph()
+    g.update(upd)
+    assert (EX.a, EX.p, Literal("1")) in g
+
+
+def test_init_bindings_visible_to_operations():
+    upd = prepareUpdate("INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    g.update(upd, initBindings={"s": EX.a, "o": Literal("v")})
+    assert (EX.a, EX.p, Literal("v")) in g
+
+
+def test_direct_evaluation_through_evalupdate():
+    upd = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, upd)
+    assert len(g) == 2
+
+
+def test_direct_evaluation_with_init_bindings():
+    upd = prepareUpdate("INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    evalUpdate(g, upd, {Variable("s"): EX.a, Variable("o"): Literal("v")})
+    assert (EX.a, EX.p, Literal("v")) in g
+
+
+def test_container_shape():
+    upd = prepareUpdate(INSERT_TWO)
+    assert isinstance(upd, Update)
+    assert isinstance(upd.prologue, Prologue)
+    assert isinstance(upd.algebra, list)
+    assert len(upd.algebra) == 1
+
+
+def test_container_shape_two_operations():
+    upd = prepareUpdate(
+        'INSERT DATA { <http://example.org/a> <http://example.org/p> "1" } ;'
+        'INSERT DATA { <http://example.org/b> <http://example.org/p> "2" }'
+    )
+    assert isinstance(upd, Update)
+    assert len(upd.algebra) == 2
+
+
+def test_empty_request_container():
+    upd = prepareUpdate("")
+    assert isinstance(upd, Update)
+    assert isinstance(upd.prologue, Prologue)
+    assert upd.algebra == []
+
+
+def test_empty_request_applies_base_and_init_ns():
+    upd = prepareUpdate("", initNs={"ex": "http://example.org/"}, base="http://b/")
+    assert isinstance(upd.prologue, Prologue)
+    assert upd.algebra == []
+    assert upd.prologue.base == "http://b/"
+
+
+def test_empty_update_string_through_graph_is_noop():
+    g = Graph()
+    g.add((EX.a, EX.p, Literal("1")))
+    before = set(g)
+    g.update("")
+    assert set(g) == before
+    g.update(prepareUpdate(""))
+    assert set(g) == before
+    evalUpdate(g, prepareUpdate(""))
+    assert set(g) == before
+
+
+def test_evaluation_does_not_mutate_container():
+    upd = prepareUpdate(INSERT_TWO)
+    snapshot = copy.deepcopy(upd.algebra)
+    g = Graph()
+    g.update(upd)
+    assert upd.algebra == snapshot
+    g2 = Graph()
+    g2.update(upd)
+    assert upd.algebra == snapshot
