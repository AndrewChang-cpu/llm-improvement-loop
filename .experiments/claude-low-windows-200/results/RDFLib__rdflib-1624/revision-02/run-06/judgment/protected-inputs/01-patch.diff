diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..17ff9bf
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,107 @@
+import copy
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+PREFIX ex: <urn:ex:>
+INSERT DATA {
+  ex:s1 ex:p ex:o1 .
+  ex:s2 ex:p ex:o2 .
+}
+"""
+
+
+def _snapshot(prepared):
+    return copy.deepcopy([(u.name, dict(u)) for u in prepared.algebra])
+
+
+def test_prepare_then_update_graph():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_reuse_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_init_ns_prefix_resolution():
+    prepared = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_init_bindings_visible_to_operations():
+    prepared = prepareUpdate("INSERT { <urn:s> <urn:p> ?o } WHERE {}")
+    g = Graph()
+    g.update(prepared, initBindings={"o": URIRef("urn:o")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_direct_evaluation_through_evalupdate():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_container_shape():
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert [u.name for u in prepared.algebra] == ["InsertData", "InsertData"]
+
+
+def test_container_shape_empty_request():
+    prepared = translateUpdate(parseUpdate(""), None, {"ex": "urn:ex:"})
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    ns = prepared.prologue.namespace_manager.store.namespace("ex")
+    assert ns == URIRef("urn:ex:")
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_prepared_update_is_not_mutated():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+
+    assert _snapshot(prepared) == before
+
+
+def test_empty_update_string_is_noop():
+    g = Graph()
+    g.add((URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")))
+    before = len(g)
+
+    g.update("")
+    assert len(g) == before
+
+    processUpdate(g, "")
+    assert len(g) == before
