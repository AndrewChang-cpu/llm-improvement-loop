diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..02db433
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,89 @@
+from rdflib import Graph, Namespace
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = (
+    "INSERT DATA { "
+    "<http://example.org/a> <http://example.org/b> <http://example.org/c> . "
+    "<http://example.org/d> <http://example.org/e> <http://example.org/f> . }"
+)
+
+
+def test_prepare_then_apply_through_graph_update():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_reuse_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_init_ns_prefix_resolution():
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:b ex:c . }", initNs={"ex": str(EX)})
+    g = Graph()
+    g.update(prepared)
+    assert (EX.a, EX.b, EX.c) in g
+
+
+def test_direct_evaluation_through_evalupdate():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_container_shape():
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_empty_request_container_shape_and_evaluation():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_and_process_update():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_prepared_update_is_not_mutated_by_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = repr(prepared.algebra)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+
+    assert repr(prepared.algebra) == before
