diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..e81327a
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,100 @@
+import unittest
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA {
+  ex:s ex:p ex:o1 .
+  ex:s ex:p ex:o2 .
+}
+"""
+
+
+def _snapshot(update):
+    return [(op.name, repr(dict(op)), op.prologue) for op in update.algebra]
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_apply_through_graph(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_DATA)
+
+        g1 = Graph()
+        g1.update(prepared)
+        g2 = Graph()
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_prefixes_resolve(self):
+        prepared = prepareUpdate(
+            "INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn(
+            (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g
+        )
+
+    def test_direct_evaluation(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(len(prepared.algebra), 1)
+
+        two_ops = translateUpdate(
+            parseUpdate("INSERT DATA { <urn:a> <urn:b> <urn:c> } ; CLEAR DEFAULT")
+        )
+        self.assertIsInstance(two_ops, Update)
+        self.assertIsInstance(two_ops.prologue, Prologue)
+        self.assertEqual([op.name for op in two_ops.algebra], ["InsertData", "Clear"])
+
+    def test_empty_request_shape(self):
+        prepared = prepareUpdate("")
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+
+    def test_empty_update_string_leaves_graph_unchanged(self):
+        g = Graph()
+        g.update("")
+        self.assertEqual(len(g), 0)
+
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+        g.update(prepareUpdate(""))
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_prepared_update(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        before = _snapshot(prepared)
+        g = Graph()
+        evalUpdate(g, prepared)
+        g.update(prepared)
+        self.assertEqual(_snapshot(prepared), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
