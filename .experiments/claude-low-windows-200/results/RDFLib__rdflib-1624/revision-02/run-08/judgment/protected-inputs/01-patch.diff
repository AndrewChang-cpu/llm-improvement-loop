diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..4d58f8e
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,103 @@
+import copy
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA {
+    ex:a ex:p ex:b .
+    ex:c ex:p ex:d .
+}
+"""
+
+
+def _snapshot(update):
+    return [(op.name, copy.deepcopy(dict(op))) for op in update.algebra]
+
+
+def test_prepare_then_update_graph():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated():
+    prepared = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_init_ns_prefixes_resolve():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b")) in g
+
+
+def test_init_bindings_visible_to_operations():
+    prepared = prepareUpdate("INSERT { ?s <urn:ex:p> ?o } WHERE { }")
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={"s": URIRef("urn:ex:a"), "o": Literal("x")},
+    )
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), Literal("x")) in g
+
+
+def test_direct_evaluation_through_evalupdate():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_container_shape():
+    prepared = prepareUpdate(INSERT_DATA)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_empty_request_container():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_is_noop():
+    g = Graph()
+    g.update(prepareUpdate(""))
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_prepared_update_not_mutated_by_evaluation():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _snapshot(prepared)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert _snapshot(prepared) == before
