diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..3d3d7e9
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,107 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.parserutils import CompValue
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o1> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+INSERT_PREFIXED = """
+INSERT DATA {
+  ex:s ex:p ex:o .
+}
+"""
+
+
+def test_prepare_then_update_graph():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(update)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated():
+    update = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(update)
+    assert len(g1) == 2
+
+    g2 = Graph()
+    g2.update(update)
+    assert len(g2) == 2
+
+    g1.update(update)
+    assert len(g1) == 2
+
+
+def test_prepared_update_init_ns_resolves_prefixes():
+    update = prepareUpdate(INSERT_PREFIXED, initNs={"ex": "urn:ex:"})
+    g = Graph()
+    g.update(update)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_direct_evaluation():
+    update = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 2
+
+
+def test_prepared_update_shape():
+    update = prepareUpdate(INSERT_TWO)
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert isinstance(update.algebra, list)
+    assert len(update.algebra) == 1
+
+
+def test_translate_update_returns_container_per_operation():
+    update = translateUpdate(
+        parseUpdate(INSERT_TWO + ";" + "INSERT DATA { <urn:s> <urn:p> <urn:o3> . }")
+    )
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 2
+
+
+def test_empty_request_container():
+    update = prepareUpdate("")
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_and_process_update():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
+
+
+def test_evaluation_does_not_mutate_prepared_update():
+    update = prepareUpdate(INSERT_TWO)
+    before = repr(update.algebra)
+    assert all(isinstance(op, CompValue) for op in update.algebra)
+
+    g = Graph()
+    g.update(update)
+    assert repr(update.algebra) == before
+
+    g2 = Graph()
+    g2.update(update)
+    assert repr(update.algebra) == before
