diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..9bb3bc7
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,118 @@
+import unittest
+
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_apply_through_graph(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_TWO)
+
+        g1 = Graph()
+        g1.update(prepared)
+        g2 = Graph()
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_resolves_prefixes(self):
+        prepared = prepareUpdate(
+            'INSERT DATA { ex:s ex:p "a" . }', initNs={"ex": "http://example.org/"}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((EX.s, EX.p, Literal("a")), g)
+
+    def test_direct_evaluation(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_init_bindings_are_visible(self):
+        prepared = prepareUpdate(
+            "INSERT { ?s ex:p ?o } WHERE { }",
+            initNs={"ex": "http://example.org/"},
+        )
+        g = Graph()
+        g.update(
+            prepared,
+            initBindings={"s": EX.s, "o": Literal("v")},
+        )
+        self.assertIn((EX.s, EX.p, Literal("v")), g)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertIsInstance(prepared.algebra, list)
+        self.assertEqual(len(prepared.algebra), 1)
+
+    def test_translate_returns_container(self):
+        translated = translateUpdate(parseUpdate(INSERT_TWO))
+        self.assertIsInstance(translated, Update)
+        self.assertIsInstance(translated.prologue, Prologue)
+        self.assertEqual(len(translated.algebra), 1)
+
+    def test_empty_request_container(self):
+        for text in ("", "PREFIX ex: <http://example.org/>"):
+            prepared = prepareUpdate(text)
+            self.assertIsInstance(prepared, Update)
+            self.assertIsInstance(prepared.prologue, Prologue)
+            self.assertEqual(prepared.algebra, [])
+
+    def test_empty_request_evaluates_without_error(self):
+        prepared = prepareUpdate("")
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_graph_and_process_update(self):
+        g = Graph()
+        g.update("")
+        g.update("PREFIX ex: <http://example.org/>")
+        self.assertEqual(len(g), 0)
+
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_container(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        before_algebra = repr(prepared.algebra)
+        before_prologue = repr(prepared.prologue)
+
+        g1 = Graph()
+        g1.update(prepared)
+        g2 = Graph()
+        evalUpdate(g2, prepared)
+        g2.update(prepared)
+
+        self.assertEqual(repr(prepared.algebra), before_algebra)
+        self.assertEqual(repr(prepared.prologue), before_prologue)
+        self.assertEqual(len(prepared.algebra), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
