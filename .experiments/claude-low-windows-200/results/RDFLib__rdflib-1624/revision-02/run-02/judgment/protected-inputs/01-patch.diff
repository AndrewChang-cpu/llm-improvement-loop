@@ -0,0 +1,90 @@
+import unittest
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o1> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_update(self):
+        g = Graph()
+        u = prepareUpdate(INSERT_TWO)
+        g.update(u)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        u = prepareUpdate(INSERT_TWO)
+
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(u)
+        g2.update(u)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        g1.update(u)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_resolves_prefixes(self):
+        g = Graph()
+        u = prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"})
+        g.update(u)
+        self.assertIn((URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g)
+
+    def test_init_bindings_visible_to_operations(self):
+        g = Graph()
+        u = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+        g.update(u, initBindings={"s": URIRef("urn:x")})
+        self.assertIn((URIRef("urn:x"), URIRef("urn:p"), URIRef("urn:o")), g)
+
+    def test_direct_evaluation(self):
+        g = Graph()
+        u = prepareUpdate(INSERT_TWO)
+        evalUpdate(g, u)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        u = prepareUpdate(INSERT_TWO)
+        self.assertIsInstance(u.prologue, Prologue)
+        self.assertIsInstance(u.algebra, list)
+        self.assertEqual(len(u.algebra), 1)
+
+        two_ops = prepareUpdate(
+            "INSERT DATA { <urn:a> <urn:b> <urn:c> } ; "
+            "DELETE DATA { <urn:a> <urn:b> <urn:c> }"
+        )
+        self.assertEqual(len(two_ops.algebra), 2)
+
+    def test_empty_request_shape_and_evaluation(self):
+        u = prepareUpdate("")
+        self.assertIsInstance(u.prologue, Prologue)
+        self.assertEqual(u.algebra, [])
+
+        g = Graph()
+        evalUpdate(g, u)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_is_noop(self):
+        g = Graph()
+        g.add((URIRef("urn:a"), URIRef("urn:b"), URIRef("urn:c")))
+        g.update("")
+        processUpdate(g, "")
+        self.assertEqual(len(g), 1)
+
+    def test_evaluation_does_not_mutate_prepared_update(self):
+        u = prepareUpdate(INSERT_TWO)
+        before = repr(u.algebra)
+
+        evalUpdate(Graph(), u)
+        evalUpdate(Graph(), u)
+
+        self.assertEqual(repr(u.algebra), before)
