+def test_prepare_update():
+    from rdflib.plugins.sparql import prepareUpdate
+    from rdflib.plugins.sparql.sparql import Update
+
+    g = Graph()
+    u = prepareUpdate(
+        "INSERT DATA { <urn:s> <urn:p> <urn:o> }",
+    )
+    assert isinstance(u, Update)
+    assert u._original_args[0] == "INSERT DATA { <urn:s> <urn:p> <urn:o> }"
+
+    g.update(u)
+    assert (URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+    # prepared update can be run against another graph
+    g2 = Graph()
+    g2.update(u)
+    assert len(g2) == 1
