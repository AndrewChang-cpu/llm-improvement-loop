diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..bfe896b
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,61 @@
+from rdflib import Graph, URIRef, Literal
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+from rdflib.plugins.sparql.processor import SPARQLUpdateProcessor
+
+
+def test_prepare_update_returns_update():
+    u = prepareUpdate(
+        "PREFIX : <urn:ns1:> INSERT DATA { :a :b :c }",
+    )
+    assert isinstance(u, Update)
+    assert u._original_args[0].strip().startswith("PREFIX")
+
+
+def test_prepared_update_applied_to_graph():
+    update_str = """
+    PREFIX : <urn:ns1:>
+    INSERT DATA { :a :b "c" }
+    """
+    prepared = prepareUpdate(update_str)
+
+    g = Graph()
+    g.update(prepared)
+
+    assert (URIRef("urn:ns1:a"), URIRef("urn:ns1:b"), Literal("c")) in g
+
+
+def test_prepared_update_is_reusable():
+    prepared = prepareUpdate("INSERT DATA { <urn:x> <urn:y> <urn:z> }")
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+
+    expected = (URIRef("urn:x"), URIRef("urn:y"), URIRef("urn:z"))
+    assert expected in g1
+    assert expected in g2
+
+
+def test_prepared_update_matches_string_update():
+    update_str = "INSERT { ?s <urn:p> ?o } WHERE { ?s <urn:q> ?o }"
+
+    data = "<urn:s1> <urn:q> <urn:o1> ."
+
+    g_str = Graph()
+    g_str.parse(data=data, format="nt")
+    g_str.update(update_str)
+
+    g_prep = Graph()
+    g_prep.parse(data=data, format="nt")
+    g_prep.update(prepareUpdate(update_str))
+
+    assert set(g_str) == set(g_prep)
+
+
+def test_processor_accepts_prepared_update():
+    g = Graph()
+    processor = SPARQLUpdateProcessor(g)
+    processor.update(prepareUpdate("INSERT DATA { <urn:a> <urn:b> <urn:c> }"))
+    assert (URIRef("urn:a"), URIRef("urn:b"), URIRef("urn:c")) in g
