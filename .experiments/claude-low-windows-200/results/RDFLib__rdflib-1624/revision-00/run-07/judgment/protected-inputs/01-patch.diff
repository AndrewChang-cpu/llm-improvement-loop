+    g = Graph()
+    u_str = """
+    PREFIX : <urn:ns1:>
+    INSERT DATA { :foo <p> 42 }
+    """
+    u_prepared = prepareUpdate(u_str)
+    assert isinstance(u_prepared, sparql.Update)
+
+    g.update(u_prepared)
