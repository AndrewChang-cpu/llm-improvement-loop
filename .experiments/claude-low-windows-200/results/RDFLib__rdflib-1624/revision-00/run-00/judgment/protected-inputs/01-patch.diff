diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..8869c43
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,51 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+
+
+class TestPrepareUpdate(unittest.TestCase):
+    def test_prepare_update_returns_update(self):
+        u = prepareUpdate("INSERT DATA { <urn:a> <urn:p> 'x' }")
+        self.assertIsInstance(u, Update)
+        self.assertEqual(len(u.algebra), 1)
+
+    def test_prepared_update_applies_to_graph(self):
+        g = Graph()
+        u = prepareUpdate("INSERT DATA { <urn:a> <urn:p> 'x' }")
+        g.update(u)
+
+        self.assertEqual(
+            set(g), {(URIRef("urn:a"), URIRef("urn:p"), Literal("x"))}
+        )
+
+    def test_prepared_update_is_reusable(self):
+        g = Graph()
+        u = prepareUpdate("INSERT DATA { <urn:a> <urn:p> 'x' }")
+        g.update(u)
+        g.update(u)
+
+        self.assertEqual(len(g), 1)
+
+    def test_prepared_update_with_init_bindings(self):
+        g = Graph()
+        g.add((URIRef("urn:a"), URIRef("urn:p"), Literal("old")))
+        u = prepareUpdate(
+            "DELETE { ?s ?p ?old } INSERT { ?s ?p ?new } WHERE { ?s ?p ?old }"
+        )
+        g.update(u, initBindings={"new": Literal("new")})
+
+        # ?old is bound by the WHERE clause; ?new comes from initBindings
+        self.assertEqual(
+            set(g), {(URIRef("urn:a"), URIRef("urn:p"), Literal("new"))}
+        )
+
+    def test_prepare_update_stores_original_args(self):
+        s = "INSERT DATA { <urn:a> <urn:p> 'x' }"
+        u = prepareUpdate(s)
+        self.assertEqual(u._original_args, (s, {}, None))
+
+
+if __name__ == "__main__":
+    unittest.main()
