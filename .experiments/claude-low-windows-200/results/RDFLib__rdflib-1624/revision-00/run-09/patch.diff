diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..f4c441c
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,46 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+
+
+def test_prepare_update_returns_update():
+    u = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT DATA { ex:s ex:p ex:o }"
+    )
+    assert isinstance(u, Update)
+    assert len(u.algebra) == 1
+
+
+def test_prepared_update_can_be_executed_repeatedly():
+    ex = "http://example.org/"
+    g = Graph()
+    u = prepareUpdate(
+        "INSERT DATA { <http://example.org/s> <http://example.org/p> 'o' }"
+    )
+    g.update(u)
+    assert (URIRef(ex + "s"), URIRef(ex + "p"), Literal("o")) in g
+    assert len(g) == 1
+
+    g2 = Graph()
+    g2.update(u)
+    assert len(g2) == 1
+
+
+def test_prepare_update_uses_init_ns():
+    g = Graph()
+    u = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o }",
+        initNs={"ex": "http://example.org/"},
+    )
+    g.update(u)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/o"),
+    ) in g
+
+
+def test_prepare_update_original_args():
+    s = "INSERT DATA { <http://example.org/s> <http://example.org/p> 'o' }"
+    u = prepareUpdate(s)
+    assert u._original_args == (s, {}, None)
