diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..e7dcab9
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,47 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+
+
+def test_prepare_update_returns_update():
+    u = prepareUpdate(
+        "PREFIX : <urn:ns1:> INSERT DATA { :foo :bar 42 }",
+    )
+    assert isinstance(u, Update)
+    assert len(u.algebra) == 1
+
+
+def test_prepared_update_is_applied():
+    g = Graph()
+    u = prepareUpdate(
+        """
+        PREFIX : <urn:ns1:>
+        INSERT DATA { :foo :bar 42 }
+        """
+    )
+    g.update(u)
+
+    assert (URIRef("urn:ns1:foo"), URIRef("urn:ns1:bar"), Literal(42)) in g
+
+
+def test_prepared_update_can_be_reused():
+    g = Graph()
+    u = prepareUpdate(
+        """
+        PREFIX : <urn:ns1:>
+        INSERT DATA { :foo :bar 1 }
+        """
+    )
+    g.update(u)
+    g.update(u)
+
+    assert len(g) == 1
+    assert (URIRef("urn:ns1:foo"), URIRef("urn:ns1:bar"), Literal(1)) in g
+
+
+def test_prepared_update_respects_init_ns():
+    g = Graph()
+    u = prepareUpdate("INSERT DATA { :foo :bar 7 }", initNs={"": "urn:ns2:"})
+    g.update(u)
+
+    assert (URIRef("urn:ns2:foo"), URIRef("urn:ns2:bar"), Literal(7)) in g
