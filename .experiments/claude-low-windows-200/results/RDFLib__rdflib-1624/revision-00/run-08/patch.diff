diff --git a/test/test_sparql_prepareupdate.py b/test/test_sparql_prepareupdate.py
new file mode 100644
index 0000000..ccd0bb9
--- /dev/null
+++ b/test/test_sparql_prepareupdate.py
@@ -0,0 +1,39 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+
+from .testutils import eq_
+
+
+def test_prepare_update_returns_update():
+    u = prepareUpdate("INSERT DATA { <urn:s> <urn:p> <urn:o> }")
+    assert isinstance(u, Update)
+    assert u._original_args[0] == "INSERT DATA { <urn:s> <urn:p> <urn:o> }"
+
+
+def test_prepared_update_applies_to_graph():
+    g = Graph()
+    u = prepareUpdate("INSERT DATA { <urn:s> <urn:p> <urn:o> }")
+    g.update(u)
+    assert (URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_prepared_update_is_reusable():
+    g = Graph()
+    u = prepareUpdate(
+        "PREFIX ex: <urn:ex:> INSERT DATA { ex:s ex:p ex:o }"
+    )
+    g.update(u)
+    g.update(u)
+    eq_(len(g), 1)
+
+    g2 = Graph()
+    g2.update(u)
+    eq_(len(g2), 1)
+
+
+def test_prepared_update_with_initns():
+    g = Graph()
+    u = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"})
+    g.update(u)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
