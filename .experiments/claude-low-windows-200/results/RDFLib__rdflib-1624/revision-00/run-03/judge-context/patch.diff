diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..6c30759
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,50 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+
+
+def test_prepare_update_returns_update():
+    u = prepareUpdate("INSERT DATA { <urn:s> <urn:p> 42 }")
+    assert isinstance(u, Update)
+    assert u._original_args == (
+        "INSERT DATA { <urn:s> <urn:p> 42 }",
+        {},
+        None,
+    )
+
+
+def test_prepared_update_insert_data():
+    g = Graph()
+    u = prepareUpdate("PREFIX : <urn:ns1:> INSERT DATA { :foo :bar 42 }")
+
+    g.update(u)
+
+    assert (URIRef("urn:ns1:foo"), URIRef("urn:ns1:bar"), Literal(42)) in g
+
+
+def test_prepared_update_is_reusable():
+    g = Graph()
+    u = prepareUpdate(
+        "PREFIX : <urn:ns1:> DELETE { ?s :p ?o } INSERT { ?s :p ?new } "
+        "WHERE { ?s :p ?o . BIND(?o + 1 AS ?new) }"
+    )
+    g.add((URIRef("urn:ns1:a"), URIRef("urn:ns1:p"), Literal(1)))
+
+    g.update(u)
+    g.update(u)
+
+    assert list(g.objects(URIRef("urn:ns1:a"), URIRef("urn:ns1:p"))) == [
+        Literal(3)
+    ]
+
+
+def test_prepared_update_matches_string_update():
+    update_str = "PREFIX : <urn:ns1:> INSERT DATA { :x :y :z }"
+
+    g_prepared = Graph()
+    g_prepared.update(prepareUpdate(update_str))
+
+    g_string = Graph()
+    g_string.update(update_str)
+
+    assert set(g_prepared) == set(g_string)
