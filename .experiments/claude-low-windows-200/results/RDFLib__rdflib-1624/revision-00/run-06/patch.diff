+def prepareUpdate(updateString, initNs={}, base=None) -> Update:
+    """
+    Parse and translate a SPARQL Update request
+    """
+    parsetree = parseUpdate(updateString)
+    algebra = translateUpdate(parsetree, base, initNs)
+    prologues = [u.prologue for u in algebra]
+    ret = Update(prologues, algebra)
+    ret._original_args = (updateString, initNs, base)
+    return ret
