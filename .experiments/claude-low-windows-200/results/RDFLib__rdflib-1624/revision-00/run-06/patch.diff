diff --git a/test/test_sparql_prepareupdate.py b/test/test_sparql_prepareupdate.py
new file mode 100644
index 0000000..418b859
--- /dev/null
+++ b/test/test_sparql_prepareupdate.py
@@ -0,0 +1,51 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+
+from .testutils import eq_
+
+
+def test_prepare_update_returns_update():
+    u = prepareUpdate("INSERT DATA { <urn:s> <urn:p> 1 }")
+    assert isinstance(u, Update)
+    eq_(len(u.algebra), 1)
+
+
+def test_prepared_update_applies_to_graph():
+    update_str = """
+    PREFIX : <urn:ns1:>
+    INSERT DATA { :foo :bar 42 }
+    """
+    u = prepareUpdate(update_str)
+
+    g = Graph()
+    g.update(u)
+
+    expected = [(URIRef("urn:ns1:foo"), URIRef("urn:ns1:bar"), Literal(42))]
+    eq_(list(g.triples((None, None, None))), expected)
+
+
+def test_prepared_update_reusable():
+    u = prepareUpdate("INSERT DATA { <urn:s> <urn:p> <urn:o> }")
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(u)
+    g2.update(u)
+
+    expected = [(URIRef("urn:s"), URIRef("urn:p"), URIRef("urn:o"))]
+    eq_(list(g1.triples((None, None, None))), expected)
+    eq_(list(g2.triples((None, None, None))), expected)
+
+
+def test_prepare_update_respects_initns():
+    u = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o }",
+        initNs={"ex": "urn:ex:"},
+    )
+
+    g = Graph()
+    g.update(u)
+
+    expected = [(URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o"))]
+    eq_(list(g.triples((None, None, None))), expected)
