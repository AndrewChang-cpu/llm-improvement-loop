+def prepareUpdate(updateString, initNs={}, base=None) -> Update:
+    """
+    Parse and translate a SPARQL Update
+    """
+    algebra = translateUpdate(parseUpdate(updateString), base, initNs)
+    # translateUpdate tags each operation with its prologue; the last one
+    # reflects the prologue in effect at the end of the request.
+    prologue = algebra[-1].prologue if algebra else None
+    ret = Update(prologue, algebra)
+    ret._original_args = (updateString, initNs, base)
+    return ret
