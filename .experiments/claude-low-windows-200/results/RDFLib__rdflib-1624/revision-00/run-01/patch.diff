diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..c70738f
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,56 @@
+from rdflib import Graph, URIRef, Literal
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Update
+
+
+def test_prepare_update_returns_update():
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT DATA { ex:s ex:p 42 }"
+    )
+    assert isinstance(prepared, Update)
+    assert len(prepared.algebra) == 1
+
+
+def test_prepared_update_can_be_applied_repeatedly():
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.org/> INSERT DATA { ex:s ex:p 42 }"
+    )
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    g2.update(prepared)  # re-applying the same prepared update is idempotent
+
+    expected = [(URIRef("http://example.org/s"), URIRef("http://example.org/p"), Literal(42))]
+    assert list(g1) == expected
+    assert list(g2) == expected
+
+
+def test_prepared_update_matches_string_update():
+    update_str = (
+        "PREFIX ex: <http://example.org/> "
+        "INSERT DATA { ex:a ex:b ex:c } ; "
+        "DELETE DATA { ex:a ex:b ex:c }"
+    )
+    g_str = Graph()
+    g_str.update(update_str)
+
+    g_prepared = Graph()
+    g_prepared.update(prepareUpdate(update_str))
+
+    assert len(g_str) == len(g_prepared) == 0
+
+
+def test_prepare_update_with_init_ns():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o }",
+        initNs={"ex": "http://example.org/"},
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        URIRef("http://example.org/o"),
+    ) in g
+
