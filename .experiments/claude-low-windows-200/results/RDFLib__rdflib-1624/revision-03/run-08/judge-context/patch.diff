diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..72fe8fd
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,83 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:a> <urn:b> <urn:c> .
+  <urn:d> <urn:e> <urn:f> .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applies_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_applications():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    g1.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_resolves_init_ns():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:a ex:b ex:c . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:b"), URIRef("urn:ex:c")) in g
+    assert len(g) == 1
+
+
+def test_prepared_update_direct_evaluation():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape():
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 1
+
+
+def test_empty_request_translates_to_empty_update():
+    translated = translateUpdate(parseUpdate(""))
+    assert isinstance(translated, Update)
+    assert isinstance(translated.prologue, Prologue)
+    assert translated.algebra == []
+    evalUpdate(Graph(), translated)
+
+
+def test_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    evalUpdate(Graph(), prepared)
+    assert _snapshot(prepared) == before
+
+
+def test_empty_update_string_is_noop():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
