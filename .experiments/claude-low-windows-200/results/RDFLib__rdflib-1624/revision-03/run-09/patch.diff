diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..2294e92
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,109 @@
+from rdflib import Graph, Namespace
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:a ex:p ex:b . ex:a ex:p ex:c . }
+"""
+
+
+def _snapshot(update):
+    return [[op.name, repr(op)] for op in update.algebra]
+
+
+def test_prepare_then_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (EX.a, EX.p, EX.b) in g
+
+
+def test_prepared_update_uses_init_bindings():
+    prepared = prepareUpdate("INSERT { ?s ex:p ex:o } WHERE { }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared, initBindings={"s": EX.subject})
+    assert (EX.subject, EX.p, EX.o) in g
+
+
+def test_evaluate_prepared_update_directly():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert _snapshot(prepared) == before
+
+
+def test_prepared_update_shape():
+    prepared = prepareUpdate(INSERT_TWO + "; INSERT DATA { <urn:x> <urn:y> <urn:z> }")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 2
+    assert [op.name for op in prepared.algebra] == ["InsertData", "InsertData"]
+
+
+def test_translate_update_returns_update_container():
+    update = translateUpdate(parseUpdate(INSERT_TWO))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 1
+
+
+def test_empty_request_yields_empty_container():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_keeps_prologue():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+
+def test_empty_update_string_is_noop():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
