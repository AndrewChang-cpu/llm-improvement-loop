diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..946a0c1
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,88 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = "INSERT DATA { <urn:a> <urn:b> <urn:c> . <urn:d> <urn:e> <urn:f> }"
+
+
+def _algebra_snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepare_then_update_through_graph():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_init_ns_resolves_prefixes():
+    g = Graph()
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:b ex:c }", initNs={"ex": "urn:ex:"})
+    g.update(prepared)
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:b"), URIRef("urn:ex:c")) in g
+
+
+def test_direct_evaluation_with_evalupdate():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_container_shape_non_empty():
+    prepared = prepareUpdate(INSERT_TWO + " ; " + INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 2
+
+
+def test_container_shape_empty_request():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    evalUpdate(Graph(), update)
+
+
+def test_declarations_only_request_keeps_prologue():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "a") == URIRef("urn:ex:a")
+
+
+def test_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _algebra_snapshot(prepared)
+    g = Graph()
+    evalUpdate(g, prepared)
+    g2 = Graph()
+    evalUpdate(g2, prepared)
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_empty_update_string_is_noop():
+    g = Graph()
+    g.update(prepareUpdate(""))
+    assert len(g) == 0
+    g.update("")
+    assert len(g) == 0
+    processUpdate(g, "")
+    assert len(g) == 0
