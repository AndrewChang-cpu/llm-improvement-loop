diff --git a/test/test_prepared_update.py b/test/test_prepared_update.py
new file mode 100644
index 0000000..f5219dd
--- /dev/null
+++ b/test/test_prepared_update.py
@@ -0,0 +1,93 @@
+import unittest
+
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:a ex:p ex:b . ex:a ex:p ex:c . }
+"""
+
+
+def _shape(update):
+    return [(op.name, str(op)) for op in update.algebra]
+
+
+class PreparedUpdateTest(unittest.TestCase):
+    def test_prepare_and_apply_through_graph(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_prefix_resolution(self):
+        prepared = prepareUpdate("INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": EX})
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((EX.a, EX.p, EX.b), g)
+
+    def test_init_bindings_visible_to_operations(self):
+        prepared = prepareUpdate("INSERT DATA { ex:a ex:p ex:b . }", initNs={"ex": EX})
+        g = Graph()
+        g.update(prepared,initBindings={"x": Literal("unused")})
+        self.assertEqual(len(g), 1)
+
+    def test_direct_evaluation(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(len(prepared.algebra), 1)
+        self.assertEqual(prepared.algebra[0].name, "InsertData")
+
+    def test_container_shape_empty_request(self):
+        prepared = translateUpdate(parseUpdate(""))
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+
+    def test_empty_request_evaluates_without_error(self):
+        prepared = prepareUpdate("")
+        g = Graph()
+        evalUpdate(g, prepared)
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_through_process_update(self):
+        g = Graph()
+        processUpdate(g, "")
+        g.update("")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_algebra(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        before = _shape(prepared)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(_shape(prepared), before)
+
+
+if __name__ == "__main__":
+    unittest.main()
