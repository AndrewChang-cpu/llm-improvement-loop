diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..de9f669
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,100 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_TWO = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:s ex:p ex:o1 . ex:s ex:p ex:o2 . }
+"""
+
+
+def _snapshot(update):
+    return [(op.name, repr(op)) for op in update.algebra]
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_apply_with_graph_update(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_prefix_resolution(self):
+        prepared = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": EX})
+        g = Graph()
+        g.update(prepared)
+        self.assertIn(
+            (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")),
+            g,
+        )
+
+    def test_direct_evaluation_through_evalupdate(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertIsInstance(prepared.algebra, list)
+        self.assertEqual(len(prepared.algebra), 1)
+        self.assertEqual(prepared.algebra[0].name, "InsertData")
+
+    def test_empty_request_container(self):
+        prepared = prepareUpdate("")
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+
+    def test_prologue_only_request_keeps_declarations(self):
+        prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+        self.assertEqual(prepared.prologue.resolvePName("ex", "x"), URIRef(EX + "x"))
+
+    def test_evaluation_does_not_mutate_algebra(self):
+        prepared = prepareUpdate(INSERT_TWO)
+        before = _snapshot(prepared)
+        g = Graph()
+        g.update(prepared)
+        evalUpdate(g, prepared)
+        self.assertEqual(_snapshot(prepared), before)
+
+    def test_empty_update_string_is_noop(self):
+        g = Graph()
+        g.add((URIRef(EX + "s"), URIRef(EX + "p"), Literal("keep")))
+        before = len(g)
+
+        g.update("")
+        processUpdate(g, "")
+        self.assertEqual(len(g), before)
+
+        g.update(prepareUpdate(""))
+        self.assertEqual(len(g), before)
+
+    def test_translate_update_returns_container_for_empty_request(self):
+        result = translateUpdate(parseUpdate(""))
+        self.assertIsInstance(result, Update)
+        self.assertIsInstance(result.prologue, Prologue)
+        self.assertEqual(result.algebra, [])
