+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,101 @@
+import unittest
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:a ex:b ex:c . ex:d ex:e ex:f . }
+"""
+
+
+def _operation_repr(update):
+    return [f"{op.name} {op}" for op in update.algebra]
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_apply_through_graph_update(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_DATA)
+
+        g1 = Graph()
+        g1.update(prepared)
+        g2 = Graph()
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_resolves_prefixes(self):
+        prepared = prepareUpdate(
+            "INSERT DATA { ex:a ex:b ex:c }", initNs={"ex": "urn:ex:"}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn((URIRef("urn:ex:a"), URIRef("urn:ex:b"), URIRef("urn:ex:c")), g)
+
+    def test_init_bindings_are_visible_to_operations(self):
+        prepared = prepareUpdate(
+            "PREFIX ex: <urn:ex:> INSERT { ?s ex:p ex:o } WHERE { }"
+        )
+        g = Graph()
+        g.update(prepared, initBindings={"s": URIRef("urn:ex:subject")})
+        self.assertIn(
+            (URIRef("urn:ex:subject"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g
+        )
+
+    def test_direct_evaluation(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(len(prepared.algebra), 1)
+
+    def test_container_shape_for_empty_request(self):
+        prepared = prepareUpdate("")
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request_keeps_prologue(self):
+        prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertEqual(prepared.algebra, [])
+        self.assertEqual(
+            prepared.prologue.resolvePName("ex", "x"), URIRef("urn:ex:x")
+        )
+
+    def test_evaluation_does_not_mutate_container(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        before = _operation_repr(prepared)
+        g = Graph()
+        g.update(prepared)
+        Graph().update(prepared)
+        self.assertEqual(_operation_repr(prepared), before)
+
+    def test_empty_update_string_is_noop(self):
+        g = Graph()
+        g.update("")
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
