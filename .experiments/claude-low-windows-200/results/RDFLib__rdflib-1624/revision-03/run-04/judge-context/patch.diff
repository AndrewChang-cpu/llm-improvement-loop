diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..7c6d0d6
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,77 @@
+import unittest
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = "INSERT DATA { <urn:s> <urn:p> <urn:o1> . <urn:s> <urn:p> <urn:o2> . }"
+
+
+def _algebra_repr(update):
+    return [f"{op.name}: {op}" for op in update.algebra]
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_apply_through_graph(self):
+        g = Graph()
+        g.update(prepareUpdate(INSERT_TWO))
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        q = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(q)
+        g2.update(q)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        g1.update(q)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_prefixes_resolve(self):
+        q = prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"})
+        g = Graph()
+        g.update(q)
+        self.assertIn((URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g)
+
+    def test_direct_evaluation(self):
+        q = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, q)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        u = translateUpdate(parseUpdate(INSERT_TWO))
+        self.assertIsInstance(u, Update)
+        self.assertIsInstance(u.prologue, Prologue)
+        self.assertEqual(len(u.algebra), 1)
+
+    def test_empty_request_container(self):
+        u = translateUpdate(parseUpdate(""))
+        self.assertIsInstance(u, Update)
+        self.assertIsInstance(u.prologue, Prologue)
+        self.assertEqual(u.algebra, [])
+        evalUpdate(Graph(), u)
+
+    def test_empty_update_string_leaves_graph_unchanged(self):
+        g = Graph()
+        g.update("")
+        self.assertEqual(len(g), 0)
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+    def test_evaluation_does_not_mutate_algebra(self):
+        q = prepareUpdate(INSERT_TWO)
+        before = _algebra_repr(q)
+        g = Graph()
+        g.update(q)
+        evalUpdate(g, q)
+        self.assertEqual(before, _algebra_repr(q))
+
+
+if __name__ == "__main__":
+    unittest.main()
