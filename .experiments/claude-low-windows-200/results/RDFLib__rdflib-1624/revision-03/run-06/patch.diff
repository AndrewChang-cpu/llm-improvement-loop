diff --git a/test/test_prepared_update.py b/test/test_prepared_update.py
new file mode 100644
index 0000000..e0c0cd3
--- /dev/null
+++ b/test/test_prepared_update.py
@@ -0,0 +1,95 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_DATA = """
+INSERT DATA {
+    <http://example.org/a> <http://example.org/p> "x" .
+    <http://example.org/b> <http://example.org/p> "y" .
+}
+"""
+
+
+def _algebra_snapshot(update):
+    return [(op.name, str(op).splitlines()) for op in update.algebra]
+
+
+def test_prepare_then_update_graph():
+    g = Graph()
+    g.update(prepareUpdate(INSERT_DATA))
+    assert len(g) == 2
+
+
+def test_reuse_across_graphs_and_repeated_application():
+    upd = prepareUpdate(INSERT_DATA)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(upd)
+    g2.update(upd)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(upd)
+    assert len(g1) == 2
+
+
+def test_initns_prefix_resolution():
+    upd = prepareUpdate('INSERT DATA { ex:a ex:p "x" . }', initNs={"ex": EX})
+    g = Graph()
+    g.update(upd)
+    assert (URIRef(EX + "a"), URIRef(EX + "p"), Literal("x")) in g
+
+
+def test_direct_evaluation():
+    upd = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, upd)
+    assert len(g) == 2
+
+
+def test_container_shape():
+    upd = prepareUpdate(INSERT_DATA)
+    assert isinstance(upd, Update)
+    assert isinstance(upd.prologue, Prologue)
+    assert isinstance(upd.algebra, list)
+    assert len(upd.algebra) == 1
+    assert upd.algebra[0].name == "InsertData"
+
+
+def test_empty_request_container():
+    upd = translateUpdate(parseUpdate(""))
+    assert isinstance(upd, Update)
+    assert isinstance(upd.prologue, Prologue)
+    assert upd.algebra == []
+
+    g = Graph()
+    evalUpdate(g, upd)
+    assert len(g) == 0
+
+
+def test_empty_update_string_is_noop():
+    g = Graph()
+    g.add((URIRef(EX + "a"), URIRef(EX + "p"), Literal("x")))
+
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 1
+
+
+def test_evaluation_does_not_mutate_algebra():
+    upd = prepareUpdate(INSERT_DATA)
+    before = _algebra_snapshot(upd)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(upd)
+    g2.update(upd)
+
+    assert _algebra_snapshot(upd) == before
