diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..d35e406
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,61 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT = """
+    PREFIX ex: <http://example.org/>
+    INSERT DATA { ex:s ex:p "one" . ex:s ex:p "two" . }
+"""
+
+
+def test_prepare_and_update_through_graph():
+    prepared = prepareUpdate(INSERT)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_reuse_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    # INSERT DATA is idempotent
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_init_ns_resolves_prefixes():
+    prepared = prepareUpdate(
+        'INSERT DATA { ex:s ex:p "x" . }',
+        initNs={"ex": "http://example.org/"},
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        Literal("x"),
+    ) in g
+
+
+def test_direct_evaluation_through_evalupdate():
+    prepared = prepareUpdate(INSERT)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_container_shape():
+    prepared = prepareUpdate(INSERT)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
