diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..77aaaa8
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,76 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }
+"""
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_and_apply_through_graph_update(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_DATA)
+
+        g1 = Graph()
+        g1.update(prepared)
+        g2 = Graph()
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        # INSERT DATA is idempotent
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_prefix_resolution(self):
+        prepared = prepareUpdate(
+            "INSERT DATA { ex:s ex:p ex:o . }",
+            initNs={"ex": "urn:ex:"},
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn(
+            (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g
+        )
+
+    def test_init_bindings_visible_to_operations(self):
+        prepared = prepareUpdate(
+            "PREFIX ex: <urn:ex:> INSERT { ?s ex:p ?o } WHERE { }"
+        )
+        g = Graph()
+        g.update(
+            prepared,
+            initBindings={"s": URIRef("urn:ex:s"), "o": Literal("v")},
+        )
+        self.assertIn(
+            (URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("v")), g
+        )
+
+    def test_direct_evaluation(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertIsInstance(prepared.algebra, list)
+        self.assertEqual(len(prepared.algebra), 1)
+        self.assertEqual(prepared.algebra[0].name, "InsertData")
+
+
+if __name__ == "__main__":
+    unittest.main()
