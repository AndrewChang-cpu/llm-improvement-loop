diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..4f73d7d
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,71 @@
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.com/")
+
+INSERT_DATA = """
+    PREFIX ex: <http://example.com/>
+    INSERT DATA {
+        ex:s ex:p "a" .
+        ex:s ex:p "b" .
+    }
+"""
+
+
+def test_prepare_and_update_graph():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_DATA)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated():
+    prepared = prepareUpdate(INSERT_DATA)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+
+    # INSERT DATA is idempotent
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_init_ns():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p 'a' }", initNs={"ex": EX}
+    )
+    g.update(prepared)
+    assert (EX.s, EX.p, Literal("a")) in g
+
+
+def test_prepared_update_init_bindings():
+    g = Graph()
+    prepared = prepareUpdate(
+        "INSERT { ?s ex:p 'a' } WHERE { }",
+        initNs={"ex": EX},
+    )
+    g.update(prepared, initBindings={"s": EX.bound})
+    assert (EX.bound, EX.p, Literal("a")) in g
+
+
+def test_direct_evaluation():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_DATA)
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_update_container_shape():
+    prepared = prepareUpdate(INSERT_DATA)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
