diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..446835e
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,82 @@
+from rdflib import Graph, Literal, Namespace
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.org/")
+
+INSERT_DATA = """
+PREFIX ex: <http://example.org/>
+INSERT DATA { ex:a ex:p "1" . ex:b ex:p "2" . }
+"""
+
+
+def test_prepare_then_update_graph():
+    q = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(q)
+    assert len(g) == 2
+    assert (EX.a, EX.p, Literal("1")) in g
+
+
+def test_reuse_across_graphs_and_repeated_application():
+    q = prepareUpdate(INSERT_DATA)
+
+    g1 = Graph()
+    g1.update(q)
+    g2 = Graph()
+    g2.update(q)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    # INSERT DATA is idempotent
+    g1.update(q)
+    assert len(g1) == 2
+
+
+def test_initns_resolves_prefixes():
+    q = prepareUpdate(
+        'INSERT DATA { ex:a ex:p "1" . }', initNs={"ex": "http://example.org/"}
+    )
+    g = Graph()
+    g.update(q)
+    assert (EX.a, EX.p, Literal("1")) in g
+
+
+def test_initbindings_visible_to_operations():
+    q = prepareUpdate(
+        "INSERT { ?s ex:p ?o } WHERE { }", initNs={"ex": "http://example.org/"}
+    )
+    g = Graph()
+    g.update(q, initBindings={"s": EX.a, "o": Literal("1")})
+    assert (EX.a, EX.p, Literal("1")) in g
+
+
+def test_direct_evaluation():
+    q = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, q)
+    assert len(g) == 2
+
+
+def test_container_shape():
+    q = prepareUpdate(INSERT_DATA)
+    assert isinstance(q, Update)
+    assert isinstance(q.prologue, Prologue)
+    assert isinstance(q.algebra, list)
+    assert len(q.algebra) == 1
+    assert q.algebra[0].name == "InsertData"
+
+
+def test_container_shape_multiple_operations_in_order():
+    q = translateUpdate(
+        parseUpdate(
+            "PREFIX ex: <http://example.org/> "
+            "INSERT DATA { ex:a ex:p ex:b } ; CLEAR DEFAULT"
+        )
+    )
+    assert isinstance(q, Update)
+    assert isinstance(q.prologue, Prologue)
+    assert [op.name for op in q.algebra] == ["InsertData", "Clear"]
