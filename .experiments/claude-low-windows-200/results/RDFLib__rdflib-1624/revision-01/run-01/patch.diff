diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..fc69538
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,81 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_DATA = """
+PREFIX : <urn:ns1:>
+INSERT DATA {
+  :a :p "1" .
+  :b :p "2" .
+}
+"""
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_apply_through_graph_update(self):
+        g = Graph()
+        q = prepareUpdate(INSERT_DATA)
+        g.update(q)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        q = prepareUpdate(INSERT_DATA)
+
+        g1 = Graph()
+        g1.update(q)
+        g2 = Graph()
+        g2.update(q)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        # INSERT DATA is idempotent
+        g1.update(q)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_prefix_resolution(self):
+        q = prepareUpdate(
+            "INSERT DATA { ex:a ex:p ex:b . }",
+            initNs={"ex": "urn:ex:"},
+        )
+        g = Graph()
+        g.update(q)
+        self.assertEqual(
+            set(g),
+            {(URIRef("urn:ex:a"), URIRef("urn:ex:p"), URIRef("urn:ex:b"))},
+        )
+
+    def test_init_bindings_visible_to_operations(self):
+        q = prepareUpdate(
+            "INSERT { ?s <urn:p> ?o } WHERE { }",
+        )
+        g = Graph()
+        g.update(
+            q,
+            initBindings={"s": URIRef("urn:s"), "o": Literal("v")},
+        )
+        self.assertEqual(
+            set(g),
+            {(URIRef("urn:s"), URIRef("urn:p"), Literal("v"))},
+        )
+
+    def test_direct_evaluation(self):
+        q = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        evalUpdate(g, q)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        q = prepareUpdate(INSERT_DATA)
+        self.assertIsInstance(q, Update)
+        self.assertIsInstance(q.prologue, Prologue)
+        self.assertIsInstance(q.algebra, list)
+        self.assertEqual(len(q.algebra), 1)
+        self.assertEqual(q._original_args[0], INSERT_DATA)
+
+
+if __name__ == "__main__":
+    unittest.main()
