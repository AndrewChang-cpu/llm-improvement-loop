diff --git a/test/test_prepared_update.py b/test/test_prepared_update.py
new file mode 100644
index 0000000..1abb551
--- /dev/null
+++ b/test/test_prepared_update.py
@@ -0,0 +1,83 @@
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = Namespace("http://example.com/")
+
+INSERT_TWO = """
+INSERT DATA {
+    <urn:s1> <urn:p> "a" .
+    <urn:s2> <urn:p> "b" .
+}
+"""
+
+
+def test_prepare_then_update_graph():
+    g = Graph()
+    q = prepareUpdate(INSERT_TWO)
+    g.update(q)
+    assert len(g) == 2
+
+
+def test_prepared_reuse_across_graphs_and_repeats():
+    q = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g1.update(q)
+    g2 = Graph()
+    g2.update(q)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    # INSERT DATA is idempotent: applying again leaves the graph unchanged
+    g1.update(q)
+    assert len(g1) == 2
+
+
+def test_prepared_update_initns_prefix_resolution():
+    g = Graph()
+    q = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": EX}
+    )
+    g.update(q)
+    assert (EX["s"], EX["p"], EX["o"]) in g
+    assert len(g) == 1
+
+
+def test_prepared_update_direct_evaluation():
+    g = Graph()
+    q = prepareUpdate(INSERT_TWO)
+    evalUpdate(g, q)
+    assert len(g) == 2
+
+
+def test_prepared_update_initial_bindings():
+    g = Graph()
+    q = prepareUpdate("INSERT { ?s <urn:p> ?o } WHERE { }")
+    g.update(
+        q,
+        initBindings={
+            "s": URIRef("urn:subject"),
+            "o": Literal("value"),
+        },
+    )
+    assert (URIRef("urn:subject"), URIRef("urn:p"), Literal("value")) in g
+
+
+def test_update_container_shape():
+    q = prepareUpdate(INSERT_TWO)
+    assert isinstance(q, Update)
+    assert isinstance(q.prologue, Prologue)
+    assert isinstance(q.algebra, list)
+    assert len(q.algebra) == 1
+    assert q.algebra[0].name == "InsertData"
+
+
+def test_update_container_one_entry_per_operation():
+    q = prepareUpdate(
+        "INSERT DATA { <urn:a> <urn:p> <urn:b> } ; "
+        "INSERT DATA { <urn:c> <urn:p> <urn:d> }"
+    )
+    assert len(q.algebra) == 2
+    assert [op.name for op in q.algebra] == ["InsertData", "InsertData"]
