diff --git a/test/test_sparql_prepare_update.py b/test/test_sparql_prepare_update.py
new file mode 100644
index 0000000..6b2f2e3
--- /dev/null
+++ b/test/test_sparql_prepare_update.py
@@ -0,0 +1,95 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA { ex:s ex:p ex:o . ex:s ex:p2 "v" . }
+"""
+
+INSERT_PREFIXED = """
+INSERT DATA { ex:s ex:p ex:o . }
+"""
+
+
+class TestPrepareUpdate(unittest.TestCase):
+    def test_prepare_then_apply_via_graph_update(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_DATA)
+
+        g1 = Graph()
+        g1.update(prepared)
+        g2 = Graph()
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        self.assertEqual(set(g1), set(g2))
+
+        # INSERT DATA is idempotent
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_initns_prefix_resolution(self):
+        prepared = prepareUpdate(
+            INSERT_PREFIXED, initNs={"ex": URIRef("urn:ex:")}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn(
+            (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g
+        )
+
+    def test_init_bindings_visible_to_operations(self):
+        prepared = prepareUpdate(
+            "INSERT { ?s <urn:ex:p> ?o } WHERE { }"
+        )
+        g = Graph()
+        g.update(
+            prepared,
+            initBindings={"s": URIRef("urn:ex:s"), "o": Literal("x")},
+        )
+        self.assertIn(
+            (URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("x")), g
+        )
+
+    def test_direct_evaluation_with_evalupdate(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        # Must not raise a "not iterable" error
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertIsInstance(prepared.algebra, list)
+        self.assertEqual(len(prepared.algebra), 1)
+        self.assertEqual(prepared._original_args[0], INSERT_DATA)
+
+    def test_translate_returns_container_with_one_entry_per_operation(self):
+        req = translateUpdate(
+            parseUpdate(
+                "INSERT DATA { <urn:a> <urn:b> <urn:c> } ; "
+                "INSERT DATA { <urn:d> <urn:e> <urn:f> }"
+            )
+        )
+        self.assertIsInstance(req, Update)
+        self.assertIsInstance(req.prologue, Prologue)
+        self.assertEqual(len(req.algebra), 2)
+        self.assertEqual([u.name for u in req.algebra], ["InsertData", "InsertData"])
+
+
+if __name__ == "__main__":
+    unittest.main()
