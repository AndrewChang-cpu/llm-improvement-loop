diff --git a/test/test_prepared_update.py b/test/test_prepared_update.py
new file mode 100644
index 0000000..83404e0
--- /dev/null
+++ b/test/test_prepared_update.py
@@ -0,0 +1,102 @@
+import unittest
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA {
+    ex:s1 ex:p ex:o1 .
+    ex:s2 ex:p ex:o2 .
+}
+"""
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_and_apply_through_graph_update(self):
+        g = Graph()
+        prepared = prepareUpdate(INSERT_DATA)
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs_and_repeated_application(self):
+        prepared = prepareUpdate(INSERT_DATA)
+
+        g1 = Graph()
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+        g2 = Graph()
+        g2.update(prepared)
+        self.assertEqual(len(g2), 2)
+
+        # INSERT DATA is idempotent, so a second application changes nothing
+        g1.update(prepared)
+        self.assertEqual(len(g1), 2)
+
+    def test_init_ns_resolves_prefixes(self):
+        prepared = prepareUpdate(
+            "INSERT DATA { ex:s ex:p ex:o . }",
+            initNs={"ex": URIRef("urn:ex:")},
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 1)
+        self.assertIn(
+            (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g
+        )
+
+    def test_direct_evaluation_through_evalupdate(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_init_bindings_are_visible_to_operations(self):
+        prepared = prepareUpdate(
+            "PREFIX ex: <urn:ex:> INSERT { ?s ex:p ?o } WHERE { }"
+        )
+        g = Graph()
+        g.update(
+            prepared,
+            initBindings={
+                "s": URIRef("urn:ex:subj"),
+                "o": URIRef("urn:ex:obj"),
+            },
+        )
+        self.assertIn(
+            (URIRef("urn:ex:subj"), URIRef("urn:ex:p"), URIRef("urn:ex:obj")), g
+        )
+
+    def test_container_shape(self):
+        request = """
+        PREFIX ex: <urn:ex:>
+        INSERT DATA { ex:s ex:p ex:o . } ;
+        INSERT DATA { ex:s2 ex:p ex:o2 . }
+        """
+        prepared = translateUpdate(parseUpdate(request))
+
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertIsInstance(prepared.algebra, list)
+        self.assertEqual(len(prepared.algebra), 2)
+        self.assertEqual(
+            [u.name for u in prepared.algebra], ["InsertData", "InsertData"]
+        )
+
+    def test_prepared_update_is_reusable_without_mutation(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        before = list(prepared.algebra)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(prepared.algebra, before)
+        self.assertEqual(len(prepared.algebra), 1)
+
+
+if __name__ == "__main__":
+    unittest.main()
