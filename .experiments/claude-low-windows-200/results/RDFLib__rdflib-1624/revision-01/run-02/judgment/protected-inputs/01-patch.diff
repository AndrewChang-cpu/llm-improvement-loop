diff --git a/test/test_sparql_prepared_update.py b/test/test_sparql_prepared_update.py
new file mode 100644
index 0000000..660ef95
--- /dev/null
+++ b/test/test_sparql_prepared_update.py
@@ -0,0 +1,107 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA {
+    ex:s ex:p "a" .
+    ex:s ex:p "b" .
+}
+"""
+
+INSERT_DATA_INITNS = """
+INSERT DATA {
+    ex:s ex:p "a" .
+    ex:s ex:p "b" .
+}
+"""
+
+
+class TestPreparedUpdate(unittest.TestCase):
+    def test_prepare_then_update(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_reuse_across_graphs(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(prepared)
+        g2.update(prepared)
+        self.assertEqual(len(g1), 2)
+        self.assertEqual(len(g2), 2)
+        self.assertEqual(set(g1), set(g2))
+
+    def test_repeated_application_is_idempotent(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        g.update(prepared)
+        g.update(prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_initns_resolves_prefixes(self):
+        prepared = prepareUpdate(
+            INSERT_DATA_INITNS, initNs={"ex": "urn:ex:"}
+        )
+        g = Graph()
+        g.update(prepared)
+        self.assertIn(
+            (URIRef("urn:ex:s"), URIRef("urn:ex:p"), Literal("a")), g
+        )
+        self.assertEqual(len(g), 2)
+
+    def test_init_bindings_are_visible(self):
+        prepared = prepareUpdate(
+            "INSERT { ?s <urn:ex:p> <urn:ex:o> } WHERE {}"
+        )
+        g = Graph()
+        g.update(prepared, initBindings={"s": URIRef("urn:ex:subj")})
+        self.assertIn(
+            (URIRef("urn:ex:subj"), URIRef("urn:ex:p"), URIRef("urn:ex:o")), g
+        )
+
+    def test_direct_evaluation(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        g = Graph()
+        evalUpdate(g, prepared)
+        self.assertEqual(len(g), 2)
+
+    def test_container_shape(self):
+        prepared = prepareUpdate(INSERT_DATA)
+        self.assertIsInstance(prepared, Update)
+        self.assertIsInstance(prepared.prologue, Prologue)
+        self.assertIsInstance(prepared.algebra, list)
+        self.assertEqual(len(prepared.algebra), 1)
+        self.assertEqual(prepared.algebra[0].name, "InsertData")
+
+    def test_translate_returns_container(self):
+        translated = translateUpdate(parseUpdate(INSERT_DATA))
+        self.assertIsInstance(translated, Update)
+        self.assertIsInstance(translated.prologue, Prologue)
+        self.assertEqual(len(translated.algebra), 1)
+
+    def test_original_args_recorded(self):
+        prepared = prepareUpdate(INSERT_DATA, initNs={"ex": "urn:ex:"}, base=None)
+        self.assertEqual(
+            prepared._original_args, (INSERT_DATA, {"ex": "urn:ex:"}, None)
+        )
+
+    def test_empty_update_does_not_raise(self):
+        prepared = prepareUpdate("")
+        g = Graph()
+        evalUpdate(g, prepared)
+        g.update(prepared)
+        self.assertEqual(len(g), 0)
+
+
+if __name__ == "__main__":
+    unittest.main()
