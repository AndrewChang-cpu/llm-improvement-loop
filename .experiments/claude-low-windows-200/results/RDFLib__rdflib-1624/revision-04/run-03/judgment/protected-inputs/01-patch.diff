diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..4350295
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,117 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.org/"
+
+INSERT_DATA = """
+PREFIX ex: <http://example.org/>
+INSERT DATA {
+    ex:s ex:p ex:o1 .
+    ex:s ex:p ex:o2 .
+}
+"""
+
+INSERT_DATA_NO_PREFIX = """
+INSERT DATA {
+    ex:s ex:p ex:o1 .
+    ex:s ex:p ex:o2 .
+}
+"""
+
+INSERT_WITH_BINDING = """
+INSERT { ?s <http://example.org/p> <http://example.org/o> } WHERE { }
+"""
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepared_update_applied_with_graph_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_applied_to_two_graphs_gives_same_result():
+    prepared = prepareUpdate(INSERT_DATA)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_applied_twice_to_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepare_update_init_ns_resolves_prefixes_in_update():
+    prepared = prepareUpdate(INSERT_DATA_NO_PREFIX, initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o1")) in g
+
+
+def test_prepared_update_init_bindings_are_visible_to_operations():
+    prepared = prepareUpdate(INSERT_WITH_BINDING)
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef(EX + "subject")})
+    assert (URIRef(EX + "subject"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_passed_directly_to_evaluation_applies_without_error():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_has_prologue_and_algebra_for_operations():
+    prepared = prepareUpdate(INSERT_DATA)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    assert _snapshot(prepared) == before
+
+
+def test_empty_request_prepares_to_update_with_empty_algebra():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <http://example.org/>")
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "s") == URIRef(EX + "s")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
