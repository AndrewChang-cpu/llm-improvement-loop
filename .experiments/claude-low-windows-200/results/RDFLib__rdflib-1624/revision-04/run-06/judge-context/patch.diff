diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..333d559
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,107 @@
+import unittest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s1> <urn:p> <urn:o1> .
+  <urn:s2> <urn:p> <urn:o2> .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+class TestPrepareUpdate(unittest.TestCase):
+    def test_prepared_update_inserts_triples_through_graph_update(self):
+        g = Graph()
+        g.update(prepareUpdate(INSERT_TWO))
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_gives_same_result_on_second_graph(self):
+        pu = prepareUpdate(INSERT_TWO)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(pu)
+        g2.update(pu)
+        self.assertEqual(set(g1), set(g2))
+        self.assertEqual(len(g2), 2)
+
+    def test_prepared_update_applied_twice_is_idempotent(self):
+        pu = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        g.update(pu)
+        g.update(pu)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_does_not_mutate_algebra_on_reuse(self):
+        pu = prepareUpdate(INSERT_TWO)
+        before = _snapshot(pu)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(pu)
+        g2.update(pu)
+        g1.update(pu)
+        self.assertEqual(_snapshot(pu), before)
+
+    def test_init_ns_prefixes_resolve_inside_prepared_update(self):
+        pu = prepareUpdate("INSERT DATA { ex:s ex:p ex:o }", initNs={"ex": "urn:ex:"})
+        g = Graph()
+        g.update(pu)
+        self.assertEqual(
+            set(g), {(URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o"))}
+        )
+
+    def test_init_bindings_are_visible_to_prepared_update_operations(self):
+        pu = prepareUpdate("INSERT { ?s <urn:p> ?o } WHERE { }")
+        g = Graph()
+        g.update(pu, initBindings={"s": URIRef("urn:s"), "o": Literal("x")})
+        self.assertEqual(set(g), {(URIRef("urn:s"), URIRef("urn:p"), Literal("x"))})
+
+    def test_direct_evaluation_applies_prepared_update_without_error(self):
+        pu = prepareUpdate(INSERT_TWO)
+        g = Graph()
+        evalUpdate(g, pu)
+        self.assertEqual(len(g), 2)
+
+    def test_translated_non_empty_request_returns_update_container(self):
+        text = (
+            "PREFIX ex: <urn:ex:> INSERT DATA { ex:s ex:p ex:o } ; "
+            "INSERT DATA { <urn:s> <urn:p> <urn:o> }"
+        )
+        pu = translateUpdate(parseUpdate(text))
+        self.assertIsInstance(pu, Update)
+        self.assertIsInstance(pu.prologue, Prologue)
+        self.assertEqual(len(pu.algebra), 2)
+        self.assertEqual([op.name for op in pu.algebra], ["InsertData", "InsertData"])
+
+    def test_empty_request_yields_empty_algebra_and_evaluates_cleanly(self):
+        pu = prepareUpdate("")
+        self.assertIsInstance(pu, Update)
+        self.assertIsInstance(pu.prologue, Prologue)
+        self.assertEqual(pu.algebra, [])
+        g = Graph()
+        evalUpdate(g, pu)
+        self.assertEqual(len(g), 0)
+
+    def test_declarations_only_request_binds_prefix_in_prologue(self):
+        pu = prepareUpdate("PREFIX ex: <urn:ex:>")
+        self.assertIsInstance(pu.prologue, Prologue)
+        self.assertEqual(pu.algebra, [])
+        self.assertEqual(pu.prologue.resolvePName("ex", "x"), URIRef("urn:ex:x"))
+        g = Graph()
+        evalUpdate(g, pu)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_leaves_graph_unchanged(self):
+        g = Graph()
+        g.update("")
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
