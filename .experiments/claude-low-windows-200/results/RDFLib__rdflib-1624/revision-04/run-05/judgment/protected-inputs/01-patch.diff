diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..559b78d
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,118 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_TWO = 'INSERT DATA { <urn:s> <urn:p> "a" . <urn:s> <urn:p> "b" . }'
+
+
+def operation_snapshot(update):
+    return [(op.name, str(op).splitlines()) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    g = Graph()
+    prepared = prepareUpdate(INSERT_TWO)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p 'a' }", initNs={"ex": "http://example.org/"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (
+        URIRef("http://example.org/s"),
+        URIRef("http://example.org/p"),
+        Literal("a"),
+    ) in g
+
+
+def test_prepared_update_passed_directly_to_evalupdate_inserts_triples():
+    g = Graph()
+    evalUpdate(g, prepareUpdate(INSERT_TWO))
+    assert len(g) == 2
+
+
+def test_prepared_update_initial_bindings_are_visible_to_operations():
+    g = Graph()
+    prepared = prepareUpdate("INSERT { ?s <urn:p> 'x' } WHERE { }")
+    g.update(prepared, initBindings={"s": URIRef("urn:s")})
+    assert (URIRef("urn:s"), URIRef("urn:p"), Literal("x")) in g
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = operation_snapshot(prepared)
+    g = Graph()
+    evalUpdate(g, prepared)
+    g.update(prepared)
+    assert operation_snapshot(prepared) == before
+    assert len(prepared.algebra) == 1
+
+
+def test_non_empty_request_translates_to_update_container():
+    update = translateUpdate(
+        parseUpdate(
+            'INSERT DATA { <urn:s> <urn:p> "a" } ; '
+            'INSERT DATA { <urn:s> <urn:p> "b" }'
+        )
+    )
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert len(update.algebra) == 2
+    assert [op.name for op in update.algebra] == ["InsertData", "InsertData"]
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    update = translateUpdate(parseUpdate(""))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue():
+    update = translateUpdate(parseUpdate("PREFIX ex: <http://example.org/>"))
+    assert isinstance(update, Update)
+    assert isinstance(update.prologue, Prologue)
+    assert update.algebra == []
+    assert update.prologue.resolvePName("ex", "s") == URIRef("http://example.org/s")
+
+    g = Graph()
+    evalUpdate(g, update)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_process_update_leaves_graph_unchanged():
+    g = Graph()
+    processUpdate(g, "")
+    assert len(g) == 0
