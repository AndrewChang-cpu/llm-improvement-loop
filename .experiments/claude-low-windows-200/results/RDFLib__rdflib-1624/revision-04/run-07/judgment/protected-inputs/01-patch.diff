diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..4f57108
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,128 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.com/"
+
+INSERT_TWO = (
+    "PREFIX ex: <http://example.com/> "
+    'INSERT DATA { ex:s ex:p "a" . ex:s ex:p "b" . }'
+)
+
+INSERT_THEN_DELETE = (
+    "PREFIX ex: <http://example.com/> "
+    "INSERT DATA { ex:s ex:p ex:o . } ; "
+    "DELETE DATA { ex:s ex:p ex:o . }"
+)
+
+
+def _algebra_snapshot(prepared):
+    return [[op.name, str(op)] for op in prepared.algebra]
+
+
+def test_prepare_update_then_apply_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    assert set(g1) == set(g2)
+    assert len(g2) == 2
+
+
+def test_prepared_update_repeated_on_one_graph_is_idempotent():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepare_update_init_ns_resolves_prefix():
+    prepared = prepareUpdate("INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepare_update_passes_initial_bindings_to_operations():
+    prepared = prepareUpdate(
+        "PREFIX ex: <http://example.com/> "
+        "INSERT { ?s ex:p ?o . } WHERE { }"
+    )
+    g = Graph()
+    g.update(
+        prepared,
+        initBindings={"s": URIRef(EX + "s"), "o": URIRef(EX + "o")},
+    )
+    assert (URIRef(EX + "s"), URIRef(EX + "p"), URIRef(EX + "o")) in g
+
+
+def test_prepared_update_direct_evaluation_applies_operations():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared, {})
+    assert len(g) == 2
+
+
+def test_translated_update_container_has_prologue_and_algebra():
+    prepared = translateUpdate(parseUpdate(INSERT_THEN_DELETE))
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert [op.name for op in prepared.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_THEN_DELETE)
+    before = _algebra_snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_empty_request_translates_to_update_with_empty_algebra():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+
+def test_empty_request_prepared_update_applies_without_error():
+    prepared = prepareUpdate("")
+    g = Graph()
+    g.update(prepared)
+    evalUpdate(g, prepared, {})
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix():
+    prepared = prepareUpdate("PREFIX ex: <http://example.com/>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    ns = prepared.prologue.namespace_manager.store.namespace("ex")
+    assert ns == URIRef(EX)
+
+
+def test_declarations_only_request_leaves_graph_unchanged():
+    prepared = prepareUpdate("PREFIX ex: <http://example.com/>")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
