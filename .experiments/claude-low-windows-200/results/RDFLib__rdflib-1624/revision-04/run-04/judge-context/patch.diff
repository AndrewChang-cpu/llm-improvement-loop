diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..60d695e
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,100 @@
+from rdflib import Graph, Literal, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+
+INSERT_DATA = """
+PREFIX ex: <urn:ex:>
+INSERT DATA {
+    ex:a ex:p "one" .
+    ex:b ex:p "two" .
+}
+"""
+
+
+def _snapshot(update):
+    return [[op.name, str(op)] for op in update.algebra]
+
+
+def test_prepare_then_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_DATA)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:a ex:p 'one' . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), Literal("one")) in g
+
+
+def test_prepared_update_sees_init_bindings():
+    prepared = prepareUpdate("INSERT { <urn:ex:a> <urn:ex:p> ?v } WHERE { }")
+    g = Graph()
+    g.update(prepared, initBindings={"v": Literal("bound")})
+    assert (URIRef("urn:ex:a"), URIRef("urn:ex:p"), Literal("bound")) in g
+
+
+def test_prepared_update_direct_evaluation_does_not_raise():
+    prepared = prepareUpdate(INSERT_DATA)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_container_shape_for_non_empty_request():
+    prepared = prepareUpdate(INSERT_DATA)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_prepared_update_algebra_not_mutated_by_evaluation():
+    prepared = prepareUpdate(INSERT_DATA)
+    before = _snapshot(prepared)
+    Graph().update(prepared)
+    assert _snapshot(prepared) == before
+
+
+def test_prepared_empty_request_has_empty_algebra():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    Graph().update(prepared)
+
+
+def test_prepared_declarations_only_request_binds_prefixes():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(prepared, Update)
+    assert prepared.algebra == []
+    assert prepared.prologue.resolvePName("ex", "a") == URIRef("urn:ex:a")
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
