diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..0e669d2
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,103 @@
+from typing import List, Tuple
+
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate
+from rdflib.plugins.sparql.processor import processUpdate
+from rdflib.plugins.sparql.sparql import Prologue
+from rdflib.plugins.sparql.update import evalUpdate
+import unittest
+
+TWO_INSERTS = (
+    "INSERT DATA { <urn:s> <urn:p> <urn:o1> } ; "
+    "INSERT DATA { <urn:s> <urn:p> <urn:o2> }"
+)
+
+
+def algebra_snapshot(update) -> List[Tuple[str, List[str]]]:
+    return [(op.name, [str(op)]) for op in update.algebra]
+
+
+class SPARQLPrepareTests(unittest.TestCase):
+    def test_prepared_update_applied_with_graph_update_inserts_triples(self) -> None:
+        q = prepareUpdate(TWO_INSERTS)
+        g = Graph()
+        g.update(q)
+        self.assertEqual(len(g), 2)
+
+    def test_prepared_update_applies_to_second_graph_with_same_result(self) -> None:
+        q = prepareUpdate(TWO_INSERTS)
+        g1 = Graph()
+        g2 = Graph()
+        g1.update(q)
+        g2.update(q)
+        self.assertEqual(len(g2), 2)
+        self.assertEqual(set(g1), set(g2))
+
+    def test_prepared_update_repeated_on_one_graph_is_idempotent(self) -> None:
+        q = prepareUpdate(TWO_INSERTS)
+        g = Graph()
+        g.update(q)
+        g.update(q)
+        self.assertEqual(len(g), 2)
+
+    def test_init_ns_prefixes_resolve_inside_prepared_update(self) -> None:
+        q = prepareUpdate(
+            "INSERT DATA { ex:s ex:p ex:o }",
+            initNs={"ex": "http://example.org/"},
+        )
+        g = Graph()
+        g.update(q)
+        self.assertIn(
+            (
+                URIRef("http://example.org/s"),
+                URIRef("http://example.org/p"),
+                URIRef("http://example.org/o"),
+            ),
+            g,
+        )
+
+    def test_prepared_update_passed_to_evalupdate_applies_without_error(self) -> None:
+        q = prepareUpdate(TWO_INSERTS)
+        g = Graph()
+        evalUpdate(g, q)
+        self.assertEqual(len(g), 2)
+
+    def test_evaluation_does_not_mutate_prepared_algebra(self) -> None:
+        q = prepareUpdate(TWO_INSERTS)
+        before = algebra_snapshot(q)
+        evalUpdate(Graph(), q)
+        self.assertEqual(before, algebra_snapshot(q))
+
+    def test_non_empty_request_container_has_prologue_and_algebra(self) -> None:
+        q = prepareUpdate(TWO_INSERTS)
+        self.assertIsInstance(q.prologue, Prologue)
+        self.assertEqual(len(q.algebra), 2)
+        self.assertEqual([op.name for op in q.algebra], ["InsertData", "InsertData"])
+
+    def test_empty_request_prepares_container_with_empty_algebra(self) -> None:
+        q = prepareUpdate("")
+        self.assertIsInstance(q.prologue, Prologue)
+        self.assertEqual(q.algebra, [])
+        evalUpdate(Graph(), q)
+
+    def test_declarations_only_request_binds_prefix_in_prologue(self) -> None:
+        q = prepareUpdate("PREFIX ex: <http://example.org/>")
+        self.assertIsInstance(q.prologue, Prologue)
+        self.assertEqual(q.algebra, [])
+        self.assertEqual(
+            q.prologue.resolvePName("ex", "x"), URIRef("http://example.org/x")
+        )
+        g = Graph()
+        evalUpdate(g, q)
+        self.assertEqual(len(g), 0)
+
+    def test_empty_update_string_leaves_graph_unchanged(self) -> None:
+        g = Graph()
+        g.update("")
+        processUpdate(g, "")
+        self.assertEqual(len(g), 0)
+
+
+if __name__ == "__main__":
+
+    unittest.main()
