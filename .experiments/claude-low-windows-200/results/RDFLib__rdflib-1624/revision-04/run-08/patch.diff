diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..b4e6ebc
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,108 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.algebra import translateUpdate
+from rdflib.plugins.sparql.parser import parseUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+INSERT_TWO = """
+INSERT DATA {
+  <urn:s> <urn:p> <urn:o> .
+  <urn:s> <urn:p> <urn:o2> .
+}
+"""
+
+DELETE_ONE = "DELETE DATA { <urn:s> <urn:p> <urn:o> }"
+
+INSERT_THEN_DELETE = INSERT_TWO + "; " + DELETE_ONE
+
+
+def _algebra_snapshot(update):
+    return [(op.name, str(op)) for op in update.algebra]
+
+
+def test_prepared_update_applied_through_graph_update_inserts_triples():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    g1 = Graph()
+    g2 = Graph()
+    g1.update(prepared)
+    g2.update(prepared)
+    g1.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+
+def test_prepared_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate(
+        "INSERT DATA { ex:s ex:p ex:o . }", initNs={"ex": "urn:ex:"}
+    )
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef("urn:ex:s"), URIRef("urn:ex:p"), URIRef("urn:ex:o")) in g
+
+
+def test_prepared_update_passed_directly_to_evalUpdate_applies_operations():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_initial_bindings_visible_to_prepared_update_operations():
+    prepared = prepareUpdate("INSERT { ?s <urn:p> <urn:o> } WHERE { }")
+    g = Graph()
+    g.update(prepared, initBindings={"s": URIRef("urn:bound")})
+    assert (URIRef("urn:bound"), URIRef("urn:p"), URIRef("urn:o")) in g
+
+
+def test_prepared_update_evaluation_does_not_mutate_algebra():
+    prepared = prepareUpdate(INSERT_THEN_DELETE)
+    before = _algebra_snapshot(prepared)
+    g = Graph()
+    g.update(prepared)
+    g.update(prepared)
+    assert _algebra_snapshot(prepared) == before
+
+
+def test_non_empty_request_translates_to_update_container_shape():
+    u = translateUpdate(parseUpdate(INSERT_THEN_DELETE))
+    assert isinstance(u, Update)
+    assert isinstance(u.prologue, Prologue)
+    assert [op.name for op in u.algebra] == ["InsertData", "DeleteData"]
+
+
+def test_empty_request_prepares_update_with_empty_algebra():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_declared_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <urn:ex:>")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    namespaces = dict(prepared.prologue.namespace_manager.namespaces())
+    assert namespaces["ex"] == URIRef("urn:ex:")
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_leaves_graph_unchanged():
+    g = Graph()
+    g.update("")
+    processUpdate(g, "")
+    assert len(g) == 0
