diff --git a/test/test_sparql_prepare.py b/test/test_sparql_prepare.py
new file mode 100644
index 0000000..d6c29c0
--- /dev/null
+++ b/test/test_sparql_prepare.py
@@ -0,0 +1,95 @@
+from rdflib import Graph, URIRef
+from rdflib.plugins.sparql import prepareUpdate, processUpdate
+from rdflib.plugins.sparql.sparql import Prologue, Update
+from rdflib.plugins.sparql.update import evalUpdate
+
+EX = "http://example.com/"
+
+INSERT_TWO = """
+PREFIX ex: <http://example.com/>
+INSERT DATA { ex:a ex:b ex:c . ex:d ex:e ex:f . }
+"""
+
+
+def _snapshot(update):
+    return [(op.name, [str(op)]) for op in update.algebra]
+
+
+def test_prepare_then_apply_through_graph_update():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    g.update(prepared)
+    assert len(g) == 2
+
+
+def test_prepared_update_reused_across_graphs_and_repeated_application():
+    prepared = prepareUpdate(INSERT_TWO)
+    before = _snapshot(prepared)
+
+    g1 = Graph()
+    g1.update(prepared)
+    g2 = Graph()
+    g2.update(prepared)
+    assert len(g1) == 2
+    assert len(g2) == 2
+    assert set(g1) == set(g2)
+
+    g1.update(prepared)
+    assert len(g1) == 2
+
+    assert _snapshot(prepared) == before
+
+
+def test_prepare_update_resolves_init_ns_prefixes():
+    prepared = prepareUpdate("INSERT DATA { ex:a ex:b ex:c . }", initNs={"ex": EX})
+    g = Graph()
+    g.update(prepared)
+    assert (URIRef(EX + "a"), URIRef(EX + "b"), URIRef(EX + "c")) in g
+
+
+def test_evaluate_prepared_update_directly():
+    prepared = prepareUpdate(INSERT_TWO)
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 2
+
+
+def test_non_empty_request_returns_update_container():
+    prepared = prepareUpdate(INSERT_TWO)
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert isinstance(prepared.algebra, list)
+    assert len(prepared.algebra) == 1
+    assert prepared.algebra[0].name == "InsertData"
+
+
+def test_empty_request_returns_update_with_empty_algebra():
+    prepared = prepareUpdate("")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_declarations_only_request_binds_prefix_in_prologue():
+    prepared = prepareUpdate("PREFIX ex: <http://example.com/>")
+    assert isinstance(prepared, Update)
+    assert isinstance(prepared.prologue, Prologue)
+    assert prepared.algebra == []
+    assert prepared.prologue.namespace_manager.store.namespace("ex") == URIRef(EX)
+
+    g = Graph()
+    evalUpdate(g, prepared)
+    assert len(g) == 0
+
+
+def test_empty_update_string_through_graph_update_and_process_update_is_noop():
+    g = Graph()
+    g.update("")
+    assert len(g) == 0
+
+    processUpdate(g, "")
+    assert len(g) == 0
