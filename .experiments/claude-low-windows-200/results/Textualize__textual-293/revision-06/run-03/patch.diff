@@ -0,0 +1,167 @@
+import io
+
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def make_renderable(tabs, active=None, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def rendered_rows(renderable, width=100):
+    console = Console(width=width, file=io.StringIO(), color_system=None)
+    segments = console.render(renderable, console.options)
+    return "".join(segment.text for segment in segments).split("\n")
+
+
+def rendered_segments(renderable, width=100):
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def test_default_construction_with_tabs():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+
+
+def test_default_construction_with_no_tabs():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs._bar_position == 0.0
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert Tab("Home", "h").name == "h"
+    assert str(Tab("Home", "h")) == "Home"
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "h")
+
+
+def test_initial_active_tab_is_given_tab():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_keeps_name_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("B") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_activate_tab_by_first_char_skips_active_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_other_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_label_row_with_fixed_padding():
+    tabs = [Tab("Home"), Tab("Docs")]
+    rows = rendered_rows(make_renderable(tabs, "Home", tab_padding=1))
+    assert rows[0] == " Home  Docs "
+
+
+def test_label_row_auto_fit_shares_flexible_cells_evenly():
+    # Two one-cell labels leave 8 flexible cells for four padding edges, two each.
+    rows = rendered_rows(make_renderable([Tab("A"), Tab("B")], "A"), width=10)
+    assert rows[0] == "  A    B  "
+
+
+def test_label_row_with_no_tabs_is_empty_and_bar_is_full_width():
+    rows = rendered_rows(make_renderable([]), width=10)
+    assert rows == ["", "━" * 10]
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("Home", "x"), Tab("Docs"), Tab("Home2", "x")]
+    rows = rendered_rows(make_renderable(tabs, "x", tab_padding=1))
+    assert rows[0] == " Home2  Docs "
+
+
+def test_bar_highlights_under_active_tab():
+    rows = rendered_rows(
+        make_renderable([Tab("A"), Tab("B")], "B", bar_position=1.0, tab_padding=1),
+        width=10,
+    )
+    bar = rows[1]
+    assert bar[3] == "╸"
+    assert bar[4] == "━"
+    assert bar[5] == "╺"
+
+
+def test_inactive_label_carries_click_action_and_active_does_not():
+    segments = rendered_segments(
+        make_renderable([Tab("A"), Tab("B")], "B", tab_padding=1)
+    )
+    inactive = [segment for segment in segments if segment.text == " A "]
+    active = [segment for segment in segments if segment.text == " B "]
+    assert len(inactive) == 1 and len(active) == 1
+    assert isinstance(inactive[0].style, Style)
+    assert inactive[0].style.meta == {"@click": "range_clicked('A')"}
+    assert isinstance(active[0].style, Style)
+    assert "@click" not in active[0].style.meta
