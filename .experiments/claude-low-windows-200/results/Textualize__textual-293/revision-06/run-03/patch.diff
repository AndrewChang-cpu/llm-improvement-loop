diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..94ce07c
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,403 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import LayoutEdge, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A label and a name pair for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab when selecting it. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> dict[str, str]:
+    """Map each distinct tab name to its label.
+
+    A name keeps the position of its first tab, and takes the label of its last tab.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+
+    Returns:
+        dict[str, str]: Tab names in display order, mapped to their labels.
+    """
+    return {tab.name: tab.label for tab in tabs}
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or None when there are no tabs.
+        bar_position (float): The fractional index of the bar into the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's label.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of the inactive tabs' labels.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int | None): The fixed padding on each side of a label, or None to fit the width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = list(_displayed_tabs(self.tabs).items())
+
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        padding = self.tab_padding or None
+        edges: list[LayoutEdge] = []
+        for _name, label in displayed:
+            edges.append(LayoutEdge(size=padding))
+            edges.append(LayoutEdge(size=cell_len(label)))
+            edges.append(LayoutEdge(size=padding))
+        sizes = layout_resolve(width, edges)
+
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        cursor = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+
+            label_ranges.append((label_start, label_end))
+            selection_ranges[name] = (cursor, selection_end)
+
+            padded = (
+                " " * left
+                + label
+                + " " * (label_width - cell_len(label))
+                + " " * right
+            )
+            if name == self.active_tab_name:
+                yield Text(
+                    padded,
+                    style=active_tab_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+            else:
+                span = Text(
+                    padded,
+                    style=inactive_tab_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+                span.apply_meta(
+                    {"@click": f"range_clicked('{name}')"}, 0, len(padded)
+                )
+                yield Opacity(span, opacity=self.inactive_text_opacity)
+            cursor = selection_end
+
+        yield Segment("\n")
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (list[tuple[int, int]]): The label range of each displayed tab.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        floor_index = int(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+        start_a, end_a = label_ranges[floor_index]
+        start_b, end_b = label_ranges[next_index]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    The tab row occupies two rows. The first holds the tab labels and the second holds the
+    underline. A tab is selected with the Left and Right keys, with a digit key, with a first
+    character search, or with a mouse click.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. Tabs may share a name, in which case
+            only the first position is displayed, with the label of the last tab that has the name.
+        active_tab (str, optional): The name of the tab that starts active. Defaults to the name of
+            the first tab. An unknown name is accepted, and the underline then sits under the first tab.
+        active_tab_style (StyleType): The style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the underline under the active tab. Defaults to
+            ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of the inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the underline outside the active tab. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels, where 1.0 is fully
+            visible and 0.0 takes the background color. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline animation. Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the underline animation.
+            Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label. ``None`` (or zero)
+            fits the padding to the width. Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates the next tab whose
+            label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the position of a tab name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed position, or 0 when the name is not displayed.
+        """
+        names = list(_displayed_tabs(self.tabs))
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list, or 0 when no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab, after the active one, whose label starts with a character.
+
+        The search wraps, is case-insensitive, and never selects the active tab. If no other tab
+        matches, the active tab does not change.
+
+        Args:
+            char (str): The character to search for.
+        """
+        search = char.lower()
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(search):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based number.
+
+        A number greater than the tab count is ignored. The number 0 activates the 10th tab when
+        there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Run when a tab's clickable range is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed position of the new active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the new active tab.
+        """
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        Every key press is marked handled, and it is not stopped from propagating, so application
+        bindings still receive it. With no tabs, nothing else happens. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next and previous tab, wrapping at either end.
+        - The digit keys 1 to 9 activate the tab at that position. The 0 key follows the rule of
+          ``activate_tab_by_number``. Other digits are ignored.
+        - Any other single character activates the next tab whose label starts with it, when
+          ``search_by_first_character`` is True.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
