+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows Tabs widgets with and without padding."""
+
+    def on_mount(self):
+        """Mount the example Tabs widgets directly on the app."""
+        tabs = [
+            Tab("Home"),
+            Tab("Files", "files"),
+            Tab("Search"),
+            Tab("Settings", "settings"),
+        ]
+        self.mount(
+            fitted=Tabs(tabs, active_tab="files"),
+            padded=Tabs(tabs, tab_padding=3),
+            empty=Tabs([]),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
