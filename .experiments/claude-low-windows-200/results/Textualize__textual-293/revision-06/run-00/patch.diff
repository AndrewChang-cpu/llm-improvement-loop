diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..4cc87eb
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,466 @@
+from __future__ import annotations
+
+from math import floor
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab of a Tabs widget, pairing a display label with a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of flexible space this edge takes. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Compute the tabs to render: one per distinct name.
+
+    Each displayed tab takes the position of the first tab with its name and the
+    label of the last tab with that name.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The displayed tabs, in display order.
+    """
+    positions: Dict[str, int] = {}
+    displayed: List[Tab] = []
+    for tab in tabs:
+        if tab.name in positions:
+            displayed[positions[tab.name]] = tab
+        else:
+            positions[tab.name] = len(displayed)
+            displayed.append(tab)
+    return displayed
+
+
+def _click_action(tab_name: str) -> str:
+    """Build the click action that activates a tab.
+
+    Args:
+        tab_name (str): The name of the tab.
+
+    Returns:
+        str: The action string.
+    """
+    return f"range_clicked('{tab_name}')"
+
+
+def _fit_label(label: str, cells: int) -> str:
+    """Pad a label with spaces so that it occupies the given number of cells.
+
+    Args:
+        label (str): The label text.
+        cells (int): The number of cells the label was allotted.
+
+    Returns:
+        str: The label, padded on the right when it is narrower than the allotment.
+    """
+    padding = cells - cell_len(label)
+    return label + " " * padding if padding > 0 else label
+
+
+def _bar_highlight(
+    label_ranges: List[Tuple[int, int]], position: float
+) -> Tuple[float, float]:
+    """Interpolate the highlight range for a fractional position.
+
+    The highlight spans the label range of the floor index and the label range of
+    the next index, interpolated by the fractional part. The next index wraps.
+
+    Args:
+        label_ranges (List[Tuple[int, int]]): Label range of each displayed tab.
+        position (float): Fractional index into the displayed tabs.
+
+    Returns:
+        Tuple[float, float]: The start and end of the highlight in cells.
+    """
+    count = len(label_ranges)
+    if count == 0:
+        return (0.0, 0.0)
+    floor_position = floor(position)
+    fraction = position - floor_position
+    current = int(floor_position) % count
+    following = (current + 1) % count
+    current_start, current_end = label_ranges[current]
+    following_start, following_end = label_ranges[following]
+    start = current_start + (following_start - current_start) * fraction
+    end = current_end + (following_end - current_end) * fraction
+    return (start, end)
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full tab list. Duplicate names are displayed once.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): Index into the full tab list that places the bar.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of the inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int, optional): A fixed padding size in cells, or ``None`` or
+            zero to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _display_position(self, index_by_name: Dict[str, int]) -> float:
+        """Convert the bar position over the full tab list to the displayed tabs.
+
+        Args:
+            index_by_name (Dict[str, int]): Displayed index of each tab name.
+
+        Returns:
+            float: Fractional index into the displayed tabs.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return 0.0
+        position = max(self.bar_position, 0.0)
+        floor_position = floor(position)
+        index = min(int(floor_position), count - 1)
+        current = index_by_name[self.tabs[index].name]
+        if position > floor_position and index + 1 < count:
+            following = index_by_name[self.tabs[index + 1].name]
+            return current + (following - current) * (position - floor_position)
+        return float(current)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        edges: List[_Edge] = []
+        for tab in displayed:
+            if self.tab_padding:
+                padding_edge = _Edge(size=self.tab_padding)
+            else:
+                padding_edge = _Edge()
+            edges.extend([padding_edge, _Edge(size=cell_len(tab.label)), padding_edge])
+        sizes = layout_resolve(width, edges)
+
+        # Each record: tab, padded span text, selection range, label range.
+        records: List[Tuple[Tab, str, Tuple[int, int], Tuple[int, int]]] = []
+        x = 0
+        for index, tab in enumerate(displayed):
+            left, label_cells, right = sizes[index * 3 : index * 3 + 3]
+            label_start = x + left
+            label_end = label_start + label_cells
+            span_end = label_end + right
+            span_text = (
+                " " * left + _fit_label(tab.label, label_cells) + " " * right
+            )
+            records.append(
+                (tab, span_text, (x, span_end), (label_start, label_end))
+            )
+            x = span_end
+
+        # Label row
+        for tab, span_text, _, _ in records:
+            if tab.name == self.active_tab_name:
+                style = console.get_style(self.active_tab_style)
+                yield Text(span_text, style=style, no_wrap=True, end="")
+            else:
+                style = console.get_style(self.inactive_tab_style) + Style(
+                    meta={"@click": _click_action(tab.name)}
+                )
+                yield Opacity(
+                    Text(span_text, style=style, no_wrap=True, end=""),
+                    opacity=self.inactive_text_opacity,
+                )
+        yield Segment.line()
+
+        # Underline row
+        index_by_name = {tab.name: index for index, tab in enumerate(displayed)}
+        label_ranges = [label_range for _, _, _, label_range in records]
+        highlight = _bar_highlight(
+            label_ranges, self._display_position(index_by_name)
+        )
+        clickable_ranges = {
+            tab.name: selection_range for tab, _, selection_range, _ in records
+        }
+        yield UnderlineBar(
+            highlight_range=highlight,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline. A
+    tab is selected with the keyboard or the mouse, and the underline moves to it.
+
+    Args:
+        tabs (List[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. A name that matches no tab is kept, and the bar
+            then sits at index 0.
+        active_tab_style (StyleType): The style of the active tab label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of the inactive tab labels. Defaults
+            to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The padding in cells on each side of a label. Use
+            ``None`` (or zero) to fit the padding to the available width. Defaults to
+            ``None``.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to True.
+    """
+
+    can_focus = True
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        Right and Left move to the next and previous tab, wrapping at either end. The
+        digit keys 1 to 9 activate the tab at that position, and 0 uses the rule of
+        ``activate_tab_by_number``. Escape removes focus from the widget. When
+        ``search_by_first_character`` is true, any other single character activates the
+        next tab whose label starts with it. Every key event is marked handled, and
+        its propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and never selects the
+        active tab. If no other tab matches, the active tab does not change. The
+        comparison is case-insensitive.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        active_name = self._active_tab_name
+        count = len(self.tabs)
+        start = self.find_tab_by_name(active_name)
+        target = char.casefold()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == active_name:
+                continue
+            if tab.label.casefold().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A tab number greater than the number of tabs does nothing. Tab number 0
+        activates the 10th tab when there are at least ten tabs, and otherwise the
+        last tab.
+
+        Args:
+            tab_number (int): The 1-based position of the tab, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 when no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used as the click action of a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
