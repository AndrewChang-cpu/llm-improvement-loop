diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..4d4c306
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,202 @@
+import io
+import re
+from typing import List
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_SGR = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def make_renderable(tabs, active=None, position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def segments_of(renderable, width=100):
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def plain_rows(renderable) -> List[str]:
+    return ANSI_SGR.sub("", render(renderable)).split("\n")
+
+
+def meta_of(style):
+    return style.meta if style else {}
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home") != Tab("Home", "h")
+    assert str(Tab("Home", "h")) == "Home"
+
+
+def test_construction_with_default_styles():
+    Tabs([])
+    Tabs([Tab("Home"), Tab("Files")], active_tab="Files")
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Files")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given_by_name():
+    tabs = Tabs([Tab("Home"), Tab("Files"), Tab("Settings")], active_tab="Settings")
+    assert tabs._active_tab_name == "Settings"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_initial_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Files")], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([], active_tab="Nope")
+    assert tabs._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_one_based():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_is_last():
+    tabs = Tabs([Tab(f"T{i}") for i in range(1, 6)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T5"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_is_tenth():
+    tabs = Tabs([Tab(f"T{i}") for i in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_number_beyond_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "A"
+
+
+def test_first_char_search_is_case_insensitive_and_starts_after_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apricot"
+
+
+def test_first_char_search_wraps_around():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot")])
+    tabs._active_tab_name = "apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_never_selects_active_and_ignores_no_match():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Files")])
+    tabs.action_range_clicked("Files")
+    assert tabs._active_tab_name == "Files"
+
+
+def test_label_row_with_fixed_padding():
+    renderable = make_renderable([Tab("Home"), Tab("Files")], "Home", tab_padding=1)
+    assert plain_rows(renderable)[0] == " Home  Files "
+
+
+def test_label_row_auto_fit_padding_uses_shared_layout():
+    # Width 100 (the render helper's width). The labels take 1 and 2 cells, leaving 97
+    # cells for four padding edges. Each share is 97 / 4 = 24.25 cells, so the sizes are
+    # 24, 24, 24, 25, with the fractional leftover carried forward.
+    renderable = make_renderable([Tab("A"), Tab("BB")], "A")
+    row = plain_rows(renderable)[0]
+    assert row == " " * 24 + "A" + " " * 48 + "BB" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")]
+    renderable = make_renderable(tabs, "a", tab_padding=1)
+    assert plain_rows(renderable)[0] == " Three  Two "
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    rows = plain_rows(make_renderable([], None))
+    assert rows == ["", "━" * 100]
+
+
+def test_inactive_label_carries_click_action_and_active_does_not():
+    renderable = make_renderable([Tab("Home"), Tab("Files")], "Home", tab_padding=1)
+    segments = segments_of(renderable)
+    active = next(s for s in segments if s.text == " Home ")
+    inactive = next(s for s in segments if s.text == " Files ")
+    assert "@click" not in meta_of(active.style)
+    assert meta_of(inactive.style) == {"@click": "range_clicked('Files')"}
+
+
+def test_underline_cells_under_each_tab_carry_its_click_action():
+    renderable = make_renderable([Tab("Home"), Tab("Files")], "Home", tab_padding=1)
+    rows = segments_of(renderable, width=20)
+    underline = []
+    current_row = 0
+    for segment in rows:
+        if segment.text == "\n":
+            current_row += 1
+            continue
+        if current_row == 1:
+            underline.extend(meta_of(segment.style) for _ in segment.text)
+    assert len(underline) == 20
+    assert all(
+        meta == {"@click": "range_clicked('Home')"} for meta in underline[0:6]
+    )
+    assert all(
+        meta == {"@click": "range_clicked('Files')"} for meta in underline[6:13]
+    )
+    assert all("@click" not in meta for meta in underline[13:])
