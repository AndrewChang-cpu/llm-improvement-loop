+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsApp(App):
+    """Sandbox application that shows Tabs widgets."""
+
+    def on_mount(self):
+        """Mount example tab bars directly on the app."""
+        self.mount(
+            basic=Tabs([Tab("Home"), Tab("Projects"), Tab("Settings")]),
+            numbered=Tabs(
+                [Tab(str(number)) for number in range(1, 13)], active_tab="5"
+            ),
+            named=Tabs(
+                [Tab("Inbox", "inbox"), Tab("Sent", "sent"), Tab("Archive", "archive")]
+            ),
+        )
+
+
+TabsApp.run(css_file="tabs.css", log="textual.log")
