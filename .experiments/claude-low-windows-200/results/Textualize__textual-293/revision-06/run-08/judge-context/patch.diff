+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(tabs):
+    return ANSI_ESCAPE.sub("", render(tabs.render())).split("\n")
+
+
+def label_and_bar(tabs):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    items = list(tabs.render().__rich_console__(console, console.options))
+    label_row = items[0]
+    bar_text = next(iter(items[1].__rich_console__(console, console.options)))
+    return label_row, bar_text
+
+
+def span_at(text, position):
+    covering = [span for span in text.spans if span.start <= position < span.end]
+    return covering[-1]
+
+
+def test_tabs_construct_with_default_styles():
+    assert len(Tabs([Tab("One"), Tab("Two")]).tabs) == 2
+    assert Tabs([]).tabs == []
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_text_and_representation():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+    assert str(Tab("Home", "home")) == "Home"
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_argument_is_used():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    assert Tabs([])._active_tab_name is None
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_uses_one_based_positions():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado"), Tab("apricot")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_keeps_active_tab_when_nothing_else_matches():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_activates_named_tab():
+    tabs = Tabs([Tab("One"), Tab("Two", "two")])
+    tabs.action_range_clicked("two")
+    assert tabs._active_tab_name == "two"
+
+
+def test_no_tabs_draws_empty_label_row_and_inactive_underline():
+    assert plain_lines(Tabs([])) == ["", "━" * 100]
+
+
+def test_auto_fit_padding_shares_the_remaining_width():
+    # Four flexible padding edges share 100 - 6 = 94 cells: 23.5 each. The whole
+    # cells are 23, 24, 23, 24, and the half cell carried forward fixes the total.
+    label_row, _ = plain_lines(Tabs([Tab("One"), Tab("Two")]))
+    expected = " " * 23 + "One" + " " * 24 + " " * 23 + "Two" + " " * 24
+    assert label_row == expected
+
+
+def test_auto_fit_underline_highlights_active_label_cells():
+    _, bar = plain_lines(Tabs([Tab("One"), Tab("Two")]))
+    assert len(bar) == 100
+    assert bar[22] == "╸"
+    assert bar[23:26] == "━━━"
+    assert bar[26] == "╺"
+
+
+def test_fixed_padding_places_labels_with_spaces_between():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    label_row, bar = plain_lines(tabs)
+    assert label_row == " One  Two "
+    assert len(bar) == 100
+    assert bar[0] == "╸"
+    assert bar[1:4] == "━━━"
+    assert bar[4] == "╺"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    label_row, _ = plain_lines(tabs)
+    assert label_row == " C  B "
+
+
+def test_underline_follows_active_name_past_duplicates():
+    tabs = Tabs(
+        [Tab("A", "x"), Tab("A2", "x"), Tab("B", "y")],
+        active_tab="y",
+        tab_padding=1,
+    )
+    label_row, bar = plain_lines(tabs)
+    assert label_row == " A2  B "
+    assert bar[4] == "╸"
+    assert bar[5] == "━"
+    assert bar[6] == "╺"
+
+
+def test_inactive_label_carries_click_action_and_is_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    label_row, _ = label_and_bar(tabs)
+    for position in (5, 6):
+        inactive = span_at(label_row, position)
+        assert isinstance(inactive.style, Style)
+        assert inactive.style.meta == {"@click": "range_clicked('Two')"}
+        assert inactive.style.color.triplet != Color.parse("#f0f0f0").triplet
+
+
+def test_active_label_has_no_click_action():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    label_row, _ = label_and_bar(tabs)
+    active = span_at(label_row, 2)
+    assert "@click" not in active.style.meta
+
+
+def test_underline_row_carries_selection_ranges_including_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    _, bar = label_and_bar(tabs)
+    one, two = bar.spans[-2], bar.spans[-1]
+    assert (one.start, one.end) == (0, 5)
+    assert one.style.meta == {"@click": "range_clicked('One')"}
+    assert (two.start, two.end) == (5, 10)
+    assert two.style.meta == {"@click": "range_clicked('Two')"}
