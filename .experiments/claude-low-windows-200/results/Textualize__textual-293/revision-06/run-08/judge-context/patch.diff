+    assert (first_span.start, first_span.end) == (0, 2)
+    assert first_span.style.meta == {"@click": "range_clicked('first')"}
+    assert (second_span.start, second_span.end) == (2, 5)
+    assert second_span.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(clickable_ranges={"one": (0, 3)}, width=6)
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    for span in item.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_reversed_range_takes_early_path_without_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 1),
+        clickable_ranges={"one": (0, 3)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert item.plain == "━━━━━━"
+    for span in item.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_nonzero_position_keeps_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"one": (0, 2)},
+        width=6,
+    )
+    item = first_item(bar)
+    last_span = item.spans[-1]
+    assert (last_span.start, last_span.end) == (0, 2)
+    assert last_span.style.meta == {"@click": "range_clicked('one')"}
+
