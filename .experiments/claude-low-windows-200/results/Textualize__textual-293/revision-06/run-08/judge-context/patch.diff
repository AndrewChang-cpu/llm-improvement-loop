diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..b9f0978
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,375 @@
+from __future__ import annotations
+
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab shown by the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The share of the remaining space for a flexible edge.
+            Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Compute the tabs that are rendered.
+
+    There is one entry per distinct name. Each entry takes the position of the first
+    tab with that name and the label of the last tab with that name.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The tabs to render, in display order.
+    """
+    by_name: Dict[str, Tab] = {}
+    for tab in tabs:
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline row of a Tabs widget.
+
+    Args:
+        widget (Tabs): The widget whose state is rendered.
+    """
+
+    def __init__(self, widget: Tabs) -> None:
+        self.widget = widget
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        widget = self.widget
+        width = options.max_width
+        displayed = _displayed_tabs(widget.tabs)
+
+        padding = widget.tab_padding or None
+        edges: List[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=padding))
+        sizes = layout_resolve(width, edges)
+
+        active_name = widget._active_tab_name
+        active_style = console.get_style(widget.active_tab_style)
+        inactive_style = console.get_style(widget.inactive_tab_style)
+
+        label_row = Text(end="\n", no_wrap=True, overflow="crop")
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (cursor, selection_end)
+
+            padded = " " * left + tab.label + " " * right
+            if tab.name == active_name:
+                label_row.append(padded, active_style)
+            else:
+                click_style = inactive_style + Style.from_meta(
+                    {"@click": f"range_clicked('{tab.name}')"}
+                )
+                tab_text = Text(end="", no_wrap=True, overflow="crop")
+                tab_text.append(padded, click_style)
+                dimmed = Opacity(tab_text, opacity=widget.inactive_text_opacity)
+                for segment in console.render(dimmed, options):
+                    if segment.text:
+                        label_row.append(segment.text, segment.style)
+            cursor = selection_end
+
+        highlight_range = self._highlight_range(label_ranges)
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(widget.active_bar_style),
+            background_style=console.get_style(widget.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield label_row
+        yield bar
+
+    def _highlight_range(
+        self, label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the two tabs around the bar position.
+
+        The bar position is a fractional index into the full tab list. The label
+        ranges are keyed by name, so a duplicated name resolves to its displayed tab.
+
+        Args:
+            label_ranges (Dict[str, Tuple[int, int]]): Label range of each displayed
+                tab, keyed by name.
+
+        Returns:
+            Tuple[float, float]: The highlight range in columns.
+        """
+        tabs = self.widget.tabs
+        if not tabs:
+            return (0, 0)
+        count = len(tabs)
+        position = min(max(self.widget._bar_position, 0.0), float(count - 1))
+        floor_index = int(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+        start_start, start_end = label_ranges[tabs[floor_index].name]
+        next_start, next_end = label_ranges[tabs[next_index].name]
+        return (
+            start_start + (next_start - start_start) * fraction,
+            start_end + (next_end - start_end) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A tab is selected by pressing its digit (1 to 9, or 0 for the tenth or last tab),
+    by searching for its first character, with the left and right keys, or by
+    clicking it. Selection is identified by tab name.
+
+    Args:
+        tabs (List[Tab]): The tabs to show, in display order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. An unknown name is kept as given,
+            and the bar then sits at index 0.
+        active_tab_style (StyleType): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of the inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+            Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation, in
+            seconds. Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            Defaults to ``None``, which fits the labels across the widget width.
+            A value of zero is treated the same as ``None``.
+        search_by_first_character (bool): Whether a key that is not a digit or an
+            arrow selects the next tab whose label starts with that character.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if not self.tabs:
+            initial_name = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(self)
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape removes focus from the widget by awaiting ``set_focus`` on the app
+          with no target.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digit keys 1 to 9 activate the tab at that position. The 0 key activates
+          the tenth tab, or the last tab when there are fewer than ten tabs. Only the
+          characters 0 to 9 are digits.
+        - When ``search_by_first_character`` is true, any other single-character key
+          activates the next tab, after the active one and wrapping, whose label starts
+          with that character. The search is case-insensitive.
+
+        Every key event is marked handled, and none is stopped, so application-level
+        bindings still receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the tab after the active one, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the tab before the active one, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around the full tab list. It
+        never selects the active tab. If no other tab matches, the active tab does not
+        change.
+
+        Args:
+            char (str): The character to match, compared case-insensitively.
+        """
+        count = len(self.tabs)
+        current = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(current + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        tenth tab when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used by clickable label spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
