@@ -0,0 +1,218 @@
+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ANSI_PATTERN.sub("", render(renderable))
+
+
+def segments(renderable):
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+
+
+def test_tab_keeps_explicit_name():
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_compares_label_and_name():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home") != Tab("Home", "h")
+
+
+def test_tab_repr_and_str():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+    assert str(Tab("Home", "h")) == "Home"
+
+
+def test_construct_with_default_styles():
+    assert Tabs([]).find_tab_by_name("missing") == 0
+    assert Tabs([Tab("A"), Tab("B")]).find_tab_by_name("B") == 1
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    assert Tabs([])._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_tab_wraps():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_previous_tab_wraps():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_is_one_based():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_greater_than_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "A"
+
+
+def test_zero_activates_last_tab_with_fewer_than_ten():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_char_search_skips_active_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_is_case_insensitive():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_label_row_and_underline_row_with_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    lines = plain(tabs.render()).split("\n")
+    assert len(lines) == 2
+    assert lines[0] == " Home  Docs "
+    # Active label spans cells 1 to 5; the highlight has half-cell edges.
+    assert lines[1][:6] == "╸" + "━" * 4 + "╺"
+    assert len(lines[1]) == 100
+
+
+def test_auto_fit_padding_shares_width_by_layout_rule():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    lines = plain(tabs.render()).split("\n")
+    # Width 100 with two one-cell labels leaves 98 cells for four flexible edges,
+    # a share of 24.5 each. Edges take 24, 25, 24, 25 with the leftover carried.
+    expected = " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+    assert lines[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], tab_padding=1
+    )
+    lines = plain(tabs.render()).split("\n")
+    assert lines[0] == " Three  Two "
+    # The active name "a" sits under the displayed "Three" tab (cells 1 to 6).
+    assert lines[1][:7] == "╸" + "━" * 5 + "╺"
+
+
+def test_underline_sits_under_displayed_duplicate_tab_with_active_name():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")],
+        active_tab="b",
+        tab_padding=1,
+    )
+    lines = plain(tabs.render()).split("\n")
+    # "Two" starts at cell 7 with its label at cells 8 to 10.
+    assert lines[1][:12] == "━" * 7 + "╸" + "━" * 3 + "╺"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    lines = plain(Tabs([]).render()).split("\n")
+    assert lines == ["", "━" * 100]
+
+
+def test_inactive_label_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    docs = [s for s in segments(tabs.render()) if s.text == " Docs "]
+    assert len(docs) == 1
+    style = docs[0].style
+    assert isinstance(style, Style)
+    assert style.meta == {"@click": "range_clicked('Docs')"}
+    original = Color.parse("#f0f0f0").triplet
+    assert style.color.triplet != original
+
+
+def test_active_label_has_no_click_action():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    home = [s for s in segments(tabs.render()) if s.text == " Home "]
+    assert len(home) == 1
+    assert isinstance(home[0].style, Style)
+    assert "@click" not in home[0].style.meta
+
+
+def test_underline_cells_under_inactive_tab_carry_its_click_action():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    all_segments = segments(tabs.render())
+    newline_index = [i for i, s in enumerate(all_segments) if s.text == "\n"][0]
+    underline = all_segments[newline_index + 1 :]
+    docs_cells = sum(
+        len(s.text)
+        for s in underline
+        if s.style is not None and s.style.meta.get("@click") == "range_clicked('Docs')"
+    )
+    # The Docs selection range spans its padded span, which is 6 cells wide.
+    assert docs_cells == 6
