diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..d3a834d
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,463 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for the shared layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of flexible space this edge receives. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Compute the tabs to render, one per distinct name.
+
+    Each name keeps the position of its first occurrence and the label of its last
+    occurrence.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs.
+
+    Returns:
+        List[Tab]: The displayed tabs in display order.
+    """
+    by_name: Dict[str, Tab] = {}
+    for tab in tabs:
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+def _click_style(tab_name: str) -> Style:
+    """Create the style that attaches the click action for a tab name.
+
+    Args:
+        tab_name (str): The name of the tab.
+
+    Returns:
+        Style: A style carrying the ``@click`` metadata for the tab.
+    """
+    return Style(meta={"@click": f"range_clicked('{tab_name}')"})
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full list of tabs.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): The bar position, as a fractional index into the full
+            tab list.
+        active_tab_style (StyleType): The style of the active tab label.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tab labels.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int, optional): A fixed padding size in cells, or ``None`` to
+            fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding:
+            return _Edge(size=self.tab_padding)
+        return _Edge()
+
+    def _inactive_segments(
+        self,
+        console: Console,
+        options: ConsoleOptions,
+        text: str,
+        tab_name: str,
+        style: Style,
+    ) -> List[Segment]:
+        label = Text(text, style=style, no_wrap=True, overflow="crop", end="")
+        label.stylize(_click_style(tab_name))
+        return list(
+            console.render(
+                Opacity(label, opacity=self.inactive_text_opacity), options
+            )
+        )
+
+    def _highlight_range(
+        self, displayed: List[Tab], label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Compute the highlighted column range of the underline bar.
+
+        The bar position is a full-list index. It is converted to a position over the
+        displayed tabs, then the label ranges of the floor tab and the next tab are
+        interpolated, wrapping at the end.
+
+        Args:
+            displayed (List[Tab]): The displayed tabs.
+            label_ranges (Dict[str, Tuple[int, int]]): Label ranges keyed by tab name.
+
+        Returns:
+            Tuple[float, float]: The start and end columns of the highlight.
+        """
+        if not displayed:
+            return (0, 0)
+
+        names = [tab.name for tab in displayed]
+        count = len(self.tabs)
+
+        def displayed_index(full_index: int) -> int:
+            return names.index(self.tabs[full_index].name)
+
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        floor_index = int(math.floor(position))
+        fraction = position - floor_index
+        next_full_index = min(floor_index + 1, count - 1)
+        floor_displayed = displayed_index(floor_index)
+        next_displayed = displayed_index(next_full_index)
+        displayed_position = floor_displayed + (
+            next_displayed - floor_displayed
+        ) * fraction
+
+        index = int(math.floor(displayed_position))
+        index_fraction = displayed_position - index
+        next_index = (index + 1) % len(displayed)
+        start, end = label_ranges[names[index]]
+        next_start, next_end = label_ranges[names[next_index]]
+        return (
+            start + (next_start - start) * index_fraction,
+            end + (next_end - end) * index_fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        edges: List[_Edge] = []
+        for tab in displayed:
+            edges.append(self._padding_edge())
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        cursor = 0
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        label_segments: List[Segment] = []
+        for index, tab in enumerate(displayed):
+            left, label_cells, right = sizes[index * 3 : index * 3 + 3]
+            label_width = cell_len(tab.label)
+            padded = (
+                " " * left
+                + tab.label
+                + " " * max(label_cells - label_width, 0)
+                + " " * right
+            )
+            selection_end = cursor + left + label_cells + right
+            label_ranges[tab.name] = (cursor + left, cursor + left + label_cells)
+            selection_ranges[tab.name] = (cursor, selection_end)
+            if tab.name == self.active_tab_name:
+                label_segments.append(Segment(padded, active_style))
+            else:
+                label_segments.extend(
+                    self._inactive_segments(
+                        console, options, padded, tab.name, inactive_style
+                    )
+                )
+            cursor = selection_end
+
+        yield from label_segments
+        yield Segment.line()
+
+        highlight_range = self._highlight_range(displayed, label_ranges)
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal tab bar with an animated underline.
+
+    The widget occupies two rows. The first row shows the tab labels and the second
+    row shows an underline that marks the active tab. Tabs are selected with the
+    keyboard or the mouse.
+
+    Args:
+        tabs (List[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            missing or empty, the first tab is active. Defaults to ``None``.
+        active_tab_style (StyleType, optional): The style of the active tab label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): The duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): A fixed number of cells for the padding on
+            each side of a label. ``None`` or zero fits the padding to the available
+            width. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character. Defaults to
+            ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Key behavior:
+
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - Escape removes focus from the widget.
+        - The digits 1 through 9 activate the tab at that 1-based position. The digit 0
+          activates the 10th tab, or the last tab when there are fewer than ten.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab, after the active one, whose label starts with that
+          character. The comparison ignores case.
+
+        Every key event is marked handled. Propagation is not stopped, so application
+        bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0 if no
+                tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It never selects the active
+        tab. The comparison ignores case.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start_index = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        A number greater than the tab count is ignored. The number 0 activates the 10th
+        tab when there are at least ten tabs, and the last tab otherwise. Any other
+        number activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            tab = self.tabs[9] if len(self.tabs) >= 10 else self.tabs[-1]
+        else:
+            tab = self.tabs[tab_number - 1]
+        self._active_tab_name = tab.name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the named tab. This is the action for clicks on a tab's range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
