+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows the Tabs widget."""
+
+    def on_mount(self):
+        """Mount two Tabs widgets directly on the app."""
+        self.mount(
+            first=Tabs([Tab("Home"), Tab("Profile"), Tab("Settings")]),
+            second=Tabs(
+                [Tab("One"), Tab("Two"), Tab("Three"), Tab("Four")],
+                active_tab="Two",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
