@@ -0,0 +1,168 @@
+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def make_renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=1):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def plain_lines(renderable):
+    return ANSI_CODE.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", name="first").name == "first"
+
+
+def test_tab_equality_repr_and_text():
+    assert Tab("One") == Tab("One", name="One")
+    assert Tab("One") != Tab("One", name="other")
+    assert repr(Tab("One", name="first")) == "Tab(label='One', name='first')"
+    assert str(Tab("One", name="first")) == "One"
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([Tab("One"), Tab("Two")]) is not None
+    assert Tabs([]) is not None
+
+
+def test_initial_active_tab_is_first_tab_by_default():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_given_active_tab_sets_initial_bar_position():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], active_tab="Three")
+    assert tabs._active_tab_name == "Three"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Zed")
+    assert tabs._active_tab_name == "Zed"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_means_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("B"), Tab("A"), Tab("C", name="A")])
+    assert tabs.find_tab_by_name("A") == 1
+    assert tabs.find_tab_by_name("B") == 0
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_for_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Avocado")],
+        search_by_first_character=False,
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    renderable = make_renderable([], tab_padding=None)
+    assert plain_lines(renderable) == ["", "━" * 100]
+
+
+def test_fixed_padding_label_row_and_highlight_under_active_tab():
+    tabs = [Tab("One"), Tab("Two"), Tab("Three")]
+    lines = plain_lines(make_renderable(tabs, active_tab_name="One"))
+    assert lines[0].rstrip() == " One  Two  Three"
+    # The label "One" occupies columns 1 to 3, so the highlight spans them.
+    assert lines[1] == "╸━━━╺" + "━" * 95
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("One", name="x"), Tab("Two"), Tab("Uno", name="x")]
+    lines = plain_lines(make_renderable(tabs, active_tab_name="Two", bar_position=1))
+    assert lines[0].rstrip() == " Uno  Two"
+    # "Two" starts after the 5-cell span of "Uno", so its label is at columns 6 to 8.
+    assert lines[1] == "━━━━━╸━━━╺" + "━" * 90
+
+
+def test_inactive_padded_span_is_clickable_and_dimmed():
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    tabs = [Tab("One"), Tab("Two")]
+    renderable = make_renderable(tabs, active_tab_name="One")
+    segments = list(console.render(renderable, console.options))
+
+    inactive = [segment for segment in segments if segment.text == " Two "]
+    assert len(inactive) == 1
+    assert inactive[0].style.meta == {"@click": "range_clicked('Two')"}
+    assert inactive[0].style.color.triplet != Color.parse("#f0f0f0").triplet
+
+    active = [segment for segment in segments if segment.text == " One "]
+    assert len(active) == 1
+    assert "@click" not in active[0].style.meta
