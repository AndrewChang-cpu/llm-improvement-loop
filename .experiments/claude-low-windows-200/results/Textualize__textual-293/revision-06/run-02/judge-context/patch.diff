diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..a3da1b2
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,405 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab shown in a `Tabs` widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str | None, optional): The name that identifies the tab. Defaults to None,
+            which uses the label as the name.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """Edge description for the shared layout resolver."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the tabs that are rendered, one per distinct name.
+
+    The position of each displayed tab is where its name first appears, and its
+    label comes from the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full list of tabs.
+
+    Returns:
+        list[Tab]: The displayed tabs in display order.
+    """
+    last_by_name = {tab.name: tab for tab in tabs}
+    displayed: list[Tab] = []
+    seen: set[str] = set()
+    for tab in tabs:
+        if tab.name not in seen:
+            seen.add(tab.name)
+            displayed.append(last_by_name[tab.name])
+    return displayed
+
+
+class TabsRenderable:
+    """Renderable for the `Tabs` widget: a label row over an underline bar.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or None when there
+            are no tabs.
+        bar_position (float): Fractional index into the full tab list that places
+            the underline.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab labels.
+        tab_padding (int | None): Fixed padding on each side of a label, or None to
+            auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _TabEdge:
+        if self.tab_padding:
+            return _TabEdge(size=self.tab_padding)
+        return _TabEdge(size=None, min_size=1, fraction=1)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        edges: list[_TabEdge] = []
+        for tab in displayed:
+            edges.append(self._padding_edge())
+            edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        label_segments: list[Segment] = []
+
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (cursor, span_end)
+            cursor = span_end
+
+            padded = " " * left + tab.label + " " * right
+            text = Text(end="", no_wrap=True)
+            if tab.name == self.active_tab_name:
+                text.append(padded, style=active_tab_style)
+                renderable: RenderableType = text
+            else:
+                text.append(padded, style=inactive_tab_style)
+                text.stylize(
+                    Style(meta={"@click": f"range_clicked('{tab.name}')"}),
+                    0,
+                    len(padded),
+                )
+                renderable = Opacity(text, opacity=self.inactive_text_opacity)
+            label_segments.extend(console.render(renderable, options))
+
+        highlight_range = (0.0, 0.0)
+        if self.tabs:
+            count = len(self.tabs)
+            floor_index = int(math.floor(self.bar_position))
+            fraction = self.bar_position - floor_index
+            floor_tab = self.tabs[floor_index % count]
+            next_tab = self.tabs[(floor_index + 1) % count]
+            floor_start, floor_end = label_ranges[floor_tab.name]
+            next_start, next_end = label_ranges[next_tab.name]
+            highlight_range = (
+                floor_start + (next_start - floor_start) * fraction,
+                floor_end + (next_end - floor_end) * fraction,
+            )
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield from label_segments
+        yield Segment("\n")
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline. A
+    user can select a tab with the keyboard or with the mouse.
+
+    Args:
+        tabs (list[Tab]): The tabs to show. The list may be empty.
+        active_tab (str | None, optional): The name of the initially active tab.
+            Defaults to None, which selects the first tab. A name that matches no tab
+            is kept, and the bar then sits at index 0.
+        active_tab_style (StyleType, optional): The style of the active tab label.
+            Defaults to "#f0f0f0 on #021720".
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline. Defaults to "#1BB152".
+        inactive_tab_style (StyleType, optional): The style of inactive tab labels.
+            Defaults to "#f0f0f0 on #021720".
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to "#455058".
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tab labels. Defaults to 0.5.
+        animation_duration (float, optional): The duration of the underline animation
+            in seconds. Defaults to 0.3.
+        animation_function (str, optional): The easing name used by the underline
+            animation. Defaults to "out_cubic".
+        tab_padding (int | None, optional): The number of cells on each side of a
+            label. Defaults to None, which fits the labels across the widget width. A
+            value of zero is treated the same as None.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character. Defaults to
+            True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            active_name: str | None = None
+        elif active_tab:
+            active_name = active_tab
+        else:
+            active_name = tabs[0].name
+        self._active_tab_name = active_name
+        self._bar_position = float(self.find_tab_by_name(active_name))
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the position of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the widget has focus.
+
+        Behavior:
+            - With no tabs, the key is marked handled and nothing else happens.
+            - Escape removes focus from the widget by awaiting the app's
+              ``set_focus`` with no target.
+            - Left and Right activate the previous and next tab, wrapping at either
+              end.
+            - The digit keys 1 through 9 activate the tab at that 1-based position.
+              The 0 key follows the rule in ``activate_tab_by_number``. Other
+              characters are not digit keys.
+            - When ``search_by_first_character`` is true, any other single-character
+              key activates the next tab, after the active one and wrapping, whose
+              label starts with that character.
+
+        Every key is marked handled by preventing its default action. Propagation is
+        not stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It never selects the active
+        tab. If no other tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match, compared case-insensitively.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        Numbers are 1-based. A number greater than the tab count is ignored. The
+        number 0 activates the 10th tab when there are at least ten tabs, and otherwise
+        the last tab.
+
+        Args:
+            tab_number (int): The tab number.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. Used as the click action of tab ranges.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
