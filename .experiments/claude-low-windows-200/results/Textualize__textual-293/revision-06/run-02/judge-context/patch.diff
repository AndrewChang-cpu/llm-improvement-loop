+
+def test_zero_width_highlight_at_nonzero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3), clickable_ranges={"first": (0, 3)}, width=6
+    )
+    item = _first_item(bar)
+    click = item.spans[-1]
+    assert (click.start, click.end) == (0, 3)
+    assert click.style.meta == {"@click": "range_clicked('first')"}
