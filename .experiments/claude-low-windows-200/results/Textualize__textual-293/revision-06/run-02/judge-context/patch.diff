+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (2, 4)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    first, second = item.spans[-2], item.spans[-1]
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert (second.start, second.end) == (2, 4)
+    assert second.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_zero_width_early_path_has_no_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 1), clickable_ranges={"first": (0, 3)}, width=6
+    )
