+import io
+import re
+
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+RE_ANSI = re.compile(r"\x1b\[[0-9;]*m")
+WIDTH = 100
+
+
+def _renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def _plain_rows(renderable):
+    """Return the label row and the underline row as plain text."""
+    return RE_ANSI.sub("", render(renderable)).split("\n")
+
+
+def _cells(renderable):
+    """Return one (char, style) pair per cell, per row, read from rendered segments."""
+    console = Console(
+        width=WIDTH, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rows = [[], []]
+    row = 0
+    for segment in console.render(renderable, console.options):
+        if segment.control:
+            continue
+        for char in segment.text:
+            if char == "\n":
+                row += 1
+                continue
+            rows[row].append((char, segment.style))
+    return rows
+
+
+def _click(cell):
+    _char, style = cell
+    if style is None:
+        return None
+    assert isinstance(style, Style)
+    return style.meta.get("@click")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Files", "files").name == "files"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "other")
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construction_with_default_styles_succeeds():
+    widget = Tabs([Tab("Home"), Tab("Files")])
+    assert widget._active_tab_name == "Home"
+    empty = Tabs([])
+    assert empty._active_tab_name is None
+
+
+def test_active_tab_option_selects_named_tab():
+    widget = Tabs([Tab("Home"), Tab("Files", "files")], active_tab="files")
+    assert widget._active_tab_name == "files"
+    assert widget._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_with_bar_at_zero():
+    widget = Tabs([Tab("Home"), Tab("Files")], active_tab="missing")
+    assert widget._active_tab_name == "missing"
+    assert widget._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_match():
+    widget = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "C"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "A"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_is_one_based_and_ignores_large_numbers():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "B"
+    widget.activate_tab_by_number(4)
+    assert widget._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_uses_last_tab_below_ten():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_at_ten_or_more():
+    widget = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_skips_active_and_wraps():
+    widget = Tabs([Tab("Apple"), Tab("Avocado"), Tab("banana")], active_tab="Apple")
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Avocado"
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "Apple"
+    widget.activate_tab_by_first_char("B")
+    assert widget._active_tab_name == "banana"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    widget = Tabs([Tab("Apple"), Tab("Avocado")], active_tab="Apple")
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs([Tab("A"), Tab("B")])
+    widget.action_range_clicked("B")
+    assert widget._active_tab_name == "B"
+
+
+def test_render_returns_tabs_renderable():
+    widget = Tabs([Tab("A")])
+    assert isinstance(widget.render(), TabsRenderable)
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_bar():
+    rows = _plain_rows(_renderable([]))
+    assert rows == ["", "━" * WIDTH]
+
+
+def test_label_row_with_fixed_padding():
+    tabs = [Tab("Home"), Tab("Files"), Tab("Help")]
+    rows = _plain_rows(_renderable(tabs, "Home", tab_padding=1))
+    assert rows[0] == " Home  Files  Help "
+
+
+def test_label_row_auto_fit_padding_shares_remaining_width():
+    # Labels take 4 + 5 + 4 = 13 cells, leaving 87 cells for six flexible edges.
+    # Each edge gets 14 or 15 cells, with the fractional share carried forward:
+    # 14, 15, 14, 15, 14, 15 (sums to 87).
+    tabs = [Tab("Home"), Tab("Files"), Tab("Help")]
+    expected = (
+        " " * 14 + "Home" + " " * 15
+        + " " * 14 + "Files" + " " * 15
+        + " " * 14 + "Help" + " " * 15
+    )
+    assert len(expected) == WIDTH
+    rows = _plain_rows(_renderable(tabs, "Home"))
+    assert rows[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")]
+    rows = _plain_rows(_renderable(tabs, "x", tab_padding=1))
+    assert rows[0] == " Gamma  Beta "
+
+
+def test_underline_highlights_active_tab_span():
+    tabs = [Tab("Home"), Tab("Files"), Tab("Help")]
+    rows = _plain_rows(_renderable(tabs, "Home", tab_padding=None))
+    # Home's label occupies cells 14 to 17 under auto-fit padding.
+    # Half-cell glyphs sit at the edges of the highlight.
+    assert rows[1] == "━" * 13 + "╸" + "━" * 4 + "╺" + "━" * 81
+
+
+def test_inactive_tab_cells_carry_its_click_action_and_active_does_not():
+    tabs = [Tab("Home"), Tab("Files"), Tab("Help")]
+    label_row = _cells(_renderable(tabs, "Files"))[0]
+    # Home's padded span is cells 0 to 32, and its label is cells 14 to 17.
+    assert label_row[14][0] == "H"
+    for cell in label_row[0:33]:
+        assert _click(cell) == "range_clicked('Home')"
+    # Files is active, so its padded span (cells 33 to 66) has no click action.
+    for cell in label_row[33:67]:
+        assert _click(cell) is None
+    assert _click(label_row[67]) == "range_clicked('Help')"
+
+
+def test_inactive_labels_are_dimmed_relative_to_active_label():
+    # Two tabs with auto-fit padding: 91 flexible cells over four edges gives
+    # Home's span as 22 + 4 + 23 cells, so its label starts at cell 22.
+    # Files' span starts at cell 49, with 23 padding cells, so its label starts at 72.
+    tabs = [Tab("Home"), Tab("Files")]
+    label_row = _cells(_renderable(tabs, "Files"))[0]
+    assert label_row[22][0] == "H"
+    assert label_row[72][0] == "F"
+    inactive_color = label_row[22][1].color
+    active_color = label_row[72][1].color
+    assert inactive_color is not None
+    assert active_color is not None
+    assert inactive_color != active_color
+
+
+def test_underline_clickable_spans_cover_every_displayed_tab():
+    tabs = [Tab("Home"), Tab("Files"), Tab("Help")]
+    underline = _cells(_renderable(tabs, "Files"))[1]
+    assert _click(underline[5]) == "range_clicked('Home')"
+    assert _click(underline[40]) == "range_clicked('Files')"
+    assert _click(underline[70]) == "range_clicked('Help')"
+    assert _click(underline[99]) == "range_clicked('Help')"
