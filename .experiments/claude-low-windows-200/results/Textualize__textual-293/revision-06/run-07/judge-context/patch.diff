@@ -0,0 +1,188 @@
+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ESCAPE_CODES = re.compile(r"\x1b\][^\x1b]*\x1b\\|\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ESCAPE_CODES.sub("", render(renderable))
+
+
+def make_console() -> Console:
+    return Console(width=100, file=io.StringIO(), color_system="truecolor")
+
+
+def first_item(renderable, console):
+    return next(iter(renderable.__rich_console__(console, console.options)))
+
+
+def label_row(tabs: Tabs) -> Text:
+    console = make_console()
+    return first_item(tabs.render(), console)
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "home") != Tab("Home")
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_default_construction_succeeds_with_and_without_tabs():
+    assert Tabs([]).render().__class__ is TabsRenderable
+    assert Tabs([Tab("A"), Tab("B")]).render().__class__ is TabsRenderable
+
+
+def test_initial_active_tab_is_first_tab_or_active_tab_argument():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_for_fewer_than_ten_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 6)])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "3"
+
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "3"
+
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "5"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_first_character_search_skips_active_wraps_and_ignores_case():
+    tabs = Tabs([Tab("Home"), Tab("About"), Tab("Help")])
+
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Help"
+
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "About"
+
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "About"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_renders_label_row_and_underline_row_with_explicit_padding():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], tab_padding=1)
+    lines = plain(tabs.render()).split("\n")
+
+    assert lines[0] == " One  Two  Three "
+    # The active tab is "One", whose label occupies columns 1 to 3.
+    # The highlight spans columns 1 to 4, so it is drawn with half glyphs at each edge.
+    assert lines[1][:5] == "╸━━━╺"
+
+
+def test_auto_fit_padding_shares_width_across_flexible_edges():
+    # Two tabs of one-cell labels on a 100-cell bar. Each tab has two flexible padding
+    # edges, so four edges share the 98 remaining cells: 24.5 each. The first edge
+    # takes 24 and carries 0.5. The next takes 25 and carries 0. The pattern repeats,
+    # so each tab gets left padding 24 and right padding 25.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    lines = plain(tabs.render()).split("\n")
+
+    assert lines[0] == " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label_at_first_position():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    lines = plain(tabs.render()).split("\n")
+
+    assert lines[0] == " C  B "
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    tabs = Tabs([])
+    lines = plain(tabs.render()).split("\n")
+
+    assert lines == ["", "━" * 100]
+
+
+def test_inactive_padded_cells_carry_click_action_and_are_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    text = label_row(tabs)
+
+    # " One " occupies columns 0 to 4 and " Two " occupies columns 5 to 9.
+    active_spans = [span for span in text.spans if (span.start, span.end) == (0, 5)]
+    inactive_spans = [span for span in text.spans if (span.start, span.end) == (5, 10)]
+
+    assert len(active_spans) == 1
+    assert isinstance(active_spans[0].style, Style)
+    assert active_spans[0].style.meta == {}
+
+    assert len(inactive_spans) == 1
+    inactive_style = inactive_spans[0].style
+    assert isinstance(inactive_style, Style)
+    assert inactive_style.meta == {"@click": "range_clicked('Two')"}
+    assert inactive_style.color != Color.parse("#f0f0f0")
+
+
+def test_underline_click_spans_cover_every_displayed_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    console = make_console()
+    label, bar = list(tabs.render().__rich_console__(console, console.options))
+    bar_text = first_item(bar, console)
+
+    first_click, second_click = bar_text.spans[-2:]
+    assert (first_click.start, first_click.end) == (0, 5)
+    assert first_click.style.meta == {"@click": "range_clicked('One')"}
+    assert (second_click.start, second_click.end) == (5, 10)
+    assert second_click.style.meta == {"@click": "range_clicked('Two')"}
