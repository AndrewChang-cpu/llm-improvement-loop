@@ -0,0 +1,33 @@
+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows Tabs widgets."""
+
+    def on_mount(self):
+        """Mount the example tab bars directly on the app."""
+        self.mount(
+            top=Tabs(
+                [Tab("Home"), Tab("About"), Tab("Contact")],
+                active_tab="About",
+            ),
+            digits=Tabs(
+                [
+                    Tab(f"Page {number}", name=f"page-{number}")
+                    for number in range(1, 12)
+                ],
+                tab_padding=1,
+            ),
+            duplicates=Tabs(
+                [
+                    Tab("First", name="a"),
+                    Tab("Second", name="b"),
+                    Tab("Third", name="a"),
+                ],
+            ),
+        )
+
+
+if __name__ == "__main__":
+    TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
