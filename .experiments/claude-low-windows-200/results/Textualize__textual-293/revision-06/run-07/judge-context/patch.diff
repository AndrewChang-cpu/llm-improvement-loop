+
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    home_span, about_span = text.spans[-2:]
+    assert (home_span.start, home_span.end) == (0, 2)
+    assert (about_span.start, about_span.end) == (2, 6)
+    assert isinstance(home_span.style, Style)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
+    assert isinstance(about_span.style, Style)
+    assert about_span.style.meta == {"@click": "range_clicked('about')"}
+
+
+@pytest.mark.parametrize(
+    "highlight_range", [(0, 0), (4, 2), (-5, -2)]
+)
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    items = _render_items(bar, 6)
+
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    assert text.plain == "━━━━━━"
+    for span in text.spans:
+        assert isinstance(span.style, Style)
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_non_zero_position_has_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    items = _render_items(bar, 6)
+
+    text = items[0]
+    home_span = text.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
