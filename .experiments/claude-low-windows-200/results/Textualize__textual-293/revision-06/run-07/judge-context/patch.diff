diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..2f1d615
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,405 @@
+from __future__ import annotations
+
+import math
+from typing import Any, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name used to select the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: Any) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Compute the tabs that are rendered, one per distinct name.
+
+    An entry takes the position of the first tab with its name and the label of the
+    last tab with that name.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The displayed tabs in display order.
+    """
+    by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+class _Edge:
+    """A column span for the layout resolver. A size of None is flexible."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs for the bar.
+        active_tab_style (StyleType): Style of the active tab's padded label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of the inactive tabs' padded labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding in cells on each side of a label, or
+            ``None`` to fit the labels across the width.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        padding_size = self.tab_padding if self.tab_padding else None
+        edges: List[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding_size))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=padding_size))
+        sizes = layout_resolve(width, edges) if edges else []
+
+        label_row = Text(end="\n", no_wrap=True, overflow="crop")
+        label_ranges: dict[str, Tuple[int, int]] = {}
+        selection_ranges: dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left = sizes[index * 3]
+            right = sizes[index * 3 + 2]
+            padded = " " * left + tab.label + " " * right
+            span_start = cursor
+            span_end = cursor + cell_len(padded)
+            label_start = span_start + left
+            label_ranges[tab.name] = (label_start, label_start + cell_len(tab.label))
+            selection_ranges[tab.name] = (span_start, span_end)
+
+            if tab.name == self.active_tab_name:
+                label_row.append(padded, style=active_style)
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                dimmed = Text(
+                    padded, style=click_style, no_wrap=True, overflow="crop", end=""
+                )
+                for segment in console.render(
+                    Opacity(dimmed, opacity=self.inactive_text_opacity), options
+                ):
+                    label_row.append(segment.text, style=segment.style)
+            cursor = span_end
+        yield label_row
+
+        highlight_range = (0.0, 0.0)
+        count = len(displayed)
+        if count:
+            position = self.bar_position
+            floor_position = math.floor(position)
+            index = int(floor_position) % count
+            fraction = position - floor_position
+            next_index = (index + 1) % count
+            current_start, current_end = label_ranges[displayed[index].name]
+            next_start, next_end = label_ranges[displayed[next_index].name]
+            highlight_range = (
+                current_start + (next_start - current_start) * fraction,
+                current_end + (next_end - current_end) * fraction,
+            )
+
+        yield UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    The widget occupies two rows: the labels, then the underline bar. A tab is
+    selected by name. Keys and mouse clicks change the active tab.
+
+    Args:
+        tabs (List[Tab]): The tabs to show. The list may be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. An unknown name is kept as given.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of the inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels. A value
+            of 1.0 shows the label fully and 0.0 blends it into the background. Defaults
+            to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to ``None``, which fits the labels across the width. A value of 0
+            is treated the same as ``None``.
+        search_by_first_character (bool): If ``True``, a single-character key that is
+            not a digit activates the next tab whose label starts with that character.
+            Defaults to ``True``.
+    """
+
+    can_focus = True
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self._tabs: List[Tab] = list(tabs)
+        self._active_tab_style = active_tab_style
+        self._active_bar_style = active_bar_style
+        self._inactive_tab_style = inactive_tab_style
+        self._inactive_bar_style = inactive_bar_style
+        self._inactive_text_opacity = inactive_text_opacity
+        self._animation_duration = animation_duration
+        self._animation_function = animation_function
+        self._tab_padding = tab_padding
+        self._search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self._tabs:
+            initial_name = self._tabs[0].name
+        else:
+            initial_name = None
+
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the position of a tab name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index, or 0 when the name is not displayed.
+        """
+        names = [tab.name for tab in _displayed_tabs(self._tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed position of the active tab.
+
+        Args:
+            active_tab_name (str | None): The new active tab name.
+        """
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self._animation_duration,
+            easing=self._animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self._active_tab_style,
+            active_bar_style=self._active_bar_style,
+            inactive_tab_style=self._inactive_tab_style,
+            inactive_bar_style=self._inactive_bar_style,
+            inactive_text_opacity=self._inactive_text_opacity,
+            tab_padding=self._tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Every key event is marked handled, but propagation is not stopped, so app
+        bindings still receive keys. With no tabs, nothing else happens.
+
+        ``Escape`` removes focus from the widget. ``Right`` and ``Left`` move to the
+        next or previous tab, wrapping at either end. A digit from ``0`` to ``9``
+        activates the tab at that 1-based position, and ``0`` uses the tenth tab or the
+        last tab. A digit larger than the tab count is ignored. Any other single
+        character activates the next tab whose label starts with it, ignoring case, if
+        searching by first character is enabled.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self._tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and "0" <= key <= "9":
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self._search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self._tabs[(index + 1) % len(self._tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self._tabs[(index - 1) % len(self._tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, ignores case, and wraps around the tab
+        list. The active tab is never selected. If no other tab matches, the active tab
+        does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self._tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count):
+            tab = self._tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A tab number of ``0`` activates the tenth tab when there are at least ten
+        tabs, and the last tab otherwise. A tab number greater than the tab count
+        does nothing.
+
+        Args:
+            tab_number (int): The 1-based position, or 0 for the tenth or last tab.
+        """
+        count = len(self._tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self._tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The tab name to find.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list, or 0
+                when no tab has the name.
+        """
+        for index, tab in enumerate(self._tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with a name. This is the action of a tab's click range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
