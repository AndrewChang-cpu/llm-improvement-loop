diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..6daa9ed
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,413 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..reactive import Reactive
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = tuple("0123456789")
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tuple[str, str]]:
+    """Compute the displayed tabs as ``(name, label)`` pairs.
+
+    There is one entry per distinct name. Each entry takes the position of the
+    first tab with that name and the label of the last tab with that name.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        List[Tuple[str, str]]: The displayed ``(name, label)`` pairs in display order.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return list(labels.items())
+
+
+@dataclass
+class _TabEdge:
+    """A layout edge for one part of a tab, consumed by ``layout_resolve``."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _click_style(tab_name: str) -> Style:
+    return Style(meta={"@click": f"range_clicked('{tab_name}')"})
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    The label row lays out a padded span per displayed tab. The underline bar
+    highlights the label range under the bar position and carries a click range
+    for each displayed tab.
+
+    Args:
+        tabs (List[Tab]): The full tab list. Displayed tabs are derived from it.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): Fractional index of the underline into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' spans.
+        tab_padding (int | None): Fixed size of each padding edge, or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _TabEdge:
+        if self.tab_padding:
+            return _TabEdge(size=self.tab_padding)
+        return _TabEdge()
+
+    def _highlight_range(
+        self, names: List[str], label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position.
+
+        Args:
+            names (List[str]): Names of the displayed tabs in display order.
+            label_ranges (Dict[str, Tuple[int, int]]): Label range of each tab.
+
+        Returns:
+            Tuple[float, float]: The highlight range in columns.
+        """
+        count = len(names)
+        if count == 0:
+            return (0, 0)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = floor_position % count
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[names[index]]
+        start_b, end_b = label_ranges[names[next_index]]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        names = [name for name, _ in displayed]
+
+        edges: List[_TabEdge] = []
+        for _name, label in displayed:
+            edges.append(self._padding_edge())
+            edges.append(_TabEdge(size=cell_len(label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        x = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_width, right = sizes[3 * index : 3 * index + 3]
+            label_ranges[name] = (x + left, x + left + label_width)
+            selection_ranges[name] = (x, x + left + label_width + right)
+            x += left + label_width + right
+
+            padded = " " * left + label + " " * right
+            if name == self.active_tab_name:
+                yield Segment(padded, active_style)
+            else:
+                text = Text(
+                    padded,
+                    style=inactive_style + _click_style(name),
+                    end="",
+                    no_wrap=True,
+                    overflow="ignore",
+                )
+                yield from console.render(
+                    Opacity(text, self.inactive_text_opacity), options
+                )
+
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(names, label_ranges),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A tab is selected with the keyboard or the mouse. Selection and activation are
+    identified by tab name.
+
+    Args:
+        tabs (list[Tab]): The tabs to show. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            None, which selects the first tab.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive
+            labels, where 1.0 is fully visible and 0.0 matches the background.
+            Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to None, which fits the labels across the widget width.
+        search_by_first_character (bool, optional): True to activate the next tab whose
+            label starts with a pressed character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            active_name: str | None = None
+        elif active_tab:
+            active_name = active_tab
+        else:
+            active_name = tabs[0].name
+        self._active_tab_name = active_name
+        self._bar_position = float(self._bar_index(active_name))
+
+    def _bar_index(self, tab_name: str | None) -> int:
+        """Find the index of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The displayed index of the name, or 0 when it is not displayed.
+        """
+        names = [name for name, _ in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._bar_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name in the full tab list.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, and ignores the active tab.
+        The comparison is case-insensitive. The active tab does not change when no
+        other tab matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        A tab number greater than the tab count is ignored. Tab number 0 activates
+        the 10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0 for the 10th or last tab.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. Invoked by clicks on a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        The event is always marked handled, without stopping its propagation, so
+        application bindings still receive keys. With no tabs, nothing else happens.
+
+        - Escape removes focus from the widget.
+        - Right and Left activate the next and previous tab, wrapping at either end.
+        - The digit keys 1 to 9 activate the tab at that 1-based position, and 0
+          follows the rule of ``activate_tab_by_number``. Other digits are ignored.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab whose label starts with it, case-insensitively.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
