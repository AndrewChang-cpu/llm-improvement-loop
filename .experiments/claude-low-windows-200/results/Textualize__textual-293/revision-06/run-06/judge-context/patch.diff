@@ -0,0 +1,143 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable) -> list:
+    """Render a renderable with the render helper and return its plain text lines."""
+    return ANSI_PATTERN.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_text_form_is_label():
+    assert str(Tab("Home", "home")) == "Home"
+
+
+def test_tab_representation_shows_label_and_name():
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_tab_equality_compares_label_and_name():
+    assert Tab("A") == Tab("A", "A")
+    assert Tab("A") != Tab("A", "b")
+
+
+def test_construction_with_empty_tab_list_succeeds():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+
+
+def test_construction_with_tabs_uses_first_tab_as_active():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_name_is_used_when_given():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_name_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_for_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_tab_when_ten_or_more():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_char_search_is_case_insensitive_and_skips_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_width_underline():
+    tabs = Tabs([])
+    assert plain_lines(tabs.render()) == ["", "━" * 100]
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")], tab_padding=1)
+    lines = plain_lines(tabs.render())
+    # Displayed tabs: "x" with label "Three", then "y" with label "Two".
+    assert lines[0] == " Three  Two "
+
+
+def test_auto_fit_label_row_shares_flexible_edges():
+    # Two one-cell labels across 100 columns. Four flexible padding edges share
+    # 100 - 2 = 98 cells, so each gets 24.5. The whole-cell parts are 24 and 25,
+    # with the leftover carried forward: [24, 1, 25, 24, 1, 25].
+    tabs = Tabs([Tab("A"), Tab("B")])
+    lines = plain_lines(tabs.render())
+    assert lines[0] == " " * 24 + "A" + " " * 49 + "B" + " " * 25
+
+
+def test_underline_highlights_active_tab_span():
+    # Active tab "A" has the label range (24, 25) in the auto-fit row above.
+    # Half-cell glyphs sit at the highlight edges that are not at the bar ends.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    lines = plain_lines(tabs.render())
+    assert lines[1] == "━" * 23 + "╸" + "━" + "╺" + "━" * 74
+
+
+def test_inactive_label_carries_click_action_and_active_label_does_not():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+    active_segment = next(segment for segment in segments if "A" in segment.text)
+    inactive_segment = next(segment for segment in segments if "B" in segment.text)
+    assert "@click" not in active_segment.style.meta
+    assert inactive_segment.style.meta == {"@click": "range_clicked('B')"}
