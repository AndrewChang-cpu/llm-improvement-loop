+def test_clickable_ranges_attach_click_metadata_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (2, 4)},
+        width=6,
+    )
+    items = render_items(bar)
+    assert len(items) == 1
+    item = items[0]
+    assert isinstance(item, Text)
+    first, second = item.spans[-2], item.spans[-1]
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": "range_clicked('one')"}
+    assert (second.start, second.end) == (2, 4)
+    assert second.style.meta == {"@click": "range_clicked('two')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (4, 2), (-5, -2)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"one": (0, 2)},
+        width=6,
+    )
+    items = render_items(bar)
+    assert len(items) == 1
+    item = items[0]
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    for span in item.spans:
+        assert "@click" not in span.style.meta
+
