+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+BAR_WIDTH = 100
+
+
+def plain(output):
+    return ANSI_ESCAPE.sub("", output)
+
+
+def rows(tabs):
+    return plain(render(tabs.render())).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+
+
+def test_tab_keeps_explicit_name():
+    tab = Tab("Home", "home-tab")
+    assert tab.label == "Home"
+    assert tab.name == "home-tab"
+
+
+def test_tab_equality_compares_label_and_name():
+    assert Tab("A", "a") == Tab("A", "a")
+    assert Tab("A", "a") != Tab("A", "b")
+    assert Tab("A", "a") != Tab("B", "a")
+
+
+def test_tab_text_form_is_label():
+    assert str(Tab("Home", "home-tab")) == "Home"
+
+
+def test_tab_repr_shows_label_and_name():
+    assert repr(Tab("Home", "home-tab")) == "Tab(label='Home', name='home-tab')"
+
+
+def test_tabs_render_returns_tabs_renderable():
+    assert isinstance(Tabs([Tab("A")]).render(), TabsRenderable)
+
+
+def test_construction_with_empty_tab_list_succeeds():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_empty_tabs_render_empty_label_row_and_full_inactive_bar():
+    assert rows(Tabs([])) == ["", "━" * BAR_WIDTH]
+
+
+def test_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_given_active_tab_is_used():
+    tabs = Tabs([Tab("A"), Tab("B", "b")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_index():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    assert tabs.find_tab_by_name("C") == 2
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+
+
+def test_find_tab_by_name_unknown_returns_zero():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_tab_wraps_at_end():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_previous_tab_wraps_at_start():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_selects_last():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    names = [f"t{index}" for index in range(1, 11)]
+    tabs = Tabs([Tab(name) for name in names])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_activate_tab_by_number_beyond_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+
+
+def test_first_char_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "apricot"
+
+
+def test_first_char_search_wraps_around():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot")], active_tab="apricot")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Alpha"), Tab("Beta")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Alpha"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Alpha"
+
+
+def test_action_range_clicked_sets_named_tab_active():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_label_row_with_fixed_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    label_row, bar_row = rows(tabs)
+    assert label_row == " One  Two "
+    assert bar_row[0] == "╸"
+    assert bar_row[1:4] == "━━━"
+    assert bar_row[4] == "╺"
+
+
+def test_label_row_with_auto_fit_padding():
+    # Width 100 minus the labels "A" and "BB" leaves 97 cells for four flexible
+    # padding edges. Each gets 24.25 cells, and the fractional part carries forward,
+    # so the shares are 24, 24, 24 and 25.
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    label_row = rows(tabs)[0]
+    assert label_row == " " * 24 + "A" + " " * 24 + " " * 24 + "BB" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    label_row, bar_row = rows(tabs)
+    assert label_row == " C  B "
+    assert bar_row[:3] == "╸━╺"
+
+
+def test_inactive_label_carries_click_action_and_is_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    console = Console(width=BAR_WIDTH, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+
+    two = [segment for segment in segments if "Two" in segment.text]
+    assert len(two) == 1
+    assert isinstance(two[0].style, Style)
+    assert two[0].style.meta == {"@click": "range_clicked('Two')"}
+    original = Color.parse("#f0f0f0").triplet
+    assert two[0].style.color.triplet != original
+
+    one = [segment for segment in segments if "One" in segment.text]
+    assert len(one) == 1
+    assert isinstance(one[0].style, Style)
+    assert "@click" not in one[0].style.meta
