diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..704c07d
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,419 @@
+from __future__ import annotations
+
+import math
+from typing import Dict, List, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab item for the Tabs widget: a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab when selecting it.
+            Defaults to ``None``, in which case the label is used as the name.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge description for the layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_labels(tabs: List[Tab]) -> Dict[str, str]:
+    """Map each distinct tab name to its displayed label.
+
+    Names keep the position of their first occurrence, and take the label of the
+    last tab with that name.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        Dict[str, str]: Mapping of tab name to label, in display order.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return labels
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): The fractional index into the full tab list that
+            places the bar.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int | None): Fixed padding in cells on each side of a label, or
+            ``None`` (or zero) to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        label_pieces, label_ranges, selection_ranges = self._layout_labels(
+            console, width
+        )
+        for piece in label_pieces:
+            yield piece
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield bar
+
+    def _layout_labels(
+        self, console: Console, width: int
+    ) -> Tuple[
+        List[RenderableType], Dict[str, Tuple[int, int]], Dict[str, Tuple[int, int]]
+    ]:
+        """Lay out the label row across the width.
+
+        Args:
+            console (Console): The console used to resolve styles.
+            width (int): The width of the label row in cells.
+
+        Returns:
+            tuple: The renderables for each displayed tab, the label range keyed by
+                tab name, and the selection range keyed by tab name.
+        """
+        displayed = list(_displayed_labels(self.tabs).items())
+
+        padding = self.tab_padding or None
+        edges: List[_Edge] = []
+        for _name, label in displayed:
+            edges.append(_Edge(size=padding))
+            edges.append(_Edge(size=cell_len(label)))
+            edges.append(_Edge(size=padding))
+        sizes = layout_resolve(width, edges)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        pieces: List[RenderableType] = []
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        position = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = position + left
+            label_end = label_start + label_width
+            span_end = label_end + right
+            label_ranges[name] = (label_start, label_end)
+            selection_ranges[name] = (position, span_end)
+            position = span_end
+
+            padded = " " * left + label + " " * right
+            if name == self.active_tab_name:
+                pieces.append(Text(padded, style=active_style, end=""))
+            else:
+                text = Text(padded, style=inactive_style, end="")
+                text.apply_meta({"@click": f"range_clicked('{name}')"})
+                pieces.append(Opacity(text, opacity=self.inactive_text_opacity))
+
+        return pieces, label_ranges, selection_ranges
+
+    def _highlight_range(
+        self, label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight range from the bar position.
+
+        Args:
+            label_ranges (Dict[str, Tuple[int, int]]): Label range keyed by tab name.
+
+        Returns:
+            tuple: The start and end columns of the highlight.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return (0, 0)
+        floor_index = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_index
+        current_name = self.tabs[floor_index % count].name
+        next_name = self.tabs[(floor_index + 1) % count].name
+        current_start, current_end = label_ranges[current_name]
+        next_start, next_end = label_ranges[next_name]
+        start = current_start + (next_start - current_start) * fraction
+        end = current_end + (next_end - current_end) * fraction
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs can be selected with the keyboard (left and right arrows, digit keys, or the
+    first character of a label) or by clicking them. The selected tab is identified by
+    name.
+
+    Args:
+        tabs (List[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function used to animate the
+            underline. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The padding in cells on each side of a label.
+            Defaults to ``None``, which fits the padding to the available width.
+        search_by_first_character (bool): Whether pressing a character key activates the
+            next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str | None): The tab name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0 if
+                no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, never selects the active
+        tab, and compares characters case-insensitively. If no other tab matches, the
+        active tab does not change.
+
+        Args:
+            char (str): The character to match against the first letter of each label.
+        """
+        count = len(self.tabs)
+        current = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(current + offset) % count]
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs, and the
+        last tab otherwise. A number greater than the tab count does nothing.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used by clicks on the tab's range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the position of the newly active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the active tab, or None.
+        """
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        The event is always marked handled, without stopping its propagation.
+
+        - Escape removes focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digits 0 through 9 activate a tab by its 1-based position (see
+          ``activate_tab_by_number``).
+        - Any other single character activates the next tab whose label starts with
+          that character, when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
