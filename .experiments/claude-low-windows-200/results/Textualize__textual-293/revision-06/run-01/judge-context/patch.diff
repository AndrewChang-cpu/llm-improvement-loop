diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..edb1aeb
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,442 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab shown in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab when it is
+            selected or activated. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A flexible or fixed-size edge for the shared layout resolver."""
+
+    size: int | None = None
+    fraction: int = 1
+    min_size: int = 1
+
+
+@dataclass
+class _TabSpan:
+    """The laid-out columns of one displayed tab."""
+
+    name: str
+    text: str
+    selection_range: tuple[int, int]
+    label_range: tuple[int, int]
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Compute one tab per distinct name.
+
+    The position of each entry is where its name first appears, and its label
+    comes from the last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs.
+    """
+    by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        by_name[tab.name] = tab
+    return list(by_name.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): Fractional index into the full tab list that places
+            the bar.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' text.
+        tab_padding (int | None): Fixed padding size per side, or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Lay out the displayed tabs across the width using the shared resolver.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: One entry per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        padding = (
+            self.tab_padding
+            if self.tab_padding is not None and self.tab_padding > 0
+            else None
+        )
+
+        edges: list[_Edge] = []
+        indices: list[tuple[int, int | None, int]] = []
+        for tab in displayed:
+            label_width = cell_len(tab.label)
+            left = len(edges)
+            edges.append(_Edge(size=padding))
+            label_index: int | None = None
+            if label_width > 0:
+                label_index = len(edges)
+                edges.append(_Edge(size=label_width))
+            right = len(edges)
+            edges.append(_Edge(size=padding))
+            indices.append((left, label_index, right))
+
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        position = 0
+        for tab, (left, label_index, right) in zip(displayed, indices):
+            left_size = sizes[left]
+            label_size = sizes[label_index] if label_index is not None else 0
+            right_size = sizes[right]
+            label_start = position + left_size
+            label_end = label_start + label_size
+            span_end = label_end + right_size
+            text = " " * left_size + tab.label + " " * right_size
+            spans.append(
+                _TabSpan(
+                    name=tab.name,
+                    text=text,
+                    selection_range=(position, span_end),
+                    label_range=(label_start, label_end),
+                )
+            )
+            position = span_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            spans (list[_TabSpan]): The laid-out displayed tabs.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        if not self.tabs:
+            return (0, 0)
+        label_ranges = {span.name: span.label_range for span in spans}
+        count = len(self.tabs)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        floor_index = int(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+
+        start_from, end_from = label_ranges[self.tabs[floor_index].name]
+        start_to, end_to = label_ranges[self.tabs[next_index].name]
+        start = start_from + (start_to - start_from) * fraction
+        end = end_from + (end_to - end_from) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        spans = self._layout(width)
+
+        for span in spans:
+            if span.name == self.active_tab_name:
+                yield Text(
+                    span.text, style=active_tab_style, no_wrap=True, end=""
+                )
+            else:
+                text = Text(span.text, style=inactive_tab_style, no_wrap=True, end="")
+                text.apply_meta(
+                    {"@click": f"range_clicked('{span.name}')"}, 0, len(span.text)
+                )
+                yield Opacity(text, opacity=self.inactive_text_opacity)
+
+        yield Segment.line()
+
+        clickable_ranges = {span.name: span.selection_range for span in spans}
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Clicking a tab, or pressing its number or first letter, makes it active. The
+    left and right arrow keys move between tabs and wrap at either end.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            None, which selects the first tab.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the underline beneath the
+            active tab. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of the inactive tabs'
+            labels. Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tabs' text. Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the underline
+            animation. Defaults to 0.3.
+        animation_function (str, optional): The easing function name used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            Defaults to None, which fits the labels across the width.
+        search_by_first_character (bool, optional): Whether pressing a key that is not a
+            digit or an arrow activates the next tab whose label starts with that
+            character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+
+        self._bar_position = (
+            float(self.find_tab_by_name(initial_name)) if initial_name else 0.0
+        )
+        self._active_tab_name = initial_name
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The tab name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0 if no
+                tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, compares case-insensitively,
+        and never selects the active tab. The active tab is kept if no other tab
+        matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A tab number greater than the tab count does nothing. Tab number 0 activates
+        the 10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0 for the rule above.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the target of tab click actions.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            tab_name (str | None): The name of the new active tab.
+        """
+        target = self.find_tab_by_name(tab_name) if tab_name is not None else 0
+        self.animate(
+            "_bar_position",
+            float(target),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the Tabs widget has focus.
+
+        Every key event is marked handled, and propagation is not stopped, so app
+        bindings still receive keys. With no tabs, nothing else happens. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Left and Right move to the previous and next tab, wrapping at either end.
+        - The digits 0 to 9 activate a tab by position, following
+          ``activate_tab_by_number``.
+        - Any other single character activates the next tab whose label starts with
+          it, if ``search_by_first_character`` is True.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1 and key.isprintable():
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
