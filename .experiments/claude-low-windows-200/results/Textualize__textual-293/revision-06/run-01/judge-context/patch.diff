+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_PATTERN = re.compile(r"\x1b\[[0-9;]*m")
+INACTIVE_TEXT = "#f0f0f0"
+
+
+def plain_render(renderable):
+    return ANSI_PATTERN.sub("", render(renderable))
+
+
+def make_renderable(tabs, active="Home", bar_position=0.0, tab_padding=2):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def segments_for(renderable):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def find_segment(segments, text):
+    matches = [segment for segment in segments if segment.text == text]
+    assert len(matches) == 1
+    return matches[0]
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_with_explicit_name():
+    tab = Tab("Home", "start")
+    assert tab.label == "Home"
+    assert tab.name == "start"
+    assert tab == Tab("Home", "start")
+    assert tab != Tab("Home")
+    assert "label='Home'" in repr(tab)
+    assert "name='start'" in repr(tab)
+
+
+def test_construct_with_default_styles():
+    tabs = Tabs([Tab("Home"), Tab("Files")])
+    assert tabs.tabs == [Tab("Home"), Tab("Files")]
+    assert isinstance(tabs.render(), TabsRenderable)
+
+
+def test_construct_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+    assert plain_render(tabs.render()).split("\n")[0] == ""
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("B") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_given_name():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    assert tabs._active_tab_name == "C"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_with_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado"), Tab("cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_row_layout():
+    lines = plain_render(make_renderable([], active=None)).split("\n")
+    assert lines[0] == ""
+    assert lines[1] == "━" * 100
+
+
+def test_fixed_padding_label_row():
+    tabs = [Tab("Home"), Tab("Files"), Tab("Settings")]
+    lines = plain_render(make_renderable(tabs, tab_padding=2)).split("\n")
+    assert lines[0] == "  Home    Files    Settings  "
+
+
+def test_auto_fit_padding_label_row():
+    # Width 100 with labels "Home" (4) and "Files" (5) leaves 91 cells for four
+    # flexible pads, so the share is 22.75 per pad. The resolver gives the first
+    # pad 22 with 0.75 carried forward, then 23 (0.5 carried), 23 (0.25 carried),
+    # and 23. The row is therefore 22 + 4 + 23 + 23 + 5 + 23 = 100 cells.
+    tabs = [Tab("Home"), Tab("Files")]
+    expected = " " * 22 + "Home" + " " * 23 + " " * 23 + "Files" + " " * 23
+    lines = plain_render(make_renderable(tabs, tab_padding=None)).split("\n")
+    assert lines[0] == expected
+
+
+def test_underline_highlights_active_tab_cells():
+    tabs = [Tab("Home"), Tab("Files")]
+    rendered = make_renderable(tabs, active="Home", tab_padding=2)
+    bar = plain_render(rendered).split("\n")[1]
+    # The active label "Home" sits at columns 2 to 6, so the highlight covers 2 to 6.
+    assert bar[1] == "╸"
+    assert bar[2:6] == "━━━━"
+    assert bar[6] == "╺"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("A", "x"), Tab("B"), Tab("C", "x")]
+    lines = plain_render(make_renderable(tabs, active="x", tab_padding=1)).split("\n")
+    assert lines[0] == " C  B "
+    assert lines[1][:3] == "╸━╺"
+
+
+def test_inactive_padded_span_is_dimmed_and_carries_click_action():
+    tabs = [Tab("Home"), Tab("Files")]
+    segments = segments_for(make_renderable(tabs, active="Home", tab_padding=2))
+
+    inactive = find_segment(segments, "  Files  ")
+    assert isinstance(inactive.style, Style)
+    assert inactive.style.meta == {"@click": "range_clicked('Files')"}
+    assert inactive.style.color.triplet != Color.parse(INACTIVE_TEXT).triplet
+
+
+def test_active_label_has_no_click_action():
+    tabs = [Tab("Home"), Tab("Files")]
+    segments = segments_for(make_renderable(tabs, active="Home", tab_padding=2))
+
+    active = find_segment(segments, "  Home  ")
+    assert isinstance(active.style, Style)
+    assert "@click" not in active.style.meta
