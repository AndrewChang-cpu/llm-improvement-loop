+class _Console:
+    """Minimal console double: only get_style is needed by UnderlineBar."""
+
+    def get_style(self, style):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+class _Options:
+    """Minimal options double: UnderlineBar reads max_width only as a fallback."""
+
+    max_width = 6
+
+
+def _first_item(bar):
+    items = list(bar.__rich_console__(_Console(), _Options()))
+    return items[0]
+
+
+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (2, 6)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(_Console(), _Options()))
+
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    assert text.plain == "━╸━━╺━"
+    first, second = text.spans[-2:]
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert (second.start, second.end) == (2, 6)
+    assert second.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_middle_highlight_plain_text_has_edge_half_glyphs():
+    # One bar, right-half glyph, two highlighted bars, left-half glyph, one bar
+    text = _first_item(UnderlineBar(highlight_range=(2, 4), width=6))
+    assert text.plain == "━╸━━╺━"
+
+
+def test_zero_width_early_path_yields_only_background_text():
+    bar = UnderlineBar(clickable_ranges={"only": (0, 6)}, width=6)
+    text = _first_item(bar)
+    assert text.plain == "━━━━━━"
+    assert text.spans == []
+
+
+def test_reversed_highlight_takes_early_path_without_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(5, 2),
+        clickable_ranges={"only": (0, 6)},
+        width=6,
+    )
+    text = _first_item(bar)
+    assert text.plain == "━━━━━━"
+    assert text.spans == []
+
+
+def test_zero_width_highlight_at_nonzero_position_keeps_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"only": (0, 6)},
+        width=6,
+    )
+    text = _first_item(bar)
+    # Two bars, right-half glyph, left-half glyph, two bars
+    assert text.plain == "━━╸╺━━"
+    assert text.spans[-1].style.meta == {"@click": "range_clicked('only')"}
