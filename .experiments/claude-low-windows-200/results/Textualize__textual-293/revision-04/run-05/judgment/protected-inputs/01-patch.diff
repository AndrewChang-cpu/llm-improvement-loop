+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def rows_of(segments):
+    """Split a segment stream into rows at line-break segments."""
+    rows = [[]]
+    for segment in segments:
+        if segment.text == "\n":
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    return rows
+
+
+def click_per_cell(row):
+    """The click action (or None) of every cell in a row of segments."""
+    actions = []
+    for segment in row:
+        meta = segment.style.meta if segment.style else {}
+        actions.extend([meta.get("@click")] * len(segment.text))
+    return actions
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "one").name == "one"
+
+
+def test_tab_str_is_label():
+    assert str(Tab("One", "one")) == "One"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("a") == Tab("a", "a")
+    assert Tab("a", "x") != Tab("a", "y")
+
+
+def test_tab_repr_shows_both_fields():
+    representation = repr(Tab("One", "one"))
+    assert "label='One'" in representation
+    assert "name='one'" in representation
+
+
+def test_construct_with_default_styles_and_no_tabs():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+
+
+def test_construct_with_default_styles_and_tabs():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_bar_position_matches_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], active_tab="Three")
+    assert tabs._active_tab_name == "Three"
+    assert tabs._bar_position == 2.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("A2", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_selects_last():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_number_beyond_count_changes_nothing():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "One"
+
+
+def test_first_char_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("apricot")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_with_no_match_changes_nothing():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("First", "x"), Tab("Second", "y"), Tab("Third-label", "x")],
+        tab_padding=1,
+    )
+    label_row = plain(tabs.render()).split("\n")[0]
+    # Position of the first "x" tab, label of the last "x" tab
+    assert label_row == " Third-label  Second "
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    lines = plain(Tabs([]).render()).split("\n")
+    assert lines == ["", "━" * 100]
+
+
+def test_auto_fit_padding_follows_layout_rule():
+    # Labels take 3 + 3 + 5 = 11 cells, leaving 89 cells for six padding edges.
+    # Shares are 14, 15, 15, 15, 15, 15 (the fractional leftover is carried on),
+    # in the order left1, right1, left2, right2, left3, right3.
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    expected = (
+        " " * 14 + "One" + " " * 15 + " " * 15 + "Two" + " " * 15 + " " * 15
+        + "Three" + " " * 15
+    )
+    assert plain(tabs.render()).split("\n")[0] == expected
+
+
+def test_active_tab_has_no_click_and_inactive_tab_has_its_click():
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    rows = rows_of(console.render(tabs.render()))
+
+    label_row = rows[0]
+    assert click_per_cell(label_row) == [None] * 5 + ["range_clicked('Two')"] * 5
+
+
+def test_inactive_label_is_dimmed_and_keeps_padding_cells():
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    label_row = rows_of(console.render(tabs.render()))[0]
+
+    inactive = label_row[-1]
+    assert inactive.text == " Two "
+    assert inactive.style.color.triplet != (240, 240, 240)
+
+
+def test_underline_cells_carry_click_for_each_displayed_tab():
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One", tab_padding=1)
+    underline_row = rows_of(console.render(tabs.render()))[1]
+
+    clicks = click_per_cell(underline_row)
+    assert clicks[:5] == ["range_clicked('One')"] * 5
+    assert clicks[5:10] == ["range_clicked('Two')"] * 5
