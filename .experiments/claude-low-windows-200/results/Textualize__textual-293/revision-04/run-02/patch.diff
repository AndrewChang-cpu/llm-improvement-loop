+++ b/tests/widgets/test_tabs.py
@@ -0,0 +1,172 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.renderables.opacity import Opacity
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def make_tabs(names, **kwargs) -> Tabs:
+    return Tabs([Tab(name) for name in names], **kwargs)
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert str(Tab("Home", "home")) == "Home"
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "home") != Tab("Home")
+    assert repr(Tab("Home", "home")) == "Tab(label='Home', name='home')"
+
+
+def test_construct_with_empty_tabs_and_default_styles():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+
+
+def test_first_tab_is_active_by_default():
+    tabs = make_tabs(["Home", "Files"])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_active_tab_argument_selects_named_tab():
+    tabs = make_tabs(["Home", "Files"], active_tab="Files")
+    assert tabs._active_tab_name == "Files"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = make_tabs(["Home", "Files"], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    displayed = [(tab.label, tab.name) for tab in tabs._displayed_tabs()]
+    assert displayed == [("C", "x"), ("B", "y")]
+
+
+def test_bar_position_uses_displayed_index_for_duplicates():
+    tabs = Tabs(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x"), Tab("D", "z")],
+        active_tab="z",
+    )
+    assert tabs._bar_position == 2.0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_uses_one_based_positions():
+    tabs = make_tabs(list("ABCDE"))
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "C"
+
+
+def test_zero_selects_last_tab_when_fewer_than_ten_tabs():
+    tabs = make_tabs(list("ABCDE"))
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "E"
+
+
+def test_zero_selects_tenth_tab_when_ten_or_more_tabs():
+    tabs = make_tabs([f"T{index}" for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_char_search_is_case_insensitive_wraps_and_skips_active():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Avocado"), Tab("Banana"), Tab("apricot")],
+        active_tab="Avocado",
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_other_match_changes_nothing():
+    tabs = Tabs([Tab("Avocado"), Tab("Banana")], active_tab="Avocado")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Avocado"
+
+
+def test_action_range_clicked_activates_named_tab():
+    tabs = make_tabs(["Home", "Files"])
+    tabs.action_range_clicked("Files")
+    assert tabs._active_tab_name == "Files"
+
+
+def test_auto_fit_label_row_shares_flexible_padding():
+    # Four flexible padding edges share 100 - (4 + 5) = 91 cells: 22, 23, 23, 23.
+    tabs = make_tabs(["Home", "Files"])
+    label_row, bar_row = plain(tabs.render()).split("\n")
+    assert label_row == " " * 22 + "Home" + " " * 46 + "Files" + " " * 23
+    # The active label spans cells 22 to 26, so the underline highlights 22 to 26.
+    assert bar_row == "━" * 21 + "╸" + "━" * 4 + "╺" + "━" * 73
+
+
+def test_fixed_padding_label_row_and_underline():
+    tabs = make_tabs(["Home", "Files"], tab_padding=1)
+    label_row, bar_row = plain(tabs.render()).split("\n")
+    assert label_row == " Home  Files "
+    # The active label spans cells 1 to 5 of the bar.
+    assert bar_row == "╸" + "━" * 4 + "╺" + "━" * 94
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_underline():
+    assert plain(Tabs([]).render()) == "\n" + "━" * 100
+
+
+def test_inactive_tabs_are_dimmed_and_carry_click_action():
+    tabs = make_tabs(["Home", "Files"], tab_padding=1)
+    console = Console(width=100, file=io.StringIO())
+    items = list(tabs.render().__rich_console__(console, console.options))
+
+    active_label, inactive_label = items[0], items[1]
+    assert not any(span.style.meta for span in active_label.spans)
+    assert isinstance(inactive_label, Opacity)
+    assert inactive_label.opacity == 0.5
+    assert inactive_label.renderable.spans[-1].style.meta == {
+        "@click": "range_clicked('Files')"
+    }
+
+
+def test_underline_clickable_ranges_cover_padded_span_of_every_tab():
+    tabs = make_tabs(["Home", "Files"], tab_padding=1)
+    console = Console(width=100, file=io.StringIO())
+    items = list(tabs.render().__rich_console__(console, console.options))
+
+    bar = items[-1]
+    assert isinstance(bar, UnderlineBar)
+    assert bar.clickable_ranges == {"Home": (0, 6), "Files": (6, 13)}
