diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..f51d0de
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,433 @@
+from __future__ import annotations
+
+import math
+from typing import Optional
+
+from rich.cells import cell_len
+from rich.console import RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabEdge:
+    """A layout edge for the tab row, consumed by ``layout_resolve``.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    The width arithmetic lives here. The label row and the underline bar are produced
+    from the same layout pass, so the clickable ranges match the drawn labels.
+
+    Args:
+        tabs (list[Tab]): The displayed tabs, one per distinct name, in display order.
+        active_tab_name (str, optional): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' text.
+        tab_padding (int, optional): Fixed cells on each side of a label, or ``None``
+            (or zero) to auto-fit the padding.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _TabEdge:
+        if self.tab_padding and self.tab_padding > 0:
+            return _TabEdge(size=self.tab_padding)
+        return _TabEdge(size=None, min_size=1, fraction=1)
+
+    def _layout(
+        self, width: int
+    ) -> tuple[list, list[tuple[int, int]], dict[str, tuple[int, int]]]:
+        """Lay out the tabs across ``width`` cells.
+
+        Returns:
+            tuple: The label pieces in display order, the label range of each tab, and
+                the selection range of each tab keyed by name.
+        """
+        label_widths = [cell_len(tab.label) for tab in self.tabs]
+
+        edges: list[_TabEdge] = []
+        for label_width in label_widths:
+            edges.append(self._padding_edge())
+            # A zero-width label has no edge, because size 0 would read as flexible
+            if label_width:
+                edges.append(_TabEdge(size=label_width))
+            edges.append(self._padding_edge())
+
+        sizes = layout_resolve(width, edges)
+
+        pieces: list = []
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+
+        index = 0
+        cursor = 0
+        for tab, label_width in zip(self.tabs, label_widths):
+            left_pad = sizes[index]
+            index += 1
+            if label_width:
+                index += 1
+            right_pad = sizes[index]
+            index += 1
+
+            label_start = cursor + left_pad
+            label_end = label_start + label_width
+            span_end = label_end + right_pad
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (cursor, span_end)
+            cursor = span_end
+
+            # The padded span is one run of text, so padding shares the label's style
+            padded = " " * left_pad + tab.label + " " * right_pad
+            if tab.name == self.active_tab_name:
+                pieces.append(
+                    Text(padded, style=self.active_tab_style, no_wrap=True, end="")
+                )
+            else:
+                text = Text(
+                    padded, style=self.inactive_tab_style, no_wrap=True, end=""
+                )
+                text.stylize(
+                    Style(meta={"@click": f"range_clicked('{tab.name}')"}),
+                )
+                pieces.append(Opacity(text, opacity=self.inactive_text_opacity))
+
+        return pieces, label_ranges, selection_ranges
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the position."""
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(math.floor(position))
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[index]
+        start_b, end_b = label_ranges[next_index]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(self, console, options):
+        width = options.max_width
+        pieces, label_ranges, selection_ranges = self._layout(width)
+
+        for piece in pieces:
+            yield piece
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    A tab is selected with the keyboard or the mouse. The selection is identified by
+    tab name, not by position.
+
+    Args:
+        tabs (list[Tab]): The tabs to show. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. A name that matches no tab is kept
+            as given, and the underline then sits at index 0.
+        active_tab_style (StyleType, optional): Style of the active tab's label and
+            padding. Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs' labels and
+            padding. Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio used to dim inactive tabs,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation, in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to ``None``, which auto-fits the padding across the width. Zero is
+            treated the same as ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character. Defaults to
+            ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[Optional[str]] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            self._active_tab_name = None
+        elif active_tab:
+            self._active_tab_name = active_tab
+        else:
+            self._active_tab_name = self.tabs[0].name
+        self._bar_position = float(self._displayed_index(self._active_tab_name))
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """Compute the displayed tabs: one per distinct name.
+
+        Each entry takes the position of the first tab with that name, and the label of
+        the last tab with that name.
+        """
+        displayed: dict[str, Tab] = {}
+        for tab in self.tabs:
+            # Re-assigning an existing key keeps its first position
+            displayed[tab.name] = tab
+        return list(displayed.values())
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a name among the displayed tabs, or 0 if it is absent."""
+        names = [tab.name for tab in self._displayed_tabs()]
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name in the full tab list.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name)  # type: ignore[arg-type]
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name)  # type: ignore[arg-type]
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It is case-insensitive, and it
+        never selects the active tab. If no other tab matches, nothing changes.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        current = self.find_tab_by_name(self._active_tab_name)  # type: ignore[arg-type]
+        wanted = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(current + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        Args:
+            tab_number (int): The 1-based tab number. ``0`` selects the 10th tab when
+                there are at least ten tabs, and the last tab otherwise. A number larger
+                than the tab count does nothing.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab whose clickable range was clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        This handler is synchronous and always marks the event handled without
+        stopping its propagation, so application bindings still receive keys.
+
+        With no tabs, nothing else happens. Otherwise:
+
+        - Escape requests focus removal by calling ``app.set_focus(None)``. The call
+          is not awaited, so it has no effect as written.
+        - Right and left move to the next and previous tab, wrapping at either end.
+        - The characters ``0`` through ``9`` are digit keys. ``1`` through ``9``
+          activate the tab at that 1-based position, and ``0`` follows the rule of
+          ``activate_tab_by_number``. Other characters, including superscript or
+          circled numerals, are not digit keys.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab whose label starts with it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if self.tabs:
+            key = event.key
+            if key == "escape":
+                self.app.set_focus(None)
+            elif key == "right":
+                self.activate_next_tab()
+            elif key == "left":
+                self.activate_previous_tab()
+            elif len(key) == 1 and key in DIGITS:
+                self.activate_tab_by_number(int(key))
+            elif self.search_by_first_character and len(key) == 1:
+                self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        """Render the label row and the underline bar.
+
+        Returns:
+            RenderableType: A TabsRenderable for the current state.
+        """
+        return TabsRenderable(
+            tabs=self._displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
