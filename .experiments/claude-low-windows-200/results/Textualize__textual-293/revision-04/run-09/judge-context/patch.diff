diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..937d5b6
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,433 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Dict, List, NamedTuple, Optional, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class Tab:
+    """A tab for the `Tabs` widget: a display label paired with a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to select and activate the tab. Defaults to
+            the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """An edge for the shared layout resolver, describing one tab segment."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+class _TabLayout(NamedTuple):
+    """Resolved cell positions for one displayed tab."""
+
+    name: str
+    label: str
+    run: str
+    selection_range: Tuple[int, int]
+    label_range: Tuple[int, int]
+    left_padding: int
+    right_padding: int
+
+
+def _displayed_tabs(tabs: List[Tab]) -> List[Tab]:
+    """Compute the displayed tabs: one per distinct name.
+
+    The position of each entry is where its name first appears, and its label
+    comes from the last tab with that name.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The displayed tabs.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its first position
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a `Tabs` widget.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): Fractional index into the full tab list that places the
+            underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' text.
+        tab_padding (int, optional): Fixed padding on each side of a label, or ``None``
+            to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout_tabs(self, total: int) -> List[_TabLayout]:
+        """Compute the padded span and label range of each displayed tab.
+
+        Args:
+            total (int): The width available for the label row.
+
+        Returns:
+            List[_TabLayout]: One entry per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        if self.tab_padding and self.tab_padding > 0:
+            padding_edge = _TabEdge(size=self.tab_padding)
+        else:
+            padding_edge = _TabEdge()
+
+        label_widths = [cell_len(tab.label) for tab in displayed]
+        edges: List[_TabEdge] = []
+        for label_width in label_widths:
+            edges.append(padding_edge)
+            if label_width:
+                edges.append(_TabEdge(size=label_width))
+            edges.append(padding_edge)
+
+        sizes = iter(layout_resolve(total, edges))
+        layouts: List[_TabLayout] = []
+        cursor = 0
+        for tab, label_width in zip(displayed, label_widths):
+            left = next(sizes)
+            label = next(sizes) if label_width else 0
+            right = next(sizes)
+            span_end = cursor + left + label + right
+            layouts.append(
+                _TabLayout(
+                    name=tab.name,
+                    label=tab.label,
+                    run=" " * left + tab.label + " " * right,
+                    selection_range=(cursor, span_end),
+                    label_range=(cursor + left, cursor + left + label),
+                    left_padding=left,
+                    right_padding=right,
+                )
+            )
+            cursor = span_end
+        return layouts
+
+    def _highlight_range(
+        self, layouts: List[_TabLayout]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            layouts (List[_TabLayout]): The resolved tabs.
+
+        Returns:
+            Tuple[float, float]: The highlight range in columns.
+        """
+        count = len(self.tabs)
+        if not count or not layouts:
+            return (0, 0)
+        label_ranges = {layout.name: layout.label_range for layout in layouts}
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = min(max(floor_position, 0), count - 1)
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[self.tabs[index].name]
+        start_b, end_b = label_ranges[self.tabs[next_index].name]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        layouts = self._layout_tabs(width)
+
+        # Label row
+        for layout in layouts:
+            if layout.name == self.active_tab_name:
+                yield Segment(layout.run, active_style)
+            else:
+                click_style = Style(meta={"@click": f"range_clicked('{layout.name}')"})
+                text = Text(end="", no_wrap=True, overflow="crop")
+                text.append(layout.run, style=inactive_style + click_style)
+                yield from console.render(
+                    Opacity(text, opacity=self.inactive_text_opacity), options
+                )
+        yield Segment.line()
+
+        # Underline row
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(layouts),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges={
+                layout.name: layout.selection_range for layout in layouts
+            },
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are selected by keyboard (left and right, digits, or the first character
+    of a label) or by mouse click. Selection is identified by tab name.
+
+    Args:
+        tabs (List[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab's name.
+        active_tab_style (StyleType): Style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab text, from 0
+            to 1. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation, in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to ``None``, which auto-fits the labels across the width. A value
+            of zero is treated as ``None``.
+        search_by_first_character (bool): Whether pressing a non-digit character
+            activates the next tab whose label starts with it. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: List[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The tab name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab, after the active one, whose label
+        starts with a character.
+
+        The comparison is case-insensitive and wraps around. The active
+        tab is never selected. If no other tab matches, the active tab
+        does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        active_name = self._active_tab_name
+        count = len(self.tabs)
+        start = self.find_tab_by_name(active_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == active_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based number.
+
+        A number greater than the tab count is ignored. Zero activates the 10th tab
+        when there are at least ten tabs, and the last tab otherwise.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used as the click action of tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Behaviour, in order:
+
+        - With no tabs, the key is only marked handled.
+        - Escape asks the app to remove focus. The call is not awaited.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The characters 0 through 9 activate a tab by number (see
+          `activate_tab_by_number`).
+        - Any other single character activates the next tab, after the active one, whose
+          label starts with that character, when ``search_by_first_character`` is true.
+
+        Every key is marked handled. Propagation is not stopped, so application
+        bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == "escape":
+            focus = getattr(self.app, "focus", None)
+            if callable(focus):
+                focus()
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
