+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def make_renderable(tabs, active=None, position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "x")
+    assert str(Tab("Home", "h")) == "Home"
+    assert "label='Home'" in repr(Tab("Home", "h"))
+    assert "name='h'" in repr(Tab("Home", "h"))
+
+
+def test_construction_with_default_styles_succeeds_for_empty_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], active_tab="x")
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_given_name():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")], active_tab="Three")
+    assert tabs._active_tab_name == "Three"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_by_number_maps_one_based_positions():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_by_number_zero_uses_last_tab_under_ten():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_by_number_zero_uses_tenth_tab_when_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_first_character_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_first_character_search_keeps_active_when_no_other_match():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_label_row_and_bar_with_explicit_padding():
+    tabs = [Tab("One"), Tab("Two")]
+    output = plain(make_renderable(tabs, active="One", tab_padding=1))
+    label_row, bar_row = output.split("\n")
+    assert label_row == " One  Two "
+    # Highlight spans the label "One" (columns 1 to 4)
+    assert bar_row == "╸━━━╺" + "━" * 95
+
+
+def test_label_row_with_auto_fit_padding_shares_width():
+    # Four flexible padding edges share 94 cells: 23.5 each, with the
+    # fractional part carried forward (23, 24, 23, 24).
+    tabs = [Tab("One"), Tab("Two")]
+    label_row = plain(make_renderable(tabs, active="One")).split("\n")[0]
+    expected = " " * 23 + "One" + " " * 24 + " " * 23 + "Two" + " " * 24
+    assert label_row == expected
+    assert len(label_row) == 100
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")]
+    output = plain(make_renderable(tabs, active="x", tab_padding=1))
+    label_row, bar_row = output.split("\n")
+    assert label_row == " C  B "
+    # Highlight spans the displayed tab "x" (columns 1 to 2)
+    assert bar_row == "╸━╺" + "━" * 97
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    output = plain(make_renderable([], active=None))
+    label_row, bar_row = output.split("\n")
+    assert label_row == ""
+    assert bar_row == "━" * 100
