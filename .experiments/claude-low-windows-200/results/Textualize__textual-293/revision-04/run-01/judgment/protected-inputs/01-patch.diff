diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..f8627d9
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,409 @@
+from __future__ import annotations
+
+import math
+import string
+from typing import Iterable, Sequence
+
+import rich.repr
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+@rich.repr.auto
+class Tab:
+    """A tab item with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __rich_repr__(self) -> rich.repr.Result:
+        yield "label", self.label
+        yield "name", self.name
+
+    def __str__(self) -> str:
+        return self.label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+
+class _TabEdge:
+    """A layout edge for the shared resolver: a fixed size or a flexible share."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: Iterable[Tab]) -> list[Tab]:
+    """One tab per distinct name, at the first occurrence's position and with the
+    label of the last tab that has that name."""
+    return list({tab.name: tab for tab in tabs}.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full ordered tab list.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into the full tab list for the bar.
+        active_tab_style (StyleType): Style of the active tab's padded label.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded labels.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding size per side, or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(
+        self, width: int
+    ) -> tuple[
+        list[tuple[Tab, int, int, int]],
+        dict[str, tuple[int, int]],
+        dict[str, tuple[int, int]],
+    ]:
+        """Compute the padded slots, label ranges, and selection ranges.
+
+        Returns:
+            tuple: ``(slots, label_ranges, selection_ranges)`` where each slot is
+                ``(tab, left_padding, label_width, right_padding)``.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        if self.tab_padding is not None and self.tab_padding > 0:
+            padding_edge = _TabEdge(size=self.tab_padding)
+        else:
+            padding_edge = _TabEdge()
+
+        edges: list[_TabEdge] = []
+        roles: list[tuple[int, int]] = []
+        for index, tab in enumerate(displayed):
+            label_width = cell_len(tab.label)
+            edges.append(padding_edge)
+            roles.append((index, 0))
+            if label_width:
+                edges.append(_TabEdge(size=label_width))
+                roles.append((index, 1))
+            edges.append(padding_edge)
+            roles.append((index, 2))
+
+        sizes = layout_resolve(width, edges)
+        parts = [[0, 0, 0] for _ in displayed]
+        for (index, role), size in zip(roles, sizes):
+            parts[index][role] = size
+
+        slots: list[tuple[Tab, int, int, int]] = []
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        x = 0
+        for tab, (left, label, right) in zip(displayed, parts):
+            slots.append((tab, left, label, right))
+            selection_ranges[tab.name] = (x, x + left + label + right)
+            label_ranges[tab.name] = (x + left, x + left + label)
+            x += left + label + right
+        return slots, label_ranges, selection_ranges
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between label ranges around the bar position."""
+        count = len(self.tabs)
+        if count == 0:
+            return (0.0, 0.0)
+        position = self.bar_position % count
+        floor_index = math.floor(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+        start_a, end_a = label_ranges[self.tabs[floor_index].name]
+        start_b, end_b = label_ranges[self.tabs[next_index].name]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        slots, label_ranges, selection_ranges = self._layout(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for tab, left, label, right in slots:
+            run = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                run_text = Text(
+                    run, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                run_text = Opacity(
+                    Text(run, style=click_style, end="", no_wrap=True, overflow="crop"),
+                    opacity=self.inactive_text_opacity,
+                )
+            yield from console.render(run_text, options)
+
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline for the active tab.
+
+    Args:
+        tabs (list[Tab]): The ordered list of tabs. May be empty.
+        active_tab (str, optional): Name of the initially active tab. If not given
+            or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType, optional): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of
+            the underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive
+            labels, where 1 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation
+            in seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label,
+            or None to auto-fit the labels across the width. Zero is treated as
+            None. Defaults to None.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            activates the next tab whose label starts with that letter.
+            Defaults to True.
+        name (str, optional): The name of the widget. Defaults to None.
+        id (str, optional): The ID of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        super().__init__(name=name, id=id)
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str): The name to search for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0 if
+                no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab, after the active one, whose label matches a character.
+
+        The comparison is case-insensitive and wraps. The active tab is never
+        selected, and the active tab is unchanged if no other tab matches.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        current = self.find_tab_by_name(self._active_tab_name)
+        target = char.casefold()
+        for offset in range(1, count):
+            tab = self.tabs[(current + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.casefold().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        Args:
+            tab_number (int): The 1-based tab number. Zero selects the 10th tab when
+                there are at least ten tabs, and otherwise the last tab. A number
+                greater than the tab count is ignored.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Invoked by clicks on tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the widget has focus.
+
+        Every key event is marked handled, and propagation is not stopped, so
+        application bindings still receive keys. With no tabs, nothing else happens.
+
+        - Escape requests focus removal from the app.
+        - Right and left activate the next and previous tab, with wrap-around.
+        - The digits 0 through 9 activate a tab by number (see activate_tab_by_number).
+          Other characters are not digit keys.
+        - When search_by_first_character is true, any other single character
+          activates the next tab whose label starts with it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape.value:
+            # Matches the reference: the call is made without awaiting it.
+            self.app.set_focus(None)
+        elif key == Keys.Right.value:
+            self.activate_next_tab()
+        elif key == Keys.Left.value:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in string.digits:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
