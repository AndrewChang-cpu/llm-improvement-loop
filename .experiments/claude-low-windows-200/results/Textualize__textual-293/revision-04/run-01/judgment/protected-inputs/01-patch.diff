+import io
+import re
+
+from rich.console import Console
+from rich.constrain import Constrain
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _rows(renderable, width):
+    """Plain-text rows of a renderable constrained to a width."""
+    output = render(Constrain(renderable, width))
+    return ANSI_RE.sub("", output).split("\n")
+
+
+def _segments(renderable, width):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(Constrain(renderable, width)))
+
+
+def _actions(segments):
+    actions = set()
+    for segment in segments:
+        if segment.style and segment.style.meta:
+            actions.add(segment.style.meta.get("@click"))
+    return actions
+
+
+def _names(count):
+    return [Tab(f"Tab {index}", f"T{index}") for index in range(1, count + 1)]
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home")
+    assert str(Tab("Home", "h")) == "Home"
+    assert "label='Home'" in repr(Tab("Home", "h"))
+    assert "name='h'" in repr(Tab("Home", "h"))
+
+
+def test_construction_with_empty_and_default_styles():
+    assert Tabs([]).tabs == []
+    assert Tabs([Tab("A")]).tabs[0].name == "A"
+    assert "{" not in Tabs.DEFAULT_STYLES
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_given_name():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    assert tabs._active_tab_name == "C"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate_and_zero_when_missing():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_is_one_based():
+    tabs = Tabs(_names(5))
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "T3"
+
+
+def test_activate_tab_by_number_zero_uses_last_tab_below_ten():
+    tabs = Tabs(_names(5))
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T5"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_at_ten_or_more():
+    tabs = Tabs(_names(12))
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_number_beyond_count_is_ignored():
+    tabs = Tabs(_names(3), active_tab="T2")
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "T2"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [
+            Tab("Apple", "a"),
+            Tab("Avocado", "v"),
+            Tab("apricot", "ap"),
+            Tab("Banana", "b"),
+        ]
+    )
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "v"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "ap"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_leaves_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    rows = _rows(Tabs([]).render(), 10)
+    assert rows == ["", "━" * 10]
+
+
+def test_auto_fit_labels_follow_the_layout_rule():
+    # Edges: pad, A, pad, pad, BB, pad. Free width 7 over four flexible edges
+    # gives shares 1.75 each, so the whole-cell sizes are 1, 2, 2, 2.
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    rows = _rows(tabs.render(), 10)
+    assert rows[0] == " A    BB  "
+    # Highlight spans the label A at [1, 2) with half-cell glyphs at its edges.
+    assert rows[1] == "╸━╺━━━━━━━"
+
+
+def test_fixed_padding_labels_use_the_padding_size():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    rows = _rows(tabs.render(), 40)
+    assert rows[0] == " One  Two "
+
+
+def test_zero_padding_is_treated_as_auto_fit():
+    auto = _rows(Tabs([Tab("A"), Tab("BB")], tab_padding=0).render(), 10)
+    assert auto[0] == " A    BB  "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")], tab_padding=1
+    )
+    rows = _rows(tabs.render(), 40)
+    assert rows[0] == " Three  Two "
+
+
+def test_underline_sits_under_displayed_tab_with_active_duplicate_name():
+    tabs = Tabs(
+        [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")],
+        active_tab="y",
+        tab_padding=1,
+    )
+    rows = _rows(tabs.render(), 40)
+    # " Three " occupies [0, 7), so the label " Two " puts Two at [8, 11).
+    assert rows[1] == "━" * 7 + "╸" + "━━━" + "╺" + "━" * 28
+
+
+def test_inactive_label_has_click_action_and_active_does_not():
+    tabs = Tabs([Tab("Alpha", "a"), Tab("Beta", "b")])
+    segments = _segments(tabs.render(), 30)
+    alpha = [segment for segment in segments if "Alpha" in segment.text]
+    beta = [segment for segment in segments if "Beta" in segment.text]
+
+    assert alpha and beta
+    assert not alpha[0].style.meta
+    assert beta[0].style.meta == {"@click": "range_clicked('b')"}
+
+
+def test_underline_carries_click_action_for_every_displayed_tab():
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    actions = _actions(_segments(tabs.render(), 10))
+    assert "range_clicked('A')" in actions
+    assert "range_clicked('BB')" in actions
