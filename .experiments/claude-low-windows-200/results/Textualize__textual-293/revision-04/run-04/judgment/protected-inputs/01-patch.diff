diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..3dde6f2
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,440 @@
+from __future__ import annotations
+
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab item for the Tabs widget: a display label and a name.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name used to identify the tab when selecting it.
+            Defaults to ``None``, which uses the label as the name.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the tabs that are rendered: one per distinct name.
+
+    The position of each entry is where its name first appears, and its label
+    comes from the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    # Re-assigning an existing key keeps its first position but updates the value
+    return list({tab.name: tab for tab in tabs}.values())
+
+
+class _TabEdge:
+    """A layout edge for the shared layout resolver."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int | None): Fixed padding size per side, or ``None`` / zero
+            to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _TabEdge:
+        if self.tab_padding:
+            return _TabEdge(size=self.tab_padding)
+        return _TabEdge()
+
+    def _layout(
+        self, width: int, label_widths: list[int]
+    ) -> list[tuple[int, int, int]]:
+        """Split the width into (left padding, label, right padding) per tab.
+
+        Args:
+            width (int): Available width in cells.
+            label_widths (list[int]): Cell width of each displayed tab's label.
+
+        Returns:
+            list[tuple[int, int, int]]: The cell counts for each displayed tab.
+        """
+        slots: list[_TabEdge | None] = []
+        for label_width in label_widths:
+            slots.append(self._padding_edge())
+            slots.append(_TabEdge(size=label_width) if label_width else None)
+            slots.append(self._padding_edge())
+
+        # Zero-width labels are left out of the resolver and given zero cells
+        edges = [slot for slot in slots if slot is not None]
+        resolved = iter(layout_resolve(width, edges))
+        sizes = [next(resolved) if slot is not None else 0 for slot in slots]
+        return [
+            (sizes[index], sizes[index + 1], sizes[index + 2])
+            for index in range(0, len(sizes), 3)
+        ]
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (list[tuple[int, int]]): Label range of each displayed tab.
+
+        Returns:
+            tuple[float, float]: The highlight range, in columns.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0.0, 0.0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[index]
+        start_b, end_b = label_ranges[next_index]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        cells = self._layout(width, [cell_len(tab.label) for tab in displayed])
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        label_ranges: list[tuple[int, int]] = []
+        x = 0
+        for tab, (left, label, right) in zip(displayed, cells):
+            selection_end = x + left + label + right
+            selection_ranges[tab.name] = (x, selection_end)
+            label_ranges.append((x + left, x + left + label))
+            span = " " * left + tab.label + " " * right
+
+            if tab.name == self.active_tab_name:
+                yield Text(
+                    span, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                yield Opacity(
+                    Text(
+                        span,
+                        style=click_style,
+                        end="",
+                        no_wrap=True,
+                        overflow="crop",
+                    ),
+                    opacity=self.inactive_text_opacity,
+                )
+            x = selection_end
+
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A user selects a tab with the keyboard or the mouse. Tabs are identified
+    by name. Tab names need not be unique: duplicated names display once.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults
+            to ``None``, which selects the first tab.
+        active_tab_style (StyleType, optional): Style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of
+            the underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the
+            underline bar. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive
+            tab labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the bar animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by
+            the bar animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a
+            label. Defaults to ``None``, which auto-fits the labels to the width.
+            A value of zero is treated the same as ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character
+            key activates the next tab whose label starts with it. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if active_tab:
+            initial_name = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index, or 0 when the name is not displayed.
+        """
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name in the full tab list.
+
+        Args:
+            tab_name (str): The name to look up.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, compares case-insensitively,
+        and never selects the active tab. If no other tab matches, nothing changes.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        if not self.tabs:
+            return
+        needle = char.lower()
+        active_name = self._active_tab_name
+        count = len(self.tabs)
+        start = self.find_tab_by_name(active_name)
+        for step in range(1, count + 1):
+            tab = self.tabs[(start + step) % count]
+            if tab.name == active_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        Args:
+            tab_number (int): The tab number. A number greater than the tab count is
+                ignored. ``0`` selects the 10th tab when there are at least ten tabs,
+                otherwise the last tab.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used as a click action.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        Every key event is marked handled without stopping propagation, so
+        application bindings still receive it. Behavior by key:
+
+        - With no tabs, nothing else happens.
+        - ``escape`` requests focus removal by calling the app's focus method
+          with no target. The call is not awaited.
+        - ``right`` and ``left`` activate the next and previous tab, wrapping.
+        - The digit keys ``0`` through ``9`` activate a tab by number (see
+          ``activate_tab_by_number``). Only these ten characters are digits.
+        - Any other single character activates the next tab whose label starts
+          with it, if ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == "escape":
+            focus = getattr(self.app, "focus", None)
+            if callable(focus):
+                focus()
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
