diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..b4bd5d2
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,198 @@
+from __future__ import annotations
+
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def make_renderable(
+    tabs: list[Tab],
+    active_tab_name: str | None = None,
+    bar_position: float = 0.0,
+    tab_padding: int | None = None,
+) -> TabsRenderable:
+    return TabsRenderable(
+        tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def plain_rows(renderable: TabsRenderable) -> list[str]:
+    """Render at the helper's width of 100 cells and strip ANSI codes."""
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert Tab("Home") != Tab("Other")
+
+
+def test_tabs_constructs_with_default_styles_and_empty_list():
+    assert Tabs([]).tabs == []
+    assert Tabs([Tab("One"), Tab("Two")]).tabs[1].name == "Two"
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_used_when_given():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="nope")
+    assert tabs._active_tab_name == "nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_active_tab_when_there_are_no_tabs():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("A", "A2")])
+    assert tabs.find_tab_by_name("B") == 1
+    assert tabs.find_tab_by_name("A2") == 2
+    assert tabs.find_tab_by_name("missing") == 0
+
+    duplicated = Tabs([Tab("First", "x"), Tab("Middle"), Tab("Last", "x")])
+    assert duplicated.find_tab_by_name("x") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_uses_last_tab_below_ten():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_at_ten_or_more():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Berry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "Berry"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("First", "x"), Tab("Mid", "y"), Tab("Last", "x")], tab_padding=1)
+    rows = plain_rows(tabs.render())
+    assert rows[0] == " Last  Mid "
+    assert "First" not in rows[0]
+
+
+def test_auto_fit_label_row_uses_flexible_shares():
+    # Four flexible paddings share 100 - 3 = 97 cells: 24.25 each.
+    # Whole cells are 24, 24, 24, 25 with the fraction carried forward.
+    renderable = make_renderable([Tab("A"), Tab("BB")], active_tab_name="A")
+    rows = plain_rows(renderable)
+    expected = " " * 24 + "A" + " " * 48 + "BB" + " " * 25
+    assert rows[0] == expected
+    assert len(rows[0]) == 100
+
+
+def test_no_tabs_renders_empty_label_row_and_inactive_underline():
+    rows = plain_rows(make_renderable([]))
+    assert rows == ["", "━" * 100]
+
+
+def test_highlight_half_glyphs_at_edges_of_active_tab():
+    renderable = make_renderable(
+        [Tab("One"), Tab("Two")], active_tab_name="One", tab_padding=1
+    )
+    rows = plain_rows(renderable)
+    # The active span " One " is columns 0 to 4 and its label is columns 1 to 3.
+    # The highlight is (1, 3): a right-half glyph before it, then the highlighted
+    # cells, then a left-half glyph after it.
+    assert rows[1][:5] == "╸━━━╺"
+    assert rows[1][5] == "━"
+
+
+def test_inactive_label_carries_click_action_and_active_does_not():
+    tabs = [Tab("One"), Tab("Two")]
+    renderable = make_renderable(tabs, active_tab_name="One", tab_padding=1)
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(renderable, console.options))
+
+    inactive = next(segment for segment in segments if "Two" in segment.text)
+    active = next(segment for segment in segments if "One" in segment.text)
+    assert inactive.style.meta == {"@click": "range_clicked('Two')"}
+    assert active.style.meta == {}
+
+
+def test_underline_bar_clickable_ranges_cover_each_selection_range():
+    tabs = [Tab("One"), Tab("Two")]
+    renderable = make_renderable(tabs, active_tab_name="One", tab_padding=1)
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    items = list(renderable.__rich_console__(console, console.options))
+
+    bar = items[-1]
+    assert isinstance(bar, UnderlineBar)
+    assert bar.clickable_ranges == {"One": (0, 5), "Two": (5, 10)}
