+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that mounts Tabs widgets directly on the App."""
+
+    def on_mount(self):
+        """Build the demo layout here."""
+        self.mount(
+            plain=Tabs([Tab("Home"), Tab("Docs"), Tab("About")]),
+            duplicates=Tabs(
+                [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")],
+                active_tab="y",
+            ),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
