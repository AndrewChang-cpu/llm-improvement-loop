diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..17ee5b7
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,466 @@
+from __future__ import annotations
+
+import math
+from typing import NamedTuple, Sequence
+
+import rich.repr
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+DIGIT_KEYS = "0123456789"
+
+
+@rich.repr.auto
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __rich_repr__(self) -> rich.repr.Result:
+        yield "label", self.label
+        yield "name", self.name
+
+    def __str__(self) -> str:
+        return self.label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+
+class _Edge(NamedTuple):
+    """An edge description for the shared layout resolver."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+class _TabCells(NamedTuple):
+    """The resolved cells of one displayed tab."""
+
+    name: str
+    label: str
+    left_padding: int
+    right_padding: int
+    selection_range: tuple[int, int]
+    label_range: tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The displayed tabs, with one entry per distinct name.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): The style of the active tab's padded label.
+        active_bar_style (StyleType): The style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded labels.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed cells on each side of a label, or ``None``
+            to auto-fit the tabs across the width.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def layout(self, width: int) -> list[_TabCells]:
+        """Compute the cell ranges of every tab across the given width.
+
+        Each tab contributes a left padding edge, a label edge (omitted when the
+        label is empty), and a right padding edge. Padding edges are fixed when
+        ``tab_padding`` is positive and flexible otherwise.
+
+        Args:
+            width (int): The total width in cells.
+
+        Returns:
+            list[_TabCells]: The cells of each tab, in display order.
+        """
+        edges: list[_Edge] = []
+        has_label: list[bool] = []
+        for tab in self.tabs:
+            label_width = cell_len(tab.label)
+            if self.tab_padding:
+                padding_edge = _Edge(size=self.tab_padding)
+            else:
+                padding_edge = _Edge()
+            edges.append(padding_edge)
+            has_label.append(label_width > 0)
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            edges.append(padding_edge)
+
+        sizes = iter(layout_resolve(width, edges))
+        cells: list[_TabCells] = []
+        position = 0
+        for tab, label_present in zip(self.tabs, has_label):
+            left = next(sizes)
+            label = next(sizes) if label_present else 0
+            right = next(sizes)
+            label_start = position + left
+            label_end = label_start + label
+            selection_end = label_end + right
+            cells.append(
+                _TabCells(
+                    name=tab.name,
+                    label=tab.label,
+                    left_padding=left,
+                    right_padding=right,
+                    selection_range=(position, selection_end),
+                    label_range=(label_start, label_end),
+                )
+            )
+            position = selection_end
+        return cells
+
+    def _highlight_range(self, cells: list[_TabCells]) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position.
+
+        Args:
+            cells (list[_TabCells]): The resolved cells of the displayed tabs.
+
+        Returns:
+            tuple[float, float]: The start and end of the highlight in columns.
+        """
+        if not cells:
+            return (0, 0)
+        count = len(cells)
+        position = min(max(self.bar_position, 0.0), float(count))
+        index = min(int(math.floor(position)), count - 1)
+        fraction = position - index
+        current = cells[index]
+        following = cells[(index + 1) % count]
+        current_start, current_end = current.label_range
+        next_start, next_end = following.label_range
+        start = current_start + (next_start - current_start) * fraction
+        end = current_end + (next_end - current_end) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        cells = self.layout(width)
+        for cell in cells:
+            padded = " " * cell.left_padding + cell.label + " " * cell.right_padding
+            if cell.name == self.active_tab_name:
+                text = Text(
+                    padded,
+                    style=self.active_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                yield from console.render(text, options)
+            else:
+                text = Text(
+                    padded,
+                    style=self.inactive_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                text.stylize(Style(meta={"@click": f"range_clicked('{cell.name}')"}))
+                dimmed = Opacity(text, opacity=self.inactive_text_opacity)
+                yield from console.render(dimmed, options)
+
+        yield Segment.line()
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(cells),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges={cell.name: cell.selection_range for cell in cells},
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The widget occupies two rows. The first row holds the tab labels and the second
+    row holds the underline. A user can select a tab with the keyboard or the mouse.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. Tab names need not be unique.
+            Tabs that share a name are displayed once, at the position of the first
+            one, with the label of the last one.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive labels,
+            where 1.0 is fully visible and 0.0 is fully transparent. Defaults to 0.5.
+        animation_duration (float, optional): Duration in seconds of the underline
+            animation. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to ``None``, which auto-fits the tabs across the width. A value of
+            zero is treated the same as ``None``.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            activates the next tab whose label starts with that letter. Defaults to
+            ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+        super().__init__()
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """Compute the displayed tabs: one per distinct name.
+
+        The position of each entry is that of the first tab with its name, and its
+        label comes from the last tab with that name.
+
+        Returns:
+            list[Tab]: The displayed tabs in display order.
+        """
+        displayed: dict[str, Tab] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab
+        return list(displayed.values())
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a name among the displayed tabs, or 0 if absent.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index into the displayed tabs.
+        """
+        for index, tab in enumerate(self._displayed_tabs()):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name of the tab.
+
+        Returns:
+            int: The index of the first tab in the full tab list with that name, or 0
+                if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            tab_name (str | None): The name of the new active tab.
+        """
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name or "")
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name or "")
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It never selects the active
+        tab, and it compares case-insensitively. If no other tab matches, the active
+        tab does not change.
+
+        Args:
+            char (str): The character to search for.
+        """
+        if not self.tabs:
+            return
+        target = char.lower()
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name or "")
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based number.
+
+        The number 0 selects the 10th tab when there are at least ten tabs, and
+        otherwise the last tab. A number greater than the tab count does nothing.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        if not self.tabs:
+            return
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab whose clickable range was clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Escape requests focus removal. Left and Right move to the previous and next
+        tab, wrapping at either end. The keys 0 through 9 activate a tab by number,
+        with 0 following the rule of ``activate_tab_by_number``. Any other single
+        character activates the next tab whose label starts with it, when
+        ``search_by_first_character`` is true. Every key event is marked handled,
+        and propagation is not stopped, so application bindings still receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            # Matches the reference: the focus coroutine is not awaited.
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        """Build the renderable for the label row and the underline bar.
+
+        Returns:
+            RenderableType: A renderable of the two rows.
+        """
+        return TabsRenderable(
+            tabs=self._displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding or None,
+        )
