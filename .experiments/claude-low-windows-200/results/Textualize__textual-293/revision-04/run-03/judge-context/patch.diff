+from types import SimpleNamespace
+
+from rich.style import Style
+from rich.text import Text
+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
+
+class _StubConsole:
+    """Resolves style strings the way a console does, for direct bar rendering."""
+
+    def get_style(self, style):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+def _first_item(bar: UnderlineBar, width: int):
+    options = SimpleNamespace(max_width=width)
+    return next(iter(bar.__rich_console__(_StubConsole(), options)))
+
+
 MAGENTA = "\x1b[35m"
 GREY = "\x1b[38;5;59m"
 STOP = "\x1b[0m"
@@ -124,3 +142,43 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+def test_clickable_ranges_attach_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"home": (0, 3), "docs": (3, 6)},
+        width=6,
+    )
+    item = _first_item(bar, 6)
+
+    assert isinstance(item, Text)
+    # Highlight: one heavy bar, right-half glyph, two heavy bars, left-half glyph,
+    # one heavy bar.
+    assert item.plain == "━╸━━╺━"
+    home_span, docs_span = item.spans[-2], item.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
+    assert (docs_span.start, docs_span.end) == (3, 6)
+    assert docs_span.style.meta == {"@click": "range_clicked('docs')"}
+
+
+def test_zero_width_early_path_yields_background_only():
+    no_highlight = UnderlineBar(clickable_ranges={"home": (0, 3)}, width=6)
+    rejected_range = UnderlineBar(
+        highlight_range=(3, 2), clickable_ranges={"home": (0, 3)}, width=6
+    )
+    for bar in (no_highlight, rejected_range):
+        item = _first_item(bar, 6)
+        assert isinstance(item, Text)
+        assert item.plain == "━━━━━━"
+        assert all("@click" not in span.style.meta for span in item.spans)
+
+
+def test_zero_width_range_at_non_zero_position_gets_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(3, 3), clickable_ranges={"home": (0, 3)}, width=6
+    )
+    item = _first_item(bar, 6)
+    assert item.plain == "━━╸╺━━"
+    assert item.spans[-1].style.meta == {"@click": "range_clicked('home')"}
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..e1b2e82
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,230 @@
+from __future__ import annotations
+
+import io
+import re
+
+from rich.console import Console
+from rich.segment import Segment
+
+from tests.utilities.render import render
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(text: str) -> str:
+    return ANSI.sub("", text)
+
+
+def make_renderable(
+    tabs: list[Tab],
+    active: str | None = None,
+    bar_position: float = 0.0,
+    tab_padding: int | None = None,
+) -> TabsRenderable:
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def label_row_segments(renderable: TabsRenderable, width: int) -> list[Segment]:
+    """Return the segments of the first row, stopping at the line break."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    segments: list[Segment] = []
+    for item in renderable.__rich_console__(console, console.options):
+        if isinstance(item, Segment):
+            if item.text == "\n":
+                break
+            segments.append(item)
+    return segments
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_text_and_repr():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "x")
+    assert str(Tab("Home", "h")) == "Home"
+    assert "label='Home'" in repr(Tab("Home", "h"))
+    assert "name='h'" in repr(Tab("Home", "h"))
+
+
+def test_construction_with_empty_tabs_and_default_styles():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+    assert "{" not in Tabs.DEFAULT_STYLES and "}" not in Tabs.DEFAULT_STYLES
+
+
+def test_initial_active_tab():
+    assert Tabs([Tab("A"), Tab("B")])._active_tab_name == "A"
+    assert Tabs([Tab("A"), Tab("B")], active_tab="B")._active_tab_name == "B"
+
+
+def test_unknown_active_tab_is_kept_and_bar_starts_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("A2", "A")])
+    assert tabs.find_tab_by_name("A") == 0
+    assert tabs.find_tab_by_name("B") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    displayed = tabs._displayed_tabs()
+    assert [(tab.label, tab.name) for tab in displayed] == [
+        ("Three", "x"),
+        ("Two", "y"),
+    ]
+
+
+def test_next_and_previous_wrap_over_full_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_small_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"t{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_activate_tab_by_first_char_skips_active_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_fixed_padding_label_ranges():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("Docs")], active="Home", tab_padding=1
+    )
+    cells = renderable.layout(30)
+    assert cells[0].selection_range == (0, 6)
+    assert cells[0].label_range == (1, 5)
+    assert cells[1].selection_range == (6, 12)
+    assert cells[1].label_range == (7, 11)
+
+
+def test_auto_fit_padding_carries_fractional_share_forward():
+    # Width 21: four flexible padding edges share 13 cells, so each gets 3.25.
+    # Shares are 3, 3, 3, then 4 once the carried fraction reaches a whole cell.
+    renderable = make_renderable([Tab("Home"), Tab("Docs")], active="Home")
+    cells = renderable.layout(21)
+    assert cells[0].left_padding == 3
+    assert cells[0].right_padding == 3
+    assert cells[0].selection_range == (0, 10)
+    assert cells[0].label_range == (3, 7)
+    assert cells[1].left_padding == 3
+    assert cells[1].right_padding == 4
+    assert cells[1].selection_range == (10, 21)
+    assert cells[1].label_range == (13, 17)
+
+
+def test_label_row_renders_with_fixed_padding():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("Docs")], active="Home", tab_padding=1
+    )
+    first_row = plain(render(renderable)).splitlines()[0]
+    assert first_row.rstrip() == " Home  Docs"
+
+
+def test_inactive_padded_cells_carry_click_action():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("Docs")], active="Home", tab_padding=1
+    )
+    segments = label_row_segments(renderable, width=30)
+    docs_text = "".join(
+        segment.text
+        for segment in segments
+        if segment.style and segment.style.meta.get("@click")
+        == "range_clicked('Docs')"
+    )
+    assert docs_text == " Docs "
+    home_clicks = [
+        segment
+        for segment in segments
+        if segment.style and segment.style.meta.get("@click")
+    ]
+    assert all("Home" not in segment.text for segment in home_clicks)
+
+
+def test_underline_clickable_ranges_cover_every_displayed_tab():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("Docs")], active="Home", tab_padding=1
+    )
+    console = Console(width=30, file=io.StringIO(), color_system="truecolor")
+    bars = [
+        item
+        for item in renderable.__rich_console__(console, console.options)
+        if isinstance(item, UnderlineBar)
+    ]
+    assert bars[0].clickable_ranges == {"Home": (0, 6), "Docs": (6, 12)}
+
+
+def test_underline_highlight_sits_under_active_label():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("Docs")], active="Docs", bar_position=1.0, tab_padding=1
+    )
+    cells = renderable.layout(30)
+    assert renderable._highlight_range(cells) == (7, 11)
+    underline = plain(render(renderable)).splitlines()[1]
+    # Half-cell glyph before the highlight, four heavy bars, then the half glyph
+    # after it. The highlight starts at label column 7 and ends at 11.
+    assert underline[6:12] == "╸━━━━╺"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    renderable = make_renderable([], active=None, tab_padding=None)
+    lines = plain(render(renderable)).splitlines()
+    assert lines[0].strip() == ""
+    assert lines[1] == "━" * 100
+
+
+def test_duplicate_tabs_render_once():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    renderable = tabs.render()
+    assert [tab.label for tab in renderable.tabs] == ["Three", "Two"]
