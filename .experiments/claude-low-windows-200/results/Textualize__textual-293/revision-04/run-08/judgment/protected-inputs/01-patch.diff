+from rich.style import Style
+from rich.text import Text
+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
@@ -124,3 +127,51 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+class ConsoleDouble:
+    def get_style(self, style, *, default=None):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+class OptionsDouble:
+    max_width = 6
+
+
+def first_render_item(bar):
+    return next(iter(bar.__rich_console__(ConsoleDouble(), OptionsDouble())))
+
+
+def test_clickable_ranges_attach_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        width=6,
+        clickable_ranges={"home": (0, 3), "docs": (3, 6)},
+    )
+    item = first_render_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    home, docs = item.spans[-2], item.spans[-1]
+    assert (home.start, home.end) == (0, 3)
+    assert home.style.meta == {"@click": "range_clicked('home')"}
+    assert (docs.start, docs.end) == (3, 6)
+    assert docs.style.meta == {"@click": "range_clicked('docs')"}
+
+
+def test_zero_width_early_path_yields_background_only():
+    bar = UnderlineBar(
+        highlight_range=(4, 2),
+        width=6,
+        clickable_ranges={"home": (0, 3)},
+    )
+    item = first_render_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    assert item.spans == []
+
+
+def test_no_highlight_yields_background_only_without_click_spans():
+    bar = UnderlineBar(width=6, clickable_ranges={"home": (0, 3)})
+    item = first_render_item(bar)
+    assert item.plain == "━" * 6
+    assert item.spans == []
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..0a0daf8
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,138 @@
+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m|\x1b\]8;[^\x1b]*\x1b\\")
+
+
+def plain_lines(renderable) -> list[str]:
+    """Render with the test helper and strip ANSI codes, leaving the cell text."""
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "x")
+    assert Tab("Home") == Tab("Home", "Home")
+
+
+def test_tab_repr_shows_both_fields():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construct_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_construct_with_default_styles():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs.find_tab_by_name("Docs") == 1
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    assert tabs._active_tab_name == "Docs"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_keeps_name_and_bar_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "b")])
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(letter) for letter in "ABCDE"])
+    tabs.activate_tab_by_number(3)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "E"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "E"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_char_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("Dashboard"), Tab("Help")])
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Docs"
+    tabs.activate_tab_by_first_char("D")
+    assert tabs._active_tab_name == "Dashboard"
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Help"
+
+
+def test_first_char_search_without_other_match_keeps_active():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    tabs.action_range_clicked("Docs")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    lines = plain_lines(Tabs([]).render())
+    assert lines == ["", "━" * 100]
+
+
+def test_fixed_padding_label_row():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    lines = plain_lines(tabs.render())
+    assert lines[0] == " Home  Docs "
+
+
+def test_auto_fit_label_row_shares_remaining_width():
+    # Width 100: labels take 8 cells, leaving 92 for four flexible pads of 23 each.
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    lines = plain_lines(tabs.render())
+    expected = " " * 23 + "Home" + " " * 46 + "Docs" + " " * 23
+    assert lines[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("Home", "h"), Tab("Docs", "d"), Tab("Home2", "h")])
+    lines = plain_lines(tabs.render())
+    # Displayed: "Home2" (name h) then "Docs" (name d). Remaining 91 cells over four pads:
+    # shares 22, 23, 23, 23 with the fractional carry.
+    expected = " " * 22 + "Home2" + " " * 46 + "Docs" + " " * 23
+    assert lines[0] == expected
