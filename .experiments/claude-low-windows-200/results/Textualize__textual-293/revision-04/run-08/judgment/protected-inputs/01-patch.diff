diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..8b14bc3
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,464 @@
+from __future__ import annotations
+
+from typing import NamedTuple, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import LayoutEdge, layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab shown in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the tabs that are rendered: one per distinct name.
+
+    The position of each entry is where its name first appears, and its label
+    comes from the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full list of tabs.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class _TabSlot(NamedTuple):
+    """Column positions of one displayed tab."""
+
+    name: str
+    label: str
+    span_start: int
+    span_end: int
+    label_start: int
+    label_end: int
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the displayed tabs that places
+            the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the non-highlighted part of the
+            underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' text.
+        tab_padding (int | None): Fixed padding in cells, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSlot]:
+        """Work out the column span of each displayed tab.
+
+        Each displayed tab contributes a left padding edge, a label edge and a
+        right padding edge. Zero-width label edges are omitted from the resolver.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSlot]: One slot per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        edges: list[LayoutEdge] = []
+        layout_indices: list[tuple[int, int | None, int]] = []
+
+        def padding_edge() -> LayoutEdge:
+            if self.tab_padding:
+                return LayoutEdge(size=self.tab_padding)
+            return LayoutEdge()
+
+        for tab in displayed:
+            label_width = cell_len(tab.label)
+            left_index = len(edges)
+            edges.append(padding_edge())
+            label_index: int | None = None
+            if label_width:
+                label_index = len(edges)
+                edges.append(LayoutEdge(size=label_width))
+            right_index = len(edges)
+            edges.append(padding_edge())
+            layout_indices.append((left_index, label_index, right_index))
+
+        sizes = layout_resolve(width, edges) if edges else []
+
+        slots: list[_TabSlot] = []
+        cursor = 0
+        for tab, (left_index, label_index, right_index) in zip(
+            displayed, layout_indices
+        ):
+            left = sizes[left_index]
+            label_size = sizes[label_index] if label_index is not None else 0
+            right = sizes[right_index]
+            span_start = cursor
+            label_start = span_start + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+            cursor = span_end
+            slots.append(
+                _TabSlot(
+                    tab.name,
+                    tab.label,
+                    span_start,
+                    span_end,
+                    label_start,
+                    label_end,
+                )
+            )
+        return slots
+
+    def _highlight_range(self, slots: list[_TabSlot]) -> tuple[float, float]:
+        """Interpolate the highlight from the label ranges at the bar position.
+
+        Args:
+            slots (list[_TabSlot]): The displayed tab slots.
+
+        Returns:
+            tuple[float, float]: The highlight range in columns.
+        """
+        if not slots:
+            return (0, 0)
+        count = len(slots)
+        position = min(max(self.bar_position, 0), count - 1)
+        index = int(position)
+        fraction = position - index
+        following = slots[(index + 1) % count]
+        current = slots[index]
+        start_step = following.label_start - current.label_start
+        end_step = following.label_end - current.label_end
+        start = current.label_start + start_step * fraction
+        end = current.label_end + end_step * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        slots = self._layout(width)
+
+        for slot in slots:
+            padded = (
+                " " * (slot.label_start - slot.span_start)
+                + slot.label
+                + " " * (slot.span_end - slot.label_end)
+            )
+            if slot.name == self.active_tab_name:
+                yield Text(
+                    padded, style=self.active_tab_style, end="", no_wrap=True
+                )
+            else:
+                style = console.get_style(self.inactive_tab_style) + Style(
+                    meta={"@click": f"range_clicked('{slot.name}')"}
+                )
+                yield Opacity(
+                    Text(padded, style=style, end="", no_wrap=True),
+                    opacity=self.inactive_text_opacity,
+                )
+
+        yield Segment.line()
+
+        clickable_ranges = {
+            slot.name: (slot.span_start, slot.span_end) for slot in slots
+        }
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(slots),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are identified by name. The label row is drawn on the first line and the
+    underline on the second. A tab is selected with the keyboard or with a mouse
+    click on its span. Changing the active tab animates the underline to it.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            not given or empty, the first tab is active. Defaults to ``None``.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of the inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the non-highlighted part of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label, or
+            ``None`` (or zero) to fit the padding to the available width. Defaults to
+            ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates the
+            next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if not self.tabs:
+            initial_name = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the position of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The displayed index of the name, or 0 if it is not displayed.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full tab list active, wrapping at the end."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full tab list active, wrapping at the start."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, compares
+        case-insensitively, and never selects the active tab itself.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        if not self.tabs:
+            return
+        active = self._active_tab_name
+        start = self.find_tab_by_name(active)
+        count = len(self.tabs)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == active:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs, and
+        the last tab otherwise. A number larger than the tab count is ignored.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        count = len(self.tabs)
+        if not count or tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Called when a tab's span is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget has focus.
+
+        This handler is synchronous and always marks the event as handled, without
+        stopping its propagation.
+
+        - With no tabs, nothing else happens.
+        - ``escape`` requests focus removal by calling the app's ``set_focus`` method
+          with no target. The call is not awaited, so it has no effect as written.
+        - ``right`` and ``left`` move to the next and previous tab, wrapping at
+          either end.
+        - The digit keys ``0`` to ``9`` activate a tab by position, using the rules of
+          :meth:`activate_tab_by_number`. Other characters are not digits.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab whose label starts with it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == "escape":
+            self.app.set_focus(None)
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
