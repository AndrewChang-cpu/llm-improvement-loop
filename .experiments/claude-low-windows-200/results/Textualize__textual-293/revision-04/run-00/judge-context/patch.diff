+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def _tabs_items(tabs: Tabs):
+    console = Console(file=io.StringIO(), width=100)
+    return list(tabs.render().__rich_console__(console, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_repr_and_text():
+    assert Tab("a") == Tab("a", "a")
+    assert Tab("a", "b") != Tab("a")
+    assert str(Tab("a", "b")) == "a"
+    assert "label='a'" in repr(Tab("a", "b"))
+    assert "name='b'" in repr(Tab("a", "b"))
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([]) is not None
+    assert Tabs([Tab("One"), Tab("Two")]) is not None
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_initial_active_tab_is_kept_with_bar_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([], active_tab="anything")
+    assert tabs._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{i}") for i in range(1, 12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("First", "x"), Tab("Second", "y"), Tab("Last", "x")], tab_padding=1
+    )
+    label_row = _plain(tabs.render()).split("\n")[0]
+    assert label_row == " Last  Second "
+
+
+def test_auto_fit_padding_follows_flexible_share_rule():
+    # Width 100, two labels of width 1. Four flexible padding edges share 98
+    # cells: 24.5 each, with the fractional part carried forward, so the
+    # shares are 24, 25, 24, 25.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    label_row = _plain(tabs.render()).split("\n")[0]
+    assert label_row == " " * 24 + "A" + " " * 49 + "B" + " " * 25
+
+
+def test_no_tabs_renders_empty_row_and_full_inactive_bar():
+    tabs = Tabs([])
+    assert _plain(tabs.render()) == "\n" + "━" * 100
+
+
+def test_active_tab_highlight_sits_under_its_label():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two", tab_padding=1)
+    bar_row = _plain(tabs.render()).split("\n")[1]
+    # " One  Two " puts the label "Two" at columns 6 to 8.
+    assert bar_row[:10] == "━━━━━╸━━━╺"
+    assert bar_row[10:] == "━" * 90
+
+
+def test_bar_clickable_ranges_cover_selection_spans():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    bar = _tabs_items(tabs)[-1]
+    assert bar.clickable_ranges == {"One": (0, 5), "Two": (5, 10)}
+
+
+def test_inactive_label_carries_click_action():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two", tab_padding=1)
+    inactive_label = _tabs_items(tabs)[0]
+    assert inactive_label.renderable.spans[0].style.meta == {
+        "@click": "range_clicked('One')"
+    }
