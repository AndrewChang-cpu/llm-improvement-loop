diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..326e12e
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,412 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab item for the Tabs widget: a display label paired with a name.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The identifier used to select the tab.
+            Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: Optional[str] = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """An edge for the shared layout resolver, sized in cells."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> List[Tab]:
+    """Compute the displayed tabs: one per distinct name.
+
+    The position is that of the first tab with the name, and the label is that
+    of the last tab with the name.
+    """
+    labels: Dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list, including duplicate names.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): Fractional index into the full tab list that
+            places the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding size on each side of a label,
+            or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: Optional[str],
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: Optional[int],
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(
+        self, displayed: List[Tab], width: int
+    ) -> Tuple[
+        List[Tuple[Tab, str]],
+        Dict[str, Tuple[int, int]],
+        Dict[str, Tuple[int, int]],
+    ]:
+        """Lay out the padded spans and compute label and selection ranges.
+
+        Returns:
+            tuple: The padded span text per displayed tab, the label range per name,
+                and the selection range per name.
+        """
+        padding = self.tab_padding
+        if not padding or padding < 0:
+            padding = None
+        edges: List[_TabEdge] = []
+        for tab in displayed:
+            edges.append(_TabEdge(size=padding))
+            if cell_len(tab.label):
+                edges.append(_TabEdge(size=cell_len(tab.label)))
+            edges.append(_TabEdge(size=padding))
+
+        sizes = iter(layout_resolve(width, edges))
+        rows: List[Tuple[Tab, str]] = []
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        cursor = 0
+        for tab in displayed:
+            label_width = cell_len(tab.label)
+            left = next(sizes)
+            if label_width:
+                next(sizes)
+            right = next(sizes)
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (cursor, selection_end)
+            rows.append((tab, " " * left + tab.label + " " * right))
+            cursor = selection_end
+        return rows, label_ranges, selection_ranges
+
+    def _highlight_range(
+        self, label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the highlight between the floor index and the next index."""
+        count = len(self.tabs)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[self.tabs[index].name]
+        start_b, end_b = label_ranges[self.tabs[next_index].name]
+        return (
+            start_a + (start_b - start_a) * fraction,
+            end_a + (end_b - end_a) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        rows, label_ranges, selection_ranges = self._layout(displayed, width)
+
+        for tab, padded in rows:
+            if tab.name == self.active_tab_name:
+                yield Text(
+                    padded,
+                    style=self.active_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+            else:
+                label = Text(
+                    padded,
+                    style=self.inactive_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                label.apply_meta(
+                    {"@click": f"range_clicked('{tab.name}')"}, 0, len(padded)
+                )
+                yield Opacity(label, opacity=self.inactive_text_opacity)
+
+        yield Segment.line()
+
+        clickable_ranges = {
+            tab.name: selection_ranges[tab.name] for tab in displayed
+        }
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected by name. A key press or a click activates a tab, and the
+    underline bar slides to the new tab.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab.
+            Defaults to None, which selects the first tab's name.
+        active_tab_style (StyleType): Style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+            Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation,
+            in seconds. Defaults to 0.3.
+        animation_function (str): Name of the easing function for the
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a
+            label. Defaults to None, which auto-fits the padding to the widget
+            width. A value of zero is treated as None.
+        search_by_first_character (bool): Whether pressing a letter key
+            activates the next tab whose label starts with that letter.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[Optional[str]] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab: Optional[str] = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: Optional[int] = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        self.tabs: List[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+        super().__init__()
+
+        if not self.tabs:
+            initial_name: Optional[str] = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def watch__active_tab_name(self, active_tab_name: Optional[str]) -> None:
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def find_tab_by_name(self, tab_name: Optional[str]) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping to the first after the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping to the last before the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, compares
+        case-insensitively, and never selects the active tab. If no other tab
+        matches, nothing changes.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label[:1].lower() == wanted:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A tab number greater than the tab count is ignored. Tab number 0 activates
+        the 10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0 for the rule above.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. Used by clickable underline spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the tab bar has focus.
+
+        With no tabs, the key is only marked handled. Escape asks the app to remove
+        focus. Left and Right move to the previous and next tab, with wrap-around.
+        The keys 0 through 9 activate a tab by number (see activate_tab_by_number).
+        Other single characters activate the next tab whose label starts with that
+        character, when ``search_by_first_character`` is enabled. Every key press is
+        marked handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            focus = getattr(self.app, "focus", None)
+            if callable(focus):
+                focus()
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
