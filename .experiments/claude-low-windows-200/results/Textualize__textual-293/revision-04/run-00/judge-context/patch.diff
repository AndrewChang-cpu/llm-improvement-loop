+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox app that mounts Tabs widgets directly on the App."""
+
+    def on_mount(self) -> None:
+        self.mount(
+            first=Tabs(
+                [Tab("Home"), Tab("Files"), Tab("Settings", "settings"), Tab("Help")]
+            ),
+            second=Tabs(
+                [Tab("One"), Tab("Two"), Tab("Three")],
+                active_tab="Two",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
