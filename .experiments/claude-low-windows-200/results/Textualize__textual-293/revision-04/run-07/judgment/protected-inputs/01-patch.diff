@@ -0,0 +1,167 @@
+import io
+
+from rich.console import Console
+
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def segments_of(renderable, width=40):
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def rows_of(renderable, width=40):
+    text = "".join(segment.text for segment in segments_of(renderable, width))
+    return text.split("\n")
+
+
+def row_click_actions(renderable, width=40):
+    """Click actions found on the label row, which is the segments before the first newline."""
+    actions = set()
+    for segment in segments_of(renderable, width):
+        if "\n" in segment.text:
+            break
+        if segment.style and segment.style.meta:
+            actions.add(segment.style.meta.get("@click"))
+    actions.discard(None)
+    return actions
+
+
+def make_tabs(tabs, **kwargs):
+    kwargs.setdefault("tab_padding", 1)
+    return Tabs(tabs, **kwargs)
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_tab_equality():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "h")
+
+
+def test_construct_with_empty_and_default_styles():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert Tabs([Tab("Home")]).tabs == [Tab("Home")]
+
+
+def test_two_rows_with_fixed_padding():
+    widget = make_tabs([Tab("Home"), Tab("About"), Tab("Help")])
+    rows = rows_of(widget.render())
+    assert rows[0] == " Home  About  Help "
+    assert rows[1].startswith("╸━━━━╺")
+    assert len(rows[1]) == 40
+
+
+def test_auto_fit_padding_uses_layout_shares():
+    # Width 20, two labels of width 1. Four flexible pads share 20 - 2 = 18 cells.
+    # Shares are 4.5 each, so the sizes are 4, 5, 4, 5 with carried remainders.
+    renderable = TabsRenderable(
+        tabs=[Tab("A"), Tab("B")],
+        active_tab_name="A",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=None,
+    )
+    rows = rows_of(renderable, width=20)
+    assert rows[0] == "    A     " + "    B     "
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    rows = rows_of(make_tabs([]).render(), width=10)
+    assert rows[0] == ""
+    assert rows[1] == "━" * 10
+
+
+def test_duplicate_names_display_once_with_last_label():
+    widget = make_tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    rows = rows_of(widget.render())
+    assert rows[0] == " Three  Two "
+
+
+def test_find_tab_by_name_returns_first_index():
+    widget = Tabs([Tab("A", "x"), Tab("B", "x"), Tab("C", "y")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 2
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_active_tab_defaults_to_first_and_respects_active_tab():
+    assert Tabs([Tab("A"), Tab("B")])._active_tab_name == "A"
+    assert Tabs([Tab("A"), Tab("B")], active_tab="B")._active_tab_name == "B"
+    assert Tabs([Tab("A"), Tab("B")], active_tab="zzz")._active_tab_name == "zzz"
+
+
+def test_next_and_previous_wrap():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "C"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "A"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "B"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "C"
+    widget.activate_tab_by_number(5)
+    assert widget._active_tab_name == "C"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more():
+    widget = Tabs([Tab(f"T{i}") for i in range(12)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "T9"
+
+
+def test_first_char_search_is_case_insensitive_wraps_and_skips_active():
+    widget = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Blueberry")])
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "avocado"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Apple"
+    widget.activate_tab_by_first_char("b")
+    assert widget._active_tab_name == "Banana"
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs([Tab("A"), Tab("B")])
+    widget.action_range_clicked("B")
+    assert widget._active_tab_name == "B"
+
+
+def test_inactive_labels_carry_click_action_and_active_does_not():
+    widget = make_tabs([Tab("Home"), Tab("About")])
+    actions = row_click_actions(widget.render())
+    assert actions == {"range_clicked('About')"}
+
+
+def test_underline_click_actions_cover_every_displayed_tab():
+    widget = make_tabs([Tab("Home"), Tab("About")])
+    rows = rows_of(widget.render())
+    assert rows[1] != ""
+    segments = segments_of(widget.render())
+    bar_actions = set()
+    after_break = False
+    for segment in segments:
+        if "\n" in segment.text:
+            after_break = True
+            continue
+        if after_break and segment.style and segment.style.meta:
+            bar_actions.add(segment.style.meta.get("@click"))
+    assert bar_actions == {"range_clicked('Home')", "range_clicked('About')"}
