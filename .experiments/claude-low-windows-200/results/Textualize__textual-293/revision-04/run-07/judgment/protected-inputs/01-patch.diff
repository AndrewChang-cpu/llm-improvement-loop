diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..2f8eb79
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,408 @@
+from __future__ import annotations
+
+import math
+from typing import Iterator, Optional, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import LayoutEdge, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+# (span_start, label_start, label_end, span_end) for one displayed tab
+_TabSpan = Tuple[int, int, int, int]
+
+
+class Tab:
+    """A tab item with a label shown in the tab bar and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: Optional[str] = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full ordered list of tabs.
+        active_tab_name (str, optional): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the full tab list that places
+            the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding on each side of a label, or ``None``
+            (or zero) to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: Optional[str],
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: Optional[int],
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """One tab per distinct name, at the first position, with the last label."""
+        return list({tab.name: tab for tab in self.tabs}.values())
+
+    def _layout_spans(self, width: int, displayed: list[Tab]) -> list[_TabSpan]:
+        """Divide the width among the displayed tabs using the layout resolver."""
+        padding = None
+        if self.tab_padding and self.tab_padding > 0:
+            padding = self.tab_padding
+        label_widths = [cell_len(tab.label) for tab in displayed]
+
+        edges: list[LayoutEdge] = []
+        for label_width in label_widths:
+            edges.append(LayoutEdge(size=padding))
+            if label_width:
+                # A zero-width label gets no edge, since a zero size reads as flexible
+                edges.append(LayoutEdge(size=label_width))
+            edges.append(LayoutEdge(size=padding))
+
+        sizes = iter(layout_resolve(width, edges))
+        spans: list[_TabSpan] = []
+        position = 0
+        for label_width in label_widths:
+            left = next(sizes)
+            label = next(sizes) if label_width else 0
+            right = next(sizes)
+            label_start = position + left
+            label_end = label_start + label
+            span_end = label_end + right
+            spans.append((position, label_start, label_end, span_end))
+            position = span_end
+        return spans
+
+    def _label_parts(
+        self, console: Console, displayed: list[Tab], spans: list[_TabSpan]
+    ) -> Iterator[RenderableType]:
+        """Yield one run of text per displayed tab, with its style and click action."""
+        for tab, (span_start, label_start, label_end, span_end) in zip(
+            displayed, spans
+        ):
+            left = label_start - span_start
+            right = span_end - label_end
+            padded = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action
+                yield Text(
+                    padded,
+                    style=console.get_style(self.active_tab_style),
+                    end="",
+                    no_wrap=True,
+                )
+            else:
+                text = Text(
+                    padded,
+                    style=console.get_style(self.inactive_tab_style),
+                    end="",
+                    no_wrap=True,
+                )
+                text.stylize(
+                    Style(meta={"@click": f"range_clicked('{tab.name}')"})
+                )
+                yield Opacity(text, opacity=self.inactive_text_opacity)
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Indices are into the full tab list, and each is mapped to its displayed tab
+        by name, so duplicated names share one underline position.
+        """
+        count = len(self.tabs)
+        if count == 0 or not label_ranges:
+            return (0.0, 0.0)
+        position = self.bar_position % count
+        index = math.floor(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+
+        start_1, end_1 = label_ranges[self.tabs[index].name]
+        start_2, end_2 = label_ranges[self.tabs[next_index].name]
+        start = start_1 + (start_2 - start_1) * fraction
+        end = end_1 + (end_2 - end_1) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = self._displayed_tabs()
+        spans = self._layout_spans(width, displayed)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        for tab, (span_start, label_start, label_end, span_end) in zip(
+            displayed, spans
+        ):
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (span_start, span_end)
+
+        yield from self._label_parts(console, displayed, spans)
+        yield Segment.line()
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by keyboard or mouse. Selection and activation are identified
+    by tab name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. A non-empty value that matches no tab is kept.
+        active_tab_style (StyleType): Style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of the inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation, in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Cells of padding on each side of a label. Defaults
+            to ``None``, which auto-fits the tabs to the widget width. Zero is treated
+            the same as ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates the
+            next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[Optional[str]] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: Optional[str] = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: Optional[int] = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: Optional[str] = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def find_tab_by_name(self, tab_name: Optional[str]) -> int:
+        """Find the index of the first tab with a given name in the full tab list.
+
+        Args:
+            tab_name (str): The tab name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: Optional[str]) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus. This handler is synchronous.
+
+        With no tabs, the key is marked handled and nothing else happens. Otherwise:
+
+        - Escape calls the app's focus method with no target, without awaiting it.
+        - Right and Left move to the next and previous tab, wrapping at either end.
+        - The digits 0 to 9 activate a tab by position, using the rule of
+          :meth:`activate_tab_by_number`. Other characters are not digits.
+        - Any other single character activates the next tab whose label starts with
+          it, when ``search_by_first_character`` is true.
+
+        Every key is marked handled by preventing its default action. Propagation is
+        not stopped, so application bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            focus = getattr(self.app, "focus", None)
+            if focus is not None:
+                # Not awaited, matching the reference behavior
+                focus()
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab.
+
+        The comparison is case-insensitive and wraps. The active tab is never selected.
+        If no other tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to search for.
+        """
+        if not self.tabs:
+            return
+        lowered = char.lower()
+        count = len(self.tabs)
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        for offset in range(1, count):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(lowered):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        Numbers larger than the tab count are ignored. Zero activates the 10th tab when
+        there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the target of tab click actions.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
