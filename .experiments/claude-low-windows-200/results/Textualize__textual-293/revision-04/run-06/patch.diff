diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..4f30a05
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,417 @@
+from __future__ import annotations
+
+from typing import NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to select the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge description for the shared layout resolver."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _Cell(NamedTuple):
+    """The laid-out columns of one displayed tab."""
+
+    name: str
+    label: str
+    left: int
+    right: int
+    span_start: int
+    label_start: int
+    label_end: int
+    span_end: int
+
+
+class TabsRenderable:
+    """Renders the label row and underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list, including duplicate names.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab text.
+        tab_padding (int | None): Fixed padding on each side of a label, or ``None``
+            (or zero) to share the width between padding edges.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _displayed_tabs(self) -> list[tuple[str, str]]:
+        """Return (name, label) pairs, one per distinct name.
+
+        The position is that of the first tab with the name, and the label is
+        taken from the last tab with that name.
+        """
+        labels: dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return list(labels.items())
+
+    def _cells(self, width: int) -> list[_Cell]:
+        """Lay out the displayed tabs across ``width`` cells."""
+        displayed = self._displayed_tabs()
+        padding_size = self.tab_padding if (self.tab_padding or 0) > 0 else None
+
+        edges: list[_Edge] = []
+        for name, label in displayed:
+            edges.append(_Edge(size=padding_size))
+            edges.append(_Edge(size=cell_len(label)))
+            edges.append(_Edge(size=padding_size))
+        sizes = layout_resolve(width, edges)
+
+        cells: list[_Cell] = []
+        x = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_start = x + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+            cells.append(
+                _Cell(name, label, left, right, x, label_start, label_end, span_end)
+            )
+            x = span_end
+        return cells
+
+    def _highlight_range(self, cells: list[_Cell]) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position."""
+        count = len(self.tabs)
+        if count == 0:
+            return (0, 0)
+        label_ranges = {
+            cell.name: (cell.label_start, cell.label_end) for cell in cells
+        }
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[self.tabs[index].name]
+        start_b, end_b = label_ranges[self.tabs[next_index].name]
+        return (
+            start_a + (start_b - start_a) * fraction,
+            end_a + (end_b - end_a) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        cells = self._cells(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for cell in cells:
+            span_text = " " * cell.left + cell.label + " " * cell.right
+            if cell.name == self.active_tab_name:
+                yield Text(
+                    span_text,
+                    style=active_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+            else:
+                text = Text(
+                    span_text,
+                    style=inactive_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+                text.apply_meta(
+                    {"@click": f"range_clicked('{cell.name}')"}, 0, len(span_text)
+                )
+                yield Opacity(text, opacity=self.inactive_text_opacity)
+
+        yield Segment("\n")
+
+        clickable_ranges = {
+            cell.name: (cell.span_start, cell.span_end) for cell in cells
+        }
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(cells),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are selected by keyboard or mouse. The active tab is identified by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. A name matching no tab is kept as given.
+        active_tab_style (StyleType, optional): Style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive tab
+            text, where 1 is fully visible and 0 matches the background.
+            Defaults to 0.5.
+        animation_duration (float, optional): Duration in seconds of the underline
+            animation. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label, or
+            ``None`` to fit the labels across the width. Zero is treated as ``None``.
+            Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Return the index of the first tab with the given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search begins after the active tab, ignores case, and wraps. It never
+        selects the active tab. If no other tab matches, the active tab does not
+        change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        active_name = self._active_tab_name
+        index = self.find_tab_by_name(active_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(index + offset) % count]
+            if tab.name == active_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        Zero selects the 10th tab when there are at least ten tabs, and otherwise
+        the last tab. A number greater than the tab count does nothing.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0 as described above.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Used as the click action of tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the widget has focus.
+
+        Every key event is marked handled, and propagation is not stopped, so
+        application bindings still receive keys. With no tabs, nothing else happens.
+
+        - Escape requests focus removal by calling the app's focus method with no
+          target. The call is not awaited.
+        - Right and left activate the next and previous tab, with wrap-around.
+        - The characters 0 through 9 activate a tab by number. Other characters are
+          not digit keys.
+        - Any other single character activates the next tab, after the active one,
+          whose label starts with it, ignoring case. This is skipped when
+          ``search_by_first_character`` is false.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape.value:
+            # The app's focus method is a coroutine, so calling it without
+            # awaiting does not take effect. Guard the lookup so Escape never raises.
+            focus = getattr(self.app, "focus", None)
+            if callable(focus):
+                focus()
+        elif key == Keys.Right.value:
+            self.activate_next_tab()
+        elif key == Keys.Left.value:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
