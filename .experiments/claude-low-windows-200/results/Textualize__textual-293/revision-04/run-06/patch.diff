+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable) -> list[str]:
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def make_renderable(
+    tabs, active_tab_name=None, bar_position=0.0, tab_padding=None
+) -> TabsRenderable:
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "x")
+    assert str(Tab("Home", "h")) == "Home"
+    assert "label='Home'" in repr(Tab("Home", "h"))
+    assert "name='h'" in repr(Tab("Home", "h"))
+
+
+def test_construct_with_empty_and_non_empty_tab_lists():
+    assert Tabs([])._active_tab_name is None
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    widget = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_and_bar_position():
+    tabs = [Tab("A", "a"), Tab("B", "b"), Tab("C", "c")]
+    widget = Tabs(tabs, active_tab="c")
+    assert widget._active_tab_name == "c"
+    assert widget._bar_position == 2.0
+    unknown = Tabs(tabs, active_tab="nope")
+    assert unknown._active_tab_name == "nope"
+    assert unknown._bar_position == 0.0
+
+
+def test_activate_next_and_previous_wrap():
+    widget = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "c"
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "a"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "b"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "c"
+    widget.activate_tab_by_number(5)
+    assert widget._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = [Tab(str(number), f"t{number}") for number in range(1, 13)]
+    widget = Tabs(tabs)
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "t10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    widget = Tabs(
+        [Tab("Apple", "apple"), Tab("Banana", "banana"), Tab("avocado", "avo")]
+    )
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "avo"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    widget = Tabs([Tab("Apple", "apple"), Tab("Banana", "banana")])
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs([Tab("A", "a"), Tab("B", "b")])
+    widget.action_range_clicked("b")
+    assert widget._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    lines = plain_lines(make_renderable([]))
+    assert lines == ["", "━" * 100]
+
+
+def test_label_row_with_explicit_padding():
+    tabs = [Tab("One"), Tab("Two")]
+    lines = plain_lines(make_renderable(tabs, "One", tab_padding=1))
+    assert lines[0] == " One  Two "
+
+
+def test_label_row_with_auto_fit_padding():
+    # Width 100, two 3-cell labels: the four flexible padding edges share the 94
+    # remaining cells at 23.5 each. With the fractional carry they resolve to
+    # 23, 24, 23, 24, giving left and right padding of 23 and 24 for "One", then
+    # 23 and 24 for "Two".
+    tabs = [Tab("One"), Tab("Two")]
+    lines = plain_lines(make_renderable(tabs, "One"))
+    assert lines[0] == " " * 23 + "One" + " " * 47 + "Two" + " " * 24
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("Home", "h"), Tab("Docs", "d"), Tab("Home2", "h")]
+    lines = plain_lines(make_renderable(tabs, "h", tab_padding=1))
+    assert lines[0] == " Home2  Docs "
+
+
+def test_underline_sits_under_active_displayed_tab_with_duplicates():
+    tabs = [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")]
+    # Active name "y" is at full index 1; the displayed row is "C" then "B".
+    lines = plain_lines(make_renderable(tabs, "y", bar_position=1.0, tab_padding=1))
+    assert lines[0] == " C  B "
+    bar = lines[1]
+    assert len(bar) == 100
+    assert bar[3] == "╸"
+    assert bar[4] == "━"
+    assert bar[5] == "╺"
