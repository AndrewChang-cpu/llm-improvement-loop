+    assert home.style.meta == {"@click": "range_clicked('home')"}
+    assert (docs.start, docs.end) == (2, 6)
+    assert docs.style.meta == {"@click": "range_clicked('docs')"}
+
+
+def test_zero_width_range_at_nonzero_position_still_gets_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"a": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert item.spans[-1].style.meta == {"@click": "range_clicked('a')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (-5, -2), (3, 2)])
+def test_early_path_yields_only_background_without_click_spans(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"a": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert item.plain == "━━━━━━"
+    assert all("@click" not in span.style.meta for span in item.spans)
