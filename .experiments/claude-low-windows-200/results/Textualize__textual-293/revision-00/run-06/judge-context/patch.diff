+from textual.app import App
+from textual import events
+from textual.widgets import Placeholder, TabActivated, Tabs
+
+
+class TabsApp(App):
+    """Demo of the Tabs widget. Run with `python -m tabs` from the sandbox directory."""
+
+    def on_mount(self) -> None:
+        self.mount(
+            tabs=Tabs(
+                "January",
+                "February",
+                "March",
+                "April",
+                "May",
+                "June",
+                "July",
+            ),
+            content=Placeholder(),
+        )
+
+    async def on_tab_activated(self, message: TabActivated) -> None:
+        self.log(f"Activated tab {message.index}: {message.label}")
+
+
+TabsApp.run(log="textual.log")
