diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..072bea3
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,157 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.text import Text
+
+from .. import events
+from ..message import Message
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+TAB_PADDING = 1
+
+
+class TabActivated(Message, bubble=True):
+    """Sent when a tab becomes the active tab.
+
+    Attributes:
+        index (int): The zero-based index of the newly active tab.
+        label (str): The label of the newly active tab.
+    """
+
+    def __init__(self, sender, index: int, label: str) -> None:
+        super().__init__(sender)
+        self.index = index
+        self.label = label
+
+
+class Tabs(Widget, can_focus=True):
+    """A row of tab labels with an underline bar marking the active tab.
+
+    The widget is two lines high when it has tabs: the labels on the first
+    line, and the underline bar on the second. With no tabs, only the
+    (inactive) underline bar is rendered.
+
+    Interaction:
+
+    * Clicking anywhere on the widget activates the nearest tab.
+    * ``left`` and ``right`` cycle through the tabs, wrapping around.
+    * A number key ``1`` to ``9`` activates the tab with that (one-based) number.
+    * A letter key searches for the next tab whose label starts with that
+      letter, cycling through matches.
+
+    Changing the active tab posts a :class:`TabActivated` message to the parent.
+
+    Args:
+        *tabs (str): The labels of the tabs, in order.
+        name (str, optional): An optional name for the widget.
+        active (int, optional): The zero-based index of the initially active tab. Defaults to ``0``.
+    """
+
+    active: Reactive[int] = Reactive(0)
+
+    def __init__(self, *tabs: str, name: str | None = None, active: int = 0) -> None:
+        super().__init__(name=name)
+        self.tabs: list[str] = list(tabs)
+        self.layout_size = 2 if self.tabs else 1
+        self.active = active if 0 <= active < len(self.tabs) else 0
+
+    def _cell_ranges(self) -> list[tuple[int, int]]:
+        """Get the (start, end) column range of each tab, including padding.
+
+        Returns:
+            list[tuple[int, int]]: A list of ranges, one per tab. ``end`` is exclusive.
+        """
+        ranges: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = cell_len(label) + TAB_PADDING * 2
+            ranges.append((position, position + width))
+            position += width
+        return ranges
+
+    def render(self) -> RenderableType:
+        if not self.tabs:
+            return UnderlineBar(highlight_style="magenta")
+
+        labels = Text(no_wrap=True, end="")
+        for index, label in enumerate(self.tabs):
+            style = "bold" if index == self.active else "grey70"
+            labels.append(
+                f"{' ' * TAB_PADDING}{label}{' ' * TAB_PADDING}", style=style
+            )
+
+        start, end = self._cell_ranges()[self.active]
+        underline = UnderlineBar(highlight_range=(start, end), highlight_style="magenta")
+        return Group(labels, underline)
+
+    def _nearest_tab(self, x: int) -> int:
+        """Get the index of the tab whose centre is nearest to a column.
+
+        Args:
+            x (int): The column, relative to the widget.
+
+        Returns:
+            int: The zero-based index of the nearest tab.
+        """
+        position = x + 0.5
+        centres = [(start + end) / 2 for start, end in self._cell_ranges()]
+        return min(range(len(centres)), key=lambda i: abs(position - centres[i]))
+
+    def _find_by_letter(self, letter: str) -> int | None:
+        """Find the next tab (after the active one, wrapping) whose label starts with a letter.
+
+        Args:
+            letter (str): A single letter, compared case-insensitively.
+
+        Returns:
+            int | None: The index of the matching tab, or ``None`` if there is no match.
+        """
+        count = len(self.tabs)
+        for offset in range(1, count + 1):
+            index = (self.active + offset) % count
+            if self.tabs[index].lower().startswith(letter):
+                return index
+        return None
+
+    async def activate_tab(self, index: int) -> None:
+        """Make a tab the active tab, and notify the parent if it changed.
+
+        Args:
+            index (int): The zero-based index of the tab to activate.
+        """
+        if index == self.active:
+            return
+        self.active = index
+        await self.emit(TabActivated(self, index, self.tabs[index]))
+
+    async def on_click(self, event: events.Click) -> None:
+        event.prevent_default().stop()
+        if not self.tabs:
+            return
+        await self.activate_tab(self._nearest_tab(event.x))
+
+    async def on_key(self, event: events.Key) -> None:
+        if not self.tabs:
+            return
+        count = len(self.tabs)
+        key = event.key
+
+        if key == "left":
+            target: int | None = (self.active - 1) % count
+        elif key == "right":
+            target = (self.active + 1) % count
+        elif len(key) == 1 and "1" <= key <= "9":
+            number = int(key) - 1
+            target = number if number < count else None
+        elif len(key) == 1 and key.isalpha():
+            target = self._find_by_letter(key.lower())
+        else:
+            target = None
+
+        if target is None:
+            return
+        event.stop()
+        await self.activate_tab(target)
