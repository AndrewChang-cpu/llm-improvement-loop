@@ -0,0 +1,161 @@
+from __future__ import annotations
+
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from ..message import Message
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+TAB_PADDING = 1
+"""Number of blank cells added on each side of a tab label."""
+
+
+class TabActivated(Message, bubble=True):
+    """Sent when a tab becomes the active tab.
+
+    Attributes:
+        index (int): The index of the newly active tab.
+        label (str): The label of the newly active tab.
+    """
+
+    def __init__(self, sender, index: int, label: str) -> None:
+        super().__init__(sender)
+        self.index = index
+        self.label = label
+
+
+class Tabs(Widget):
+    """A row of tab labels with an underline bar that highlights the active tab.
+
+    Clicking anywhere on the widget activates the tab nearest to the click.
+    When the widget has focus:
+
+    * ``left`` and ``right`` cycle through the tabs, wrapping around.
+    * A number key ``1``-``9`` activates the tab at that (one-based) position.
+    * A letter key cycles through the tabs whose label begins with that letter.
+
+    Each time the active tab changes, a :class:`TabActivated` message is sent.
+
+    Args:
+        tabs (Sequence[str]): The labels of the tabs, in display order.
+        name (str, optional): The name of the widget. Defaults to ``None``.
+        highlight_style (StyleType): The style of the underline over the active tab.
+        background_style (StyleType): The style of the underline elsewhere.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[str] = (),
+        *,
+        name: str | None = None,
+        highlight_style: StyleType = "magenta",
+        background_style: StyleType = "grey37",
+    ) -> None:
+        self.tabs: list[str] = list(tabs)
+        self.highlight_style = highlight_style
+        self.background_style = background_style
+        super().__init__(name=name)
+
+    active: Reactive[int] = Reactive(0)
+
+    def watch_active(self, value: int) -> None:
+        self.refresh()
+        if 0 <= value < len(self.tabs):
+            self.emit_no_wait(TabActivated(self, value, self.tabs[value]))
+
+    def tab_regions(self) -> list[tuple[int, int]]:
+        """Get the cell range ``(start, end)`` occupied by each tab, including padding.
+
+        Returns:
+            list[tuple[int, int]]: One ``(start, end)`` pair per tab; ``end`` is exclusive.
+        """
+        regions: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = cell_len(label) + 2 * TAB_PADDING
+            regions.append((position, position + width))
+            position += width
+        return regions
+
+    def tab_at(self, x: int) -> int | None:
+        """Get the index of the tab nearest to a horizontal cell position.
+
+        Args:
+            x (int): A cell offset from the left edge of the widget.
+
+        Returns:
+            int | None: The index of the nearest tab, or ``None`` if there are no tabs.
+        """
+        if not self.tabs:
+            return None
+        best_index = 0
+        best_distance: float | None = None
+        for index, (start, end) in enumerate(self.tab_regions()):
+            distance = abs((start + end) / 2 - x)
+            if best_distance is None or distance < best_distance:
+                best_index = index
+                best_distance = distance
+        return best_index
+
+    def render(self) -> RenderableType:
+        highlight_range = (0.0, 0.0)
+        if self.tabs:
+            regions = self.tab_regions()
+            start, end = regions[min(self.active, len(regions) - 1)]
+            highlight_range = (float(start), float(end))
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=self.highlight_style,
+            background_style=self.background_style,
+        )
+        if not self.tabs:
+            return bar
+
+        labels = Text(no_wrap=True, overflow="ellipsis")
+        for index, label in enumerate(self.tabs):
+            style = "bold" if index == self.active else ""
+            labels.append(" " * TAB_PADDING + label + " " * TAB_PADDING, style=style)
+        return Group(labels, bar)
+
+    async def on_click(self, event: events.Click) -> None:
+        index = self.tab_at(event.x)
+        event.prevent_default().stop()
+        if index is not None:
+            self.active = index
+
+    async def on_key(self, event: events.Key) -> None:
+        key = event.key
+        count = len(self.tabs)
+        if count == 0:
+            return
+
+        if key == "left":
+            self.active = (self.active - 1) % count
+        elif key == "right":
+            self.active = (self.active + 1) % count
+        elif len(key) == 1 and key in "123456789":
+            index = int(key) - 1
+            if index < count:
+                self.active = index
+        elif len(key) == 1 and key.isalpha():
+            # Search forward from the active tab, wrapping around, for the next label
+            # beginning with this letter. The active tab is checked last.
+            wanted = key.lower()
+            for offset in range(1, count + 1):
+                index = (self.active + offset) % count
+                if self.tabs[index][:1].lower() == wanted:
+                    self.active = index
+                    break
+        else:
+            return
+
+        event.prevent_default().stop()
