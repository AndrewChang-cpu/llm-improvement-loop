+from textual.app import App
+from textual.widgets import Tabs, Placeholder
+
+
+class TabsApp(App):
+    """Sandbox application demonstrating the Tabs widget."""
+
+    def on_mount(self):
+        """Build layout here."""
+        months = [
+            "January", "February", "March", "April", "May", "June",
+            "July", "August", "September", "October", "November", "December",
+        ]
+        self.mount(
+            tabs=Tabs(*months),
+            content=Placeholder(),
+        )
+
+
+if __name__ == "__main__":
+    TabsApp.run(log="textual.log")
