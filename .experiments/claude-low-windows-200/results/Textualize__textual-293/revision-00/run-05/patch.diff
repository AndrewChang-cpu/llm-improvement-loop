diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..0d56daa
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,168 @@
+from __future__ import annotations
+
+from rich.console import Group, RenderableType
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from ..message import Message
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class TabActivated(Message, bubble=True):
+    """Sent when a tab becomes active.
+
+    Attributes:
+        index (int): The index of the newly active tab.
+        label (str): The label of the newly active tab.
+    """
+
+    def __init__(self, sender: Widget, index: int, label: str) -> None:
+        super().__init__(sender)
+        self.index = index
+        self.label = label
+
+
+class Tabs(Widget):
+    """A row of tab labels with an underline bar showing the active tab.
+
+    Tabs can be activated in several ways:
+
+    * Clicking on a tab label, or anywhere on the underline bar, activates the
+      nearest tab.
+    * The left and right arrow keys cycle through the tabs, wrapping around.
+    * Pressing a number key (1-9) activates the tab with that (1-based) number.
+    * Pressing a letter key searches the tab labels: successive presses cycle
+      through the tabs whose label begins with that letter.
+
+    Args:
+        *tabs (str): The labels of the tabs, in order.
+        name (str | None, optional): The widget name. Defaults to None.
+        active_style (StyleType): The style of the active tab label. Defaults to "bold magenta".
+        inactive_style (StyleType): The style of the inactive tab labels. Defaults to "grey70".
+        highlight_style (StyleType): The style of the underline under the active tab. Defaults to "magenta".
+        background_style (StyleType): The style of the rest of the underline. Defaults to "grey37".
+
+    With no tabs, only the (inactive) underline is rendered.
+    """
+
+    TAB_PADDING = 1
+
+    active: Reactive[int] = Reactive(0)
+
+    def __init__(
+        self,
+        *tabs: str,
+        name: str | None = None,
+        active_style: StyleType = "bold magenta",
+        inactive_style: StyleType = "grey70",
+        highlight_style: StyleType = "magenta",
+        background_style: StyleType = "grey37",
+    ) -> None:
+        super().__init__(name=name)
+        self.tabs: list[str] = list(tabs)
+        self.active_style = active_style
+        self.inactive_style = inactive_style
+        self.highlight_style = highlight_style
+        self.background_style = background_style
+        self.layout_size = 2
+
+    def _tab_ranges(self) -> list[tuple[int, int]]:
+        """Get the (start, end) column range occupied by each tab, end exclusive."""
+        ranges: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = len(label) + 2 * self.TAB_PADDING
+            ranges.append((position, position + width))
+            position += width
+        return ranges
+
+    def _tab_at(self, x: int) -> int | None:
+        """Get the index of the tab at column x, or the nearest tab if x is not over a tab.
+
+        Returns:
+            int | None: The tab index, or None if there are no tabs.
+        """
+        if not self.tabs:
+            return None
+        ranges = self._tab_ranges()
+        best_index = 0
+        best_distance: int | None = None
+        for index, (start, end) in enumerate(ranges):
+            if start <= x < end:
+                return index
+            distance = start - x if x < start else x - end + 1
+            if best_distance is None or distance < best_distance:
+                best_index = index
+                best_distance = distance
+        return best_index
+
+    def _activate(self, index: int) -> None:
+        """Activate a tab by index, and notify listeners if it changed."""
+        if not 0 <= index < len(self.tabs):
+            return
+        if index != self.active:
+            self.active = index
+            self.post_message_no_wait(
+                TabActivated(self, index, self.tabs[index])
+            )
+
+    def render(self) -> RenderableType:
+        width = self.size.width
+        labels = Text()
+        for index, label in enumerate(self.tabs):
+            style = self.active_style if index == self.active else self.inactive_style
+            labels.append(" " * self.TAB_PADDING)
+            labels.append(label, style=style)
+            labels.append(" " * self.TAB_PADDING)
+        labels.append("\n")
+
+        highlight_range = (0.0, 0.0)
+        if self.tabs:
+            start, end = self._tab_ranges()[self.active]
+            highlight_range = (float(start), float(end))
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=self.highlight_style,
+            background_style=self.background_style,
+            width=width or None,
+        )
+        return Group(labels, bar)
+
+    async def on_click(self, event: events.Click) -> None:
+        event.prevent_default().stop()
+        index = self._tab_at(event.x)
+        if index is not None:
+            self._activate(index)
+
+    async def on_key(self, event: events.Key) -> None:
+        count = len(self.tabs)
+        if count == 0:
+            return
+
+        key = event.key
+        handled = True
+        if key == "left":
+            self._activate((self.active - 1) % count)
+        elif key == "right":
+            self._activate((self.active + 1) % count)
+        elif len(key) == 1 and key.isdigit() and key != "0":
+            self._activate(int(key) - 1)
+        elif len(key) == 1 and key.isalpha():
+            letter = key.lower()
+            matches = [
+                index
+                for index, label in enumerate(self.tabs)
+                if label.lower().startswith(letter)
+            ]
+            if matches:
+                following = [index for index in matches if index > self.active]
+                self._activate(following[0] if following else matches[0])
+        else:
+            handled = False
+
+        if handled:
+            event.prevent_default().stop()
