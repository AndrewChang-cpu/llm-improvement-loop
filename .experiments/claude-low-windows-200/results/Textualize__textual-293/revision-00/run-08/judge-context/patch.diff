+"""Demo of the Tabs widget. Run with: python -m tabs (from the sandbox directory)."""
+
+from textual.app import App
+from textual.widgets import Static, Tabs, TabActivated
+
+MONTHS = [
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+]
+
+
+class TabsApp(App):
+    """Shows a Tabs widget and the label of the active tab."""
+
+    def on_mount(self) -> None:
+        self.status = Static("Press a number, a letter, or use the arrow keys.")
+        self.mount(
+            tabs=Tabs(MONTHS, name="months"),
+            content=self.status,
+        )
+
+    async def on_tab_activated(self, message: TabActivated) -> None:
+        await self.status.update(f"Active tab: {message.label}")
+
+
+TabsApp.run(log="textual.log")
