diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..b800f6e
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,199 @@
+from __future__ import annotations
+
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.text import Text
+
+from .. import events
+from ..message import Message
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class TabActivated(Message, bubble=True):
+    """Sent when a tab becomes the active tab.
+
+    Attributes:
+        index (int): The index of the newly active tab.
+        label (str): The label of the newly active tab.
+    """
+
+    def __init__(self, sender, index: int, label: str) -> None:
+        super().__init__(sender)
+        self.index = index
+        self.label = label
+
+
+class Tabs(Widget):
+    """A horizontal row of tab labels with an underline indicating the active tab.
+
+    Clicking anywhere on the widget activates the tab nearest to the click.
+    When the widget has focus:
+
+    * ``left`` and ``right`` cycle through the tabs, wrapping around.
+    * A number key (``1`` to ``9``) activates the tab with that (1-based) number.
+    * A letter key cycles through tabs whose label begins with that letter,
+      starting after the currently active tab.
+
+    If no tabs are supplied, only the inactive underline is rendered.
+
+    Args:
+        tabs (Sequence[str]): The labels of the tabs, in order.
+        active (int): The index of the initially active tab. Defaults to ``0``.
+        name (str, optional): Optional name for the widget.
+        highlight_style (str): Style of the underline beneath the active tab.
+        background_style (str): Style of the underline elsewhere.
+    """
+
+    PADDING = 1
+
+    def __init__(
+        self,
+        tabs: Sequence[str] = (),
+        active: int = 0,
+        name: str | None = None,
+        highlight_style: str = "magenta",
+        background_style: str = "grey37",
+    ) -> None:
+        super().__init__(name=name)
+        self.tabs: list[str] = list(tabs)
+        self.bar_highlight_style = highlight_style
+        self.bar_background_style = background_style
+        self._active = active if 0 <= active < len(self.tabs) else 0
+        # One row for labels plus one for the underline; only the underline when empty.
+        self.layout_size = 2 if self.tabs else 1
+
+    @property
+    def active(self) -> int:
+        """int: The index of the active tab (``0`` when there are no tabs)."""
+        return self._active
+
+    @property
+    def active_label(self) -> str | None:
+        """str | None: The label of the active tab, or ``None`` if there are no tabs."""
+        return self.tabs[self._active] if self.tabs else None
+
+    def tab_spans(self) -> list[tuple[int, int]]:
+        """Compute the horizontal cell range occupied by each tab.
+
+        Returns:
+            list[tuple[int, int]]: A ``(start, end)`` pair for each tab, where ``end``
+                is exclusive. Padding is included, so it is part of the click target.
+        """
+        spans: list[tuple[int, int]] = []
+        x = 0
+        for label in self.tabs:
+            width = cell_len(label) + 2 * self.PADDING
+            spans.append((x, x + width))
+            x += width
+        return spans
+
+    def activate(self, index: int) -> None:
+        """Make the tab at ``index`` active. Out-of-range indices are ignored.
+
+        Posts a :class:`TabActivated` message if the active tab changes.
+
+        Args:
+            index (int): The index of the tab to activate.
+        """
+        if not 0 <= index < len(self.tabs) or index == self._active:
+            return
+        self._active = index
+        self.refresh()
+        self.post_message_no_wait(TabActivated(self, index, self.tabs[index]))
+
+    def tab_at(self, x: int) -> int | None:
+        """Find the index of the tab nearest to a horizontal cell position.
+
+        Args:
+            x (int): A cell position relative to the left edge of the widget.
+
+        Returns:
+            int | None: The nearest tab index, or ``None`` if there are no tabs.
+        """
+        if not self.tabs:
+            return None
+        spans = self.tab_spans()
+
+        def distance(index: int) -> float:
+            start, end = spans[index]
+            return abs(x - (start + end - 1) / 2)
+
+        return min(range(len(spans)), key=distance)
+
+    def find_letter(self, letter: str) -> int | None:
+        """Find the next tab whose label begins with ``letter``.
+
+        The search starts after the active tab and wraps around. The comparison
+        is case-insensitive.
+
+        Args:
+            letter (str): A single letter.
+
+        Returns:
+            int | None: The index of the matching tab, or ``None`` if none match.
+        """
+        letter = letter.lower()
+        matches = [
+            index
+            for index, label in enumerate(self.tabs)
+            if label[:1].lower() == letter
+        ]
+        if not matches:
+            return None
+        for index in matches:
+            if index > self._active:
+                return index
+        return matches[0]
+
+    def render(self) -> RenderableType:
+        """Render the tab labels above the underline.
+
+        Returns:
+            RenderableType: The labels and underline, or just the underline if there are no tabs.
+        """
+        if not self.tabs:
+            return UnderlineBar(
+                highlight_style=self.bar_highlight_style,
+                background_style=self.bar_background_style,
+            )
+        labels = Text(no_wrap=True)
+        for index, label in enumerate(self.tabs):
+            style = "bold" if index == self._active else ""
+            labels.append(f"{' ' * self.PADDING}{label}{' ' * self.PADDING}", style=style)
+        start, end = self.tab_spans()[self._active]
+        bar = UnderlineBar(
+            highlight_range=(start, end),
+            highlight_style=self.bar_highlight_style,
+            background_style=self.bar_background_style,
+        )
+        return Group(labels, bar)
+
+    async def on_click(self, event: events.Click) -> None:
+        """Activate the tab nearest to the click position."""
+        event.prevent_default().stop()
+        index = self.tab_at(event.x)
+        if index is not None:
+            self.activate(index)
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle arrow, number, and letter keys for tab navigation."""
+        key = event.key
+        count = len(self.tabs)
+        if not count:
+            return
+        if key == "left":
+            self.activate((self._active - 1) % count)
+        elif key == "right":
+            self.activate((self._active + 1) % count)
+        elif len(key) == 1 and key.isdigit() and key != "0":
+            self.activate(int(key) - 1)
+        elif len(key) == 1 and key.isalpha():
+            index = self.find_letter(key)
+            if index is not None:
+                self.activate(index)
+        else:
+            return
+        event.prevent_default().stop()
