+"""Demo of the Tabs widget. Run with: python -m tabs (from the sandbox directory)."""
+
+from textual.app import App
+from textual.widgets import Tabs
+
+
+MONTHS = [
+    "January",
+    "February",
+    "March",
+    "April",
+    "May",
+    "June",
+    "July",
+    "August",
+    "September",
+    "October",
+    "November",
+    "December",
+]
+
+
+class TabsApp(App):
+    """Sandbox application showing the Tabs widget."""
+
+    async def on_mount(self) -> None:
+        """Mount a Tabs widget and focus it so it receives key presses."""
+        tabs = Tabs(MONTHS, name="months")
+        self.mount(tabs=tabs)
+        await tabs.focus()
+
+
+TabsApp.run(log="textual.log")
