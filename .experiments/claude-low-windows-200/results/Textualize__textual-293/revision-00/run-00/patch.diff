diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..8211907
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,176 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.text import Text
+
+from .. import events
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class Tabs(Widget, can_focus=True):
+    """A row of tab labels with an underline bar that highlights the active tab.
+
+    Clicking anywhere on the widget activates the nearest tab. When focused,
+    the following keys control the widget:
+
+    * ``left`` / ``right`` cycle through the tabs, wrapping around at either end.
+    * A number key (``1`` to ``9``) activates the tab with that (1-based) number.
+    * A letter key searches through tab labels: it activates the next tab whose
+      label begins with that letter, cycling through matching tabs.
+
+    If no tabs are supplied, only the inactive underline is rendered.
+
+    Args:
+        tabs (list[str], optional): The labels of the tabs. Defaults to no tabs.
+        name (str, optional): The name of the widget. Defaults to None.
+        active_color (str, optional): Style of the underline over the active tab.
+            Defaults to "magenta".
+        inactive_color (str, optional): Style of the rest of the underline.
+            Defaults to "grey37".
+    """
+
+    # Blank cells added on either side of each label. They are part of the tab's click target.
+    PADDING = 1
+
+    def __init__(
+        self,
+        tabs: list[str] | None = None,
+        name: str | None = None,
+        active_color: str = "magenta",
+        inactive_color: str = "grey37",
+    ) -> None:
+        super().__init__(name=name)
+        self.tabs: list[str] = list(tabs or [])
+        self.active_index: int = 0
+        self.active_color = active_color
+        self.inactive_color = inactive_color
+
+    def _tab_spans(self) -> list[tuple[int, int]]:
+        """Compute the (start, end) cell range of each tab, including padding.
+
+        Returns:
+            list[tuple[int, int]]: A (start, end) pair for each tab, with ``end`` exclusive.
+        """
+        spans: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = cell_len(label) + self.PADDING * 2
+            spans.append((position, position + width))
+            position += width
+        return spans
+
+    def _activate(self, index: int) -> None:
+        """Make the tab at ``index`` active and repaint.
+
+        Args:
+            index (int): The index of the tab to activate.
+        """
+        if not self.tabs:
+            return
+        index = max(0, min(index, len(self.tabs) - 1))
+        if index != self.active_index:
+            self.active_index = index
+            self.refresh()
+
+    def _tab_at(self, x: int) -> int | None:
+        """Find the index of the tab nearest to a horizontal cell position.
+
+        Args:
+            x (int): A cell offset relative to the left of the widget.
+
+        Returns:
+            int | None: The index of the nearest tab, or None if there are no tabs.
+        """
+        if not self.tabs:
+            return None
+        spans = self._tab_spans()
+        for index, (start, end) in enumerate(spans):
+            if start <= x < end:
+                return index
+
+        # Not directly over a tab: choose the one with the nearest edge.
+        def distance(span: tuple[int, int]) -> int:
+            start, end = span
+            if x < start:
+                return start - x
+            return x - (end - 1)
+
+        return min(range(len(spans)), key=lambda i: distance(spans[i]))
+
+    def render(self) -> RenderableType:
+        """Render the tab labels above the underline bar.
+
+        Returns:
+            RenderableType: The tab labels and underline.
+        """
+        if not self.tabs:
+            return UnderlineBar(
+                highlight_range=(0, 0),
+                highlight_style=self.active_color,
+                background_style=self.inactive_color,
+            )
+
+        labels = Text(no_wrap=True, overflow="ellipsis")
+        spans = self._tab_spans()
+        for index, label in enumerate(self.tabs):
+            style = "bold" if index == self.active_index else ""
+            padding = " " * self.PADDING
+            labels.append(f"{padding}{label}{padding}", style=style)
+
+        highlight = spans[self.active_index]
+        bar = UnderlineBar(
+            highlight_range=highlight,
+            highlight_style=self.active_color,
+            background_style=self.inactive_color,
+        )
+        return Group(labels, bar)
+
+    async def on_click(self, event: events.Click) -> None:
+        """Activate the tab nearest to the click.
+
+        Args:
+            event (events.Click): The click event.
+        """
+        index = self._tab_at(event.x)
+        if index is not None:
+            self._activate(index)
+        event.prevent_default().stop()
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle navigation keys for the tabs.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            await super().on_key(event)
+            return
+
+        key = event.key
+        count = len(self.tabs)
+
+        if key == "left":
+            self._activate((self.active_index - 1) % count)
+        elif key == "right":
+            self._activate((self.active_index + 1) % count)
+        elif len(key) == 1 and key in "123456789":
+            number = int(key) - 1
+            if number < count:
+                self._activate(number)
+        elif len(key) == 1 and key.isalpha():
+            letter = key.lower()
+            matches = [
+                index
+                for index, label in enumerate(self.tabs)
+                if label and label[0].lower() == letter
+            ]
+            if matches:
+                following = [index for index in matches if index > self.active_index]
+                self._activate(following[0] if following else matches[0])
+        else:
+            await super().on_key(event)
+            return
+
+        event.prevent_default().stop()
