diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..d68f030
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,168 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, Group, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.text import Text
+
+from .. import events
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class _Row:
+    """Render a renderable followed by a line break.
+
+    Args:
+        renderable (RenderableType): The renderable to draw on a single row.
+    """
+
+    def __init__(self, renderable: RenderableType) -> None:
+        self.renderable = renderable
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        yield from console.render(self.renderable, options)
+        yield Segment.line()
+
+
+class Tabs(Widget, can_focus=True):
+    """A row of tab labels with an underline bar marking the active tab.
+
+    The widget is two rows high when it has tabs (labels, then underline), and
+    one row high (the inactive underline only) when it has none.
+
+    Interaction:
+
+    * Clicking anywhere on the widget activates the nearest tab.
+    * "left" and "right" cycle through the tabs, wrapping around.
+    * Pressing a number key activates the tab with that (1-based) number.
+    * Pressing a letter cycles through tabs whose labels begin with that letter.
+
+    The index of the active tab is available as ``active``. Apps can watch it
+    with ``watch_active`` or ``watch`` as they would any reactive attribute.
+
+    Args:
+        tabs (list[str], optional): The tab labels, in display order. Defaults to no tabs.
+        name (str, optional): The name of the widget.
+    """
+
+    ACTIVE_LABEL_STYLE = "bold magenta"
+    INACTIVE_LABEL_STYLE = ""
+    HIGHLIGHT_STYLE = "magenta"
+    BACKGROUND_STYLE = "grey37"
+
+    active: Reactive[int] = Reactive(0)
+
+    def __init__(self, tabs: list[str] | None = None, *, name: str | None = None) -> None:
+        super().__init__(name=name)
+        self.tabs: list[str] = list(tabs) if tabs else []
+        self.layout_size = 2 if self.tabs else 1
+
+    def _tab_spans(self) -> list[tuple[int, int]]:
+        """Compute the cell range ``(start, end)`` occupied by each tab's label.
+
+        Each label is drawn with one space of padding on either side, and the
+        span includes that padding so the whole tab is clickable.
+
+        Returns:
+            list[tuple[int, int]]: A ``(start, end)`` pair for each tab, with ``end`` exclusive.
+        """
+        spans: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = cell_len(label) + 2
+            spans.append((position, position + width))
+            position += width
+        return spans
+
+    def _nearest_tab(self, x: int) -> int:
+        """Find the index of the tab closest to a column.
+
+        Args:
+            x (int): A column relative to the widget.
+
+        Returns:
+            int: The index of the tab whose span contains ``x``, or the nearest one.
+        """
+        best_index = 0
+        best_distance: int | None = None
+        for index, (start, end) in enumerate(self._tab_spans()):
+            if start <= x < end:
+                distance = 0
+            elif x < start:
+                distance = start - x
+            else:
+                distance = x - (end - 1)
+            if best_distance is None or distance < best_distance:
+                best_index = index
+                best_distance = distance
+        return best_index
+
+    def render(self) -> RenderableType:
+        """Render the tab labels and the underline bar."""
+        if not self.tabs:
+            return _Row(
+                UnderlineBar(
+                    highlight_style=self.HIGHLIGHT_STYLE,
+                    background_style=self.BACKGROUND_STYLE,
+                )
+            )
+
+        labels = Text(no_wrap=True, overflow="crop", end="")
+        for index, label in enumerate(self.tabs):
+            style = (
+                self.ACTIVE_LABEL_STYLE
+                if index == self.active
+                else self.INACTIVE_LABEL_STYLE
+            )
+            labels.append(f" {label} ", style=style)
+
+        start, end = self._tab_spans()[self.active]
+        underline = UnderlineBar(
+            highlight_range=(start, end),
+            highlight_style=self.HIGHLIGHT_STYLE,
+            background_style=self.BACKGROUND_STYLE,
+        )
+        return Group(_Row(labels), _Row(underline))
+
+    async def on_click(self, event: events.Click) -> None:
+        """Activate the tab nearest to the click, and take focus."""
+        event.prevent_default().stop()
+        await self.focus()
+        if self.tabs:
+            self.active = self._nearest_tab(event.x)
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle number keys and letter keys; other keys go to ``key_`` methods."""
+        key = event.key
+        if not self.tabs:
+            return
+        if len(key) == 1 and key.isdigit():
+            number = int(key)
+            if 1 <= number <= len(self.tabs):
+                self.active = number - 1
+        elif len(key) == 1 and key.isalpha():
+            letter = key.lower()
+            matches = [
+                index
+                for index, label in enumerate(self.tabs)
+                if label.lower().startswith(letter)
+            ]
+            if matches:
+                following = [index for index in matches if index > self.active]
+                self.active = following[0] if following else matches[0]
+        else:
+            await self.dispatch_key(event)
+
+    async def key_left(self) -> None:
+        """Activate the previous tab, wrapping around to the last tab."""
+        if self.tabs:
+            self.active = (self.active - 1) % len(self.tabs)
+
+    async def key_right(self) -> None:
+        """Activate the next tab, wrapping around to the first tab."""
+        if self.tabs:
+            self.active = (self.active + 1) % len(self.tabs)
