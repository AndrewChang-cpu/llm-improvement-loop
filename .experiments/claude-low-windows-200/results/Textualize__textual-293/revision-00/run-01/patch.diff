+"""Demo of the Tabs widget: python -m tabs (run from the sandbox directory)."""
+
+from textual.app import App
+from textual.widgets import Tabs
+
+MONTHS = [
+    "January",
+    "February",
+    "March",
+    "April",
+    "May",
+    "June",
+    "July",
+    "August",
+    "September",
+    "October",
+    "November",
+    "December",
+]
+
+
+class TabsApp(App):
+    """Shows a Tabs widget with the months of the year."""
+
+    def on_mount(self):
+        self.mount(tabs=Tabs(MONTHS))
+
+
+TabsApp.run(log="textual.log")
