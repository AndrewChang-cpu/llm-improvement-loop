+from __future__ import annotations
+
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.text import Text
+
+from .. import events
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class Tabs(Widget):
+    """A row of tab labels with an underline bar that highlights the active tab.
+
+    Each tab label is padded on either side, and the tab's click target spans
+    both the label row and the underline row beneath it. Clicking anywhere on
+    the widget activates the nearest tab.
+
+    Keyboard control (when the widget has focus):
+
+    * ``left`` / ``right`` cycle through the tabs, wrapping around at either end.
+    * A number key (``1``-``9``) activates the tab with that (1-based) number.
+    * A letter key searches forward through tab labels, activating the next tab
+      whose label begins with that letter (case-insensitive), wrapping around.
+
+    If no tabs are supplied, only the inactive underline is rendered.
+
+    Args:
+        tabs (Sequence[str], optional): The labels of the tabs. Defaults to no tabs.
+        active (int, optional): The index of the initially active tab. Defaults to 0.
+        name (str, optional): The name of the widget. Defaults to None.
+        id (str, optional): The ID of the widget. Defaults to None.
+    """
+
+    PADDING = 1
+
+    active: Reactive[int] = Reactive(0)
+
+    def __init__(
+        self,
+        tabs: Sequence[str] = (),
+        active: int = 0,
+        *,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        super().__init__(name=name, id=id)
+        self.tabs: list[str] = list(tabs)
+        self.active = self._clamp_index(active)
+        self.layout_size = 2 if self.tabs else 1
+
+    def _clamp_index(self, index: int) -> int:
+        """Clamp an index to the valid range of tabs (0 when there are no tabs)."""
+        if not self.tabs:
+            return 0
+        return max(0, min(index, len(self.tabs) - 1))
+
+    def _tab_ranges(self) -> list[tuple[int, int]]:
+        """Compute the (start, end) cell columns occupied by each tab, including padding."""
+        ranges: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = cell_len(label) + self.PADDING * 2
+            ranges.append((position, position + width))
+            position += width
+        return ranges
+
+    def render(self) -> RenderableType:
+        """Render the tab labels above an underline bar highlighting the active tab."""
+        if not self.tabs:
+            return UnderlineBar()
+
+        label_text = Text(no_wrap=True, end="")
+        for index, label in enumerate(self.tabs):
+            padded = " " * self.PADDING + label + " " * self.PADDING
+            style = "bold reverse" if index == self.active else ""
+            label_text.append(padded, style=style)
+
+        start, end = self._tab_ranges()[self.active]
+        bar = UnderlineBar(
+            highlight_range=(start, end),
+            highlight_style="magenta",
+            background_style="grey37",
+        )
+        return Group(label_text, bar)
+
+    def _nearest_tab(self, x: int) -> int:
+        """Return the index of the tab nearest to column ``x``."""
+        best_index = 0
+        best_distance: int | None = None
+        for index, (start, end) in enumerate(self._tab_ranges()):
+            if start <= x < end:
+                return index
+            distance = start - x if x < start else x - (end - 1)
+            if best_distance is None or distance < best_distance:
+                best_index = index
+                best_distance = distance
+        return best_index
+
+    def _activate(self, index: int) -> None:
+        """Activate a tab by index, ignoring out-of-range indices."""
+        if 0 <= index < len(self.tabs):
+            self.active = index
+
+    def _cycle(self, step: int) -> None:
+        """Move the active tab by ``step``, wrapping around at either end."""
+        if self.tabs:
+            self.active = (self.active + step) % len(self.tabs)
+
+    def _search(self, letter: str) -> None:
+        """Activate the next tab (after the active one, wrapping) starting with ``letter``."""
+        count = len(self.tabs)
+        if not count:
+            return
+        letter = letter.lower()
+        for offset in range(1, count + 1):
+            index = (self.active + offset) % count
+            if self.tabs[index].lower().startswith(letter):
+                self.active = index
+                return
+
+    async def on_click(self, event: events.Click) -> None:
+        """Activate the tab nearest to the click."""
+        if not self.tabs:
+            return
+        event.prevent_default().stop()
+        self._activate(self._nearest_tab(event.x))
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle arrow keys, number keys, and letter search."""
+        key = event.key
+        if key == "left":
+            event.prevent_default().stop()
+            self._cycle(-1)
+        elif key == "right":
+            event.prevent_default().stop()
+            self._cycle(1)
+        elif len(key) == 1 and key.isdigit() and key != "0":
+            event.prevent_default().stop()
+            self._activate(int(key) - 1)
+        elif len(key) == 1 and key.isalpha():
+            event.prevent_default().stop()
+            self._search(key)
