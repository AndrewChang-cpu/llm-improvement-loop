diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..3373b0d
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,154 @@
+from __future__ import annotations
+
+from typing import Iterable
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.text import Text
+
+from .. import events
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+TAB_PADDING = 1
+"""Number of blank cells added on each side of a tab label."""
+
+
+class Tabs(Widget):
+    """A horizontal row of tab labels with an underline marking the active tab.
+
+    Clicking anywhere on the widget activates the nearest tab. When the widget
+    has focus, the keyboard can be used to change tabs:
+
+    * ``left`` / ``right`` cycle through the tabs, wrapping at either end.
+    * A number key (``1`` to ``9``) activates the tab with that (1-based) number.
+    * A letter key cycles through the tabs whose label begins with that letter.
+
+    If no tabs are supplied, only the inactive underline is rendered.
+
+    Args:
+        tabs (Iterable[str]): The labels of the tabs, in display order.
+        name (str, optional): The name of the widget.
+    """
+
+    can_focus = True
+
+    active: Reactive[int] = Reactive(0)
+
+    def __init__(self, tabs: Iterable[str] = (), name: str | None = None) -> None:
+        super().__init__(name=name)
+        self.tabs: list[str] = [str(tab) for tab in tabs]
+        # Two rows when there are tabs (labels and underline), one row otherwise.
+        self.layout_size = 2 if self.tabs else 1
+
+    def _tab_spans(self) -> list[tuple[int, int]]:
+        """Get the horizontal cell range ``(start, end)`` occupied by each tab,
+        including its padding. The ranges are contiguous and start at 0.
+
+        Returns:
+            list[tuple[int, int]]: One ``(start, end)`` pair per tab.
+        """
+        spans: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = cell_len(label) + TAB_PADDING * 2
+            spans.append((position, position + width))
+            position += width
+        return spans
+
+    def _tab_at(self, x: int) -> int:
+        """Get the index of the tab at a horizontal position, or the nearest tab
+        if the position is outside every tab.
+
+        Args:
+            x (int): A horizontal cell position within the widget.
+
+        Returns:
+            int: The index of the tab. Must only be called when there are tabs.
+        """
+        spans = self._tab_spans()
+        for index, (start, end) in enumerate(spans):
+            if start <= x < end:
+                return index
+
+        def distance(index: int) -> int:
+            start, end = spans[index]
+            return min(abs(x - start), abs(x - end))
+
+        return min(range(len(spans)), key=distance)
+
+    def next_tab(self) -> None:
+        """Activate the next tab, wrapping around to the first tab."""
+        if self.tabs:
+            self.active = (self.active + 1) % len(self.tabs)
+
+    def previous_tab(self) -> None:
+        """Activate the previous tab, wrapping around to the last tab."""
+        if self.tabs:
+            self.active = (self.active - 1) % len(self.tabs)
+
+    def _activate_by_letter(self, letter: str) -> bool:
+        """Activate the next tab whose label begins with ``letter``.
+
+        Args:
+            letter (str): A single lower case letter.
+
+        Returns:
+            bool: True if a matching tab was found.
+        """
+        matches = [
+            index
+            for index, label in enumerate(self.tabs)
+            if label[:1].lower() == letter
+        ]
+        if not matches:
+            return False
+        later = [index for index in matches if index > self.active]
+        self.active = later[0] if later else matches[0]
+        return True
+
+    def render(self) -> RenderableType:
+        if not self.tabs:
+            return UnderlineBar()
+
+        labels = Text(no_wrap=True, end="")
+        for index, label in enumerate(self.tabs):
+            style = "bold" if index == self.active else ""
+            labels.append(f"{' ' * TAB_PADDING}{label}{' ' * TAB_PADDING}", style=style)
+
+        start, end = self._tab_spans()[self.active]
+        underline = UnderlineBar(highlight_range=(start, end))
+        return Group(labels, underline)
+
+    async def on_click(self, event: events.Click) -> None:
+        """Activate the tab nearest to the click position."""
+        event.prevent_default().stop()
+        if self.tabs:
+            self.active = self._tab_at(event.x)
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation between tabs."""
+        if not self.tabs:
+            return
+
+        key = event.key
+        handled = True
+        if key == "left":
+            self.previous_tab()
+        elif key == "right":
+            self.next_tab()
+        elif len(key) == 1 and key.isdigit():
+            index = int(key) - 1
+            if 0 <= index < len(self.tabs):
+                self.active = index
+            else:
+                handled = False
+        elif len(key) == 1 and key.isalpha():
+            handled = self._activate_by_letter(key.lower())
+        else:
+            handled = False
+
+        if handled:
+            event.prevent_default().stop()
