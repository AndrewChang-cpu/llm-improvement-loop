+from textual.app import App
+from textual.widgets import Tabs
+
+
+MONTHS = [
+    "January",
+    "February",
+    "March",
+    "April",
+    "May",
+    "June",
+    "July",
+    "August",
+    "September",
+    "October",
+    "November",
+    "December",
+]
+
+
+class TabsApp(App):
+    """Sandbox demo of the Tabs widget.
+
+    Click a tab, use left/right to cycle, press a number to jump to a tab,
+    or press a letter to cycle through tabs beginning with that letter.
+    """
+
+    def on_mount(self):
+        """Mount a Tabs widget containing the month names."""
+        self.mount(tabs=Tabs(MONTHS))
+
+
+TabsApp.run(log="textual.log")
