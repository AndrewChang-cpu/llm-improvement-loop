diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..e3e09db
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,162 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.text import Text
+
+from .. import events
+from ..message import Message
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class TabChanged(Message, bubble=True):
+    """Sent when the active tab changes.
+
+    Attributes:
+        index (int): The index of the newly active tab.
+        label (str): The label of the newly active tab.
+    """
+
+    def __init__(self, sender: Widget, index: int, label: str) -> None:
+        super().__init__(sender)
+        self.index = index
+        self.label = label
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tab labels with an underline that highlights the active tab.
+
+    Clicking the labels or the underline activates the nearest tab. When the
+    widget has focus, the left and right arrow keys cycle through the tabs
+    (wrapping around), pressing a number key activates the tab with that
+    1-based number, and pressing a letter cycles through tabs whose labels
+    begin with that letter.
+
+    If no tabs are supplied, only the inactive underline is rendered.
+
+    Args:
+        *tabs (str): The labels of the tabs, in order.
+        name (str | None, optional): The name of the widget. Defaults to None.
+
+    Messages:
+        TabChanged: Sent when the active tab changes.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    active: Reactive[int] = Reactive(0)
+
+    def __init__(self, *tabs: str, name: str | None = None) -> None:
+        super().__init__(name=name)
+        self.tabs: list[str] = [str(tab) for tab in tabs]
+        self.active = 0
+
+    def _tab_regions(self) -> list[tuple[int, int]]:
+        """Get the (start, end) cell range of each tab, including padding.
+
+        Returns:
+            list[tuple[int, int]]: The start (inclusive) and end (exclusive) of each tab.
+        """
+        regions: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            # One cell of padding either side of the label
+            width = cell_len(label) + 2
+            regions.append((position, position + width))
+            position += width
+        return regions
+
+    def _nearest_tab(self, x: int) -> int | None:
+        """Find the index of the tab nearest to a horizontal cell position.
+
+        Args:
+            x (int): A cell position relative to the widget.
+
+        Returns:
+            int | None: The index of the nearest tab, or None if there are no tabs.
+        """
+        if not self.tabs:
+            return None
+
+        def distance(region: tuple[int, int]) -> int:
+            start, end = region
+            if start <= x < end:
+                return 0
+            return min(abs(x - start), abs(x - (end - 1)))
+
+        regions = self._tab_regions()
+        return min(range(len(regions)), key=lambda index: distance(regions[index]))
+
+    def render(self) -> RenderableType:
+        labels = Text()
+        for index, label in enumerate(self.tabs):
+            style = "bold magenta" if index == self.active else ""
+            labels.append(f" {label} ", style=style)
+
+        if self.tabs:
+            start, end = self._tab_regions()[self.active]
+            highlight_range = (start, end)
+        else:
+            highlight_range = (0, 0)
+
+        return Group(labels, UnderlineBar(highlight_range=highlight_range))
+
+    async def _activate(self, index: int) -> None:
+        """Activate a tab and notify listeners.
+
+        Args:
+            index (int): The index of the tab to activate.
+        """
+        self.active = index
+        self.refresh()
+        await self.emit(TabChanged(self, index, self.tabs[index]))
+
+    async def on_click(self, event: events.Click) -> None:
+        event.prevent_default().stop()
+        index = self._nearest_tab(event.x)
+        if index is not None:
+            await self._activate(index)
+
+    async def on_key(self, event: events.Key) -> None:
+        if not self.tabs:
+            await super().on_key(event)
+            return
+
+        key = event.key
+        count = len(self.tabs)
+        handled = True
+
+        if key == "left":
+            await self._activate((self.active - 1) % count)
+        elif key == "right":
+            await self._activate((self.active + 1) % count)
+        elif len(key) == 1 and key.isdigit():
+            number = int(key)
+            if 1 <= number <= count:
+                await self._activate(number - 1)
+            else:
+                handled = False
+        elif len(key) == 1 and key.isalpha():
+            letter = key.lower()
+            matches = [
+                index
+                for index, label in enumerate(self.tabs)
+                if label.lower().startswith(letter)
+            ]
+            if matches:
+                # Move to the next matching tab after the active one, wrapping around
+                following = [index for index in matches if index > self.active]
+                await self._activate(following[0] if following else matches[0])
+            else:
+                handled = False
+        else:
+            handled = False
+
+        if handled:
+            event.prevent_default()
+        else:
+            await super().on_key(event)
