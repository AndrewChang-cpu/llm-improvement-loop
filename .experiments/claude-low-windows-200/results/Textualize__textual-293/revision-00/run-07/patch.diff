+from textual.app import App
+from textual.widgets import Static, Tabs, TabChanged
+
+
+MONTHS = [
+    "January", "February", "March", "April", "May", "June",
+    "July", "August", "September", "October", "November", "December",
+]
+
+
+class TabsApp(App):
+    """Demo of the Tabs widget."""
+
+    def on_mount(self) -> None:
+        self.tabs = Tabs(*MONTHS)
+        self.content = Static("Select a tab")
+        self.mount(tabs=self.tabs, content=self.content)
+
+    async def on_tab_changed(self, message: TabChanged) -> None:
+        await self.content.update(f"Active tab: {message.label}")
+
+
+TabsApp.run(log="textual.log")
