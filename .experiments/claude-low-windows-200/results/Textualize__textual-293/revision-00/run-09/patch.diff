diff --git a/src/textual/widgets/_tabs.py b/src/textual/widgets/_tabs.py
new file mode 100644
index 0000000..8ed2545
--- /dev/null
+++ b/src/textual/widgets/_tabs.py
@@ -0,0 +1,132 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Group, RenderableType
+from rich.text import Text
+
+from .. import events
+from ..reactive import Reactive
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+
+class Tabs(Widget):
+    """A row of tab labels with an underline bar that marks the active tab.
+
+    Each tab is rendered with one cell of padding on either side, and the
+    underline highlights the full width of the active tab including that
+    padding. Clicking anywhere on the widget activates the nearest tab.
+
+    Keyboard control (the widget takes focus):
+
+    * ``left`` / ``right`` cycle through tabs, wrapping around.
+    * A number key ``1``-``9`` activates the tab at that (1-based) position.
+    * A letter key searches tab labels: it activates the next tab (after the
+      active one, wrapping around) whose label begins with that letter.
+
+    With no tabs, only the inactive underline is rendered.
+
+    Args:
+        *tabs (str): The labels of the tabs, in order.
+        name (str, optional): The name of the widget. Defaults to None.
+    """
+
+    tabs: Reactive[list[str]] = Reactive([], layout=True)
+    active_tab: Reactive[int] = Reactive(0)
+
+    def __init__(self, *tabs: str, name: str | None = None) -> None:
+        super().__init__(name=name)
+        self.layout_size = 2 if tabs else 1
+        self.tabs = list(tabs)
+
+    def watch_tabs(self, tabs: list[str]) -> None:
+        self.layout_size = 2 if tabs else 1
+
+    def _tab_spans(self) -> list[tuple[int, int]]:
+        """Get the (start, end) cell range of each tab, including padding."""
+        spans: list[tuple[int, int]] = []
+        position = 0
+        for label in self.tabs:
+            width = cell_len(label) + 2
+            spans.append((position, position + width))
+            position += width
+        return spans
+
+    def render(self) -> RenderableType:
+        underline_range = (0.0, 0.0)
+        if not self.tabs:
+            return UnderlineBar()
+
+        labels = Text(no_wrap=True, overflow="ellipsis")
+        active = self.active_tab
+        for index, label in enumerate(self.tabs):
+            labels.append(f" {label} ", style="bold" if index == active else "")
+
+        if 0 <= active < len(self.tabs):
+            start, end = self._tab_spans()[active]
+            underline_range = (float(start), float(end))
+
+        bar = UnderlineBar(highlight_range=underline_range)
+        return Group(labels, bar)
+
+    def activate_tab(self, index: int) -> None:
+        """Activate the tab at the given index, if it exists.
+
+        Args:
+            index (int): The zero-based index of the tab to activate.
+        """
+        if 0 <= index < len(self.tabs):
+            self.active_tab = index
+
+    def search_tab(self, letter: str) -> None:
+        """Activate the next tab whose label begins with the given letter.
+
+        The search starts after the active tab and wraps around, so repeated
+        presses cycle through all matching tabs.
+
+        Args:
+            letter (str): The letter to search for (case-insensitive).
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        letter = letter.lower()
+        start = self.active_tab % count
+        for offset in range(1, count + 1):
+            index = (start + offset) % count
+            if self.tabs[index][:1].lower() == letter:
+                self.active_tab = index
+                return
+
+    async def on_click(self, event: events.Click) -> None:
+        event.prevent_default().stop()
+        if not self.tabs:
+            return
+        spans = self._tab_spans()
+        index = len(spans) - 1
+        for tab_index, (_start, end) in enumerate(spans):
+            if event.x < end:
+                index = tab_index
+                break
+        self.activate_tab(index)
+
+    async def on_key(self, event: events.Key) -> None:
+        await self.dispatch_key(event)
+        key = event.key
+        if len(key) != 1:
+            return
+        if key.isdigit():
+            if key != "0":
+                self.activate_tab(int(key) - 1)
+                event.prevent_default()
+        elif key.isalpha():
+            self.search_tab(key)
+            event.prevent_default()
+
+    async def key_left(self) -> None:
+        if self.tabs:
+            self.active_tab = (self.active_tab - 1) % len(self.tabs)
+
+    async def key_right(self) -> None:
+        if self.tabs:
+            self.active_tab = (self.active_tab + 1) % len(self.tabs)
