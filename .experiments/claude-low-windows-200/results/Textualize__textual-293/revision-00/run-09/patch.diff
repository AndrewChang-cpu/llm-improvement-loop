+"""Demo of the Tabs widget. Run with: python -m tabs (from the sandbox directory)."""
+
+from textual.app import App
+from textual.widgets import Static, Tabs
+
+MONTHS = [
+    "January",
+    "February",
+    "March",
+    "April",
+    "May",
+    "June",
+    "July",
+    "August",
+    "September",
+    "October",
+    "November",
+    "December",
+]
+
+
+class TabsApp(App):
+    """Demonstrates keyboard and mouse control of the Tabs widget."""
+
+    async def on_mount(self) -> None:
+        await self.view.dock(
+            Tabs(*MONTHS),
+            edge="top",
+        )
+        await self.view.dock(
+            Static("Use left/right, number keys, or letters to switch tabs."),
+            edge="top",
+        )
+
+
+if __name__ == "__main__":
+    TabsApp.run(log="textual.log")
