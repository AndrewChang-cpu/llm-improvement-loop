diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..05eb7de
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,423 @@
+from __future__ import annotations
+
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab shown in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge of the tab row, as consumed by layout_resolve."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the displayed tabs: one per distinct name, at the position of the
+    first tab with that name, carrying the label of the last tab with that name.
+    """
+    displayed: list[Tab] = []
+    positions: dict[str, int] = {}
+    for tab in tabs:
+        position = positions.get(tab.name)
+        if position is None:
+            positions[tab.name] = len(displayed)
+            displayed.append(tab)
+        else:
+            displayed[position] = tab
+    return displayed
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): Fractional index into the full tab list that places the
+            underline.
+        active_tab_style (StyleType): Style of the active tab.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of the inactive tabs.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels.
+        tab_padding (int | None): Fixed cell count for each padding edge, or None
+            (or zero) to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        segments, label_ranges, selection_ranges = self._label_row(
+            console, options, displayed, width
+        )
+        yield from segments
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+    def _label_row(
+        self,
+        console: Console,
+        options: ConsoleOptions,
+        displayed: list[Tab],
+        width: int,
+    ) -> tuple[
+        list[Segment],
+        dict[str, tuple[int, int]],
+        dict[str, tuple[int, int]],
+    ]:
+        """Lay out the labels and render them.
+
+        Returns:
+            tuple: The label row segments, the label range of each displayed tab, and
+                the selection range (padded span) of each displayed tab, keyed by name.
+        """
+        padding_size = self.tab_padding or None
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding_size))
+            label_width = cell_len(tab.label)
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            else:
+                # A size of 0 would read as flexible, so an empty label is given
+                # no share of the space and no minimum instead.
+                edges.append(_Edge(min_size=0, fraction=0))
+            edges.append(_Edge(size=padding_size))
+        sizes = layout_resolve(width, edges)
+
+        segments: list[Segment] = []
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        position = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            span_start = position
+            label_ranges[tab.name] = (
+                position + left,
+                position + left + label_size,
+            )
+            position += left + label_size + right
+            selection_ranges[tab.name] = (span_start, position)
+
+            # The padded span is one run, so padding cells share the label's style.
+            is_active = tab.name == self.active_tab_name
+            text = Text(
+                " " * left + tab.label + " " * right,
+                style=self.active_tab_style if is_active else self.inactive_tab_style,
+                end="",
+                no_wrap=True,
+                overflow="crop",
+            )
+            if is_active:
+                segments.extend(console.render(text, options))
+            else:
+                text.apply_meta({"@click": f"range_clicked({tab.name!r})"})
+                segments.extend(
+                    console.render(Opacity(text, self.inactive_text_opacity), options)
+                )
+
+        segments = Segment.adjust_line_length(segments, width, pad=False)
+        return segments, label_ranges, selection_ranges
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Returns:
+            tuple[float, float]: The highlighted column range.
+        """
+        count = len(self.tabs)
+        if not count or not label_ranges:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), count - 1)
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_ranges[self.tabs[index].name]
+        next_start, next_end = label_ranges[self.tabs[next_index].name]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Selection is by tab name. Use the arrow keys, digit keys, or first-character
+    search to change tabs, or click a tab.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            not given or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType): Style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted underline. Defaults to
+            ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels, from
+            0 to 1. Defaults to 0.5.
+        animation_duration (float): Duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            ``None`` (or zero) auto-fits the padding to the widget width. Defaults to
+            None.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if self.tabs:
+            initial_name: str | None = active_tab or self.tabs[0].name
+        else:
+            initial_name = None
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation.
+
+        Every key event is marked handled, but propagation is not stopped, so
+        application bindings still receive keys.
+
+        - Escape clears focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digit keys 1 to 9 activate the tab at that 1-based position. The 0 key
+          activates the 10th tab, or the last tab when there are fewer than ten.
+        - Any other single character activates the next tab, after the active one
+          and wrapping, whose label starts with that character (case-insensitive).
+          This is skipped when ``search_by_first_character`` is false.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab, after the active one, whose label starts with a
+        character. The comparison is case-insensitive, the search wraps, and the
+        active tab is never selected. The active tab does not change if no other tab
+        matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        if not char:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.casefold()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.casefold().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        Numbers are 1-based. Zero activates the 10th tab when there are at least ten
+        tabs, and the last tab otherwise. A number greater than the tab count is
+        ignored.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the action of a clicked tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
