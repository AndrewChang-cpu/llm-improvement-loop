index 0000000..3a7ec60
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,212 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def make_renderable(tabs, active=None, position=0.0, padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=padding,
+    )
+
+
+def plain_lines(renderable):
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def cells_by_row(renderable):
+    """Split the rendered output into rows of (character, style) cells."""
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    rows = [[]]
+    for segment in console.render(renderable, console.options):
+        if segment.control:
+            continue
+        if segment.text == "\n":
+            rows.append([])
+            continue
+        for character in segment.text:
+            rows[-1].append((character, segment.style))
+    return rows
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "x")
+    representation = repr(Tab("Home", "h"))
+    assert "Home" in representation
+    assert "'h'" in representation
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="nope")
+    assert tabs._active_tab_name == "nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_is_one_based_and_ignores_out_of_range():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "2"
+
+
+def test_zero_selects_last_tab_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(5)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T4"
+
+
+def test_zero_selects_tenth_tab_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_range_clicked_action_activates_named_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_bar():
+    assert plain_lines(make_renderable([])) == ["", "━" * 100]
+
+
+def test_fixed_padding_label_row():
+    renderable = make_renderable(
+        [Tab("One"), Tab("Two")], active="One", padding=2
+    )
+    assert plain_lines(renderable)[0] == "  One    Two  "
+
+
+def test_auto_fit_label_row_fills_width():
+    lines = plain_lines(make_renderable([Tab("One"), Tab("Two")], active="One"))
+    assert len(lines[0]) == 100
+    assert len(lines[1]) == 100
+
+
+def test_underline_highlights_active_tab_span_with_half_edges():
+    renderable = make_renderable(
+        [Tab("One"), Tab("Two")], active="One", position=0.0, padding=2
+    )
+    bar = plain_lines(renderable)[1]
+    # The label "One" occupies columns 2 to 4, so the highlight spans 2 to 5.
+    assert bar[1] == "╸"
+    assert bar[2:5] == "━━━"
+    assert bar[5] == "╺"
+    assert bar[6:] == "━" * 94
+
+
+def test_duplicate_names_display_once_with_last_label():
+    renderable = make_renderable(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], active="x", padding=1
+    )
+    lines = plain_lines(renderable)
+    assert lines[0] == " C  B "
+    # Displayed tab "x" has its label in columns 1 to 2.
+    assert lines[1] == "╸━╺" + "━" * 97
+
+
+def test_inactive_label_cells_are_dimmed_and_carry_click_action():
+    rows = cells_by_row(
+        make_renderable([Tab("One"), Tab("Two")], active="One", padding=2)
+    )
+    label_row = rows[0]
+
+    # Cells 7 to 13 are the padded span of the inactive tab "Two".
+    for _, style in label_row[7:14]:
+        assert style.meta == {"@click": "range_clicked('Two')"}
+
+    # The inactive label is blended toward the background, not full foreground.
+    red, _, _ = label_row[9][1].color.triplet
+    assert abs(red - 121) <= 1
+
+    # The active tab keeps its foreground and carries no click action.
+    _, active_style = label_row[2]
+    assert active_style.color.triplet == (240, 240, 240)
+    assert active_style.meta == {}
+
+
+def test_underline_cells_carry_click_action_for_each_displayed_tab():
+    rows = cells_by_row(
+        make_renderable([Tab("One"), Tab("Two")], active="One", padding=2)
+    )
+    bar_row = rows[1]
+    for _, style in bar_row[0:7]:
+        assert style.meta == {"@click": "range_clicked('One')"}
+    for _, style in bar_row[7:14]:
+        assert style.meta == {"@click": "range_clicked('Two')"}
