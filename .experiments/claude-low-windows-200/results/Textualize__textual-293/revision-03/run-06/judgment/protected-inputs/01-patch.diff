+
+class OptionsDouble:
+    def __init__(self, max_width):
+        self.max_width = max_width
+
+
+def first_item(bar, width):
+    return list(bar.__rich_console__(ConsoleDouble(), OptionsDouble(width)))[0]
+
+
+def test_clickable_ranges_attach_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 3), "two": (3, 6)},
+        width=6,
+    )
+    item = first_item(bar, 6)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    click_spans = item.spans[-2:]
+    assert (click_spans[0].start, click_spans[0].end) == (0, 3)
+    assert click_spans[0].style.meta == {"@click": "range_clicked('one')"}
+    assert (click_spans[1].start, click_spans[1].end) == (3, 6)
+    assert click_spans[1].style.meta == {"@click": "range_clicked('two')"}
+
+
+def test_zero_width_early_path_yields_background_only():
+    for highlight_range in [(0, 0), (4, 2)]:
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            clickable_ranges={"one": (0, 3)},
+            width=6,
+        )
+        item = first_item(bar, 6)
+        assert isinstance(item, Text)
+        assert item.plain == "━" * 6
+        assert item.spans == []
+
+
+def test_zero_width_range_at_non_zero_position_gets_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"one": (0, 3)},
+        width=6,
+    )
+    item = first_item(bar, 6)
+    assert item.spans[-1].style.meta == {"@click": "range_clicked('one')"}
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
