diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..6e1bd9a
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,227 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable) -> list[str]:
+    return ANSI_ESCAPE.sub("", render(renderable)).split("\n")
+
+
+def label_row_segments(renderable) -> list:
+    """Return the segments of the first row, up to the line break."""
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    row = []
+    for segment in console.render(renderable):
+        if segment.text == "\n":
+            break
+        row.append(segment)
+    return row
+
+
+def make_renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_explicit_name():
+    tab = Tab("Home", "start")
+    assert tab.name == "start"
+    assert tab.label == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("A", "a") == Tab("A", "a")
+    assert Tab("A", "a") != Tab("A", "b")
+    assert Tab("A", "a") != Tab("B", "a")
+
+
+def test_tab_repr_shows_both_fields():
+    assert repr(Tab("A", "a")) == "Tab(label='A', name='a')"
+
+
+def test_no_tabs_row_layout():
+    lines = plain_lines(Tabs([]).render())
+    assert lines == ["", "━" * 100]
+
+
+def test_initial_active_tab_is_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_given_active_tab_starts_bar_at_its_index():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    assert tabs._active_tab_name == "C"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    assert Tabs([])._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+
+
+def test_find_tab_by_name_missing_returns_zero():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y")])
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_selects_last():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_selects_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_number_beyond_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B")
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+
+
+def test_first_char_search_is_case_insensitive_and_starts_after_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+
+
+def test_first_char_search_wraps_to_start():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")], active_tab="Avocado")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Banana")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    renderable = make_renderable(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], active_tab_name="x"
+    )
+    labels = [tab.label for tab in renderable.displayed_tabs()]
+    assert labels == ["C", "B"]
+    assert plain_lines(renderable)[0] == " C  B "
+
+
+def test_underline_highlights_active_tab_cells_and_edges():
+    renderable = make_renderable(
+        [Tab("A"), Tab("B"), Tab("C")], active_tab_name="A", tab_padding=1
+    )
+    underline = plain_lines(renderable)[1]
+    # Label "A" occupies cell 1, so the half glyphs sit on cells 0 and 2
+    assert underline[:3] == "╸━╺"
+    assert len(underline) == 100
+
+
+def test_underline_moves_with_bar_position():
+    renderable = make_renderable(
+        [Tab("A"), Tab("B"), Tab("C")],
+        active_tab_name="B",
+        bar_position=1.0,
+        tab_padding=1,
+    )
+    underline = plain_lines(renderable)[1]
+    # Label "B" occupies cell 4, so the highlight is cell 4 with half glyphs at 3 and 5
+    assert underline[:6] == "━━━╸━╺"
+
+
+def test_inactive_labels_carry_click_action_and_active_does_not():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About")], active_tab_name="Home", tab_padding=1
+    )
+    row = label_row_segments(renderable)
+
+    def has_click(segment) -> bool:
+        return bool(segment.style and segment.style.meta)
+
+    clicked = [segment for segment in row if has_click(segment)]
+    unclicked = [segment for segment in row if not has_click(segment)]
+
+    assert "".join(segment.text for segment in clicked) == " About "
+    assert all(
+        segment.style.meta == {"@click": "range_clicked('About')"}
+        for segment in clicked
+    )
+    assert "".join(segment.text for segment in unclicked) == " Home "
+
+
+def test_inactive_padding_cells_share_label_click_action():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About")], active_tab_name="Home", tab_padding=2
+    )
+    row = label_row_segments(renderable)
+    clicked_text = "".join(
+        segment.text
+        for segment in row
+        if segment.style and segment.style.meta
+    )
+    # Both padding cells on each side of the label are part of the clicked run
+    assert clicked_text == "  About  "
