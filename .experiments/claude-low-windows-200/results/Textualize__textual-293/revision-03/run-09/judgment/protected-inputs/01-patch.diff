+            Opacity(text_with_meta, opacity=0.5)
+        )
+    )
+    assert segments[0].text == "Hello"
+    assert segments[0].style.meta == {"@click": "range_clicked('home')"}
+    assert segments[0].style.color.triplet == (127, 127, 0)
