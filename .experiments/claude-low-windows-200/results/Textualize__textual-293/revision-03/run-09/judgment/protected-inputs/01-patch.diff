+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application for the Tabs widget."""
+
+    def on_mount(self):
+        """Mount example Tabs widgets directly on the app."""
+        self.mount(
+            first=Tabs(
+                [Tab("Home"), Tab("Projects"), Tab("Settings"), Tab("Help")],
+                active_tab="Projects",
+            ),
+            second=Tabs(
+                [
+                    Tab("One", "alpha"),
+                    Tab("Two", "beta"),
+                    Tab("Two again", "beta"),
+                    Tab("Three", "gamma"),
+                ],
+                active_tab="beta",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
