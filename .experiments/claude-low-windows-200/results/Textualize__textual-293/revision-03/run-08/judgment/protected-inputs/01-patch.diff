diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..f62692e
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,483 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import floor
+from typing import Iterable
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab shown in a [Tabs][textual.widgets.tabs.Tabs] widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A layout edge for the tab labels (see ``layout_resolve``)."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+@dataclass(frozen=True)
+class TabLayout:
+    """Column positions of a displayed tab.
+
+    Args:
+        name (str): The tab name.
+        label (str): The tab label.
+        padded_start (int): First column of the selection range (left padding).
+        label_start (int): First column of the label text.
+        label_end (int): End column (exclusive) of the label text.
+        padded_end (int): End column (exclusive) of the selection range (right padding).
+        left_padding (int): Number of cells in the left padding.
+        right_padding (int): Number of cells in the right padding.
+    """
+
+    name: str
+    label: str
+    padded_start: int
+    label_start: int
+    label_end: int
+    padded_end: int
+    left_padding: int
+    right_padding: int
+
+    @property
+    def label_range(self) -> tuple[int, int]:
+        """The columns occupied by the label, excluding padding."""
+        return (self.label_start, self.label_end)
+
+    @property
+    def selection_range(self) -> tuple[int, int]:
+        """The columns occupied by the padded span, which receives clicks."""
+        return (self.padded_start, self.padded_end)
+
+
+def _displayed_tabs(tabs: Iterable[Tab]) -> list[Tab]:
+    """Compute the displayed tabs: one per distinct name.
+
+    The position is that of the first tab with the name, and the label comes from
+    the last tab with the name.
+    """
+    displayed: dict[str, Tab] = {}
+    for tab in tabs:
+        displayed[tab.name] = tab
+    return list(displayed.values())
+
+
+class TabsRenderable:
+    """Renders the label row and underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into the full tab list placing the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding size in cells, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+        self.displayed_tabs = _displayed_tabs(tabs)
+
+    def compute_layout(self, width: int) -> list[TabLayout]:
+        """Lay out the displayed tabs across a width.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[TabLayout]: One entry per displayed tab, in display order.
+        """
+        padding_size = self.tab_padding if self.tab_padding else None
+
+        edges: list[_Edge] = []
+        roles: list[tuple[int, str]] = []
+        for index, tab in enumerate(self.displayed_tabs):
+            edges.append(_Edge(size=padding_size))
+            roles.append((index, "left"))
+            label_width = cell_len(tab.label)
+            if label_width:
+                edges.append(_Edge(size=label_width, min_size=label_width))
+                roles.append((index, "label"))
+            edges.append(_Edge(size=padding_size))
+            roles.append((index, "right"))
+
+        sizes = layout_resolve(width, edges)
+
+        count = len(self.displayed_tabs)
+        padded_starts = [0] * count
+        padded_ends = [0] * count
+        label_starts = [0] * count
+        label_ends = [0] * count
+        left_paddings = [0] * count
+        right_paddings = [0] * count
+
+        cursor = 0
+        for (index, role), size in zip(roles, sizes):
+            if role == "left":
+                padded_starts[index] = cursor
+                left_paddings[index] = size
+                label_starts[index] = label_ends[index] = cursor + size
+            elif role == "label":
+                label_starts[index] = cursor
+                label_ends[index] = cursor + size
+            else:
+                right_paddings[index] = size
+                padded_ends[index] = cursor + size
+            cursor += size
+
+        return [
+            TabLayout(
+                name=tab.name,
+                label=tab.label,
+                padded_start=padded_starts[index],
+                label_start=label_starts[index],
+                label_end=label_ends[index],
+                padded_end=padded_ends[index],
+                left_padding=left_paddings[index],
+                right_padding=right_paddings[index],
+            )
+            for index, tab in enumerate(self.displayed_tabs)
+        ]
+
+    def _highlight_range(self, layouts: list[TabLayout]) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position.
+
+        The bar position is a fractional index into the full tab list. The highlight
+        runs between the label of the floor index and the label of the next index
+        (wrapping at the end), and is mapped onto displayed tabs by name.
+        """
+        count = len(self.tabs)
+        if not layouts or count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0), count - 1)
+        floor_index = int(floor(position))
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+
+        displayed_index = {
+            tab.name: index for index, tab in enumerate(self.displayed_tabs)
+        }
+        current = layouts[displayed_index[self.tabs[floor_index].name]]
+        following = layouts[displayed_index[self.tabs[next_index].name]]
+
+        start_delta = following.label_start - current.label_start
+        end_delta = following.label_end - current.label_end
+        start = current.label_start + start_delta * fraction
+        end = current.label_end + end_delta * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        layouts = self.compute_layout(width)
+
+        for tab, layout in zip(self.displayed_tabs, layouts):
+            run = " " * layout.left_padding + tab.label + " " * layout.right_padding
+            if tab.name == self.active_tab_name:
+                text = Text(
+                    run,
+                    style=console.get_style(self.active_tab_style),
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                yield from console.render(text, options)
+            else:
+                tab_style = console.get_style(self.inactive_tab_style) + Style(
+                    meta={"@click": f"range_clicked({tab.name!r})"}
+                )
+                text = Text(
+                    run, style=tab_style, no_wrap=True, overflow="crop", end=""
+                )
+                yield from console.render(
+                    Opacity(text, self.inactive_text_opacity), options
+                )
+
+        yield Segment.line()
+
+        clickable_ranges = {
+            layout.name: layout.selection_range for layout in layouts
+        }
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(layouts),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected with the keyboard (left and right arrows, digit keys,
+    and first-character search) or with the mouse. The first row shows the
+    labels and the second row shows the underline.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. An unknown name is accepted, and the bar then
+            sits at index 0.
+        active_tab_style (StyleType, optional): Style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive tab
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed padding in cells on each side of a label.
+            ``None`` (or zero) auto-fits the padding to the available width. Defaults
+            to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character. Defaults to
+            ``True``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+
+        self._bar_position = float(self.find_tab_by_name(initial_name or ""))
+        self._active_tab_name = initial_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation.
+
+        The event is always marked handled, and it still propagates.
+
+        - With no tabs, nothing else happens.
+        - Escape clears focus from the widget.
+        - Left and right move to the previous and next tab, wrapping at either end.
+        - The digit keys 1 to 9 activate the tab at that position, and 0 follows
+          ``activate_tab_by_number``. Other characters are not digits.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab whose label starts with it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == "escape":
+            await self.app.set_focus(None)
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The tab name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0
+                if none match.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, is case-insensitive,
+        and never selects the active tab. The active tab is unchanged if nothing
+        else matches.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        if not self.tabs:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        target = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        Numbers 1 to the tab count select by 1-based position. Zero selects the 10th
+        tab when there are at least ten tabs, and otherwise the last tab. A number
+        greater than the tab count is ignored.
+
+        Args:
+            tab_number (int): The tab number.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. This is the target of clicks.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
