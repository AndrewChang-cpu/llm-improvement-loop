diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..479b800
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,227 @@
+import io
+import re
+
+from rich.cells import cell_len
+from rich.color import Color
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+TAB_STYLE = "#f0f0f0 on #021720"
+BAR_STYLE = "#1BB152"
+INACTIVE_BAR_STYLE = "#455058"
+
+
+def make_tabs(**kwargs) -> Tabs:
+    tabs = [Tab("Home"), Tab("About", name="about"), Tab("Blog"), Tab("Contact")]
+    return Tabs(tabs, **kwargs)
+
+
+def make_renderable(tabs, active_tab_name=None, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style=TAB_STYLE,
+        active_bar_style=BAR_STYLE,
+        inactive_tab_style=TAB_STYLE,
+        inactive_bar_style=INACTIVE_BAR_STYLE,
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def segments_of(renderable, width=40):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(renderable, console.options))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", name="home").name == "home"
+
+
+def test_tab_equality_repr_and_str():
+    assert Tab("Home") == Tab("Home", name="Home")
+    assert Tab("Home") != Tab("Home", name="home")
+    assert repr(Tab("Home", name="home")) == "Tab(label='Home', name='home')"
+    assert str(Tab("Home", name="home")) == "Home"
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = make_tabs()
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0
+
+
+def test_initial_active_tab_given_sets_bar_position():
+    tabs = make_tabs(active_tab="Blog")
+    assert tabs._active_tab_name == "Blog"
+    assert tabs._bar_position == 2
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = make_tabs(active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0
+
+
+def test_tabs_without_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "x"), Tab("C", "y")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 2
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = make_tabs()
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Contact"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Home"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "about"
+
+
+def test_activate_tab_by_number_positions():
+    tabs = make_tabs()
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "about"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "about"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_is_last():
+    tabs = make_tabs()
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Contact"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs_is_tenth():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_first_char_starts_after_active_and_wraps():
+    tabs = make_tabs(active_tab="about")
+    tabs.activate_tab_by_first_char("c")
+    assert tabs._active_tab_name == "Contact"
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = make_tabs(active_tab="about")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "about"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = make_tabs()
+    tabs.action_range_clicked("Blog")
+    assert tabs._active_tab_name == "Blog"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("A", "x"), Tab("B", "x"), Tab("C", "y")]
+    layouts = make_renderable(tabs).compute_layout(40)
+
+    assert [layout.name for layout in layouts] == ["x", "y"]
+    assert layouts[0].label == "B"
+
+
+def test_label_layout_is_contiguous_and_within_width():
+    tabs = make_tabs()
+    layouts = make_renderable(tabs).compute_layout(40)
+
+    for layout, tab in zip(layouts, tabs):
+        assert layout.label_end - layout.label_start == cell_len(tab.label)
+        assert layout.left_padding >= 1
+        assert layout.right_padding >= 1
+    for left, right in zip(layouts, layouts[1:]):
+        assert left.padded_end == right.padded_start
+    assert layouts[-1].padded_end <= 40
+
+
+def test_fixed_tab_padding_is_used_on_both_sides():
+    layouts = make_renderable(make_tabs(), tab_padding=2).compute_layout(60)
+
+    for layout in layouts:
+        assert layout.left_padding == 2
+        assert layout.right_padding == 2
+
+
+def test_zero_tab_padding_matches_auto_fit():
+    tabs = make_tabs()
+    auto = make_renderable(tabs, tab_padding=None).compute_layout(40)
+    zero = make_renderable(tabs, tab_padding=0).compute_layout(40)
+
+    assert auto == zero
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    output = render(make_renderable([]))
+
+    assert ANSI.sub("", output) == "\n" + "━" * 100
+
+
+def test_inactive_labels_are_dimmed_and_carry_click_action():
+    tabs = make_tabs()
+    segments = segments_of(make_renderable(tabs, active_tab_name="Home"))
+    about = next(segment for segment in segments if "About" in segment.text)
+
+    assert about.style.meta == {"@click": "range_clicked('about')"}
+    assert about.style.color.triplet != Color.parse(TAB_STYLE.split()[0]).triplet
+
+
+def test_active_label_has_no_click_action():
+    tabs = make_tabs()
+    segments = segments_of(make_renderable(tabs, active_tab_name="Home"))
+    home = next(segment for segment in segments if "Home" in segment.text)
+
+    assert not home.style.meta
+
+
+def test_underline_cells_under_active_tab_carry_its_click_action():
+    tabs = make_tabs()
+    renderable = make_renderable(tabs, active_tab_name="Home")
+    layout = renderable.compute_layout(40)[0]
+
+    segments = segments_of(renderable)
+    newline_index = next(i for i, seg in enumerate(segments) if seg.text == "\n")
+    column = 0
+    metas = {}
+    for segment in segments[newline_index + 1 :]:
+        for _ in segment.text:
+            metas[column] = segment.style.meta.get("@click")
+            column += 1
+
+    for cell in range(*layout.selection_range):
+        assert metas[cell] == "range_clicked('Home')"
+
+
+def test_active_bar_highlights_label_of_active_tab():
+    tabs = make_tabs()
+    renderable = make_renderable(tabs, active_tab_name="Home", bar_position=0)
+    layout = renderable.compute_layout(40)[0]
+
+    segments = segments_of(renderable)
+    newline_index = next(i for i, seg in enumerate(segments) if seg.text == "\n")
+    column = 0
+    highlight = None
+    for segment in segments[newline_index + 1 :]:
+        for _ in segment.text:
+            if column == layout.label_start:
+                highlight = segment.style.color
+            column += 1
+
+    assert highlight is not None
+    assert highlight.triplet == Color.parse(BAR_STYLE).triplet
