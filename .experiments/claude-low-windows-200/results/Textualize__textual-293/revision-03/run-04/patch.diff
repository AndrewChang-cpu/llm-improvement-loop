+++ b/tests/widgets/test_tabs.py
@@ -0,0 +1,193 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+_ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _rows(output: str) -> list[str]:
+    """Split rendered output into plain-text rows."""
+    return _ANSI.sub("", output).split("\n")
+
+
+def _cell_meta(renderable, width: int = 100) -> list[list[dict]]:
+    """Return the style meta of every cell, grouped by row."""
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rows: list[list[dict]] = [[]]
+    for segment in console.render(renderable, console.options):
+        if segment.control:
+            continue
+        meta = segment.style.meta if segment.style else {}
+        for char in segment.text:
+            if char == "\n":
+                rows.append([])
+            else:
+                rows[-1].append(meta)
+    return rows
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "h") != Tab("Home", "home")
+    assert "Home" in repr(Tab("Home", "h")) and "'h'" in repr(Tab("Home", "h"))
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_used_when_given():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    assert tabs._active_tab_name == "C"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_starts_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_empty_tabs_have_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_bar_starts_under_displayed_tab_for_duplicate_names():
+    tabs = Tabs([Tab("A", "x"), Tab("A2", "x"), Tab("B", "y")], active_tab="y")
+    # The displayed tabs are [x, y], so y sits at displayed index 1.
+    assert tabs._bar_position == 1.0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_greater_than_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B")
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_tabs_is_last():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs_is_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Home"), Tab("docs"), Tab("Hello"), Tab("Help")], active_tab="Home"
+    )
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Hello"
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "Help"
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Hi")], active_tab="Home")
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Hi"
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    rows = _rows(render(Tabs([]).render()))
+    assert rows == ["", "━" * 100]
+
+
+def test_label_row_and_underline_row_render_two_rows():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    rows = _rows(render(tabs.render()))
+    assert len(rows) == 2
+    assert rows[0].split() == ["Home", "Docs"]
+
+
+def test_underline_highlights_active_label_with_half_glyph_edges():
+    # Labels with one-cell padding: Home spans 0-6 with label 1-5, Docs spans 6-12
+    # with label 7-11. The highlight covers the Docs label.
+    tabs = Tabs(
+        [Tab("Home"), Tab("Docs"), Tab("Help")], active_tab="Docs", tab_padding=1
+    )
+    underline = _rows(render(tabs.render()))[1]
+    assert underline[6] == "╸"
+    assert underline[7:11] == "━━━━"
+    assert underline[11] == "╺"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("First", "a"), Tab("Second", "b"), Tab("Third", "a")])
+    rows = _rows(render(tabs.render()))
+    assert rows[0].split() == ["Third", "Second"]
+
+
+def test_inactive_label_cells_carry_click_action_and_active_label_does_not():
+    tabs = Tabs(
+        [Tab("Home"), Tab("Docs"), Tab("Help")], active_tab="Docs", tab_padding=1
+    )
+    label_row, underline_row = _cell_meta(tabs.render())
+    # Left padding and label of the inactive "Home" tab.
+    assert label_row[0] == {"@click": "range_clicked('Home')"}
+    assert label_row[1] == {"@click": "range_clicked('Home')"}
+    # Active "Docs" label carries no click action.
+    assert "@click" not in label_row[7]
+    # Inactive "Help" label carries its own click action.
+    assert label_row[13] == {"@click": "range_clicked('Help')"}
+    # Underline cells keep the click action of every displayed tab, active included.
+    assert underline_row[0]["@click"] == "range_clicked('Home')"
+    assert underline_row[8]["@click"] == "range_clicked('Docs')"
