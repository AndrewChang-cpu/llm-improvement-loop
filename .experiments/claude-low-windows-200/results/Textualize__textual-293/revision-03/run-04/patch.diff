diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..ff6f376
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,474 @@
+from __future__ import annotations
+
+import math
+from typing import NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """An edge for layout_resolve: a fixed or flexible run of cells."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan(NamedTuple):
+    """Column positions of one displayed tab."""
+
+    selection_start: int
+    selection_end: int
+    label_start: int
+    label_end: int
+    left_padding: int
+    right_padding: int
+
+
+def _click_action(name: str) -> str:
+    return f"range_clicked({name!r})"
+
+
+class TabsRenderable:
+    """Lay out the tab labels and the underline bar for a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The displayed tabs, one per distinct name, in display order.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): Style of the active tab's padded label.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded labels.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed padding on each side of a label, or ``None``
+            (or zero) to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _tab_spans(self, width: int) -> list[_TabSpan]:
+        """Compute the column positions of every displayed tab.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: One span per displayed tab, in display order.
+        """
+        fixed_padding = (
+            self.tab_padding
+            if self.tab_padding and self.tab_padding > 0
+            else None
+        )
+        edges: list[_Edge] = []
+        label_widths: list[int] = []
+        for tab in self.tabs:
+            label_width = cell_len(tab.label)
+            label_widths.append(label_width)
+            edges.append(_Edge(size=fixed_padding))
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            edges.append(_Edge(size=fixed_padding))
+
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        position = 0
+        for label_width in label_widths:
+            left = sizes[cursor]
+            cursor += 1
+            if label_width:
+                label = sizes[cursor]
+                cursor += 1
+            else:
+                label = 0
+            right = sizes[cursor]
+            cursor += 1
+
+            label_start = position + left
+            label_end = label_start + label
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    selection_start=position,
+                    selection_end=selection_end,
+                    label_start=label_start,
+                    label_end=label_end,
+                    left_padding=left,
+                    right_padding=right,
+                )
+            )
+            position = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position.
+
+        Args:
+            spans (list[_TabSpan]): The spans returned by ``_tab_spans``.
+
+        Returns:
+            tuple[float, float]: The start and end of the highlight in cells.
+        """
+        count = len(spans)
+        if count == 0:
+            return (0, 0)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = floor_position % count
+        next_index = (index + 1) % count
+        current = spans[index]
+        following = spans[next_index]
+        start = current.label_start + fraction * (
+            following.label_start - current.label_start
+        )
+        end = current.label_end + fraction * (following.label_end - current.label_end)
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._tab_spans(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for tab, span in zip(self.tabs, spans):
+            padded = " " * span.left_padding + tab.label + " " * span.right_padding
+            if tab.name == self.active_tab_name:
+                yield Text(
+                    padded, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": _click_action(tab.name)}
+                )
+                yield Opacity(
+                    Text(
+                        padded,
+                        style=click_style,
+                        end="",
+                        no_wrap=True,
+                        overflow="crop",
+                    ),
+                    opacity=self.inactive_text_opacity,
+                )
+
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={
+                tab.name: (span.selection_start, span.selection_end)
+                for tab, span in zip(self.tabs, spans)
+            },
+            width=width,
+        )
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the keyboard (Left and Right move one tab, digit keys
+    select by position, and other characters search labels by first character) or
+    with the mouse (a click on a tab's label or the underline beneath it).
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. Tab names need not be unique.
+            A repeated name is shown once, at its first position, with the label of
+            its last occurrence.
+        active_tab (str, optional): The name of the initially active tab. If empty or
+            ``None``, the first tab is active. A name that matches no tab is kept, and
+            the underline sits at index 0. Defaults to ``None``.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the underline under the active tab.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of the labels of inactive tabs. Defaults
+            to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where 1.0
+            is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Duration in seconds of the underline animation when
+            the active tab changes. Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Cells of padding on each side of a label. ``None``
+            or zero fits the padding to the available width. Defaults to ``None``.
+        search_by_first_character (bool): If true, a key that is not a digit or an
+            arrow key activates the next tab whose label starts with that character.
+            Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = """
+    Tabs {
+        height: 2;
+    }
+    """
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """Return one tab per distinct name, in display order.
+
+        The position of each entry is where its name first appears, and its label is
+        taken from the last tab with that name.
+
+        Returns:
+            list[Tab]: The displayed tabs.
+        """
+        displayed: dict[str, Tab] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab
+        return list(displayed.values())
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Return the index of a name in the displayed tabs, or 0 if absent."""
+        for index, tab in enumerate(self._displayed_tabs()):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of a tab in the full tab list by name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full tab list, and
+        never selects the active tab. The comparison ignores case. If no other tab
+        matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match at the start of a tab label.
+        """
+        index = self.find_tab_by_name(self._active_tab_name)
+        count = len(self.tabs)
+        wanted = char.casefold()
+        for offset in range(1, count):
+            tab = self.tabs[(index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.casefold().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        A number greater than the tab count is ignored. The number 0 activates the 10th
+        tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0 for the 0 key rule.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Target of label and underline clicks.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the Tabs widget has focus.
+
+        Every key is marked handled, but the event keeps propagating so application
+        bindings still receive it. With no tabs, nothing else happens.
+
+        - Escape clears focus from the widget.
+        - Right and Left move to the next and previous tab, with wrap-around.
+        - The digit keys 0 through 9 activate a tab by position (see
+          ``activate_tab_by_number``). Other characters are not digits.
+        - Any other single character activates the next tab whose label starts with it,
+          if ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape.value:
+            await self.app.set_focus(None)
+        elif key == Keys.Right.value:
+            self.activate_next_tab()
+        elif key == Keys.Left.value:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    async def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the newly active tab.
+        """
+        if active_tab_name is None:
+            return
+        target = float(self._displayed_index(active_tab_name))
+        if target == self._bar_position:
+            return
+        self.animate(
+            "_bar_position",
+            target,
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
