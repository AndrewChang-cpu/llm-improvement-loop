@@ -0,0 +1,161 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain(renderable):
+    return ANSI.sub("", render(renderable))
+
+
+def _renderable(tabs, active=None, position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_repr_and_text():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "h")
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+    assert str(Tab("Home", "h")) == "Home"
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_and_bar_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+    default = Tabs([Tab("A"), Tab("B")])
+    assert default._active_tab_name == "A"
+    assert default._bar_position == 0.0
+
+    unknown = Tabs([Tab("A"), Tab("B")], active_tab="zzz")
+    assert unknown._active_tab_name == "zzz"
+    assert unknown._bar_position == 0.0
+
+
+def test_next_and_previous_wrap_around():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "B"
+    widget.activate_next_tab()
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "A"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "B"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "C"
+    widget.activate_tab_by_number(5)
+    assert widget._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_uses_tenth():
+    widget = Tabs([Tab(str(number)) for number in range(1, 12)])
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    widget = Tabs([Tab("Apple"), Tab("Avocado"), Tab("banana")], active_tab="Apple")
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Avocado"
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    widget = Tabs([Tab("Apple"), Tab("Avocado")], active_tab="Apple")
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs([Tab("A"), Tab("B")])
+    widget.action_range_clicked("B")
+    assert widget._active_tab_name == "B"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    text = _plain(
+        _renderable(
+            [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")],
+            active="a",
+            tab_padding=1,
+        )
+    )
+    first_row = text.split("\n")[0]
+    assert "One" not in first_row
+    assert "Three" in first_row
+    assert first_row.index("Three") < first_row.index("Two")
+
+
+def test_no_tabs_draws_empty_label_row_and_inactive_underline():
+    text = _plain(_renderable([]))
+    rows = text.split("\n")
+    assert rows == ["", "━" * 100]
+
+
+def test_fixed_padding_renders_label_row():
+    text = _plain(_renderable([Tab("A"), Tab("B")], active="A", tab_padding=1))
+    assert text.split("\n")[0] == " A  B "
+
+
+def test_auto_padding_fills_width():
+    renderable = _renderable([Tab("A"), Tab("B")], active="A")
+    spans = renderable._layout(10)
+    assert [span.selection_range for span in spans] == [(0, 5), (5, 10)]
+    assert [span.label_range for span in spans] == [(2, 3), (7, 8)]
+
+
+def test_inactive_tab_carries_click_action_and_opacity():
+    renderable = _renderable([Tab("A"), Tab("B")], active="A", tab_padding=1)
+    console = Console(width=10, file=io.StringIO(), color_system="truecolor")
+    items = list(renderable.__rich_console__(console, console.options))
+    inactive = items[1]
+    assert inactive.renderable.spans[-1].style.meta == {
+        "@click": "range_clicked('B')"
+    }
+
+
+def test_underline_clickable_ranges_follow_selection_ranges():
+    renderable = _renderable([Tab("A"), Tab("B")], active="A", tab_padding=1)
+    console = Console(width=10, file=io.StringIO(), color_system="truecolor")
+    items = list(renderable.__rich_console__(console, console.options))
+    bar_text = next(iter(items[-1].__rich_console__(console, console.options)))
+    first, second = bar_text.spans[-2:]
+    assert (first.start, first.end) == (0, 3)
+    assert first.style.meta == {"@click": "range_clicked('A')"}
+    assert (second.start, second.end) == (3, 6)
+    assert second.style.meta == {"@click": "range_clicked('B')"}
