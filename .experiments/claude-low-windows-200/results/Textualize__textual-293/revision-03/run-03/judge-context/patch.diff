diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..5fd8e52
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,454 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Optional
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: Optional[str] = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Compute one displayed tab per distinct name.
+
+    The position is that of the first tab with the name, and the label is that
+    of the last tab with the name.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    # Updating an existing key keeps its first position but takes the last label.
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+@dataclass
+class _Edge:
+    """A layout edge for the layout resolver."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+@dataclass
+class _TabSpan:
+    """Column placement of one displayed tab."""
+
+    tab: Tab
+    text: str
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs for the bar.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels.
+        tab_padding (int, optional): Fixed padding on each side of a label, or
+            ``None`` (or zero) to fit the padding to the width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: Optional[str],
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: Optional[int],
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Place each displayed tab in columns.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: One span per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=self.tab_padding or None))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=self.tab_padding or None))
+        sizes = layout_resolve(width, edges) if edges else []
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            selection_start = cursor
+            label_start = selection_start + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    tab=tab,
+                    text=" " * left + tab.label + " " * right,
+                    label_range=(label_start, label_end),
+                    selection_range=(selection_start, selection_end),
+                )
+            )
+            cursor = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the label range of the highlighted position.
+
+        Args:
+            spans (list[_TabSpan]): The placed displayed tabs.
+
+        Returns:
+            tuple[float, float]: The highlight range in columns.
+        """
+        count = len(spans)
+        if count == 0:
+            return (0, 0)
+        floor = math.floor(self.bar_position)
+        fraction = self.bar_position - floor
+        current = spans[floor % count].label_range
+        following = spans[(floor + 1) % count].label_range
+        start = current[0] + (following[0] - current[0]) * fraction
+        end = current[1] + (following[1] - current[1]) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+
+        for span in spans:
+            if span.tab.name == self.active_tab_name:
+                yield Text(
+                    span.text,
+                    style=self.active_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+            else:
+                text = Text(
+                    span.text,
+                    style=self.inactive_tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                text.apply_meta({"@click": f"range_clicked({span.tab.name!r})"})
+                yield Opacity(text, opacity=self.inactive_text_opacity)
+
+        yield Segment.line()
+
+        clickable_ranges = {
+            span.tab.name: span.selection_range for span in spans
+        }
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    A user can select a tab with the keyboard or the mouse. Tabs are identified by
+    name. Tab names need not be unique: a duplicated name is displayed once, at the
+    position of its first tab, with the label of its last tab.
+
+    Keys (while the widget has focus):
+        - Escape clears focus.
+        - Left and Right move to the previous and next tab, wrapping at either end.
+        - The digit keys 1 through 9 activate the tab at that 1-based position. The 0
+          key follows the rule of ``activate_tab_by_number``.
+        - Any other single character activates the next tab whose label begins with
+          that character, case-insensitively, when ``search_by_first_character`` is
+          true.
+
+    Every key event is marked handled, without stopping its propagation.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. An unknown name is accepted, and the bar then
+            sits at the first tab.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to the labels of inactive
+            tabs, from 0 (background color) to 1 (full color). Defaults to 0.5.
+        animation_duration (float): Duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label. A
+            value of ``None`` or zero fits the padding to the widget width. Defaults to
+            ``None``.
+        search_by_first_character (bool): Whether pressing a character key selects the
+            next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    can_focus = True
+
+    _active_tab_name: Reactive[Optional[str]] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: Optional[str] = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: Optional[int] = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: Optional[str] = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: Optional[str]) -> None:
+        """Animate the underline to the displayed tab with the new active name."""
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def _displayed_index(self, tab_name: Optional[str]) -> int:
+        """Index of a name among the displayed tabs, or 0 when not found."""
+        if tab_name is None:
+            return 0
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for tab navigation.
+
+        Escape clears focus. Left and Right move to the previous and next tab, with
+        wrap-around. The digit keys 1 through 9 activate by position, and 0 follows
+        the rule of ``activate_tab_by_number``. Any other single character activates
+        the next tab whose label starts with it, when search is enabled. The event is
+        marked handled but still propagates.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    def _move_active_tab(self, step: int) -> None:
+        """Make the tab ``step`` places away the active tab, skipping same-name tabs.
+
+        Args:
+            step (int): ``1`` for the next tab, ``-1`` for the previous tab.
+        """
+        count = len(self.tabs)
+        current = self.find_tab_by_name(self._active_tab_name)
+        for offset in range(1, count):
+            tab = self.tabs[(current + step * offset) % count]
+            if tab.name != self._active_tab_name:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        self._move_active_tab(1)
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        self._move_active_tab(-1)
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label begins with a character.
+
+        The search starts after the active tab, wraps, is case-insensitive, and never
+        selects the active tab. The active tab is unchanged if nothing matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        current = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(current + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based number.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: Optional[str]) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if none has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. This is the target of tab clicks.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
