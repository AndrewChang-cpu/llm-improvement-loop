+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows a Tabs widget."""
+
+    def on_mount(self) -> None:
+        """Mount a Tabs widget directly on the app."""
+        self.mount(
+            tabs=Tabs(
+                [
+                    Tab("Home"),
+                    Tab("Files", "files"),
+                    Tab("Settings", "settings"),
+                    Tab("Help"),
+                ],
+                active_tab="files",
+            )
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
