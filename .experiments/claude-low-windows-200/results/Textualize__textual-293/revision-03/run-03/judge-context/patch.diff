+
+def test_opacity_preserves_other_style_attributes():
+    text = Text("Hi", style="#ff0000 on #00ff00 bold", end="")
+    text.apply_meta({"@click": "range_clicked('a')"})
+    console = Console(width=20, color_system="truecolor", file=io.StringIO())
+    segments = [
+        segment
+        for segment in console.render(Opacity(text, opacity=0.5))
+        if segment.text == "Hi"
+    ]
+    assert len(segments) == 1
+    style = segments[0].style
+    assert style.bold
+    assert style.meta == {"@click": "range_clicked('a')"}
+    assert style.color.triplet == (127, 127, 0)
