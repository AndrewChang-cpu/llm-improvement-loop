+import io
+
 import pytest
+from rich.console import Console
+from rich.style import Style
 from rich.text import Text
 
 from tests.utilities.render import render
 from textual.renderables.opacity import Opacity
 
+
+def test_opacity_preserves_other_style_attributes_and_meta():
+    styled = Text(
+        "Hello, world!",
+        style=Style(
+            color="#ff0000",
+            bgcolor="#00ff00",
+            bold=True,
+            meta={"@click": "range_clicked('x')"},
+        ),
+        end="",
+    )
+    output = render(Opacity(styled, opacity=0.5))
+    assert "\x1b[1" in output
+    assert "38;2;127;127;0" in output
+
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(Opacity(styled, opacity=0.5)))
+    assert segments[0].style.meta == {"@click": "range_clicked('x')"}
+
 STOP = "\x1b[0m"
 
 
