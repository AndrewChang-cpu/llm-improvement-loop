diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..9d7cdfa
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,446 @@
+from __future__ import annotations
+
+import math
+from typing import NamedTuple, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = frozenset("0123456789")
+
+
+class Tab:
+    """A tab for the [Tabs][textual.widgets.tabs.Tabs] widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for `layout_resolve`.
+
+    Args:
+        size (int, optional): A fixed size, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of the remaining space. Defaults to 1.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan(NamedTuple):
+    """Column layout of one displayed tab."""
+
+    name: str
+    label: str
+    left_padding: int
+    right_padding: int
+    label_start: int
+    label_end: int
+    select_start: int
+    select_end: int
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the displayed tabs: one per distinct name, at the first position of
+    that name, with the label of the last tab with that name."""
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): The fractional index of the bar into the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int, optional): A fixed padding size per side, or ``None``
+            to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding and self.tab_padding > 0:
+            return _Edge(size=self.tab_padding)
+        return _Edge(size=None, min_size=1, fraction=1)
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Compute the label and selection ranges of each displayed tab."""
+        displayed = _displayed_tabs(self.tabs)
+        label_widths = [cell_len(tab.label) for tab in displayed]
+
+        edges: list[_Edge] = []
+        for label_width in label_widths:
+            edges.append(self._padding_edge())
+            if label_width:
+                edges.append(_Edge(size=label_width))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        position = 0
+        index = 0
+        for tab, label_width in zip(displayed, label_widths):
+            left = sizes[index]
+            index += 1
+            if label_width:
+                index += 1
+            right = sizes[index]
+            index += 1
+
+            label_start = position + left
+            label_end = label_start + label_width
+            select_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    name=tab.name,
+                    label=tab.label,
+                    left_padding=left,
+                    right_padding=right,
+                    label_start=label_start,
+                    label_end=label_end,
+                    select_start=position,
+                    select_end=select_end,
+                )
+            )
+            position = select_end
+        return spans
+
+    def _highlight_range(self, spans: Sequence[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the label range at the bar position.
+
+        The range runs from the floor index to the next index, wrapping at the end.
+        """
+        count = len(spans)
+        if count == 0:
+            return (0, 0)
+        index = min(max(int(math.floor(self.bar_position)), 0), count - 1)
+        fraction = min(max(self.bar_position - index, 0.0), 1.0)
+        current = spans[index]
+        following = spans[(index + 1) % count]
+        start_delta = following.label_start - current.label_start
+        end_delta = following.label_end - current.label_end
+        start = current.label_start + start_delta * fraction
+        end = current.label_end + end_delta * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for span in spans:
+            padded = (
+                " " * span.left_padding + span.label + " " * span.right_padding
+            )
+            if span.name == self.active_tab_name:
+                yield Segment(padded, active_style)
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked({span.name!r})"}
+                )
+                run = Text(
+                    padded,
+                    style=click_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+                yield from console.render(
+                    Opacity(run, opacity=self.inactive_text_opacity), options
+                )
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges={
+                span.name: (span.select_start, span.select_end) for span in spans
+            },
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A tab is selected with the keyboard or the mouse. Selection is identified by
+    tab name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If not
+            given or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline bar.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a
+            label. If None or zero, the padding fits the widget width automatically.
+            Defaults to None.
+        search_by_first_character (bool): Whether pressing a character key activates the
+            next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Index of the displayed tab with the given name, or 0 if there is none."""
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of a tab in the full tab list.
+
+        Args:
+            tab_name (str): The name of the tab.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name or "")
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name or "")
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, is case-insensitive, wraps around the
+        tab list, and never selects the active tab. If no other tab matches, the
+        active tab is unchanged.
+
+        Args:
+            char (str): The character to search for.
+        """
+        start = self.find_tab_by_name(self._active_tab_name or "")
+        count = len(self.tabs)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based number.
+
+        The number 0 activates the tenth tab, or the last tab if there are fewer than
+        ten. A number greater than the number of tabs is ignored.
+
+        Args:
+            tab_number (int): The tab number.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(
+        self, old_name: str | None, new_name: str | None
+    ) -> None:
+        """Animate the underline bar to the newly active tab."""
+        if new_name is None:
+            return
+        target = float(self._displayed_index(new_name))
+        if old_name is None:
+            # Initial state: place the bar without animating.
+            self._bar_position = target
+        else:
+            self.animate(
+                "_bar_position",
+                target,
+                duration=self.animation_duration,
+                easing=self.animation_function,
+            )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for the tabs.
+
+        Escape clears focus. Left and right move to the previous and next tab,
+        wrapping. The digit keys 1 through 9 activate a tab by position, and 0
+        activates the tenth tab, or the last tab if there are fewer than ten. Other
+        single characters activate the next tab whose label starts with that
+        character, when ``search_by_first_character`` is true. Every key event is
+        marked handled without stopping its propagation.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
