+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain_lines(renderable) -> list[str]:
+    return ANSI_ESCAPE.sub("", render(renderable)).split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+    assert Tab("A") == Tab("A", "A")
+    assert Tab("A", "b") != Tab("A", "A")
+
+
+def test_tab_text_form_is_label_and_repr_shows_both_fields():
+    tab = Tab("Label", "name")
+    assert str(tab) == "Label"
+    assert "Label" in repr(tab) and "name" in repr(tab)
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_used_when_given():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="nope")
+    assert tabs._active_tab_name == "nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs._bar_position == 0.0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_uses_one_based_positions():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_uses_last_tab_when_fewer_than_ten():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_uses_tenth_tab_when_ten_or_more():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("banana"), Tab("Avocado"), Tab("apricot")],
+        active_tab="Apple",
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_render_returns_tabs_renderable():
+    assert isinstance(Tabs([Tab("A")]).render(), TabsRenderable)
+
+
+def test_label_row_and_underline_row_are_separate():
+    lines = _plain_lines(Tabs([Tab("One"), Tab("Two")]).render())
+    assert len(lines) == 2
+    assert "One" in lines[0] and "Two" in lines[0]
+    # The highlight adds half glyphs at its edges, so only check the glyph set.
+    assert len(lines[1]) == 100
+    assert set(lines[1]) <= {"━", "╸", "╺"}
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    lines = _plain_lines(Tabs([]).render())
+    assert lines == ["", "━" * 100]
+
+
+def test_fixed_tab_padding_sizes_each_side():
+    lines = _plain_lines(Tabs([Tab("A")], tab_padding=3).render())
+    assert lines[0] == "   A   "
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")])
+    lines = _plain_lines(tabs.render())
+    assert "Gamma" in lines[0]
+    assert "Beta" in lines[0]
+    assert "Alpha" not in lines[0]
+
+
+def test_inactive_label_padding_carries_click_action_and_active_does_not():
+    console = Console(width=40, file=io.StringIO(), color_system="truecolor")
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One")
+    segments = list(console.render(tabs.render()))
+
+    clicked = [
+        segment
+        for segment in segments
+        if segment.style and segment.style.meta.get("@click")
+    ]
+    assert {segment.style.meta["@click"] for segment in clicked} >= {
+        "range_clicked('Two')"
+    }
+    inactive_run = [segment for segment in clicked if "Two" in segment.text]
+    assert inactive_run and inactive_run[0].text.startswith(" ")
+    assert inactive_run[0].text.endswith(" ")
+
+    active_runs = [segment for segment in segments if "One" in segment.text]
+    assert active_runs
+    assert all(
+        segment.style.meta.get("@click") is None for segment in active_runs
+    )
