+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox demo for the Tabs widget."""
+
+    def on_mount(self) -> None:
+        self.mount(
+            sections=Tabs(
+                [Tab("Home"), Tab("Music"), Tab("Photos"), Tab("Videos")],
+            ),
+            numbers=Tabs(
+                [Tab("One"), Tab("Two"), Tab("Three")],
+                active_tab="Two",
+                tab_padding=2,
+            ),
+        )
+
+
+if __name__ == "__main__":
+    TabsDemo.run(css_file="tabs_demo.css")
