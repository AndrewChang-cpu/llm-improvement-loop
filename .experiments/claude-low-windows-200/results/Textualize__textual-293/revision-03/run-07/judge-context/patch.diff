diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..b46193b
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,433 @@
+from __future__ import annotations
+
+from typing import NamedTuple, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.style import Style
+from rich.text import Text, TextType
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = frozenset("0123456789")
+
+
+def _click_action(tab_name: str) -> str:
+    """Build the click action that activates the tab with the given name.
+
+    Args:
+        tab_name (str): The name of the tab.
+
+    Returns:
+        str: The action string, for example ``range_clicked('home')``.
+    """
+    return f"range_clicked({tab_name!r})"
+
+
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (TextType): The text displayed for the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: TextType, name: str | None = None) -> None:
+        self.label = label
+        self.name = str(label) if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return str(self.label)
+
+
+class _Edge:
+    """A layout edge for the layout resolver, sized in cells."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan(NamedTuple):
+    """Resolved columns for one displayed tab."""
+
+    name: str
+    label: str
+    left: int
+    right: int
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[tuple[str, str]]:
+    """Compute the displayed tabs, one per distinct name.
+
+    The position of each entry is where its name first appears, and its label
+    is taken from the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        list[tuple[str, str]]: The ``(name, label)`` pairs in display order.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = str(tab.label)
+    return list(labels.items())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, if any.
+        bar_position (float): Fractional index into the full tab list that places
+            the bar.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels.
+        tab_padding (int | None): Fixed padding in cells, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: str | Style,
+        active_bar_style: str | Style,
+        inactive_tab_style: str | Style,
+        inactive_bar_style: str | Style,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, displayed: list[tuple[str, str]], width: int) -> list[_TabSpan]:
+        """Divide the width between the padding and label edges of each tab.
+
+        Args:
+            displayed (list[tuple[str, str]]): The displayed ``(name, label)`` pairs.
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: The resolved columns for each displayed tab.
+        """
+        edges: list[_Edge] = []
+        for _, label in displayed:
+            padding = _Edge(size=self.tab_padding) if self.tab_padding else _Edge()
+            edges.extend([padding, _Edge(size=cell_len(label)), padding])
+
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        for index, (name, label) in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    name=name,
+                    label=label,
+                    left=left,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(cursor, selection_end),
+                )
+            )
+            cursor = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Compute the highlight from the bar position, in label-range columns.
+
+        Args:
+            spans (list[_TabSpan]): The resolved columns for each displayed tab.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        if not self.tabs or not spans:
+            return (0, 0)
+        by_name = {span.name: span for span in spans}
+        count = len(self.tabs)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        first = by_name[self.tabs[index].name].label_range
+        second = by_name[self.tabs[next_index].name].label_range
+        start = first[0] + (second[0] - first[0]) * fraction
+        end = first[1] + (second[1] - first[1]) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        spans = self._layout(displayed, width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_row = Text(no_wrap=True, overflow="crop", end="\n")
+        for span in spans:
+            padded_label = " " * span.left + span.label + " " * span.right
+            if span.name == self.active_tab_name:
+                label_row.append(padded_label, style=active_style)
+                continue
+            tab_style = inactive_style + Style(
+                meta={"@click": _click_action(span.name)}
+            )
+            dimmed = Text(
+                padded_label, style=tab_style, no_wrap=True, overflow="crop", end=""
+            )
+            for segment in console.render(
+                Opacity(dimmed, self.inactive_text_opacity), options
+            ):
+                label_row.append(segment.text, segment.style)
+        yield label_row
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges={span.name: span.selection_range for span in spans},
+            width=width,
+        )
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A tab is selected with the keyboard or the mouse. The selection is identified
+    by tab name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab's name. An unknown name is accepted, and the bar then sits at
+            index 0.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation, in
+            seconds. Defaults to 0.3.
+        animation_function (str): The name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a
+            label, or ``None`` to fit the tabs to the width. A value of zero is treated
+            as ``None``. Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: str | Style = "#f0f0f0 on #021720",
+        active_bar_style: str | Style = "#1BB152",
+        inactive_tab_style: str | Style = "#f0f0f0 on #021720",
+        inactive_bar_style: str | Style = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for tab navigation.
+
+        The event is always marked handled, and it keeps propagating.
+
+        - With no tabs, nothing else happens.
+        - Escape clears focus from the widget.
+        - Right and left move to the next and previous tab, wrapping at either end.
+        - The keys 0 through 9 are digit keys. They activate the tab at that 1-based
+          position, and 0 follows the rule of ``activate_tab_by_number``.
+        - Other single-character keys activate the next tab whose label starts with
+          that character, when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == "escape":
+            await self.app.set_focus(None)
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It never selects the
+        active tab, and it compares characters case-insensitively. If no other
+        tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if str(tab.label).lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        Args:
+            tab_number (int): The 1-based tab number. If it is 0, the 10th tab is
+                activated when there are at least ten tabs, and the last tab
+                otherwise. A number greater than the tab count does nothing.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0 if no
+            tab matches.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. This is the target of the click action.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
