+import io
+
+from rich.color import Color
+from rich.console import Console
+from rich.style import Style
+
+from textual.widgets.tabs import Tab, Tabs
+
+ACTIVE_BAR = Color.parse("#1BB152")
+ACTIVE_TAB = Color.parse("#f0f0f0")
+
+
+def _cells(renderable, width=40):
+    """Split rendered output into rows of (character, style) cells."""
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rows = [[]]
+    for segment in console.render(renderable, console.options):
+        if segment.control:
+            continue
+        for character in segment.text:
+            if character == "\n":
+                rows.append([])
+                continue
+            rows[-1].append((character, segment.style))
+    return rows
+
+
+def _click(style):
+    if style is None:
+        return None
+    return style.meta.get("@click")
+
+
+def _text(row):
+    return "".join(character for character, _ in row)
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+    assert "label='Home'" in repr(Tab("Home"))
+    assert "name='home'" in repr(Tab("Home", "home"))
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="nope")
+    assert tabs._active_tab_name == "nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    assert Tabs([])._active_tab_name is None
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 4)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "2"
+
+
+def test_zero_activates_last_tab_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 6)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "5"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado"), Tab("Blueberry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs._active_tab_name == "banana"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_activates_named_tab():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    rows = _cells(Tabs([]).render(), width=10)
+    assert len(rows) == 2
+    assert rows[0] == []
+    assert _text(rows[1]) == "━" * 10
+    assert {style.color for _, style in rows[1]} == {
+        Style.parse("#455058").color
+    }
+
+
+def test_labels_and_underline_render_on_two_rows():
+    rows = _cells(Tabs([Tab("One"), Tab("Two")]).render(), width=40)
+    assert len(rows) == 2
+    assert len(rows[0]) == 40
+    assert len(rows[1]) == 40
+    labels = _text(rows[0])
+    assert "One" in labels and "Two" in labels
+    assert labels.index("One") < labels.index("Two")
+
+
+def test_inactive_labels_carry_click_and_active_label_does_not():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="a")
+    rows = _cells(tabs.render(), width=40)
+    labels = _text(rows[0])
+    one_start = labels.index("One")
+    two_start = labels.index("Two")
+    for column in range(one_start, one_start + 3):
+        assert _click(rows[0][column][1]) is None
+    for column in range(two_start, two_start + 3):
+        assert _click(rows[0][column][1]) == "range_clicked('b')"
+        # Inactive labels are dimmed, so they differ from the active label color.
+        assert rows[0][column][1].color != ACTIVE_TAB
+
+
+def test_underline_under_active_tab_carries_its_click_action():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="a")
+    rows = _cells(tabs.render(), width=40)
+    labels = _text(rows[0])
+    one_start = labels.index("One")
+    assert _click(rows[1][one_start][1]) == "range_clicked('a')"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], active_tab="b"
+    )
+    rows = _cells(tabs.render(), width=40)
+    labels = _text(rows[0])
+    assert "One" not in labels
+    assert "Three" in labels and "Two" in labels
+    assert labels.index("Three") < labels.index("Two")
+
+    highlighted = [
+        column
+        for column, (_, style) in enumerate(rows[1])
+        if style.color == ACTIVE_BAR
+    ]
+    assert highlighted
+    two_start = labels.index("Two")
+    assert all(
+        _click(rows[1][column][1]) == "range_clicked('b')" for column in highlighted
+    )
+    assert highlighted == list(range(two_start, two_start + len("Two")))
