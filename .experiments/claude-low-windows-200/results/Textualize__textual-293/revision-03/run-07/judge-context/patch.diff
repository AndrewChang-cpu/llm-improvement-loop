@@ -1,6 +1,69 @@
+import pytest
+from rich.style import Style
+from rich.text import Text
+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
+
+class ConsoleDouble:
+    def get_style(self, style):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+class OptionsDouble:
+    max_width = 6
+
+
+def _render_single_text(bar):
+    items = list(bar.__rich_console__(ConsoleDouble(), OptionsDouble()))
+    assert len(items) == 1
+    assert isinstance(items[0], Text)
+    return items[0]
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        highlight_style="red",
+        background_style="green",
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+        width=6,
+    )
+    text = _render_single_text(bar)
+    # Highlight edges are half glyphs: "╸" before the highlight, "╺" after it.
+    assert text.plain == "━╸━━╺━"
+    click_spans = text.spans[-2:]
+    assert [(span.start, span.end) for span in click_spans] == [(0, 3), (3, 6)]
+    assert [span.style.meta for span in click_spans] == [
+        {"@click": "range_clicked('first')"},
+        {"@click": "range_clicked('second')"},
+    ]
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (3, 1), (-3, -1)])
+def test_zero_width_early_path_yields_background_only(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        background_style="green",
+        clickable_ranges={"first": (0, 3)},
+        width=6,
+    )
+    text = _render_single_text(bar)
+    assert text.plain == "━" * 6
+    assert all(not span.style.meta for span in text.spans)
+
+
+def test_zero_width_range_at_nonzero_position_keeps_click_span():
+    bar = UnderlineBar(
+        highlight_range=(2, 2),
+        clickable_ranges={"first": (2, 2)},
+        width=6,
+    )
+    text = _render_single_text(bar)
+    assert (text.spans[-1].start, text.spans[-1].end) == (2, 2)
+    assert text.spans[-1].style.meta == {"@click": "range_clicked('first')"}
+
