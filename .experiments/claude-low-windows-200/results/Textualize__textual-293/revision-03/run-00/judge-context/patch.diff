index 0000000..4f7b783
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,416 @@
+from __future__ import annotations
+
+from math import floor
+from typing import NamedTuple, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab item with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+
+class _PaddingEdge:
+    """Flexible padding edge for the layout resolver."""
+
+    size = None
+    min_size = 1
+    fraction = 1
+
+
+def _lerp(start: float, end: float, fraction: float) -> float:
+    """Linearly interpolate between two values."""
+    return start + (end - start) * fraction
+
+
+class _TabSpan(NamedTuple):
+    """Column positions of one displayed tab."""
+
+    name: str
+    label: str
+    pad_left: int
+    pad_right: int
+    label_start: int
+    label_end: int
+    sel_start: int
+    sel_end: int
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into the full tab list for the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the non-highlighted part of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int | None): Fixed padding size, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout_spans(self, width: int) -> list[_TabSpan]:
+        """Compute label and selection ranges for each displayed tab.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: One entry per displayed tab, in display order.
+        """
+        # One displayed tab per distinct name: first position, last label.
+        displayed: dict[str, str] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab.label
+
+        items = list(displayed.items())
+        label_widths = [cell_len(label) for _, label in items]
+
+        if self.tab_padding:
+            pads = [self.tab_padding] * (2 * len(items))
+        else:
+            remaining = width - sum(label_widths)
+            pads = layout_resolve(
+                remaining, [_PaddingEdge() for _ in range(2 * len(items))]
+            )
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        for index, ((name, label), label_width) in enumerate(zip(items, label_widths)):
+            pad_left = pads[2 * index]
+            pad_right = pads[2 * index + 1]
+            sel_start = cursor
+            label_start = sel_start + pad_left
+            label_end = label_start + label_width
+            sel_end = label_end + pad_right
+            spans.append(
+                _TabSpan(
+                    name=name,
+                    label=label,
+                    pad_left=pad_left,
+                    pad_right=pad_right,
+                    label_start=label_start,
+                    label_end=label_end,
+                    sel_start=sel_start,
+                    sel_end=sel_end,
+                )
+            )
+            cursor = sel_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            spans (list[_TabSpan]): The displayed tabs.
+
+        Returns:
+            tuple[float, float]: The highlight range in cells.
+        """
+        if not spans or not self.tabs:
+            return (0.0, 0.0)
+        span_by_name = {span.name: span for span in spans}
+        last_index = len(self.tabs) - 1
+        position = min(max(self.bar_position, 0.0), float(last_index))
+        floor_index = floor(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % len(self.tabs)
+        current = span_by_name[self.tabs[floor_index].name]
+        following = span_by_name[self.tabs[next_index].name]
+        start = _lerp(current.label_start, following.label_start, fraction)
+        end = _lerp(current.label_end, following.label_end, fraction)
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout_spans(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        row = Text(end="\n", no_wrap=True, overflow="crop")
+        for span in spans:
+            padded = f"{' ' * span.pad_left}{span.label}{' ' * span.pad_right}"
+            if span.name == self.active_tab_name:
+                row.append(padded, style=active_style)
+                continue
+            click_style = inactive_style + Style(
+                meta={"@click": f"range_clicked({span.name!r})"}
+            )
+            dimmed_text = Text(end="", no_wrap=True, overflow="ignore")
+            dimmed_text.append(padded, style=click_style)
+            dimmed = Opacity(dimmed_text, opacity=self.inactive_text_opacity)
+            for segment in console.render(dimmed, options):
+                if segment.text:
+                    row.append(segment.text, segment.style)
+        yield row
+
+        clickable_ranges = {span.name: (span.sel_start, span.sel_end) for span in spans}
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. An unknown name is kept as given.
+        active_tab_style (StyleType): Style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the non-highlighted underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab text, where
+            1.0 is fully visible. Defaults to ``0.5``.
+        animation_duration (float): Duration in seconds of the underline animation.
+            Defaults to ``0.3``.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label, or
+            ``None`` (or zero) to auto-fit the padding across the width. Defaults to
+            ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+
+        # Set the bar position before the name so the watcher animates from the
+        # starting position to itself.
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+        self._active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keyboard navigation.
+
+        Escape clears focus. Right and left move to the next and previous tab with
+        wrap-around. Digit keys ``0`` to ``9`` activate a tab by position (see
+        `activate_tab_by_number`). Other single characters activate the next tab whose
+        label starts with that character when ``search_by_first_character`` is true.
+        Every key event is marked handled without stopping its propagation.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab after the active one whose label starts with a character.
+
+        The comparison is case-insensitive. The search wraps and never selects the
+        active tab. If no other tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        Tab number ``0`` activates the 10th tab when there are at least ten tabs,
+        and otherwise the last tab. A number greater than the tab count is ignored.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The tab name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0 if
+                no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Used as the click action for tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
