+    assert text.plain == "━" * 6
+    first, second = text.spans[-2], text.spans[-1]
+    assert (first.start, first.end) == (0, 3)
+    assert _click_meta(first.style) == "range_clicked('first')"
+    assert (second.start, second.end) == (3, 6)
+    assert _click_meta(second.style) == "range_clicked('second')"
+
+
+def test_zero_width_early_path_has_no_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(0, 0),
+        background_style="green",
+        clickable_ranges={"tab": (0, 3)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(_FakeConsole(), _FakeOptions()))
+
+    assert len(items) == 1
+    text = items[0]
+    assert text.plain == "━" * 6
+    assert all(_click_meta(span.style) is None for span in text.spans)
+
+
+def test_negative_end_early_path_has_no_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(-5, -2),
+        background_style="green",
+        clickable_ranges={"tab": (0, 3)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(_FakeConsole(), _FakeOptions()))
+
+    assert len(items) == 1
+    assert all(_click_meta(span.style) is None for span in items[0].spans)
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..7ba398a
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,245 @@
+import io
+import re
+
+from rich.color_triplet import ColorTriplet
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
+ACTIVE_BAR = ColorTriplet(27, 177, 82)  # #1BB152
+
+
+def make_renderable(tabs, active=None, position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def plain(renderable) -> str:
+    return ANSI_RE.sub("", render(renderable))
+
+
+def segments(renderable):
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable))
+
+
+def click_action(style):
+    return style.meta.get("@click")
+
+
+def active_bar_text(renderable) -> str:
+    return "".join(
+        segment.text
+        for segment in segments(renderable)
+        if segment.style
+        and segment.style.color
+        and segment.style.color.triplet == ACTIVE_BAR
+    )
+
+
+# Tab
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Files")
+    assert tab.name == "Files"
+    assert str(tab) == "Files"
+
+
+def test_tab_with_explicit_name():
+    tab = Tab("Files", "files")
+    assert tab.label == "Files"
+    assert tab.name == "files"
+
+
+def test_tab_equality():
+    assert Tab("A", "a") == Tab("A", "a")
+    assert Tab("A", "a") != Tab("A", "b")
+    assert Tab("A") == Tab("A", "A")
+
+
+def test_tab_repr_shows_both_fields():
+    assert repr(Tab("A", "a")) == "Tab(label='A', name='a')"
+
+
+# Initial state
+
+
+def test_initial_active_tab_is_first_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_given_active_tab_is_used():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([], active_tab="anything")
+    assert tabs._active_tab_name is None
+
+
+# Lookup and activation
+
+
+def test_find_tab_by_name_returns_first_match_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+
+
+def test_find_tab_by_name_unknown_returns_zero():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_is_one_based():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_uses_last():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_uses_tenth():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_number_beyond_count_is_ignored():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")], active_tab="2")
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "2"
+
+
+def test_first_char_search_is_case_insensitive_and_starts_after_active():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")],
+        active_tab="Apple",
+    )
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("c")
+    assert tabs._active_tab_name == "Cherry"
+
+
+def test_first_char_search_wraps_around():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Cherry")], active_tab="Cherry")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Banana")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+# Rendering
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    output = plain(make_renderable([]))
+    assert output == "\n" + "━" * 100
+
+
+def test_label_row_and_underline_row_are_separated():
+    output = plain(make_renderable([Tab("Alpha"), Tab("Beta")], active="Alpha"))
+    lines = output.split("\n")
+    assert len(lines) == 2
+    assert "Alpha" in lines[0]
+    assert "Beta" in lines[0]
+
+
+def test_underline_highlights_active_label_width():
+    tabs = [Tab("Alpha"), Tab("Beta")]
+    renderable = make_renderable(tabs, active="Alpha", position=0)
+    assert active_bar_text(renderable) == "━" * len("Alpha")
+
+
+def test_fixed_tab_padding_is_used_on_each_side():
+    output = plain(
+        make_renderable([Tab("Alpha"), Tab("Beta")], active="Alpha", tab_padding=2)
+    )
+    assert output.split("\n")[0] == "  Alpha    Beta  "
+
+
+def test_inactive_padded_span_carries_click_action_and_active_does_not():
+    renderable = make_renderable(
+        [Tab("Alpha"), Tab("Beta")], active="Alpha", tab_padding=2
+    )
+    label_segments = segments(renderable)
+
+    beta = [segment for segment in label_segments if "Beta" in segment.text]
+    assert len(beta) == 1
+    assert beta[0].text.startswith("  ")
+    assert click_action(beta[0].style) == "range_clicked('Beta')"
+
+    alpha = [segment for segment in label_segments if "Alpha" in segment.text]
+    assert len(alpha) == 1
+    assert click_action(alpha[0].style) is None
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    tabs = [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")]
+    row = plain(make_renderable(tabs, active="x")).split("\n")[0]
+    assert "One" not in row
+    assert "Three" in row
+    assert row.index("Three") < row.index("Two")
+
+
+def test_underline_sits_under_displayed_tab_for_duplicate_name():
+    tabs = [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")]
+    position = Tabs(tabs).find_tab_by_name("x")
+    renderable = make_renderable(tabs, active="x", position=position)
+    assert active_bar_text(renderable) == "━" * len("Three")
