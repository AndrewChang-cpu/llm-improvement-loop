+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,416 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed in the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __str__(self) -> str:
+        return self.label
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+
+@dataclass
+class _Edge:
+    """A layout edge for the layout resolver: a fixed size or a flexible share."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the displayed tabs: one per distinct name, in first-occurrence order.
+
+    The label of each displayed tab comes from the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab text.
+        tab_padding (int | None): Fixed padding size in cells, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _resolve_spans(
+        self, displayed: Sequence[Tab], width: int
+    ) -> list[tuple[int, int, int]]:
+        """Split the width among each tab's left padding, label, and right padding.
+
+        Returns:
+            list[tuple[int, int, int]]: ``(left, label, right)`` cell sizes per tab.
+        """
+        padding = self.tab_padding or None
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=padding))
+        sizes = layout_resolve(width, edges)
+        return [
+            (sizes[index], sizes[index + 1], sizes[index + 2])
+            for index in range(0, len(sizes), 3)
+        ]
+
+    def _highlight_range(
+        self, displayed: Sequence[Tab], label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted label range at the bar position.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        count = len(displayed)
+        if count == 0:
+            return (0, 0)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = floor_position % count
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[displayed[index].name]
+        start_b, end_b = label_ranges[displayed[next_index].name]
+        return (
+            start_a + (start_b - start_a) * fraction,
+            end_a + (end_b - end_a) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        spans = self._resolve_spans(displayed, width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        cursor = 0
+        for tab, (left, label_size, right) in zip(displayed, spans):
+            selection_start = cursor
+            label_start = cursor + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            cursor = selection_end
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (selection_start, selection_end)
+
+            label_padding = max(0, label_size - cell_len(tab.label))
+            padded_text = (
+                " " * left + tab.label + " " * label_padding + " " * right
+            )
+            if tab.name == self.active_tab_name:
+                style = active_style
+                dim = False
+            else:
+                style = inactive_style + Style(
+                    meta={"@click": f"range_clicked({tab.name!r})"}
+                )
+                dim = True
+            text = Text(
+                padded_text,
+                style=style,
+                end="",
+                no_wrap=True,
+                overflow="crop",
+            )
+            renderable: RenderableType = (
+                Opacity(text, opacity=self.inactive_text_opacity) if dim else text
+            )
+            yield from console.render(renderable, options)
+
+        # Line break between the label row and the underline row
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(displayed, label_ranges),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Clicking a tab, or pressing its digit key, selects it. Left and right keys move
+    between tabs with wrap-around. Pressing a letter selects the next tab whose label
+    starts with that letter, if ``search_by_first_character`` is enabled.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            absent or empty, the first tab is active. Defaults to ``None``.
+        active_tab_style (StyleType, optional): Style of the active tab label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive tab
+            text, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration in seconds of the underline
+            animation. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed size in cells of the padding on each side
+            of a label, or ``None`` to fit the padding to the available width.
+            A value of zero is treated the same as ``None``. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            selects the next tab whose label starts with that letter. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            active_name: str | None = active_tab
+        elif self.tabs:
+            active_name = self.tabs[0].name
+        else:
+            active_name = None
+        self._active_tab_name = active_name
+        self._bar_position = float(self._displayed_index(active_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a name among the displayed tabs, or 0 if absent."""
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of a tab in the full tab list.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed index of the new active tab."""
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, ignores case, and never
+        selects the active tab. If no other tab matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A tab number of 0 activates the 10th tab if there are at least ten tabs,
+        otherwise the last tab. A number greater than the tab count is ignored.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Used by the click action on tab spans.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for navigation and selection.
+
+        Every key is marked handled without stopping propagation. With no tabs, nothing
+        else happens. Escape clears focus. Left and right move to the previous and next
+        tab. Digits 0 through 9 activate a tab by number (see
+        ``activate_tab_by_number``). Other single characters select the next tab whose
+        label starts with that character, if ``search_by_first_character`` is enabled.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape.value:
+            await self.app.set_focus(None)
+        elif key == Keys.Right.value:
+            self.activate_next_tab()
+        elif key == Keys.Left.value:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
