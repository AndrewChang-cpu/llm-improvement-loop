+def test_zero_width_early_path_yields_only_background_without_click_spans():
+    clickable = {"first": (0, 4)}
+    for bar in (
+        UnderlineBar(highlight_range=(0, 0), clickable_ranges=clickable, width=8),
+        UnderlineBar(highlight_range=(5, 2), clickable_ranges=clickable, width=8),
+    ):
+        items = _render_items(bar)
+        assert len(items) == 1
+        assert items[0].plain == "━" * 8
+        assert items[0].spans == []
+
+
+def test_zero_width_range_at_non_zero_position_keeps_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"first": (0, 4)},
+        width=8,
+    )
+    items = _render_items(bar)
+    assert len(items) == 1
+    assert items[0].spans[-1].style.meta == {"@click": "range_clicked('first')"}
