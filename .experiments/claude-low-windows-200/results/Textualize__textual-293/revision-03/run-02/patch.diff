+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def strip(text: str) -> str:
+    return ANSI.sub("", text)
+
+
+def make_tabs(*labels_and_names, **kwargs) -> Tabs:
+    tabs = [Tab(label, name) for label, name in labels_and_names]
+    return Tabs(tabs, **kwargs)
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert tab == Tab("Home", "Home")
+    assert tab != Tab("Home", "other")
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = make_tabs(("A", "a"), ("B", "b"), ("C", "b"))
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = make_tabs(("A", "a"), ("B", "b"))
+    assert tabs._active_tab_name == "a"
+
+
+def test_initial_active_tab_is_given_name():
+    tabs = make_tabs(("A", "a"), ("B", "b"), active_tab="b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = make_tabs(("A", "a"), ("B", "b"), active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_next_and_previous_wrap_around():
+    tabs = make_tabs(("A", "a"), ("B", "b"), ("C", "c"))
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number():
+    tabs = make_tabs(("A", "a"), ("B", "b"), ("C", "c"))
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_uses_tenth():
+    tabs = make_tabs(*[(str(i), f"t{i}") for i in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t9"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = make_tabs(("Home", "h"), ("Apple", "a"), ("Banana", "b"), ("apricot", "p"))
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "p"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_first_char_search_without_match_keeps_active_tab():
+    tabs = make_tabs(("Home", "h"), ("Apple", "a"), active_tab="h")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "h"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = make_tabs(("A", "a"), ("B", "b"))
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_inactive_underline():
+    output = strip(render(Tabs([]).render()))
+    assert output == "\n" + "━" * 100
+
+
+def test_label_row_and_underline_for_fixed_padding():
+    tabs = make_tabs(("One", "one"), ("Two", "two"), tab_padding=1)
+    label_row, underline = strip(render(tabs.render())).split("\n")
+    assert label_row == " One  Two "
+    # Active tab spans columns 1 to 4, shown with half glyphs at its edges
+    assert underline == "╸━━━╺" + "━" * 95
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = make_tabs(("First", "x"), ("Second", "y"), ("Third", "x"), tab_padding=1)
+    label_row = strip(render(tabs.render())).split("\n")[0]
+    assert "First" not in label_row
+    assert label_row.count("Third") == 1
+    assert label_row.index("Third") < label_row.index("Second")
+    assert tabs.find_tab_by_name("x") == 0
+
+
+def test_inactive_tab_padding_carries_click_action_and_is_dimmed():
+    tabs = make_tabs(("One", "one"), ("Two", "two"), tab_padding=1)
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render()))
+    row = []
+    for segment in segments:
+        if segment.text == "\n":
+            break
+        row.append(segment)
+    assert "".join(segment.text for segment in row) == " One  Two "
+    # The inactive tab's padded span carries its click action
+    inactive = [s for s in row if "Two" in s.text]
+    assert inactive
+    for segment in inactive:
+        assert segment.style.meta == {"@click": "range_clicked('two')"}
+    # The active tab's padded span carries no click action
+    active = [s for s in row if "One" in s.text]
+    assert active
+    for segment in active:
+        assert segment.style.meta == {}
