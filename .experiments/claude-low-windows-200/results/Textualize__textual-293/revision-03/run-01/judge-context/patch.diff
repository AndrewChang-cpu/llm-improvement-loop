+        clickable_ranges={"home": (0, 2), "about": (2, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    home_span, about_span = item.spans[-2:]
+    assert (home_span.start, home_span.end) == (0, 2)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
+    assert (about_span.start, about_span.end) == (2, 6)
+    assert about_span.style.meta == {"@click": "range_clicked('about')"}
+
+
+def test_clickable_ranges_keep_highlight_half_glyphs():
+    bar = UnderlineBar(
+        highlight_range=(2.5, 4.5),
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    assert _strip_ansi(render(bar)) == "━━╺━╸━"
+
+
+def test_zero_width_early_path_yields_background_only():
+    bar = UnderlineBar(clickable_ranges={"home": (0, 2)}, width=6)
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    assert item.spans == []
+
+
+def test_zero_width_highlight_at_non_zero_position_gets_click_spans():
+    bar = UnderlineBar(
