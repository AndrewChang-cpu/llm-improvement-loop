+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows Tabs widgets mounted on the app."""
+
+    def on_mount(self):
+        self.mount(
+            top=Tabs([Tab("Home"), Tab("Files"), Tab("Settings")]),
+            bottom=Tabs(
+                [Tab(str(number)) for number in range(1, 13)],
+                active_tab="5",
+                tab_padding=2,
+            ),
+        )
+
+
+if __name__ == "__main__":
+    TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
