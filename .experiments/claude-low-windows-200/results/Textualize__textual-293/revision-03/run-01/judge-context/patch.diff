+import io
+
+from rich.cells import cell_len
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+
+def _rows(renderable):
+    """Split rendered segments into rows at line breaks."""
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rows = [[]]
+    for segment in console.render(renderable):
+        if segment.text == "\n":
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    return rows
+
+
+def _plain_rows(renderable):
+    return ["".join(segment.text for segment in row) for row in _rows(renderable)]
+
+
+def _click_per_cell(row):
+    clicks = []
+    for segment in row:
+        click = segment.style.meta.get("@click") if segment.style else None
+        clicks.extend([click] * len(segment.text))
+    return clicks
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_repr_and_text():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "h")
+    assert str(Tab("Home", "h")) == "Home"
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Files")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_argument_is_used():
+    tabs = Tabs([Tab("Home"), Tab("Files")], active_tab="Files")
+    assert tabs._active_tab_name == "Files"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Files")], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_match_or_zero():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+    assert tabs.find_tab_by_name("B") == 1
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    tabs = Tabs([])
+    assert _plain_rows(tabs.render()) == ["", "━" * 100]
+
+
+def test_label_and_underline_rows_with_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Files")], tab_padding=1)
+    rows = _plain_rows(tabs.render())
+    assert rows[0] == " Home  Files "
+    # Highlight covers "Home" (cells 1-4) with half-cell glyphs at its edges
+    assert rows[1] == "╸" + "━" * 4 + "╺" + "━" * 94
+
+
+def test_wide_label_measured_in_cells():
+    tabs = Tabs([Tab("日本")], tab_padding=1)
+    assert cell_len(_plain_rows(tabs.render())[0]) == 6
+
+
+def test_inactive_label_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("Home"), Tab("Files")], tab_padding=1)
+    label_clicks = _click_per_cell(_rows(tabs.render())[0])
+    assert label_clicks[:6] == [None] * 6
+    assert label_clicks[6:13] == ["range_clicked('Files')"] * 7
+
+
+def test_underline_cells_carry_click_action_for_each_displayed_tab():
+    tabs = Tabs([Tab("Home"), Tab("Files")], tab_padding=1)
+    underline_clicks = _click_per_cell(_rows(tabs.render())[1])
+    assert underline_clicks[:6] == ["range_clicked('Home')"] * 6
+    assert underline_clicks[6:13] == ["range_clicked('Files')"] * 7
+
+
+def test_duplicate_names_display_once_at_first_position_with_last_label():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], tab_padding=1)
+    assert _plain_rows(tabs.render())[0] == " Three  Two "
+
+
+def test_underline_sits_under_displayed_tab_with_active_name():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")],
+        active_tab="b",
+        tab_padding=1,
+    )
+    underline = _plain_rows(tabs.render())[1]
+    # "Two" occupies label cells 8-10 of " Three  Two "
+    assert underline[7] == "╸"
+    assert underline[8:11] == "━━━"
+    assert underline[11] == "╺"
+
+
+def test_render_helper_matches_row_output():
+    tabs = Tabs([Tab("Home")], tab_padding=1)
+    assert render(tabs.render()).count("\n") == 1
