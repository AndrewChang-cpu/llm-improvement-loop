diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..d823a39
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,387 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Tuple
+
+from rich.cells import cell_len, set_cell_size
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A labelled tab, identified by a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: Optional[str] = None) -> None:
+        self.label = label
+        self.name: str = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """A layout edge for the layout resolver (padding or label cells)."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full ordered tab list.
+        active_tab_name (str, optional): The name of the active tab, if any.
+        bar_position (float): Fractional index into the full tab list that places
+            the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the non-highlighted part of the
+            underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs' text.
+        tab_padding (int, optional): Fixed padding cells on each side of a label, or
+            ``None`` (or zero) to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab_name: Optional[str],
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: Optional[int],
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _displayed_tabs(self) -> Dict[str, str]:
+        """Map each distinct name to its label.
+
+        A name appears once, at the position of its first tab, with the label of its
+        last tab.
+        """
+        displayed: Dict[str, str] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab.label
+        return displayed
+
+    def _highlight_range(
+        self, label_ranges: Dict[str, Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the label range for the current bar position."""
+        count = len(self.tabs)
+        if not count:
+            return (0, 0)
+        floor_index = min(max(int(math.floor(self.bar_position)), 0), count - 1)
+        fraction = min(max(self.bar_position - floor_index, 0.0), 1.0)
+        next_index = (floor_index + 1) % count
+
+        start_a, end_a = label_ranges[self.tabs[floor_index].name]
+        start_b, end_b = label_ranges[self.tabs[next_index].name]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = self._displayed_tabs()
+
+        # Three edges per displayed tab: left padding, label, right padding
+        edges: List[_TabEdge] = []
+        for label in displayed.values():
+            if self.tab_padding:
+                edges.append(_TabEdge(size=self.tab_padding))
+            else:
+                edges.append(_TabEdge())
+            edges.append(_TabEdge(size=cell_len(label)))
+            if self.tab_padding:
+                edges.append(_TabEdge(size=self.tab_padding))
+            else:
+                edges.append(_TabEdge())
+        sizes = layout_resolve(width, edges)
+
+        label_ranges: Dict[str, Tuple[int, int]] = {}
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        label_row: List[Segment] = []
+
+        cursor = 0
+        for index, (name, label) in enumerate(displayed.items()):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            span_text = " " * left + set_cell_size(label, label_size) + " " * right
+
+            label_start = cursor + left
+            label_ranges[name] = (label_start, label_start + label_size)
+            selection_ranges[name] = (cursor, cursor + left + label_size + right)
+            cursor += left + label_size + right
+
+            piece = Text(
+                span_text,
+                end="",
+                no_wrap=True,
+                overflow="crop",
+            )
+            if name == self.active_tab_name:
+                piece.stylize(self.active_tab_style)
+                label_row.extend(console.render(piece, options))
+            else:
+                piece.stylize(self.inactive_tab_style)
+                piece.stylize(Style(meta={"@click": f"range_clicked({name!r})"}))
+                dimmed = Opacity(piece, opacity=self.inactive_text_opacity)
+                label_row.extend(console.render(dimmed, options))
+
+        # The line break always separates the label row from the underline row
+        label_row.append(Segment("\n"))
+        yield from label_row
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline.
+
+    Tabs are selected by keyboard (left and right, digit keys, and first-character
+    search) or by mouse click. The active tab is shown by an underline bar that
+    animates to the newly active tab.
+
+    Args:
+        tabs (List[Tab]): The ordered tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. An empty string is treated as absent.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted underline. Defaults to
+            ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the non-highlighted underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Number of cells on each side of a label. Defaults
+            to ``None``, which auto-fits the tabs across the width. Zero is treated as
+            ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[Optional[str]] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: Optional[str] = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: Optional[int] = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: List[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: Optional[str] = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = None
+
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def watch__active_tab_name(self, active_tab_name: Optional[str]) -> None:
+        """Animate the underline to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for selecting tabs.
+
+        Left and right move to the previous and next tab, wrapping at either end.
+        Escape clears focus. The digit keys 1 through 9 activate the tab at that
+        1-based position, and 0 follows the rule of ``activate_tab_by_number``. Any
+        other single character activates the next tab whose label starts with that
+        character when ``search_by_first_character`` is true. Every key event is
+        marked handled, and propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape.value:
+            await self.app.set_focus(None)
+        elif key == Keys.Right.value:
+            self.activate_next_tab()
+        elif key == Keys.Left.value:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, and is case-insensitive. It
+        never selects the active tab. If no other tab matches, nothing changes.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        A number greater than the tab count is ignored. Zero activates the 10th tab
+        when there are at least ten tabs, and the last tab otherwise. Any other number
+        activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: Optional[str]) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab in the full tab list, or 0 if no
+                tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Invoked by clicks on a tab's range.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
