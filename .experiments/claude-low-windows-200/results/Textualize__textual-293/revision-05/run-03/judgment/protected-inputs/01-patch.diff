index 0000000..3caae05
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,410 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import EdgeDescription, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = tuple("0123456789")
+
+
+@dataclass
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    label: str
+    name: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Get the tabs that are rendered, one per distinct name.
+
+    Each name keeps the position of its first occurrence and the label of its last tab.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    last_tab_by_name = {tab.name: tab for tab in tabs}
+    return list(last_tab_by_name.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab.
+        bar_position (float): The fractional index of the underline into the
+            displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (StyleType): The style of each inactive tab's padded span.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int | None): The fixed padding on each side of a label, or
+            ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _edges(self, displayed: list[Tab]) -> list[EdgeDescription]:
+        """Describe the left padding, label, and right padding edge of each tab."""
+        padding_size = self.tab_padding or None
+        edges: list[EdgeDescription] = []
+        for tab in displayed:
+            edges.append(EdgeDescription(size=padding_size))
+            edges.append(EdgeDescription(size=cell_len(tab.label)))
+            edges.append(EdgeDescription(size=padding_size))
+        return edges
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted label range at the bar position.
+
+        Args:
+            label_ranges (list[tuple[int, int]]): The label range of each displayed tab.
+
+        Returns:
+            tuple[float, float]: The highlight range in columns.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(math.floor(position))
+        fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_ranges[index]
+        next_start, next_end = label_ranges[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        sizes = layout_resolve(width, self._edges(displayed))
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: list[tuple[int, int]] = []
+        pieces: list[RenderableType] = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            selection_start = cursor
+            label_start = cursor + left
+            label_end = label_start + label_width
+            cursor = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges.append((selection_start, cursor))
+
+            span_text = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                # The active span carries no click action.
+                pieces.append(
+                    Text(
+                        span_text,
+                        style=active_style,
+                        end="",
+                        no_wrap=True,
+                        overflow="crop",
+                    )
+                )
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+                pieces.append(
+                    Opacity(
+                        Text(
+                            span_text,
+                            style=click_style,
+                            end="",
+                            no_wrap=True,
+                            overflow="crop",
+                        ),
+                        opacity=self.inactive_text_opacity,
+                    )
+                )
+
+        for piece in pieces:
+            yield piece
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges={
+                tab.name: selection_range
+                for tab, selection_range in zip(displayed, selection_ranges)
+            },
+            width=width,
+        )
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by keyboard or mouse. The active tab is identified by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If empty
+            or absent, the first tab is active. Defaults to None.
+        active_tab_style (StyleType): The style of the active tab.
+            Defaults to "#f0f0f0 on #021720".
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to "#1BB152".
+        inactive_tab_style (StyleType): The style of inactive tabs.
+            Defaults to "#f0f0f0 on #021720".
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to "#455058".
+        inactive_text_opacity (float): The blend ratio applied to inactive tab
+            text, from 0 to 1. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation, in
+            seconds. Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the
+            underline animation. Defaults to "out_cubic".
+        tab_padding (int, optional): The number of cells on each side of a label.
+            ``None`` or zero fits the padding automatically to the width.
+            Defaults to None.
+        search_by_first_character (bool): Whether a key press selects the next tab
+            whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a name within the displayed tabs, or 0 if not displayed."""
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list,
+                or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed tab with the new active name."""
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It compares
+        case-insensitively and never selects the active tab. If no other tab
+        matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match against the first character of
+                each label.
+        """
+        active_name = self._active_tab_name
+        count = len(self.tabs)
+        start = self.find_tab_by_name(active_name)
+        wanted = char.casefold()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == active_name:
+                continue
+            if tab.label[:1].casefold() == wanted:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        A number greater than the tab count is ignored. Number 0 activates the 10th tab
+        when there are at least ten tabs, and the last tab otherwise. Any other number
+        activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. This is the target of clicks on tabs.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the Tabs widget receives key events.
+
+        The event is always marked handled, and it keeps propagating.
+
+        - With no tabs, nothing else happens.
+        - Escape calls the app's ``set_focus`` with no target. ``set_focus`` is a
+          coroutine, and this call does not await it, so the call does not run.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digit keys 0 through 9 activate a tab by number. Other characters
+          that are not in that range are not digits.
+        - Any other single-character key activates the next tab whose label starts with
+          that character, when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
