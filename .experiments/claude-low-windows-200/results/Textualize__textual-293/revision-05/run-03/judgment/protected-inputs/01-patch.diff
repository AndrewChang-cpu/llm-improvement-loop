+        clickable_ranges={"home": (0, 2), "files": (2, 4)},
+        width=6,
+    )
+    item = next(iter(bar.__rich_console__(ConsoleDouble(), OptionsDouble(6))))
+
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    home_span, files_span = item.spans[-2], item.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 2)
+    assert _click_meta(home_span) == "range_clicked('home')"
+    assert (files_span.start, files_span.end) == (2, 4)
+    assert _click_meta(files_span) == "range_clicked('files')"
+
+
+@pytest.mark.parametrize(
+    "highlight_range",
+    [(0, 0), (-5, -2), (4, 2)],
+)
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 2)},
+        width=6,
+    )
+    item = next(iter(bar.__rich_console__(ConsoleDouble(), OptionsDouble(6))))
+
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    assert item.spans
+    for span in item.spans:
+        assert _click_meta(span) is None
