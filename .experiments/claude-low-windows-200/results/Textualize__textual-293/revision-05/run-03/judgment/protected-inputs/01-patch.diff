+import io
+import itertools
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable) -> list[str]:
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def click_action(segment):
+    if segment.style is None:
+        return None
+    return segment.style.meta.get("@click")
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "start").name == "start"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "home")
+    assert str(Tab("Home", "start")) == "Home"
+
+
+def test_construction_with_empty_and_populated_tab_lists():
+    assert Tabs([]).tabs == []
+    assert Tabs([Tab("A")]).tabs[0].name == "A"
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_initial_active_tab_keeps_name_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_over_full_list():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_tab_by_number_with_fewer_than_ten_tabs():
+    tabs = Tabs([Tab("1"), Tab("2"), Tab("3")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "2"
+
+
+def test_activate_tab_by_number_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_character_search_skips_active_tab_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_range_clicked_action_activates_named_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    assert plain_lines(Tabs([]).render()) == ["", "━" * 100]
+
+
+def test_fixed_padding_label_row():
+    tabs = Tabs([Tab("Home"), Tab("Files")], tab_padding=1)
+    assert plain_lines(tabs.render())[0] == " Home  Files "
+
+
+def test_auto_fit_label_row_uses_layout_rule():
+    # Fixed cells: labels 4 + 5 = 9. Remaining 91 cells over 4 flexible edges:
+    # 22.75 each, with the fractional part carried forward.
+    tabs = Tabs([Tab("Home"), Tab("Files")])
+    expected = " " * 22 + "Home" + " " * 46 + "Files" + " " * 23
+    assert plain_lines(tabs.render())[0] == expected
+
+
+def test_duplicate_names_display_once_with_last_label_and_first_position():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    lines = plain_lines(tabs.render())
+    assert lines[0] == " C  B "
+    # The underline sits under the displayed tab "C", which has the active name.
+    assert lines[1] == "╸━╺" + "━" * 97
+
+
+def test_underline_highlights_active_tab_label_range():
+    tabs = Tabs([Tab("A"), Tab("B")], tab_padding=1, active_tab="B")
+    lines = plain_lines(tabs.render())
+    assert lines[1] == "━━━╸━╺" + "━" * 94
+
+
+def test_inactive_labels_carry_click_action_and_active_does_not():
+    tabs = Tabs([Tab("Home"), Tab("Files")], tab_padding=1)
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(tabs.render(), console.options))
+    label_segments = list(itertools.takewhile(lambda s: s.text != "\n", segments))
+
+    home = [segment for segment in label_segments if "Home" in segment.text]
+    files = [segment for segment in label_segments if "Files" in segment.text]
+    assert home and all(click_action(segment) is None for segment in home)
+    assert files and all(
+        click_action(segment) == "range_clicked('Files')" for segment in files
+    )
