+import io
+import re
+
+from rich.console import Console
+from rich.text import Text
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def render_plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("One").name == "One"
+    assert Tab("One", "one").name == "one"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("One") == Tab("One", "One")
+    assert Tab("One") != Tab("One", "one")
+    assert str(Tab("One", "one")) == "One"
+    assert "label='One'" in repr(Tab("One", "one"))
+    assert "name='one'" in repr(Tab("One", "one"))
+
+
+def test_construct_with_default_styles():
+    assert Tabs([]) is not None
+    assert Tabs([Tab("One"), Tab("Two")]) is not None
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], tab_padding=1
+    )
+    lines = render_plain(tabs.render()).split("\n")
+    assert len(lines) == 2
+    assert lines[0].rstrip() == " Three  Two"
+    # The active name "a" sits under the displayed "Three" label, cells 1 to 5.
+    assert lines[1] == "╸" + "━" * 5 + "╺" + "━" * 93
+
+
+def test_no_tabs_renders_empty_row_and_full_underline():
+    tabs = Tabs([])
+    assert render_plain(tabs.render()) == "\n" + "━" * 100
+
+
+def test_auto_fit_padding_is_derived_from_flexible_shares():
+    # Four flexible padding edges share 100 - 3 = 97 cells: 24.25 each, with the
+    # fractional part carried forward, giving 24, 24, 24, 25.
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    lines = render_plain(tabs.render()).split("\n")
+    expected = " " * 24 + "A" + " " * 48 + "BB" + " " * 25
+    assert lines[0] == expected
+
+
+def test_inactive_padded_span_carries_click_action():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    console = Console(width=20, file=io.StringIO())
+    items = list(tabs.render().__rich_console__(console, console.options))
+    label_row = items[0]
+    assert isinstance(label_row, Text)
+    assert label_row.plain == " One  Two "
+    clicks = [
+        (span.start, span.end, span.style.meta)
+        for span in label_row.spans
+        if span.style.meta
+    ]
+    # The inactive "Two" padded span covers characters 5 to 10 and nothing else.
+    assert clicks == [(5, 10, {"@click": "range_clicked('Two')"})]
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 4)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "T2"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T3"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "T3"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+
+
+def test_activate_tab_by_first_char_skips_active_and_wraps():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Banana"), Tab("Avocado")], active_tab="Apple"
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
