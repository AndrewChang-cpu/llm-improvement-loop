diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..5a1d67d
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,424 @@
+from __future__ import annotations
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for one span of cells, used with ``layout_resolve``.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take. Defaults to 1.
+        fraction (int): The share of the remaining space for a flexible edge.
+    """
+
+    def __init__(
+        self, size: int | None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Return one tab per distinct name.
+
+    Each entry takes the position of the first tab with its name and the label of
+    the last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+
+    Returns:
+        list[Tab]: The tabs to render.
+    """
+    last_by_name: dict[str, Tab] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its original position.
+        last_by_name[tab.name] = tab
+    return list(last_by_name.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str, optional): The name of the active tab.
+        bar_position (float): The bar position, as a fractional index into ``tabs``.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int, optional): A fixed padding size, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout_sizes(
+        self, displayed: list[Tab], width: int
+    ) -> list[tuple[int, int, int]]:
+        """Compute the left padding, label, and right padding sizes of each tab.
+
+        Args:
+            displayed (list[Tab]): The displayed tabs, in display order.
+            width (int): The available width in cells.
+
+        Returns:
+            list[tuple[int, int, int]]: Sizes in cells for each displayed tab.
+        """
+        padding = (
+            self.tab_padding
+            if self.tab_padding is not None and self.tab_padding > 0
+            else None
+        )
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(padding))
+            edges.append(_Edge(cell_len(tab.label)))
+            edges.append(_Edge(padding))
+        sizes = layout_resolve(width, edges)
+        return [
+            (sizes[index], sizes[index + 1], sizes[index + 2])
+            for index in range(0, len(sizes), 3)
+        ]
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (dict[str, tuple[int, int]]): Label range keyed by tab name.
+
+        Returns:
+            tuple[float, float]: The highlight start and end in cells.
+        """
+        count = len(self.tabs)
+        if not count:
+            return (0.0, 0.0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(position)
+        fraction = position - index
+        current_start, current_end = label_ranges[self.tabs[index].name]
+        next_name = self.tabs[(index + 1) % count].name
+        next_start, next_end = label_ranges[next_name]
+        start = current_start + (next_start - current_start) * fraction
+        end = current_end + (next_end - current_end) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        sizes = self._layout_sizes(displayed, width)
+
+        label_row = Text(end="", no_wrap=True)
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        click_action_format = "range_clicked('{name}')"
+
+        cursor = 0
+        for tab, (left, label_size, right) in zip(displayed, sizes):
+            label_width = cell_len(tab.label)
+            label_start = cursor + left
+            label_ranges[tab.name] = (label_start, label_start + label_width)
+            selection_ranges[tab.name] = (cursor, cursor + left + label_size + right)
+            cursor += left + label_size + right
+
+            trailing = max(label_size - label_width, 0) + right
+            piece = " " * left + tab.label + " " * trailing
+
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action and is not dimmed.
+                label_row.append(piece, self.active_tab_style)
+                continue
+
+            dimmed = console.render(
+                Opacity(
+                    Text(piece, style=self.inactive_tab_style, end="", no_wrap=True),
+                    opacity=self.inactive_text_opacity,
+                ),
+                options,
+            )
+            span_start = len(label_row)
+            for segment in dimmed:
+                if segment.text:
+                    label_row.append(segment.text, segment.style)
+            label_row.apply_meta(
+                {"@click": click_action_format.format(name=tab.name)},
+                span_start,
+                len(label_row),
+            )
+
+        highlight_range = self._highlight_range(label_ranges)
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield label_row
+        yield Segment.line()
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    A tab is selected with the keyboard or with the mouse. The active tab is
+    identified by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            ``None`` or empty, the first tab is active. Defaults to ``None``.
+        active_tab_style (StyleType): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+            Defaults to ``0.5``.
+        animation_duration (float): The duration of the underline animation, in
+            seconds. Defaults to ``0.3``.
+        animation_function (str): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            ``None`` or ``0`` fits the padding to the available width. Defaults to
+            ``None``.
+        search_by_first_character (bool): Whether pressing a character key moves to
+            the next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        else:
+            initial_name = tabs[0].name if tabs else None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, ignores case, wraps around the tab
+        list, and never selects the active tab. If no other tab matches, the active
+        tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a tab label.
+        """
+        count = len(self.tabs)
+        current = self.find_tab_by_name(self._active_tab_name)
+        target = char.casefold()
+        for offset in range(1, count):
+            tab = self.tabs[(current + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.casefold().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 selects the 10th tab when there are at least ten tabs, and the
+        last tab otherwise. A number greater than the tab count is ignored.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name. This is the target of tab clicks.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        Every key event is marked handled, and propagation is not stopped, so
+        application bindings still receive keys. With no tabs, nothing else happens.
+
+        - Escape makes a bare call to the app's ``set_focus`` with no target.
+        - Right and Left activate the next and previous tab, wrapping at the ends.
+        - The characters ``0`` to ``9`` activate a tab by number. Other characters,
+          including Unicode numerals, are not digit keys.
+        - Any other single character activates the next tab whose label starts with
+          it, when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
