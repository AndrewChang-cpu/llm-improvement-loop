+
+
+def _first_item(bar: UnderlineBar, max_width: int):
+    options = _OptionsDouble(max_width)
+    return next(iter(bar.__rich_console__(_ConsoleDouble(), options)))
+
+
+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+        width=6,
+    )
+    item = _first_item(bar, max_width=6)
+
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    first, second = item.spans[-2], item.spans[-1]
+    assert (first.start, first.end) == (0, 3)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert (second.start, second.end) == (3, 6)
+    assert second.style.meta == {"@click": "range_clicked('second')"}
