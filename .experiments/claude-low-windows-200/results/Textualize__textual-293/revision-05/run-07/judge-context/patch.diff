@@ -0,0 +1,167 @@
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.renderables.opacity import Opacity
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, _displayed_tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    """Render a renderable and remove the ANSI style codes."""
+    return ANSI_CODE.sub("", render(renderable))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home-tab").name == "home-tab"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "h")
+    assert str(Tab("Home", "h")) == "Home"
+    assert "label='Home'" in repr(Tab("Home", "h"))
+    assert "name='h'" in repr(Tab("Home", "h"))
+
+
+def test_construction_with_default_styles_and_empty_tabs():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_empty_tabs_render_empty_label_row_and_full_underline():
+    assert plain(Tabs([]).render()) == "\n" + "━" * 100
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_is_given_name():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_initial_active_tab_is_kept_and_bar_is_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("B") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_rules():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_number_zero_selects_tenth_tab_with_ten_or_more_tabs():
+    tabs = Tabs([Tab(f"T{index}") for index in range(10)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_char_search_starts_after_active_and_wraps():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("Dashboard"), Tab("Settings")])
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Docs"
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Dashboard"
+    tabs.activate_tab_by_first_char("d")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_first_char_search_is_case_insensitive_and_ignores_no_match():
+    tabs = Tabs([Tab("Home"), Tab("Docs"), Tab("Settings")])
+    tabs.activate_tab_by_first_char("S")
+    assert tabs._active_tab_name == "Settings"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Settings"
+
+
+def test_first_char_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.action_range_clicked("C")
+    assert tabs._active_tab_name == "C"
+
+
+def test_duplicate_names_are_displayed_once_with_last_label():
+    tabs = [Tab("Alpha", "a"), Tab("Beta", "b"), Tab("Gamma", "a")]
+    displayed = _displayed_tabs(tabs)
+    assert [tab.label for tab in displayed] == ["Gamma", "Beta"]
+    assert [tab.name for tab in displayed] == ["a", "b"]
+
+
+def test_label_row_with_fixed_padding_and_underline_under_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    lines = plain(tabs.render()).split("\n")
+
+    assert lines[0] == " One  Two "
+    bar = lines[1]
+    assert len(bar) == 100
+    assert bar[0] == "╸"
+    assert bar[1:4] == "━━━"
+    assert bar[4] == "╺"
+    assert set(bar[5:]) == {"━"}
+
+
+def test_auto_fit_padding_follows_flexible_share_rule():
+    # Fixed cells: "A" (1) and "BB" (2). Four flexible padding edges share 97 cells,
+    # 24.25 each. Whole cells are 24, 24, 24, 25 with the carried fraction.
+    tabs = Tabs([Tab("A"), Tab("BB")])
+    lines = plain(tabs.render()).split("\n")
+
+    assert lines[0] == " " * 24 + "A" + " " * 24 + " " * 24 + "BB" + " " * 25
+    bar = lines[1]
+    assert bar[23] == "╸"
+    assert bar[24] == "━"
+    assert bar[25] == "╺"
+
+
+def test_inactive_padded_span_carries_click_and_is_dimmed():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    console = Console(width=100)
+    items = list(tabs.render().__rich_console__(console, console.options))
+
+    active_label, inactive_label, _newline, bar = items
+    assert not active_label.spans
+    assert isinstance(inactive_label, Opacity)
+    assert inactive_label.opacity == 0.5
+    click = inactive_label.renderable.spans[0].style.meta
+    assert click == {"@click": "range_clicked('Two')"}
+    assert isinstance(bar, UnderlineBar)
+    assert bar.clickable_ranges == {"One": (0, 5), "Two": (5, 10)}
