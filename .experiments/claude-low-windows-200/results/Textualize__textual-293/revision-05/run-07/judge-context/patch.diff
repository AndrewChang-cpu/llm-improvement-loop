diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..8663e1a
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,494 @@
+from __future__ import annotations
+
+import math
+from typing import NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.style import Style
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab for the Tabs widget: a label, and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str | None, optional): The name used to select the tab.
+            Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A layout edge for one part of the tab row.
+
+    Args:
+        size (int | None): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take.
+        fraction (int): The share of the remaining space taken by a flexible edge.
+    """
+
+    __slots__ = ("size", "min_size", "fraction")
+
+    def __init__(
+        self, size: int | None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSlot(NamedTuple):
+    """Resolved columns for one displayed tab."""
+
+    tab: Tab
+    span_start: int
+    left_width: int
+    label_start: int
+    label_end: int
+    right_width: int
+    span_end: int
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Return one tab per distinct name.
+
+    Each entry takes the position of the first tab with that name, and the
+    label of the last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    displayed: list[Tab] = []
+    positions: dict[str, int] = {}
+    for tab in tabs:
+        position = positions.get(tab.name)
+        if position is None:
+            positions[tab.name] = len(displayed)
+            displayed.append(tab)
+        else:
+            displayed[position] = tab
+    return displayed
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list. Tabs with the same name are shown once.
+        active_tab_name (str | None): The name of the active tab, or ``None`` when
+            there are no tabs.
+        bar_position (float): Fractional index into the displayed tabs that places
+            the underline.
+        active_tab_style (str | Style): The style of the active tab's padded span.
+        active_bar_style (str | Style): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (str | Style): The style of each inactive tab's padded span.
+        inactive_bar_style (str | Style): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int | None): A fixed padding size in cells, or ``None`` to fit
+            the tabs to the width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: str | Style,
+        active_bar_style: str | Style,
+        inactive_tab_style: str | Style,
+        inactive_bar_style: str | Style,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        slots = self._layout(_displayed_tabs(self.tabs), width)
+
+        for slot in slots:
+            yield self._render_label(slot)
+
+        # A line break separates the label row from the underline row
+        yield Text("\n", end="", no_wrap=True, overflow="crop")
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(slots),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges={
+                slot.tab.name: (slot.span_start, slot.span_end) for slot in slots
+            },
+            width=width,
+        )
+
+    def _padding_edge(self) -> _Edge:
+        """Return the layout edge for one padding part of a tab."""
+        if self.tab_padding:
+            return _Edge(size=self.tab_padding)
+        return _Edge(size=None, min_size=1, fraction=1)
+
+    def _layout(self, displayed: list[Tab], width: int) -> list[_TabSlot]:
+        """Resolve the columns of every displayed tab.
+
+        Args:
+            displayed (list[Tab]): The displayed tabs, in display order.
+            width (int): The width available for the label row.
+
+        Returns:
+            list[_TabSlot]: The resolved columns for each tab.
+        """
+        edges: list[_Edge] = []
+        # Per tab: left padding edge index, right padding edge index, label width
+        edge_indices: list[tuple[int, int, int]] = []
+        for tab in displayed:
+            left = len(edges)
+            edges.append(self._padding_edge())
+            label_width = cell_len(tab.label)
+            if label_width > 0:
+                edges.append(_Edge(size=label_width))
+            right = len(edges)
+            edges.append(self._padding_edge())
+            edge_indices.append((left, right, label_width))
+
+        sizes = layout_resolve(width, edges)
+
+        slots: list[_TabSlot] = []
+        cursor = 0
+        for tab, (left, right, label_width) in zip(displayed, edge_indices):
+            left_width = sizes[left]
+            right_width = sizes[right]
+            label_start = cursor + left_width
+            label_end = label_start + label_width
+            span_end = label_end + right_width
+            slots.append(
+                _TabSlot(
+                    tab=tab,
+                    span_start=cursor,
+                    left_width=left_width,
+                    label_start=label_start,
+                    label_end=label_end,
+                    right_width=right_width,
+                    span_end=span_end,
+                )
+            )
+            cursor = span_end
+        return slots
+
+    def _render_label(self, slot: _TabSlot) -> RenderableType:
+        """Render the padded span of one tab.
+
+        The active tab carries no click action. Inactive tabs carry the click action
+        for their name and are dimmed by the inactive text opacity.
+
+        Args:
+            slot (_TabSlot): The resolved columns for the tab.
+
+        Returns:
+            RenderableType: The rendered padded span.
+        """
+        padded = " " * slot.left_width + slot.tab.label + " " * slot.right_width
+        if slot.tab.name == self.active_tab_name:
+            return Text(
+                padded,
+                style=self.active_tab_style,
+                end="",
+                no_wrap=True,
+                overflow="crop",
+            )
+        text = Text(
+            padded,
+            style=self.inactive_tab_style,
+            end="",
+            no_wrap=True,
+            overflow="crop",
+        )
+        text.apply_meta({"@click": f"range_clicked('{slot.tab.name}')"})
+        return Opacity(text, opacity=self.inactive_text_opacity)
+
+    def _highlight_range(self, slots: list[_TabSlot]) -> tuple[float, float]:
+        """Interpolate the highlighted columns from the bar position.
+
+        The highlight runs from the label of the tab at the floor of the bar
+        position to the label of the next tab, wrapping at the end.
+
+        Args:
+            slots (list[_TabSlot]): The resolved columns for each displayed tab.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        if not slots:
+            return (0, 0)
+        count = len(slots)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        current = slots[floor_position % count]
+        following = slots[(floor_position + 1) % count]
+        start = current.label_start + fraction * (
+            following.label_start - current.label_start
+        )
+        end = current.label_end + fraction * (following.label_end - current.label_end)
+        return (start, end)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by name. A tab can be activated with the Left and Right keys,
+    with the number keys, by typing the first character of its label, or by clicking it.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. The list may be empty.
+        active_tab (str | None, optional): The name of the initially active tab. If
+            it is ``None`` or empty, the first tab is active. Defaults to ``None``.
+        active_tab_style (str | Style, optional): The style of the active tab's
+            label. Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (str | Style, optional): The style of the underline under
+            the active tab. Defaults to ``"#1BB152"``.
+        inactive_tab_style (str | Style, optional): The style of the inactive tabs'
+            labels. Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (str | Style, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tabs, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the
+            underline animation when the active tab changes. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by
+            the underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): The number of cells on each side of a
+            label, or ``None`` to fit the tabs to the width. A value of zero is
+            treated as ``None``. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether typing a character
+            activates the next tab whose label starts with it. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: str | Style = "#f0f0f0 on #021720",
+        active_bar_style: str | Style = "#1BB152",
+        inactive_tab_style: str | Style = "#f0f0f0 on #021720",
+        inactive_bar_style: str | Style = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._bar_position = float(self._displayed_index_of(initial_name))
+        self._active_tab_name = initial_name
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the displayed tab with the new active name."""
+        self.animate(
+            "_bar_position",
+            self._displayed_index_of(active_tab_name),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle keys while the Tabs widget receives key events.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape makes a bare call to the app's ``set_focus`` with no target. The
+          call is not awaited, so it does not run.
+        - Right and Left activate the next and previous tab, wrapping at either end.
+        - The characters 0 through 9 activate a tab by number, as described in
+          ``activate_tab_by_number``.
+        - Any other single character activates the next tab whose label starts with
+          it, when ``search_by_first_character`` is true.
+
+        Every key is marked handled by preventing its default action. The event is
+        not stopped, so application bindings still receive it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full tab list, and
+        never selects the active tab. The comparison ignores case. If no other tab
+        matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for step in range(1, count + 1):
+            tab = self.tabs[(start + step) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        Numbers 1 through 9 select the tab at that 1-based position. A number greater
+        than the tab count is ignored. The number 0 selects the 10th tab when there
+        are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list, or 0
+                if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. This is the click action of a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def _displayed_index_of(self, tab_name: str | None) -> int:
+        """Return the index of a name among the displayed tabs, or 0 if it is absent.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The index of the displayed tab with that name.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
