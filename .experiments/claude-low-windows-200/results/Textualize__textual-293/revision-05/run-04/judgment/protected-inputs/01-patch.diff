index 0000000..0c1c056
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,427 @@
+from __future__ import annotations
+
+import math
+from typing import NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A size request for one layout edge, consumed by ``layout_resolve``.
+
+    Args:
+        size (int | None): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The smallest size a flexible edge may take.
+        fraction (int): The share of remaining space a flexible edge requests.
+    """
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _TabSpan(NamedTuple):
+    """Column layout of one displayed tab."""
+
+    name: str
+    label: str
+    left: int
+    right: int
+    span_range: tuple[int, int]
+    label_range: tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The displayed tabs, with one entry per distinct name.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int | None): Fixed padding in cells, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding:
+            return _Edge(size=self.tab_padding)
+        return _Edge(size=None, min_size=1, fraction=1)
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Compute the columns of every displayed tab for the given width."""
+        edges: list[_Edge] = []
+        for tab in self.tabs:
+            edges.append(self._padding_edge())
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        position = 0
+        for index, tab in enumerate(self.tabs):
+            left, label, right = sizes[index * 3 : index * 3 + 3]
+            label_start = position + left
+            spans.append(
+                _TabSpan(
+                    name=tab.name,
+                    label=tab.label,
+                    left=left,
+                    right=right,
+                    span_range=(position, label_start + label + right),
+                    label_range=(label_start, label_start + label),
+                )
+            )
+            position = label_start + label + right
+        return spans
+
+    def _bar_highlight(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges at the bar position."""
+        count = len(spans)
+        if count == 0:
+            return (0.0, 0.0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(math.floor(position))
+        fraction = position - index
+        current = spans[index]
+        following = spans[(index + 1) % count]
+        start = current.label_range[0] + (
+            following.label_range[0] - current.label_range[0]
+        ) * fraction
+        end = current.label_range[1] + (
+            following.label_range[1] - current.label_range[1]
+        ) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        # Label row: each padded span is one run, so padding shares its label's style
+        label_segments: list[Segment] = []
+        for span in spans:
+            padded = " " * span.left + span.label + " " * span.right
+            if span.name == self.active_tab_name:
+                piece = Text(
+                    padded, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+                label_segments.extend(console.render(piece, options))
+            else:
+                click_style = Style(meta={"@click": f"range_clicked('{span.name}')"})
+                piece = Text(
+                    padded,
+                    style=inactive_style + click_style,
+                    end="",
+                    no_wrap=True,
+                    overflow="crop",
+                )
+                label_segments.extend(
+                    console.render(
+                        Opacity(piece, opacity=self.inactive_text_opacity), options
+                    )
+                )
+        yield from Segment.adjust_line_length(label_segments, width)
+        yield Segment.line()
+
+        # Underline row
+        bar = UnderlineBar(
+            highlight_range=self._bar_highlight(spans),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges={span.name: span.span_range for span in spans},
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected by keyboard or mouse. Tabs are identified by name. Tabs that
+    share a name are displayed once, at the position of the first one, with the
+    label of the last one.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            not given or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType): Style of the active tab label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults
+            to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label,
+            or None to fit the padding to the widget width. Zero is treated as None.
+            Defaults to None.
+        search_by_first_character (bool): Whether a key that is not a digit or an
+            arrow activates the next tab whose label starts with that character.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        # Set the bar position before the active name, so the watcher finds no
+        # distance to animate on construction.
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """One tab per distinct name, at the first position, with the last label."""
+        displayed: dict[str, Tab] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab
+        return list(displayed.values())
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Index of a name within the displayed tabs, or 0 when it is not displayed."""
+        for index, tab in enumerate(self._displayed_tabs()):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, compares
+        case-insensitively, and never selects the active tab itself. If no other
+        tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        Numbers are 1-based. The number 0 selects the 10th tab when there are at least
+        ten tabs, and the last tab otherwise. A number greater than the tab count is
+        ignored.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with a given name. Dispatched by clicks on tab ranges.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        """Animate the underline to the displayed index of the new active tab."""
+        if tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Every key event is marked handled, without stopping its propagation.
+
+        With no tabs, nothing else happens. Otherwise:
+
+        - Escape calls ``set_focus`` on the app with no target. The call is made
+          without an await, so it does not run.
+        - Right and left activate the next and previous tab, with wrap-around.
+        - The digit keys 0 through 9 activate a tab by number. Only the characters
+          0 through 9 are digits. The rule is the one in ``activate_tab_by_number``.
+        - When ``search_by_first_character`` is true, any other single-character key
+          activates the next tab whose label starts with that character.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            # Not awaited: set_focus is a coroutine, so this call has no effect.
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
