+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (4, 2)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 2)},
+        width=6,
+    )
+    item = _first_rich_item(bar, 6)
+
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    assert item.spans
+    for span in item.spans:
+        assert "@click" not in span.style.meta
+
+
+def test_zero_width_highlight_at_position_gets_click_metadata():
+    bar = UnderlineBar(
+        highlight_range=(3, 3),
+        clickable_ranges={"docs": (2, 5)},
+        width=6,
+    )
+    item = _first_rich_item(bar, 6)
+
+    assert item.plain == "━━╸╺━━"
+    last_span = item.spans[-1]
+    assert (last_span.start, last_span.end) == (2, 5)
+    assert last_span.style.meta == {"@click": "range_clicked('docs')"}
