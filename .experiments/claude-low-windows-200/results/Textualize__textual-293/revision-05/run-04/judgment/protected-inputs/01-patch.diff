+import io
+import re
+
+from rich.cells import cell_len
+from rich.console import Console
+from rich.segment import Segment
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+WIDTH = 100
+
+
+def plain_rows(renderable) -> list[str]:
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def segment_rows(renderable) -> list[list[Segment]]:
+    console = Console(
+        width=WIDTH, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rows: list[list[Segment]] = [[]]
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n" and segment.control is None:
+            rows.append([])
+        else:
+            rows[-1].append(segment)
+    return rows
+
+
+def meta_at_column(row: list[Segment], column: int) -> dict:
+    position = 0
+    for segment in row:
+        width = cell_len(segment.text)
+        if position <= column < position + width:
+            return segment.style.meta if segment.style else {}
+        position += width
+    raise AssertionError(f"column {column} is outside the row")
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert Tab("Home", "start").name == "start"
+    assert str(tab) == "Home"
+    assert "Home" in repr(tab) and "Home" in repr(Tab("Home", "start"))
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert Tab("Home") != Tab("Docs")
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([]).tabs == []
+    assert len(Tabs([Tab("One"), Tab("Two", "two")]).tabs) == 2
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")])
+    assert tabs._active_tab_name == "a"
+
+
+def test_initial_active_tab_is_used_when_given():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b")], active_tab="b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")], active_tab="a")
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{i}", f"t{i}") for i in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_first_character_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs(
+        [Tab("Apple", "apple"), Tab("Avocado", "avocado"), Tab("Banana", "banana")],
+        active_tab="apple",
+    )
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "banana"
+
+
+def test_first_character_search_keeps_active_tab_when_no_other_match():
+    tabs = Tabs([Tab("Apple", "apple"), Tab("Banana", "banana")], active_tab="apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")])
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")], tab_padding=1
+    )
+    rows = plain_rows(tabs.render())
+    assert rows[0].rstrip() == " Three  Two"
+
+
+def test_label_row_auto_fit_padding():
+    # Width 100 minus two labels of 4 cells leaves 92 cells for four flexible
+    # padding edges, so each gets 23 cells.
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    rows = plain_rows(tabs.render())
+    assert rows[0] == " " * 23 + "Home" + " " * 46 + "Docs" + " " * 23
+
+
+def test_label_row_fixed_padding():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], tab_padding=1)
+    rows = plain_rows(tabs.render())
+    assert rows[0].rstrip() == " Home  Docs"
+
+
+def test_zero_padding_is_auto_fit():
+    auto = plain_rows(Tabs([Tab("Home"), Tab("Docs")]).render())
+    zero = plain_rows(Tabs([Tab("Home"), Tab("Docs")], tab_padding=0).render())
+    assert auto == zero
+
+
+def test_underline_highlights_active_tab_span():
+    # Label ranges with auto-fit padding: Home at 23-27, Docs at 73-77.
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab=None)
+    tabs.action_range_clicked("Docs")
+    tabs._bar_position = 1.0
+    rows = plain_rows(tabs.render())
+    assert rows[1] == "━" * 72 + "╸" + "━" * 4 + "╺" + "━" * 22
+
+
+def test_empty_tabs_render_empty_label_row_and_full_underline():
+    rows = plain_rows(Tabs([]).render())
+    assert rows[0].strip() == ""
+    assert rows[1] == "━" * WIDTH
+
+
+def test_inactive_label_is_dimmed_and_carries_click_action():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    label_row = segment_rows(tabs.render())[0]
+    docs_segments = [s for s in label_row if "Docs" in s.text]
+    assert len(docs_segments) == 1
+    assert docs_segments[0].text == " " * 23 + "Docs" + " " * 23
+    assert docs_segments[0].style.meta == {"@click": "range_clicked('Docs')"}
+
+    home_segments = [s for s in label_row if "Home" in s.text]
+    assert len(home_segments) == 1
+    assert "@click" not in home_segments[0].style.meta
+
+
+def test_padding_of_inactive_tab_carries_its_click_action():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    label_row = segment_rows(tabs.render())[0]
+    assert meta_at_column(label_row, 50) == {"@click": "range_clicked('Docs')"}
+    assert "@click" not in meta_at_column(label_row, 10)
+
+
+def test_underline_cells_carry_click_actions_for_every_displayed_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    underline_row = segment_rows(tabs.render())[1]
+    assert meta_at_column(underline_row, 10) == {"@click": "range_clicked('Home')"}
+    assert meta_at_column(underline_row, 60) == {"@click": "range_clicked('Docs')"}
