+def _first_yielded(bar, max_width):
+    options = SimpleNamespace(max_width=max_width)
+    return next(iter(bar.__rich_console__(_StubConsole(), options)))
+
+
+def test_clickable_ranges_add_click_spans_last_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        highlight_style="red",
+        background_style="green",
+        clickable_ranges={"first": (0, 2), "second": (2, 6)},
+        width=6,
+    )
+    item = _first_yielded(bar, max_width=6)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    first_span, second_span = item.spans[-2:]
+    assert (first_span.start, first_span.end) == (0, 2)
+    assert first_span.style.meta == {"@click": "range_clicked('first')"}
+    assert (second_span.start, second_span.end) == (2, 6)
+    assert second_span.style.meta == {"@click": "range_clicked('second')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (-5, -2), (4, 2)])
+def test_zero_width_early_path_has_no_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"first": (0, 3)},
+        width=6,
+    )
+    item = _first_yielded(bar, max_width=6)
+    assert isinstance(item, Text)
+    assert item.plain == "━" * 6
+    assert item.spans
+    for span in item.spans:
+        assert "@click" not in span.style.meta
