+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows a Tabs widget."""
+
+    async def on_mount(self) -> None:
+        self.tab_bar = Tabs(
+            [
+                Tab("Home"),
+                Tab("Files", "files"),
+                Tab("Settings", "settings"),
+                Tab("Help"),
+            ],
+            active_tab="files",
+            tab_padding=2,
+        )
+        self.mount(tab_bar=self.tab_bar)
+        await self.set_focus(self.tab_bar)
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
