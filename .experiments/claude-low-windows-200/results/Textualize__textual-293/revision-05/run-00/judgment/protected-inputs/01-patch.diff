+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+HEAVY = "━"
+
+
+def plain(text: str) -> str:
+    return ANSI_ESCAPE.sub("", text)
+
+
+def label_and_underline_rows(tabs: Tabs) -> tuple[str, str]:
+    label_row, underline_row = plain(render(tabs.render())).split("\n")
+    return label_row, underline_row
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text():
+    assert Tab("A") == Tab("A", "A")
+    assert Tab("A") != Tab("A", "b")
+    assert str(Tab("A", "b")) == "A"
+
+
+def test_construction_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs._active_tab_name == "One"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given_by_name():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs._active_tab_name == "Two"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_sits_at_zero():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Missing")
+    assert tabs._active_tab_name == "Missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("First", "x"), Tab("Other", "y"), Tab("Last", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One", "one"), Tab("Two", "two"), Tab("Three", "three")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "two"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "one"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "three"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("One", "one"), Tab("Two", "two"), Tab("Three", "three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "two"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "three"
+    tabs.activate_tab_by_number(7)
+    assert tabs._active_tab_name == "three"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(str(number), f"t{number}") for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_wraps():
+    tabs = Tabs(
+        [Tab("Home", "home"), Tab("Hello", "hello"), Tab("Apple", "apple")],
+        active_tab="home",
+    )
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "hello"
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "home"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Home", "home"), Tab("Hello", "hello")], active_tab="home")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "home"
+
+
+def test_activate_tab_by_first_char_never_selects_active_tab():
+    tabs = Tabs([Tab("Home", "home")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "home"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One", "one"), Tab("Two", "two")])
+    tabs.action_range_clicked("two")
+    assert tabs._active_tab_name == "two"
+
+
+def test_label_row_and_underline_with_fixed_padding():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    label_row, underline_row = label_and_underline_rows(tabs)
+    assert label_row == " One  Two "
+    assert underline_row == "╸" + HEAVY * 3 + "╺" + HEAVY * 95
+
+
+def test_underline_sits_under_active_second_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two", tab_padding=1)
+    _, underline_row = label_and_underline_rows(tabs)
+    assert underline_row == HEAVY * 5 + "╸" + HEAVY * 3 + "╺" + HEAVY * 90
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("First", "x"), Tab("Other", "y"), Tab("Last", "x")], tab_padding=1
+    )
+    label_row, underline_row = label_and_underline_rows(tabs)
+    assert label_row == " Last  Other "
+    assert underline_row == "╸" + HEAVY * 4 + "╺" + HEAVY * 94
+
+
+def test_inactive_tab_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("One"), Tab("Two")], tab_padding=1)
+    console = Console(width=100, color_system="truecolor", file=io.StringIO())
+    segments = []
+    for segment in console.render(tabs.render(), console.options):
+        if segment.text == "\n":
+            break
+        segments.append(segment)
+
+    def clicked_text(name: str) -> str:
+        return "".join(
+            segment.text
+            for segment in segments
+            if segment.style
+            and segment.style.meta.get("@click") == f"range_clicked('{name}')"
+        )
+
+    assert clicked_text("Two") == " Two "
+    assert clicked_text("One") == ""
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    assert plain(render(Tabs([]).render())) == "\n" + HEAVY * 100
