@@ -0,0 +1,210 @@
+from __future__ import annotations
+
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+HEAVY = "━"
+LEFT_HALF = "╺"
+RIGHT_HALF = "╸"
+
+
+def plain_rows(renderable) -> list[str]:
+    """Rendered text with ANSI codes removed, split into rows."""
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def cell_rows(renderable, width: int = 100) -> list[list[tuple[str, dict]]]:
+    """Each rendered cell as a (character, click metadata) pair, grouped by row."""
+    console = Console(
+        width=width, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    rows: list[list[tuple[str, dict]]] = [[]]
+    for segment in console.render(renderable, console.options):
+        meta = segment.style.meta if segment.style else {}
+        for char in segment.text:
+            if char == "\n":
+                rows.append([])
+            else:
+                rows[-1].append((char, meta))
+    return rows
+
+
+def click_action(name: str) -> dict:
+    return {"@click": f"range_clicked('{name}')"}
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "h") != Tab("Home")
+
+
+def test_tab_repr_shows_label_and_name():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_construct_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs.tabs == []
+    assert tabs._active_tab_name is None
+
+
+def test_construct_with_tabs_makes_first_tab_active():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    assert tabs._active_tab_name == "Home"
+    assert tabs._bar_position == 0.0
+
+
+def test_active_tab_argument_selects_named_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs")
+    assert tabs._active_tab_name == "Docs"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="missing")
+    assert tabs._active_tab_name == "missing"
+    assert tabs._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("A2", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="A")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "B"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_uses_one_based_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="A")
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_selects_last_when_fewer_than_ten():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="A")
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_selects_tenth_when_ten_or_more():
+    names = [f"T{index}" for index in range(12)]
+    tabs = Tabs([Tab(name) for name in names], active_tab="T0")
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_activate_tab_by_number_ignores_numbers_beyond_count():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="B")
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "B"
+
+
+def test_first_character_search_wraps_and_skips_active_tab():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Avocado"), Tab("Banana"), Tab("cherry")],
+        active_tab="Apple",
+    )
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("b")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_first_character_search_without_match_keeps_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Banana")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_activates_named_tab():
+    tabs = Tabs([Tab("Home"), Tab("Docs")])
+    tabs.action_range_clicked("Docs")
+    assert tabs._active_tab_name == "Docs"
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    rows = plain_rows(Tabs([]).render())
+    assert rows == ["", HEAVY * 100]
+
+
+def test_auto_fit_label_row_shares_width_between_padding_edges():
+    # Four flexible padding edges share 100 - (4 + 4) = 92 cells: 23 each.
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Home")
+    label_row = plain_rows(tabs.render())[0]
+    assert label_row == " " * 23 + "Home" + " " * 46 + "Docs" + " " * 23
+
+
+def test_fixed_padding_label_row():
+    tabs = Tabs(
+        [Tab("Home"), Tab("Docs"), Tab("Help")], active_tab="Docs", tab_padding=1
+    )
+    label_row = plain_rows(tabs.render())[0]
+    assert label_row.rstrip() == " Home  Docs  Help"
+
+
+def test_zero_padding_matches_auto_fit():
+    tabs = [Tab("Home"), Tab("Docs")]
+    assert plain_rows(Tabs(tabs, tab_padding=0).render()) == plain_rows(
+        Tabs(tabs).render()
+    )
+
+
+def test_underline_highlights_active_tab_span():
+    tabs = Tabs(
+        [Tab("Home"), Tab("Docs"), Tab("Help")], active_tab="Docs", tab_padding=1
+    )
+    underline = plain_rows(tabs.render())[1]
+    # Docs label occupies columns 7 to 10. The highlight starts at column 7 and
+    # ends at column 11, with a right-half glyph before it and a left-half after it.
+    assert underline == (
+        HEAVY * 6 + RIGHT_HALF + HEAVY * 4 + LEFT_HALF + HEAVY * 88
+    )
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs(
+        [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")], tab_padding=1
+    )
+    label_row, underline = plain_rows(tabs.render())[:2]
+    assert label_row.rstrip() == " Three  Two"
+    # The active name "x" is the first tab, so the underline sits under "Three".
+    assert underline[:7] == RIGHT_HALF + HEAVY * 5 + LEFT_HALF
+
+
+def test_inactive_padding_carries_click_and_active_tab_does_not():
+    tabs = Tabs([Tab("Home"), Tab("Docs")], active_tab="Docs", tab_padding=1)
+    label_cells, underline_cells = cell_rows(tabs.render())[:2]
+
+    # Padding and label of the inactive tab carry its click action.
+    assert label_cells[0][1] == click_action("Home")
+    assert label_cells[1][1] == click_action("Home")
+    assert label_cells[5][1] == click_action("Home")
+    # The active tab's padded span carries no click action.
+    assert label_cells[6][1] == {}
+    assert label_cells[7][1] == {}
+
+    # Underline cells carry the click action of the displayed tab beneath them,
+    # including the active tab.
+    assert underline_cells[2][1] == click_action("Home")
+    assert underline_cells[8][1] == click_action("Docs")
