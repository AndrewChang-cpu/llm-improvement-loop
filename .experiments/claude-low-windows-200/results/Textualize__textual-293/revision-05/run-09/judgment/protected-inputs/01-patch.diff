+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows Tabs widgets."""
+
+    async def on_mount(self) -> None:
+        first = Tabs(
+            [Tab("Home"), Tab("Docs"), Tab("Settings", "settings"), Tab("Help")],
+            active_tab="Docs",
+            id="first",
+        )
+        second = Tabs(
+            [Tab("Alpha"), Tab("Beta"), Tab("Gamma"), Tab("Delta")],
+            tab_padding=2,
+            id="second",
+        )
+        self.mount(first=first, second=second)
+        await self.set_focus(first)
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
