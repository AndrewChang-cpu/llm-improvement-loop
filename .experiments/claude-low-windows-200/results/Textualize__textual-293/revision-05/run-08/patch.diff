+class ConsoleDouble:
+    def get_style(self, style):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+def first_item(bar, max_width=6):
+    options = SimpleNamespace(max_width=max_width)
+    return next(iter(bar.__rich_console__(ConsoleDouble(), options)))
+
+
+def click_meta(span):
+    return span.style.meta
+
+
+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"home": (0, 2), "about": (2, 4)},
+        width=6,
+    )
+    item = first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    home_span, about_span = item.spans[-2], item.spans[-1]
+    assert (home_span.start, home_span.end) == (0, 2)
+    assert click_meta(home_span) == {"@click": "range_clicked('home')"}
+    assert (about_span.start, about_span.end) == (2, 4)
+    assert click_meta(about_span) == {"@click": "range_clicked('about')"}
+
