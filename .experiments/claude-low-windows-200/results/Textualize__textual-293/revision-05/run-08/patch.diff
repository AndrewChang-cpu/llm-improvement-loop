diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..4a7b640
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,419 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import LayoutEdge, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+@dataclass
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    label: str
+    name: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabSpan(NamedTuple):
+    """The laid-out columns of one displayed tab."""
+
+    name: str
+    label: str
+    left: int
+    right: int
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or None.
+        bar_position (float): A fractional index into the full tab list.
+        active_tab_style (StyleType): The style of the active tab's label.
+        active_bar_style (StyleType): The style of the highlighted bar.
+        inactive_tab_style (StyleType): The style of inactive tabs' labels.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio for inactive tabs' labels.
+        tab_padding (int, optional): The fixed padding per side, or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Compute the columns of every displayed tab.
+
+        Each displayed tab contributes a left padding edge, a label edge and a
+        right padding edge. The label edge is omitted when the label is empty,
+        because a zero size would be treated as flexible.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: One entry per displayed tab, in display order.
+        """
+        # One entry per distinct name, at its first position, with the last label
+        displayed: dict[str, str] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab.label
+
+        padding: int | None = None
+        if self.tab_padding and self.tab_padding > 0:
+            padding = self.tab_padding
+
+        edges: list[LayoutEdge] = []
+        slots: list[tuple[str, int, int, int]] = []
+        for name, label in displayed.items():
+            label_width = cell_len(label)
+            left_index = len(edges)
+            edges.append(LayoutEdge(size=padding))
+            if label_width:
+                edges.append(LayoutEdge(size=label_width))
+            right_index = len(edges)
+            edges.append(LayoutEdge(size=padding))
+            slots.append((name, label_width, left_index, right_index))
+
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        position = 0
+        for name, label_width, left_index, right_index in slots:
+            left = sizes[left_index]
+            right = sizes[right_index]
+            label_start = position + left
+            label_end = label_start + label_width
+            span_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    name=name,
+                    label=displayed[name],
+                    left=left,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(position, span_end),
+                )
+            )
+            position = span_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlighted label range from the bar position.
+
+        The bar position is an index into the full tab list. Each full index is
+        mapped to the displayed tab that carries its name, so that duplicate
+        names share one underline. The highlight runs between the label ranges
+        of the floor index and the next index, wrapping at the end.
+
+        Args:
+            spans (list[_TabSpan]): The laid-out displayed tabs.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        if not spans or not self.tabs:
+            return (0, 0)
+        by_name = {span.name: span for span in spans}
+        last_index = len(self.tabs) - 1
+        position = min(max(self.bar_position, 0.0), float(last_index))
+        floor_index = int(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % len(self.tabs)
+
+        current = by_name[self.tabs[floor_index].name].label_range
+        following = by_name[self.tabs[next_index].name].label_range
+        start = current[0] + (following[0] - current[0]) * fraction
+        end = current[1] + (following[1] - current[1]) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for span in spans:
+            padded = " " * span.left + span.label + " " * span.right
+            if span.name == self.active_tab_name:
+                label = Text(
+                    padded, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+                yield from console.render(label, options)
+            else:
+                label = Text(
+                    padded, style=inactive_style, end="", no_wrap=True, overflow="crop"
+                )
+                label.apply_meta({"@click": f"range_clicked('{span.name}')"})
+                yield from console.render(
+                    Opacity(label, opacity=self.inactive_text_opacity), options
+                )
+        yield Segment("\n")
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={span.name: span.selection_range for span in spans},
+            width=width,
+        )
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A tab is selected with the keyboard or the mouse. Selection is identified by
+    tab name. Tabs with duplicate names are displayed once, at the first
+    occurrence's position, with the label of the last tab that has the name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the tab that starts active. Defaults to
+            the first tab's name when this is None or empty.
+        active_tab_style (StyleType, optional): The style of the active tab's label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs' labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tabs' labels, from 0 to 1. Defaults to 0.5.
+        animation_duration (float, optional): The duration of the underline animation,
+            in seconds. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            None or 0 fits the padding to the available width. Defaults to None.
+        search_by_first_character (bool, optional): Whether pressing a letter
+            key activates the next tab whose label starts with that letter.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            self._active_tab_name = active_tab
+        elif tabs:
+            self._active_tab_name = tabs[0].name
+        else:
+            self._active_tab_name = None
+        self._bar_position = float(self.find_tab_by_name(self._active_tab_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch__active_tab_name(self, tab_name: str | None) -> None:
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name in the full tab list.
+
+        Args:
+            tab_name (str | None): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end.
+
+        The current position is the first index of the active tab's name.
+        The list must not be empty.
+        """
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start.
+
+        The current position is the first index of the active tab's name.
+        The list must not be empty.
+        """
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full tab list,
+        and never selects the active tab. The comparison ignores case. If no
+        other tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        count = len(self.tabs)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        A number greater than the tab count is ignored. The number 0 activates
+        the 10th tab when there are at least ten tabs, and the last tab
+        otherwise. Any other number activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0 for the rule above.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab.
+
+        This is the action run by the click metadata on the label and bar cells.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the widget has focus.
+
+        Every key event is marked handled without stopping its propagation.
+        With no tabs, nothing else happens.
+
+        * Escape makes a bare call to the app's ``set_focus`` with no target,
+          without awaiting it.
+        * Right and Left activate the next and previous tab, wrapping at the ends.
+        * The digits 0 to 9 activate a tab by number. Other characters are not
+          digits, even when Unicode treats them as numbers.
+        * Any other single character activates the next tab whose label starts
+          with it, when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
