+        for segment in console.render(Opacity(text, opacity=0.5))
+        if segment.text
+    ]
+    assert segments
+    for segment in segments:
+        assert segment.style.meta == {"@click": "range_clicked('home')"}
+        assert segment.style.color.triplet == (127, 127, 0)
