+++ b/tests/test_tabs.py
@@ -0,0 +1,214 @@
+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain_lines(renderable) -> list[str]:
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def make_renderable(
+    tabs, active_name=None, bar_position=0.0, tab_padding=None
+) -> TabsRenderable:
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+
+
+def test_tab_explicit_name():
+    assert Tab("Home", "start").name == "start"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("A", "x") == Tab("A", "x")
+    assert Tab("A", "x") != Tab("A", "y")
+    assert Tab("A", "x") != Tab("B", "x")
+
+
+def test_tab_repr_shows_both_fields():
+    text = repr(Tab("A", "x"))
+    assert "label='A'" in text
+    assert "name='x'" in text
+
+
+def test_tab_str_is_label():
+    assert str(Tab("Home", "start")) == "Home"
+
+
+def test_construct_with_empty_tab_list():
+    tabs = Tabs([])
+    assert tabs.find_tab_by_name("anything") == 0
+
+
+def test_construct_with_default_styles():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs.tabs[0].name == "A"
+
+
+def test_initial_active_tab_is_first_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_tab_wraps():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_previous_tab_wraps():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_one_based():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_number_zero_with_fewer_than_ten_is_last():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_or_more_is_tenth():
+    tabs = Tabs([Tab(str(index)) for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "9"
+
+
+def test_activate_tab_by_number_beyond_count_is_ignored():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "B"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive_and_after_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")])
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_no_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Banana")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Banana"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    renderable = make_renderable(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")],
+        active_name="x",
+        tab_padding=1,
+    )
+    lines = plain_lines(renderable)
+    assert lines[0] == " C  B "
+
+
+def test_duplicate_names_underline_sits_under_displayed_tab():
+    renderable = make_renderable(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")],
+        active_name="x",
+        bar_position=0.0,
+        tab_padding=1,
+    )
+    lines = plain_lines(renderable)
+    # Label of the displayed "x" tab is "C" at column 1
+    assert lines[1].startswith("╸━╺")
+
+
+def test_label_row_with_fixed_padding():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About")], active_name="Home", tab_padding=1
+    )
+    lines = plain_lines(renderable)
+    assert lines[0] == " Home  About "
+
+
+def test_underline_highlights_active_label_range():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About")], active_name="Home", tab_padding=1
+    )
+    lines = plain_lines(renderable)
+    # Highlight covers columns 1 to 5 of a 100 cell bar
+    assert lines[1] == "╸━━━━╺" + "━" * 94
+
+
+def test_no_tabs_row_layout():
+    renderable = make_renderable([], active_name=None)
+    lines = plain_lines(renderable)
+    assert lines == ["", "━" * 100]
+
+
+def test_auto_fit_layout_shares_flexible_space():
+    renderable = make_renderable([Tab("A"), Tab("BB")], active_name="A")
+    spans = renderable._layout(10)
+    assert [span.selection_range for span in spans] == [(0, 4), (4, 10)]
+    assert [span.label_range for span in spans] == [(1, 2), (6, 8)]
+
+
+def test_inactive_label_carries_click_action():
+    renderable = make_renderable(
+        [Tab("Home"), Tab("About")], active_name="Home", tab_padding=1
+    )
+    import io
+
+    from rich.console import Console
+
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(renderable))
+    about = [segment for segment in segments if segment.text.strip() == "About"]
+    assert about
+    for segment in about:
+        assert segment.style.meta == {"@click": "range_clicked('About')"}
