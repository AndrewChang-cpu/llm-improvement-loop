+++ b/tests/widgets/test_tabs.py
@@ -0,0 +1,171 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable):
+    """Render at the helper's width and return the rows without ANSI codes."""
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def segments(renderable):
+    """Render to styled segments at the helper's width."""
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    return list(console.render(renderable, console.options))
+
+
+def click_of(segment):
+    if not segment.style:
+        return None
+    return segment.style.meta.get("@click")
+
+
+def test_construction_with_default_styles():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert [tab.name for tab in tabs.tabs] == ["One", "Two"]
+    assert Tabs([]).tabs == []
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert Tab("Home", "h").name == "h"
+    assert str(tab) == "Home"
+    assert Tab("A") == Tab("A", "A")
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab():
+    assert Tabs([Tab("A"), Tab("B")])._active_tab_name == "A"
+
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+    unknown = Tabs([Tab("A"), Tab("B")], active_tab="nope")
+    assert unknown._active_tab_name == "nope"
+    assert unknown._bar_position == 0.0
+
+    assert Tabs([], active_tab="x")._active_tab_name is None
+
+
+def test_empty_tabs_render_empty_label_row_and_full_underline():
+    lines = plain(Tabs([]).render())
+    assert lines == ["", "━" * 100]
+
+
+def test_fixed_padding_label_row_and_underline():
+    tabs = Tabs([Tab("A"), Tab("B")], tab_padding=1)
+    label_row, underline = plain(tabs.render())
+
+    assert label_row == " A  B "
+    # The active label is cell 1, so the highlight covers that cell.
+    assert underline[:3] == "╸━╺"
+    assert underline[3:] == "━" * 97
+
+
+def test_auto_fit_padding_follows_flexible_shares():
+    # Four flexible padding edges share 100 - 2 = 98 cells, so each gets 24.5 cells.
+    # The fractional part carries forward, giving 24, 25, 24, 25.
+    tabs = Tabs([Tab("A"), Tab("B")])
+    label_row, underline = plain(tabs.render())
+
+    expected = " " * 24 + "A" + " " * 25 + " " * 24 + "B" + " " * 25
+    assert label_row == expected
+    assert len(underline) == 2
+    assert underline[23:26] == "╸━╺"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")], tab_padding=1)
+    label_row, underline = plain(tabs.render())
+
+    assert label_row == " C  B "
+    # The active name "x" is the first displayed tab.
+    assert underline[:3] == "╸━╺"
+
+
+def test_inactive_tab_carries_click_action_and_active_does_not():
+    tabs = Tabs([Tab("A"), Tab("B")], tab_padding=1)
+    segs = segments(tabs.render())
+
+    run_a = next(seg for seg in segs if seg.text == " A ")
+    run_b = next(seg for seg in segs if seg.text == " B ")
+
+    assert click_of(run_a) is None
+    assert click_of(run_b) == "range_clicked('B')"
+
+
+def test_inactive_tab_is_dimmed_and_active_is_not():
+    tabs = Tabs([Tab("A"), Tab("B")], tab_padding=1)
+    segs = segments(tabs.render())
+
+    run_a = next(seg for seg in segs if seg.text == " A ")
+    run_b = next(seg for seg in segs if seg.text == " B ")
+
+    assert run_a.style.color.triplet == (240, 240, 240)
+    assert run_b.style.color.triplet != (240, 240, 240)
+
+
+def test_activate_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "B"
+
+    # Zero with fewer than ten tabs activates the last tab.
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "C"
+
+    # A number greater than the tab count is ignored.
+    tabs.activate_tab_by_number(4)
+    assert tabs._active_tab_name == "C"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_uses_tenth():
+    tabs = Tabs([Tab(f"T{index}") for index in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_activate_tab_by_first_char_skips_active_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")])
+
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
