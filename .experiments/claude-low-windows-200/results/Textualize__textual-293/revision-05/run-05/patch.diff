@@ -0,0 +1,20 @@
+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows Tabs widgets."""
+
+    def on_mount(self):
+        """Mount the example Tabs widgets directly on the app."""
+        self.mount(
+            first=Tabs([Tab("Home"), Tab("Search"), Tab("Settings", "settings")]),
+            second=Tabs(
+                [Tab("One"), Tab("Two"), Tab("Three")],
+                active_tab="Two",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
