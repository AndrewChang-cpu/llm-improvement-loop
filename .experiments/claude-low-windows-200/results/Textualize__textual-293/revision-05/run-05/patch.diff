diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..60cbf1f
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,427 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import floor
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import EdgeSpec, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar, range_click_action
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGIT_KEYS = "0123456789"
+
+
+@dataclass
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    label: str
+    name: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Compute the tabs that are rendered, one per distinct name.
+
+    Each entry takes the position where its name first appears, and the label of
+    the last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    latest: dict[str | None, Tab] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its original position.
+        latest[tab.name] = tab
+    return list(latest.values())
+
+
+def _highlight_range(
+    label_ranges: list[tuple[int, int]], bar_position: float
+) -> tuple[float, float]:
+    """Interpolate the highlight between the label ranges around a bar position.
+
+    Args:
+        label_ranges (list[tuple[int, int]]): The label range of each displayed tab.
+        bar_position (float): A fractional index into the displayed tabs.
+
+    Returns:
+        tuple[float, float]: The highlighted start and end columns.
+    """
+    count = len(label_ranges)
+    if count == 0:
+        return (0, 0)
+    index = min(max(floor(bar_position), 0), count - 1)
+    next_index = (index + 1) % count
+    fraction = min(max(bar_position - index, 0.0), 1.0)
+    start, end = label_ranges[index]
+    next_start, next_end = label_ranges[next_index]
+    return (
+        start + (next_start - start) * fraction,
+        end + (next_end - end) * fraction,
+    )
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): A fractional index into the displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of each inactive tab's padded span.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int | None): A fixed padding size in cells, or ``None`` to
+            auto-fit the padding.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> EdgeSpec:
+        # A zero padding is treated as absent, so the edge is flexible.
+        return EdgeSpec(size=self.tab_padding if self.tab_padding else None)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_widths = [cell_len(tab.label) for tab in displayed]
+
+        # Each displayed tab contributes a left padding edge, a label edge (omitted
+        # when the label is empty, since a zero size would be treated as flexible),
+        # and a right padding edge.
+        edges: list[EdgeSpec] = []
+        for label_width in label_widths:
+            edges.append(self._padding_edge())
+            if label_width:
+                edges.append(EdgeSpec(size=label_width))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        cursor = 0
+        position = 0
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+
+        for tab, label_width in zip(displayed, label_widths):
+            left = sizes[cursor]
+            cursor += 1
+            label_size = 0
+            if label_width:
+                label_size = sizes[cursor]
+                cursor += 1
+            right = sizes[cursor]
+            cursor += 1
+
+            span_start = position
+            label_start = span_start + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (span_start, span_end)
+
+            # The padded span is one run, so padding cells share the label's style.
+            run = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action.
+                run_text = Text(
+                    run, style=active_style, no_wrap=True, overflow="crop", end=""
+                )
+                yield from console.render(run_text, options)
+            else:
+                run_style = inactive_style + Style(
+                    meta={"@click": range_click_action(tab.name)}
+                )
+                run_text = Text(
+                    run, style=run_style, no_wrap=True, overflow="crop", end=""
+                )
+                dimmed = Opacity(run_text, opacity=self.inactive_text_opacity)
+                yield from console.render(dimmed, options)
+            position = span_end
+
+        # The line break that separates the label row from the underline row
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=_highlight_range(label_ranges, self.bar_position),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Keys: Right and left move between tabs with wrap-around. Escape calls the app's
+    ``set_focus`` with no target. The digits 0 through 9 activate a tab by number,
+    and other characters search tab labels when ``search_by_first_character`` is set.
+
+    Clicking a tab activates it. Tabs are selected by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to show. The list may be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. A name that matches no tab is kept, and the bar
+            then sits at index 0.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs,
+            where 1.0 leaves the text fully visible. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str): The name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): A fixed padding size in cells on each side of a
+            label. ``None`` or zero auto-fits the padding to the widget width.
+            Defaults to ``None``.
+        search_by_first_character (bool): Whether a character key activates the next
+            tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        initial_name: str | None
+        if not tabs:
+            initial_name = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the position of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The displayed position, or 0 when no displayed tab has the name.
+        """
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list, or 0
+                when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the position of the new active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the new active tab.
+        """
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, compares
+        case-insensitively, and never selects the active tab. The active tab does
+        not change when no other tab matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        target = char.lower()
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name != self._active_tab_name and tab.label.lower().startswith(
+                target
+            ):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its number.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and otherwise the last tab.
+        Other numbers activate the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab number, or 0.
+        """
+        count = len(self.tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with a given name. This is the click action.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle a key press while the tabs have focus.
+
+        Every key event is marked handled, and it still propagates to the rest of the
+        application. Escape calls the app's ``set_focus`` with no target, without
+        awaiting it. Right and left move to the next or previous tab, with wrap-around.
+        The characters 0 through 9 activate a tab by number. Other single characters
+        search tab labels when ``search_by_first_character`` is enabled.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in _DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
