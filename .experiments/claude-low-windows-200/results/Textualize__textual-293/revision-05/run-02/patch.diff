+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application that shows the Tabs widget."""
+
+    def on_mount(self):
+        """Mount example Tabs widgets."""
+        self.mount(
+            first=Tabs(
+                [Tab("Home"), Tab("Files"), Tab("Settings"), Tab("Help")],
+                active_tab="Files",
+            ),
+            second=Tabs([Tab("One", "one"), Tab("Two", "two"), Tab("Three", "three")]),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
