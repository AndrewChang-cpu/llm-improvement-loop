diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..a25e187
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,461 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+_DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab item for the Tabs widget.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str | None, optional): The name that identifies the tab. Defaults to
+            the label when not given.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """A layout edge for the shared layout resolver."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+@dataclass
+class _TabSpan:
+    """The computed columns of one displayed tab."""
+
+    tab: Tab
+    left: int
+    right: int
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+
+
+def _displayed_tabs(tabs: list[Tab]) -> list[Tab]:
+    """Collapse duplicate names into one displayed tab per name.
+
+    The displayed tab takes the position of the first tab with a name and the
+    label of the last tab with that name.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs in display order.
+    """
+    positions: dict[str, int] = {}
+    displayed: list[Tab] = []
+    for tab in tabs:
+        if tab.name in positions:
+            displayed[positions[tab.name]] = tab
+        else:
+            positions[tab.name] = len(displayed)
+            displayed.append(tab)
+    return displayed
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str | None): The name of the active tab, if any.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int | None): Fixed padding size in cells, or ``None`` to
+            auto-fit the padding.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.displayed = _displayed_tabs(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Compute the padding, label, and selection columns of each displayed tab.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: One span per displayed tab, in display order.
+        """
+        if self.tab_padding:
+            padding_edge = _TabEdge(size=self.tab_padding)
+        else:
+            padding_edge = _TabEdge()
+
+        label_widths = [cell_len(tab.label) for tab in self.displayed]
+        edges: list[_TabEdge] = []
+        for label_width in label_widths:
+            edges.append(padding_edge)
+            # A zero-width label has no edge; a size of zero would read as flexible.
+            if label_width:
+                edges.append(_TabEdge(size=label_width))
+            edges.append(padding_edge)
+
+        sizes = iter(layout_resolve(width, edges))
+        spans: list[_TabSpan] = []
+        position = 0
+        for tab, label_width in zip(self.displayed, label_widths):
+            left = next(sizes)
+            if label_width:
+                next(sizes)
+            right = next(sizes)
+            label_start = position + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    tab=tab,
+                    left=left,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(position, selection_end),
+                )
+            )
+            position = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the label range under the fractional bar position.
+
+        Args:
+            spans (list[_TabSpan]): The displayed tab spans.
+
+        Returns:
+            tuple[float, float]: The highlighted column range.
+        """
+        count = len(spans)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0), count - 1)
+        index = int(position)
+        fraction = position - index
+        current_start, current_end = spans[index].label_range
+        next_start, next_end = spans[(index + 1) % count].label_range
+        start = current_start + (next_start - current_start) * fraction
+        end = current_end + (next_end - current_end) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+
+        # First row: each tab's padded span is one run of text.
+        for span in spans:
+            tab = span.tab
+            padded = " " * span.left + tab.label + " " * span.right
+            if tab.name == self.active_tab_name:
+                text = Text(padded, style=self.active_tab_style, end="", no_wrap=True)
+                yield from console.render(text, options)
+            else:
+                text = Text(
+                    padded, style=self.inactive_tab_style, end="", no_wrap=True
+                )
+                text.apply_meta(
+                    {"@click": f"range_clicked('{tab.name}')"}, 0, len(padded)
+                )
+                yield from console.render(
+                    Opacity(text, self.inactive_text_opacity), options
+                )
+        yield Segment.line()
+
+        # Second row: the underline bar, with each tab's selection range clickable.
+        clickable_ranges: dict[str, tuple[int, int]] = {}
+        for span in spans:
+            start, end = span.selection_range
+            start, end = min(start, width), min(end, width)
+            if end > start:
+                clickable_ranges[span.tab.name] = (start, end)
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are identified by name. A user selects a tab with the keyboard or by
+    clicking its label or the underline beneath it.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. Tab names need not be unique;
+            tabs with the same name are shown once, at the first occurrence's
+            position, with the last tab's label.
+        active_tab (str | None, optional): The name of the initially active tab.
+            If it is ``None`` or empty, the first tab is active. A name that matches
+            no tab is kept, and the bar then sits at index 0. Defaults to ``None``.
+        active_tab_style (StyleType, optional): The style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline bar. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to the text
+            of inactive tabs, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): The duration of the bar animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by
+            the bar animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None, optional): The size in cells of the padding on each
+            side of a label. ``None`` or zero auto-fits the padding across the
+            width. Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a letter key
+            activates the next tab whose label starts with that letter. Defaults to
+            ``True``.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self._tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self._animation_duration = animation_duration
+        self._animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self._tabs:
+            initial_name: str | None = None
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self._tabs[0].name
+        self._bar_position = float(self._display_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _display_index(self, tab_name: str | None) -> int:
+        """Get the position of a name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index, or 0 when no displayed tab has the name.
+        """
+        names = [tab.name for tab in _displayed_tabs(self._tabs)]
+        if tab_name in names:
+            return names.index(tab_name)
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The index of the first tab in the full tab list with that name, or
+                0 when no tab has it.
+        """
+        for index, tab in enumerate(self._tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    async def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the bar to the displayed index of the newly active tab."""
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._display_index(active_tab_name)),
+            duration=self._animation_duration,
+            easing=self._animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        count = len(self._tabs)
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self._tabs[(index + 1) % count].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        count = len(self._tabs)
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self._tabs[(index - 1) % count].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It compares
+        case-insensitively and never selects the active tab. If no other tab
+        matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self._tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self._tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        A number greater than the tab count is ignored. The number 0 activates the
+        10th tab when there are at least ten tabs, and otherwise the last tab.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0.
+        """
+        count = len(self._tabs)
+        if tab_number > count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self._tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab with the given name.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle keys while the Tabs widget has focus.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape makes a bare call to the app's ``set_focus`` with no target.
+        - Right and Left activate the next and previous tab, wrapping at the ends.
+        - The digits 1 through 9 activate the tab at that 1-based position. The 0
+          key follows the rule of ``activate_tab_by_number``.
+        - Any other single character activates the next tab whose label starts
+          with that character, when ``search_by_first_character`` is true.
+
+        Every key is marked handled. Propagation is not stopped, so application
+        bindings still receive the key.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        key = event.key
+        if self._tabs:
+            if key == Keys.Escape:
+                self.app.set_focus(None)
+            elif key == Keys.Right:
+                self.activate_next_tab()
+            elif key == Keys.Left:
+                self.activate_previous_tab()
+            elif len(key) == 1 and key in _DIGITS:
+                self.activate_tab_by_number(int(key))
+            elif len(key) == 1 and self.search_by_first_character:
+                self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
