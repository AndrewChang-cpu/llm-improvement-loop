+++ b/tests/widgets/test_tabs.py
@@ -0,0 +1,166 @@
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> str:
+    return ANSI.sub("", render(renderable))
+
+
+def make_renderable(tabs, active=None, position=0.0, padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_repr_and_text():
+    assert Tab("a") == Tab("a", "a")
+    assert Tab("a") != Tab("a", "b")
+    assert str(Tab("a", "b")) == "a"
+    assert repr(Tab("a", "b")) == "Tab(label='a', name='b')"
+
+
+def test_construction_with_default_styles_succeeds():
+    assert Tabs([]) is not None
+    assert Tabs([Tab("One"), Tab("Two")]) is not None
+    assert Tabs([Tab("One")], tab_padding=0) is not None
+
+
+def test_initial_active_tab():
+    tabs = [Tab("One"), Tab("Two")]
+    assert Tabs(tabs, active_tab="Two")._active_tab_name == "Two"
+    assert Tabs(tabs)._active_tab_name == "One"
+    assert Tabs(tabs, active_tab="")._active_tab_name == "One"
+    assert Tabs([Tab("One")], active_tab="zzz")._active_tab_name == "zzz"
+    assert Tabs([])._active_tab_name is None
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_activate_by_number():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_tab_by_number(5)
+    assert tabs._active_tab_name == "Three"
+
+
+def test_activate_by_number_zero_with_ten_tabs_selects_tenth():
+    tabs = Tabs([Tab(f"T{number}") for number in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "T10"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "T9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado"), Tab("Cherry")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.action_range_clicked("Two")
+    assert tabs._active_tab_name == "Two"
+
+
+def test_label_row_with_fixed_padding():
+    renderable = make_renderable([Tab("One"), Tab("Two")], active="One", padding=1)
+    lines = plain(renderable).split("\n")
+    assert lines[0] == " One  Two "
+    bar = lines[1]
+    # Highlight covers columns 1 to 4, so the edges are half-cell glyphs.
+    assert bar.startswith("╸━━━╺")
+    assert len(bar) == 100
+
+
+def test_label_row_with_auto_fit_padding():
+    # Width 100 minus 3 label cells leaves 97 cells for 4 flexible pads.
+    # Each pad gets 24.25 cells; the leftover carries forward, so the pads
+    # are 24, 24, 24, and 25 cells.
+    renderable = make_renderable([Tab("A"), Tab("BB")], active="A")
+    lines = plain(renderable).split("\n")
+    assert lines[0] == " " * 24 + "A" + " " * 48 + "BB" + " " * 25
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")]
+    renderable = make_renderable(tabs, active="a", padding=1)
+    lines = plain(renderable).split("\n")
+    assert lines[0] == " Three  Two "
+
+
+def test_underline_sits_under_displayed_tab_with_duplicate_names():
+    tabs = [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")]
+    # Displayed tabs are Three (a) and Two (b). Two's label occupies 8 to 11.
+    renderable = make_renderable(tabs, active="b", position=1.0, padding=1)
+    bar = plain(renderable).split("\n")[1]
+    assert bar.startswith("━" * 7 + "╸━━━╺")
+
+
+def test_no_tabs_renders_empty_row_and_inactive_underline():
+    lines = plain(make_renderable([])).split("\n")
+    assert lines[0] == ""
+    assert lines[1] == "━" * 100
+
+
+def test_inactive_padded_span_carries_click_action_and_active_does_not():
+    console = Console(width=100)
+    renderable = make_renderable([Tab("One"), Tab("Two")], active="One", padding=1)
+    segments = list(renderable.__rich_console__(console, console.options))
+
+    def clicked_text(action):
+        return "".join(
+            segment.text
+            for segment in segments
+            if segment.style and segment.style.meta.get("@click") == action
+        )
+
+    assert clicked_text("range_clicked('Two')") == " Two "
+    assert clicked_text("range_clicked('One')") == ""
