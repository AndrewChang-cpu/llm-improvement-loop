+import io
+import re
+
+from rich.color import Color
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_ESCAPE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _plain_lines(widget: Tabs) -> list[str]:
+    return ANSI_ESCAPE.sub("", render(widget.render())).split("\n")
+
+
+def _segments(widget: Tabs):
+    console = Console(width=100, file=io.StringIO(), color_system="truecolor")
+    return list(console.render(widget.render(), console.options))
+
+
+def _label_row_segments(widget: Tabs):
+    row = []
+    for segment in _segments(widget):
+        if segment.text == "\n":
+            break
+        row.append(segment)
+    return row
+
+
+def _click_actions(widget: Tabs) -> set[str]:
+    actions = set()
+    for segment in _segments(widget):
+        if segment.style is None:
+            continue
+        action = segment.style.meta.get("@click")
+        if action is not None:
+            actions.add(action)
+    return actions
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_explicit_name():
+    tab = Tab("Home", "home")
+    assert tab.name == "home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality():
+    assert Tab("Home", "home") == Tab("Home", "home")
+    assert Tab("Home", "home") != Tab("Home", "other")
+
+
+def test_construction_with_empty_tabs():
+    widget = Tabs([])
+    assert widget._active_tab_name is None
+
+
+def test_construction_with_tabs_and_default_styles():
+    widget = Tabs([Tab("a"), Tab("b")])
+    assert widget._active_tab_name == "a"
+
+
+def test_initial_active_tab_from_argument():
+    widget = Tabs([Tab("a"), Tab("b")], active_tab="b")
+    assert widget._active_tab_name == "b"
+    assert widget._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    widget = Tabs([Tab("a"), Tab("b")], active_tab="zzz")
+    assert widget._active_tab_name == "zzz"
+    assert widget._bar_position == 0.0
+
+
+def test_find_tab_by_name_returns_first_match():
+    widget = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert widget.find_tab_by_name("x") == 0
+    assert widget.find_tab_by_name("y") == 1
+    assert widget.find_tab_by_name("missing") == 0
+
+
+def test_activate_next_and_previous_wrap():
+    widget = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "b"
+    widget.activate_next_tab()
+    widget.activate_next_tab()
+    assert widget._active_tab_name == "a"
+    widget.activate_previous_tab()
+    assert widget._active_tab_name == "c"
+
+
+def test_activate_tab_by_number():
+    widget = Tabs([Tab("a"), Tab("b"), Tab("c")])
+    widget.activate_tab_by_number(2)
+    assert widget._active_tab_name == "b"
+    widget.activate_tab_by_number(4)
+    assert widget._active_tab_name == "b"
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "c"
+
+
+def test_activate_tab_by_number_zero_with_ten_tabs_uses_tenth():
+    tabs = [Tab(f"t{index}") for index in range(1, 13)]
+    widget = Tabs(tabs)
+    widget.activate_tab_by_number(0)
+    assert widget._active_tab_name == "t10"
+
+
+def test_activate_tab_by_first_char_skips_active_and_wraps():
+    widget = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")], active_tab="Apple")
+    widget.activate_tab_by_first_char("A")
+    assert widget._active_tab_name == "Avocado"
+    widget.activate_tab_by_first_char("a")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_activate_tab_by_first_char_is_case_insensitive():
+    widget = Tabs([Tab("Apple"), Tab("Banana")])
+    widget.activate_tab_by_first_char("b")
+    assert widget._active_tab_name == "Banana"
+
+
+def test_activate_tab_by_first_char_without_match_keeps_active():
+    widget = Tabs([Tab("Apple"), Tab("Banana")])
+    widget.activate_tab_by_first_char("z")
+    assert widget._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    widget = Tabs([Tab("a"), Tab("b")])
+    widget.action_range_clicked("b")
+    assert widget._active_tab_name == "b"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    widget = Tabs(
+        [Tab("A", "x"), Tab("B", "y"), Tab("C", "x")],
+        tab_padding=1,
+    )
+    assert _plain_lines(widget)[0] == " C  B "
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    widget = Tabs([])
+    lines = _plain_lines(widget)
+    assert lines == ["", "━" * 100]
+
+
+def test_auto_fit_padding_shares_remaining_width():
+    # Four flexible edges share 100 - 3 = 97 cells: 24.25 each, carried forward,
+    # so the sizes are 24, 24, 24 and 25.
+    widget = Tabs([Tab("ab"), Tab("c")])
+    label_row = _plain_lines(widget)[0]
+    assert label_row == " " * 24 + "ab" + " " * 24 + " " * 24 + "c" + " " * 25
+
+
+def test_fixed_padding_label_row():
+    widget = Tabs([Tab("a"), Tab("bb")], tab_padding=1)
+    assert _plain_lines(widget)[0] == " a  bb "
+
+
+def test_underline_highlights_active_label_span():
+    widget = Tabs([Tab("ab"), Tab("c")])
+    underline = _plain_lines(widget)[1]
+    # The active label "ab" spans columns 24 to 26 of the 100-cell bar.
+    assert underline == "━" * 23 + "╸" + "━━" + "╺" + "━" * 73
+
+
+def test_inactive_padded_span_carries_click_and_is_dimmed():
+    widget = Tabs(
+        [Tab("a"), Tab("b")],
+        tab_padding=1,
+        inactive_text_opacity=0.5,
+    )
+    inactive = [
+        segment
+        for segment in _label_row_segments(widget)
+        if segment.text.strip() == "b"
+    ]
+    assert inactive
+    for segment in inactive:
+        assert segment.style.meta == {"@click": "range_clicked('b')"}
+        assert segment.style.color != Color.parse("#f0f0f0")
+
+
+def test_active_padded_span_has_no_click():
+    widget = Tabs([Tab("a"), Tab("b")], tab_padding=1)
+    active = [
+        segment
+        for segment in _label_row_segments(widget)
+        if segment.text.strip() == "a"
+    ]
+    assert active
+    for segment in active:
+        assert "@click" not in segment.style.meta
+
+
+def test_underline_click_ranges_include_active_tab():
+    widget = Tabs([Tab("a"), Tab("b")], tab_padding=1)
+    actions = _click_actions(widget)
+    assert "range_clicked('a')" in actions
+    assert "range_clicked('b')" in actions
+
+
+def test_active_label_has_no_click_action():
+    widget = Tabs([Tab("a"), Tab("b")], tab_padding=1)
+    label_actions = set()
+    for segment in _label_row_segments(widget):
+        if segment.style is not None and segment.text.strip() == "a":
+            label_actions.add(segment.style.meta.get("@click"))
+    assert label_actions == {None}
