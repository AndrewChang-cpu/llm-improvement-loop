diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..8d18032
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,426 @@
+from __future__ import annotations
+
+import math
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..reactive import Reactive
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_CHARACTERS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str | None): The name used to select the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the tabs that are rendered, one per distinct name.
+
+    Each displayed tab takes the position of the first tab with its name and the
+    label of the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full list of tabs.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    order: list[str] = []
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        if tab.name not in labels:
+            order.append(tab.name)
+        labels[tab.name] = tab.label
+    return [Tab(labels[name], name) for name in order]
+
+
+class _Edge:
+    """A layout edge for the tab row, consumed by ``layout_resolve``."""
+
+    def __init__(
+        self, size: int | None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full list of tabs.
+        active_tab_name (str | None): The name of the active tab, or ``None``.
+        bar_position (float): The bar position as a fractional index into the
+            displayed tabs.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int | None): The fixed padding size in cells, or ``None`` to
+            auto-fit the padding.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding and self.tab_padding > 0:
+            return _Edge(self.tab_padding)
+        return _Edge(None)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(self._padding_edge())
+            edges.append(_Edge(cell_len(tab.label)))
+            edges.append(self._padding_edge())
+        sizes = layout_resolve(width, edges)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (cursor, selection_end)
+
+            # Pad the label to the layout size so the run covers its whole span.
+            label_fill = max(label_size - cell_len(tab.label), 0)
+            padded = " " * left + tab.label + " " * label_fill + " " * right
+
+            if tab.name == self.active_tab_name:
+                run_style = console.get_style(self.active_tab_style)
+                run = Text(padded, style=run_style, end="", no_wrap=True)
+                yield from console.render(run, options)
+            else:
+                click_meta = Style(meta={"@click": f"range_clicked('{tab.name}')"})
+                run_style = console.get_style(self.inactive_tab_style) + click_meta
+                run = Text(padded, style=run_style, end="", no_wrap=True)
+                yield from console.render(
+                    Opacity(run, opacity=self.inactive_text_opacity), options
+                )
+            cursor = selection_end
+
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(displayed, label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield bar
+
+    def _highlight_range(
+        self, displayed: list[Tab], label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            displayed (list[Tab]): The displayed tabs.
+            label_ranges (dict[str, tuple[int, int]]): Label ranges keyed by tab name.
+
+        Returns:
+            tuple[float, float]: The highlight start and end columns.
+        """
+        if not displayed:
+            return (0, 0)
+        count = len(displayed)
+        index = min(max(math.floor(self.bar_position), 0), count - 1)
+        fraction = min(max(self.bar_position - index, 0.0), 1.0)
+        next_index = (index + 1) % count
+
+        start, end = label_ranges[displayed[index].name]
+        next_start, next_end = label_ranges[displayed[next_index].name]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+
+class Tabs(Widget, can_focus=True):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by keyboard or mouse. The active tab is identified by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str | None): The name of the initially active tab. Defaults to
+            the name of the first tab. An unknown name is kept, and the bar then
+            sits at index 0.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int | None): The size of the padding on each side of a tab
+            label, in cells. ``None`` or zero fits the padding to the width.
+            Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+        name (str | None): The name of the widget. Defaults to None.
+        id (str | None): The ID of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = "height: 2;"
+
+    _active_tab_name: Reactive[str | None] = Reactive(None)
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        super().__init__(name=name, id=id)
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name: str | None = active_tab
+        elif tabs:
+            initial_name = tabs[0].name
+        else:
+            initial_name = None
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str | None) -> int:
+        """Get the index of a tab name among the displayed tabs.
+
+        Args:
+            tab_name (str | None): The tab name to look up.
+
+        Returns:
+            int: The displayed index, or 0 when the name is not displayed.
+        """
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str | None) -> int:
+        """Find the index of a tab in the full tab list by name.
+
+        Args:
+            tab_name (str | None): The name to look up.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str | None) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            active_tab_name (str | None): The name of the newly active tab.
+        """
+        if active_tab_name is None:
+            return
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full tab list,
+        compares case-insensitively, and never selects the active tab. If no other
+        tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        count = len(self.tabs)
+        wanted = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its position.
+
+        A number greater than the tab count is ignored. Zero activates the tenth tab
+        when there are at least ten tabs, and the last tab otherwise. Any other
+        number activates the tab at that 1-based position.
+
+        Args:
+            tab_number (int): The 1-based tab position, or 0 for the tenth or last tab.
+        """
+        if tab_number > len(self.tabs):
+            return
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Activate the tab whose clickable range was clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus. Every key event is marked handled.
+
+        With no tabs, nothing else happens. Escape makes a bare call to the app's
+        ``set_focus`` with no target. The call is not awaited, so it does not
+        currently remove focus. Right and left move to the next and previous tab,
+        wrapping at either end. The characters 0 through 9 activate a tab by number
+        (see ``activate_tab_by_number``). Other single characters activate the next
+        tab whose label starts with that character, when
+        ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        if not self.tabs:
+            event.prevent_default()
+            return
+
+        key = event.key
+        is_character = len(key) == 1
+        if key == Keys.Escape:
+            self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif is_character and key in DIGIT_CHARACTERS:
+            self.activate_tab_by_number(int(key))
+        elif is_character and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+        event.prevent_default()
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
