+class _ConsoleDouble:
+    def get_style(self, style, *, default=None):
+        if isinstance(style, Style):
+            return style
+        return Style.parse(style)
+
+
+class _OptionsDouble:
+    def __init__(self, max_width: int) -> None:
+        self.max_width = max_width
+
+
+def _first_item(bar: UnderlineBar, max_width: int = 6):
+    console = _ConsoleDouble()
+    options = _OptionsDouble(max_width)
+    return next(iter(bar.__rich_console__(console, options)))
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"home": (0, 3), "about": (3, 6)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━╸━━╺━"
+    home_span, about_span = item.spans[-2:]
+    assert (home_span.start, home_span.end) == (0, 3)
+    assert home_span.style.meta == {"@click": "range_clicked('home')"}
+    assert (about_span.start, about_span.end) == (3, 6)
+    assert about_span.style.meta == {"@click": "range_clicked('about')"}
+
+
+@pytest.mark.parametrize("highlight_range", [(0, 0), (5, 2), (-5, -2)])
+def test_early_path_has_background_run_without_click_metadata(highlight_range):
+    bar = UnderlineBar(
+        highlight_range=highlight_range,
+        clickable_ranges={"home": (0, 3)},
+        width=6,
+    )
+    item = _first_item(bar)
+    assert isinstance(item, Text)
+    assert item.plain == "━━━━━━"
+    assert item.spans
+    for span in item.spans:
+        assert "@click" not in span.style.meta
