+def test_opacity_preserves_click_metadata():
+    from rich.console import Console
+    import io
+
+    style = Style(color="#ff0000", bgcolor="#00ff00", meta={"@click": "noop"})
+    text = Text("Hello", style=style, end="")
+    console = Console(width=20, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(Opacity(text, opacity=0.5), console.options))
+    styled = [segment for segment in segments if segment.text.strip()]
+    assert styled
+    for segment in styled:
+        assert segment.style.meta == {"@click": "noop"}
