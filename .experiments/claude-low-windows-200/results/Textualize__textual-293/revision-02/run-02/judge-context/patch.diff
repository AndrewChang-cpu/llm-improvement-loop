@@ -0,0 +1,194 @@
+import asyncio
+import re
+
+from tests.utilities.render import render
+from textual import events
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(text: str) -> str:
+    return ANSI.sub("", text)
+
+
+def make_tabs(*names: str, **kwargs) -> Tabs:
+    return Tabs([Tab(name.title(), name) for name in names], **kwargs)
+
+
+def press(tabs: Tabs, key: str) -> None:
+    asyncio.run(tabs.on_key(events.Key(tabs, key)))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+
+
+def test_tab_equality_and_text_form():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "h") != Tab("Home", "home")
+    assert str(Tab("Home", "h")) == "Home"
+    assert "label='Home'" in repr(Tab("Home", "h"))
+    assert "name='h'" in repr(Tab("Home", "h"))
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("A2", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = make_tabs("a", "b", "c")
+    assert tabs._active_tab_name == "a"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given():
+    tabs = make_tabs("a", "b", "c", active_tab="c")
+    assert tabs._active_tab_name == "c"
+    assert tabs._bar_position == 2.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = make_tabs("a", "b", active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([], active_tab="a")
+    assert tabs._active_tab_name == ""
+
+
+def test_next_and_previous_wrap():
+    tabs = make_tabs("a", "b", "c")
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "b"
+
+
+def test_number_keys_activate_by_position():
+    tabs = make_tabs("a", "b", "c")
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(5)  # beyond the tab count is ignored
+    assert tabs._active_tab_name == "b"
+
+
+def test_zero_key_is_last_tab_with_fewer_than_ten():
+    tabs = make_tabs("a", "b", "c")
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_zero_key_is_tenth_tab_with_ten_or_more():
+    names = [f"t{i}" for i in range(12)]
+    tabs = make_tabs(*names)
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Home"), Tab("Apple"), Tab("Banana"), Tab("apricot")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "apricot"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_keeps_active_when_no_other_match():
+    tabs = Tabs([Tab("Home"), Tab("Apple")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_key_handling_right_left_and_digits():
+    tabs = make_tabs("a", "b", "c")
+    press(tabs, "right")
+    assert tabs._active_tab_name == "b"
+    press(tabs, "left")
+    assert tabs._active_tab_name == "a"
+    press(tabs, "3")
+    assert tabs._active_tab_name == "c"
+
+
+def test_key_handling_letter_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("Home"), Tab("Apple")], search_by_first_character=False
+    )
+    press(tabs, "a")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_key_handling_with_no_tabs_does_nothing():
+    tabs = Tabs([])
+    press(tabs, "right")
+    press(tabs, "1")
+    press(tabs, "a")
+    assert tabs._active_tab_name == ""
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = make_tabs("a", "b")
+    asyncio.run(tabs.action_range_clicked("b"))
+    assert tabs._active_tab_name == "b"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")])
+    renderable = TabsRenderable(
+        tabs.tabs,
+        active_tab_name="x",
+        bar_position=0.0,
+        active_tab_style="",
+        active_bar_style="",
+        inactive_tab_style="",
+        inactive_bar_style="",
+        inactive_text_opacity=0.5,
+        tab_padding=None,
+    )
+    assert [tab.label for tab in renderable.displayed_tabs] == ["Three", "Two"]
+    assert [tab.name for tab in renderable.displayed_tabs] == ["x", "y"]
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    renderable = TabsRenderable(
+        [],
+        active_tab_name="",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=None,
+    )
+    lines = plain(render(renderable)).split("\n")
+    assert lines == ["", "━" * 100]
+
+
+def test_label_row_contains_labels_and_two_rows():
+    tabs = Tabs([Tab("Home", "home"), Tab("Docs", "docs")], tab_padding=1)
+    renderable = TabsRenderable(
+        tabs.tabs,
+        active_tab_name="home",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=1,
+    )
+    lines = plain(render(renderable)).split("\n")
+    assert len(lines) == 2
+    assert lines[0] == " Home  Docs "
+    assert lines[1] == "━" * 100
