+def test_clickable_ranges_attach_click_spans():
+    console = Console(file=io.StringIO())
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"tab_a": (0, 2), "tab_b": (2, 6)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(console, _Options()))
+
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    # The click spans are the last spans, in mapping order
+    first, second = text.spans[-2], text.spans[-1]
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": "range_clicked('tab_a')"}
+    assert (second.start, second.end) == (2, 6)
+    assert second.style.meta == {"@click": "range_clicked('tab_b')"}
+
+
+def test_clickable_ranges_not_attached_on_zero_width_path():
+    console = Console(file=io.StringIO())
+    bar = UnderlineBar(
+        highlight_range=(0, 0),
+        clickable_ranges={"tab_a": (0, 2)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(console, _Options()))
+
+    assert len(items) == 1
+    assert isinstance(items[0], Text)
+    assert all("@click" not in span.style.meta for span in items[0].spans)
