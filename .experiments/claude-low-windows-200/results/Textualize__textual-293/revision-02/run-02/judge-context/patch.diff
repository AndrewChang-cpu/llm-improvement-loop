diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..07c23b7
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,430 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import floor
+from typing import List, Optional, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+@dataclass
+class Tab:
+    """A tab for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    label: str
+    name: Optional[str] = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A layout edge for `layout_resolve`."""
+
+    size: Optional[int] = None
+    fraction: int = 1
+    min_size: int = 1
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> List[Tab]:
+    """Compute the tabs that are rendered.
+
+    There is one entry per distinct name. The entry takes the position of the first
+    tab with that name and the label of the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The displayed tabs, in display order.
+    """
+    positions: dict[str, int] = {}
+    displayed: List[Tab] = []
+    for tab in tabs:
+        if tab.name in positions:
+            displayed[positions[tab.name]] = tab
+        else:
+            positions[tab.name] = len(displayed)
+            displayed.append(tab)
+    return displayed
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (List[Tab]): The full tab list.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs of the bar.
+        active_tab_style (StyleType): Style of the active tab.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int, optional): Fixed size of each padding edge, or ``None``
+            to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: Optional[int],
+    ) -> None:
+        self.displayed_tabs = _displayed_tabs(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+        self.label_ranges: dict[str, Tuple[int, int]] = {}
+        self.selection_ranges: dict[str, Tuple[int, int]] = {}
+
+    def _resolve_padding(self, width: int) -> List[Tuple[int, int]]:
+        """Resolve the left and right padding of each displayed tab.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            List[Tuple[int, int]]: The (left, right) padding for each displayed tab.
+        """
+        fixed: Optional[int] = (
+            self.tab_padding if self.tab_padding and self.tab_padding > 0 else None
+        )
+        edges: List[_Edge] = []
+        for tab in self.displayed_tabs:
+            edges.append(_Edge(size=fixed))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=fixed))
+        sizes = layout_resolve(width, edges)
+        return [(sizes[index], sizes[index + 2]) for index in range(0, len(sizes), 3)]
+
+    def _build_label_row(
+        self, console: Console, options: ConsoleOptions
+    ) -> List[Segment]:
+        """Lay out the labels and record label and selection ranges.
+
+        Args:
+            console (Console): The console used for rendering.
+            options (ConsoleOptions): The render options.
+
+        Returns:
+            List[Segment]: The segments of the label row.
+        """
+        self.label_ranges = {}
+        self.selection_ranges = {}
+        segments: List[Segment] = []
+        cursor = 0
+        paddings = self._resolve_padding(options.max_width)
+        for tab, (left, right) in zip(self.displayed_tabs, paddings):
+            label_width = cell_len(tab.label)
+            selection_start = cursor
+            label_start = cursor + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            name = tab.name
+            self.label_ranges[name] = (label_start, label_end)
+            self.selection_ranges[name] = (selection_start, selection_end)
+
+            is_active = name == self.active_tab_name
+            text = Text(
+                " " * left + tab.label + " " * right,
+                style=self.active_tab_style if is_active else self.inactive_tab_style,
+                no_wrap=True,
+                overflow="ignore",
+                end="",
+            )
+            if is_active:
+                piece: RenderableType = text
+            else:
+                text.stylize(Style(meta={"@click": f"range_clicked({name!r})"}))
+                piece = Opacity(text, opacity=self.inactive_text_opacity)
+            segments.extend(console.render(piece, options))
+            cursor = selection_end
+        return segments
+
+    def _highlight_range(self) -> Tuple[float, float]:
+        """Interpolate the label range under the bar position.
+
+        Returns:
+            Tuple[float, float]: The (start, end) columns to highlight.
+        """
+        count = len(self.displayed_tabs)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(floor(position))
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_a, end_a = self.label_ranges[self.displayed_tabs[index].name]
+        start_b, end_b = self.label_ranges[self.displayed_tabs[next_index].name]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        # Labels first: this records the label and selection ranges used by the bar
+        label_segments = self._build_label_row(console, options)
+        yield from label_segments
+        yield Segment.line()
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=self.selection_ranges,
+            width=options.max_width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A tab is selected with the keyboard or the mouse. Selection is identified by tab
+    name.
+
+    Args:
+        tabs (List[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. If empty or
+            ``None``, the first tab is active. Defaults to ``None``.
+        active_tab_style (StyleType, optional): The style of the active tab. Defaults
+            to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs. Defaults
+            to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline bar. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tab labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the bar
+            animation when the active tab changes. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by
+            the bar animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a label.
+            ``None`` or ``0`` auto-fits the padding to the widget width. Defaults to
+            ``None``.
+        search_by_first_character (bool, optional): If ``True``, pressing a letter key
+            activates the next tab whose label starts with that letter. Defaults to
+            ``True``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: Optional[str] = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: Optional[int] = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: List[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str) -> int:
+        """Get the index of a name in the displayed tabs, or 0 if not displayed.
+
+        Args:
+            tab_name (str): The tab name.
+
+        Returns:
+            int: The index into the displayed tabs.
+        """
+        for index, tab in enumerate(_displayed_tabs(self.tabs)):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    async def watch__active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the bar to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of a tab in the full tab list by name.
+
+        Args:
+            tab_name (str): The name of the tab.
+
+        Returns:
+            int: The index of the first tab with that name, or 0 if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = (self.find_tab_by_name(self._active_tab_name) + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = (self.find_tab_by_name(self._active_tab_name) - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, is case-insensitive, and never
+        selects the active tab.
+
+        Args:
+            char (str): The character to match.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        start = self.find_tab_by_name(self._active_tab_name)
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            name = tab.name
+            if name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        The number 0 activates the 10th tab when there are at least ten tabs. Otherwise
+        it resolves to the last tab. Numbers beyond the tab count are ignored.
+
+        Args:
+            tab_number (int): The tab number.
+        """
+        if tab_number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        elif 0 < tab_number <= len(self.tabs):
+            index = tab_number - 1
+        else:
+            return
+        tab = self.tabs[index]
+        self._active_tab_name = tab.name
+
+    async def action_range_clicked(self, target_tab_name: str) -> None:
+        """Set the named tab as the active tab. Used by the click action.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the widget has focus.
+
+        The event is always marked handled, without stopping its propagation.
+
+        - With no tabs, nothing else happens.
+        - Escape clears focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digits 1 to 9 activate the tab at that position. 0 activates the 10th
+          tab when there are at least ten tabs, otherwise the last tab. Digits beyond
+          the tab count are ignored.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab whose label starts with it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
