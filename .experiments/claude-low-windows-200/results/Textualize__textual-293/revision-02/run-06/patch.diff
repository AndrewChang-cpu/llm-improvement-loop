+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows Tabs widgets."""
+
+    def on_mount(self):
+        """Mount the example tab rows directly on the app."""
+        self.mount(
+            tabs_home=Tabs(
+                [Tab("Home"), Tab("Music"), Tab("Settings"), Tab("Help")],
+                active_tab="Music",
+            ),
+            tabs_numbers=Tabs([Tab(str(number)) for number in range(1, 13)]),
+            tabs_empty=Tabs([]),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
