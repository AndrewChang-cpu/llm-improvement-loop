diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..624c5c5
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,163 @@
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable, _displayed_tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def _renderable(tabs, active_tab_name="", bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+    assert repr(Tab("Home", "a")) == "Tab(label='Home', name='a')"
+
+
+def test_displayed_tabs_keep_first_position_and_last_label():
+    tabs = [Tab("Home", "a"), Tab("Music", "b"), Tab("Again", "a")]
+    displayed = _displayed_tabs(tabs)
+    assert [(tab.label, tab.name) for tab in displayed] == [
+        ("Again", "a"),
+        ("Music", "b"),
+    ]
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("Home", "a"), Tab("Music", "b"), Tab("Again", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = Tabs([Tab("Home"), Tab("Music")])
+    assert tabs._active_tab_name == "Home"
+
+
+def test_initial_active_tab_is_used_when_given():
+    tabs = Tabs([Tab("Home"), Tab("Music")], active_tab="Music")
+    assert tabs._active_tab_name == "Music"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = Tabs([Tab("Home"), Tab("Music")], active_tab="Nope")
+    assert tabs._active_tab_name == "Nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([], active_tab="Home")
+    assert tabs._active_tab_name == ""
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("Home"), Tab("Music"), Tab("Settings")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Music"
+    tabs.activate_next_tab()
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Home"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Settings"
+
+
+def test_activate_by_number_zero_resolves_to_last_tab():
+    tabs = Tabs([Tab("Home"), Tab("Music"), Tab("Settings")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Settings"
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Music"
+
+
+def test_first_character_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Home"), Tab("Music"), Tab("Settings")])
+    tabs.activate_tab_by_first_char("s")
+    assert tabs._active_tab_name == "Settings"
+    tabs.activate_tab_by_first_char("H")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_first_character_search_keeps_active_when_no_other_match():
+    tabs = Tabs([Tab("Home"), Tab("Music")])
+    tabs.activate_tab_by_first_char("h")
+    assert tabs._active_tab_name == "Home"
+
+
+def test_layout_label_and_selection_ranges_auto_fit():
+    layout = _renderable(
+        [Tab("Home"), Tab("Music")], active_tab_name="Home"
+    )._layout(30)
+    assert layout.label_ranges == {"Home": (5, 9), "Music": (19, 24)}
+    assert layout.selection_ranges == {"Home": (0, 14), "Music": (14, 30)}
+
+
+def test_layout_label_and_selection_ranges_fixed_padding():
+    layout = _renderable(
+        [Tab("Home"), Tab("Music")], active_tab_name="Home", tab_padding=2
+    )._layout(30)
+    assert layout.label_ranges == {"Home": (2, 6), "Music": (10, 15)}
+    assert layout.selection_ranges == {"Home": (0, 8), "Music": (8, 17)}
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    plain = ANSI.sub("", render(_renderable([])))
+    assert plain == "\n" + "━" * 100
+
+
+def test_inactive_padded_cells_carry_click_and_active_does_not():
+    console = Console(width=30, file=io.StringIO(), color_system="truecolor")
+    segments = list(
+        _renderable(
+            [Tab("Home"), Tab("Music")], active_tab_name="Home", tab_padding=2
+        ).__rich_console__(console, console.options)
+    )
+    label_segments = []
+    for segment in segments:
+        if segment.text == "\n":
+            break
+        label_segments.append(segment)
+
+    def meta_of(segment):
+        return segment.style.meta if segment.style else {}
+
+    music = "".join(
+        segment.text
+        for segment in label_segments
+        if meta_of(segment).get("@click") == "range_clicked('Music')"
+    )
+    assert music == "  Music  "
+
+    home_clicks = [
+        segment for segment in label_segments if "@click" in meta_of(segment)
+    ]
+    assert all(
+        meta_of(segment)["@click"] == "range_clicked('Music')"
+        for segment in home_clicks
+    )
+    home_text = "".join(
+        segment.text for segment in label_segments if "@click" not in meta_of(segment)
+    )
+    assert home_text == "  Home  "
