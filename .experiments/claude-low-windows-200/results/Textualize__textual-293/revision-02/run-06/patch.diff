diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..92be988
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,451 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import List, NamedTuple, Optional, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """An edge for the layout resolver: a label or a padding cell span."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+class _TabsLayout(NamedTuple):
+    """The result of laying out the displayed tabs across a width."""
+
+    rows: List[Tuple[Tab, str]]
+    label_ranges: dict
+    selection_ranges: dict
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> List[Tab]:
+    """Compute one displayed tab per distinct name.
+
+    The position comes from the first tab with a name, and the label comes from
+    the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        List[Tab]: The displayed tabs, in display order.
+    """
+    labels: dict = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its first position
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): The fractional index that places the underline.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int | None): A fixed padding size, or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> _TabsLayout:
+        """Lay out the displayed tabs and compute their cell ranges.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            _TabsLayout: The label rows, label ranges, and selection ranges.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        padding = self.tab_padding or None
+
+        edges: List[_Edge] = []
+        slots: List[Tuple[int, str]] = []
+        for index, tab in enumerate(displayed):
+            label_width = cell_len(tab.label)
+            edges.append(_Edge(size=padding))
+            slots.append((index, "left"))
+            if label_width:
+                # A zero-width label is not an edge, since a size of 0 is flexible
+                edges.append(_Edge(size=label_width))
+                slots.append((index, "label"))
+            edges.append(_Edge(size=padding))
+            slots.append((index, "right"))
+
+        sizes = dict(zip(slots, layout_resolve(width, edges)))
+
+        rows: List[Tuple[Tab, str]] = []
+        label_ranges: dict = {}
+        selection_ranges: dict = {}
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left = sizes[(index, "left")]
+            label = sizes.get((index, "label"), 0)
+            right = sizes[(index, "right")]
+            label_start = cursor + left
+            label_ranges[tab.name] = (label_start, label_start + label)
+            selection_ranges[tab.name] = (cursor, cursor + left + label + right)
+            rows.append((tab, " " * left + tab.label + " " * right))
+            cursor += left + label + right
+
+        return _TabsLayout(rows, label_ranges, selection_ranges)
+
+    def _highlight_range(self, layout: _TabsLayout) -> Tuple[float, float]:
+        """Interpolate the highlight between the floor index and the next index.
+
+        Args:
+            layout (_TabsLayout): The layout of the current width.
+
+        Returns:
+            Tuple[float, float]: The highlighted column range.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return (0, 0)
+        floor_index = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_index
+        current = self.tabs[floor_index % count].name
+        following = self.tabs[(floor_index + 1) % count].name
+        current_start, current_end = layout.label_ranges[current]
+        next_start, next_end = layout.label_ranges[following]
+        return (
+            current_start + (next_start - current_start) * fraction,
+            current_end + (next_end - current_end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        layout = self._layout(options.max_width)
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for tab, padded in layout.rows:
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action
+                text = Text(padded, style=active_style, end="", no_wrap=True)
+                yield from console.render(text, options)
+            else:
+                click_style = Style.combine(
+                    [
+                        inactive_style,
+                        Style(meta={"@click": f"range_clicked({tab.name!r})"}),
+                    ]
+                )
+                text = Text(padded, style=click_style, end="", no_wrap=True)
+                yield from console.render(
+                    Opacity(text, self.inactive_text_opacity), options
+                )
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(layout),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=layout.selection_ranges,
+            width=None,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline.
+    A tab is selected by clicking it, or by the keyboard (see `on_key`).
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            not given or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tab text,
+            from 0 (background) to 1 (full color). Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline
+            animation when the active tab changes. Defaults to 0.3.
+        animation_function (str): The name of the easing function used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The number of cells on each side of a label.
+            If None or zero, padding fills the available width. Defaults to None.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            active_name = ""
+        else:
+            active_name = active_tab or self.tabs[0].name
+        self._bar_position = float(self.find_tab_by_name(active_name))
+        self._active_tab_name = active_name
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The tab name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def _active_index(self) -> int:
+        """Get the index of the first tab with the active name, or -1 if none."""
+        for index, tab in enumerate(self.tabs):
+            if tab.name == self._active_tab_name:
+                return index
+        return -1
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping to the first tab after the last."""
+        self._move_active(1)
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping to the last tab before the first."""
+        self._move_active(-1)
+
+    def _move_active(self, step: int) -> None:
+        """Move the active tab by a step, skipping tabs that share its name.
+
+        Args:
+            step (int): ``1`` for next, ``-1`` for previous.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return
+        index = self._active_index()
+        if index == -1:
+            start = -1 if step > 0 else 0
+        else:
+            start = index
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + step * offset) % count]
+            if tab.name != self._active_tab_name:
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab after the active one whose label starts with a character.
+
+        The search is case-insensitive, wraps around, and never selects the active
+        tab. If no other tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return
+        needle = char.lower()
+        start = self._active_index()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        A value of 0 resolves to the last tab through negative indexing.
+
+        Args:
+            tab_number (int): The 1-based tab position.
+        """
+        self._active_tab_name = self.tabs[tab_number - 1].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. Invoked by a click on a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, tab_name: str) -> None:
+        """Animate the underline to the position of the new active tab.
+
+        Args:
+            tab_name (str): The name of the new active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for tab navigation. Every key event is marked handled.
+
+        With no tabs, nothing else happens. Otherwise:
+
+        - Escape clears focus from the widget.
+        - Right and left move to the next or previous tab, wrapping at either end.
+        - Digits 1 to 9 activate the tab at that 1-based position. A digit larger
+          than the tab count is ignored. The 0 key activates the 10th tab when
+          there are at least ten tabs, and the last tab otherwise.
+        - Any other single character activates the next tab, after the active one,
+          whose label starts with that character, if ``search_by_first_character``
+          is true. The active tab is never selected by this search.
+
+        Propagation is not stopped, so application bindings still receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            if key == "0":
+                tab_number = 10 if len(self.tabs) >= 10 else 0
+            else:
+                tab_number = int(key)
+                if tab_number > len(self.tabs):
+                    return
+            self.activate_tab_by_number(tab_number)
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
