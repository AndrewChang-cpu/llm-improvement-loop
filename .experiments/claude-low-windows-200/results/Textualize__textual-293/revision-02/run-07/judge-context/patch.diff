+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox demo of the Tabs widget."""
+
+    def on_mount(self) -> None:
+        """Mount example tab bars directly on the app."""
+        self.mount(
+            first=Tabs(
+                [Tab("Home"), Tab("Files"), Tab("Settings"), Tab("Help")],
+            ),
+            second=Tabs(
+                [Tab("Inbox", "inbox"), Tab("Sent", "sent"), Tab("Drafts", "drafts")],
+                active_tab="sent",
+                tab_padding=2,
+            ),
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
