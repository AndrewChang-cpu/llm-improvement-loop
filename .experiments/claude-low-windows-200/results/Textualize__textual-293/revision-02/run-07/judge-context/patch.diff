diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..d788588
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,426 @@
+from __future__ import annotations
+
+from typing import NamedTuple, Sequence
+
+import rich.repr
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+@rich.repr.auto
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A size description for `layout_resolve`."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class _Slot(NamedTuple):
+    """Columns occupied by one displayed tab."""
+
+    name: str
+    label: str
+    span_start: int
+    label_start: int
+    label_end: int
+    span_end: int
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the tabs to display, one per distinct name.
+
+    Each name keeps the position of its first tab and the label of its last tab.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs.
+    """
+    displayed: dict[str, Tab] = {}
+    for tab in tabs:
+        displayed[tab.name] = tab
+    return list(displayed.values())
+
+
+class TabsRenderable:
+    """Lays out the tab labels and the underline bar.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of the inactive tabs.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int, optional): Fixed padding on each side of a label, or
+            ``None`` (or zero) to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _Edge:
+        if self.tab_padding:
+            return _Edge(size=self.tab_padding)
+        return _Edge()
+
+    def _layout(self, width: int) -> list[_Slot]:
+        """Compute the columns of every displayed tab across the width."""
+        displayed = _displayed_tabs(self.tabs)
+        label_widths = [cell_len(tab.label) for tab in displayed]
+
+        edges: list[_Edge] = []
+        for label_width in label_widths:
+            edges.append(self._padding_edge())
+            if label_width > 0:
+                # A zero-size edge would be treated as flexible, so it is omitted
+                edges.append(_Edge(size=label_width))
+            edges.append(self._padding_edge())
+
+        sizes = iter(layout_resolve(width, edges))
+        slots: list[_Slot] = []
+        position = 0
+        for tab, label_width in zip(displayed, label_widths):
+            left = next(sizes)
+            label = next(sizes) if label_width > 0 else 0
+            right = next(sizes)
+            label_start = position + left
+            label_end = label_start + label
+            span_end = label_end + right
+            slots.append(
+                _Slot(tab.name, tab.label, position, label_start, label_end, span_end)
+            )
+            position = span_end
+        return slots
+
+    def _highlight_range(
+        self, slots: Sequence[_Slot]
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted label range at the bar position."""
+        count = len(slots)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), count - 1)
+        index = int(position)
+        fraction = position - index
+        current = slots[index]
+        following = slots[(index + 1) % count]
+        start = current.label_start + (
+            following.label_start - current.label_start
+        ) * fraction
+        end = current.label_end + (following.label_end - current.label_end) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        slots = self._layout(options.max_width)
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        for slot in slots:
+            selection_ranges[slot.name] = (slot.span_start, slot.span_end)
+            padded = (
+                " " * (slot.label_start - slot.span_start)
+                + slot.label
+                + " " * (slot.span_end - slot.label_end)
+            )
+            if slot.name == self.active_tab_name:
+                text = Text(
+                    padded, style=active_style, no_wrap=True, overflow="ignore", end=""
+                )
+                yield from text.render(console, end="")
+            else:
+                text = Text(
+                    padded,
+                    style=inactive_style
+                    + Style(meta={"@click": f"range_clicked({slot.name!r})"}),
+                    no_wrap=True,
+                    overflow="ignore",
+                    end="",
+                )
+                yield from console.render(
+                    Opacity(text, opacity=self.inactive_text_opacity), options
+                )
+
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(slots),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=options.max_width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs can be selected with the keyboard or the mouse. Selection is identified by
+    tab name, not by position.
+
+    Args:
+        tabs (list[Tab]): The tabs to show. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If not
+            given or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType, optional): Style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of the inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to the inactive
+            tab labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the underline animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label,
+            or None to fit the padding to the width. Zero is treated as None.
+            Defaults to None.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with that character.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._displayed_index(initial_name))
+
+    def _displayed_index(self, tab_name: str) -> int:
+        """Index of a name among the displayed tabs, or 0 if it is not displayed."""
+        names = [tab.name for tab in _displayed_tabs(self.tabs)]
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list,
+                or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, tab_name: str) -> None:
+        """Animate the underline to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, is case-insensitive, and never
+        selects the active tab. The active tab is unchanged if no other tab matches.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        With ten or more tabs, 0 activates the tenth tab. With fewer, 0 resolves to
+        the last tab through negative indexing. Numbers beyond the tab count are
+        ignored.
+
+        Args:
+            tab_number (int): The 1-based tab number.
+        """
+        count = len(self.tabs)
+        if tab_number == 0 and count >= 10:
+            index = 9
+        else:
+            index = tab_number - 1
+        if not -count <= index < count:
+            return
+        self._active_tab_name = self.tabs[index].name
+
+    async def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab.
+
+        Args:
+            target_tab_name (str): The name of the tab that was clicked.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for navigating the tabs.
+
+        Every key event is marked handled, and no key stops propagation, so
+        application bindings still receive keys. With no tabs, nothing else happens.
+        Otherwise:
+
+        - Escape clears focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - Digits 1 to 9 activate the tab at that position. 0 activates the tenth tab
+          when there are ten or more tabs, and otherwise the last tab.
+        - Any other single character activates the next tab whose label starts with
+          it, if search_by_first_character is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key.isdigit():
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
