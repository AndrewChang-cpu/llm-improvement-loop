+import asyncio
+import io
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+class FakeKey:
+    """Stands in for a key event; records whether it was marked handled."""
+
+    def __init__(self, key: str) -> None:
+        self.key = key
+        self.handled = False
+
+    def prevent_default(self, prevent: bool = True) -> "FakeKey":
+        self.handled = prevent
+        return self
+
+
+def press(tabs: Tabs, key: str) -> FakeKey:
+    event = FakeKey(key)
+    asyncio.run(tabs.on_key(event))
+    return event
+
+
+def make_renderable(tabs, active: str = "", position: float = 0.0) -> TabsRenderable:
+    return TabsRenderable(
+        tabs,
+        active_tab_name=active,
+        bar_position=position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=None,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "a") != Tab("Home", "b")
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_duplicate_names_render_once_with_last_label():
+    tabs = [Tab("Alpha", "x"), Tab("Beta", "y"), Tab("Gamma", "x")]
+    output = render(make_renderable(tabs, active="x"))
+    assert "Gamma" in output
+    assert "Alpha" not in output
+    assert "Beta" in output
+
+
+def test_no_tabs_draws_empty_label_row_and_full_underline():
+    output = render(make_renderable([]))
+    label_row, underline_row = output.split("\n")
+    assert label_row == ""
+    assert underline_row.count("━") == 100
+
+
+def test_inactive_span_carries_click_action_and_active_does_not():
+    console = Console(width=40, file=io.StringIO())
+    renderable = make_renderable([Tab("Home"), Tab("Docs")], active="Home")
+    segments = list(renderable.__rich_console__(console, console.options))
+
+    home = [segment for segment in segments if "Home" in segment.text]
+    docs = [segment for segment in segments if "Docs" in segment.text]
+    assert home and docs
+    assert "@click" not in home[0].style.meta
+    assert docs[0].style.meta == {"@click": "range_clicked('Docs')"}
+
+
+def test_right_and_left_wrap_around_full_list():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")], active_tab="a")
+    press(tabs, "right")
+    assert tabs._active_tab_name == "b"
+    press(tabs, "right")
+    press(tabs, "right")
+    assert tabs._active_tab_name == "a"
+    press(tabs, "left")
+    assert tabs._active_tab_name == "c"
+
+
+def test_digit_activates_by_position_and_ignores_out_of_range():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")], active_tab="a")
+    press(tabs, "2")
+    assert tabs._active_tab_name == "b"
+    press(tabs, "9")
+    assert tabs._active_tab_name == "b"
+
+
+def test_zero_activates_last_tab_with_fewer_than_ten():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b"), Tab("C", "c")], active_tab="a")
+    press(tabs, "0")
+    assert tabs._active_tab_name == "c"
+
+
+def test_letter_search_is_case_insensitive_wraps_and_skips_active():
+    tabs = Tabs(
+        [Tab("Apple", "apple"), Tab("Banana", "banana"), Tab("avocado", "avo")],
+        active_tab="apple",
+    )
+    press(tabs, "A")
+    assert tabs._active_tab_name == "avo"
+    press(tabs, "a")
+    assert tabs._active_tab_name == "apple"
+
+
+def test_letter_search_disabled_by_flag():
+    tabs = Tabs(
+        [Tab("A", "a"), Tab("Banana", "b")],
+        active_tab="a",
+        search_by_first_character=False,
+    )
+    press(tabs, "b")
+    assert tabs._active_tab_name == "a"
+
+
+def test_every_key_is_marked_handled_including_with_no_tabs():
+    tabs = Tabs([])
+    assert press(tabs, "right").handled
+    assert press(tabs, "x").handled
+    assert tabs._active_tab_name == ""
+
+
+def test_initial_active_tab_defaults_to_first_when_unknown_name_sits_at_zero():
+    tabs = Tabs([Tab("A", "a"), Tab("B", "b")], active_tab="unknown")
+    assert tabs._active_tab_name == "unknown"
+    assert tabs._bar_position == 0.0
