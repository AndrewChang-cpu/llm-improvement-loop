+import io
+
+from rich.console import Console
+from rich.text import Text
+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
@@ -124,3 +129,23 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+def test_clickable_ranges_are_last_spans_in_mapping_order():
+    console = Console(width=6, file=io.StringIO())
+    bar = UnderlineBar(
+        highlight_range=(1, 3),
+        clickable_ranges={"first": (0, 2), "second": (3, 5)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(console, console.options))
+
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    assert len(text.plain) == 6
+    first, second = text.spans[-2], text.spans[-1]
+    assert (first.start, first.end) == (0, 2)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert (second.start, second.end) == (3, 5)
+    assert second.style.meta == {"@click": "range_clicked('second')"}
