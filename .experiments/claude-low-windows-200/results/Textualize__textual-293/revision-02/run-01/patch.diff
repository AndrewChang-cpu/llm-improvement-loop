+def test_underline_clickable_ranges_follow_display_order():
+    renderable = _tabs_renderable([Tab("A"), Tab("B")], active_tab_name="A")
+    console = Console(width=20, file=io.StringIO(), color_system="truecolor")
+    items = list(renderable.__rich_console__(console, console.options))
+    bar = items[-1]
+
+    ranges = list(bar.clickable_ranges.items())
+    assert [name for name, _ in ranges] == ["A", "B"]
+    (_, (first_start, first_end)), (_, (second_start, second_end)) = ranges
+    assert first_start == 0
+    assert second_start == first_end
+    assert second_end <= 20
