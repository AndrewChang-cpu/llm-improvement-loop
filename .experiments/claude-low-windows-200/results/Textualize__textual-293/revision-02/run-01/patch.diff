+def test_inactive_padding_carries_click_action_and_active_does_not():
+    renderable = _tabs_renderable(
+        [Tab("A"), Tab("B")], active_tab_name="A", tab_padding=2
+    )
+    segments = _label_row_segments(renderable)
+
+    active_segments = [s for s in segments if "A" in s.text]
+    inactive_segments = [s for s in segments if "B" in s.text]
+    assert active_segments and inactive_segments
+    assert all(s.style.meta == {} for s in active_segments)
+    assert all(
+        s.style.meta == {"@click": "range_clicked('B')"} for s in inactive_segments
+    )
+
