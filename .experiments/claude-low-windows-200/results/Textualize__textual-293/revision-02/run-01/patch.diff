diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..3adbab0
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,394 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import floor
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGITS = "0123456789"
+
+
+@dataclass
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    label: str
+    name: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A flexible or fixed span of cells, as consumed by ``layout_resolve``."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The displayed tabs, one per distinct name.
+        active_tab_name (str): The name of the active tab, or an empty string.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int | None): Fixed size of each padding edge, or ``None`` to
+            auto-fit the padding.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _tab_cells(self, width: int) -> list[tuple[int, int, int]]:
+        """Compute (left padding, label, right padding) cell counts for each tab."""
+        padding_size = self.tab_padding or None
+        edges: list[_Edge] = []
+        slots: list[tuple[int, int | None, int, int]] = []
+        for tab in self.tabs:
+            label_width = cell_len(tab.label)
+            left = len(edges)
+            edges.append(_Edge(size=padding_size))
+            label_index: int | None = None
+            if label_width:
+                # A zero-width label is left out, because a size of 0 would
+                # be treated as flexible by the resolver.
+                label_index = len(edges)
+                edges.append(_Edge(size=label_width))
+            right = len(edges)
+            edges.append(_Edge(size=padding_size))
+            slots.append((left, label_index, right, label_width))
+
+        if not edges:
+            return []
+        sizes = layout_resolve(width, edges)
+        cells: list[tuple[int, int, int]] = []
+        for left, label_index, right, label_width in slots:
+            label = sizes[label_index] if label_index is not None else 0
+            cells.append((sizes[left], label, sizes[right]))
+        return cells
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the current bar position."""
+        count = len(label_ranges)
+        if not count:
+            return (0.0, 0.0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(floor(position))
+        fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_ranges[index]
+        next_start, next_end = label_ranges[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        cursor = 0
+        for tab, (left, label_width, right) in zip(self.tabs, self._tab_cells(width)):
+            label_start = cursor + left
+            label_end = label_start + label_width
+            span_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (cursor, span_end)
+            cursor = span_end
+
+            padded = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                yield Text(padded, style=active_tab_style, end="")
+            else:
+                text = Text(padded, style=inactive_tab_style, end="")
+                text.stylize(Style(meta={"@click": f"range_clicked({tab.name!r})"}))
+                yield Opacity(text, opacity=self.inactive_text_opacity)
+
+        # The line break always separates the label row from the underline row
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    A tab is selected with the mouse, the arrow keys, the number keys, or by typing
+    the first character of its label.
+
+    Args:
+        tabs (list[Tab]): The tabs to show, in order. May be empty.
+        active_tab (str, optional): The name of the tab that starts active. If it is
+            not given, or is empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType, optional): The style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of
+            the underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tab text, from 0 to 1. Defaults to 0.5.
+        animation_duration (float, optional): The duration of the underline animation,
+            in seconds. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by
+            the underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The width of the padding on each side of a
+            label. ``None`` or ``0`` auto-fits the padding to the widget width.
+            Defaults to None.
+        search_by_first_character (bool, optional): Whether typing a character
+            activates the next tab whose label starts with it. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self._bar_index(initial_name))
+
+    def _displayed_tabs(self) -> list[Tab]:
+        """Return one tab per distinct name, in the position of its first occurrence.
+
+        The label comes from the last tab with that name.
+        """
+        displayed: dict[str, Tab] = {}
+        for tab in self.tabs:
+            displayed[tab.name] = tab
+        return list(displayed.values())
+
+    def _bar_index(self, tab_name: str) -> int:
+        """Return the index of the displayed tab with the given name, or 0."""
+        for index, tab in enumerate(self._displayed_tabs()):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab in the full tab list with that name, or 0
+                if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str) -> None:
+        self.animate(
+            "_bar_position",
+            float(self._bar_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, never selects the active
+        tab, and is case-insensitive. The active tab does not change if nothing matches.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        if not self.tabs or not char:
+            return
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        count = len(self.tabs)
+        needle = char.casefold()
+        for offset in range(1, count):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.casefold().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate the tab at a 1-based position in the full tab list.
+
+        A number larger than the tab count is ignored. The number 0 activates the 10th
+        tab when there are at least ten tabs. With fewer than ten tabs it resolves to
+        the last tab, through negative indexing.
+
+        Args:
+            tab_number (int): The 1-based tab position.
+        """
+        count = len(self.tabs)
+        if not count or tab_number > count:
+            return
+        index = 9 if tab_number == 0 and count >= 10 else tab_number - 1
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses for navigation.
+
+        Every key event is marked handled, and propagation is not stopped, so
+        application-level bindings still receive keys. With no tabs, nothing else
+        happens.
+
+        Escape clears focus. Right and left move to the next and previous tab, wrapping
+        at either end. The digits 1 to 9 activate the tab at that position, and 0
+        follows the rule in ``activate_tab_by_number``. When
+        ``search_by_first_character`` is true, any other single character activates the
+        next tab whose label starts with it.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1 and key.isprintable():
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
