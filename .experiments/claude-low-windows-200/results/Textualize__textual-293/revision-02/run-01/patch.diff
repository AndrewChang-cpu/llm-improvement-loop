+
+    assert isinstance(item, Text)
+    first_click, second_click = item.spans[-2], item.spans[-1]
+    assert (first_click.start, first_click.end) == (0, 3)
+    assert first_click.style.meta == {"@click": "range_clicked('first')"}
+    assert (second_click.start, second_click.end) == (3, 6)
+    assert second_click.style.meta == {"@click": "range_clicked('second')"}
