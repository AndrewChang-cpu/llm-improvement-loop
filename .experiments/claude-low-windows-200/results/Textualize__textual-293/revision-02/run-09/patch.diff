+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+
+
+def test_tab_explicit_name():
+    assert Tab("Home", "h").name == "h"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("A", "x") == Tab("A", "x")
+    assert Tab("A", "x") != Tab("A", "y")
+    assert Tab("A", "x") != Tab("B", "x")
+
+
+def test_tab_text_form_is_label():
+    assert str(Tab("A", "x")) == "A"
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+
+
+def test_find_tab_by_name_missing_returns_zero():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+    assert tabs._bar_position == 0.0
+
+
+def test_initial_active_tab_given_name():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_keeps_name_and_index_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="Z")
+    assert tabs._active_tab_name == "Z"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name == ""
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_activate_tab_by_number():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 4)])
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "2"
+    tabs.activate_tab_by_number(0)  # Fewer than ten tabs: last tab
+    assert tabs._active_tab_name == "3"
+    tabs.activate_tab_by_number(7)  # Beyond the tab count: ignored
+    assert tabs._active_tab_name == "3"
+
+
+def test_activate_tab_by_number_zero_is_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_other_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    tabs.action_range_clicked("B")
+    assert tabs._active_tab_name == "B"
+
+
+def test_displayed_tabs_collapse_duplicates():
+    tabs = Tabs([Tab("First", "x"), Tab("B", "y"), Tab("Last", "x")])
+    displayed = tabs.render().displayed_tabs()
+    assert displayed == [Tab("Last", "x"), Tab("B", "y")]
+
+
+def test_render_no_tabs_draws_only_underline():
+    output = render(Tabs([]).render())
+    lines = output.split("\n")
+    assert len(lines) == 2
+    assert lines[0] == ""
+    assert "━" * 100 in lines[1]
+    assert "\x1b[" in lines[1]
+
+
+def test_render_labels_and_underline_rows():
+    output = render(Tabs([Tab("One"), Tab("Two")], active_tab="One").render())
+    label_row, underline_row = output.split("\n")
+    assert "One" in label_row
+    assert "Two" in label_row
+    assert "━" in underline_row
+
+
+def test_inactive_tab_carries_click_action():
+    console = Console(width=100, color_system="truecolor")
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="One")
+    segments = list(console.render(tabs.render(), console.options))
+    metas = [segment.style.meta for segment in segments if segment.style]
+    assert {"@click": "range_clicked('Two')"} in metas
+    assert {"@click": "range_clicked('One')"} not in metas
