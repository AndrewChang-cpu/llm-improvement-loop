+    def get_style(self, style, *, default=None):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+class _OptionsDouble:
+    max_width = 10
+
+
+def test_clickable_ranges_add_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(_ConsoleDouble(), _OptionsDouble()))
+
+    assert len(items) == 1
+    text = items[0]
+    assert isinstance(text, Text)
+    first, second = text.spans[-2], text.spans[-1]
+    assert (first.start, first.end) == (0, 3)
+    assert first.style.meta == {"@click": "range_clicked('first')"}
+    assert (second.start, second.end) == (3, 6)
+    assert second.style.meta == {"@click": "range_clicked('second')"}
+
+
+def test_zero_width_path_attaches_no_click_spans():
+    bar = UnderlineBar(
+        highlight_range=(0, 0),
+        clickable_ranges={"only": (0, 3)},
+        width=6,
+    )
+    items = list(bar.__rich_console__(_ConsoleDouble(), _OptionsDouble()))
+
+    assert len(items) == 1
+    assert all("@click" not in span.style.meta for span in items[0].spans)
