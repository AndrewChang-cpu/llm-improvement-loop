index 0000000..54c67b5
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,427 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Iterator, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A labelled tab that can be selected in a Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A flexible or fixed span along the tab row (see layout_resolve)."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+@dataclass
+class _Span:
+    """Column layout of one displayed tab."""
+
+    tab: Tab
+    left: int
+    label_size: int
+    right: int
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list. Duplicate names are shown once.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): Fractional index of the bar into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int, optional): Fixed padding size per side, or ``None`` to
+            auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def displayed_tabs(self) -> list[Tab]:
+        """Compute the displayed tabs.
+
+        There is one per name, at the name's first position, with the last label.
+        """
+        labels: dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return [Tab(label, name) for name, label in labels.items()]
+
+    def _measure(self, width: int) -> list[_Span]:
+        """Lay out the displayed tabs across the width."""
+        displayed = self.displayed_tabs()
+        if not displayed:
+            return []
+        padding = (
+            self.tab_padding
+            if self.tab_padding and self.tab_padding > 0
+            else None
+        )
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=padding))
+        sizes = [int(size) for size in layout_resolve(width, edges)]
+
+        spans: list[_Span] = []
+        cursor = 0
+        for index, tab in enumerate(displayed):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+            spans.append(
+                _Span(
+                    tab=tab,
+                    left=left,
+                    label_size=label_size,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(cursor, span_end),
+                )
+            )
+            cursor = span_end
+        return spans
+
+    def _highlight_range(self, spans: list[_Span]) -> tuple[float, float]:
+        """Interpolate the highlight between the floor index and the next index."""
+        count = len(spans)
+        if count == 0:
+            return (0.0, 0.0)
+        index = min(max(int(math.floor(self.bar_position)), 0), count - 1)
+        fraction = min(max(self.bar_position - index, 0.0), 1.0)
+        current = spans[index].label_range
+        following = spans[(index + 1) % count].label_range
+        start = current[0] + (following[0] - current[0]) * fraction
+        end = current[1] + (following[1] - current[1]) * fraction
+        return (start, end)
+
+    def _label_row(
+        self, console: Console, spans: list[_Span]
+    ) -> Iterator[RenderableType]:
+        """Yield one text run per displayed tab's padded span."""
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        for span in spans:
+            tab = span.tab
+            is_active = tab.name == self.active_tab_name
+            label_padding = span.label_size - cell_len(tab.label)
+            value = (
+                " " * span.left
+                + tab.label
+                + " " * label_padding
+                + " " * span.right
+            )
+            if is_active:
+                text = Text(
+                    value, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+                yield text
+            else:
+                text = Text(
+                    value, style=inactive_style, end="", no_wrap=True, overflow="crop"
+                )
+                text.apply_meta({"@click": f"range_clicked({tab.name!r})"})
+                yield Opacity(text, opacity=self.inactive_text_opacity)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._measure(width)
+
+        yield from self._label_row(console, spans)
+        # The label row and the underline row are always separated by a line break
+        yield Segment.line()
+
+        clickable_ranges = {
+            span.tab.name: span.selection_range for span in spans
+        }
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected with the keyboard or the mouse. Selection is by tab name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. An unknown name is accepted and
+            puts the bar at index 0.
+        active_tab_style (StyleType, optional): Style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline
+            bar. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to inactive tab
+            labels, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration in seconds of the bar animation.
+            Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            bar animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            ``None`` or ``0`` auto-fits the padding to the widget width. Defaults to
+            ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with it. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    can_focus = True
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self._tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self._tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self._tabs[0].name
+
+        # Set the bar position first so the watcher's animation starts from it
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str) -> int:
+        """Index of a name among the displayed tabs, or 0 when absent.
+
+        With unique names this equals find_tab_by_name. With duplicates it counts
+        each name once, so the bar sits under the displayed tab.
+        """
+        names = list(dict.fromkeys(tab.name for tab in self._tabs))
+        return names.index(tab_name) if tab_name in names else 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name in the full tab list.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self._tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the bar to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self._tabs[(index + 1) % len(self._tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self._tabs[(index - 1) % len(self._tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The comparison is case-insensitive. The search wraps and never selects the
+        active tab. If no other tab matches, the active tab does not change.
+
+        Args:
+            char (str): The character to match against the start of each label.
+        """
+        count = len(self._tabs)
+        if not count:
+            return
+        start = self.find_tab_by_name(self._active_tab_name)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self._tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        The number 0 activates the 10th tab when there are at least ten tabs.
+        Otherwise it resolves to the last tab. Numbers beyond the tab count are ignored.
+
+        Args:
+            tab_number (int): The tab number to activate.
+        """
+        if tab_number == 0:
+            index = 9 if len(self._tabs) >= 10 else -1
+        else:
+            index = tab_number - 1
+        if not -len(self._tabs) <= index < len(self._tabs):
+            return
+        self._active_tab_name = self._tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. Invoked by a click on its span.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget receives key events.
+
+        With no tabs, nothing else happens. Otherwise:
+
+        - Escape clears focus.
+        - Right and left move to the next and previous tab, wrapping.
+        - Digits 1 to 9 activate the tab at that position; 0 activates the 10th tab
+          (or the last tab when there are fewer than ten).
+        - Other single characters activate the next tab whose label starts with the
+          character, when ``search_by_first_character`` is true.
+
+        Every key event is marked handled without stopping its propagation.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self._tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
