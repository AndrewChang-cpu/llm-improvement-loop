diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..c72563d
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,451 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import NamedTuple, Optional
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab item with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _TabCells(NamedTuple):
+    """The cell layout of one displayed tab."""
+
+    name: str
+    label: str
+    left_pad: int
+    right_pad: int
+    selection_range: tuple[int, int]
+    label_range: tuple[int, int]
+
+
+@dataclass
+class _TabEdge:
+    """An edge description for the layout resolver."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The displayed tabs, with unique names.
+        active_tab_name (str): The name of the active tab, or an empty string.
+        bar_position (float): Fractional index into ``tabs`` that places the underline.
+        active_tab_style (StyleType): The style of the active tab's padded span.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (StyleType): The style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int, optional): The fixed cell size of each padding edge, or
+            ``None`` (or zero) to auto-fit the padding.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _TabEdge:
+        if self.tab_padding:
+            return _TabEdge(size=self.tab_padding)
+        return _TabEdge()
+
+    def _layout(self, width: int) -> list[_TabCells]:
+        """Compute the cell layout of each displayed tab.
+
+        Args:
+            width (int): The width available to the label row.
+
+        Returns:
+            list[_TabCells]: The cell layout of each tab, in display order.
+        """
+        label_widths = [cell_len(tab.label) for tab in self.tabs]
+        edges: list[_TabEdge] = []
+        for label_width in label_widths:
+            edges.append(self._padding_edge())
+            if label_width:
+                edges.append(_TabEdge(size=label_width))
+            edges.append(self._padding_edge())
+        resolved = iter(layout_resolve(width, edges))
+
+        cells: list[_TabCells] = []
+        position = 0
+        for tab, label_width in zip(self.tabs, label_widths):
+            left_pad = next(resolved)
+            if label_width:
+                next(resolved)
+            right_pad = next(resolved)
+            label_start = position + left_pad
+            selection_end = label_start + label_width + right_pad
+            cells.append(
+                _TabCells(
+                    name=tab.name,
+                    label=tab.label,
+                    left_pad=left_pad,
+                    right_pad=right_pad,
+                    selection_range=(position, selection_end),
+                    label_range=(label_start, label_start + label_width),
+                )
+            )
+            position = selection_end
+        return cells
+
+    def _bar_highlight(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (list[tuple[int, int]]): The label range of each displayed tab.
+
+        Returns:
+            tuple[float, float]: The highlight range, or ``(0, 0)`` with no tabs.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = min(int(position), count - 1)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_a, end_a = label_ranges[index]
+        start_b, end_b = label_ranges[next_index]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        cells = self._layout(width)
+
+        for cell in cells:
+            padded = f"{' ' * cell.left_pad}{cell.label}{' ' * cell.right_pad}"
+            if cell.name == self.active_tab_name:
+                # The active tab carries no click action.
+                tab_style = console.get_style(self.active_tab_style)
+                yield Text(
+                    padded, style=tab_style, no_wrap=True, overflow="crop", end=""
+                )
+            else:
+                tab_style = console.get_style(self.inactive_tab_style) + Style(
+                    meta={"@click": f"range_clicked({cell.name!r})"}
+                )
+                piece = Text(
+                    padded, style=tab_style, no_wrap=True, overflow="crop", end=""
+                )
+                yield Opacity(piece, opacity=self.inactive_text_opacity)
+
+        # Line break separating the label row from the underline row.
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._bar_highlight(
+                [cell.label_range for cell in cells]
+            ),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={
+                cell.name: cell.selection_range for cell in cells
+            },
+            width=width,
+        )
+        yield bar
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected by keyboard (left/right, digits, and first-character search)
+    or by mouse click. Each tab is identified by its name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the name of the first tab. A name that matches no tab is kept, and the bar
+            then sits at index 0.
+        active_tab_style (StyleType, optional): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): The style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): The style of the rest of the
+            underline. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): The blend ratio applied to inactive
+            tabs, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): The duration in seconds of the underline
+            animation. Defaults to 0.3.
+        animation_function (str, optional): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed cell count of the padding on each side of
+            a label, or ``None`` to auto-fit the padding. Zero is treated as ``None``.
+            Defaults to ``None``.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label begins with that character. Defaults
+            to True.
+        name (str, optional): The name of the widget. Defaults to None.
+        id (str, optional): The ID of the widget. Defaults to None.
+    """
+
+    can_focus = True
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        super().__init__(name=name, id=id)
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+
+        # Set the bar position before the active tab so the initial watcher call
+        # does not animate the bar from a stale position.
+        self._bar_position = float(self._bar_index_for(initial_name))
+        self._active_tab_name = initial_name
+
+    def _get_displayed_tabs(self) -> list[Tab]:
+        """Compute the displayed tabs: one per distinct name, in first-occurrence order,
+        labelled by the last tab with that name."""
+        labels: dict[str, str] = {}
+        for tab in self.tabs:
+            labels[tab.name] = tab.label
+        return [Tab(label, name) for name, label in labels.items()]
+
+    def _bar_index_for(self, tab_name: str) -> int:
+        """Index of a name within the displayed tabs, or 0 if it is not present."""
+        for index, tab in enumerate(self._get_displayed_tabs()):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with the given name.
+
+        Args:
+            tab_name (str): The name of the tab to find.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list, or 0
+                if no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        next_index = (index + 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[next_index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        previous_index = (index - 1) % len(self.tabs)
+        self._active_tab_name = self.tabs[previous_index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label begins with a character.
+
+        The search starts after the active tab.
+
+        The search wraps, is case-insensitive, and never selects the active tab. If no
+        other tab matches, the active tab is unchanged.
+
+        Args:
+            char (str): The character to match at the start of a tab label.
+        """
+        if not self.tabs:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self._active_tab_name)
+        search = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(search):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        The number 0 activates the 10th tab when there are at least ten tabs. With fewer
+        than ten tabs, 0 activates the last tab. Numbers beyond the tab count are
+        ignored.
+
+        Args:
+            tab_number (int): The 1-based tab number.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else count - 1
+        elif 1 <= tab_number <= count:
+            index = tab_number - 1
+        else:
+            return
+        self._active_tab_name = self.tabs[index].name
+
+    def watch__active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the underline to the displayed index of the new active tab."""
+        self.animate(
+            "_bar_position",
+            float(self._bar_index_for(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with the given name the active tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for tab navigation.
+
+        With no tabs, the key is only marked handled. Otherwise:
+
+        - Escape clears focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - Digits 1 to 9 activate the tab at that 1-based position. 0 activates the 10th
+          tab, or the last tab when there are fewer than ten. Larger numbers are
+          ignored.
+        - When ``search_by_first_character`` is true, another single-character key
+          activates the next tab whose label begins with that character.
+
+        Every key is marked handled, and propagation is not stopped, so application
+        bindings still receive keys.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self._get_displayed_tabs(),
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
