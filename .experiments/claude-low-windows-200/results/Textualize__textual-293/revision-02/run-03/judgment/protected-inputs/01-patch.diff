+import asyncio
+import io
+import re
+
+from rich.console import Console
+
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+from tests.utilities.render import render
+
+ANSI_RE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(text: str) -> str:
+    return ANSI_RE.sub("", text)
+
+
+class KeyDouble:
+    def __init__(self, key: str) -> None:
+        self.key = key
+        self.handled = False
+
+    def prevent_default(self, prevent: bool = True):
+        self.handled = prevent
+        return self
+
+
+def press(tabs: Tabs, key: str) -> KeyDouble:
+    event = KeyDouble(key)
+    asyncio.run(tabs.on_key(event))
+    return event
+
+
+def make_renderable(tabs, tab_padding=None, active_tab_name="", bar_position=0.0):
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active_tab_name,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home") != Tab("Home", "other")
+    assert "label='Home'" in repr(Tab("Home", "home"))
+    assert "name='home'" in repr(Tab("Home", "home"))
+
+
+def test_find_tab_by_name_returns_first_index_for_duplicates():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    assert tabs._active_tab_name == "A"
+
+
+def test_initial_active_tab_is_respected():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="B")
+    assert tabs._active_tab_name == "B"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_keeps_name_and_bar_at_zero():
+    tabs = Tabs([Tab("A"), Tab("B")], active_tab="nope")
+    assert tabs._active_tab_name == "nope"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs._active_tab_name == ""
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "C"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "A"
+
+
+def test_right_and_left_keys_cycle_and_are_handled():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    event = press(tabs, "right")
+    assert tabs._active_tab_name == "B"
+    assert event.handled
+    press(tabs, "left")
+    assert tabs._active_tab_name == "A"
+
+
+def test_empty_tabs_keys_are_handled_without_error():
+    tabs = Tabs([])
+    event = press(tabs, "right")
+    assert event.handled
+    press(tabs, "1")
+    press(tabs, "a")
+
+
+def test_digit_activates_by_position():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    press(tabs, "3")
+    assert tabs._active_tab_name == "C"
+    press(tabs, "7")  # Beyond the tab count is ignored.
+    assert tabs._active_tab_name == "C"
+
+
+def test_zero_resolves_to_last_tab_with_fewer_than_ten():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    press(tabs, "0")
+    assert tabs._active_tab_name == "C"
+
+
+def test_zero_resolves_to_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(index)) for index in range(12)])
+    press(tabs, "0")
+    assert tabs._active_tab_name == "9"
+
+
+def test_first_character_search_wraps_and_skips_active():
+    tabs = Tabs([Tab("Apple"), Tab("Avocado"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_no_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")])
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_character_search_disabled():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], search_by_first_character=False)
+    press(tabs, "b")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = Tabs([Tab("A"), Tab("B")])
+    asyncio.run(tabs.action_range_clicked("B"))
+    assert tabs._active_tab_name == "B"
+
+
+def test_duplicate_names_display_once_with_last_label():
+    tabs = Tabs([Tab("First", "x"), Tab("Other", "y"), Tab("Last", "x")])
+    displayed = tabs._get_displayed_tabs()
+    assert [(tab.label, tab.name) for tab in displayed] == [
+        ("Last", "x"),
+        ("Other", "y"),
+    ]
+
+
+def test_no_tabs_row_layout_is_empty_then_full_bar():
+    output = plain(render(make_renderable([])))
+    assert output == "\n" + "━" * 100
+
+
+def test_label_row_with_fixed_padding():
+    renderable = make_renderable([Tab("A"), Tab("B")], tab_padding=1)
+    first_line = plain(render(renderable)).split("\n")[0]
+    assert first_line == " A  B "
+
+
+def test_inactive_padded_span_carries_click_and_is_dimmed():
+    renderable = make_renderable(
+        [Tab("A"), Tab("B")], tab_padding=1, active_tab_name="A"
+    )
+    console = Console(width=20, color_system="truecolor", file=io.StringIO())
+    segments = list(console.render(renderable, console.options))
+
+    inactive = [segment for segment in segments if segment.text == " B "]
+    assert len(inactive) == 1
+    assert inactive[0].style.meta == {"@click": "range_clicked('B')"}
+
+    active = [segment for segment in segments if segment.text == " A "]
+    assert len(active) == 1
+    assert not active[0].style.meta
