+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application that shows a Tabs widget mounted directly on the App."""
+
+    def on_mount(self) -> None:
+        """Mount example tab bars."""
+        self.mount(
+            Tabs(
+                [
+                    Tab("Home"),
+                    Tab("Music", "music"),
+                    Tab("Videos", "videos"),
+                    Tab("Photos"),
+                    Tab("Settings"),
+                ],
+                active_tab="music",
+            ),
+            Tabs([Tab("Only one")]),
+            Tabs([]),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
