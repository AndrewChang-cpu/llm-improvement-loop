+        width=6,
+    )
+    options = SimpleNamespace(max_width=6)
+    item = next(iter(bar.__rich_console__(_FakeConsole(), options)))
+
+    assert isinstance(item, Text)
+    first_click, second_click = item.spans[-2:]
+    assert (first_click.start, first_click.end) == (0, 2)
+    assert first_click.style.meta == {"@click": "range_clicked('home')"}
+    assert (second_click.start, second_click.end) == (2, 5)
+    assert second_click.style.meta == {"@click": "range_clicked('about')"}
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
