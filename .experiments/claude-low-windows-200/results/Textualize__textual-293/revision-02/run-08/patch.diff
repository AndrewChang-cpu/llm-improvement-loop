diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..b2cb15e
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,456 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from math import floor
+from typing import Optional, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+@dataclass
+class Tab:
+    """A tab for the Tabs widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    label: str
+    name: Optional[str] = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A flexible or fixed cell span used by the layout resolver."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+@dataclass
+class _TabSpan:
+    """Measured position of one displayed tab.
+
+    Args:
+        tab (Tab): The displayed tab.
+        label_range (tuple[int, int]): Columns occupied by the label text.
+        selection_range (tuple[int, int]): Columns of the padded span.
+        text (str): The padded text of the span.
+    """
+
+    tab: Tab
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+    text: str
+
+
+def _displayed_names(tabs: Sequence[Tab]) -> list[str]:
+    """Return distinct tab names in order of first appearance."""
+    return list(dict.fromkeys(tab.name for tab in tabs))
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the displayed tabs.
+
+    Each name appears once, at the position of its first tab, with the label of
+    its last tab.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        assert tab.name is not None
+        labels[tab.name] = tab.label
+    return [Tab(label=label, name=name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renderable for the label row and underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): Fractional index of the underline into the displayed tabs.
+        active_tab_style (StyleType): Style of the active tab.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int, optional): Fixed padding cell count, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: Optional[int],
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _measure(self, width: int) -> list[_TabSpan]:
+        """Lay out the displayed tabs across a width in cells.
+
+        Args:
+            width (int): Available width in cells.
+
+        Returns:
+            list[_TabSpan]: One span per displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        padding = self.tab_padding or None
+        edges: list[_Edge] = []
+        for tab in displayed:
+            edges.append(_Edge(size=padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=padding))
+        sizes = layout_resolve(width, edges) if edges else []
+
+        spans: list[_TabSpan] = []
+        x = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = x + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            label_text = tab.label + " " * max(0, label_width - cell_len(tab.label))
+            spans.append(
+                _TabSpan(
+                    tab=tab,
+                    label_range=(label_start, label_end),
+                    selection_range=(x, selection_end),
+                    text=" " * left + label_text + " " * right,
+                )
+            )
+            x = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position.
+
+        Args:
+            spans (list[_TabSpan]): The measured displayed tabs.
+
+        Returns:
+            tuple[float, float]: The highlighted start and end columns.
+        """
+        count = len(spans)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = min(int(floor(position)), count - 1)
+        fraction = position - index
+        next_index = (index + 1) % count
+        current = spans[index].label_range
+        following = spans[next_index].label_range
+        start = current[0] + (following[0] - current[0]) * fraction
+        end = current[1] + (following[1] - current[1]) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._measure(width)
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for span in spans:
+            name = span.tab.name
+            if name == self.active_tab_name:
+                text = Text(
+                    span.text, style=active_style, no_wrap=True, overflow="crop", end=""
+                )
+                yield from console.render(text, options)
+            else:
+                text = Text(
+                    span.text,
+                    style=inactive_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                text.apply_meta({"@click": f"range_clicked({name!r})"})
+                faded = Opacity(text, opacity=self.inactive_text_opacity)
+                yield from console.render(faded, options)
+
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={
+                span.tab.name: span.selection_range for span in spans
+            },
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal tab bar with an animated underline.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab's name. An unknown name is kept, and the bar sits at index 0.
+        active_tab_style (StyleType): Style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults
+            to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive tab text, from
+            0 (background) to 1 (full color). Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation, in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed cell count for each side of a tab label, or
+            ``None`` (or zero) to auto-fit the padding to the widget width. Defaults to
+            ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates the
+            next tab whose label starts with it. Defaults to True.
+        name (str, optional): The name of the widget. Defaults to None.
+        id (str, optional): The ID of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: Optional[str] = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: Optional[int] = None,
+        search_by_first_character: bool = True,
+        name: Optional[str] = None,
+        id: Optional[str] = None,
+    ) -> None:
+        super().__init__(name=name, id=id)
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name or ""
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a name.
+
+        Args:
+            tab_name (str): The tab name to look up.
+
+        Returns:
+            int: The index in the full tab list, or 0 if no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def _displayed_index(self, tab_name: str) -> int:
+        """Index of a name among the displayed tabs, or 0 if it is not displayed."""
+        names = _displayed_names(self.tabs)
+        return names.index(tab_name) if tab_name in names else 0
+
+    def _step_active_tab(self, direction: int) -> None:
+        """Move the active tab by one in the full list, wrapping at either end.
+
+        Tabs that share the active name are skipped so the selection always changes.
+
+        Args:
+            direction (int): 1 for next, -1 for previous.
+        """
+        count = len(self.tabs)
+        active = self._active_tab_name
+        index = self.find_tab_by_name(active)
+        for offset in range(1, count + 1):
+            candidate = self.tabs[(index + direction * offset) % count]
+            if candidate.name != active:
+                self._active_tab_name = candidate.name or ""
+                return
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full list active, wrapping at the end."""
+        self._step_active_tab(1)
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full list active, wrapping at the start."""
+        self._step_active_tab(-1)
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, never selects the active tab,
+        and compares case-insensitively. The active tab is unchanged if nothing
+        matches.
+
+        Args:
+            char (str): The character to search for.
+        """
+        if not char or not self.tabs:
+            return
+        needle = char.lower()
+        active = self._active_tab_name
+        count = len(self.tabs)
+        index = self.find_tab_by_name(active)
+        for offset in range(1, count):
+            candidate = self.tabs[(index + offset) % count]
+            if candidate.name == active:
+                continue
+            if candidate.label.lower().startswith(needle):
+                self._active_tab_name = candidate.name or ""
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        Zero activates the 10th tab when there are at least ten tabs. With fewer
+        than ten tabs, zero resolves to the last tab. Numbers above the tab count
+        are ignored.
+
+        Args:
+            tab_number (int): The tab position.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        elif 1 <= tab_number <= count:
+            index = tab_number - 1
+        else:
+            return
+        self._active_tab_name = self.tabs[index].name or ""
+
+    async def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Invoked by clicks on the tab or underline.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the underline to the newly active tab.
+
+        Args:
+            active_tab_name (str): The new active tab name.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for the tab bar.
+
+        Every key event is marked handled, and propagation is not stopped, so
+        application bindings still receive keys. With no tabs, nothing else happens.
+        Otherwise, Escape clears focus; Right and Left move to the next or previous
+        tab with wrap-around; the digits 1 through 9 activate tabs by position, and 0
+        activates the 10th tab (or the last tab when there are fewer than ten); other
+        single characters activate the next tab whose label starts with that character
+        when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
