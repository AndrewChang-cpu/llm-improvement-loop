@@ -0,0 +1,105 @@
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable, _displayed_tabs
+
+
+def _renderable(tabs, width_padding=None, active="") -> TabsRenderable:
+    return TabsRenderable(
+        tabs,
+        active_tab_name=active,
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=width_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_and_repr():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "home") != Tab("Home", "Home")
+    assert "label='Home'" in repr(Tab("Home", "home"))
+    assert "name='home'" in repr(Tab("Home", "home"))
+
+
+def test_displayed_tabs_keep_first_position_and_last_label():
+    tabs = [Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")]
+    displayed = _displayed_tabs(tabs)
+    assert [(tab.name, tab.label) for tab in displayed] == [
+        ("a", "Three"),
+        ("b", "Two"),
+    ]
+
+
+def test_find_tab_by_name_returns_first_duplicate():
+    tabs = Tabs([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    assert tabs.find_tab_by_name("a") == 0
+    assert tabs.find_tab_by_name("b") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_and_honors_argument():
+    assert Tabs([Tab("One"), Tab("Two")])._active_tab_name == "One"
+    assert Tabs([Tab("One"), Tab("Two")], active_tab="Two")._active_tab_name == "Two"
+    assert Tabs([])._active_tab_name == ""
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "Two"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "One"
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "Two"
+
+
+def test_digit_zero_resolves_to_last_tab_with_fewer_than_ten():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_tab_by_number(9)
+    assert tabs._active_tab_name == "Three"
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "Two"
+
+
+def test_first_char_search_is_case_insensitive_and_skips_active():
+    tabs = Tabs([Tab("Apple"), Tab("avocado"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "avocado"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_first_char_search_without_match_keeps_active():
+    tabs = Tabs([Tab("Apple"), Tab("Banana")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "Apple"
+
+
+def test_label_and_selection_ranges_with_fixed_padding():
+    renderable = _renderable([Tab("Home"), Tab("About")], width_padding=1)
+    spans = renderable._measure(20)
+    assert [span.label_range for span in spans] == [(1, 5), (7, 12)]
+    assert [span.selection_range for span in spans] == [(0, 6), (6, 13)]
+    assert spans[1].text == " About "
+
+
+def test_duplicate_names_are_displayed_once():
+    renderable = _renderable([Tab("One", "a"), Tab("Two", "b"), Tab("Three", "a")])
+    spans = renderable._measure(40)
+    assert [span.tab.label for span in spans] == ["Three", "Two"]
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    output = render(_renderable([]))
+    assert output.startswith("\n")
+    assert output.count("━") == 100
