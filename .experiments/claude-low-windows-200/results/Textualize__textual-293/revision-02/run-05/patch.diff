diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..d2f252b
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,190 @@
+import asyncio
+import re
+
+from tests.utilities.render import render
+from textual import events
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable, _displayed_tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def strip_ansi(text: str) -> str:
+    return ANSI.sub("", text)
+
+
+def make_tabs(*tabs: Tab, active_tab=None) -> Tabs:
+    return Tabs(list(tabs), active_tab=active_tab)
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home", "h") == Tab("Home", "h")
+    assert Tab("Home", "h") != Tab("Home", "other")
+    assert Tab("Home") != Tab("Docs")
+
+
+def test_tab_repr_shows_both_fields():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_displayed_tabs_keep_first_position_and_last_label():
+    tabs = [Tab("One", "x"), Tab("Two", "y"), Tab("Three", "x")]
+    displayed = _displayed_tabs(tabs)
+    assert [(tab.label, tab.name) for tab in displayed] == [
+        ("Three", "x"),
+        ("Two", "y"),
+    ]
+
+
+def test_find_tab_by_name_returns_first_index():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "dup"), Tab("C", "dup"))
+    assert tabs.find_tab_by_name("dup") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_initial_active_tab_defaults_to_first_tab():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"))
+    assert tabs._active_tab_name == "a"
+
+
+def test_initial_active_tab_uses_given_name():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"), active_tab="b")
+    assert tabs._active_tab_name == "b"
+    assert tabs._bar_position == 1.0
+
+
+def test_unknown_active_tab_is_kept_and_bar_at_zero():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"), active_tab="zzz")
+    assert tabs._active_tab_name == "zzz"
+    assert tabs._bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = make_tabs()
+    assert tabs._active_tab_name == ""
+
+
+def test_next_and_previous_wrap():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"), Tab("C", "c"))
+    tabs.activate_previous_tab()
+    assert tabs._active_tab_name == "c"
+    tabs.activate_next_tab()
+    assert tabs._active_tab_name == "a"
+
+
+def test_number_keys_activate_by_position_and_ignore_out_of_range():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"), Tab("C", "c"))
+    tabs.activate_tab_by_number(2)
+    assert tabs._active_tab_name == "b"
+    tabs.activate_tab_by_number(7)
+    assert tabs._active_tab_name == "b"
+
+
+def test_zero_resolves_to_last_tab_with_fewer_than_ten():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"), Tab("C", "c"))
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "c"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more():
+    tabs = make_tabs(*[Tab(str(i), f"t{i}") for i in range(1, 12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs._active_tab_name == "t10"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = make_tabs(Tab("Apple", "a"), Tab("Banana", "b"), Tab("avocado", "v"))
+    tabs.activate_tab_by_first_char("A")
+    assert tabs._active_tab_name == "v"
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_first_character_search_never_selects_active_tab():
+    tabs = make_tabs(Tab("Apple", "a"), Tab("Banana", "b"))
+    tabs.activate_tab_by_first_char("a")
+    assert tabs._active_tab_name == "a"
+
+
+def test_first_character_search_without_match_keeps_active():
+    tabs = make_tabs(Tab("Apple", "a"), Tab("Banana", "b"))
+    tabs.activate_tab_by_first_char("z")
+    assert tabs._active_tab_name == "a"
+
+
+def test_on_key_marks_event_handled_and_handles_arrows():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"))
+    event = events.Key(None, "right")
+    asyncio.run(tabs.on_key(event))
+    assert event._no_default_action
+    assert not event._stop_propagation
+    assert tabs._active_tab_name == "b"
+
+
+def test_on_key_with_no_tabs_does_nothing():
+    tabs = make_tabs()
+    event = events.Key(None, "right")
+    asyncio.run(tabs.on_key(event))
+    assert event._no_default_action
+    assert tabs._active_tab_name == ""
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = make_tabs(Tab("A", "a"), Tab("B", "b"))
+    tabs.action_range_clicked("b")
+    assert tabs._active_tab_name == "b"
+
+
+def test_range_computation_with_flexible_padding():
+    renderable = TabsRenderable(
+        tabs=[Tab("Home"), Tab("Docs")],
+        active_tab_name="Home",
+        bar_position=0,
+        active_tab_style="",
+        active_bar_style="",
+        inactive_tab_style="",
+        inactive_bar_style="",
+        inactive_text_opacity=0.5,
+    )
+    label_ranges, selection_ranges = renderable.compute_ranges(20)
+    assert label_ranges == {"Home": (3, 7), "Docs": (13, 17)}
+    assert selection_ranges == {"Home": (0, 10), "Docs": (10, 20)}
+
+
+def test_no_tabs_renders_empty_label_row_and_full_underline():
+    renderable = TabsRenderable(
+        tabs=[],
+        active_tab_name="",
+        bar_position=0,
+        active_tab_style="",
+        active_bar_style="",
+        inactive_tab_style="",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+    )
+    rows = strip_ansi(render(renderable)).split("\n")
+    assert rows[0] == ""
+    assert rows[1] == "━" * 100
+
+
+def test_duplicate_names_render_once_with_last_label():
+    renderable = TabsRenderable(
+        tabs=[Tab("One", "x"), Tab("Two", "x"), Tab("Three", "y")],
+        active_tab_name="x",
+        bar_position=0,
+        active_tab_style="",
+        active_bar_style="",
+        inactive_tab_style="",
+        inactive_bar_style="",
+        inactive_text_opacity=0.5,
+    )
+    label_ranges, _ = renderable.compute_ranges(40)
+    assert set(label_ranges) == {"x", "y"}
+    row = strip_ansi(render(renderable)).split("\n")[0]
+    assert "Two" in row
+    assert "One" not in row
