diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..11b5226
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,449 @@
+from __future__ import annotations
+
+import math
+from typing import Iterable, NamedTuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import EdgeDescription, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: Iterable[Tab]) -> list[Tab]:
+    """Compute the displayed tabs: one per distinct name.
+
+    Each entry takes the position of the first tab with its name and the label
+    of the last tab with that name.
+
+    Args:
+        tabs (Iterable[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its original (first) position
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class _TabSpan(NamedTuple):
+    """Layout of one displayed tab."""
+
+    tab: Tab
+    left: int
+    label_width: int
+    right: int
+    label_range: tuple[int, int]
+    selection_range: tuple[int, int]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str): The name of the active tab, or an empty string.
+        bar_position (float): Fractional index into the full tab list that
+            places the underline.
+        active_tab_style (StyleType): The style of the active tab.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (StyleType): The style of inactive tabs.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs.
+        tab_padding (int, optional): Fixed padding size on each side of a label, or
+            ``None`` (or zero) to fit the padding automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None = None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(self, width: int) -> list[_TabSpan]:
+        """Compute the layout of every displayed tab for a given width.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            list[_TabSpan]: The layout of each displayed tab, in display order.
+        """
+        displayed = _displayed_tabs(self.tabs)
+        if not displayed:
+            return []
+
+        padding_size = (
+            self.tab_padding
+            if self.tab_padding is not None and self.tab_padding > 0
+            else None
+        )
+        edges: list[EdgeDescription] = []
+        for tab in displayed:
+            edges.append(EdgeDescription(size=padding_size))
+            edges.append(EdgeDescription(size=cell_len(tab.label)))
+            edges.append(EdgeDescription(size=padding_size))
+        sizes = layout_resolve(width, edges)
+
+        spans: list[_TabSpan] = []
+        position = 0
+        for index, tab in enumerate(displayed):
+            left, label_width, right = sizes[index * 3 : index * 3 + 3]
+            label_start = position + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(
+                    tab=tab,
+                    left=left,
+                    label_width=label_width,
+                    right=right,
+                    label_range=(label_start, label_end),
+                    selection_range=(position, selection_end),
+                )
+            )
+            position = selection_end
+        return spans
+
+    def compute_ranges(
+        self, width: int
+    ) -> tuple[dict[str, tuple[int, int]], dict[str, tuple[int, int]]]:
+        """Compute the label ranges and selection ranges, keyed by tab name.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            tuple[dict[str, tuple[int, int]], dict[str, tuple[int, int]]]: The label
+                ranges and the selection ranges. The end of each range is exclusive.
+        """
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        for span in self._layout(width):
+            label_ranges[span.tab.name] = span.label_range
+            selection_ranges[span.tab.name] = span.selection_range
+        return label_ranges, selection_ranges
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            spans (list[_TabSpan]): The layout of the displayed tabs.
+
+        Returns:
+            tuple[float, float]: The highlight range, or ``(0, 0)`` with no tabs.
+        """
+        count = len(self.tabs)
+        if not spans or count == 0:
+            return (0, 0)
+        label_ranges = {span.tab.name: span.label_range for span in spans}
+        position = min(max(self.bar_position, 0.0), count - 1)
+        index = min(int(math.floor(position)), count - 1)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start_range = label_ranges[self.tabs[index].name]
+        next_range = label_ranges[self.tabs[next_index].name]
+        start = start_range[0] + (next_range[0] - start_range[0]) * fraction
+        end = start_range[1] + (next_range[1] - start_range[1]) * fraction
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        spans = self._layout(width)
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for span in spans:
+            tab = span.tab
+            padding_needed = max(span.label_width - cell_len(tab.label), 0)
+            label_text = tab.label + " " * padding_needed
+            padded = " " * span.left + label_text + " " * span.right
+            if tab.name == self.active_tab_name:
+                text = Text(
+                    padded, style=active_style, end="", no_wrap=True, overflow="crop"
+                )
+                yield from console.render(text, options)
+            else:
+                click_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked({tab.name!r})"}
+                )
+                text = Text(
+                    padded, style=click_style, end="", no_wrap=True, overflow="crop"
+                )
+                yield from console.render(
+                    Opacity(text, opacity=self.inactive_text_opacity), options
+                )
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges={
+                span.tab.name: span.selection_range for span in spans
+            },
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal tab bar with an animated underline.
+
+    Tabs are identified by name. Select a tab with the keyboard or the mouse.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): The name of the initially active tab. If it is
+            ``None`` or empty, the first tab is active. Defaults to None.
+        active_tab_style (StyleType): The style of the active tab. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive tabs. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive tabs,
+            from 0 (background color) to 1 (full foreground color). Defaults to 0.5.
+        animation_duration (float): The duration of the underline animation, in
+            seconds. Defaults to 0.3.
+        animation_function (str): The name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): The fixed number of cells on each side of a
+            label, or ``None`` to fit the padding automatically. A value of zero is
+            treated the same as ``None``. Defaults to None.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The name to look for.
+
+        Returns:
+            int: The index of the first tab with that name in the full tab list, or 0
+                if no tab has it.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def watch__active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the underline to the newly active tab."""
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full tab list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full tab list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        Zero activates the 10th tab when there are at least ten tabs. With fewer,
+        zero resolves to the last tab. Numbers outside the tab count are ignored.
+
+        Args:
+            tab_number (int): The 1-based tab number.
+        """
+        count = len(self.tabs)
+        if tab_number == 0 and count >= 10:
+            index = 9
+        else:
+            index = tab_number - 1
+        if not -count <= index < count:
+            return
+        self._active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around the full tab list,
+        ignores the active tab, and compares case-insensitively. If no other tab
+        matches, the active tab does not change.
+
+        Args:
+            char (str): The character to search for.
+        """
+        count = len(self.tabs)
+        if not count or not char:
+            return
+        active_name = self._active_tab_name
+        start = self.find_tab_by_name(active_name)
+        needle = char.lower()
+        for offset in range(1, count):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == active_name:
+                continue
+            if tab.label.lower().startswith(needle):
+                self._active_tab_name = tab.name
+                return
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the tab with the given name the active tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        Every key event is marked handled, without stopping propagation.
+
+        - With no tabs, nothing else happens.
+        - Escape clears focus from the widget.
+        - Right and Left activate the next and previous tab, wrapping at either end.
+        - Digits 1 through 9 activate the tab at that position. 0 activates the
+          10th tab when there are at least ten tabs, otherwise the last tab. Digits
+          beyond the tab count are ignored.
+        - When ``search_by_first_character`` is true, any other single character
+          activates the next tab, after the active one, whose label starts with
+          that character (case-insensitive).
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
