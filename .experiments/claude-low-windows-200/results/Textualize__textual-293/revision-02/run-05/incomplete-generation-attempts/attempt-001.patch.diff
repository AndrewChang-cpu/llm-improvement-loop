+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
@@ -124,3 +127,30 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+class _ConsoleDouble:
+    def get_style(self, style):
+        return Style.parse(style) if isinstance(style, str) else style
+
+
+class _OptionsDouble:
+    max_width = 6
+
+
+def test_clickable_ranges_attach_click_spans_in_mapping_order():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        highlight_style="red",
+        background_style="green",
+        clickable_ranges={"first": (0, 3), "second": (3, 6)},
+        width=6,
+    )
+    item = next(iter(bar.__rich_console__(_ConsoleDouble(), _OptionsDouble())))
+
+    assert isinstance(item, Text)
+    first_span, second_span = item.spans[-2:]
+    assert (first_span.start, first_span.end) == (0, 3)
+    assert first_span.style.meta["@click"] == "range_clicked('first')"
+    assert (second_span.start, second_span.end) == (3, 6)
+    assert second_span.style.meta["@click"] == "range_clicked('second')"
