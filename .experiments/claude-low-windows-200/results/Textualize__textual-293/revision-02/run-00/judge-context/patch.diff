+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,401 @@
+from __future__ import annotations
+
+import math
+from typing import Iterable
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import EdgeSpec, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+DIGITS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _displayed_tabs(tabs: Iterable[Tab]) -> list[Tab]:
+    """Compute the displayed tabs: one per name, at its first position.
+
+    Each displayed tab takes the label of the last tab with its name.
+
+    Args:
+        tabs (Iterable[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The tabs to render.
+    """
+    # Re-assigning an existing key keeps its first position but updates the value
+    return list({tab.name: tab for tab in tabs}.values())
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The full tab list.
+        active_tab_name (str): The name of the active tab, or an empty string.
+        bar_position (float): Fractional index into the full tab list for the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int, optional): Fixed padding cells, or ``None`` to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        padding_size = (
+            self.tab_padding
+            if self.tab_padding and self.tab_padding > 0
+            else None
+        )
+
+        # Describe each tab as left padding, label (if any), right padding
+        edges: list[EdgeSpec] = []
+        for tab in displayed:
+            edges.append(EdgeSpec(size=padding_size))
+            if cell_len(tab.label):
+                edges.append(EdgeSpec(size=cell_len(tab.label)))
+            edges.append(EdgeSpec(size=padding_size))
+        sizes = iter(layout_resolve(width, edges))
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        cursor = 0
+        for tab in displayed:
+            left = next(sizes)
+            label_width = cell_len(tab.label)
+            if label_width:
+                next(sizes)
+            right = next(sizes)
+
+            padded_width = left + label_width + right
+            label_start = cursor + left
+            label_ranges[tab.name] = (label_start, label_start + label_width)
+            selection_ranges[tab.name] = (cursor, cursor + padded_width)
+
+            is_active = tab.name == self.active_tab_name
+            text = Text(
+                " " * left + tab.label + " " * right,
+                style=active_style if is_active else inactive_style,
+                end="",
+                no_wrap=True,
+                overflow="crop",
+            )
+            if is_active:
+                yield from console.render(text, options)
+            else:
+                text.stylize(
+                    Style(meta={"@click": f"range_clicked({tab.name!r})"})
+                )
+                yield from console.render(
+                    Opacity(text, opacity=self.inactive_text_opacity), options
+                )
+            cursor += padded_width
+
+        # A line break always separates the label row from the underline row
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the current bar position.
+
+        Args:
+            label_ranges (dict[str, tuple[int, int]]): Label ranges keyed by tab name.
+
+        Returns:
+            tuple[float, float]: The highlight range in cells.
+        """
+        count = len(self.tabs)
+        if not count:
+            return (0.0, 0.0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        floor_index = math.floor(position)
+        fraction = position - floor_index
+        next_index = (floor_index + 1) % count
+
+        start_a, end_a = label_ranges[self.tabs[floor_index].name]
+        start_b, end_b = label_ranges[self.tabs[next_index].name]
+        return (
+            start_a + (start_b - start_a) * fraction,
+            end_a + (end_b - end_a) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Args:
+        tabs (list[Tab]): The tabs to display. May be empty.
+        active_tab (str, optional): Name of the initially active tab.
+            Defaults to the first tab.
+        active_tab_style (StyleType): Style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio for inactive tab text,
+            from 0 to 1. Defaults to 0.5.
+        animation_duration (float): Duration of the bar animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the bar
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed padding cells on each side of a
+            label. Defaults to ``None``, which auto-fits the padding. A value
+            of zero is treated the same as ``None``.
+        search_by_first_character (bool): Whether unhandled character keys jump
+            to a tab whose label starts with that character. Defaults to True.
+        name (str, optional): The name of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+    ) -> None:
+        super().__init__(name=name)
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self._active_tab_name = initial_name
+        self._bar_position = float(self.find_tab_by_name(initial_name))
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab in the full tab list with a name.
+
+        Args:
+            tab_name (str): The tab name to look for.
+
+        Returns:
+            int: The index of the first matching tab, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab in the full list, wrapping at the end."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab in the full list, wrapping at the start."""
+        index = self.find_tab_by_name(self._active_tab_name)
+        self._active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab.
+
+        The search wraps, is case-insensitive, and never selects the active tab.
+
+        Args:
+            char (str): The character to match at the start of a label.
+        """
+        if not self.tabs or not char:
+            return
+        active_index = self.find_tab_by_name(self._active_tab_name)
+        count = len(self.tabs)
+        wanted = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(active_index + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.lower().startswith(wanted):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        The number 0 selects the 10th tab when there are at least ten tabs. Otherwise
+        it selects the last tab through negative indexing. Numbers beyond the tab
+        count are ignored.
+
+        Args:
+            tab_number (int): The 1-based tab number.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        if not -count <= index < count:
+            return
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab the active tab. Invoked by clicks on a tab.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for tab navigation.
+
+        With no tabs, the key is only marked handled. Otherwise, Escape clears focus,
+        Right and Left move to the next and previous tab with wrap-around, digit keys
+        activate a tab by position (0 is the 10th tab, or the last tab when there are
+        fewer than ten), and, when ``search_by_first_character`` is set, any other
+        single-character key activates the next tab whose label starts with it.
+        Every key is marked handled, but propagation is not stopped.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    def watch__active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the bar to the newly active tab.
+
+        Args:
+            active_tab_name (str): The name of the new active tab.
+        """
+        self.animate(
+            "_bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+
+__all__ = ["Tab", "Tabs"]
