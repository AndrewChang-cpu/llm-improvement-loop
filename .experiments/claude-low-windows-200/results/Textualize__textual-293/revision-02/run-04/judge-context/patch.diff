@@ -0,0 +1,65 @@
+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable, _displayed_tabs
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(renderable) -> list[str]:
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def make_renderable(tabs, active="", padding=1) -> TabsRenderable:
+    return TabsRenderable(
+        tabs=tabs,
+        active_tab_name=active,
+        bar_position=0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_equality_uses_label_and_name():
+    assert Tab("Home") == Tab("Home", "Home")
+    assert Tab("Home", "h") != Tab("Home")
+    assert Tab("Home") != Tab("Start")
+
+
+def test_tab_repr_shows_both_fields():
+    assert repr(Tab("Home", "h")) == "Tab(label='Home', name='h')"
+
+
+def test_displayed_tabs_dedupes_by_name_keeping_first_position_last_label():
+    tabs = [Tab("Alpha", "a"), Tab("Beta", "b"), Tab("Gamma", "a")]
+    displayed = _displayed_tabs(tabs)
+    assert [(tab.name, tab.label) for tab in displayed] == [("a", "Gamma"), ("b", "Beta")]
+
+
+def test_no_tabs_renders_empty_label_row_and_full_width_bar():
+    lines = plain(make_renderable([]))
+    assert lines == ["", "━" * 100]
+
+
+def test_duplicate_names_render_once_at_first_position_with_last_label():
+    tabs = [Tab("Alpha", "a"), Tab("Beta", "b"), Tab("Gamma", "a")]
+    label_row = plain(make_renderable(tabs, active="a", padding=1))[0]
+    assert label_row.startswith(" Gamma  Beta ")
+    assert "Alpha" not in label_row
+
+
+def test_find_tab_by_name_returns_first_match():
+    tabs = Tabs([Tab("A", "x"), Tab("B", "y"), Tab("C", "x")])
+    assert tabs.find_tab_by_name("x") == 0
+    assert tabs.find_tab_by_name("y") == 1
+    assert tabs.find_tab_by_name("missing") == 0
