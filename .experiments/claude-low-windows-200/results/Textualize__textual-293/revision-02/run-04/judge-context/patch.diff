+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application for the Tabs widget."""
+
+    def on_mount(self):
+        """Mount example tab bars directly on the app."""
+        self.mount(
+            tabs=Tabs(
+                [Tab("Home"), Tab("Files", "files"), Tab("Settings")],
+                active_tab="files",
+            ),
+            short=Tabs([Tab("One"), Tab("Two"), Tab("Three")], tab_padding=2),
+        )
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
