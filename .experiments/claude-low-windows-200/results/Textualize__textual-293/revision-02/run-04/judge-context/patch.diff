diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..a7e700e
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,448 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __eq__(self, other: object) -> bool:
+        if not isinstance(other, Tab):
+            return NotImplemented
+        return self.label == other.label and self.name == other.name
+
+    def __hash__(self) -> int:
+        return hash((self.label, self.name))
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """An edge for the layout resolver, describing one padding or label cell run."""
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _displayed_tabs(tabs: Sequence[Tab]) -> list[Tab]:
+    """Compute the tabs to render: one per distinct name.
+
+    The position of each entry is where its name first appears, and its label
+    comes from the last tab with that name.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+
+    Returns:
+        list[Tab]: The displayed tabs, in display order.
+    """
+    labels: dict[str, str] = {}
+    for tab in tabs:
+        # Re-assigning an existing key keeps its first position
+        labels[tab.name] = tab.label
+    return [Tab(label, name) for name, label in labels.items()]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The full tab list.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): Fractional index into the displayed tabs for the bar.
+        active_tab_style (StyleType): Style of the active tab's padded span.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_tab_style (StyleType): Style of inactive tabs' padded spans.
+        inactive_bar_style (StyleType): Style of the non-highlighted part of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive tabs.
+        tab_padding (int | None): Fixed padding cells per side, or None to auto-fit.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_edge(self) -> _TabEdge:
+        if self.tab_padding is not None and self.tab_padding > 0:
+            return _TabEdge(size=self.tab_padding)
+        return _TabEdge(size=None, min_size=1, fraction=1)
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (list[tuple[int, int]]): Label range of each displayed tab.
+
+        Returns:
+            tuple[float, float]: The highlight range in columns.
+        """
+        count = len(label_ranges)
+        if count == 0:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(math.floor(position))
+        fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_ranges[index]
+        next_start, next_end = label_ranges[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        displayed = _displayed_tabs(self.tabs)
+        label_widths = [cell_len(tab.label) for tab in displayed]
+
+        # Each displayed tab contributes: left padding, label (if non-empty), right padding.
+        # A zero-width label is left out so it is not treated as a flexible edge.
+        edges: list[_TabEdge] = []
+        for label_width in label_widths:
+            edges.append(self._padding_edge())
+            if label_width:
+                edges.append(_TabEdge(size=label_width))
+            edges.append(self._padding_edge())
+        sizes = iter(layout_resolve(width, edges))
+
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        row: list[RenderableType] = []
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        x = 0
+        for tab, label_width in zip(displayed, label_widths):
+            left = next(sizes)
+            label_size = next(sizes) if label_width else 0
+            right = next(sizes)
+
+            label_start = x + left
+            label_end = label_start + label_size
+            span_end = label_end + right
+            label_ranges.append((label_start, label_end))
+            selection_ranges[tab.name] = (x, span_end)
+            x = span_end
+
+            run = " " * left + tab.label + " " * right
+            if tab.name == self.active_tab_name:
+                # The active tab carries no click action
+                row.append(
+                    Text(
+                        run,
+                        style=active_style,
+                        no_wrap=True,
+                        overflow="crop",
+                        end="",
+                    )
+                )
+            else:
+                run_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked({tab.name!r})"}
+                )
+                row.append(
+                    Opacity(
+                        Text(
+                            run,
+                            style=run_style,
+                            no_wrap=True,
+                            overflow="crop",
+                            end="",
+                        ),
+                        opacity=self.inactive_text_opacity,
+                    )
+                )
+
+        for item in row:
+            yield item
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    Tabs are selected with the keyboard or the mouse. Tab names identify the
+    active tab, so duplicate names are shown once.
+
+    Args:
+        tabs (list[Tab]): The tabs to show. May be empty.
+        active_tab (str, optional): Name of the initially active tab. If it is
+            absent or empty, the first tab is active. An unknown name is kept,
+            and the bar then sits at index 0. Defaults to None.
+        active_tab_style (StyleType, optional): Style of the active tab.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of
+            the underline bar. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of inactive tabs.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the
+            underline bar. Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio applied to the text of
+            inactive tabs, where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration of the bar animation in
+            seconds. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used for
+            the bar animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            None or 0 sizes the padding to fit the widget. Defaults to None.
+        search_by_first_character (bool, optional): If True, pressing a character
+            key activates the next tab whose label starts with that character.
+            Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    _active_tab_name: Reactive[str] = Reactive("")
+    _bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if active_tab:
+            initial_name = active_tab
+        elif self.tabs:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = ""
+        self._bar_position = float(self._displayed_index(initial_name))
+        self._active_tab_name = initial_name
+
+    def _displayed_index(self, tab_name: str) -> int:
+        """Get the index of a name's tab among the displayed tabs.
+
+        Args:
+            tab_name (str): The tab name.
+
+        Returns:
+            int: The displayed index, or 0 when the name is not found.
+        """
+        full_index = self.find_tab_by_name(tab_name)
+        return len({tab.name for tab in self.tabs[:full_index]})
+
+    def find_tab_by_name(self, tab_name: str) -> int:
+        """Find the index of the first tab with a given name.
+
+        Args:
+            tab_name (str): The tab name to look for.
+
+        Returns:
+            int: The index in the full tab list, or 0 when no tab has the name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == tab_name:
+                return index
+        return 0
+
+    def _activate_relative(self, step: int) -> None:
+        count = len(self.tabs)
+        index = self.find_tab_by_name(self._active_tab_name)
+        for _ in range(count):
+            index = (index + step) % count
+            # Skip duplicates of the active name so the move is visible
+            if self.tabs[index].name != self._active_tab_name:
+                self._active_tab_name = self.tabs[index].name
+                return
+
+    def activate_next_tab(self) -> None:
+        """Make the next tab in the full tab list active, wrapping at the end."""
+        self._activate_relative(1)
+
+    def activate_previous_tab(self) -> None:
+        """Make the previous tab in the full tab list active, wrapping at the start."""
+        self._activate_relative(-1)
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps, and never selects the
+        active tab. The active tab does not change if no other tab matches.
+
+        Args:
+            char (str): The character to match, compared case-insensitively.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        target = char.casefold()
+        start = self.find_tab_by_name(self._active_tab_name)
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.name == self._active_tab_name:
+                continue
+            if tab.label.casefold().startswith(target):
+                self._active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, tab_number: int) -> None:
+        """Activate a tab by its 1-based position in the full tab list.
+
+        The number 0 activates the 10th tab when there are at least ten tabs.
+        With fewer than ten tabs, 0 resolves to the last tab. Numbers outside
+        the tab count are ignored.
+
+        Args:
+            tab_number (int): The 1-based tab number.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        if tab_number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = tab_number - 1
+        if not -count <= index < count:
+            return
+        self._active_tab_name = self.tabs[index].name
+
+    def action_range_clicked(self, target_tab_name: str) -> None:
+        """Make the named tab active. Called when a tab's span is clicked.
+
+        Args:
+            target_tab_name (str): The name of the tab to activate.
+        """
+        self._active_tab_name = target_tab_name
+
+    def watch__active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the underline bar to the newly active tab.
+
+        Args:
+            active_tab_name (str): The new active tab name.
+        """
+        self.animate(
+            "_bar_position",
+            float(self._displayed_index(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys for tab navigation.
+
+        The event is always marked handled, and its propagation is not stopped.
+        With no tabs, nothing else happens. Otherwise:
+
+        - Escape clears focus from the widget.
+        - Right and Left activate the next and previous tab, wrapping at either end.
+        - Digits 1-9 activate the tab at that 1-based position. 0 follows the
+          rule in ``activate_tab_by_number``.
+        - Other single characters activate the next tab whose label starts with
+          that character, when ``search_by_first_character`` is True.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self._active_tab_name,
+            bar_position=self._bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
