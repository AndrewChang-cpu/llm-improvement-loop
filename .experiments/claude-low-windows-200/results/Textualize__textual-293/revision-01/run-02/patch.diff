@@ -0,0 +1,51 @@
+import re
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def plain(output: str) -> list[str]:
+    return ANSI.sub("", output).split("\n")
+
+
+def make_renderable(tabs, active_tab, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs,
+        active_tab=active_tab,
+        bar_position=bar_position,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_explicit_name():
+    tab = Tab("Home", name="home")
+    assert tab.name == "home"
+    assert tab.label == "Home"
+
+
+def test_tabs_renderable_labels_and_highlight():
+    tabs = [Tab("one"), Tab("two")]
+    lines = plain(render(make_renderable(tabs, "one", tab_padding=1)))
+    # Labels are separated by the padding cells, and the row is padded to width.
+    assert lines[0].rstrip() == " one  two"
+    # The highlight covers the label "one" (columns 1 to 4) and the bar wraps to full width.
+    assert lines[1] == "╸━━━╺" + "━" * 95
+
+
+def test_tabs_renderable_no_tabs_draws_only_inactive_bar():
+    lines = plain(render(make_renderable([], "")))
+    assert lines[0].strip() == ""
+    assert lines[1] == "━" * 100
