+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application for the Tabs widget."""
+
+    def on_mount(self) -> None:
+        self.mount(
+            tabs=Tabs(
+                [
+                    Tab("Home"),
+                    Tab("Files", name="files"),
+                    Tab("Settings"),
+                    Tab("Help"),
+                ],
+                active_tab="files",
+                tab_padding=2,
+            )
+        )
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
