+    def _with_click_ranges(self, segments: Iterable[Segment]) -> Iterator[Segment]:
+        """Split segments at clickable range edges and attach click metadata.
+
+        Segments are only split where a clickable range begins or ends, so the
+        visible output is unchanged apart from the added metadata.
+        """
+        spans = [
+            (start, end, Style(meta={"@click": f"range_clicked({name!r})"}))
+            for name, (start, end) in self.clickable_ranges.items()
+        ]
+        column = 0
+        for segment in segments:
+            text = segment.text
+            length = len(text)
+            cuts = {0, length}
+            for start, end, _ in spans:
+                for edge in (start, end):
+                    if 0 < edge - column < length:
+                        cuts.add(edge - column)
