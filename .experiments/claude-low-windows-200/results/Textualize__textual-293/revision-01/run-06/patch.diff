diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..0ef2d4c
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,458 @@
+from __future__ import annotations
+
+from dataclasses import dataclass
+from typing import Dict, List, Optional, Sequence, Tuple
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab for the [Tabs][textual.widgets.tabs.Tabs] widget.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __str__(self) -> str:
+        return str(self.label)
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+
+@dataclass
+class _Edge:
+    """A span of cells for ``layout_resolve``: fixed when ``size`` is set."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _unique_tabs(tabs: Sequence[Tab]) -> List[Tab]:
+    """Keep only the last tab for each name, in list order.
+
+    Args:
+        tabs (Sequence[Tab]): The tabs, possibly with repeated names.
+
+    Returns:
+        List[Tab]: The tabs to render, one per name.
+    """
+    last_index = {tab.name: index for index, tab in enumerate(tabs)}
+    return [tab for index, tab in enumerate(tabs) if last_index[tab.name] == index]
+
+
+def _resolve_sizes(total: int, edges: Sequence[_Edge]) -> List[int]:
+    """Size each edge with ``layout_resolve``.
+
+    Zero-size edges are kept out of the resolver, because it treats a zero size as
+    flexible.
+
+    Args:
+        total (int): Number of cells available.
+        edges (Sequence[_Edge]): The edges to size.
+
+    Returns:
+        List[int]: The number of cells for each edge.
+    """
+    live = [index for index, edge in enumerate(edges) if edge.size != 0]
+    resolved = layout_resolve(total, [edges[index] for index in live])
+    sizes = [0] * len(edges)
+    for index, size in zip(live, resolved):
+        sizes[index] = size
+    return sizes
+
+
+def _resolve_style(console: Console, style: StyleType | None) -> Style:
+    """Resolve a style value to a Style, never returning None.
+
+    Args:
+        console (Console): The console used to parse style strings.
+        style (StyleType | None): The style value.
+
+    Returns:
+        Style: The resolved style.
+    """
+    if style is None:
+        return Style()
+    return console.get_style(style)
+
+
+def _click_style(name: str) -> Style:
+    """Build the style that carries the click action for a tab name.
+
+    Args:
+        name (str): The tab name.
+
+    Returns:
+        Style: A style whose metadata holds the ``range_clicked`` action.
+    """
+    return Style(meta={"@click": f"range_clicked({name!r})"})
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The tabs to render.
+        active_tab_name (str): The name of the active tab, or an empty string.
+        bar_position (float): Fractional tab index that places the underline.
+        active_tab_style (StyleType): Style of the active label.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of the inactive labels.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed cells on each side of a label, or
+            ``None`` to fit the padding automatically.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        inactive_bar = _resolve_style(console, self.inactive_bar_style)
+        active_bar = _resolve_style(console, self.active_bar_style)
+
+        tabs = _unique_tabs(self.tabs)
+        if not tabs:
+            yield UnderlineBar(background_style=inactive_bar, width=width)
+            return
+
+        # Each tab is padding, label, padding, in that order.
+        edges: List[_Edge] = []
+        for tab in tabs:
+            edges.append(_Edge(size=self.tab_padding))
+            edges.append(_Edge(size=cell_len(str(tab.label))))
+            edges.append(_Edge(size=self.tab_padding))
+        sizes = _resolve_sizes(width, edges)
+
+        active_style = _resolve_style(console, self.active_tab_style)
+        inactive_style = _resolve_style(console, self.inactive_tab_style)
+
+        row: List[Segment] = []
+        label_spans: List[Tuple[int, int]] = []
+        selection_ranges: Dict[str, Tuple[int, int]] = {}
+        column = 0
+        for tab_index, tab in enumerate(tabs):
+            left, label_width, right = sizes[tab_index * 3 : tab_index * 3 + 3]
+            is_active = tab.name == self.active_tab_name
+            click = None if is_active else _click_style(tab.name)
+
+            selection_start = column
+            if left:
+                row.append(Segment(" " * left, click))
+            label_start = column + left
+            if label_width:
+                label = str(tab.label)
+                if is_active:
+                    row.append(Segment(label, active_style))
+                else:
+                    label_text = Text(
+                        label,
+                        style=inactive_style + click,
+                        no_wrap=True,
+                        end="",
+                    )
+                    row.extend(
+                        console.render(
+                            Opacity(label_text, opacity=self.inactive_text_opacity),
+                            options.update_width(label_width),
+                        )
+                    )
+            if right:
+                row.append(Segment(" " * right, click))
+
+            column = label_start + label_width + right
+            label_spans.append((label_start, label_start + label_width))
+            selection_ranges[tab.name] = (selection_start, column)
+
+        yield from Segment.adjust_line_length(row, width)
+        yield Segment.line()
+
+        yield UnderlineBar(
+            highlight_range=self._highlight_range(label_spans),
+            highlight_style=active_bar,
+            background_style=inactive_bar,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+    def _highlight_range(
+        self, label_spans: List[Tuple[int, int]]
+    ) -> Tuple[float, float]:
+        """Interpolate the label range at the bar position.
+
+        Args:
+            label_spans (List[Tuple[int, int]]): The label range of each rendered tab.
+
+        Returns:
+            Tuple[float, float]: The highlight range in cells.
+        """
+        count = len(label_spans)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(position)
+        fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_spans[index]
+        next_start, next_end = label_spans[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tab labels with an animated underline.
+
+    The active tab is shown by the underline. Tabs are chosen with the keyboard
+    or by clicking them.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab. An unknown name is accepted and selects index 0 for the bar.
+        active_tab_style (StyleType, optional): Style of the active tab label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType, optional): Style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType, optional): Style of the inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType, optional): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float, optional): Blend ratio used to dim inactive
+            labels, where 1 is fully visible. Defaults to 0.5.
+        animation_duration (float, optional): Duration in seconds of the underline
+            animation. Defaults to 0.3.
+        animation_function (str, optional): Name of the easing function used by the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to ``None``, which fits the padding to the available width.
+        search_by_first_character (bool, optional): Whether pressing a character key
+            activates the next tab whose label starts with it. Defaults to True.
+        name (str, optional): The name of the widget. Defaults to None.
+        id (str, optional): The ID of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = """
+        height: 2;
+    """
+
+    active_tab_name: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        super().__init__(name=name, id=id)
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab is None:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = active_tab
+        self.active_tab_name = initial_name
+        self.bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> TabsRenderable:
+        return TabsRenderable(
+            self.tabs,
+            active_tab_name=self.active_tab_name,
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch_active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        self.animate(
+            "bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the rendered index of a tab by name.
+
+        Args:
+            name (str): The name of the tab.
+
+        Returns:
+            int: The index of the tab, or 0 if no tab has that name.
+        """
+        for index, tab in enumerate(_unique_tabs(self.tabs)):
+            if tab.name == name:
+                return index
+        return 0
+
+    def _active_index(self) -> int | None:
+        """Get the index in ``tabs`` of the active tab, or None if there is none."""
+        for index, tab in enumerate(self.tabs):
+            if tab.name == self.active_tab_name:
+                return index
+        return None
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        count = len(self.tabs)
+        current = self._active_index()
+        index = 0 if current is None else (current + 1) % count
+        self.active_tab_name = self.tabs[index].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        count = len(self.tabs)
+        current = self._active_index()
+        index = count - 1 if current is None else (current - 1) % count
+        self.active_tab_name = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, char: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps. It ignores case.
+
+        Args:
+            char (str): The character to match.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        current = self._active_index()
+        start = -1 if current is None else current
+        needle = char.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if str(tab.label).lower().startswith(needle):
+                self.active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The value 0 selects the 10th tab when there are at least ten tabs. Otherwise
+        it selects the last tab, through negative indexing. A number larger than the
+        tab count is ignored.
+
+        Args:
+            number (int): The tab number.
+        """
+        count = len(self.tabs)
+        if number < 0:
+            return
+        if number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = number - 1
+        if not -count <= index < count:
+            return
+        self.active_tab_name = self.tabs[index].name
+
+    async def action_range_clicked(self, name: str) -> None:
+        """Make the tab with the given name the active tab.
+
+        Args:
+            name (str): The name of the tab.
+        """
+        self.active_tab_name = name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the tabs have focus.
+
+        Every key event is marked handled. With no tabs, nothing else happens.
+        Otherwise:
+
+        - ``escape`` clears focus from the widget.
+        - ``right`` and ``left`` move to the next and previous tab, wrapping at
+          either end.
+        - The digits ``1`` to ``9`` activate the tab at that 1-based position, and
+          ``0`` follows the rule in ``activate_tab_by_number``.
+        - Any other single character activates the next tab whose label starts with
+          it, ignoring case, when ``search_by_first_character`` is set. Digits take
+          precedence over this search.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == "escape":
+            await self.app.set_focus(None)
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
