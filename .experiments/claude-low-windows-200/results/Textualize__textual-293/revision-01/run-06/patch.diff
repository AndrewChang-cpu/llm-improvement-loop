+import io
+
+from rich.console import Console
+
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def plain_lines(renderable, width: int) -> list[str]:
+    """Render without styling and split the result into lines."""
+    console = Console(width=width, file=io.StringIO(), color_system=None)
+    text = "".join(
+        segment.text for segment in console.render(renderable, console.options)
+    )
+    return text.split("\n")
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+    assert Tab("Home", name="start").name == "start"
+
+
+def test_initial_active_tab_is_first_tab():
+    tabs = Tabs([Tab("Alpha"), Tab("Beta")])
+    assert tabs.active_tab_name == "Alpha"
+    assert tabs.bar_position == 0.0
+
+
+def test_initial_active_tab_by_name():
+    tabs = Tabs([Tab("Alpha"), Tab("Beta"), Tab("Gamma")], active_tab="Beta")
+    assert tabs.active_tab_name == "Beta"
+    assert tabs.bar_position == 1.0
+
+
+def test_unknown_active_tab_falls_back_to_index_zero():
+    tabs = Tabs([Tab("Alpha"), Tab("Beta")], active_tab="nope")
+    assert tabs.active_tab_name == "nope"
+    assert tabs.find_tab_by_name("nope") == 0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs.active_tab_name == ""
+
+
+def test_next_and_previous_wrap():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs.active_tab_name == "A"
+    tabs.activate_previous_tab()
+    assert tabs.active_tab_name == "C"
+
+
+def test_activate_by_number():
+    tabs = Tabs([Tab("A"), Tab("B"), Tab("C")])
+    tabs.activate_tab_by_number(2)
+    assert tabs.active_tab_name == "B"
+    tabs.activate_tab_by_number(4)  # larger than the tab count is ignored
+    assert tabs.active_tab_name == "B"
+    tabs.activate_tab_by_number(0)  # fewer than ten tabs: last tab
+    assert tabs.active_tab_name == "C"
+
+
+def test_activate_by_number_zero_with_ten_tabs():
+    tabs = Tabs([Tab(str(number)) for number in range(1, 11)])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab_name == "10"
+
+
+def test_first_character_search_wraps_and_ignores_case():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("Avocado")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs.active_tab_name == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs.active_tab_name == "Apple"
+
+
+def test_find_tab_by_name():
+    tabs = Tabs([Tab("A"), Tab("B", name="bee")])
+    assert tabs.find_tab_by_name("bee") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_no_tabs_renders_only_inactive_underline():
+    lines = plain_lines(Tabs([]).render(), width=10)
+    assert lines == ["━" * 10]
+
+
+def test_label_row_and_underline_row():
+    tabs = Tabs([Tab("Home"), Tab("Help")], tab_padding=1)
+    lines = plain_lines(tabs.render(), width=20)
+    assert len(lines) == 2
+    assert lines[0].rstrip() == " Home  Help"
+    assert len(lines[1]) == 20
