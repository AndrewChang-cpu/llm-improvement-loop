@@ -0,0 +1,131 @@
+import asyncio
+
+from tests.utilities.render import render
+from textual import events
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def make_tabs(count: int, **kwargs) -> Tabs:
+    return Tabs([Tab(f"Tab {number}") for number in range(1, count + 1)], **kwargs)
+
+
+def press(tabs: Tabs, key: str) -> None:
+    asyncio.run(tabs.on_key(events.Key(tabs, key)))
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", name="home").name == "home"
+    assert str(Tab("Home")) == "Home"
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("Home", "home"), Tab("About", "about")])
+    assert tabs.active_tab == "home"
+    assert tabs.bar_position == 0.0
+
+
+def test_initial_active_tab_by_name():
+    tabs = Tabs([Tab("Home", "home"), Tab("About", "about")], active_tab="about")
+    assert tabs.active_tab == "about"
+    assert tabs.bar_position == 1.0
+
+
+def test_find_tab_by_name_unknown_returns_zero():
+    tabs = Tabs([Tab("Home", "home"), Tab("About", "about")])
+    assert tabs.find_tab_by_name("about") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap():
+    tabs = make_tabs(3)
+    tabs.activate_previous_tab()
+    assert tabs.active_tab == "Tab 3"
+    tabs.activate_next_tab()
+    assert tabs.active_tab == "Tab 1"
+    tabs.activate_next_tab()
+    assert tabs.active_tab == "Tab 2"
+
+
+def test_right_and_left_keys():
+    tabs = make_tabs(3)
+    press(tabs, "right")
+    assert tabs.active_tab == "Tab 2"
+    press(tabs, "left")
+    press(tabs, "left")
+    assert tabs.active_tab == "Tab 3"
+
+
+def test_digit_keys_activate_by_position():
+    tabs = make_tabs(3)
+    press(tabs, "2")
+    assert tabs.active_tab == "Tab 2"
+    press(tabs, "9")
+    assert tabs.active_tab == "Tab 2"
+
+
+def test_zero_key_with_fewer_than_ten_tabs_selects_last():
+    tabs = make_tabs(3)
+    press(tabs, "0")
+    assert tabs.active_tab == "Tab 3"
+
+
+def test_zero_key_with_ten_or_more_tabs_selects_tenth():
+    tabs = make_tabs(12)
+    press(tabs, "0")
+    assert tabs.active_tab == "Tab 10"
