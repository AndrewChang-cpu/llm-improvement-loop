+def test_duplicate_names_keep_last_for_rendering():
+    renderable = TabsRenderable(
+        [Tab("First", "same"), Tab("Second", "same")],
+        active_tab="same",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        inactive_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=None,
+    )
+    output = render(renderable)
+    assert "Second" in output
+    assert "First" not in output
