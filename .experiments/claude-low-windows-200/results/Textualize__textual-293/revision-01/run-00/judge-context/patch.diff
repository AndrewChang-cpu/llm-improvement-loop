+def test_letter_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("banana"), Tab("Avocado")])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs.active_tab == "Avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs.active_tab == "Apple"
+
+
+def test_letter_search_disabled():
+    tabs = Tabs(
+        [Tab("Apple"), Tab("Avocado")],
+        search_by_first_character=False,
+    )
+    press(tabs, "a")
+    assert tabs.active_tab == "Apple"
+
+
+def test_range_clicked_action_sets_active_tab():
+    tabs = make_tabs(3)
+    asyncio.run(tabs.action_range_clicked("Tab 3"))
+    assert tabs.active_tab == "Tab 3"
