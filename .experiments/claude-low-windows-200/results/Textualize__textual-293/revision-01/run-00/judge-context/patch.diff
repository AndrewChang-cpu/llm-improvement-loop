new file mode 100644
index 0000000..1b4b4e1
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,390 @@
+from __future__ import annotations
+
+import math
+import string
+from dataclasses import dataclass
+from typing import List, Optional, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __str__(self) -> str:
+        return self.label
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+
+@dataclass
+class _Edge:
+    """A layout edge for `layout_resolve`. A size of None means flexible."""
+
+    size: Optional[int] = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+@dataclass
+class _TabSpan:
+    """The columns occupied by one tab, as computed during rendering."""
+
+    tab: Tab
+    selection_start: int
+    label_start: int
+    label_end: int
+    selection_end: int
+
+
+class TabsRenderable:
+    """Renderable for the Tabs widget: a label row followed by an underline bar.
+
+    Args:
+        tabs (Sequence[Tab]): The tabs to render.
+        active_tab (str): The name of the active tab.
+        bar_position (float): Fractional tab index that places the underline.
+        active_tab_style (StyleType): Style of the active label.
+        inactive_tab_style (StyleType): Style of the inactive labels.
+        active_bar_style (StyleType): Style of the highlighted part of the bar.
+        inactive_bar_style (StyleType): Style of the rest of the bar.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding cells on each side of a label,
+            or ``None`` to fit padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        inactive_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab = active_tab
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.inactive_tab_style = inactive_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _unique_tabs(self) -> List[Tab]:
+        # Name-keyed lookup: when names collide, the last tab with that name is kept.
+        return list({tab.name: tab for tab in self.tabs}.values())
+
+    def _layout(self, tabs: List[Tab], width: int) -> List[_TabSpan]:
+        """Compute the columns of every tab from the label widths and padding."""
+        label_widths = [cell_len(tab.label) for tab in tabs]
+        if self.tab_padding is None:
+            edges: List[_Edge] = []
+            for label_width in label_widths:
+                edges.append(_Edge())
+                edges.append(_Edge(size=label_width))
+                edges.append(_Edge())
+            sizes = layout_resolve(width, edges)
+        else:
+            sizes = []
+            for label_width in label_widths:
+                sizes += [self.tab_padding, label_width, self.tab_padding]
+
+        spans: List[_TabSpan] = []
+        column = 0
+        for index, tab in enumerate(tabs):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            label_start = column + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            spans.append(
+                _TabSpan(tab, column, label_start, label_end, selection_end)
+            )
+            column = selection_end
+        return spans
+
+    def _bar_highlight(self, spans: List[_TabSpan]) -> tuple[float, float]:
+        """Interpolated label range between the floor index and the next index."""
+        if not spans:
+            return (0.0, 0.0)
+        count = len(spans)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        current = spans[floor_position % count]
+        following = spans[(floor_position + 1) % count]
+        start = current.label_start + fraction * (
+            following.label_start - current.label_start
+        )
+        end = current.label_end + fraction * (following.label_end - current.label_end)
+        return (start, end)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        tabs = self._unique_tabs()
+        spans = self._layout(tabs, width)
+
+        active_tab_style = console.get_style(self.active_tab_style)
+        inactive_tab_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        clickable_ranges: dict[str, tuple[int, int]] = {}
+        if spans:
+            row: List[Segment] = []
+            for span in spans:
+                tab = span.tab
+                row.append(Segment(" " * (span.label_start - span.selection_start)))
+                if tab.name == self.active_tab:
+                    row.append(Segment(tab.label, active_tab_style))
+                else:
+                    click_style = inactive_tab_style + Style(
+                        meta={"@click": f"range_clicked({tab.name!r})"}
+                    )
+                    label = Text(
+                        tab.label,
+                        style=click_style,
+                        no_wrap=True,
+                        overflow="crop",
+                        end="",
+                    )
+                    row.extend(
+                        console.render(
+                            Opacity(label, opacity=self.inactive_text_opacity), options
+                        )
+                    )
+                row.append(Segment(" " * (span.selection_end - span.label_end)))
+                clickable_ranges[tab.name] = (span.selection_start, span.selection_end)
+
+            yield from Segment.adjust_line_length(row, width)
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._bar_highlight(spans),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline.
+    Tabs can be selected by keyboard or by mouse click.
+
+    Args:
+        tabs (List[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults
+            to the first tab.
+        active_tab_style (StyleType): Style of the active label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of the inactive labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults
+            to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible and 0.0 is fully blended into the background.
+            Defaults to 0.5.
+        animation_duration (float): Duration in seconds of the underline animation
+            when the active tab changes. Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label,
+            or ``None`` to fit padding to the available width. Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to True.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    active_tab: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: List[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if self.tabs:
+            initial = active_tab if active_tab is not None else self.tabs[0].name
+            self.bar_position = float(self.find_tab_by_name(initial))
+            self.active_tab = initial
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_tab=self.active_tab,
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            inactive_tab_style=self.inactive_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def watch_active_tab(self, active_tab: str) -> None:
+        if not self.tabs:
+            return
+        self.animate(
+            "bar_position",
+            float(self.find_tab_by_name(active_tab)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the index of a tab by its name.
+
+        Args:
+            name (str): The name of the tab.
+
+        Returns:
+            int: The index of the tab, or 0 if no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping to the first tab after the last."""
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping to the last tab before the first."""
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, character: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and compares
+        case-insensitively.
+
+        Args:
+            character (str): The character to search for.
+        """
+        if not self.tabs:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self.active_tab)
+        needle = character.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(needle):
+                self.active_tab = tab.name
+                return
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs. With
+        fewer than ten tabs it resolves to the last tab through negative indexing.
+        Numbers outside the tab count are ignored.
+
+        Args:
+            number (int): The 1-based tab number.
+        """
+        if not self.tabs:
+            return
+        if number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = number - 1
+        if -len(self.tabs) <= index < len(self.tabs):
+            self.active_tab = self.tabs[index].name
+
+    async def action_range_clicked(self, name: str) -> None:
+        """Activate the tab with the given name. Invoked by clicking a tab.
+
+        Args:
+            name (str): The name of the tab to activate.
+        """
+        self.active_tab = name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle key presses while the widget has focus.
+
+        Escape removes focus. Left and right move to the previous and next tab,
+        wrapping at either end. The digit keys 1 to 9 activate the tab at that
+        1-based position, and 0 follows the rule in `activate_tab_by_number`. Any
+        other single character activates the next tab whose label starts with that
+        character, when `search_by_first_character` is true. Every key event is
+        marked as handled.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == "escape":
+            await self.app.set_focus(None)
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in string.digits:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
