@@ -124,3 +128,25 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+def test_clickable_ranges_attach_click_action():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"first": (0, 2), "second": (3, 6)},
+        width=6,
+    )
+    # The click metadata is not part of the ANSI output, so inspect the segments.
+    console = Console(width=6, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(bar, console.options))
+    click_actions = []
+    for segment in segments:
+        meta = segment.style.meta if segment.style else {}
+        click_actions.extend([meta.get("@click")] * len(segment.text))
+    assert click_actions == (
+        ["range_clicked('first')"] * 2
+        + [None]
+        + ["range_clicked('second')"] * 3
+    )
+    # The visible output is unchanged by the click ranges.
+    assert render(bar) == render(UnderlineBar(highlight_range=(2, 4), width=6))
