+from tests.utilities.render import render
+from textual import events
+from textual.widgets.tabs import Tab, Tabs
+
+
+def make_tabs(labels, **kwargs) -> Tabs:
+    return Tabs([Tab(label) for label in labels], **kwargs)
+
+
+def press(tabs: Tabs, key: str) -> events.Key:
+    event = events.Key(tabs, key)
+    asyncio.run(tabs.on_key(event))
+    return event
+
+
+def test_tab_name_defaults_to_label():
+    assert Tab("Home").name == "Home"
+    assert Tab("Home", "home").name == "home"
+    assert str(Tab("Home")) == "Home"
+
+
+def test_initial_active_tab_is_first_tab():
+    tabs = make_tabs(["A", "B"])
+    assert tabs.active_tab == "A"
+    assert tabs.bar_position == 0
+
+
+def test_initial_active_tab_by_name():
+    tabs = make_tabs(["A", "B", "C"], active_tab="B")
+    assert tabs.active_tab == "B"
+    assert tabs.bar_position == 1
+
+
+def test_unknown_active_tab_places_bar_at_zero():
+    tabs = make_tabs(["A", "B"], active_tab="missing")
+    assert tabs.active_tab == "missing"
+    assert tabs.bar_position == 0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs.active_tab == ""
+    assert tabs.bar_position == 0
+
+
+def test_find_tab_by_name():
+    tabs = make_tabs(["A", "B", "C"])
+    assert tabs.find_tab_by_name("C") == 2
+    assert tabs.find_tab_by_name("nope") == 0
+
+
+def test_next_and_previous_wrap():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.activate_previous_tab()
+    assert tabs.active_tab == "C"
+    tabs.activate_next_tab()
+    assert tabs.active_tab == "A"
+    tabs.activate_next_tab()
+    assert tabs.active_tab == "B"
+
+
+def test_digit_activates_by_position():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.activate_tab_by_number(2)
+    assert tabs.active_tab == "B"
+    tabs.activate_tab_by_number(5)
+    assert tabs.active_tab == "B"
+
+
+def test_zero_activates_last_tab_with_fewer_than_ten():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab == "C"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more():
+    tabs = make_tabs([str(number) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab == "9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = make_tabs(["Apple", "Banana", "apricot"])
+    tabs.activate_tab_by_first_char("a")
+    assert tabs.active_tab == "apricot"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs.active_tab == "Apple"
+
+
+def test_keys_with_no_tabs_are_handled_without_error():
+    tabs = Tabs([])
+    event = press(tabs, "right")
+    assert event._no_default_action
+    assert event._stop_propagation
+
+
+def test_right_and_left_keys_wrap():
+    tabs = make_tabs(["A", "B"])
+    press(tabs, "left")
+    assert tabs.active_tab == "B"
+    press(tabs, "right")
+    assert tabs.active_tab == "A"
+
+
+def test_digit_key_takes_precedence_over_search():
+    tabs = make_tabs(["1st", "2nd", "Three"])
+    press(tabs, "2")
+    assert tabs.active_tab == "2nd"
+
+
+def test_search_flag_disables_letter_search():
+    tabs = make_tabs(["Apple", "Banana"], search_by_first_character=False)
+    press(tabs, "b")
+    assert tabs.active_tab == "Apple"
+
+
+def test_action_range_clicked_sets_active_tab():
+    tabs = make_tabs(["A", "B", "C"])
+    asyncio.run(tabs.action_range_clicked("C"))
+    assert tabs.active_tab == "C"
+
+
+def test_render_no_tabs_draws_full_width_bar():
+    output = render(Tabs([]).render())
+    assert "━" * 100 in output
+
+
+def test_render_two_rows_with_labels():
+    output = render(make_tabs(["Home", "Files"]).render())
+    assert len(output.split("\n")) == 2
+    assert "Home" in output
+    assert "Files" in output
