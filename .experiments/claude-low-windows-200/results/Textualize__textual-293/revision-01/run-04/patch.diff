diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..97552de
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,393 @@
+from __future__ import annotations
+
+import math
+from typing import Iterator
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import LayoutEdge, layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name used to identify the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __str__(self) -> str:
+        return self.label
+
+
+def _click_style(name: str) -> Style:
+    """Create a style that carries the click action for a tab name."""
+    return Style(meta={"@click": f"range_clicked({name!r})"})
+
+
+class TabsRenderable:
+    """Renders the label row and the underline row of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The tabs to render.
+        active_tab (str): The name of the active tab, or an empty string.
+        bar_position (float): The fractional tab index that places the underline.
+        active_tab_style (StyleType): The style of the active label.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (StyleType): The style of inactive labels.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels.
+        tab_padding (int, optional): A fixed padding in cells on each side of a label,
+            or ``None`` to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab = active_tab
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _padding_sizes(self, width: int) -> list[int]:
+        """Get the left and right padding sizes for every tab, in order."""
+        count = len(self.tabs) * 2
+        if self.tab_padding is not None:
+            return [self.tab_padding] * count
+        label_total = sum(cell_len(tab.label) for tab in self.tabs)
+        remaining = width - label_total
+        return layout_resolve(remaining, [LayoutEdge() for _ in range(count)])
+
+    def _layout(self, width: int) -> list[tuple[int, int, int, int]]:
+        """Compute the column positions of every tab.
+
+        Returns:
+            list[tuple[int, int, int, int]]: For each tab, the selection start, the
+                label start, the label end, and the selection end.
+        """
+        pads = self._padding_sizes(width)
+        positions: list[tuple[int, int, int, int]] = []
+        cursor = 0
+        for index, tab in enumerate(self.tabs):
+            left = pads[index * 2]
+            right = pads[index * 2 + 1]
+            label_start = cursor + left
+            label_end = label_start + cell_len(tab.label)
+            selection_end = label_end + right
+            positions.append((cursor, label_start, label_end, selection_end))
+            cursor = selection_end
+        return positions
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the bar position."""
+        count = len(label_ranges)
+        floor_position = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_position
+        index = floor_position % count
+        next_index = (index + 1) % count
+        start, end = label_ranges[index]
+        next_start, next_end = label_ranges[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def _label_segments(
+        self, console: Console, options: ConsoleOptions, tab: Tab, is_active: bool
+    ) -> Iterator[Segment]:
+        """Render the label text of a single tab."""
+        if is_active:
+            style = console.get_style(self.active_tab_style)
+            label = Text(tab.label, style=style, end="", no_wrap=True, overflow="crop")
+            yield from console.render(label, options)
+        else:
+            style = console.get_style(self.inactive_tab_style) + _click_style(tab.name)
+            label = Text(tab.label, style=style, end="", no_wrap=True, overflow="crop")
+            opacity = Opacity(label, opacity=self.inactive_text_opacity)
+            yield from console.render(opacity, options)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        clickable_ranges: dict[str, tuple[int, int]] = {}
+
+        if self.tabs:
+            positions = self._layout(width)
+            label_ranges: list[tuple[int, int]] = []
+            for tab, (selection_start, label_start, label_end, selection_end) in zip(
+                self.tabs, positions
+            ):
+                is_active = tab.name == self.active_tab
+                label_ranges.append((label_start, label_end))
+                clickable_ranges[tab.name] = (selection_start, selection_end)
+
+                if is_active:
+                    pad_style = console.get_style(self.active_tab_style)
+                else:
+                    pad_style = console.get_style(
+                        self.inactive_tab_style
+                    ) + _click_style(tab.name)
+
+                left_pad = label_start - selection_start
+                right_pad = selection_end - label_end
+                if left_pad:
+                    yield Segment(" " * left_pad, pad_style)
+                yield from self._label_segments(console, options, tab, is_active)
+                if right_pad:
+                    yield Segment(" " * right_pad, pad_style)
+
+            # Line break between the label row and the underline row
+            yield Segment.line()
+            highlight_range = self._highlight_range(label_ranges)
+        else:
+            highlight_range = (0, 0)
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=clickable_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline.
+    Tabs can be selected with the keyboard or with the mouse.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab. An unknown name is accepted and places the bar at index 0.
+        active_tab_style (StyleType): The style of the active label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline. Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): The blend ratio applied to inactive labels,
+            where 1.0 is fully visible. Defaults to 0.5.
+        animation_duration (float): The duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): The name of the easing function used for the
+            underline animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): A fixed number of cells of padding on each side of
+            every label, or ``None`` to fit the padding to the available width.
+            Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a key other than a digit or
+            an arrow activates the next tab whose label starts with that character.
+            Defaults to True.
+        name (str, optional): The name of the widget. Defaults to None.
+        id (str, optional): The ID of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = """
+        height: 2;
+    """
+
+    active_tab: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        super().__init__(name=name, id=id)
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            self.active_tab = ""
+        elif active_tab is None:
+            self.active_tab = self.tabs[0].name
+        else:
+            self.active_tab = active_tab
+        self.bar_position = float(self.find_tab_by_name(self.active_tab))
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the index of a tab by its name.
+
+        If several tabs share the name, the index of the last one is returned.
+
+        Args:
+            name (str): The tab name to look up.
+
+        Returns:
+            int: The index of the tab, or 0 if no tab has that name.
+        """
+        index = 0
+        for position, tab in enumerate(self.tabs):
+            if tab.name == name:
+                index = position
+        return index
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping to the first tab after the last."""
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping to the last tab before the first."""
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, character: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and ignores case.
+        The active tab is the last one checked.
+
+        Args:
+            character (str): The character to match at the start of a label.
+        """
+        if not self.tabs:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self.active_tab)
+        target = character.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(target):
+                self.active_tab = tab.name
+                return
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs.
+        With fewer tabs, 0 activates the last tab. Numbers beyond the tab count are
+        ignored.
+
+        Args:
+            number (int): The tab number to activate.
+        """
+        if not self.tabs:
+            return
+        if number == 0:
+            index = 9 if len(self.tabs) >= 10 else -1
+        else:
+            index = number - 1
+            if index < 0 or index >= len(self.tabs):
+                return
+        self.active_tab = self.tabs[index].name
+
+    async def action_range_clicked(self, name: str) -> None:
+        """Make the tab with the given name the active tab.
+
+        Args:
+            name (str): The name of the tab to activate.
+        """
+        self.active_tab = name
+
+    async def watch_active_tab(self, active_tab: str) -> None:
+        """Animate the underline bar to the index of the newly active tab."""
+        self.animate(
+            "bar_position",
+            float(self.find_tab_by_name(active_tab)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        Every key event is marked handled. With no tabs, nothing else happens.
+        Escape clears focus. Right and left move to the next and previous tab, with
+        wrap-around. The digit keys 1 to 9 activate tabs by position, and 0 activates
+        the 10th tab (or the last tab when there are fewer than ten). Digit handling
+        takes precedence over letter search. When ``search_by_first_character`` is
+        true, any other single-character key activates the next tab whose label starts
+        with that character, ignoring case.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default().stop()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGIT_KEYS:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab=self.active_tab,
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
