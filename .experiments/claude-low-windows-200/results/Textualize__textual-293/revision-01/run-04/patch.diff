+    def _click_name_at(self, column: int) -> str | None:
+        """Get the name of the clickable range covering a column, if any."""
+        for name, (start, end) in self.clickable_ranges.items():
+            if start <= column < end:
+                return name
+        return None
+
+    def _attach_click_actions(self, segments: Iterable[Segment]) -> Iterator[Segment]:
+        """Split segments at clickable range boundaries and add ``@click`` metadata.
+
+        Args:
+            segments (Iterable[Segment]): The rendered bar segments.
+
+        Yields:
+            Segment: Segments with click metadata on the clickable spans.
+        """
+        column = 0
+        for segment in segments:
+            text, style, control = segment
+            if control or not text:
+                yield segment
+                continue
+            length = cell_len(text)
+            start = 0
+            current = self._click_name_at(column)
+            for index in range(1, length + 1):
+                name = self._click_name_at(column + index) if index < length else None
+                if index == length or name != current:
+                    piece = text[start:index]
+                    if current is None:
+                        yield Segment(piece, style)
+                    else:
+                        meta = {"@click": f"range_clicked({current!r})"}
+                        yield Segment(piece, (style or Style()) + Style(meta=meta))
+                    start = index
+                    current = name
+            column += length
+
 
