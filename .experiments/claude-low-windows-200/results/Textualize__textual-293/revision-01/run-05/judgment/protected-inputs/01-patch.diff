+            piece_style = style
+            for name, (start, end) in self.clickable_ranges.items():
+                if start <= piece_start < end:
+                    piece_style = style + Style(
+                        meta={"@click": f"range_clicked('{name}')"}
+                    )
+                    break
+            segments.append(
+                Segment(
+                    text[piece_start - position : piece_end - position], piece_style
+                )
+            )
+        return segments
 
 
