diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..5729c2c
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,409 @@
+from __future__ import annotations
+
+import math
+from typing import Iterable, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import EdgeSpec, layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A single tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __str__(self) -> str:
+        return self.label
+
+    def __repr__(self) -> str:
+        return f"Tab(label={self.label!r}, name={self.name!r})"
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    The label row lays out each tab as a left padding edge, a label edge sized to
+    the label's cell width, and a right padding edge. The underline bar is drawn on
+    the row below, with its clickable ranges set to each tab's selection range.
+
+    Args:
+        tabs (Sequence[Tab]): The tabs to render. When names collide, only the last
+            tab with a given name is rendered.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): Fractional tab index that places the underline.
+        active_tab_style (StyleType): Style of the active tab's label.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive tabs' labels.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding on each side of each label, or
+            ``None`` to share the remaining width between padding edges.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs_by_name: dict[str, Tab] = {tab.name: tab for tab in tabs}
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+        self.label_ranges: dict[str, tuple[int, int]] = {}
+        self.selection_ranges: dict[str, tuple[int, int]] = {}
+
+    def _compute_layout(
+        self, width: int, tabs: list[Tab]
+    ) -> list[tuple[Tab, int, int, int]]:
+        """Compute the padding and label widths of each tab, and the ranges they occupy.
+
+        Args:
+            width (int): The width available to the label row.
+            tabs (list[Tab]): The tabs to lay out, in order.
+
+        Returns:
+            list[tuple[Tab, int, int, int]]: For each tab, the left padding, label
+                width, and right padding, in cells.
+        """
+        label_widths = [cell_len(tab.label) for tab in tabs]
+        padding_count = 2 * len(tabs)
+        if self.tab_padding is None:
+            remaining = width - sum(label_widths)
+            edges = [EdgeSpec() for _ in range(padding_count)]
+            paddings = layout_resolve(max(remaining, 0), edges)
+        else:
+            paddings = [self.tab_padding] * padding_count
+        return [
+            (tab, paddings[2 * index], label_widths[index], paddings[2 * index + 1])
+            for index, tab in enumerate(tabs)
+        ]
+
+    def _highlight_range(self, tabs: list[Tab]) -> tuple[float, float]:
+        """Interpolate the label range of the bar position between two tabs.
+
+        Args:
+            tabs (list[Tab]): The rendered tabs.
+
+        Returns:
+            tuple[float, float]: The start and end columns of the highlight.
+        """
+        if not tabs:
+            return (0, 0)
+        count = len(tabs)
+        floor_index = math.floor(self.bar_position)
+        fraction = self.bar_position - floor_index
+        index = floor_index % count
+        next_index = (index + 1) % count
+        start_a, end_a = self.label_ranges[tabs[index].name]
+        start_b, end_b = self.label_ranges[tabs[next_index].name]
+        start = start_a + (start_b - start_a) * fraction
+        end = end_a + (end_b - end_a) * fraction
+        return (start, end)
+
+    def _label_segments(
+        self,
+        console: Console,
+        options: ConsoleOptions,
+        layout: list[tuple[Tab, int, int, int]],
+    ) -> Iterable[Segment]:
+        """Yield the segments of the label row.
+
+        Args:
+            console (Console): The console used to resolve styles.
+            options (ConsoleOptions): Render options.
+            layout (list[tuple[Tab, int, int, int]]): The computed tab layout.
+
+        Yields:
+            Segment: Segments of the label row.
+        """
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        for tab, left, label_width, right in layout:
+            is_active = tab.name == self.active_tab_name
+            if is_active:
+                pad_style = active_style
+            else:
+                # Inactive tabs carry the click action across their whole span.
+                pad_style = inactive_style + Style(
+                    meta={"@click": f"range_clicked('{tab.name}')"}
+                )
+            if left:
+                yield Segment(" " * left, pad_style)
+            if is_active:
+                yield Segment(tab.label, active_style)
+            elif label_width:
+                label = Text(
+                    tab.label,
+                    style=pad_style,
+                    no_wrap=True,
+                    end="",
+                )
+                dimmed = Opacity(label, opacity=self.inactive_text_opacity)
+                for segment in console.render(dimmed, options):
+                    if segment.text:
+                        yield segment
+            if right:
+                yield Segment(" " * right, pad_style)
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        tabs = list(self.tabs_by_name.values())
+
+        layout = self._compute_layout(width, tabs)
+        self.label_ranges = {}
+        self.selection_ranges = {}
+        offset = 0
+        for tab, left, label_width, right in layout:
+            selection_start = offset
+            label_start = offset + left
+            label_end = label_start + label_width
+            selection_end = label_end + right
+            self.label_ranges[tab.name] = (label_start, label_end)
+            self.selection_ranges[tab.name] = (selection_start, selection_end)
+            offset = selection_end
+
+        if tabs:
+            yield from self._label_segments(console, options, layout)
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(tabs),
+            highlight_style=self.active_bar_style,
+            background_style=self.inactive_bar_style,
+            clickable_ranges=self.selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected by keyboard or mouse. The active tab is identified by name.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            the first tab. An unknown name is accepted and places the underline at the
+            first tab.
+        active_tab_style (StyleType): Style of the active tab's label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted underline. Defaults to
+            ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tabs' labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults
+            to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of each label,
+            or ``None`` to fit the padding to the widget width. Defaults to ``None``.
+        search_by_first_character (bool): Whether pressing a key other than the arrow
+            keys, Escape, or a digit activates the next tab whose label starts with
+            that character. Defaults to ``True``.
+        name (str, optional): The name of the widget. Defaults to ``None``.
+        id (str, optional): The ID of the widget. Defaults to ``None``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    active_tab_name: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        self.tabs: list[Tab] = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+        super().__init__(name=name, id=id)
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab is not None:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self.active_tab_name = initial_name
+        self.bar_position = float(self.find_tab_by_name(initial_name))
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self.active_tab_name,
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the index of the tab with a given name.
+
+        Args:
+            name (str): The name of the tab.
+
+        Returns:
+            int: The index of the tab, or 0 if no tab has that name.
+        """
+        for index, tab in enumerate(self.tabs):
+            if tab.name == name:
+                return index
+        return 0
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping to the first tab after the last."""
+        index = self.find_tab_by_name(self.active_tab_name)
+        self.active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping to the last tab before the first."""
+        index = self.find_tab_by_name(self.active_tab_name)
+        self.active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, character: str) -> None:
+        """Activate the next tab, after the active one, whose label starts with a letter.
+
+        The search wraps around and compares case-insensitively. The active tab
+        is considered last.
+
+        Args:
+            character (str): The character to search for.
+        """
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self.active_tab_name)
+        needle = character.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(needle):
+                self.active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs.
+        With fewer than ten tabs, it activates the last tab. Numbers beyond the tab
+        count are ignored.
+
+        Args:
+            number (int): The tab number.
+        """
+        count = len(self.tabs)
+        if count == 0:
+            return
+        if number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = number - 1
+            if not 0 <= index < count:
+                return
+        self.active_tab_name = self.tabs[index].name
+
+    async def action_range_clicked(self, tab_name: str) -> None:
+        """Activate the tab with the given name. Used by click actions.
+
+        Args:
+            tab_name (str): The name of the tab to activate.
+        """
+        self.active_tab_name = tab_name
+
+    async def watch_active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        index = self.find_tab_by_name(active_tab_name)
+        self.animate(
+            "bar_position",
+            float(index),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        With no tabs, the key is only marked handled. Otherwise, Escape clears focus,
+        Right and Left move to the next and previous tab with wrap-around, and the
+        digits 1 to 9 (and 0) activate a tab by position. When
+        ``search_by_first_character`` is true, any other single character activates
+        the next tab whose label starts with it. Every key is marked handled.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == "escape":
+            await self.app.set_focus(None)
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
