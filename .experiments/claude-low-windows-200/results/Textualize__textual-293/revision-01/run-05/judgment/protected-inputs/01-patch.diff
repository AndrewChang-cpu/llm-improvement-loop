+        width=6,
+    )
+    actions = _click_actions_by_cell(bar, width=6)
+    assert actions == [
+        "range_clicked('first')",
+        "range_clicked('first')",
+        "range_clicked('first')",
+        "range_clicked('second')",
+        "range_clicked('second')",
+        "range_clicked('second')",
+    ]
+    assert render(bar) == render(UnderlineBar(highlight_range=(2, 4), width=6))
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..767fa5f
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,98 @@
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def make_renderable(tabs, **kwargs):
+    options = dict(
+        active_tab_name=tabs[0].name if tabs else "",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=None,
+    )
+    options.update(kwargs)
+    return TabsRenderable(tabs, **options)
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_explicit_name():
+    tab = Tab("Home", name="home")
+    assert tab.name == "home"
+    assert str(tab) == "Home"
+
+
+def test_find_tab_by_name_unknown_returns_zero():
+    tabs = Tabs([Tab("One"), Tab("Two", name="two")])
+    assert tabs.find_tab_by_name("two") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_activate_tab_by_number_ignores_out_of_range():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(2)
+    assert tabs.active_tab_name == "Two"
+    tabs.activate_tab_by_number(5)
+    assert tabs.active_tab_name == "Two"
+
+
+def test_activate_tab_by_number_zero_is_last_with_fewer_than_ten():
+    tabs = Tabs([Tab("One"), Tab("Two"), Tab("Three")])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab_name == "Three"
+
+
+def test_activate_tab_by_number_zero_is_tenth_with_ten_or_more():
+    labels = [f"Tab{index}" for index in range(12)]
+    tabs = Tabs([Tab(label) for label in labels])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab_name == "Tab9"
+
+
+def test_next_and_previous_wrap_around():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    tabs.activate_previous_tab()
+    assert tabs.active_tab_name == "Two"
+    tabs.activate_next_tab()
+    assert tabs.active_tab_name == "One"
+
+
+def test_first_character_search_wraps_and_is_case_insensitive():
+    tabs = Tabs([Tab("Alpha"), Tab("beta"), Tab("Apple")], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs.active_tab_name == "Alpha"
+    tabs.activate_tab_by_first_char("B")
+    assert tabs.active_tab_name == "beta"
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = Tabs([Tab("One"), Tab("Two")])
+    assert tabs.active_tab_name == "One"
+    assert tabs.bar_position == 0.0
+
+
+def test_initial_active_tab_by_name():
+    tabs = Tabs([Tab("One"), Tab("Two")], active_tab="Two")
+    assert tabs.active_tab_name == "Two"
+    assert tabs.bar_position == 1.0
+
+
+def test_label_and_selection_ranges_with_fixed_padding():
+    renderable = make_renderable(
+        [Tab("A"), Tab("BB")], tab_padding=2, active_tab_name="A"
+    )
+    render(renderable)
+    assert renderable.label_ranges == {"A": (2, 3), "BB": (7, 9)}
+    assert renderable.selection_ranges == {"A": (0, 5), "BB": (5, 11)}
+
+
+def test_no_tabs_renders_without_error():
+    output = render(make_renderable([]))
+    assert "━" in output
