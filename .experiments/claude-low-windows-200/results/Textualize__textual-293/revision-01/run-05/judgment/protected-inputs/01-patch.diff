+def _click_actions_by_cell(bar, width):
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    actions = []
+    for segment in console.render(bar, console.options):
+        click = segment.style.meta.get("@click") if segment.style else None
+        actions.extend([click] * len(segment.text))
+    return actions
+
+
+def test_clickable_ranges_attach_click_actions_to_spans():
