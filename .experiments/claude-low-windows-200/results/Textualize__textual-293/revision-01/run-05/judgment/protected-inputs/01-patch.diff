+    def _split_by_clickable(
+        self, text: str, style: Style, position: int
+    ) -> list[Segment]:
+        """Split a run of text at clickable range boundaries and attach click actions.
+
+        Args:
+            text (str): The text to emit. Each character occupies one column.
+            style (Style): The style of the text.
+            position (int): The column at which the text starts.
+
+        Returns:
+            list[Segment]: Segments covering the text. When there are no clickable
+                ranges, a single segment with the unchanged style is returned.
+        """
+        if not self.clickable_ranges or not text:
+            return [Segment(text, style)]
+
+        end_position = position + len(text)
+        cuts = {position, end_position}
+        for start, end in self.clickable_ranges.values():
+            for cut in (start, end):
+                if position < cut < end_position:
+                    cuts.add(cut)
