@@ -0,0 +1,192 @@
+import asyncio
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+ANSI = re.compile(r"\x1b\[[0-9;]*m")
+
+
+class FakeKey:
+    """Stands in for events.Key: only the key and the handled flag are used."""
+
+    def __init__(self, key: str) -> None:
+        self.key = key
+        self.handled = False
+
+    def prevent_default(self, prevent: bool = True) -> "FakeKey":
+        self.handled = prevent
+        return self
+
+
+def press(tabs: Tabs, key: str) -> FakeKey:
+    event = FakeKey(key)
+    asyncio.run(tabs.on_key(event))
+    return event
+
+
+def make_tabs(**kwargs) -> Tabs:
+    return Tabs([Tab("Home"), Tab("About Us", "about"), Tab("Contact")], **kwargs)
+
+
+def plain_lines(renderable) -> list[str]:
+    return ANSI.sub("", render(renderable)).split("\n")
+
+
+def label_row_clicks(renderable) -> list[tuple[str, str | None]]:
+    """Return (text, click action) for each segment on the first row."""
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    row = []
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n":
+            break
+        meta = segment.style.meta if segment.style else {}
+        row.append((segment.text, meta.get("@click")))
+    return row
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_explicit_name():
+    assert Tab("About Us", "about").name == "about"
+
+
+def test_default_active_tab_is_first():
+    assert make_tabs().active_tab_name == "Home"
+
+
+def test_active_tab_given_by_name():
+    tabs = make_tabs(active_tab="about")
+    assert tabs.active_tab_name == "about"
+    assert tabs.find_tab_by_name("about") == 1
+    assert tabs.bar_position == 1.0
+
+
+def test_unknown_active_tab_falls_back_to_index_zero():
+    tabs = make_tabs(active_tab="missing")
+    assert tabs.active_tab_name == "missing"
+    assert tabs.bar_position == 0.0
+
+
+def test_find_tab_by_name_unknown_returns_zero():
+    assert make_tabs().find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap():
+    tabs = make_tabs()
+    tabs.activate_previous_tab()
+    assert tabs.active_tab_name == "Contact"
+    tabs.activate_next_tab()
+    assert tabs.active_tab_name == "Home"
+
+
+def test_right_and_left_keys_cycle_with_wrap():
+    tabs = make_tabs()
+    assert press(tabs, "right").handled
+    assert tabs.active_tab_name == "about"
+    press(tabs, "left")
+    press(tabs, "left")
+    assert tabs.active_tab_name == "Contact"
+
+
+def test_digit_keys_activate_by_position():
+    tabs = make_tabs()
+    press(tabs, "2")
+    assert tabs.active_tab_name == "about"
+    press(tabs, "3")
+    assert tabs.active_tab_name == "Contact"
+
+
+def test_digit_beyond_tab_count_is_ignored():
+    tabs = make_tabs(active_tab="about")
+    event = press(tabs, "5")
+    assert event.handled
+    assert tabs.active_tab_name == "about"
+
+
+def test_zero_activates_last_tab_with_fewer_than_ten():
+    tabs = make_tabs()
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab_name == "Contact"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more():
+    tabs = Tabs([Tab(str(number)) for number in range(12)])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab_name == "9"
+
+
+def test_first_character_search_is_case_insensitive_and_wraps():
+    tabs = Tabs([Tab("Apple"), Tab("Banana"), Tab("avocado")], active_tab="Apple")
+    press(tabs, "B")
+    assert tabs.active_tab_name == "Banana"
+    press(tabs, "a")
+    assert tabs.active_tab_name == "avocado"
+    press(tabs, "a")
+    assert tabs.active_tab_name == "Apple"
+
+
+def test_first_character_search_disabled_by_flag():
+    tabs = make_tabs(search_by_first_character=False)
+    press(tabs, "c")
+    assert tabs.active_tab_name == "Home"
+
+
+def test_empty_tabs_marks_keys_handled_and_does_nothing():
+    tabs = Tabs([])
+    assert tabs.active_tab_name == ""
+    for key in ("right", "left", "1", "0", "a", "escape"):
+        assert press(tabs, key).handled
+    assert tabs.active_tab_name == ""
+
+
+def test_range_clicked_action_sets_active_tab():
+    tabs = make_tabs()
+    asyncio.run(tabs.action_range_clicked("Contact"))
+    assert tabs.active_tab_name == "Contact"
+
+
+def test_inactive_label_carries_click_action_and_active_does_not():
+    tabs = make_tabs()
+    row = label_row_clicks(tabs.render())
+    assert [click for text, click in row if text == "Home"] == [None]
+    assert [click for text, click in row if text == "About Us"] == [
+        "range_clicked('about')"
+    ]
+
+
+def test_two_rows_labels_then_underline():
+    lines = plain_lines(make_tabs().render())
+    assert len(lines) == 2
+    assert "Home" in lines[0]
+    assert "About Us" in lines[0]
+    assert set(lines[1]) <= set("━╸╺")
+
+
+def test_no_tabs_draws_only_full_width_underline():
+    assert plain_lines(Tabs([]).render()) == ["━" * 100]
+
+
+def test_fixed_tab_padding_sizes():
+    tabs = [Tab("ab"), Tab("c")]
+    renderable = TabsRenderable(
+        tabs=tabs,
+        active_tab_name="ab",
+        bar_position=0.0,
+        active_tab_style="#f0f0f0 on #021720",
+        active_bar_style="#1BB152",
+        inactive_tab_style="#f0f0f0 on #021720",
+        inactive_bar_style="#455058",
+        inactive_text_opacity=0.5,
+        tab_padding=2,
+    )
+    assert renderable._tab_sizes(tabs, 20) == [(2, 2, 2), (2, 1, 2)]
