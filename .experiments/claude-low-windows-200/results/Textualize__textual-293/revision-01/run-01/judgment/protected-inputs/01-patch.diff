diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..6010cee
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,438 @@
+from __future__ import annotations
+
+import math
+from typing import Any, Iterable, Optional, Union
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+DIGIT_KEYS = "0123456789"
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __str__(self) -> str:
+        return self.label
+
+
+class _Edge:
+    """A flexible or fixed-size edge, as consumed by ``layout_resolve``."""
+
+    def __init__(
+        self, size: int | None = None, min_size: int = 1, fraction: int = 1
+    ) -> None:
+        self.size = size
+        self.min_size = min_size
+        self.fraction = fraction
+
+
+class TabsRenderable:
+    """Renders the label row and the underline row of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The tabs to render. Tabs sharing a name keep only the
+            last one.
+        active_tab_name (str): The name of the active tab.
+        bar_position (float): Fractional tab index that places the underline.
+        active_tab_style (StyleType): The style of the active label.
+        active_bar_style (StyleType): The style of the highlighted part of the
+            underline.
+        inactive_tab_style (StyleType): The style of inactive labels.
+        inactive_bar_style (StyleType): The style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed cells on each side of a label, or ``None``
+            to share the remaining space.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab_name: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_name = active_tab_name
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        # Name-keyed lookup: a later tab with the same name replaces an earlier one
+        tabs = list({tab.name: tab for tab in self.tabs}.values())
+        sizes = self._tab_sizes(tabs, width)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        cursor = 0
+        for tab, (left, label_width, right) in zip(tabs, sizes):
+            label_start = cursor + left
+            label_ranges[tab.name] = (label_start, label_start + label_width)
+            selection_end = cursor + left + label_width + right
+            selection_ranges[tab.name] = (cursor, selection_end)
+            cursor = selection_end
+
+        if tabs:
+            for tab, (left, label_width, right) in zip(tabs, sizes):
+                yield from self._render_tab(
+                    console, options, tab, left, label_width, right
+                )
+            yield Segment.line()
+
+            ordered_labels = [label_ranges[tab.name] for tab in tabs]
+            highlight_range = self._highlight_range(ordered_labels)
+        else:
+            highlight_range = (0, 0)
+
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=console.get_style(self.active_bar_style),
+            background_style=console.get_style(self.inactive_bar_style),
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+    def _tab_sizes(self, tabs: list[Tab], width: int) -> list[tuple[int, int, int]]:
+        """Compute the left padding, label width and right padding of each tab.
+
+        Args:
+            tabs (list[Tab]): The tabs to lay out.
+            width (int): The available width in cells.
+
+        Returns:
+            list[tuple[int, int, int]]: ``(left, label_width, right)`` for each tab.
+        """
+        # Each slot is either a fixed cell count (possibly 0) or an edge to resolve
+        slots: list[Union[int, _Edge]] = []
+        for tab in tabs:
+            label_width = cell_len(tab.label)
+            padding_slot: Union[int, _Edge] = (
+                _Edge() if self.tab_padding is None else self.tab_padding
+            )
+            slots.append(padding_slot)
+            # A zero-size edge would be treated as flexible, so zero stays fixed
+            slots.append(_Edge(size=label_width) if label_width else 0)
+            slots.append(padding_slot)
+
+        edges = [slot for slot in slots if isinstance(slot, _Edge)]
+        resolved = iter(layout_resolve(width, edges) if edges else [])
+        sizes = [slot if isinstance(slot, int) else next(resolved) for slot in slots]
+        return [
+            (sizes[index], sizes[index + 1], sizes[index + 2])
+            for index in range(0, len(sizes), 3)
+        ]
+
+    def _render_tab(
+        self,
+        console: Console,
+        options: ConsoleOptions,
+        tab: Tab,
+        left: int,
+        label_width: int,
+        right: int,
+    ) -> Iterable[Segment]:
+        """Render one tab's padding and label on the label row."""
+        active = tab.name == self.active_tab_name
+        tab_style = self.active_tab_style if active else self.inactive_tab_style
+        # The active label carries no click action; inactive tabs carry their own
+        meta: Optional[dict[str, Any]] = (
+            None if active else {"@click": f"range_clicked({tab.name!r})"}
+        )
+        opacity = None if active else self.inactive_text_opacity
+
+        yield from self._render_text(
+            console, options, " " * left, tab_style, meta, left
+        )
+        yield from self._render_text(
+            console, options, tab.label, tab_style, meta, label_width, opacity
+        )
+        yield from self._render_text(
+            console, options, " " * right, tab_style, meta, right
+        )
+
+    def _render_text(
+        self,
+        console: Console,
+        options: ConsoleOptions,
+        text: str,
+        style: StyleType,
+        meta: Optional[dict[str, Any]],
+        width: int,
+        opacity: Optional[float] = None,
+    ) -> Iterable[Segment]:
+        """Render a single unwrapped piece of text with optional meta and opacity."""
+        if width <= 0:
+            return []
+        renderable: RenderableType = Text(
+            text, style=style, no_wrap=True, overflow="crop", end=""
+        )
+        if meta:
+            renderable.apply_meta(meta)
+        if opacity is not None:
+            renderable = Opacity(renderable, opacity=opacity)
+        return console.render(renderable, options.update(width=width))
+
+    def _highlight_range(
+        self, ordered_labels: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the label range at the current bar position.
+
+        Args:
+            ordered_labels (list[tuple[int, int]]): Label range of each tab, in order.
+
+        Returns:
+            tuple[float, float]: The highlight range in cells.
+        """
+        count = len(ordered_labels)
+        floor_position = math.floor(self.bar_position)
+        index = floor_position % count
+        fraction = self.bar_position - floor_position
+        next_index = (index + 1) % count
+
+        start, end = ordered_labels[index]
+        next_start, next_end = ordered_labels[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab. An unknown name is accepted, and the
+            underline then starts at index 0.
+        active_tab_style (StyleType): The style of the active label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): The style of the highlighted underline. Defaults
+            to ``"#1BB152"``.
+        inactive_tab_style (StyleType): The style of inactive labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): The style of the rest of the underline. Defaults
+            to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where 1.0
+            is fully visible and 0.0 matches the background. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label, or
+            ``None`` to share the remaining width between the paddings. Defaults to
+            ``None``.
+        search_by_first_character (bool): Whether pressing a character key activates
+            the next tab whose label starts with that character. Defaults to ``True``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    can_focus = True
+
+    active_tab_name: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+    ) -> None:
+        super().__init__()
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab is None:
+            initial_name = self.tabs[0].name
+        else:
+            initial_name = active_tab
+        self.active_tab_name = initial_name
+        self.bar_position = float(self.find_tab_by_name(initial_name))
+
+    def watch_active_tab_name(self, active_tab_name: str) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        self.animate(
+            "bar_position",
+            float(self.find_tab_by_name(active_tab_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the index of a tab by its name.
+
+        Args:
+            name (str): The name of the tab.
+
+        Returns:
+            int: The index of the last tab with that name, or 0 if none has it.
+        """
+        index = 0
+        for position, tab in enumerate(self.tabs):
+            if tab.name == name:
+                index = position
+        return index
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self.active_tab_name)
+        self.active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self.active_tab_name)
+        self.active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, character: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around. The comparison is
+        case-insensitive.
+
+        Args:
+            character (str): The character to match at the start of a label.
+        """
+        if not self.tabs or not character:
+            return
+        start = self.find_tab_by_name(self.active_tab_name)
+        count = len(self.tabs)
+        wanted = character.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(wanted):
+                self.active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs. With fewer
+        than ten tabs, it activates the last tab through negative indexing. Numbers
+        beyond the tab count are ignored.
+
+        Args:
+            number (int): The 1-based tab position, or 0.
+        """
+        count = len(self.tabs)
+        if number == 0:
+            index = 9 if count >= 10 else -1
+        else:
+            index = number - 1
+        if -count <= index < count:
+            self.active_tab_name = self.tabs[index].name
+
+    async def action_range_clicked(self, tab_name: str) -> None:
+        """Make the named tab the active tab. Invoked by clicks on a tab's range.
+
+        Args:
+            tab_name (str): The name of the tab to activate.
+        """
+        self.active_tab_name = tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        Every key event is marked handled. With no tabs, nothing else happens.
+        Otherwise:
+
+        - ``escape`` removes focus from the widget.
+        - ``right`` and ``left`` move to the next and previous tab, wrapping at
+          either end.
+        - ``1`` to ``9`` activate the tab at that 1-based position. ``0`` activates the
+          10th tab when there are at least ten tabs, otherwise the last tab. Numbers
+          beyond the tab count are ignored.
+        - Any other single character activates the next tab, after the active one and
+          wrapping, whose label starts with that character, compared case-insensitively.
+          This is skipped when ``search_by_first_character`` is ``False``.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == "escape":
+            await self.app.set_focus(None)
+        elif key == "right":
+            self.activate_next_tab()
+        elif key == "left":
+            self.activate_previous_tab()
+        elif key in DIGIT_KEYS and len(key) == 1:
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab_name=self.active_tab_name,
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
