+    def _apply_clickable_ranges(
+        self, segments: list[Segment], width: int
+    ) -> list[Segment]:
+        """Split segments by column and attach click metadata to clickable spans.
+
+        Args:
+            segments (list[Segment]): The bar segments before click metadata is added.
+            width (int): The width of the bar in cells.
+
+        Returns:
+            list[Segment]: Segments where each clickable span carries its click action.
+        """
+        # Name for each column, or None where no range applies
+        column_names: list[str | None] = [None] * width
+        for name, (start, end) in self.clickable_ranges.items():
+            for column in range(max(int(start), 0), min(int(end), width)):
+                column_names[column] = name
+
+        result: list[Segment] = []
+        column = 0
+        for segment in segments:
+            # The bar characters are single cells, so character index is column offset
+            text = segment.text
+            base_style = segment.style or Style()
+            run_start = 0
+            while run_start < len(text):
+                name = _name_at(column_names, column + run_start)
+                run_end = run_start + 1
+                while (
+                    run_end < len(text)
+                    and _name_at(column_names, column + run_end) == name
+                ):
+                    run_end += 1
+                run_text = text[run_start:run_end]
+                if name is None:
+                    result.append(Segment(run_text, segment.style, segment.control))
+                else:
+                    click = Style.from_meta({"@click": f"range_clicked({name!r})"})
+                    result.append(
+                        Segment(run_text, base_style + click, segment.control)
+                    )
+                run_start = run_end
+            column += len(text)
+        return result
+
+
+def _name_at(column_names: list[str | None], column: int) -> str | None:
+    """Return the clickable name at a column, or None if it is unclaimed."""
+    if 0 <= column < len(column_names):
+        return column_names[column]
+    return None
 
 
