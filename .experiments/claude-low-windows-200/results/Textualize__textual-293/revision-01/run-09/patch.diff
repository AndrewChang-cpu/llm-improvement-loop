@@ -1,3 +1,7 @@
+import io
+
+from rich.console import Console
+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
@@ -124,3 +128,33 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+def test_clickable_ranges_attach_click_action_to_spans():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"one": (0, 2), "two": (3, 5)},
+        width=6,
+    )
+    # Click metadata does not change the visible output.
+    assert render(bar) == (
+        f"{GREY}━{STOP}"
+        f"{GREY}╸{STOP}"
+        f"{MAGENTA}━━{STOP}"
+        f"{GREY}╺{STOP}"
+        f"{GREY}━{STOP}"
+    )
+
+    # Collect the text carried by each click action.
+    console = Console(width=6, file=io.StringIO(), color_system="truecolor")
+    clicks: dict[str, str] = {}
+    for segment in console.render(bar):
+        if segment.style is None:
+            continue
+        click = segment.style.meta.get("@click")
+        if click:
+            clicks[click] = clicks.get(click, "") + segment.text
+    assert clicks == {
+        "range_clicked('one')": "━╸",
+        "range_clicked('two')": "━╺",
+    }
