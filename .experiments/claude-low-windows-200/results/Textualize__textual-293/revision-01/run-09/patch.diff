+def _with_click(style: Style | None, name: str | None) -> Style | None:
+    """Add a ``range_clicked`` click action for ``name`` to a style, if given."""
+    if name is None:
+        return style
+    click_style = Style.from_meta({"@click": f"range_clicked({name!r})"})
+    return (style or Style()) + click_style
