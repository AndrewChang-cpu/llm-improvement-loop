+def test_clickable_ranges_attach_click_action_to_spans():
+    bar = UnderlineBar(
+        highlight_range=(2, 4),
+        clickable_ranges={"home": (0, 2), "files": (4, 6)},
+        width=6,
+    )
+    console = Console(width=6, file=io.StringIO(), color_system="truecolor")
+    segments = list(console.render(bar, console.options))
+
+    actions = []
+    for segment in segments:
+        meta = segment.style.meta if segment.style else {}
+        actions.extend([meta.get("@click")] * len(segment.text))
+
+    assert actions == [
+        "range_clicked('home')",
+        "range_clicked('home')",
+        None,
+        None,
+        "range_clicked('files')",
+        "range_clicked('files')",
+    ]
+    # Click metadata does not change the rendered output.
+    assert render(bar) == render(UnderlineBar(highlight_range=(2, 4), width=6))
diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..37c7fa1
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,60 @@
+import io
+
+from rich.console import Console
+
+from textual.widgets.tabs import Tab, TabsRenderable
+
+
+def plain_lines(renderable, width):
+    """Render a renderable to plain text, one string per line."""
+    console = Console(width=width, file=io.StringIO(), color_system=None)
+    text = "".join(
+        segment.text for segment in console.render(renderable, console.options)
+    )
+    return text.split("\n")
+
+
+def make_renderable(tabs, active_index=0, bar_position=0.0, tab_padding=None):
+    return TabsRenderable(
+        tabs,
+        active_index=active_index,
+        bar_position=bar_position,
+        active_tab_style="red",
+        active_bar_style="green",
+        inactive_tab_style="blue",
+        inactive_bar_style="grey37",
+        inactive_text_opacity=0.5,
+        tab_padding=tab_padding,
+    )
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_explicit_name():
+    tab = Tab("Home", "start")
+    assert tab.name == "start"
+    assert tab.label == "Home"
+
+
+def test_no_tabs_draws_only_full_width_inactive_underline():
+    lines = plain_lines(make_renderable([], active_index=None), width=10)
+    assert lines == ["━" * 10]
+
+
+def test_labels_with_fixed_padding_and_underline_row():
+    tabs = [Tab("Home"), Tab("Files")]
+    lines = plain_lines(make_renderable(tabs, tab_padding=1), width=20)
+    assert lines[0] == " Home  Files "
+    assert len(lines) == 2
+    assert len(lines[1]) == 20
+
+
+def test_labels_with_flexible_padding_fill_width():
+    tabs = [Tab("Home"), Tab("Files")]
+    lines = plain_lines(make_renderable(tabs), width=20)
+    assert len(lines[0]) == 20
+    assert "Home" in lines[0] and "Files" in lines[0]
