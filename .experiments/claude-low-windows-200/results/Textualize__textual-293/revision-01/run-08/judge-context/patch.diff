+def _apply_clickable_ranges(
+    segments: Iterable[Segment], clickable_ranges: Mapping[str, tuple[int, int]]
+) -> Iterator[Segment]:
+    """Split bar segments so cells in each clickable range carry a click action.
+
+    Every bar cell is one column wide, so column indices are counted per character.
+
+    Args:
+        segments (Iterable[Segment]): The bar segments, in column order.
+        clickable_ranges (Mapping[str, tuple[int, int]]): Named ``(start, end)`` spans.
+
+    Returns:
+        Iterator[Segment]: Segments with ``@click`` metadata where needed.
+    """
+    column_actions: dict[int, str] = {}
+    for name, (start, end) in clickable_ranges.items():
+        action = f"range_clicked({name!r})"
+        for column in range(int(start), int(end)):
+            column_actions[column] = action
+
+    column = 0
+    for segment in segments:
+        text, style, control = segment
+        if control or not text:
+            yield segment
+            continue
+        run_start = 0
+        run_action = column_actions.get(column)
+        for index in range(1, len(text)):
+            action = column_actions.get(column + index)
+            if action != run_action:
+                yield Segment(
+                    text[run_start:index],
+                    _with_click(style, run_action),
+                )
+                run_start = index
+                run_action = action
+        yield Segment(text[run_start:], _with_click(style, run_action))
+        column += len(text)
+
+
+def _with_click(style: Style | None, action: str | None) -> Style | None:
+    """Return ``style`` with a ``@click`` action merged into its metadata."""
+    if action is None:
+        return style
+    click_style = Style(meta={"@click": action})
+    return click_style if style is None else style + click_style
+
+
