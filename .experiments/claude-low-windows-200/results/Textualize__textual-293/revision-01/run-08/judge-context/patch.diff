@@ -0,0 +1,26 @@
+from textual import events
+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemo(App):
+    """Sandbox application for the Tabs widget."""
+
+    def on_mount(self) -> None:
+        self.mount(
+            tabs=Tabs(
+                [
+                    Tab("Home"),
+                    Tab("Files"),
+                    Tab("Settings", "prefs"),
+                    Tab("Help"),
+                ],
+                active_tab="Files",
+            )
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        await self.dispatch_key(event)
+
+
+TabsDemo.run(css_file="tabs_demo.css", log="textual.log")
