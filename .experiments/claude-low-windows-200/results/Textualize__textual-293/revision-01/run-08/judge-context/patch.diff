diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..cb1dc9a
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,436 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Iterator, NamedTuple, Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab with a display label and a name that identifies it.
+
+    Args:
+        label (str): The text shown for the tab.
+        name (str, optional): The name used to select the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _TabEdge:
+    """A layout edge for the layout resolver, for one padding or label run."""
+
+    size: int | None = None
+    fraction: int = 1
+    min_size: int = 1
+
+
+class _TabSpan(NamedTuple):
+    """Column positions of one tab. Ends are exclusive."""
+
+    selection_start: int
+    label_start: int
+    label_end: int
+    selection_end: int
+
+
+class TabsRenderable:
+    """Renders the label row and the underline bar of a Tabs widget.
+
+    Args:
+        tabs (Sequence[Tab]): The tabs to draw.
+        active_index (int | None): Index of the active tab, or ``None`` if none.
+        bar_position (float): Fractional tab index that places the underline.
+        active_tab_style (StyleType): Style of the active tab label.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of the inactive tab labels.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int | None): Fixed cells on each side of a label, or ``None`` to
+            fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_index: int | None,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = list(tabs)
+        self.active_index = active_index
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        if not self.tabs:
+            bar = UnderlineBar(
+                highlight_style=active_bar_style,
+                background_style=inactive_bar_style,
+                width=width,
+            )
+            yield from console.render(bar, options)
+            return
+
+        spans = self._tab_spans(width)
+        yield from self._label_segments(console, options, spans)
+        yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(spans),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges={
+                tab.name: (span.selection_start, span.selection_end)
+                for tab, span in zip(self.tabs, spans)
+            },
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+    def _padding_edge(self) -> _TabEdge | None:
+        """Describe the padding on one side of a label, or ``None`` for no space."""
+        if self.tab_padding is None:
+            return _TabEdge(size=None, fraction=1, min_size=1)
+        if self.tab_padding > 0:
+            return _TabEdge(size=self.tab_padding)
+        return None
+
+    def _tab_spans(self, width: int) -> list[_TabSpan]:
+        """Compute the label and selection ranges of every tab, in cells."""
+        label_widths = [cell_len(tab.label) for tab in self.tabs]
+
+        # Each tab contributes: left padding, label, right padding.
+        # Zero-sized entries are left out of the resolver, since a size of 0 would
+        # otherwise be treated as flexible.
+        entries: list[_TabEdge | None] = []
+        for label_width in label_widths:
+            entries.append(self._padding_edge())
+            entries.append(_TabEdge(size=label_width) if label_width else None)
+            entries.append(self._padding_edge())
+
+        resolved = iter(
+            layout_resolve(width, [entry for entry in entries if entry is not None])
+        )
+        sizes = [next(resolved) if entry is not None else 0 for entry in entries]
+
+        spans: list[_TabSpan] = []
+        cursor = 0
+        for index in range(len(self.tabs)):
+            left, label, right = sizes[index * 3 : index * 3 + 3]
+            label_start = cursor + left
+            label_end = label_start + label
+            selection_end = label_end + right
+            spans.append(_TabSpan(cursor, label_start, label_end, selection_end))
+            cursor = selection_end
+        return spans
+
+    def _highlight_range(self, spans: list[_TabSpan]) -> tuple[float, float]:
+        """Interpolate the highlighted label range for the fractional bar position."""
+        position = self.bar_position
+        floor = math.floor(position)
+        fraction = position - floor
+        count = len(spans)
+        current = spans[floor % count]
+        following = spans[(floor + 1) % count]
+        start = current.label_start + (
+            following.label_start - current.label_start
+        ) * fraction
+        end = current.label_end + (following.label_end - current.label_end) * fraction
+        return start, end
+
+    def _label_segments(
+        self, console: Console, options: ConsoleOptions, spans: list[_TabSpan]
+    ) -> Iterator[Segment]:
+        """Yield the segments of the label row."""
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+
+        for index, (tab, span) in enumerate(zip(self.tabs, spans)):
+            is_active = index == self.active_index
+            # The active tab carries no click action; inactive tabs carry their own.
+            padding_style = (
+                None
+                if is_active
+                else Style(meta={"@click": f"range_clicked({tab.name!r})"})
+            )
+            left = span.label_start - span.selection_start
+            right = span.selection_end - span.label_end
+            label_width = span.label_end - span.label_start
+
+            if left:
+                yield Segment(" " * left, padding_style)
+
+            if label_width:
+                if is_active:
+                    text = Text(
+                        tab.label, style=active_style, no_wrap=True, end=""
+                    )
+                    renderable: RenderableType = text
+                else:
+                    text = Text(
+                        tab.label, style=inactive_style, no_wrap=True, end=""
+                    )
+                    text.apply_meta({"@click": f"range_clicked({tab.name!r})"})
+                    renderable = Opacity(text, opacity=self.inactive_text_opacity)
+                yield from console.render(
+                    renderable, options.update_width(label_width)
+                )
+
+            if right:
+                yield Segment(" " * right, padding_style)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The widget is two rows high. The first row shows the tab labels, and the
+    second row shows the underline, which highlights the active tab.
+
+    Tabs can be selected with the left and right keys, the digit keys, a letter
+    key, or the mouse. Each tab is identified by its name.
+
+    Args:
+        tabs (list[Tab]): The tabs to show. May be empty.
+        active_tab (str, optional): The name of the initially active tab. Defaults to
+            ``None``, which selects the first tab.
+        active_tab_style (StyleType): Style of the active tab label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of the inactive tab labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            ``1.0`` shows the text fully. Defaults to ``0.5``.
+        animation_duration (float): Duration of the underline animation, in seconds.
+            Defaults to ``0.3``.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label.
+            Defaults to ``None``, which spreads the remaining width across the padding.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to ``True``.
+        name (str, optional): The widget name. Defaults to ``None``.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    active_tab_name: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+    ) -> None:
+        super().__init__(name=name)
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab is not None:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        self.bar_position = float(self.find_tab_by_name(initial_name))
+        self.active_tab_name = initial_name
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            self.tabs,
+            active_index=self._index_of_name(self.active_tab_name),
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
+
+    def _index_of_name(self, name: str) -> int | None:
+        """Return the index of the last tab with the given name, or ``None``."""
+        found: int | None = None
+        for index, tab in enumerate(self.tabs):
+            if tab.name == name:
+                found = index
+        return found
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the index of a tab by its name.
+
+        If several tabs share the name, the index of the last one is returned,
+        matching the lookup used for rendering and clicks.
+
+        Args:
+            name (str): The name of the tab.
+
+        Returns:
+            int: The index of the tab, or ``0`` if no tab has that name.
+        """
+        index = self._index_of_name(name)
+        return 0 if index is None else index
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping to the first tab after the last."""
+        index = self.find_tab_by_name(self.active_tab_name)
+        self.active_tab_name = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping to the last tab before the first."""
+        index = self.find_tab_by_name(self.active_tab_name)
+        self.active_tab_name = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_first_char(self, character: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab and wraps around. The comparison
+        ignores case. If no label matches, the active tab does not change.
+
+        Args:
+            character (str): The character to search for.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        start = self.find_tab_by_name(self.active_tab_name)
+        needle = character.casefold()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.casefold().startswith(needle):
+                self.active_tab_name = tab.name
+                return
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number ``0`` selects the 10th tab when there are at least ten tabs.
+        With fewer tabs it selects the last tab. Numbers outside the tab count
+        are ignored.
+
+        Args:
+            number (int): The tab number.
+        """
+        count = len(self.tabs)
+        if not count:
+            return
+        if number == 0:
+            index = 9 if count >= 10 else count - 1
+        else:
+            index = number - 1
+        if 0 <= index < count:
+            self.active_tab_name = self.tabs[index].name
+
+    async def action_range_clicked(self, name: str) -> None:
+        """Make the tab with the given name the active tab.
+
+        This is the action run by a click on a tab, and it is not meant to be
+        called directly.
+
+        Args:
+            name (str): The name of the tab to activate.
+        """
+        self.active_tab_name = name
+
+    async def watch_active_tab_name(self, name: str) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        self.animate(
+            "bar_position",
+            float(self.find_tab_by_name(name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus.
+
+        Every key event is marked handled. With no tabs, nothing else happens.
+        Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digit keys 1 to 9 activate the tab at that position. The key 0
+          activates the 10th tab if there are ten or more tabs, and the last tab
+          otherwise. Digits beyond the tab count are ignored.
+        - Any other single character activates the next tab, after the active one
+          and wrapping, whose label starts with that character, ignoring case.
+          This is only done when ``search_by_first_character`` is true.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
