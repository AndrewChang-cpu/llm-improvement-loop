diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..b3bd8ee
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,443 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderResult, RenderableType
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+DIGITS = "0123456789"
+
+
+@dataclass
+class Tab:
+    """A tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name identifying the tab. Defaults to the label.
+    """
+
+    label: str
+    name: str | None = None
+
+    def __post_init__(self) -> None:
+        if self.name is None:
+            self.name = self.label
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _Edge:
+    """A horizontal span for the layout resolver.
+
+    Args:
+        size (int, optional): A fixed size in cells, or ``None`` for a flexible edge.
+        min_size (int): The minimum size of a flexible edge. Defaults to 1.
+        fraction (int): The share of remaining space for a flexible edge. Defaults to 1.
+    """
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _resolve_sizes(total: int, edges: list[_Edge]) -> list[int]:
+    """Resolve edge sizes, keeping zero-sized edges as zero.
+
+    The layout resolver treats a size of zero as flexible, so zero-sized edges are
+    removed before resolving and given a size of zero afterwards.
+
+    Args:
+        total (int): The total number of cells available.
+        edges (list[_Edge]): The edges to resolve, in order.
+
+    Returns:
+        list[int]: The resolved size of each edge, in the same order.
+    """
+    flexible = [edge for edge in edges if edge.size != 0]
+    resolved = iter(layout_resolve(total, flexible))
+    return [0 if edge.size == 0 else next(resolved) for edge in edges]
+
+
+class TabsRenderable:
+    """Renders the label row and the underline row of a Tabs widget.
+
+    Args:
+        tabs (list[Tab]): The tabs to display.
+        active_tab (str): The name of the active tab.
+        bar_position (float): The fractional tab index that places the underline.
+        active_tab_style (StyleType): Style of the active label.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of inactive labels.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding in cells on each side of a label,
+            or ``None`` to fit the padding to the available width.
+    """
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab = active_tab
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        if not self.tabs:
+            bar = UnderlineBar(background_style=inactive_bar_style, width=width)
+            yield from console.render(bar, options)
+            return
+
+        # Names are keyed, so a repeated name renders only its last tab.
+        rendered_tabs = list({tab.name: tab for tab in self.tabs}.values())
+
+        edges: list[_Edge] = []
+        for tab in rendered_tabs:
+            edges.append(_Edge(size=self.tab_padding))
+            edges.append(_Edge(size=cell_len(tab.label)))
+            edges.append(_Edge(size=self.tab_padding))
+        sizes = _resolve_sizes(width, edges)
+
+        label_ranges: dict[str, tuple[int, int]] = {}
+        selection_ranges: dict[str, tuple[int, int]] = {}
+        row: list[Segment] = []
+        cursor = 0
+        for index, tab in enumerate(rendered_tabs):
+            left, label_size, right = sizes[index * 3 : index * 3 + 3]
+            is_active = tab.name == self.active_tab
+            tab_style = console.get_style(
+                self.active_tab_style if is_active else self.inactive_tab_style
+            )
+            click_style = (
+                None
+                if is_active
+                else Style(meta={"@click": f"range_clicked({tab.name!r})"})
+            )
+
+            selection_start = cursor
+            label_start = cursor + left
+            label_end = label_start + label_size
+            selection_end = label_end + right
+            label_ranges[tab.name] = (label_start, label_end)
+            selection_ranges[tab.name] = (selection_start, selection_end)
+
+            label_segments: list[Segment] = []
+            if label_size:
+                label = Text(
+                    tab.label,
+                    style=tab_style,
+                    no_wrap=True,
+                    overflow="crop",
+                    end="",
+                )
+                renderable: RenderableType = label
+                if not is_active:
+                    renderable = Opacity(label, opacity=self.inactive_text_opacity)
+                label_segments = Segment.adjust_line_length(
+                    list(console.render(renderable, options.update_width(label_size))),
+                    label_size,
+                )
+
+            padding_style = tab_style
+            if click_style is not None:
+                padding_style = tab_style + click_style
+                label_segments = [
+                    Segment(
+                        segment.text,
+                        (segment.style or Style()) + click_style,
+                        segment.control,
+                    )
+                    for segment in label_segments
+                ]
+
+            if left:
+                row.append(Segment(" " * left, padding_style))
+            row.extend(label_segments)
+            if right:
+                row.append(Segment(" " * right, padding_style))
+            cursor = selection_end
+
+        highlight_range = self._highlight_range(label_ranges)
+        bar = UnderlineBar(
+            highlight_range=highlight_range,
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges=selection_ranges,
+            width=width,
+        )
+
+        yield from Segment.adjust_line_length(row, width)
+        yield Segment.line()
+        yield from console.render(bar, options)
+
+    def _highlight_range(
+        self, label_ranges: dict[str, tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the label ranges around the bar position.
+
+        Args:
+            label_ranges (dict[str, tuple[int, int]]): Label ranges keyed by tab name.
+
+        Returns:
+            tuple[float, float]: The highlighted column range.
+        """
+        count = len(self.tabs)
+        index = min(max(math.floor(self.bar_position), 0), count - 1)
+        fraction = min(max(self.bar_position - index, 0.0), 1.0)
+        next_index = (index + 1) % count
+
+        start, end = label_ranges[self.tabs[index].name]
+        next_start, next_end = label_ranges[self.tabs[next_index].name]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline bar.
+
+    The first row shows the tab labels and the second row shows the underline. A tab
+    is selected with the keyboard or by clicking its label or the underline below it.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order. May be empty.
+        active_tab (str, optional): The name of the tab to activate initially. Defaults
+            to the first tab. An unknown name is accepted and the bar starts at index 0.
+        active_tab_style (StyleType): Style of the active label. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive labels. Defaults to
+            ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline. Defaults to
+            ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where
+            1.0 keeps the full label color. Defaults to 0.5.
+        animation_duration (float): Duration of the underline animation in seconds.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function for the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed padding in cells on each side of a label.
+            Defaults to ``None``, which fits the padding to the available width.
+        search_by_first_character (bool): Whether pressing a letter key activates the
+            next tab whose label starts with that letter. Defaults to True.
+        name (str, optional): The name of the widget. Defaults to None.
+        id (str, optional): The DOM id of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = """
+    height: 2;
+    """
+
+    active_tab: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+        id: str | None = None,
+    ) -> None:
+        self.tabs = tabs
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+        super().__init__(name=name, id=id)
+
+        if not tabs:
+            initial_tab = ""
+        elif active_tab is None:
+            initial_tab = tabs[0].name or ""
+        else:
+            initial_tab = active_tab
+        # Set the position directly so the initial state is not animated.
+        self.bar_position = float(self.find_tab_by_name(initial_tab))
+        self.active_tab = initial_tab
+
+    async def watch_active_tab(self, active_tab: str) -> None:
+        """Animate the underline to the index of the newly active tab."""
+        self.animate(
+            "bar_position",
+            float(self.find_tab_by_name(active_tab)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the index of a tab by its name.
+
+        If several tabs share the name, the index of the last one is returned.
+
+        Args:
+            name (str): The name of the tab.
+
+        Returns:
+            int: The index of the tab, or 0 if no tab has that name.
+        """
+        index = 0
+        for position, tab in enumerate(self.tabs):
+            if tab.name == name:
+                index = position
+        return index
+
+    def activate_next_tab(self) -> None:
+        """Activate the next tab, wrapping from the last tab to the first."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index + 1) % len(self.tabs)].name or ""
+
+    def activate_previous_tab(self) -> None:
+        """Activate the previous tab, wrapping from the first tab to the last."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index - 1) % len(self.tabs)].name or ""
+
+    def activate_tab_by_first_char(self, character: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and ignores case.
+
+        Args:
+            character (str): The character to match at the start of a label.
+        """
+        if not self.tabs or not character:
+            return
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self.active_tab)
+        target = character.lower()
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(target):
+                self.active_tab = tab.name or ""
+                return
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate a tab by its 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs. With
+        fewer tabs, it resolves to the last tab through negative indexing. Numbers
+        beyond the tab count are ignored.
+
+        Args:
+            number (int): The tab number.
+        """
+        if not self.tabs:
+            return
+        index = 9 if number == 0 and len(self.tabs) >= 10 else number - 1
+        if not -len(self.tabs) <= index < len(self.tabs):
+            return
+        self.active_tab = self.tabs[index].name or ""
+
+    async def action_range_clicked(self, name: str) -> None:
+        """Activate the tab with the given name.
+
+        Args:
+            name (str): The name of the tab to activate.
+        """
+        self.active_tab = name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus. Every key event is marked handled.
+
+        With no tabs, nothing else happens. Otherwise:
+
+        - Escape removes focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digits 1 to 9 activate the tab at that 1-based position, and 0 activates
+          the 10th tab when there are at least ten tabs. Digits beyond the tab count
+          are ignored.
+        - Any other single character activates the next tab, after the active one and
+          wrapping, whose label starts with that character, ignoring case. This is
+          skipped when ``search_by_first_character`` is False.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.stop()
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in DIGITS:
+            self.activate_tab_by_number(int(key))
+        elif len(key) == 1 and self.search_by_first_character:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        """Render the label row and the underline row.
+
+        Returns:
+            RenderableType: A TabsRenderable for the current state.
+        """
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab=self.active_tab,
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
