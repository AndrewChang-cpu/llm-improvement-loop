+++ b/tests/renderables/test_underline_bar.py
@@ -1,3 +1,7 @@
+import io
+
+from rich.console import Console
+
 from tests.utilities.render import render
 from textual.renderables.underline_bar import UnderlineBar
 
@@ -124,3 +128,18 @@ def test_custom_styles():
         f"{GREEN}╺{STOP}"
         f"{GREEN}━{STOP}"
     )
+
+
+def test_clickable_ranges_attach_click_action_to_spans():
+    bar = UnderlineBar(width=6, clickable_ranges={"home": (1, 3)})
+    console = Console(
+        width=100, file=io.StringIO(), color_system="truecolor", legacy_windows=False
+    )
+    segments = list(console.render(bar, console.options))
+
+    assert "".join(segment.text for segment in segments) == "━" * 6
+    clicked = [s for s in segments if s.style is not None and s.style.meta]
+    assert [segment.text for segment in clicked] == ["━━"]
+    assert clicked[0].style.meta == {"@click": "range_clicked('home')"}
+    # Click metadata adds no escape codes, so the rendered text is unchanged.
+    assert render(bar) == render(UnderlineBar(width=6))
