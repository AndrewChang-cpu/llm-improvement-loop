+from textual.app import App
+from textual.widgets.tabs import Tab, Tabs
+
+
+class TabsDemoApp(App):
+    """Sandbox application for trying the Tabs widget."""
+
+    def on_mount(self):
+        """Build the layout."""
+        tabs = [
+            Tab("Home"),
+            Tab("Files", name="files"),
+            Tab("Settings"),
+            Tab("Help"),
+        ]
+        self.mount(tabs=Tabs(tabs, active_tab="files"))
+
+
+TabsDemoApp.run(css_file="tabs_demo.css", log="textual.log")
