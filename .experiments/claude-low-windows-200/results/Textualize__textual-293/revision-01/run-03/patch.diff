+from tests.utilities.render import render
+from textual.renderables.underline_bar import UnderlineBar
+from textual.widgets.tabs import Tab, Tabs, TabsRenderable
+
+
+def make_tabs(labels, **kwargs) -> Tabs:
+    return Tabs([Tab(label) for label in labels], **kwargs)
+
+
+def test_tab_name_defaults_to_label():
+    tab = Tab("Home")
+    assert tab.name == "Home"
+    assert str(tab) == "Home"
+
+
+def test_tab_explicit_name():
+    tab = Tab("Home", name="start")
+    assert tab.name == "start"
+    assert str(tab) == "Home"
+
+
+def test_initial_active_tab_defaults_to_first():
+    tabs = make_tabs(["Home", "Files", "Help"])
+    assert tabs.active_tab == "Home"
+    assert tabs.bar_position == 0.0
+
+
+def test_initial_active_tab_by_name():
+    tabs = make_tabs(["Home", "Files", "Help"], active_tab="Help")
+    assert tabs.active_tab == "Help"
+    assert tabs.bar_position == 2.0
+
+
+def test_unknown_active_tab_falls_back_to_index_zero():
+    tabs = make_tabs(["Home", "Files"], active_tab="nope")
+    assert tabs.active_tab == "nope"
+    assert tabs.bar_position == 0.0
+
+
+def test_no_tabs_has_no_active_tab():
+    tabs = Tabs([])
+    assert tabs.active_tab == ""
+    assert tabs.bar_position == 0.0
+
+
+def test_find_tab_by_name():
+    tabs = make_tabs(["Home", "Files", "Help"])
+    assert tabs.find_tab_by_name("Files") == 1
+    assert tabs.find_tab_by_name("missing") == 0
+
+
+def test_next_and_previous_wrap():
+    tabs = make_tabs(["A", "B", "C"], active_tab="C")
+    tabs.activate_next_tab()
+    assert tabs.active_tab == "A"
+    tabs.activate_previous_tab()
+    assert tabs.active_tab == "C"
+
+
+def test_activate_tab_by_number():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.activate_tab_by_number(2)
+    assert tabs.active_tab == "B"
+
+
+def test_activate_tab_by_number_beyond_count_is_ignored():
+    tabs = make_tabs(["A", "B", "C"], active_tab="B")
+    tabs.activate_tab_by_number(5)
+    assert tabs.active_tab == "B"
+
+
+def test_zero_resolves_to_last_tab_with_fewer_than_ten():
+    tabs = make_tabs(["A", "B", "C"])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab == "C"
+
+
+def test_zero_activates_tenth_tab_with_ten_or_more():
+    tabs = make_tabs([str(number) for number in range(1, 13)])
+    tabs.activate_tab_by_number(0)
+    assert tabs.active_tab == "10"
+
+
+def test_first_char_search_is_case_insensitive_and_wraps():
+    tabs = make_tabs(["Apple", "Banana", "avocado"], active_tab="Apple")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs.active_tab == "avocado"
+    tabs.activate_tab_by_first_char("A")
+    assert tabs.active_tab == "Apple"
+
+
+def test_first_char_search_starts_after_active_tab():
+    tabs = make_tabs(["Apple", "Banana", "Avocado"], active_tab="Avocado")
+    tabs.activate_tab_by_first_char("a")
+    assert tabs.active_tab == "Apple"
+
+
+def test_renderable_with_no_tabs_draws_only_inactive_bar():
+    output = render(
+        TabsRenderable(
+            tabs=[],
+            active_tab="",
+            bar_position=0.0,
+            active_tab_style="#f0f0f0 on #021720",
+            active_bar_style="#1BB152",
+            inactive_tab_style="#f0f0f0 on #021720",
+            inactive_bar_style="#455058",
+            inactive_text_opacity=0.5,
+            tab_padding=None,
+        )
+    )
+    assert output == render(UnderlineBar(background_style="#455058"))
+
+
+def test_renderable_draws_labels_above_bar():
+    tabs = make_tabs(["Home", "Files"])
+    output = render(
+        TabsRenderable(
+            tabs=tabs.tabs,
+            active_tab="Home",
+            bar_position=0.0,
+            active_tab_style="#f0f0f0 on #021720",
+            active_bar_style="#1BB152",
+            inactive_tab_style="#f0f0f0 on #021720",
+            inactive_bar_style="#455058",
+            inactive_text_opacity=0.5,
+            tab_padding=None,
+        )
+    )
+    label_row, bar_row = output.split("\n")
+    assert "Home" in label_row
+    assert "Files" in label_row
+    assert "Home" not in bar_row
