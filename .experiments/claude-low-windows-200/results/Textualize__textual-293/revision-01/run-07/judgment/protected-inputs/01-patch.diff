diff --git a/src/textual/widgets/tabs.py b/src/textual/widgets/tabs.py
new file mode 100644
index 0000000..8e03a63
--- /dev/null
+++ b/src/textual/widgets/tabs.py
@@ -0,0 +1,417 @@
+from __future__ import annotations
+
+import math
+from dataclasses import dataclass
+from typing import Sequence
+
+from rich.cells import cell_len
+from rich.console import Console, ConsoleOptions, RenderableType, RenderResult
+from rich.segment import Segment
+from rich.style import Style, StyleType
+from rich.text import Text
+
+from .. import events
+from .._layout_resolve import layout_resolve
+from ..keys import Keys
+from ..reactive import Reactive
+from ..renderables.opacity import Opacity
+from ..renderables.underline_bar import UnderlineBar
+from ..widget import Widget
+
+__all__ = ["Tab", "Tabs"]
+
+
+class Tab:
+    """A tab with a display label and a name used to identify it.
+
+    Args:
+        label (str): The text displayed for the tab.
+        name (str, optional): The name that identifies the tab. Defaults to the label.
+    """
+
+    def __init__(self, label: str, name: str | None = None) -> None:
+        self.label = label
+        self.name = label if name is None else name
+
+    def __str__(self) -> str:
+        return self.label
+
+
+@dataclass
+class _PaddingEdge:
+    """Edge description for the layout resolver: one flexible padding span.
+
+    Attributes:
+        size (int | None): Fixed size in cells, or None when flexible.
+        min_size (int): Minimum size in cells for a flexible edge.
+        fraction (int): Share of the remaining space for a flexible edge.
+    """
+
+    size: int | None = None
+    min_size: int = 1
+    fraction: int = 1
+
+
+def _last_tab_per_name(tabs: Sequence[Tab]) -> list[Tab]:
+    """Keep only the last tab for each name, preserving the position of that tab."""
+    seen: set[str] = set()
+    kept: list[Tab] = []
+    for tab in reversed(tabs):
+        if tab.name not in seen:
+            seen.add(tab.name)
+            kept.append(tab)
+    kept.reverse()
+    return kept
+
+
+class TabsRenderable:
+    """Renders the label row of a Tabs widget, followed by its underline bar.
+
+    Args:
+        tabs (Sequence[Tab]): The tabs to draw. Tabs sharing a name keep only the
+            last one.
+        active_tab (str): The name of the active tab.
+        bar_position (float): Fractional tab index that places the underline.
+        active_tab_style (StyleType): Style of the active label.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+        inactive_tab_style (StyleType): Style of each inactive label.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels.
+        tab_padding (int, optional): Fixed padding cells on each side of a label, or
+            ``None`` to share the remaining width between the paddings.
+    """
+
+    def __init__(
+        self,
+        tabs: Sequence[Tab],
+        active_tab: str,
+        bar_position: float,
+        active_tab_style: StyleType,
+        active_bar_style: StyleType,
+        inactive_tab_style: StyleType,
+        inactive_bar_style: StyleType,
+        inactive_text_opacity: float,
+        tab_padding: int | None,
+    ) -> None:
+        self.tabs = _last_tab_per_name(tabs)
+        self.active_tab = active_tab
+        self.bar_position = bar_position
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.tab_padding = tab_padding
+
+    def _layout(
+        self, width: int
+    ) -> tuple[list[tuple[int, int]], list[tuple[int, int]]]:
+        """Compute label and selection ranges for each rendered tab.
+
+        Args:
+            width (int): The available width in cells.
+
+        Returns:
+            tuple: ``(label_ranges, selection_ranges)``, each a list of ``(start, end)``
+                column pairs in tab order. A selection range includes the padding.
+        """
+        label_widths = [cell_len(tab.label) for tab in self.tabs]
+        padding_count = 2 * len(self.tabs)
+        if self.tab_padding is None:
+            remaining = width - sum(label_widths)
+            paddings = layout_resolve(
+                remaining, [_PaddingEdge() for _ in range(padding_count)]
+            )
+        else:
+            paddings = [self.tab_padding] * padding_count
+
+        label_ranges: list[tuple[int, int]] = []
+        selection_ranges: list[tuple[int, int]] = []
+        column = 0
+        for index, label_width in enumerate(label_widths):
+            left = paddings[2 * index]
+            right = paddings[2 * index + 1]
+            label_start = column + left
+            label_ranges.append((label_start, label_start + label_width))
+            column = label_start + label_width + right
+            selection_ranges.append((label_ranges[-1][0] - left, column))
+        return label_ranges, selection_ranges
+
+    def _highlight_range(
+        self, label_ranges: list[tuple[int, int]]
+    ) -> tuple[float, float]:
+        """Interpolate the highlight between the floor tab and the next one.
+
+        The next tab wraps to the first tab after the last.
+        """
+        count = len(label_ranges)
+        if not count:
+            return (0, 0)
+        position = min(max(self.bar_position, 0.0), float(count - 1))
+        index = int(math.floor(position))
+        fraction = position - index
+        next_index = (index + 1) % count
+        start, end = label_ranges[index]
+        next_start, next_end = label_ranges[next_index]
+        return (
+            start + (next_start - start) * fraction,
+            end + (next_end - end) * fraction,
+        )
+
+    def _tab_text(self, tab: Tab, left: int, right: int, style: Style) -> Text:
+        text = Text(end="", no_wrap=True, overflow="crop")
+        text.append(" " * left, style=style)
+        text.append(tab.label, style=style)
+        text.append(" " * right, style=style)
+        return text
+
+    def __rich_console__(
+        self, console: Console, options: ConsoleOptions
+    ) -> RenderResult:
+        width = options.max_width
+        active_style = console.get_style(self.active_tab_style)
+        inactive_style = console.get_style(self.inactive_tab_style)
+        active_bar_style = console.get_style(self.active_bar_style)
+        inactive_bar_style = console.get_style(self.inactive_bar_style)
+
+        label_ranges, selection_ranges = self._layout(width)
+
+        if self.tabs:
+            for tab, (label_start, label_end), (sel_start, sel_end) in zip(
+                self.tabs, label_ranges, selection_ranges
+            ):
+                left = label_start - sel_start
+                right = sel_end - label_end
+                renderable: RenderableType
+                if tab.name == self.active_tab:
+                    renderable = self._tab_text(tab, left, right, active_style)
+                else:
+                    click_style = inactive_style + Style(
+                        meta={"@click": f"range_clicked({tab.name!r})"}
+                    )
+                    renderable = Opacity(
+                        self._tab_text(tab, left, right, click_style),
+                        opacity=self.inactive_text_opacity,
+                    )
+                yield from console.render(renderable, options)
+            yield Segment.line()
+
+        bar = UnderlineBar(
+            highlight_range=self._highlight_range(label_ranges),
+            highlight_style=active_bar_style,
+            background_style=inactive_bar_style,
+            clickable_ranges={
+                tab.name: selection
+                for tab, selection in zip(self.tabs, selection_ranges)
+            },
+            width=width,
+        )
+        yield from console.render(bar, options)
+
+
+class Tabs(Widget):
+    """A horizontal row of tabs with an animated underline under the active tab.
+
+    Tabs are selected with the keyboard (left, right, escape, digits, and letter
+    search) or with the mouse. The Tabs widget is two rows high: labels on the first
+    row, the underline on the second.
+
+    Args:
+        tabs (list[Tab]): The tabs to display, in order.
+        active_tab (str, optional): The name of the initially active tab. If absent, the
+            first tab is active. An unknown name is accepted and selects index 0 for the
+            underline. Defaults to None.
+        active_tab_style (StyleType): Style of the active tab label.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        active_bar_style (StyleType): Style of the highlighted part of the underline.
+            Defaults to ``"#1BB152"``.
+        inactive_tab_style (StyleType): Style of inactive tab labels.
+            Defaults to ``"#f0f0f0 on #021720"``.
+        inactive_bar_style (StyleType): Style of the rest of the underline.
+            Defaults to ``"#455058"``.
+        inactive_text_opacity (float): Blend ratio applied to inactive labels, where 1.0
+            is fully visible. Defaults to 0.5.
+        animation_duration (float): Duration in seconds of the underline animation.
+            Defaults to 0.3.
+        animation_function (str): Name of the easing function used by the underline
+            animation. Defaults to ``"out_cubic"``.
+        tab_padding (int, optional): Fixed number of cells on each side of a label, or
+            None to fit the labels across the widget width. Defaults to None.
+        search_by_first_character (bool): Whether pressing a character key activates the
+            next tab whose label starts with that character. Defaults to True.
+        name (str, optional): The name of the widget. Defaults to None.
+    """
+
+    DEFAULT_STYLES = """
+        height: 2;
+    """
+
+    active_tab: Reactive[str] = Reactive("")
+    bar_position: Reactive[float] = Reactive(0.0)
+
+    def __init__(
+        self,
+        tabs: list[Tab],
+        active_tab: str | None = None,
+        active_tab_style: StyleType = "#f0f0f0 on #021720",
+        active_bar_style: StyleType = "#1BB152",
+        inactive_tab_style: StyleType = "#f0f0f0 on #021720",
+        inactive_bar_style: StyleType = "#455058",
+        inactive_text_opacity: float = 0.5,
+        animation_duration: float = 0.3,
+        animation_function: str = "out_cubic",
+        tab_padding: int | None = None,
+        search_by_first_character: bool = True,
+        name: str | None = None,
+    ) -> None:
+        super().__init__(name=name)
+        self.tabs = list(tabs)
+        self.active_tab_style = active_tab_style
+        self.active_bar_style = active_bar_style
+        self.inactive_tab_style = inactive_tab_style
+        self.inactive_bar_style = inactive_bar_style
+        self.inactive_text_opacity = inactive_text_opacity
+        self.animation_duration = animation_duration
+        self.animation_function = animation_function
+        self.tab_padding = tab_padding
+        self.search_by_first_character = search_by_first_character
+
+        if not self.tabs:
+            initial_name = ""
+        elif active_tab is not None:
+            initial_name = active_tab
+        else:
+            initial_name = self.tabs[0].name
+        # The watcher sees an empty old name for this first assignment and does not
+        # animate, so the bar starts at the active tab's index.
+        self.active_tab = initial_name
+        self.bar_position = float(self.find_tab_by_name(initial_name))
+
+    async def watch_active_tab(self, old_name: str, new_name: str) -> None:
+        if not old_name:
+            return
+        self.animate(
+            "bar_position",
+            float(self.find_tab_by_name(new_name)),
+            duration=self.animation_duration,
+            easing=self.animation_function,
+        )
+
+    def find_tab_by_name(self, name: str) -> int:
+        """Find the index of a tab by its name.
+
+        Args:
+            name (str): The tab name to look up.
+
+        Returns:
+            int: The index of the last tab with that name, or 0 if no tab has it.
+        """
+        index = 0
+        for position, tab in enumerate(self.tabs):
+            if tab.name == name:
+                index = position
+        return index
+
+    def activate_next_tab(self) -> None:
+        """Make the tab after the active tab active, wrapping to the first tab."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index + 1) % len(self.tabs)].name
+
+    def activate_previous_tab(self) -> None:
+        """Make the tab before the active tab active, wrapping to the last tab."""
+        if not self.tabs:
+            return
+        index = self.find_tab_by_name(self.active_tab)
+        self.active_tab = self.tabs[(index - 1) % len(self.tabs)].name
+
+    def activate_tab_by_number(self, number: int) -> None:
+        """Activate the tab at a 1-based position.
+
+        The number 0 activates the 10th tab when there are at least ten tabs. With fewer
+        than ten tabs, 0 resolves to the last tab through negative indexing. Numbers
+        outside the tab count are ignored.
+
+        Args:
+            number (int): The 1-based tab position.
+        """
+        count = len(self.tabs)
+        index = 9 if number == 0 and count >= 10 else number - 1
+        if not -count <= index < count:
+            return
+        self.active_tab = self.tabs[index].name
+
+    def activate_tab_by_first_char(self, character: str) -> None:
+        """Activate the next tab whose label starts with a character.
+
+        The search starts after the active tab, wraps around, and compares
+        case-insensitively.
+
+        Args:
+            character (str): The character to search for.
+        """
+        if not self.tabs or not character:
+            return
+        wanted = character.lower()
+        count = len(self.tabs)
+        start = self.find_tab_by_name(self.active_tab)
+        for offset in range(1, count + 1):
+            tab = self.tabs[(start + offset) % count]
+            if tab.label.lower().startswith(wanted):
+                self.active_tab = tab.name
+                return
+
+    def action_range_clicked(self, tab_name: str) -> None:
+        """Make the named tab active. Invoked by clicks on a tab's selection range.
+
+        Args:
+            tab_name (str): The name of the tab to activate.
+        """
+        self.active_tab = tab_name
+
+    async def on_key(self, event: events.Key) -> None:
+        """Handle keys while the widget has focus. Every key event is marked handled.
+
+        With no tabs, nothing else happens. Otherwise:
+
+        - Escape clears focus from the widget.
+        - Right and left activate the next and previous tab, wrapping at either end.
+        - The digits 1 through 9 activate the tab at that 1-based position; 0 activates
+          the 10th tab, or the last tab when there are fewer than ten. Numbers larger
+          than the tab count are ignored.
+        - Any other single character activates the next tab, after the active one and
+          wrapping, whose label starts with that character, compared case-insensitively.
+          This is skipped when ``search_by_first_character`` is False.
+
+        Args:
+            event (events.Key): The key event.
+        """
+        event.prevent_default()
+        if not self.tabs:
+            return
+
+        key = event.key
+        if key == Keys.Escape:
+            await self.app.set_focus(None)
+        elif key == Keys.Right:
+            self.activate_next_tab()
+        elif key == Keys.Left:
+            self.activate_previous_tab()
+        elif len(key) == 1 and key in "0123456789":
+            self.activate_tab_by_number(int(key))
+        elif self.search_by_first_character and len(key) == 1:
+            self.activate_tab_by_first_char(key)
+
+    def render(self) -> RenderableType:
+        return TabsRenderable(
+            tabs=self.tabs,
+            active_tab=self.active_tab,
+            bar_position=self.bar_position,
+            active_tab_style=self.active_tab_style,
+            active_bar_style=self.active_bar_style,
+            inactive_tab_style=self.inactive_tab_style,
+            inactive_bar_style=self.inactive_bar_style,
+            inactive_text_opacity=self.inactive_text_opacity,
+            tab_padding=self.tab_padding,
+        )
