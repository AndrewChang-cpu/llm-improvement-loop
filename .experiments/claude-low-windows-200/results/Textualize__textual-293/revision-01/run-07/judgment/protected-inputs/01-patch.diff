+    def _attach_click_actions(self, segments: Iterable[Segment]) -> Iterator[Segment]:
+        """Attach click metadata to cells in the clickable spans, merging equal runs."""
+        column = 0
+        pending: Segment | None = None
+        for text, style, _control in segments:
+            for character in text:
+                action = self._click_action_at(column)
+                column += cell_len(character)
+                cell_style = style
+                if action is not None:
