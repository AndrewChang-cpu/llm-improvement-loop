diff --git a/tests/test_tabs.py b/tests/test_tabs.py
new file mode 100644
index 0000000..f9308c5
--- /dev/null
+++ b/tests/test_tabs.py
@@ -0,0 +1,150 @@
+import asyncio
+import io
+import re
+
+from rich.console import Console
+
+from tests.utilities.render import render
+from textual import events
+from textual.widgets.tabs import Tab, Tabs
+
+ANSI_CODE = re.compile(r"\x1b\[[0-9;]*m")
+
+
+def make_tabs(**kwargs) -> Tabs:
+    tabs = [Tab("Home"), Tab("About"), Tab("Contact", name="contact")]
+    return Tabs(tabs, **kwargs)
+
+
+def press(tabs: Tabs, key: str) -> None:
+    asyncio.run(tabs.on_key(events.Key(tabs, key)))
+
+
+def plain_text(renderable) -> str:
+    return ANSI_CODE.sub("", render(renderable))
+
+
+def cell_actions(renderable, width: int = 22) -> list[str | None]:
+    """Return the click action of each cell in the first (label) row."""
+    console = Console(width=width, file=io.StringIO(), color_system="truecolor")
+    actions: list[str | None] = []
+    for segment in console.render(renderable, console.options):
+        if segment.text == "\n":
+            break
+        for _ in segment.text:
+            meta = segment.style.meta if segment.style else {}
+            actions.append(meta.get("@click"))
+    return actions
+
