@@ -291,3 +291,25 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value.
+
+    Example:
+
+        >>> lambd = Lambda(func=lambda x: x[:, 1:3])
+        >>> lambd(np.zeros((2, 4))).shape
+        (2, 2)
+
+    Args:
+        func: the callable to apply to the input. It receives the whole input and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
