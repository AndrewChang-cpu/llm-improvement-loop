+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The callable is applied to each listed key of a shallow copy of the input mapping.
+
+    For example, a slicing callable applied to the key "img":
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambdad
+
+        data = {"img": np.zeros((1, 4, 8)), "seg": np.zeros((1, 4, 8))}
+        out = Lambdad(keys=data.keys(), func=lambda x: x[:, 1:3])(data)
+        # out["img"] and out["seg"] both have shape (1, 2, 8); data is not modified
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of each listed key. A single callable is used for every key.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
