+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertTrue(np.array_equal(result["img"], img))
+        self.assertTrue(np.array_equal(result["seg"], self.seg1))
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        original_img = img.copy()
+        original_seg = self.seg1.copy()
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, ::-2])(data)
+        self.assertTrue(result["img"].size > 0)
+        self.assertTrue(np.array_equal(result["img"], img[:, :, 10:50, ::-2]))
+        self.assertTrue(np.array_equal(result["seg"], self.seg1[:, :, 10:50, ::-2]))
+        # the caller's mapping is not modified
+        self.assertTrue(np.array_equal(data["img"], original_img))
+        self.assertTrue(np.array_equal(data["seg"], original_seg))
+
+
+if __name__ == "__main__":
+    unittest.main()
