+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+
+    The same callable is applied to the value of each listed key. For example, with a slicing
+    callable and an item of shape (1, 1, 4, 6), the item is replaced by the array of shape (1, 1, 3, 3)
+    returned by the callable. The input mapping is not modified; a new dictionary is returned.
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to the value of every listed key. A single callable is required;
+            a list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
 IdentityD = IdentityDict = Identityd
