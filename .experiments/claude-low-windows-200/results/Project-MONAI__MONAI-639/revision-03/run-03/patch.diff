     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda function to the data.
+    The function is applied to the whole input value and its return value is returned.
+
+    For example, a slicing function applied to a 2D image array of shape (1, 1, 4, 3):
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambda
+
+        img = np.zeros((1, 1, 4, 3))
+        out = Lambda(lambda x: x[:, :, 1:, ::-1])(img)  # out.shape == (1, 1, 3, 3)
+
+    Args:
+        func: user-defined callable applied to the input value. It must accept the input and
+            return the transformed value.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
