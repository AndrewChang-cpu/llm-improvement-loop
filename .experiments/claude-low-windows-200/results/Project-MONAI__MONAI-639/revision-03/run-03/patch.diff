+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same user-defined function is applied to each configured key of the data mapping.
+    The input mapping is not modified; a new dictionary with the transformed values is returned.
+
+    For example, a slicing function applied to the array stored under key "img":
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambdad
+
+        data = {"img": np.zeros((1, 1, 4, 3))}
+        out = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:, ::-1])(data)  # out["img"].shape == (1, 1, 3, 3)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: user-defined callable applied to the value of every listed key. A single callable is
+            required; a list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
