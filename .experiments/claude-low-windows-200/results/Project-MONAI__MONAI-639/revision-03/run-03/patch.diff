+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        result = Lambda(lambda x: x)(self.imt)
+        self.assertIs(result, self.imt)
+        np.testing.assert_array_equal(result, self.imt)
+
+    def test_slicing(self):
+        # slice only the spatial axes (2 and 3), keeping the batch and channel axes whole
+        result = Lambda(lambda x: x[:, :, 1:, ::-2])(self.imt)
+        expected = self.imt[:, :, 1:, ::-2]
+        self.assertGreater(expected.size, 0)
+        np.testing.assert_array_equal(result, expected)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda("not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
