+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.segn}
+        # slice only the spatial axes (2 and 3), keeping the batch and channel axes whole
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 1:, ::-2])(data)
+        expected_img = self.imt[:, :, 1:, ::-2]
+        expected_seg = self.segn[:, :, 1:, ::-2]
+        self.assertGreater(expected_img.size, 0)
+        np.testing.assert_array_equal(result["img"], expected_img)
+        np.testing.assert_array_equal(result["seg"], expected_seg)
+        # the input mapping is not modified
+        np.testing.assert_array_equal(data["img"], self.imt)
+        np.testing.assert_array_equal(data["seg"], self.segn)
+
+    def test_unlisted_keys_unchanged(self):
+        data = {"img": self.imt, "seg": self.segn}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:, ::-2])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 1:, ::-2])
+        self.assertIs(result["seg"], self.segn)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
