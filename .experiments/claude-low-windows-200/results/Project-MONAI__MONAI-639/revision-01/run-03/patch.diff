+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. Applies the same
+    callable to each of the configured keys of the input mapping.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(10), "label": np.arange(10)}
+            out = Lambdad(keys="img", func=lambda x: x[2:5])(data)
+            # out["img"] is array([2, 3, 4]); out["label"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: a single callable applied to the value of every listed key. A list
+            or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = copy.copy(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
