+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        out = Lambda(lambda x: x)(img)
+        self.assertTrue(np.allclose(img, out))
+
+    def test_slicing(self):
+        img = self.imt
+        out = Lambda(lambda x: x[..., 2:10])(img)
+        self.assertTrue(np.allclose(img[..., 2:10], out))
+        self.assertEqual(out.shape, img[..., 2:10].shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
