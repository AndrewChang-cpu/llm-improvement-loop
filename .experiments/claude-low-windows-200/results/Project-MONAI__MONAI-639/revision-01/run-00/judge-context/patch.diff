+class Lambdad(MapTransform):
+    """
+    Apply the same user-supplied callable to each of the specified keys of a data dictionary.
+    The callable is applied to each value as a whole, including when it is itself iterable.
+
+    Example:
+
+        .. code-block:: python
+
+            data = {"img": np.array([0, 1, 2, 3, 4]), "label": np.array([5, 6, 7, 8, 9])}
+            out = Lambdad(keys=["img"], func=lambda a: a[1:3])(data)
+            # out["img"] is array([1, 2]); out["label"] is unchanged
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: the callable applied to the value of each listed key. It must accept
+                a single value and return the transformed value.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
