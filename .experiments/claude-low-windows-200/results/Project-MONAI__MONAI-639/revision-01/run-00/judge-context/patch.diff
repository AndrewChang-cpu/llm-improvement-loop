+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity_lambda(self):
+        img = self.imt
+        out = Lambda(func=lambda x: x)(img)
+        self.assertTrue(np.allclose(img, out))
+
+    def test_slicing_lambda(self):
+        img = self.imt
+        out = Lambda(func=lambda x: x[1:3])(img)
+        self.assertTrue(np.allclose(img[1:3], out))
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
