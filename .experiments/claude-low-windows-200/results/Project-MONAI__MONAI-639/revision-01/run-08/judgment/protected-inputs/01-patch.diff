     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+
+    The input is passed to the callable unchanged, and whatever the callable returns is returned.
+    For example, a slicing callable selects the same slice it would select when called directly:
+
+    .. code-block:: python
+
+        lambd = Lambda(lambda x: x[1:3])
+        out = lambd(np.array([0, 1, 2, 3]))  # out is np.array([1, 2])
+
+    Args:
+        func: a callable that accepts the input value and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
