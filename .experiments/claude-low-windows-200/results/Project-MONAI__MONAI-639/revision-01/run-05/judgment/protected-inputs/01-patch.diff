+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], img)
+        self.assertIsNot(result, data)
+
+    def test_slicing_keys_view(self):
+        img = self.imt
+        data = {"img": img}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[1:3])(data)
+        np.testing.assert_array_equal(result["img"], img[1:3])
+        # the caller's mapping must not be modified
+        np.testing.assert_array_equal(data["img"], img)
+
+    def test_unlisted_keys_unchanged(self):
+        img = self.imt
+        seg = self.segn
+        data = {"img": img, "seg": seg}
+        result = Lambdad(keys=["img"], func=lambda x: x[1:3])(data)
+        np.testing.assert_array_equal(result["img"], img[1:3])
+        np.testing.assert_array_equal(result["seg"], seg)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=np.array([1, 2]))
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
