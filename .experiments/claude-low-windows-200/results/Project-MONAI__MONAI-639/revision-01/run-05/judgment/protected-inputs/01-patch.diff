@@ -291,3 +291,24 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The input is passed to the callable unchanged, without copying or type conversion.
+
+    For example, a slicing callable selects a sub-range of an array:
+    ``Lambda(func=lambda x: x[1:3])(np.array([0, 1, 2, 3, 4]))`` returns ``array([1, 2])``.
+
+    Args:
+        func: the callable to apply to the input. It must accept the input and return the transformed value.
+            The return value is not inspected or constrained.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
