-IdentityD = IdentityDict = Identityd
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to each of the configured keys and returns a new dictionary;
+    the input dictionary is not modified.
+
+    For example, with ``keys="img"`` and ``func=lambda x: x[1:3]``, the input
+    ``{"img": np.array([0, 1, 2, 3, 4])}`` produces ``{"img": array([1, 2])}``.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: the callable applied to the value of every listed key. It must accept a single item
+                and return the transformed value. A list or tuple of callables is not supported.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
+IdentityD =IdentityDict = Identityd
 AsChannelFirstD = AsChannelFirstDict = AsChannelFirstd
