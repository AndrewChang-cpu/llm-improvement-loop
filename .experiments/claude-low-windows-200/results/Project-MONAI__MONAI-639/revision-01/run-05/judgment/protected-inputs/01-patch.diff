+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x[1:3])(img)
+        np.testing.assert_array_equal(result, img[1:3])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=np.array([1, 2]))
+
+
+if __name__ == "__main__":
+    unittest.main()
