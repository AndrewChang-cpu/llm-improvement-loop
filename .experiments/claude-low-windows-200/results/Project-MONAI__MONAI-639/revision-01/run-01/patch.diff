     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The input is passed through unchanged, with no copy or type conversion.
+
+    For example, a slicing callable returns exactly the slice it produces:
+
+    .. code-block:: python
+
+        from monai.transforms import Lambda
+        import numpy as np
+
+        arr = np.arange(10)
+        out = Lambda(lambda x: x[2:5])(arr)
+        # out is array([2, 3, 4])
+
+    Args:
+        func: Callable applied to the input; it must accept the input and
+            return the transformed value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
