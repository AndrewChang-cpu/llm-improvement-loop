+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. Applies the
+    same callable to each configured key of the data mapping. The input mapping
+    is shallow-copied; the caller's mapping is not modified.
+
+    For example, a slicing callable applied to key "img":
+
+    .. code-block:: python
+
+        from monai.transforms import Lambdad
+        import numpy as np
+
+        data = {"img": np.arange(10), "label": 1}
+        out = Lambdad(keys="img", func=lambda x: x[2:5])(data)
+        # out["img"] is array([2, 3, 4]); out["label"] is 1
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: Callable applied to the value of every listed key. A single
+            callable is required; a list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambda_transform = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambda_transform(d[key])
+        return d
+
+
