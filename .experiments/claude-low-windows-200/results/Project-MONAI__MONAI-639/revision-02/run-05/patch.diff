+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "other": img.copy()}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], img)
+        np.testing.assert_array_equal(result["other"], img)
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "other": img.copy()}
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, ::-2])
+        result = lambd(data)
+        expected = img[:, :, 10:50, ::-2]
+        self.assertGreater(expected.size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+        np.testing.assert_array_equal(result["other"], expected)
+        # the original mapping is not modified
+        np.testing.assert_array_equal(data["img"], img)
+        np.testing.assert_array_equal(data["other"], img)
+
+
+if __name__ == "__main__":
+    unittest.main()
