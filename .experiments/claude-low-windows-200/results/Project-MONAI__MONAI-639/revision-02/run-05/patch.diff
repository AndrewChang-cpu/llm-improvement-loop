@@ -291,3 +291,24 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value, for example::
+
+        >>> lamb = Lambda(lambda x: x[:, 1:, ::-1])
+        >>> lamb(np.arange(12).reshape(1, 3, 4)).shape
+        (1, 2, 4)
+
+    Args:
+        func: the callable to apply to the input. It must accept the input value and return the
+            transformed value. The framework does not inspect or constrain the return value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
