+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The callable is applied
+    to the value of each listed key, for example::
+
+        >>> lambd = Lambdad(keys=["img"], func=lambda x: x[:, 1:, ::-1])
+        >>> lambd({"img": np.arange(12).reshape(1, 3, 4)})["img"].shape
+        (1, 2, 4)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: the callable applied to the value of every listed key. It must accept one item
+            and return the transformed value. A list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
