+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        result = lambd(img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        lambd = Lambda(func=lambda x: x[:, :, 10:50, ::-2])
+        result = lambd(img)
+        expected = img[:, :, 10:50, ::-2]
+        self.assertEqual(result.size, expected.size)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_array_equal(result, expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
