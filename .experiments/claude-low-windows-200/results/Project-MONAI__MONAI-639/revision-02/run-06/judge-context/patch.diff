+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt.copy(), "seg": self.segn.copy()}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+
+    def test_slicing(self):
+        data = {"img": self.imt.copy(), "seg": self.segn.copy()}
+        original = {k: v.copy() for k, v in data.items()}
+        keys = {"img": 0}.keys()
+        result = Lambdad(keys=keys, func=lambda x: x[:, :, 10:50, ::-3])(data)
+        expected = self.imt[:, :, 10:50, ::-3]
+        self.assertGreater(expected.size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+        np.testing.assert_array_equal(result["seg"], self.segn)
+        # the caller's mapping is not modified
+        np.testing.assert_array_equal(data["img"], original["img"])
+        np.testing.assert_array_equal(data["seg"], original["seg"])
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func=1)
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+
+if __name__ == "__main__":
+    unittest.main()
