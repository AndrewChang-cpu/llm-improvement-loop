+class Lambdad(MapTransform):
+    """
+    Apply the same user-supplied callable to each specified item of the data mapping.
+    The callable is applied to each listed key's value as a whole, and the result
+    replaces that value in a shallow copy of the mapping. The input mapping is not modified.
+
+    Example:
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            transform = Lambdad(keys=["img"], func=lambda x: x[:, 1:3])
+            out = transform({"img": np.zeros((1, 4, 8)), "label": 0})
+            # out["img"] has shape (1, 2, 8); out["label"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: a single callable applied to every listed key's value.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
