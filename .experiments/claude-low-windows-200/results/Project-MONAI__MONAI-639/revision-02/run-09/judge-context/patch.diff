+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        np.testing.assert_allclose(result, img)
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        expected = img[:, :, 10:, ::-2]
+        self.assertGreater(expected.size, 0)
+        result = Lambda(func=lambda x: x[:, :, 10:, ::-2])(img)
+        np.testing.assert_allclose(result, expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
