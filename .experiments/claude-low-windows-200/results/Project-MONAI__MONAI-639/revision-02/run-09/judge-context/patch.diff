-IdentityD = IdentityDict = Identityd
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to the value of each listed key.
+
+    For example, with ``data = {"img": np.arange(6).reshape(2, 3)}``, the transform
+    ``Lambdad(keys=data.keys(), func=lambda x: x[:, 1:])(data)`` returns a new dictionary whose
+    ``"img"`` value is ``[[1, 2], [4, 5]]``. The input dictionary is not modified.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to the value of each listed key. A single callable is required;
+                a list or tuple of callables is not supported.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
+IdentityD =IdentityDict = Identityd
 AsChannelFirstD = AsChannelFirstDict = AsChannelFirstd
