@@ -291,3 +291,23 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The input is passed to the callable unchanged, with no copy or type conversion.
+
+    For example, with ``img = np.arange(6).reshape(2, 3)``, the transform
+    ``Lambda(func=lambda x: x[:, 1:])(img)`` returns ``[[1, 2], [4, 5]]``.
+
+    Args:
+        func: callable applied to the input value. It must accept the input and return the transformed value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
