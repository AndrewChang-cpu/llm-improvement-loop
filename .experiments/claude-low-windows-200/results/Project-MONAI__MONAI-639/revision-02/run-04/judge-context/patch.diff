     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The input is passed to the callable unchanged, without copying or type conversion.
+
+    For example:
+
+    .. code-block:: python
+
+        import numpy as np
+        from monai.transforms import Lambda
+
+        lambda_transform = Lambda(func=lambda x: x[1:4])
+        print(lambda_transform(np.array([1, 2, 3, 4, 5])))  # [2 3 4]
+
+    Args:
+        func: the callable to apply to the input. It must accept the input value and return the
+            transformed value. The framework does not check the type of the returned value.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
