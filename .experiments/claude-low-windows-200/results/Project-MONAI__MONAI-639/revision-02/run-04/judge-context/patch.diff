+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        np.testing.assert_array_equal(result["seg"], self.seg1)
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        # keep the batch and channel axes whole; slice the spatial axes only
+        lambd = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, ::-2])
+        expected_img = img[:, :, 10:50, ::-2]
+        expected_seg = self.seg1[:, :, 10:50, ::-2]
+        self.assertGreater(expected_img.size, 0)
+        result = lambd(data)
+        np.testing.assert_array_equal(result["img"], expected_img)
+        np.testing.assert_array_equal(result["seg"], expected_seg)
+        # the caller's mapping is not modified
+        np.testing.assert_array_equal(data["img"], img)
+        np.testing.assert_array_equal(data["seg"], self.seg1)
+
+
+if __name__ == "__main__":
+    unittest.main()
