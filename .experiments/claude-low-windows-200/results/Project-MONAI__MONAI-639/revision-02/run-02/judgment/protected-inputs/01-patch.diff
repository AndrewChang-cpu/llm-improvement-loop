         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a caller-supplied callable to the input value and return its result.
+    The input is passed to ``func`` unchanged, without copying or type conversion.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(12).reshape(1, 1, 3, 4)
+            crop = Lambda(lambda x: x[:, :, 1:, ::-2])
+            out = crop(img)  # out.shape == (1, 1, 2, 2)
+
+    Args:
+        func: a callable that accepts the input value and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
