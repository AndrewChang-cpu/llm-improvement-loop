+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        out = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        self.assertTrue(np.allclose(img, out["img"]))
+        self.assertTrue(np.allclose(self.seg1, out["seg"]))
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping the batch and channel axes whole
+        expected = img[:, :, 10:100, ::-2]
+        self.assertGreater(expected.size, 0)
+        data = {"img": img, "seg": self.seg1}
+        original_seg = data["seg"].copy()
+        out = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:100, ::-2])(data)
+        self.assertTrue(np.allclose(expected, out["img"]))
+        self.assertTrue(np.allclose(self.seg1[:, :, 10:100, ::-2], out["seg"]))
+        # the input mapping is not modified
+        self.assertIs(data["img"], img)
+        self.assertTrue(np.allclose(original_seg, data["seg"]))
+
+    def test_unlisted_keys_unchanged(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        out = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:100, ::-2])(data)
+        self.assertTrue(np.allclose(img[:, :, 10:100, ::-2], out["img"]))
+        self.assertIs(out["seg"], self.seg1)
+
+
+if __name__ == "__main__":
+    unittest.main()
