+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        out = Lambda(lambda x: x)(img)
+        self.assertTrue(np.allclose(img, out))
+
+    def test_slicing(self):
+        img = self.imt
+        # slice only the spatial axes, keeping the batch and channel axes whole
+        expected = img[:, :, 10:100, ::-2]
+        self.assertGreater(expected.size, 0)
+        out = Lambda(lambda x: x[:, :, 10:100, ::-2])(img)
+        self.assertTrue(np.allclose(expected, out))
+
+
+if __name__ == "__main__":
+    unittest.main()
