+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The same callable is applied
+    to the value of each listed key, and a new dictionary is returned; the input dictionary is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(12).reshape(1, 1, 3, 4), "label": np.zeros((1, 1, 3, 4))}
+            crop = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 1:, ::-2])
+            out = crop(data)  # out["img"].shape == (1, 1, 2, 2), out["label"].shape == (1, 1, 2, 2)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: a single callable applied to the value of every listed key.
+            A list or tuple of callables is not supported.
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = copy.copy(data)
+        for key in self.keys:
+            d[key] = self.lambd(data[key])
+        return d
+
+
