+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, transform(img)))
+
+    def test_slicing(self):
+        img = self.imt
+        transform = Lambda(func=lambda x: x[:, :, 2:100, ::-2])
+        expected = img[:, :, 2:100, ::-2]
+        result = transform(img)
+        self.assertGreater(result.size, 0)
+        self.assertTrue(np.allclose(expected, result))
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambda(func=1)
+
+
+if __name__ == "__main__":
+    unittest.main()
