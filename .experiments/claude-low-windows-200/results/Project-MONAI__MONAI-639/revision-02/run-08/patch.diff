+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "other": np.zeros(3)}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+        self.assertIsNot(result, data)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "other": img.copy()}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:100, ::-2])
+        result = transform(data)
+        expected = img[:, :, 2:100, ::-2]
+        self.assertGreater(result["img"].size, 0)
+        self.assertTrue(np.allclose(expected, result["img"]))
+        self.assertTrue(np.allclose(expected, result["other"]))
+        # the input mapping is not modified
+        self.assertTrue(np.allclose(img, data["img"]))
+
+    def test_unlisted_key_unchanged(self):
+        img = self.imt
+        data = {"img": img, "seg": self.seg1}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:100, ::-2])
+        result = transform(data)
+        self.assertTrue(np.allclose(img[:, :, 2:100, ::-2], result["img"]))
+        self.assertIs(result["seg"], data["seg"])
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
