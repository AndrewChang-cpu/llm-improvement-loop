+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to the value of each listed key; the input mapping is not modified.
+
+    For example, a callable that slices the value of each key:
+
+    .. code-block:: python
+
+        from monai.transforms import Lambdad
+
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, 1:3])
+        output = transform({"img": np.arange(24).reshape(2, 3, 4)})  # output["img"] is x[:, 1:3]
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to the value of every listed key. A list or tuple of callables
+                is not supported; a callable that is also iterable is still used as a whole.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
