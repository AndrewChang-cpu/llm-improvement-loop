@@ -35,6 +35,31 @@ class Identity(Transform):
         return np.asanyarray(img)
 
 
+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the input data. This is useful for quickly
+    prototyping custom transforms without writing a new ``Transform`` subclass.
+
+    Args:
+        func: Callable applied to the input, its return value is the output.
+            Must be callable, otherwise a ``TypeError`` is raised.
+
+    Example:
+        .. code-block:: python
+
+            transform = Lambda(lambda x: x * 2)
+            out = transform(np.ones((2, 2)))
+    """
+
+    def __init__(self, func: Callable):
+        if not callable(func):
+            raise TypeError(f"func must be callable, got {type(func).__name__}.")
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
+
+
