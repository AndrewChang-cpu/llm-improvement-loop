+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_single_func(self):
+        img = self.imt
+        data = {"img": img, "other": img}
+        result = Lambdad(keys=["img", "other"], func=lambda x: x + 1)(data)
+        np.testing.assert_allclose(result["img"], img + 1)
+        np.testing.assert_allclose(result["other"], img + 1)
+        # input dict is not modified
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_func_sequence(self):
+        img = self.imt
+        data = {"a": img, "b": img}
+        result = Lambdad(keys=["a", "b"], func=[lambda x: x * 2, lambda x: x - 1])(data)
+        np.testing.assert_allclose(result["a"], img * 2)
+        np.testing.assert_allclose(result["b"], img - 1)
+
+    def test_invalid_func(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys="img", func=123)
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["a", "b"], func=[lambda x: x, "bad"])
+
+
+if __name__ == "__main__":
+    unittest.main()
