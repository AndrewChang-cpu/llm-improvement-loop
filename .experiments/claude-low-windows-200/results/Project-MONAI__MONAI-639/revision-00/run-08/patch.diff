+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies a user-supplied function to the data under each key.
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: Callable applied to each selected item. If a sequence of callables is given,
+            its length must match the number of keys, and the i-th callable is applied to the
+            i-th key. Each callable must be callable, otherwise a ``TypeError`` is raised.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Union[Sequence[Callable], Callable]):
+        super().__init__(keys)
+        self.funcs = ensure_tuple_rep(func, len(self.keys))
+        for f in self.funcs:
+            if not callable(f):
+                raise TypeError(f"func must be callable or a sequence of callables, got {type(f).__name__}.")
+        self.lambdas = [Lambda(f) for f in self.funcs]
+
+    def __call__(self, data):
+        d = dict(data)
+        for key, trans in zip(self.keys, self.lambdas):
+            d[key] = trans(d[key])
+        return d
+
+
