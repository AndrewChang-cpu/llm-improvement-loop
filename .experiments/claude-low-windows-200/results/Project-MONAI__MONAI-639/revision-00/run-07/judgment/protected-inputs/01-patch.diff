+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_lambdad_single_func(self):
+        img = self.imt
+        data = {"img": img, "other": img}
+        result = Lambdad(keys=["img"], func=lambda x: x + 1)(data)
+        np.testing.assert_allclose(result["img"], img + 1)
+        np.testing.assert_allclose(result["other"], img)
+        # input dictionary is not modified
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_lambdad_func_list(self):
+        img = self.imt
+        data = {"a": img, "b": img}
+        result = Lambdad(keys=["a", "b"], func=[lambda x: x + 1, lambda x: x * 3])(data)
+        np.testing.assert_allclose(result["a"], img + 1)
+        np.testing.assert_allclose(result["b"], img * 3)
+
+    def test_lambdad_func_list_length_mismatch(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=["a", "b"], func=[lambda x: x])
+
+    def test_lambdad_func_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["a"], func="not_callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
