+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the input data. Useful for quickly wrapping a custom
+    operation (e.g. a numpy or torch function) into a transform chain without writing a new class.
+
+    Args:
+        func: callable that takes the input data and returns the transformed data.
+
+    Raises:
+        TypeError: argument `func` must be a callable.
+
+    """
+
+    def __init__(self, func: Callable):
+        if not callable(func):
+            raise TypeError("argument `func` must be a callable.")
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
+
