+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+
+
+class TestLambda(unittest.TestCase):
+    def test_lambda_numpy(self):
+        img = np.array([[1.0, 2.0], [3.0, 4.0]])
+        result = Lambda(lambda x: x * 2)(img)
+        np.testing.assert_allclose(result, img * 2)
+
+    def test_named_function(self):
+        def add_one(x):
+            return x + 1
+
+        result = Lambda(add_one)(np.array([1, 2]))
+        np.testing.assert_allclose(result, np.array([2, 3]))
+
+    def test_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambda("not a function")
+
+
+if __name__ == "__main__":
+    unittest.main()
