+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+
+    Applies a user-supplied function to the data stored under each specified key.
+    If a list of functions is given, it must have the same length as ``keys`` and
+    the i-th function is applied to the i-th key.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Union[Callable, Sequence[Callable]]):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: function to apply to each item, or a sequence of functions with the same
+                length as ``keys`` (one function per key). All must be callable.
+
+        Raises:
+            TypeError: a function is not callable.
+            ValueError: length of ``func`` does not match length of ``keys``.
+
+        """
+        super().__init__(keys)
+        self.funcs = ensure_tuple_rep(func, len(self.keys))
+        for f in self.funcs:
+            if not callable(f):
+                raise TypeError(f"func must be callable, got {type(f)}.")
+        self.converters = [Lambda(f) for f in self.funcs]
+
+    def __call__(self, data):
+        d = dict(data)
+        for key, converter in zip(self.keys, self.converters):
+            d[key] = converter(d[key])
+        return d
+
+
