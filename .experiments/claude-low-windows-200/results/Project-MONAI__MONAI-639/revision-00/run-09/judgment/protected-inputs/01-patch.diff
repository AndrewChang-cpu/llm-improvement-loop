+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the input data. This allows arbitrary custom processing
+    to be inserted into a transform chain without writing a new transform class.
+
+    For example:
+        ``Lambda(lambda x: x * 2)(np.array([1, 2]))`` returns ``array([2, 4])``.
+
+    Args:
+        func: function to apply to the input data. Must be callable.
+
+    Raises:
+        TypeError: ``func`` is not callable.
+
+    """
+
+    def __init__(self, func: Callable) -> None:
+        if not callable(func):
+            raise TypeError(f"func must be callable, got {type(func)}.")
+        self.func = func
+
+    def __call__(self, img):
+        """
+        Args:
+            img: data to be processed by ``func``.
+
+        Returns:
+            the output of ``func(img)``.
+        """
+        return self.func(img)
+
+
