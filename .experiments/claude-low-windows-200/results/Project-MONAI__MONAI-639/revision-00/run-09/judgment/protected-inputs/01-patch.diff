+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from monai.transforms.utility.dictionary import LambdaD
+
+
+class TestLambdad(unittest.TestCase):
+    def test_single_func_multiple_keys(self):
+        data = {"img": np.array([1.0, 2.0]), "seg": np.array([3.0, 4.0]), "meta": "keep"}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x * 10)(data)
+        np.testing.assert_allclose(result["img"], np.array([10.0, 20.0]))
+        np.testing.assert_allclose(result["seg"], np.array([30.0, 40.0]))
+        self.assertEqual(result["meta"], "keep")
+        # input dictionary is not modified in place
+        np.testing.assert_allclose(data["img"], np.array([1.0, 2.0]))
+
+    def test_func_per_key(self):
+        data = {"img": np.array([1.0, 2.0]), "seg": np.array([3.0, 4.0])}
+        result = Lambdad(keys=["img", "seg"], func=[lambda x: x + 1, lambda x: x - 1])(data)
+        np.testing.assert_allclose(result["img"], np.array([2.0, 3.0]))
+        np.testing.assert_allclose(result["seg"], np.array([2.0, 3.0]))
+
+    def test_alias(self):
+        result = LambdaD(keys="img", func=lambda x: -x)({"img": 2})
+        self.assertEqual(result["img"], -2)
+
+    def test_length_mismatch(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=["img", "seg"], func=[lambda x: x])
+
+    def test_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["img"], func="not a function")
+
+
+if __name__ == "__main__":
+    unittest.main()
