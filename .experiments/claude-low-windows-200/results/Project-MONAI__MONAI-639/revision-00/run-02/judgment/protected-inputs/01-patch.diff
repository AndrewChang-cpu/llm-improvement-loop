+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+
+
+class TestLambdad(unittest.TestCase):
+    def test_single_func_for_all_keys(self):
+        data = {"img": np.array([1, 2, 3]), "seg": np.array([0, 1, 0])}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x * 10)(data)
+        np.testing.assert_array_equal(result["img"], np.array([10, 20, 30]))
+        np.testing.assert_array_equal(result["seg"], np.array([0, 10, 0]))
+        # input dictionary is not modified
+        np.testing.assert_array_equal(data["img"], np.array([1, 2, 3]))
+
+    def test_func_list_per_key(self):
+        data = {"img": [1, 2, 3], "seg": [1, 2, 3]}
+        result = Lambdad(keys=["img", "seg"], func=[lambda x: x + 1, lambda x: x * 2])(data)
+        np.testing.assert_array_equal(result["img"], np.array([2, 3, 4]))
+        np.testing.assert_array_equal(result["seg"], np.array([2, 4, 6]))
+
+    def test_untouched_keys_preserved(self):
+        data = {"img": np.zeros(2), "meta": "info"}
+        result = Lambdad(keys=["img"], func=lambda x: x + 1)(data)
+        self.assertEqual(result["meta"], "info")
+        np.testing.assert_array_equal(result["img"], np.ones(2))
+
+    def test_length_mismatch(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=["img", "seg"], func=[lambda x: x])
+
+    def test_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["img"], func=5)
+
+
+if __name__ == "__main__":
+    unittest.main()
