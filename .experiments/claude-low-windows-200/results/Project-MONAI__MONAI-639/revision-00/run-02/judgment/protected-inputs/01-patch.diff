@@ -413,6 +414,40 @@ class ConcatItemsd(MapTransform):
         return d
 
 
+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+
+    Apply a user-supplied function to the data stored under each key. ``func`` can be a single
+    callable applied to every key, or a list of callables with one entry per key.
+    """
+
+    def __init__(self, keys: KeysCollection, func):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: function to apply to the items. Either a single callable used for all keys,
+                or a list of callables whose length matches `keys`.
+
+        Raises:
+            TypeError: every element of `func` must be callable.
+            ValueError: length of the list `func` does not match `keys`.
+
+        """
+        super().__init__(keys)
+        self.func = ensure_tuple_rep(func, len(self.keys))
+        if len(self.func) != len(self.keys):
+            raise ValueError("length of `func` does not match length of `keys`.")
+        self.lambds = [Lambda(f) for f in self.func]
+
+    def __call__(self, data):
+        d = dict(data)
+        for key, converter in zip(self.keys, self.lambds):
+            d[key] = converter(d[key])
+        return d
+
+
