+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+
+
+class TestLambda(unittest.TestCase):
+    def test_lambda_list(self):
+        result = Lambda(func=lambda x: x * 2)([1, 2, 3])
+        np.testing.assert_array_equal(result, np.array([1, 2, 3, 1, 2, 3]))
+
+    def test_lambda_numpy(self):
+        img = np.arange(6).reshape(2, 3)
+        result = Lambda(func=lambda x: x + 1)(img)
+        np.testing.assert_array_equal(result, img + 1)
+
+    def test_named_function(self):
+        def square(x):
+            return x ** 2
+
+        result = Lambda(square)(np.array([1, 2, 3]))
+        np.testing.assert_array_equal(result, np.array([1, 4, 9]))
+
+    def test_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambda(func=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
