+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the input data. This makes it easy to plug in custom
+    one-off processing without writing a new transform class, for example:
+    ``Lambda(func=lambda x: x * 2)([1, 2, 3])`` returns ``[2, 4, 6]``.
+
+    Args:
+        func: the function to apply to the input data. It must be callable.
+
+    Raises:
+        TypeError: argument `func` must be callable.
+
+    """
+
+    def __init__(self, func: Callable) -> None:
+        if not callable(func):
+            raise TypeError("argument `func` must be callable.")
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
+
