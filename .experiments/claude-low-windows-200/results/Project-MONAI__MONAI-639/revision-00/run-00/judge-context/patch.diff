+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies a user-supplied function to the value of each specified key.
+
+    For example:
+        ``Lambdad(keys="img", func=lambda x: x * 2)({"img": [1, 2, 3]})`` returns ``{"img": [2, 4, 6]}``.
+    """
+
+    def __init__(self, keys: KeysCollection, func) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: function to be applied to each item. Either a single callable applied to every key,
+                or a sequence of callables with one per key (in the same order as ``keys``).
+
+        Raises:
+            ValueError: When a sequence of functions is given whose length differs from ``keys``.
+            TypeError: When any of the functions is not callable.
+        """
+        super().__init__(keys)
+        self.lambdas = [Lambda(f) for f in ensure_tuple_rep(func, len(self.keys))]
+
+    def __call__(self, data):
+        d = dict(data)
+        for key, transform in zip(self.keys, self.lambdas):
+            d[key] = transform(d[key])
+        return d
+
+
