+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_single_func_multiple_keys(self):
+        img = self.imt
+        data = {"img": img, "seg": img.copy()}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x + 1)(data)
+        self.assertTrue(np.allclose(result["img"], img + 1))
+        self.assertTrue(np.allclose(result["seg"], img + 1))
+
+    def test_func_per_key(self):
+        data = {"a": 1, "b": 2}
+        result = Lambdad(keys=["a", "b"], func=[lambda x: x * 10, lambda x: x - 1])(data)
+        self.assertEqual(result, {"a": 10, "b": 1})
+
+    def test_input_not_modified(self):
+        data = {"a": 1}
+        Lambdad(keys="a", func=lambda x: x + 1)(data)
+        self.assertEqual(data, {"a": 1})
+
+    def test_func_count_mismatch(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=["a", "b"], func=[lambda x: x])
+
+
+if __name__ == "__main__":
+    unittest.main()
