 from monai.transforms.compose import Transform
 
 
+class Lambda(Transform):
+    """
+    Apply a user-supplied function as a transform. Useful for one-off custom operations
+    without writing a new transform class.
+
+    For example:
+        ``Lambda(lambda x: x * 2)([1, 2, 3])`` returns ``[2, 4, 6]``.
+
+    Args:
+        func: function to be applied to the input data. Must be callable.
+
+    Raises:
+        TypeError: When ``func`` is not callable.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        if not callable(func):
+            raise TypeError(f"func must be callable, got {type(func).__name__}.")
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
+
+
