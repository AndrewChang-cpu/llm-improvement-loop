+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_lambda_numpy(self):
+        img = self.imt
+        result = Lambda(lambda x: x * 2)(img)
+        self.assertTrue(np.allclose(result, img * 2))
+
+    def test_lambda_list(self):
+        self.assertEqual(Lambda(lambda x: [v + 1 for v in x])([1, 2, 3]), [2, 3, 4])
+
+    def test_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambda("not a function")
+
+
+if __name__ == "__main__":
+    unittest.main()
