+# limitations under the License.
+
+import unittest
+
+import numpy as np
+import torch
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_lambda_numpy(self):
+        img = self.imt
+        result = Lambda(lambda x: x * 2)(img)
+        np.testing.assert_allclose(result, img * 2)
+
+    def test_lambda_tensor(self):
+        img = torch.tensor([1.0, 2.0, 3.0])
+        result = Lambda(lambda x: x + 1)(img)
+        self.assertTrue(torch.equal(result, torch.tensor([2.0, 3.0, 4.0])))
+
+    def test_lambda_function(self):
+        def _add_one(x):
+            return x + 1
+
+        np.testing.assert_allclose(Lambda(_add_one)(np.zeros(3)), np.ones(3))
+
+    def test_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambda(None)
+
+
+if __name__ == "__main__":
+    unittest.main()
