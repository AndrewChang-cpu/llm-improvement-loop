diff --git a/monai/transforms/utility/array.py b/monai/transforms/utility/array.py
index 5b2eb42..f9a56e3 100644
--- a/monai/transforms/utility/array.py
+++ b/monai/transforms/utility/array.py
@@ -291,3 +291,28 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda function to the data.
+
+    This is useful for quick, one-off transformations that do not warrant a dedicated transform class,
+    for example: ``Lambda(lambda x: x * 2)``. The function is applied to the whole input, so it may
+    operate on numpy arrays, tensors, or any other object.
+
+    Args:
+        func: user-defined callable to apply to the input data.
+
+    Raises:
+        TypeError: When ``func`` is not callable.
+
+    """
+
+    def __init__(self, func: Callable) -> None:
+        if not callable(func):
+            raise TypeError(f"func must be callable, got {type(func).__name__}.")
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
