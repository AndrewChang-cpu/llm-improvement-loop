+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_lambdad(self):
+        img = self.imt
+        data = {"img": img, "seg": img.copy(), "other": 7}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x + 1)(data)
+        np.testing.assert_allclose(result["img"], img + 1)
+        np.testing.assert_allclose(result["seg"], img + 1)
+        self.assertEqual(result["other"], 7)
+        # input dictionary is not modified in place
+        np.testing.assert_allclose(data["img"], img)
+
+    def test_not_callable(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
