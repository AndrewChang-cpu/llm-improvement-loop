+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+
+
+class TestLambda(unittest.TestCase):
+    def test_lambda_numpy(self):
+        img = np.array([[0, 1], [1, 2]])
+        result = Lambda(lambda x: x * 2)(img)
+        np.testing.assert_allclose(result, np.array([[0, 2], [2, 4]]))
+
+    def test_named_function(self):
+        def add_one(x):
+            return x + 1
+
+        img = np.array([1.0, 2.0])
+        np.testing.assert_allclose(Lambda(add_one)(img), np.array([2.0, 3.0]))
+
+    def test_invalid_func(self):
+        with self.assertRaises(TypeError):
+            Lambda("not_callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
