+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+
+
+class TestLambdad(unittest.TestCase):
+    def test_single_func_for_all_keys(self):
+        data = {"img": np.array([1, 2]), "seg": np.array([3, 4])}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x + 10)(data)
+        np.testing.assert_allclose(result["img"], np.array([11, 12]))
+        np.testing.assert_allclose(result["seg"], np.array([13, 14]))
+        # input dictionary is not modified in place
+        np.testing.assert_allclose(data["img"], np.array([1, 2]))
+
+    def test_func_per_key(self):
+        data = {"img": np.array([1, 2]), "seg": np.array([3, 4])}
+        result = Lambdad(keys=["img", "seg"], func=[lambda x: x * 2, lambda x: -x])(data)
+        np.testing.assert_allclose(result["img"], np.array([2, 4]))
+        np.testing.assert_allclose(result["seg"], np.array([-3, -4]))
+
+    def test_other_keys_untouched(self):
+        data = {"img": np.array([1, 2]), "meta": "info"}
+        result = Lambdad(keys="img", func=lambda x: x * 0)(data)
+        np.testing.assert_allclose(result["img"], np.array([0, 0]))
+        self.assertEqual(result["meta"], "info")
+
+    def test_invalid_func(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["img"], func=123)
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["img", "seg"], func=[lambda x: x, "bad"])
+
+
+if __name__ == "__main__":
+    unittest.main()
