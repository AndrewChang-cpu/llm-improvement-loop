+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies a user-supplied function to each of the specified items.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Union[Callable, Sequence[Callable]]):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: the callable to apply to the data. If a sequence is provided, it must have the same
+                length as `keys`, and each function is applied to the item with the corresponding key.
+
+        Raises:
+            ValueError: length of `func` does not match length of `keys`.
+            TypeError: each function in `func` must be a callable.
+
+        """
+        super().__init__(keys)
+        self.func = ensure_tuple_rep(func, len(self.keys))
+        for f in self.func:
+            if not callable(f):
+                raise TypeError("each function in argument `func` must be a callable.")
+        self.lambds = [Lambda(f) for f in self.func]
+
+    def __call__(self, data):
+        d = dict(data)
+        for idx, key in enumerate(self.keys):
+            d[key] = self.lambds[idx](d[key])
+        return d
+
+
