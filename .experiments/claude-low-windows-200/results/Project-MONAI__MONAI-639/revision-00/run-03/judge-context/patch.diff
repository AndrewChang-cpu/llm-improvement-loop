+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the input data. It allows arbitrary
+    processing of the data without writing a dedicated transform class.
+
+    Example::
+
+        Lambda(lambda x: x * 2)(np.array([1, 2]))  # -> array([2, 4])
+
+    Args:
+        func: the callable to apply to the input data. Its return value is the output of the transform.
+
+    Raises:
+        TypeError: argument `func` must be a callable.
+
+    """
+
+    def __init__(self, func: Callable):
+        if not callable(func):
+            raise TypeError("argument `func` must be a callable.")
+        self.func = func
+
+    def __call__(self, img):
+        """
+        Args:
+            img: data to be processed by the function.
+        """
+        return self.func(img)
+
+
