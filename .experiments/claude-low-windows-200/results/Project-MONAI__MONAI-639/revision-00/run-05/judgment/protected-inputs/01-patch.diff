+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the user-supplied function(s) to the items specified by `keys`.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Union[Callable, Sequence[Callable]]):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: a callable applied to every item in `keys`, or a sequence of callables with
+                the same length as `keys`, one per key.
+
+        Raises:
+            ValueError: length of `func` does not match length of `keys` when a sequence is given.
+            TypeError: every element of `func` must be a callable.
+        """
+        super().__init__(keys)
+        funcs = ensure_tuple_rep(func, len(self.keys))
+        self.lambdas = [Lambda(f) for f in funcs]
+
+    def __call__(self, data):
+        d = dict(data)
+        for key, converter in zip(self.keys, self.lambdas):
+            d[key] = converter(d[key])
+        return d
+
+
