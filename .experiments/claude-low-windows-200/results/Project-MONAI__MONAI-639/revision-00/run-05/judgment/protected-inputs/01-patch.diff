@@ -291,3 +291,26 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the input data. This is useful for quick, one-off
+    transformations that do not warrant a dedicated transform class, for example::
+
+        Lambda(lambda x: x * 2)(np.array([1, 2]))  # -> array([2, 4])
+
+    Args:
+        func: a callable that takes the input data and returns the transformed data.
+
+    Raises:
+        TypeError: argument `func` must be a callable.
+    """
+
+    def __init__(self, func: Callable):
+        if not callable(func):
+            raise TypeError("argument `func` must be a callable.")
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
