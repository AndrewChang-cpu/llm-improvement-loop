+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad
+
+
+class TestLambdad(unittest.TestCase):
+    def test_single_func_applied_to_all_keys(self):
+        input_data = {"img": np.array([1, 2]), "seg": np.array([3, 4]), "other": np.array([5])}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x + 10)(input_data)
+        np.testing.assert_allclose(result["img"], np.array([11, 12]))
+        np.testing.assert_allclose(result["seg"], np.array([13, 14]))
+        # keys not listed are untouched
+        np.testing.assert_allclose(result["other"], np.array([5]))
+
+    def test_func_per_key(self):
+        input_data = {"img": np.array([1.0, 2.0]), "seg": np.array([1, 0])}
+        result = Lambdad(keys=["img", "seg"], func=[lambda x: x * 2, lambda x: 1 - x])(input_data)
+        np.testing.assert_allclose(result["img"], np.array([2.0, 4.0]))
+        np.testing.assert_allclose(result["seg"], np.array([0, 1]))
+
+    def test_input_not_modified(self):
+        input_data = {"img": np.array([1, 2])}
+        Lambdad(keys=["img"], func=lambda x: x * 0)(input_data)
+        np.testing.assert_allclose(input_data["img"], np.array([1, 2]))
+
+    def test_length_mismatch_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=["img", "seg"], func=[lambda x: x])
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
