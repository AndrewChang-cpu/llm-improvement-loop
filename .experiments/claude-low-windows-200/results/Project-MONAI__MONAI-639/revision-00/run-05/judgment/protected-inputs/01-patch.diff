+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambda
+
+
+class TestLambda(unittest.TestCase):
+    def test_lambda_numpy(self):
+        result = Lambda(lambda x: x * 2)(np.array([1, 2]))
+        np.testing.assert_allclose(result, np.array([2, 4]))
+
+    def test_named_function(self):
+        def add_one(x):
+            return x + 1
+
+        result = Lambda(add_one)(np.array([0.0, 1.0]))
+        np.testing.assert_allclose(result, np.array([1.0, 2.0]))
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(TypeError):
+            Lambda("not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
