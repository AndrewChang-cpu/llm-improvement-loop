@@ -35,6 +35,31 @@ class Identity(Transform):
         return np.asanyarray(img)
 
 
+class Lambda(Transform):
+    """
+    Apply a user-defined lambda or function to the data.
+
+    This transform makes it easy to insert ad-hoc operations into a transform chain
+    without writing a new transform class. The callable receives the whole input and
+    its return value becomes the output.
+
+    Args:
+        func: user-defined callable (typically a ``lambda`` expression) applied to the input.
+
+    Raises:
+        ValueError: argument `func` must be a callable.
+
+    """
+
+    def __init__(self, func: Callable):
+        if not callable(func):
+            raise ValueError("argument `func` must be a callable.")
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
+
+
