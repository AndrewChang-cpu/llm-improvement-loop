+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+
+
+class TestLambdad(unittest.TestCase):
+    def test_lambdad_dict(self):
+        data = {"img": np.array([1.0, 2.0]), "seg": np.array([0, 1]), "meta": "keep"}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x + 1)(data)
+        np.testing.assert_allclose(result["img"], np.array([2.0, 3.0]))
+        np.testing.assert_allclose(result["seg"], np.array([1, 2]))
+        self.assertEqual(result["meta"], "keep")
+
+    def test_input_not_modified(self):
+        data = {"img": np.array([1.0, 2.0])}
+        Lambdad(keys="img", func=lambda x: x * 10)(data)
+        np.testing.assert_allclose(data["img"], np.array([1.0, 2.0]))
+
+    def test_invalid_func(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys="img", func="not_callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
