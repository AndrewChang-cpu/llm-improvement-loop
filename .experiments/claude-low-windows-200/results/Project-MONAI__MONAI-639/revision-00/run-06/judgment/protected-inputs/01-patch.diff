+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+
+
+class TestLambda(unittest.TestCase):
+    def test_lambda_array(self):
+        img = np.array([[0.0, 1.0], [2.0, 3.0]])
+        result = Lambda(func=lambda x: x * 2)(img)
+        np.testing.assert_allclose(result, img * 2)
+
+    def test_lambda_changes_shape(self):
+        img = np.zeros((1, 4, 4))
+        result = Lambda(lambda x: x[0])(img)
+        self.assertEqual(result.shape, (4, 4))
+
+    def test_named_function(self):
+        def add_one(x):
+            return x + 1
+
+        np.testing.assert_allclose(Lambda(add_one)(np.zeros(3)), np.ones(3))
+
+    def test_invalid_func(self):
+        with self.assertRaises(ValueError):
+            Lambda(func=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
