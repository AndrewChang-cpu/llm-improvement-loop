+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same user-supplied function to each specified key.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Optional[Callable] = None):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: the function to apply to each item. It must be callable, otherwise a `TypeError` is raised.
+                If `None`, the items are returned unchanged.
+
+        Raises:
+            TypeError: argument `func` must be callable or None.
+        """
+        super().__init__(keys)
+        self.converter = Lambda(func=func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.converter(d[key])
+        return d
+
+
