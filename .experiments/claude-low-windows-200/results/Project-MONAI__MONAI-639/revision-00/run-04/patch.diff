+class Lambda(Transform):
+    """
+    Apply a user-supplied function to the input data. This is useful for
+    one-off custom operations that do not warrant a dedicated transform class.
+
+    Args:
+        func: the function to apply to the input data. It must be callable,
+            otherwise a `TypeError` is raised. If `None`, the input is returned unchanged.
+
+    Raises:
+        TypeError: argument `func` must be callable or None.
+
+    """
+
+    def __init__(self, func: Optional[Callable] = None) -> None:
+        if func is not None and not callable(func):
+            raise TypeError("argument `func` must be a callable or None.")
+        self.func = func
+
+    def __call__(self, img, func: Optional[Callable] = None):
+        """
+        Args:
+            img: the data to be transformed.
+            func: optional callable to use for this call only, overriding the one given at construction.
+        """
+        applied = self.func if func is None else func
+        if applied is None:
+            return img
+        if not callable(applied):
+            raise TypeError("argument `func` must be a callable or None.")
+        return applied(img)
+
+
