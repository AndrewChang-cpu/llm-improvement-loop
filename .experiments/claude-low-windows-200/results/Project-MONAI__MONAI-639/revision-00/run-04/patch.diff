+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambda
+
+
+class TestLambda(unittest.TestCase):
+    def test_lambda_function(self):
+        img = np.array([[1, 2], [3, 4]])
+        result = Lambda(func=lambda x: x * 2)(img)
+        np.testing.assert_array_equal(result, img * 2)
+
+    def test_none_returns_input(self):
+        img = np.array([1, 2, 3])
+        result = Lambda()(img)
+        np.testing.assert_array_equal(result, img)
+
+    def test_call_time_override(self):
+        img = np.array([1, 2, 3])
+        result = Lambda(func=lambda x: x + 1)(img, func=lambda x: x - 1)
+        np.testing.assert_array_equal(result, img - 1)
+
+    def test_invalid_func(self):
+        with self.assertRaises(TypeError):
+            Lambda(func=5)
+
+
+if __name__ == "__main__":
+    unittest.main()
