+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+
+
+class TestLambdad(unittest.TestCase):
+    def test_lambdad_applies_to_keys(self):
+        img = np.array([[1, 2], [3, 4]])
+        data = {"img": img, "seg": img + 1, "other": 7}
+        result = Lambdad(keys=["img", "seg"], func=lambda x: x * 2)(data)
+        np.testing.assert_array_equal(result["img"], img * 2)
+        np.testing.assert_array_equal(result["seg"], (img + 1) * 2)
+        self.assertEqual(result["other"], 7)
+
+    def test_input_not_mutated(self):
+        img = np.array([1, 2, 3])
+        data = {"img": img}
+        Lambdad(keys=["img"], func=lambda x: x + 1)(data)
+        np.testing.assert_array_equal(data["img"], np.array([1, 2, 3]))
+
+    def test_none_func_returns_unchanged(self):
+        img = np.array([1, 2, 3])
+        result = Lambdad(keys=["img"])({"img": img})
+        np.testing.assert_array_equal(result["img"], img)
+
+    def test_invalid_func(self):
+        with self.assertRaises(TypeError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
