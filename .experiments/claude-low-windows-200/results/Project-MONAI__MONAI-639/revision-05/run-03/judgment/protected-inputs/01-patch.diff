+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img}
+        identity = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = identity(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img}
+        slicer = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 1:10, ::-2])  # noqa: E731
+        expected = img[:, :, 1:10, ::-2]
+        result = slicer(data)
+        self.assertTrue(result["img"].size > 0)
+        self.assertTrue(np.allclose(expected, result["img"]))
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        meta = {"name": "sample"}
+        data = {"img": img, "meta": meta}
+        slicer = Lambdad(keys=["img"], func=lambda x: x[:, :, 1:10, ::-2])  # noqa: E731
+        result = slicer(data)
+        self.assertTrue(np.allclose(img[:, :, 1:10, ::-2], result["img"]))
+        self.assertIs(result["meta"], meta)
+        self.assertTrue(np.allclose(img, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
