+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad, LambdaD, LambdaDict
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        # slice only the spatial axes, keeping the leading batch and channel axes whole
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:50, ::-2])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:50, ::-2])
+        self.assertGreater(result["img"].size, 0)
+
+    def test_unlisted_entry_preserved(self):
+        meta = "metadata"
+        data = {"img": self.imt, "meta": meta}
+        original_img = self.imt.copy()
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:50, ::-2])(data)
+        np.testing.assert_allclose(result["img"], original_img[:, :, 10:50, ::-2])
+        self.assertEqual(result["meta"], meta)
+        # the caller's mapping is not modified
+        np.testing.assert_allclose(data["img"], original_img)
+
+    def test_aliases(self):
+        self.assertIs(LambdaD, Lambdad)
+        self.assertIs(LambdaDict, Lambdad)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not_callable")
+
+    def test_empty_keys_raises(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
