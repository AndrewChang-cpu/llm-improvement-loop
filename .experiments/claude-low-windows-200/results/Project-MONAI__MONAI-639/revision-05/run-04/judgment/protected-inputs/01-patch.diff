+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The same callable is applied to the value of every listed key.
+
+    Example:
+        >>> import numpy as np
+        >>> data = {"img": np.arange(8).reshape(1, 2, 4)}
+        >>> out = Lambdad(keys=["img"], func=lambda x: x[:, 1:, ::-1])(data)
+        >>> out["img"].shape
+        (1, 1, 4)
+
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: a single callable applied to the value of every listed key. It is passed whole
+                to :py:class:`monai.transforms.Lambda` for each key, even if it is also iterable.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
