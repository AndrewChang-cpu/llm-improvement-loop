+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+
+    def test_slicing(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:, ::-2])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:, ::-2])
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "meta": "unchanged"}
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:, ::-2])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 10:, ::-2])
+        self.assertEqual(result["meta"], "unchanged")
+        self.assertIs(data["img"], self.imt)
+        self.assertEqual(data["img"].shape, self.imt.shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
