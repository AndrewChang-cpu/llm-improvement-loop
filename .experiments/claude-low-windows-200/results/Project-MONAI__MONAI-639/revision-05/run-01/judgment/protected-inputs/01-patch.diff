+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_func(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x)
+        result = transform(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+
+    def test_slicing_func(self):
+        img = self.imt
+        data = {"img": img}
+        transform = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 2:40, ::-2])
+        result = transform(data)
+        expected = img[:, :, 2:40, ::-2]
+        self.assertEqual(result["img"].shape, expected.shape)
+        self.assertTrue(np.allclose(expected, result["img"]))
+
+    def test_unlisted_entry_preserved(self):
+        img = self.imt
+        meta = "unchanged"
+        data = {"img": img, "meta": meta}
+        transform = Lambdad(keys=["img"], func=lambda x: x[:, :, 2:40, ::-2])
+        result = transform(data)
+        expected = img[:, :, 2:40, ::-2]
+        self.assertTrue(np.allclose(expected, result["img"]))
+        self.assertEqual(result["meta"], meta)
+        self.assertIs(data["img"], img)
+        self.assertEqual(data["meta"], meta)
+        self.assertEqual(data["img"].shape, img.shape)
+
+
+if __name__ == "__main__":
+    unittest.main()
