+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity_keys_view(self):
+        data = {"img": self.imt}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+
+    def test_slicing_keys_view(self):
+        data = {"img": self.imt}
+        # slice spatial axes only; leading batch and channel axes are kept whole
+        result = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 10:, ::-2])(data)
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:, ::-2])
+
+    def test_unlisted_entry_preserved(self):
+        data = {"img": self.imt, "meta": "info"}
+        original_img = data["img"]
+        result = Lambdad(keys=["img"], func=lambda x: x[:, :, 10:, ::-2])(data)
+        self.assertEqual(result["meta"], "info")
+        np.testing.assert_array_equal(result["img"], self.imt[:, :, 10:, ::-2])
+        # the input mapping is not modified
+        self.assertIs(data["img"], original_img)
+        np.testing.assert_array_equal(data["img"], self.imt)
+
+
+if __name__ == "__main__":
+    unittest.main()
