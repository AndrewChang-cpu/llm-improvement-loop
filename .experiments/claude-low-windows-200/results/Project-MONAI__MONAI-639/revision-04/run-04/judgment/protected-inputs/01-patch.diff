@@ -291,3 +291,27 @@ class SimulateDelay(Transform):
     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a caller-supplied callable to the input value and return what it returns.
+    The input is passed through unchanged.
+
+    Example:
+        .. code-block:: python
+
+            img = np.arange(6).reshape(1, 2, 3)
+            trans = Lambda(func=lambda x: x[:, 0:1])
+            out = trans(img)  # out has shape (1, 1, 3)
+
+    Args:
+        func: callable applied to the input value; it must accept the input and return the transformed value.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
