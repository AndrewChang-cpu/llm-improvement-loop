     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The input is passed to the callable unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            x = np.zeros((1, 4, 6))
+            out = Lambda(func=lambda x: x[:, 1:3, ::2])(x)
+            # out.shape == (1, 2, 3)
+
+    Args:
+        func: callable applied to the input value, e.g. ``lambda x: x[:, 1:3, ::2]``.
+            It must accept the input and return the transformed value.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
