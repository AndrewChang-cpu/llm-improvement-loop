+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    Applies the same callable to each listed key and returns a new dictionary;
+    the input dictionary is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            data = {"img": np.zeros((1, 4, 6)), "seg": np.zeros((1, 4, 6))}
+            out = Lambdad(keys=data.keys(), func=lambda x: x[:, 1:3, ::2])(data)
+            # out["img"].shape == (1, 2, 3), out["seg"].shape == (1, 2, 3)
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        """
+        Args:
+            keys: keys of the corresponding items to be transformed.
+                See also: :py:class:`monai.transforms.compose.MapTransform`
+            func: callable applied to each listed item. A single callable is required;
+                a list or tuple of callables is not supported.
+        """
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
