+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x)(img)
+        np.testing.assert_allclose(result, self.imt)
+
+    def test_slicing(self):
+        img = self.imt
+        result = Lambda(func=lambda x: x[:, :, 5:100, 60::-2])(img)
+        expected = self.imt[:, :, 5:100, 60::-2]
+        self.assertEqual(result.shape, expected.shape)
+        self.assertGreater(result.size, 0)
+        np.testing.assert_allclose(result, expected)
+
+
+if __name__ == "__main__":
+    unittest.main()
