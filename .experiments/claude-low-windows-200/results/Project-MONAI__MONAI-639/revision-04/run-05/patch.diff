+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import LambdaD
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        original = {"img": self.imt.copy(), "seg": self.seg1.copy()}
+        result = LambdaD(keys=data.keys(), func=lambda x: x)(data)
+        self.assertIsNot(result, data)
+        np.testing.assert_allclose(result["img"], original["img"])
+        np.testing.assert_allclose(result["seg"], original["seg"])
+        np.testing.assert_allclose(data["img"], original["img"])
+        np.testing.assert_allclose(data["seg"], original["seg"])
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        original = {"img": self.imt.copy(), "seg": self.seg1.copy()}
+        result = LambdaD(keys=data.keys(), func=lambda x: x[:, :, 5:100, 60::-2])(data)
+        expected_img = self.imt[:, :, 5:100, 60::-2]
+        expected_seg = self.seg1[:, :, 5:100, 60::-2]
+        self.assertGreater(expected_img.size, 0)
+        self.assertEqual(result["img"].shape, expected_img.shape)
+        self.assertEqual(result["seg"].shape, expected_seg.shape)
+        np.testing.assert_allclose(result["img"], expected_img)
+        np.testing.assert_allclose(result["seg"], expected_seg)
+        np.testing.assert_allclose(data["img"], original["img"])
+        np.testing.assert_allclose(data["seg"], original["seg"])
+
+
+if __name__ == "__main__":
+    unittest.main()
