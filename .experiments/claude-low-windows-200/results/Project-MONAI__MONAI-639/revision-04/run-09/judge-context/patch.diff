+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def _slice_spatial(x):
+    # leave batch and channel axes whole; slice only the spatial axes
+    return x[:, :, 10:100, ::-2]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        keys = {"img": None}.keys()
+        data = {"img": img, "other": img.copy()}
+        lambd = Lambdad(keys=keys, func=lambda x: x)
+        out = lambd(data)
+        self.assertTrue(np.allclose(img, out["img"]))
+        self.assertTrue(np.allclose(img, data["img"]))
+        self.assertTrue(np.allclose(img, out["other"]))
+
+    def test_slice(self):
+        img = self.imt
+        keys = {"img": None}.keys()
+        data = {"img": img, "other": img.copy()}
+        expected = img[:, :, 10:100, ::-2]
+        self.assertGreater(expected.size, 0)
+        lambd = Lambdad(keys=keys, func=_slice_spatial)
+        out = lambd(data)
+        self.assertTrue(np.array_equal(expected, out["img"]))
+        self.assertTrue(np.array_equal(img, data["img"]))
+        self.assertTrue(np.array_equal(img, out["other"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
