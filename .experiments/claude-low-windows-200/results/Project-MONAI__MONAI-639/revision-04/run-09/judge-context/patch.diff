+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.utility.array.Lambda`.
+    Apply the same callable to each configured key of the data mapping. The input
+    mapping is copied, and the caller's mapping is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            lambd = Lambdad(keys="img", func=lambda x: x[..., 1:])
+            out = lambd({"img": np.zeros((2, 3, 4))})  # out["img"] has shape (2, 3, 3)
+
+    Args:
+        keys: keys of the data items to be transformed. See also:
+            :py:class:`monai.transforms.compose.MapTransform`
+        func: callable applied to every item listed in ``keys``. It must accept the item and return the
+            transformed item. A list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
