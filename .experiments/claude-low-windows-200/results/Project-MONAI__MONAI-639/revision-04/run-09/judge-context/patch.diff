+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def _slice_spatial(x):
+    # leave batch and channel axes whole; slice only the spatial axes
+    return x[:, :, 10:100, ::-2]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        lambd = Lambda(func=lambda x: x)
+        self.assertTrue(np.allclose(img, lambd(img)))
+
+    def test_slice(self):
+        img = self.imt
+        expected = img[:, :, 10:100, ::-2]
+        self.assertGreater(expected.size, 0)
+        lambd = Lambda(func=_slice_spatial)
+        self.assertTrue(np.array_equal(expected, lambd(img)))
+
+
+if __name__ == "__main__":
+    unittest.main()
