+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+def identity_func(x):
+    return x
+
+
+def slice_func(x):
+    # leave the batch and channel axes whole, slice only the spatial axes
+    return x[:, :, 10:100, ::-2]
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "other": img.copy()}
+        result = Lambdad(keys=data.keys(), func=identity_func)(data)
+        self.assertTrue(np.allclose(img, result["img"]))
+        self.assertTrue(np.allclose(img, result["other"]))
+        self.assertIsNot(result, data)
+
+    def test_slice(self):
+        img = self.imt
+        data = {"img": img, "other": img.copy()}
+        expected = img[:, :, 10:100, ::-2]
+        self.assertGreater(expected.size, 0)
+        result = Lambdad(keys=data.keys(), func=slice_func)(data)
+        self.assertTrue(np.allclose(expected, result["img"]))
+        self.assertTrue(np.allclose(expected, result["other"]))
+        # the caller's mapping is not modified
+        self.assertEqual(data["img"].shape, img.shape)
+        self.assertTrue(np.allclose(img, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
