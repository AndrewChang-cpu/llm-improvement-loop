+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+def identity_func(x):
+    return x
+
+
+def slice_func(x):
+    # leave the batch and channel axes whole, slice only the spatial axes
+    return x[:, :, 10:100, ::-2]
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        result = Lambda(identity_func)(img)
+        self.assertTrue(np.allclose(img, result))
+
+    def test_slice(self):
+        img = self.imt
+        expected = img[:, :, 10:100, ::-2]
+        self.assertGreater(expected.size, 0)
+        result = Lambda(slice_func)(img)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
