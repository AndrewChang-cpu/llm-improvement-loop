+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.dictionary import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        data = {"img": img, "meta": "info"}
+        identity = Lambdad(keys=data.keys(), func=lambda x: x)
+        out = identity(data)
+        self.assertTrue(np.allclose(img, out["img"]))
+        self.assertEqual(out["meta"], "info")
+        self.assertIsNot(out, data)
+
+    def test_slicing(self):
+        img = self.imt
+        data = {"img": img, "meta": "info"}
+        # leave batch and channel axes whole; slice the spatial axes only
+        expected = img[:, :, 1:, ::-1]
+        slicer = Lambdad(keys=data.keys(), func=lambda x: x[:, :, 1:, ::-1])
+        out = slicer(data)
+        self.assertEqual(out["img"].shape, expected.shape)
+        self.assertTrue(np.allclose(expected, out["img"]))
+        self.assertEqual(out["meta"], "info")
+        # the original mapping is not modified
+        self.assertTrue(np.allclose(img, data["img"]))
+
+
+if __name__ == "__main__":
+    unittest.main()
