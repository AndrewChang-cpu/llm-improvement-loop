     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value. The input is passed to the callable
+    unchanged, and the callable's return value is returned.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(24).reshape(1, 2, 3, 4)
+            out = Lambda(lambda x: x[:, 1:, ::-1])(img)  # out.shape is (1, 1, 3, 4)
+
+    Args:
+        func: the callable applied to the input. It receives the whole input value
+            and returns the transformed value.
+    """
+
+    def __init__(self, func: Callable) -> None:
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
