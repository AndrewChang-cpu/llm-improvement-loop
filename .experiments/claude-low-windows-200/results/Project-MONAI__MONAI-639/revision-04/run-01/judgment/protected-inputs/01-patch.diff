+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`. The callable is applied to
+    the value of each listed key. The input mapping is copied and the original is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(24).reshape(1, 2, 3, 4), "label": np.arange(24).reshape(1, 2, 3, 4)}
+            out = Lambdad(keys=data.keys(), func=lambda x: x[:, 1:, ::-1])(data)
+            # out["img"].shape and out["label"].shape are both (1, 1, 3, 4)
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: a single callable applied to the value of every listed key. A list or tuple
+            of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable) -> None:
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
