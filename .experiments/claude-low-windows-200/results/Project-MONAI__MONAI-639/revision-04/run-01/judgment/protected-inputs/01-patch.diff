+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms.utility.array import Lambda
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambda(NumpyImageTestCase2D):
+    def test_identity(self):
+        img = self.imt
+        identity = Lambda(lambda x: x)
+        self.assertTrue(np.allclose(img, identity(img)))
+
+    def test_slicing(self):
+        img = self.imt
+        # leave batch and channel axes whole; slice the spatial axes only
+        expected = img[:, :, 1:, ::-1]
+        slicer = Lambda(lambda x: x[:, :, 1:, ::-1])
+        result = slicer(img)
+        self.assertEqual(result.shape, expected.shape)
+        self.assertTrue(np.allclose(expected, result))
+
+
+if __name__ == "__main__":
+    unittest.main()
