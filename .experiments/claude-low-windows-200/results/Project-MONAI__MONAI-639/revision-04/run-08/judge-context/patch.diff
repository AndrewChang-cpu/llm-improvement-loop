+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        result = Lambdad(keys=data.keys(), func=lambda x: x)(data)
+        np.testing.assert_array_equal(result["img"], self.imt)
+        np.testing.assert_array_equal(result["seg"], self.seg1)
+
+    def test_slicing(self):
+        data = {"img": self.imt, "seg": self.seg1}
+        keys = {"img": None}.keys()
+        result = Lambdad(keys=keys, func=lambda x: x[:, :, 10:50, ::-2])(data)
+        expected = self.imt[:, :, 10:50, ::-2]
+        self.assertGreater(expected.size, 0)
+        np.testing.assert_array_equal(result["img"], expected)
+        np.testing.assert_array_equal(result["seg"], self.seg1)
+        # the caller's mapping is not modified
+        np.testing.assert_array_equal(data["img"], self.imt)
+        self.assertIsNot(result, data)
+
+    def test_non_callable(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys="img", func="not callable")
+
+    def test_empty_keys(self):
+        with self.assertRaises(ValueError):
+            Lambdad(keys=[], func=lambda x: x)
+
+
+if __name__ == "__main__":
+    unittest.main()
