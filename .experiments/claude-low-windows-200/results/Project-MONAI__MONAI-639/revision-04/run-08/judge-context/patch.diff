     def __call__(self, img, delay_time=None):
         time.sleep(self.delay_time if delay_time is None else delay_time)
         return img
+
+
+class Lambda(Transform):
+    """
+    Apply a user-supplied callable to the input value and return its result.
+    The input is passed to ``func`` unchanged.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambda
+
+            img = np.arange(6).reshape(2, 3)
+            out = Lambda(func=lambda x: x[:, 1:])(img)  # keeps the columns from index 1 onward, shape (2, 2)
+
+    Args:
+        func: a callable applied to the input value. It receives the value passed to the transform
+            and its return value is returned unchanged.
+    """
+
+    def __init__(self, func: Callable):
+        assert callable(func), "func must be callable"
+        self.func = func
+
+    def __call__(self, img):
+        return self.func(img)
