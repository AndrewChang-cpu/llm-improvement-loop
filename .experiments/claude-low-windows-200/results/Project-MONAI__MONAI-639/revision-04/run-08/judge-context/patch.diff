+class Lambdad(MapTransform):
+    """
+    Dictionary-based wrapper of :py:class:`monai.transforms.Lambda`.
+    The callable is applied to the value of each configured key, and the results are stored
+    in a new dictionary. The input mapping is not modified.
+
+    Example:
+
+        .. code-block:: python
+
+            import numpy as np
+            from monai.transforms import Lambdad
+
+            data = {"img": np.arange(6).reshape(2, 3), "seg": np.arange(6).reshape(2, 3)}
+            out = Lambdad(keys=["img"], func=lambda x: x[:, 1:])(data)
+            # out["img"] keeps the columns from index 1 onward, shape (2, 2); out["seg"] is unchanged
+
+    Args:
+        keys: keys of the corresponding items to be transformed.
+            See also: :py:class:`monai.transforms.compose.MapTransform`
+        func: a single callable applied to the value of every key in ``keys``.
+            A list or tuple of callables is not supported.
+    """
+
+    def __init__(self, keys: KeysCollection, func: Callable):
+        super().__init__(keys)
+        self.lambd = Lambda(func)
+
+    def __call__(self, data):
+        d = dict(data)
+        for key in self.keys:
+            d[key] = self.lambd(d[key])
+        return d
+
+
