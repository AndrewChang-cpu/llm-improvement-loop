+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import unittest
+
+import numpy as np
+from monai.transforms import Lambdad
+from tests.utils import NumpyImageTestCase2D
+
+
+class TestLambdad(NumpyImageTestCase2D):
+    def test_identity(self):
+        keys = {"img": None, "seg": None}.keys()
+        data = {"img": self.imt, "seg": self.segn, "other": 1}
+        result = Lambdad(keys=keys, func=lambda x: x)(data)
+        np.testing.assert_allclose(result["img"], self.imt)
+        np.testing.assert_allclose(result["seg"], self.segn)
+        self.assertEqual(result["other"], 1)
+
+    def test_slicing(self):
+        keys = {"img": None, "seg": None}.keys()
+        data = {"img": self.imt, "seg": self.segn, "other": 1}
+        result = Lambdad(keys=keys, func=lambda x: x[:, :, 1:, ::-2])(data)
+        np.testing.assert_allclose(result["img"], self.imt[:, :, 1:, ::-2])
+        np.testing.assert_allclose(result["seg"], self.segn[:, :, 1:, ::-2])
+        self.assertEqual(result["other"], 1)
+        np.testing.assert_allclose(data["img"], self.imt)
+
+    def test_non_callable_raises(self):
+        with self.assertRaises(AssertionError):
+            Lambdad(keys=["img"], func="not callable")
+
+
+if __name__ == "__main__":
+    unittest.main()
