+
+    def test_namespace_prefix_membership(self):
+        """Namespace membership is a prefix test on the reference text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of the namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "URI containing but not beginning with the namespace text",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text should be a member of itself",
+        )
+
+    def test_closed_namespace_membership_rdfs(self):
+        """Closed membership for RDFS only matches defined terms"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined term rdfs:label should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "plain string with term text should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "Literal with term text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        """Closed membership for RDF matches defined terms"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined term rdf:type should be a member",
+        )
