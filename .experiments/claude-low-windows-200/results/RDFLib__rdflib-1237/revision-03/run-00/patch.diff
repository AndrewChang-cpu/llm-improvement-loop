@@ -214,8 +218,15 @@ class ClosedNamespace(object):
     def __dir__(self):
         return list(self._ClosedNamespace__uris)
 
+    def __contains__(self, ref):
+        # Closed membership: ref must be a URIRef equal (node-type-aware)
+        # to one of the stored term URIs. Plain strings and Literals never match.
+        if not isinstance(ref, URIRef):
+            return False
+        return any(ref == uri for uri in self.__uris.values())
