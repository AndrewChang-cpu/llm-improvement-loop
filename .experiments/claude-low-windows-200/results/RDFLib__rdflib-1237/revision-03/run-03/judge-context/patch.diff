+
+    def test_namespace_prefix_membership(self):
+        """A reference is a member when it begins with the namespace text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text itself should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of the namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "URI containing but not beginning with the namespace should not match",
+        )
+
+    def test_closed_namespace_membership_rdfs(self):
+        """Closed membership for RDFS: defined terms only"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined RDFS term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "plain string with a defined term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "Literal with a defined term's text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        """Closed membership for RDF: a defined term is a member"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined RDF term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership property should not be a member",
+        )
