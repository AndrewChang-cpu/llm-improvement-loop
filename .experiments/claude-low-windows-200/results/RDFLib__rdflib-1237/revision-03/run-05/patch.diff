@@ -139,6 +139,12 @@ class Namespace(str):
         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        # Prefix membership: ref belongs if its text begins with this
+        # namespace's text. The namespace is passed as the prefix argument
+        # and ref is the value being tested, so the direction is correct.
+        return str.startswith(ref, self)
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
@@ -214,8 +220,15 @@ class ClosedNamespace(object):
     def __dir__(self):
         return list(self._ClosedNamespace__uris)
 
+    def __contains__(self, ref):
+        # Closed membership: ref must be a URIRef equal (node-type-aware)
+        # to one of the full term URIs stored for this namespace.
+        # Container membership properties are not stored, so they are not
+        # members.
+        return any(ref == uri for uri in self.__uris.values())
+
     def _ipython_key_completions_(self):
-        return dir(self)
+        return dir(self.uri)
 
 
 class _RDFNamespace(ClosedNamespace):
