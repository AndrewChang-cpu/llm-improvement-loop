+
+    def test_namespace_contains_prefix(self):
+        """Prefix membership on Namespace compares the reference's text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "a reference equal to the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("urn:x/http://example.org/thing") in ns,
+            "a URI that contains but does not begin with the text is not a member",
+        )
+
+    def test_sh_contains(self):
+        """SH is a prefix Namespace, so membership is a prefix test"""
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "a SHACL URI should be a member of SH",
+        )
+
+    def test_closed_namespace_contains_rdfs(self):
+        """Closed membership on RDFS: defined terms only"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "an undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "a plain string with a term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "a Literal with a term's text should not be a member",
+        )
+
+    def test_closed_namespace_contains_rdf(self):
+        """Closed membership on RDF: a defined term is a member"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "a container membership property is not a stored term",
+        )
