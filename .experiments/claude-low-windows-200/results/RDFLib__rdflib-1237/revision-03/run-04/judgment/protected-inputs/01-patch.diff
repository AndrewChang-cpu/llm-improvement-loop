+from rdflib.namespace import FOAF, RDF, RDFS, Namespace
+from rdflib.term import Literal, URIRef
 
 
 class NamespacePrefixTest(unittest.TestCase):
+    def test_namespace_contains_prefix(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "proper prefix of the namespace text should not be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "namespace text should be a member of itself",
+        )
+
+    def test_closed_namespace_contains_rdfs(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "defined RDFS term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "plain string with defined term text should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "Literal with defined term text should not be a member",
+        )
+
+    def test_closed_namespace_contains_rdf(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#type") in RDF,
+            "defined RDF term should be a member",
+        )
+
