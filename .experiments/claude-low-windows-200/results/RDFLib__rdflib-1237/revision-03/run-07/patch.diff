+
+    def test_namespace_prefix_membership(self):
+        """Namespace membership is a prefix test on the reference text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "a URI beginning with the namespace text should be a member",
+        )
+        self.assertTrue(
+            URIRef("http://example.org/") in ns,
+            "a reference equal to the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://example.org") in ns,
+            "a proper prefix of the namespace text should not be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "a URI containing but not starting with the namespace is not a member",
+        )
+
+    def test_closed_namespace_membership_rdfs(self):
+        """Closed membership for RDFS: defined terms only"""
+        self.assertTrue(
+            RDFS.label in RDFS, "rdfs:label is a defined term and should be a member"
+        )
+        self.assertFalse(
+            URIRef(str(RDFS) + "example") in RDFS,
+            "rdfs:example shares the base but is not a defined term",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "a plain string with a term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "a Literal with a term's text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        """Closed membership for RDF: a defined term is a member"""
+        self.assertTrue(RDF.type in RDF, "rdf:type should be a member")
+
+    def test_closed_namespace_membership_sh(self):
+        """Prefix membership for the SHACL Namespace instance"""
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "a URI beginning with the SHACL namespace text should be a member",
+        )
