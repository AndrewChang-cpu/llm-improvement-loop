@@ -139,6 +139,23 @@ class Namespace(str):
         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """
+        Return True if ``ref`` is a URI within this namespace, i.e. it
+        starts with the namespace URI. Plain substring matching (the
+        inherited ``str`` behaviour) is not used.
+
+        >>> from rdflib import Namespace, URIRef
+        >>> ns = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/Person") in ns
+        True
+        >>> URIRef("http://other.org/Person") in ns
+        False
+        """
+        if not isinstance(ref, str):
+            return False
+        return str.startswith(ref, str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
