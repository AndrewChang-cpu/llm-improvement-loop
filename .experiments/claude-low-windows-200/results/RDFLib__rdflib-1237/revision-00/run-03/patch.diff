@@ -139,6 +139,21 @@ class Namespace(str):
         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """
+        Return True if ``ref`` lies within this namespace, i.e. it starts
+        with the namespace URI. Overrides the default substring semantics
+        of ``str.__contains__``.
+
+        >>> from rdflib import Namespace, URIRef
+        >>> n = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/Person") in n
+        True
+        >>> URIRef("http://other.org/example.org/Person") in n
+        False
+        """
+        return str(ref).startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
