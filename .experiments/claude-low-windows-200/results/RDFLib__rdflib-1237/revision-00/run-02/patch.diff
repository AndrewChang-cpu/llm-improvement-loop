@@ -139,6 +139,15 @@ class Namespace(str):
         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """Return True if ``ref`` is a URI within this namespace.
+
+        A URI is in the namespace when it starts with the namespace URI,
+        so ``ref in ns`` is equivalent to ``str(ref).startswith(str(ns))``.
+        This overrides the plain substring test inherited from ``str``.
+        """
+        return str(ref).startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
@@ -803,6 +812,10 @@ class NamespaceManager(object):
             namespace = URIRef(namespace)
             yield prefix, namespace
 
+    def __contains__(self, ref):
+        """Return True if ``ref`` falls within any namespace bound to this manager."""
+        return any(str(ref).startswith(str(ns)) for _, ns in self.namespaces())
+
     def absolutize(self, uri, defrag=1):
         base = urljoin("file:", pathname2url(os.getcwd()))
         result = urljoin("%s/" % base, uri, allow_fragments=not defrag)
