diff --git a/rdflib/namespace.py b/rdflib/namespace.py
index aa1b4d0..1e252b7 100644
--- a/rdflib/namespace.py
+++ b/rdflib/namespace.py
@@ -133,6 +133,22 @@ class Namespace(str):
     def __getitem__(self, key, default=None):
         return self.term(key)
 
+    def __contains__(self, ref):
+        """
+        Returns True if ``ref`` is a URI that falls within this namespace,
+        i.e. it starts with the namespace URI.
+
+        >>> from rdflib import Namespace, URIRef
+        >>> ns = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/Person") in ns
+        True
+        >>> URIRef("http://other.org/Person") in ns
+        False
+        """
+        if not isinstance(ref, str):
+            return False
+        return ref.startswith(str(self))
+
     def __getattr__(self, name):
         if name.startswith("__"):  # ignore any special Python names!
             raise AttributeError
