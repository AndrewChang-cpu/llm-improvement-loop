@@ -139,6 +139,17 @@ class Namespace(str):
         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """Return True if ``ref`` is a URI within this namespace.
+
+        Membership is tested by prefix, not by substring, so
+        ``ref in ns`` is equivalent to ``str(ref).startswith(str(ns))``.
+        Non-string values are never members.
+        """
+        if not isinstance(ref, str):
+            return False
+        return str(ref).startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
