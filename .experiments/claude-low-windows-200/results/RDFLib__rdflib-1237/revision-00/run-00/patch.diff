+    def __contains__(self, ref):
+        """
+        Return True if the URI ``ref`` lies within this namespace,
+        i.e. it starts with the namespace URI.
+
+        Unlike plain ``str`` containment, this checks for a prefix match
+        only, so ``"http://example.org/x" in Namespace("http://example.org/")``
+        is True while ``"x" in ...`` is not.
+        """
+        return str(ref).startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
