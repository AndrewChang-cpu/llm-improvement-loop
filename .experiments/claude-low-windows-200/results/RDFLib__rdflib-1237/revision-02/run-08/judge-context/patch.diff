+
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/Person") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/Person") in ns,
+            "URI merely containing the namespace text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdfs(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "plain string with defined term text should not be a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "Literal with defined term text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership property is not a stored term",
+        )
+
+    def test_shacl_namespace_membership(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "sh:example should be a member of the SHACL namespace",
+        )
