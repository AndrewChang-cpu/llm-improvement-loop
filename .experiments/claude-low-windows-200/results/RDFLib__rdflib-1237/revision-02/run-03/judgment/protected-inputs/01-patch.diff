 class NamespacePrefixTest(unittest.TestCase):
@@ -112,3 +112,38 @@ class NamespacePrefixTest(unittest.TestCase):
             add_not_in_namespace("givenName"),
             URIRef("http://xmlns.com/foaf/0.1/givenName"),
         )
+
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with the namespace should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/thing") in ns,
+            "URI merely containing the namespace text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdfs(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "undefined term sharing the RDFS base should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with a term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with a term's text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
