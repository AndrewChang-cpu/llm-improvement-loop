+class NamespaceMembershipTest(unittest.TestCase):
+    """Tests for the `in` operator on Namespace and ClosedNamespace"""
+
+    def test_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/Person") in ns,
+            "URIRef starting with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/Person") in ns,
+            "URIRef containing but not starting with the text is not a member",
+        )
+
+    def test_prefix_membership_shacl(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "sh:example should be a member of SH",
+        )
+
+    def test_closed_membership_rdfs(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "rdfs:example shares the base but is not a defined term",
+        )
+
+    def test_closed_membership_rdfs_non_uriref(self):
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with the text of a term should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with the text of a term should not be a member",
+        )
+
+    def test_closed_membership_rdf(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type should be a member of RDF",
+        )
+
+    def test_closed_membership_rdf_container_property(self):
+        self.assertFalse(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF,
+            "container membership properties are not stored terms",
+        )
