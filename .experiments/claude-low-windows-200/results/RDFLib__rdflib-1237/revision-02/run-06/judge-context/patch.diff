+from rdflib.namespace import FOAF, RDF, RDFS, Namespace
+from rdflib.term import Literal, URIRef
+
+
+class NamespaceMembershipTest(unittest.TestCase):
+    def test_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/thing") in ns,
+            "URI containing but not beginning with the namespace text is not",
+        )
+
+    def test_closed_membership_rdfs(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined RDFS term should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "term sharing the RDFS base but not defined should not be a member",
+        )
+
+    def test_closed_membership_rdfs_non_uriref(self):
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with defined term text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with defined term text should not be a member",
+        )
+
+    def test_closed_membership_rdf(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined RDF term should be a member",
+        )
 
 
