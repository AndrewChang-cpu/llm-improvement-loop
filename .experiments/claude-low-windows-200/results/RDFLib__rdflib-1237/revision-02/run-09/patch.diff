 class NamespacePrefixTest(unittest.TestCase):
@@ -112,3 +112,41 @@ class NamespacePrefixTest(unittest.TestCase):
             add_not_in_namespace("givenName"),
             URIRef("http://xmlns.com/foaf/0.1/givenName"),
         )
+
+    def test_namespace_contains_prefix(self):
+        """Prefix membership on a Namespace"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/Person") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ns,
+            "URI containing but not beginning with the namespace is not a member",
+        )
+
+    def test_closed_namespace_contains_rdfs(self):
+        """Closed membership on RDFS"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined term should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "term sharing the RDFS base but not defined should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with defined term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with defined term's text should not be a member",
+        )
+
+    def test_closed_namespace_contains_rdf(self):
+        """Closed membership on RDF"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined term should be a member of RDF",
+        )
