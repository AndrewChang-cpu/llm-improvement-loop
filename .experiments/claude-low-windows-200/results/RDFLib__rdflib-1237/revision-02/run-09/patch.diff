@@ -139,6 +139,19 @@ class Namespace(str):
         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """
+        Prefix membership: True when the text of ``ref`` begins with the
+        namespace text.
+
+        >>> n = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/Person") in n
+        True
+        >>> URIRef("http://other.org/http://example.org/") in n
+        False
+        """
+        return ref.startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
@@ -205,6 +218,15 @@ class ClosedNamespace(object):
             except KeyError as e:
                 raise AttributeError(e)
 
+    def __contains__(self, ref):
+        """
+        Closed membership: True only when ``ref`` is a URIRef equal (under
+        node-type-aware equality) to one of the stored term URIs.
+        Container membership properties are not stored, so they are not
+        members.
+        """
+        return any(ref == uri for uri in self.__uris.values())
+
     def __str__(self):
         return str(self.uri)
 
