         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """
+        Prefix membership: True when the text of ``ref`` begins with the
+        text of this namespace.
+
+        >>> from rdflib import Namespace, URIRef
+        >>> n = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/Person") in n
+        True
+        >>> URIRef("http://other.org/http://example.org/x") in n
+        False
+        """
+        return ref.startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
@@ -196,6 +210,13 @@ class ClosedNamespace(object):
     def __getitem__(self, key, default=None):
         return self.term(key)
 
+    def __contains__(self, ref):
+        """
+        Closed membership: True only when ``ref`` is a URIRef equal (under
+        node-type-aware equality) to one of the term URIs defined here.
+        """
+        return any(ref == uri for uri in self.__uris.values())
+
     def __getattr__(self, name):
         if name.startswith("__"):  # ignore any special Python names!
             raise AttributeError
