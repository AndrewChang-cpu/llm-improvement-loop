+
+    def test_namespace_prefix_membership(self):
+        """A URIRef is a member of a Namespace when it begins with its text"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/Person") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/Person") in ns,
+            "URI containing but not beginning with the text is not a member",
+        )
+
+    def test_shacl_prefix_membership(self):
+        """A URI beginning with the SHACL namespace text is a member"""
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "sh:example should be a member of SH",
+        )
+
+    def test_rdfs_closed_membership(self):
+        """Defined RDFS terms are members; undefined RDFS terms are not"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "rdfs:example shares the base but is not a defined term",
+        )
+
+    def test_rdfs_closed_membership_non_uriref(self):
+        """Plain strings and Literals with a term's text are not members"""
+        text = str(RDFS.label)
+        self.assertFalse(
+            text in RDFS,
+            "plain string with the text of rdfs:label is not a member",
+        )
+        self.assertFalse(
+            Literal(text) in RDFS,
+            "Literal with the text of rdfs:label is not a member",
+        )
+
+    def test_rdf_closed_membership(self):
+        """A defined RDF term is a member of RDF"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type should be a member of RDF",
+        )
