--- a/rdflib/namespace.py
+++ b/rdflib/namespace.py
@@ -142,6 +142,20 @@ class Namespace(str):
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
+    def __contains__(self, ref):
+        """
+        Prefix membership: True when the text of ``ref`` begins with
+        the namespace text.
+
+        >>> from rdflib import Namespace, URIRef
+        >>> n = Namespace("http://example.org/")
+        >>> URIRef("http://example.org/Person") in n
+        True
+        >>> URIRef("http://other.org/http://example.org/") in n
+        False
+        """
+        return ref.startswith(str(self))
+
 
