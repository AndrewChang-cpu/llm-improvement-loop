+
+    def test_namespace_prefix_membership(self):
+        """Prefix membership on Namespace uses a begins-with test"""
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/Person") in ns,
+            "URI beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/Person") in ns,
+            "URI containing but not beginning with the namespace is not a member",
+        )
+
+    def test_closed_namespace_membership_rdfs(self):
+        """Closed membership on RDFS compares against defined terms only"""
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "defined RDFS term should be a member",
+        )
+        self.assertFalse(
+            URIRef(str(RDFS) + "example") in RDFS,
+            "term sharing the RDFS base but not defined should not be a member",
+        )
+        self.assertFalse(
+            str(RDFS.label) in RDFS,
+            "plain string with a defined term's text should not be a member",
+        )
+        self.assertFalse(
+            Literal(str(RDFS.label)) in RDFS,
+            "Literal with a defined term's text should not be a member",
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        """Closed membership on RDF for a defined term"""
+        self.assertTrue(
+            RDF.type in RDF,
+            "defined RDF term should be a member",
+        )
