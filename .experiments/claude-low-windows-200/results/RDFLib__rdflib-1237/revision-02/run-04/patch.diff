@@ -196,6 +201,11 @@ class ClosedNamespace(object):
     def __getitem__(self, key, default=None):
         return self.term(key)
 
+    def __contains__(self, ref):
+        """Closed membership: True only if ``ref`` is a URIRef equal (under
+        node-type-aware equality) to one of the stored term URIs."""
+        return any(ref == uri for uri in self.__uris.values())
+
     def __getattr__(self, name):
         if name.startswith("__"):  # ignore any special Python names!
             raise AttributeError
