+
+    def test_namespace_prefix_membership(self):
+        ex = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/Person") in ex,
+            "URIRef beginning with the namespace text should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/x") in ex,
+            "URIRef containing but not beginning with the text is not a member",
+        )
+
+    def test_shacl_namespace_membership(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "sh:example should be a member of SH",
+        )
+
+    def test_closed_namespace_membership_rdfs(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label should be a member of RDFS",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "rdfs:example shares the base but is not a defined term",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "a plain string with the term text is not a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "a Literal with the term text is not a member",
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type should be a member of RDF",
+        )
