@@ -139,6 +139,10 @@ class Namespace(str):
         else:
             return self.term(name)
 
+    def __contains__(self, ref):
+        """Prefix membership: True if ``ref`` text begins with this namespace."""
+        return ref.startswith(str(self))
+
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
@@ -205,6 +209,14 @@ class ClosedNamespace(object):
             except KeyError as e:
                 raise AttributeError(e)
 
+    def __contains__(self, ref):
+        """Closed membership: True if ``ref`` equals a stored term URI.
+
+        Uses node-type-aware equality, so plain strings and Literals never
+        match. Container membership properties are not stored and are False.
+        """
+        return any(ref == uri for uri in self.__uris.values())
+
     def __str__(self):
         return str(self.uri)
 
