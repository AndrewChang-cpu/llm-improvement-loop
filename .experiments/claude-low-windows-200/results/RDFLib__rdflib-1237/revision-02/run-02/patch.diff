+
+    def test_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertTrue(
+            URIRef("http://example.org/thing") in ns,
+            "URIRef beginning with the namespace should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://other.org/http://example.org/thing") in ns,
+            "URIRef containing but not beginning with the namespace",
+        )
+
+    def test_shacl_membership(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/ns/shacl#example") in SH,
+            "sh:example should be a member of SH",
+        )
+
+    def test_closed_membership_rdfs(self):
+        self.assertTrue(
+            RDFS.label in RDFS,
+            "rdfs:label is a defined term and should be a member",
+        )
+        self.assertFalse(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS,
+            "rdfs:example shares the base but is not a defined term",
+        )
+        self.assertFalse(
+            "http://www.w3.org/2000/01/rdf-schema#label" in RDFS,
+            "a plain string with a term's text is not a member",
+        )
+        self.assertFalse(
+            Literal("http://www.w3.org/2000/01/rdf-schema#label") in RDFS,
+            "a Literal with a term's text is not a member",
+        )
+
+    def test_closed_membership_rdf(self):
+        self.assertTrue(
+            RDF.type in RDF,
+            "rdf:type is a defined term and should be a member",
+        )
+
+    def test_closed_membership_container_property(self):
+        self.assertFalse(
+            RDF._1 in RDF,
+            "container membership properties are not stored terms",
+        )
