 import unittest
 
 from rdflib.graph import Graph
-from rdflib.namespace import FOAF
+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
 from rdflib.term import URIRef
 
 
+class NamespaceContainsTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/ns#")
+        self.assertIs(URIRef("http://example.org/ns#thing") in ns, True)
+        self.assertIs(URIRef("http://other.org/ns#thing") in ns, False)
+        # contains the namespace string, but does not begin with it
+        self.assertIs(URIRef("http://x.org/http://example.org/ns#thing") in ns, False)
+
+    def test_shacl_namespace_membership(self):
+        self.assertIs(URIRef("http://www.w3.org/ns/shacl#example") in SH, True)
+
+    def test_closed_namespace_membership_rdfs(self):
+        self.assertIs(URIRef("http://www.w3.org/2000/01/rdf-schema#label") in RDFS, True)
+        self.assertIs(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS, False
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        self.assertIs(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#type") in RDF, True
+        )
+        # container membership property is not a stored term
+        self.assertIs(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF, False
+        )
+
+
