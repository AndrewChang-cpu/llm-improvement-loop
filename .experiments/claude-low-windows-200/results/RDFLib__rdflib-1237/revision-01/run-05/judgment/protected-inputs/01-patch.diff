@@ -196,6 +200,11 @@ class ClosedNamespace(object):
     def __getitem__(self, key, default=None):
         return self.term(key)
 
+    def __contains__(self, ref):
+        """Closed membership: True only if ``ref`` equals a stored term URI."""
+        ref = str(ref)
+        return any(ref == str(uri) for uri in self.__uris.values())
