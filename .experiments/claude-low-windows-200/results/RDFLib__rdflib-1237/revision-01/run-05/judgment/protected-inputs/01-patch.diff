@@ -1,10 +1,27 @@
 import unittest
 
 from rdflib.graph import Graph
-from rdflib.namespace import FOAF
+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
 from rdflib.term import URIRef
 
 
+class NamespaceMembershipTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        self.assertTrue(URIRef("http://www.w3.org/ns/shacl#example") in SH)
+        self.assertFalse(URIRef("http://example.org/www.w3.org/ns/shacl#x") in SH)
+        ns = Namespace("http://example.org/")
+        self.assertTrue(URIRef("http://example.org/a") in ns)
+        self.assertFalse(URIRef("http://other.org/http://example.org/a") in ns)
+
+    def test_closed_namespace_membership_rdfs(self):
+        self.assertIs(URIRef("http://www.w3.org/2000/01/rdf-schema#label") in RDFS, True)
+        self.assertIs(URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS, False)
+
+    def test_closed_namespace_membership_rdf(self):
+        self.assertIs(URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#type") in RDF, True)
+        self.assertIs(URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF, False)
+
+
