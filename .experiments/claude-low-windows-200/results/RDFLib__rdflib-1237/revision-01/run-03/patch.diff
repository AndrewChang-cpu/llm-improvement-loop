 import unittest
 
 from rdflib.graph import Graph
-from rdflib.namespace import FOAF
+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
 from rdflib.term import URIRef
 
 
+class NamespaceMembershipTest(unittest.TestCase):
+    def test_prefix_membership(self):
+        """`in` on an open Namespace is a prefix test"""
+        self.assertIn(URIRef("http://www.w3.org/ns/shacl#example"), SH)
+        ex = Namespace("http://example.org/")
+        self.assertIn(URIRef("http://example.org/foo"), ex)
+        self.assertNotIn(URIRef("http://other.org/http://example.org/"), ex)
+        self.assertNotIn(URIRef("http://example.org/foo"), Namespace("http://example.org/bar"))
+
+    def test_closed_membership_rdfs(self):
+        """`in` on a ClosedNamespace only matches defined terms"""
+        self.assertIs(URIRef("http://www.w3.org/2000/01/rdf-schema#label") in RDFS, True)
+        self.assertIs(URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS, False)
+
+    def test_closed_membership_rdf(self):
+        """`in` on the RDF namespace matches defined terms"""
+        self.assertIs(URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#type") in RDF, True)
+        self.assertIs(URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF, False)
+
+
