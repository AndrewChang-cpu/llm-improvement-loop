@@ -1,10 +1,40 @@
 import unittest
 
 from rdflib.graph import Graph
-from rdflib.namespace import FOAF
+from rdflib.namespace import FOAF, RDF, RDFS, SH, Namespace
 from rdflib.term import URIRef
 
 
+class NamespaceContainsTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        ex = Namespace("http://example.org/")
+        self.assertTrue(URIRef("http://example.org/Person") in ex)
+        self.assertFalse(URIRef("http://other.org/example.org/Person") in ex)
+        self.assertFalse(
+            URIRef("http://example.org.evil/x") in Namespace("http://example.org/a")
+        )
+
+    def test_shacl_namespace_membership(self):
+        self.assertIsInstance(SH, Namespace)
+        self.assertTrue(URIRef(str(SH) + "example") in SH)
+
+    def test_closed_namespace_membership_rdfs(self):
+        self.assertTrue(URIRef("http://www.w3.org/2000/01/rdf-schema#label") in RDFS)
+        self.assertIs(
+            URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS, False
+        )
+
+    def test_closed_namespace_membership_rdf(self):
+        self.assertTrue(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#type") in RDF
+        )
+
+    def test_container_property_not_member(self):
+        self.assertIs(
+            URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF, False
+        )
+
+
