+
+class NamespaceMembershipTest(unittest.TestCase):
+    def test_namespace_prefix_membership(self):
+        ns = Namespace("http://example.org/")
+        self.assertIs(URIRef("http://example.org/thing") in ns, True)
+        self.assertIs(URIRef("http://other.org/example.org/thing") in ns, False)
+        self.assertIs(URIRef("http://example.org") in ns, False)
+
+    def test_sh_membership(self):
+        self.assertIs(URIRef(SH + "example") in SH, True)
+
+    def test_closed_namespace_membership_rdfs(self):
+        self.assertIs(URIRef(RDFS + "label") in RDFS, True)
+        self.assertIs(URIRef(RDFS + "example") in RDFS, False)
+
+    def test_closed_namespace_membership_rdf(self):
+        self.assertIs(URIRef(RDF + "type") in RDF, True)
+        self.assertIs(URIRef(RDF + "_1") in RDF, False)
