diff --git a/rdflib/namespace.py b/rdflib/namespace.py
index aa1b4d0..9b62713 100644
--- a/rdflib/namespace.py
+++ b/rdflib/namespace.py
@@ -142,6 +142,10 @@ class Namespace(str):
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
+    def __contains__(self, ref):
+        """Prefix membership: True if ``ref`` begins with this namespace's string value."""
+        return str(ref).startswith(str(self))
+
 
 class URIPattern(str):
 
@@ -211,6 +215,15 @@ class ClosedNamespace(object):
     def __repr__(self):
         return "rdf.namespace.ClosedNamespace(%r)" % str(self.uri)
 
+    def __contains__(self, ref):
+        """Closed membership: True only if ``ref`` equals one of the stored term URIs.
+
+        Container membership properties (e.g. rdf:_1) are not stored, so are not members.
+        Inherited by _RDFNamespace.
+        """
+        ref = str(ref)
+        return any(ref == str(uri) for uri in self.__uris.values())
+
     def __dir__(self):
         return list(self._ClosedNamespace__uris)
 
