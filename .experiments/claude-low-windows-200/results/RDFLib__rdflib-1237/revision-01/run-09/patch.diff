@@ -112,3 +112,19 @@ class NamespacePrefixTest(unittest.TestCase):
             add_not_in_namespace("givenName"),
             URIRef("http://xmlns.com/foaf/0.1/givenName"),
         )
+
+
+class NamespaceContainsTest(unittest.TestCase):
+    def test_prefix_membership(self):
+        self.assertTrue(URIRef("http://example.org/Person") in Namespace("http://example.org/"))
+        self.assertFalse(URIRef("http://other.org/example.org/x") in Namespace("http://example.org/"))
+        self.assertFalse(URIRef("http://example.org/") in Namespace("http://example.org/a"))
+        self.assertTrue(SH.example in SH)
+
+    def test_closed_membership_rdfs(self):
+        self.assertTrue(RDFS.label in RDFS)
+        self.assertIs(URIRef("http://www.w3.org/2000/01/rdf-schema#example") in RDFS, False)
+
+    def test_closed_membership_rdf(self):
+        self.assertTrue(RDF.type in RDF)
+        self.assertIs(URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#_1") in RDF, False)
