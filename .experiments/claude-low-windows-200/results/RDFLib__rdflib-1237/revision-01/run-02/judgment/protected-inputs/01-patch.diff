@@ -142,6 +142,10 @@ class Namespace(str):
     def __repr__(self):
         return "Namespace(%r)" % str(self)
 
+    def __contains__(self, ref):
+        """Prefix membership: True if ``ref`` begins with this namespace's string."""
+        return str(ref).startswith(str(self))
+
 
 class URIPattern(str):
 
@@ -217,6 +221,11 @@ class ClosedNamespace(object):
     def _ipython_key_completions_(self):
         return dir(self)
 
+    def __contains__(self, ref):
+        """Closed membership: True only if ``ref`` equals one of the defined term URIs."""
+        ref = str(ref)
+        return any(ref == str(uri) for uri in self.__uris.values())
+
 
 class _RDFNamespace(ClosedNamespace):
