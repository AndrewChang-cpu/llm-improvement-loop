 """
-handles spatial 1D, 2D, 3D network components with a factory pattern.
+Generic, extensible layer factories.
+
+A `LayerFactory` is a registry mapping string names to callables. Each callable returns a layer type (a class such as
+`torch.nn.Conv2d`) given whatever arguments it needs, typically the spatial dimension. New layer families can be added
+without changing this module:
+
+.. code-block:: python
+
+    from monai.networks.layers.factories import LayerFactory
+
+    MyLayers = LayerFactory('my layers')
+
+    @MyLayers.factory_method('double')
+    def make_double(dim):
+        return [MyDoubleLayer1d, MyDoubleLayer2d, MyDoubleLayer3d][dim - 1]
+
+    layer_type = MyLayers.get_layer_type('double', 2)
+
+Predefined factories are provided for convolution (`Conv`), dropout (`Dropout`), normalization (`Norm`) and pooling
+(`Pool`). The `get_*_type` functions are kept for backward compatibility and delegate to these factories.
 """
 
+from typing import Callable, Dict, List
+
 from torch import nn as nn
 
