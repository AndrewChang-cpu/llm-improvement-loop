+class LayerFactory:
+    """
+    Registry of named layer constructors.
+
+    Args:
+        name: a human readable name for this factory, used in error messages.
+    """
+
+    def __init__(self, name: str = ''):
+        self.name = name
+        self._factories: Dict[str, Callable] = {}
+
+    def add_factory_callable(self, name: str, func: Callable) -> None:
+        """
+        Register `func` under `name`. `func` is called with the arguments given to `get_layer_type` and must return
+        a layer type.
+
+        Raises:
+            TypeError: if `func` is not callable.
+            ValueError: if `name` is already registered.
+        """
+        if not callable(func):
+            raise TypeError(f'factory for "{name}" must be callable, got {type(func).__name__}')
+        if name in self._factories:
+            raise ValueError(f'"{name}" is already registered in layer factory "{self.name}"')
+        self._factories[name] = func
+
+    def factory_method(self, name: str) -> Callable:
+        """
+        Decorator form of `add_factory_callable`. Returns the decorated function unchanged.
+        """
+
+        def decorator(func: Callable) -> Callable:
+            self.add_factory_callable(name, func)
+            return func
+
+        return decorator
+
+    def names(self) -> List[str]:
+        """Return the registered names, in registration order."""
+        return list(self._factories)
+
+    def __contains__(self, name: str) -> bool:
+        return name in self._factories
+
+    def get_layer_type(self, name: str, *args, **kwargs):
+        """
+        Call the factory registered under `name` with the given arguments and return the resulting layer type.
+
+        Raises:
+            ValueError: if no factory is registered under `name`.
+        """
+        if name not in self._factories:
+            raise ValueError(f'unknown layer "{name}" in layer factory "{self.name}", known: {self.names()}')
+        return self._factories[name](*args, **kwargs)
+
+
+def _select(types: list, dim: int):
+    """Pick the layer type for a 1, 2 or 3 spatial dimension input."""
+    if dim not in (1, 2, 3):
+        raise ValueError(f'spatial dimension must be 1, 2 or 3, got {dim}')
     return types[dim - 1]
 
 
+Conv = LayerFactory('convolution')
+Dropout = LayerFactory('dropout')
+Norm = LayerFactory('normalization')
+Pool = LayerFactory('pooling')
+
+
+@Conv.factory_method('conv')
+def _make_conv(dim: int, is_transpose: bool = False):
+    if is_transpose:
+        return _select([nn.ConvTranspose1d, nn.ConvTranspose2d, nn.ConvTranspose3d], dim)
+    return _select([nn.Conv1d, nn.Conv2d, nn.Conv3d], dim)
+
+
+@Dropout.factory_method('dropout')
+def _make_dropout(dim: int):
+    return _select([nn.Dropout, nn.Dropout2d, nn.Dropout3d], dim)
+
+
+@Norm.factory_method('batch')
+def _make_batch_norm(dim: int):
+    return _select([nn.BatchNorm1d, nn.BatchNorm2d, nn.BatchNorm3d], dim)
+
+
+@Norm.factory_method('instance')
+def _make_instance_norm(dim: int):
+    return _select([nn.InstanceNorm1d, nn.InstanceNorm2d, nn.InstanceNorm3d], dim)
+
+
+@Pool.factory_method('max')
+def _make_max_pool(dim: int, is_adaptive: bool = False):
+    if is_adaptive:
+        return _select([nn.AdaptiveMaxPool1d, nn.AdaptiveMaxPool2d, nn.AdaptiveMaxPool3d], dim)
+    return _select([nn.MaxPool1d, nn.MaxPool2d, nn.MaxPool3d], dim)
+
+
+@Pool.factory_method('avg')
+def _make_avg_pool(dim: int, is_adaptive: bool = False):
+    if is_adaptive:
+        return _select([nn.AdaptiveAvgPool1d, nn.AdaptiveAvgPool2d, nn.AdaptiveAvgPool3d], dim)
+    return _select([nn.AvgPool1d, nn.AvgPool2d, nn.AvgPool3d], dim)
+
+
+def get_conv_type(dim, is_transpose):
+    return Conv.get_layer_type('conv', dim, is_transpose)
+
