+class Factory:
+    """
+    A name-keyed registry of constructor-producing callables.
+
+    Each entry is a callable which, when invoked with the arguments given to
+    `get_constructor`, returns the constructor to be used (e.g. a class).
+
+    Args:
+        description: optional human-readable description of what this factory produces.
+    """
+
+    def __init__(self, description=""):
+        self.description = description
+        self._factories = OrderedDict()
+        self._descriptions = OrderedDict()
+
+    def add_factory_callable(self, name, func, description=""):
+        """
+        Register a callable under `name`. Re-registering an existing name replaces it.
+
+        Args:
+            name: key used to look the factory up.
+            func: callable returning a constructor.
+            description: optional description of the entry.
+        """
+        if not callable(func):
+            raise TypeError(f"factory for '{name}' must be callable, got {type(func)}")
+        self._factories[name] = func
+        self._descriptions[name] = description
+
+    @property
+    def names(self):
+        """Tuple of all registered names, in registration order."""
+        return tuple(self._factories.keys())
+
+    def describe(self, name):
+        """Return the description registered for `name`."""
+        self._check(name)
+        return self._descriptions[name]
+
+    def __contains__(self, name):
+        return name in self._factories
+
+    def _check(self, name):
+        if name not in self._factories:
+            raise ValueError(f"unknown factory name '{name}', available: {', '.join(self.names)}")
+
+    def get_constructor(self, name, *args, **kwargs):
+        """
+        Look up the factory registered under `name` and call it with the given arguments.
+
+        Raises:
+            ValueError: if `name` is not registered.
+        """
+        self._check(name)
+        return self._factories[name](*args, **kwargs)
+
+
+def _check_dim(dim, supported=(1, 2, 3)):
+    if dim not in supported:
+        raise ValueError(f"spatial dimension must be one of {supported}, got {dim}")
+    return dim - 1
+
+
+class LayerFactory(Factory):
+    """
+    Factory for spatial layers. Registered callables take `dim` (1, 2, or 3)
+    as their first argument, plus any extra keyword arguments they need.
+
+    Example:
+        >>> Conv.get_constructor("conv", 2)
+        <class 'torch.nn.modules.conv.Conv2d'>
+    """
+
+    def get_constructor(self, name, dim, *args, **kwargs):
+        """
+        Return the constructor registered under `name` for spatial dimension `dim`.
+
+        Args:
+            name: registered name.
+            dim: spatial dimension, 1, 2 or 3.
+        """
+        return super().get_constructor(name, dim, *args, **kwargs)
+
+
+def _select(types):
+    """Build a callable that picks the class for `dim` from a 3-element list of classes."""
+
+    def _factory(dim):
+        return types[_check_dim(dim)]
+
+    return _factory
+
+
+Conv = LayerFactory("Convolution layers, selected by spatial dimension")
+Conv.add_factory_callable("conv", _select([nn.Conv1d, nn.Conv2d, nn.Conv3d]), "standard convolution")
+Conv.add_factory_callable(
+    "convtranspose", _select([nn.ConvTranspose1d, nn.ConvTranspose2d, nn.ConvTranspose3d]), "transposed convolution"
+)
+
+Dropout = LayerFactory("Dropout layers, selected by spatial dimension")
+Dropout.add_factory_callable("dropout", _select([nn.Dropout, nn.Dropout2d, nn.Dropout3d]), "dropout")
+
+Norm = LayerFactory("Normalization layers, selected by spatial dimension")
+Norm.add_factory_callable("batch", _select([nn.BatchNorm1d, nn.BatchNorm2d, nn.BatchNorm3d]), "batch normalization")
+Norm.add_factory_callable(
+    "instance", _select([nn.InstanceNorm1d, nn.InstanceNorm2d, nn.InstanceNorm3d]), "instance normalization"
+)
+
+MaxPool = LayerFactory("Max pooling layers, selected by spatial dimension")
+MaxPool.add_factory_callable("max", _select([nn.MaxPool1d, nn.MaxPool2d, nn.MaxPool3d]), "max pooling")
+MaxPool.add_factory_callable(
+    "adaptivemax", _select([nn.AdaptiveMaxPool1d, nn.AdaptiveMaxPool2d, nn.AdaptiveMaxPool3d]), "adaptive max pooling"
+)
+
+AvgPool = LayerFactory("Average pooling layers, selected by spatial dimension")
+AvgPool.add_factory_callable("avg", _select([nn.AvgPool1d, nn.AvgPool2d, nn.AvgPool3d]), "average pooling")
+AvgPool.add_factory_callable(
+    "adaptiveavg", _select([nn.AdaptiveAvgPool1d, nn.AdaptiveAvgPool2d, nn.AdaptiveAvgPool3d]), "adaptive average pooling"
+)
+
+
+def get_conv_type(dim, is_transpose):
+    return Conv.get_constructor("convtranspose" if is_transpose else "conv", dim)
 
 
