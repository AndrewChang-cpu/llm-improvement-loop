+class Factory:
+    """
+    A registry mapping string names to factory callables.
+
+    Factory callables are looked up by name with `get_constructor`, which calls the registered callable with the
+    supplied arguments and returns whatever it returns (for layer factories, a layer class).
+    """
+
+    def __init__(self):
+        self._factories = OrderedDict()
+
+    def add_factory_callable(self, name, func, overwrite=False):
+        """
+        Register `func` under `name`.
+
+        Args:
+            name: string key used to look the callable up later.
+            func: callable that builds (or returns) the requested object.
+            overwrite: if False (default), raise a `ValueError` when `name` is already registered.
+        """
+        if not callable(func):
+            raise TypeError("factory for '{}' must be callable, got {}".format(name, type(func).__name__))
+        if name in self._factories and not overwrite:
+            raise ValueError("factory '{}' is already registered".format(name))
+        self._factories[name] = func
+
+    def factory_function(self, name, overwrite=False):
+        """
+        Decorator form of `add_factory_callable`. The decorated function is registered and returned unchanged.
+        """
+
+        def _decorator(func):
+            self.add_factory_callable(name, func, overwrite=overwrite)
+            return func
+
+        return _decorator
+
+    def get_constructor(self, name, *args, **kwargs):
+        """
+        Call the factory registered under `name` with the given arguments and return the result.
+
+        Raises:
+            KeyError: if no factory is registered under `name`. The message lists the available names.
+        """
+        if name not in self._factories:
+            raise KeyError("no factory named '{}'; available: {}".format(name, ", ".join(self.names())))
+        return self._factories[name](*args, **kwargs)
+
+    def names(self):
+        """Return the registered factory names in registration order."""
+        return list(self._factories.keys())
 
+    def __contains__(self, name):
+        return name in self._factories
+
+
+class LayerFactory(Factory):
