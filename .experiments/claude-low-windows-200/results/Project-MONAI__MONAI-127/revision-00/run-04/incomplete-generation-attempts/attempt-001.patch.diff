+class Factory:
+    """
+    Registry of named factory callables. Each subclass keeps its own registry, so `LayerFactory` entries do not
+    leak into other factories. Use the class methods directly, e.g. `LayerFactory.names()`.
+    """
+
+    _registry: Dict[str, Tuple[Callable, str]] = {}
+
+    def __init_subclass__(cls, **kwargs):
+        super().__init_subclass__(**kwargs)
+        # every subclass gets its own registry, not a shared one from the base class
+        cls._registry = {}
+
+    @classmethod
+    def add_factory_callable(cls, name: str, func: Callable, desc: Optional[str] = None, override: bool = False):
+        """
+        Register `func` under `name`.
+
+        Args:
+            name: key used to look up the factory, case-sensitive.
+            func: callable returning the layer type for the arguments it is called with.
+            desc: optional human readable description.
+            override: if False (default), registering an existing name raises `ValueError`.
+        """
+        if not callable(func):
+            raise TypeError(f"factory for '{name}' must be callable, got {type(func).__name__}")
+        if name in cls._registry and not override:
+            raise ValueError(f"'{name}' is already registered in {cls.__name__}; pass override=True to replace it")
+        cls._registry[name] = (func, desc or "")
+
+    @classmethod
+    def get_factory(cls, name: str) -> Callable:
+        """Return the callable registered under `name`. Raises `KeyError` if it is not registered."""
+        if name not in cls._registry:
+            raise KeyError(f"'{name}' is not a registered {cls.__name__}; available: {list(cls.names())}")
+        return cls._registry[name][0]
+
+    @classmethod
+    def description(cls, name: str) -> str:
+        """Return the description registered for `name`."""
+        if name not in cls._registry:
+            raise KeyError(f"'{name}' is not a registered {cls.__name__}")
+        return cls._registry[name][1]
+
+    @classmethod
+    def names(cls) -> Tuple[str, ...]:
+        """Return the registered names, in registration order."""
+        return tuple(cls._registry.keys())
+
+
