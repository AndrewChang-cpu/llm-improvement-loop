+class Factory:
+    """
+    A named registry mapping string names to callables that build layers.
+
+    Args:
+        name: human-readable name of this factory, used in error messages.
+    """
+
+    def __init__(self, name):
+        self.name = name
+        self._callables = {}
+
+    def add_factory_callable(self, name, func):
+        """
+        Register `func` under `name`. It is invoked with whatever arguments the caller
+        passes to :meth:`make_instance` or :meth:`LayerFactory.get_type`.
+
+        Raises:
+            ValueError: if `name` is already registered.
+            TypeError: if `func` is not callable.
+        """
+        if not callable(func):
+            raise TypeError(f"factory callable for '{name}' must be callable, got {type(func).__name__}")
+        if name in self._callables:
+            raise ValueError(f"'{name}' is already registered in factory '{self.name}'")
+        self._callables[name] = func
+
+    def names(self):
+        """Return the tuple of registered names, in registration order."""
+        return tuple(self._callables)
+
+    def __contains__(self, name):
+        return name in self._callables
+
+    def get_constructor(self, name):
+        """
+        Return the registered callable for `name`.
+
+        Raises:
+            KeyError: if `name` is not registered.
+        """
+        try:
+            return self._callables[name]
+        except KeyError:
+            raise KeyError(f"'{name}' is not registered in factory '{self.name}'; available: {self.names()}") from None
+
+    def make_instance(self, name, *args, **kwargs):
+        """Call the registered callable for `name` with the given arguments and return its result."""
+        return self.get_constructor(name)(*args, **kwargs)
+
+
+class LayerFactory(Factory):
+    """
+    A :class:`Factory` whose callables take a spatial ``dim`` (1, 2 or 3) as the first
+    argument and return the corresponding torch layer class. Use :meth:`get_type`.
+    """
+
+    def get_type(self, name, *args, **kwargs):
+        """Return the layer class for `name` with the given arguments (e.g. ``dim``)."""
+        return self.get_constructor(name)(*args, **kwargs)
+
+
+def _select_by_dim(types):
+    """Build a factory callable choosing one of `types` (ordered for dims 1, 2, 3) by `dim`."""
+
+    def _factory(dim):
+        if dim not in (1, 2, 3):
+            raise ValueError(f"spatial dimension must be 1, 2 or 3, got {dim}")
+        return types[dim - 1]
+
+    return _factory
+
+
+Conv = LayerFactory("conv")
+Conv.add_factory_callable("conv", _select_by_dim([nn.Conv1d, nn.Conv2d, nn.Conv3d]))
+Conv.add_factory_callable("convtrans", _select_by_dim([nn.ConvTranspose1d, nn.ConvTranspose2d, nn.ConvTranspose3d]))
+
+Dropout = LayerFactory("dropout")
+Dropout.add_factory_callable("dropout", _select_by_dim([nn.Dropout, nn.Dropout2d, nn.Dropout3d]))
+
+Norm = LayerFactory("norm")
+Norm.add_factory_callable(
+    "batch", _select_by_dim([nn.BatchNorm1d, nn.BatchNorm2d, nn.BatchNorm3d])
+)
+Norm.add_factory_callable(
+    "instance", _select_by_dim([nn.InstanceNorm1d, nn.InstanceNorm2d, nn.InstanceNorm3d])
+)
+
+Pool = LayerFactory("pool")
+Pool.add_factory_callable("max", _select_by_dim([nn.MaxPool1d, nn.MaxPool2d, nn.MaxPool3d]))
+Pool.add_factory_callable("avg", _select_by_dim([nn.AvgPool1d, nn.AvgPool2d, nn.AvgPool3d]))
+Pool.add_factory_callable(
+    "adaptivemax", _select_by_dim([nn.AdaptiveMaxPool1d, nn.AdaptiveMaxPool2d, nn.AdaptiveMaxPool3d])
+)
+Pool.add_factory_callable(
+    "adaptiveavg", _select_by_dim([nn.AdaptiveAvgPool1d, nn.AdaptiveAvgPool2d, nn.AdaptiveAvgPool3d])
+)
+
+
+# Backward-compatible helpers delegating to the factories above.
+
+
+def get_conv_type(dim, is_transpose):
+    return Conv.get_type("convtrans" if is_transpose else "conv", dim)
 
 
