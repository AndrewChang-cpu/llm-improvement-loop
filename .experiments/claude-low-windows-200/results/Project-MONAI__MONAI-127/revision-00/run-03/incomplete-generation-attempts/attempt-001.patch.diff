 """
-handles spatial 1D, 2D, 3D network components with a factory pattern.
+Generic, extensible factory mechanism for network layers.
+
+A :class:`Factory` maps string names to callables. Each callable produces a layer
+(class or instance) and can be registered at runtime with
+:meth:`Factory.add_factory_callable`, so new layer types can be plugged in
+without editing this module.
+
+Predefined factories:
+
+- ``Conv``: ``conv``, ``convtrans`` (transposed), chosen by spatial dimension.
+- ``Dropout``: ``dropout``.
+- ``Norm``: ``batch``, ``instance``.
+- ``Pool``: ``max``, ``avg``, ``adaptivemax``, ``adaptiveavg``.
+
+The ``get_*_type`` helpers below are kept for backward compatibility and delegate
+to these factories.
+
+Example::
+
+    from monai.networks.layers.factories import Conv, Factory
+
+    Conv.get_type("conv", 3)                      # -> nn.Conv3d
+    Conv.make_instance("conv", 2, 4, 8, 3)        # -> nn.Conv2d(4, 8, 3)
+
+    Norm = Factory("norm")
+    Norm.add_factory_callable("group", lambda dim: my_group_norm_for(dim))
 """
 
 from torch import nn as nn
 
