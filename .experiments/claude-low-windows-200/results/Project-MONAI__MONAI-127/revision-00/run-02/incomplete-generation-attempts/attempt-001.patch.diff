+class Factory:
+    """
+    A named registry of callables, each of which returns a layer type (class) when called.
+
+    Args:
+        name: a human readable name for this factory, used in error messages.
+    """
+
+    def __init__(self, name: str):
+        self.name = name
+        self._factories = OrderedDict()
+
+    def add_factory_callable(self, name: str, func: Callable):
+        """
+        Register `func` under `name`, replacing any existing registration with the same name.
+
+        Args:
+            name: key used to look up the factory callable.
+            func: callable which returns a layer type when called with the arguments used at lookup.
+        """
+        self._factories[name] = func
+
+    def factory(self, name: str) -> Callable:
+        """
+        Decorator form of `add_factory_callable`, registering the decorated function under `name`.
+        """
+
+        def _decorator(func: Callable) -> Callable:
+            self.add_factory_callable(name, func)
+            return func
+
+        return _decorator
+
+    def names(self):
+        """Return the names of all registered factory callables."""
+        return tuple(self._factories.keys())
+
+    def __contains__(self, name) -> bool:
+        return name in self._factories
+
+    def get(self, name: str, *args, **kwargs):
+        """
+        Look up the factory callable registered under `name` and call it with `args` and `kwargs`.
+
+        Raises:
+            ValueError: if no factory callable is registered under `name`.
+        """
+        if name not in self._factories:
+            raise ValueError(f"'{name}' is not a known {self.name} type, available types: {', '.join(self.names())}")
+        return self._factories[name](*args, **kwargs)
 
+
+def _spatial_type(types, dim):
+    """Select the layer type for the given spatial dimension (1, 2 or 3) from a list ordered by dimension."""
     return types[dim - 1]
 
 
