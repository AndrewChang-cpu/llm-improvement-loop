 """
-handles spatial 1D, 2D, 3D network components with a factory pattern.
+Generic, extensible layer factories.
+
+A ``LayerFactory`` is a named registry of factory functions. Each factory function
+receives arbitrary arguments and returns a layer type (a class such as ``nn.Conv2d``).
+New factory functions are added with the ``factory_method`` decorator, and layer types
+are looked up by name with ``get_layer_type``::
+
+    @Conv.factory_method("transposed_conv")
+    def _transposed(dim, is_transposed=True):
+        return [nn.ConvTranspose1d, nn.ConvTranspose2d, nn.ConvTranspose3d][dim - 1]
+
+    Conv.get_layer_type("transposed_conv", 2)  # -> nn.ConvTranspose2d
+
+The module-level helpers ``get_conv_type``, ``get_dropout_type``, etc. are kept as
+thin wrappers around the factories defined below, so existing callers are unaffected.
 """
 
 from torch import nn as nn
 
+__all__ = [
+    "LayerFactory",
+    "Conv",
+    "Dropout",
+    "Norm",
+    "MaxPool",
+    "AvgPool",
+    "get_conv_type",
+    "get_dropout_type",
+    "get_normalize_type",
+    "get_maxpooling_type",
+    "get_avgpooling_type",
+]
+
+
+class LayerFactory:
+    """
+    A named registry of factory functions that return layer types.
+
+    Args:
+        name (str): name of this factory, used in error messages.
+        description (str): short human-readable description of the layers it creates.
+    """
+
+    def __init__(self, name, description=""):
+        self.name = name
+        self.description = description
+        self._factories = {}
+
+    def factory_method(self, name):
+        """
+        Decorator registering a factory function under ``name``.
+
+        Args:
+            name (str): key used to look the factory function up later.
+
+        Returns:
+            the decorator, which returns the decorated function unchanged.
+        """
+        if not isinstance(name, str) or not name:
+            raise ValueError("factory name must be a non-empty string, got {!r}".format(name))
+
+        def decorator(func):
+            if name in self._factories:
+                raise ValueError("'{}' is already registered in the {} factory".format(name, self.name))
+            self._factories[name] = func
+            return func
+
+        return decorator
+
+    def names(self):
+        """Return the sorted list of registered factory names."""
+        return sorted(self._factories)
+
+    def __contains__(self, name):
+        return name in self._factories
+
+    def get_layer_type(self, name, *args, **kwargs):
+        """
+        Call the factory function registered under ``name`` and return the layer type.
+
+        Args:
+            name (str): registered factory name.
+            args, kwargs: passed on to the factory function.
+
+        Raises:
+            ValueError: if no factory is registered under ``name``.
+        """
+        if name not in self._factories:
+            raise ValueError("unknown {} factory '{}', available: {}".format(self.name, name, self.names()))
+        return self._factories[name](*args, **kwargs)
+
+
+Conv = LayerFactory("Conv", "convolution layers")
+Dropout = LayerFactory("Dropout", "dropout layers")
+Norm = LayerFactory("Norm", "normalization layers")
+MaxPool = LayerFactory("MaxPool", "max pooling layers")
+AvgPool = LayerFactory("AvgPool", "average pooling layers")
 
