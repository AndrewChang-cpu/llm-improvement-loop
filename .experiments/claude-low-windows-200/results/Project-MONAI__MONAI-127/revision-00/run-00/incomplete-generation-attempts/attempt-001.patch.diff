+class LayerFactory:
+    """
+    Generic registry mapping a factory name to a function that returns a layer type.
+
+    Example:
+        .. code-block:: python
+
+            @LayerFactory.register('Identity')
+            def identity_factory(dim):
+                return nn.Identity
+
+            layer_type = LayerFactory.get('Identity', dim=3)
+
+    Factory functions take the spatial dimension as their first argument, followed by
+    any keyword arguments passed to `get`.
+    """
+
+    _factories: Dict[str, Callable[..., Any]] = {}
+
+    @classmethod
+    def register(cls, name: str) -> Callable[[Callable[..., Any]], Callable[..., Any]]:
+        """
+        Decorator that registers a factory function under `name`.
+
+        Args:
+            name (str): name used to look up the factory; must be a non-empty string.
+
+        Raises:
+            ValueError: if `name` is empty or already registered.
+        """
+        if not name:
+            raise ValueError('factory name must be a non-empty string.')
+
+        def decorator(func: Callable[..., Any]) -> Callable[..., Any]:
+            if name in cls._factories:
+                raise ValueError(f'factory "{name}" is already registered.')
+            cls._factories[name] = func
+            return func
+
+        return decorator
+
+    @classmethod
+    def names(cls) -> List[str]:
+        """Return the sorted names of all registered factories."""
+        return sorted(cls._factories)
+
+    @classmethod
+    def get(cls, name: str, dim: int, **kwargs: Any) -> Any:
+        """
+        Return the layer type produced by the factory `name` for spatial dimension `dim`.
+
+        Args:
+            name (str): registered factory name.
+            dim (int): spatial dimension, one of 1, 2 or 3.
+            kwargs: extra keyword arguments forwarded to the factory function.
+
+        Raises:
+            ValueError: if `name` is not registered, or the factory rejects `dim`.
+        """
+        if name not in cls._factories:
+            raise ValueError(f'unknown factory "{name}", available: {cls.names()}.')
+        return cls._factories[name](dim, **kwargs)
+
+
+def _select_by_dim(dim: int, types: List[Any]) -> Any:
+    """Pick the entry for spatial dimension `dim` (1, 2 or 3) from a list of three types."""
+    if dim not in (1, 2, 3):
+        raise ValueError(f'spatial dimension must be 1, 2 or 3, got {dim}.')
+    return types[dim - 1]
+
+
