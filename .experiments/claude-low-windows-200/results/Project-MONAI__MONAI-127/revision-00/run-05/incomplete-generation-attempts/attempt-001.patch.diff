 """
 handles spatial 1D, 2D, 3D network components with a factory pattern.
+
+Two styles are provided:
+
+* the ``get_*_type`` functions, which select a layer class from a spatial dimension and a flag;
+* the ``LayerFactory`` class, a generic, extensible registry mapping names to layer constructors. Named factories
+  (``Conv``, ``Dropout``, ``Norm``, ``Pool``) are instances of it, and new constructors can be registered with
+  ``add_factory_callable`` or the ``factory_function`` decorator.
 """
 
+from collections import OrderedDict
+from typing import Callable, Optional
+
 from torch import nn as nn
 
 
+class LayerFactory:
+    """
+    A registry of named layer constructors.
+
+    Example::
+
+        Conv = LayerFactory(name="Convolutions", description="Convolution layers")
+        Conv.add_factory_callable("Conv2d", nn.Conv2d)
+
+        @Conv.factory_function("Conv3d")
+        def make_conv3d(*args, **kwargs):
+            return nn.Conv3d(*args, **kwargs)
+
+        layer = Conv["Conv2d"](3, 8, 3)
+
+    Args:
+        name: human readable name of the factory.
+        description: longer description of what the factory provides.
+    """
+
+    def __init__(self, name: Optional[str] = None, description: Optional[str] = None):
+        self.name = name
+        self.description = description
+        self._factories = OrderedDict()
+
+    def add_factory_callable(self, name: str, func: Callable, desc: Optional[str] = None) -> None:
+        """
+        Register a constructor under `name`. Registering a name twice raises `ValueError`, so existing entries are
+        never silently replaced.
+        """
+        if not isinstance(name, str) or not name:
+            raise ValueError("factory name must be a non-empty string.")
+        if not callable(func):
+            raise TypeError(f"factory '{name}' must be callable, got {type(func).__name__}.")
+        if name in self._factories:
+            raise ValueError(f"factory '{name}' is already registered in '{self.name}'.")
+        self._factories[name] = (func, desc)
+
+    def factory_function(self, name: str, desc: Optional[str] = None) -> Callable:
+        """Decorator form of `add_factory_callable`. Returns the decorated function unchanged."""
+
+        def decorator(func: Callable) -> Callable:
+            self.add_factory_callable(name, func, desc)
+            return func
+
+        return decorator
+
+    def get_constructor(self, name: str) -> Callable:
+        """Return the constructor registered under `name`, raising `KeyError` if it is not registered."""
+        if name not in self._factories:
+            raise KeyError(f"'{name}' is not registered in '{self.name}'. Available: {self.names}.")
+        return self._factories[name][0]
+
+    def get_description(self, name: str) -> Optional[str]:
+        """Return the description given at registration for `name`."""
+        if name not in self._factories:
+            raise KeyError(f"'{name}' is not registered in '{self.name}'.")
+        return self._factories[name][1]
+
+    @property
+    def names(self):
+        """Registered names, in registration order."""
+        return tuple(self._factories.keys())
+
+    def __getitem__(self, name: str) -> Callable:
+        return self.get_constructor(name)
+
+    def __contains__(self, name) -> bool:
+        return name in self._factories
+
+    def __iter__(self):
+        return iter(self._factories)
+
+    def __len__(self) -> int:
+        return len(self._factories)
+
+    def __repr__(self) -> str:
+        return f"LayerFactory(name={self.name!r}, names={list(self.names)})"
+
+
+Conv = LayerFactory(name="Convolution", description="Convolution and transposed convolution layers.")
+Conv.add_factory_callable("Conv1d", nn.Conv1d)
+Conv.add_factory_callable("Conv2d", nn.Conv2d)
+Conv.add_factory_callable("Conv3d", nn.Conv3d)
+Conv.add_factory_callable("ConvTranspose1d", nn.ConvTranspose1d)
+Conv.add_factory_callable("ConvTranspose2d", nn.ConvTranspose2d)
+Conv.add_factory_callable("ConvTranspose3d", nn.ConvTranspose3d)
+
+Dropout = LayerFactory(name="Dropout", description="Dropout layers.")
+Dropout.add_factory_callable("Dropout", nn.Dropout)
+Dropout.add_factory_callable("Dropout2d", nn.Dropout2d)
+Dropout.add_factory_callable("Dropout3d", nn.Dropout3d)
+
+Norm = LayerFactory(name="Normalization", description="Batch and instance normalization layers.")
+Norm.add_factory_callable("BatchNorm1d", nn.BatchNorm1d)
+Norm.add_factory_callable("BatchNorm2d", nn.BatchNorm2d)
+Norm.add_factory_callable("BatchNorm3d", nn.BatchNorm3d)
+Norm.add_factory_callable("InstanceNorm1d", nn.InstanceNorm1d)
+Norm.add_factory_callable("InstanceNorm2d", nn.InstanceNorm2d)
+Norm.add_factory_callable("InstanceNorm3d", nn.InstanceNorm3d)
+
+Pool = LayerFactory(name="Pooling", description="Max, average and adaptive pooling layers.")
+Pool.add_factory_callable("MaxPool1d", nn.MaxPool1d)
+Pool.add_factory_callable("MaxPool2d", nn.MaxPool2d)
+Pool.add_factory_callable("MaxPool3d", nn.MaxPool3d)
+Pool.add_factory_callable("AvgPool1d", nn.AvgPool1d)
+Pool.add_factory_callable("AvgPool2d", nn.AvgPool2d)
+Pool.add_factory_callable("AvgPool3d", nn.AvgPool3d)
+Pool.add_factory_callable("AdaptiveMaxPool1d", nn.AdaptiveMaxPool1d)
+Pool.add_factory_callable("AdaptiveMaxPool2d", nn.AdaptiveMaxPool2d)
+Pool.add_factory_callable("AdaptiveMaxPool3d", nn.AdaptiveMaxPool3d)
+Pool.add_factory_callable("AdaptiveAvgPool1d", nn.AdaptiveAvgPool1d)
+Pool.add_factory_callable("AdaptiveAvgPool2d", nn.AdaptiveAvgPool2d)
+Pool.add_factory_callable("AdaptiveAvgPool3d", nn.AdaptiveAvgPool3d)
+
+
 def get_conv_type(dim, is_transpose):
     if is_transpose:
         types = [nn.ConvTranspose1d, nn.ConvTranspose2d, nn.ConvTranspose3d]
