diff --git a/botocore/utils.py b/botocore/utils.py
index 0efd7ef..18b0510 100644
--- a/botocore/utils.py
+++ b/botocore/utils.py
@@ -3620,3 +3620,59 @@ CLIENT_NAME_TO_HYPHENIZED_SERVICE_ID_OVERRIDES = {
     'stepfunctions': 'sfn',
     'storagegateway': 'storage-gateway',
 }
+
+
+EXPIRES_STRING_DOCUMENTATION = (
+    '<p>The raw value of the <code>Expires</code> header. Use this member '
+    'instead of <code>Expires</code>.</p>'
+)
+EXPIRES_DEPRECATION_NOTE = (
+    '<p><b>Deprecated:</b> This member is deprecated and may be omitted if the '
+    'value cannot be parsed as a timestamp. Use <code>ExpiresString</code> '
+    'to retrieve the raw value.</p>'
+)
+
+
+def customize_expires_shapes(service_data):
+    """Customize operation output shapes that contain an ``Expires`` timestamp.
+
+    For each output shape with an ``Expires`` member, this adds a synthetic
+    ``ExpiresString`` member that is populated from the same header but
+    retains the raw string value. The ``Expires`` member is marked as
+    deprecated in its documentation.
+
+    The model is modified in place. The operation is idempotent, so it is
+    safe to call on data that has already been customized.
+
+    :param service_data: The loaded service-2 model dictionary.
+    """
+    shapes = service_data.get('shapes', {})
+    if 'ExpiresString' in shapes:
+        return
+    touched = False
+    for operation in service_data.get('operations', {}).values():
+        output = operation.get('output')
+        if not output:
+            continue
+        output_shape = shapes.get(output['shape'], {})
+        members = output_shape.get('members', {})
+        expires = members.get('Expires')
+        if not expires or expires.get('shape') != 'Expires':
+            continue
+        if 'ExpiresString' in members:
+            continue
+        if not touched:
+            shapes['ExpiresString'] = {
+                'type': 'string',
+                'documentation': EXPIRES_STRING_DOCUMENTATION,
+            }
+            touched = True
+        expires['documentation'] = (
+            EXPIRES_DEPRECATION_NOTE + expires.get('documentation', '')
+        )
+        members['ExpiresString'] = {
+            'shape': 'ExpiresString',
+            'documentation': EXPIRES_STRING_DOCUMENTATION,
+            'location': 'header',
+            'locationName': 'Expires',
+        }
