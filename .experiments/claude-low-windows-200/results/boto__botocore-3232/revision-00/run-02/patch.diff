+    def _parse_lenient_timestamp_header(
+        self, member_shape, name, header_name, value, final_parsed
+    ):
+        # Used for timestamp headers (e.g. S3 ``Expires``) whose raw values
+        # may not be valid timestamps. Rather than failing the whole
+        # operation, the key is omitted and a warning is logged. The raw
+        # value remains available through the synthetic ``ExpiresString``
+        # member, which is populated by the regular header parsing path.
+        try:
+            final_parsed[name] = self._parse_shape(member_shape, value)
+        except (ValueError, TypeError, OverflowError, OSError):
+            LOG.warning(
+                'Unable to parse the "%s" header value %r as a timestamp; '
+                'omitting "%s" from the response. The raw value is available '
+                'in the "%sString" member.',
+                header_name,
+                value,
+                name,
+                name,
+            )
 
