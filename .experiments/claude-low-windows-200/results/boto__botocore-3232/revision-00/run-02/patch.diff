@@ -349,6 +349,62 @@ def disable_signing(**kwargs):
     return botocore.UNSIGNED
 
 
+S3_EXPIRES_DEPRECATION_DOC = (
+    '<p><b>This member is deprecated.</b> Use <code>ExpiresString</code> '
+    'instead. If the raw <code>Expires</code> value cannot be parsed as a '
+    'timestamp, this member is omitted and a warning is logged.</p>'
+)
+S3_EXPIRES_STRING_DOC = (
+    '<p>The raw value of the <code>Expires</code> header. Use this member '
+    'instead of the deprecated <code>Expires</code> member.</p>'
+)
+
+
+def add_s3_expires_string_member(service_data, **kwargs):
+    """Customize S3 output shapes that contain the ``Expires`` timestamp.
+
+    For each output shape with an ``Expires`` timestamp member this:
+
+    * adds a synthetic ``ExpiresString`` string member that carries the raw
+      ``Expires`` header value,
+    * marks the ``Expires`` shape as lenient so unparseable values are
+      omitted with a warning instead of raising an error, and
+    * deprecates ``Expires`` in its documentation.
+    """
+    shapes = service_data.get('shapes', {})
+    for operation in service_data.get('operations', {}).values():
+        output_name = operation.get('output', {}).get('shape')
+        output_shape = shapes.get(output_name)
+        if output_shape is None:
+            continue
+        members = output_shape.get('members', {})
+        expires_member = members.get('Expires')
+        if expires_member is None:
+            continue
+        expires_shape = shapes.get(expires_member.get('shape'), {})
+        if expires_shape.get('type') != 'timestamp':
+            continue
+        if 'ExpiresString' in members:
+            # Already customized (the service model may be shared/cached).
+            continue
+
+        expires_shape['lenientTimestamp'] = True
+        expires_member['documentation'] = (
+            S3_EXPIRES_DEPRECATION_DOC
+            + expires_member.get('documentation', '')
+        )
+        shapes.setdefault(
+            'ExpiresString',
+            {'type': 'string', 'documentation': S3_EXPIRES_STRING_DOC},
+        )
+        members['ExpiresString'] = {
+            'shape': 'ExpiresString',
+            'documentation': S3_EXPIRES_STRING_DOC,
+            'location': 'header',
+            'locationName': 'Expires',
+        }
+
+
 def add_expect_header(model, params, **kwargs):
