         return f'{self.__class__.__name__}({self.service_name})'
 
 
+EXPIRES_MEMBER_NAME = 'Expires'
+EXPIRES_STRING_MEMBER_NAME = 'ExpiresString'
+_EXPIRES_DEPRECATION_DOC = (
+    '<p>This member is deprecated because the S3 <code>Expires</code> header '
+    'is not always a valid timestamp. If the value cannot be parsed, this '
+    'member is omitted from the response and a warning is logged. Use '
+    '<code>ExpiresString</code> to read the raw value of the header.</p>'
+)
+_EXPIRES_STRING_DOC = (
+    '<p>The raw value of the <code>Expires</code> header, returned as a '
+    'string. Unlike <code>Expires</code>, this value is not parsed and is '
+    'always present when the header is returned. Prefer this member over the '
+    'deprecated <code>Expires</code> member.</p>'
+)
+
+
+def _add_expires_string_member(shape):
+    """Customize an output shape that contains an ``Expires`` timestamp.
+
+    The ``Expires`` member is deprecated and documented as such, and a
+    synthetic ``ExpiresString`` string member is added that reads the same
+    ``Expires`` header but keeps the raw value without parsing it.
+
+    The shape's member mapping is updated in place, so this is idempotent.
+    Only the members of the given shape are changed; the referenced
+    ``Expires`` shape itself is left untouched.
+    """
+    if not isinstance(shape, StructureShape):
+        return
+    members = shape.members
+    expires = members.get(EXPIRES_MEMBER_NAME)
+    if expires is None or expires.type_name != 'timestamp':
+        return
+    if EXPIRES_STRING_MEMBER_NAME in members:
+        return
+    resolver = shape._shape_resolver
+
+    # Replace Expires with a copy that carries the deprecation documentation.
+    expires_model = dict(expires._shape_model)
+    expires_model['documentation'] = _EXPIRES_DEPRECATION_DOC
+    members[EXPIRES_MEMBER_NAME] = expires.__class__(
+        expires.name, expires_model, resolver
+    )
+
+    # Add ExpiresString, which shares the Expires header location but is a
+    # plain string so the raw header value is retained.
+    expires_string_model = dict(expires._shape_model)
+    expires_string_model['type'] = 'string'
+    expires_string_model['documentation'] = _EXPIRES_STRING_DOC
+    expires_string_model.pop('timestampFormat', None)
+    members[EXPIRES_STRING_MEMBER_NAME] = StringShape(
+        EXPIRES_STRING_MEMBER_NAME, expires_string_model, resolver
+    )
+
+
 class OperationModel:
