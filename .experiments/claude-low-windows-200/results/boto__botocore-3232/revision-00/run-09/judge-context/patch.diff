+    def _is_expires_member(self, member_shape):
+        # The S3 ``Expires`` shape is a timestamp, but service responses
+        # frequently contain values that cannot be parsed as one. Such
+        # members are handled with a fallback instead of failing the call.
+        return member_shape.name == 'Expires' and (
+            member_shape.type_name == 'timestamp'
+        )
+
+    def _parse_expires_header(self, member_shape, name, raw_value, parsed):
+        # Deprecated: ``Expires`` is retained for backwards compatibility,
+        # use ``ExpiresString`` to access the raw header value.
+        parsed['ExpiresString'] = raw_value
+        try:
+            parsed[name] = self._parse_shape(member_shape, raw_value)
+        except (ValueError, TypeError, OverflowError):
+            LOG.warning(
+                "Unable to parse the 'Expires' header value %r as a "
+                "timestamp; omitting the 'Expires' member from the response. "
+                "The raw value is available as 'ExpiresString'.",
+                raw_value,
+            )
 
