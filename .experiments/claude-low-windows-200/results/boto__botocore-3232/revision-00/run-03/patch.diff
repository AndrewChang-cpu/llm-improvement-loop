+EXPIRES_SHAPE_NAME = 'Expires'
+EXPIRES_STRING_MEMBER_NAME = 'ExpiresString'
+EXPIRES_STRING_DOCUMENTATION = (
+    '<p>The raw string value of the <code>Expires</code> header. Use this '
+    'member instead of <code>Expires</code>, which is deprecated. If the '
+    '<code>Expires</code> header cannot be parsed as a timestamp, '
+    '<code>Expires</code> is omitted from the response and this member '
+    'still contains the raw value.</p>'
+)
+
+
+def _add_expires_string_member(shape):
+    """Add a synthetic ``ExpiresString`` member next to ``Expires``.
+
+    The ``Expires`` member is kept as a timestamp for backwards
+    compatibility. ``ExpiresString`` exposes the raw header value so
+    that callers can still read it when ``Expires`` cannot be parsed.
+    """
+    if not isinstance(shape, StructureShape):
+        return
+    members = shape.members
+    expires = members.get('Expires')
+    if (
+        expires is None
+        or expires.name != EXPIRES_SHAPE_NAME
+        or expires.type_name != 'timestamp'
+        or EXPIRES_STRING_MEMBER_NAME in members
+    ):
+        return
+    location = expires.serialization.get('location')
+    if location is None:
+        return
+    shape_model = {
+        'type': 'string',
+        'documentation': EXPIRES_STRING_DOCUMENTATION,
+        'location': location,
+        'locationName': expires.serialization.get('name', 'Expires'),
+    }
+    members[EXPIRES_STRING_MEMBER_NAME] = StringShape(
+        EXPIRES_STRING_MEMBER_NAME, shape_model
+    )
+
+
