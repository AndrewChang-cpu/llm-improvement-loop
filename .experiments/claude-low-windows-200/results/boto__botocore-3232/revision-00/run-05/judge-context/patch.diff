 # When a Session is created, everything in this list will be
 # automatically registered with that Session.
 
+EXPIRES_STRING_HEADER = 'x-botocore-expires-string'
+
+
+def _add_expires_string_member(output_shape):
+    if 'ExpiresString' in output_shape.members:
+        return
+    output_shape.members['ExpiresString'] = StringShape(
+        'ExpiresString',
+        {
+            'type': 'string',
+            'documentation': (
+                'The raw, unparsed value of the Expires header. Use this '
+                'member instead of the deprecated Expires member, which is '
+                'omitted when the header cannot be parsed as a timestamp.'
+            ),
+            'location': 'header',
+            'locationName': EXPIRES_STRING_HEADER,
+        },
+    )
+
+
+def handle_expires_header(operation_model, response_dict, **kwargs):
+    """Make S3 ``Expires`` parsing non-fatal.
+
+    If the output shape has a timestamp ``Expires`` member, a synthetic
+    ``ExpiresString`` member is added holding the raw header value. If the
+    header is not a parseable timestamp, ``Expires`` is removed from the
+    response (so it is omitted from the output) and a warning is logged.
+    """
+    output_shape = operation_model.output_shape
+    if output_shape is None:
+        return
+    expires = output_shape.members.get('Expires')
+    if expires is None or expires.type_name != 'timestamp':
+        return
+    _add_expires_string_member(output_shape)
+
+    headers = response_dict.get('headers')
+    if headers is None or 'Expires' not in headers:
+        return
+    raw_value = headers['Expires']
+    headers[EXPIRES_STRING_HEADER] = raw_value
+    try:
+        parse_timestamp(raw_value)
+    except (ValueError, TypeError, OverflowError, OSError):
+        logger.warning(
+            'Unable to parse the Expires header value %r as a timestamp; '
+            'omitting Expires from the response. The raw value is available '
+            'as ExpiresString.',
+            raw_value,
+        )
+        del headers['Expires']
+
+
 BUILTIN_HANDLERS = [
