+def _has_expires_member(shape):
+    return shape is not None and 'Expires' in shape.members
+
+
+def handle_expires_header(operation_model, response_dict, context, **kwargs):
+    """Make S3 ``Expires`` header parsing non-fatal.
+
+    The ``Expires`` output member is modeled as a timestamp. If the header
+    cannot be parsed, the ``Expires`` key is omitted from the response and a
+    warning is logged instead of raising an error. The raw header value is
+    stored in the request context so that ``add_expires_string_member`` can
+    expose it as the ``ExpiresString`` member.
+
+    .. note::
+        ``Expires`` is deprecated for S3 responses. Use ``ExpiresString``
+        instead, which always contains the raw value of the header.
+    """
+    if not _has_expires_member(operation_model.output_shape):
+        return
+    headers = response_dict.get('headers')
+    if not headers or 'Expires' not in headers:
+        return
+    raw_value = headers['Expires']
+    context['s3_expires_string'] = raw_value
+    try:
+        utils.parse_timestamp(raw_value)
+    except (ValueError, TypeError, OverflowError):
+        logger.warning(
+            'Unable to parse the S3 "Expires" header value %r as a timestamp. '
+            'The "Expires" key will be omitted from the response. Use '
+            '"ExpiresString" to access the raw value.',
+            raw_value,
+        )
+        response_dict['headers'] = {
+            name: value
+            for name, value in headers.items()
+            if name != 'Expires'
+        }
+
+
+def add_expires_string_member(context, parsed, **kwargs):
+    """Populate the synthetic ``ExpiresString`` member of S3 responses."""
+    if not isinstance(parsed, dict) or 's3_expires_string' not in context:
+        return
+    parsed['ExpiresString'] = context['s3_expires_string']
+
