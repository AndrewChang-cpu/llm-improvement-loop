     params['headers']['x-amz-api-version'] = model.service_model.api_version
 
 
+def handle_expires_string(parsed, model, http_response, **kwargs):
+    """Expose the raw S3 ``Expires`` header as ``ExpiresString``.
+
+    The ``Expires`` member is deprecated in favor of ``ExpiresString``. ``Expires``
+    is still parsed as a timestamp for backwards compatibility. If the header
+    cannot be parsed, the parser omits ``Expires`` and logs a warning, and this
+    handler still provides the raw value under ``ExpiresString``.
+    """
+    output_shape = model.output_shape
+    if output_shape is None or 'Expires' not in output_shape.members:
+        return
+    if output_shape.members['Expires'].type_name != 'timestamp':
+        return
+    if http_response.status_code >= 300:
+        return
+    raw_value = http_response.headers.get('Expires')
+    if raw_value is not None:
+        parsed['ExpiresString'] = raw_value
+
