diff --git a/tests/test_bar.py b/tests/test_bar.py
index 021a8aa..4db60bb 100644
--- a/tests/test_bar.py
+++ b/tests/test_bar.py
@@ -99,3 +99,10 @@ if __name__ == "__main__":
     bar.update(completed=12)
     bar_render = render(bar)
     print(repr(bar_render))
+
+
+def test_bar_unknown_total_renders_pulse() -> None:
+    unknown = ProgressBar(total=None, completed=3, width=20, animation_time=0.0)
+    pulse = ProgressBar(total=100, completed=3, width=20, pulse=True, animation_time=0.0)
+    assert unknown.percentage_completed is None
+    assert render(unknown) == render(pulse)
diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..cea2410 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -634,3 +634,25 @@ if __name__ == "__main__":
     _render = render_progress()
     print(_render)
     print(repr(_render))
+
+
+def test_task_unknown_total() -> None:
+    task = Task(TaskID(1), "foo", None, 5, _get_time=lambda: 1)
+    assert task.remaining is None
+    assert task.percentage == 0.0
+    assert task.time_remaining is None
+
+
+def test_bar_column_unknown_total_pulses() -> None:
+    task = Task(TaskID(1), "foo", None, 5, _get_time=lambda: 1)
+    task.start_time = 0
+    bar = BarColumn(bar_width=20).render(task)
+    assert bar.total is None
+    assert bar.pulse is True
+
+
+def test_unknown_total_columns() -> None:
+    task = Task(TaskID(1), "foo", None, 1500, _get_time=lambda: 1)
+    assert TotalFileSizeColumn().render(task).plain == "?"
+    assert MofNCompleteColumn().render(task).plain == "1500"
+    assert DownloadColumn().render(task).plain == "1.5 kB"
