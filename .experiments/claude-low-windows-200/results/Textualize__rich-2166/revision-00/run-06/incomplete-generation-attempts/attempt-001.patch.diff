diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..d47fc3b 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -630,6 +630,55 @@ def test_wrap_file_task_total() -> None:
         os.remove(filename)
 
 
+def test_add_task_total_none() -> None:
+    progress = rich.progress.Progress()
+    task_id = progress.add_task("Unknown", total=None)
+    task = progress.tasks[0]
+    assert task.id == task_id
+    assert task.total is None
+    assert task.remaining is None
+    assert task.percentage == 0.0
+    assert task.time_remaining is None
+
+
+def test_total_none_advance_and_update() -> None:
+    progress = rich.progress.Progress()
+    task_id = progress.add_task("Unknown", total=None)
+    progress.advance(task_id, 5)
+    progress.update(task_id, completed=10)
+    task = progress.tasks[0]
+    assert task.completed == 10
+    assert task.total is None
+    assert task.finished_time is None
+
+
+def test_total_none_renders_pulse_bar() -> None:
+    task = rich.progress.Task(
+        id=0,
+        description="x",
+        total=None,
+        completed=3,
+        _get_time=lambda: 0.0,
+    )
+    bar = rich.progress.BarColumn().render(task)
+    assert isinstance(bar, ProgressBar)
+    assert bar.total is None
+    assert bar.pulse is True
+
+
+def test_total_none_columns() -> None:
+    task = rich.progress.Task(
+        id=0,
+        description="x",
+        total=None,
+        completed=3,
+        _get_time=lambda: 0.0,
+    )
+    assert rich.progress.MofNCompleteColumn().render(task).plain == "3/?"
+    assert rich.progress.DownloadColumn().render(task).plain == "3 bytes/?"
+    assert rich.progress.TotalFileSizeColumn().render(task).plain == ""
+
+
 if __name__ == "__main__":
     _render = render_progress()
     print(_render)
