--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -630,6 +630,48 @@ def test_wrap_file_task_total() -> None:
         os.remove(filename)
 
 
+def test_total_none_renders_pulse() -> None:
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system=None,
+        width=60,
+    )
+    progress = Progress(
+        TextColumn("{task.description}"),
+        BarColumn(),
+        TextColumn("{task.percentage:>3.0f}%"),
+        TimeRemainingColumn(),
+        console=console,
+    )
+    with progress:
+        task_id = progress.add_task("Pulsing", total=None)
+        progress.advance(task_id, 5)
+        task = progress.tasks[0]
+        assert task.total is None
+        assert task.remaining is None
+        assert task.percentage == 0.0
+        assert task.time_remaining is None
+        assert not task.finished
+        progress.update(task_id, total=10, completed=10)
+        assert progress.tasks[0].finished
+
+
+def test_total_none_mofn_and_download_columns() -> None:
+    progress = Progress(
+        MofNCompleteColumn(),
+        DownloadColumn(),
+        TotalFileSizeColumn(),
+        console=Console(file=io.StringIO(), width=80),
+    )
+    task_id = progress.add_task("x", total=None, completed=1500)
+    task = progress.tasks[0]
+    assert "?" in str(MofNCompleteColumn()(task))
+    assert "/?" in str(DownloadColumn()(task))
+    assert str(TotalFileSizeColumn()(task)) == "?"
+    assert task_id is not None
+
+
 if __name__ == "__main__":
     _render = render_progress()
     print(_render)
