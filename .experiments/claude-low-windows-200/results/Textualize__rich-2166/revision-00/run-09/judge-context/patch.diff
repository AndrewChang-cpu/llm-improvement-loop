diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..4e985f0 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -634,3 +634,22 @@ if __name__ == "__main__":
     _render = render_progress()
     print(_render)
     print(repr(_render))
+
+
+
+def test_total_none_renders_pulse_and_no_eta() -> None:
+    """A task with total=None should render a pulse bar and have no ETA."""
+    from rich.progress import BarColumn, MofNCompleteColumn, TotalFileSizeColumn
+
+    task = Task(1, "unknown", None, 5, _get_time=lambda: 1.0)  # type: ignore[arg-type]
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert task.percentage == 0.0
+    assert not task.finished
+
+    bar = BarColumn().render(task)
+    assert bar.pulse is True
+    assert bar.total is None
+
+    assert MofNCompleteColumn().render(task).plain == "5"
+    assert TotalFileSizeColumn().render(task).plain == "?"
