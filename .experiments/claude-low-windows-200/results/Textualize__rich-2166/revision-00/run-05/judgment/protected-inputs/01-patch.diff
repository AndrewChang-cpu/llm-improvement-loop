@@ -428,6 +428,50 @@ def test_task_zero_total() -> None:
     assert task.percentage == 0
 
 
+def test_task_total_none() -> None:
+    """A task with an unknown total (None) should render a pulse bar and not fail."""
+    time = 0.0
+
+    def get_time() -> float:
+        return time
+
+    progress = rich.progress.Progress(
+        console=Console(file=io.StringIO(), force_terminal=True, width=60),
+        get_time=get_time,
+        auto_refresh=False,
+    )
+    task_id = progress.add_task("Unknown", total=None)
+    task = progress.tasks[0]
+    assert task.total is None
+    assert task.remaining is None
+    assert task.percentage == 0.0
+    assert task.time_remaining is None
+
+    time = 1.0
+    progress.advance(task_id, 5)
+    assert task.finished is False
+    assert task.time_remaining is None
+
+    bar_column = BarColumn()
+    bar = bar_column.render(task)
+    assert bar.pulse is True
+    assert bar.total is None
+
+    # Rendering the whole progress table must not raise
+    progress.console.print(progress.make_tasks_table(progress.tasks))
+
+    # Columns that depend on the total must also cope with None
+    for column in (
+        MofNCompleteColumn(),
+        DownloadColumn(),
+        TotalFileSizeColumn(),
+    ):
+        assert column.render(task) is not None
+
+    progress.update(task_id, total=10)
+    assert task.total == 10
+
+
 def test_progress_create() -> None:
     progress = Progress()
     assert progress.finished
