+def test_add_task_total_none_pulses() -> None:
+    """A task with an unknown total renders a pulse bar and never raises."""
+    console = Console(
+        file=io.StringIO(), force_terminal=True, width=60, color_system="truecolor"
+    )
+    progress = Progress(console=console, auto_refresh=False)
+    with progress:
+        task_id = progress.add_task("Unknown", total=None)
+        task = progress.tasks[0]
+        assert task.total is None
+        assert task.remaining is None
+        assert task.percentage == 0.0
+        assert task.time_remaining is None
+        progress.advance(task_id, 10)
+        progress.update(task_id, completed=20)
+        assert not task.finished
+        progress.refresh()
+        output = console.file.getvalue()
+    assert "Unknown" in output
+
+
+def test_task_total_none_is_not_finished() -> None:
+    progress = Progress(console=Console(file=io.StringIO()), auto_refresh=False)
+    task_id = progress.add_task("Unknown", total=None, completed=1000)
+    progress.advance(task_id, 1000)
+    assert not progress.tasks[0].finished
+
+
+def test_bar_column_pulses_when_total_none() -> None:
+    task = Task(TaskID(0), "Unknown", None, 0, _get_time=lambda: 0.0)
+    task.start_time = 0.0
+    bar = BarColumn().render(task)
+    assert bar.total is None
+    assert bar.pulse
+
+
 if __name__ == "__main__":
