 from rich.segment import Segment
@@ -92,6 +93,19 @@ def test_get_pulse_segments():
     assert segments == expected
 
 
+def test_pulse_when_total_none() -> None:
+    """A bar with no total renders the pulse animation."""
+    bar = ProgressBar(total=None, animation_time=0.0)
+    assert bar.percentage_completed == 0.0
+    console = Console(
+        file=io.StringIO(), force_terminal=True, width=40, color_system="truecolor"
+    )
+    options = console.options
+    segments = list(bar.__rich_console__(console, options))
+    assert segments
+    assert sum(len(seg.text) for seg in segments) == options.max_width
+
+
 if __name__ == "__main__":
     bar = ProgressBar(completed=11, width=50)
     bar_render = render(bar)
