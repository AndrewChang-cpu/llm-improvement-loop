diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..d1dce73 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -634,3 +634,45 @@ if __name__ == "__main__":
     _render = render_progress()
     print(_render)
     print(repr(_render))
+
+
+def test_none_total_renders_pulse() -> None:
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", width=40
+    )
+    progress = rich.progress.Progress(console=console, auto_refresh=False)
+    task_id = progress.add_task("pulse", total=None)
+    task = progress._tasks[task_id]
+    assert task.total is None
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert task.percentage == 0.0
+
+    progress.advance(task_id, 10)
+    assert task.finished is False
+
+    bar_column = BarColumn()
+    rendered = bar_column.render(task)
+    assert rendered.pulse is True
+    assert rendered.total is None
+    segments = list(rendered.__rich_console__(console, console.options))
+    assert sum(len(seg.text) for seg in segments) == 40
+
+
+def test_none_total_columns() -> None:
+    console = Console(file=io.StringIO(), width=80)
+    progress = rich.progress.Progress(console=console, auto_refresh=False)
+    task_id = progress.add_task("x", total=None, completed=5)
+    task = progress._tasks[task_id]
+    assert MofNCompleteColumn().render(task).plain == "5/?"
+    assert TotalFileSizeColumn().render(task).plain == "?"
+    assert DownloadColumn().render(task).plain == "5 bytes/?"
+    assert TimeRemainingColumn().render(task).plain == "-:--:--"
+
+
+def test_progress_bar_none_total() -> None:
+    console = Console(file=io.StringIO(), width=20)
+    bar = ProgressBar(total=None, completed=3, width=20)
+    assert bar.total is None
+    lines = console.render_lines(bar, console.options, pad=False)
+    assert sum(len(seg.text) for line in lines for seg in line) == 20
