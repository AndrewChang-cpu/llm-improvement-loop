diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..5e9f338 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -634,3 +634,53 @@ if __name__ == "__main__":
     _render = render_progress()
     print(_render)
     print(repr(_render))
+
+
+def test_progress_bar_none_total_renders_pulse() -> None:
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=40,
+        color_system="truecolor",
+        _environ={},
+    )
+    bar = ProgressBar(total=None, completed=5, width=20, animation_time=0.0)
+    console.print(bar)
+    output = console.file.getvalue()
+    assert output
+    assert "━" in output
+
+
+def test_progress_none_total_task() -> None:
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        width=120,
+        color_system="truecolor",
+        _environ={},
+    )
+    progress = Progress(
+        "test",
+        BarColumn(bar_width=10),
+        TimeRemainingColumn(),
+        FileSizeColumn(),
+        TotalFileSizeColumn(),
+        DownloadColumn(),
+        TransferSpeedColumn(),
+        MofNCompleteColumn(),
+        console=console,
+        get_time=MockClock(),
+    )
+    task_id = progress.add_task("unknown", total=None)
+    progress.advance(task_id, 3)
+    task = progress.tasks[0]
+    assert task.total is None
+    assert task.remaining is None
+    assert task.percentage == 0.0
+    assert task.time_remaining is None
+    assert task.finished_time is None
+    console.print(progress.make_tasks_table(progress.tasks))
+    assert "?" in console.file.getvalue()
+    progress.update(task_id, total=20)
+    progress.update(task_id, completed=20)
+    assert progress.tasks[0].finished is True
