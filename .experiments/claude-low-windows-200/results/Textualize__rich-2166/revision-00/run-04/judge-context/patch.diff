diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..5a56de9 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -61,6 +61,40 @@ def test_bar_columns():
     assert bar.total == 100
 
 
+def test_bar_columns_unknown_total():
+    bar_column = BarColumn(100)
+    task = Task(1, "test", None, 20, _get_time=lambda: 1.0)
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert task.percentage == 0.0
+    bar = bar_column(task)
+    assert isinstance(bar, ProgressBar)
+    assert bar.total is None
+    assert bar.pulse is True
+    console = Console(width=100, color_system="truecolor", force_terminal=True)
+    rendered = console.render_lines(bar, console.options, pad=False)
+    assert rendered
+
+
+def test_progress_unknown_total():
+    progress = rich.progress.Progress(
+        rich.progress.TextColumn("{task.description}"),
+        rich.progress.BarColumn(),
+        rich.progress.TotalFileSizeColumn(),
+        rich.progress.DownloadColumn(),
+        rich.progress.MofNCompleteColumn(),
+        rich.progress.TimeRemainingColumn(),
+        auto_refresh=False,
+    )
+    task_id = progress.add_task("pulse", total=None)
+    progress.update(task_id, advance=5)
+    assert progress.tasks[0].total is None
+    assert progress.tasks[0].finished is False
+    progress.update(task_id, total=10)
+    progress.update(task_id, completed=10)
+    assert progress.tasks[0].finished is True
+
+
