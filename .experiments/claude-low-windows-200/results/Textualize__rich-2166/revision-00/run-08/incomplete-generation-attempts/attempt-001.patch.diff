diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..432d318 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -634,3 +634,39 @@ if __name__ == "__main__":
     _render = render_progress()
     print(_render)
     print(repr(_render))
+
+
+def test_task_unknown_total() -> None:
+    task = Task(TaskID(1), "foo", None, 5, _get_time=lambda: 1)
+    assert task.total is None
+    assert task.remaining is None
+    assert task.percentage == 0
+    assert task.time_remaining is None
+    assert not task.finished
+
+
+def test_progress_unknown_total_never_finishes() -> None:
+    progress = Progress()
+    task_id = progress.add_task("foo", total=None)
+    progress.advance(task_id, 10)
+    progress.update(task_id, advance=10)
+    task = progress.tasks[0]
+    assert task.total is None
+    assert task.completed == 20
+    assert not task.finished
+    assert not progress.finished
+
+
+def test_bar_column_pulses_for_unknown_total() -> None:
+    task = Task(TaskID(1), "foo", None, 0, _get_time=lambda: 1)
+    bar = BarColumn().render(task)
+    assert isinstance(bar, ProgressBar)
+    assert bar.total is None
+    assert bar.pulse is True
+
+
+def test_columns_with_unknown_total() -> None:
+    task = Task(TaskID(1), "foo", None, 3, _get_time=lambda: 1)
+    assert TotalFileSizeColumn().render(task).plain == "?"
+    assert MofNCompleteColumn().render(task).plain == "3/?"
+    assert DownloadColumn().render(task).plain == "3 bytes/?"
