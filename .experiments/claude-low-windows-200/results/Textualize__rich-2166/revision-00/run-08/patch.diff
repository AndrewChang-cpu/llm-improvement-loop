diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..cbd6171 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -428,6 +428,46 @@ def test_task_zero_total() -> None:
     assert task.percentage == 0
 
 
+def test_task_unknown_total() -> None:
+    task = Task(TaskID(1), "foo", None, 0, _get_time=lambda: 1)
+    assert task.remaining is None
+    assert task.percentage == 0.0
+    assert task.time_remaining is None
+    assert not task.finished
+
+
+def test_progress_unknown_total_renders_pulse() -> None:
+    console = Console(
+        file=io.StringIO(), force_terminal=True, width=60, color_system=None
+    )
+    progress = rich.progress.Progress(
+        rich.progress.TextColumn("{task.description}"),
+        rich.progress.BarColumn(bar_width=20),
+        rich.progress.MofNCompleteColumn(),
+        rich.progress.TotalFileSizeColumn(),
+        console=console,
+        get_time=lambda: 1.0,
+        disable=False,
+    )
+    with progress:
+        task_id = progress.add_task("foo", total=None)
+        progress.advance(task_id, 5)
+        task = progress.tasks[0]
+        assert task.total is None
+        assert task.finished is False
+        progress.update(task_id, completed=1000)
+        assert progress.tasks[0].finished is False
+        progress.refresh()
+    output = console.file.getvalue()
+    assert "?" in output
+
+
+def test_download_column_unknown_total() -> None:
+    task = Task(TaskID(1), "foo", None, 2_000_000, _get_time=lambda: 1)
+    text = rich.progress.DownloadColumn().render(task)
+    assert text.plain == "2.0/? MB"
+
+
 def test_progress_create() -> None:
     progress = Progress()
     assert progress.finished
