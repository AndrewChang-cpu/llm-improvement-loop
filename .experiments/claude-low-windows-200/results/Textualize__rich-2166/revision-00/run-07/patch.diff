diff --git a/tests/test_progress.py b/tests/test_progress.py
index d3c6171..f759a1c 100644
--- a/tests/test_progress.py
+++ b/tests/test_progress.py
@@ -634,3 +634,30 @@ if __name__ == "__main__":
     _render = render_progress()
     print(_render)
     print(repr(_render))
+
+
+def test_bar_columns_with_unknown_total():
+    progress = rich.progress.Progress(
+        BarColumn(),
+        TotalFileSizeColumn(),
+        MofNCompleteColumn(),
+        DownloadColumn(),
+        auto_refresh=False,
+    )
+    task_id = progress.add_task("unknown", total=None)
+    progress.advance(task_id, 3)
+    task = progress.tasks[0]
+    assert task.total is None
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert not task.finished
+    # Rendering a task with unknown total should produce a pulse bar, not raise
+    bar = BarColumn().render(task)
+    assert bar.total is None
+    console = Console(
+        file=io.StringIO(), force_terminal=True, color_system="truecolor", width=80
+    )
+    console.print(bar)
+    console.print(MofNCompleteColumn().render(task))
+    console.print(DownloadColumn().render(task))
+    console.print(TotalFileSizeColumn().render(task))
