+def test_indeterminate_task_renders_pulse() -> None:
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=40,
+        legacy_windows=False,
+        _environ={},
+    )
+    progress = Progress(
+        BarColumn(bar_width=None),
+        TaskProgressColumn(),
+        TimeRemainingColumn(),
+        console=console,
+        get_time=lambda: 1.0,
+        auto_refresh=False,
+    )
+    progress.add_task("foo", total=None)
+    console.print(progress)
+    output = console.file.getvalue()
+    assert output.count("━") == 37
+    assert "%" not in output
+    assert "-:--:--" not in output
+    assert output.endswith("  \n")
+
+
+def test_task_unknown_total_state() -> None:
+    task = Task(TaskID(1), "foo", None, 20, _get_time=lambda: 1.0)
+    assert task.remaining is None
+    assert task.time_remaining is None
+    assert task.percentage == 0
+    assert not task.finished
+
+
+def test_update_unknown_total_does_not_finish() -> None:
+    progress = Progress(get_time=lambda: 1.0, auto_refresh=False)
+    task_id = progress.add_task("foo", total=None)
+    progress.update(task_id, completed=500)
+    progress.advance(task_id, 10)
+    task = progress.tasks[0]
+    assert task.completed == 510
+    assert task.total is None
+    assert task.finished_time is None
+    assert task.finished_speed is None
+    progress.update(task_id, total=100)
+    assert task.total == 100
+    assert task.remaining == 100 - 510
+
+
+def test_bar_unknown_total() -> None:
+    bar = ProgressBar(total=None, completed=10, width=20, animation_time=1.0)
+    assert bar.percentage_completed is None
+    console = Console(
+        file=io.StringIO(),
+        force_terminal=True,
+        color_system="truecolor",
+        width=20,
+        _environ={},
+    )
+    segments = list(bar.__rich_console__(console, console.options))
+    assert sum(len(seg.text) for seg in segments) == 20
+
+
+def test_unknown_total_columns() -> None:
+    task = Task(TaskID(1), "foo", None, 5, _get_time=lambda: 1.0)
+    assert TaskProgressColumn().render(task).plain == ""
+    assert TimeRemainingColumn().render(task).plain == ""
+    assert TotalFileSizeColumn().render(task).plain == ""
+    assert MofNCompleteColumn().render(task).plain == "5/?"
+    assert DownloadColumn().render(task).plain == "5/? bytes"
+
+
+def test_unknown_total_download_units() -> None:
+    task = Task(TaskID(1), "foo", None, 2048, _get_time=lambda: 1.0)
+    assert DownloadColumn(binary_units=True).render(task).plain == "2.0/? KiB"
+    assert DownloadColumn().render(task).plain == "2.0/? kB"
