@@ -0,0 +1,104 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    Path,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """
+    Parse the value of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list of two or more valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of two or more valid paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath`` pointing at a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It must be a :class:`~rdflib.term.URIRef` or a blank node.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` instance for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is malformed.
+    """
+    # Inspired by the SHACL-to-SPARQL path conversion in pyshacl.
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}"
+        )
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*(parse_shacl_path(shapes_graph, i) for i in items))
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        items = list(shapes_graph.items(alternative_value))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(*(parse_shacl_path(shapes_graph, i) for i in items))
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    # sh:zeroOrMorePath -> "*"
+    value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, value), ZeroOrMore)
+
+    # sh:oneOrMorePath -> "+"
+    value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, value), OneOrMore)
+
+    # sh:zeroOrOnePath -> "?"
+    value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, value), ZeroOrOne)
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..3a90a2a
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,166 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from rdflib import RDF, Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt3 sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:altNested sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        ( ex:p4 ex:p5 )
+    )
+] .
+
+ex:zom sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oom sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zoo sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:invMod sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:seqCombo sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:nilPath sh:path rdf:nil .
+ex:nilItem sh:path ( ex:p1 rdf:nil ) .
+ex:emptySeq sh:path rdf:nil .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath rdf:nil ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:notAPath ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _node(shapes_graph: Graph, local: str) -> Any:
+    """Return the sh:path object of the named shape."""
+    value = shapes_graph.value(EX[local], SH.path)
+    assert value is not None
+    return value
+
+
+P1, P2, P3, P4, P5 = (EX[f"p{i}"] for i in range(1, 6))
+
+
+def _valid_cases() -> list[tuple[str, Any]]:
+    return [
+        ("simple", P1),
+        ("seq3", SequencePath(P1, P2, P3)),
+        ("seqNested", SequencePath(P1, SequencePath(P2, P3))),
+        ("inv", InvPath(P1)),
+        ("alt3", AlternativePath(P1, P2, P3)),
+        (
+            "altNested",
+            AlternativePath(P1, AlternativePath(P2, P3), SequencePath(P4, P5)),
+        ),
+        ("zom", MulPath(P1, ZeroOrMore)),
+        ("oom", MulPath(P1, OneOrMore)),
+        ("zoo", MulPath(P1, ZeroOrOne)),
+        ("invMod", MulPath(InvPath(P1), ZeroOrMore)),
+        (
+            "seqCombo",
+            SequencePath(
+                AlternativePath(P1, P2),
+                MulPath(P3, OneOrMore),
+            ),
+        ),
+    ]
+
+
+def _invalid_cases() -> list[tuple[str, type[Exception]]]:
+    return [
+        ("nilPath", SHACLPathError),
+        ("nilItem", SHACLPathError),
+        ("emptySeq", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+        ("literal", TypeError),
+    ]
+
+
+@pytest.mark.parametrize(
+    ("local", "expected"),
+    _valid_cases(),
+)
+def test_valid_shacl_path(
+    shapes_graph: Graph, local: str, expected: Any
+) -> None:
+    before = set(shapes_graph)
+    result = parse_shacl_path(shapes_graph, _node(shapes_graph, local))
+    assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(
+    ("local", "exc_type"),
+    _invalid_cases(),
+)
+def test_invalid_shacl_path(
+    shapes_graph: Graph, local: str, exc_type: type[Exception]
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, _node(shapes_graph, local))
+    assert set(shapes_graph) == before
+
+
+def test_iri_returned_unchanged(shapes_graph: Graph) -> None:
+    result = parse_shacl_path(shapes_graph, P1)
+    assert isinstance(result, URIRef)
+    assert result == P1
+
+
+def test_shacl_path_error_is_not_value_error() -> None:
+    assert issubclass(SHACLPathError, Exception)
+    assert not issubclass(SHACLPathError, ValueError)
+
+
+def test_literal_direct_raises_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("x"))
+
+
+def test_rdf_nil_direct_raises(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
