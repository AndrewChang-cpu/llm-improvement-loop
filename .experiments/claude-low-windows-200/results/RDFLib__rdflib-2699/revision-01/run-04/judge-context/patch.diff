+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import List, Set, Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    Path,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+def _walk_list(shapes_graph: Graph, list_node: Node) -> List[Node]:
+    """
+    Collect the items of an RDF list without modifying the graph.
+
+    :raises SHACLPathError: if the list is malformed or cyclic.
+    """
+    items: List[Node] = []
+    seen: Set[Node] = set()
+    node: Node = list_node
+    while node != RDF.nil:
+        if node in seen:
+            raise SHACLPathError(f"Cyclic RDF list in SHACL path at {node!r}")
+        seen.add(node)
+        first = shapes_graph.value(node, RDF.first)
+        rest = shapes_graph.value(node, RDF.rest)
+        if first is None or rest is None:
+            raise SHACLPathError(f"Malformed RDF list in SHACL path at {node!r}")
+        items.append(first)
+        node = rest
+    return items
+
+
+def parse_shacl_path(shapes_graph: Graph, path_identifier: Node) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into a predicate usable with rdflib.
+
+    A valid SHACL path is one of:
+
+    * an IRI (a simple predicate path, other than ``rdf:nil``);
+    * an RDF list of at least two paths (a sequence path);
+    * a blank node with ``sh:inversePath`` (an inverse path);
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list of
+      at least two paths (an alternative path);
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` (a modifier path).
+
+    The implementation is based on pyshacl's SHACL-to-SPARQL path conversion.
+
+    :param shapes_graph: the graph holding the shapes; it is only read, never
+        modified.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`
+        or not a node at all.
+    :raises SHACLPathError: if the path structure is malformed.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise TypeError(f"SHACL path must be a graph node, not {path_identifier!r}")
+
+    # IRI: a simple predicate path; rdf:nil is an empty list, not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list: sequence path.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = _walk_list(shapes_graph, path_identifier)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        items = _walk_list(shapes_graph, alternative_value)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got {len(items)}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    modifier_predicates = (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    )
+    for predicate, modifier in modifier_predicates:
+        value = shapes_graph.value(path_identifier, predicate)
+        if value is not None:
+            return MulPath(parse_shacl_path(shapes_graph, value), modifier)
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
