index 0000000..b19c47f
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,126 @@
+from __future__ import annotations
+
+from typing import Any, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+
+DATA = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:p1 ex:simple ex:a .
+ex:p1 ex:seqPath ( ex:a ex:b ex:c ) .
+ex:p1 ex:nestedSeq ( ex:a ( ex:b ex:c ) ) .
+ex:p1 ex:inv [ sh:inversePath ex:a ] .
+ex:p1 ex:alt [ sh:alternativePath ( ex:a ex:b ex:c ) ] .
+ex:p1 ex:nestedAlt [ sh:alternativePath ( ex:a ( ex:b ex:c ) [ sh:zeroOrMorePath ex:d ] ) ] .
+ex:p1 ex:zom [ sh:zeroOrMorePath ex:a ] .
+ex:p1 ex:oom [ sh:oneOrMorePath ex:a ] .
+ex:p1 ex:zoo [ sh:zeroOrOnePath ex:a ] .
+ex:p1 ex:combo [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ] .
+ex:p1 ex:mixedSeq ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] [ sh:oneOrMorePath ex:d ] ) .
+ex:p1 ex:nil rdf:nil .
+ex:p1 ex:emptySeq rdf:nil .
+ex:p1 ex:oneSeq ( ex:a ) .
+ex:p1 ex:emptyAlt [ sh:alternativePath rdf:nil ] .
+ex:p1 ex:oneAlt [ sh:alternativePath ( ex:a ) ] .
+ex:p1 ex:unknown [ ex:somethingElse ex:a ] .
+ex:p1 ex:literal "not a path" .
+"""
+
+EX = "http://example.com/"
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=DATA, format="turtle")
+    return g
+
+
+def _obj(g: Graph, pred: str) -> Any:
+    return g.value(URIRef(EX + "p1"), URIRef(EX + pred))
+
+
+def _ex(name: str) -> URIRef:
+    return URIRef(EX + name)
+
+
+VALID_CASES = [
+    ("simple", URIRef(EX + "a")),
+    ("seqPath", SequencePath(_ex("a"), _ex("b"), _ex("c"))),
+    ("nestedSeq", SequencePath(_ex("a"), SequencePath(_ex("b"), _ex("c")))),
+    ("inv", InvPath(_ex("a"))),
+    ("alt", AlternativePath(_ex("a"), _ex("b"), _ex("c"))),
+    (
+        "nestedAlt",
+        AlternativePath(
+            _ex("a"),
+            SequencePath(_ex("b"), _ex("c")),
+            MulPath(_ex("d"), "*"),
+        ),
+    ),
+    ("zom", MulPath(_ex("a"), "*")),
+    ("oom", MulPath(_ex("a"), "+")),
+    ("zoo", MulPath(_ex("a"), "?")),
+    ("combo", MulPath(InvPath(_ex("a")), "*")),
+    (
+        "mixedSeq",
+        SequencePath(
+            _ex("a"),
+            AlternativePath(_ex("b"), _ex("c")),
+            MulPath(_ex("d"), "+"),
+        ),
+    ),
+]
+
+INVALID_CASES = [
+    ("nil", SHACLPathError),
+    ("emptySeq", SHACLPathError),
+    ("oneSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneAlt", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+def _check(actual: Union[URIRef, Path], expected: Union[URIRef, Path]) -> None:
+    assert type(actual) is type(expected)
+    if isinstance(expected, URIRef):
+        assert actual == expected
+    else:
+        assert actual.n3() == expected.n3()
+        assert repr(actual) == repr(expected)
+
+
+@pytest.mark.parametrize(
+    "name, expected",
+    VALID_CASES + [(n, e) for n, e in INVALID_CASES],
+    ids=[n for n, _ in VALID_CASES] + [n for n, _ in INVALID_CASES],
+)
+def test_parse_shacl_path(shapes_graph: Graph, name: str, expected: Any) -> None:
+    before = set(shapes_graph)
+    node = _obj(shapes_graph, name)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)
+    else:
+        _check(parse_shacl_path(shapes_graph, node), expected)
+    assert set(shapes_graph) == before
+
+
+def test_error_classes() -> None:
+    assert issubclass(SHACLPathError, Exception)
+    assert not issubclass(SHACLPathError, ValueError)
