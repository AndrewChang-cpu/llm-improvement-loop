+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,123 @@
+from typing import Any, Type, Union
+
+import pytest
+
+from rdflib import BNode, Graph, Namespace
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+
+EX = Namespace("http://example.com/shapes#")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/shapes#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seqOne sh:path ( ex:p1 ) .
+ex:seqEmpty sh:path rdf:nil .
+ex:nilPath sh:path rdf:nil .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:altNested sh:path [
+    sh:alternativePath (
+        [ sh:alternativePath ( ex:p1 ex:p2 ) ] ( ex:p3 ex:p4 )
+    )
+] .
+ex:altEmpty sh:path [ sh:alternativePath rdf:nil ] .
+ex:altOne sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:starInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMixed sh:path ( [ sh:alternativePath ( ex:p1 ex:p2 ) ] [ sh:oneOrMorePath ex:p3 ] ) .
+
+ex:unknown sh:path [ ex:notAPath ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+P1, P2, P3, P4 = EX.p1, EX.p2, EX.p3, EX.p4
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    ("shape", "expected"),
+    [
+        pytest.param("simple", P1, id="simple-iri"),
+        pytest.param("seq", SequencePath(P1, P2, P3), id="sequence"),
+        pytest.param(
+            "seqNested",
+            SequencePath(P1, SequencePath(P2, P3)),
+            id="sequence-nested",
+        ),
+        pytest.param("inv", InvPath(P1), id="inverse"),
+        pytest.param("alt", AlternativePath(P1, P2, P3), id="alternative"),
+        pytest.param(
+            "altNested",
+            AlternativePath(AlternativePath(P1, P2), SequencePath(P3, P4)),
+            id="alternative-nested",
+        ),
+        pytest.param("star", MulPath(P1, "*"), id="zero-or-more"),
+        pytest.param("plus", MulPath(P1, "+"), id="one-or-more"),
+        pytest.param("opt", MulPath(P1, "?"), id="zero-or-one"),
+        pytest.param("starInv", MulPath(InvPath(P1), "*"), id="modifier-of-inverse"),
+        pytest.param(
+            "seqMixed",
+            SequencePath(AlternativePath(P1, P2), MulPath(P3, "+")),
+            id="sequence-of-alternative-and-modifier",
+        ),
+    ],
+)
+def test_valid_shacl_path(
+    shapes_graph: Graph, shape: str, expected: Union[Any, Path]
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(EX[shape], SH.path)
+    assert parse_shacl_path(shapes_graph, node) == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(
+    ("shape", "exc_type"),
+    [
+        pytest.param("nilPath", SHACLPathError, id="nil-as-path"),
+        pytest.param("seqEmpty", SHACLPathError, id="sequence-empty"),
+        pytest.param("seqOne", SHACLPathError, id="sequence-one-item"),
+        pytest.param("altEmpty", SHACLPathError, id="alternative-empty"),
+        pytest.param("altOne", SHACLPathError, id="alternative-one-item"),
+        pytest.param("unknown", SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literal", TypeError, id="literal"),
+    ],
+)
+def test_invalid_shacl_path(
+    shapes_graph: Graph, shape: str, exc_type: Type[BaseException]
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(EX[shape], SH.path)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, node)
+    assert set(shapes_graph) == before
+
+
+def test_blank_node_without_path_predicate_is_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, BNode())
+
+
+def test_non_node_input_is_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, "http://example.com/p1")  # type: ignore
