@@ -0,0 +1,130 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import List, Set, Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+def _walk_list(shapes_graph: Graph, list_node: Node) -> List[Node]:
+    """
+    Collect the items of the RDF list starting at ``list_node``.
+
+    Only read operations are performed on ``shapes_graph``.
+    """
+    items: List[Node] = []
+    seen: Set[Node] = set()
+    current = list_node
+    while current != RDF.nil:
+        if current in seen:
+            raise SHACLPathError(f"Cyclic RDF list encountered at {current!r}.")
+        seen.add(current)
+        first = shapes_graph.value(current, RDF.first)
+        rest = shapes_graph.value(current, RDF.rest)
+        if first is None or rest is None:
+            raise SHACLPathError(
+                f"Malformed RDF list: node {current!r} lacks rdf:first or rdf:rest."
+            )
+        items.append(first)
+        current = rest
+    return items
+
+
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into a predicate usable with rdflib.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    The graph is only read, never modified.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: The path node, i.e. the object of ``sh:path``.
+        It must be a node, and not a :class:`~rdflib.term.Literal`.
+    :returns: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a Literal or not a node.
+    :raises SHACLPathError: If the path structure is malformed.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}."
+        )
+    if not isinstance(path_identifier, Node):
+        raise TypeError(f"SHACL path must be a graph node, got {path_identifier!r}.")
+
+    # Simple path: an IRI, but never rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path.")
+        return path_identifier
+
+    # Sequence path: an RDF list (rdf:first / rdf:rest chain).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = _walk_list(shapes_graph, path_identifier)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}."
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath
+    if (path_identifier, SH.inversePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.inversePath)
+        assert inner is not None
+        return InvPath(parse_shacl_path(shapes_graph, inner))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    if (path_identifier, SH.alternativePath, None) in shapes_graph:
+        alt_list = shapes_graph.value(path_identifier, SH.alternativePath)
+        assert alt_list is not None
+        items = _walk_list(shapes_graph, alt_list)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}."
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    if (path_identifier, SH.zeroOrMorePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+        assert inner is not None
+        return MulPath(parse_shacl_path(shapes_graph, inner), "*")
+    if (path_identifier, SH.oneOrMorePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+        assert inner is not None
+        return MulPath(parse_shacl_path(shapes_graph, inner), "+")
+    if (path_identifier, SH.zeroOrOnePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+        assert inner is not None
+        return MulPath(parse_shacl_path(shapes_graph, inner), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}.")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
