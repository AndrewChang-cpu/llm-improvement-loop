index 0000000..730242f
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,151 @@
+from typing import Any, Set, Tuple
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    SequencePath,
+    OneOrMore,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+
+EX = "http://example.org/"
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt3 sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:altNested sh:path [
+    sh:alternativePath (
+        [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+        ( ex:p3 ex:p4 )
+        [ sh:inversePath ex:p5 ]
+    )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:seqAlt sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:invalidNil sh:path rdf:nil .
+
+ex:invalidEmptySeq sh:path rdf:nil .
+
+ex:invalidOneSeq sh:path ( ex:p1 ) .
+
+ex:invalidEmptyAlt sh:path [ sh:alternativePath rdf:nil ] .
+
+ex:invalidOneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:invalidUnknown sh:path [ ex:unrelated ex:p1 ] .
+
+ex:invalidLiteral sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _p(name: str) -> URIRef:
+    return URIRef(EX + name)
+
+
+VALID_CASES = [
+    ("simple", _p("p1")),
+    (
+        "seq3",
+        SequencePath(_p("p1"), _p("p2"), _p("p3")),
+    ),
+    (
+        "seqNested",
+        SequencePath(_p("p1"), SequencePath(_p("p2"), _p("p3"))),
+    ),
+    ("inv", InvPath(_p("p1"))),
+    (
+        "alt3",
+        AlternativePath(_p("p1"), _p("p2"), _p("p3")),
+    ),
+    (
+        "altNested",
+        AlternativePath(
+            AlternativePath(_p("p1"), _p("p2")),
+            SequencePath(_p("p3"), _p("p4")),
+            InvPath(_p("p5")),
+        ),
+    ),
+    ("zeroOrMore", MulPath(_p("p1"), ZeroOrMore)),
+    ("oneOrMore", MulPath(_p("p1"), OneOrMore)),
+    ("zeroOrOne", MulPath(_p("p1"), ZeroOrOne)),
+    ("modInv", MulPath(InvPath(_p("p1")), ZeroOrMore)),
+    (
+        "seqAlt",
+        SequencePath(
+            AlternativePath(_p("p1"), _p("p2")),
+            MulPath(_p("p3"), OneOrMore),
+        ),
+    ),
+]
+
+INVALID_CASES = [
+    ("invalidNil", SHACLPathError),
+    ("invalidEmptySeq", SHACLPathError),
+    ("invalidOneSeq", SHACLPathError),
+    ("invalidEmptyAlt", SHACLPathError),
+    ("invalidOneAlt", SHACLPathError),
+    ("invalidUnknown", SHACLPathError),
+    ("invalidLiteral", TypeError),
+]
+
+
+def _triples(g: Graph) -> Set[Tuple[Any, Any, Any]]:
+    return set(g)
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    VALID_CASES + [(name, exc) for name, exc in INVALID_CASES],
+)
+def test_parse_shacl_path(shapes_graph: Graph, shape_name: str, expected: Any) -> None:
+    shape = URIRef(EX + shape_name)
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    before = _triples(shapes_graph)
+
+    if isinstance(expected, type) and issubclass(expected, BaseException):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)
+        assert result == expected
+        if isinstance(expected, URIRef):
+            assert isinstance(result, URIRef)
+
+    assert _triples(shapes_graph) == before
