@@ -0,0 +1,163 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seqOk sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:seqEmpty sh:path rdf:nil .
+ex:seqOne sh:path ( ex:p1 ) .
+ex:seqWithNil sh:path ( ex:p1 rdf:nil ) .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:invOfSeq sh:path [ sh:inversePath ( ex:p1 ex:p2 ) ] .
+
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:altNested sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        ( ex:p1 ex:p2 )
+    )
+] .
+ex:altEmpty sh:path [ sh:alternativePath rdf:nil ] .
+ex:altOne sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+    ex:p1
+) .
+
+ex:unknown sh:path [ ex:somethingElse ex:p1 ] .
+ex:literal sh:path "http://example.com/ns#p1" .
+"""
+
+EX = "http://example.com/ns#"
+
+
+def _p(name: str) -> URIRef:
+    return URIRef(EX + name)
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _path_node(shapes_graph: Graph, shape_name: str) -> Any:
+    return shapes_graph.value(_p(shape_name), SH.path)
+
+
+VALID_CASES = [
+    ("simple", _p("p1")),
+    ("seqOk", SequencePath(_p("p1"), _p("p2"), _p("p3"))),
+    (
+        "seqNested",
+        SequencePath(_p("p1"), SequencePath(_p("p2"), _p("p3"))),
+    ),
+    ("inv", InvPath(_p("p1"))),
+    ("invOfSeq", InvPath(SequencePath(_p("p1"), _p("p2")))),
+    ("alt", AlternativePath(_p("p1"), _p("p2"), _p("p3"))),
+    (
+        "altNested",
+        AlternativePath(
+            _p("p1"),
+            AlternativePath(_p("p2"), _p("p3")),
+            SequencePath(_p("p1"), _p("p2")),
+        ),
+    ),
+    ("star", MulPath(_p("p1"), ZeroOrMore)),
+    ("plus", MulPath(_p("p1"), OneOrMore)),
+    ("opt", MulPath(_p("p1"), ZeroOrOne)),
+    ("modInv", MulPath(InvPath(_p("p1")), ZeroOrMore)),
+    (
+        "seqMixed",
+        SequencePath(
+            AlternativePath(_p("p1"), _p("p2")),
+            MulPath(_p("p3"), OneOrMore),
+            _p("p1"),
+        ),
+    ),
+]
+
+INVALID_CASES = [
+    ("seqEmpty", SHACLPathError),  # rdf:nil as the whole path
+    ("seqWithNil", SHACLPathError),  # rdf:nil as a sequence item
+    ("seqOne", SHACLPathError),  # one-item sequence list
+    ("altEmpty", SHACLPathError),  # empty alternative list
+    ("altOne", SHACLPathError),  # one-item alternative list
+    ("unknown", SHACLPathError),  # unrecognized blank node
+    ("literal", TypeError),  # literal path node
+]
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    VALID_CASES + INVALID_CASES,
+    ids=[c[0] for c in VALID_CASES + INVALID_CASES],
+)
+def test_parse_shacl_path(shapes_graph: Graph, shape_name: str, expected: Any) -> None:
+    before = set(shapes_graph)
+    node = _path_node(shapes_graph, shape_name)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)
+    else:
+        assert parse_shacl_path(shapes_graph, node) == expected
+    assert set(shapes_graph) == before
+
+
+def test_error_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, _path_node(shapes_graph, "altOne"))
+    assert set(shapes_graph) == before
+
+
+def test_iri_path_node_returned_unchanged(shapes_graph: Graph) -> None:
+    result = parse_shacl_path(shapes_graph, _p("p2"))
+    assert result == _p("p2")
+    assert isinstance(result, URIRef)
+
+
+def test_rdf_nil_as_path_raises(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, RDF.nil)
+
+
+def test_literal_raises_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("x"))
+
+
+def test_error_is_not_value_error() -> None:
+    assert issubclass(SHACLPathError, Exception)
+    assert not issubclass(SHACLPathError, ValueError)
