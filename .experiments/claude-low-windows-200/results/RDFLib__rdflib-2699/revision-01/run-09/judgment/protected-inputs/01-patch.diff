+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import List, Optional, Set, Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    Path,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+def _list_items(shapes_graph: Graph, head: Node) -> List[Node]:
+    """
+    Walk an RDF list starting at ``head`` and return its items in order.
+
+    Raises :class:`SHACLPathError` if the list is malformed (missing
+    ``rdf:first``/``rdf:rest`` links or a cycle in ``rdf:rest``).
+    """
+    items: List[Node] = []
+    seen: Set[Node] = set()
+    node: Optional[Node] = head
+    while node != RDF.nil:
+        if node is None or node in seen:
+            raise SHACLPathError(f"Malformed RDF list at {head!r}")
+        seen.add(node)
+        first = shapes_graph.value(node, RDF.first)
+        rest = shapes_graph.value(node, RDF.rest)
+        if first is None or rest is None:
+            raise SHACLPathError(f"Malformed RDF list node {node!r}")
+        items.append(first)
+        node = rest
+    return items
+
+
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * a blank node that is an RDF list of at least two paths (sequence path);
+    * a blank node with ``sh:inversePath``;
+    * a blank node with ``sh:alternativePath`` whose RDF list holds at least
+      two paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath``.
+
+    The parser only reads from ``shapes_graph``; it never adds or removes
+    triples.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the object node of the ``sh:path`` triple. It must
+        not be a :class:`~rdflib.term.Literal`.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a Literal or not a node.
+    :raises SHACLPathError: if the path structure is malformed.
+
+    The implementation is based on pyshacl's SHACL-to-SPARQL path conversion.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}"
+        )
+    if not isinstance(path_identifier, Node):
+        raise TypeError(f"SHACL path must be a graph node: {path_identifier!r}")
+
+    # Simple path: an IRI. rdf:nil is an empty list and is never a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of at least two paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = _list_items(shapes_graph, path_identifier)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of at least two paths.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        items = _list_items(shapes_graph, alternative_value)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath: modifier paths.
+    modifier_predicates = (
+        (SH.zeroOrMorePath, ZeroOrMore),  # *
+        (SH.oneOrMorePath, OneOrMore),  # +
+        (SH.zeroOrOnePath, ZeroOrOne),  # ?
+    )
+    for predicate, modifier in modifier_predicates:
+        modifier_value = shapes_graph.value(path_identifier, predicate)
+        if modifier_value is not None:
+            return MulPath(parse_shacl_path(shapes_graph, modifier_value), modifier)
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
