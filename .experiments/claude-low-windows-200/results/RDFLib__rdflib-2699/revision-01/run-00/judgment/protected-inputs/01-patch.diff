+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,162 @@
+from typing import Any
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inv sh:path [ sh:inversePath ex:p ] .
+
+ex:alt3 sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlt sh:path [
+    sh:alternativePath (
+        [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+        ( ex:p3 ex:p4 )
+        [ sh:inversePath ex:p5 ]
+    )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:seqWithAltAndMod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:nilPath sh:path rdf:nil .
+
+ex:seqEmpty sh:path ( ) .
+
+ex:seqOne sh:path ( ex:p1 ) .
+
+ex:altEmpty sh:path [ sh:alternativePath ( ) ] .
+
+ex:altOne sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknown sh:path [ ex:notAPath ex:p ] .
+
+ex:literal sh:path "ex:p" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+VALID_CASES = [
+    pytest.param(EX.iri, EX.p, id="iri"),
+    pytest.param(
+        EX.seq3,
+        SequencePath(EX.p1, EX.p2, EX.p3),
+        id="sequence-three-items",
+    ),
+    pytest.param(
+        EX.nestedSeq,
+        SequencePath(EX.p1, SequencePath(EX.p2, EX.p3)),
+        id="nested-sequence",
+    ),
+    pytest.param(EX.inv, InvPath(EX.p), id="inverse"),
+    pytest.param(
+        EX.alt3,
+        AlternativePath(EX.p1, EX.p2, EX.p3),
+        id="alternative-three-items",
+    ),
+    pytest.param(
+        EX.nestedAlt,
+        AlternativePath(
+            AlternativePath(EX.p1, EX.p2),
+            SequencePath(EX.p3, EX.p4),
+            InvPath(EX.p5),
+        ),
+        id="nested-alternative",
+    ),
+    pytest.param(EX.zeroOrMore, MulPath(EX.p, ZeroOrMore), id="zero-or-more"),
+    pytest.param(EX.oneOrMore, MulPath(EX.p, OneOrMore), id="one-or-more"),
+    pytest.param(EX.zeroOrOne, MulPath(EX.p, ZeroOrOne), id="zero-or-one"),
+    pytest.param(
+        EX.modInv,
+        MulPath(InvPath(EX.p), ZeroOrMore),
+        id="modifier-wrapping-inverse",
+    ),
+    pytest.param(
+        EX.seqWithAltAndMod,
+        SequencePath(
+            AlternativePath(EX.p1, EX.p2),
+            MulPath(EX.p3, OneOrMore),
+        ),
+        id="sequence-with-alternative-and-modifier",
+    ),
+]
+
+INVALID_CASES = [
+    pytest.param(EX.nilPath, SHACLPathError, id="rdf-nil-as-path"),
+    pytest.param(EX.seqEmpty, SHACLPathError, id="empty-sequence"),
+    pytest.param(EX.seqOne, SHACLPathError, id="one-item-sequence"),
+    pytest.param(EX.altEmpty, SHACLPathError, id="empty-alternative"),
+    pytest.param(EX.altOne, SHACLPathError, id="one-item-alternative"),
+    pytest.param(EX.unknown, SHACLPathError, id="unrecognized-blank-node"),
+    pytest.param(EX.literal, TypeError, id="literal"),
+]
+
+
+@pytest.mark.parametrize("subject, expected", VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph, subject: URIRef, expected: Any
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(subject, SH.path)
+    assert parse_shacl_path(shapes_graph, node) == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("subject, exc", INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph, subject: URIRef, exc: type
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(subject, SH.path)
+    with pytest.raises(exc):
+        parse_shacl_path(shapes_graph, node)
+    assert set(shapes_graph) == before
+
+
+def test_literal_is_type_error_not_shacl_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError) as info:
+        parse_shacl_path(shapes_graph, Literal("x"))
+    assert not isinstance(info.value, SHACLPathError)
+
+
+def test_shacl_path_error_is_not_value_error() -> None:
+    assert issubclass(SHACLPathError, Exception)
+    assert not issubclass(SHACLPathError, ValueError)
