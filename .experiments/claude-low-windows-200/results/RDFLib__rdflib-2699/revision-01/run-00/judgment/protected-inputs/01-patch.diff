+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import List, Set, Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    Path,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+def _list_items(shapes_graph: Graph, head: Node) -> List[Node]:
+    """
+    Walk an RDF list starting at ``head`` and return its items in order.
+
+    Only read operations are used on ``shapes_graph``.
+
+    :raises SHACLPathError: if the list is malformed or cyclic.
+    """
+    items: List[Node] = []
+    seen: Set[Node] = set()
+    node = head
+    while node != RDF.nil:
+        if node in seen:
+            raise SHACLPathError(f"Cyclic RDF list encountered at {node!r}")
+        seen.add(node)
+        first = shapes_graph.value(node, RDF.first, any=True)
+        rest = shapes_graph.value(node, RDF.rest, any=True)
+        if first is None or rest is None:
+            raise SHACLPathError(f"Malformed RDF list node {node!r}")
+        items.append(first)
+        node = rest
+    return items
+
+
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """
+    Convert the value of a ``sh:path`` triple into a predicate or a Path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (a simple predicate path), other than ``rdf:nil``;
+    * an RDF list of two or more paths (a sequence path);
+    * a blank node with ``sh:inversePath`` (an inverse path);
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of two or more paths (an alternative path);
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` (a modifier path).
+
+    The implementation is based on pyshacl's SHACL-to-SPARQL path conversion.
+
+    :param shapes_graph: the graph holding the shapes. It is only read,
+        never modified.
+    :param path_identifier: the object node of a ``sh:path`` triple.
+    :returns: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`
+        or is not a node.
+    :raises SHACLPathError: if the path structure is malformed.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(
+            f"Literals are not valid SHACL paths: {path_identifier!r}"
+        )
+    if not isinstance(path_identifier, Node):
+        raise TypeError(f"SHACL path must be a node, not {path_identifier!r}")
+
+    # Simple path: an IRI, which must not be rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = _list_items(shapes_graph, path_identifier)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}"
+                f" in {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath.
+    if (path_identifier, SH.inversePath, None) in shapes_graph:
+        value = shapes_graph.value(path_identifier, SH.inversePath, any=True)
+        return InvPath(parse_shacl_path(shapes_graph, value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    if (path_identifier, SH.alternativePath, None) in shapes_graph:
+        head = shapes_graph.value(path_identifier, SH.alternativePath, any=True)
+        items = _list_items(shapes_graph, head)
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got {len(items)}"
+                f" in {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    for predicate, modifier in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        if (path_identifier, predicate, None) in shapes_graph:
+            value = shapes_graph.value(path_identifier, predicate, any=True)
+            return MulPath(parse_shacl_path(shapes_graph, value), modifier)
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
