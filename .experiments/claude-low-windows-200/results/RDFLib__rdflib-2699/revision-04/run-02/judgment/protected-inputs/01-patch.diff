@@ -0,0 +1,88 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib import paths
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value is not a valid SHACL path."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI (a simple predicate path), other than ``rdf:nil``;
+    * an RDF list of at least two valid paths (a sequence path);
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a simple predicate path,
+        or a :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is not valid.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list used as a sequence path
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    if (inner := shapes_graph.value(path_identifier, SH.inversePath)) is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inner))
+
+    # sh:alternativePath
+    if (alt := shapes_graph.value(path_identifier, SH.alternativePath)) is not None:
+        alt_items = list(shapes_graph.items(alt))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items: {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # sh:zeroOrMorePath
+    if (star := shapes_graph.value(path_identifier, SH.zeroOrMorePath)) is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, star), "*")
+
+    # sh:oneOrMorePath
+    if (plus := shapes_graph.value(path_identifier, SH.oneOrMorePath)) is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, plus), "+")
+
+    # sh:zeroOrOnePath
+    if (opt := shapes_graph.value(path_identifier, SH.zeroOrOnePath)) is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, opt), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..d3fba73
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p .
+ex:seq sh:path ( ex:a ex:b ex:c ) .
+ex:nestedSeq sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ex:c ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:a [ sh:alternativePath ( ex:b ex:c ) ] )
+] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:seqMix sh:path (
+    ex:a [ sh:alternativePath ( ex:b ex:c ) ] [ sh:zeroOrMorePath ex:d ]
+) .
+ex:openList sh:path _:l1 .
+_:l1 rdf:first ex:a ; rdf:rest _:l2 .
+_:l2 rdf:first ex:b .
+
+ex:nilPath sh:path rdf:nil .
+ex:oneSeq sh:path ( ex:a ) .
+ex:emptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown sh:path [ ex:other ex:a ] .
+ex:literal sh:path "x" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        (EX.iri, EX.p),
+        (EX.seq, EX.a / EX.b / EX.c),
+        (EX.nestedSeq, EX.a / (EX.b / EX.c)),
+        (EX.inv, ~EX.p),
+        (EX.alt, EX.a | EX.b | EX.c),
+        (EX.nestedAlt, EX.a | (EX.b | EX.c)),
+        (EX.star, EX.p * "*"),  # type: ignore[operator]
+        (EX.plus, EX.p * "+"),  # type: ignore[operator]
+        (EX.opt, EX.p * "?"),  # type: ignore[operator]
+        (EX.modInv, (~EX.p) * "*"),
+        (EX.seqMix, EX.a / (EX.b | EX.c) / (EX.d * "*")),  # type: ignore[operator]
+        (EX.openList, EX.a / EX.b),
+        (EX.nilPath, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_input", [None, "x"])
+def test_parse_shacl_path_non_node_raises_shacl_error(
+    shapes_graph: Graph, bad_input: Union[str, None]
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for name in ("iri", "seq", "alt", "nilPath", "literal", "unknown"):
+        path_node = shapes_graph.value(EX[name], SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
