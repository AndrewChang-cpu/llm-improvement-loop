+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,92 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not form a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two valid paths), ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, i.e. the object of a ``sh:path``
+        triple. It must be an IRI or a blank node; a :class:`~rdflib.term.Literal`
+        raises :class:`TypeError`.
+    :return: A :class:`~rdflib.term.URIRef` for a simple predicate path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    # Simple path: a predicate IRI. rdf:nil is an empty list, not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list (rdf:first link present).
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}"
+                f" in {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # Inverse path: sh:inversePath.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got {len(alt_items)}"
+                f" in {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..1084fc0
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,102 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import Namespace, SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p .
+ex:seq sh:path ( ex:p ex:q ex:r ) .
+ex:nestedSeq sh:path ( ex:p ( ex:q ex:r ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ( ex:p ex:q ) [ sh:inversePath ex:r ] ex:s )
+] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:seqMix sh:path (
+    [ sh:alternativePath ( ex:p ex:q ) ]
+    [ sh:oneOrMorePath ex:r ]
+    ex:s
+) .
+ex:noRest sh:path _:l1 .
+_:l1 rdf:first ex:p ; rdf:rest _:l2 .
+_:l2 rdf:first ex:q .
+
+ex:nil sh:path () .
+ex:seqOne sh:path ( ex:p ) .
+ex:altEmpty sh:path [ sh:alternativePath () ] .
+ex:altOne sh:path [ sh:alternativePath ( ex:p ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.simple, EX.p),
+        (EX.seq, EX.p / EX.q / EX.r),
+        (EX.nestedSeq, EX.p / (EX.q / EX.r)),
+        (EX.inverse, ~EX.p),
+        (EX.alt, EX.p | EX.q | EX.r),
+        (EX.nestedAlt, (EX.p / EX.q) | ~EX.r | EX.s),
+        (EX.star, EX.p * "*"),  # type: ignore[operator]
+        (EX.plus, EX.p * "+"),  # type: ignore[operator]
+        (EX.opt, EX.p * "?"),  # type: ignore[operator]
+        (EX.modInverse, (~EX.p) * "*"),
+        (EX.seqMix, (EX.p | EX.q) / (EX.r * "+") / EX.s),  # type: ignore[operator]
+        (EX.noRest, EX.p / EX.q),
+        (EX.nil, SHACLPathError),
+        (EX.seqOne, SHACLPathError),
+        (EX.altEmpty, SHACLPathError),
+        (EX.altOne, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path = shapes_graph.value(shape, SH.path)
+    before = set(shapes_graph)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "x"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: Optional[str]
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
