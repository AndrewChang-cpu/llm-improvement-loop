index 0000000..41c7666
--- /dev/null
+++ b/rdflib/extras/shacl.py
@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib import paths as paths_module
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not form a valid SHACL path."""
+
+
+# The implementation is based on pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two valid paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the graph holding the shapes. It is only read,
+        never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. It must be an IRI or a blank node.
+    :return: a :class:`~rdflib.term.URIRef` when the path is a plain
+        predicate, otherwise a :class:`~rdflib.paths.Path` instance.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list, identified by its rdf:first link.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return paths_module.SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # Inverse path: sh:inversePath.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return paths_module.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got "
+                f"{len(alt_items)}: {path_identifier!r}"
+            )
+        return paths_module.AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths_module.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths_module.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths_module.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..2117ffa
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,97 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.com/> .
+
+ex:simple sh:path ex:p .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:noRestSeq sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:inv sh:path [ sh:inversePath ex:p ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ex:p4 )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p ] .
+ex:modOfInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+ex:mixed sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+
+ex:nilPath sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    return Graph().parse(data=SHAPES_TTL, format="turtle")
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        (EX.simple, EX.p),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.noRestSeq, EX.p1 / EX.p2),
+        (EX.inv, ~EX.p),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAlt, EX.p1 | (EX.p2 | EX.p3) | EX.p4),
+        (EX.zeroOrMore, EX.p * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p * "?"),  # type: ignore[operator]
+        (EX.modOfInv, (~EX.p) * "*"),
+        (EX.mixed, EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+")),  # type: ignore[operator]
+        (EX.nilPath, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path = shapes_graph.value(resource, SH.path)
+    expects_error = isinstance(expected, type)
+    if expects_error:
+        with pytest.raises(expected):  # type: ignore[arg-type]
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes_graph, path) == expected  # type: ignore[arg-type]
+
+
+def test_parse_shacl_path_leaves_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in shapes_graph.subjects(SH.path, None):
+        path = shapes_graph.value(shape, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
