@@ -0,0 +1,90 @@
+"""This module contains utilities for working with SHACL shapes graphs."""
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil`` (a simple predicate path);
+    * an RDF list of at least two valid paths (a sequence path);
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two valid paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath``, or ``sh:zeroOrOnePath``.
+
+    This function only reads the graph and never modifies it.
+
+    :param shapes_graph: The graph holding the SHACL shapes. It is only read.
+    :param path_identifier: The node that is the value of ``sh:path``.
+    :return: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path structure is invalid or unrecognized.
+
+    The implementation is based on pyshacl's SHACL-to-SPARQL path conversion.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # Simple path: an IRI, which must not be rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # Inverse path: sh:inversePath.
+    if (inverse := shapes_graph.value(path_identifier, SH.inversePath)) is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    if (
+        alternatives := shapes_graph.value(path_identifier, SH.alternativePath)
+    ) is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    if (
+        zero_or_more := shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    ) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    if (
+        one_or_more := shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    ) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    if (
+        zero_or_one := shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    ) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..9d96c1b
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,97 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+from rdflib.term import Node
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:s_iri sh:path ex:p1 .
+ex:s_seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:s_nested_seq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:s_inv sh:path [ sh:inversePath ex:p1 ] .
+ex:s_alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:s_nested_alt sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:zeroOrMorePath ex:p1 ] )
+] .
+ex:s_mod_inv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:s_seq_alt_mod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:s_zero_or_one sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:s_one_or_more sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:s_dangling_list sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:s_nil sh:path () .
+ex:s_seq_one sh:path ( ex:p1 ) .
+ex:s_alt_empty sh:path [ sh:alternativePath () ] .
+ex:s_alt_one sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:s_unknown sh:path [ ex:foo ex:p1 ] .
+ex:s_literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.s_iri, EX.p1),
+        (EX.s_seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.s_nested_seq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.s_inv, ~EX.p1),
+        (EX.s_alt, EX.p1 | EX.p2 | EX.p3),
+        (
+            EX.s_nested_alt,
+            EX.p1 | (EX.p2 / EX.p3) | (EX.p1 * "*"),  # type: ignore[operator]
+        ),
+        (EX.s_mod_inv, (~EX.p1) * "*"),
+        (
+            EX.s_seq_alt_mod,
+            (EX.p1 | EX.p2) / (EX.p3 * "+"),  # type: ignore[operator]
+        ),
+        (EX.s_zero_or_one, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.s_one_or_more, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.s_dangling_list, EX.p1 / EX.p2),
+        (EX.s_nil, SHACLPathError),
+        (EX.s_seq_one, SHACLPathError),
+        (EX.s_alt_empty, SHACLPathError),
+        (EX.s_alt_one, SHACLPathError),
+        (EX.s_unknown, SHACLPathError),
+        (EX.s_literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path: Optional[Node] = shapes_graph.value(shape, SH.path)
+    triples_before = set(shapes_graph)
+    if isinstance(expected, type):
+        with pytest.raises(expected):  # type: ignore[arg-type]
+            parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == triples_before
