index 0000000..0f7a73b
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,118 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = "http://example.org/shapes#"
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:iri sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:inverseZeroOrMore sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sequenceMixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:missingRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:nilPath sh:path () .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "abc" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        (URIRef(EX + "iri"), URIRef(EX + "p1")),
+        (
+            URIRef(EX + "sequence"),
+            URIRef(EX + "p1") / URIRef(EX + "p2") / URIRef(EX + "p3"),
+        ),
+        (
+            URIRef(EX + "nestedSequence"),
+            URIRef(EX + "p1") / (URIRef(EX + "p2") / URIRef(EX + "p3")),
+        ),
+        (URIRef(EX + "inverse"), ~URIRef(EX + "p1")),
+        (
+            URIRef(EX + "alternative"),
+            URIRef(EX + "p1") | URIRef(EX + "p2") | URIRef(EX + "p3"),
+        ),
+        (URIRef(EX + "zeroOrMore"), URIRef(EX + "p1") * "*"),  # type: ignore[operator]
+        (URIRef(EX + "oneOrMore"), URIRef(EX + "p1") * "+"),  # type: ignore[operator]
+        (URIRef(EX + "zeroOrOne"), URIRef(EX + "p1") * "?"),  # type: ignore[operator]
+        (URIRef(EX + "inverseZeroOrMore"), ~URIRef(EX + "p1") * "*"),
+        (
+            URIRef(EX + "sequenceMixed"),
+            (URIRef(EX + "p1") | URIRef(EX + "p2"))
+            / (URIRef(EX + "p3") * "+"),  # type: ignore[operator]
+        ),
+        (URIRef(EX + "missingRest"), URIRef(EX + "p1") / URIRef(EX + "p2")),
+        (URIRef(EX + "nilPath"), SHACLPathError),
+        (URIRef(EX + "oneItemSequence"), SHACLPathError),
+        (URIRef(EX + "emptyAlternative"), SHACLPathError),
+        (URIRef(EX + "oneItemAlternative"), SHACLPathError),
+        (URIRef(EX + "unrecognized"), SHACLPathError),
+        (URIRef(EX + "literal"), TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+def test_non_node_inputs_raise_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "x")  # type: ignore[arg-type]
+
+
+def test_literal_raises_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("abc"))
+
+
+def test_shapes_graph_unchanged(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for resource in (URIRef(EX + "nilPath"), URIRef(EX + "sequence")):
+        path_node = shapes_graph.value(resource, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(shapes_graph) == before
