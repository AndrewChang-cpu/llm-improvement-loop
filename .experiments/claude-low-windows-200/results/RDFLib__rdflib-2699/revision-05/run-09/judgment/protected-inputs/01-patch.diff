index 0000000..bc04713
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,98 @@
+from __future__ import annotations
+
+from typing import Optional, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/shapes#")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/shapes#> .
+
+ex:simple sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqCombo sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath ex:p3 ]
+) .
+ex:tailless sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        (EX.simple, EX.p1),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.inverse, ~EX.p1),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAlt, EX.p1 | (EX.p2 / EX.p3) | ~EX.p4),
+        (EX.zeroOrMore, EX.p1 * "*"),  # type: ignore[operator]
+        (EX.oneOrMore, EX.p1 * "+"),  # type: ignore[operator]
+        (EX.zeroOrOne, EX.p1 * "?"),  # type: ignore[operator]
+        (EX.modInverse, (~EX.p1) * "*"),
+        (EX.seqCombo, (EX.p1 | EX.p2) / (EX.p3 * "*")),  # type: ignore[operator]
+        (EX.tailless, EX.p1 / EX.p2),
+        (EX.emptySeq, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes)
+    path = shapes.value(shape, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):  # type: ignore[arg-type]
+            parse_shacl_path(shapes, path)  # type: ignore[arg-type]
+    else:
+        assert parse_shacl_path(shapes, path) == expected  # type: ignore[arg-type]
+    assert set(shapes) == before
+
+
+@pytest.mark.parametrize("value", [None, "x"])
+def test_parse_shacl_path_non_node(shapes: Graph, value: Optional[str]) -> None:
+    before = set(shapes)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes, value)  # type: ignore[arg-type]
+    assert set(shapes) == before
