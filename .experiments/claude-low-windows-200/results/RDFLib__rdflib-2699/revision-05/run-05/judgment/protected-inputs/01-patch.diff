@@ -0,0 +1,96 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a SHACL shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into a predicate or a path.
+
+    A valid SHACL path is one of the following:
+
+    - an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    - an RDF list of at least two valid paths, which is a sequence path;
+    - a blank node with ``sh:inversePath`` whose value is a valid path;
+    - a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    - a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, i.e. the object of the ``sh:path``
+        triple.
+    :return: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or not recognized.
+
+    This implementation is based on the SHACL-to-SPARQL path conversion in
+    pyshacl.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # Simple path: an IRI, which must not be rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list with at least two items.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alt_items = list(shapes_graph.items(alternative_list))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got "
+                f"{len(alt_items)}: {path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..4eeda22
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,110 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:iri sh:path ex:p1 .
+
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:openSeq sh:path _:open1 .
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:inversePath ex:p2 ] ( ex:p3 ex:p4 ) )
+] .
+
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqMix sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:bar ] .
+ex:literal sh:path "x" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+one_or_more_p3 = EX.p3 * "+"  # type: ignore[operator]
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("iri", EX.p1),
+        ("seq", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSeq", EX.p1 / (EX.p2 / EX.p3)),
+        ("openSeq", EX.p1 / EX.p2),
+        ("inv", ~EX.p1),
+        ("alt", EX.p1 | EX.p2 | EX.p3),
+        ("nestedAlt", EX.p1 | ~EX.p2 | (EX.p3 / EX.p4)),
+        ("star", EX.p1 * "*"),  # type: ignore[operator]
+        ("plus", EX.p1 * "+"),  # type: ignore[operator]
+        ("opt", EX.p1 * "?"),  # type: ignore[operator]
+        ("modInv", ~EX.p1 * "*"),
+        ("seqMix", (EX.p1 | EX.p2) / one_or_more_p3),
+        ("emptySeq", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+        assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_node", [None, "x"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    bad_node: Union[str, None],
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == before
