@@ -0,0 +1,97 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+# The parsing approach is based on pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: The graph holding the shapes. It is only read,
+        never modified.
+    :param path_identifier: The node that is the value of ``sh:path``.
+    :return: A :class:`~rdflib.term.URIRef` when the path is a simple
+        predicate, otherwise a :class:`~rdflib.paths.Path` instance.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or not recognized.
+    """
+    # A literal is never a valid path; report it as a type error.
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths: %r" % (path_identifier,))
+
+    # A plain IRI is a simple path, except rdf:nil, which is an empty list.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # rdf:first: an RDF list used as a sequence path.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "A sequence path needs at least two items, got %d: %r"
+                % (len(items), path_identifier)
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of alternatives.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items, got %d: %r"
+                % (len(items), path_identifier)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..5308ca9
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,155 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ( ex:p4 ex:p5 ) )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:sequenceWithParts sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+
+ex:emptyList sh:path () .
+
+ex:oneItemSequence sh:path ( ex:p1 ) .
+
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknownBlankNode sh:path [ ex:other ex:p1 ] .
+
+ex:literalPath sh:path "not a path" .
+"""
+
+PATH_CASES = [
+    pytest.param(EX.simple, EX.p1, id="simple"),
+    pytest.param(EX.sequence, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+    pytest.param(
+        EX.nestedSequence,
+        EX.p1 / (EX.p2 / EX.p3),
+        id="nested-sequence",
+    ),
+    pytest.param(EX.openList, EX.p1 / EX.p2, id="open-list"),
+    pytest.param(EX.inverse, ~EX.p1, id="inverse"),
+    pytest.param(EX.alternative, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+    pytest.param(
+        EX.nestedAlternative,
+        EX.p1 | (EX.p2 | EX.p3) | (EX.p4 / EX.p5),
+        id="nested-alternative",
+    ),
+    pytest.param(
+        EX.zeroOrMore,
+        EX.p1 * "*",  # type: ignore[operator]
+        id="zero-or-more",
+    ),
+    pytest.param(
+        EX.oneOrMore,
+        EX.p1 * "+",  # type: ignore[operator]
+        id="one-or-more",
+    ),
+    pytest.param(
+        EX.zeroOrOne,
+        EX.p1 * "?",  # type: ignore[operator]
+        id="zero-or-one",
+    ),
+    pytest.param(
+        EX.modifiedInverse,
+        ~EX.p1 * "*",
+        id="modifier-of-inverse",
+    ),
+    pytest.param(
+        EX.sequenceWithParts,
+        EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+"),  # type: ignore[operator]
+        id="sequence-with-alternative-and-modifier",
+    ),
+    pytest.param(EX.emptyList, SHACLPathError, id="rdf-nil-as-path"),
+    pytest.param(EX.oneItemSequence, SHACLPathError, id="one-item-sequence"),
+    pytest.param(EX.emptyAlternative, SHACLPathError, id="empty-alternative"),
+    pytest.param(
+        EX.oneItemAlternative,
+        SHACLPathError,
+        id="one-item-alternative",
+    ),
+    pytest.param(EX.unknownBlankNode, SHACLPathError, id="unknown-blank-node"),
+    pytest.param(EX.literalPath, TypeError, id="literal"),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize("resource, expected", PATH_CASES)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):  # type: ignore[arg-type]
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("bad_node", ["x", None])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    bad_node: object,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_node)  # type: ignore[arg-type]
+
+
+def test_parse_leaves_shapes_graph_unchanged(shapes_graph: Graph) -> None:
+    triples_before = set(shapes_graph)
+    for resource in (EX.simple, EX.sequence, EX.inverse, EX.emptyList):
+        path_node = shapes_graph.value(resource, SH.path)
+        try:
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except SHACLPathError:
+            pass
+    assert set(shapes_graph) == triples_before
