@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a SHACL shapes graph is not a valid SHACL path."""
+
+
+# The parsing approach follows pyshacl's SHACL-to-SPARQL path conversion.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI (other than ``rdf:nil``), which is a
+    simple predicate, or a blank node that is an RDF list of at least two
+    paths (a sequence path), or that carries ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of at least two paths), or one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is invalid.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # simple path: an IRI, which must not be rdf:nil
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # sequence path: an RDF list
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # inverse path: sh:inversePath
+    if (inverse := shapes_graph.value(path_identifier, SH.inversePath)) is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # alternative path: sh:alternativePath, whose value is an RDF list
+    if (
+        alternatives := shapes_graph.value(path_identifier, SH.alternativePath)
+    ) is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got {len(alt_items)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alt_items]
+        )
+
+    # modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    if (
+        zero_or_more := shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    ) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+    if (
+        one_or_more := shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    ) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+    if (
+        zero_or_one := shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    ) is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
