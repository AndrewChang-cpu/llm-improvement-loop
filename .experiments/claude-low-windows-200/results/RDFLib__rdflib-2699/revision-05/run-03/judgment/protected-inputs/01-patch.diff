index 0000000..c686d0c
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import AlternativePath, Path
+
+EX = Namespace("http://example.org/")
+
+DATA = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlt sh:path [
+    sh:alternativePath (
+        [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+        ( ex:p3 ex:p4 )
+        [ sh:inversePath ex:p5 ]
+    )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:invMod sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:seqAltMod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:openList sh:path ( ex:p1 ex:p2 ) .
+
+ex:nilPath sh:path () .
+
+ex:oneItemSeq sh:path ( ex:p1 ) .
+
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknown sh:path [ ex:somethingElse ex:p1 ] .
+
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=DATA, format="turtle")
+    return g
+
+
+def _path(shapes_graph: Graph, shape: URIRef) -> Union[URIRef, Path]:
+    value = shapes_graph.value(shape, SH.path)
+    assert value is not None
+    return parse_shacl_path(shapes_graph, value)
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        ("simple", EX.p1),
+        ("seq", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSeq", EX.p1 / (EX.p2 / EX.p3)),
+        ("inv", ~EX.p1),
+        ("alt", EX.p1 | EX.p2 | EX.p3),
+        (
+            "nestedAlt",
+            AlternativePath(AlternativePath(EX.p1, EX.p2), EX.p3 / EX.p4, ~EX.p5),
+        ),
+        ("zeroOrMore", EX.p1 * "*"),  # type: ignore[operator]
+        ("oneOrMore", EX.p1 * "+"),  # type: ignore[operator]
+        ("zeroOrOne", EX.p1 * "?"),  # type: ignore[operator]
+        ("invMod", (~EX.p1) * "*"),
+        ("seqAltMod", (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+        ("openList", EX.p1 / EX.p2),
+    ],
+)
+def test_parse_shacl_path_valid(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path],
+) -> None:
+    shape = EX[shape_name]
+    assert _path(shapes_graph, shape) == expected
+
+
+@pytest.mark.parametrize(
+    "shape_name, exc_type",
+    [
+        ("nilPath", SHACLPathError),
+        ("oneItemSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneItemAlt", SHACLPathError),
+        ("unknown", SHACLPathError),
+        ("literal", TypeError),
+    ],
+)
+def test_parse_shacl_path_invalid(
+    shapes_graph: Graph,
+    shape_name: str,
+    exc_type: Type[Exception],
+) -> None:
+    value = shapes_graph.value(EX[shape_name], SH.path)
+    assert value is not None
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, value)
+
+
+@pytest.mark.parametrize("bad_input", ["x", None])
+def test_parse_shacl_path_non_node(
+    shapes_graph: Graph,
+    bad_input: str | None,
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)  # type: ignore[arg-type]
