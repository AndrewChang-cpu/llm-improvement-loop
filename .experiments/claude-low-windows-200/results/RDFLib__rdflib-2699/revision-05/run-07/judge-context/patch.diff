index 0000000..482af36
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,109 @@
+from __future__ import annotations
+
+from typing import Optional, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/> .
+
+ex:sIri sh:path ex:p1 .
+ex:sSeq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:sNestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:sSeqNoRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:sInv sh:path [ sh:inversePath ex:p1 ] .
+ex:sAlt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:sAltNested sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p1 ] )
+] .
+ex:sStar sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:sPlus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:sOpt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:sModInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sSeqMixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:sNil sh:path rdf:nil .
+ex:sEmptySeq sh:path ( ) .
+ex:sOneSeq sh:path ( ex:p1 ) .
+ex:sEmptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:sOneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:sUnknown sh:path [ ex:foo ex:bar ] .
+ex:sLiteral sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        ("sIri", EX.p1),
+        ("sSeq", EX.p1 / EX.p2 / EX.p3),
+        ("sNestedSeq", EX.p1 / (EX.p2 / EX.p3)),
+        ("sSeqNoRest", EX.p1 / EX.p2),
+        ("sInv", ~EX.p1),
+        ("sAlt", EX.p1 | EX.p2 | EX.p3),
+        ("sAltNested", EX.p1 | (EX.p2 / EX.p3) | ~EX.p1),
+        ("sStar", EX.p1 * "*"),  # type: ignore[operator]
+        ("sPlus", EX.p1 * "+"),  # type: ignore[operator]
+        ("sOpt", EX.p1 * "?"),  # type: ignore[operator]
+        ("sModInv", (~EX.p1) * "*"),
+        ("sSeqMixed", (EX.p1 | EX.p2) / (EX.p3 * "+")),  # type: ignore[operator]
+        ("sNil", SHACLPathError),
+        ("sEmptySeq", SHACLPathError),
+        ("sOneSeq", SHACLPathError),
+        ("sEmptyAlt", SHACLPathError),
+        ("sOneAlt", SHACLPathError),
+        ("sUnknown", SHACLPathError),
+        ("sLiteral", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(EX[shape], SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        assert result == expected
+
+
+@pytest.mark.parametrize("node", [None, "x"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    node: Optional[str],
+) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, node)  # type: ignore[arg-type]
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape in ("sIri", "sSeq", "sInv", "sNil", "sUnknown", "sLiteral"):
+        try:
+            path_node = shapes_graph.value(EX[shape], SH.path)
+            parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+        except (SHACLPathError, TypeError):
+            pass
+    assert set(shapes_graph) == before
