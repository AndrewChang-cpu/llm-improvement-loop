@@ -0,0 +1,98 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    The graph is only read, never modified.
+
+    Based on the SHACL-to-SPARQL path conversion in pyshacl.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+    :param path_identifier: the node that is the object of a ``sh:path``
+        triple; it is passed as a :class:`~rdflib.term.Node`.
+    :return: a :class:`~rdflib.term.URIRef` for a simple predicate path, or a
+        :class:`~rdflib.paths.Path` instance for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is not valid SHACL.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # simple path: an IRI
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # sequence path: an RDF list
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # inverse path: sh:inversePath
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # alternative path: sh:alternativePath
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got {len(alt_items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..1c4d1eb
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,133 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seq3 sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:seqNested sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt3 sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:altNested sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:seqMixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:listNoRest sh:path ( ex:p1 ex:p2 ) .
+
+ex:nilPath sh:path () .
+
+ex:seqOne sh:path ( ex:p1 ) .
+
+ex:altEmpty sh:path [ sh:alternativePath () ] .
+
+ex:altOne sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknownBNode sh:path [ ex:notAPath ex:p1 ] .
+
+ex:literalPath sh:path "not a path" .
+"""
+
+VALID_CASES: list[tuple[URIRef, Union[URIRef, Path]]] = [
+    (EX.simple, EX.p1),
+    (EX.seq3, EX.p1 / EX.p2 / EX.p3),
+    (EX.seqNested, EX.p1 / (EX.p2 / EX.p3)),
+    (EX.inverse, ~EX.p1),
+    (EX.alt3, EX.p1 | EX.p2 | EX.p3),
+    (EX.altNested, EX.p1 | (EX.p2 | EX.p3)),
+    (EX.zeroOrMore, EX.p1 * "*"),
+    (EX.oneOrMore, EX.p1 * "+"),
+    (EX.zeroOrOne, EX.p1 * "?"),
+    (EX.modInverse, (~EX.p1) * "*"),
+    (EX.seqMixed, (EX.p1 | EX.p2) / (EX.p3 * "+")),
+    (EX.listNoRest, EX.p1 / EX.p2),
+]
+
+INVALID_CASES: list[tuple[URIRef, type[Exception]]] = [
+    (EX.nilPath, SHACLPathError),
+    (EX.seqOne, SHACLPathError),
+    (EX.altEmpty, SHACLPathError),
+    (EX.altOne, SHACLPathError),
+    (EX.unknownBNode, SHACLPathError),
+    (EX.literalPath, TypeError),
+]
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    VALID_CASES,
+)
+def test_valid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    expected: Union[URIRef, Path],
+) -> None:
+    node = shapes_graph.value(shape, SH.path)
+    assert node is not None
+    assert parse_shacl_path(shapes_graph, node) == expected
+
+
+@pytest.mark.parametrize(
+    "shape, exc_type",
+    INVALID_CASES,
+)
+def test_invalid_shacl_path(
+    shapes_graph: Graph,
+    shape: URIRef,
+    exc_type: type[Exception],
+) -> None:
+    node = shapes_graph.value(shape, SH.path)
+    assert node is not None
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, node)
+
+
+def test_parse_does_not_modify_graph(shapes_graph: Graph) -> None:
+    before = set(shapes_graph)
+    for shape, _ in VALID_CASES:
+        node = shapes_graph.value(shape, SH.path)
+        assert node is not None
+        parse_shacl_path(shapes_graph, node)
+    for shape, exc_type in INVALID_CASES:
+        node = shapes_graph.value(shape, SH.path)
+        assert node is not None
+        with pytest.raises(exc_type):
+            parse_shacl_path(shapes_graph, node)
+    assert set(shapes_graph) == before
