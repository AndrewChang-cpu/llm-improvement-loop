@@ -0,0 +1,99 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an rdflib predicate or path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: The :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: The path node, i.e. the object of a ``sh:path``
+        triple. It may be a :class:`~rdflib.term.URIRef`, a blank node, or a
+        :class:`~rdflib.term.Literal` (which is rejected).
+    :return: A :class:`~rdflib.term.URIRef` when the path is a simple predicate,
+        otherwise a :class:`~rdflib.paths.Path` instance.
+    :raises TypeError: If ``path_identifier`` is a Literal.
+    :raises SHACLPathError: If the path is malformed or not recognized.
+
+    The implementation is based on the SHACL-to-SPARQL path conversion in
+    pyshacl.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # Simple path: an IRI that is not rdf:nil
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items, got {len(items)}"
+                f" in {path_identifier!r}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:inversePath
+    if (path_identifier, SH.inversePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.inversePath)
+        return InvPath(parse_shacl_path(shapes_graph, inner))
+
+    # sh:alternativePath
+    if (path_identifier, SH.alternativePath, None) in shapes_graph:
+        head = shapes_graph.value(path_identifier, SH.alternativePath)
+        items = list(shapes_graph.items(head))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items, got {len(items)}"
+                f" in {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath
+    if (path_identifier, SH.zeroOrMorePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+        return MulPath(parse_shacl_path(shapes_graph, inner), "*")
+    if (path_identifier, SH.oneOrMorePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+        return MulPath(parse_shacl_path(shapes_graph, inner), "+")
+    if (path_identifier, SH.zeroOrOnePath, None) in shapes_graph:
+        inner = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+        return MulPath(parse_shacl_path(shapes_graph, inner), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
