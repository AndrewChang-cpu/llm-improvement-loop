index 0000000..ffbe5cf
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,108 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath (
+        [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+        ( ex:p3 ex:p4 )
+        ex:p5
+    )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqWithAltAndMod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrOnePath ex:p3 ]
+) .
+ex:truncatedList sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+ex:nilPath sh:path () .
+ex:emptySeq sh:path [ sh:alternativePath () ] .
+ex:oneItemSeq sh:path ( ex:p1 ) .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownBlank sh:path [ ex:other ex:p1 ] .
+ex:literalPath sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TURTLE, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        pytest.param(EX.iri, EX.p1, id="iri"),
+        pytest.param(EX.seq, EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            EX.nestedSeq,
+            EX.p1 / (EX.p2 / EX.p3),
+            id="nested-sequence",
+        ),
+        pytest.param(EX.inverse, ~EX.p1, id="inverse"),
+        pytest.param(EX.alt, EX.p1 | EX.p2 | EX.p3, id="alternative"),
+        pytest.param(
+            EX.nestedAlt,
+            (EX.p1 | EX.p2) | (EX.p3 / EX.p4) | EX.p5,
+            id="nested-alternative",
+        ),
+        pytest.param(EX.zeroOrMore, EX.p1 * "*", id="zero-or-more"),
+        pytest.param(EX.oneOrMore, EX.p1 * "+", id="one-or-more"),
+        pytest.param(EX.zeroOrOne, EX.p1 * "?", id="zero-or-one"),
+        pytest.param(EX.modInverse, (~EX.p1) * "*", id="modifier-of-inverse"),
+        pytest.param(
+            EX.seqWithAltAndMod,
+            (EX.p1 | EX.p2) / (EX.p3 * "?"),
+            id="sequence-with-alternative-and-modifier",
+        ),
+        pytest.param(
+            EX.truncatedList,
+            EX.p1 / EX.p2,
+            id="list-without-rdf-rest",
+        ),
+        pytest.param(EX.nilPath, SHACLPathError, id="rdf-nil-path"),
+        pytest.param(EX.oneItemSeq, SHACLPathError, id="one-item-sequence"),
+        pytest.param(EX.emptySeq, SHACLPathError, id="empty-alternative"),
+        pytest.param(EX.oneItemAlt, SHACLPathError, id="one-item-alternative"),
+        pytest.param(EX.unknownBlank, SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param(EX.literalPath, TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
