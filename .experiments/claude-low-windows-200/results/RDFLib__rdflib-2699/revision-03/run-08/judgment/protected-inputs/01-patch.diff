index 0000000..3f4376d
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,127 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Literal, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TURTLE = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlternative sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        ( ex:p4 ex:p5 )
+    )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:sequenceMixed sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:noRestList sh:path _:last1 .
+_:last1 rdf:first ex:p1 ; rdf:rest _:last2 .
+_:last2 rdf:first ex:p2 .
+
+ex:nilPath sh:path rdf:nil .
+
+ex:emptySequence sh:path () .
+
+ex:oneItemSequence sh:path ( ex:p1 ) .
+
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unrecognized sh:path [ ex:foo ex:bar ] .
+
+ex:literalPath sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        ("simple", EX.p1),
+        ("sequence", EX.p1 / EX.p2 / EX.p3),
+        ("nestedSequence", EX.p1 / (EX.p2 / EX.p3)),
+        ("inverse", ~EX.p1),
+        ("alternative", EX.p1 | EX.p2 | EX.p3),
+        ("nestedAlternative", EX.p1 | (EX.p2 | EX.p3) | (EX.p4 / EX.p5)),
+        ("zeroOrMore", EX.p1 * "*"),
+        ("oneOrMore", EX.p1 * "+"),
+        ("zeroOrOne", EX.p1 * "?"),
+        ("modifiedInverse", (~EX.p1) * "*"),
+        ("sequenceMixed", (EX.p1 | EX.p2) / (EX.p3 * "+")),
+        ("noRestList", EX.p1 / EX.p2),
+        ("nilPath", SHACLPathError),
+        ("emptySequence", SHACLPathError),
+        ("oneItemSequence", SHACLPathError),
+        ("emptyAlternative", SHACLPathError),
+        ("oneItemAlternative", SHACLPathError),
+        ("unrecognized", SHACLPathError),
+        ("literalPath", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    shape = EX[shape_name]
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    triples_before = set(shapes_graph)
+
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+
+    assert set(shapes_graph) == triples_before
+
+
+def test_non_node_input_raises_shacl_path_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, "x")  # type: ignore[arg-type]
+
+
+def test_literal_is_type_error(shapes_graph: Graph) -> None:
+    with pytest.raises(TypeError):
+        parse_shacl_path(shapes_graph, Literal("x"))
