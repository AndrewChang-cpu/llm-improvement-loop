@@ -0,0 +1,96 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a SHACL shapes graph is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> URIRef | Path:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list with at least two items, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list with at least two items), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a simple predicate path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or not recognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # Simple path: an IRI, but not rdf:nil, which denotes an empty list.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError(
+                "rdf:nil is not a valid SHACL path; it denotes an empty list"
+            )
+        return path_identifier
+
+    # Sequence path: an RDF list of at least two paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, found {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # Inverse path: sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternatives = list(shapes_graph.items(alternative_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items, found "
+                f"{len(alternatives)}: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternatives]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath -> "*"
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # Modifier paths: sh:oneOrMorePath -> "+"
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # Modifier paths: sh:zeroOrOnePath -> "?"
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..4398587
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,111 @@
+from __future__ import annotations
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.com/> .
+
+ex:iriShape sh:path ex:p .
+
+ex:sequenceShape sh:path ( ex:p ex:q ex:r ) .
+
+ex:nestedSequenceShape sh:path ( ex:p ( ex:q ex:r ) ) .
+
+ex:inverseShape sh:path [ sh:inversePath ex:p ] .
+
+ex:alternativeShape sh:path [ sh:alternativePath ( ex:p ex:q ex:r ) ] .
+
+ex:nestedAlternativeShape sh:path [
+    sh:alternativePath ( ex:p ( ex:q ex:r ) [ sh:inversePath ex:s ] )
+] .
+
+ex:zeroOrMoreShape sh:path [ sh:zeroOrMorePath ex:p ] .
+
+ex:oneOrMoreShape sh:path [ sh:oneOrMorePath ex:p ] .
+
+ex:zeroOrOneShape sh:path [ sh:zeroOrOnePath ex:p ] .
+
+ex:modifiedInverseShape sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p ] ] .
+
+ex:combinedSequenceShape sh:path (
+    ex:p
+    [ sh:alternativePath ( ex:q ex:r ) ]
+    [ sh:oneOrMorePath ex:s ]
+) .
+
+ex:openListShape sh:path [ rdf:first ex:p ; rdf:rest [ rdf:first ex:q ] ] .
+
+ex:emptyListShape sh:path () .
+
+ex:rdfNilShape sh:path rdf:nil .
+
+ex:oneItemSequenceShape sh:path ( ex:p ) .
+
+ex:emptyAlternativeShape sh:path [ sh:alternativePath () ] .
+
+ex:oneItemAlternativeShape sh:path [ sh:alternativePath ( ex:p ) ] .
+
+ex:unrecognizedShape sh:path [ ex:foo ex:bar ] .
+
+ex:literalShape sh:path "x" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        (EX.iriShape, EX.p),
+        (EX.sequenceShape, EX.p / EX.q / EX.r),
+        (EX.nestedSequenceShape, EX.p / (EX.q / EX.r)),
+        (EX.inverseShape, ~EX.p),
+        (EX.alternativeShape, EX.p | EX.q | EX.r),
+        (EX.nestedAlternativeShape, EX.p | (EX.q / EX.r) | ~EX.s),
+        (EX.zeroOrMoreShape, EX.p * "*"),
+        (EX.oneOrMoreShape, EX.p * "+"),
+        (EX.zeroOrOneShape, EX.p * "?"),
+        (EX.modifiedInverseShape, (~EX.p) * "*"),
+        (EX.combinedSequenceShape, EX.p / (EX.q | EX.r) / (EX.s * "+")),
+        (EX.openListShape, EX.p / EX.q),
+        (EX.emptyListShape, SHACLPathError),
+        (EX.rdfNilShape, SHACLPathError),
+        (EX.oneItemSequenceShape, SHACLPathError),
+        (EX.emptyAlternativeShape, SHACLPathError),
+        (EX.oneItemAlternativeShape, SHACLPathError),
+        (EX.unrecognizedShape, SHACLPathError),
+        (EX.literalShape, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: URIRef | Path | type[Exception],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    assert path_node is not None
+    triples_before = set(shapes_graph)
+
+    if isinstance(expected, type) and issubclass(expected, BaseException):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)
+        assert isinstance(result, (URIRef, Path))
+        assert result == expected
+
+    assert set(shapes_graph) == triples_before
