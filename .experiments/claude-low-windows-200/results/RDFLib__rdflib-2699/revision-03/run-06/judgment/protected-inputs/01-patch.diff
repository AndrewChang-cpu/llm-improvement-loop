@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node does not describe a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is either an IRI (other than ``rdf:nil``), which is a
+    simple predicate, or a blank node that is an RDF list of at least two
+    paths (a sequence), or that carries one of the SHACL path predicates
+    ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of at least two
+    paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the graph holding the shapes; it is only read.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the node is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # simple path: an IRI, which must not be rdf:nil
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # sequence path: an RDF list
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                f"Sequence path {path_identifier} must have at least two items, "
+                f"found {len(sequence_items)}"
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath: an RDF list of at least two paths
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path {path_identifier} must have at least two items, "
+                f"found {len(alternative_items)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..a6825e7
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,122 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) [ sh:inversePath ex:p4 ] )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sequenceOfCombined sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath ex:p3 ]
+) .
+ex:unterminatedList sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+ex:emptyList sh:path () .
+ex:singleItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+ex:singleItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    [
+        pytest.param("simple", EX.p1, id="simple"),
+        pytest.param("sequence", EX.p1 / EX.p2 / EX.p3, id="sequence"),
+        pytest.param(
+            "nestedSequence",
+            EX.p1 / (EX.p2 / EX.p3),
+            id="nested-sequence",
+        ),
+        pytest.param("inverse", ~EX.p1, id="inverse"),
+        pytest.param(
+            "alternative",
+            EX.p1 | EX.p2 | EX.p3,
+            id="alternative",
+        ),
+        pytest.param(
+            "nestedAlternative",
+            EX.p1 | (EX.p2 / EX.p3) | ~EX.p4,
+            id="nested-alternative",
+        ),
+        pytest.param("zeroOrMore", EX.p1 * "*", id="zero-or-more"),
+        pytest.param("oneOrMore", EX.p1 * "+", id="one-or-more"),
+        pytest.param("zeroOrOne", EX.p1 * "?", id="zero-or-one"),
+        pytest.param(
+            "modifiedInverse",
+            (~EX.p1) * "*",
+            id="modified-inverse",
+        ),
+        pytest.param(
+            "sequenceOfCombined",
+            (EX.p1 | EX.p2) / (EX.p3 * "*"),
+            id="sequence-of-combined",
+        ),
+        pytest.param(
+            "unterminatedList",
+            EX.p1 / EX.p2,
+            id="list-without-final-rest",
+        ),
+        pytest.param("emptyList", SHACLPathError, id="empty-list-rdf-nil"),
+        pytest.param("singleItemSequence", SHACLPathError, id="single-item-sequence"),
+        pytest.param("emptyAlternative", SHACLPathError, id="empty-alternative"),
+        pytest.param(
+            "singleItemAlternative",
+            SHACLPathError,
+            id="single-item-alternative",
+        ),
+        pytest.param("unrecognized", SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literal", TypeError, id="literal"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape_name: str,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    shape = EX[shape_name]
+    path_node = shapes_graph.value(shape, SH.path)
+    assert path_node is not None
+    before = set(shapes_graph)
+
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+
+    assert set(shapes_graph) == before
