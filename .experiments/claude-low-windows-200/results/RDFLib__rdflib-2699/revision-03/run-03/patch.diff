@@ -0,0 +1,98 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from functools import reduce
+from typing import Union
+
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import Path
+from rdflib.term import Literal, Node, URIRef
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+# The parsing procedure follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into a predicate usable with rdflib.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of ``sh:path``.
+        It must be a :class:`~rdflib.term.URIRef` or a blank node.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # Simple path: an IRI, which may not be rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path (rdf:first): an RDF list of at least two paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}"
+                f" in {path_identifier!r}"
+            )
+        parts = [parse_shacl_path(shapes_graph, item) for item in items]
+        return reduce(lambda left, right: left / right, parts)
+
+    # Inverse path (sh:inversePath).
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return ~parse_shacl_path(shapes_graph, inverse_value)
+
+    # Alternative path (sh:alternativePath): an RDF list of at least two paths.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        items = list(shapes_graph.items(alternative_value))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got {len(items)}"
+                f" in {path_identifier!r}"
+            )
+        parts = [parse_shacl_path(shapes_graph, item) for item in items]
+        return reduce(lambda left, right: left | right, parts)
+
+    # Modifier paths (sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath).
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return parse_shacl_path(shapes_graph, zero_or_more_value) * "*"
+
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return parse_shacl_path(shapes_graph, one_or_more_value) * "+"
+
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return parse_shacl_path(shapes_graph, zero_or_one_value) * "?"
+
+    raise SHACLPathError(f"Unrecognized SHACL path: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..c7ce40d
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,107 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH, Namespace
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlternative sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ex:p4 )
+] .
+ex:alternativeWithSequence sh:path [
+    sh:alternativePath ( ( ex:p1 ex:p2 ) ex:p3 ex:p4 )
+] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:sequenceMix sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+ex:noRest sh:path _:c1 .
+_:c1 rdf:first ex:p1 ; rdf:rest _:c2 .
+_:c2 rdf:first ex:p2 .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySequence sh:path ( ) .
+ex:oneItemSequence sh:path ( ex:p1 ) .
+ex:emptyAlternative sh:path [ sh:alternativePath ( ) ] .
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unrecognized sh:path [ ex:other ex:p1 ] .
+ex:literalPath sh:path "x" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        (EX.simple, EX.p1),
+        (EX.sequence, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSequence, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.inverse, ~EX.p1),
+        (EX.alternative, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAlternative, EX.p1 | (EX.p2 | EX.p3) | EX.p4),
+        (EX.alternativeWithSequence, (EX.p1 / EX.p2) | EX.p3 | EX.p4),
+        (EX.zeroOrMore, EX.p1 * "*"),
+        (EX.oneOrMore, EX.p1 * "+"),
+        (EX.zeroOrOne, EX.p1 * "?"),
+        (EX.modifiedInverse, (~EX.p1) * "*"),
+        (EX.sequenceMix, (EX.p1 | EX.p2) / (EX.p3 * "+")),
+        (EX.noRest, EX.p1 / EX.p2),
+        (EX.nilPath, SHACLPathError),
+        (EX.emptySequence, SHACLPathError),
+        (EX.oneItemSequence, SHACLPathError),
+        (EX.emptyAlternative, SHACLPathError),
+        (EX.oneItemAlternative, SHACLPathError),
+        (EX.unrecognized, SHACLPathError),
+        (EX.literalPath, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    triples_before = set(shapes_graph)
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+    assert set(shapes_graph) == triples_before
+
+
+@pytest.mark.parametrize("path_node", ["x", None])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph,
+    path_node: object,
+) -> None:
+    triples_before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, path_node)  # type: ignore[arg-type]
+    assert set(shapes_graph) == triples_before
