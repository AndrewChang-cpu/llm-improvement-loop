@@ -0,0 +1,104 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    Path,
+    SequencePath,
+)
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph,
+    path_identifier: Node,
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` pointing to a valid path;
+    * a blank node with ``sh:alternativePath`` pointing to an RDF list of
+      at least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath`` pointing to a valid path.
+
+    :param shapes_graph: The graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The node that is the value of ``sh:path``.
+    :returns: A :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths: %r" % (path_identifier,))
+
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list (rdf:first / rdf:rest chain).
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        sequence_items = list(shapes_graph.items(path_identifier))
+        if len(sequence_items) < 2:
+            raise SHACLPathError(
+                "A sequence path needs at least two items, got %d in %r"
+                % (len(sequence_items), path_identifier)
+            )
+        return SequencePath(
+            *[parse_shacl_path(shapes_graph, item) for item in sequence_items]
+        )
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        alternative_items = list(shapes_graph.items(alternative_list))
+        if len(alternative_items) < 2:
+            raise SHACLPathError(
+                "An alternative path needs at least two items, got %d in %r"
+                % (len(alternative_items), path_identifier)
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alternative_items]
+        )
+
+    # sh:zeroOrMorePath
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError("Unrecognized SHACL path node: %r" % (path_identifier,))
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..685efc8
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,112 @@
+from __future__ import annotations
+
+from typing import Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import Path
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TURTLE = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+@prefix ex: <http://example.org/shapes#> .
+
+ex:iri sh:path ex:p1 .
+
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlt sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ( ex:p3 ex:p4 ) ) ]
+        [ sh:inversePath ex:p5 ]
+    )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:seqMixed sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+
+ex:noRest sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+
+ex:nilPath sh:path () .
+
+ex:oneSeq sh:path ( ex:p1 ) .
+
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:unknown sh:path [ ex:foo ex:bar ] .
+
+ex:literal sh:path "x" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TURTLE, format="turtle")
+    return graph
+
+
+@pytest.mark.parametrize(
+    "resource, expected",
+    [
+        (EX.iri, EX.p1),
+        (EX.seq, EX.p1 / EX.p2 / EX.p3),
+        (EX.nestedSeq, EX.p1 / (EX.p2 / EX.p3)),
+        (EX.inv, ~EX.p1),
+        (EX.alt, EX.p1 | EX.p2 | EX.p3),
+        (EX.nestedAlt, EX.p1 | (EX.p2 | (EX.p3 / EX.p4)) | ~EX.p5),
+        (EX.zeroOrMore, EX.p1 * "*"),
+        (EX.oneOrMore, EX.p1 * "+"),
+        (EX.zeroOrOne, EX.p1 * "?"),
+        (EX.modInv, (~EX.p1) * "*"),
+        (EX.seqMixed, EX.p1 / (EX.p2 | EX.p3) / (EX.p4 * "+")),
+        (EX.noRest, EX.p1 / EX.p2),
+        (EX.nilPath, SHACLPathError),
+        (EX.oneSeq, SHACLPathError),
+        (EX.emptyAlt, SHACLPathError),
+        (EX.oneAlt, SHACLPathError),
+        (EX.unknown, SHACLPathError),
+        (EX.literal, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    resource: URIRef,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    path_node = shapes_graph.value(resource, SH.path)
+    assert path_node is not None
+    triple_count = len(shapes_graph)
+
+    if isinstance(expected, type):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+
+    assert len(shapes_graph) == triple_count
