@@ -0,0 +1,97 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """
+    Parse the object of a ``sh:path`` triple into an RDFLib predicate or Path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list of two or more valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` whose value is a valid path;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of two or more valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` whose value is a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple. Literals are not valid paths.
+    :return: a :class:`~rdflib.term.URIRef` when the path is a plain
+        predicate, otherwise a :class:`~rdflib.paths.Path` instance.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            f"Not a node, so not a valid SHACL path: {path_identifier!r}"
+        )
+
+    # Simple path: an IRI, except rdf:nil which denotes an empty list.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list of at least two paths.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        items = list(shapes_graph.items(alternative_list))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..52ee892
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+from typing import Any, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+
+EX = Namespace("http://example.com/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:seqThree sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:seqNested sh:path ( ( ex:p1 ex:p2 ) ex:p3 ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:altThree sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:altNested sh:path [
+    sh:alternativePath ( ( ex:p1 ex:p2 ) [ sh:inversePath ex:p3 ] ex:p4 )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modInverse sh:path [ sh:oneOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:seqWithAltMod sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:zeroOrMorePath ex:p3 ]
+) .
+
+ex:openList sh:path _:openHead .
+_:openHead rdf:first ex:p1 ; rdf:rest _:openTail .
+_:openTail rdf:first ex:p2 .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownBlank sh:path [ ex:notAPath ex:p1 ] .
+ex:literalPath sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        # Valid shapes: the parsed result must equal the expected path.
+        ("simple", EX.p1),
+        ("seqThree", SequencePath(EX.p1, EX.p2, EX.p3)),
+        ("seqNested", SequencePath(SequencePath(EX.p1, EX.p2), EX.p3)),
+        ("inverse", InvPath(EX.p1)),
+        ("altThree", AlternativePath(EX.p1, EX.p2, EX.p3)),
+        (
+            "altNested",
+            AlternativePath(SequencePath(EX.p1, EX.p2), InvPath(EX.p3), EX.p4),
+        ),
+        ("zeroOrMore", MulPath(EX.p1, "*")),
+        ("oneOrMore", MulPath(EX.p1, "+")),
+        ("zeroOrOne", MulPath(EX.p1, "?")),
+        ("modInverse", MulPath(InvPath(EX.p1), "+")),
+        (
+            "seqWithAltMod",
+            SequencePath(AlternativePath(EX.p1, EX.p2), MulPath(EX.p3, "*")),
+        ),
+        ("openList", SequencePath(EX.p1, EX.p2)),
+        # Invalid shapes: the expected exception type must be raised.
+        ("nilPath", SHACLPathError),
+        ("emptySeq", SHACLPathError),
+        ("oneSeq", SHACLPathError),
+        ("emptyAlt", SHACLPathError),
+        ("oneAlt", SHACLPathError),
+        ("unknownBlank", SHACLPathError),
+        ("literalPath", TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    shape: str,
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    node = shapes_graph.value(EX[shape], SH.path)
+    assert node is not None
+
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)
+    else:
+        assert parse_shacl_path(shapes_graph, node) == expected
+
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.com/p1"])
+def test_non_node_input_raises_shacl_path_error(
+    shapes_graph: Graph, bad_input: Any
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)
+    assert set(shapes_graph) == before
