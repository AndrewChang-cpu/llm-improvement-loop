index 0000000..546a6bb
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,119 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from rdflib import Graph, Namespace
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, SequencePath
+
+EX = Namespace("http://example.org/shapes#")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iriPath sh:path ex:p1 .
+ex:seqPath sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeqPath sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:invPath sh:path [ sh:inversePath ex:p1 ] .
+ex:altPath sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAltPath sh:path [
+    sh:alternativePath (
+        ex:p1
+        [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+        ( ex:p1 ex:p2 )
+    )
+] .
+ex:starPath sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plusPath sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:optPath sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:invStarPath sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:mixedSeqPath sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeqPath sh:path () .
+ex:oneItemSeqPath sh:path ( ex:p1 ) .
+ex:emptyAltPath sh:path [ sh:alternativePath () ] .
+ex:oneItemAltPath sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownBNodePath sh:path [ ex:unrelated ex:p1 ] .
+ex:literalPath sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+VALID_CASES: list[tuple[str, Any]] = [
+    ("iriPath", EX.p1),
+    ("seqPath", SequencePath(EX.p1, EX.p2, EX.p3)),
+    ("nestedSeqPath", SequencePath(EX.p1, SequencePath(EX.p2, EX.p3))),
+    ("invPath", InvPath(EX.p1)),
+    ("altPath", AlternativePath(EX.p1, EX.p2, EX.p3)),
+    (
+        "nestedAltPath",
+        AlternativePath(
+            EX.p1,
+            AlternativePath(EX.p2, EX.p3),
+            SequencePath(EX.p1, EX.p2),
+        ),
+    ),
+    ("starPath", MulPath(EX.p1, "*")),
+    ("plusPath", MulPath(EX.p1, "+")),
+    ("optPath", MulPath(EX.p1, "?")),
+    ("invStarPath", MulPath(InvPath(EX.p1), "*")),
+    (
+        "mixedSeqPath",
+        SequencePath(
+            AlternativePath(EX.p1, EX.p2),
+            MulPath(EX.p3, "+"),
+        ),
+    ),
+]
+
+INVALID_CASES: list[tuple[str, type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("emptySeqPath", SHACLPathError),
+    ("oneItemSeqPath", SHACLPathError),
+    ("emptyAltPath", SHACLPathError),
+    ("oneItemAltPath", SHACLPathError),
+    ("unknownBNodePath", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.mark.parametrize(
+    "shape_name, expected",
+    VALID_CASES + INVALID_CASES,
+    ids=[name for name, _ in VALID_CASES + INVALID_CASES],
+)
+def test_parse_shacl_path(shapes_graph: Graph, shape_name: str, expected: Any) -> None:
+    before = set(shapes_graph)
+    path_node = shapes_graph.value(EX[shape_name], SH.path)
+    assert path_node is not None
+
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/shapes#p1"])
+def test_parse_shacl_path_non_node_input(shapes_graph: Graph, bad_input: Any) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)
+    assert set(shapes_graph) == before
