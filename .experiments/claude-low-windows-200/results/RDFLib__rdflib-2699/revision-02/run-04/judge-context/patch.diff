@@ -0,0 +1,94 @@
+"""Utilities for working with SHACL shapes graphs."""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure is malformed or unusable."""
+
+
+# The approach follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(shapes_graph: Graph, path_identifier: Node) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into a predicate or Path.
+
+    A valid SHACL path is either an IRI that is not ``rdf:nil`` (a simple
+    path), or a blank node that is an RDF list of at least two paths
+    (a sequence path), or a blank node carrying one of the SHACL path
+    predicates ``sh:inversePath``, ``sh:alternativePath`` (an RDF list of
+    at least two paths), ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+    ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of the ``sh:path``
+        triple. Passing a :class:`~rdflib.term.Literal` raises ``TypeError``.
+    :return: a :class:`~rdflib.term.URIRef` when the path is a plain predicate,
+        otherwise a :class:`~rdflib.paths.Path` instance.
+    :raises SHACLPathError: if the path structure is malformed or unusable.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    # Simple path: a plain predicate IRI.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Anything that is not a node (e.g. None or a plain string) cannot carry
+    # any of the structures below; reject it before any graph lookup.
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(
+            f"{path_identifier!r} is not a node and is not a valid SHACL path"
+        )
+
+    # Sequence path: the node is the head of an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"sequence path {path_identifier!r} must have at least two items, "
+                f"found {len(items)}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # Inverse path: sh:inversePath.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternative_list = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_list is not None:
+        items = list(shapes_graph.items(alternative_list))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"alternative path {path_identifier!r} must have at least two items, "
+                f"found {len(items)}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in items]
+        )
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"unrecognized SHACL path node {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
