@@ -0,0 +1,95 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value does not form a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI other than ``rdf:nil``, which is a simple predicate path;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list of at least two valid paths), or one of ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath`` pointing at a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the value of ``sh:path``. It
+        must be a :class:`~rdflib.term.URIRef` or a blank node.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a
+        :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is malformed or is not a node.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a valid SHACL path node: {path_identifier!r}")
+
+    # Simple path: an IRI predicate.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Sequence path: an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        items = list(shapes_graph.items(alternative_value))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..ae14127
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,135 @@
+from __future__ import annotations
+
+from typing import Any, Callable, Type, Union
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] ( ex:p1 ex:p2 ) )
+] .
+ex:star sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:combined sh:path (
+    ex:p1 [ sh:alternativePath ( ex:p2 [ sh:oneOrMorePath ex:p3 ] ) ]
+) .
+
+_:open1 rdf:first ex:p1 ; rdf:rest _:open2 .
+_:open2 rdf:first ex:p2 .
+ex:openList sh:path _:open1 .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path ( ) .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath ( ) ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:p1 ] .
+ex:literal sh:path "p1" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    graph = Graph()
+    graph.parse(data=SHAPES_TTL, format="turtle")
+    return graph
+
+
+def _shape_path(name: str) -> Callable[[Graph], Any]:
+    def getter(graph: Graph) -> Any:
+        return graph.value(EX[name], SH.path)
+
+    return getter
+
+
+def _raw(value: Any) -> Callable[[Graph], Any]:
+    def getter(graph: Graph) -> Any:
+        return value
+
+    return getter
+
+
+P1, P2, P3 = EX.p1, EX.p2, EX.p3
+
+
+@pytest.mark.parametrize(
+    "path_getter, expected",
+    [
+        pytest.param(_shape_path("iri"), P1, id="iri"),
+        pytest.param(_shape_path("seq"), SequencePath(P1, P2, P3), id="sequence"),
+        pytest.param(
+            _shape_path("nestedSeq"),
+            SequencePath(P1, SequencePath(P2, P3)),
+            id="nested-sequence",
+        ),
+        pytest.param(_shape_path("inv"), InvPath(P1), id="inverse"),
+        pytest.param(
+            _shape_path("alt"), AlternativePath(P1, P2, P3), id="alternative"
+        ),
+        pytest.param(
+            _shape_path("nestedAlt"),
+            AlternativePath(P1, AlternativePath(P2, P3), SequencePath(P1, P2)),
+            id="nested-alternative",
+        ),
+        pytest.param(_shape_path("star"), MulPath(P1, "*"), id="zero-or-more"),
+        pytest.param(_shape_path("plus"), MulPath(P1, "+"), id="one-or-more"),
+        pytest.param(_shape_path("opt"), MulPath(P1, "?"), id="zero-or-one"),
+        pytest.param(
+            _shape_path("modInv"),
+            MulPath(InvPath(P1), "*"),
+            id="modifier-of-inverse",
+        ),
+        pytest.param(
+            _shape_path("combined"),
+            SequencePath(P1, AlternativePath(P2, MulPath(P3, "+"))),
+            id="sequence-with-alternative-and-modifier",
+        ),
+        pytest.param(
+            _shape_path("openList"),
+            SequencePath(P1, P2),
+            id="list-without-final-rest",
+        ),
+        pytest.param(_shape_path("nilPath"), SHACLPathError, id="nil-path"),
+        pytest.param(_shape_path("emptySeq"), SHACLPathError, id="empty-sequence"),
+        pytest.param(_shape_path("oneSeq"), SHACLPathError, id="one-item-sequence"),
+        pytest.param(_shape_path("emptyAlt"), SHACLPathError, id="empty-alternative"),
+        pytest.param(_shape_path("oneAlt"), SHACLPathError, id="one-item-alternative"),
+        pytest.param(
+            _shape_path("unknown"), SHACLPathError, id="unrecognized-blank-node"
+        ),
+        pytest.param(_shape_path("literal"), TypeError, id="literal"),
+        pytest.param(_raw(None), SHACLPathError, id="none"),
+        pytest.param(_raw("p1"), SHACLPathError, id="plain-string"),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    path_getter: Callable[[Graph], Any],
+    expected: Union[URIRef, Path, Type[Exception]],
+) -> None:
+    before = set(shapes_graph)
+    node = path_getter(shapes_graph)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, node)
+    else:
+        assert parse_shacl_path(shapes_graph, node) == expected
+    assert set(shapes_graph) == before
