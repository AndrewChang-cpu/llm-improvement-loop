+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure in a shapes graph is malformed."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an rdflib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is returned unchanged;
+    * an RDF list of at least two valid paths, which is a sequence path;
+    * a blank node with ``sh:inversePath`` pointing to a valid path;
+    * a blank node with ``sh:alternativePath`` pointing to an RDF list of at
+      least two valid paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or
+      ``sh:zeroOrOnePath`` pointing to a valid path.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the value of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is malformed or unrecognized.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a valid SHACL path node: {path_identifier!r}")
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # RDF list used as a sequence path
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # sh:inversePath
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # sh:alternativePath
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alternatives = list(shapes_graph.items(alternative_value))
+        if len(alternatives) < 2:
+            raise SHACLPathError(
+                "Alternative path must have at least two items: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in alternatives]
+        )
+
+    # sh:zeroOrMorePath -> "*"
+    zero_or_more_value = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more_value), "*")
+
+    # sh:oneOrMorePath -> "+"
+    one_or_more_value = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more_value), "+")
+
+    # sh:zeroOrOnePath -> "?"
+    zero_or_one_value = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one_value is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one_value), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..0491575
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,106 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from rdflib import Graph, Namespace
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, SequencePath
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p .
+ex:nilPath sh:path rdf:nil .
+ex:literalPath sh:path "not a path" .
+ex:unknownPath sh:path [ ex:other ex:p ] .
+
+ex:seq3 sh:path ( ex:a ex:b ex:c ) .
+ex:seqNested sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:seqOpenEnd sh:path [ rdf:first ex:a ; rdf:rest [ rdf:first ex:b ] ] .
+ex:seqEmpty sh:path rdf:nil .
+ex:seqOne sh:path ( ex:a ) .
+
+ex:inv sh:path [ sh:inversePath ex:a ] .
+ex:alt3 sh:path [ sh:alternativePath ( ex:a ex:b ex:c ) ] .
+ex:altNested sh:path [
+    sh:alternativePath ( ( ex:a ex:b ) [ sh:inversePath ex:c ] ex:d )
+] .
+ex:altEmpty sh:path [ sh:alternativePath rdf:nil ] .
+ex:altOne sh:path [ sh:alternativePath ( ex:a ) ] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:a ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:a ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:a ] .
+
+ex:modInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ] .
+ex:seqMixed sh:path ( [ sh:alternativePath ( ex:a ex:b ) ] [ sh:oneOrMorePath ex:c ] ) .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _path_of(graph: Graph, name: str) -> Any:
+    return graph.value(EX[name], SH.path)
+
+
+@pytest.mark.parametrize(
+    "name, expected",
+    [
+        # valid
+        ("simple", EX.p),
+        ("seq3", SequencePath(EX.a, EX.b, EX.c)),
+        ("seqNested", SequencePath(EX.a, SequencePath(EX.b, EX.c))),
+        ("seqOpenEnd", SequencePath(EX.a, EX.b)),
+        ("inv", InvPath(EX.a)),
+        ("alt3", AlternativePath(EX.a, EX.b, EX.c)),
+        (
+            "altNested",
+            AlternativePath(
+                SequencePath(EX.a, EX.b),
+                InvPath(EX.c),
+                EX.d,
+            ),
+        ),
+        ("zeroOrMore", MulPath(EX.a, "*")),
+        ("oneOrMore", MulPath(EX.a, "+")),
+        ("zeroOrOne", MulPath(EX.a, "?")),
+        ("modInverse", MulPath(InvPath(EX.a), "*")),
+        (
+            "seqMixed",
+            SequencePath(
+                AlternativePath(EX.a, EX.b),
+                MulPath(EX.c, "+"),
+            ),
+        ),
+        # invalid
+        ("nilPath", SHACLPathError),
+        ("seqEmpty", SHACLPathError),
+        ("seqOne", SHACLPathError),
+        ("altEmpty", SHACLPathError),
+        ("altOne", SHACLPathError),
+        ("unknownPath", SHACLPathError),
+        ("literalPath", TypeError),
+    ],
+)
+def test_parse_shacl_path(shapes_graph: Graph, name: str, expected: Any) -> None:
+    before = set(shapes_graph)
+    path_node = _path_of(shapes_graph, name)
+    if isinstance(expected, type) and issubclass(expected, Exception):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        result = parse_shacl_path(shapes_graph, path_node)
+        assert result == expected
+    assert set(shapes_graph) == before
