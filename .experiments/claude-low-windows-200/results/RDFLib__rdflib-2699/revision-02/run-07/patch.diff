+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a node in a shapes graph is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of the following:
+
+    * an IRI (other than ``rdf:nil``), which is a simple predicate path;
+    * an RDF list with at least two items, which is a sequence path;
+    * a blank node with ``sh:inversePath``, ``sh:alternativePath`` (an RDF
+      list with at least two items), ``sh:zeroOrMorePath``,
+      ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``.
+
+    Nested values are parsed recursively with the same rules.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the node that is the object of ``sh:path``.
+    :return: a :class:`~rdflib.term.URIRef` for a simple path, or a
+        :class:`~rdflib.paths.Path` for a complex path.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path structure is not valid SHACL.
+    """
+    # Literals are never valid paths.
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # Simple path: an IRI that is not rdf:nil.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Anything that is not a node matches none of the forms below.
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a valid SHACL path node: {path_identifier!r}")
+
+    # Sequence path: an RDF list.
+    if (path_identifier, RDF.first, None) in shapes_graph:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path needs at least two items, got {len(items)}: "
+                f"{path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path: sh:inversePath.
+    inverse_value = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse_value is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse_value))
+
+    # Alternative path: sh:alternativePath, whose value is an RDF list.
+    alternative_value = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternative_value is not None:
+        alt_items = list(shapes_graph.items(alternative_value))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path needs at least two items, got {len(alt_items)}: "
+                f"{path_identifier!r}"
+            )
+        return AlternativePath(*[parse_shacl_path(shapes_graph, i) for i in alt_items])
+
+    # Modifier paths: sh:zeroOrMorePath, sh:oneOrMorePath, sh:zeroOrOnePath.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..a710e5a
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,116 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from rdflib import Graph, Namespace, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, SequencePath
+
+EX = Namespace("http://example.org/")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:iri sh:path ex:p1 .
+ex:seq sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] )
+] .
+ex:zom sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oom sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zoo sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqWithAlt sh:path (
+    ex:p1 [ sh:alternativePath ( ex:p2 ex:p3 ) ] [ sh:oneOrMorePath ex:p1 ]
+) .
+ex:openList sh:path [ rdf:first ex:p1 ; rdf:rest [ rdf:first ex:p2 ] ] .
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path ( ) .
+ex:oneSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath rdf:nil ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknown sh:path [ ex:foo ex:p1 ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _path_node(g: Graph, shape: str) -> Any:
+    return g.value(EX[shape], SH.path)
+
+
+VALID_CASES = [
+    ("iri", URIRef(EX.p1)),
+    ("seq", SequencePath(EX.p1, EX.p2, EX.p3)),
+    ("nestedSeq", SequencePath(EX.p1, SequencePath(EX.p2, EX.p3))),
+    ("inv", InvPath(EX.p1)),
+    ("alt", AlternativePath(EX.p1, EX.p2, EX.p3)),
+    ("nestedAlt", AlternativePath(EX.p1, AlternativePath(EX.p2, EX.p3))),
+    ("zom", MulPath(EX.p1, "*")),
+    ("oom", MulPath(EX.p1, "+")),
+    ("zoo", MulPath(EX.p1, "?")),
+    ("modInv", MulPath(InvPath(EX.p1), "*")),
+    (
+        "seqWithAlt",
+        SequencePath(
+            EX.p1,
+            AlternativePath(EX.p2, EX.p3),
+            MulPath(EX.p1, "+"),
+        ),
+    ),
+    ("openList", SequencePath(EX.p1, EX.p2)),
+]
+
+INVALID_CASES = [
+    ("nilPath", SHACLPathError),
+    ("emptySeq", SHACLPathError),
+    ("oneSeq", SHACLPathError),
+    ("emptyAlt", SHACLPathError),
+    ("oneAlt", SHACLPathError),
+    ("unknown", SHACLPathError),
+    ("literal", TypeError),
+]
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    VALID_CASES,
+)
+def test_valid_shacl_paths(shapes_graph: Graph, shape: str, expected: Any) -> None:
+    before = set(shapes_graph)
+    result = parse_shacl_path(shapes_graph, _path_node(shapes_graph, shape))
+    assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize(
+    "shape, exc_type",
+    INVALID_CASES,
+)
+def test_invalid_shacl_paths(
+    shapes_graph: Graph, shape: str, exc_type: type[Exception]
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, _path_node(shapes_graph, shape))
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "http://example.org/p1"])
+def test_non_node_input_raises_shacl_error(shapes_graph: Graph, bad_input: Any) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)
