@@ -0,0 +1,93 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef
+from rdflib.namespace import RDF, SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a SHACL path structure cannot be parsed."""
+
+
+# The implementation is based on the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, Path]:
+    """Parse the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is either an IRI (other than ``rdf:nil``), which is a
+    simple predicate, or a blank node that is an RDF list of at least two
+    paths (a sequence), or that carries ``sh:inversePath``,
+    ``sh:alternativePath`` (an RDF list of at least two paths), or one of
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: The Graph holding the shapes. It is only read, never
+        modified.
+    :param path_identifier: The path node, i.e. the object of a ``sh:path``
+        triple.
+    :return: A :class:`~rdflib.term.URIRef` when the path is a plain
+        predicate, otherwise a :class:`~rdflib.paths.Path` instance.
+    :raises TypeError: If ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: If the path structure is malformed or unrecognized.
+    """
+    # Literals are never valid paths.
+    if isinstance(path_identifier, Literal):
+        raise TypeError("Literals are not valid SHACL paths")
+
+    # Simple path: a predicate IRI.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Anything that is not a node (e.g. None or a str) matches no form below.
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Not a valid SHACL path node: {path_identifier!r}")
+
+    # Sequence path: an RDF list.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"Sequence path must have at least two items: {path_identifier!r}"
+            )
+        return SequencePath(*[parse_shacl_path(shapes_graph, item) for item in items])
+
+    # Inverse path.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: an RDF list of at least two paths.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        alt_items = list(shapes_graph.items(alternatives))
+        if len(alt_items) < 2:
+            raise SHACLPathError(
+                f"Alternative path must have at least two items: {path_identifier!r}"
+            )
+        return AlternativePath(
+            *[parse_shacl_path(shapes_graph, item) for item in alt_items]
+        )
+
+    # Modifier paths: zero or more, one or more, zero or one.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..913d823
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,122 @@
+from __future__ import annotations
+
+from typing import Any
+
+import pytest
+
+from rdflib import Graph, Namespace
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, SequencePath
+
+EX = Namespace("http://example.com/shapes#")
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+ex:seqPath sh:path ( ex:p1 ex:p2 ex:p3 ) .
+ex:nestedSeq sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+ex:inv sh:path [ sh:inversePath ex:p1 ] .
+ex:alt sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+ex:nestedAlt sh:path [ sh:alternativePath ( ex:p1 ( ex:p2 ex:p3 ) ) ] .
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+ex:modInv sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+ex:seqWithAltMod sh:path (
+    ex:p1
+    [ sh:alternativePath ( ex:p2 ex:p3 ) ]
+    [ sh:oneOrMorePath ex:p4 ]
+) .
+ex:rdfNil sh:path rdf:nil .
+ex:emptySeq sh:path rdf:nil .
+ex:oneItemSeq sh:path ( ex:p1 ) .
+ex:emptyAlt sh:path [ sh:alternativePath rdf:nil ] .
+ex:oneItemAlt sh:path [ sh:alternativePath ( ex:p1 ) ] .
+ex:unknownBlank sh:path [ ex:unrelated ex:p1 ] .
+ex:literalPath sh:path "not a path" .
+ex:seqNilItem sh:path ( ex:p1 rdf:nil ) .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _path_of(g: Graph, shape: str) -> Any:
+    return g.value(EX[shape], SH.path)
+
+
+@pytest.mark.parametrize(
+    "shape, expected",
+    [
+        pytest.param("simple", EX.p1, id="iri"),
+        pytest.param("seqPath", SequencePath(EX.p1, EX.p2, EX.p3), id="sequence"),
+        pytest.param(
+            "nestedSeq",
+            SequencePath(EX.p1, SequencePath(EX.p2, EX.p3)),
+            id="nested-sequence",
+        ),
+        pytest.param("inv", InvPath(EX.p1), id="inverse"),
+        pytest.param("alt", AlternativePath(EX.p1, EX.p2, EX.p3), id="alternative"),
+        pytest.param(
+            "nestedAlt",
+            AlternativePath(EX.p1, SequencePath(EX.p2, EX.p3)),
+            id="nested-alternative",
+        ),
+        pytest.param("zeroOrMore", MulPath(EX.p1, "*"), id="zero-or-more"),
+        pytest.param("oneOrMore", MulPath(EX.p1, "+"), id="one-or-more"),
+        pytest.param("zeroOrOne", MulPath(EX.p1, "?"), id="zero-or-one"),
+        pytest.param(
+            "modInv",
+            MulPath(InvPath(EX.p1), "*"),
+            id="modifier-of-inverse",
+        ),
+        pytest.param(
+            "seqWithAltMod",
+            SequencePath(
+                EX.p1,
+                AlternativePath(EX.p2, EX.p3),
+                MulPath(EX.p4, "+"),
+            ),
+            id="sequence-with-alternative-and-modifier",
+        ),
+        pytest.param("rdfNil", SHACLPathError, id="rdf-nil-path"),
+        pytest.param("emptySeq", SHACLPathError, id="empty-sequence"),
+        pytest.param("oneItemSeq", SHACLPathError, id="one-item-sequence"),
+        pytest.param("emptyAlt", SHACLPathError, id="empty-alternative"),
+        pytest.param("oneItemAlt", SHACLPathError, id="one-item-alternative"),
+        pytest.param("unknownBlank", SHACLPathError, id="unrecognized-blank-node"),
+        pytest.param("literalPath", TypeError, id="literal"),
+        pytest.param("seqNilItem", SHACLPathError, id="rdf-nil-as-sequence-item"),
+    ],
+)
+def test_parse_shacl_path(shapes_graph: Graph, shape: str, expected: Any) -> None:
+    before = set(shapes_graph)
+    path_node = _path_of(shapes_graph, shape)
+    if isinstance(expected, type) and issubclass(expected, BaseException):
+        with pytest.raises(expected):
+            parse_shacl_path(shapes_graph, path_node)
+    else:
+        assert parse_shacl_path(shapes_graph, path_node) == expected
+    assert set(shapes_graph) == before
+
+
+def test_non_node_inputs_raise_shacl_error(shapes_graph: Graph) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, None)  # type: ignore[arg-type]
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(
+            shapes_graph, "http://example.com/shapes#p1"  # type: ignore[arg-type]
+        )
+
+
+def test_shacl_path_error_is_not_value_error() -> None:
+    assert issubclass(SHACLPathError, Exception)
+    assert not issubclass(SHACLPathError, ValueError)
