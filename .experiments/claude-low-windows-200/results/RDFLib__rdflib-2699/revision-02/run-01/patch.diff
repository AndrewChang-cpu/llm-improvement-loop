@@ -0,0 +1,96 @@
+"""
+This module contains utilities for working with SHACL shapes graphs.
+"""
+
+from __future__ import annotations
+
+from typing import Union
+
+from rdflib import Graph, Literal, URIRef, paths
+from rdflib.namespace import RDF, SH
+from rdflib.term import Node
+
+
+class SHACLPathError(Exception):
+    """Raised when a value in a SHACL shapes graph is not a valid SHACL path."""
+
+
+# The implementation follows the SHACL-to-SPARQL path conversion in pyshacl.
+def parse_shacl_path(
+    shapes_graph: Graph, path_identifier: Node
+) -> Union[URIRef, paths.Path]:
+    """
+    Convert the object of a ``sh:path`` triple into an RDFLib path.
+
+    A valid SHACL path is one of:
+
+    * an IRI (other than ``rdf:nil``), which is a plain predicate;
+    * an RDF list of two or more paths, which is a sequence path;
+    * a blank node with ``sh:inversePath``;
+    * a blank node with ``sh:alternativePath`` whose value is an RDF list
+      of two or more paths;
+    * a blank node with ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, or
+      ``sh:zeroOrOnePath``.
+
+    :param shapes_graph: the :class:`~rdflib.graph.Graph` holding the shapes.
+        It is only read, never modified.
+    :param path_identifier: the path node, i.e. the object of a ``sh:path``
+        triple.
+    :returns: a :class:`~rdflib.term.URIRef` when the path is a plain
+        predicate, otherwise a :class:`~rdflib.paths.Path`.
+    :raises TypeError: if ``path_identifier`` is a :class:`~rdflib.term.Literal`.
+    :raises SHACLPathError: if the path is not a valid SHACL path.
+    """
+    if isinstance(path_identifier, Literal):
+        raise TypeError(f"Literals are not valid SHACL paths: {path_identifier!r}")
+
+    # A simple path is an IRI; rdf:nil is an empty list and is not a path.
+    if isinstance(path_identifier, URIRef):
+        if path_identifier == RDF.nil:
+            raise SHACLPathError("rdf:nil is not a valid SHACL path")
+        return path_identifier
+
+    # Only nodes can carry path structure; anything else is unrecognized.
+    if not isinstance(path_identifier, Node):
+        raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
+
+    # Sequence path: an RDF list of paths.
+    if shapes_graph.value(path_identifier, RDF.first) is not None:
+        items = list(shapes_graph.items(path_identifier))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"A sequence path needs at least two items: {path_identifier!r}"
+            )
+        return paths.SequencePath(*[parse_shacl_path(shapes_graph, i) for i in items])
+
+    # Inverse path.
+    inverse = shapes_graph.value(path_identifier, SH.inversePath)
+    if inverse is not None:
+        return paths.InvPath(parse_shacl_path(shapes_graph, inverse))
+
+    # Alternative path: an RDF list of paths.
+    alternatives = shapes_graph.value(path_identifier, SH.alternativePath)
+    if alternatives is not None:
+        items = list(shapes_graph.items(alternatives))
+        if len(items) < 2:
+            raise SHACLPathError(
+                f"An alternative path needs at least two items: {path_identifier!r}"
+            )
+        return paths.AlternativePath(
+            *[parse_shacl_path(shapes_graph, i) for i in items]
+        )
+
+    # Modifier paths: zero or more, one or more, zero or one.
+    zero_or_more = shapes_graph.value(path_identifier, SH.zeroOrMorePath)
+    if zero_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_more), "*")
+
+    one_or_more = shapes_graph.value(path_identifier, SH.oneOrMorePath)
+    if one_or_more is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, one_or_more), "+")
+
+    zero_or_one = shapes_graph.value(path_identifier, SH.zeroOrOnePath)
+    if zero_or_one is not None:
+        return paths.MulPath(parse_shacl_path(shapes_graph, zero_or_one), "?")
+
+    raise SHACLPathError(f"Unrecognized SHACL path node: {path_identifier!r}")
diff --git a/test/test_extras/test_shacl_extras.py b/test/test_extras/test_shacl_extras.py
new file mode 100644
index 0000000..02cfed6
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,143 @@
+from __future__ import annotations
+
+from typing import Any, Type, Union
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, Path, SequencePath
+
+EX = "http://example.com/"
+
+SHAPES_TTL = """
+@prefix ex: <http://example.com/> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:p1 .
+
+ex:sequence sh:path ( ex:p1 ex:p2 ex:p3 ) .
+
+ex:nestedSequence sh:path ( ex:p1 ( ex:p2 ex:p3 ) ) .
+
+ex:inverse sh:path [ sh:inversePath ex:p1 ] .
+
+ex:alternative sh:path [ sh:alternativePath ( ex:p1 ex:p2 ex:p3 ) ] .
+
+ex:nestedAlternative sh:path [
+    sh:alternativePath (
+        ( ex:p1 ex:p2 )
+        [ sh:inversePath ex:p3 ]
+        [ sh:zeroOrMorePath ex:p4 ]
+    )
+] .
+
+ex:zeroOrMore sh:path [ sh:zeroOrMorePath ex:p1 ] .
+
+ex:oneOrMore sh:path [ sh:oneOrMorePath ex:p1 ] .
+
+ex:zeroOrOne sh:path [ sh:zeroOrOnePath ex:p1 ] .
+
+ex:modifiedInverse sh:path [ sh:zeroOrMorePath [ sh:inversePath ex:p1 ] ] .
+
+ex:sequenceWithParts sh:path (
+    [ sh:alternativePath ( ex:p1 ex:p2 ) ]
+    [ sh:oneOrMorePath ex:p3 ]
+) .
+
+ex:missingRest sh:path [
+    rdf:first ex:p1 ;
+    rdf:rest [ rdf:first ex:p2 ]
+] .
+
+ex:nilPath sh:path rdf:nil .
+
+ex:oneItemSequence sh:path ( ex:p1 ) .
+
+ex:emptySequence sh:path () .
+
+ex:oneItemAlternative sh:path [ sh:alternativePath ( ex:p1 ) ] .
+
+ex:emptyAlternative sh:path [ sh:alternativePath () ] .
+
+ex:unrecognized sh:path [ ex:unknown ex:p1 ] .
+
+ex:literalPath sh:path "not a path" .
+"""
+
+P1 = URIRef(EX + "p1")
+P2 = URIRef(EX + "p2")
+P3 = URIRef(EX + "p3")
+P4 = URIRef(EX + "p4")
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _shape_path(graph: Graph, name: str) -> Any:
+    return graph.value(URIRef(EX + name), SH.path)
+
+
+VALID_CASES: list[tuple[str, Union[URIRef, Path]]] = [
+    ("simple", P1),
+    ("sequence", SequencePath(P1, P2, P3)),
+    ("nestedSequence", SequencePath(P1, SequencePath(P2, P3))),
+    ("inverse", InvPath(P1)),
+    ("alternative", AlternativePath(P1, P2, P3)),
+    (
+        "nestedAlternative",
+        AlternativePath(
+            SequencePath(P1, P2),
+            InvPath(P3),
+            MulPath(P4, "*"),
+        ),
+    ),
+    ("zeroOrMore", MulPath(P1, "*")),
+    ("oneOrMore", MulPath(P1, "+")),
+    ("zeroOrOne", MulPath(P1, "?")),
+    ("modifiedInverse", MulPath(InvPath(P1), "*")),
+    ("sequenceWithParts", SequencePath(AlternativePath(P1, P2), MulPath(P3, "+"))),
+    ("missingRest", SequencePath(P1, P2)),
+]
+
+INVALID_CASES: list[tuple[str, Type[Exception]]] = [
+    ("nilPath", SHACLPathError),
+    ("emptySequence", SHACLPathError),
+    ("oneItemSequence", SHACLPathError),
+    ("emptyAlternative", SHACLPathError),
+    ("oneItemAlternative", SHACLPathError),
+    ("unrecognized", SHACLPathError),
+    ("literalPath", TypeError),
+]
+
+
+@pytest.mark.parametrize("name, expected", VALID_CASES)
+def test_parse_valid_shacl_path(
+    shapes_graph: Graph, name: str, expected: Union[URIRef, Path]
+) -> None:
+    before = set(shapes_graph)
+    result = parse_shacl_path(shapes_graph, _shape_path(shapes_graph, name))
+    assert result == expected
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("name, exc_type", INVALID_CASES)
+def test_parse_invalid_shacl_path(
+    shapes_graph: Graph, name: str, exc_type: Type[Exception]
+) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(exc_type):
+        parse_shacl_path(shapes_graph, _shape_path(shapes_graph, name))
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad_input", [None, "p1"])
+def test_non_node_input_raises_shacl_error(shapes_graph: Graph, bad_input: Any) -> None:
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad_input)
