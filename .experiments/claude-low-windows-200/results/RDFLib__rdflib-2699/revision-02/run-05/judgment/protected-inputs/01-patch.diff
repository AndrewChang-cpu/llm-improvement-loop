index 0000000..ecd171a
--- /dev/null
+++ b/test/test_extras/test_shacl_extras.py
@@ -0,0 +1,124 @@
+from __future__ import annotations
+
+from typing import Any, Type
+
+import pytest
+
+from rdflib import Graph, URIRef
+from rdflib.extras.shacl import SHACLPathError, parse_shacl_path
+from rdflib.namespace import SH
+from rdflib.paths import AlternativePath, InvPath, MulPath, SequencePath
+
+EX = "http://example.org/shapes#"
+
+SHAPES_TTL = """
+@prefix ex: <http://example.org/shapes#> .
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+
+ex:simple sh:path ex:name .
+ex:seq sh:path ( ex:a ex:b ex:c ) .
+ex:nestedSeq sh:path ( ex:a ( ex:b ex:c ) ) .
+ex:inv sh:path [ sh:inversePath ex:a ] .
+ex:alt sh:path [ sh:alternativePath ( ex:a ex:b ex:c ) ] .
+ex:nestedAlt sh:path [
+    sh:alternativePath ( ex:a ( ex:b ex:c ) [ sh:inversePath ex:d ] )
+] .
+ex:star sh:path [ sh:zeroOrMorePath ex:a ] .
+ex:plus sh:path [ sh:oneOrMorePath ex:a ] .
+ex:opt sh:path [ sh:zeroOrOnePath ex:a ] .
+ex:combined sh:path (
+    [ sh:zeroOrMorePath [ sh:inversePath ex:a ] ]
+    ex:b
+    [ sh:alternativePath ( ex:c ex:d ) ]
+) .
+ex:openTail sh:path _:cell1 .
+_:cell1 rdf:first ex:a ; rdf:rest _:cell2 .
+_:cell2 rdf:first ex:b .
+
+ex:nilPath sh:path rdf:nil .
+ex:emptySeq sh:path () .
+ex:oneSeq sh:path ( ex:a ) .
+ex:emptyAlt sh:path [ sh:alternativePath () ] .
+ex:oneAlt sh:path [ sh:alternativePath ( ex:a ) ] .
+ex:unknown sh:path [ ex:other ex:a ] .
+ex:literal sh:path "name" .
+"""
+
+
+@pytest.fixture(scope="module")
+def shapes_graph() -> Graph:
+    g = Graph()
+    g.parse(data=SHAPES_TTL, format="turtle")
+    return g
+
+
+def _path_of(g: Graph, local: str) -> Any:
+    value = g.value(URIRef(EX + local), SH.path)
+    assert value is not None
+    return value
+
+
+a, b, c, d = (URIRef(EX + n) for n in "abcd")
+name = URIRef(EX + "name")
+
+
+@pytest.mark.parametrize(
+    "local, expected, exc",
+    [
+        # Valid paths.
+        ("simple", name, None),
+        ("seq", SequencePath(a, b, c), None),
+        ("nestedSeq", SequencePath(a, SequencePath(b, c)), None),
+        ("inv", InvPath(a), None),
+        ("alt", AlternativePath(a, b, c), None),
+        (
+            "nestedAlt",
+            AlternativePath(a, SequencePath(b, c), InvPath(d)),
+            None,
+        ),
+        ("star", MulPath(a, "*"), None),
+        ("plus", MulPath(a, "+"), None),
+        ("opt", MulPath(a, "?"), None),
+        (
+            "combined",
+            SequencePath(
+                MulPath(InvPath(a), "*"),
+                b,
+                AlternativePath(c, d),
+            ),
+            None,
+        ),
+        ("openTail", SequencePath(a, b), None),
+        # Invalid paths.
+        ("nilPath", None, SHACLPathError),
+        ("emptySeq", None, SHACLPathError),
+        ("oneSeq", None, SHACLPathError),
+        ("emptyAlt", None, SHACLPathError),
+        ("oneAlt", None, SHACLPathError),
+        ("unknown", None, SHACLPathError),
+        ("literal", None, TypeError),
+    ],
+)
+def test_parse_shacl_path(
+    shapes_graph: Graph,
+    local: str,
+    expected: Any,
+    exc: Type[Exception] | None,
+) -> None:
+    before = set(shapes_graph)
+    node = _path_of(shapes_graph, local)
+    if exc is None:
+        assert parse_shacl_path(shapes_graph, node) == expected
+    else:
+        with pytest.raises(exc):
+            parse_shacl_path(shapes_graph, node)
+    assert set(shapes_graph) == before
+
+
+@pytest.mark.parametrize("bad", [None, "http://example.org/shapes#a"])
+def test_non_node_input_raises_shacl_path_error(shapes_graph: Graph, bad: Any) -> None:
+    before = set(shapes_graph)
+    with pytest.raises(SHACLPathError):
+        parse_shacl_path(shapes_graph, bad)
+    assert set(shapes_graph) == before
