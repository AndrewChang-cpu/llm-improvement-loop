diff --git a/test/test_path.py b/test/test_path.py
index 1af0227..095b5d8 100644
--- a/test/test_path.py
+++ b/test/test_path.py
@@ -142,3 +142,102 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+SHACL_TESTS_TTL = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
+
+ex:iri sh:path skos:broader .
+ex:inv sh:path [ sh:inversePath skos:broader ] .
+ex:alt sh:path [ sh:alternativePath ( skos:broader skos:narrower ) ] .
+ex:seq sh:path [ sh:sequencePath ( skos:broader [ sh:inversePath skos:narrower ] ) ] .
+ex:star sh:path [ sh:zeroOrMorePath skos:broader ] .
+ex:plus sh:path [ sh:oneOrMorePath skos:broader ] .
+ex:opt sh:path [ sh:zeroOrOnePath skos:broader ] .
+ex:bad sh:path [ sh:inversePath skos:broader ; sh:zeroOrMorePath skos:narrower ] .
+ex:empty sh:path [ sh:sequencePath () ] .
+ex:literal sh:path "not a path" .
+"""
+
+
+@pytest.fixture
+def shacl_graph() -> Graph:
+    sg = Graph()
+    sg.parse(data=SHACL_TESTS_TTL, format="turtle")
+    return sg
+
+
+def _shacl_path_of(sg: Graph, name: str):
+    return sg.value(
+        URIRef(f"http://example.org/{name}"), URIRef("http://www.w3.org/ns/shacl#path")
+    )
+
+
+def test_parse_shacl_path_iri(shacl_graph: Graph) -> None:
+    from rdflib.namespace import SKOS
+    from rdflib.paths import parse_shacl_path
+
+    result = parse_shacl_path(shacl_graph, _shacl_path_of(shacl_graph, "iri"))
+    assert result == SKOS.broader
+    assert isinstance(result, URIRef)
+
+
+def test_parse_shacl_path_inverse(shacl_graph: Graph) -> None:
+    from rdflib.namespace import SKOS
+    from rdflib.paths import InvPath, parse_shacl_path
+
+    result = parse_shacl_path(shacl_graph, _shacl_path_of(shacl_graph, "inv"))
+    assert isinstance(result, InvPath)
+    assert result.arg == SKOS.broader
+
+
+def test_parse_shacl_path_alternative(shacl_graph: Graph) -> None:
+    from rdflib.namespace import SKOS
+    from rdflib.paths import AlternativePath, parse_shacl_path
+
+    result = parse_shacl_path(shacl_graph, _shacl_path_of(shacl_graph, "alt"))
+    assert isinstance(result, AlternativePath)
+    assert result.args == [SKOS.broader, SKOS.narrower]
+
+
+def test_parse_shacl_path_sequence_nested(shacl_graph: Graph) -> None:
+    from rdflib.namespace import SKOS
+    from rdflib.paths import InvPath, SequencePath, parse_shacl_path
+
+    result = parse_shacl_path(shacl_graph, _shacl_path_of(shacl_graph, "seq"))
+    assert isinstance(result, SequencePath)
+    assert len(result.args) == 2
+    assert result.args[0] == SKOS.broader
+    assert isinstance(result.args[1], InvPath)
+    assert result.args[1].arg == SKOS.narrower
+
+
+@pytest.mark.parametrize(
+    "name, mod",
+    [("star", ZeroOrMore), ("plus", OneOrMore), ("opt", ZeroOrOne)],
+)
+def test_parse_shacl_path_modifiers(shacl_graph: Graph, name: str, mod: str) -> None:
+    from rdflib.namespace import SKOS
+    from rdflib.paths import MulPath, parse_shacl_path
+
+    result = parse_shacl_path(shacl_graph, _shacl_path_of(shacl_graph, name))
+    assert isinstance(result, MulPath)
+    assert result.path == SKOS.broader
+    assert result.mod == mod
+
+
+def test_parse_shacl_path_n3(shacl_graph: Graph) -> None:
+    from rdflib.paths import parse_shacl_path
+
+    result = parse_shacl_path(shacl_graph, _shacl_path_of(shacl_graph, "seq"))
+    assert result.n3(shacl_graph.namespace_manager) == "skos:broader/^skos:narrower"
+
+
+@pytest.mark.parametrize("name", ["bad", "empty", "literal"])
+def test_parse_shacl_path_invalid(shacl_graph: Graph, name: str) -> None:
+    from rdflib.paths import parse_shacl_path
+
+    with pytest.raises(ValueError):
+        parse_shacl_path(shacl_graph, _shacl_path_of(shacl_graph, name))
