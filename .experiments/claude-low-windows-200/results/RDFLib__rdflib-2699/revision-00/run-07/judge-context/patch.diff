+def parse_shacl_path(
+    graph: Graph, shacl_path: Node
+) -> Union[URIRef, Path]:
+    """
+    Parse a SHACL path (the object of a ``sh:path`` triple) into an
+    RDFLib-friendly value.
+
+    A plain IRI is returned as-is as a :class:`~rdflib.term.URIRef`. A complex
+    SHACL path (``sh:inversePath``, ``sh:alternativePath``, ``sh:sequencePath``,
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath`` or ``sh:zeroOrOnePath``) is
+    returned as the corresponding :class:`Path` object.
+
+    :param graph: The graph containing the SHACL path description.
+    :param shacl_path: The node describing the path.
+    :raises ValueError: If the node is not a valid SHACL path.
+
+    See https://www.w3.org/TR/shacl/#property-paths
+    """
+    from rdflib.collection import Collection
+    from rdflib.term import BNode
+
+    SH = "http://www.w3.org/ns/shacl#"
+
+    if isinstance(shacl_path, URIRef):
+        return shacl_path
+    if not isinstance(shacl_path, BNode):
+        raise ValueError(f"Invalid SHACL path node: {shacl_path!r}")
+
+    def _list_items(node: Node) -> List[Union[URIRef, Path]]:
+        items = list(Collection(graph, node))
+        if not items:
+            raise ValueError(f"Empty SHACL path list: {node!r}")
+        return [parse_shacl_path(graph, item) for item in items]
+
+    inverse = list(graph.objects(shacl_path, URIRef(SH + "inversePath")))
+    alternative = list(graph.objects(shacl_path, URIRef(SH + "alternativePath")))
+    sequence = list(graph.objects(shacl_path, URIRef(SH + "sequencePath")))
+    zero_or_more = list(graph.objects(shacl_path, URIRef(SH + "zeroOrMorePath")))
+    one_or_more = list(graph.objects(shacl_path, URIRef(SH + "oneOrMorePath")))
+    zero_or_one = list(graph.objects(shacl_path, URIRef(SH + "zeroOrOnePath")))
+
+    candidates = [
+        (inverse, "inverse"),
+        (alternative, "alternative"),
+        (sequence, "sequence"),
+        (zero_or_more, "zeroOrMore"),
+        (one_or_more, "oneOrMore"),
+        (zero_or_one, "zeroOrOne"),
+    ]
+    present = [(vals, kind) for vals, kind in candidates if vals]
+    if len(present) != 1 or len(present[0][0]) != 1:
+        raise ValueError(f"Invalid or ambiguous SHACL path: {shacl_path!r}")
+
+    values, kind = present[0]
+    value = values[0]
+    if kind == "inverse":
+        return InvPath(parse_shacl_path(graph, value))
+    if kind == "alternative":
+        return AlternativePath(*_list_items(value))
+    if kind == "sequence":
+        return SequencePath(*_list_items(value))
+    mod = {"zeroOrMore": ZeroOrMore, "oneOrMore": OneOrMore, "zeroOrOne": ZeroOrOne}[
+        kind
+    ]
+    return MulPath(parse_shacl_path(graph, value), mod)
+
+
 if __name__ == "__main__":
