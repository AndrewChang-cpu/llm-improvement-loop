+"""
+Utilities for working with SHACL property paths.
+
+A SHACL path (the object of a triple whose predicate is ``sh:path``) is either
+a plain IRI, or a blank node describing a complex path. This module converts
+such values into RDFLib-friendly objects: a :class:`~rdflib.term.URIRef` when the
+path is a simple predicate, or a :class:`~rdflib.paths.Path` otherwise.
+
+>>> from rdflib import Graph
+>>> from rdflib.namespace import SH
+>>> g = Graph().parse(data='''
+...     @prefix sh: <http://www.w3.org/ns/shacl#> .
+...     @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
+...     [] sh:path [ sh:inversePath skos:broader ] .
+... ''', format="turtle")
+>>> node = next(g.objects(None, SH.path))
+>>> parse_shacl_path(g, node).n3(g.namespace_manager)
+'^skos:broader'
+"""
+
+from __future__ import annotations
+
+from typing import List, Union
+
+from rdflib.collection import Collection
+from rdflib.graph import Graph
+from rdflib.namespace import RDF, SH
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    Path,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+from rdflib.term import BNode, Node, URIRef
+
+__all__ = ["parse_shacl_path"]
+
+
+def parse_shacl_path(graph: Graph, path_node: Node) -> Union[URIRef, Path]:
+    """
+    Convert a SHACL path node into an RDFLib predicate or path object.
+
+    :param graph: the graph containing the SHACL path description.
+    :param path_node: the value of a ``sh:path`` triple, either an IRI or a
+        blank node describing a complex path.
+    :returns: a :class:`~rdflib.term.URIRef` if the path is a simple predicate,
+        otherwise a :class:`~rdflib.paths.Path`.
+    :raises ValueError: if the node is not a valid SHACL path.
+    """
+    if isinstance(path_node, URIRef):
+        return path_node
+    if not isinstance(path_node, BNode):
+        raise ValueError(f"Invalid SHACL path node: {path_node!r}")
+
+    inverse = graph.value(path_node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(graph, inverse))
+
+    alternatives = graph.value(path_node, SH.alternativePath)
+    if alternatives is not None:
+        return AlternativePath(*_parse_list(graph, alternatives))
+
+    for predicate, mod in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        inner = graph.value(path_node, predicate)
+        if inner is not None:
+            return MulPath(parse_shacl_path(graph, inner), mod)
+
+    # A sequence path is an RDF list of path elements.
+    if (path_node, RDF.first, None) in graph:
+        return SequencePath(*_parse_list(graph, path_node))
+
+    raise ValueError(f"Unsupported SHACL path node: {path_node!r}")
+
+
+def _parse_list(graph: Graph, list_node: Node) -> List[Union[URIRef, Path]]:
+    elements = list(Collection(graph, list_node))
+    if not elements:
+        raise ValueError(f"SHACL path list must not be empty: {list_node!r}")
+    return [parse_shacl_path(graph, element) for element in elements]
diff --git a/test/test_extras/test_shacl.py b/test/test_extras/test_shacl.py
new file mode 100644
index 0000000..1648f23
--- /dev/null
+++ b/test/test_extras/test_shacl.py
@@ -0,0 +1,131 @@
+from __future__ import annotations
+
+from typing import Union
+
+import pytest
+
+from rdflib import BNode, Graph, Literal, URIRef
+from rdflib.extras.shacl import parse_shacl_path
+from rdflib.namespace import RDF, SH, Namespace
+from rdflib.paths import (
+    AlternativePath,
+    InvPath,
+    MulPath,
+    OneOrMore,
+    Path,
+    SequencePath,
+    ZeroOrMore,
+    ZeroOrOne,
+)
+
+EX = Namespace("http://example.org/")
+SKOS = Namespace("http://www.w3.org/2004/02/skos/core#")
+
+PREFIXES = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix ex: <http://example.org/> .
+@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
+"""
+
+
+def _path_value(graph: Graph) -> Union[URIRef, BNode, Literal]:
+    return next(graph.objects(None, SH.path))
+
+
+def _parse(turtle_body: str) -> Union[URIRef, Path]:
+    graph = Graph()
+    graph.parse(data=PREFIXES + turtle_body, format="turtle")
+    return parse_shacl_path(graph, _path_value(graph))
+
+
+def test_simple_iri_path() -> None:
+    result = _parse("[] sh:path skos:broader .")
+    assert result == SKOS.broader
+    assert isinstance(result, URIRef)
+
+
+def test_inverse_path() -> None:
+    result = _parse("[] sh:path [ sh:inversePath skos:broader ] .")
+    assert isinstance(result, InvPath)
+    assert result == InvPath(SKOS.broader)
+
+
+def test_alternative_path() -> None:
+    result = _parse("[] sh:path [ sh:alternativePath ( ex:a ex:b ) ] .")
+    assert isinstance(result, AlternativePath)
+    assert result == AlternativePath(EX.a, EX.b)
+
+
+def test_sequence_path() -> None:
+    result = _parse("[] sh:path ( ex:a ex:b ex:c ) .")
+    assert isinstance(result, SequencePath)
+    assert result == SequencePath(EX.a, EX.b, EX.c)
+
+
+@pytest.mark.parametrize(
+    "predicate, mod",
+    [
+        ("sh:zeroOrMorePath", ZeroOrMore),
+        ("sh:oneOrMorePath", OneOrMore),
+        ("sh:zeroOrOnePath", ZeroOrOne),
+    ],
+)
+def test_multiplicity_paths(predicate: str, mod: str) -> None:
+    result = _parse(f"[] sh:path [ {predicate} ex:a ] .")
+    assert isinstance(result, MulPath)
+    assert result == MulPath(EX.a, mod)
+
+
+def test_nested_path() -> None:
+    result = _parse(
+        "[] sh:path [ sh:inversePath [ sh:zeroOrMorePath skos:broader ] ] ."
+    )
+    assert result == InvPath(MulPath(SKOS.broader, ZeroOrMore))
+
+
+def test_result_usable_as_predicate() -> None:
+    graph = Graph()
+    graph.parse(
+        data=PREFIXES
+        + """
+        [] sh:path [ sh:inversePath skos:broader ] .
+        ex:child skos:broader ex:parent .
+        """,
+        format="turtle",
+    )
+    path = parse_shacl_path(graph, _path_value(graph))
+    # Inverse of skos:broader: from ex:parent, following the path reaches ex:child.
+    assert list(graph.objects(EX.parent, path)) == [EX.child]
+
+
+def test_n3_representation() -> None:
+    graph = Graph()
+    graph.bind("skos", SKOS)
+    graph.parse(
+        data=PREFIXES + "[] sh:path [ sh:inversePath skos:broader ] .",
+        format="turtle",
+    )
+    path = parse_shacl_path(graph, _path_value(graph))
+    assert path.n3(graph.namespace_manager) == "^skos:broader"
+
+
+def test_invalid_literal_raises() -> None:
+    graph = Graph()
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, Literal("not a path"))
+
+
+def test_unknown_blank_node_raises() -> None:
+    graph = Graph()
+    node = BNode()
+    graph.add((node, RDF.type, SH.PropertyShape))
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, node)
+
+
+def test_empty_list_raises() -> None:
+    graph = Graph()
+    node = BNode()
+    graph.add((node, SH.alternativePath, RDF.nil))
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, node)
