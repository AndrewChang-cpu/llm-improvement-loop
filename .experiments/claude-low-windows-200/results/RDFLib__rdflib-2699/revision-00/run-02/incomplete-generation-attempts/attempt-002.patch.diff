+def test_parse_shacl_path_predicate() -> None:
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    assert parse_shacl_path(g, RDF.type) == RDF.type
+
+
+def test_parse_shacl_path_inverse() -> None:
+    from rdflib import BNode
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    b = BNode()
+    g.add((b, SH.inversePath, SKOS.broader))
+    path = parse_shacl_path(g, b)
+    assert isinstance(path, InvPath)
+    assert path == ~SKOS.broader
+    assert path.n3(nsm) == "^skos:broader"
+
+
+def test_parse_shacl_path_sequence() -> None:
+    from rdflib import BNode
+    from rdflib.collection import Collection
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    b = BNode()
+    lst = BNode()
+    Collection(g, lst, [SKOS.broader, SKOS.narrower])
+    g.add((b, URIRef("http://www.w3.org/ns/shacl#sequencePath"), lst))
+    path = parse_shacl_path(g, b)
+    assert isinstance(path, SequencePath)
+    assert path == SKOS.broader / SKOS.narrower
+
+
+def test_parse_shacl_path_alternative() -> None:
+    from rdflib import BNode
+    from rdflib.collection import Collection
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    b = BNode()
+    lst = BNode()
+    Collection(g, lst, [SKOS.broader, SKOS.narrower])
+    g.add((b, SH.alternativePath, lst))
+    path = parse_shacl_path(g, b)
+    assert isinstance(path, AlternativePath)
+    assert path == SKOS.broader | SKOS.narrower
+
+
+@pytest.mark.parametrize(
+    ["predicate", "modifier"],
+    [
+        ("zeroOrMorePath", ZeroOrMore),
+        ("oneOrMorePath", OneOrMore),
+        ("zeroOrOnePath", ZeroOrOne),
+    ],
+)
+def test_parse_shacl_path_modifiers(predicate: str, modifier: str) -> None:
+    from rdflib import BNode
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    b = BNode()
+    g.add((b, getattr(SH, predicate), SKOS.broader))
+    path = parse_shacl_path(g, b)
+    assert isinstance(path, MulPath)
+    assert path.mod == modifier
+    assert path.path == SKOS.broader
+
+
+def test_parse_shacl_path_nested() -> None:
+    from rdflib import BNode
+    from rdflib.collection import Collection
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    # ( ^skos:broader / skos:narrower* )
+    g = Graph()
+    inv = BNode()
+    star = BNode()
+    seq_list = BNode()
+    root = BNode()
+    g.add((inv, SH.inversePath, SKOS.broader))
+    g.add((star, SH.zeroOrMorePath, SKOS.narrower))
+    Collection(g, seq_list, [inv, star])
+    g.add((root, URIRef("http://www.w3.org/ns/shacl#sequencePath"), seq_list))
+    path = parse_shacl_path(g, root)
+    assert path.n3(nsm) == "^skos:broader/skos:narrower*"
+
+
+@pytest.mark.parametrize(
+    "build",
+    [
+        lambda g, b: None,  # blank node with no SHACL path description
+        lambda g, b: g.add((b, SH.inversePath, Literal("x"))),
+    ],
+)
+def test_parse_shacl_path_invalid(build) -> None:
+    from rdflib import BNode, Literal
+    from rdflib.namespace import SH
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    b = BNode()
+    build(g, b)
+    with pytest.raises(ValueError):
+        parse_shacl_path(g, b)
+
+
