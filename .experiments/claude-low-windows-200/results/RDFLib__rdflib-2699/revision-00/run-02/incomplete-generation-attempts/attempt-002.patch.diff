+def parse_shacl_path(graph: Graph, shacl_path: Node) -> Union[URIRef, Path]:
+    """
+    Parse a SHACL path (the object of a ``sh:path`` triple) into an
+    RDFLib-friendly predicate.
+
+    Returns a :class:`~rdflib.term.URIRef` when the SHACL path is a plain
+    predicate, and a :class:`Path` for complex paths such as
+    ``[sh:inversePath skos:broader]``.
+
+    See https://www.w3.org/TR/shacl/#property-paths
+
+    :param graph: The graph containing the SHACL path description.
+    :param shacl_path: The node describing the path (a URIRef or blank node).
+    :raises ValueError: If the node does not describe a valid SHACL path.
+
+    >>> from rdflib import Graph, Namespace, BNode
+    >>> from rdflib.namespace import SH, SKOS
+    >>> g = Graph()
+    >>> b = BNode()
+    >>> _ = g.add((b, SH.inversePath, SKOS.broader))
+    >>> parse_shacl_path(g, b)
+    Path(~http://www.w3.org/2004/02/skos/core#broader)
+    >>> parse_shacl_path(g, SKOS.broader)
+    rdflib.term.URIRef('http://www.w3.org/2004/02/skos/core#broader')
+    """
+    # local imports to avoid circular imports with rdflib.namespace/collection
+    from rdflib.collection import Collection
+    from rdflib.namespace._SH import SH
+
+    # sh:sequencePath is not present in the generated SH namespace
+    sh_sequence_path = URIRef("http://www.w3.org/ns/shacl#sequencePath")
+
+    if isinstance(shacl_path, URIRef):
+        return shacl_path
+
+    if not isinstance(shacl_path, BNode):
+        raise ValueError(f"Not a valid SHACL path: {shacl_path!r}")
+
+    def _list_items(list_node: Node) -> List[Union[URIRef, Path]]:
+        items = list(Collection(graph, list_node))
+        if not items:
+            raise ValueError(f"Empty SHACL path list: {list_node!r}")
+        return [parse_shacl_path(graph, item) for item in items]
+
+    def _single(predicate: URIRef) -> Optional[Node]:
+        values = list(graph.objects(shacl_path, predicate))
+        if len(values) > 1:
+            raise ValueError(
+                f"Multiple {predicate} values for SHACL path {shacl_path!r}"
+            )
+        return values[0] if values else None
+
+    inverse = _single(SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(graph, inverse))
+
+    alternative = _single(SH.alternativePath)
+    if alternative is not None:
+        return AlternativePath(*_list_items(alternative))
+
+    sequence = _single(sh_sequence_path)
+    if sequence is not None:
+        return SequencePath(*_list_items(sequence))
+
+    for predicate, modifier in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        inner = _single(predicate)
+        if inner is not None:
+            return MulPath(parse_shacl_path(graph, inner), modifier)
+
+    raise ValueError(f"Not a valid SHACL path: {shacl_path!r}")
+
+
 if __name__ == "__main__":
     pass
 else:
