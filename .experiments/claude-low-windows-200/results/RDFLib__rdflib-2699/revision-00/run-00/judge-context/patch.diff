@@ -5,8 +5,9 @@ from typing import Union
 
 import pytest
 
-from rdflib import RDF, RDFS, Graph, URIRef
-from rdflib.namespace import DCAT, DCTERMS
+from rdflib import RDF, RDFS, Graph, Namespace, URIRef
+from rdflib.namespace import DCAT, DCTERMS, SKOS
+from rdflib.paths import eval_path, parse_shacl_path
 from rdflib.paths import (
     AlternativePath,
     InvPath,
@@ -142,3 +143,127 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+SH = Namespace("http://www.w3.org/ns/shacl#")
+EX = Namespace("http://example.com/")
+
+
+def _shacl_graph(turtle: str) -> Graph:
+    g = Graph()
+    g.parse(data=turtle, format="turtle")
+    return g
+
+
+def test_parse_shacl_path_iri() -> None:
+    g = Graph()
+    assert parse_shacl_path(g, SKOS.broader) == SKOS.broader
+
+
+def test_parse_shacl_path_inverse() -> None:
+    g = _shacl_graph(
+        """
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix skos: <http://www.w3.org/2004/02/skos/core#> .
+        [] sh:path [ sh:inversePath skos:broader ] .
+        """
+    )
+    node = next(g.objects(None, SH.path))
+    path = parse_shacl_path(g, node)
+    assert isinstance(path, InvPath)
+    assert path.arg == SKOS.broader
+    assert path.n3(nsm) == "^skos:broader"
+
+
+def test_parse_shacl_path_sequence() -> None:
+    g = _shacl_graph(
+        """
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <http://example.com/> .
+        [] sh:path ( ex:p1 [ sh:inversePath ex:p2 ] ) .
+        """
+    )
+    path = parse_shacl_path(g, next(g.objects(None, SH.path)))
+    assert isinstance(path, SequencePath)
+    assert path.args == [EX.p1, InvPath(EX.p2)]
+
+
+def test_parse_shacl_path_alternative() -> None:
+    g = _shacl_graph(
+        """
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <http://example.com/> .
+        [] sh:path [ sh:alternativePath ( ex:p1 ex:p2 ) ] .
+        """
+    )
+    path = parse_shacl_path(g, next(g.objects(None, SH.path)))
+    assert isinstance(path, AlternativePath)
+    assert path.args == [EX.p1, EX.p2]
+
+
+@pytest.mark.parametrize(
+    ["predicate", "mod"],
+    [
+        ("zeroOrMorePath", ZeroOrMore),
+        ("oneOrMorePath", OneOrMore),
+        ("zeroOrOnePath", ZeroOrOne),
+    ],
+)
+def test_parse_shacl_path_modifiers(predicate: str, mod: str) -> None:
+    g = _shacl_graph(
+        f"""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <http://example.com/> .
+        [] sh:path [ sh:{predicate} ex:p1 ] .
+        """
+    )
+    path = parse_shacl_path(g, next(g.objects(None, SH.path)))
+    assert isinstance(path, MulPath)
+    assert path.path == EX.p1
+    assert path.mod == mod
+
+
+def test_parse_shacl_path_nested_and_evaluates() -> None:
+    g = _shacl_graph(
+        """
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <http://example.com/> .
+        ex:a ex:p1 ex:b .
+        ex:b ex:p2 ex:c .
+        ex:d ex:p1 ex:e .
+        ex:e ex:p2 ex:f .
+        [] sh:path ( [ sh:oneOrMorePath ex:p1 ] ex:p2 ) .
+        """
+    )
+    path = parse_shacl_path(g, next(g.objects(None, SH.path)))
+    assert isinstance(path, SequencePath)
+    assert set(eval_path(g, (EX.a, path, None))) == {(EX.a, EX.c)}
+    assert set(eval_path(g, (EX.d, path, None))) == {(EX.d, EX.f)}
+
+
+@pytest.mark.parametrize(
+    "turtle",
+    [
+        # empty sequence list
+        """
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        [] sh:path () .
+        """,
+        # literal is not a path
+        """
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        [] sh:path "nope" .
+        """,
+        # blank node with no recognised path structure
+        """
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <http://example.com/> .
+        [] sh:path [ ex:unrelated ex:p1 ] .
+        """,
+    ],
+)
+def test_parse_shacl_path_invalid(turtle: str) -> None:
+    g = _shacl_graph(turtle)
+    node = next(g.objects(None, SH.path))
+    with pytest.raises(ValueError):
+        parse_shacl_path(g, node)
