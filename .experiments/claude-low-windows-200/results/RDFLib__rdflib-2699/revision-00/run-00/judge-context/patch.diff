@@ -588,6 +588,82 @@ def neg_path(p: Union[URIRef, AlternativePath, InvPath]) -> NegatedPath:
     return NegatedPath(p)
 
 
+_SHACL_NS = "http://www.w3.org/ns/shacl#"
+_RDF_NS = "http://www.w3.org/1999/02/22-rdf-syntax-ns#"
+_RDF_FIRST = URIRef(_RDF_NS + "first")
+_RDF_NIL = URIRef(_RDF_NS + "nil")
+
+
+def parse_shacl_path(graph: Graph, path_node: Node) -> Union[URIRef, Path]:
+    """
+    Parse the value of a SHACL ``sh:path`` into an RDFLib-friendly object.
+
+    The ``path_node`` is the object of a triple whose predicate is ``sh:path``,
+    e.g. ``shape sh:path [ sh:inversePath skos:broader ]``.
+
+    The result is a :class:`~rdflib.term.URIRef` when the path is simply a
+    predicate, otherwise a :class:`Path` instance, as follows:
+
+    * an IRI -> ``URIRef``
+    * ``[ sh:inversePath P ]`` -> ``InvPath``
+    * ``[ sh:alternativePath (P1 P2 ...) ]`` -> ``AlternativePath``
+    * ``[ sh:zeroOrMorePath P ]`` -> ``MulPath`` with ``ZeroOrMore``
+    * ``[ sh:oneOrMorePath P ]`` -> ``MulPath`` with ``OneOrMore``
+    * ``[ sh:zeroOrOnePath P ]`` -> ``MulPath`` with ``ZeroOrOne``
+    * an RDF list ``(P1 P2 ...)`` -> ``SequencePath``
+
+    :raises ValueError: if the node does not form a valid SHACL path.
+
+    >>> from rdflib import BNode, Graph
+    >>> from rdflib.namespace import SH, SKOS
+    >>> g = Graph()
+    >>> inv = BNode()
+    >>> _ = g.add((inv, SH.inversePath, SKOS.broader))
+    >>> parse_shacl_path(g, inv)
+    Path(~http://www.w3.org/2004/02/skos/core#broader)
+    >>> parse_shacl_path(g, SKOS.broader)
+    rdflib.term.URIRef('http://www.w3.org/2004/02/skos/core#broader')
+    """
+    if isinstance(path_node, URIRef) and path_node != _RDF_NIL:
+        return path_node
+
+    if not isinstance(path_node, BNode):
+        raise ValueError(f"Invalid SHACL path node: {path_node!r}")
+
+    def _parse_required(predicate: str) -> Union[URIRef, Path]:
+        value = graph.value(path_node, URIRef(_SHACL_NS + predicate))
+        if value is None:
+            raise ValueError(f"Missing sh:{predicate} for SHACL path {path_node!r}")
+        return parse_shacl_path(graph, value)
+
+    if (path_node, URIRef(_SHACL_NS + "inversePath"), None) in graph:
+        return InvPath(_parse_required("inversePath"))
+
+    if (path_node, URIRef(_SHACL_NS + "alternativePath"), None) in graph:
+        list_head = graph.value(path_node, URIRef(_SHACL_NS + "alternativePath"))
+        items = [parse_shacl_path(graph, x) for x in graph.items(list_head)]
+        if not items:
+            raise ValueError(f"Empty sh:alternativePath list for {path_node!r}")
+        return AlternativePath(*items)
+
+    for predicate, mod in (
+        ("zeroOrMorePath", ZeroOrMore),
+        ("oneOrMorePath", OneOrMore),
+        ("zeroOrOnePath", ZeroOrOne),
+    ):
+        if (path_node, URIRef(_SHACL_NS + predicate), None) in graph:
+            return MulPath(_parse_required(predicate), mod)
+
+    # Otherwise the node must be an RDF list forming a sequence path.
+    if (path_node, _RDF_FIRST, None) in graph:
+        items = [parse_shacl_path(graph, x) for x in graph.items(path_node)]
+        if not items:
+            raise ValueError(f"Empty SHACL sequence path list {path_node!r}")
+        return SequencePath(*items)
+
+    raise ValueError(f"Unrecognised SHACL path: {path_node!r}")
+
+
 if __name__ == "__main__":
     pass
 else:
