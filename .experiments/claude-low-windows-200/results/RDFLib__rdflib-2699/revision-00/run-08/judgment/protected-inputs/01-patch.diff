--- a/test/test_path.py
+++ b/test/test_path.py
@@ -5,8 +5,9 @@ from typing import Union
 
 import pytest
 
-from rdflib import RDF, RDFS, Graph, URIRef
-from rdflib.namespace import DCAT, DCTERMS
+from rdflib import RDF, RDFS, BNode, Graph, Namespace, URIRef
+from rdflib.collection import Collection
+from rdflib.namespace import DCAT, DCTERMS, SH
 from rdflib.paths import (
     AlternativePath,
     InvPath,
@@ -17,6 +18,7 @@ from rdflib.paths import (
     SequencePath,
     ZeroOrMore,
     ZeroOrOne,
+    build_path,
 )
 
 g = Graph()
@@ -142,3 +144,95 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+EX = Namespace("http://example.org/")
+
+
+def test_build_path_iri() -> None:
+    g = Graph()
+    assert build_path(g, EX.p) == EX.p
+    assert isinstance(build_path(g, EX.p), URIRef)
+
+
+def test_build_path_inverse() -> None:
+    g = Graph()
+    bn = BNode()
+    g.add((bn, SH.inversePath, EX.p))
+    assert build_path(g, bn) == InvPath(EX.p)
+
+
+@pytest.mark.parametrize(
+    "pred, mod",
+    [
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ],
+)
+def test_build_path_modifiers(pred: URIRef, mod: str) -> None:
+    g = Graph()
+    bn = BNode()
+    g.add((bn, pred, EX.p))
+    assert build_path(g, bn) == MulPath(EX.p, mod)
+
+
+def test_build_path_alternative() -> None:
+    g = Graph()
+    bn = BNode()
+    lst = BNode()
+    Collection(g, lst, [EX.p, EX.q])
+    g.add((bn, SH.alternativePath, lst))
+    assert build_path(g, bn) == AlternativePath(EX.p, EX.q)
+
+
+def test_build_path_sequence() -> None:
+    g = Graph()
+    lst = BNode()
+    Collection(g, lst, [EX.p, EX.q])
+    # a sequence path is an RDF list of paths, the list node itself is the path
+    assert build_path(g, lst) == SequencePath(EX.p, EX.q)
+
+
+def test_build_path_nested() -> None:
+    g = Graph()
+    inv = BNode()
+    g.add((inv, SH.inversePath, RDFS.subClassOf))
+    star = BNode()
+    g.add((star, SH.zeroOrMorePath, inv))
+    assert build_path(g, star) == MulPath(InvPath(RDFS.subClassOf), ZeroOrMore)
+
+
+def test_build_path_nested_sequence_with_inverse() -> None:
+    g = Graph()
+    g.bind("ex", EX)
+    inv = BNode()
+    g.add((inv, SH.inversePath, EX.broader))
+    lst = BNode()
+    Collection(g, lst, [EX.p, inv])
+    path = build_path(g, lst)
+    assert path == SequencePath(EX.p, InvPath(EX.broader))
+    assert path.n3(g.namespace_manager) == "ex:p/^ex:broader"
+
+
+def test_build_path_n3_inverse() -> None:
+    g = Graph()
+    bn = BNode()
+    g.add((bn, SH.inversePath, RDFS.subClassOf))
+    path = build_path(g, bn)
+    assert path.n3(g.namespace_manager) == "^rdfs:subClassOf"
+
+
+def test_build_path_invalid() -> None:
+    g = Graph()
+    bn = BNode()
+    with pytest.raises(ValueError):
+        build_path(g, bn)
+
+
+def test_build_path_single_element_sequence_invalid() -> None:
+    g = Graph()
+    lst = BNode()
+    Collection(g, lst, [EX.p])
+    with pytest.raises(ValueError):
+        build_path(g, lst)
