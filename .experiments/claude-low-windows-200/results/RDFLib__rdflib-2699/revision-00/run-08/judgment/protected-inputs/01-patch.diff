@@ -588,6 +588,69 @@ def neg_path(p: Union[URIRef, AlternativePath, InvPath]) -> NegatedPath:
     return NegatedPath(p)
 
 
+def build_path(graph: Graph, node: Node) -> Union[URIRef, Path]:
+    """
+    Convert a SHACL path node (the object of a ``sh:path`` triple) into an
+    RDFLib-friendly path.
+
+    A plain IRI is returned as-is (a path of length one, usable directly as a
+    predicate). Complex SHACL paths are returned as :class:`Path` objects:
+
+    - ``sh:inversePath`` -> :class:`InvPath`
+    - ``sh:alternativePath`` (RDF list) -> :class:`AlternativePath`
+    - ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, ``sh:zeroOrOnePath``
+      -> :class:`MulPath`
+    - an RDF list of paths (a sequence path) -> :class:`SequencePath`
+
+    :param graph: the graph containing the SHACL path description.
+    :param node: the node describing the path.
+    :raises ValueError: if the node does not describe a valid SHACL path.
+
+    >>> from rdflib import Graph, Namespace, BNode
+    >>> from rdflib.namespace import SH
+    >>> g = Graph()
+    >>> ex = Namespace("http://example.org/")
+    >>> bn = BNode()
+    >>> _ = g.add((bn, SH.inversePath, ex.p))
+    >>> build_path(g, ex.q) == ex.q
+    True
+    >>> build_path(g, bn)
+    Path(~http://example.org/p)
+    """
+    from rdflib.collection import Collection
+    from rdflib.namespace import RDF, SH
+
+    if isinstance(node, URIRef):
+        return node
+
+    inv = graph.value(node, SH.inversePath)
+    if inv is not None:
+        return InvPath(build_path(graph, inv))
+
+    for pred, mod in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        inner = graph.value(node, pred)
+        if inner is not None:
+            return MulPath(build_path(graph, inner), mod)
+
+    alt = graph.value(node, SH.alternativePath)
+    if alt is not None:
+        return AlternativePath(
+            *[build_path(graph, item) for item in Collection(graph, alt)]
+        )
+
+    if isinstance(node, BNode) and (node, RDF.first, None) in graph:
+        items = list(Collection(graph, node))
+        if len(items) < 2:
+            raise ValueError(f"SHACL sequence path needs at least 2 elements: {node}")
+        return SequencePath(*[build_path(graph, item) for item in items])
+
+    raise ValueError(f"Not a valid SHACL path: {node!r}")
+
+
 if __name__ == "__main__":
     pass
 else:
diff --git a/test/test_path.py b/test/test_path.py
