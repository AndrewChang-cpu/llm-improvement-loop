+
+
+EX = "http://example.com/"
+
+
+def _shacl_graph(turtle: str) -> Graph:
+    graph = Graph()
+    graph.parse(
+        data="@prefix sh: <http://www.w3.org/ns/shacl#> . @prefix skos: <http://www.w3.org/2004/02/skos/core#> . "
+        f"@prefix ex: <{EX}> . {turtle}",
+        format="turtle",
+    )
+    return graph
+
+
+@pytest.mark.parametrize(
+    ["turtle", "expected"],
+    [
+        ("ex:shape sh:path skos:broader .", URIRef("http://www.w3.org/2004/02/skos/core#broader")),
+        (
+            "ex:shape sh:path [ sh:inversePath skos:broader ] .",
+            ~URIRef("http://www.w3.org/2004/02/skos/core#broader"),
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrMorePath ex:p ] .",
+            URIRef(EX + "p") * ZeroOrMore,
+        ),
+        (
+            "ex:shape sh:path [ sh:oneOrMorePath ex:p ] .",
+            URIRef(EX + "p") * OneOrMore,
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrOnePath ex:p ] .",
+            URIRef(EX + "p") * ZeroOrOne,
+        ),
+        (
+            "ex:shape sh:path ( ex:p ex:q ) .",
+            URIRef(EX + "p") / URIRef(EX + "q"),
+        ),
+        (
+            "ex:shape sh:path [ sh:alternativePath ( ex:p ex:q ) ] .",
+            URIRef(EX + "p") | URIRef(EX + "q"),
+        ),
+        (
+            "ex:shape sh:path [ sh:inversePath [ sh:zeroOrMorePath ex:p ] ] .",
+            ~(URIRef(EX + "p") * ZeroOrMore),
+        ),
+    ],
+)
+def test_parse_shacl_path(turtle: str, expected: Union[URIRef, Path]) -> None:
+    graph = _shacl_graph(turtle)
+    shape = URIRef(EX + "shape")
+    node = graph.value(shape, SH.path)
+    assert node is not None
+    parsed = parse_shacl_path(graph, node)
+    assert parsed == expected
+    assert type(parsed) is type(expected)
+
+
+def test_parse_shacl_path_is_usable_as_predicate() -> None:
+    graph = _shacl_graph(
+        """
+        ex:a skos:broader ex:b .
+        ex:b skos:broader ex:c .
+        ex:shape sh:path [ sh:zeroOrMorePath skos:broader ] .
+        """
+    )
+    path = parse_shacl_path(graph, graph.value(URIRef(EX + "shape"), SH.path))
+    assert isinstance(path, Path)
+    assert set(graph.objects(URIRef(EX + "a"), path)) == {
+        URIRef(EX + "a"),
+        URIRef(EX + "b"),
+        URIRef(EX + "c"),
+    }
+
+
+def test_parse_shacl_path_n3() -> None:
+    graph = _shacl_graph("ex:shape sh:path [ sh:inversePath skos:broader ] .")
+    path = parse_shacl_path(graph, graph.value(URIRef(EX + "shape"), SH.path))
+    assert path.n3(graph.namespace_manager) == "^skos:broader"
+
+
+@pytest.mark.parametrize(
+    "turtle",
+    [
+        "ex:shape sh:path ( ex:p ) .",
+        "ex:shape sh:path [ sh:alternativePath ( ex:p ) ] .",
+        "ex:shape sh:path [ ex:unrelated ex:p ] .",
+        'ex:shape sh:path "not a path" .',
+    ],
+)
+def test_parse_shacl_path_invalid(turtle: str) -> None:
+    graph = _shacl_graph(turtle)
+    node = graph.value(URIRef(EX + "shape"), SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(graph, node)
