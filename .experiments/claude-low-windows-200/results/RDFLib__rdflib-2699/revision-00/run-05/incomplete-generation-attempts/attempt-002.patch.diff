+def parse_shacl_path(graph: Graph, node: Node) -> Union[URIRef, Path]:
+    """
+    Parse a SHACL property path (the object of a ``sh:path`` triple) into an
+    RDFLib-friendly path.
+
+    A plain IRI is returned as-is, as it is already a valid predicate. Complex
+    SHACL paths are converted into the corresponding :class:`Path` object, which
+    can be used as a predicate in e.g. :meth:`Graph.triples` or
+    :meth:`Graph.value`.
+
+    See https://www.w3.org/TR/shacl/#property-paths
+
+    :param graph: the graph containing the path description
+    :param node: the node describing the path (the object of ``sh:path``)
+    :raises ValueError: if the node is not a valid SHACL path
+    """
+    # imported here to avoid circular imports
+    from rdflib.collection import Collection
+    from rdflib.namespace import RDF, SH
+
+    if isinstance(node, URIRef):
+        return node
+
+    if not isinstance(node, BNode):
+        raise ValueError(f"Invalid SHACL path, expected IRI or blank node: {node!r}")
+
+    def _parse_list(list_node: Node) -> List[Union[URIRef, Path]]:
+        items = [parse_shacl_path(graph, item) for item in Collection(graph, list_node)]
+        if len(items) < 2:
+            raise ValueError(
+                f"Invalid SHACL path list, expected at least 2 elements: {list_node!r}"
+            )
+        return items
+
+    def _single(predicate: URIRef) -> Optional[Node]:
+        values = list(graph.objects(node, predicate))
+        if not values:
+            return None
+        if len(values) > 1:
+            raise ValueError(f"Multiple {predicate} values on SHACL path {node!r}")
+        return values[0]
+
+    if (inv := _single(SH.inversePath)) is not None:
+        return InvPath(parse_shacl_path(graph, inv))
+
+    if (alt := _single(SH.alternativePath)) is not None:
+        return AlternativePath(*_parse_list(alt))
+
+    for pred, mod in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        if (inner := _single(pred)) is not None:
+            return MulPath(parse_shacl_path(graph, inner), mod)
+
+    if graph.value(node, RDF.first) is not None:
+        # a bare RDF list is a sequence path
+        return SequencePath(*_parse_list(node))
+
+    raise ValueError(f"Invalid SHACL path: {node!r}")
+
+
 if __name__ == "__main__":
     pass
 else:
