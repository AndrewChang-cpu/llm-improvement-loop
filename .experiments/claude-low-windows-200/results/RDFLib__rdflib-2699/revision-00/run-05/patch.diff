+SHACL_PREFIXES = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
+@prefix ex: <http://example.org/> .
+"""
+
+
+@pytest.mark.parametrize(
+    ["turtle", "expected"],
+    [
+        ("ex:shape sh:path skos:broader .", SKOS.broader),
+        ("ex:shape sh:path [ sh:inversePath skos:broader ] .", ~SKOS.broader),
+        (
+            "ex:shape sh:path ( skos:broader skos:narrower ) .",
+            SequencePath(SKOS.broader, SKOS.narrower),
+        ),
+        (
+            "ex:shape sh:path [ sh:alternativePath ( skos:broader skos:narrower ) ] .",
+            AlternativePath(SKOS.broader, SKOS.narrower),
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrMorePath skos:broader ] .",
+            MulPath(SKOS.broader, ZeroOrMore),
+        ),
+        (
+            "ex:shape sh:path [ sh:oneOrMorePath skos:broader ] .",
+            MulPath(SKOS.broader, OneOrMore),
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrOnePath skos:broader ] .",
+            MulPath(SKOS.broader, ZeroOrOne),
+        ),
+        (
+            "ex:shape sh:path ( [ sh:inversePath skos:broader ] skos:narrower ) .",
+            SequencePath(~SKOS.broader, SKOS.narrower),
+        ),
+        (
+            "ex:shape sh:path [ sh:alternativePath ( skos:broader"
+            " [ sh:oneOrMorePath skos:narrower ] ) ] .",
+            AlternativePath(SKOS.broader, MulPath(SKOS.narrower, OneOrMore)),
+        ),
+    ],
+)
+def test_shacl_path(turtle: str, expected: Union[URIRef, Path]) -> None:
+    g = Graph()
+    g.parse(data=SHACL_PREFIXES + turtle, format="turtle")
+    node = g.value(EX.shape, SH.path)
+    assert node is not None
+    result = shacl_path(g, node)
+    assert result == expected
+    assert type(result) is type(expected)
+
+
+def test_shacl_path_usable_with_graph_methods() -> None:
+    g = Graph()
+    g.parse(
+        data=SHACL_PREFIXES
+        + """
+        ex:shape sh:path [ sh:zeroOrMorePath skos:broader ] .
+        ex:a skos:broader ex:b .
+        ex:b skos:broader ex:c .
+        """,
+        format="turtle",
+    )
+    path = shacl_path(g, g.value(EX.shape, SH.path))
+    assert path == MulPath(SKOS.broader, ZeroOrMore)
+    assert set(g.objects(EX.a, path)) == {EX.a, EX.b, EX.c}
+
+
+@pytest.mark.parametrize(
+    "turtle",
+    [
+        "ex:shape sh:path [ sh:inversePath skos:broader ; sh:zeroOrMorePath skos:narrower ] .",
+        "ex:shape sh:path [ ex:unknown skos:broader ] .",
+        "ex:shape sh:path [ sh:inversePath skos:broader , skos:narrower ] .",
+        "ex:shape sh:path [ sh:alternativePath skos:broader ] .",
+    ],
+)
+def test_shacl_path_invalid(turtle: str) -> None:
+    g = Graph()
+    g.parse(data=SHACL_PREFIXES + turtle, format="turtle")
+    node = g.value(EX.shape, SH.path)
+    with pytest.raises(ValueError):
+        shacl_path(g, node)
