+def shacl_path(graph: Graph, node: Node) -> Union[URIRef, Path]:
+    """
+    Convert a SHACL property path (the object of a ``sh:path`` triple) into
+    an RDFLib-friendly object.
+
+    A ``URIRef`` is returned when the path is a simple predicate, and a
+    :class:`Path` is returned for complex paths such as
+    ``[sh:inversePath skos:broader]``.
+
+    >>> from rdflib import BNode, Graph
+    >>> from rdflib.namespace import SH, SKOS
+    >>> g = Graph()
+    >>> p = BNode()
+    >>> g.add((p, SH.inversePath, SKOS.broader))
+    <Graph identifier=... (<class 'rdflib.graph.Graph'>)>
+    >>> shacl_path(g, p)
+    Path(~http://www.w3.org/2004/02/skos/core#broader)
+
+    :param graph: The graph containing the SHACL path description.
+    :param node: The node that is the value of ``sh:path``.
+    :raises ValueError: If the node is not a valid SHACL path.
+    """
+    # Imported here to avoid circular imports.
+    from rdflib.collection import Collection
+    from rdflib.namespace import RDF, SH
+
+    if isinstance(node, URIRef):
+        return node
+
+    def _single(predicate: URIRef) -> Optional[Node]:
+        values = list(graph.objects(node, predicate))
+        if len(values) > 1:
+            raise ValueError(f"SHACL path {node!r} has multiple {predicate} values")
+        return values[0] if values else None
+
+    def _list_items(head: Node) -> List[Union[URIRef, Path]]:
+        if head != RDF.nil and (head, RDF.first, None) not in graph:
+            raise ValueError(f"Expected an RDF list for SHACL path element {head!r}")
+        return [shacl_path(graph, item) for item in Collection(graph, head)]
+
+    # Exactly one path-type property must describe a complex path node.
+    kinds = [
+        (SH.inversePath, "inverse"),
+        (SH.alternativePath, "alternative"),
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ]
+    present = [(pred, kind) for pred, kind in kinds if _single(pred) is not None]
+
+    if len(present) > 1:
+        raise ValueError(f"SHACL path {node!r} has more than one path type")
+
+    if present:
+        pred, kind = present[0]
+        value = _single(pred)
+        assert value is not None
+        if kind == "inverse":
+            return InvPath(shacl_path(graph, value))
+        if kind == "alternative":
+            return AlternativePath(*_list_items(value))
+        return MulPath(shacl_path(graph, value), kind)
+
+    if (node, RDF.first, None) in graph:
+        return SequencePath(*_list_items(node))
+
+    raise ValueError(f"Invalid SHACL path: {node!r}")
+
+
 if __name__ == "__main__":
     pass
