@@ -142,3 +144,110 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+def _shacl_graph(turtle: str) -> Graph:
+    g = Graph()
+    g.parse(
+        data="@prefix sh: <http://www.w3.org/ns/shacl#> .\n"
+        "@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n"
+        "@prefix ex: <http://example.com/> .\n" + turtle,
+        format="turtle",
+    )
+    return g
+
+
+def _path_object(g: Graph) -> Node:
+    (obj,) = list(g.objects(ex.shape, SH.path))
+    return obj
+
+
+ex = Namespace("http://example.com/")
+
+
+@pytest.mark.parametrize(
+    ["turtle", "expected"],
+    [
+        (
+            "ex:shape sh:path skos:broader .",
+            URIRef("http://www.w3.org/2004/02/skos/core#broader"),
+        ),
+        (
+            "ex:shape sh:path [ sh:inversePath skos:broader ] .",
+            InvPath(URIRef("http://www.w3.org/2004/02/skos/core#broader")),
+        ),
+        (
+            "ex:shape sh:path [ sh:alternativePath ( skos:broader skos:narrower ) ] .",
+            AlternativePath(
+                URIRef("http://www.w3.org/2004/02/skos/core#broader"),
+                URIRef("http://www.w3.org/2004/02/skos/core#narrower"),
+            ),
+        ),
+        (
+            "ex:shape sh:path ( skos:broader skos:narrower ) .",
+            SequencePath(
+                URIRef("http://www.w3.org/2004/02/skos/core#broader"),
+                URIRef("http://www.w3.org/2004/02/skos/core#narrower"),
+            ),
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrMorePath skos:broader ] .",
+            MulPath(URIRef("http://www.w3.org/2004/02/skos/core#broader"), ZeroOrMore),
+        ),
+        (
+            "ex:shape sh:path [ sh:oneOrMorePath skos:broader ] .",
+            MulPath(URIRef("http://www.w3.org/2004/02/skos/core#broader"), OneOrMore),
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrOnePath skos:broader ] .",
+            MulPath(URIRef("http://www.w3.org/2004/02/skos/core#broader"), ZeroOrOne),
+        ),
+        (
+            "ex:shape sh:path [ sh:inversePath [ sh:oneOrMorePath skos:broader ] ] .",
+            InvPath(
+                MulPath(URIRef("http://www.w3.org/2004/02/skos/core#broader"), OneOrMore)
+            ),
+        ),
+    ],
+)
+def test_build_shacl_path(turtle: str, expected: Union[Path, URIRef]) -> None:
+    g = _shacl_graph(turtle)
+    result = build_shacl_path(g, _path_object(g))
+    assert result == expected
+    assert type(result) is type(expected)
+
+
+def test_build_shacl_path_n3() -> None:
+    g = _shacl_graph("ex:shape sh:path [ sh:inversePath skos:broader ] .")
+    path = build_shacl_path(g, _path_object(g))
+    assert isinstance(path, Path)
+    nsm = NamespaceManager(Graph())
+    nsm.bind("skos", "http://www.w3.org/2004/02/skos/core#")
+    assert path.n3(nsm) == "^skos:broader"
+
+
+def test_build_shacl_path_predicate_usable_in_graph() -> None:
+    g = _shacl_graph(
+        "ex:shape sh:path [ sh:inversePath skos:broader ] .\n"
+        "ex:a skos:broader ex:b .\n"
+    )
+    path = build_shacl_path(g, _path_object(g))
+    assert list(g.objects(URIRef("http://example.com/b"), path)) == [
+        URIRef("http://example.com/a")
+    ]
+
+
+@pytest.mark.parametrize(
+    "turtle",
+    [
+        "ex:shape sh:path \"not a path\" .",
+        "ex:shape sh:path [ sh:inversePath ( skos:broader ) ] .",
+        "ex:shape sh:path [ ex:unrelated skos:broader ] .",
+        "ex:shape sh:path [ sh:alternativePath () ] .",
+        "ex:shape sh:path ( skos:broader ) .",
+    ],
+)
+def test_build_shacl_path_invalid(turtle: str) -> None:
+    g = _shacl_graph(turtle)
+    with pytest.raises(ValueError):
+        build_shacl_path(g, _path_object(g))
