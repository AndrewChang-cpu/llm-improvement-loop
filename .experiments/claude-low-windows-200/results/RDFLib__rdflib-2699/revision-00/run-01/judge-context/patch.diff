+def build_shacl_path(graph: Graph, node: Node) -> Union[URIRef, Path]:
+    """
+    Convert the SHACL path value ``node`` (the object of ``sh:path`` in
+    ``graph``) into an RDFLib-friendly path object.
+
+    A plain IRI is returned unchanged (it is a path of length one). Complex
+    SHACL paths are converted recursively into :class:`Path` instances:
+
+    * ``[sh:inversePath p]`` becomes :class:`InvPath`
+    * ``[sh:alternativePath (p1 ... pn)]`` becomes :class:`AlternativePath`
+    * ``[sh:zeroOrMorePath p]``, ``[sh:oneOrMorePath p]`` and
+      ``[sh:zeroOrOnePath p]`` become :class:`MulPath`
+    * an RDF list ``(p1 ... pn)`` is a sequence path and becomes
+      :class:`SequencePath`
+
+    :raises ValueError: if ``node`` is not a valid SHACL path.
+
+    >>> from rdflib import Graph, BNode
+    >>> from rdflib.namespace import SH, SKOS
+    >>> g = Graph()
+    >>> b = BNode()
+    >>> _ = g.add((b, SH.inversePath, SKOS.broader))
+    >>> build_shacl_path(g, b)
+    Path(~http://www.w3.org/2004/02/skos/core#broader)
+    >>> build_shacl_path(g, SKOS.broader)
+    rdflib.term.URIRef('http://www.w3.org/2004/02/skos/core#broader')
+    """
+    from rdflib.collection import Collection
+    from rdflib.namespace import RDF, SH
+
+    if isinstance(node, URIRef):
+        return node
+
+    if not isinstance(node, BNode):
+        raise ValueError(f"Invalid SHACL path: {node!r}")
+
+    def _single(prop: URIRef) -> Optional[Node]:
+        values = list(graph.objects(node, prop))
+        if len(values) > 1:
+            raise ValueError(f"Multiple values for {prop} in SHACL path {node!r}")
+        return values[0] if values else None
+
+    inv = _single(SH.inversePath)
+    if inv is not None:
+        return InvPath(build_shacl_path(graph, inv))
+
+    alt = _single(SH.alternativePath)
+    if alt is not None:
+        items = list(Collection(graph, alt))
+        if not items:
+            raise ValueError(f"Empty sh:alternativePath in SHACL path {node!r}")
+        return AlternativePath(*[build_shacl_path(graph, i) for i in items])
+
+    for prop, mod in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        value = _single(prop)
+        if value is not None:
+            return MulPath(build_shacl_path(graph, value), mod)
+
+    if (node, RDF.first, None) in graph or node == RDF.nil:
+        items = list(Collection(graph, node))
+        if len(items) < 2:
+            raise ValueError(
+                f"A sequence SHACL path needs at least 2 elements: {node!r}"
+            )
+        return SequencePath(*[build_shacl_path(graph, i) for i in items])
+
+    raise ValueError(f"Invalid SHACL path: {node!r}")
+
+
 if __name__ == "__main__":
     pass
 else:
