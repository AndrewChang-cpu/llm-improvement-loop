index 6d70ee1..5423fcf 100644
--- a/rdflib/paths.py
+++ b/rdflib/paths.py
@@ -588,6 +588,93 @@ def neg_path(p: Union[URIRef, AlternativePath, InvPath]) -> NegatedPath:
     return NegatedPath(p)
 
 
+# SHACL property path vocabulary (https://www.w3.org/TR/shacl/#property-paths)
+_SH = "http://www.w3.org/ns/shacl#"
+_SH_INVERSE_PATH = URIRef(_SH + "inversePath")
+_SH_ALTERNATIVE_PATH = URIRef(_SH + "alternativePath")
+_SH_ZERO_OR_MORE_PATH = URIRef(_SH + "zeroOrMorePath")
+_SH_ONE_OR_MORE_PATH = URIRef(_SH + "oneOrMorePath")
+_SH_ZERO_OR_ONE_PATH = URIRef(_SH + "zeroOrOnePath")
+_SHACL_COMPLEX_PATH_PREDICATES = (
+    _SH_INVERSE_PATH,
+    _SH_ALTERNATIVE_PATH,
+    _SH_ZERO_OR_MORE_PATH,
+    _SH_ONE_OR_MORE_PATH,
+    _SH_ZERO_OR_ONE_PATH,
+)
+
+
+def shacl_path_to_rdflib(
+    graph: Graph, node: Node
+) -> Union[URIRef, Path]:
+    """
+    Convert a SHACL path (the object of an ``sh:path`` triple) into an
+    RDFLib-friendly path.
+
+    A simple predicate path is returned as the :class:`~rdflib.term.URIRef`
+    itself. Complex paths (``sh:inversePath``, ``sh:alternativePath``,
+    ``sh:zeroOrMorePath``, ``sh:oneOrMorePath``, ``sh:zeroOrOnePath``, and
+    RDF lists denoting sequence paths) are returned as :class:`Path`
+    instances which can be used with the graph methods.
+
+    >>> from rdflib import Graph, Namespace, BNode
+    >>> from rdflib.namespace import SKOS
+    >>> g = Graph()
+    >>> ex = Namespace("http://example.org/")
+    >>> p = BNode()
+    >>> _ = g.add((p, _SH_INVERSE_PATH, SKOS.broader))
+    >>> shacl_path_to_rdflib(g, p)
+    Path(~http://www.w3.org/2004/02/skos/core#broader)
+    >>> shacl_path_to_rdflib(g, ex.name)
+    rdflib.term.URIRef('http://example.org/name')
+
+    :param graph: the graph containing the SHACL path description
+    :param node: the node which is the object of ``sh:path``
+    :raises ValueError: if the node is not a valid SHACL path
+    """
+    if isinstance(node, URIRef):
+        return node
+
+    if not isinstance(node, Node):
+        raise ValueError(f"Invalid SHACL path node: {node!r}")
+
+    used = [p for p in _SHACL_COMPLEX_PATH_PREDICATES if (node, p, None) in graph]
+    if len(used) > 1:
+        raise ValueError(f"SHACL path {node!r} has multiple path types: {used}")
+
+    if not used:
+        # Not a complex path: must be an RDF list denoting a sequence path
+        items = list(graph.items(node)) if node != _RDF_NIL else []
+        if not items:
+            raise ValueError(f"Invalid SHACL path: {node!r}")
+        return SequencePath(*[shacl_path_to_rdflib(graph, i) for i in items])
+
+    predicate = used[0]
+    value = graph.value(node, predicate)
+    if predicate == _SH_INVERSE_PATH:
+        return InvPath(_shacl_path_arg(graph, value))
+    if predicate == _SH_ALTERNATIVE_PATH:
+        items = list(graph.items(value)) if value != _RDF_NIL else []
+        if len(items) < 1:
+            raise ValueError(f"Invalid sh:alternativePath list: {value!r}")
+        return AlternativePath(*[shacl_path_to_rdflib(graph, i) for i in items])
+    mod = {
+        _SH_ZERO_OR_MORE_PATH: ZeroOrMore,
+        _SH_ONE_OR_MORE_PATH: OneOrMore,
+        _SH_ZERO_OR_ONE_PATH: ZeroOrOne,
+    }[predicate]
+    return MulPath(_shacl_path_arg(graph, value), mod)
+
+
+def _shacl_path_arg(graph: Graph, node: Optional[Node]) -> Union[URIRef, Path]:
+    if node is None:
+        raise ValueError("Missing operand in SHACL path")
+    return shacl_path_to_rdflib(graph, node)
+
+
+_RDF_NIL = URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#nil")
+
+
 if __name__ == "__main__":
     pass
 else:
diff --git a/test/test_path.py b/test/test_path.py
index 1af0227..8c092f3 100644
--- a/test/test_path.py
+++ b/test/test_path.py
@@ -5,7 +5,7 @@ from typing import Union
 
 import pytest
 
-from rdflib import RDF, RDFS, Graph, URIRef
+from rdflib import RDF, RDFS, Graph, Namespace, URIRef
 from rdflib.namespace import DCAT, DCTERMS
 from rdflib.paths import (
     AlternativePath,
@@ -17,6 +17,7 @@ from rdflib.paths import (
     SequencePath,
     ZeroOrMore,
     ZeroOrOne,
+    shacl_path_to_rdflib,
 )
 
 g = Graph()
@@ -142,3 +143,101 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+SH = Namespace("http://www.w3.org/ns/shacl#")
+EX = Namespace("http://example.org/")
+
+
+def _shacl_graph(triples_ttl: str) -> Graph:
+    prefix = "@prefix sh: <http://www.w3.org/ns/shacl#> .\n"
+    prefix += "@prefix ex: <http://example.org/> .\n"
+    prefix += "@prefix skos: <http://www.w3.org/2004/02/skos/core#> .\n"
+    prefix += "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .\n"
+    return Graph().parse(data=prefix + triples_ttl, format="turtle")
+
+
+def test_shacl_simple_predicate_path() -> None:
+    g = _shacl_graph("")
+    assert shacl_path_to_rdflib(g, EX.name) == EX.name
+    assert isinstance(shacl_path_to_rdflib(g, EX.name), URIRef)
+
+
+def test_shacl_inverse_path() -> None:
+    g = _shacl_graph("ex:shape sh:path [ sh:inversePath skos:broader ] .")
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert isinstance(path, InvPath)
+    assert path.arg == URIRef("http://www.w3.org/2004/02/skos/core#broader")
+
+
+def test_shacl_zero_or_more_path() -> None:
+    g = _shacl_graph("ex:shape sh:path [ sh:zeroOrMorePath ex:p ] .")
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert isinstance(path, MulPath)
+    assert path.path == EX.p
+    assert path.mod == ZeroOrMore
+
+
+def test_shacl_one_or_more_path() -> None:
+    g = _shacl_graph("ex:shape sh:path [ sh:oneOrMorePath ex:p ] .")
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert isinstance(path, MulPath)
+    assert path.mod == OneOrMore
+
+
+def test_shacl_zero_or_one_path() -> None:
+    g = _shacl_graph("ex:shape sh:path [ sh:zeroOrOnePath ex:p ] .")
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert isinstance(path, MulPath)
+    assert path.mod == ZeroOrOne
+
+
+def test_shacl_alternative_path() -> None:
+    g = _shacl_graph("ex:shape sh:path [ sh:alternativePath ( ex:p ex:q ) ] .")
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert isinstance(path, AlternativePath)
+    assert path.args == [EX.p, EX.q]
+
+
+def test_shacl_sequence_path() -> None:
+    g = _shacl_graph("ex:shape sh:path ( ex:p ex:q ) .")
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert isinstance(path, SequencePath)
+    assert path.args == [EX.p, EX.q]
+
+
+def test_shacl_nested_path() -> None:
+    g = _shacl_graph(
+        "ex:shape sh:path ( ex:p [ sh:inversePath [ sh:oneOrMorePath ex:q ] ] ) ."
+    )
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert isinstance(path, SequencePath)
+    assert path.args[0] == EX.p
+    inv = path.args[1]
+    assert isinstance(inv, InvPath)
+    assert isinstance(inv.arg, MulPath)
+    assert inv.arg.path == EX.q
+    assert inv.arg.mod == OneOrMore
+
+
+def test_shacl_path_usable_with_graph() -> None:
+    g = _shacl_graph(
+        """
+        ex:a ex:p ex:b .
+        ex:b ex:p ex:c .
+        ex:shape sh:path [ sh:oneOrMorePath ex:p ] .
+        """
+    )
+    path = shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    assert set(g.objects(EX.a, path)) == {EX.b, EX.c}
+
+
+def test_shacl_invalid_path_raises() -> None:
+    g = _shacl_graph(
+        "ex:shape sh:path [ sh:inversePath ex:p ; sh:oneOrMorePath ex:q ] ."
+    )
+    with pytest.raises(ValueError):
+        shacl_path_to_rdflib(g, g.value(EX.shape, SH.path))
+    g2 = _shacl_graph("ex:shape sh:path [ ex:unrelated ex:p ] .")
+    with pytest.raises(ValueError):
+        shacl_path_to_rdflib(g2, g2.value(EX.shape, SH.path))
