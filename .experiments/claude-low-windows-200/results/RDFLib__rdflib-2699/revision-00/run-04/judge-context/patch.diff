diff --git a/rdflib/paths.py b/rdflib/paths.py
index 6d70ee1..ade850b 100644
--- a/rdflib/paths.py
+++ b/rdflib/paths.py
@@ -197,7 +197,7 @@ from typing import (
     Union,
 )
 
-from rdflib.term import Node, URIRef
+from rdflib.term import BNode, Node, URIRef
 
 if TYPE_CHECKING:
     from rdflib._type_checking import _MulPathMod
@@ -588,6 +588,61 @@ def neg_path(p: Union[URIRef, AlternativePath, InvPath]) -> NegatedPath:
     return NegatedPath(p)
 
 
+_SH = "http://www.w3.org/ns/shacl#"
+_RDF_FIRST = URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#first")
+_SH_INVERSE_PATH = URIRef(_SH + "inversePath")
+_SH_ALTERNATIVE_PATH = URIRef(_SH + "alternativePath")
+_SH_ZERO_OR_MORE_PATH = URIRef(_SH + "zeroOrMorePath")
+_SH_ONE_OR_MORE_PATH = URIRef(_SH + "oneOrMorePath")
+_SH_ZERO_OR_ONE_PATH = URIRef(_SH + "zeroOrOnePath")
+
+
+def shacl_path(graph: Graph, node: Node) -> Union[URIRef, Path]:
+    """
+    Convert a SHACL path, given as a node in ``graph``, into an RDFLib path.
+
+    ``node`` is typically the object of a ``sh:path`` triple. The result is a
+    ``URIRef`` when the path is a simple predicate, or a :class:`Path` when the
+    path is complex (e.g. ``[sh:inversePath skos:broader]``).
+
+    See https://www.w3.org/TR/shacl/#property-paths
+
+    :raises ValueError: if ``node`` is not a valid SHACL path.
+    """
+    if isinstance(node, URIRef):
+        return node
+    if not isinstance(node, BNode):
+        raise ValueError(f"Invalid SHACL path node: {node!r}")
+
+    inv = graph.value(node, _SH_INVERSE_PATH)
+    if inv is not None:
+        return InvPath(shacl_path(graph, inv))
+
+    alt = graph.value(node, _SH_ALTERNATIVE_PATH)
+    if alt is not None:
+        items = [shacl_path(graph, i) for i in graph.items(alt)]
+        if len(items) < 2:
+            raise ValueError("sh:alternativePath requires at least two paths")
+        return AlternativePath(*items)
+
+    for pred, mod in (
+        (_SH_ZERO_OR_MORE_PATH, ZeroOrMore),
+        (_SH_ONE_OR_MORE_PATH, OneOrMore),
+        (_SH_ZERO_OR_ONE_PATH, ZeroOrOne),
+    ):
+        inner = graph.value(node, pred)
+        if inner is not None:
+            return MulPath(shacl_path(graph, inner), mod)
+
+    if (node, _RDF_FIRST, None) in graph:
+        items = [shacl_path(graph, i) for i in graph.items(node)]
+        if len(items) < 2:
+            raise ValueError("A SHACL sequence path requires at least two paths")
+        return SequencePath(*items)
+
+    raise ValueError(f"Invalid SHACL path node: {node!r}")
+
+
 if __name__ == "__main__":
     pass
 else:
diff --git a/test/test_path.py b/test/test_path.py
index 1af0227..efe50db 100644
--- a/test/test_path.py
+++ b/test/test_path.py
@@ -142,3 +142,81 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+SHACL_PREFIXES = """
+@prefix sh: <http://www.w3.org/ns/shacl#> .
+@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
+@prefix ex: <http://example.com/> .
+@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
+"""
+
+
+def _shacl_path_from_turtle(body: str) -> Union[URIRef, Path]:
+    from rdflib.paths import shacl_path
+    from rdflib.namespace import SH
+
+    g = Graph().parse(data=SHACL_PREFIXES + body, format="turtle")
+    node = g.value(URIRef("http://example.com/shape"), SH.path)
+    assert node is not None
+    return shacl_path(g, node)
+
+
+@pytest.mark.parametrize(
+    "body, expected",
+    [
+        (
+            "ex:shape sh:path skos:broader .",
+            URIRef("http://www.w3.org/2004/02/skos/core#broader"),
+        ),
+        (
+            "ex:shape sh:path [ sh:inversePath skos:broader ] .",
+            ~URIRef("http://www.w3.org/2004/02/skos/core#broader"),
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrMorePath ex:p ] .",
+            URIRef("http://example.com/p") * ZeroOrMore,
+        ),
+        (
+            "ex:shape sh:path [ sh:oneOrMorePath ex:p ] .",
+            URIRef("http://example.com/p") * OneOrMore,
+        ),
+        (
+            "ex:shape sh:path [ sh:zeroOrOnePath ex:p ] .",
+            URIRef("http://example.com/p") * ZeroOrOne,
+        ),
+        (
+            "ex:shape sh:path [ sh:alternativePath ( ex:p ex:q ) ] .",
+            AlternativePath(URIRef("http://example.com/p"), URIRef("http://example.com/q")),
+        ),
+        (
+            "ex:shape sh:path ( ex:p ex:q ) .",
+            SequencePath(URIRef("http://example.com/p"), URIRef("http://example.com/q")),
+        ),
+        (
+            "ex:shape sh:path [ sh:inversePath [ sh:zeroOrMorePath ex:p ] ] .",
+            ~(URIRef("http://example.com/p") * ZeroOrMore),
+        ),
+    ],
+)
+def test_shacl_path(body: str, expected: Union[URIRef, Path]) -> None:
+    result = _shacl_path_from_turtle(body)
+    assert result == expected
+    assert type(result) is type(expected)
+
+
+def test_shacl_path_n3() -> None:
+    path = _shacl_path_from_turtle("ex:shape sh:path [ sh:inversePath skos:broader ] .")
+    assert path.n3(nsm) == "^skos:broader"
+
+
+def test_shacl_path_invalid() -> None:
+    from rdflib.paths import shacl_path
+
+    g = Graph().parse(
+        data=SHACL_PREFIXES + "ex:shape sh:path [ sh:alternativePath ( ex:p ) ] .",
+        format="turtle",
+    )
+    node = g.value(URIRef("http://example.com/shape"), URIRef("http://www.w3.org/ns/shacl#path"))
+    with pytest.raises(ValueError):
+        shacl_path(g, node)
