+SKOS_BROADER = URIRef("http://www.w3.org/2004/02/skos/core#broader")
+SKOS_NARROWER = URIRef("http://www.w3.org/2004/02/skos/core#narrower")
+
 
 @pytest.mark.parametrize(
     "path, no_nsm, with_nsm",
@@ -142,3 +145,111 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+SH_NS = "http://www.w3.org/ns/shacl#"
+
+
+def _shacl_graph(turtle: str) -> Graph:
+    g = Graph()
+    g.parse(
+        data=f"@prefix sh: <{SH_NS}> . @prefix ex: <http://example.org/> . "
+        "@prefix skos: <http://www.w3.org/2004/02/skos/core#> . "
+        "@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> . "
+        + turtle,
+        format="turtle",
+    )
+    return g
+
+
+@pytest.mark.parametrize(
+    "turtle, expected",
+    [
+        ("ex:s sh:path skos:broader .", SKOS_BROADER),
+        ("ex:s sh:path [ sh:inversePath skos:broader ] .", ~SKOS_BROADER),
+        (
+            "ex:s sh:path [ sh:zeroOrMorePath skos:broader ] .",
+            SKOS_BROADER * ZeroOrMore,
+        ),
+        (
+            "ex:s sh:path [ sh:oneOrMorePath skos:broader ] .",
+            SKOS_BROADER * OneOrMore,
+        ),
+        (
+            "ex:s sh:path [ sh:zeroOrOnePath skos:broader ] .",
+            SKOS_BROADER * ZeroOrOne,
+        ),
+        (
+            "ex:s sh:path [ sh:alternativePath ( skos:broader skos:narrower ) ] .",
+            AlternativePath(SKOS_BROADER, SKOS_NARROWER),
+        ),
+        (
+            "ex:s sh:path ( skos:broader skos:narrower ) .",
+            SequencePath(SKOS_BROADER, SKOS_NARROWER),
+        ),
+        (
+            "ex:s sh:path [ sh:inversePath [ sh:alternativePath "
+            "( skos:broader [ sh:zeroOrMorePath skos:narrower ] ) ] ] .",
+            ~AlternativePath(
+                SKOS_BROADER, SKOS_NARROWER * ZeroOrMore
+            ),
+        ),
+    ],
+)
+def test_parse_shacl_path(turtle: str, expected: Union[URIRef, Path]) -> None:
+    from rdflib.paths import parse_shacl_path
+
+    g = _shacl_graph(turtle)
+    value = g.value(URIRef("http://example.org/s"), SH.path)
+    result = parse_shacl_path(g, value)
+    assert result == expected
+    assert result is not None
+
+
+def test_parse_shacl_path_uriref_returned_as_is() -> None:
+    from rdflib.paths import parse_shacl_path
+
+    g = _shacl_graph("ex:s sh:path skos:broader .")
+    value = g.value(URIRef("http://example.org/s"), SH.path)
+    assert isinstance(parse_shacl_path(g, value), URIRef)
+
+
+def test_parse_shacl_path_n3() -> None:
+    from rdflib.paths import parse_shacl_path
+
+    g = _shacl_graph("ex:s sh:path [ sh:inversePath skos:broader ] .")
+    value = g.value(URIRef("http://example.org/s"), SH.path)
+    path = parse_shacl_path(g, value)
+    assert path.n3(g.namespace_manager) == "^skos:broader"
+
+
+def test_parse_shacl_path_usable_in_graph_value() -> None:
+    from rdflib.paths import parse_shacl_path
+
+    g = _shacl_graph(
+        "ex:s sh:path [ sh:inversePath skos:broader ] .\n"
+        "ex:parent skos:broader ex:s .\n"
+    )
+    value = g.value(URIRef("http://example.org/s"), SH.path)
+    path = parse_shacl_path(g, value)
+    assert g.value(URIRef("http://example.org/s"), path) == URIRef(
+        "http://example.org/parent"
+    )
+
+
+@pytest.mark.parametrize(
+    "turtle",
+    [
+        "ex:s sh:path \"not a path\" .",
+        "ex:s sh:path [ ex:unrelated ex:x ] .",
+        "ex:s sh:path [ sh:alternativePath rdf:nil ] .",
+        "ex:s sh:path [ sh:inversePath skos:broader ; sh:inversePath skos:narrower ] .",
+    ],
+)
+def test_parse_shacl_path_invalid(turtle: str) -> None:
+    from rdflib.paths import parse_shacl_path
+
+    g = _shacl_graph(turtle)
+    value = g.value(URIRef("http://example.org/s"), SH.path)
+    with pytest.raises(ValueError):
+        parse_shacl_path(g, value)
