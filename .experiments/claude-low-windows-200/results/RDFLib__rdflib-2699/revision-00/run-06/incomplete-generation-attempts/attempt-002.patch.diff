 if TYPE_CHECKING:
     from rdflib._type_checking import _MulPathMod
@@ -588,6 +588,73 @@ def neg_path(p: Union[URIRef, AlternativePath, InvPath]) -> NegatedPath:
     return NegatedPath(p)
 
 
+_SHACL = "http://www.w3.org/ns/shacl#"
+_SH_INVERSE_PATH = URIRef(_SHACL + "inversePath")
+_SH_ALTERNATIVE_PATH = URIRef(_SHACL + "alternativePath")
+_SH_ZERO_OR_MORE_PATH = URIRef(_SHACL + "zeroOrMorePath")
+_SH_ONE_OR_MORE_PATH = URIRef(_SHACL + "oneOrMorePath")
+_SH_ZERO_OR_ONE_PATH = URIRef(_SHACL + "zeroOrOnePath")
+_RDF_FIRST = URIRef("http://www.w3.org/1999/02/22-rdf-syntax-ns#first")
+
+
+def parse_shacl_path(graph: Graph, value: Node) -> Union[URIRef, Path]:
+    """
+    Parse a SHACL path, as found in the object of a ``sh:path`` triple,
+    into an RDFLib-friendly object.
+
+    A plain IRI (a simple predicate path) is returned as a :class:`URIRef`.
+    Complex paths are returned as :class:`Path` instances, e.g.
+    ``[sh:inversePath skos:broader]`` becomes ``InvPath(skos:broader)``.
+
+    Lists (``sh:alternativePath`` and sequence paths) are read as RDF lists
+    from ``graph``.
+
+    :param graph: the graph containing the SHACL path description
+    :param value: the node which is the value of ``sh:path``
+    :raises ValueError: if the value is not a valid SHACL path
+    """
+    if isinstance(value, URIRef):
+        return value
+
+    if not isinstance(value, BNode):
+        raise ValueError(f"Invalid SHACL path: {value!r}")
+
+    def _single(pred: URIRef) -> Optional[Node]:
+        objs = list(graph.objects(value, pred))
+        if len(objs) > 1:
+            raise ValueError(f"Ambiguous SHACL path {value!r}: multiple {pred}")
+        return objs[0] if objs else None
+
+    inv = _single(_SH_INVERSE_PATH)
+    if inv is not None:
+        return InvPath(parse_shacl_path(graph, inv))
+
+    for pred, mod in (
+        (_SH_ZERO_OR_MORE_PATH, ZeroOrMore),
+        (_SH_ONE_OR_MORE_PATH, OneOrMore),
+        (_SH_ZERO_OR_ONE_PATH, ZeroOrOne),
+    ):
+        inner = _single(pred)
+        if inner is not None:
+            return MulPath(parse_shacl_path(graph, inner), mod)  # type: ignore[arg-type]
+
+    alt = _single(_SH_ALTERNATIVE_PATH)
+    if alt is not None:
+        items = [parse_shacl_path(graph, i) for i in graph.items(alt)]
+        if not items:
+            raise ValueError(f"Empty sh:alternativePath list in {value!r}")
+        return AlternativePath(*items)
+
+    # Otherwise the node must be an RDF list describing a sequence path.
+    if graph.value(value, _RDF_FIRST) is not None:
+        items = [parse_shacl_path(graph, i) for i in graph.items(value)]
+        if not items:
+            raise ValueError(f"Empty sequence path in {value!r}")
+        return SequencePath(*items)
+
+    raise ValueError(f"Invalid SHACL path: {value!r}")
+
+
 if __name__ == "__main__":
     pass
 else:
