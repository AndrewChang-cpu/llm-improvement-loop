@@ -142,3 +142,121 @@ def test_hash(lhs: Path, rhs: Path) -> None:
 def test_dict_key(insert_path: Path, check_path: Path) -> None:
     d = {insert_path: "foo"}
     assert d[check_path] == "foo"
+
+
+@pytest.mark.parametrize(
+    ["shacl_turtle", "expected"],
+    [
+        # predicate path
+        ("<ex:p>", URIRef("ex:p")),
+        # inverse path
+        ("[ sh:inversePath <ex:p> ]", None),
+        # sequence path
+        ("( <ex:p> <ex:q> )", None),
+        # alternative path
+        ("[ sh:alternativePath ( <ex:p> <ex:q> ) ]", None),
+        # modifiers
+        ("[ sh:zeroOrMorePath <ex:p> ]", None),
+        ("[ sh:oneOrMorePath <ex:p> ]", None),
+        ("[ sh:zeroOrOnePath <ex:p> ]", None),
+        # nested
+        ("( [ sh:inversePath <ex:p> ] [ sh:zeroOrMorePath <ex:q> ] )", None),
+    ],
+)
+def test_shacl_path(shacl_turtle: str, expected: Any) -> None:
+    from rdflib.paths import shacl_path
+
+    g = Graph()
+    g.parse(
+        data=f"""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <ex:> .
+        ex:shape sh:path {shacl_turtle} .
+        """,
+        format="turtle",
+    )
+    node = g.value(URIRef("ex:shape"), SH.path)
+    assert node is not None
+    result = shacl_path(g, node)
+    if expected is not None:
+        assert result == expected
+    else:
+        assert isinstance(result, Path)
+
+
+def test_shacl_path_structures() -> None:
+    from rdflib.paths import shacl_path
+
+    ex = Namespace("ex:")
+    g = Graph()
+    g.parse(
+        data="""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <ex:> .
+        ex:s1 sh:path [ sh:inversePath ex:p ] .
+        ex:s2 sh:path ( ex:p ex:q ) .
+        ex:s3 sh:path [ sh:alternativePath ( ex:p ex:q ) ] .
+        ex:s4 sh:path [ sh:zeroOrMorePath ex:p ] .
+        ex:s5 sh:path [ sh:oneOrMorePath ex:p ] .
+        ex:s6 sh:path [ sh:zeroOrOnePath ex:p ] .
+        ex:s7 sh:path ( [ sh:inversePath ex:p ] [ sh:zeroOrMorePath ex:q ] ) .
+        """,
+        format="turtle",
+    )
+
+    def path_of(name: str):
+        return shacl_path(g, g.value(ex[name], SH.path))
+
+    assert path_of("s1") == InvPath(ex.p)
+    assert path_of("s2") == SequencePath(ex.p, ex.q)
+    assert path_of("s3") == AlternativePath(ex.p, ex.q)
+    assert path_of("s4") == MulPath(ex.p, ZeroOrMore)
+    assert path_of("s5") == MulPath(ex.p, OneOrMore)
+    assert path_of("s6") == MulPath(ex.p, ZeroOrOne)
+    assert path_of("s7") == SequencePath(
+        InvPath(ex.p), MulPath(ex.q, ZeroOrMore)
+    )
+
+
+def test_shacl_path_evaluates() -> None:
+    from rdflib.paths import shacl_path
+
+    ex = Namespace("ex:")
+    g = Graph()
+    g.parse(
+        data="""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <ex:> .
+        ex:shape sh:path ( ex:p [ sh:inversePath ex:q ] ) .
+        ex:a ex:p ex:b .
+        ex:c ex:q ex:b .
+        """,
+        format="turtle",
+    )
+    path = shacl_path(g, g.value(ex.shape, SH.path))
+    assert list(g.objects(ex.a, path)) == [ex.c]
+
+
+@pytest.mark.parametrize(
+    "shacl_turtle",
+    [
+        "[ sh:inversePath ( ) ]",
+        "[ sh:unknownPath <ex:p> ]",
+        "( )",
+    ],
+)
+def test_shacl_path_invalid(shacl_turtle: str) -> None:
+    from rdflib.paths import shacl_path
+
+    g = Graph()
+    g.parse(
+        data=f"""
+        @prefix sh: <http://www.w3.org/ns/shacl#> .
+        @prefix ex: <ex:> .
+        ex:shape sh:path {shacl_turtle} .
+        """,
+        format="turtle",
+    )
+    node = g.value(URIRef("ex:shape"), SH.path)
+    with pytest.raises(ValueError):
+        shacl_path(g, node)
