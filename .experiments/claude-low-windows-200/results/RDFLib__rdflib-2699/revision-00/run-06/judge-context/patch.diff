+def shacl_path(graph: Graph, node: Node) -> Union[URIRef, Path]:
+    """
+    Convert a SHACL path, as found in the object of a ``sh:path`` triple,
+    into an RDFLib-friendly path.
+
+    A predicate path (an IRI) is returned as the ``URIRef`` itself. Complex
+    paths are returned as the corresponding :class:`Path` object:
+
+    * ``[sh:inversePath p]`` becomes :class:`InvPath`
+    * an RDF list of paths becomes :class:`SequencePath`
+    * ``[sh:alternativePath (p1 p2 ...)]`` becomes :class:`AlternativePath`
+    * ``[sh:zeroOrMorePath p]``, ``[sh:oneOrMorePath p]`` and
+      ``[sh:zeroOrOnePath p]`` become :class:`MulPath` with ``*``, ``+``
+      and ``?`` respectively
+
+    :param graph: the graph containing the SHACL path description.
+    :param node: the value of the ``sh:path`` predicate.
+    :raises ValueError: if the node is not a valid SHACL path.
+
+    >>> from rdflib import BNode, Graph
+    >>> from rdflib.namespace import SH, SKOS
+    >>> g = Graph()
+    >>> inv = BNode()
+    >>> _ = g.add((inv, SH.inversePath, SKOS.broader))
+    >>> shacl_path(g, inv)
+    Path(~http://www.w3.org/2004/02/skos/core#broader)
+    >>> shacl_path(g, SKOS.broader)
+    rdflib.term.URIRef('http://www.w3.org/2004/02/skos/core#broader')
+    """
+    # local imports avoid circular imports with rdflib.collection / namespace
+    from rdflib.collection import Collection
+    from rdflib.namespace import RDF, SH
+
+    if node == RDF.nil:
+        raise ValueError("Empty SHACL path list is not a valid SHACL path")
+
+    if isinstance(node, URIRef):
+        return node
+
+    def _single(pred: URIRef) -> Optional[Node]:
+        values = list(graph.objects(node, pred))
+        if len(values) > 1:
+            raise ValueError(f"Multiple values for {pred} on SHACL path {node}")
+        return values[0] if values else None
+
+    inv_arg = _single(SH.inversePath)
+    if inv_arg is not None:
+        return InvPath(shacl_path(graph, inv_arg))
+
+    alt_list = _single(SH.alternativePath)
+    if alt_list is not None:
+        return AlternativePath(
+            *[shacl_path(graph, n) for n in Collection(graph, alt_list)]
+        )
+
+    for pred, mod in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        arg = _single(pred)
+        if arg is not None:
+            return MulPath(shacl_path(graph, arg), mod)
+
+    if _single(RDF.first) is not None:
+        items = list(Collection(graph, node))
+        if len(items) == 1:
+            return shacl_path(graph, items[0])
+        return SequencePath(*[shacl_path(graph, n) for n in items])
+
+    raise ValueError(f"{node!r} is not a valid SHACL path")
+
+
