+def parse_shacl_path(graph: Graph, node: Node) -> Union[URIRef, Path]:
+    """
+    Parse a SHACL property path, as found in the object of a ``sh:path``
+    triple, into an RDFLib-friendly path object.
+
+    A plain IRI is returned as-is (a path of length one). Complex SHACL
+    paths are returned as :class:`Path` instances, as described in
+    https://www.w3.org/TR/shacl/#property-paths
+
+    >>> from rdflib import BNode, Graph
+    >>> from rdflib.namespace import SH, SKOS
+    >>> g = Graph()
+    >>> p = BNode()
+    >>> _ = g.add((p, SH.inversePath, SKOS.broader))
+    >>> parse_shacl_path(g, p)
+    Path(~http://www.w3.org/2004/02/skos/core#broader)
+
+    :param graph: the graph containing the SHACL path description.
+    :param node: the node that is the object of the ``sh:path`` triple.
+    :raises ValueError: if the node does not describe a valid SHACL path.
+    """
+    from rdflib.namespace import RDF, SH
+
+    if isinstance(node, URIRef):
+        return node
+    if not isinstance(node, Node):
+        raise ValueError(f"Invalid SHACL path node: {node!r}")
+
+    def _list_items(head: Node) -> List[Union[URIRef, Path]]:
+        items: List[Union[URIRef, Path]] = []
+        current: Node = head
+        seen: Set[Node] = set()
+        while current != RDF.nil:
+            if current in seen:
+                raise ValueError("Cyclic RDF list in SHACL path")
+            seen.add(current)
+            first = graph.value(current, RDF.first)
+            rest = graph.value(current, RDF.rest)
+            if first is None or rest is None:
+                raise ValueError(f"Malformed RDF list in SHACL path: {current!r}")
+            items.append(parse_shacl_path(graph, first))
+            current = rest
+        if not items:
+            raise ValueError("Empty RDF list in SHACL path")
+        return items
+
+    inverse = graph.value(node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(parse_shacl_path(graph, inverse))
+
+    alternative = graph.value(node, SH.alternativePath)
+    if alternative is not None:
+        return AlternativePath(*_list_items(alternative))
+
+    for pred, mod in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        arg = graph.value(node, pred)
+        if arg is not None:
+            return MulPath(parse_shacl_path(graph, arg), mod)
+
+    if isinstance(node, BNode) and (node, RDF.first, None) in graph:
+        return SequencePath(*_list_items(node))
+
+    raise ValueError(f"Not a valid SHACL path: {node!r}")
+
+
 if __name__ == "__main__":
     pass
