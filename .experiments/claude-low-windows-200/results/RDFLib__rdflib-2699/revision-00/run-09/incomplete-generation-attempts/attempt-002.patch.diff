+def test_parse_shacl_path_iri() -> None:
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    assert parse_shacl_path(g, SKOS.broader) == SKOS.broader
+
+
+def test_parse_shacl_path_inverse() -> None:
+    from rdflib import BNode
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    p = BNode()
+    g.add((p, SH.inversePath, SKOS.broader))
+    assert parse_shacl_path(g, p) == InvPath(SKOS.broader)
+
+
+def test_parse_shacl_path_sequence_and_alternative() -> None:
+    from rdflib import BNode
+    from rdflib.collection import Collection
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    seq = BNode()
+    Collection(g, seq, [SKOS.broader, SKOS.narrower])
+    assert parse_shacl_path(g, seq) == SequencePath(SKOS.broader, SKOS.narrower)
+
+    alt_list = BNode()
+    Collection(g, alt_list, [SKOS.broader, SKOS.narrower])
+    alt = BNode()
+    g.add((alt, SH.alternativePath, alt_list))
+    assert parse_shacl_path(g, alt) == AlternativePath(SKOS.broader, SKOS.narrower)
+
+
+@pytest.mark.parametrize(
+    "predicate, mod",
+    [
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ],
+)
+def test_parse_shacl_path_modifiers(predicate: URIRef, mod: str) -> None:
+    from rdflib import BNode
+    from rdflib.namespace import SKOS
+    from rdflib.paths import MulPath, parse_shacl_path
+
+    g = Graph()
+    p = BNode()
+    g.add((p, predicate, SKOS.broader))
+    assert parse_shacl_path(g, p) == MulPath(SKOS.broader, mod)
+
+
+def test_parse_shacl_path_nested() -> None:
+    from rdflib import BNode
+    from rdflib.namespace import SH, SKOS
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    inv = BNode()
+    g.add((inv, SH.inversePath, SKOS.broader))
+    star = BNode()
+    g.add((star, SH.zeroOrMorePath, inv))
+    assert parse_shacl_path(g, star) == MulPath(InvPath(SKOS.broader), ZeroOrMore)
+
+
+def test_parse_shacl_path_invalid() -> None:
+    from rdflib import BNode
+    from rdflib.paths import parse_shacl_path
+
+    g = Graph()
+    with pytest.raises(ValueError):
+        parse_shacl_path(g, BNode())
