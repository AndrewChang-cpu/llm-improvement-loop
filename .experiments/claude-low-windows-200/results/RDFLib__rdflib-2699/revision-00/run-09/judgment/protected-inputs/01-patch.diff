+def shacl_path_to_rdflib(
+    graph: Graph, node: Node
+) -> Union[URIRef, Path]:
+    """
+    Convert the value of a SHACL ``sh:path`` (a node in ``graph``) into an
+    RDFLib-friendly object.
+
+    The result is a :class:`~rdflib.term.URIRef` when the path is simply a
+    predicate, otherwise a :class:`Path` (inverse, sequence, alternative or
+    cardinality path) built from the SHACL path structure.
+
+    >>> from rdflib import Graph, Namespace, BNode, URIRef
+    >>> from rdflib.namespace import RDF, SH
+    >>> ex = Namespace("http://example.org/")
+    >>> g = Graph()
+    >>> inv = BNode()
+    >>> _ = g.add((inv, SH.inversePath, ex.broader))
+    >>> shacl_path_to_rdflib(g, inv)
+    Path(~http://example.org/broader)
+    >>> shacl_path_to_rdflib(g, ex.name)
+    rdflib.term.URIRef('http://example.org/name')
+
+    :raises ValueError: if ``node`` is not a valid SHACL path.
+    """
+    from rdflib.namespace import RDF, SH
+
+    if not isinstance(node, Node) or node == RDF.nil:
+        raise ValueError(f"Not a valid SHACL path node: {node!r}")
+    if isinstance(node, URIRef):
+        return node
+
+    def _list_items(head: Node) -> List[Node]:
+        items: List[Node] = []
+        seen: Set[Node] = set()
+        current: Node = head
+        while current != RDF.nil:
+            if current in seen:
+                raise ValueError(f"Cyclic RDF list in SHACL path: {head!r}")
+            seen.add(current)
+            first = graph.value(current, RDF.first)
+            rest = graph.value(current, RDF.rest)
+            if first is None or rest is None:
+                raise ValueError(f"Malformed RDF list in SHACL path: {head!r}")
+            items.append(first)
+            current = rest
+        return items
+
+    inverse = _single_value(graph, node, SH.inversePath)
+    if inverse is not None:
+        return InvPath(shacl_path_to_rdflib(graph, inverse))
+
+    alternatives = _single_value(graph, node, SH.alternativePath)
+    if alternatives is not None:
+        return AlternativePath(
+            *(shacl_path_to_rdflib(graph, i) for i in _list_items(alternatives))
+        )
+
+    for pred, mod in (
+        (SH.zeroOrMorePath, ZeroOrMore),
+        (SH.oneOrMorePath, OneOrMore),
+        (SH.zeroOrOnePath, ZeroOrOne),
+    ):
+        inner = _single_value(graph, node, pred)
+        if inner is not None:
+            return MulPath(shacl_path_to_rdflib(graph, inner), mod)
+
+    if graph.value(node, RDF.first) is not None:
+        items = _list_items(node)
+        if not items:
+            raise ValueError("Empty sequence in SHACL path")
+        if len(items) == 1:
+            return shacl_path_to_rdflib(graph, items[0])
+        return SequencePath(*(shacl_path_to_rdflib(graph, i) for i in items))
+
+    raise ValueError(f"Not a valid SHACL path: {node!r}")
+
+
+def _single_value(graph: Graph, node: Node, predicate: URIRef) -> Optional[Node]:
+    values = list(graph.objects(node, predicate))
+    if len(values) > 1:
+        raise ValueError(f"Multiple values for {predicate} in SHACL path {node!r}")
+    return values[0] if values else None
+
+
 if __name__ == "__main__":
     pass
