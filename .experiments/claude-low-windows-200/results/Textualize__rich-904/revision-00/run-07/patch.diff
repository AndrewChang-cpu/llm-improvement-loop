+    def __rich_measure__(self, console: "Console", max_width: int) -> "Measurement":
+        # Each level of nesting adds a 4 cell guide prefix before the label.
+        guide_width = 4
+        minimum, maximum = 0, 0
+        stack: List[Tuple[Tree, int]] = [(self, 0)]
+        while stack:
+            node, depth = stack.pop()
+            prefix = depth * guide_width
+            label_min, label_max = Measurement.get(
+                console, node.label, max(0, max_width - prefix)
+            )
+            minimum = max(minimum, label_min + prefix)
+            maximum = max(maximum, label_max + prefix)
+            if node.expanded:
+                stack.extend((child, depth + 1) for child in node.children)
+        return Measurement(minimum, maximum).with_maximum(max_width)
+
 
