+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        # Each level of nesting adds a 4 cell guide prefix before the label.
+        guide_width = 4
+
+        def measure_node(node: "Tree", depth: int) -> Measurement:
+            indent = guide_width * depth
+            label = Measurement.get(console, node.label, max(max_width - indent, 1))
+            measurement = Measurement(label.minimum + indent, label.maximum + indent)
+            if node.expanded:
+                for child in node.children:
+                    child_measurement = measure_node(child, depth + 1)
+                    measurement = Measurement(
+                        max(measurement.minimum, child_measurement.minimum),
+                        max(measurement.maximum, child_measurement.maximum),
+                    )
+            return measurement
+
+        return measure_node(self, 0).clamp(max_width=max_width).normalize()
+
 
