     assert Align.right("foo").renderable == "foo"
     assert Align.center("foo").align == "center"
     assert Align.center("foo").renderable == "foo"
+
+
+def test_vertical_center():
+    from rich.align import VerticalCenter
+
+    console = Console(width=10, height=5, color_system=None, legacy_windows=False)
+    console.begin_capture()
+    console.print(VerticalCenter("foo"))
+    result = console.end_capture()
+    lines = result.split("\n")
+    assert lines[0].strip() == ""
+    assert lines[1].strip() == ""
+    assert lines[2].strip() == "foo"
+    assert lines[3].strip() == ""
+    assert lines[4].strip() == ""
