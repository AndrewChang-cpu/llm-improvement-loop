 from rich.console import Console
+from rich.measure import Measurement
 from rich.tree import Tree
 
 
+def test_measure():
+    console = Console()
+    tree = Tree("foo")
+    assert tree.__rich_measure__(console, 80) == Measurement(3, 3)
+
+    tree.add("barbaz")
+    # Child labels are indented by one 4 cell guide level
+    assert tree.__rich_measure__(console, 80) == Measurement(10, 10)
+    assert tree.__rich_measure__(console, 8) == Measurement(8, 8)
+
