+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        # Each level of nesting adds a 4 cell wide guide before the label.
+        GUIDE_WIDTH = 4
+        minimum = 0
+        maximum = 0
+        stack: List[Tuple[Tree, int]] = [(self, 0)]
+        while stack:
+            node, depth = stack.pop()
+            indent = depth * GUIDE_WIDTH
+            label_measurement = Measurement.get(
+                console, node.label, max(0, max_width - indent)
+            )
+            minimum = max(minimum, indent + label_measurement.minimum)
+            maximum = max(maximum, indent + label_measurement.maximum)
+            if node.expanded:
+                stack.extend((child, depth + 1) for child in node.children)
+        return Measurement(minimum, maximum).with_maximum(max_width)
+
 
