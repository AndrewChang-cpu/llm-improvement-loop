+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        guide_width = 4  # Every guide level (ASCII or box-drawing) is 4 cells wide
+
+        def measure_node(node: "Tree", depth: int) -> Measurement:
+            indent = guide_width * depth
+            label = Measurement.get(console, node.label, max(0, max_width - indent))
+            minimum = label.minimum + indent
+            maximum = label.maximum + indent
+            if node.expanded:
+                for child in node.children:
+                    child_measurement = measure_node(child, depth + 1)
+                    minimum = max(minimum, child_measurement.minimum)
+                    maximum = max(maximum, child_measurement.maximum)
+            return Measurement(minimum, maximum)
+
+        measurement = measure_node(self, 0)
+        return measurement.with_maximum(max_width)
+
 
