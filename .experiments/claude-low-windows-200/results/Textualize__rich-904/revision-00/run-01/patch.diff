+class VerticalCenter(JupyterMixin):
+    """Vertically aligns a renderable within the console height.
+
+    The renderable is rendered at the available width, then blank lines are added
+    above and below so that it is centered vertically in the console.
+
+    Args:
+        renderable (RenderableType): A console renderable.
+        style (StyleType, optional): An optional style to apply to the renderable.
+    """
+
+    def __init__(
+        self,
+        renderable: "RenderableType",
+        style: StyleType = None,
+    ) -> None:
+        self.renderable = renderable
+        self.style = style
+
+    def __rich_console__(
+        self, console: "Console", options: "ConsoleOptions"
+    ) -> "RenderResult":
+        style = console.get_style(self.style) if self.style is not None else None
+        lines = console.render_lines(self.renderable, options, style=style)
+        width = options.max_width
+        height = console.height
+        new_line = Segment.line()
+
+        excess_lines = height - len(lines)
+        if excess_lines <= 0:
+            for line in lines:
+                yield from line
+                yield new_line
+            return
+
+        top = excess_lines // 2
+        bottom = excess_lines - top
+        blank_line = Segment(" " * width)
+        for _ in range(top):
+            yield blank_line
+            yield new_line
+        for line in lines:
+            yield from line
+            yield new_line
+        for _ in range(bottom):
+            yield blank_line
+            yield new_line
+
+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        return Measurement.get(console, self.renderable, max_width)
+
+
 if __name__ == "__main__":  # pragma: no cover
