                 guide_style_stack.push(get_style(node.guide_style))
                 push(iter(loop_last(node.children)))
 
+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        # Each level of nesting adds a 4 cell guide prefix (ASCII and Unicode guides are both 4 cells wide)
+        guide_width = 4
+
+        def measure_node(node: "Tree", depth: int) -> Measurement:
+            indent = guide_width * depth
+            label_measurement = Measurement.get(
+                console, node.label, max(0, max_width - indent)
+            )
+            measurement = Measurement(
+                label_measurement.minimum + indent,
+                label_measurement.maximum + indent,
+            )
+            if node.expanded:
+                for child in node.children:
+                    child_measurement = measure_node(child, depth + 1)
+                    measurement = Measurement(
+                        max(measurement.minimum, child_measurement.minimum),
+                        max(measurement.maximum, child_measurement.maximum),
+                    )
+            return measurement
+
+        return measure_node(self, 0).normalize().with_maximum(max_width)
+
 
