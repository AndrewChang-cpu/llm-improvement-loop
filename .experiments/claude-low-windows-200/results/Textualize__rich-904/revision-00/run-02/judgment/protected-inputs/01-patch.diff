+def test_measure():
+    from rich.measure import Measurement
+
+    tree = Tree("foo")
+    tree.add("bar")
+    baz_tree = tree.add("baz")
+    baz_tree.add("1")
+    console = Console(color_system=None, width=20)
+    # Deepest node "1" is at depth 2: 2 * 4 cells of guides + 1 cell label
