                 guide_style_stack.push(get_style(node.guide_style))
                 push(iter(loop_last(node.children)))
 
+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        # Each level of nesting adds a 4 cell guide prefix before the label
+        guide_width = 4
+        minimum = 0
+        maximum = 0
+        stack: List[Tuple[Tree, int]] = [(self, 0)]
+        while stack:
+            node, indent = stack.pop()
+            label_measurement = Measurement.get(
+                console, node.label, max(0, max_width - indent)
+            )
+            minimum = max(minimum, label_measurement.minimum + indent)
+            maximum = max(maximum, label_measurement.maximum + indent)
+            if node.expanded:
+                for child in node.children:
+                    stack.append((child, indent + guide_width))
+        return Measurement(minimum, maximum).with_maximum(max_width).normalize()
+
 
 if __name__ == "__main__":  # pragma: no cover
 
