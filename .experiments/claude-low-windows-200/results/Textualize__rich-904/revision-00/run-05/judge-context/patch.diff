+    def __rich_measure__(
+        self, console: "Console", max_width: int
+    ) -> "Measurement":
+        """Measure the minimum and maximum widths required to render the tree.
+
+        Each level of nesting adds a 4 cell guide prefix before the label.
+        Only nodes that would be rendered (the root, plus children of expanded
+        nodes) contribute to the measurement.
+        """
+        guide_width = 4
+        minimum = 0
+        maximum = 0
+
+        stack: List[Tuple[Tree, int]] = [(self, 0)]
+        while stack:
+            node, depth = stack.pop()
+            indent = guide_width * depth
+            label_max_width = max(0, max_width - indent)
+            label_measurement = Measurement.get(console, node.label, label_max_width)
+            minimum = max(minimum, indent + label_measurement.minimum)
+            maximum = max(maximum, indent + label_measurement.maximum)
+            if node.expanded:
+                for child in node.children:
+                    stack.append((child, depth + 1))
+
+        return Measurement(minimum, maximum).normalize().with_maximum(max_width)
+
 
