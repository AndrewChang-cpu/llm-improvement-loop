+++ b/tests/test_tree.py
@@ -1,7 +1,21 @@
 from rich.console import Console
+from rich.measure import Measurement
 from rich.tree import Tree
 
 
+def test_measure_tree():
+    console = Console(color_system=None, width=40)
+    tree = Tree("foo")
+    # Single node: no guide prefix
+    assert Measurement.get(console, tree, 40) == Measurement(3, 3)
+    # Child adds a 4 cell guide prefix ("└── ")
+    tree.add("barbaz")
+    assert Measurement.get(console, tree, 40) == Measurement(10, 10)
+    # Collapsed children are not rendered, so they are not measured
+    tree.expanded = False
+    assert Measurement.get(console, tree, 40) == Measurement(3, 3)
+
+
