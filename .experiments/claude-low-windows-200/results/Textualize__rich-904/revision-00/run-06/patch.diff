+    def __rich_measure__(self, console: "Console", max_width: int) -> Measurement:
+        # Each level of nesting adds a 4 cell guide prefix (see ASCII_GUIDES / TREE_GUIDES)
+        guide_width = 4
+        minimum = 0
+        maximum = 0
+        # Walk the visible nodes: (node, depth)
+        stack: List[Tuple[Tree, int]] = [(self, 0)]
+        while stack:
+            node, depth = stack.pop()
+            prefix = guide_width * depth
+            label_measurement = Measurement.get(console, node.label, max_width)
+            node_measurement = Measurement(
+                label_measurement.minimum + prefix,
+                label_measurement.maximum + prefix,
+            ).with_maximum(max_width)
+            minimum = max(minimum, node_measurement.minimum)
+            maximum = max(maximum, node_measurement.maximum)
+            if node.expanded:
+                stack.extend((child, depth + 1) for child in node.children)
+        return Measurement(minimum, maximum).normalize()
+
