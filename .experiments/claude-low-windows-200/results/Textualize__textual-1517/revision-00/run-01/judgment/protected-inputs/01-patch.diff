+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callback in the app's event loop from another thread, blocking
+        until the callback returns, and return its result.
+
+        Must not be called from the app's own thread, as that would deadlock.
+
+        Args:
+            callback: A callable (sync or async) to run in the app's loop.
+            *args: Positional arguments for the callback.
+            **kwargs: Keyword arguments for the callback.
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's thread.
+
+        Returns:
+            The return value of the callback.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running; cannot call from thread.")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "call_from_thread must be called from a different thread than the app."
+            )
+
+        async def run_callback() -> Any:
+            result = callback(*args, **kwargs)
+            if inspect.isawaitable(result):
+                result = await result
+            return result
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
