diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..90f4c2a
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,70 @@
+import asyncio
+import threading
+
+import pytest
+
+from textual.app import App
+
+
+class CallFromThreadApp(App[None]):
+    pass
+
+
+def test_call_from_thread_returns_result() -> None:
+    """call_from_thread should run the callback in the app loop and return its result."""
+
+    async def main() -> None:
+        app = CallFromThreadApp()
+        loop = asyncio.get_running_loop()
+        async with app.run_test():
+            result = await loop.run_in_executor(
+                None, app.call_from_thread, lambda a, b: a + b, 2, 3
+            )
+            assert result == 5
+
+    asyncio.run(main())
+
+
+def test_call_from_thread_runs_in_app_thread() -> None:
+    """The callback should execute on the app's thread."""
+
+    async def main() -> None:
+        app = CallFromThreadApp()
+        loop = asyncio.get_running_loop()
+        async with app.run_test():
+            app_thread = threading.get_ident()
+            callback_thread = await loop.run_in_executor(
+                None, app.call_from_thread, threading.get_ident
+            )
+            assert callback_thread == app_thread
+
+    asyncio.run(main())
+
+
+def test_call_from_thread_async_callback() -> None:
+    """Async callbacks should be awaited before returning."""
+
+    async def coro(value: int) -> int:
+        await asyncio.sleep(0)
+        return value * 2
+
+    async def main() -> None:
+        app = CallFromThreadApp()
+        loop = asyncio.get_running_loop()
+        async with app.run_test():
+            result = await loop.run_in_executor(None, app.call_from_thread, coro, 21)
+            assert result == 42
+
+    asyncio.run(main())
+
+
+def test_call_from_app_thread_raises() -> None:
+    """Calling from the app's own thread would deadlock, so it should raise."""
+
+    async def main() -> None:
+        app = CallFromThreadApp()
+        async with app.run_test():
+            with pytest.raises(RuntimeError):
+                app.call_from_thread(lambda: None)
+
+    asyncio.run(main())
