diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..bcfda66
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,63 @@
+import threading
+
+import pytest
+
+from textual.app import App
+
+
+class ThreadApp(App[None]):
+    pass
+
+
+async def test_call_from_thread_returns_value() -> None:
+    """call_from_thread should run the callback in the app's loop and return its result."""
+    app = ThreadApp()
+    results: list[object] = []
+
+    def worker() -> None:
+        results.append(app.call_from_thread(lambda a, b: a + b, 2, b=3))
+
+    async with app.run_test() as pilot:
+        thread = threading.Thread(target=worker)
+        thread.start()
+        while thread.is_alive():
+            await pilot.pause(0.01)
+        thread.join()
+
+    assert results == [5]
+
+
+async def test_call_from_thread_runs_in_app_thread() -> None:
+    """The callback should execute on the app's thread, not the worker thread."""
+    app = ThreadApp()
+    callback_thread: list[int] = []
+
+    def record() -> None:
+        callback_thread.append(threading.get_ident())
+
+    def worker() -> None:
+        app.call_from_thread(record)
+
+    async with app.run_test() as pilot:
+        thread = threading.Thread(target=worker)
+        thread.start()
+        while thread.is_alive():
+            await pilot.pause(0.01)
+        thread.join()
+
+    assert callback_thread == [threading.get_ident()]
+
+
+async def test_call_from_app_thread_raises() -> None:
+    """Calling call_from_thread from the app's own thread would deadlock, so it must raise."""
+    app = ThreadApp()
+    async with app.run_test():
+        with pytest.raises(RuntimeError):
+            app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_when_not_running() -> None:
+    """Calling call_from_thread before the app runs should raise RuntimeError."""
+    app = ThreadApp()
+    with pytest.raises(RuntimeError):
+        app.call_from_thread(lambda: None)
