+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callback in the app's event loop from another thread, and wait for the result.
+
+        This method blocks the calling thread until the callback has returned.
+        It must not be called from the thread running the app, as that would deadlock.
+
+        Args:
+            callback (Callable[..., Any]): A callable. May be a coroutine function, in which
+                case it is awaited in the app's loop.
+            *args: Positional arguments passed to the callback.
+            **kwargs: Keyword arguments passed to the callback.
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's own thread.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        loop = self._loop
+        if loop is None or not self._running:
+            raise RuntimeError("App is not running")
+        try:
+            running_loop = asyncio.get_running_loop()
+        except RuntimeError:
+            running_loop = None
+        if running_loop is loop:
+            raise RuntimeError(
+                "call_from_thread must not be called from the app's thread (would deadlock)"
+            )
+
+        async def run_callback() -> Any:
+            result = callback(*args, **kwargs)
+            if inspect.isawaitable(result):
+                result = await result
+            return result
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), loop)
+        return future.result()
+
