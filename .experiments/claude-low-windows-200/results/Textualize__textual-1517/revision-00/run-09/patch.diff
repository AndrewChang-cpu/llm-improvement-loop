diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..b81e473
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,58 @@
+import asyncio
+import threading
+
+import pytest
+
+from textual.app import App
+
+
+class CallFromThreadApp(App[None]):
+    pass
+
+
+async def _in_thread(app: App, callback, *args, **kwargs):
+    """Run app.call_from_thread from a worker thread, keeping the app loop free."""
+    return await asyncio.to_thread(app.call_from_thread, callback, *args, **kwargs)
+
+
+def test_call_from_thread_returns_value() -> None:
+    """call_from_thread runs the callback in the app thread and returns its result."""
+    seen: dict[str, int] = {}
+
+    def callback(a: int, b: int = 0) -> int:
+        seen["thread"] = threading.get_ident()
+        return a + b
+
+    async def main() -> None:
+        app = CallFromThreadApp()
+        async with app.run_test():
+            result = await _in_thread(app, callback, 2, b=3)
+            assert result == 5
+            assert seen["thread"] == app._thread_id
+
+    asyncio.run(main())
+
+
+def test_call_from_thread_awaits_coroutine() -> None:
+    """A coroutine function is awaited in the app's loop and its result returned."""
+    async def callback(value: str) -> str:
+        return value * 2
+
+    async def main() -> None:
+        app = CallFromThreadApp()
+        async with app.run_test():
+            result = await _in_thread(app, callback, "ab")
+            assert result == "abab"
+
+    asyncio.run(main())
+
+
+def test_call_from_app_thread_raises() -> None:
+    """Calling from the app's own thread would deadlock, so it must raise."""
+    async def main() -> None:
+        app = CallFromThreadApp()
+        async with app.run_test():
+            with pytest.raises(RuntimeError):
+                app.call_from_thread(lambda: None)
+
+    asyncio.run(main())
