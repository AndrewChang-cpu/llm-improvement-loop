+    def call_from_thread(self, callback: Callable, *args, **kwargs) -> Any:
+        """Run a callback in the app's event loop from another thread, and block until it returns.
+
+        This is intended for use by threads other than the app's thread (e.g. a worker or a
+        third-party API callback). The callback may be a regular function or a coroutine function.
+
+        Args:
+            callback (Callable): A callable to run in the app's event loop.
+            *args: Positional arguments to pass to the callable.
+            **kwargs: Keyword arguments to pass to the callable.
+
+        Raises:
+            RuntimeError: If called from the app's own thread (this would deadlock), or if
+                the app is not running.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None:
+            raise RuntimeError("The app is not running; cannot call from thread.")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "call_from_thread must be called from a different thread than the app."
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> Any:
+            return await invoke(callback_with_args)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
