+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callable in the app's event loop from another thread, and block
+        until it returns. Positional and keyword arguments are passed to the callable.
+        If the callable is a coroutine function (or returns an awaitable), it is awaited.
+
+        Note that this must not be called from the app's own thread, as it would deadlock.
+
+        Args:
+            callback (Callable[..., Any]): The callable to run in the app's event loop.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+
+        async def run_callback() -> Any:
+            result = callback(*args, **kwargs)
+            if isawaitable(result):
+                result = await result
+            return result
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
