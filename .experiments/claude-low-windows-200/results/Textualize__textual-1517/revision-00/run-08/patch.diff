+    def call_from_thread(self, callback: Callable[..., Any], *args: Any, **kwargs: Any) -> Any:
+        """Run a callback in the app's event loop from another thread, and block until it returns.
+
+        This is intended for use from a thread other than the app's thread, for example
+        when integrating a threaded third-party API. The callback is invoked in the app's
+        loop, and its return value (or exception) is returned to the calling thread.
+
+        Calling this from the app's own thread would deadlock, so it raises a RuntimeError.
+
+        Args:
+            callback (Callable[..., Any]): A callable, which may be a coroutine function.
+            *args: Positional arguments passed to the callback.
+            **kwargs: Keyword arguments passed to the callback.
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's thread.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None or not self._running:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> Any:
+            return await invoke(callback_with_args)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), loop=self._loop)
+        return future.result()
+
