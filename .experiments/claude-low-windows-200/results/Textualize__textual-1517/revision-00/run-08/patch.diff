diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..b081a5a
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,64 @@
+import asyncio
+
+import pytest
+
+from textual.app import App
+
+
+class CallFromThreadApp(App[None]):
+    pass
+
+
+async def test_call_from_thread_returns_value() -> None:
+    """Check that call_from_thread runs the callback in the app and returns its result."""
+    app = CallFromThreadApp()
+
+    def add(a: int, b: int) -> int:
+        return a + b
+
+    async with app.run_test():
+        result = await asyncio.to_thread(app.call_from_thread, add, 2, b=3)
+        assert result == 5
+
+
+async def test_call_from_thread_runs_in_app_loop() -> None:
+    """Check that the callback is executed in the app's event loop thread."""
+    app = CallFromThreadApp()
+    loop = asyncio.get_running_loop()
+    seen_loops: list[asyncio.AbstractEventLoop] = []
+
+    def record() -> None:
+        seen_loops.append(asyncio.get_running_loop())
+
+    async with app.run_test():
+        await asyncio.to_thread(app.call_from_thread, record)
+        assert seen_loops == [loop]
+
+
+async def test_call_from_thread_awaits_coroutine() -> None:
+    """Check that a coroutine callback is awaited before call_from_thread returns."""
+    app = CallFromThreadApp()
+
+    async def compute() -> str:
+        await asyncio.sleep(0)
+        return "done"
+
+    async with app.run_test():
+        result = await asyncio.to_thread(app.call_from_thread, compute)
+        assert result == "done"
+
+
+async def test_call_from_thread_from_app_thread_raises() -> None:
+    """Check that calling call_from_thread from the app's own thread raises instead of deadlocking."""
+    app = CallFromThreadApp()
+
+    async with app.run_test():
+        with pytest.raises(RuntimeError):
+            app.call_from_thread(lambda: None)
+
+
+async def test_call_from_thread_when_not_running_raises() -> None:
+    """Check that call_from_thread raises if the app is not running."""
+    app = CallFromThreadApp()
+    with pytest.raises(RuntimeError):
+        app.call_from_thread(lambda: None)
