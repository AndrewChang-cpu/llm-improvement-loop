+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callback in the app's event loop from another thread, and block
+        until the callback returns. Positional and keyword arguments are passed to
+        the callback. If the callback is a coroutine function, it is awaited.
+
+        Must not be called from the app's own thread, as that would deadlock.
+
+        Args:
+            callback (Callable[..., Any]): A callable (sync or async).
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's thread.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        loop = self._loop
+        if loop is None or not loop.is_running():
+            raise RuntimeError("The app is not running")
+        try:
+            running_loop = asyncio.get_running_loop()
+        except RuntimeError:
+            running_loop = None
+        if running_loop is loop:
+            raise RuntimeError(
+                "call_from_thread must not be called from the app's own thread"
+            )
+
+        async def run_callback() -> Any:
+            return await invoke(partial(callback, *args, **kwargs))
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), loop)
+        return future.result()
+
