+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callback in the app's event loop from another thread, and block
+        until the callback returns.
+
+        Must not be called from the thread running the app, as that would deadlock.
+
+        Args:
+            callback (Callable[..., Any]): A callable to run in the app's thread.
+            *args: Positional arguments passed to the callable.
+            **kwargs: Keyword arguments passed to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's thread.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None or not self._running:
+            raise RuntimeError("The app is not running; cannot call from thread.")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "call_from_thread must be called from another thread, not the app thread."
+            )
+
+        future: ConcurrentFuture[Any] = ConcurrentFuture()
+
+        def run_callback() -> None:
+            try:
+                result = callback(*args, **kwargs)
+            except BaseException as error:
+                future.set_exception(error)
+            else:
+                future.set_result(result)
+
+        self._loop.call_soon_threadsafe(self.call_later, run_callback)
+        return future.result()
+
