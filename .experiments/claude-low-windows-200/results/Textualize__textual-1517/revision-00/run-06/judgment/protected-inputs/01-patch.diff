+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callable in the app's thread from another thread, and block until it returns.
+
+        The callable may be a coroutine function, in which case it is awaited in the app's loop.
+
+        Args:
+            callback (Callable[..., Any]): The callable to run in the app's thread.
+            *args: Positional arguments to pass to the callable.
+            **kwargs: Keyword arguments to pass to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's own thread
+                (which would deadlock).
+
+        Returns:
+            Any: The return value of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("The app is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "call_from_thread must be called from a different thread than the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> Any:
+            return await invoke(callback_with_args)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
