diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..0768753
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,45 @@
+import asyncio
+import threading
+
+from textual.app import App
+
+
+class ThreadApp(App[None]):
+    pass
+
+
+async def test_call_from_thread() -> None:
+    """Check that call_from_thread runs a callback in the app thread and returns its result."""
+    app = ThreadApp()
+    results: list[object] = []
+
+    async with app.run_test():
+        loop = asyncio.get_running_loop()
+
+        def worker() -> None:
+            results.append(app.call_from_thread(lambda: 42))
+            results.append(
+                app.call_from_thread(lambda a, b: a + b, 1, b=2)
+            )
+
+        await loop.run_in_executor(None, worker)
+
+    assert results == [42, 3]
+
+
+async def test_call_from_thread_runs_in_app_thread() -> None:
+    """Check the callback is executed on the app's thread."""
+    app = ThreadApp()
+    thread_ids: list[int] = []
+
+    async with app.run_test():
+        loop = asyncio.get_running_loop()
+
+        def callback() -> None:
+            thread_ids.append(threading.get_ident())
+
+        await loop.run_in_executor(
+            None, lambda: app.call_from_thread(callback)
+        )
+
+    assert thread_ids == [threading.get_ident()]
