+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callback in the app's event loop from another thread, and block
+        until the callback returns.
+
+        The callback may be a regular function or a coroutine function. Its
+        return value is returned from this method.
+
+        Note:
+            This must be called from a thread other than the one running the app,
+            otherwise it would deadlock. A RuntimeError is raised if called from
+            the app's own thread.
+
+        Args:
+            callback (Callable[..., Any]): A callable to run in the app's loop.
+            *args: Positional arguments to pass to the callback.
+            **kwargs: Keyword arguments to pass to the callback.
+
+        Raises:
+            RuntimeError: If called from the app's thread, or if the app is not running.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "call_from_thread must be called from a different thread than the app"
+            )
+
+        async def run_callback() -> Any:
+            result = callback(*args, **kwargs)
+            if inspect.isawaitable(result):
+                result = await result
+            return result
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
     def exit(
