diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..2942f22
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,58 @@
+import asyncio
+import threading
+
+import pytest
+
+from textual.app import App
+
+
+class ThreadApp(App[None]):
+    pass
+
+
+async def test_call_from_thread_returns_value() -> None:
+    """call_from_thread should run the callback in the app and return its result."""
+    app = ThreadApp()
+    async with app.run_test():
+        loop_thread = threading.get_ident()
+
+        def callback(a: int, b: int = 0) -> int:
+            # Runs in the app's thread
+            assert threading.get_ident() == loop_thread
+            return a + b
+
+        result = await asyncio.to_thread(app.call_from_thread, callback, 2, b=3)
+        assert result == 5
+
+
+async def test_call_from_thread_with_coroutine() -> None:
+    """Coroutine callbacks should be awaited in the app's loop."""
+    app = ThreadApp()
+
+    async def callback(value: str) -> str:
+        await asyncio.sleep(0)
+        return value.upper()
+
+    async with app.run_test():
+        result = await asyncio.to_thread(app.call_from_thread, callback, "hello")
+        assert result == "HELLO"
+
+
+async def test_call_from_thread_same_thread_raises() -> None:
+    """Calling from the app's own thread would deadlock, so it should raise."""
+    app = ThreadApp()
+    async with app.run_test():
+        with pytest.raises(RuntimeError):
+            app.call_from_thread(lambda: None)
+
+
+async def test_call_from_thread_propagates_exception() -> None:
+    """Exceptions raised by the callback should propagate to the calling thread."""
+    app = ThreadApp()
+
+    def callback() -> None:
+        raise ValueError("boom")
+
+    async with app.run_test():
+        with pytest.raises(ValueError):
+            await asyncio.to_thread(app.call_from_thread, callback)
