+    def call_from_thread(self, callback: Callable, *args: Any, **kwargs: Any) -> Any:
+        """Run a callback in the app's event loop from another thread, and block
+        until the callback returns.
+
+        This is intended for integrating threaded third-party APIs with Textual.
+        It must not be called from the app's own thread, otherwise it would deadlock.
+
+        Args:
+            callback (Callable): A callable. May be a coroutine function.
+            *args: Positional arguments to pass to the callable.
+            **kwargs: Keyword arguments to pass to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's thread.
+
+        Returns:
+            Any: The result of the callback.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "call_from_thread must be called from a different thread than the app"
+            )
+
+        async def run_callback() -> Any:
+            return await invoke(partial(callback, *args, **kwargs))
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
