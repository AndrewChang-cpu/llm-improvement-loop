+    def call_from_thread(self, callback: Callable, *args, **kwargs) -> Any:
+        """Run a callback in the app's event loop from another thread, blocking
+        until the callback has returned. Positional and keyword arguments are
+        passed to the callable. If the callback is a coroutine function (or
+        returns an awaitable), it is awaited.
+
+        Must not be called from the app's own thread, since that would deadlock.
+
+        Args:
+            callback (Callable): A callable to run in the app's loop.
+
+        Raises:
+            RuntimeError: If called from the same thread as the app.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None or self._thread_id == threading.get_ident():
+            raise RuntimeError(
+                "The `call_from_thread` method must be called from a different thread than the app"
+            )
+
+        async def run_callback() -> Any:
+            result = callback(*args, **kwargs)
+            if inspect.isawaitable(result):
+                result = await result
+            return result
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
     def exit(
         self, result: ReturnType | None = None, message: RenderableType | None = None
     ) -> None:
