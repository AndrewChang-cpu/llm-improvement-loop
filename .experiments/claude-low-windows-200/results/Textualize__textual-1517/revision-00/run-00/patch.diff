diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..f26d2bf
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,55 @@
+import threading
+
+from textual.app import App
+
+
+def test_call_from_thread_returns_result():
+    results = {}
+
+    class ThreadedApp(App[None]):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                results["value"] = self.call_from_thread(lambda a, b: a + b, 2, b=3)
+                results["thread_ident"] = threading.get_ident()
+                self.call_from_thread(self.exit)
+
+            threading.Thread(target=worker).start()
+
+    app = ThreadedApp()
+    app.run(headless=True)
+    assert results["value"] == 5
+    assert results["thread_ident"] != threading.get_ident()
+
+
+def test_call_from_thread_runs_in_app_thread():
+    results = {}
+
+    class ThreadedApp(App[None]):
+        def on_mount(self) -> None:
+            results["app_thread"] = threading.get_ident()
+
+            def worker() -> None:
+                results["callback_thread"] = self.call_from_thread(threading.get_ident)
+                self.call_from_thread(self.exit)
+
+            threading.Thread(target=worker).start()
+
+    app = ThreadedApp()
+    app.run(headless=True)
+    assert results["callback_thread"] == results["app_thread"]
+
+
+def test_call_from_thread_raises_in_app_thread():
+    errors = []
+
+    class ThreadedApp(App[None]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    app = ThreadedApp()
+    app.run(headless=True)
+    assert len(errors) == 1
