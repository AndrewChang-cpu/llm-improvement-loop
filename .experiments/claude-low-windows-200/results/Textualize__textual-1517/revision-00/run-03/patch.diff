diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..d8a011f
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,54 @@
+import threading
+
+import pytest
+
+from textual.app import App
+
+
+class ThreadApp(App[None]):
+    pass
+
+
+async def test_call_from_thread_returns_value() -> None:
+    """call_from_thread should run the callback in the app and return its result."""
+    app = ThreadApp()
+    results: list[object] = []
+
+    def callback(a: int, b: int = 0) -> int:
+        results.append(threading.get_ident())
+        return a + b
+
+    async with app.run_test():
+        value = await _run_in_thread(app.call_from_thread, callback, 2, b=3)
+
+    assert value == 5
+    assert results == [app._thread_id]
+
+
+async def test_call_from_thread_awaits_coroutine() -> None:
+    """Coroutine callbacks should be awaited before returning."""
+    app = ThreadApp()
+
+    async def callback() -> str:
+        return "done"
+
+    async with app.run_test():
+        value = await _run_in_thread(app.call_from_thread, callback)
+
+    assert value == "done"
+
+
+async def test_call_from_thread_raises_from_app_thread() -> None:
+    """Calling from the app's own thread would deadlock, so it must raise."""
+    app = ThreadApp()
+    async with app.run_test():
+        with pytest.raises(RuntimeError):
+            app.call_from_thread(lambda: None)
+
+
+async def _run_in_thread(func, *args, **kwargs):
+    """Run a blocking function in a worker thread and await its result."""
+    import asyncio
+
+    loop = asyncio.get_running_loop()
+    return await loop.run_in_executor(None, lambda: func(*args, **kwargs))
