+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: object, **kwargs: object
+    ) -> Any:
+        """Run a callback in the app's event loop from another thread.
+
+        The callback is invoked in the app's loop, and this method blocks until
+        the callback returns. If the callback is a coroutine function (or returns
+        an awaitable), it is awaited and its result is returned.
+
+        Must not be called from the app's own thread, as that would deadlock.
+
+        Args:
+            callback (Callable[..., Any]): A callable to run in the app's loop.
+            *args: Positional arguments to pass to the callback.
+            **kwargs: Keyword arguments to pass to the callback.
+
+        Raises:
+            RuntimeError: If called from the app's thread, or if the app is not running.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None or self._thread_id == 0:
+            raise RuntimeError("The app is not running.")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must be called from a different thread than the app."
+            )
+
+        async def run_callback() -> Any:
+            result = callback(*args, **kwargs)
+            if inspect.isawaitable(result):
+                result = await result
+            return result
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
     def compose(self) -> ComposeResult:
