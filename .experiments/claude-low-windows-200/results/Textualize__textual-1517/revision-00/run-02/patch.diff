+    def call_from_thread(self, callback: Callable, *args, **kwargs) -> Any:
+        """Run a callback in the app's event loop from another thread, and block until it returns.
+
+        This is useful for integrating with threaded third-party APIs. The callback may be a
+        regular function or a coroutine function.
+
+        Must not be called from the same thread as the app, since that would deadlock.
+
+        Args:
+            callback (Callable): A callable to run in the app's event loop.
+            *args: Positional arguments to pass to the callback.
+            **kwargs: Keyword arguments to pass to the callback.
+
+        Raises:
+            RuntimeError: If the app is not running, or if called from the app's own thread.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None:
+            raise RuntimeError("The app is not running.")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "call_from_thread must be called from a different thread than the app."
+            )
+
+        async def run_callback() -> Any:
+            result = callback(*args, **kwargs)
+            if inspect.isawaitable(result):
+                result = await result
+            return result
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
