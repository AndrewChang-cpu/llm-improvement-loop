diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..fb39af9
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,68 @@
+import asyncio
+import threading
+
+import pytest
+
+from textual.app import App
+
+
+class CallFromThreadApp(App[None]):
+    pass
+
+
+async def test_call_from_thread_returns_value() -> None:
+    """call_from_thread should run the callback in the app and return its result."""
+    app = CallFromThreadApp()
+    async with app.run_test():
+        result = await asyncio.to_thread(app.call_from_thread, lambda: 42)
+        assert result == 42
+
+
+async def test_call_from_thread_passes_args() -> None:
+    """Positional and keyword arguments should be forwarded to the callback."""
+    app = CallFromThreadApp()
+
+    def add(a: int, b: int, *, scale: int = 1) -> int:
+        return (a + b) * scale
+
+    async with app.run_test():
+        result = await asyncio.to_thread(app.call_from_thread, add, 2, 3, scale=10)
+        assert result == 50
+
+
+async def test_call_from_thread_runs_in_app_thread() -> None:
+    """The callback should run on the app's thread."""
+    app = CallFromThreadApp()
+    async with app.run_test():
+        callback_thread = await asyncio.to_thread(
+            app.call_from_thread, threading.get_ident
+        )
+        assert callback_thread == app._thread_id
+
+
+async def test_call_from_thread_awaits_coroutine() -> None:
+    """Coroutine functions should be awaited in the app's loop."""
+    app = CallFromThreadApp()
+
+    async def coro(value: str) -> str:
+        await asyncio.sleep(0)
+        return value.upper()
+
+    async with app.run_test():
+        result = await asyncio.to_thread(app.call_from_thread, coro, "hello")
+        assert result == "HELLO"
+
+
+async def test_call_from_thread_raises_from_app_thread() -> None:
+    """Calling from the app's own thread would deadlock, so it should raise."""
+    app = CallFromThreadApp()
+    async with app.run_test():
+        with pytest.raises(RuntimeError):
+            app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_not_running() -> None:
+    """Calling before the app is running should raise."""
+    app = CallFromThreadApp()
+    with pytest.raises(RuntimeError):
+        app.call_from_thread(lambda: None)
