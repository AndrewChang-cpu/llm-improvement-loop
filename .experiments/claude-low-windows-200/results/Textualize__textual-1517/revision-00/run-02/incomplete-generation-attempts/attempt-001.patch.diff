+    def call_from_thread(
+        self, callback: Callable[..., Any], *args: Any, **kwargs: Any
+    ) -> Any:
+        """Run a callback in the app's event loop from another thread, and block
+        until the callback returns.
+
+        This is intended for use from threads that are not the app's thread (for
+        example, a thread created to call a third-party API). Calling this from
+        the app's own thread would deadlock, so a RuntimeError is raised instead.
+
+        Args:
+            callback (Callable[..., Any]): A callable (sync or async) to run in the app's loop.
+            *args: Positional arguments to pass to the callback.
+            **kwargs: Keyword arguments to pass to the callback.
+
+        Raises:
+            RuntimeError: If called from the app's own thread, or if the app is not running.
+
+        Returns:
+            Any: The return value of the callback.
+        """
+        if self._loop is None or self._thread_id is None:
+            raise RuntimeError("The app is not running; call_from_thread is unavailable")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> Any:
+            return await invoke(callback_with_args)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
