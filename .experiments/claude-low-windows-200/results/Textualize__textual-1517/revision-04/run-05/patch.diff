diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..5cb00a4
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,162 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+JOIN_TIMEOUT = 5.0
+
+
+class ThreadedApp(App[int]):
+    """An app that runs a body of work on a daemon thread once mounted.
+
+    The worker stores its outcome in `outcome`, then exits the app with
+    the exit value 3 through `call_from_thread`.
+    """
+
+    def __init__(self, work: Callable[[ThreadedApp], Any]) -> None:
+        super().__init__()
+        self._work = work
+        self.outcome: dict[str, Any] = {}
+        self.worker: threading.Thread | None = None
+
+    def compose(self):
+        yield TextLog()
+
+    def on_mount(self) -> None:
+        self.worker = threading.Thread(target=self._run_work, daemon=True)
+        self.worker.start()
+
+    def _run_work(self) -> None:
+        try:
+            self.outcome["value"] = self._work(self)
+        except BaseException as error:
+            self.outcome["error"] = error
+        finally:
+            self.call_from_thread(self.exit, 3)
+
+
+def run_threaded_app(work: Callable[[ThreadedApp], Any]) -> tuple[ThreadedApp, Any]:
+    app = ThreadedApp(work)
+    return_value = app.run(headless=True, size=(80, 24))
+    assert app.worker is not None
+    app.worker.join(JOIN_TIMEOUT)
+    assert not app.worker.is_alive(), "worker thread did not finish"
+    return app, return_value
+
+
+def test_call_from_thread_before_run_raises_not_running():
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error():
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.same_thread_error = str(error)
+            self.exit(3)
+
+    app = SameThreadApp()
+    assert app.run(headless=True, size=(80, 24)) == 3
+    assert "different thread from the app" in app.same_thread_error
+
+
+def test_call_from_thread_writes_to_widget_from_worker_thread():
+    def work(app: ThreadedApp) -> None:
+        def write_to_log() -> None:
+            app.query_one(TextLog).write("hello from thread")
+
+        app.call_from_thread(write_to_log)
+
+    app, return_value = run_threaded_app(work)
+    assert "error" not in app.outcome
+    assert return_value == 3
+
+
+def test_call_from_thread_awaits_awaitable_result():
+    async def coroutine_result() -> str:
+        return "awaited value"
+
+    def work(app: ThreadedApp) -> None:
+        app.outcome["result"] = app.call_from_thread(coroutine_result)
+
+    app, return_value = run_threaded_app(work)
+    assert "error" not in app.outcome
+    assert app.outcome.get("result") == "awaited value"
+    assert return_value == 3
+
+
+def test_call_from_thread_returns_plain_result():
+    def work(app: ThreadedApp) -> None:
+        app.outcome["result"] = app.call_from_thread(lambda: 42)
+
+    app, return_value = run_threaded_app(work)
+    assert "error" not in app.outcome
+    assert app.outcome.get("result") == 42
+    assert return_value == 3
+
+
+def test_call_from_thread_propagates_timeout_exception_message_and_args():
+    def raise_timeout() -> None:
+        raise TimeoutError("third party timed out", 7)
+
+    def work(app: ThreadedApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            app.outcome["message"] = str(error)
+            app.outcome["args"] = error.args
+            app.outcome["returned"] = True
+
+    app, return_value = run_threaded_app(work)
+    assert "error" not in app.outcome
+    assert app.outcome.get("returned") is True
+    assert "third party timed out" in app.outcome.get("message", "")
+    assert app.outcome.get("args") == ("third party timed out", 7)
+    assert return_value == 3
+
+
+def test_call_from_thread_forwards_positional_arguments_to_variadic_callable():
+    def collect(*values: int) -> tuple[int, ...]:
+        return values
+
+    def work(app: ThreadedApp) -> None:
+        app.outcome["result"] = app.call_from_thread(collect, 1, 2, 3)
+
+    app, return_value = run_threaded_app(work)
+    assert "error" not in app.outcome
+    assert app.outcome.get("result") == (1, 2, 3)
+    assert return_value == 3
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters():
+    def combine(first: str, second: str = "", *, suffix: str = "") -> str:
+        return first + second + suffix
+
+    def work(app: ThreadedApp) -> None:
+        app.outcome["result"] = app.call_from_thread(
+            combine, "a", second="b", suffix="c"
+        )
+
+    app, return_value = run_threaded_app(work)
+    assert "error" not in app.outcome
+    assert app.outcome.get("result") == "abc"
+    assert return_value == 3
+
+
+def test_call_from_thread_after_app_has_stopped_raises_not_running():
+    def work(app: ThreadedApp) -> None:
+        pass
+
+    app, return_value = run_threaded_app(work)
+    assert return_value == 3
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
