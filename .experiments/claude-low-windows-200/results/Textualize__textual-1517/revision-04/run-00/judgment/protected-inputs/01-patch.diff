diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..239a608
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,211 @@
+from __future__ import annotations
+
+import threading
+from typing import Any
+
+from textual.app import App
+from textual.widgets import TextLog
+
+RESULT_TIMEOUT = 5.0
+
+
+def _join_thread(thread: threading.Thread) -> None:
+    """Join a background thread with a bounded wait, asserting it has finished."""
+    thread.join(RESULT_TIMEOUT)
+    assert not thread.is_alive()
+
+
+class NotRunningApp(App[None]):
+    """App that is never run; used to check calls made before run."""
+
+
+def test_call_before_run_raises_not_running() -> None:
+    """Calling call_from_thread before the app runs raises 'App is not running'."""
+    app = NotRunningApp()
+    try:
+        app.call_from_thread(lambda: None)
+    except RuntimeError as error:
+        assert str(error) == "App is not running"
+    else:
+        raise AssertionError("RuntimeError was not raised")
+
+
+class SameThreadApp(App[None]):
+    """App that calls call_from_thread from its own thread."""
+
+    def on_mount(self) -> None:
+        try:
+            self.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            self.same_thread_error = str(error)
+        else:
+            self.same_thread_error = None
+        self.exit()
+
+
+def test_call_from_app_thread_raises_runtime_error() -> None:
+    """Calling call_from_thread from the app thread raises a RuntimeError."""
+    app = SameThreadApp()
+    app.run(headless=True)
+    assert app.same_thread_error == (
+        "The `call_from_thread` method must run in a different thread from the app"
+    )
+
+
+class WidgetApp(App[int]):
+    """App whose background thread writes to a text log widget."""
+
+    def compose(self):  # type: ignore[no-untyped-def]
+        yield TextLog()
+
+    def on_mount(self) -> None:
+        self.thread_done = False
+
+        def background() -> None:
+            def write() -> None:
+                self.query_one(TextLog).write("hello from thread")
+
+            self.call_from_thread(write)
+            self.thread_done = True
+            self.call_from_thread(self.exit, 3)
+
+        self.thread = threading.Thread(target=background, daemon=True)
+        self.thread.start()
+
+
+def test_callable_can_access_widgets_through_app() -> None:
+    """A callable that queries and writes a widget completes and the app exits with the supplied code."""
+    app = WidgetApp()
+    result = app.run(headless=True, size=(80, 24))
+    _join_thread(app.thread)
+    assert app.thread_done
+    assert result == 3
+
+
+class AwaitableApp(App[int]):
+    """App whose background thread calls an awaitable callable."""
+
+    def on_mount(self) -> None:
+        self.received: Any = None
+
+        async def coro() -> str:
+            return "awaited result"
+
+        def background() -> None:
+            self.received = self.call_from_thread(lambda: coro())
+            self.call_from_thread(self.exit, 4)
+
+        self.thread = threading.Thread(target=background, daemon=True)
+        self.thread.start()
+
+
+def test_awaitable_callable_result_is_returned_to_calling_thread() -> None:
+    """An awaitable returned by the callable is awaited and its result returned."""
+    app = AwaitableApp()
+    result = app.run(headless=True)
+    _join_thread(app.thread)
+    assert app.received == "awaited result"
+    assert result == 4
+
+
+class ExceptionApp(App[int]):
+    """App whose background thread triggers a timeout-class exception."""
+
+    def on_mount(self) -> None:
+        self.error_message: str | None = None
+        self.error_args: tuple[Any, ...] | None = None
+
+        def raise_timeout() -> None:
+            raise TimeoutError("timed out in callable")
+
+        def background() -> None:
+            try:
+                self.call_from_thread(raise_timeout)
+            except Exception as error:
+                self.error_message = str(error)
+                self.error_args = error.args
+            self.call_from_thread(self.exit, 5)
+
+        self.thread = threading.Thread(target=background, daemon=True)
+        self.thread.start()
+
+
+def test_timeout_exception_is_raised_on_calling_thread_and_call_returns() -> None:
+    """A timeout-class exception from the callable is re-raised on the calling thread and the call returns."""
+    app = ExceptionApp()
+    result = app.run(headless=True)
+    _join_thread(app.thread)
+    assert app.error_message == "timed out in callable"
+    assert app.error_args == ("timed out in callable",)
+    assert result == 5
+
+
+class VariadicApp(App[int]):
+    """App whose background thread forwards positional and keyword arguments."""
+
+    def on_mount(self) -> None:
+        self.received: tuple[Any, ...] | None = None
+
+        def variadic(*args: Any, **kwargs: Any) -> tuple[Any, ...]:
+            return args, kwargs
+
+        def background() -> None:
+            self.received = self.call_from_thread(variadic, 1, 2, 3, key="value")
+            self.call_from_thread(self.exit, 6)
+
+        self.thread = threading.Thread(target=background, daemon=True)
+        self.thread.start()
+
+
+def test_variadic_callable_receives_all_positional_and_keyword_arguments() -> None:
+    """A variadic callable receives every supplied positional and keyword argument."""
+    app = VariadicApp()
+    result = app.run(headless=True)
+    _join_thread(app.thread)
+    assert app.received == ((1, 2, 3), {"key": "value"})
+    assert result == 6
+
+
+class ExitApp(App[int]):
+    """App whose background thread exits the app with a value."""
+
+    def on_mount(self) -> None:
+        def background() -> None:
+            self.call_from_thread(self.exit, 7)
+
+        self.thread = threading.Thread(target=background, daemon=True)
+        self.thread.start()
+
+
+def test_exit_from_background_thread_returns_exit_value() -> None:
+    """Exiting the app through call_from_thread makes run return the supplied value."""
+    app = ExitApp()
+    result = app.run(headless=True)
+    _join_thread(app.thread)
+    assert result == 7
+
+
+class AfterStopApp(App[int]):
+    """App that records a call made from a background thread after run has returned."""
+
+    def on_mount(self) -> None:
+
+        def background() -> None:
+            self.call_from_thread(self.exit, 8)
+
+        self.thread = threading.Thread(target=background, daemon=True)
+        self.thread.start()
+
+
+def test_call_after_app_stopped_raises_not_running() -> None:
+    """After run has returned, call_from_thread raises 'App is not running' without blocking."""
+    app = AfterStopApp()
+    result = app.run(headless=True)
+    _join_thread(app.thread)
+    assert result == 8
+    try:
+        app.call_from_thread(lambda: None)
+    except RuntimeError as error:
+        assert str(error) == "App is not running"
+    else:
+        raise AssertionError("RuntimeError was not raised")
