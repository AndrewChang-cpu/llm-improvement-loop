+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, in the context of the app, and block until it returns.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in the
+        correct context (the app's event loop, with the app as the active app), so it can be
+        used from a thread other than the app thread. The call blocks until the callable has
+        returned (awaiting it if it returns an awaitable), and then returns its result.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. It may return a value or an awaitable.
+            *args: Positional arguments forwarded to the callable unchanged.
+            **kwargs: Keyword arguments forwarded to the callable unchanged.
+
+        Raises:
+            RuntimeError: If the app is not running (before it starts, or after it has stopped).
+            RuntimeError: If called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
