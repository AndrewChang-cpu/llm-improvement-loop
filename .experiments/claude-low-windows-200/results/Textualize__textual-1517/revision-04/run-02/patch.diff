+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from a thread other than the app thread, in the app's context.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (with this app as the active app), and blocks the
+        calling thread until the callable has returned.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]): The
+                callable to run in the app's context. It may return a value or an awaitable.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped).
+            RuntimeError: If called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable, after awaiting if needed.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callable in the app's context on the app's event loop."""
+            self._set_active()
+            bound = partial(callback, *args, **kwargs)
+            return await invoke(bound)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
