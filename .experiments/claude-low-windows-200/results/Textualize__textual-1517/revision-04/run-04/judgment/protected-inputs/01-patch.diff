diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..85e5956
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,189 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+THREAD_JOIN_TIMEOUT = 5.0
+
+
+class CallFromThreadApp(App[int]):
+    """An app that runs a body on a daemon thread once it is mounted.
+
+    The body receives the app and returns an exit code. The thread always
+    finishes by asking the app to exit with that code, via call_from_thread.
+    """
+
+    def __init__(self, body: Callable[[CallFromThreadApp], int]) -> None:
+        self._body = body
+        self.outcome: dict[str, Any] = {}
+        self.thread: threading.Thread | None = None
+        super().__init__()
+
+    def compose(self):
+        yield TextLog(id="log")
+
+    def on_mount(self) -> None:
+        self.thread = threading.Thread(target=self._run_body, daemon=True)
+        self.thread.start()
+
+    def _run_body(self) -> None:
+        try:
+            exit_code = self._body(self)
+        except BaseException as error:
+            self.outcome["error"] = error
+            # Ask the app to exit so the test run terminates.
+            self.call_from_thread(self.exit, -1)
+        else:
+            self.call_from_thread(self.exit, exit_code)
+
+
+def run_body(body: Callable[[CallFromThreadApp], int]) -> tuple[Any, CallFromThreadApp]:
+    """Run a body from a background thread inside a headless app.
+
+    Returns the app's return value and the app (whose outcome dict holds results).
+    """
+    app = CallFromThreadApp(body)
+    return_value = app.run(headless=True)
+    assert app.thread is not None
+    app.thread.join(THREAD_JOIN_TIMEOUT)
+    assert not app.thread.is_alive()
+    return return_value, app
+
+
+def test_call_from_thread_before_app_runs_raises_not_running() -> None:
+    """A call made before the app has started raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_returns_raises_not_running() -> None:
+    """A call made after run has returned raises 'App is not running' without blocking."""
+    class ExitOnMountApp(App[int]):
+        def on_mount(self) -> None:
+            self.exit(0)
+
+    app = ExitOnMountApp()
+    assert app.run(headless=True) == 0
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_on_app_thread_raises_runtime_error() -> None:
+    """Calling call_from_thread from the app thread raises a RuntimeError."""
+    captured: dict[str, Any] = {}
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                captured["error"] = error
+            self.exit(0)
+
+    result = SameThreadApp().run(headless=True)
+    assert result == 0
+    assert isinstance(captured.get("error"), RuntimeError)
+    assert "different thread from the app" in str(captured["error"])
+
+
+def test_call_from_thread_writes_to_widget_and_returns_result() -> None:
+    """A callable that accesses a widget through the app completes and returns its result."""
+
+    def body(app: CallFromThreadApp) -> int:
+        def write_to_log() -> str:
+            app.query_one("#log", TextLog).write("hello from thread")
+            return "written"
+
+        app.outcome["result"] = app.call_from_thread(write_to_log)
+        return 3
+
+    return_value, app = run_body(body)
+    assert "error" not in app.outcome
+    assert app.outcome["result"] == "written"
+    assert return_value == 3
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+
+    async def coro() -> int:
+        return 42
+
+    def body(app: CallFromThreadApp) -> int:
+        app.outcome["result"] = app.call_from_thread(coro)
+        return 0
+
+    _, app = run_body(body)
+    assert "error" not in app.outcome
+    assert app.outcome["result"] == 42
+
+
+def test_call_from_thread_reraises_timeout_exception_with_same_message_and_args() -> None:
+    """A timeout-class exception from the callable re-raises on the calling thread."""
+
+    def raise_timeout() -> None:
+        raise TimeoutError("request timed out")
+
+    def body(app: CallFromThreadApp) -> int:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            app.outcome["error"] = error
+        else:
+            app.outcome["error"] = None
+        return 0
+
+    _, app = run_body(body)
+    error = app.outcome["error"]
+    assert isinstance(error, Exception)
+    assert str(error) == "request timed out"
+    assert error.args == ("request timed out",)
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable() -> None:
+    """A variadic callable receives every supplied positional argument."""
+
+    def collect(*values: object) -> tuple:
+        return values
+
+    def body(app: CallFromThreadApp) -> int:
+        app.outcome["result"] = app.call_from_thread(collect, 1, "two", 3.0)
+        return 0
+
+    _, app = run_body(body)
+    assert "error" not in app.outcome
+    assert app.outcome["result"] == (1, "two", 3.0)
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_parameters() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+
+    def combine(first: int, *, second: int = 0, label: str = "") -> str:
+        return f"{label}:{first + second}"
+
+    def body(app: CallFromThreadApp) -> int:
+        app.outcome["result"] = app.call_from_thread(
+            combine, 1, second=2, label="sum"
+        )
+        return 0
+
+    _, app = run_body(body)
+    assert "error" not in app.outcome
+    assert app.outcome["result"] == "sum:3"
+
+
+def test_call_from_thread_exit_makes_run_return_exit_value() -> None:
+    """A background thread that exits the app through call_from_thread makes run return the exit value."""
+
+    def body(app: CallFromThreadApp) -> int:
+        return 7
+
+    return_value, app = run_body(body)
+    assert "error" not in app.outcome
+    assert return_value == 7
