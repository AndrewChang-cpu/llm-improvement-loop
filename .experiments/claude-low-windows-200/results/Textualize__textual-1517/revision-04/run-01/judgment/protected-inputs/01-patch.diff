diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..9d25f9c
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,176 @@
+from __future__ import annotations
+
+import asyncio
+import threading
+from concurrent.futures import TimeoutError as FutureTimeoutError
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+# Upper bound (in seconds) for any blocking wait in these tests.
+WAIT_TIMEOUT = 5.0
+
+
+class LogApp(App[int]):
+    """An app with a single TextLog widget."""
+
+    def compose(self):
+        yield TextLog(id="log")
+
+
+def run_with_background_thread(
+    app: App,
+    work: Callable[[App, dict[str, Any]], None],
+) -> tuple[Any, dict[str, Any], threading.Thread]:
+    """Run the app headless, starting `work` on a daemon thread once the app is ready.
+
+    The thread is started from the auto pilot, which runs once the app is ready.
+    The auto pilot waits (without blocking the loop) for the thread to finish.
+
+    Returns:
+        A tuple of the app's return value, the outcome dictionary populated by
+        `work`, and the background thread.
+    """
+    outcome: dict[str, Any] = {}
+    thread = threading.Thread(target=work, args=(app, outcome), daemon=True)
+
+    async def auto_pilot(pilot) -> None:
+        thread.start()
+        loop = asyncio.get_running_loop()
+        await loop.run_in_executor(None, thread.join, WAIT_TIMEOUT)
+
+    return_value = app.run(headless=True, auto_pilot=auto_pilot)
+    return return_value, outcome, thread
+
+
+def assert_thread_finished(thread: threading.Thread) -> None:
+    """Join the background thread with a bounded wait and assert it has finished."""
+    thread.join(WAIT_TIMEOUT)
+    assert not thread.is_alive()
+
+
+def test_call_from_thread_before_run_raises_not_running():
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error():
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            self.call_from_thread_error = None
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.call_from_thread_error = error
+            self.exit()
+
+    app = SameThreadApp()
+    app.run(headless=True)
+    assert isinstance(app.call_from_thread_error, RuntimeError)
+    assert "different thread from the app" in str(app.call_from_thread_error)
+    assert "not running" not in str(app.call_from_thread_error)
+
+
+def test_call_from_thread_writes_to_widget_in_app():
+    def work(app: App, outcome: dict[str, Any]) -> None:
+        def write_to_log() -> str:
+            log = app.query_one(TextLog)
+            log.write("hello from a thread")
+            return "written"
+
+        try:
+            outcome["result"] = app.call_from_thread(write_to_log)
+            app.call_from_thread(app.exit, 3)
+        except Exception as error:  # pragma: no cover - reported via outcome
+            outcome["error"] = error
+            app.call_from_thread(app.exit, 1)
+
+    return_value, outcome, thread = run_with_background_thread(LogApp(), work)
+    assert_thread_finished(thread)
+    assert "error" not in outcome
+    assert outcome["result"] == "written"
+    assert return_value == 3
+
+
+def test_call_from_thread_awaits_awaitable_result():
+    async def coroutine_callable() -> str:
+        await asyncio.sleep(0)
+        return "awaited value"
+
+    def work(app: App, outcome: dict[str, Any]) -> None:
+        outcome["result"] = app.call_from_thread(coroutine_callable)
+        app.call_from_thread(app.exit, 4)
+
+    app = App[int]()
+    return_value, outcome, thread = run_with_background_thread(app, work)
+    assert_thread_finished(thread)
+    assert outcome["result"] == "awaited value"
+    assert return_value == 4
+
+
+def test_call_from_thread_propagates_timeout_exception_and_returns():
+    def raises_timeout() -> None:
+        raise FutureTimeoutError("request timed out")
+
+    def work(app: App, outcome: dict[str, Any]) -> None:
+        try:
+            app.call_from_thread(raises_timeout)
+        except Exception as error:
+            outcome["error"] = error
+        else:  # pragma: no cover - the call must raise
+            outcome["error"] = None
+        app.call_from_thread(app.exit, 5)
+
+    return_value, outcome, thread = run_with_background_thread(App[int](), work)
+    assert_thread_finished(thread)
+    error = outcome["error"]
+    assert error is not None
+    assert str(error) == "request timed out"
+    assert error.args == ("request timed out",)
+    assert return_value == 5
+
+
+def test_call_from_thread_forwards_all_positional_arguments_to_variadic_callable():
+    def collect(*values: object) -> tuple:
+        return values
+
+    def work(app: App, outcome: dict[str, Any]) -> None:
+        outcome["result"] = app.call_from_thread(collect, 1, "two", 3.0)
+        app.call_from_thread(app.exit, 6)
+
+    return_value, outcome, thread = run_with_background_thread(App[int](), work)
+    assert_thread_finished(thread)
+    assert outcome["result"] == (1, "two", 3.0)
+    assert return_value == 6
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters():
+    def combine(first: int, second: str, *, flag: bool) -> str:
+        return f"{first}-{second}-{flag}"
+
+    def work(app: App, outcome: dict[str, Any]) -> None:
+        outcome["result"] = app.call_from_thread(
+            combine, 7, "eight", flag=True
+        )
+        app.call_from_thread(app.exit, 8)
+
+    return_value, outcome, thread = run_with_background_thread(App[int](), work)
+    assert_thread_finished(thread)
+    assert outcome["result"] == "7-eight-True"
+    assert return_value == 8
+
+
+def test_call_from_thread_after_run_returned_raises_not_running():
+    app = App()
+    app.run(headless=True, auto_pilot=_exit_immediately)
+    # The app has stopped, so the call must be rejected at entry rather than blocking.
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+async def _exit_immediately(pilot) -> None:
+    pilot.app.exit(9)
