+        self,
+        callback: Callable[..., CallbackReturnType | Awaitable[CallbackReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallbackReturnType:
+        """Run a callable in the context of the app from a different thread.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context, and blocks the calling thread until the callable
+        has returned (awaiting it if it is awaitable).
+
+        Args:
+            callback (Callable[..., CallbackReturnType | Awaitable[CallbackReturnType]]):
+                The callable to run in the app's context. It may be a regular function
+                or a coroutine function.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped).
+            RuntimeError: If called from the app's own thread.
+
+        Returns:
+            CallbackReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallbackReturnType:
+            self._set_active()
+            return await invoke(bound_callback)
+
+        scheduled = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return scheduled.result()
