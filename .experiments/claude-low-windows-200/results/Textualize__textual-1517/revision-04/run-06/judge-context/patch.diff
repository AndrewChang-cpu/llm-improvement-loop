diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..7d64d15
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,174 @@
+from __future__ import annotations
+
+import threading
+from concurrent.futures import TimeoutError as FuturesTimeoutError
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+THREAD_JOIN_TIMEOUT = 10
+
+
+class WorkerApp(App[Any]):
+    """An app that starts a daemon worker thread once it is ready."""
+
+    def __init__(self, worker: Callable[[WorkerApp], None]) -> None:
+        super().__init__()
+        self.worker_callback = worker
+        self.worker_thread: threading.Thread | None = None
+
+    def compose(self):
+        yield TextLog(id="log")
+
+    def on_ready(self) -> None:
+        self.worker_thread = threading.Thread(
+            target=self.worker_callback, args=(self,), daemon=True
+        )
+        self.worker_thread.start()
+
+
+def run_with_worker(worker: Callable[[WorkerApp], None]) -> Any:
+    """Run a WorkerApp headlessly and return its exit value.
+
+    Asserts that the worker thread finished within the join timeout.
+    """
+    app = WorkerApp(worker)
+    return_value = app.run(headless=True)
+    assert app.worker_thread is not None
+    app.worker_thread.join(THREAD_JOIN_TIMEOUT)
+    assert not app.worker_thread.is_alive()
+    return return_value
+
+
+def test_call_from_thread_before_app_runs_raises_not_running():
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_returns_raises_not_running():
+    class ExitImmediatelyApp(App[None]):
+        def on_ready(self) -> None:
+            self.exit()
+
+    app = ExitImmediatelyApp()
+    app.run(headless=True)
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_same_thread_error():
+    captured: dict[str, str] = {}
+
+    class SameThreadApp(App[None]):
+        def on_ready(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                captured["message"] = str(error)
+            self.exit()
+
+    SameThreadApp().run(headless=True)
+    assert captured["message"] == (
+        "The `call_from_thread` method must run in a different thread from the app"
+    )
+
+
+def test_call_from_thread_returns_callable_result_to_calling_thread():
+    results: dict[str, Any] = {}
+
+    def worker(app: WorkerApp) -> None:
+        results["value"] = app.call_from_thread(lambda: 42)
+        app.call_from_thread(app.exit, 5)
+
+    assert run_with_worker(worker) == 5
+    assert results["value"] == 42
+
+
+def test_call_from_thread_writes_to_text_log_widget_in_app():
+    outcome: dict[str, bool] = {}
+
+    def write_to_log(app: WorkerApp) -> None:
+        log = app.get_widget_by_id("log", TextLog)
+        log.write("hello from a worker thread")
+        outcome["completed"] = True
+
+    def worker(app: WorkerApp) -> None:
+        app.call_from_thread(write_to_log, app)
+        app.call_from_thread(app.exit, 3)
+
+    assert run_with_worker(worker) == 3
+    assert outcome["completed"]
+
+
+def test_call_from_thread_awaits_awaitable_result():
+    results: dict[str, Any] = {}
+
+    async def double(value: int) -> int:
+        return value * 2
+
+    def worker(app: WorkerApp) -> None:
+        results["value"] = app.call_from_thread(double, 21)
+        app.call_from_thread(app.exit, 4)
+
+    assert run_with_worker(worker) == 4
+    assert results["value"] == 42
+
+
+def test_call_from_thread_reraises_timeout_exception_with_same_message():
+    errors: list[BaseException] = []
+
+    def raise_timeout() -> None:
+        raise FuturesTimeoutError("slow response")
+
+    def worker(app: WorkerApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            errors.append(error)
+        app.call_from_thread(app.exit, 6)
+
+    assert run_with_worker(worker) == 6
+    assert len(errors) == 1
+    assert str(errors[0]) == "slow response"
+    assert errors[0].args == ("slow response",)
+
+
+def test_call_from_thread_forwards_positional_args_to_variadic_callable():
+    results: dict[str, Any] = {}
+
+    def collect(*values: Any, **options: Any) -> tuple[tuple[Any, ...], dict]:
+        return values, options
+
+    def worker(app: WorkerApp) -> None:
+        results["value"] = app.call_from_thread(collect, 1, 2, 3, suffix="!")
+        app.call_from_thread(app.exit, 2)
+
+    assert run_with_worker(worker) == 2
+    assert results["value"] == ((1, 2, 3), {"suffix": "!"})
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters():
+    results: dict[str, Any] = {}
+
+    def combine(first: str, second: str, *, separator: str) -> str:
+        return f"{first}{separator}{second}"
+
+    def worker(app: WorkerApp) -> None:
+        results["value"] = app.call_from_thread(
+            combine, "left", "right", separator="-"
+        )
+        app.call_from_thread(app.exit, 8)
+
+    assert run_with_worker(worker) == 8
+    assert results["value"] == "left-right"
+
+
+def test_background_thread_exit_via_call_from_thread_returns_exit_value():
+    def worker(app: WorkerApp) -> None:
+        app.call_from_thread(app.exit, 9)
+
+    assert run_with_worker(worker) == 9
