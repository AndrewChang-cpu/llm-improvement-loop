diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..e3d31f2
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,186 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+THREAD_JOIN_TIMEOUT = 5
+
+
+class ScenarioApp(App[int]):
+    """An app that runs a scenario on a daemon thread once it is mounted.
+
+    The scenario must finish by calling `call_from_thread(app.exit, value)`,
+    which makes `run` return `value`.
+    """
+
+    def __init__(self, scenario: Callable[[ScenarioApp], None]) -> None:
+        super().__init__()
+        self.scenario = scenario
+        self.results: dict[str, Any] = {}
+        self.scenario_error: BaseException | None = None
+        self.thread = threading.Thread(target=self._run_scenario, daemon=True)
+
+    def compose(self):
+        yield TextLog(id="log")
+
+    def on_mount(self) -> None:
+        self.thread.start()
+
+    def _run_scenario(self) -> None:
+        try:
+            self.scenario(self)
+        except BaseException as error:
+            self.scenario_error = error
+            try:
+                self.call_from_thread(self.exit, None)
+            except RuntimeError:
+                pass
+
+
+def run_scenario(scenario: Callable[[ScenarioApp], None]) -> tuple[ScenarioApp, Any]:
+    """Run a scenario headlessly and return the app and the value run returned."""
+    app = ScenarioApp(scenario)
+    result = app.run(headless=True)
+    app.thread.join(THREAD_JOIN_TIMEOUT)
+    assert not app.thread.is_alive(), "scenario thread did not finish"
+    if app.scenario_error is not None:
+        raise app.scenario_error
+    return app, result
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """Calling call_from_thread on an app that has never run raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_returns_raises_not_running() -> None:
+    """After run has returned, call_from_thread raises 'App is not running' without blocking."""
+    app = App()
+    app.run(headless=True, auto_pilot=_exit_immediately)
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+async def _exit_immediately(pilot) -> None:
+    pilot.app.exit(0)
+
+
+def test_call_from_app_thread_raises_runtime_error() -> None:
+    """Calling call_from_thread from the app thread raises a RuntimeError about threads."""
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.same_thread_message = str(error)
+            self.exit(7)
+
+    app = SameThreadApp()
+    result = app.run(headless=True)
+    assert result == 7
+    assert "must run in a different thread from the app" in app.same_thread_message
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    """The value returned by the callable is returned to the calling thread."""
+
+    def scenario(app: ScenarioApp) -> None:
+        app.results["value"] = app.call_from_thread(lambda: "hello")
+        app.call_from_thread(app.exit, 3)
+
+    app, result = run_scenario(scenario)
+    assert app.results["value"] == "hello"
+    assert result == 3
+
+
+def test_call_from_thread_widget_access_completes_and_exits() -> None:
+    """A callable that queries and writes to a widget completes, and the app exits with the code."""
+
+    def write_to_log() -> None:
+        log = app_holder[0].query_one(TextLog)
+        log.write("written from thread")
+
+    app_holder: list[ScenarioApp] = []
+
+    def scenario(app: ScenarioApp) -> None:
+        app_holder.append(app)
+        app.results["completed"] = app.call_from_thread(write_to_log) is None
+        app.call_from_thread(app.exit, 5)
+
+    app, result = run_scenario(scenario)
+    assert app.results["completed"] is True
+    assert result == 5
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+
+    async def produce() -> str:
+        return "awaited"
+
+    def scenario(app: ScenarioApp) -> None:
+        app.results["value"] = app.call_from_thread(produce)
+        app.call_from_thread(app.exit, 4)
+
+    app, result = run_scenario(scenario)
+    assert app.results["value"] == "awaited"
+    assert result == 4
+
+
+def test_call_from_thread_reraises_timeout_exception_message_and_args() -> None:
+    """A timeout-class exception from the callable is re-raised on the calling thread."""
+
+    class ThirdPartyTimeoutError(Exception):
+        """Stands in for a timeout exception raised by a third-party API."""
+
+    def raise_timeout() -> None:
+        raise ThirdPartyTimeoutError("took too long", 99)
+
+    def scenario(app: ScenarioApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            app.results["args"] = error.args
+        app.call_from_thread(app.exit, 6)
+
+    app, result = run_scenario(scenario)
+    assert app.results["args"] == ("took too long", 99)
+    assert result == 6
+
+
+def test_call_from_thread_forwards_positional_and_keyword_arguments() -> None:
+    """A variadic callable receives all positional arguments; named parameters receive keywords."""
+
+    def variadic(*values: int) -> tuple[int, ...]:
+        return values
+
+    def named(first: int, second: int, *, label: str) -> str:
+        return f"{label}:{first + second}"
+
+    def scenario(app: ScenarioApp) -> None:
+        app.results["variadic"] = app.call_from_thread(variadic, 1, 2, 3, 4)
+        app.results["named"] = app.call_from_thread(named, 1, 2, label="sum")
+        app.call_from_thread(app.exit, 8)
+
+    app, result = run_scenario(scenario)
+    assert app.results["variadic"] == (1, 2, 3, 4)
+    assert app.results["named"] == "sum:3"
+    assert result == 8
+
+
+def test_call_from_thread_exit_returns_supplied_exit_value() -> None:
+    """A background thread calling exit through call_from_thread makes run return that value."""
+
+    def scenario(app: ScenarioApp) -> None:
+        app.call_from_thread(app.exit, 11)
+
+    _, result = run_scenario(scenario)
+    assert result == 11
