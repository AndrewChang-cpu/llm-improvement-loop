+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, in the context of the app, and return its result.
+
+        Textual objects are not thread-safe. This call ensures the callable runs
+        in the correct context (the app's event loop, with the app active).
+        The call blocks until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]): A callable
+                (or a callable returning an awaitable) to run in the app's context.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it starts, or after it has stopped).
+            RuntimeError: If called from the app's own thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable, after awaiting if needed.
+        """
+        loop = self._thread_loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Make this app active, then invoke the bound callback."""
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), loop
+        )
+        return future.result()
+
