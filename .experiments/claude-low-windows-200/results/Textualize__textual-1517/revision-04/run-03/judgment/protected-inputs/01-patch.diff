+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (the app's event loop, with the app as the active app).
+        The call blocks the calling thread until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. It may return a value or an awaitable.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it starts and after it has stopped).
+            RuntimeError: If called from the app's own thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable, after awaiting it if needed.
+        """
+        if self._thread_loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            self._set_active()
+            bound_callback = partial(callback, *args, **kwargs)
+            return await invoke(bound_callback)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), self._thread_loop
+        )
+        return future.result()
+
