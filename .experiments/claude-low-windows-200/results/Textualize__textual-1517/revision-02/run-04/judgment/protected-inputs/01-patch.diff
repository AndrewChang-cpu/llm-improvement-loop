diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..71d7ca6
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,205 @@
+"""Tests for calling into the app from threads other than the app thread."""
+
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+EXIT_CODE = 7
+
+
+def _app_with_worker(worker: Callable[[App], None], errors: list[BaseException]) -> App:
+    """Create an app whose `worker` runs on a background thread once the app is mounted.
+
+    The worker must not exit the app itself. When it finishes (or raises), the app is
+    exited with `EXIT_CODE` through `call_from_thread`. Any exception from the worker is
+    appended to `errors` for the main thread to inspect.
+    """
+
+    class WorkerApp(App[int]):
+        def compose(self):
+            yield TextLog(id="log")
+
+        def on_mount(self) -> None:
+            def run_worker() -> None:
+                try:
+                    worker(self)
+                except BaseException as error:
+                    errors.append(error)
+                finally:
+                    self.call_from_thread(self.exit, EXIT_CODE)
+
+            threading.Thread(target=run_worker, daemon=True).start()
+
+    return WorkerApp()
+
+
+def test_call_from_thread_before_run_raises():
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises():
+    class ExitOnMountApp(App[int]):
+        def on_mount(self) -> None:
+            self.exit(EXIT_CODE)
+
+    app = ExitOnMountApp()
+    assert app.run(headless=True) == EXIT_CODE
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_app_thread_raises():
+    raised: list[BaseException] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                raised.append(error)
+            self.exit(EXIT_CODE)
+
+    assert SameThreadApp().run(headless=True) == EXIT_CODE
+    assert len(raised) == 1
+    assert "different thread" in str(raised[0])
+
+
+def test_call_from_thread_returns_result():
+    errors: list[BaseException] = []
+    results: list[Any] = []
+
+    def worker(app: App) -> None:
+        results.append(app.call_from_thread(lambda: "value"))
+
+    app = _app_with_worker(worker, errors)
+    assert app.run(headless=True) == EXIT_CODE
+    assert errors == []
+    assert results == ["value"]
+
+
+def test_call_from_thread_widget_access():
+    errors: list[BaseException] = []
+
+    def write_to_log(app: App) -> None:
+        app.query_one("#log", TextLog).write("hello from a thread")
+
+    def worker(app: App) -> None:
+        app.call_from_thread(write_to_log, app)
+
+    app = _app_with_worker(worker, errors)
+    assert app.run(headless=True) == EXIT_CODE
+    assert errors == []
+
+
+def test_call_from_thread_awaits_awaitable():
+    errors: list[BaseException] = []
+    results: list[Any] = []
+
+    async def double(value: int) -> int:
+        return value * 2
+
+    def worker(app: App) -> None:
+        results.append(app.call_from_thread(double, 21))
+
+    app = _app_with_worker(worker, errors)
+    assert app.run(headless=True) == EXIT_CODE
+    assert errors == []
+    assert results == [42]
+
+
+def test_call_from_thread_propagates_timeout_exception():
+    errors: list[BaseException] = []
+    caught: list[BaseException] = []
+
+    def raise_timeout() -> None:
+        raise TimeoutError("third-party timeout")
+
+    def worker(app: App) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except TimeoutError as error:
+            caught.append(error)
+
+    app = _app_with_worker(worker, errors)
+    assert app.run(headless=True) == EXIT_CODE
+    assert errors == []
+    assert len(caught) == 1
+    assert str(caught[0]) == "third-party timeout"
+
+
+def test_call_from_thread_propagates_exception_unchanged():
+    errors: list[BaseException] = []
+    original = ValueError("boom")
+    caught: list[BaseException] = []
+
+    def raise_value_error() -> None:
+        raise original
+
+    def worker(app: App) -> None:
+        try:
+            app.call_from_thread(raise_value_error)
+        except ValueError as error:
+            caught.append(error)
+
+    app = _app_with_worker(worker, errors)
+    assert app.run(headless=True) == EXIT_CODE
+    assert errors == []
+    assert len(caught) == 1
+    assert caught[0] is original
+
+
+def test_call_from_thread_forwards_positional_arguments_to_variadic_callable():
+    errors: list[BaseException] = []
+    results: list[Any] = []
+
+    def collect(*args: Any, **kwargs: Any) -> tuple[tuple[Any, ...], dict[str, Any]]:
+        return args, kwargs
+
+    def worker(app: App) -> None:
+        results.append(app.call_from_thread(collect, 1, 2, 3, key="value"))
+
+    app = _app_with_worker(worker, errors)
+    assert app.run(headless=True) == EXIT_CODE
+    assert errors == []
+    assert results == [((1, 2, 3), {"key": "value"})]
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters():
+    errors: list[BaseException] = []
+    results: list[Any] = []
+
+    def combine(a: int, b: int, *, c: int) -> int:
+        return a + b + c
+
+    def worker(app: App) -> None:
+        results.append(app.call_from_thread(combine, 1, 2, c=3))
+
+    app = _app_with_worker(worker, errors)
+    assert app.run(headless=True) == EXIT_CODE
+    assert errors == []
+    assert results == [6]
+
+
+def test_call_from_thread_exit_returns_exit_value():
+    errors: list[BaseException] = []
+
+    class ExitApp(App[int]):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                try:
+                    self.call_from_thread(self.exit, 42)
+                except BaseException as error:
+                    errors.append(error)
+
+            threading.Thread(target=worker, daemon=True).start()
+
+    assert ExitApp().run(headless=True) == 42
+    assert errors == []
