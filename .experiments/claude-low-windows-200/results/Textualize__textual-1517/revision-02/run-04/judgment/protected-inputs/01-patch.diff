+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from a thread other than the app thread.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in the
+        correct app context, on the app's event loop. The call blocks the calling thread
+        until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable that may return a value or an awaitable. If it returns an awaitable,
+                it is awaited on the app's event loop.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after it has
+                stopped), or if called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable, after awaiting if needed.
+        """
+        loop = self._thread_loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callback in the app's context on the app's event loop."""
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), loop)
+        return future.result()
