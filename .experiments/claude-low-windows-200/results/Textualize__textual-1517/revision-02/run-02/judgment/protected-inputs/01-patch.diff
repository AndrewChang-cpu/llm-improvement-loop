diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..69f5da1
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,150 @@
+import concurrent.futures
+import threading
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+class ThreadedApp(App):
+    """Runs `work(app)` on a background thread once mounted, then exits with 7."""
+
+    EXIT_VALUE = 7
+
+    def __init__(self, work) -> None:
+        super().__init__()
+        self._work = work
+        self.outcome = None
+        self.error = None
+
+    def on_mount(self) -> None:
+        threading.Thread(target=self._background).start()
+
+    def _background(self) -> None:
+        try:
+            self.outcome = self._work(self)
+        except BaseException as error:  # recorded and checked by the test
+            self.error = error
+        finally:
+            self.call_from_thread(self.exit, self.EXIT_VALUE)
+
+
+def run_threaded(work) -> ThreadedApp:
+    app = ThreadedApp(work)
+    result = app.run(headless=True)
+    assert result == ThreadedApp.EXIT_VALUE
+    return app
+
+
+def test_call_from_thread_returns_result():
+    app = run_threaded(lambda app: app.call_from_thread(lambda: 42))
+    assert app.error is None
+    assert app.outcome == 42
+
+
+def test_call_from_thread_forwards_positional_and_keyword_arguments():
+    def variadic(*args, **kwargs):
+        return args, kwargs
+
+    def named(a, b, *, c):
+        return a, b, c
+
+    def work(app):
+        return (
+            app.call_from_thread(variadic, 1, 2, 3, key="value"),
+            app.call_from_thread(named, 1, 2, c=3),
+        )
+
+    app = run_threaded(work)
+    assert app.error is None
+    assert app.outcome == (((1, 2, 3), {"key": "value"}), (1, 2, 3))
+
+
+def test_call_from_thread_awaits_awaitable():
+    async def coro(value):
+        return value * 2
+
+    app = run_threaded(lambda app: app.call_from_thread(coro, 21))
+    assert app.error is None
+    assert app.outcome == 42
+
+
+def test_call_from_thread_propagates_exceptions_unchanged():
+    error = concurrent.futures.TimeoutError("third-party timeout")
+
+    def raise_error():
+        raise error
+
+    def work(app):
+        with pytest.raises(concurrent.futures.TimeoutError) as info:
+            app.call_from_thread(raise_error)
+        assert info.value is error
+        return "returned"
+
+    app = run_threaded(work)
+    assert app.error is None
+    assert app.outcome == "returned"
+
+
+def test_call_from_thread_widget_access():
+    def write_log(app):
+        log = app.query_one(TextLog)
+        log.write("hello from a thread")
+
+    class WidgetApp(ThreadedApp):
+        def compose(self):
+            yield TextLog()
+
+    app = WidgetApp(lambda app: app.call_from_thread(write_log, app))
+    result = app.run(headless=True)
+    assert result == ThreadedApp.EXIT_VALUE
+    assert app.error is None
+
+
+def test_call_from_app_thread_raises():
+    errors = []
+
+    class SameThreadApp(App):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(1)
+
+    assert SameThreadApp().run(headless=True) == 1
+    assert len(errors) == 1
+    assert "different thread" in str(errors[0])
+
+
+def test_call_before_run_raises():
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_after_run_raises_without_blocking():
+    class ExitImmediatelyApp(App):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = ExitImmediatelyApp()
+    app.run(headless=True)
+    done = threading.Event()
+    errors = []
+
+    def background():
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            errors.append(error)
+        finally:
+            done.set()
+
+    thread = threading.Thread(target=background)
+    thread.start()
+    assert done.wait(timeout=5), "call_from_thread blocked after the app stopped"
+    thread.join()
+    assert len(errors) == 1
+    assert str(errors[0]) == "App is not running"
