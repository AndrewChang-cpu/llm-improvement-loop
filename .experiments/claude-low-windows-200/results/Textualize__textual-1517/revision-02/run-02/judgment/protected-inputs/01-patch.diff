+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from another thread and wait for its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context, on the app's event loop. The call blocks the
+        calling thread until the callable returns (awaiting it if it is awaitable).
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. It may return a value or an awaitable.
+            *args: Positional arguments forwarded to the callable unchanged.
+            **kwargs: Keyword arguments forwarded to the callable unchanged.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped).
+            RuntimeError: If called from the app thread; this method must run in a
+                different thread from the app.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> tuple[bool, Any]:
+            # Capture the outcome instead of letting the task fail: asyncio copies
+            # task exceptions to the concurrent future and converts some types
+            # (e.g. concurrent.futures.TimeoutError), which would change the error.
+            self._set_active()
+            try:
+                return True, await invoke(bound_callback)
+            except BaseException as error:
+                return False, error
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        succeeded, value = future.result()
+        if not succeeded:
+            raise value
+        return value
+
     async def _on_css_change(self) -> None:
