diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..1a8d0a2
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,152 @@
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+class TimeoutLikeError(Exception):
+    """Stand-in for a third-party timeout-class exception."""
+
+
+class ThreadedApp(App[int]):
+    """Runs `worker` on a background thread once mounted, then exits with its result."""
+
+    def __init__(self, worker: Callable[[ThreadedApp], int]) -> None:
+        super().__init__()
+        self._worker = worker
+        self.worker_errors: list[BaseException] = []
+
+    def compose(self):
+        yield TextLog(id="log")
+
+    def on_mount(self) -> None:
+        thread = threading.Thread(target=self._run_worker, daemon=True)
+        thread.start()
+
+    def _run_worker(self) -> None:
+        try:
+            exit_code = self._worker(self)
+        except BaseException as error:
+            self.worker_errors.append(error)
+            exit_code = -1
+        self.call_from_thread(self.exit, exit_code)
+
+
+def run_threaded(worker: Callable[[ThreadedApp], int]) -> int | None:
+    """Run the app headlessly, execute the worker on a thread, and re-raise worker errors."""
+    app = ThreadedApp(worker)
+    result = app.run(headless=True)
+    if app.worker_errors:
+        raise app.worker_errors[0]
+    return result
+
+
+def test_call_from_thread_not_running() -> None:
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread() -> None:
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            finally:
+                self.exit(0)
+
+    SameThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert "different thread" in str(errors[0])
+
+
+def test_call_from_thread_widget_access() -> None:
+    def worker(app: ThreadedApp) -> int:
+        def write_to_log() -> None:
+            app.query_one("#log", TextLog).write("hello from thread")
+
+        app.call_from_thread(write_to_log)
+        return 7
+
+    assert run_threaded(worker) == 7
+
+
+def test_call_from_thread_returns_result() -> None:
+    def worker(app: ThreadedApp) -> int:
+        value = app.call_from_thread(lambda: 41 + 1)
+        return value
+
+    assert run_threaded(worker) == 42
+
+
+def test_call_from_thread_awaitable() -> None:
+    async def compute() -> str:
+        return "awaited"
+
+    def worker(app: ThreadedApp) -> int:
+        result = app.call_from_thread(compute)
+        return 0 if result == "awaited" else 1
+
+    assert run_threaded(worker) == 0
+
+
+def test_call_from_thread_propagates_timeout_like_exception() -> None:
+    error = TimeoutLikeError("timed out")
+
+    def raise_timeout() -> None:
+        raise error
+
+    def worker(app: ThreadedApp) -> int:
+        with pytest.raises(TimeoutLikeError) as info:
+            app.call_from_thread(raise_timeout)
+        assert info.value is error
+        return 0
+
+    assert run_threaded(worker) == 0
+
+
+def test_call_from_thread_variadic_arguments() -> None:
+    def collect(*args: Any, **kwargs: Any) -> tuple[tuple[Any, ...], dict[str, Any]]:
+        return args, kwargs
+
+    def worker(app: ThreadedApp) -> int:
+        args, kwargs = app.call_from_thread(collect, 1, 2, 3, key="value")
+        assert args == (1, 2, 3)
+        assert kwargs == {"key": "value"}
+        return 0
+
+    assert run_threaded(worker) == 0
+
+
+def test_call_from_thread_named_parameters() -> None:
+    def named(a: int, b: int = 0, *, key: str = "") -> tuple[int, int, str]:
+        return a, b, key
+
+    def worker(app: ThreadedApp) -> int:
+        result = app.call_from_thread(named, 1, b=2, key="x")
+        return 0 if result == (1, 2, "x") else 1
+
+    assert run_threaded(worker) == 0
+
+
+def test_call_from_thread_after_stop() -> None:
+    app = ThreadedApp(lambda app: 0)
+    assert app.run(headless=True) == 0  # run has returned; the app has stopped
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_exit_value() -> None:
+    def worker(app: ThreadedApp) -> int:
+        return 5
+
+    assert run_threaded(worker) == 5
