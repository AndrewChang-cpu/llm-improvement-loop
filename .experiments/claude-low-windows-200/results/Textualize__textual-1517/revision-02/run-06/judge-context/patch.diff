+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the context of the app from a different thread.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context (on the app's event loop), and blocks the calling
+        thread until the callable has returned. If the callable returns an awaitable,
+        it is awaited before returning.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. It may be a regular function
+                or a coroutine function.
+            *args: Positional arguments forwarded to the callable unchanged.
+            **kwargs: Keyword arguments forwarded to the callable unchanged.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after
+                it has stopped), or if called from the app's own thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._thread_loop is None:
+            raise RuntimeError("App is not running")
+        if self._thread_id == threading.get_ident():
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            """Make this app active, then invoke the callable."""
+            self._set_active()
+            bound = partial(callback, *args, **kwargs)
+            return await invoke(bound)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._thread_loop)
+        return future.result()
