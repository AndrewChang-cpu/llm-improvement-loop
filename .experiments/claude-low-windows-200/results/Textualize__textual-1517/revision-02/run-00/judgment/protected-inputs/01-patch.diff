         css_paths = self.css_path
diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..b74d124
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,160 @@
+"""Tests for calling into the app from non-app threads via App.call_from_thread."""
+
+from __future__ import annotations
+
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+class _ThirdPartyTimeoutError(Exception):
+    """A timeout-class exception, as raised by a third-party API."""
+
+
+def _start_worker(
+    app: App[Any], work: Callable[[], Any], outcome: list[Any]
+) -> threading.Thread:
+    """Start a background thread that runs `work` and records its outcome.
+
+    The worker never blocks the app thread: it records the result, then exits the
+    app with the code returned by `work`'s own bookkeeping via call_from_thread.
+    """
+
+    def target() -> None:
+        try:
+            outcome.append(("ok", work()))
+        except BaseException as error:
+            outcome.append(("error", error))
+
+    thread = threading.Thread(target=target, daemon=True)
+    thread.start()
+    return thread
+
+
+def test_call_from_thread_before_run_raises() -> None:
+    """Calling before the app has run should raise 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread_raises() -> None:
+    """Calling from the app thread should raise a RuntimeError."""
+
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            with pytest.raises(RuntimeError, match="different thread"):
+                self.call_from_thread(lambda: None)
+            self.exit()
+
+    SameThreadApp().run(headless=True)
+
+
+def test_call_from_thread_widget_access() -> None:
+    """A callable touching widgets through the app should complete without error."""
+
+    class WidgetApp(App[int]):
+        def compose(self):
+            yield TextLog()
+
+        def on_mount(self) -> None:
+            outcome: list[Any] = []
+
+            def work() -> None:
+                def write_to_log() -> None:
+                    self.query_one(TextLog).write("hello from thread")
+
+                self.call_from_thread(write_to_log)
+                outcome.append("completed")
+                self.call_from_thread(self.exit, 7)
+
+            _start_worker(self, work, outcome)
+
+    assert WidgetApp().run(headless=True) == 7
+
+
+def test_call_from_thread_returns_awaited_result() -> None:
+    """An awaitable returned by the callable is awaited and its result returned."""
+
+    class AwaitableApp(App[int]):
+        def on_mount(self) -> None:
+            async def compute() -> int:
+                return 42
+
+            def work() -> None:
+                result = self.call_from_thread(lambda: compute())
+                self.call_from_thread(self.exit, result)
+
+            _start_worker(self, work, [])
+
+    assert AwaitableApp().run(headless=True) == 42
+
+
+def test_call_from_thread_propagates_timeout_exception() -> None:
+    """A timeout-class exception propagates unchanged and the call returns."""
+
+    class TimeoutApp(App[str]):
+        def on_mount(self) -> None:
+            def raise_timeout() -> None:
+                raise _ThirdPartyTimeoutError("third-party timeout")
+
+            def work() -> None:
+                try:
+                    self.call_from_thread(raise_timeout)
+                except _ThirdPartyTimeoutError as error:
+                    self.call_from_thread(self.exit, f"raised:{error}")
+                    return
+                self.call_from_thread(self.exit, "not raised")
+
+            _start_worker(self, work, [])
+
+    assert TimeoutApp().run(headless=True) == "raised:third-party timeout"
+
+
+def test_call_from_thread_forwards_arguments() -> None:
+    """Positional arguments reach variadic callables; keywords reach named params."""
+
+    class ArgsApp(App[str]):
+        def on_mount(self) -> None:
+            def variadic(*values: int) -> tuple[int, ...]:
+                return values
+
+            def named(*, first: str, second: str) -> str:
+                return f"{first}-{second}"
+
+            def work() -> None:
+                values = self.call_from_thread(variadic, 1, 2, 3)
+                joined = self.call_from_thread(named, first="a", second="b")
+                self.call_from_thread(self.exit, f"{values}|{joined}")
+
+            _start_worker(self, work, [])
+
+    assert ArgsApp().run(headless=True) == "(1, 2, 3)|a-b"
+
+
+def test_call_from_thread_after_run_raises() -> None:
+    """Calls made after run has returned raise 'App is not running' without blocking."""
+
+    class QuickApp(App[int]):
+        def on_mount(self) -> None:
+            self.exit(3)
+
+    app = QuickApp()
+    assert app.run(headless=True) == 3
+
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_exit_from_thread() -> None:
+    """A background thread can exit the app through call_from_thread."""
+
+    class ExitApp(App[str]):
+        def on_mount(self) -> None:
+            _start_worker(self, lambda: self.call_from_thread(self.exit, "bye"), [])
+
+    assert ExitApp().run(headless=True) == "bye"
