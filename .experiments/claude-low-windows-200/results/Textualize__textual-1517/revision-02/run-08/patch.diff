+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the app's context (on the app's event loop), so it may safely access
+        widgets and other app state. The call blocks the calling thread until the
+        callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. It may return a value or an
+                awaitable; an awaitable is awaited and its result returned.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after
+                it has stopped).
+            RuntimeError: If called from the app's own thread; this method must run
+                in a different thread from the app.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            self._set_active()
+            return await invoke(bound_callback)
+
+        # The outcome is copied to a concurrent future without asyncio's exception
+        # conversion, so the callable's exception reaches the caller unchanged.
+        result_future: Future[CallThreadReturnType] = Future()
+
+        def copy_outcome(task: asyncio.Future) -> None:
+            if task.cancelled():
+                result_future.cancel()
+                return
+            error = task.exception()
+            if error is not None:
+                result_future.set_exception(error)
+            else:
+                result_future.set_result(task.result())
+
+        def schedule() -> None:
+            task = asyncio.ensure_future(run_callback())
+            task.add_done_callback(copy_outcome)
+
+        loop.call_soon_threadsafe(schedule)
+        return result_future.result()
+
