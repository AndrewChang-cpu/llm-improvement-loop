diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..7c30ea1
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,170 @@
+"""Tests for calling into the app from threads other than the app thread."""
+
+from __future__ import annotations
+
+import threading
+from concurrent.futures import TimeoutError as FutureTimeoutError
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+def run_in_background(app: App, work: Callable[[], None]) -> threading.Thread:
+    """Start a background thread that runs `work`, then exits the app."""
+
+    def target() -> None:
+        try:
+            work()
+        finally:
+            # Always exit so that a failing check cannot hang the test run.
+            app.call_from_thread(app.exit, None)
+
+    return threading.Thread(target=target, daemon=True)
+
+
+def test_call_from_thread_not_running() -> None:
+    """Calling before the app runs raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises() -> None:
+    """Calling after run has returned raises and does not block."""
+    class ExitOnMountApp(App[None]):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = ExitOnMountApp()
+    app.run(headless=True)
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_app_thread_raises() -> None:
+    """Calling from the app's own thread raises a runtime error."""
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            finally:
+                self.exit()
+
+    SameThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert "different thread" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_widget_access() -> None:
+    """A callable can access widgets through the app when called from a thread."""
+    completed: list[bool] = []
+
+    class WidgetApp(App[int]):
+        def compose(self):
+            yield TextLog()
+
+        def on_mount(self) -> None:
+            def work() -> None:
+                def write_log() -> None:
+                    self.query_one(TextLog).write("hello from thread")
+
+                self.call_from_thread(write_log)
+                completed.append(True)
+
+            run_in_background(self, work).start()
+
+    # The background thread exits the app with a supplied code.
+    assert WidgetApp().run(headless=True) is None
+    assert completed == [True]
+
+
+def test_call_from_thread_returns_result_and_exit_code() -> None:
+    """The callable's result is returned, and the thread can exit the app."""
+    results: list[Any] = []
+
+    class ExitApp(App[int]):
+        def on_mount(self) -> None:
+            def work() -> None:
+                results.append(self.call_from_thread(lambda: 40 + 2))
+
+            def target() -> None:
+                try:
+                    work()
+                finally:
+                    self.call_from_thread(self.exit, 42)
+
+            threading.Thread(target=target, daemon=True).start()
+
+    assert ExitApp().run(headless=True) == 42
+    assert results == [42]
+
+
+def test_call_from_thread_awaitable() -> None:
+    """An awaitable returned by the callable is awaited and its result returned."""
+    results: list[Any] = []
+
+    async def coro() -> str:
+        return "awaited"
+
+    class AwaitApp(App[None]):
+        def on_mount(self) -> None:
+            def work() -> None:
+                results.append(self.call_from_thread(coro))
+
+            run_in_background(self, work).start()
+
+    AwaitApp().run(headless=True)
+    assert results == ["awaited"]
+
+
+def test_call_from_thread_exception_propagates() -> None:
+    """A timeout-class exception from the callable reaches the calling thread unchanged."""
+    caught: list[BaseException] = []
+    raised = FutureTimeoutError("third-party timeout")
+
+    def raiser() -> None:
+        raise raised
+
+    class RaiseApp(App[None]):
+        def on_mount(self) -> None:
+            def work() -> None:
+                try:
+                    self.call_from_thread(raiser)
+                except BaseException as error:
+                    caught.append(error)
+
+            run_in_background(self, work).start()
+
+    RaiseApp().run(headless=True)
+    assert len(caught) == 1
+    assert caught[0] is raised
+
+
+def test_call_from_thread_variadic_and_keyword_arguments() -> None:
+    """All positional and keyword arguments reach the callable."""
+    results: list[Any] = []
+
+    def variadic(*args: Any, **kwargs: Any) -> tuple:
+        return args, kwargs
+
+    def named(a: int, b: int) -> int:
+        return a + b
+
+    class ArgsApp(App[None]):
+        def on_mount(self) -> None:
+            def work() -> None:
+                results.append(self.call_from_thread(variadic, 1, 2, 3, key="value"))
+                results.append(self.call_from_thread(named, a=1, b=2))
+
+            run_in_background(self, work).start()
+
+    ArgsApp().run(headless=True)
+    assert results == [((1, 2, 3), {"key": "value"}), 3]
