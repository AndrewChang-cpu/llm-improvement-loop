+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from a thread other than the app's thread, and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in the
+        correct context (with this app as the active app) on the app's event loop.
+        The call blocks until the callable has returned.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. If it returns an awaitable, the
+                awaitable is awaited and its result is returned.
+            *args: Positional arguments forwarded to the callable unchanged.
+            **kwargs: Keyword arguments forwarded to the callable unchanged.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started,
+                or after it has stopped).
+            RuntimeError: If called from the app's thread; call_from_thread must run in a
+                different thread from the app.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._thread_loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callback within the app context."""
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._thread_loop)
+        return future.result()
