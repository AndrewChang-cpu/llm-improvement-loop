+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from another thread and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (the app's event loop, with this app as the active app),
+        so it can be used from threads other than the app thread, such as a worker
+        thread wrapping a third-party threaded API.
+
+        The call blocks the calling thread until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. It may return a value or an
+                awaitable; awaitables are awaited before the result is returned.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after it has stopped).
+            RuntimeError: If called from the app thread; this method must run in a different thread from the app.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._thread_loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), loop)
+        return future.result()
