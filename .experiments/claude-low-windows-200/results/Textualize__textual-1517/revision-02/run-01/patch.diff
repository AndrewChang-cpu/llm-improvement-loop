+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from another thread, and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in
+        the correct app context (on the app's event loop), so it may be used from a
+        worker thread wrapping a third-party threaded API. The call blocks the calling
+        thread until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. If it returns an awaitable, the
+                awaitable is awaited.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped), or if called from the app's own thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> tuple[bool, Any]:
+            # Hand back the callable's exception object itself, so that asyncio's
+            # cross-thread future bridge (which can rebuild some exception classes)
+            # cannot change what the calling thread receives.
+            self._set_active()
+            try:
+                return True, await invoke(bound_callback)
+            except Exception as error:
+                return False, error
+
+        future: Future[tuple[bool, Any]] = asyncio.run_coroutine_threadsafe(
+            run_callback(), self._loop
+        )
+        succeeded, outcome = future.result()
+        if succeeded:
+            return outcome
+        raise outcome
