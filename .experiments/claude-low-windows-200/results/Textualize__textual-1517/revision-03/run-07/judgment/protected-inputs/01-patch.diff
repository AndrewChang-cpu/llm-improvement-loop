diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..10be887
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,196 @@
+"""Tests for App.call_from_thread, run from a background thread."""
+
+import threading
+from concurrent.futures import TimeoutError as FutureTimeoutError
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+class ThreadCallApp(App[int]):
+    """An app that starts a background thread from on_mount."""
+
+    def __init__(self, work: Callable[["ThreadCallApp"], None]) -> None:
+        self.work = work
+        self.thread_error: BaseException | None = None
+        super().__init__()
+
+    def compose(self):
+        yield TextLog(id="log")
+
+    def on_mount(self) -> None:
+        def target() -> None:
+            try:
+                self.work(self)
+            except BaseException as error:
+                self.thread_error = error
+                # Stop the app so a failing callable cannot hang the test.
+                try:
+                    self.call_from_thread(self.exit)
+                except RuntimeError:
+                    pass  # The app has already stopped.
+
+        self.thread = threading.Thread(target=target)
+        self.thread.start()
+
+
+def run_with_thread(work: Callable[[ThreadCallApp], None]) -> tuple[ThreadCallApp, Any]:
+    """Run the app headless; the background thread receives the app as its argument."""
+    app = ThreadCallApp(work)
+    result = app.run(headless=True)
+    app.thread.join()
+    return app, result
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    """The value returned by the callable is returned to the calling thread."""
+    results: list[object] = []
+
+    def work(app: ThreadCallApp) -> None:
+        results.append(app.call_from_thread(lambda: "hello"))
+        app.call_from_thread(app.exit, 3)
+
+    app, exit_value = run_with_thread(work)
+    assert app.thread_error is None
+    assert results == ["hello"]
+    assert exit_value == 3
+
+
+def test_call_from_thread_writes_to_widget() -> None:
+    """A callable that queries and writes to a widget completes without error."""
+
+    def write_to_log(app: ThreadCallApp) -> None:
+        app.query_one("#log", TextLog).write("written from thread")
+
+    def work(app: ThreadCallApp) -> None:
+        app.call_from_thread(write_to_log, app)
+        app.call_from_thread(app.exit, 4)
+
+    app, exit_value = run_with_thread(work)
+    assert app.thread_error is None
+    assert exit_value == 4
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result is returned."""
+    results: list[object] = []
+
+    async def double(value: int) -> int:
+        return value * 2
+
+    def work(app: ThreadCallApp) -> None:
+        results.append(app.call_from_thread(double, 21))
+        app.call_from_thread(app.exit, 5)
+
+    app, exit_value = run_with_thread(work)
+    assert app.thread_error is None
+    assert results == [42]
+    assert exit_value == 5
+
+
+def test_call_from_thread_propagates_timeout_exception() -> None:
+    """A timeout-class exception from the callable is re-raised on the calling thread."""
+    errors: list[BaseException] = []
+
+    def raise_timeout() -> None:
+        raise FutureTimeoutError("timed out")
+
+    def work(app: ThreadCallApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            errors.append(error)
+        app.call_from_thread(app.exit, 6)
+
+    app, exit_value = run_with_thread(work)
+    assert app.thread_error is None
+    assert len(errors) == 1
+    assert str(errors[0]) == "timed out"
+    assert errors[0].args == ("timed out",)
+    assert exit_value == 6
+
+
+def test_call_from_thread_forwards_all_positional_arguments_to_variadic_callable() -> None:
+    """A variadic callable receives every supplied positional argument."""
+    results: list[object] = []
+
+    def collect(*values: object) -> tuple:
+        return values
+
+    def work(app: ThreadCallApp) -> None:
+        results.append(app.call_from_thread(collect, 1, "two", 3.0))
+        app.call_from_thread(app.exit, 7)
+
+    app, exit_value = run_with_thread(work)
+    assert app.thread_error is None
+    assert results == [(1, "two", 3.0)]
+    assert exit_value == 7
+
+
+def test_call_from_thread_forwards_keyword_arguments_to_named_parameters() -> None:
+    """A callable with named parameters receives the supplied keyword arguments."""
+    results: list[object] = []
+
+    def label(value: int, *, prefix: str) -> str:
+        return f"{prefix}{value}"
+
+    def work(app: ThreadCallApp) -> None:
+        results.append(app.call_from_thread(label, 8, prefix="item-"))
+        app.call_from_thread(app.exit, 8)
+
+    app, exit_value = run_with_thread(work)
+    assert app.thread_error is None
+    assert results == ["item-8"]
+    assert exit_value == 8
+
+
+def test_call_from_thread_raises_when_called_from_app_thread() -> None:
+    """Calling from the app thread raises a RuntimeError naming the different-thread rule."""
+    errors: list[RuntimeError] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(9)
+
+    exit_value = SameThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert "must run in a different thread from the app" in str(errors[0])
+    assert exit_value == 9
+
+
+def test_call_from_thread_raises_before_app_runs() -> None:
+    """Calling before the app runs raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_raises_after_app_has_stopped() -> None:
+    """Calling after run has returned raises 'App is not running' without blocking."""
+
+    class StoppingApp(App[int]):
+        def on_mount(self) -> None:
+            self.exit(10)
+
+    app = StoppingApp()
+    assert app.run(headless=True) == 10
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_exit_from_background_thread_returns_exit_value() -> None:
+    """A background thread that exits the app through call_from_thread makes run return the exit value."""
+
+    def work(app: ThreadCallApp) -> None:
+        app.call_from_thread(app.exit, 11)
+
+    app, exit_value = run_with_thread(work)
+    assert app.thread_error is None
+    assert exit_value == 11
