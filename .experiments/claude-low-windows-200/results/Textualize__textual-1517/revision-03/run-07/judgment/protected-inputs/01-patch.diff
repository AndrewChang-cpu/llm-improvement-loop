+    def call_from_thread(
+        self,
+        callback: Callable[..., CallbackReturnType | Awaitable[CallbackReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallbackReturnType:
+        """Run a callable in the app's context from another thread and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (the app's event loop, with this app active), and
+        blocks until the callable has returned.
+
+        Args:
+            callback (Callable[..., CallbackReturnType | Awaitable[CallbackReturnType]]):
+                A callable to run in the app's context. It may return a value or an awaitable.
+            *args: Positional arguments forwarded unchanged to the callable.
+            **kwargs: Keyword arguments forwarded unchanged to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (it has not started, or has stopped).
+            RuntimeError: If called from the app's own thread.
+
+        Returns:
+            CallbackReturnType: The result of the callable, after awaiting if needed.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallbackReturnType:
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
