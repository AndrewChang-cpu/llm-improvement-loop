diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..8329f6d
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,185 @@
+import asyncio
+import threading
+from typing import Any
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+def run_with_background_thread(
+    app: App, thread_body, exit_value: Any = 0, exit_after_body: bool = True
+) -> Any:
+    """Run the app headless, starting a background thread once the app is ready.
+
+    The thread body receives the app and stores its outcome in a dict. When the
+    body finishes and ``exit_after_body`` is set, the thread exits the app with
+    ``exit_value`` through call_from_thread. The auto pilot waits, without blocking
+    the app's loop, until the thread finishes.
+
+    Returns:
+        A tuple of the outcome dict and the value returned by app.run.
+    """
+    outcome: dict = {}
+
+    def thread_target() -> None:
+        try:
+            outcome["value"] = thread_body(app)
+        except BaseException as error:  # captured for assertions in the test
+            outcome["error"] = error
+        finally:
+            if exit_after_body:
+                app.call_from_thread(app.exit, exit_value)
+
+    async def auto_pilot(pilot) -> None:
+        thread = threading.Thread(target=thread_target)
+        thread.start()
+        while thread.is_alive():
+            await asyncio.sleep(0.01)
+        thread.join()
+
+    app_return = app.run(headless=True, auto_pilot=auto_pilot)
+    return outcome, app_return
+
+
+class NotRunningApp(App[None]):
+    pass
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """Calling call_from_thread before the app has started raises 'App is not running'."""
+    app = NotRunningApp()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_runtime_error() -> None:
+    """Calling call_from_thread from the app thread raises a RuntimeError about threads."""
+    errors: list = []
+
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    SameThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert "different thread from the app" in str(errors[0])
+
+
+def test_call_from_thread_returns_value_from_background_thread() -> None:
+    """A background thread gets the return value of a callable run on the app."""
+    app = NotRunningApp()
+    outcome, _ = run_with_background_thread(
+        app, lambda app: app.call_from_thread(lambda: 123)
+    )
+    assert outcome.get("error") is None
+    assert outcome["value"] == 123
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """A callable returning an awaitable is awaited and its result returned to the thread."""
+
+    async def coro_callable() -> str:
+        await asyncio.sleep(0)
+        return "awaited"
+
+    app = NotRunningApp()
+    outcome, _ = run_with_background_thread(
+        app, lambda app: app.call_from_thread(coro_callable)
+    )
+    assert outcome.get("error") is None
+    assert outcome["value"] == "awaited"
+
+
+def test_call_from_thread_can_write_to_text_log_widget() -> None:
+    """A callable that touches a widget through the app completes without error."""
+
+    class LogApp(App[int]):
+        def compose(self):
+            yield TextLog(id="log")
+
+    app = LogApp()
+
+    def thread_body(app: App) -> None:
+        def write_to_log() -> None:
+            app.query_one("#log", TextLog).write("hello from thread")
+
+        app.call_from_thread(write_to_log)
+
+    outcome, app_return = run_with_background_thread(
+        app, thread_body, exit_value=4
+    )
+    assert outcome.get("error") is None
+    assert app_return == 4
+
+
+def test_call_from_thread_reraises_timeout_exception_with_same_message() -> None:
+    """A timeout-class exception raised by the callable is re-raised on the calling thread."""
+
+    def raise_timeout() -> None:
+        raise TimeoutError("timed out", 7)
+
+    app = NotRunningApp()
+    outcome, _ = run_with_background_thread(
+        app, lambda app: app.call_from_thread(raise_timeout)
+    )
+    error = outcome.get("error")
+    assert isinstance(error, Exception)
+    assert error.args == ("timed out", 7)
+    assert "timed out" in str(error)
+
+
+def test_call_from_thread_forwards_all_positional_args_to_variadic_callable() -> None:
+    """All supplied positional arguments reach a variadic callable."""
+
+    def variadic(*values: int) -> tuple:
+        return values
+
+    app = NotRunningApp()
+    outcome, _ = run_with_background_thread(
+        app, lambda app: app.call_from_thread(variadic, 1, 2, 3)
+    )
+    assert outcome.get("error") is None
+    assert outcome["value"] == (1, 2, 3)
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_parameters() -> None:
+    """Supplied keyword arguments reach a callable with named parameters."""
+
+    def named(first: int, second: str) -> str:
+        return f"{first}-{second}"
+
+    app = NotRunningApp()
+    outcome, _ = run_with_background_thread(
+        app, lambda app: app.call_from_thread(named, first=5, second="x")
+    )
+    assert outcome.get("error") is None
+    assert outcome["value"] == "5-x"
+
+
+def test_call_from_thread_exit_returns_exit_value_from_run() -> None:
+    """Exiting the app through call_from_thread makes run return the supplied exit value."""
+    app = NotRunningApp()
+    _, app_return = run_with_background_thread(
+        app,
+        lambda app: app.call_from_thread(app.exit, 42),
+        exit_after_body=False,
+    )
+    assert app_return == 42
+
+
+def test_call_from_thread_after_run_has_returned_raises_not_running() -> None:
+    """After run has returned, call_from_thread raises 'App is not running' without blocking."""
+    app = NotRunningApp()
+    app.run(headless=True, auto_pilot=_exit_immediately)
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+async def _exit_immediately(pilot) -> None:
+    pilot.app.exit(0)
