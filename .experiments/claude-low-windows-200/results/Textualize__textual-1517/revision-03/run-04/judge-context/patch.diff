diff --git a/tests/test_call_from_thread.py b/tests/test_call_from_thread.py
new file mode 100644
index 0000000..3c24347
--- /dev/null
+++ b/tests/test_call_from_thread.py
@@ -0,0 +1,176 @@
+import threading
+from concurrent.futures import TimeoutError as FuturesTimeoutError
+from typing import Any, Callable, List
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+def run_in_thread(app: App, work: Callable[[], None], exit_value: Any) -> None:
+    """Run `work` on a background thread, then exit the app with `exit_value`."""
+
+    def target() -> None:
+        try:
+            work()
+        finally:
+            app.call_from_thread(app.exit, exit_value)
+
+    threading.Thread(target=target, daemon=True).start()
+
+
+class ThreadApp(App[Any]):
+    """An app that runs a background-thread workload once mounted."""
+
+    def __init__(self, work: Callable[["ThreadApp"], None], exit_value: Any) -> None:
+        super().__init__()
+        self._work = work
+        self._exit_value = exit_value
+
+    def compose(self):
+        yield TextLog(id="log")
+
+    def on_mount(self) -> None:
+        run_in_thread(self, lambda: self._work(self), self._exit_value)
+
+
+def test_call_from_thread_before_run_raises_not_running() -> None:
+    """Calling before the app has started raises 'App is not running'."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises_not_running() -> None:
+    """Calling after the app's run has returned raises 'App is not running' without blocking."""
+    class ExitOnMountApp(App[int]):
+        def on_mount(self) -> None:
+            self.exit(3)
+
+    stopped_app = ExitOnMountApp()
+    assert stopped_app.run(headless=True) == 3
+    with pytest.raises(RuntimeError, match="App is not running"):
+        stopped_app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises_same_thread_error() -> None:
+    """Calling from the app thread raises a runtime error naming the thread rule."""
+    errors: List[BaseException] = []
+
+    class SameThreadApp(App[int]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit(5)
+
+    assert SameThreadApp().run(headless=True) == 5
+    assert len(errors) == 1
+    assert "must run in a different thread from the app" in str(errors[0])
+
+
+def test_call_from_thread_writes_to_widget_and_returns() -> None:
+    """A callable that accesses a widget through the app completes without error."""
+    outcome: List[BaseException] = []
+
+    def work(app: ThreadApp) -> None:
+        def write_log() -> None:
+            app.query_one(TextLog).write("hello from thread")
+
+        try:
+            app.call_from_thread(write_log)
+        except Exception as error:  # pragma: no cover - reported via assertion
+            outcome.append(error)
+
+    app = ThreadApp(work, exit_value=7)
+    assert app.run(headless=True) == 7
+    assert outcome == []
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    """An awaitable returned by the callable is awaited and its result returned."""
+    results: List[Any] = []
+
+    async def compute() -> int:
+        return 21 * 2
+
+    def work(app: ThreadApp) -> None:
+        results.append(app.call_from_thread(compute))
+
+    app = ThreadApp(work, exit_value=0)
+    assert app.run(headless=True) == 0
+    assert results == [42]
+
+
+def test_call_from_thread_returns_sync_result() -> None:
+    """A synchronous callable's return value is returned to the calling thread."""
+    results: List[Any] = []
+
+    def work(app: ThreadApp) -> None:
+        results.append(app.call_from_thread(lambda: "value"))
+
+    app = ThreadApp(work, exit_value=0)
+    assert app.run(headless=True) == 0
+    assert results == ["value"]
+
+
+def test_call_from_thread_propagates_timeout_exception_message_and_args() -> None:
+    """A timeout-class exception reaches the calling thread with the same message and args."""
+    raised: List[BaseException] = []
+
+    def timeout_callable() -> None:
+        raise FuturesTimeoutError("third-party timed out")
+
+    def work(app: ThreadApp) -> None:
+        try:
+            app.call_from_thread(timeout_callable)
+        except Exception as error:
+            raised.append(error)
+
+    app = ThreadApp(work, exit_value=1)
+    assert app.run(headless=True) == 1
+    assert len(raised) == 1
+    assert str(raised[0]) == "third-party timed out"
+    assert raised[0].args == ("third-party timed out",)
+
+
+def test_call_from_thread_forwards_positional_args_to_variadic_callable() -> None:
+    """All supplied positional arguments reach a variadic callable."""
+    results: List[Any] = []
+
+    def collect(*values: int) -> tuple:
+        return values
+
+    def work(app: ThreadApp) -> None:
+        results.append(app.call_from_thread(collect, 1, 2, 3))
+
+    app = ThreadApp(work, exit_value=0)
+    assert app.run(headless=True) == 0
+    assert results == [(1, 2, 3)]
+
+
+def test_call_from_thread_forwards_keyword_args_to_named_parameters() -> None:
+    """Supplied keyword arguments reach a callable with named parameters."""
+    results: List[Any] = []
+
+    def combine(*, left: int, right: int) -> int:
+        return left + right
+
+    def work(app: ThreadApp) -> None:
+        results.append(app.call_from_thread(combine, left=20, right=22))
+
+    app = ThreadApp(work, exit_value=0)
+    assert app.run(headless=True) == 0
+    assert results == [42]
+
+
+def test_call_from_thread_exit_from_thread_returns_exit_value() -> None:
+    """Exiting the app through call_from_thread makes run return the exit value 11."""
+
+    def work(app: ThreadApp) -> None:
+        app.call_from_thread(app.exit, 11)
+
+    app = ThreadApp(work, exit_value=11)
+    assert app.run(headless=True) == 11
