+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from a thread other than the app thread.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (with the app active) on the app's event loop, and
+        blocks the calling thread until the callable has returned.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run on the app's thread. If it returns an awaitable, the
+                awaitable is awaited and its result is returned.
+            *args: Positional arguments forwarded to the callable unchanged.
+            **kwargs: Keyword arguments forwarded to the callable unchanged.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped), or if called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The `call_from_thread` method must run in a different thread from the app"
+            )
+
+        bound_callback = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            self._set_active()
+            return await invoke(bound_callback)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), self._loop)
+        return future.result()
+
