diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..5a63bc9
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,162 @@
+import asyncio
+import threading
+from typing import Any, Callable
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+class ThreadWorkApp(App):
+    """An app that runs a work function on a background thread once mounted.
+
+    The work function must end the app itself by calling `call_from_thread(app.exit, ...)`.
+    If the work function raises, the error is stored and the app is exited with None.
+    """
+
+    def __init__(self, work: Callable[["ThreadWorkApp"], None]) -> None:
+        super().__init__()
+        self.work = work
+        self.work_error: BaseException | None = None
+        self.thread: threading.Thread | None = None
+
+    def compose(self):
+        yield TextLog()
+
+    def on_mount(self) -> None:
+        self.thread = threading.Thread(target=self._run_work, daemon=True)
+        self.thread.start()
+
+    def _run_work(self) -> None:
+        try:
+            self.work(self)
+        except BaseException as error:
+            self.work_error = error
+            try:
+                self.call_from_thread(self.exit)
+            except Exception:
+                pass
+
+
+def test_call_from_thread_not_running_raises() -> None:
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_from_app_thread_raises() -> None:
+    errors: list[RuntimeError] = []
+
+    class SameThreadApp(App):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    SameThreadApp().run(headless=True, size=(80, 24))
+    assert len(errors) == 1
+    assert "different thread from the app" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_returns_callable_result() -> None:
+    results: list[object] = []
+
+    def work(app: ThreadWorkApp) -> None:
+        results.append(app.call_from_thread(lambda: "value"))
+        app.call_from_thread(app.exit, 3)
+
+    app = ThreadWorkApp(work)
+    assert app.run(headless=True, size=(80, 24)) == 3
+    assert app.work_error is None
+    assert results == ["value"]
+
+
+def test_call_from_thread_awaits_awaitable_result() -> None:
+    results: list[object] = []
+
+    async def produce() -> int:
+        await asyncio.sleep(0)
+        return 42
+
+    def work(app: ThreadWorkApp) -> None:
+        results.append(app.call_from_thread(produce))
+        app.call_from_thread(app.exit, 5)
+
+    app = ThreadWorkApp(work)
+    assert app.run(headless=True, size=(80, 24)) == 5
+    assert app.work_error is None
+    assert results == [42]
+
+
+def test_call_from_thread_widget_access_completes() -> None:
+    def write_to_log(app: ThreadWorkApp) -> None:
+        app.query_one(TextLog).write("hello from thread")
+
+    def work(app: ThreadWorkApp) -> None:
+        app.call_from_thread(write_to_log, app)
+        app.call_from_thread(app.exit, 9)
+
+    app = ThreadWorkApp(work)
+    assert app.run(headless=True, size=(80, 24)) == 9
+    assert app.work_error is None
+
+
+def test_call_from_thread_propagates_timeout_exception() -> None:
+    errors: list[BaseException] = []
+
+    def raise_timeout() -> None:
+        raise TimeoutError("third-party timeout", 17)
+
+    def work(app: ThreadWorkApp) -> None:
+        try:
+            app.call_from_thread(raise_timeout)
+        except Exception as error:
+            errors.append(error)
+        app.call_from_thread(app.exit, 4)
+
+    app = ThreadWorkApp(work)
+    assert app.run(headless=True, size=(80, 24)) == 4
+    assert app.work_error is None
+    assert len(errors) == 1
+    assert errors[0].args == ("third-party timeout", 17)
+
+
+def test_call_from_thread_forwards_positional_and_keyword_arguments() -> None:
+    received: list[object] = []
+
+    def collect(*items: Any, **options: Any) -> None:
+        received.append((items, options))
+
+    def work(app: ThreadWorkApp) -> None:
+        app.call_from_thread(collect, 1, "two", 3.0, key="value")
+        app.call_from_thread(app.exit, 6)
+
+    app = ThreadWorkApp(work)
+    assert app.run(headless=True, size=(80, 24)) == 6
+    assert app.work_error is None
+    assert received == [((1, "two", 3.0), {"key": "value"})]
+
+
+def test_call_from_thread_after_app_stopped_raises() -> None:
+    def work(app: ThreadWorkApp) -> None:
+        app.call_from_thread(app.exit, 2)
+
+    app = ThreadWorkApp(work)
+    assert app.run(headless=True, size=(80, 24)) == 2
+    assert app.work_error is None
+
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_exit_returns_supplied_value() -> None:
+    def work(app: ThreadWorkApp) -> None:
+        app.call_from_thread(app.exit, 7)
+
+    app = ThreadWorkApp(work)
+    assert app.run(headless=True, size=(80, 24)) == 7
+    assert app.work_error is None
