diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..fe82721
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,147 @@
+import asyncio
+import threading
+from typing import Any
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+class ThreadApp(App[Any]):
+    """A headless app with a text log, used for cross-thread calls."""
+
+    def compose(self):
+        yield TextLog(id="log")
+
+
+def run_in_background(target) -> threading.Thread:
+    """Start a background thread that runs `target`, and collect its outcome."""
+    thread = threading.Thread(target=target, daemon=True)
+    thread.start()
+    return thread
+
+
+def test_call_from_thread_not_running() -> None:
+    """Calling before the app runs raises, rather than blocking."""
+    app = ThreadApp()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread() -> None:
+    """Calling from the app thread raises a runtime error."""
+    errors: list[BaseException] = []
+
+    class SameThreadApp(ThreadApp):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    SameThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert "different thread from the app" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_widget_access() -> None:
+    """A callable touching widgets through the app succeeds from another thread."""
+    written_lines: list[int] = []
+
+    class WidgetApp(ThreadApp):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                def write_log() -> None:
+                    log = self.query_one(TextLog)
+                    log.write("hello from thread")
+                    # Widgets are torn down once run returns, so inspect them here.
+                    written_lines.append(len(log.lines))
+
+                self.call_from_thread(write_log)
+                self.call_from_thread(self.exit, "done")
+
+            run_in_background(worker)
+
+    result = WidgetApp().run(headless=True)
+    assert result == "done"
+    assert written_lines and written_lines[0] > 0  # the write reached the widget
+
+
+def test_call_from_thread_awaitable() -> None:
+    """An awaitable returned by the callable is awaited, and its result returned."""
+    results: list[int] = []
+
+    async def compute(value: int) -> int:
+        await asyncio.sleep(0)
+        return value * 2
+
+    class AwaitableApp(ThreadApp):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                results.append(self.call_from_thread(compute, 21))
+                self.call_from_thread(self.exit)
+
+            run_in_background(worker)
+
+    AwaitableApp().run(headless=True)
+    assert results == [42]
+
+
+def test_call_from_thread_exception_propagates() -> None:
+    """Exceptions raised by the callable propagate to the calling thread."""
+    errors: list[BaseException] = []
+
+    def fail() -> None:
+        raise ValueError("boom")
+
+    class FailApp(ThreadApp):
+        def on_mount(self) -> None:
+            def worker() -> None:
+                try:
+                    self.call_from_thread(fail)
+                except ValueError as error:
+                    errors.append(error)
+                self.call_from_thread(self.exit)
+
+            run_in_background(worker)
+
+    FailApp().run(headless=True)
+    assert len(errors) == 1
+    assert str(errors[0]) == "boom"
+
+
+def test_call_from_thread_exit_value() -> None:
+    """A background thread can exit the app with a value, returned by run."""
+
+    class ExitApp(ThreadApp):
+        def on_mount(self) -> None:
+            run_in_background(lambda: self.call_from_thread(self.exit, "bye"))
+
+    assert ExitApp().run(headless=True) == "bye"
+
+
+def test_call_from_thread_after_stop_does_not_block() -> None:
+    """After run has returned, calls raise 'App is not running' without blocking."""
+    class QuickApp(ThreadApp):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = QuickApp()
+    app.run(headless=True)
+
+    outcome: list[BaseException] = []
+
+    def worker() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            outcome.append(error)
+
+    thread = run_in_background(worker)
+    thread.join(timeout=5)
+    assert not thread.is_alive(), "call_from_thread blocked after the app stopped"
+    assert len(outcome) == 1
+    assert "App is not running" in str(outcome[0])
