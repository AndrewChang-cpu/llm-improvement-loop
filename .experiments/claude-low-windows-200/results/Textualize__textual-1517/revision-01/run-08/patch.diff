diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..4f32aae
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,149 @@
+import threading
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+def _run_in_thread(target) -> threading.Thread:
+    thread = threading.Thread(target=target, daemon=True)
+    thread.start()
+    return thread
+
+
+def test_call_from_thread_not_running():
+    """Calling before the app has run raises, without blocking."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises():
+    """Calling after run has returned raises and does not block."""
+    class ExitOnMountApp(App):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = ExitOnMountApp()
+    app.run(headless=True)
+
+    errors: list[BaseException] = []
+
+    def worker() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except BaseException as error:
+            errors.append(error)
+
+    thread = _run_in_thread(worker)
+    thread.join(timeout=5)
+    assert not thread.is_alive()
+    assert len(errors) == 1
+    assert isinstance(errors[0], RuntimeError)
+    assert str(errors[0]) == "App is not running"
+
+
+def test_call_from_app_thread_raises():
+    """Calling from the app thread raises a RuntimeError."""
+    errors: list[BaseException] = []
+
+    class SameThreadApp(App):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                errors.append(error)
+            self.exit()
+
+    SameThreadApp().run(headless=True)
+    assert len(errors) == 1
+    assert "different thread" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_widget_access_and_result():
+    """A background thread can write to a widget and receive a result."""
+    results: dict[str, object] = {}
+
+    class WidgetApp(App):
+        def compose(self):
+            yield TextLog(id="log")
+
+        def on_mount(self) -> None:
+            def worker() -> None:
+                def write_to_log() -> int:
+                    log = self.query_one("#log", TextLog)
+                    log.write("hello from thread")
+                    return 42
+
+                results["value"] = self.call_from_thread(write_to_log)
+                self.call_from_thread(self.exit, "done")
+
+            _run_in_thread(worker)
+
+    app = WidgetApp()
+    return_value = app.run(headless=True)
+    assert results["value"] == 42
+    assert return_value == "done"
+
+
+def test_call_from_thread_awaitable_result():
+    """An awaitable callable is awaited and its result is returned."""
+    results: dict[str, object] = {}
+
+    class AwaitableApp(App):
+        def on_mount(self) -> None:
+            async def coro(value: int) -> int:
+                return value * 2
+
+            def worker() -> None:
+                results["value"] = self.call_from_thread(coro, 21)
+                self.call_from_thread(self.exit)
+
+            _run_in_thread(worker)
+
+    AwaitableApp().run(headless=True)
+    assert results["value"] == 42
+
+
+def test_call_from_thread_propagates_exception():
+    """Exceptions raised by the callable propagate to the calling thread."""
+    errors: list[BaseException] = []
+
+    class ErrorApp(App):
+        def on_mount(self) -> None:
+            def boom() -> None:
+                raise ValueError("boom")
+
+            def worker() -> None:
+                try:
+                    self.call_from_thread(boom)
+                except ValueError as error:
+                    errors.append(error)
+                self.call_from_thread(self.exit)
+
+            _run_in_thread(worker)
+
+    ErrorApp().run(headless=True)
+    assert len(errors) == 1
+    assert str(errors[0]) == "boom"
+
+
+def test_call_from_thread_forwards_arguments():
+    """Positional and keyword arguments are forwarded to the callable."""
+    results: dict[str, object] = {}
+
+    class ArgsApp(App):
+        def on_mount(self) -> None:
+            def add(a: int, b: int, *, scale: int = 1) -> int:
+                return (a + b) * scale
+
+            def worker() -> None:
+                results["value"] = self.call_from_thread(add, 1, 2, scale=10)
+                self.call_from_thread(self.exit)
+
+            _run_in_thread(worker)
+
+    ArgsApp().run(headless=True)
+    assert results["value"] == 30
