+    def call_from_thread(
+        self,
+        callback: Callable[..., ReturnType | Awaitable[ReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> ReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in
+        the correct app context (on the app's event loop, with the app as the active app),
+        and blocks the calling thread until the callable has returned.
+
+        Args:
+            callback (Callable[..., ReturnType | Awaitable[ReturnType]]): A callable to run
+                in the app's context. If it returns an awaitable, the awaitable is awaited.
+            *args: Positional arguments to pass to the callable.
+            **kwargs: Keyword arguments to pass to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped), or if called from the app thread.
+
+        Returns:
+            ReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        loop = self._loop
+
+        async def run_callback() -> ReturnType:
+            """Run in the app's event loop, within the app context."""
+            self._set_active()
+            return await invoke(partial(callback, *args, **kwargs))
+
+        future: Future[ReturnType] = asyncio.run_coroutine_threadsafe(run_callback(), loop)
+        return future.result()
