diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..3fbc608
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,155 @@
+import asyncio
+import threading
+
+import pytest
+
+from textual.app import App, ComposeResult
+from textual.pilot import Pilot
+from textual.widgets import TextLog
+
+
+class ThreadApp(App):
+    def compose(self) -> ComposeResult:
+        yield TextLog(id="log")
+
+
+def run_in_background(func):
+    """Run a blocking function in a separate thread, awaitable from the app loop."""
+
+    async def runner(pilot: Pilot) -> None:
+        loop = asyncio.get_running_loop()
+        await loop.run_in_executor(None, func)
+
+    return runner
+
+
+def test_call_from_thread_not_running():
+    """Calling before the app runs raises, without touching any event loop."""
+    app = ThreadApp()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread_raises():
+    """Calling from the app thread raises a runtime error."""
+    app = ThreadApp()
+    errors: list[BaseException] = []
+
+    async def auto_pilot(pilot: Pilot) -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            errors.append(error)
+        app.exit()
+
+    app.run(headless=True, auto_pilot=auto_pilot)
+    assert len(errors) == 1
+    assert "different thread" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_widget_access():
+    """A callable from a background thread can write to a widget."""
+    app = ThreadApp()
+    written: list[str] = []
+
+    def work() -> None:
+        def write_log() -> None:
+            log = app.query_one(TextLog)
+            log.write("hello from thread")
+            written.extend(str(line) for line in log.lines)
+
+        app.call_from_thread(write_log)
+        app.call_from_thread(app.exit)
+
+    app.run(headless=True, auto_pilot=run_in_background(work))
+    assert any("hello from thread" in line for line in written)
+
+
+def test_call_from_thread_returns_result():
+    """The result of the callable is returned to the calling thread."""
+    app = ThreadApp()
+    results: list[int] = []
+
+    def work() -> None:
+        results.append(app.call_from_thread(lambda a, b=0: a + b, 2, b=3))
+        app.call_from_thread(app.exit)
+
+    app.run(headless=True, auto_pilot=run_in_background(work))
+    assert results == [5]
+
+
+def test_call_from_thread_awaitable():
+    """An awaitable returned by the callable is awaited."""
+    app = ThreadApp()
+    results: list[str] = []
+
+    async def coro(value: str) -> str:
+        await asyncio.sleep(0.01)
+        return value.upper()
+
+    def work() -> None:
+        results.append(app.call_from_thread(coro, "abc"))
+        app.call_from_thread(app.exit)
+
+    app.run(headless=True, auto_pilot=run_in_background(work))
+    assert results == ["ABC"]
+
+
+def test_call_from_thread_propagates_exception():
+    """Exceptions raised by the callable propagate to the calling thread."""
+    app = ThreadApp()
+    errors: list[BaseException] = []
+
+    def boom() -> None:
+        raise ValueError("boom")
+
+    def work() -> None:
+        try:
+            app.call_from_thread(boom)
+        except ValueError as error:
+            errors.append(error)
+        app.call_from_thread(app.exit)
+
+    app.run(headless=True, auto_pilot=run_in_background(work))
+    assert len(errors) == 1
+    assert str(errors[0]) == "boom"
+
+
+def test_call_from_thread_exit_value():
+    """A background thread can exit the app with a value via call_from_thread."""
+    app = ThreadApp()
+
+    def work() -> None:
+        app.call_from_thread(app.exit, 42)
+
+    result = app.run(headless=True, auto_pilot=run_in_background(work))
+    assert result == 42
+
+
+def test_call_from_thread_after_stop_raises():
+    """After run has returned, calls raise instead of blocking."""
+    app = ThreadApp()
+
+    def work() -> None:
+        app.call_from_thread(app.exit)
+
+    app.run(headless=True, auto_pilot=run_in_background(work))
+
+    finished = threading.Event()
+    errors: list[BaseException] = []
+
+    def late_call() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            errors.append(error)
+        finally:
+            finished.set()
+
+    thread = threading.Thread(target=late_call, daemon=True)
+    thread.start()
+    assert finished.wait(timeout=5), "call_from_thread blocked after shutdown"
+    thread.join()
+    assert len(errors) == 1
+    assert "App is not running" in str(errors[0])
