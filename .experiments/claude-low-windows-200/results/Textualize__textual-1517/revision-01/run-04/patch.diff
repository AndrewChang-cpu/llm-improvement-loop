diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..b394115
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,160 @@
+from __future__ import annotations
+
+import asyncio
+import threading
+from typing import Any
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+def _run_in_thread(func: Any) -> tuple[list[Any], list[BaseException]]:
+    """Run `func` in a background thread, collecting its result or error."""
+    results: list[Any] = []
+    errors: list[BaseException] = []
+
+    def target() -> None:
+        try:
+            results.append(func())
+        except BaseException as error:
+            errors.append(error)
+
+    thread = threading.Thread(target=target)
+    thread.start()
+    return thread, results, errors
+
+
+async def _join(thread: threading.Thread) -> None:
+    """Wait for a thread without blocking the app's event loop."""
+    await asyncio.to_thread(thread.join)
+
+
+def test_call_from_thread_before_run_raises() -> None:
+    """Calling before the app runs should raise, not block."""
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises() -> None:
+    """Calling after run has returned should raise, not block."""
+
+    app = App()
+
+    async def auto_pilot(pilot) -> None:
+        app.exit()
+
+    app.run(headless=True, auto_pilot=auto_pilot)
+
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread_raises() -> None:
+    """Calling from the app thread should raise a RuntimeError."""
+    app = App()
+    errors: list[BaseException] = []
+
+    async def auto_pilot(pilot) -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            errors.append(error)
+        finally:
+            app.exit()
+
+    app.run(headless=True, auto_pilot=auto_pilot)
+
+    assert len(errors) == 1
+    assert "different thread" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_widget_access() -> None:
+    """A callable run from a thread can write to a widget through the app."""
+
+    class LogApp(App):
+        def compose(self):
+            yield TextLog(id="log")
+
+    app = LogApp()
+
+    def write_to_log() -> list[str]:
+        log = app.query_one(TextLog)
+        log.write("hello from thread")
+        return [str(line) for line in log.lines]
+
+    async def auto_pilot(pilot) -> None:
+        thread, results, errors = _run_in_thread(
+            lambda: app.call_from_thread(write_to_log)
+        )
+        await _join(thread)
+        assert not errors
+        assert any("hello from thread" in line for line in results[0])
+        app.exit()
+
+    app.run(headless=True, auto_pilot=auto_pilot)
+
+
+def test_call_from_thread_awaitable() -> None:
+    """An awaitable returned by the callable is awaited and its result returned."""
+    app = App()
+    results: list[Any] = []
+
+    async def coro(value: int) -> int:
+        await asyncio.sleep(0)
+        return value * 2
+
+    async def auto_pilot(pilot) -> None:
+        thread, outputs, errors = _run_in_thread(
+            lambda: app.call_from_thread(coro, 21)
+        )
+        await _join(thread)
+        results.extend(outputs)
+        assert not errors
+        app.exit()
+
+    app.run(headless=True, auto_pilot=auto_pilot)
+
+    assert results == [42]
+
+
+def test_call_from_thread_exception_propagates() -> None:
+    """Exceptions raised by the callable propagate to the calling thread."""
+    app = App()
+    errors: list[BaseException] = []
+
+    def fail() -> None:
+        raise ValueError("boom")
+
+    async def auto_pilot(pilot) -> None:
+        thread, _, thread_errors = _run_in_thread(
+            lambda: app.call_from_thread(fail)
+        )
+        await _join(thread)
+        errors.extend(thread_errors)
+        app.exit()
+
+    app.run(headless=True, auto_pilot=auto_pilot)
+
+    assert len(errors) == 1
+    assert isinstance(errors[0], ValueError)
+    assert str(errors[0]) == "boom"
+
+
+def test_call_from_thread_exit_returns_value() -> None:
+    """A background thread can exit the app with a value via call_from_thread."""
+    app = App()
+
+    async def auto_pilot(pilot) -> None:
+        thread, _, errors = _run_in_thread(
+            lambda: app.call_from_thread(app.exit, "done")
+        )
+        await _join(thread)
+        assert not errors
+
+    result = app.run(headless=True, auto_pilot=auto_pilot)
+
+    assert result == "done"
