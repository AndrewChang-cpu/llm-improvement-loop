+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the context of the app from a different thread.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context, and blocks the calling thread until the callable
+        has returned (awaiting it if it returns an awaitable).
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. It may be a regular function
+                or a coroutine function.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after
+                it has stopped).
+            RuntimeError: If called from the app thread; this method must be called
+                from a different thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run inside the app's event loop, with the app set as active."""
+            self._set_active()
+            return await invoke(partial(callback, *args, **kwargs))
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), loop
+        )
+        # Poll so that a shutdown while waiting cannot block the caller forever.
+        while True:
+            try:
+                return future.result(timeout=0.1)
+            except FutureTimeoutError:
+                if self._loop is None:
+                    future.cancel()
+                    raise RuntimeError("App is not running")
