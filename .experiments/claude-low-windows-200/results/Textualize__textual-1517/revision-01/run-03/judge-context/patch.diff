+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: object,
+        **kwargs: object,
+    ) -> CallThreadReturnType:
+        """Run a callable from a thread other than the app thread, in the app's context.
+
+        Textual objects are not thread-safe. This method ensures the callable runs in
+        the correct context (with the app active), and blocks the calling thread until
+        the callable has returned. If the callable returns an awaitable, it is awaited.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run on the app's event loop. It may be a regular function
+                or a coroutine function.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after it
+                has stopped), or if called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callable inside a task in which the app is the active app."""
+            self._set_active()
+            return await invoke(callback_with_args)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), loop
+        )
+        # Wait in short slices so that a shutdown during the wait cannot block forever.
+        while True:
+            try:
+                return future.result(timeout=0.05)
+            except FutureTimeoutError:
+                if self._loop is None:
+                    future.cancel()
+                    raise RuntimeError("App is not running")
