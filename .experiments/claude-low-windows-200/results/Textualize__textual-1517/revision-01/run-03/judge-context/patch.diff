diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..3b40f75
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,169 @@
+"""Tests for calling into the app from non-app threads (App.call_from_thread)."""
+
+from __future__ import annotations
+
+import asyncio
+import threading
+from typing import Any
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+def _run_with_worker(
+    worker: Any,
+    exit_value: object = None,
+) -> tuple[object, dict[str, Any]]:
+    """Run a headless app, executing `worker(app, results)` on a background thread.
+
+    The background thread always ends the app through `call_from_thread`, so the
+    run cannot hang if the worker body fails. Any exception raised by the worker
+    body is stored in `results["error"]`.
+    """
+    results: dict[str, Any] = {}
+
+    def worker_main(app: App) -> None:
+        try:
+            worker(app, results)
+        except BaseException as error:
+            results["error"] = error
+        finally:
+            try:
+                app.call_from_thread(app.exit, exit_value)
+            except Exception:
+                # The app is already stopped (or never started the exit); nothing to do.
+                pass
+
+    class ThreadedApp(App[object]):
+        def compose(self):
+            yield TextLog(id="log")
+
+        def on_mount(self) -> None:
+            threading.Thread(target=worker_main, args=(self,), daemon=True).start()
+
+    app = ThreadedApp()
+    return_value = app.run(headless=True)
+    return return_value, results
+
+
+def test_call_from_thread_not_running_before_start() -> None:
+    app = App()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_after_run_raises_without_blocking() -> None:
+    class QuickApp(App[None]):
+        def on_mount(self) -> None:
+            self.exit()
+
+    app = QuickApp()
+    app.run(headless=True)
+
+    outcome: dict[str, BaseException] = {}
+
+    def call() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            outcome["error"] = error
+
+    thread = threading.Thread(target=call, daemon=True)
+    thread.start()
+    thread.join(timeout=5)
+    assert not thread.is_alive(), "call_from_thread blocked after the app stopped"
+    assert "App is not running" in str(outcome["error"])
+
+
+def test_call_from_thread_same_thread_raises() -> None:
+    class SameThreadApp(App[None]):
+        def on_mount(self) -> None:
+            try:
+                self.call_from_thread(lambda: None)
+            except RuntimeError as error:
+                self.same_thread_error = error
+            self.exit()
+
+    app = SameThreadApp()
+    app.run(headless=True)
+    error = app.same_thread_error  # type: ignore[attr-defined]
+    assert isinstance(error, RuntimeError)
+    assert "different thread" in str(error)
+    assert "not running" not in str(error)
+
+
+def test_call_from_thread_widget_access() -> None:
+    def write_to_log(app: App, text: str) -> None:
+        app.query_one(TextLog).write(text)
+
+    def worker(app: App, results: dict[str, Any]) -> None:
+        app.call_from_thread(write_to_log, app, "hello from thread")
+        results["written"] = True
+
+    _, results = _run_with_worker(worker)
+    assert "error" not in results
+    assert results["written"]
+
+
+def test_call_from_thread_writes_text_log_lines() -> None:
+    def write_and_read(app: App) -> list[str]:
+        log = app.query_one(TextLog)
+        log.write("from thread")
+        return ["".join(segment.text for segment in strip) for strip in log.lines]
+
+    def worker(app: App, results: dict[str, Any]) -> None:
+        results["lines"] = app.call_from_thread(write_and_read, app)
+
+    _, results = _run_with_worker(worker)
+    assert "error" not in results
+    assert any("from thread" in line for line in results["lines"])
+
+
+def test_call_from_thread_awaits_awaitable() -> None:
+    async def compute() -> int:
+        await asyncio.sleep(0)
+        return 42
+
+    def worker(app: App, results: dict[str, Any]) -> None:
+        results["value"] = app.call_from_thread(compute)
+
+    _, results = _run_with_worker(worker)
+    assert "error" not in results
+    assert results["value"] == 42
+
+
+def test_call_from_thread_forwards_arguments() -> None:
+    def add(a: int, b: int, *, scale: int = 1) -> int:
+        return (a + b) * scale
+
+    def worker(app: App, results: dict[str, Any]) -> None:
+        results["value"] = app.call_from_thread(add, 2, 3, scale=10)
+
+    _, results = _run_with_worker(worker)
+    assert "error" not in results
+    assert results["value"] == 50
+
+
+def test_call_from_thread_propagates_exceptions() -> None:
+    def boom() -> None:
+        raise ValueError("boom")
+
+    def worker(app: App, results: dict[str, Any]) -> None:
+        with pytest.raises(ValueError, match="boom"):
+            app.call_from_thread(boom)
+        results["propagated"] = True
+
+    _, results = _run_with_worker(worker)
+    assert "error" not in results
+    assert results["propagated"]
+
+
+def test_call_from_thread_exit_returns_value() -> None:
+    def worker(app: App, results: dict[str, Any]) -> None:
+        results["started"] = True
+
+    return_value, results = _run_with_worker(worker, exit_value="bye")
+    assert "error" not in results
+    assert return_value == "bye"
