diff --git a/tests/test_concurrency.py b/tests/test_concurrency.py
new file mode 100644
index 0000000..3139850
--- /dev/null
+++ b/tests/test_concurrency.py
@@ -0,0 +1,146 @@
+import threading
+
+import pytest
+
+from textual.app import App
+from textual.widgets import TextLog
+
+
+class ConcurrencyApp(App[object]):
+    def compose(self):
+        yield TextLog(id="log")
+
+
+def _run_in_thread(target) -> threading.Thread:
+    thread = threading.Thread(target=target, daemon=True)
+    thread.start()
+    return thread
+
+
+def test_call_from_thread_not_running() -> None:
+    """Calling before the app runs raises, rather than blocking."""
+    app = ConcurrencyApp()
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
+
+
+def test_call_from_thread_same_thread() -> None:
+    """Calling from the app thread raises a runtime error."""
+    app = ConcurrencyApp()
+    errors: list[BaseException] = []
+
+    def callback() -> None:
+        try:
+            app.call_from_thread(lambda: None)
+        except RuntimeError as error:
+            errors.append(error)
+        app.exit()
+
+    async def start(pilot) -> None:
+        # Runs on the app thread, inside the running event loop.
+        callback()
+
+    app.run(headless=True, auto_pilot=start)
+
+    assert len(errors) == 1
+    assert "different thread" in str(errors[0])
+    assert "not running" not in str(errors[0])
+
+
+def test_call_from_thread_widget_access() -> None:
+    """A callable run from a background thread can access widgets through the app."""
+    app = ConcurrencyApp()
+    line_counts: list[int] = []
+
+    def worker() -> None:
+        def write() -> None:
+            app.query_one("#log", TextLog).write("hello from thread")
+
+        def count_lines() -> int:
+            return len(app.query_one("#log", TextLog).lines)
+
+        app.call_from_thread(write)
+        line_counts.append(app.call_from_thread(count_lines))
+        app.call_from_thread(app.exit)
+
+    async def start(pilot) -> None:
+        _run_in_thread(worker)
+
+    app.run(headless=True, auto_pilot=start)
+
+    assert line_counts == [1]
+
+
+def test_call_from_thread_awaitable() -> None:
+    """An awaitable callable is awaited and its result returned to the caller."""
+    app = ConcurrencyApp()
+    results: list[int] = []
+
+    async def compute() -> int:
+        return 7
+
+    def worker() -> None:
+        results.append(app.call_from_thread(compute))
+        app.call_from_thread(app.exit)
+
+    async def start(pilot) -> None:
+        _run_in_thread(worker)
+
+    app.run(headless=True, auto_pilot=start)
+
+    assert results == [7]
+
+
+def test_call_from_thread_exception_propagates() -> None:
+    """Exceptions raised by the callable propagate to the calling thread."""
+    app = ConcurrencyApp()
+    errors: list[BaseException] = []
+
+    def boom() -> None:
+        raise ValueError("boom")
+
+    def worker() -> None:
+        try:
+            app.call_from_thread(boom)
+        except ValueError as error:
+            errors.append(error)
+        app.call_from_thread(app.exit)
+
+    async def start(pilot) -> None:
+        _run_in_thread(worker)
+
+    app.run(headless=True, auto_pilot=start)
+
+    assert len(errors) == 1
+    assert str(errors[0]) == "boom"
+
+
+def test_call_from_thread_exit_returns_value() -> None:
+    """A background thread can exit the app with a return value."""
+    app = ConcurrencyApp()
+
+    def worker() -> None:
+        app.call_from_thread(app.exit, 42)
+
+    async def start(pilot) -> None:
+        _run_in_thread(worker)
+
+    result = app.run(headless=True, auto_pilot=start)
+
+    assert result == 42
+
+
+def test_call_from_thread_after_stop_raises() -> None:
+    """After run has returned, a call raises 'App is not running' and does not block."""
+    app = ConcurrencyApp()
+
+    def worker() -> None:
+        app.call_from_thread(app.exit)
+
+    async def start(pilot) -> None:
+        _run_in_thread(worker)
+
+    app.run(headless=True, auto_pilot=start)
+
+    with pytest.raises(RuntimeError, match="App is not running"):
+        app.call_from_thread(lambda: None)
