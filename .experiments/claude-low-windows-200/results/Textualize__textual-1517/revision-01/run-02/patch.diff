+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from a thread other than the app thread.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context on the app's event loop. The call blocks the
+        calling thread until the callable has returned.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. It may return a value or an
+                awaitable, which is awaited.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped).
+            RuntimeError: If called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callable in the app context, on the app's event loop."""
+            self._set_active()
+            return await invoke(callback_with_args)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), loop
+        )
+        return future.result()
