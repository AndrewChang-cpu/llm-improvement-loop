+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from another thread and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (with this app active) on the app's event loop.
+        The call blocks the calling thread until the callable has returned.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. If it returns an awaitable, it is awaited.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after it has stopped),
+                or if called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            active_app.set(self)
+            return await invoke(partial(callback, **kwargs), *args)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), loop
+        )
+        while True:
+            try:
+                return future.result(timeout=0.1)
+            except FutureTimeoutError:
+                # Never wait on a loop that can no longer run the work.
+                if not loop.is_running() or self._loop is not loop:
+                    future.cancel()
+                    raise RuntimeError("App is not running")
