+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the context of the app from a different thread.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct app context (on the app's event loop), so it may be used
+        from a worker thread wrapping a third-party threaded API.
+
+        The call blocks the calling thread until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. If it returns an awaitable,
+                the awaitable is awaited.
+            *args: Positional arguments to forward to the callable.
+            **kwargs: Keyword arguments to forward to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped), or if called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        loop = self._loop
+
+        async def run_callback() -> CallThreadReturnType:
+            # The active app context is per task, so set it inside the scheduled task.
+            self._set_active()
+            return await invoke(partial(callback, *args, **kwargs))
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), loop
+        )
+        # Wait for completion, but never block forever if the loop has stopped.
+        while True:
+            done, _ = wait_futures([future], timeout=0.05)
+            if done:
+                return future.result()
+            if not loop.is_running():
+                future.cancel()
+                raise RuntimeError("App is not running")
+
