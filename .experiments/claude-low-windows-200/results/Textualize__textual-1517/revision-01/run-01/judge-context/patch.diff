+    def call_from_thread(
+        self,
+        callback: Callable[..., ReturnType | Awaitable[ReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> ReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (the app's event loop, with the app set as the active app).
+        The call blocks until the callable has returned.
+
+        Args:
+            callback (Callable[..., ReturnType | Awaitable[ReturnType]]): A callable to run
+                in the app's context. If it returns an awaitable, it will be awaited.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after it
+                has stopped), or if called from the app's own thread.
+
+        Returns:
+            ReturnType: The result of the callable.
+        """
+        loop = self._loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> ReturnType:
+            """Run in the app's event loop, within the app context."""
+            self._set_active()
+            return await invoke(callback_with_args)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), loop)
+        while True:
+            try:
+                return future.result(timeout=0.1)
+            except concurrent.futures.TimeoutError:
+                # Don't wait forever on a loop that has since stopped.
+                if self._loop is None:
+                    future.cancel()
+                    raise RuntimeError("App is not running")
+
