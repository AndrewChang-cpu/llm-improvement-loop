+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable in the app's context from a different thread, and return its result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (with the app as the active app) on the app's event loop.
+        The call blocks until the callable has returned, and if the callable returns
+        an awaitable, it is awaited before returning.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. It may be a regular function
+                or a coroutine function, or return an awaitable.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (before it has started, or after it has stopped).
+            RuntimeError: If called from the app thread; this method must run in a different thread from the app.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callback in the app's context, on the app's event loop."""
+            self._set_active()
+            return await invoke(callback_with_args)
+
+        future = asyncio.run_coroutine_threadsafe(run_callback(), loop)
+        while True:
+            done, _ = concurrent.futures.wait((future,), timeout=0.1)
+            if done:
+                # Re-raises any exception from the callable, unchanged.
+                return future.result()
+            # If the app has stopped while we were waiting, the scheduled work
+            # may never run, so stop waiting rather than block indefinitely.
+            if self._loop is None:
+                future.cancel()
+                raise RuntimeError("App is not running")
+
