+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This call ensures the code runs in
+        the correct context (with the app active), on the app's event loop.
+        The call blocks until the callable returns.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                The callable to run in the app's context. If it returns an awaitable,
+                the awaitable is awaited.
+            *args: Positional arguments forwarded to the callable.
+            **kwargs: Keyword arguments forwarded to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (including before it has started
+                and after it has stopped), or if called from the app thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        loop = self._thread_loop
+        if loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        async def run_callback() -> CallThreadReturnType:
+            active_app.set(self)
+            return await invoke(partial(callback, **kwargs), *args)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), loop
+        )
+        while True:
+            done, _ = futures_wait([future], timeout=0.1)
+            if done:
+                return future.result()
+            if self._thread_loop is None or loop.is_closed():
+                # The app stopped before the work could run; never wait on it.
+                future.cancel()
+                raise RuntimeError("App is not running")
+
