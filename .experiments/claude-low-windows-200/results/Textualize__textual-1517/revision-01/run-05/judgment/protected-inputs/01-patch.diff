+    def call_from_thread(
+        self,
+        callback: Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]],
+        *args: Any,
+        **kwargs: Any,
+    ) -> CallThreadReturnType:
+        """Run a callable from another thread, and return the result.
+
+        Textual objects are not thread-safe. This method ensures the callable runs
+        in the correct context (with the app as the active app) on the app's event
+        loop. The call blocks the calling thread until the callable has returned.
+
+        Args:
+            callback (Callable[..., CallThreadReturnType | Awaitable[CallThreadReturnType]]):
+                A callable to run in the app's context. If it returns an awaitable, the
+                awaitable is awaited on the app's event loop.
+            *args: Positional arguments to pass to the callable.
+            **kwargs: Keyword arguments to pass to the callable.
+
+        Raises:
+            RuntimeError: If the app is not running (it has not started, or has already
+                stopped), or if called from the app's own thread.
+
+        Returns:
+            CallThreadReturnType: The result of the callable.
+        """
+        if self._loop is None:
+            raise RuntimeError("App is not running")
+        if threading.get_ident() == self._thread_id:
+            raise RuntimeError(
+                "The call_from_thread method must run in a different thread from the app"
+            )
+
+        callback_with_args = partial(callback, *args, **kwargs)
+
+        async def run_callback() -> CallThreadReturnType:
+            """Run the callback in the app's context, on the app's event loop."""
+            # The active app is per asyncio task, so it must be set inside this task.
+            self._set_active()
+            return await invoke(callback_with_args)
+
+        future: Future[CallThreadReturnType] = asyncio.run_coroutine_threadsafe(
+            run_callback(), self._loop
+        )
+        return future.result()
