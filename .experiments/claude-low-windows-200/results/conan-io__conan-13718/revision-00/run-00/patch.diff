+def _get_custom_generator_class(generator_name, custom_generators_path):
+    """ Load a global custom generator from the cache "extensions/generators" folder.
+    The generator must be defined in a file named "<generator_name>.py" and the class
+    must have the same name as the file """
+    if not custom_generators_path:
+        return None
+    generator_file = os.path.join(custom_generators_path, f"{generator_name}.py")
+    if not os.path.isfile(generator_file):
+        return None
+    # Imported here to avoid a circular import with the conanfile loader
+    from conans.client.loader import load_python_file
+    module, _ = load_python_file(generator_file)
