-def _get_generator_class(generator_name):
+def _load_custom_generator_class(generator_name, generators_path):
+    """ Loads a global custom generator from the cache "extensions/generators" folder.
+    The generator must be defined in a file named "<generator_name>.py" that contains
+    a class with the same name "<generator_name>". Returns None if no such file exists.
+    """
+    if not generators_path or not generator_name:
+        return None
+    if os.path.sep in generator_name or "/" in generator_name or generator_name in (".", ".."):
+        return None
+    path = os.path.join(generators_path, f"{generator_name}.py")
+    if not os.path.isfile(path):
+        return None
+    module_name = f"conan_custom_generator_{generator_name}"
+    try:
+        spec = importlib.util.spec_from_file_location(module_name, path)
+        module = importlib.util.module_from_spec(spec)
+        spec.loader.exec_module(module)
+    except Exception as e:
+        raise ConanException(f"Error loading custom generator '{generator_name}' "
+                             f"from '{path}': {e}") from e
+    try:
+        return getattr(module, generator_name)
+    except AttributeError as e:
+        raise ConanException(f"Custom generator file '{path}' does not define a class "
+                             f"named '{generator_name}'") from e
+
+
+def _get_generator_class(generator_name, generators_path=None):
     # QbsToolchain is an alias for QbsProfile
     if generator_name == "QbsToolchain":
         generator_name = "QbsProfile"
 
+    if generator_name not in _generators:
+        custom_class = _load_custom_generator_class(generator_name, generators_path)
+        if custom_class is not None:
+            return custom_class
     try:
         generator_class = _generators[generator_name]
         # This is identical to import ... form ... in terms of cacheing
