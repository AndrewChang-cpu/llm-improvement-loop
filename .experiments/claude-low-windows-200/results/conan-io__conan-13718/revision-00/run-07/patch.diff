-def write_generators(conanfile, hook_manager):
+def _get_custom_generator_class(generator_name, cache_generators_folder):
+    """ Custom global generators are python files named as the generator in the
+    cache extensions/generators folder, e.g. "MyGen" -> <cache>/extensions/generators/MyGen.py,
+    that must define a class with the same name
+    """
+    if not cache_generators_folder or os.path.basename(generator_name) != generator_name:
+        return None
+    path = os.path.join(cache_generators_folder, f"{generator_name}.py")
+    if not os.path.isfile(path):
+        return None
+    from conans.client.loader import load_python_file  # avoid import cycles
+    mod, _ = load_python_file(path)
+    try:
+        return getattr(mod, generator_name)
+    except AttributeError as e:
+        raise ConanException(f"Custom generator file '{path}' must define a class "
+                             f"named '{generator_name}'") from e
+
+
+def _get_generator_class(generator_name, cache_generators_folder=None):
+    # QbsToolchain is an alias for QbsProfile
+    if generator_name == "QbsToolchain":
+        generator_name = "QbsProfile"
+
+    if generator_name in _generators:
+        return _get_builtin_generator_class(generator_name)
+    custom_class = _get_custom_generator_class(generator_name, cache_generators_folder)
+    if custom_class is not None:
+        return custom_class
+    raise ConanException(f"Invalid generator '{generator_name}'. "
+                         f"Available types: {', '.join(_generators)}")
+
+
