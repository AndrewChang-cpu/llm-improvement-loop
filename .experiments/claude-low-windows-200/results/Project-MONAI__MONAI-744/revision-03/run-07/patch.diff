+import unittest
+
+import numpy as np
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(target, num_classes):
+    """Class-first logits equal to 1000 times the one-hot encoding of an integer label map."""
+    target = torch.as_tensor(target, dtype=torch.long)
+    onehot = torch.nn.functional.one_hot(target, num_classes=num_classes)
+    # move the class axis from last to channel position 1
+    dims = [0, onehot.dim() - 1] + list(range(1, onehot.dim() - 1))
+    return 1000.0 * onehot.permute(*dims).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+        target = np.zeros((4, 4), dtype=np.int64)
+        target[1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        correct = one_hot_logits(target, 2).unsqueeze(0)
+        result = loss(correct, torch.as_tensor(target).unsqueeze(0))
+        self.assertEqual(result.dim(), 0)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # same target with an added channel dimension
+        result = loss(correct, torch.as_tensor(target).unsqueeze(0).unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        wrong = one_hot_logits(1 - target, 2).unsqueeze(0)
+        result = loss(wrong, torch.as_tensor(target).unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+        target = np.zeros((4, 4), dtype=np.int64)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        correct = one_hot_logits(target, 2).unsqueeze(0)
+        result = loss(correct, torch.as_tensor(target).unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        wrong = one_hot_logits(1 - target, 2).unsqueeze(0)
+        result = loss(wrong, torch.as_tensor(target).unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
