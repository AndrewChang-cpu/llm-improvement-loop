+import unittest
+
+import numpy as np
+import torch
+from torch.nn.functional import one_hot
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _class_first_logits(target, num_classes):
+    # integer labels (B, H, W) -> class-first logits (B, C, H, W), scaled by 1000
+    return one_hot(target.long(), num_classes).permute(0, 3, 1, 2).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        # correct prediction, without and with a channel dimension in the target
+        logits = _class_first_logits(target, 2)
+        result = loss_fn(logits, target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+        result = loss_fn(logits, target.unsqueeze(1))
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        result = loss_fn(_class_first_logits(1 - target, 2), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        result = loss_fn(_class_first_logits(target, 2), target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        result = loss_fn(_class_first_logits(1 - target, 2), target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
