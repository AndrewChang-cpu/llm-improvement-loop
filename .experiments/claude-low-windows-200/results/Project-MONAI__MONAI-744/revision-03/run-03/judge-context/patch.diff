+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalization of the Dice overlap, where the true positive contribution of each voxel is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label, computed with
+    a class-distance matrix. The class weighting follows the generalized Dice loss:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits and passed through a softmax over the class dimension.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), given as a torch tensor or a numpy array.
+                Entries should be nonnegative. It is divided by its maximum entry if that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Reduction mode, stored on the loss object. It does not change the output of ``forward``:
+                the returned loss is always the mean over the batch, whatever the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5):
+        """
+        Args:
+            input: the shape should be BCS[, ...] (float logits, C classes).
+            target: the shape should be BS[, ...] or B1S[, ...] (integer class indices).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample loss ``1 - (2 * TP + smooth) / (D + smooth)``.
+
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, self.num_classes, -1), 1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(loss)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map for every sample and voxel:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class indices of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N), computed for every sample in the batch.
+
+        """
+        m = self.m.to(flat_proba)  # moves the matrix to the probability device and dtype, stored matrix unchanged
+        rows = m[flat_target.long()]  # (batch, N, classes)
+        probs = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(rows * probs, dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels of sample b with label c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class indices of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+
+        """
+        one_hot_target = F.one_hot(flat_target.long(), self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot_target, dim=1).float()  # (batch, classes)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for each sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)),
+        where the sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class indices of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one TP value per sample, shape (batch,).
+
+        """
+        weights = torch.gather(alpha, 1, flat_target.long())  # (batch, N), alpha of each sample's own labels
+        # pairs sample b's weights (axis 0) with the distance maps of all samples s (axis 1), summed over voxels
+        pairs = weights[:, None, :] * (1.0 - wasserstein_distance_map)[None, :, :]
+        return torch.sum(pairs, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for each sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)),
+        where the sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class indices of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        weights = torch.gather(alpha, 1, flat_target.long())  # (batch, N), alpha of each sample's own labels
+        # pairs sample b's weights (axis 0) with the distance maps of all samples s (axis 1), summed over voxels
+        pairs = weights[:, None, :] * (2.0 - wasserstein_distance_map)[None, :, :]
+        return torch.sum(pairs, dim=(1, 2))
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
