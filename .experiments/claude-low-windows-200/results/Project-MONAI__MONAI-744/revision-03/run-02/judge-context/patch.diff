+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+
+
+def _class_first_one_hot(labels: torch.Tensor, num_classes: int) -> torch.Tensor:
+    # labels: (B, spatial...) -> one-hot (B, spatial..., C) -> (B, C, spatial...)
+    one_hot = F.one_hot(labels.long(), num_classes=num_classes)
+    dims = [0, one_hot.dim() - 1] + list(range(1, one_hot.dim() - 1))
+    return one_hot.permute(*dims).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = 1000.0 * _class_first_one_hot(target, 2)
+        result = loss(logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # same target with an added channel dimension
+        result = loss(logits, target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # logits predicting the flipped target
+        flipped_logits = 1000.0 * _class_first_one_hot(1 - target, 2)
+        result = loss(flipped_logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = 1000.0 * _class_first_one_hot(target, 2)
+        result = loss(logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped_logits = 1000.0 * _class_first_one_hot(1 - target, 2)
+        result = loss(flipped_logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
