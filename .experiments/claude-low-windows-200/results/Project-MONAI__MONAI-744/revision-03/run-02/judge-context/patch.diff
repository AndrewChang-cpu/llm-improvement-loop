+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalization of the Dice overlap to multi-class segmentation with a class-distance
+    matrix, where each voxel's true-positive contribution is discounted by the Wasserstein distance
+    between the predicted class distribution and the ground-truth label. The class weighting follows
+    the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target
+    is an integer class-index label map. Samples in a batch are coupled: the true positives and the
+    denominator of each sample sum over the distance maps of every sample in the batch.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), as a 2D torch tensor or 2D numpy array.
+                It is divided by its maximum entry when that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode passed to the parent loss. Defaults to ``"mean"``.
+                The returned loss is always the batch mean, regardless of the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_value = torch.max(dist_matrix)
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample and voxel.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        m_y = m[flat_target.long()]  # (batch, N, classes)
+        return torch.sum(m_y * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number
+        of voxels of class c in sample b. Classes absent from a sample receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+        """
+        one_hot = F.one_hot(flat_target.long(), num_classes=self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot, dim=1).float()  # (batch, classes)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample s of the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances W of shape (batch, N) for every sample.
+
+        Returns:
+            one true-positive value per sample, of shape (batch,).
+        """
+        weight = torch.gather(alpha, 1, flat_target.long())  # (batch, N), alpha(b, y_b(v))
+        one_minus_w = 1.0 - wasserstein_distance_map  # (batch, N), indexed by s
+        # pair sample b's weight map with the distance maps of all samples s: (b, s, N)
+        product = weight.unsqueeze(1) * one_minus_w.unsqueeze(0)
+        return torch.sum(product, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample s of the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distances W of shape (batch, N) for every sample.
+
+        Returns:
+            one denominator value per sample, of shape (batch,).
+        """
+        weight = torch.gather(alpha, 1, flat_target.long())  # (batch, N), alpha(b, y_b(v))
+        two_minus_w = 2.0 - wasserstein_distance_map  # (batch, N), indexed by s
+        product = weight.unsqueeze(1) * two_minus_w.unsqueeze(0)
+        return torch.sum(product, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits of shape (batch, classes, spatial dims...).
+            target: integer class-index labels of shape (batch, spatial dims...) or (batch, 1, spatial dims...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses, as a scalar tensor.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)  # (batch, classes, N)
+        flat_target = target.reshape(batch, -1)  # (batch, N)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
