+import unittest
+
+import numpy as np
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+from monai.networks import one_hot
+
+
+def _class_first_one_hot(target, num_classes):
+    # target: (B, H, W) integer labels -> (B, C, H, W) one-hot logits built as one-hot then permute
+    labels = target.unsqueeze(-1)  # (B, H, W, 1)
+    oh = one_hot(labels, num_classes=num_classes, dim=-1)  # (B, H, W, C)
+    return oh.permute(0, 3, 1, 2)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        logits = 1000.0 * _class_first_one_hot(target, 2)
+        result = loss(logits, target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # same target with an added channel dimension
+        result = loss(logits, target.unsqueeze(1))
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        # flipped logits: every prediction is wrong
+        flipped = 1000.0 * _class_first_one_hot(1 - target, 2)
+        result = loss(flipped, target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        logits = 1000.0 * _class_first_one_hot(target, 2)
+        result = loss(logits, target)
+        np.testing.assert_allclose(result.item(), 0.0, atol=1e-3)
+
+        flipped = 1000.0 * _class_first_one_hot(1 - target, 2)
+        result = loss(flipped, target)
+        np.testing.assert_allclose(result.item(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
