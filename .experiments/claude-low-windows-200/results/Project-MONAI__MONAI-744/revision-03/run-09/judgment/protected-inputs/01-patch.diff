+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The per-voxel true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix. The class
+    weighting follows the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits, and the target is a tensor of integer class indices.
+    The returned loss is the batch mean, regardless of the reduction setting.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), as a torch tensor or a numpy array.
+                It is max-normalized when its maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode passed to the parent loss. Defaults to ``"mean"``.
+                The returned loss is always the batch mean, whatever reduction is given.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BCH[WD], float logits.
+            target: the shape should be B[H[WD]] or B1H[WD], integer class indices.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the batch mean of the per-sample losses.
+
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        f = 1.0 - (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(f)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class labels of shape (batch, N).
+
+        Returns:
+            distances of shape (batch, N).
+
+        """
+        m = self.m.to(flat_proba.device)
+        m_rows = m[flat_target]  # (batch, N, classes): row M[y_s(v)] for every voxel
+        proba = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(m_rows * proba, dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class labels of shape (batch, N).
+
+        Returns:
+            alpha weights of shape (batch, classes).
+
+        """
+        one_hot = F.one_hot(flat_target, num_classes=self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot, dim=1).float()  # (batch, classes)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for every sample b.
+        The sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class labels of shape (batch, N).
+            wasserstein_distance_map: distances W of shape (batch, N) for all samples.
+
+        Returns:
+            one generalized true positive value per sample, shape (batch,).
+
+        """
+        weight = torch.gather(alpha, 1, flat_target).unsqueeze(1)  # (batch_b, 1, N)
+        terms = weight * (1.0 - wasserstein_distance_map.unsqueeze(0))  # (batch_b, batch_s, N)
+        return torch.sum(torch.sum(terms, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for every sample b.
+        The sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class labels of shape (batch, N).
+            wasserstein_distance_map: distances W of shape (batch, N) for all samples.
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        weight = torch.gather(alpha, 1, flat_target).unsqueeze(1)  # (batch_b, 1, N)
+        terms = weight * (2.0 - wasserstein_distance_map.unsqueeze(0))  # (batch_b, batch_s, N)
+        return torch.sum(torch.sum(terms, dim=2), dim=1)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
