+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def _one_hot_logits(target, num_classes):
+    """target: (H, W) integer labels -> class-first logits (1, C, H, W), 1000 times the one-hot."""
+    onehot = F.one_hot(target.unsqueeze(0), num_classes).permute(0, 3, 1, 2)
+    return 1000.0 * onehot.float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((4, 4), dtype=torch.long)
+        target[1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        # correct prediction, with and without an added channel dimension
+        result = loss(_one_hot_logits(target, 2), target.unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+        result = loss(_one_hot_logits(target, 2), target.unsqueeze(0).unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+        # flipped prediction
+        flipped = 1 - target
+        result = loss(_one_hot_logits(flipped, 2), target.unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+        result = loss(_one_hot_logits(target, 2), target.unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+        flipped = 1 - target
+        result = loss(_one_hot_logits(flipped, 2), target.unsqueeze(0))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
