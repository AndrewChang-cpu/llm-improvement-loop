+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The per-voxel true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground-truth label, using a class-distance matrix. The class weights follow
+    the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target is an
+    integer class-index label map. Samples in the batch are coupled: the true-positive and denominator terms
+    of each sample sum over the distance maps of every sample in the batch.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D, square, nonnegative class-distance matrix of shape (C, C), where C is the number of
+                classes. Can be a torch tensor or a numpy array. It is divided by its maximum entry if that
+                maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode. It is stored and passed to the parent class, but it does not
+                change the output: the returned loss is always the batch mean, whatever the reduction.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W for every sample and voxel:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where y_s(v) is the ground-truth label and p the softmax probability.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes)
+        proba = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(rows * proba, dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        sample b with label c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights of shape (batch, classes).
+        """
+        volumes = F.one_hot(flat_target, num_classes=self.num_classes).sum(dim=1)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on the
+        whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        weight = alpha.gather(1, flat_target)  # (batch, N), weight of sample b at voxel v
+        # pair the weight map of sample b (index b) with the distance maps of all samples s (index s)
+        return torch.sum(weight.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on the
+        whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        weight = alpha.gather(1, flat_target)  # (batch, N), weight of sample b at voxel v
+        # pair the weight map of sample b (index b) with the distance maps of all samples s (index s)
+        return torch.sum(weight.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0), dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BCH[WD], raw logits.
+            target: the shape should be BH[WD] or B1H[WD], integer class-index labels.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP + smooth) / (D + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wd = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wd)
+        denominator = self.compute_denominator(alpha, flat_target, wd)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
