+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The Wasserstein Dice score discounts each voxel's true-positive contribution by the Wasserstein
+    distance between the predicted class distribution and the ground-truth label, using a class-distance
+    matrix. The per-class weighting follows the generalized Dice loss (Sudre, C. et. al. (2017) Generalised
+    Dice overlap as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017), i.e.
+    the inverse of the class volume.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The batch samples
+    are coupled: the generalized true positives and denominator of each sample sum over the distance maps
+    of every sample in the batch.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), as a 2D torch tensor or 2D numpy array.
+                It is max-normalized to a maximum entry of 1 when its maximum is not already 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                The reduction mode. It is stored but does not change the returned value: the loss is always
+                the batch mean regardless of reduction.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if float(dist_matrix.max()) != 1.0:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BCH[WD], raw logits.
+            target: the shape should be BH[WD] or B1H[WD], integer class indices.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the batch mean of the per-sample losses ``1 - (2 * TP + smooth) / (D + smooth)``.
+
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denom = self.compute_denominator(alpha, flat_target, wdm)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(1.0 - score)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s and voxel v.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class indices of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N).
+
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        gathered = m[flat_target]  # (batch, N, classes)
+        return torch.sum(gathered * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        sample b with label c. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class indices of shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights of shape (batch, classes).
+
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)) for every sample b. The sum over s runs over
+        every sample's distance map in the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights of shape (batch, classes).
+            flat_target: integer class indices of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one generalized true positive value per sample, shape (batch,).
+
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weight of sample b's own labels
+        pairs = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # (b, s, N)
+        return torch.sum(pairs, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)) for every sample b. The sum over s runs over
+        every sample's distance map in the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights of shape (batch, classes).
+            flat_target: integer class indices of shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # (batch, N), weight of sample b's own labels
+        pairs = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # (b, s, N)
+        return torch.sum(pairs, dim=(1, 2))
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
