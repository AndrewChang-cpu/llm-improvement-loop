+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+def _class_first_logits(target, num_classes, scale=1000.0):
+    # one-hot over the label map (last dim becomes classes), then move classes to dim 1
+    one_hot = F.one_hot(target.long(), num_classes=num_classes)
+    spatial = len(target.shape)
+    perm = [0, spatial + 1] + list(range(1, spatial + 1))
+    return scale * one_hot.permute(*perm).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(_class_first_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # same target with an added channel dimension
+        result = loss(_class_first_logits(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # logits of the flipped target
+        flipped = 1 - target
+        result = loss(_class_first_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(_class_first_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped = 1 - target
+        result = loss(_class_first_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
