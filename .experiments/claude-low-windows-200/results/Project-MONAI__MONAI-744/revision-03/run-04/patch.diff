+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap score in which the true-positive contribution of each voxel is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label,
+    computed with a class-distance matrix. The class weighting follows the generalized Dice loss
+    (Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+    unbalanced segmentations. DLMIA 2017).
+
+    The input is always treated as logits, and the target is a map of integer class indices.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of size C by C, as a torch tensor or numpy array.
+                It is divided by its maximum entry when that maximum is not 1.
+            reduction: the reduction mode. The returned loss is the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: dist_matrix is not square. The message is "Dist Matrix is invalid.".
+            ValueError: reduction is not a valid LossReduction value.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s and voxel v.
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances for every sample, shape (batch, N).
+        """
+        m = self.m.to(flat_proba.device)
+        # row y_s(v) of the distance matrix for each voxel, shape (batch, N, classes)
+        m_target = m[flat_target]
+        return torch.sum(m_target * flat_proba.transpose(1, 2), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        sample b with label c. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights, shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum over every sample s in the batch and every voxel v of alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on the
+        whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one generalized true-positive value per sample, shape (batch,).
+        """
+        weight = alpha.gather(1, flat_target)  # (batch, N): alpha of sample b at its own labels
+        # pair the weight map of sample b (index b) with the distance map of sample s (index s)
+        terms = weight.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # (batch, batch, N)
+        return torch.sum(terms, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum over every sample s in the batch and every voxel v of alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on the
+        whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        weight = alpha.gather(1, flat_target)  # (batch, N): alpha of sample b at its own labels
+        terms = weight.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # (batch, batch, N)
+        return torch.sum(terms, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, the shape should be BCH[WD].
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses 1 - (2 * TP + smooth) / (D + smooth), as a scalar tensor.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        dist_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, dist_map)
+        denominator = self.compute_denominator(alpha, flat_target, dist_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
