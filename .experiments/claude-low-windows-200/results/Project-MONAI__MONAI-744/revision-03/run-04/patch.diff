+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def one_hot_logits(labels, scale=1000.0):
+    """Class-first one-hot logits built from integer label maps of shape (B, H, W)."""
+    return F.one_hot(labels, num_classes=2).permute(0, 3, 1, 2).float() * scale
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        # correct logits, with and without an explicit channel dimension in the target
+        result = loss(one_hot_logits(target), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+        result = loss(one_hot_logits(target), target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped logits
+        result = loss(one_hot_logits(1 - target), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        result = loss(one_hot_logits(target), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        result = loss(one_hot_logits(1 - target), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
