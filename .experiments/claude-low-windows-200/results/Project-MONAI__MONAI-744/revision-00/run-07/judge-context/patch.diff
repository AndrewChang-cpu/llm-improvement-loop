+import unittest
+
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_perfect_prediction_is_zero(self):
+        target = torch.zeros(2, 3, 2, 2)
+        target[:, 0] = 1.0
+        target[:, 1, 0] = 1.0
+        target[:, 2, 1] = 1.0
+        # one-hot ground truth as logits-free probabilities
+        loss = GeneralizedWassersteinDiceLoss(reduction="none")(target.clone(), target)
+        self.assertEqual(loss.shape, (2,))
+        for v in loss:
+            self.assertAlmostEqual(float(v), 0.0, places=4)
+
+    def test_wrong_prediction_is_larger_for_distant_class(self):
+        # classes 0, 1, 2 on a line: 0-1 distance 1/2, 0-2 distance 1
+        dist = [[0.0, 1.0, 2.0], [1.0, 0.0, 1.0], [2.0, 1.0, 0.0]]
+        target = torch.zeros(1, 3, 4)
+        target[:, 0] = 1.0  # all voxels class 0
+        near = torch.zeros(1, 3, 4)
+        near[:, 1] = 1.0  # predicts class 1
+        far = torch.zeros(1, 3, 4)
+        far[:, 2] = 1.0  # predicts class 2
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist, reduction="none")
+        self.assertLess(float(loss_fn(near, target)), float(loss_fn(far, target)))
+
+    def test_include_background_false_runs(self):
+        target = torch.zeros(1, 2, 3, 3)
+        target[:, 0] = 1.0
+        pred = torch.rand(1, 2, 3, 3)
+        loss = GeneralizedWassersteinDiceLoss(include_background=False, sigmoid=True)(pred, target)
+        self.assertEqual(loss.dim(), 0)
+
+    def test_to_onehot_y(self):
+        pred = torch.rand(2, 3, 4)
+        labels = torch.tensor([[[0, 1, 2, 0]], [[2, 2, 1, 0]]])
+        loss = GeneralizedWassersteinDiceLoss(to_onehot_y=True, softmax=True)(pred, labels)
+        self.assertEqual(loss.dim(), 0)
+
+    def test_invalid_dist_matrix(self):
+        with self.assertRaises(ValueError):
+            GeneralizedWassersteinDiceLoss(dist_matrix=[[0.0, 1.0], [0.0, 0.0]])
+        with self.assertRaises(ValueError):
+            GeneralizedWassersteinDiceLoss(dist_matrix=[[1.0, 1.0], [1.0, 0.0]])
+
+    def test_sigmoid_softmax_conflict(self):
+        with self.assertRaises(ValueError):
+            GeneralizedWassersteinDiceLoss(sigmoid=True, softmax=True)
+
+
+if __name__ == "__main__":
+    unittest.main()
