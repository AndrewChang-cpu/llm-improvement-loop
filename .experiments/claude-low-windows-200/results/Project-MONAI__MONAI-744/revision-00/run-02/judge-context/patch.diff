+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI 2017 (BrainLes workshop).
+
+    The loss uses a class distance matrix `dist_matrix` (C x C, zero on the diagonal, symmetric) to penalise
+    confusions between classes according to how far apart they are. For a prediction `p` (probabilities) and
+    one-hot ground truth `g`, the per-voxel Wasserstein cost of a class `l` is
+    ``W_l(x) = sum_k M[k, l] * p_k(x)``, and the per-class "true positive" mass is
+    ``tp_l = sum_x g_l(x) * (1 - W_l(x))``. The loss is then
+
+        1 - (2 * sum_l w_l * tp_l + smooth) / (sum_l w_l * (sum_x g_l(x) + sum_x p_l(x)) + smooth)
+
+    where ``w_l`` is a per-class weight (by default ``1 / (sum_x g_l(x))^2``, as in the generalized Dice loss,
+    or the user supplied `weight`). With ``dist_matrix = 1 - I`` the loss reduces to the generalized Dice loss
+    with square weights.
+
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, "np.ndarray", Sequence[Sequence[float]]],
+        weight: Optional[Union[torch.Tensor, Sequence[float]]] = None,
+        to_onehot_y: bool = False,
+        sigmoid: bool = False,
+        softmax: bool = False,
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D tensor (or array) of shape (C, C) with the distance between each pair of classes.
+                It is expected to be symmetric with zeros on the diagonal; values are typically normalised to [0, 1].
+            weight: optional 1D tensor (or sequence) of length C giving a fixed weight per class. If None, the
+                weights are computed from the ground truth as ``1 / (sum_x g_l(x))^2``.
+            to_onehot_y: whether to convert `y` into the one-hot format. Defaults to False.
+            sigmoid: If True, apply a sigmoid function to the prediction.
+            softmax: If True, apply a softmax function to the prediction.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction to apply to the output. Defaults to ``"mean"``.
+
+                - ``"none"``: no reduction will be applied.
+                - ``"mean"``: the sum of the output will be divided by the number of elements in the output.
+                - ``"sum"``: the output will be summed.
+
+        Raises:
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+            ValueError: sigmoid=True and softmax=True are not compatible.
+            ValueError: dist_matrix must be a square 2D matrix.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if sigmoid and softmax:
+            raise ValueError("sigmoid=True and softmax=True are not compatible.")
+
+        m = torch.as_tensor(np.asarray(dist_matrix) if not torch.is_tensor(dist_matrix) else dist_matrix)
+        if m.dim() != 2 or m.shape[0] != m.shape[1]:
+            raise ValueError(f"dist_matrix must be a square 2D matrix, got shape {tuple(m.shape)}.")
+        self.dist_matrix = m.float()
+
+        self.weight = None
+        if weight is not None:
+            w = torch.as_tensor(np.asarray(weight) if not torch.is_tensor(weight) else weight).float()
+            if w.dim() != 1 or w.shape[0] != m.shape[0]:
+                raise ValueError(f"weight must be a 1D vector of length {m.shape[0]}, got shape {tuple(w.shape)}.")
+            self.weight = w
+
+        self.to_onehot_y = to_onehot_y
+        self.sigmoid = sigmoid
+        self.softmax = softmax
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BNH[WD].
+            target: the shape should be BNH[WD] (one-hot), or B1H[WD] if `to_onehot_y=True`.
+            smooth: a small constant to avoid nan.
+
+        Raises:
+            ValueError: reduction={self.reduction} is invalid.
+            ValueError: dist_matrix size does not match the number of prediction channels.
+
+        """
+        if self.sigmoid:
+            input = torch.sigmoid(input)
+        n_classes = input.shape[1]
+        if self.softmax:
+            if n_classes == 1:
+                warnings.warn("single channel prediction, `softmax=True` ignored.")
+            else:
+                input = torch.softmax(input, 1)
+        if self.to_onehot_y:
+            if n_classes == 1:
+                warnings.warn("single channel prediction, `to_onehot_y=True` ignored.")
+            else:
+                target = one_hot(target, num_classes=n_classes)
+
+        assert (
+            target.shape == input.shape
+        ), f"ground truth has differing shape ({target.shape}) from input ({input.shape})"
+        if self.dist_matrix.shape[0] != n_classes:
+            raise ValueError(
+                f"dist_matrix has size {self.dist_matrix.shape[0]} but input has {n_classes} channels."
+            )
+
+        batch = input.shape[0]
+        # flatten spatial dimensions: (B, C, N)
+        p = input.reshape(batch, n_classes, -1)
+        g = target.reshape(batch, n_classes, -1).to(p.dtype)
+        m = self.dist_matrix.to(device=p.device, dtype=p.dtype)
+
+        # W[b, l, n] = sum_k M[k, l] * p[b, k, n]: Wasserstein cost of predicting each voxel as class l
+        w_cost = torch.einsum("bkn,kl->bln", p, m)
+        # per-class true positive mass, distance weighted: (B, C)
+        tp = torch.sum(g * (1.0 - w_cost), dim=-1)
+        ground_o = torch.sum(g, dim=-1)
+        pred_o = torch.sum(p, dim=-1)
+
+        if self.weight is not None:
+            w = self.weight.to(device=p.device, dtype=p.dtype).expand(batch, n_classes)
+        else:
+            # square inverse of class volume, clamped to avoid division by zero for absent classes
+            w = torch.reciprocal((ground_o * ground_o).clamp_min(smooth))
+
+        numerator = 2.0 * torch.sum(w * tp, dim=1) + smooth
+        denominator = torch.sum(w * (ground_o + pred_o), dim=1) + smooth
+        f = 1.0 - numerator / denominator  # per-sample loss, shape (B,)
+
+        if self.reduction == LossReduction.MEAN.value:
+            f = torch.mean(f)
+        elif self.reduction == LossReduction.SUM.value:
+            f = torch.sum(f)
+        elif self.reduction == LossReduction.NONE.value:
+            pass  # returns [B] losses
+        else:
+            raise ValueError(f"reduction={self.reduction} is invalid.")
+
+        return f
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
