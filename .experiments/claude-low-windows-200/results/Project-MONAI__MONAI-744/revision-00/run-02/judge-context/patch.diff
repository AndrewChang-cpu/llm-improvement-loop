+import unittest
+
+import numpy as np
+import torch
+
+from monai.losses import GeneralizedDiceLoss, GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = [[0.0, 1.0, 0.5], [1.0, 0.0, 1.0], [0.5, 1.0, 0.0]]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_perfect_prediction_is_zero(self):
+        labels = torch.tensor([[0, 0, 1, 2], [2, 1, 1, 0]])
+        # one-hot ground truth; prediction equal to ground truth
+        target = torch.nn.functional.one_hot(labels, 3).permute(0, 2, 1).float()
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)(target.clone(), target)
+        np.testing.assert_allclose(loss.detach().cpu().numpy(), 0.0, atol=1e-4)
+
+    def test_matches_generalized_dice_with_unit_distances(self):
+        # with dist_matrix = 1 - I the loss reduces to generalized dice with square weights
+        torch.manual_seed(0)
+        pred = torch.softmax(torch.rand((2, 3, 5, 5)), dim=1)
+        labels = torch.randint(0, 3, (2, 5, 5))
+        target = torch.nn.functional.one_hot(labels, 3).permute(0, 3, 1, 2).float()
+        dist = 1.0 - np.eye(3)
+        wass = GeneralizedWassersteinDiceLoss(dist_matrix=dist, reduction="none")(pred, target)
+        gdl = GeneralizedDiceLoss(reduction="none")(pred, target)
+        self.assertEqual(wass.shape, (2,))
+        np.testing.assert_allclose(
+            wass.mean().detach().cpu().numpy(), gdl.detach().cpu().numpy(), rtol=1e-4
+        )
+
+    def test_reduction_shapes(self):
+        pred = torch.softmax(torch.rand((2, 3, 4)), dim=1)
+        target = torch.nn.functional.one_hot(torch.randint(0, 3, (2, 4)), 3).permute(0, 2, 1).float()
+        none = GeneralizedWassersteinDiceLoss(DIST_MATRIX, reduction="none")(pred, target)
+        mean = GeneralizedWassersteinDiceLoss(DIST_MATRIX, reduction="mean")(pred, target)
+        total = GeneralizedWassersteinDiceLoss(DIST_MATRIX, reduction="sum")(pred, target)
+        self.assertEqual(none.shape, (2,))
+        np.testing.assert_allclose(mean.item(), none.mean().item(), rtol=1e-5)
+        np.testing.assert_allclose(total.item(), none.sum().item(), rtol=1e-5)
+
+    def test_ill_opts(self):
+        with self.assertRaisesRegex(ValueError, ""):
+            GeneralizedWassersteinDiceLoss(DIST_MATRIX, sigmoid=True, softmax=True)
+        with self.assertRaisesRegex(ValueError, ""):
+            GeneralizedWassersteinDiceLoss(DIST_MATRIX, reduction="unknown")
+        with self.assertRaisesRegex(ValueError, ""):
+            GeneralizedWassersteinDiceLoss(torch.ones((2, 3)))
+        with self.assertRaisesRegex(ValueError, ""):
+            GeneralizedWassersteinDiceLoss(DIST_MATRIX)(torch.ones((1, 2, 3)), torch.ones((1, 2, 3)))
+
+    def test_ill_shape(self):
+        loss = GeneralizedWassersteinDiceLoss(DIST_MATRIX)
+        with self.assertRaisesRegex(AssertionError, ""):
+            loss.forward(torch.ones((1, 3, 3)), torch.ones((4, 5, 6)))
+
+
+if __name__ == "__main__":
+    unittest.main()
