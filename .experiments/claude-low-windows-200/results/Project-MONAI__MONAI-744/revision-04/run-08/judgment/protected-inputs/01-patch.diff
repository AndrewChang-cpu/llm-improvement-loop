+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalization of the Dice score which uses a Wasserstein distance between the predicted class
+    distribution and the ground-truth label, given a class-distance matrix, to discount the true-positive
+    contribution of each voxel. The class weighting follows the generalized Dice loss defined in:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is treated as logits and converted to probabilities with a softmax over the class dimension.
+    The target is an integer class-index map of shape BS[WD] or B1S[WD].
+    """
+
+    def __init__(
+        self, dist_matrix: Union[torch.Tensor, np.ndarray], reduction: Union[LossReduction, str] = LossReduction.MEAN
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), where C is the number of classes.
+                It can be a 2D torch tensor or a 2D numpy array. It is normalized by its maximum entry.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}. Defaults to ``"mean"``.
+                The reduction is stored but does not change the output: the returned loss is always
+                the mean over the batch, regardless of the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s and voxel v.
+
+        Args:
+            flat_proba: probabilities, flattened to shape (batch, classes, N).
+            flat_target: integer class-index labels, flattened to shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+        """
+        m = self.m.to(flat_proba)  # matrix on the probability device and dtype, stored matrix unchanged
+        rows = m[flat_target]  # (batch, N, classes): each voxel's distance row picked by its label
+        return torch.sum(rows.permute(0, 2, 1) * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, flattened to shape (batch, N).
+
+        Returns:
+            weights of shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels, flattened to shape (batch, N).
+            wasserstein_distance_map: distance map of the whole batch, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N): weight of each voxel's own label
+        # pair sample b's weights [b, 1, N] with every sample's (1 - W) [1, s, N], sum over s and voxels
+        weight = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(weight, dim=[1, 2])
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch.
+
+        Args:
+            alpha: class weights of shape (batch, classes).
+            flat_target: integer class-index labels, flattened to shape (batch, N).
+            wasserstein_distance_map: distance map of the whole batch, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N): weight of each voxel's own label
+        weight = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(weight, dim=[1, 2])
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape should be BC[WHD] where C is the number of classes.
+            target: integer class-index labels, shape should be BS[WHD] or B1[WHD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample loss, as a scalar tensor.
+        """
+        flat_proba = torch.softmax(input.reshape(input.shape[0], input.shape[1], -1), dim=1)
+        flat_target = target.reshape(target.shape[0], -1)
+
+        wass_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wass_map)
+        denom = self.compute_denominator(alpha, flat_target, wass_map)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
