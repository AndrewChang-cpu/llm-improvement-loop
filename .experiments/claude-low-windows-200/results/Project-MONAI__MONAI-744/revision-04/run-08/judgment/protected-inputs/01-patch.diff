+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = [[0.0, 1.0], [1.0, 0.0]]
+
+
+def _class_first_logits(label, num_classes):
+    """label: batched integer label map (B, spatial...). Returns logits of shape (B, num_classes, spatial...)."""
+    one_hot = F.one_hot(label, num_classes)  # (B, spatial..., C)
+    one_hot = one_hot.permute(0, -1, *range(1, one_hot.dim() - 1))  # class axis to channel position 1
+    return one_hot.float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        # batch of one, 4x4 label map with inner 2x2 block of label 1
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=torch.tensor(DIST_MATRIX))
+
+        result = loss(_class_first_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # same target with an extra size-1 class axis
+        result = loss(_class_first_logits(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # logits of the flipped target give the worst case
+        flipped = 1 - target
+        result = loss(_class_first_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        # all-zero label map with two classes: class 1 is absent
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=torch.tensor(DIST_MATRIX))
+
+        result = loss(_class_first_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped = 1 - target
+        result = loss(_class_first_logits(flipped, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
