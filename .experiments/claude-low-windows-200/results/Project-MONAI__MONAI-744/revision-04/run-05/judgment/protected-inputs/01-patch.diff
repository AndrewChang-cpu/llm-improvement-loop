+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The per-class weighting follows the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground-truth label, using the class-distance matrix ``dist_matrix``.
+    Input logits have shape BCS[D/H/W] and targets are integer class indices of shape BS[D/H/W]
+    or B1S[D/H/W]. The returned loss is always the batch mean, regardless of ``reduction``.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of size C x C, where C is the number of classes.
+                It can be a torch tensor or a numpy array. It is normalized by its maximum entry
+                when that maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode, stored on the loss. The returned loss is the batch mean
+                regardless of the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance for every sample: W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: the flattened softmax probabilities, shape BCN.
+            flat_target: the flattened integer target, shape BN.
+
+        Returns:
+            the Wasserstein distance map of shape BN, one row per sample.
+        """
+        m = self.m.to(flat_proba.device)
+        # gather each voxel's distance row by its label: shape BN x C
+        dist_rows = m[flat_target]
+        return torch.sum(dist_rows * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of sample b labelled c. Absent classes receive weight 1.
+
+        Args:
+            flat_target: the flattened integer target, shape BN.
+
+        Returns:
+            the alpha weights, shape BC.
+        """
+        volumes = F.one_hot(flat_target, num_classes=self.num_classes).sum(1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for every sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)), where the sum over s runs over every sample's
+        distance map in the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: the class weights, shape BC, from ``compute_weights_generalized_true_positives``.
+            flat_target: the flattened integer target, shape BN.
+            wasserstein_distance_map: the distance map of every sample, shape BN.
+
+        Returns:
+            one generalized true positive value per sample, shape B.
+        """
+        # weight of each voxel of sample b, from its own label: shape BN
+        weight = torch.gather(alpha, 1, flat_target)
+        # pair sample b's weights (B x 1 x N) with every sample's distance map (1 x B x N)
+        terms = weight.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return terms.sum(2).sum(1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for every sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)), where the sum over s runs over every sample's
+        distance map in the batch, so each returned value depends on the whole batch.
+
+        Args:
+            alpha: the class weights, shape BC, from ``compute_weights_generalized_true_positives``.
+            flat_target: the flattened integer target, shape BN.
+            wasserstein_distance_map: the distance map of every sample, shape BN.
+
+        Returns:
+            one generalized denominator value per sample, shape B.
+        """
+        weight = torch.gather(alpha, 1, flat_target)
+        terms = weight.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return terms.sum(2).sum(1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape BCS[D/H/W].
+            target: the integer class indices, shape BS[D/H/W] or B1S[D/H/W].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample loss, as a scalar tensor.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+        flat_proba = torch.softmax(flat_input, 1)
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
