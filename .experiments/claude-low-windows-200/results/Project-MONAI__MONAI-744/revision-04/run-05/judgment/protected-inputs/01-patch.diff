+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _class_first_logits(label_map, num_classes):
+    """Build class-first logits (B, C, spatial...) as 1000 * one-hot of a batched label map (B, spatial...)."""
+    onehot = F.one_hot(label_map, num_classes=num_classes)  # (B, spatial..., C)
+    dims = [0, onehot.dim() - 1] + list(range(1, onehot.dim() - 1))
+    return onehot.permute(*dims).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+
+    def test_binary_2d(self):
+        # batch of one, 4x4 label map with inner 2x2 block of label 1
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        for tgt in (target, target.unsqueeze(1)):
+            # correct prediction
+            result = loss(_class_first_logits(target, 2), tgt)
+            self.assertEqual(result.dim(), 0)
+            self.assertAlmostEqual(result.item(), 0.0, places=3)
+            # flipped prediction
+            result = loss(_class_first_logits(1 - target, 2), tgt)
+            self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        # batch of one, 4x4 label map that is all label 0 with two classes
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        result = loss(_class_first_logits(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+        result = loss(_class_first_logits(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
