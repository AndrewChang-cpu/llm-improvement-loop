+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+        segmentations. MICCAI DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted class
+    distribution and the ground-truth label, computed from the class-distance matrix. The per-class weighting follows
+    the generalized Dice loss (inverse volume). Input is always treated as logits and converted with softmax over
+    the class dimension. Samples in a batch are coupled: the true positive and denominator terms of each sample sum
+    over the distance maps of every sample in the batch.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), as a 2D torch tensor or a 2D numpy array.
+                It is divided by its maximum entry when that maximum is not 1.
+            reduction: the reduction mode, accepts a ``LossReduction`` member or its string value.
+                Defaults to ``"mean"``. It is stored, but it does not change the returned value: the returned loss
+                is always the mean over the batch, whatever the reduction.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix is not square.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map W for every sample and voxel:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances for every sample, shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's distance row, picked by its label
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        sample b with label c. Classes absent from a sample get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights, shape (batch, classes).
+        """
+        counts = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b for each sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value depends on
+        the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples in the batch, shape (batch, N).
+
+        Returns:
+            one true positive value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's own label
+        pairs = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))  # (batch, batch, N)
+        return torch.sum(torch.sum(pairs, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b for each sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value depends on
+        the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of all samples in the batch, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's own label
+        pairs = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))  # (batch, batch, N)
+        return torch.sum(torch.sum(pairs, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BNH[WD].
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of the per-sample loss, regardless of the reduction setting.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denominator = self.compute_denominator(alpha, flat_target, wdm)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
