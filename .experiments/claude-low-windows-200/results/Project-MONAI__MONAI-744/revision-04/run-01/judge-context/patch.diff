+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _class_first_logits(labels, num_classes):
+    """
+    Build class-first logits from a batched integer label map of shape (B, spatial...).
+    Returns a float tensor of shape (B, num_classes, spatial...) with 1000 at the labelled class.
+    """
+    onehot = F.one_hot(labels, num_classes)  # (B, spatial..., classes): class axis last
+    dims = list(range(onehot.dim()))
+    onehot = onehot.permute([0, dims[-1]] + dims[1:-1])  # (B, classes, spatial...)
+    return (onehot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+    def test_binary_2d_case(self):
+        # batch of one, 4 x 4 label map with an inner 2 x 2 block of label 1
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        flipped = 1 - target
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        # correct predictions
+        correct_logits = _class_first_logits(target, 2)
+        self.assertAlmostEqual(loss(correct_logits, target).item(), 0.0, places=3)
+        # target with an added class dimension of size 1: shape (1, 1, 4, 4)
+        self.assertAlmostEqual(loss(correct_logits, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        # flipped predictions
+        flipped_logits = _class_first_logits(flipped, 2)
+        self.assertAlmostEqual(loss(flipped_logits, target).item(), 1.0, places=3)
+
+    def test_empty_class_case(self):
+        # batch of one, 4 x 4 label map where every voxel is label 0 (label 1 is absent)
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        flipped = 1 - target
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        correct_logits = _class_first_logits(target, 2)
+        self.assertAlmostEqual(loss(correct_logits, target).item(), 0.0, places=3)
+
+        flipped_logits = _class_first_logits(flipped, 2)
+        self.assertAlmostEqual(loss(flipped_logits, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
