+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+from parameterized import parameterized
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+def one_hot_logits(label_map, num_classes):
+    """
+    label_map: batched integer label map, shape (batch, spatial...).
+    Returns float logits of shape (batch, num_classes, spatial...), 1000 at the labelled class and 0 elsewhere.
+    """
+    one_hot = F.one_hot(label_map, num_classes=num_classes)  # (batch, spatial..., classes)
+    one_hot = one_hot.permute(0, -1, *range(1, one_hot.dim() - 1))  # class axis to channel position 1
+    return (one_hot * 1000).float()
+
+
+BINARY_LABEL = torch.zeros((1, 4, 4), dtype=torch.long)
+BINARY_LABEL[:, 1:3, 1:3] = 1
+
+TEST_CASES_BINARY = [
+    [  # correct prediction, target (1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": BINARY_LABEL, "flipped": False},
+        0.0,
+    ],
+    [  # correct prediction, target with channel axis (1, 1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": BINARY_LABEL.unsqueeze(1), "flipped": False},
+        0.0,
+    ],
+    [  # flipped prediction, target (1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": BINARY_LABEL, "flipped": True},
+        1.0,
+    ],
+]
+
+EMPTY_LABEL = torch.zeros((1, 4, 4), dtype=torch.long)
+
+TEST_CASES_EMPTY = [
+    [  # correct prediction, all-zero target (1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": EMPTY_LABEL, "flipped": False},
+        0.0,
+    ],
+    [  # flipped prediction, all-zero target (1, 4, 4)
+        {"dist_matrix": DIST_MATRIX},
+        {"target": EMPTY_LABEL, "flipped": True},
+        1.0,
+    ],
+]
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    @parameterized.expand(TEST_CASES_BINARY)
+    def test_binary_2d(self, input_param, input_data, expected_val):
+        target = input_data["target"]
+        label = 1 - target if input_data["flipped"] else target
+        logits = one_hot_logits(label.reshape(target.shape[0], *target.shape[-2:]), 2)
+        result = GeneralizedWassersteinDiceLoss(**input_param)(logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+    @parameterized.expand(TEST_CASES_EMPTY)
+    def test_empty_class(self, input_param, input_data, expected_val):
+        target = input_data["target"]
+        label = 1 - target if input_data["flipped"] else target
+        logits = one_hot_logits(label, 2)
+        result = GeneralizedWassersteinDiceLoss(**input_param)(logits, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), expected_val, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
