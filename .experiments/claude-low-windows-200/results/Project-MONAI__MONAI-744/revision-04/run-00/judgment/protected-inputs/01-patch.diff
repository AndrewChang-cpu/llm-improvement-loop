+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap in which the true-positive contribution of each voxel is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label,
+    using a class-distance matrix. The class weighting follows the generalized Dice loss:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits (softmax is applied over the class dimension). The target
+    is a batch of integer class-index label maps. The returned loss is the batch mean, whatever
+    ``reduction`` is set to.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of size C by C (C = number of classes), given as a
+                torch tensor or a numpy array. It is max-normalized when its maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode. It is stored but does not change the returned value:
+                ``forward`` always returns the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: probabilities, shape batch by classes by N.
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            distance map of shape batch by N.
+        """
+        m = self.m.to(flat_proba.device)
+        # rows of M selected by each voxel's label: batch by N by classes
+        dist_rows = m[flat_target]
+        return torch.sum(dist_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            per-sample, per-class weights, shape batch by classes.
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute TP_b = sum over every sample s in the batch and every voxel v of
+        alpha(b, y_b(v)) * (1 - W_s(v)). The sum runs over every sample's distance map in the batch,
+        so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: distance map for all samples, shape batch by N.
+
+        Returns:
+            one generalized true-positive value per sample, shape batch.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # batch by N
+        # pair sample b's weights (dim 0) with the distance maps of all samples s (dim 1)
+        prod = alpha_voxel.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(prod, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute D_b = sum over every sample s in the batch and every voxel v of
+        alpha(b, y_b(v)) * (2 - W_s(v)). The sum runs over every sample's distance map in the batch,
+        so each returned value depends on the whole batch.
+
+        Args:
+            alpha: class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: distance map for all samples, shape batch by N.
+
+        Returns:
+            one denominator value per sample, shape batch.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # batch by N
+        prod = alpha_voxel.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(prod, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, shape batch by classes by spatial dimensions.
+            target: integer class-index labels, shape batch by spatial dimensions or batch by 1 by spatial dimensions.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+
+        true_pos = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        loss = 1.0 - (2.0 * true_pos + smooth) / (denominator + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
