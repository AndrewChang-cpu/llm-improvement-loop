+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def class_first_logits(label_map, num_classes):
+    """label_map: batched integer labels (B, H, W). Returns logits (B, C, H, W) = 1000 * one-hot."""
+    onehot = F.one_hot(label_map, num_classes=num_classes)  # (B, H, W, C)
+    onehot = onehot.permute(0, 3, 1, 2)  # (B, C, H, W)
+    return (onehot * 1000).float()
+
+
+DIST_MATRIX = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # batched label map
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = class_first_logits(target, 2)
+        np.testing.assert_allclose(loss(logits, target).detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # target with an added size-1 class axis: shape (B, 1, H, W)
+        np.testing.assert_allclose(loss(logits, target.unsqueeze(1)).detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped = class_first_logits(1 - target, 2)
+        np.testing.assert_allclose(loss(flipped, target).detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all label 0, batch axis of size 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = class_first_logits(target, 2)
+        np.testing.assert_allclose(loss(logits, target).detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped = class_first_logits(1 - target, 2)
+        np.testing.assert_allclose(loss(flipped, target).detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
