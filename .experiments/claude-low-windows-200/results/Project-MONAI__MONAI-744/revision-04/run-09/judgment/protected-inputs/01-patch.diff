+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the Generalized Wasserstein Dice Loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It extends the Generalized Dice overlap of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. MICCAI DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted
+    class distribution and the ground-truth label, computed with a class-distance matrix. The class weighting
+    follows the generalized Dice loss (inverse volume of each class).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of size C by C, where C is the number of classes.
+                It can be a torch tensor or a numpy array. It is max-normalized to a maximum entry of 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction mode, stored on the loss. Defaults to ``"mean"``.
+                The loss returned by ``forward`` is the batch mean regardless of the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, the shape should be BCH[WD]. Softmax is applied over the class dimension.
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean of the per-sample losses over the batch.
+
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)  # batch, classes, N
+        flat_target = target.reshape(batch, -1)  # batch, N
+        flat_proba = torch.softmax(flat_input, 1)
+
+        wass = self.wasserstein_distance_map(flat_proba, flat_target)  # batch, N
+        alpha = self.compute_weights_generalized_true_positives(flat_target)  # batch, classes
+
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wass)  # batch
+        denom = self.compute_denominator(alpha, flat_target, wass)  # batch
+
+        f = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(f)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample s.
+
+        Args:
+            flat_proba: softmax probabilities, the shape should be batch by classes by N.
+            flat_target: integer class-index labels, the shape should be batch by N.
+
+        Returns:
+            distances of shape batch by N.
+
+        """
+        m = self.m.to(flat_proba.device)
+        dist_rows = m[flat_target]  # batch, N, classes: row of M selected by each voxel's label
+        proba = flat_proba.permute(0, 2, 1)  # batch, N, classes
+        return torch.sum(dist_rows * proba, dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the generalized Dice class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number
+        of voxels in sample b with label c. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, the shape should be batch by N.
+
+        Returns:
+            per-sample, per-class weights of shape batch by classes.
+
+        """
+        onehot_target = F.one_hot(flat_target, self.num_classes)  # batch, N, classes
+        volumes = torch.sum(onehot_target, dim=1).float()  # batch, classes
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, the shape should be batch by classes.
+            flat_target: integer class-index labels, the shape should be batch by N.
+            wasserstein_distance_map: distances for every sample, the shape should be batch by N.
+
+        Returns:
+            one true-positive value per sample, of shape batch.
+
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # batch, N: alpha of each voxel's own label
+        weighted = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)  # batch(b), batch(s), N
+        return torch.sum(torch.sum(weighted, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, the shape should be batch by classes.
+            flat_target: integer class-index labels, the shape should be batch by N.
+            wasserstein_distance_map: distances for every sample, the shape should be batch by N.
+
+        Returns:
+            one denominator value per sample, of shape batch.
+
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)  # batch, N: alpha of each voxel's own label
+        weighted = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)  # batch(b), batch(s), N
+        return torch.sum(torch.sum(weighted, dim=2), dim=1)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
