+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _class_first_logits(label, num_classes):
+    """
+    Build class-first logits from a batched integer label map.
+    `label` has shape (B, spatial...); the result has shape (B, num_classes, spatial...).
+    """
+    one_hot = F.one_hot(label.long(), num_classes=num_classes)  # (B, spatial..., C)
+    n = one_hot.dim()
+    perm = [0, n - 1] + list(range(1, n - 1))  # move the class axis to channel position 1
+    return one_hot.permute(*perm).float() * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1  # inner 2 x 2 block is label 1
+
+        # correct prediction, class-first (B, C, H, W)
+        pred = _class_first_logits(target, 2)
+        result = loss.forward(pred, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # target with an extra class-dimension axis, shape (B, 1, H, W)
+        result = loss.forward(pred, target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction (wrong at every voxel)
+        flipped_pred = _class_first_logits(1 - target, 2)
+        result = loss.forward(flipped_pred, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        target = torch.zeros((1, 4, 4), dtype=torch.long)  # all label 0, class 1 is empty
+
+        pred = _class_first_logits(target, 2)
+        result = loss.forward(pred, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        flipped_pred = _class_first_logits(1 - target, 2)
+        result = loss.forward(flipped_pred, target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
