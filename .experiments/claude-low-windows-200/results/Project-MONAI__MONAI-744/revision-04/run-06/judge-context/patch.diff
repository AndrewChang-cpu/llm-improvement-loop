+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the predicted class
+    distribution and the ground-truth label, computed with a class-distance matrix. The class weights follow the
+    generalized Dice loss weighting (Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss
+    function for highly unbalanced segmentations. DLMIA 2017), i.e. the inverse of the label volume.
+    """
+
+    def __init__(
+        self, dist_matrix: Union[torch.Tensor, np.ndarray], reduction: Union[LossReduction, str] = LossReduction.MEAN
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), as a torch tensor or a numpy array.
+                It is divided by its maximum entry when that maximum is not 1.
+            reduction: the reduction mode, as a ``LossReduction`` member or its string value. Defaults to ``"mean"``.
+                It is stored but does not change the output of ``forward``: the returned loss is always
+                the mean over the batch.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction is invalid.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: float logits, the shape should be BCH[WD].
+            target: integer class indices, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample loss.
+
+        """
+        flat_proba = torch.softmax(input.reshape(input.shape[0], input.shape[1], -1), 1)  # B x C x N
+        flat_target = target.reshape(target.shape[0], -1)  # B x N
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)  # B x N
+        alpha = self.compute_weights_generalized_true_positives(flat_target)  # B x C
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)  # B
+        denominator = self.compute_denominator(alpha, flat_target, wdm)  # B
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map for every sample and voxel:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: softmax probabilities, the shape should be B x C x N.
+            flat_target: integer class indices, the shape should be B x N.
+
+        Returns:
+            per-voxel distances for every sample, the shape is B x N.
+
+        """
+        m = self.m.to(flat_proba.device)
+        dist_rows = m[flat_target]  # B x N x C, the row of M selected by each voxel's label
+        return torch.sum(dist_rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number
+        of voxels of sample b with label c. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class indices, the shape should be B x N.
+
+        Returns:
+            alpha weights, the shape is B x C.
+
+        """
+        onehot_target = F.one_hot(flat_target, num_classes=self.num_classes)  # B x N x C
+        volumes = torch.sum(onehot_target, dim=1).float()  # B x C
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for every sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on the
+        whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, the shape should be B x C.
+            flat_target: integer class indices, the shape should be B x N.
+            wasserstein_distance_map: distance map of every sample, the shape should be B x N.
+
+        Returns:
+            one true-positive value per sample, the shape is B.
+
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # B x N, weight of each voxel of sample b
+        # [b, s, v] = alpha(b, y_b(v)) * (1 - W_s(v))
+        weighted = alpha_vox.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(weighted, dim=[1, 2])
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for every sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map in the batch, so each returned value depends on the
+        whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, the shape should be B x C.
+            flat_target: integer class indices, the shape should be B x N.
+            wasserstein_distance_map: distance map of every sample, the shape should be B x N.
+
+        Returns:
+            one denominator value per sample, the shape is B.
+
+        """
+        alpha_vox = torch.gather(alpha, 1, flat_target)  # B x N, weight of each voxel of sample b
+        # [b, s, v] = alpha(b, y_b(v)) * (2 - W_s(v))
+        weighted = alpha_vox.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(weighted, dim=[1, 2])
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
