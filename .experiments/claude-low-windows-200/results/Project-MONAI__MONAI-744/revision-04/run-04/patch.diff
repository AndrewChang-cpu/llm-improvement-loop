+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It builds on the generalized Dice overlap of:
+
+        Sudre, C. et al. (2017) Generalised Dice overlap as a deep learning loss function for
+        highly unbalanced segmentations. DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by a Wasserstein distance between the
+    predicted class distribution (softmax of the logits) and the ground-truth label, computed from
+    a class-distance matrix. The per-class weighting follows the generalized Dice loss (inverse
+    volume). The returned loss is the batch mean.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of shape (C, C), as a torch tensor or numpy array,
+                where C is the number of input channels. Its entries should be nonnegative. It is
+                max-normalized so that its maximum entry is 1.
+            reduction: the reduction mode. Defaults to ``"mean"``. It is stored but does not change
+                the output: the returned loss is always the batch mean, regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map for every sample in the batch:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v).
+
+        Args:
+            flat_proba: probabilities, shape (batch, classes, N).
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            distance map of shape (batch, N).
+        """
+        m = self.m.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        dist_rows = m[flat_target]  # (batch, N, classes): each voxel's distance row from its label
+        return torch.sum(dist_rows * flat_proba.transpose(1, 2), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the generalized Dice class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is
+        the number of voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights of shape (batch, classes).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives for each sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum runs over every sample's distance map s in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of every sample, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        # pair sample b's weights (index b) with the distance maps of all samples (index s)
+        weighted = alpha_per_voxel.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(weighted, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator for each sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum runs over every sample's distance map s in the batch, so each returned value depends
+        on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights, shape (batch, classes).
+            flat_target: integer class-index labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of every sample, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N)
+        weighted = alpha_per_voxel.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(weighted, dim=(1, 2))
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5):
+        """
+        Args:
+            input: the logits, shape should be BCS[D][H][W] (batch, classes, spatial dimensions).
+            target: integer class-index labels, shape should be B[1]S[D][H][W]
+                (batch, optional singleton channel, spatial dimensions).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP + smooth) / (D + smooth)``.
+        """
+        batch = input.shape[0]
+        flat_proba = torch.softmax(input.reshape(batch, input.shape[1], -1), dim=1)
+        flat_target = target.reshape(batch, -1)
+
+        wdm = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wdm)
+        denom = self.compute_denominator(alpha, flat_target, wdm)
+
+        loss = 1.0 - (2.0 * tp + smooth) / (denom + smooth)
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
