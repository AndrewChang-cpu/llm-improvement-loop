+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap score in which the true-positive contribution of each voxel is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label. The distance is
+    computed from a class-distance matrix. The per-class weighting follows the generalized Dice loss
+    (Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly unbalanced
+    segmentations. DLMIA 2017), i.e. the inverse of the class volume.
+
+    The input is always treated as logits and converted to probabilities with a softmax over the class dimension.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), where C is the number of classes.
+                It can be a 2D torch tensor or a 2D numpy array with nonnegative entries. It is divided by its
+                maximum entry when that maximum is not 1.
+            reduction: the reduction mode. Defaults to ``"mean"``. The returned loss is the batch mean
+                regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the Wasserstein distance map of every sample and voxel:
+        W_s(v) = sum_k M[y_s(v), k] * p_k,s(v), where y_s(v) is the ground-truth label and p_k,s(v) the probability.
+
+        Args:
+            flat_proba: probabilities of shape (batch, classes, N).
+            flat_target: integer class labels of shape (batch, N).
+
+        Returns:
+            per-voxel distances of shape (batch, N), computed for every sample in the batch.
+        """
+        m = self.m.to(flat_proba.device)
+        # each voxel picks its distance row from the matrix using its label: shape (batch, N, classes)
+        rows = m[flat_target]
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        sample b labelled c. A class absent from a sample gets weight 1.
+
+        Args:
+            flat_target: integer class labels of shape (batch, N).
+
+        Returns:
+            per-sample, per-class weights of shape (batch, classes).
+        """
+        one_hot = F.one_hot(flat_target, num_classes=self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot, dim=1).float()  # (batch, classes)
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives of every sample b:
+        TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The weight uses sample b's own labels, while the distance map of every sample s in the batch is summed.
+        Each returned value therefore depends on the whole batch, not only on the sample's own distance map.
+
+        Args:
+            alpha: per-sample, per-class weights of shape (batch, classes).
+            flat_target: integer class labels of shape (batch, N).
+            wasserstein_distance_map: distance map of every sample in the batch, of shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, of shape (batch,).
+        """
+        # weight of each voxel from its own label: shape (batch, N)
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        # pair sample b's weights with the distance maps of all samples s: shape (batch, batch, N)
+        weighted = alpha_map.unsqueeze(1) * (1.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(weighted, dim=2), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator of every sample b:
+        D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        As for the true positives, the sum runs over the distance map of every sample s in the batch, so each
+        returned value depends on the whole batch.
+
+        Args:
+            alpha: per-sample, per-class weights of shape (batch, classes).
+            flat_target: integer class labels of shape (batch, N).
+            wasserstein_distance_map: distance map of every sample in the batch, of shape (batch, N).
+
+        Returns:
+            one denominator value per sample, of shape (batch,).
+        """
+        alpha_map = torch.gather(alpha, 1, flat_target)
+        weighted = alpha_map.unsqueeze(1) * (2.0 - wasserstein_distance_map).unsqueeze(0)
+        return torch.sum(torch.sum(weighted, dim=2), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits of shape (batch, classes, spatial dimensions).
+            target: integer class labels of shape (batch, spatial dimensions) or (batch, 1, spatial dimensions).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses as a scalar tensor.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positive = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * true_positive + smooth) / (denominator + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+
 dice = Dice = DiceLoss
