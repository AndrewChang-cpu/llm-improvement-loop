+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(label, num_classes):
+    """
+    Build class-first logits from a batched integer label map of shape (batch, spatial...).
+    The one-hot class axis is moved to channel position 1, then the result is scaled by 1000 and cast to float.
+    """
+    onehot = F.one_hot(label, num_classes=num_classes)  # (batch, spatial..., classes)
+    ndim = label.dim()
+    onehot = onehot.permute([0, ndim] + list(range(1, ndim)))  # (batch, classes, spatial...)
+    return (onehot * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        # batch of one, 4 by 4 label map with an inner 2 by 2 block of label 1
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct prediction
+        result = loss(one_hot_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # same target with an added class-dimension axis of size 1
+        result = loss(one_hot_logits(target, 2), target.unsqueeze(1))
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        result = loss(one_hot_logits(1 - target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        # batch of one, 4 by 4 label map that is all label 0 (class 1 is absent)
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct prediction
+        result = loss(one_hot_logits(target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 0.0, atol=1e-3)
+
+        # flipped prediction
+        result = loss(one_hot_logits(1 - target, 2), target)
+        np.testing.assert_allclose(result.detach().cpu().numpy(), 1.0, atol=1e-3)
+
+
+if __name__ == "__main__":
+    unittest.main()
