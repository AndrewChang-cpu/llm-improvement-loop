+import unittest
+
+import numpy as np
+import torch
+from torch.nn import functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(label, num_classes):
+    """
+    Build class-first logits from a batched integer label map of shape (batch, spatial...).
+    The one-hot class axis (last) is moved to channel position 1, then scaled by 1000.
+    """
+    onehot = F.one_hot(label, num_classes=num_classes)
+    ndim = onehot.dim()
+    dims = [0, ndim - 1] + list(range(1, ndim - 1))
+    return (onehot.permute(*dims) * 1000).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]])
+        # batch of one, 4 by 4 label map with inner 2 by 2 block labelled 1
+        label = torch.zeros((1, 4, 4), dtype=torch.long)
+        label[:, 1:3, 1:3] = 1
+        flipped = 1 - label
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        # correct prediction, label map with batch axis
+        result = loss(_one_hot_logits(label, 2), label)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(float(result), 0.0, places=3)
+
+        # correct prediction, label map with an extra channel axis of size 1
+        result = loss(_one_hot_logits(label, 2), label.unsqueeze(1))
+        self.assertAlmostEqual(float(result), 0.0, places=3)
+
+        # flipped prediction
+        result = loss(_one_hot_logits(flipped, 2), label)
+        self.assertAlmostEqual(float(result), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist = np.array([[0.0, 1.0], [1.0, 0.0]])
+        # batch of one, 4 by 4 map that is all label 0, so class 1 is absent
+        label = torch.zeros((1, 4, 4), dtype=torch.long)
+        flipped = 1 - label
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist)
+
+        result = loss(_one_hot_logits(label, 2), label)
+        self.assertAlmostEqual(float(result), 0.0, places=3)
+
+        result = loss(_one_hot_logits(flipped, 2), label)
+        self.assertAlmostEqual(float(result), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
