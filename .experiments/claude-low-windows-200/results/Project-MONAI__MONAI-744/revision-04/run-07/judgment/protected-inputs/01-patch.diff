+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap score in which the true-positive contribution of each voxel is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label,
+    computed with a class-distance matrix. The class weighting follows the generalized Dice loss
+    (Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning loss function for highly
+    unbalanced segmentations. DLMIA 2017), i.e. the inverse volume of each class.
+
+    The input is always treated as logits (softmax over the class dimension is applied internally).
+    The target is an integer class-index label map with a leading batch axis, with shape
+    ``(batch, spatial...)`` or ``(batch, 1, spatial...)``.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of shape (C, C), where C is the number of classes.
+                Accepts a 2D torch tensor or a 2D numpy array. Entries must be nonnegative. The matrix is
+                divided by its maximum entry when that maximum is not 1.
+            reduction: the reduction mode, accepts a ``LossReduction`` member or its string value.
+                Defaults to ``"mean"``. It is passed to the parent initializer and stored. The returned loss
+                is always the batch mean, regardless of the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. The distance matrix must be square.
+            ValueError: reduction is not a valid ``LossReduction`` value.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if float(torch.max(dist_matrix)) != 1.0:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.m = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape should be BCH[WD] (batch, classes, spatial dimensions).
+            target: the integer class-index labels, shape should be B[H WD] or B1[H WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the batch mean of the per-sample loss ``1 - (2 * TP + smooth) / (D + smooth)``.
+
+        """
+        flat_proba = torch.softmax(input.reshape(input.shape[0], input.shape[1], -1), dim=1)
+        flat_target = target.reshape(target.shape[0], -1)
+
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        true_positive = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * true_positive + smooth) / (denominator + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map W_s(v) = sum_k M[y_s(v), k] * p_k,s(v) for every sample.
+
+        Args:
+            flat_proba: softmax probabilities, shape (batch, classes, N).
+            flat_target: flattened integer labels, shape (batch, N).
+
+        Returns:
+            per-voxel distances, shape (batch, N).
+
+        """
+        m = self.m.to(flat_proba.device)
+        rows = m[flat_target]  # (batch, N, classes): each voxel's distance row, picked by its label
+        proba = flat_proba.permute(0, 2, 1)  # (batch, N, classes)
+        return torch.sum(rows * proba, dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number
+        of voxels in sample b labelled c. Absent classes get weight 1.
+
+        Args:
+            flat_target: flattened integer labels, shape (batch, N).
+
+        Returns:
+            weights alpha, shape (batch, classes).
+
+        """
+        one_hot = F.one_hot(flat_target, num_classes=self.num_classes)  # (batch, N, classes)
+        volumes = torch.sum(one_hot, dim=1)  # (batch, classes)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_s sum_v alpha(b, y_b(v)) * (1 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch, not only on sample b.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: flattened integer labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of the whole batch, shape (batch, N).
+
+        Returns:
+            one true-positive value per sample, shape (batch,).
+
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's own label
+        # pair sample b's weights (axis 0) with every sample s's distance map (axis 1)
+        pairs = alpha_voxel.unsqueeze(1) * (1.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(pairs, dim=(1, 2))
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_s sum_v alpha(b, y_b(v)) * (2 - W_s(v)).
+        The sum over s runs over every sample's distance map in the batch, so each returned value
+        depends on the whole batch, not only on sample b.
+
+        Args:
+            alpha: class weights from ``compute_weights_generalized_true_positives``, shape (batch, classes).
+            flat_target: flattened integer labels, shape (batch, N).
+            wasserstein_distance_map: distance maps of the whole batch, shape (batch, N).
+
+        Returns:
+            one denominator value per sample, shape (batch,).
+
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)  # (batch, N): alpha of each voxel's own label
+        # pair sample b's weights (axis 0) with every sample s's distance map (axis 1)
+        pairs = alpha_voxel.unsqueeze(1) * (2.0 - wasserstein_distance_map.unsqueeze(0))
+        return torch.sum(pairs, dim=(1, 2))
+
+
 dice = Dice = DiceLoss
