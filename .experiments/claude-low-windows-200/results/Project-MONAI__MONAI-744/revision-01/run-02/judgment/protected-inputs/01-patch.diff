+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is based on the generalized Dice overlap of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution (softmax of the logits) and the ground truth label, computed with
+    the class-distance matrix `dist_matrix`. The class weights follow the generalized Dice loss
+    weighting (inverse volume), with absent classes receiving weight 1.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of size C by C, as a torch tensor or numpy array.
+                It is max-normalized (divided by its maximum entry) unless the maximum is already 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction to apply to the output. Defaults to ``"mean"``.
+
+                - ``"none"``: no reduction will be applied.
+                - ``"mean"``: the sum of the output will be divided by the number of elements in the output.
+                - ``"sum"``: the output will be summed.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        max_value = torch.max(dist_matrix)
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities, shape [B, C, N].
+            flat_target: integer class labels, shape [B, N].
+
+        Returns:
+            per-voxel distances, shape [B, N].
+        """
+        matrix = self.matrix.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # gather the rows of the distance matrix for each voxel's label: [B, N, C]
+        distances_per_label = matrix[flat_target]
+        return torch.sum(distances_per_label * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class labels, shape [B, N].
+
+        Returns:
+            per-sample, per-class weights, shape [B, C].
+        """
+        one_hot_target = F.one_hot(flat_target, self.num_classes)  # [B, N, C]
+        volumes = torch.sum(one_hot_target, dim=1)  # [B, C]
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape [B, C].
+            flat_target: integer class labels, shape [B, N].
+            wasserstein_distance_map: per-voxel distances W, shape [B, N].
+
+        Returns:
+            per-sample generalized true positives, shape [B].
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)  # [B, N]
+        return torch.sum(alpha_per_voxel * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape [B, C].
+            flat_target: integer class labels, shape [B, N].
+            wasserstein_distance_map: per-voxel distances W, shape [B, N].
+
+        Returns:
+            per-sample denominators, shape [B].
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)  # [B, N]
+        return torch.sum(alpha_per_voxel * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: float logits, shape [B, C, spatial...].
+            target: integer class labels, shape [B, spatial...] or [B, 1, spatial...].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of 1 - (2 * TP_b + smooth) / (D_b + smooth).
+        """
+        flat_input = input.flatten(2)  # [B, C, N]
+        flat_target = target.reshape(target.shape[0], -1)  # [B, N]
+        flat_proba = torch.softmax(flat_input, dim=1)
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positives = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * true_positives + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
