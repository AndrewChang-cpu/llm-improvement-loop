+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(target, num_classes):
+    # channels-first logits, 1000 times the one-hot encoding of the target
+    one_hot = F.one_hot(target, num_classes).float()  # [B, H, W, C]
+    return one_hot.permute(0, 3, 1, 2) * 1000.0
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[0, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=torch.tensor([[0.0, 1.0], [1.0, 0.0]]))
+
+        logits = _one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss(logits, target).item(), 0.0, places=3)
+        # target with an explicit channel dimension
+        self.assertAlmostEqual(loss(logits, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped_logits, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=torch.tensor([[0.0, 1.0], [1.0, 0.0]]))
+
+        logits = _one_hot_logits(target, 2)
+        self.assertAlmostEqual(loss(logits, target).item(), 0.0, places=3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped_logits, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
