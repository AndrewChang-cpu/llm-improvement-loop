+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(target: torch.Tensor, num_classes: int) -> torch.Tensor:
+    """Return 1000 times the one-hot encoding of `target` (B, H, W), channels first."""
+    return 1000.0 * F.one_hot(target, num_classes=num_classes).permute(0, 3, 1, 2).float()
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct logits give a loss of 0, with and without a channel dimension in the target
+        loss_value = loss(_one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(loss_value.item(), 0.0, places=3)
+        loss_value = loss(_one_hot_logits(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(loss_value.item(), 0.0, places=3)
+
+        # flipped logits give a loss of 1
+        flipped = 1 - target
+        loss_value = loss(_one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(loss_value.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        loss_value = loss(_one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(loss_value.item(), 0.0, places=3)
+
+        loss_value = loss(_one_hot_logits(1 - target, 2), target)
+        self.assertAlmostEqual(loss_value.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
