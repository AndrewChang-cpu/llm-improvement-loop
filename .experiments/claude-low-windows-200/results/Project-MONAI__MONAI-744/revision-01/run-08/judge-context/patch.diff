+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is built on the generalized Dice overlap of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. MICCAI DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution (softmax of the logits) and the ground-truth label, using a
+    class-distance matrix. The per-class weights follow the generalized Dice weighting (inverse volume),
+    as in the generalized Dice loss.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square matrix of class distances, of size C by C where C is the number of classes.
+                It can be a 2D torch tensor or a 2D numpy array. It is max-normalized to a maximum of 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction to apply to the output. Defaults to ``"mean"``.
+
+                - ``"none"``: no reduction will be applied.
+                - ``"mean"``: the sum of the output will be divided by the number of elements in the output.
+                - ``"sum"``: the output will be summed.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.matrix = dist_matrix
+        self.num_classes = self.matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities of shape BCN.
+            flat_target: integer class-index labels of shape BN.
+
+        Returns:
+            per-voxel distances of shape BN.
+        """
+        matrix = self.matrix.to(flat_proba.device)
+        # gather the rows of the distance matrix for each voxel's ground-truth label: BN x C
+        dist_rows = matrix[flat_target]
+        return torch.sum(dist_rows * flat_proba.transpose(1, 2), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape BN.
+
+        Returns:
+            alpha weights of shape BC.
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights of shape BC.
+            flat_target: integer class-index labels of shape BN.
+            wasserstein_distance_map: per-voxel distances of shape BN.
+
+        Returns:
+            per-sample generalized true positives of shape B.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_voxel * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights of shape BC.
+            flat_target: integer class-index labels of shape BN.
+            wasserstein_distance_map: per-voxel distances of shape BN.
+
+        Returns:
+            per-sample denominators of shape B.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_voxel * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape BC[spatial], softmax is applied over the class dimension.
+            target: integer class-index labels of shape B[spatial] or B1[spatial].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean over the batch of the per-sample loss ``1 - (2 * TP + smooth) / (D + smooth)``.
+        """
+        batch_size, n_classes = input.shape[0], input.shape[1]
+        flat_proba = torch.softmax(input.reshape(batch_size, n_classes, -1), dim=1)
+        flat_target = target.reshape(batch_size, -1)
+
+        wasserstein_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
