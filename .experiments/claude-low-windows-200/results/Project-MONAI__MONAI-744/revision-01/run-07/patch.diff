+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalization of the Generalized Dice overlap (Sudre, C. et. al. (2017) Generalised Dice overlap
+    as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017). The class weights follow
+    the generalized Dice loss weighting (inverse volume). The true positives of each voxel are discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed from a
+    class-distance matrix.
+
+    Input logits are expected with shape BC[SPATIAL], target class indices with shape B[SPATIAL] or B1[SPATIAL].
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D, square, nonnegative class-distance matrix of shape (C, C), where C is the number of
+                classes. Can be a torch tensor or a numpy array. It is divided by its maximum entry when that
+                maximum is not 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction to apply to the output. Defaults to ``"mean"``. It is stored but not
+                applied in ``forward``, which always returns the batch mean.
+
+                - ``"none"``: no reduction will be applied.
+                - ``"mean"``: the sum of the output will be divided by the number of elements in the output.
+                - ``"sum"``: the output will be summed.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if dist_matrix.max() != 1:
+            dist_matrix = dist_matrix / dist_matrix.max()
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: softmax probabilities, shape (B, C, N).
+            flat_target: class index labels, shape (B, N).
+
+        Returns:
+            per-voxel distances, shape (B, N).
+        """
+        matrix = self.matrix.to(flat_proba.device)
+        # gather the rows of the distance matrix for each voxel's label: shape (B, N, C)
+        rows = matrix[flat_target]
+        return torch.sum(rows.transpose(1, 2) * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels of
+        class c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: class index labels, shape (B, N).
+
+        Returns:
+            per-sample, per-class weights, shape (B, C).
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape (B, C).
+            flat_target: class index labels, shape (B, N).
+            wasserstein_distance_map: per-voxel distances, shape (B, N).
+
+        Returns:
+            per-sample generalized true positives, shape (B,).
+        """
+        voxel_alpha = torch.gather(alpha, 1, flat_target)
+        return torch.sum(voxel_alpha * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape (B, C).
+            flat_target: class index labels, shape (B, N).
+            wasserstein_distance_map: per-voxel distances, shape (B, N).
+
+        Returns:
+            per-sample denominators, shape (B,).
+        """
+        voxel_alpha = torch.gather(alpha, 1, flat_target)
+        return torch.sum(voxel_alpha * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: logits, shape BC[SPATIAL]. Softmax is applied over the class dimension.
+            target: class index labels, shape B[SPATIAL] or B1[SPATIAL].
+            smooth: a small constant added to numerator and denominator to avoid division by zero.
+
+        Returns:
+            scalar tensor, the batch mean of the per-sample losses 1 - (2 * TP_b + smooth) / (D_b + smooth).
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+        flat_proba = torch.softmax(flat_input, dim=1)
+
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_pos = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * true_pos + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
