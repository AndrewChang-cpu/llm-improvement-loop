+import unittest
+
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(labels: torch.Tensor, num_classes: int) -> torch.Tensor:
+    # labels: (B, H, W) integer map -> logits (B, C, H, W) equal to 1000 times the one-hot encoding
+    channels = [(labels == c).float() for c in range(num_classes)]
+    return 1000.0 * torch.stack(channels, dim=1)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[0, 1:3, 1:3] = 1
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct prediction, with and without a channel dimension in the target
+        logits = _one_hot_logits(target, 2)
+        self.assertAlmostEqual(float(loss(logits, target)), 0.0, places=3)
+        self.assertAlmostEqual(float(loss(logits, target.unsqueeze(1))), 0.0, places=3)
+
+        # flipped prediction
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(float(loss(flipped_logits, target)), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        logits = _one_hot_logits(target, 2)
+        self.assertAlmostEqual(float(loss(logits, target)), 0.0, places=3)
+
+        flipped_logits = _one_hot_logits(1 - target, 2)
+        self.assertAlmostEqual(float(loss(flipped_logits, target)), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
