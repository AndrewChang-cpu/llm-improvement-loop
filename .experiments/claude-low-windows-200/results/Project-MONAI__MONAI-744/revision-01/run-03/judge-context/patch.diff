+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a Dice-type overlap score in which each voxel's true-positive contribution is discounted by the
+    Wasserstein distance between the predicted class distribution and the ground-truth label, computed from a
+    class-distance matrix. The class weighting follows the generalized Dice loss (Sudre et al., Generalised Dice
+    overlap as a deep learning loss function for highly unbalanced segmentations, DLMIA 2017), i.e. inverse volume.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), as a torch tensor or numpy array.
+                It is max-normalized (divided by its maximum entry) unless its maximum is already 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction to apply to the output. Defaults to ``"mean"``.
+
+                - ``"none"``: no reduction will be applied.
+                - ``"mean"``: the sum of the output will be divided by the number of elements in the output.
+                - ``"sum"``: the output will be summed.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+        super().__init__(reduction=LossReduction(reduction).value)
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities of shape (B, C, N).
+            flat_target: integer class-index labels of shape (B, N).
+
+        Returns:
+            per-voxel distances of shape (B, N).
+        """
+        matrix = self.matrix.to(flat_proba.device)
+        # M[y(v)] has shape (B, N, C); flat_proba is permuted to (B, N, C) before the dot over classes
+        return torch.sum(matrix[flat_target] * flat_proba.permute(0, 2, 1), dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of
+        voxels of class c in sample b. Absent classes therefore get weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape (B, N).
+
+        Returns:
+            alpha weights of shape (B, C).
+        """
+        one_hot = F.one_hot(flat_target, num_classes=self.num_classes)
+        volumes = torch.sum(one_hot, dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: class weights of shape (B, C), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels of shape (B, N).
+            wasserstein_distance_map: per-voxel distances of shape (B, N).
+
+        Returns:
+            per-sample true positives of shape (B,).
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_voxel * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: class weights of shape (B, C), from compute_weights_generalized_true_positives.
+            flat_target: integer class-index labels of shape (B, N).
+            wasserstein_distance_map: per-voxel distances of shape (B, N).
+
+        Returns:
+            per-sample denominators of shape (B,).
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_voxel * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape (B, C, spatial...).
+            target: integer class-index labels of shape (B, spatial...) or (B, 1, spatial...).
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of 1 - (2 * TP_b + smooth) / (D_b + smooth).
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, input.shape[1], -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = F.softmax(flat_input, dim=1)
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positives = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * true_positives + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
