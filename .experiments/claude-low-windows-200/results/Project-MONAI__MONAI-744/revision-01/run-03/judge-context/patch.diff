+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _logits_from_labels(labels, num_classes, scale=1000.0):
+    """Channels-first logits equal to `scale` times the one-hot encoding of integer labels."""
+    one_hot = F.one_hot(labels, num_classes=num_classes).permute(0, -1, *range(1, labels.dim()))
+    return one_hot.float() * scale
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def setUp(self):
+        self.dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        self.target = torch.zeros(1, 4, 4, dtype=torch.long)
+        self.target[:, 1:3, 1:3] = 1
+
+    def test_binary_2d_case(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+
+        # perfect prediction
+        logits = _logits_from_labels(self.target, num_classes=2)
+        self.assertAlmostEqual(loss(logits, self.target).item(), 0.0, places=3)
+
+        # same target with an added channel dimension
+        target_with_channel = self.target.unsqueeze(1)
+        self.assertAlmostEqual(loss(logits, target_with_channel).item(), 0.0, places=3)
+
+        # completely wrong prediction (flipped target)
+        flipped_logits = _logits_from_labels(1 - self.target, num_classes=2)
+        self.assertAlmostEqual(loss(flipped_logits, self.target).item(), 1.0, places=3)
+
+    def test_empty_class_case(self):
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=self.dist_matrix)
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+
+        # perfect prediction of a sample containing only label 0
+        logits = _logits_from_labels(target, num_classes=2)
+        self.assertAlmostEqual(loss(logits, target).item(), 0.0, places=3)
+
+        # flipped prediction
+        flipped_logits = _logits_from_labels(1 - target, num_classes=2)
+        self.assertAlmostEqual(loss(flipped_logits, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
