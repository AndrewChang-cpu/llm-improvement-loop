+import unittest
+
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(target, num_classes):
+    """Logits equal to 1000 times the one-hot encoding of `target` (channels first)."""
+    one_hot = F.one_hot(target.long(), num_classes).float()
+    # (B, spatial..., C) -> (B, C, spatial...)
+    dims = [0, one_hot.dim() - 1] + list(range(1, one_hot.dim() - 1))
+    return 1000.0 * one_hot.permute(*dims)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        flipped = 1 - target
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+        # perfect prediction, with and without an explicit channel dimension
+        perfect = loss(_one_hot_logits(target, 2), target)
+        perfect_channel = loss(_one_hot_logits(target, 2), target.unsqueeze(1))
+        self.assertEqual(perfect.dim(), 0)
+        self.assertAlmostEqual(perfect.item(), 0.0, places=3)
+        self.assertAlmostEqual(perfect_channel.item(), 0.0, places=3)
+
+        # fully wrong prediction
+        wrong_loss = loss(_one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(wrong_loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        flipped = 1 - target
+
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+        perfect = loss(_one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(perfect.item(), 0.0, places=3)
+
+        wrong = loss(_one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(wrong.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
