+import unittest
+
+import numpy as np
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(target: torch.Tensor, num_classes: int) -> torch.Tensor:
+    """Logits equal to 1000 times the one-hot encoding of `target` (channels first)."""
+    onehot = torch.nn.functional.one_hot(target.long(), num_classes).float()
+    # (B, spatial..., C) -> (B, C, spatial...)
+    return 1000.0 * onehot.movedim(-1, 1)
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = [[0, 1], [1, 0]]
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=np.array(dist_matrix))
+
+        # target without channel dimension
+        loss = loss_fn(one_hot_logits(target, 2), target)
+        self.assertEqual(loss.dim(), 0)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # target with added channel dimension
+        loss = loss_fn(one_hot_logits(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # flipped target as prediction
+        flipped = 1 - target
+        loss = loss_fn(one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        loss = loss_fn(one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        loss = loss_fn(one_hot_logits(1 - target, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
