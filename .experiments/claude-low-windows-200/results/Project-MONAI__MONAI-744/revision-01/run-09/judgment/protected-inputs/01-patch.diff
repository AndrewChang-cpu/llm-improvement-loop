+import unittest
+
+import torch
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _one_hot_logits(labels: torch.Tensor, num_classes: int) -> torch.Tensor:
+    """Return 1000 times the one-hot encoding of integer labels, channels first."""
+    onehot = torch.nn.functional.one_hot(labels.long(), num_classes=num_classes)
+    onehot = onehot.permute(0, -1, *range(1, labels.dim())).float()
+    return 1000.0 * onehot
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # correct logits, with and without the channel dimension in the target
+        loss = loss_fn(_one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+        loss = loss_fn(_one_hot_logits(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        # flipped logits
+        flipped = 1 - target
+        loss = loss_fn(_one_hot_logits(flipped, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        dist_matrix = torch.tensor([[0.0, 1.0], [1.0, 0.0]])
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss_fn = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        loss = loss_fn(_one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(loss.item(), 0.0, places=3)
+
+        loss = loss_fn(_one_hot_logits(1 - target, 2), target)
+        self.assertAlmostEqual(loss.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
