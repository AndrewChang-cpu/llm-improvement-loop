+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The Wasserstein Dice score discounts each voxel's true-positive contribution by the Wasserstein
+    distance between the predicted class distribution and the ground-truth label, using a class-distance
+    matrix. The per-class weighting follows the generalized Dice loss (Sudre, C. et. al. (2017) Generalised
+    Dice overlap as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017), i.e.
+    each class is weighted by the inverse of its volume.
+
+    The input is always treated as logits; softmax is applied over the class dimension.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of size C by C, as a 2D torch tensor or 2D numpy array.
+                It is max-normalized (divided by its maximum) unless its maximum is already 1.
+            reduction: {``"none"``, ``"mean"``, ``"sum"``}
+                Specifies the reduction to apply to the output. Defaults to ``"mean"``.
+
+                - ``"none"``: no reduction will be applied.
+                - ``"mean"``: the sum of the output will be divided by the number of elements in the output.
+                - ``"sum"``: the output will be summed.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        if torch.max(dist_matrix) != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance map W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities of shape B x C x N (softmax over the class dimension).
+            flat_target: integer class-index labels of shape B x N.
+
+        Returns:
+            per-voxel distances of shape B x N.
+        """
+        matrix = self.matrix.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # gather the row of the distance matrix for each voxel's label: B x N x C -> B x C x N
+        dist_per_class = matrix[flat_target].permute(0, 2, 1)
+        return torch.sum(dist_per_class * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes therefore have weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape B x N.
+
+        Returns:
+            per-sample, per-class weights of shape B x C.
+        """
+        counts = torch.sum(F.one_hot(flat_target, num_classes=self.num_classes), dim=1)
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights of shape B x C.
+            flat_target: integer class-index labels of shape B x N.
+            wasserstein_distance_map: per-voxel distances of shape B x N.
+
+        Returns:
+            per-sample generalized true positives of shape B.
+        """
+        alpha_per_voxel = alpha.gather(1, flat_target)
+        return torch.sum(alpha_per_voxel * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights of shape B x C.
+            flat_target: integer class-index labels of shape B x N.
+            wasserstein_distance_map: per-voxel distances of shape B x N.
+
+        Returns:
+            per-sample denominators of shape B.
+        """
+        alpha_per_voxel = alpha.gather(1, flat_target)
+        return torch.sum(alpha_per_voxel * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits of shape BCH[WD]; softmax is applied over the class dimension.
+            target: integer class-index labels of shape BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample loss 1 - (2 * TP_b + smooth) / (D_b + smooth), as a scalar tensor.
+            The reduction setting is stored but not applied here.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wasserstein_distance = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+
+        true_positive = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance)
+
+        score = (2.0 * true_positive + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
