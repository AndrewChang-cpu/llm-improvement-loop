+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalization of the Generalized Dice loss (Sudre, C. et al. (2017) Generalised Dice
+    overlap as a deep learning loss function for highly unbalanced segmentations. DLMIA 2017).
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution (softmax of the logits) and the ground-truth label, given a
+    class-distance matrix. The per-class weighting follows the generalized Dice loss (inverse volume).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D square class-distance matrix of shape (C, C), where C is the number of classes.
+                It can be a torch tensor or a numpy array. It is max-normalized to a maximum of 1 if needed.
+            reduction: the reduction mode, a ``LossReduction`` member or its string value. Defaults to ``"mean"``.
+                It is stored but does not change the returned value: the loss is always the batch mean.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction={reduction} is invalid. Valid options are: none, mean or sum.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_value = torch.max(dist_matrix)
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the voxel-wise Wasserstein distance map W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: class probabilities, shape (B, C, N).
+            flat_target: flattened class-index labels, shape (B, N).
+
+        Returns:
+            per-voxel distances, shape (B, N).
+        """
+        matrix = self.matrix.to(flat_proba.device)
+        # gather the rows of the distance matrix for each voxel's label: shape (B, N, C)
+        rows = matrix[flat_target]
+        probs = flat_proba.permute(0, 2, 1)
+        return torch.sum(rows * probs, dim=-1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels
+        of class c in sample b. Absent classes therefore get weight 1.
+
+        Args:
+            flat_target: flattened class-index labels, shape (B, N).
+
+        Returns:
+            per-sample, per-class weights, shape (B, C).
+        """
+        one_hot_target = torch.nn.functional.one_hot(flat_target, num_classes=self.num_classes)
+        volumes = torch.sum(one_hot_target, dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape (B, C).
+            flat_target: flattened class-index labels, shape (B, N).
+            wasserstein_distance_map: per-voxel distances W, shape (B, N).
+
+        Returns:
+            per-sample generalized true positives, shape (B,).
+        """
+        alpha_map = alpha.gather(1, flat_target)
+        return torch.sum(alpha_map * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape (B, C).
+            flat_target: flattened class-index labels, shape (B, N).
+            wasserstein_distance_map: per-voxel distances W, shape (B, N).
+
+        Returns:
+            per-sample denominators, shape (B,).
+        """
+        alpha_map = alpha.gather(1, flat_target)
+        return torch.sum(alpha_map * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the logits, shape should be BC[spatial], where C is the number of classes.
+            target: the class-index labels, shape should be B[spatial] or B1[spatial].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            the batch mean of the per-sample losses, as a scalar tensor.
+        """
+        batch = input.shape[0]
+        flat_input = input.reshape(batch, self.num_classes, -1)
+        flat_target = target.reshape(batch, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
