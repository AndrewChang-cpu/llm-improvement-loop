+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is based on the generalized Dice overlap of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    Each voxel's true-positive contribution is discounted by a Wasserstein distance between the
+    predicted class distribution and the ground-truth label, using a class-distance matrix.
+    The class weights follow the generalized Dice loss weighting (inverse volume).
+    The input is always treated as logits (softmax is applied over the class dimension).
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: a square 2D class-distance matrix, as a torch tensor or a numpy array. Its size must equal
+                the number of input channels. Entries are nonnegative. The matrix is divided by its maximum
+                entry when that maximum is not 1.
+            reduction: the reduction mode, stored on the loss object as its string value. Defaults to ``"mean"``.
+                The returned loss is the batch mean regardless of this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction is not a valid LossReduction value.
+
+        """
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        if torch.max(dist_matrix).item() != 1:
+            dist_matrix = dist_matrix / torch.max(dist_matrix)
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities, shape batch by classes by N.
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            per-voxel distances, shape batch by N.
+        """
+        matrix = self.matrix.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        rows = matrix[flat_target]  # batch by N by classes
+        return torch.sum(rows * flat_proba.permute(0, 2, 1), dim=2)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels labelled c in sample b. Absent classes get weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            alpha weights, shape batch by classes.
+        """
+        one_hot_target = F.one_hot(flat_target, self.num_classes)  # batch by N by classes
+        counts = torch.sum(one_hot_target, dim=1)  # batch by classes
+        return 1.0 / (counts.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: per-voxel distances, shape batch by N.
+
+        Returns:
+            per-sample true positives, shape batch.
+        """
+        alpha_v = torch.gather(alpha, 1, flat_target)  # batch by N
+        return torch.sum(alpha_v * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: per-voxel distances, shape batch by N.
+
+        Returns:
+            per-sample denominators, shape batch.
+        """
+        alpha_v = torch.gather(alpha, 1, flat_target)  # batch by N
+        return torch.sum(alpha_v * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: float logits, shape batch by classes by spatial dimensions.
+            target: integer class-index labels, shape batch by spatial dimensions or batch by 1 by spatial dimensions.
+            smooth: a small constant added to numerator and denominator to avoid nan.
+
+        Returns:
+            scalar tensor: the mean over the batch of ``1 - (2 * TP_b + smooth) / (D_b + smooth)``.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+        flat_proba = torch.softmax(flat_input, 1)
+
+        wd_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        tp = self.compute_generalized_true_positive(alpha, flat_target, wd_map)
+        denom = self.compute_denominator(alpha, flat_target, wd_map)
+
+        score = (2.0 * tp + smooth) / (denom + smooth)
+        loss = 1.0 - score
+        return torch.mean(loss)
+
+
