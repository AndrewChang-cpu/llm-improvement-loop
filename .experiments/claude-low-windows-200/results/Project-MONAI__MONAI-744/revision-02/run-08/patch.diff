+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def _class_first_onehot(target: torch.Tensor, num_classes: int) -> torch.Tensor:
+    """Build a class-first one-hot tensor from integer labels of shape (B, H, W)."""
+    return F.one_hot(target, num_classes).permute(0, 3, 1, 2).float()
+
+
+DIST_MATRIX = np.array([[0.0, 1.0], [1.0, 0.0]])
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = 1000.0 * _class_first_onehot(target, 2)
+        self.assertAlmostEqual(loss(logits, target).item(), 0.0, places=3)
+
+        # same target with an explicit channel dimension
+        self.assertAlmostEqual(loss(logits, target.unsqueeze(1)).item(), 0.0, places=3)
+
+        # flipped prediction
+        flipped = 1000.0 * _class_first_onehot(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros(1, 4, 4, dtype=torch.long)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=DIST_MATRIX)
+
+        logits = 1000.0 * _class_first_onehot(target, 2)
+        self.assertAlmostEqual(loss(logits, target).item(), 0.0, places=3)
+
+        flipped = 1000.0 * _class_first_onehot(1 - target, 2)
+        self.assertAlmostEqual(loss(flipped, target).item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
