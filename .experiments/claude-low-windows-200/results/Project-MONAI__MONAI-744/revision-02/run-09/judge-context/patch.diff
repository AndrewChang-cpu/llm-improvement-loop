+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation Using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    It is a generalization of the Dice score: each voxel's true-positive contribution is discounted
+    by the Wasserstein distance between the predicted class distribution and the ground-truth label,
+    using a class-distance matrix. The class weighting follows the generalized Dice loss:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits, and softmax is applied over the class dimension.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: 2D, square, C by C class-distance matrix with nonnegative entries, where C is the number
+                of classes. It can be a torch tensor or a numpy array. It is normalized by its maximum entry
+                if that maximum is not 1.
+            reduction: the reduction mode, stored on the parent loss. It accepts a ``LossReduction`` member or
+                its string value. Defaults to ``"mean"``. The returned loss is the batch mean regardless of
+                this setting.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: reduction is invalid, as reported by the shared ``LossReduction`` conversion.
+
+        """
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+
+        max_value = torch.max(dist_matrix)
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance map W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities of shape batch by classes by N, after softmax over classes.
+            flat_target: integer class-index labels of shape batch by N.
+
+        Returns:
+            per-voxel distances of shape batch by N.
+        """
+        matrix = self.matrix.to(flat_proba.device)
+        # rows of the distance matrix selected by each voxel's label: batch by N by classes
+        dist_per_class = matrix[flat_target].transpose(1, 2)
+        return torch.sum(dist_per_class * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-sample, per-class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the
+        number of voxels of class c in sample b. Absent classes receive weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape batch by N.
+
+        Returns:
+            alpha weights of shape batch by classes.
+        """
+        volumes = torch.sum(F.one_hot(flat_target, self.num_classes), dim=1)
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)) for each sample.
+
+        Args:
+            alpha: per-sample, per-class weights of shape batch by classes.
+            flat_target: integer class-index labels of shape batch by N.
+            wasserstein_distance_map: per-voxel distances of shape batch by N.
+
+        Returns:
+            per-sample true positives of shape batch.
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_per_voxel * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)) for each sample.
+
+        Args:
+            alpha: per-sample, per-class weights of shape batch by classes.
+            flat_target: integer class-index labels of shape batch by N.
+            wasserstein_distance_map: per-voxel distances of shape batch by N.
+
+        Returns:
+            per-sample denominators of shape batch.
+        """
+        alpha_per_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_per_voxel * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: the shape should be BCH[WD], raw logits.
+            target: the shape should be BH[WD] or B1H[WD], integer class-index labels.
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean of the per-sample losses over the batch.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)
+        flat_target = target.reshape(target.shape[0], -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positives = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * true_positives + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
