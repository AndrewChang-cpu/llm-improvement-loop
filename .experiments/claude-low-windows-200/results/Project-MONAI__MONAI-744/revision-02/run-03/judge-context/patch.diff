+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class Segmentation
+        using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    The overlap score discounts the true-positive contribution of each voxel by the Wasserstein distance between
+    the predicted class distribution and the ground-truth label, computed from a class-distance matrix. The
+    per-class weighting follows the generalized Dice loss:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. MICCAI DLMIA 2017.
+
+    The input is always treated as raw logits; softmax is applied over the class dimension. The returned loss is
+    the batch mean.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[np.ndarray, torch.Tensor],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square class-distance matrix of size C by C, where C is the number of classes. It can be
+                a 2D torch tensor or a 2D numpy array with nonnegative entries. It is divided by its maximum entry
+                when that maximum is not 1.
+            reduction: the reduction mode, as a ``LossReduction`` member or its string value. Defaults to ``"mean"``.
+                It is stored and passed to the parent class, but it does not change the returned value: the loss
+                is always the batch mean, regardless of the reduction mode.
+
+        Raises:
+            ValueError: Dist Matrix is invalid.
+            ValueError: the reduction value is not a valid ``LossReduction`` value.
+
+        """
+        if len(dist_matrix.shape) != 2 or dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        max_value = torch.max(dist_matrix).item()
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W(v) = sum_k M[y(v), k] * p_k(v), where y(v) is the ground-truth
+        label of voxel v, M is the class-distance matrix and p_k(v) is the probability of class k at voxel v.
+
+        Args:
+            flat_proba: softmax probabilities, shape batch by classes by N.
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            per-voxel Wasserstein distances, shape batch by N.
+        """
+        dist_matrix = self.matrix.to(device=flat_proba.device, dtype=flat_proba.dtype)
+        # row M[y(v), :] for every voxel, shape batch by N by classes
+        dist_rows = dist_matrix[flat_target]
+        return torch.sum(dist_rows.permute(0, 2, 1) * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the number of voxels with label c
+        in sample b. A class absent from a sample has weight 1.
+
+        Args:
+            flat_target: integer class-index labels, shape batch by N.
+
+        Returns:
+            per-sample, per-class weights alpha, shape batch by classes.
+        """
+        one_hot_target = F.one_hot(flat_target, num_classes=self.num_classes)
+        volumes = torch.sum(one_hot_target, dim=1).float()
+        return 1.0 / (volumes + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)) for each sample b.
+
+        Args:
+            alpha: per-sample, per-class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: per-voxel Wasserstein distances, shape batch by N.
+
+        Returns:
+            per-sample generalized true positives, shape batch.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_voxel * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)) for each sample b.
+
+        Args:
+            alpha: per-sample, per-class weights, shape batch by classes.
+            flat_target: integer class-index labels, shape batch by N.
+            wasserstein_distance_map: per-voxel Wasserstein distances, shape batch by N.
+
+        Returns:
+            per-sample denominators, shape batch.
+        """
+        alpha_voxel = torch.gather(alpha, 1, flat_target)
+        return torch.sum(alpha_voxel * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BCH[WD].
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor: the batch mean of ``1 - (2 * TP + smooth) / (D + smooth)``.
+
+        """
+        batch_size, num_classes = input.shape[0], input.shape[1]
+        flat_input = input.reshape(batch_size, num_classes, -1)
+        flat_target = target.reshape(batch_size, -1)
+
+        flat_proba = torch.softmax(flat_input, dim=1)
+        wasserstein_distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        generalized_tp = self.compute_generalized_true_positive(alpha, flat_target, wasserstein_distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, wasserstein_distance_map)
+
+        score = (2.0 * generalized_tp + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
 dice = Dice = DiceLoss
 generalized_dice = GeneralizedDiceLoss
+generalized_wasserstein_dice = GeneralizedWassersteinDiceLoss
