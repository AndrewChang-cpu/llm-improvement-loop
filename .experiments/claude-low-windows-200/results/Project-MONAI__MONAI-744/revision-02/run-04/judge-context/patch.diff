+import unittest
+
+import numpy as np
+import torch
+import torch.nn.functional as F
+
+from monai.losses import GeneralizedWassersteinDiceLoss
+
+
+def one_hot_logits(target, num_classes):
+    """Build class-first logits equal to 1000 times the one-hot of an integer label map of shape (B, H, W)."""
+    one_hot = F.one_hot(target, num_classes)  # B, H, W, C
+    return 1000.0 * one_hot.permute(0, 3, 1, 2).float()  # B, C, H, W
+
+
+class TestGeneralizedWassersteinDiceLoss(unittest.TestCase):
+    def test_binary_2d(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        target[:, 1:3, 1:3] = 1
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        # perfect prediction (no channel dim, then with channel dim)
+        result = loss.forward(one_hot_logits(target, 2), target)
+        self.assertEqual(result.dim(), 0)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+        result = loss.forward(one_hot_logits(target, 2), target.unsqueeze(1))
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        # flipped prediction
+        result = loss.forward(one_hot_logits(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+    def test_empty_class(self):
+        target = torch.zeros((1, 4, 4), dtype=torch.long)
+        dist_matrix = np.array([[0.0, 1.0], [1.0, 0.0]], dtype=np.float32)
+        loss = GeneralizedWassersteinDiceLoss(dist_matrix=dist_matrix)
+
+        result = loss.forward(one_hot_logits(target, 2), target)
+        self.assertAlmostEqual(result.item(), 0.0, places=3)
+
+        result = loss.forward(one_hot_logits(1 - target, 2), target)
+        self.assertAlmostEqual(result.item(), 1.0, places=3)
+
+
+if __name__ == "__main__":
+    unittest.main()
