+class GeneralizedWassersteinDiceLoss(_Loss):
+    """
+    Compute the generalized Wasserstein Dice loss defined in:
+
+        Fidon, L. et. al. (2017) Generalised Wasserstein Dice Score for Imbalanced Multi-class
+        Segmentation using Holistic Convolutional Networks. MICCAI BrainLes 2017.
+
+    Each voxel's true-positive contribution is discounted by the Wasserstein distance between the
+    predicted class distribution and the ground-truth label, computed from a class-distance matrix.
+    The per-class weighting follows the generalized Dice loss of:
+
+        Sudre, C. et. al. (2017) Generalised Dice overlap as a deep learning
+        loss function for highly unbalanced segmentations. DLMIA 2017.
+
+    The input is always treated as logits and converted to probabilities with softmax over the class dimension.
+    The returned loss is the batch mean, regardless of the ``reduction`` setting.
+    """
+
+    def __init__(
+        self,
+        dist_matrix: Union[torch.Tensor, np.ndarray],
+        reduction: Union[LossReduction, str] = LossReduction.MEAN,
+    ) -> None:
+        """
+        Args:
+            dist_matrix: square 2D class-distance matrix of size C by C, where C is the number of classes.
+                It can be a torch tensor or a numpy array. The matrix is divided by its maximum entry
+                when that maximum is not 1.
+            reduction: the reduction mode, {``"none"``, ``"mean"``, ``"sum"``}, stored on the loss.
+                The returned loss of ``forward`` is always the batch mean, whatever the reduction is.
+
+        Raises:
+            ValueError: Dist Matrix is invalid. Raised when the distance matrix is not square.
+
+        """
+        if dist_matrix.shape[0] != dist_matrix.shape[1]:
+            raise ValueError("Dist Matrix is invalid.")
+        if isinstance(dist_matrix, np.ndarray):
+            dist_matrix = torch.from_numpy(dist_matrix)
+        max_value = torch.max(dist_matrix)
+        if max_value != 1:
+            dist_matrix = dist_matrix / max_value
+
+        super().__init__(reduction=LossReduction(reduction).value)
+
+        self.matrix = dist_matrix
+        self.num_classes = dist_matrix.shape[0]
+
+    def wasserstein_distance_map(self, flat_proba: torch.Tensor, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the per-voxel Wasserstein distance W(v) = sum_k M[y(v), k] * p_k(v).
+
+        Args:
+            flat_proba: probabilities of shape batch, classes, N.
+            flat_target: integer class-index labels of shape batch, N.
+
+        Returns:
+            per-voxel distances of shape batch, N.
+        """
+        dist = self.matrix.to(flat_proba.device)[flat_target]  # batch, N, classes
+        return torch.sum(dist.permute(0, 2, 1) * flat_proba, dim=1)
+
+    def compute_weights_generalized_true_positives(self, flat_target: torch.Tensor) -> torch.Tensor:
+        """
+        Compute the class weights alpha(b, c) = 1 / (V(b, c) + 1), where V(b, c) is the voxel count of class c
+        in sample b. Absent classes have weight 1.
+
+        Args:
+            flat_target: integer class-index labels of shape batch, N.
+
+        Returns:
+            per-sample, per-class weights of shape batch, classes.
+        """
+        one_hot_target = F.one_hot(flat_target, self.num_classes)  # batch, N, classes
+        volumes = torch.sum(one_hot_target, dim=1)  # batch, classes
+        return 1.0 / (volumes.float() + 1.0)
+
+    def compute_generalized_true_positive(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized true positives TP_b = sum_v alpha(b, y(v)) * (1 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights of shape batch, classes.
+            flat_target: integer class-index labels of shape batch, N.
+            wasserstein_distance_map: per-voxel distances of shape batch, N.
+
+        Returns:
+            per-sample generalized true positives of shape batch.
+        """
+        alpha_voxels = torch.gather(alpha, 1, flat_target)  # batch, N
+        return torch.sum(alpha_voxels * (1.0 - wasserstein_distance_map), dim=1)
+
+    def compute_denominator(
+        self, alpha: torch.Tensor, flat_target: torch.Tensor, wasserstein_distance_map: torch.Tensor
+    ) -> torch.Tensor:
+        """
+        Compute the generalized denominator D_b = sum_v alpha(b, y(v)) * (2 - W(v)).
+
+        Args:
+            alpha: per-sample, per-class weights of shape batch, classes.
+            flat_target: integer class-index labels of shape batch, N.
+            wasserstein_distance_map: per-voxel distances of shape batch, N.
+
+        Returns:
+            per-sample denominators of shape batch.
+        """
+        alpha_voxels = torch.gather(alpha, 1, flat_target)  # batch, N
+        return torch.sum(alpha_voxels * (2.0 - wasserstein_distance_map), dim=1)
+
+    def forward(self, input: torch.Tensor, target: torch.Tensor, smooth: float = 1e-5) -> torch.Tensor:
+        """
+        Args:
+            input: raw logits, the shape should be BCH[WD].
+            target: integer class-index labels, the shape should be BH[WD] or B1H[WD].
+            smooth: a small constant to avoid nan.
+
+        Returns:
+            scalar tensor, the mean of the per-sample losses over the batch.
+        """
+        flat_input = input.reshape(input.shape[0], input.shape[1], -1)  # batch, classes, N
+        flat_target = target.reshape(target.shape[0], -1)  # batch, N
+        flat_proba = torch.softmax(flat_input, 1)
+
+        distance_map = self.wasserstein_distance_map(flat_proba, flat_target)
+        alpha = self.compute_weights_generalized_true_positives(flat_target)
+        true_positives = self.compute_generalized_true_positive(alpha, flat_target, distance_map)
+        denominator = self.compute_denominator(alpha, flat_target, distance_map)
+
+        score = (2.0 * true_positives + smooth) / (denominator + smooth)
+        return torch.mean(1.0 - score)
+
+
