+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the model outputs of classification predictions into a CSV file, one row per item.
+    Results are kept in memory and written to disk when `finalize` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, default is the current directory.
+            filename (str): name of the CSV file, it must be a string ending with '.csv'.
+            overwrite (bool): if False, rows already present in an existing CSV file are loaded before writing.
+                Values loaded from the file replace in-memory values with the same key, and keys found only
+                in the file are appended after the in-memory keys.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = {}
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item, to be written by `finalize`.
+
+        Args:
+            data (Tensor or numpy array): the model output of one item.
+            meta_data (dict): optional meta data mapping. The key ``'filename_or_obj'`` is used as the row name.
+                If meta data is absent (None or an empty mapping), the item index is used as the row name.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._index)
+        self._cache[key] = np.asarray(data, dtype=np.float32)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches the values of every item along the first dimension of `batch_data`.
+
+        Args:
+            batch_data (Tensor or numpy array): the model outputs, the first dimension indexes items.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in
+                parallel with the batch. If meta data is absent (None or an empty mapping), the item index is used.
+        """
+        for i in range(len(batch_data)):
+            item_meta = None if not meta_data else {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file. Existing rows are loaded first when `overwrite` is False.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        os.makedirs(self.output_dir, exist_ok=True)
+        with open(self._filepath, 'w') as f:
+            for key, values in self._cache.items():
+                f.write(str(key))
+                for value in values.flatten():
+                    f.write(',' + str(value))
+                f.write('\n')
