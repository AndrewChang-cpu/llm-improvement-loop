+import os
+import tempfile
+import unittest
+
+import numpy as np
+import nibabel as nib
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            names = ['testfile' + str(i) for i in range(8)]
+            saver.save_batch(torch.zeros(8, 1, 2, 2), {'filename_or_obj': names})
+
+            for i in range(8):
+                filepath = os.path.join(tempdir, 'testfile' + str(i), 'testfile' + str(i) + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_no_meta_data_uses_item_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(np.zeros((2, 1, 2, 2), dtype=np.float32))
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '0', '0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '1', '1_seg.nii.gz')))
+
+    def test_empty_meta_data_uses_item_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(np.zeros((2, 1, 2, 2), dtype=np.float32), {})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '0', '0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, '1', '1_seg.nii.gz')))
+
+    def test_directory_part_is_dropped(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(np.zeros((1, 2, 2), dtype=np.float32), {'filename_or_obj': 'sub/case0.nii.gz'})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz')))
+            self.assertFalse(os.path.exists(os.path.join(tempdir, 'sub')))
+
+    def test_dtype_default_keeps_data_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'int_case'})
+
+            img = nib.load(os.path.join(tempdir, 'int_case', 'int_case_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.int32)
+
+    def test_dtype_set_is_written(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir, dtype=np.float32)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'float_case'})
+
+            img = nib.load(os.path.join(tempdir, 'float_case', 'float_case_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.float32)
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(batch_data=torch.zeros(1, 1, 2, 2), meta_data={'filename_or_obj': ['kw0']})
+            saver.save(data=torch.zeros(1, 2, 2), meta_data={'filename_or_obj': 'kw1'})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'kw0', 'kw0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'kw1', 'kw1_seg.nii.gz')))
+
+
+if __name__ == '__main__':
+    unittest.main()
