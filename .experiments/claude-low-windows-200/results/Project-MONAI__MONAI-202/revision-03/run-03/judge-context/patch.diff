+import glob
+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class RecordingSummaryWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images it is asked to write."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, *args, **kwargs):
+        self.image_tags.append(tag)
+        super().add_image(tag, *args, **kwargs)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=4)
+            writer.close()
+
+            self.assertTrue(len(glob.glob(os.path.join(tempdir, '*'))) > 0)
+
+    def test_three_dimensional_single_channel_tag(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingSummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, tag='input_0')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_three_dimensional_no_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingSummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, max_channels=0, tag='input_0')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, [])
+
+    def test_two_dimensional_tag(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = RecordingSummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 10, 10)), 0, writer, tag='output')
+            writer.close()
+
+            self.assertEqual(writer.image_tags, ['output_HW'])
+
+    def test_accepts_numpy_input(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10, 10)).numpy(), 0, writer)
+            writer.close()
+
+            self.assertTrue(len(glob.glob(os.path.join(tempdir, '*'))) > 0)
+
+
+if __name__ == '__main__':
+    unittest.main()
