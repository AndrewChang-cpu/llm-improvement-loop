+import os
+import csv
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            names = ['testfile' + str(i) for i in range(8)]
+            saver.save_batch(torch.zeros(8), {'filename_or_obj': names})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_no_meta_data_uses_item_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(3, 2))
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            self.assertEqual(len(rows[0]), 3)
+
+    def test_empty_meta_data_uses_item_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2), {})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1'])
+
+    def test_overwrite_false_merges_existing_rows(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,1.0\n')
+                f.write('C,3.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(np.array([0.0]), {'filename_or_obj': 'A'})
+            saver.save(np.array([2.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # A keeps its in-memory position but takes the file's value, B stays, C is appended from the file
+            self.assertEqual(rows, [['A', '1.0'], ['B', '2.0'], ['C', '3.0']])
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir, filename='keyword.csv')
+            saver.save_batch(batch_data=torch.zeros(2, 1), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.save(data=torch.ones(1), meta_data={'filename_or_obj': 'c'})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'keyword.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['a', 'b', 'c'])
+
+    def test_invalid_filename_raises(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
