                                           global_step)
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot the data of one item in a batch as 2D images or animated GIFs with SummaryWriter.
+
+    Args:
+        data (Tensor or numpy array): data in NCHW[D] layout, one item (selected by `index`) is plotted.
+        step (int): global step value to record.
+        writer (SummaryWriter): TensorBoard SummaryWriter to write to.
+        index (int): index of the item along the first dimension of `data` to plot.
+        max_channels (int): maximum number of channels to plot.
+        max_frames (int): number of frames of the animated GIF for 3D volumes.
+        tag (str): tag name of the written images, the plot type is appended to it as a suffix.
+    """
+    assert isinstance(writer, SummaryWriter), 'writer must be a SummaryWriter.'
+    if torch.is_tensor(data):
+        data = data.detach().cpu().numpy()
+    data = data[index]
+
+    if data.ndim == 2:
+        data = rescale_array(data, 0, 1)
+        writer.add_image('{}_HW'.format(tag), data, step, dataformats='HW')
+    elif data.ndim == 3:
+        if data.shape[0] == 3 and max_channels == 3:  # RGB
+            writer.add_image('{}_CHW'.format(tag), data, step, dataformats='CHW')
+        elif max_channels >= 1:
+            data = rescale_array(data[0], 0, 1)
+            writer.add_image('{}_HW_0'.format(tag), data, step, dataformats='HW')
+    elif data.ndim >= 4:
+        spatial = data.shape[-3:]
+        for j, d3 in enumerate(data.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
