+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta_data)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                reader = csv.reader(f)
+                i = 0
+                for row in reader:
+                    self.assertEqual(row[0], 'testfile' + str(i))
+                    self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+                    i += 1
+                self.assertEqual(i, 8)
+
+    def test_save_without_meta_data_uses_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(3), {})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                keys = [row[0] for row in csv.reader(f)]
+            self.assertEqual(keys, ['0', '1', '2'])
+
+    def test_keyword_arguments(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(data=np.array([1.0, 2.0]), meta_data={'filename_or_obj': 'single'})
+            saver.save_batch(batch_data=torch.zeros(2, 2), meta_data={'filename_or_obj': ['a', 'b']})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['single', 'a', 'b'])
+
+    def test_overwrite_false_merge(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            # first run writes keys A and C
+            first = CSVSaver(output_dir=tempdir, overwrite=True)
+            first.save(np.array([1.0]), {'filename_or_obj': 'A'})
+            first.save(np.array([2.0]), {'filename_or_obj': 'C'})
+            first.finalize()
+
+            # second run holds keys A and B in memory, A has a different value than the file
+            second = CSVSaver(output_dir=tempdir, overwrite=False)
+            second.save(np.array([0.0]), {'filename_or_obj': 'A'})
+            second.save(np.array([0.0]), {'filename_or_obj': 'B'})
+            second.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            # in-memory keys keep their order (A, B), file-only keys are appended (C),
+            # and the file value replaces the in-memory value for A
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 1.0)
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32), 0.0)
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 2.0)
+
+    def test_filename_must_be_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
