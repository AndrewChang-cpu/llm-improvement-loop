+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from tensorboard.backend.event_processing.event_accumulator import EventAccumulator
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+def _read_image_tags(log_dir):
+    accumulator = EventAccumulator(log_dir)
+    accumulator.Reload()
+    return accumulator.Tags()['images']
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=4, tag='output')
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_3d_single_channel_writes_channel_zero(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, tag='input_0')
+            writer.close()
+            tags = _read_image_tags(tempdir)
+            self.assertIn('input_0_HW_0', tags)
+            self.assertNotIn('input_0_HW', tags)
+
+    def test_3d_non_rgb_max_channels_zero_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 4, 10, 10)), 0, writer, max_channels=0, tag='input_0')
+            writer.close()
+            self.assertEqual(len(_read_image_tags(tempdir)), 0)
+
+    def test_index_selects_item(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            data = torch.zeros((2, 1, 10, 10))
+            data[1] = 1.0
+            plot_2d_or_3d_image(data, 0, writer, index=1, tag='output')
+            writer.close()
+            self.assertIn('output_HW_0', _read_image_tags(tempdir))
+
+    def test_non_writer_raises(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
