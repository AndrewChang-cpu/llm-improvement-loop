+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves per-item values (for example classification predictions) into a CSV file.
+    Values are cached in memory by key and written to disk when `finalize` is called.
+    The key of an item is its ``filename_or_obj`` meta data value when meta data is present,
+    otherwise the string form of the item index (a running counter kept by the saver).
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file content. If False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', \
+            'filename must be a string ending with .csv.'
+        self.output_dir = output_dir
+        self._cache_dict = OrderedDict()
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._data_index = 0
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file. If not overwriting and the file exists, the rows
+        in the file are merged into the cache first. Keys already in memory keep their position,
+        keys found only in the file are appended in file order.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item.
+
+        Args:
+            data (Tensor or numpy array): the values of one item.
+            meta_data (dict): optional mapping holding the key ``filename_or_obj``. If None or empty,
+                the key is the string form of the item index.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache_dict[key] = np.asarray(data, dtype=np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches the values of every item along the first dimension of `batch_data`.
+
+        Args:
+            batch_data (Tensor or numpy array): data whose first dimension indexes items.
+            meta_data (dict): optional mapping whose values are per-item sequences, indexed in parallel
+                with the batch. The key ``filename_or_obj`` is used for naming. If None or empty,
+                each item is named by its item index.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(data, item_meta)
