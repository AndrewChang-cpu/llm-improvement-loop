+import os
+import shutil
+import tempfile
+import unittest
+from unittest import mock
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        plot_2d_or_3d_image(torch.zeros(shape), step=0, writer=writer, max_channels=3, max_frames=4)
+        writer.flush()
+        writer.close()
+
+        self.assertTrue(os.path.exists(self.tempdir))
+        self.assertTrue(len(os.listdir(self.tempdir)) > 0)
+
+    def test_numpy_input_is_accepted(self):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        plot_2d_or_3d_image(np.zeros((1, 1, 10, 10)), step=0, writer=writer)
+        writer.close()
+
+        self.assertTrue(len(os.listdir(self.tempdir)) > 0)
+
+    def test_three_dimensional_non_rgb_writes_channel_zero_only(self):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        with mock.patch.object(writer, 'add_image') as add_image:
+            plot_2d_or_3d_image(torch.rand(1, 2, 10, 10), step=0, writer=writer, max_channels=1)
+        writer.close()
+
+        self.assertEqual(add_image.call_count, 1)
+        self.assertEqual(add_image.call_args[0][0], 'output_HW_0')
+
+    def test_index_selects_item(self):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        # item 0 is constant, item 1 varies, so the plotted image's maximum shows which item was selected
+        data = np.stack([np.zeros((10, 10)), np.arange(100).reshape(10, 10)])[:, None]  # shape (2, 1, 10, 10)
+        with mock.patch.object(writer, 'add_image') as add_image:
+            plot_2d_or_3d_image(data, step=0, writer=writer, index=1, tag='input_0')
+        writer.close()
+
+        self.assertEqual(add_image.call_count, 1)
+        self.assertEqual(add_image.call_args[0][0], 'input_0_HW')
+        self.assertEqual(np.max(add_image.call_args[0][1]), 1.0)
+
+
+if __name__ == '__main__':
+    unittest.main()
