+import os
+import shutil
+import tempfile
+import unittest
+import numpy as np
+import nibabel as nib
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASES = [
+    [(8, 1, 2, 2)],
+    [(8, 1, 2, 2, 2)],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_save_batch_with_meta(self, shape):
+        saver = NiftiSaver(output_dir=self.tempdir)
+        names = ['testfile' + str(i) for i in range(shape[0])]
+        saver.save_batch(torch.zeros(shape), {'filename_or_obj': names})
+
+        for n in names:
+            expected = os.path.join(self.tempdir, n, '{}_seg.nii.gz'.format(n))
+            self.assertTrue(os.path.exists(expected), expected)
+
+    def test_save_batch_without_meta_uses_index(self):
+        saver = NiftiSaver(output_dir=self.tempdir)
+        saver.save_batch(torch.zeros(3, 1, 2, 2))
+
+        for i in range(3):
+            expected = os.path.join(self.tempdir, str(i), '{}_seg.nii.gz'.format(i))
+            self.assertTrue(os.path.exists(expected), expected)
+
+    def test_directory_part_is_dropped(self):
+        saver = NiftiSaver(output_dir=self.tempdir)
+        saver.save(torch.zeros(1, 2, 2), {'filename_or_obj': os.path.join('sub', 'case0.nii.gz')})
+
+        expected = os.path.join(self.tempdir, 'case0', 'case0_seg.nii.gz')
+        self.assertTrue(os.path.exists(expected), expected)
+        self.assertFalse(os.path.exists(os.path.join(self.tempdir, 'sub')))
+
+    def test_dtype_default_keeps_data_dtype(self):
+        saver = NiftiSaver(output_dir=self.tempdir)
+        saver.save(torch.zeros(1, 2, 2, dtype=torch.int32), {'filename_or_obj': 'testfile0'})
+
+        img = nib.load(os.path.join(self.tempdir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(img.get_data_dtype(), np.int32)
+
+    def test_dtype_set_is_used(self):
+        saver = NiftiSaver(output_dir=self.tempdir, dtype=np.float32)
+        saver.save(torch.zeros(1, 2, 2, dtype=torch.int32), {'filename_or_obj': 'testfile0'})
+
+        img = nib.load(os.path.join(self.tempdir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(img.get_data_dtype(), np.float32)
+
+
+if __name__ == '__main__':
+    unittest.main()
