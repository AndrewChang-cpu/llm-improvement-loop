new file mode 100644
index 0000000..058ce3d
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,91 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the model outputs into a CSV file. Each item is cached under a key and the cache is written to
+    disk when ``finalize`` is called. The key is the ``filename_or_obj`` value from the meta data when it is given,
+    otherwise it is the string form of the item index.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file content. If not overwriting and the file
+                exists, its rows are loaded into the cache before the file is written again.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = {}
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item of data. The item is stored under the ``filename_or_obj`` value of ``meta_data``
+        if it is given, otherwise under the string form of the item index.
+
+        Args:
+            data (Tensor or ndarray): one item of model output, without the batch dimension.
+            meta_data (dict): meta data mapping, with the key ``filename_or_obj`` used as the key of the item.
+                If None, the item index is used as the key.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data is None:
+            key = str(self._data_index)
+        else:
+            key = meta_data['filename_or_obj']
+        self._cache_dict[key] = np.asarray(data, dtype=np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``batch_data``.
+
+        Args:
+            batch_data (Tensor or ndarray): a batch of model outputs, the first dimension indexes the items.
+            meta_data (dict): meta data mapping whose values are per-item sequences indexed in parallel with the
+                batch. The key ``filename_or_obj`` is used. If None, each item is saved without meta data.
+        """
+        for i, data in enumerate(batch_data):
+            meta_data_i = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, meta_data_i)
+
+    def finalize(self):
+        """
+        Writes the cached items to the CSV file, one line per key in insertion order. If not overwriting and the
+        file already exists, the rows in the file are loaded into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
diff --git a/monai/data/nifti_saver.py b/monai/data/nifti_saver.py
new file mode 100644
index 0000000..51970cc
--- /dev/null
+++ b/monai/data/nifti_saver.py
@@ -0,0 +1,117 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import numpy as np
+import torch
+from monai.data.nifti_writer import write_nifti
+
+
+class NiftiSaver:
+    """
+    Saves the model outputs as NIfTI files. Each item is written immediately when ``save`` or ``save_batch``
+    is called.
+    """
+
+    def __init__(self, output_dir='./', output_postfix='seg', output_ext='.nii.gz', dtype=None):
+        """
+        Args:
+            output_dir (str): output directory to save the NIfTI files, defaults to the current directory.
+            output_postfix (str): a string appended to the output file base name.
+            output_ext (str): output file extension name.
+            dtype (np.dtype, optional): data type to write. If None, the data's own dtype is kept.
+        """
+        self.output_dir = output_dir
+        self.output_postfix = output_postfix
+        self.output_ext = output_ext
+        self.dtype = dtype
+        self._data_index = 0
+
+    @staticmethod
+    def _create_file_basename(postfix, input_file_name, folder_path, data_root_dir=""):
+        """
+        Utility function to create the path to the output file based on the input
+        filename (extension is added by lib level writer before writing the file)
+
+        Args:
+            postfix (str): output name's postfix
+            input_file_name (str): path to the input image file
+            folder_path (str): path for the output file
+            data_root_dir (str): if not empty, it specifies the beginning parts of the input file's
+                absolute path. This is used to compute `input_file_rel_path`, the relative path to the file from
+                `data_root_dir` to preserve folder structure when saving in case there are files in different
+                folders with the same file names.
+        """
+
+        # get the filename and directory
+        filedir, filename = os.path.split(input_file_name)
+
+        # jettison the extension to have just filename
+        filename, ext = os.path.splitext(filename)
+        while ext != "":
+            filename, ext = os.path.splitext(filename)
+
+        # use data_root_dir to find relative path to file
+        filedir_rel_path = ""
+        if data_root_dir:
+            filedir_rel_path = os.path.relpath(filedir, data_root_dir)
+
+        # sub-folder path will be original name without the extension
+        subfolder_path = os.path.join(folder_path, filedir_rel_path, filename)
+        if not os.path.exists(subfolder_path):
+            os.makedirs(subfolder_path)
+
+        # add the sub-folder plus the postfix name to become the file basename in the output path
+        return os.path.join(subfolder_path, filename + "_" + postfix)
+
+    def save(self, data, meta_data=None):
+        """
+        Writes one item of data as a NIfTI file.
+
+        Args:
+            data (Tensor or ndarray): one item of data in channel-first layout (channels, spatial dims...).
+            meta_data (dict): meta data mapping. The key ``filename_or_obj`` gives the output file base name,
+                ``affine`` and ``original_affine`` are optional and used for the output affine. If None, the
+                item index is used as the file base name and no affine is given.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+
+        if meta_data is None:
+            base_name = str(self._data_index)
+            affine = None
+            original_affine = None
+        else:
+            base_name = meta_data['filename_or_obj']
+            affine = meta_data.get('affine', None)
+            original_affine = meta_data.get('original_affine', None)
+        self._data_index += 1
+
+        output_filename = self._create_file_basename(self.output_postfix, base_name, self.output_dir)
+        output_filename = '{}{}'.format(output_filename, self.output_ext)
+        # change output to "channel last" format and write to nifti format file
+        to_save = np.moveaxis(data, 0, -1)
+        dtype = data.dtype if self.dtype is None else self.dtype
+        write_nifti(to_save, affine, output_filename, original_affine, dtype=dtype)
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Writes every item along the first dimension of ``batch_data`` as a NIfTI file.
+
+        Args:
+            batch_data (Tensor or ndarray): a batch of data, the first dimension indexes the items.
+            meta_data (dict): meta data mapping whose values are per-item sequences indexed in parallel with the
+                batch. The keys ``filename_or_obj``, ``affine`` and ``original_affine`` are used. If None, each
+                item is saved without meta data and is named by its item index.
+        """
+        for i, data in enumerate(batch_data):
+            meta_data_i = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, meta_data_i)
