+
+import os
+import csv
+import shutil
+import tempfile
+import unittest
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return list(csv.reader(f))
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def test_save_batch_content(self):
+        saver = CSVSaver(output_dir=self.tempdir)
+        saver.save_batch(torch.zeros(8), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+        saver.finalize()
+
+        filepath = os.path.join(self.tempdir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        rows = _read_rows(filepath)
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_save_without_meta_uses_index(self):
+        saver = CSVSaver(output_dir=self.tempdir)
+        saver.save_batch(torch.zeros(3))
+        saver.finalize()
+
+        rows = _read_rows(os.path.join(self.tempdir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+
+    def test_save_replaces_same_key(self):
+        saver = CSVSaver(output_dir=self.tempdir)
+        saver.save(torch.zeros(2), {'filename_or_obj': 'a'})
+        saver.save(torch.ones(2), {'filename_or_obj': 'b'})
+        saver.save(torch.full((2,), 3.0), {'filename_or_obj': 'a'})
+        saver.finalize()
+
+        rows = _read_rows(os.path.join(self.tempdir, 'predictions.csv'))
+        self.assertEqual([row[0] for row in rows], ['a', 'b'])
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [3.0, 3.0])
+
+    def test_overwrite_false_keeps_existing_rows(self):
+        first = CSVSaver(output_dir=self.tempdir)
+        first.save_batch(torch.zeros(3), {'filename_or_obj': ['testfile0', 'testfile1', 'testfile2']})
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.tempdir, overwrite=False)
+        second.save(torch.ones(1), {'filename_or_obj': 'testfile0'})
+        second.save(torch.full((1,), 2.0), {'filename_or_obj': 'testfile5'})
+        second.finalize()
+
+        rows = {row[0]: np.array(row[1:]).astype(np.float32).tolist() for row in
+                _read_rows(os.path.join(self.tempdir, 'predictions.csv'))}
+        self.assertEqual(set(rows.keys()), {'testfile0', 'testfile1', 'testfile2', 'testfile5'})
+        # values in the file replace the in-memory values with the same key
+        self.assertEqual(rows['testfile0'], [0.0])
+        self.assertEqual(rows['testfile5'], [2.0])
+
+    def test_finalize_creates_output_dir(self):
+        output_dir = os.path.join(self.tempdir, 'nested', 'out')
+        saver = CSVSaver(output_dir=output_dir)
+        saver.save(torch.zeros(1), {'filename_or_obj': 'testfile0'})
+        saver.finalize()
+        self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+    def test_filename_must_be_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir=self.tempdir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
