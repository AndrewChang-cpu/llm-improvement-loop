 def _image3_animated_gif(imp, scale_factor=1):
@@ -126,3 +129,48 @@ def add_animated_gif_no_channels(writer, tag, image_tensor, max_out, scale_facto
                                                                     max_out=max_out, animation_axes=[1],
                                                                     image_axes=[2, 3], scale_factor=scale_factor),
                                           global_step)
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot 2D or 3D image on the TensorBoard. 2D data is written as a single image. 3D data is written as one RGB
+    image when it has 3 channels and ``max_channels`` is 3, otherwise only the first channel is written. Data with
+    4 or more dimensions is written as animated GIFs along the last spatial axis, one per channel up to
+    ``max_channels``.
+
+    Args:
+        data (Tensor or ndarray): data in NCHW[D] layout, the item at ``index`` is plotted.
+        step (int): global step value to record.
+        writer (SummaryWriter): TensorBoard SummaryWriter to write to.
+        index (int): index of the item along the first dimension to plot.
+        max_channels (int): number of channels to plot.
+        max_frames (int): number of frames for the animated GIF plot.
+        tag (str): tag of the plotted data, the output tag is suffixed by the plot type.
+    """
+    assert isinstance(writer, SummaryWriter), 'writer must be SummaryWriter.'
+    if torch.is_tensor(data):
+        data = data.detach().cpu().numpy()
+    d = data[index]
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+        return
+
+    if d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            dataformats = 'CHW'
+            writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+            return
+        d2 = rescale_array(d[0], 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}_0'.format(tag, dataformats), d2, step, dataformats=dataformats)
+        return
+
+    if d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
+        return
