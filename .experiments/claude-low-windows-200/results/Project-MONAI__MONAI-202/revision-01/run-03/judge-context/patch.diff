+# limitations under the License.
+
+import os
+
+import numpy as np
+import torch
+
+from monai.data.nifti_writer import write_nifti
+
+
+class NiftiSaver:
+    """
+    Saves data items as NIfTI files, each item written immediately. Files are placed at
+    ``output_dir/<base name>/<base name>_<output_postfix><output_ext>``, where the base name is taken from the
+    input filename with its directory and all extensions removed. This class does not depend on ignite and does
+    not take an engine object.
+
+    Args:
+        output_dir (str): output directory to save the NIfTI files, defaults to the current directory.
+        output_postfix (str): a string appended to all output file names.
+        output_ext (str): output file extension name.
+        dtype (numpy.dtype): data type to write. If None, the data's own dtype is kept.
+    """
+
+    def __init__(self, output_dir='./', output_postfix='seg', output_ext='.nii.gz', dtype=None):
+        self.output_dir = output_dir
+        self.output_postfix = output_postfix
+        self.output_ext = output_ext
+        self.dtype = dtype
+        self._index = 0
+
+    @staticmethod
+    def _create_file_basename(postfix, input_file_name, output_folder, data_root_dir=''):
+        """
+        Utility function to create the path to the output file based on the input
+        filename (extension is added by the caller before writing the file).
+
+        Args:
+            postfix (str): output name's postfix.
+            input_file_name (str): path to the input image file.
+            output_folder (str): path for the output file.
+            data_root_dir (str): if not empty, it specifies the beginning parts of the input file's
+                absolute path. It is used to compute the relative path to the file from ``data_root_dir``
+                so that the folder structure is preserved.
+        """
+        # get the filename and directory
+        filedir, filename = os.path.split(input_file_name)
+
+        # jettison the extension to have just filename
+        filename, ext = os.path.splitext(filename)
+        while ext != '':
+            filename, ext = os.path.splitext(filename)
+
+        # use data_root_dir to find relative path to file
+        filedir_rel_path = ''
+        if data_root_dir:
+            filedir_rel_path = os.path.relpath(filedir, data_root_dir)
+
+        # sub-folder path will be original name without the extension
+        subfolder_path = os.path.join(output_folder, filedir_rel_path, filename)
+        os.makedirs(subfolder_path, exist_ok=True)
+
+        # add the sub-folder plus the postfix name to become the file basename in the output path
+        return os.path.join(subfolder_path, filename + '_' + postfix)
+
+    def save(self, data, meta_data=None):
+        """
+        Writes one item to a NIfTI file.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): one item, channel-first (channels, then spatial dimensions).
+            meta_data (dict): optional meta data mapping. Keys used are ``'filename_or_obj'`` (required when the
+                mapping is given, used for naming), ``'affine'`` (optional output affine) and
+                ``'original_affine'`` (optional). If None, the item index string is used as the base name, and no
+                affine is given.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+
+        if meta_data is None:
+            input_name = str(self._index)
+            affine = None
+            original_affine = None
+        else:
+            input_name = meta_data['filename_or_obj']
+            affine = meta_data.get('affine', None)
+            original_affine = meta_data.get('original_affine', None)
+        affine = affine.detach().cpu().numpy() if isinstance(affine, torch.Tensor) else affine
+        original_affine = original_affine.detach().cpu().numpy() \
+            if isinstance(original_affine, torch.Tensor) else original_affine
+
+        output_filename = self._create_file_basename(self.output_postfix, input_name, self.output_dir)
+        output_filename = '{}{}'.format(output_filename, self.output_ext)
+        dtype = data.dtype if self.dtype is None else self.dtype
+
+        # change output to "channel last" format and write to nifti format file
+        to_save = np.moveaxis(data, 0, -1)
+        write_nifti(to_save, affine, output_filename, original_affine, dtype=dtype)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Writes every item along the first dimension of ``batch_data`` to its own NIfTI file.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): data whose first dimension indexes the items.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in
+                parallel with the batch. If None, every item is saved using the item index as its base name.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta)
