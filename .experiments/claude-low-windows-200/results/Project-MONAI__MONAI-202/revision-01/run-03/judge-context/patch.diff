+import os
+import tempfile
+import unittest
+
+import torch
+from ignite.engine import Engine
+from parameterized import parameterized
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+TEST_CASES = [
+    [(8, 1, 2, 2)],
+    [(8, 1, 2, 2, 2)],
+]
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_saved_files(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            def _train_func(engine, batch):
+                return torch.zeros(shape)
+
+            engine = Engine(_train_func)
+            saver = SegmentationSaver(output_dir=tempdir, output_postfix='seg', output_ext='.nii.gz')
+            saver.attach(engine)
+
+            data = [{'filename_or_obj': ['testfile' + str(i) for i in range(shape[0])]}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            for i in range(shape[0]):
+                name = 'testfile' + str(i)
+                self.assertTrue(os.path.exists(os.path.join(tempdir, name, name + '_seg.nii.gz')))
+
+    def test_batch_transform_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            def _train_func(engine, batch):
+                return torch.zeros((2, 1, 2, 2))
+
+            engine = Engine(_train_func)
+            saver = SegmentationSaver(output_dir=tempdir, batch_transform=lambda x: x[0])
+            saver.attach(engine)
+
+            data = [({'filename_or_obj': ['case0.nii.gz', 'case1.nii.gz']},)]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz')))
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case1', 'case1_seg.nii.gz')))
+
+
+if __name__ == '__main__':
+    unittest.main()
