+import os
+import tempfile
+import unittest
+
+import numpy as np
+import nibabel as nib
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASES = [
+    [(8, 1, 2, 2)],
+    [(2, 1, 4, 4, 4)],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_save_batch_with_meta(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            names = ['testfile' + str(i) for i in range(shape[0])]
+            saver.save_batch(torch.zeros(shape), {'filename_or_obj': names})
+
+            for name in names:
+                filepath = os.path.join(tempdir, name, name + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_save_batch_without_meta_uses_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 1, 2, 2))
+
+            for i in range(2):
+                self.assertTrue(os.path.exists(os.path.join(tempdir, str(i), str(i) + '_seg.nii.gz')))
+
+    def test_directory_part_is_dropped(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(torch.zeros(1, 2, 2), {'filename_or_obj': 'sub/case0.nii.gz'})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz')))
+            self.assertFalse(os.path.exists(os.path.join(tempdir, 'sub')))
+
+    def test_dtype_default_keeps_data_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'case0.nii.gz'})
+
+            img = nib.load(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz'))
+            self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+
+    def test_dtype_set_overrides_data_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir, dtype=np.float32)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'case0.nii.gz'})
+
+            img = nib.load(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz'))
+            self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.float32))
+
