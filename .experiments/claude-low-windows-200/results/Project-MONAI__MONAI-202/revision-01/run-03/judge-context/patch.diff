+import os
+import csv
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_save_batch_with_meta(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta_data = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta_data)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_save_batch_without_meta(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir, filename='out.csv')
+            saver.save_batch(torch.zeros(3, 2))
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'out.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            for row in rows:
+                self.assertEqual(len(row), 3)
+
+    def test_overwrite_false_merges_existing_file(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            first = CSVSaver(output_dir=tempdir)
+            first.save(torch.ones(2), {'filename_or_obj': 'testfile0'})
+            first.finalize()
+
+            second = CSVSaver(output_dir=tempdir, overwrite=False)
+            second.save(torch.zeros(2), {'filename_or_obj': 'testfile0'})
+            second.save(torch.zeros(2), {'filename_or_obj': 'testfile1'})
+            second.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['testfile0', 'testfile1'])
+            # the value read from the existing file replaces the in-memory value
+            np.testing.assert_array_equal(np.array(rows[0][1:]).astype(np.float32), [1.0, 1.0])
+            np.testing.assert_array_equal(np.array(rows[1][1:]).astype(np.float32), [0.0, 0.0])
+
+    def test_creates_output_directory(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            output_dir = os.path.join(tempdir, 'nested', 'dir')
+            saver = CSVSaver(output_dir=output_dir)
+            saver.save(torch.zeros(1), {'filename_or_obj': 'testfile0'})
+            saver.finalize()
+            self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+    def test_filename_must_end_with_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
