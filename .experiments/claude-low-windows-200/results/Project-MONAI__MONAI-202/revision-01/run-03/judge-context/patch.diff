--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,94 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves classification-style predictions into a CSV file. Each item is cached in memory under a key, and
+    the cache is written to ``os.path.join(output_dir, filename)`` when ``finalize`` is called.
+    This class does not depend on ignite and does not take an engine object.
+
+    Args:
+        output_dir (str): output directory to save the CSV file, defaults to the current directory.
+        filename (str): name of the CSV file, must be a string ending with '.csv'.
+        overwrite (bool): whether to overwrite the existing CSV file content. If False and the file exists,
+            the rows already in the file are read back into the cache, and their values replace in-memory
+            values with the same key.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of one item.
+            meta_data (dict): optional meta data mapping. If given, the key is the value of ``'filename_or_obj'``.
+                If None, the key is the string form of the item index, which starts at zero and advances by one
+                on every save.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        if meta_data is None:
+            key = str(self._index)
+        else:
+            key = meta_data['filename_or_obj']
+        self._cache[key] = np.array(data, dtype=np.float32)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches the values of every item along the first dimension of ``batch_data``.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): data whose first dimension indexes the items.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in
+                parallel with the batch. If None, every item is saved without meta data.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta)
+
+    def finalize(self, _engine=None):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order, with no header row.
+        If ``overwrite`` is False and the file exists, its rows are merged into the cache first.
+
+        Args:
+            _engine: unused, accepted so the method can be registered directly as an event handler.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        os.makedirs(self.output_dir, exist_ok=True)
+        with open(self._filepath, 'w') as f:
+            for key, values in self._cache.items():
+                f.write(str(key))
+                for value in values.flatten():
+                    f.write(',' + str(value))
+                f.write('\n')
diff --git a/monai/data/nifti_saver.py b/monai/data/nifti_saver.py
