+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def _run(self, output, saver_kwargs=None):
+        def _train_func(engine, batch):
+            return output
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_dir=self.tmp_dir, **(saver_kwargs or {}))
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+    def test_saved_files(self):
+        self._run(torch.zeros(8, 1, 2, 2))
+
+        for i in range(8):
+            name = 'testfile' + str(i)
+            path = os.path.join(self.tmp_dir, name, '{}_seg.nii.gz'.format(name))
+            self.assertTrue(os.path.exists(path))
+
+    def test_integer_output_keeps_dtype(self):
+        self._run(torch.zeros(8, 1, 2, 2, dtype=torch.int32))
+
+        img = nib.load(os.path.join(self.tmp_dir, 'testfile0', 'testfile0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+
+
+if __name__ == '__main__':
+    unittest.main()
