+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def test_saved_content(self):
+        saver = CSVSaver(output_dir=self.tmp_dir)
+        meta = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+        saver.save_batch(torch.zeros(8), meta)
+        saver.finalize()
+
+        filepath = os.path.join(self.tmp_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_no_meta_uses_item_index(self):
+        saver = CSVSaver(output_dir=self.tmp_dir)
+        saver.save_batch(torch.zeros(3, 2))
+        saver.finalize()
+
+        with open(os.path.join(self.tmp_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+        self.assertEqual(len(rows[0]), 3)
+
+    def test_save_same_key_replaces_value(self):
+        saver = CSVSaver(output_dir=self.tmp_dir)
+        saver.save(torch.tensor([1.0]), {'filename_or_obj': 'a'})
+        saver.save(torch.tensor([2.0]), {'filename_or_obj': 'b'})
+        saver.save(torch.tensor([3.0]), {'filename_or_obj': 'a'})
+        saver.finalize()
+
+        with open(os.path.join(self.tmp_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(rows, [['a', '3.0'], ['b', '2.0']])
+
+    def test_no_overwrite_keeps_file_rows(self):
+        filepath = os.path.join(self.tmp_dir, 'predictions.csv')
+        with open(filepath, 'w') as f:
+            f.write('testfile0,1.0\n')
+
+        saver = CSVSaver(output_dir=self.tmp_dir, overwrite=False)
+        saver.save(torch.tensor([0.0]), {'filename_or_obj': 'testfile0'})
+        saver.save(torch.tensor([0.0]), {'filename_or_obj': 'testfile1'})
+        saver.finalize()
+
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(rows, [['testfile0', '1.0'], ['testfile1', '0.0']])
+
+    def test_filename_must_end_with_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir=self.tmp_dir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
