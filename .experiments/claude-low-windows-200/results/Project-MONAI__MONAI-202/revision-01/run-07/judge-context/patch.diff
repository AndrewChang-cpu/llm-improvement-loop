 def _image3_animated_gif(imp, scale_factor=1):
@@ -126,3 +130,39 @@ def add_animated_gif_no_channels(writer, tag, image_tensor, max_out, scale_facto
                                                                     max_out=max_out, animation_axes=[1],
                                                                     image_axes=[2, 3], scale_factor=scale_factor),
                                           global_step)
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot one item of a batch of 2D or 3D images to TensorBoard. 2D items are written as a single image,
+    3D items as a single image (RGB when there are 3 channels and `max_channels` is 3, otherwise the first channel),
+    and items with four or more dimensions as animated GIFs along the last spatial axis, one per volume.
+
+    Args:
+        data (Tensor or ndarray): batch in NCHW[D] layout, the item at `index` is plotted.
+        step (int): global step value to record.
+        writer (SummaryWriter): TensorBoard SummaryWriter to write to.
+        index (int): index of the item in the batch to plot.
+        max_channels (int): maximum number of channels or volumes to plot.
+        max_frames (int): number of frames for the animated GIF.
+        tag (str): data identifier, used as the prefix of the tag.
+    """
+    assert isinstance(writer, SummaryWriter), 'writer must be a SummaryWriter'
+    if torch.is_tensor(data):
+        data = data.detach().cpu().numpy()
+    d = data[index]
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        writer.add_image('{}_HW'.format(tag), d, step, dataformats='HW')
+    elif d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            writer.add_image('{}_CHW'.format(tag), d, step, dataformats='CHW')
+        else:
+            d2 = rescale_array(d[0], 0, 1)
+            writer.add_image('{}_HW_0'.format(tag), d2, step, dataformats='HW')
+    elif d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
