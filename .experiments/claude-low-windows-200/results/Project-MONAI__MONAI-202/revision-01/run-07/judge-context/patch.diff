new file mode 100644
index 0000000..dc057d9
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,93 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves items (for example classification predictions) into a CSV file. Results are cached in memory
+    and written to disk when `finalize` is called.
+
+    Each item is stored under a key: the ``filename_or_obj`` value of the meta data when meta data is given,
+    otherwise the string form of the item index. The item index counts every single-item save, including the
+    items of a batch.
+
+    Args:
+        output_dir (str): output directory to save the CSV file, defaults to the current directory.
+        filename (str): name of the CSV file, must be a string ending with '.csv'.
+        overwrite (bool): if False and the file already exists, the rows in the file are loaded into the cache
+            before writing, and the in-memory values replace file values with the same key.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item.
+
+        Args:
+            data (Tensor or ndarray): one item, its values are stored as float32.
+            meta_data (dict): optional meta data mapping. The key ``'filename_or_obj'`` gives the name of the item.
+                If None, the name is the string form of the item index.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data is None:
+            key = str(self._index)
+        else:
+            key = meta_data['filename_or_obj']
+        self._cache[key] = np.asarray(data).astype(np.float32)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of `batch_data`.
+
+        Args:
+            batch_data (Tensor or ndarray): a batch of items, the first dimension indexes the items.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in
+                parallel with the batch. See `save` for the keys used. If None, each item uses no meta data.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached items to the CSV file, one line per key in insertion order, with no header row.
+        If `overwrite` is False and the file exists, its rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
diff --git a/monai/data/nifti_saver.py b/monai/data/nifti_saver.py
