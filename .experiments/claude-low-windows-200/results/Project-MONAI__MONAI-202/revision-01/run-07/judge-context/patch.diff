+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_DTYPE_CASES = [
+    [None, np.int32],
+    [np.float32, np.float32],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tmp_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tmp_dir, ignore_errors=True)
+
+    def test_batch_with_meta(self):
+        saver = NiftiSaver(output_dir=self.tmp_dir)
+        meta = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+        saver.save_batch(torch.zeros(8, 1, 2, 2), meta)
+
+        for i in range(8):
+            name = 'testfile' + str(i)
+            path = os.path.join(self.tmp_dir, name, '{}_seg.nii.gz'.format(name))
+            self.assertTrue(os.path.exists(path))
+
+    def test_no_meta_uses_item_index(self):
+        saver = NiftiSaver(output_dir=self.tmp_dir)
+        saver.save_batch(np.zeros((2, 1, 2, 2)))
+
+        for i in range(2):
+            path = os.path.join(self.tmp_dir, str(i), '{}_seg.nii.gz'.format(i))
+            self.assertTrue(os.path.exists(path))
+
+    def test_directory_part_is_dropped(self):
+        saver = NiftiSaver(output_dir=self.tmp_dir)
+        saver.save(np.zeros((1, 2, 2)), {'filename_or_obj': 'sub/case0.nii.gz'})
+
+        self.assertTrue(os.path.exists(os.path.join(self.tmp_dir, 'case0', 'case0_seg.nii.gz')))
+
+    @parameterized.expand(TEST_DTYPE_CASES)
+    def test_written_dtype(self, dtype, expected):
+        saver = NiftiSaver(output_dir=self.tmp_dir, dtype=dtype)
+        saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'case0.nii.gz'})
+
+        img = nib.load(os.path.join(self.tmp_dir, 'case0', 'case0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(expected))
+
+
+if __name__ == '__main__':
+    unittest.main()
