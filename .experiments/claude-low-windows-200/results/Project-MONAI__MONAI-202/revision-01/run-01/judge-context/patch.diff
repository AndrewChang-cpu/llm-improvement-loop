+
+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_index_keys_without_meta(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=os.path.join(tempdir, 'sub'), filename='out.csv')
+            saver.save_batch(torch.zeros(3, 2))
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'sub', 'out.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                keys = [row[0] for row in csv.reader(f)]
+            self.assertEqual(keys, ['0', '1', '2'])
+
+    def test_overwrite_false_keeps_existing_rows(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('old,1.0,2.0\n')
+                f.write('kept,3.0,4.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(torch.tensor([9.0, 9.0]), {'filename_or_obj': 'old'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = {row[0]: np.array(row[1:]).astype(np.float32) for row in csv.reader(f)}
+            self.assertEqual(set(rows.keys()), {'old', 'kept'})
+            # values read from the file replace the in-memory values with the same key
+            np.testing.assert_allclose(rows['old'], [1.0, 2.0])
+            np.testing.assert_allclose(rows['kept'], [3.0, 4.0])
+
+
+if __name__ == '__main__':
+    unittest.main()
