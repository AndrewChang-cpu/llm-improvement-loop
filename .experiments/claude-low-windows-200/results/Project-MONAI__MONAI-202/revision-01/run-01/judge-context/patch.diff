--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,91 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches per-item values in memory and writes them to a CSV file when ``finalize`` is called.
+    Each row holds the item key followed by its flattened values. No header row is written.
+    This class does not depend on ignite; it can be used directly or wrapped by an event handler.
+
+    Args:
+        output_dir (str): output directory to save the CSV file, default is the current directory.
+        filename (str): name of the CSV file, must be a string ending with ``'.csv'``.
+        overwrite (bool): if False and the file already exists, rows already in the file are loaded
+            into the cache before writing; in-memory values with the same key are replaced by the file values.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv.'
+        self.output_dir = output_dir
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._cache_dict = OrderedDict()
+        self._index = 0
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order.
+        If ``overwrite`` is False and the file exists, the existing rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is the ``filename_or_obj`` value of ``meta_data`` when it is given,
+        otherwise the string form of the item index.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): the values of one item.
+            meta_data (dict): optional mapping whose ``'filename_or_obj'`` key gives the item key.
+                If None, the item index is used as the key.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        if meta_data is not None:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._index)
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``batch_data``.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): data whose first dimension indexes items.
+            meta_data (dict): optional mapping whose values are per-item sequences, indexed in parallel
+                with ``batch_data``. Each item receives the values at its position. If None, each item
+                uses no metadata and is keyed by its item index.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta)
