index 0000000..249da92
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,91 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the predictions of classification items into a CSV file. Items are cached in memory
+    and written to the file when ``finalize`` is called. The class does not depend on any
+    ignite engine; it can be used directly or wrapped by an event handler.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to save the CSV file, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with ``'.csv'``.
+            overwrite (bool): whether to overwrite the existing CSV file content. If False and the file
+                exists, its rows are loaded into the cache before the merged cache is written.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with ".csv".'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = {}
+        self._item_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches the values of one item. The key is the ``'filename_or_obj'`` value of ``meta_data``
+        when it is given, otherwise the string form of the item index. The item index advances by one.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): values of one item, converted to float32.
+            meta_data (dict): optional mapping whose ``'filename_or_obj'`` key holds the item's name.
+                If None, the item index is used as the name.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        if meta_data is None:
+            key = str(self._item_index)
+        else:
+            key = meta_data['filename_or_obj']
+        self._cache[key] = np.asarray(data).astype(np.float32)
+        self._item_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``batch_data``.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of items, the first dimension indexes items.
+            meta_data (dict): optional mapping whose values are per-item sequences, indexed in parallel
+                with the batch. If None, each item is saved without meta data.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = None if meta_data is None else {k: v[i] for k, v in meta_data.items()}
+            self.save(data, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order. If ``overwrite``
+        is False and the file exists, the existing rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
