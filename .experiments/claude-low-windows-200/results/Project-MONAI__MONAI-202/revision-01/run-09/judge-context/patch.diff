+        saver.save_batch(torch.zeros(shape), {'filename_or_obj': names})
+
+        for i in range(8):
+            filepath = os.path.join(output_dir, 'testfile' + str(i), 'testfile' + str(i) + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_save_batch_without_meta_uses_index(self):
+        output_dir = os.path.join(self.tempdir, 'output')
+        saver = NiftiSaver(output_dir=output_dir)
+        saver.save_batch(torch.zeros((4, 1, 2, 2)))
+
+        for i in range(4):
+            filepath = os.path.join(output_dir, str(i), str(i) + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_directory_part_is_dropped(self):
+        output_dir = os.path.join(self.tempdir, 'output')
+        saver = NiftiSaver(output_dir=output_dir)
