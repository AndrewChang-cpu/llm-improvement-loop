+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return [row for row in csv.reader(f)]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    def test_save_batch_with_names(self):
+        saver = CSVSaver(output_dir=self.tempdir)
+        names = ['testfile' + str(i) for i in range(8)]
+        saver.save_batch(torch.zeros(8), {'filename_or_obj': names})
+        saver.finalize()
+
+        filepath = os.path.join(self.tempdir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        rows = _read_rows(filepath)
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_save_single_item_without_meta_uses_index(self):
+        saver = CSVSaver(output_dir=self.tempdir, filename='out.csv')
+        saver.save(torch.tensor([1.0, 2.0]))
+        saver.save(torch.tensor([3.0, 4.0]))
+        saver.finalize()
+
+        rows = _read_rows(os.path.join(self.tempdir, 'out.csv'))
+        self.assertEqual([row[0] for row in rows], ['0', '1'])
+        self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [3.0, 4.0])
+
+    def test_overwrite_false_keeps_existing_rows(self):
+        first = CSVSaver(output_dir=self.tempdir)
+        first.save(np.array([0.0]), {'filename_or_obj': 'a'})
+        first.save(np.array([1.0]), {'filename_or_obj': 'b'})
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.tempdir, overwrite=False)
+        second.save(np.array([5.0]), {'filename_or_obj': 'a'})
+        second.save(np.array([2.0]), {'filename_or_obj': 'c'})
+        second.finalize()
+
+        values = {row[0]: np.array(row[1:]).astype(np.float32).tolist()
+                  for row in _read_rows(os.path.join(self.tempdir, 'predictions.csv'))}
+        # the file value replaces the in-memory value with the same key
+        self.assertEqual(values, {'a': [0.0], 'b': [1.0], 'c': [2.0]})
+
+    def test_creates_missing_output_dir(self):
+        output_dir = os.path.join(self.tempdir, 'sub', 'dir')
+        saver = CSVSaver(output_dir=output_dir)
+        saver.save(torch.zeros(1), {'filename_or_obj': 'x'})
+        saver.finalize()
+        self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+    def test_invalid_filename_raises(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(output_dir=self.tempdir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
