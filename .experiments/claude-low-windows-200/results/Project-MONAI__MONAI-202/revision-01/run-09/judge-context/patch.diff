+import os
+import shutil
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class RecordingSummaryWriter(SummaryWriter):
+    """SummaryWriter that records the tags of the images added through add_image."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.tempdir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.tempdir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        writer = SummaryWriter(log_dir=self.tempdir)
+        plot_2d_or_3d_image(torch.zeros(shape), 0, writer, max_channels=3)
+        writer.close()
+        self.assertTrue(len(os.listdir(self.tempdir)) > 0)
+
+    def test_three_dimensional_non_rgb_writes_one_image(self):
+        writer = RecordingSummaryWriter(log_dir=self.tempdir)
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, max_channels=1)
+        writer.close()
+        self.assertEqual(writer.image_tags, ['output_HW_0'])
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
