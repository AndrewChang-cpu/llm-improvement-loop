+
+import os
+import csv
+import tempfile
+import unittest
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_save_batch_with_meta(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_save_without_meta_uses_item_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir, filename='out.csv')
+            saver.save_batch(np.zeros((3, 2)))
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'out.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            for row in rows:
+                self.assertEqual(len(row), 3)
+
+    def test_nothing_written_before_finalize(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(torch.zeros(2), {'filename_or_obj': 'a'})
+            self.assertFalse(os.path.exists(os.path.join(tempdir, 'predictions.csv')))
+
+    def test_same_key_replaces_values_in_place(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(torch.tensor([1.0]), {'filename_or_obj': 'a'})
+            saver.save(torch.tensor([2.0]), {'filename_or_obj': 'b'})
+            saver.save(torch.tensor([3.0]), {'filename_or_obj': 'a'})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(rows[0][0], 'a')
+            self.assertEqual(float(rows[0][1]), 3.0)
+            self.assertEqual(rows[1][0], 'b')
+
+    def test_overwrite_false_keeps_existing_rows(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('old,5.0\nkeep,7.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(torch.tensor([1.0]), {'filename_or_obj': 'old'})
+            saver.save(torch.tensor([2.0]), {'filename_or_obj': 'new'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['old', 'keep', 'new'])
+            # the in-memory value replaces the value read from the file for the same key
+            self.assertEqual(float(rows[0][1]), 1.0)
+            self.assertEqual(float(rows[1][1]), 7.0)
+
+    def test_invalid_filename_raises(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
