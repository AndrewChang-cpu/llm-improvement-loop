+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves items of classification predictions into a CSV file. Items are cached in memory
+    and written to disk when ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the CSV file to write; must be a string ending in ``'.csv'``.
+            overwrite (bool): whether to overwrite the existing CSV file content. If False and the file
+                exists, its rows are loaded into the cache before writing, and rows with the same key
+                are replaced by the values in the file.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', \
+            'filename must be a string ending with ".csv".'
+        self.output_dir = output_dir
+        self._cache_dict = OrderedDict()
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self._data_index = 0
+
+    def finalize(self):
+        """
+        Writes the cached predictions to the CSV file, one line per key in insertion order.
+        If ``overwrite`` is False and the file exists, the existing rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is the ``'filename_or_obj'`` value of ``meta_data`` when it is given,
+        otherwise the string form of the item index. The item index increments on every call.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): one item of predictions, channel-first.
+            meta_data (dict): meta data mapping for this item; its ``'filename_or_obj'`` key is used
+                as the key. If None, the item index is used as the key.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data is None:
+            key = str(self._data_index)
+        else:
+            key = meta_data['filename_or_obj']
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item of a batch along the first dimension, by calling ``save`` for each item.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): a batch of predictions, batch dimension first.
+            meta_data (dict): meta data mapping whose values are per-item sequences indexed in parallel
+                with the batch. If None, each item is saved without meta data.
+        """
+        for i, data in enumerate(batch_data):
+            meta_data_i = None if meta_data is None else {k: meta_data[k][i] for k in meta_data}
+            self.save(data, meta_data_i)
