+import os
+import tempfile
+import unittest
+import numpy as np
+import nibabel as nib
+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASES = [
+    [(8, 1, 2, 2)],
+    [(8, 2, 2, 2, 2)],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_save_batch_with_meta(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            meta = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(shape), meta)
+
+            for i in range(8):
+                filepath = os.path.join(tempdir, 'testfile' + str(i), 'testfile' + str(i) + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_save_without_meta_uses_item_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(2, 1, 2, 2))
+
+            for i in range(2):
+                filepath = os.path.join(tempdir, str(i), str(i) + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_directory_part_is_dropped(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(torch.zeros(1, 2, 2), {'filename_or_obj': 'sub/case0.nii.gz'})
+
+            self.assertTrue(os.path.exists(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz')))
+            self.assertFalse(os.path.exists(os.path.join(tempdir, 'sub')))
+
+    def test_default_dtype_keeps_data_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int16), {'filename_or_obj': 'a'})
+
+            img = nib.load(os.path.join(tempdir, 'a', 'a_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.int16)
+
+    def test_explicit_dtype_is_written(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = NiftiSaver(output_dir=tempdir, dtype=np.float32)
+            saver.save(np.zeros((1, 2, 2), dtype=np.int16), {'filename_or_obj': 'a'})
+
+            img = nib.load(os.path.join(tempdir, 'a', 'a_seg.nii.gz'))
+            self.assertEqual(img.get_data_dtype(), np.float32)
+
+
+if __name__ == '__main__':
+    unittest.main()
