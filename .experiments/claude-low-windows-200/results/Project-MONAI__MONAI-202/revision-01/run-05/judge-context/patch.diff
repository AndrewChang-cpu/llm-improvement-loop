+from unittest import mock
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=1, max_frames=4)
+            writer.flush()
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_numpy_input_accepted(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(np.zeros((1, 1, 10, 10)), 0, writer)
+            writer.flush()
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_three_dimensional_non_rgb_writes_one_channel(self):
+        writer = mock.MagicMock(spec=SummaryWriter)
+        plot_2d_or_3d_image(torch.zeros(1, 3, 10, 10), 0, writer, index=0, max_channels=1, tag='output')
+        self.assertEqual(writer.add_image.call_count, 1)
+        self.assertEqual(writer.add_image.call_args[0][0], 'output_HW_0')
