index 0000000..77695b5
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,99 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+def _is_absent(meta_data):
+    """Return True when meta data is None or an empty mapping."""
+    return meta_data is None or len(meta_data) == 0
+
+
+class CSVSaver:
+    """
+    Store per-item values in memory and write them to a CSV file with ``finalize``.
+    Each item is keyed by the ``'filename_or_obj'`` value of its meta data. When meta data is absent
+    (None or an empty mapping), the key is the string form of the item index, which starts at zero.
+    The file has no header row; each line is the key followed by the comma-separated values of the item.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory to write the CSV file into, defaults to the current directory.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file. If False and the file exists, the rows
+                loaded from that file replace in-memory values with the same key when ``finalize`` is called.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv.'
+        self.output_dir = output_dir
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache = {}
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Store one item in memory.
+
+        Args:
+            data (Tensor or ndarray): one item, channel-first. Tensors are detached and moved to CPU.
+            meta_data (dict): optional mapping whose ``'filename_or_obj'`` key gives the item name. If None or
+                empty, the item index is used as the name instead.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if _is_absent(meta_data):
+            key = str(self._data_index)
+        else:
+            key = meta_data['filename_or_obj']
+        self._cache[key] = np.asarray(data).astype(np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Store every item of a batch in memory.
+
+        Args:
+            batch_data (Tensor or ndarray): batch whose first dimension indexes the items.
+            meta_data (dict): optional mapping whose values are per-item sequences, indexed in parallel with the
+                batch. If None or empty, every item uses the item index as its name.
+        """
+        absent = _is_absent(meta_data)
+        for i in range(len(batch_data)):
+            item_meta = None if absent else {k: v[i] for k, v in meta_data.items()}
+            self.save(batch_data[i], item_meta)
+
+    def finalize(self):
+        """
+        Write all stored items to the CSV file. If ``overwrite`` is False and the file exists, the rows already in
+        the file are loaded first; their values replace in-memory values with the same key. Keys already in memory
+        keep their position, and keys found only in the file are appended in file order.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if len(row) == 0:
+                        continue
+                    self._cache[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for key, values in self._cache.items():
+                f.write(str(key))
+                for value in values.flatten():
+                    f.write(',' + str(value))
+                f.write('\n')
