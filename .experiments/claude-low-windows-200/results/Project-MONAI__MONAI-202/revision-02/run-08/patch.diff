+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+
+from monai.data.csv_saver import CSVSaver
+
+ABSENT_META_CASES = [[None], [{}]]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            meta = {'filename_or_obj': ['testfile' + str(i) for i in range(8)]}
+            saver.save_batch(torch.zeros(8), meta)
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                reader = csv.reader(f)
+                i = 0
+                for row in reader:
+                    self.assertEqual(row[0], 'testfile' + str(i))
+                    self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+                    i += 1
+                self.assertEqual(i, 8)
+
+    @parameterized.expand(ABSENT_META_CASES)
+    def test_absent_meta_uses_item_index(self, meta):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(np.zeros((8, 2)), meta)
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], [str(i) for i in range(8)])
+            for row in rows:
+                self.assertEqual(len(row), 3)
+
+    def test_overwrite_false_merges_file_rows(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,1.0,2.0\nC,5.0,6.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(np.array([9.0, 9.0]), {'filename_or_obj': 'A'})
+            saver.save(np.array([3.0, 3.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # A keeps its memory position and takes the file value, B is in memory only,
+            # C is found only in the file and is appended after the in-memory keys
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32).tolist(), [1.0, 2.0])
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32).tolist(), [3.0, 3.0])
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32).tolist(), [5.0, 6.0])
+
+    def test_filename_must_end_with_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
