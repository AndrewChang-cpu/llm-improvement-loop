+import os
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            def _train_func(engine, batch):
+                return torch.zeros((8, 1, 2, 2))
+
+            engine = Engine(_train_func)
+            saver = SegmentationSaver(output_dir=tempdir)
+            saver.attach(engine)
+
+            data = [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            for i in range(8):
+                name = 'testfile' + str(i)
+                filepath = os.path.join(tempdir, name, name + '_seg.nii.gz')
+                self.assertTrue(os.path.exists(filepath))
+
+    def test_integer_output_keeps_dtype(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            def _train_func(engine, batch):
+                return torch.zeros((1, 1, 2, 2), dtype=torch.int32)
+
+            engine = Engine(_train_func)
+            saver = SegmentationSaver(output_dir=tempdir)
+            saver.attach(engine)
+
+            data = [{'filename_or_obj': ['case0.nii.gz']}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            img = nib.load(os.path.join(tempdir, 'case0', 'case0_seg.nii.gz'))
+            self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+
+
+if __name__ == '__main__':
+    unittest.main()
