+import glob
+import os
+import tempfile
+import unittest
+from unittest import mock
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shape(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, index=0, max_channels=3, max_frames=10)
+            writer.flush()
+            writer.close()
+
+            self.assertTrue(len(glob.glob(os.path.join(tempdir, 'events.out.tfevents*'))) > 0)
+
+    def test_three_dimensional_single_channel_writes_hw_0(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            with mock.patch.object(writer, 'add_image') as add_image:
+                plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, max_channels=1, tag='input_0')
+            writer.close()
+
+            self.assertEqual(add_image.call_count, 1)
+            self.assertEqual(add_image.call_args[0][0], 'input_0_HW_0')
+
+    def test_three_dimensional_zero_max_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            with mock.patch.object(writer, 'add_image') as add_image:
+                plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, max_channels=0, tag='input_0')
+            writer.close()
+
+            add_image.assert_not_called()
+
+    def test_numpy_input_is_accepted(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)).numpy(), 0, writer)
+            writer.close()
+
+            self.assertTrue(len(glob.glob(os.path.join(tempdir, 'events.out.tfevents*'))) > 0)
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
