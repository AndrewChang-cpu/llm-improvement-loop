+import os
+import csv
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_saved_content(self):
+        saver = CSVSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.zeros(8), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+        saver.finalize()
+
+        filepath = os.path.join(self.test_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(len(rows), 8)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_absent_meta_data_uses_item_index(self):
+        for meta_data in [None, {}]:
+            saver = CSVSaver(output_dir=self.test_dir)
+            saver.save_batch(torch.ones(3, 2), meta_data)
+            saver.finalize()
+
+            with open(os.path.join(self.test_dir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2'])
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32), [1.0, 1.0])
+
+    def test_overwrite_false_merge(self):
+        # existing file holds keys A and C, memory holds keys A and B
+        with open(os.path.join(self.test_dir, 'predictions.csv'), 'w') as f:
+            f.write('A,1.0\nC,2.0\n')
+
+        saver = CSVSaver(output_dir=self.test_dir, overwrite=False)
+        saver.save_batch(torch.zeros(2, 1), {'filename_or_obj': ['A', 'B']})
+        saver.finalize()
+
+        with open(os.path.join(self.test_dir, 'predictions.csv'), 'r') as f:
+            rows = list(csv.reader(f))
+        # order follows the merge rule: in-memory keys keep their position, file-only keys are appended
+        self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+        # the file value for A replaces the in-memory value
+        self.assertEqual(np.array(rows[0][1:]).astype(np.float32), [1.0])
+        self.assertEqual(np.array(rows[1][1:]).astype(np.float32), [0.0])
+        self.assertEqual(np.array(rows[2][1:]).astype(np.float32), [2.0])
+
+    def test_creates_output_dir(self):
+        output_dir = os.path.join(self.test_dir, 'sub', 'dir')
+        saver = CSVSaver(output_dir=output_dir)
+        saver.save(np.zeros(1), {'filename_or_obj': 'testfile0'})
+        saver.finalize()
+        self.assertTrue(os.path.exists(os.path.join(output_dir, 'predictions.csv')))
+
+
+if __name__ == '__main__':
+    unittest.main()
