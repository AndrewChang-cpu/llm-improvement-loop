--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,92 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves the model outputs (for example classification predictions) into a CSV file, one row per item.
+    Values are cached in memory by ``save`` / ``save_batch`` and written to disk only when ``finalize`` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the output CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite existing CSV file content. If False and the file already
+                exists, the rows loaded from the existing file replace the in-memory values with the same key.
+                Keys that are only present in the file are appended after the in-memory keys.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending in .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item for writing by ``finalize``.
+
+        Args:
+            data (Tensor or ndarray): one item, its values are stored as float32.
+            meta_data (dict): optional mapping whose ``'filename_or_obj'`` key gives the name of the item.
+                If it is None or empty, the item index (a running counter starting at zero) is used as the name.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._index)
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+        self._index += 1
+
+    def save_batch(self, data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``data``, by calling ``save`` once per item.
+
+        Args:
+            data (Tensor or ndarray): a batch, the first dimension indexes the items.
+            meta_data (dict): optional mapping whose values are per-item sequences, indexed in parallel
+                with the batch. See ``save`` for the meaning of the keys and for absent meta data.
+        """
+        for i, item in enumerate(data):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(item, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file, one line per key in insertion order, without a header row.
+        If ``overwrite`` is False and the file exists, the existing rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
