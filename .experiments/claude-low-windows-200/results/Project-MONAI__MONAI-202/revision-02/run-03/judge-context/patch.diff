+import torch
+from parameterized import parameterized
+
+from monai.data.nifti_saver import NiftiSaver
+
+TEST_CASES = [
+    [{'filename_or_obj': ['testfile' + str(i) for i in range(8)]}],
+    [{'filename_or_obj': ['testfile' + str(i) for i in range(8)],
+      'affine': [np.eye(4) for _ in range(8)], 'original_affine': [np.eye(4) for _ in range(8)]}],
+]
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_saved_content(self, meta_data):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save_batch(torch.zeros(8, 1, 2, 2), meta_data)
+        for i in range(8):
+            filepath = os.path.join(self.test_dir, 'testfile' + str(i), 'testfile' + str(i) + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+
+    def test_without_meta_data_uses_index(self):
+        for meta_data in [None, {}]:
+            output_dir = os.path.join(self.test_dir, 'case_' + str(meta_data is None))
+            saver = NiftiSaver(output_dir=output_dir)
+            saver.save_batch(torch.zeros(2, 1, 2, 2), meta_data)
+            for i in range(2):
+                self.assertTrue(os.path.exists(os.path.join(output_dir, str(i), str(i) + '_seg.nii.gz')))
+
+    def test_path_drops_directory(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save(torch.zeros(1, 2, 2), {'filename_or_obj': 'sub/case0.nii.gz'})
+        self.assertTrue(os.path.exists(os.path.join(self.test_dir, 'case0', 'case0_seg.nii.gz')))
+
+    def test_dtype_default_keeps_data_dtype(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'case0.nii.gz'})
+        img = nib.load(os.path.join(self.test_dir, 'case0', 'case0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+
+    def test_dtype_set_is_used(self):
+        saver = NiftiSaver(output_dir=self.test_dir, dtype=np.float32)
+        saver.save(np.zeros((1, 2, 2), dtype=np.int32), {'filename_or_obj': 'case0.nii.gz'})
+        img = nib.load(os.path.join(self.test_dir, 'case0', 'case0_seg.nii.gz'))
+        self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.float32))
+
+
+if __name__ == '__main__':
+    unittest.main()
