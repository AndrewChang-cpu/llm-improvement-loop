                                                                     max_out=max_out, animation_axes=[1],
                                                                     image_axes=[2, 3], scale_factor=scale_factor),
                                           global_step)
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot one item of a batch of 2D or 3D images to TensorBoard. 2D items are written as a single image,
+    3D items as images of the first channel (or as RGB when there are three channels and ``max_channels`` is 3),
+    and items with four or more dimensions as animated GIFs of their leading volumes.
+
+    Args:
+        data (Tensor or ndarray): batch in NCHW[D] layout, the item at ``index`` is plotted.
+        step (int): global step value to record.
+        writer (SummaryWriter): TensorBoard writer to write to.
+        index (int): index of the item in the batch to plot.
+        max_channels (int): maximum number of channels to plot.
+        max_frames (int): number of frames of the animated GIFs for 3D plots.
+        tag (str): tag name of the written data, the suffix describing the plot is appended to it.
+    """
+    assert isinstance(writer, SummaryWriter), 'writer must be a SummaryWriter.'
+
+    d = data[index]
+    if isinstance(d, torch.Tensor):
+        d = d.detach().cpu().numpy()
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+        return
+
+    if d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            dataformats = 'CHW'
+            writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+            return
+        if max_channels >= 1:
+            d2 = rescale_array(d[0], 0, 1)
+            dataformats = 'HW'
+            writer.add_image('{}_{}_0'.format(tag, dataformats), d2, step, dataformats=dataformats)
+        return
+
+    if d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
+        return
