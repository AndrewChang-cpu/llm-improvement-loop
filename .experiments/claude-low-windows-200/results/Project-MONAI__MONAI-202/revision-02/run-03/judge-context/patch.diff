+import os
+import shutil
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class RecordingSummaryWriter(SummaryWriter):
+    """SummaryWriter that also records the tags of the images written with add_image."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+        super().add_image(tag, img_tensor, global_step, walltime, dataformats)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        writer = SummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros(shape), 0, writer)
+        writer.close()
+        self.assertTrue(os.path.exists(self.test_dir))
+        self.assertTrue(len(os.listdir(self.test_dir)) > 0)
+
+    def test_plot_tensor_and_array_input(self):
+        writer = RecordingSummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, tag='input_0')
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)).numpy(), 0, writer, tag='input_1')
+        writer.close()
+        self.assertEqual(writer.image_tags, ['input_0_HW_0', 'input_1_HW_0'])
+
+    def test_three_dimensional_single_channel_tag(self):
+        writer = RecordingSummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, tag='input_0')
+        writer.close()
+        self.assertEqual(len(writer.image_tags), 1)
+        self.assertEqual(writer.image_tags[0], 'input_0_HW_0')
+
+    def test_three_dimensional_non_rgb_writes_channel_zero(self):
+        writer = RecordingSummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 4, 10, 10)), 0, writer, tag='input_0', max_channels=1)
+        writer.close()
+        self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_three_dimensional_non_rgb_max_channels_zero_writes_nothing(self):
+        writer = RecordingSummaryWriter(log_dir=self.test_dir)
+        plot_2d_or_3d_image(torch.zeros((1, 4, 10, 10)), 0, writer, tag='input_0', max_channels=0)
+        writer.close()
+        self.assertEqual(writer.image_tags, [])
+
+    def test_index_selects_item(self):
+        writer = RecordingSummaryWriter(log_dir=self.test_dir)
+        data = torch.zeros((2, 1, 10, 10))
+        data[1] = 1.0
+        plot_2d_or_3d_image(data, 0, writer, index=1, tag='output')
+        writer.close()
+        self.assertEqual(writer.image_tags, ['output_HW_0'])
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
