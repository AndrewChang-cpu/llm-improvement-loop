+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+
+import numpy as np
+import torch
+
+from monai.data.nifti_writer import write_nifti
+
+
+class NiftiSaver:
+    """
+    Saves model outputs as NIfTI files. Each item is written immediately when saved. This class does not depend on
+    ignite; it can be used directly or through the SegmentationSaver class in the ``monai.handlers.segmentation_saver``
+    module.
+    """
+
+    def __init__(self, output_dir='./', output_postfix='seg', output_ext='.nii.gz', dtype=None):
+        """
+        Args:
+            output_dir (str): output directory for the NIfTI files.
+            output_postfix (str): a string appended to the base name of each output file.
+            output_ext (str): output file extension.
+            dtype (numpy.dtype): dtype to write. None keeps the dtype of the data being saved.
+        """
+        self.output_dir = output_dir
+        self.output_postfix = output_postfix
+        self.output_ext = output_ext
+        self.dtype = dtype
+        self._data_index = 0
+
+    @staticmethod
+    def _create_file_basename(postfix, input_file_name, folder_path, data_root_dir=""):
+        """
+        Utility function to create the path to the output file based on the input filename. The extension is added
+        by the lib level writer before writing the file.
+
+        Args:
+            postfix (str): output name's postfix.
+            input_file_name (str): path to the input image file. Its directory part is dropped unless
+                ``data_root_dir`` is given.
+            folder_path (str): path of the output directory.
+            data_root_dir (str): if not empty, it specifies the beginning parts of the input file's absolute path.
+                It is used to compute the relative path to the file from ``data_root_dir`` to preserve folder
+                structure when saving files from different folders with the same file names.
+        """
+        filedir, filename = os.path.split(input_file_name)
+
+        # jettison all the extensions to have just the base name
+        filename, ext = os.path.splitext(filename)
+        while ext != "":
+            filename, ext = os.path.splitext(filename)
+
+        filedir_rel_path = ""
+        if data_root_dir:
+            filedir_rel_path = os.path.relpath(filedir, data_root_dir)
+
+        # the base name is used as a sub-folder of the output directory
+        subfolder_path = os.path.join(folder_path, filedir_rel_path, filename)
+        os.makedirs(subfolder_path, exist_ok=True)
+
+        return os.path.join(subfolder_path, filename + "_" + postfix)
+
+    def save(self, data, meta_data=None):
+        """
+        Writes one item to a NIfTI file. The base name comes from the ``'filename_or_obj'`` value of ``meta_data``.
+        When meta data is absent (None or an empty mapping), the base name is the string form of the item index.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): one item, channel-first (channels, then spatial dimensions).
+            meta_data (dict): optional meta data mapping. Keys used are ``'filename_or_obj'`` (file name),
+                ``'affine'`` (output affine, optional) and ``'original_affine'`` (optional).
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        data = np.asarray(data)
+
+        if meta_data:
+            filename = meta_data['filename_or_obj']
+            affine = meta_data.get('affine', None)
+            original_affine = meta_data.get('original_affine', None)
+        else:
+            filename = str(self._data_index)
+            affine = None
+            original_affine = None
+        if torch.is_tensor(affine):
+            affine = affine.detach().cpu().numpy()
+        if torch.is_tensor(original_affine):
+            original_affine = original_affine.detach().cpu().numpy()
+
+        output_name = self._create_file_basename(self.output_postfix, str(filename), self.output_dir)
+        output_name = '{}{}'.format(output_name, self.output_ext)
+        dtype = self.dtype if self.dtype is not None else data.dtype
+
+        # change output to "channel last" format and write to nifti format file
+        to_save = np.moveaxis(data, 0, -1)
+        write_nifti(to_save, affine, output_name, original_affine, dtype=dtype)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Writes every item along the first dimension of ``batch_data`` by calling ``save`` for each item.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of items, first dimension is the batch.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in parallel
+                with the batch. The keys used are ``'filename_or_obj'``, ``'affine'`` and ``'original_affine'``.
+                None or an empty mapping means absent.
+        """
+        for i, item in enumerate(batch_data):
+            item_meta = None
+            if meta_data:
+                item_meta = {k: (v[i] if v is not None else None) for k, v in meta_data.items()}
+            self.save(item, item_meta)
