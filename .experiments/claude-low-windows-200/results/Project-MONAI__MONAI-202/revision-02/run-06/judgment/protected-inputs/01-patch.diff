new file mode 100644
index 0000000..8bf2197
--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,99 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Saves classification-style predictions into a CSV file. Items are cached in memory by key and the file is
+    written when ``finalize`` is called. This class does not depend on ignite; it can be used directly or through
+    the ClassificationSaver class in the ``monai.handlers.classification_saver`` module.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory where the CSV file is written. Created by ``finalize`` if missing.
+            filename (str): name of the CSV file. Must be a string ending with ``'.csv'``.
+            overwrite (bool): whether to overwrite the existing CSV file. When False and the file exists, the rows
+                loaded from the existing file replace in-memory values with the same key; keys found only in the
+                file are appended after the in-memory keys.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item. The key is the ``'filename_or_obj'`` value of ``meta_data`` when meta data is present.
+        When meta data is absent (None or an empty mapping), the key is the string form of the item index.
+
+        Args:
+            data (torch.Tensor or numpy.ndarray): one item of prediction values.
+            meta_data (dict): optional meta data mapping. The key used is ``'filename_or_obj'``.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache_dict[key] = np.asarray(data, dtype=np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of ``batch_data`` by calling ``save`` for each item.
+
+        Args:
+            batch_data (torch.Tensor or numpy.ndarray): batch of prediction values, first dimension is the batch.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences, indexed in parallel
+                with the batch. The key used is ``'filename_or_obj'``. None or an empty mapping means absent.
+        """
+        for i, item in enumerate(batch_data):
+            item_meta = None
+            if meta_data:
+                item_meta = {k: (v[i] if v is not None else None) for k, v in meta_data.items()}
+            self.save(item, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached items to the CSV file, one line per key in insertion order. There is no header row.
+        When ``overwrite`` is False and the file exists, the existing rows are merged into the cache first.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            file_cache = OrderedDict()
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    if not row:
+                        continue
+                    file_cache[row[0]] = np.array(row[1:]).astype(np.float32)
+            for key, values in file_cache.items():
+                self._cache_dict[key] = values
+
+        if self.output_dir and not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for key, values in self._cache_dict.items():
+                f.write(str(key))
+                for result in values.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
