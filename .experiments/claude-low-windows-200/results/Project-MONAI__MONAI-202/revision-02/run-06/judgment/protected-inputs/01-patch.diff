+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            names = ['testfile' + str(i) for i in range(8)]
+
+            # set up engine
+            def _train_func(engine, batch):
+                return torch.zeros((8, 1, 2, 2))
+
+            engine = Engine(_train_func)
+
+            # set up testing handler
+            saver = SegmentationSaver(output_dir=tempdir, output_postfix='seg', output_ext='.nii.gz',
+                                      batch_transform=lambda x: {'filename_or_obj': names})
+            saver.attach(engine)
+
+            data = [{'filename_or_obj': names}]
+            engine.run(data, epoch_length=1, max_epochs=1)
+
+            for name in names:
+                filepath = os.path.join(tempdir, name, '{}_seg.nii.gz'.format(name))
+                self.assertTrue(os.path.exists(filepath))
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+    def test_default_dtype_keeps_integer_output(self):
+        tempdir = tempfile.mkdtemp()
+        try:
+            names = ['testfile' + str(i) for i in range(2)]
+
+            # set up engine
+            def _train_func(engine, batch):
+                return torch.zeros((2, 1, 2, 2), dtype=torch.int32)
+
+            engine = Engine(_train_func)
+
+            saver = SegmentationSaver(output_dir=tempdir, batch_transform=lambda x: {'filename_or_obj': names})
+            saver.attach(engine)
+
+            engine.run([{'filename_or_obj': names}], epoch_length=1, max_epochs=1)
+
+            img = nib.load(os.path.join(tempdir, names[0], '{}_seg.nii.gz'.format(names[0])))
+            self.assertEqual(np.dtype(img.get_data_dtype()), np.dtype(np.int32))
+        finally:
+            shutil.rmtree(tempdir, ignore_errors=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
