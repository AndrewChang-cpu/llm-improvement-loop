+
+import csv
+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            names = ['testfile' + str(i) for i in range(8)]
+            saver.save_batch(torch.zeros(8), {'filename_or_obj': names})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(np.array(row[1:]).astype(np.float32), 0.0)
+
+    def test_saved_content_without_meta_data(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(4, 2))
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual([row[0] for row in rows], ['0', '1', '2', '3'])
+            for row in rows:
+                self.assertEqual(len(row), 3)
+
+    def test_empty_meta_data_uses_item_index(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(torch.ones(2), {})
+            saver.finalize()
+
+            with open(os.path.join(tempdir, 'predictions.csv'), 'r') as f:
+                rows = list(csv.reader(f))
+            self.assertEqual(rows[0][0], '0')
+
+    def test_saved_content_overwrite_false(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            # existing file holds keys A and C
+            with open(filepath, 'w') as f:
+                f.write('A,1.0\nC,2.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(torch.zeros(1), {'filename_or_obj': 'A'})
+            saver.save(torch.zeros(1), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            with open(filepath, 'r') as f:
+                rows = list(csv.reader(f))
+            # keys in memory keep their position, file-only keys are appended in file order
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            # the file value replaces the in-memory value for the shared key A
+            self.assertEqual(np.array(rows[0][1:]).astype(np.float32), 1.0)
+            self.assertEqual(np.array(rows[1][1:]).astype(np.float32), 0.0)
+            self.assertEqual(np.array(rows[2][1:]).astype(np.float32), 2.0)
+
+    def test_filename_must_be_csv(self):
+        with self.assertRaises(AssertionError):
+            CSVSaver(filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
