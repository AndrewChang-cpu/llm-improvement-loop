--- /dev/null
+++ b/monai/data/csv_saver.py
@@ -0,0 +1,94 @@
+# Copyright 2020 MONAI Consortium
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#     http://www.apache.org/licenses/LICENSE-2.0
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import os
+import csv
+from collections import OrderedDict
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Caches per-item values in memory and writes them to a CSV file on ``finalize``.
+    Each line of the file holds the key followed by the flattened values of the item.
+    There is no header row. This class does not depend on ignite.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        """
+        Args:
+            output_dir (str): output directory where the CSV file is written.
+            filename (str): name of the CSV file, must be a string ending with '.csv'.
+            overwrite (bool): whether to overwrite the existing CSV file. If False and the file exists,
+                rows loaded from the existing file replace in-memory values with the same key.
+                Keys found only in the file are appended after the in-memory keys, in file order.
+        """
+        assert isinstance(filename, str) and filename[-4:] == '.csv', 'filename must be a string ending with .csv.'
+        self.output_dir = output_dir
+        self.filename = filename
+        self.overwrite = overwrite
+        self._filepath = os.path.join(output_dir, filename)
+        self._cache_dict = OrderedDict()
+        self._data_index = 0
+
+    def save(self, data, meta_data=None):
+        """
+        Caches one item of data for writing by ``finalize``.
+
+        Args:
+            data (Tensor or numpy.ndarray): the values of one item.
+            meta_data (dict): optional meta data mapping. The key ``'filename_or_obj'`` gives the
+                row key. If the mapping is absent (None or empty), the string form of the item index
+                is used as the key instead.
+        """
+        if torch.is_tensor(data):
+            data = data.detach().cpu().numpy()
+        if meta_data:
+            key = meta_data['filename_or_obj']
+        else:
+            key = str(self._data_index)
+        self._cache_dict[key] = np.array(data, dtype=np.float32)
+        self._data_index += 1
+
+    def save_batch(self, batch_data, meta_data=None):
+        """
+        Caches every item along the first dimension of a batch.
+
+        Args:
+            batch_data (Tensor or numpy.ndarray): data whose first dimension indexes items.
+            meta_data (dict): optional meta data mapping whose values are per-item sequences,
+                indexed in parallel with the batch. See ``save`` for the keys used. If absent
+                (None or empty), each item uses the item index as its key.
+        """
+        for i, data in enumerate(batch_data):
+            item_meta = {k: v[i] for k, v in meta_data.items()} if meta_data else None
+            self.save(data, item_meta)
+
+    def finalize(self):
+        """
+        Writes the cached values to the CSV file. If ``overwrite`` is False and the file exists,
+        the rows of the existing file are loaded first and replace in-memory values with the same key.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                for row in csv.reader(f):
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in self._cache_dict.items():
+                f.write(k)
+                for result in v.flatten():
+                    f.write(',' + str(result))
+                f.write('\n')
