+import csv
+import os
+import tempfile
+import unittest
+
+import torch
+from parameterized import parameterized
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(filepath):
+    with open(filepath, 'r') as f:
+        return [row for row in csv.reader(f)]
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(8), {'filename_or_obj': ['testfile' + str(i) for i in range(8)]})
+            saver.finalize()
+
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            self.assertTrue(os.path.exists(filepath))
+            rows = _read_rows(filepath)
+            self.assertEqual(len(rows), 8)
+            for i, row in enumerate(rows):
+                self.assertEqual(row[0], 'testfile' + str(i))
+                self.assertEqual(float(row[1]), 0.0)
+
+    @parameterized.expand([[None], [{}]])
+    def test_absent_meta_data_uses_item_index(self, meta_data):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save_batch(torch.zeros(8), meta_data)
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], [str(i) for i in range(8)])
+
+    def test_single_item_save_then_overwrite_key(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            saver = CSVSaver(output_dir=tempdir)
+            saver.save(torch.tensor([1.0, 2.0]), {'filename_or_obj': 'A'})
+            saver.save(torch.tensor([3.0, 4.0]), {'filename_or_obj': 'B'})
+            saver.save(torch.tensor([5.0, 6.0]), {'filename_or_obj': 'A'})
+            saver.finalize()
+
+            rows = _read_rows(os.path.join(tempdir, 'predictions.csv'))
+            self.assertEqual([row[0] for row in rows], ['A', 'B'])
+            self.assertEqual([float(v) for v in rows[0][1:]], [5.0, 6.0])
+            self.assertEqual([float(v) for v in rows[1][1:]], [3.0, 4.0])
+
+    def test_overwrite_false_merge_order_and_values(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            filepath = os.path.join(tempdir, 'predictions.csv')
+            with open(filepath, 'w') as f:
+                f.write('A,5.0\nC,7.0\n')
+
+            saver = CSVSaver(output_dir=tempdir, overwrite=False)
+            saver.save(torch.tensor([0.0]), {'filename_or_obj': 'A'})
+            saver.save(torch.tensor([0.0]), {'filename_or_obj': 'B'})
+            saver.finalize()
+
+            # A keeps its in-memory position and takes the file value, B stays, C is appended from the file
+            rows = _read_rows(filepath)
+            self.assertEqual([row[0] for row in rows], ['A', 'B', 'C'])
+            self.assertEqual([float(v) for v in rows[0][1:]], [5.0])
+            self.assertEqual([float(v) for v in rows[1][1:]], [0.0])
+            self.assertEqual([float(v) for v in rows[2][1:]], [7.0])
+
+    def test_filename_must_end_with_csv(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            with self.assertRaises(AssertionError):
+                CSVSaver(output_dir=tempdir, filename='predictions.txt')
+
+
+if __name__ == '__main__':
+    unittest.main()
