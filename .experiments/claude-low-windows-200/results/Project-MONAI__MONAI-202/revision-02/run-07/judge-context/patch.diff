+import os
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+from parameterized import parameterized
+from torch.utils.tensorboard import SummaryWriter
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+TEST_CASES = [
+    [(1, 1, 10, 10)],
+    [(1, 3, 10, 10)],
+    [(1, 4, 10, 10)],
+    [(1, 1, 10, 10, 10)],
+    [(1, 3, 10, 10, 10)],
+]
+
+
+class _RecordingWriter(SummaryWriter):
+    """SummaryWriter that records the tags of the 2D images it is asked to write."""
+
+    def __init__(self, log_dir):
+        super().__init__(log_dir=log_dir)
+        self.image_tags = []
+
+    def add_image(self, tag, img_tensor, global_step=None, walltime=None, dataformats='CHW'):
+        self.image_tags.append(tag)
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    @parameterized.expand(TEST_CASES)
+    def test_plot_shapes(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, max_channels=3, max_frames=4)
+            writer.flush()
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    def test_plot_numpy_input(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = SummaryWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(np.zeros((1, 1, 10, 10)), 0, writer)
+            writer.flush()
+            writer.close()
+            self.assertTrue(len(os.listdir(tempdir)) > 0)
+
+    @parameterized.expand([[(1, 1, 10, 10)], [(1, 3, 10, 10)]])
+    def test_three_dimensional_single_channel_tag(self, shape):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros(shape), 0, writer, max_channels=1, tag='input_0')
+            writer.close()
+            self.assertEqual(writer.image_tags, ['input_0_HW_0'])
+
+    def test_three_dimensional_no_channels_writes_nothing(self):
+        with tempfile.TemporaryDirectory() as tempdir:
+            writer = _RecordingWriter(log_dir=tempdir)
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer, max_channels=0, tag='output')
+            writer.close()
+            self.assertEqual(writer.image_tags, [])
+
+    def test_writer_must_be_summary_writer(self):
+        with self.assertRaises(AssertionError):
+            plot_2d_or_3d_image(torch.zeros((1, 1, 10, 10)), 0, writer=None)
+
+
+if __name__ == '__main__':
+    unittest.main()
