+import os
+import csv
+import logging
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Save the data in a dictionary format cache, and write it to a CSV file when finalized.
+    This class has no dependency on ignite, so it can be called directly or wrapped by an event handler.
+    Typical usage: call ``save`` for each item, then call ``finalize`` once to write the CSV file.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True, name=None):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            filename (str): name of the CSV file to write under ``output_dir``.
+            overwrite (bool): whether to overwrite existing CSV file content. If we are not overwriting,
+                then we check if the results have been previously saved, and load them to the cache.
+            name (str): identifier of logging.logger to use, if None, defaulting to ``logging.getLogger()``.
+        """
+        self.output_dir = output_dir
+        self._cache_dict = {}
+        self._filepath = os.path.join(output_dir, filename)
+        self.overwrite = overwrite
+        self.logger = logging.getLogger(name)
+
+    def save(self, key, data):
+        """
+        Cache one item. Items with the same key overwrite each other.
+
+        Args:
+            key (str): identifier of the item, written as the first column of its CSV row.
+            data (numpy.ndarray or torch.Tensor or scalar): the values to write, flattened into the row.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._cache_dict[key] = np.asarray(data).astype(np.float32)
+
+    def finalize(self):
+        """
+        Write the cached items to the CSV file, sorted by key.
+        """
+        if not self.overwrite and os.path.exists(self._filepath):
+            with open(self._filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._cache_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._filepath, 'w') as f:
+            for k, v in sorted(self._cache_dict.items()):
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+        self.logger.info('saved classification predictions into: {}'.format(self._filepath))
