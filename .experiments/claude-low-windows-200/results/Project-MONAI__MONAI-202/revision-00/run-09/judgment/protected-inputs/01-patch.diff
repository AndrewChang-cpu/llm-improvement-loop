+import unittest
+from unittest.mock import MagicMock
+
+import numpy as np
+
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def test_2d_image(self):
+        writer = MagicMock()
+        data = np.random.normal(size=(2, 10, 10))
+        plot_2d_or_3d_image(data, 5, writer, tag='output')
+        writer.add_image.assert_called_once()
+        args, kwargs = writer.add_image.call_args
+        self.assertEqual(args[0], 'output_HW')
+        self.assertEqual(args[1].shape, (10, 10))
+        self.assertEqual(args[2], 5)
+        self.assertEqual(kwargs['dataformats'], 'HW')
+
+    def test_rgb_image(self):
+        writer = MagicMock()
+        data = np.random.normal(size=(1, 3, 10, 10))
+        plot_2d_or_3d_image(data, 1, writer, max_channels=3, tag='input_0')
+        writer.add_image.assert_called_once()
+        args, kwargs = writer.add_image.call_args
+        self.assertEqual(args[0], 'input_0_CHW')
+        self.assertEqual(kwargs['dataformats'], 'CHW')
+
+    def test_3d_volume_writes_gif(self):
+        writer = MagicMock()
+        data = np.random.normal(size=(1, 2, 2, 10, 10, 10))
+        plot_2d_or_3d_image(data, 3, writer, max_channels=2, max_frames=4, tag='output')
+        # animated gif is written through the file writer, one per channel
+        self.assertEqual(writer._get_file_writer.return_value.add_summary.call_count, 2)
+        writer.add_image.assert_not_called()
+
+
+if __name__ == '__main__':
+    unittest.main()
