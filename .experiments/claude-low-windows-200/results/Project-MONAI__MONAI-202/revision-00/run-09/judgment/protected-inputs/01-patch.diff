+import os
+import shutil
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = os.path.join('.', 'tempdir_nifti_saver')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        saver = NiftiSaver(output_dir=default_dir, output_postfix='seg', output_ext='.nii.gz')
+        data = torch.zeros((1, 2, 3, 4))  # channel first
+        saver.save(data, 'testfile0.nii.gz', affine=np.eye(4), original_affine=np.eye(4))
+
+        filepath = os.path.join(default_dir, 'testfile0', 'testfile0_seg.nii.gz')
+        self.assertTrue(os.path.exists(filepath))
+        img = nib.load(filepath)
+        # channel is moved to the last axis before writing
+        self.assertEqual(tuple(img.shape), (2, 3, 4, 1))
+        shutil.rmtree(default_dir)
+
+    def test_create_file_basename_keeps_relative_folder(self):
+        default_dir = os.path.join('.', 'tempdir_nifti_basename')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        basename = NiftiSaver.create_file_basename('seg', os.path.join('/root', 'sub', 'case1.nii.gz'),
+                                                   default_dir, data_root_dir='/root')
+        self.assertEqual(basename, os.path.join(default_dir, 'sub', 'case1', 'case1_seg'))
+        self.assertTrue(os.path.isdir(os.path.join(default_dir, 'sub', 'case1')))
+        shutil.rmtree(default_dir)
+
+
+if __name__ == '__main__':
+    unittest.main()
