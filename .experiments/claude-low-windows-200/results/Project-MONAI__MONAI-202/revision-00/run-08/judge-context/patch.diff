+# limitations under the License.
+
+import numpy as np
+import torch
+
+from monai.visualize import img2tensorboard
+from monai.transforms.utils import rescale_array
+
+
+def plot_2d_or_3d_image(data, step, writer, index=0, max_channels=1, max_frames=64, tag='output'):
+    """
+    Plot the data of one element of a batch to TensorBoard as an image (2D) or animated GIF (3D).
+
+    - 2D data (H, W) is plotted as a simple image.
+    - 3D data (C, H, W) is plotted as a 2D image per channel, or as an RGB image if C == 3 and
+      ``max_channels == 3``.
+    - ND data (C, H, W, D, ...) is plotted as an animated GIF along the last spatial axis, for each of
+      the first ``max_channels`` channels.
+
+    This function has no dependency on ignite, so it can be called directly.
+
+    Args:
+        data (numpy.ndarray or torch.Tensor): batch of data, shape (N, C, ...). Only the element at ``index`` is plotted.
+        step (int): global step (iteration) number used for TensorBoard.
+        writer (SummaryWriter): TensorBoard writer to write to.
+        index (int): index of the element in the batch to plot, default to 0.
+        max_channels (int): number of channels to plot.
+        max_frames (int): number of frames for the animated GIF of 3D data.
+        tag (str): tag name prefix used for TensorBoard.
+    """
+    if torch.is_tensor(data):
+        data = data.detach().cpu().numpy()
+    if not isinstance(data, np.ndarray):
+        raise ValueError('data must be an ndarray or tensor.')
+
+    d = data[index]  # show the element at `index` in a batch
+
+    if d.ndim == 2:
+        d = rescale_array(d, 0, 1)
+        dataformats = 'HW'
+        writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+        return
+
+    if d.ndim == 3:
+        if d.shape[0] == 3 and max_channels == 3:  # RGB
+            dataformats = 'CHW'
+            writer.add_image('{}_{}'.format(tag, dataformats), d, step, dataformats=dataformats)
+            return
+        for j, d2 in enumerate(d[:max_channels]):
+            d2 = rescale_array(d2, 0, 1)
+            dataformats = 'HW'
+            writer.add_image('{}_{}_{}'.format(tag, dataformats, j), d2, step, dataformats=dataformats)
+            return
+
+    if d.ndim >= 4:
+        spatial = d.shape[-3:]
+        for j, d3 in enumerate(d.reshape([-1] + list(spatial))[:max_channels]):
+            d3 = rescale_array(d3, 0, 255)
+            img2tensorboard.add_animated_gif(writer, '{}_HWD_{}'.format(tag, j), d3[None], max_frames, 1.0, step)
