+# limitations under the License.
+
+import csv
+import os
+import shutil
+import unittest
+
+import numpy as np
+import torch
+
+from monai.handlers.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.output_dir = os.path.join('.', 'tempdir_csv_saver')
+        shutil.rmtree(self.output_dir, ignore_errors=True)
+
+    def tearDown(self):
+        shutil.rmtree(self.output_dir, ignore_errors=True)
+
+    def _read_rows(self, path):
+        with open(path, 'r') as f:
+            return list(csv.reader(f))
+
+    def test_saved_content_sorted(self):
+        saver = CSVSaver(output_dir=self.output_dir)
+        saver.save('testfile1', torch.tensor([0.1, 0.2]))
+        saver.save('testfile0', np.array([0.3, 0.4]))
+        path = saver.finalize()
+
+        self.assertEqual(path, os.path.join(self.output_dir, 'predictions.csv'))
+        rows = self._read_rows(path)
+        self.assertEqual(len(rows), 2)
+        self.assertEqual(rows[0][0], 'testfile0')
+        self.assertEqual(rows[1][0], 'testfile1')
+        np.testing.assert_allclose(np.array(rows[0][1:], dtype=np.float32), [0.3, 0.4], rtol=1e-6)
+        np.testing.assert_allclose(np.array(rows[1][1:], dtype=np.float32), [0.1, 0.2], rtol=1e-6)
+
+    def test_not_overwrite_keeps_previous_rows(self):
+        first = CSVSaver(output_dir=self.output_dir)
+        first.save('old', np.array([1.0]))
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.output_dir, overwrite=False)
+        second.save('new', np.array([2.0]))
+        second.finalize()
+
+        rows = self._read_rows(second.filepath)
+        self.assertEqual([r[0] for r in rows], ['new', 'old'])
+
+    def test_overwrite_replaces_previous_rows(self):
+        first = CSVSaver(output_dir=self.output_dir)
+        first.save('old', np.array([1.0]))
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.output_dir, overwrite=True)
+        second.save('new', np.array([2.0]))
+        second.finalize()
+
+        rows = self._read_rows(second.filepath)
+        self.assertEqual([r[0] for r in rows], ['new'])
+
+
+if __name__ == '__main__':
+    unittest.main()
