+import os
+import shutil
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.output_dir = os.path.join('.', 'tempdir_seg_saver')
+        shutil.rmtree(self.output_dir, ignore_errors=True)
+
+    def tearDown(self):
+        shutil.rmtree(self.output_dir, ignore_errors=True)
+
+    def test_saved_nifti_files(self):
+        # set up engine, the output of each iteration is a batch of 2 single-channel images
+        def _train_func(engine, batch):
+            return torch.ones((2, 1, 10, 10))
+
+        engine = Engine(_train_func)
+
+        saver = SegmentationSaver(output_path=self.output_dir, output_ext='.nii.gz', output_postfix='seg')
+        saver.attach(engine)
+
+        data = [{
+            'filename_or_obj': ['testfile0.nii.gz', 'testfile1.nii.gz'],
+            'affine': [np.eye(4), np.eye(4)],
+            'original_affine': [np.eye(4), np.eye(4)],
+        }]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        for name in ['testfile0', 'testfile1']:
+            path = os.path.join(self.output_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(path), path)
+            img = nib.load(path)
+            self.assertEqual(img.shape, (10, 10, 1))  # saved in channel last format
+            np.testing.assert_allclose(np.asarray(img.dataobj), np.ones((10, 10, 1)))
+
+    def test_attach_does_not_duplicate_handler(self):
+        engine = Engine(lambda engine, batch: torch.zeros((1, 1, 4, 4)))
+        saver = SegmentationSaver(output_path=self.output_dir)
+        saver.attach(engine)
+        saver.attach(engine)
+        self.assertTrue(engine.has_event_handler(saver))
+
+
+if __name__ == '__main__':
+    unittest.main()
