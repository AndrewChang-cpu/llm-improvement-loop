+import os
+import shutil
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.handlers.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.output_dir = os.path.join('.', 'tempdir_nifti_saver')
+        shutil.rmtree(self.output_dir, ignore_errors=True)
+
+    def tearDown(self):
+        shutil.rmtree(self.output_dir, ignore_errors=True)
+
+    def test_save_numpy(self):
+        saver = NiftiSaver(output_path=self.output_dir, output_postfix='seg', output_ext='.nii.gz')
+        data = np.random.rand(2, 10, 8).astype(np.float32)  # channel first
+        out_file = saver.save(data, 'testfile0.nii.gz', affine=np.eye(4), original_affine=np.eye(4))
+
+        expected = os.path.join(self.output_dir, 'testfile0', 'testfile0_seg.nii.gz')
+        self.assertEqual(out_file, expected)
+        self.assertTrue(os.path.exists(expected))
+
+        img = nib.load(expected)
+        self.assertEqual(img.shape, (10, 8, 2))  # saved in channel last format
+        np.testing.assert_allclose(np.asarray(img.dataobj), np.moveaxis(data, 0, -1), rtol=1e-5)
+
+    def test_save_tensor_and_default_affine(self):
+        saver = NiftiSaver(output_path=self.output_dir, output_postfix='pred', output_ext='.nii')
+        data = torch.ones((1, 5, 5, 5))
+        out_file = saver.save(data, 'sub/testfile1.nii')
+
+        expected = os.path.join(self.output_dir, 'sub', 'testfile1', 'testfile1_pred.nii')
+        self.assertTrue(os.path.exists(expected))
+        img = nib.load(expected)
+        self.assertEqual(img.shape, (5, 5, 5, 1))
+        self.assertEqual(out_file, expected)
+
+    def test_create_file_basename(self):
+        path = NiftiSaver._create_file_basename('seg', os.path.join('a', 'b', 'img.nii.gz'), self.output_dir)
+        self.assertEqual(path, os.path.join(self.output_dir, 'img', 'img_seg'))
+        self.assertTrue(os.path.isdir(os.path.join(self.output_dir, 'img')))
+
+
+if __name__ == '__main__':
+    unittest.main()
