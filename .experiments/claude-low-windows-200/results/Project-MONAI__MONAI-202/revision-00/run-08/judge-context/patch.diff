+import unittest
+from unittest import mock
+
+import numpy as np
+import torch
+
+from monai.handlers.plot_2d_or_3d_image import plot_2d_or_3d_image
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def test_2d_image(self):
+        writer = mock.MagicMock()
+        data = np.random.rand(2, 10, 10)  # batch of 2D images
+        plot_2d_or_3d_image(data, 5, writer, tag='input')
+
+        writer.add_image.assert_called_once()
+        args, kwargs = writer.add_image.call_args
+        self.assertEqual(args[0], 'input_HW')
+        self.assertEqual(args[1].shape, (10, 10))
+        self.assertEqual(args[2], 5)
+        self.assertEqual(kwargs['dataformats'], 'HW')
+        self.assertGreaterEqual(args[1].min(), 0.0)
+        self.assertLessEqual(args[1].max(), 1.0)
+
+    def test_rgb_image(self):
+        writer = mock.MagicMock()
+        data = np.random.rand(1, 3, 10, 10)
+        plot_2d_or_3d_image(data, 1, writer, max_channels=3)
+
+        writer.add_image.assert_called_once()
+        args, kwargs = writer.add_image.call_args
+        self.assertEqual(args[0], 'output_CHW')
+        self.assertEqual(kwargs['dataformats'], 'CHW')
+
+    def test_multi_channel_plots_first_channel_only(self):
+        writer = mock.MagicMock()
+        data = np.random.rand(1, 2, 10, 10)
+        plot_2d_or_3d_image(data, 3, writer, max_channels=1)
+
+        writer.add_image.assert_called_once()
+        self.assertEqual(writer.add_image.call_args[0][0], 'output_HW_0')
+
+    def test_index_selects_batch_element(self):
+        writer = mock.MagicMock()
+        data = torch.zeros((2, 10, 10))
+        data[1] = 1.0  # second element is all ones
+        plot_2d_or_3d_image(data, 0, writer, index=1)
+
+        args, _ = writer.add_image.call_args
+        np.testing.assert_allclose(args[1], np.ones((10, 10)))
+
+    @mock.patch('monai.handlers.plot_2d_or_3d_image.img2tensorboard.add_animated_gif')
+    def test_3d_volume_as_animated_gif(self, mock_gif):
+        writer = mock.MagicMock()
+        data = np.random.rand(1, 2, 10, 10, 10)
+        plot_2d_or_3d_image(data, 7, writer, max_channels=2, max_frames=4, tag='output')
+
+        self.assertEqual(mock_gif.call_count, 2)
+        tags = [c[0][1] for c in mock_gif.call_args_list]
+        self.assertEqual(tags, ['output_HWD_0', 'output_HWD_1'])
+        for c in mock_gif.call_args_list:
+            self.assertEqual(c[0][0], writer)
+            self.assertEqual(c[0][2].shape, (1, 10, 10, 10))
+            self.assertEqual(c[0][3], 4)  # max_frames
+            self.assertEqual(c[0][5], 7)  # step
+        writer.add_image.assert_not_called()
+
+    def test_invalid_input_raises(self):
+        with self.assertRaises(ValueError):
+            plot_2d_or_3d_image([[1.0, 2.0]], 0, mock.MagicMock())
+
+
+if __name__ == '__main__':
+    unittest.main()
