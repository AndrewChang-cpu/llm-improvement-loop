+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_save_numpy(self):
+        saver = NiftiSaver(output_dir=self.test_dir, output_postfix='seg', output_ext='.nii.gz')
+        data = np.arange(1 * 2 * 3 * 4, dtype=np.float32).reshape(1, 2, 3, 4)
+        out = saver.save(data, {'filename_or_obj': os.path.join('sub', 'case0.nii.gz')})
+
+        expected = os.path.join(self.test_dir, 'sub', 'case0', 'case0_seg.nii.gz')
+        self.assertEqual(out, expected)
+        self.assertTrue(os.path.exists(expected))
+        loaded = nib.load(expected)
+        # channel-first (1, 2, 3, 4) is written channel-last
+        self.assertEqual(loaded.shape, (2, 3, 4, 1))
+        np.testing.assert_allclose(np.asarray(loaded.dataobj).squeeze(), data.squeeze())
+
+    def test_save_torch_tensor_and_postfix(self):
+        saver = NiftiSaver(output_dir=self.test_dir, output_postfix='pred', output_ext='.nii')
+        data = torch.ones(2, 4, 4, 4)
+        out = saver.save(data, {'filename_or_obj': 'case1.nii.gz'})
+
+        self.assertEqual(out, os.path.join(self.test_dir, 'case1', 'case1_pred.nii'))
+        self.assertTrue(os.path.exists(out))
+        self.assertEqual(nib.load(out).shape, (4, 4, 4, 2))
+
+    def test_affine_is_used(self):
+        saver = NiftiSaver(output_dir=self.test_dir)
+        affine = np.diag([2.0, 3.0, 4.0, 1.0])
+        out = saver.save(np.zeros((1, 3, 3, 3), dtype=np.float32),
+                         {'filename_or_obj': 'case2.nii.gz', 'affine': affine})
+        np.testing.assert_allclose(nib.load(out).affine, affine)
+
+    def test_dtype_override(self):
+        saver = NiftiSaver(output_dir=self.test_dir, dtype=np.uint8)
+        out = saver.save(np.ones((1, 2, 2, 2), dtype=np.float32), {'filename_or_obj': 'case3.nii.gz'})
+        self.assertEqual(np.asarray(nib.load(out).dataobj).dtype, np.uint8)
+
+
+if __name__ == '__main__':
+    unittest.main()
