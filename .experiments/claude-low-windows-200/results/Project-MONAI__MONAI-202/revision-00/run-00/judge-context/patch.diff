+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+import shutil
+import tempfile
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+def _read_rows(path):
+    with open(path, 'r') as f:
+        return list(csv.reader(f))
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_save_and_finalize(self):
+        saver = CSVSaver(output_dir=os.path.join(self.test_dir, 'out'))
+        saver.save(torch.zeros(3), {'filename_or_obj': 'b'})
+        saver.save(np.array([1.0, 2.0, 3.0]), {'filename_or_obj': 'a'})
+        path = saver.finalize()
+
+        self.assertEqual(path, os.path.join(self.test_dir, 'out', 'predictions.csv'))
+        rows = _read_rows(path)
+        # rows are sorted by file name
+        self.assertEqual(rows, [['a', '1.0', '2.0', '3.0'], ['b', '0.0', '0.0', '0.0']])
+
+    def test_custom_filename(self):
+        saver = CSVSaver(output_dir=self.test_dir, filename='custom.csv')
+        saver.save(np.array([0.5]), {'filename_or_obj': 'x'})
+        path = saver.finalize()
+        self.assertEqual(path, os.path.join(self.test_dir, 'custom.csv'))
+        self.assertEqual(_read_rows(path), [['x', '0.5']])
+
+    def test_not_overwrite_keeps_existing_rows(self):
+        first = CSVSaver(output_dir=self.test_dir)
+        first.save(np.array([1.0]), {'filename_or_obj': 'old'})
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.test_dir, overwrite=False)
+        second.save(np.array([2.0]), {'filename_or_obj': 'new'})
+        path = second.finalize()
+        self.assertEqual(_read_rows(path), [['new', '2.0'], ['old', '1.0']])
+
+    def test_overwrite_replaces_existing_rows(self):
+        first = CSVSaver(output_dir=self.test_dir)
+        first.save(np.array([1.0]), {'filename_or_obj': 'old'})
+        first.finalize()
+
+        second = CSVSaver(output_dir=self.test_dir, overwrite=True)
+        second.save(np.array([2.0]), {'filename_or_obj': 'new'})
+        path = second.finalize()
+        self.assertEqual(_read_rows(path), [['new', '2.0']])
+
+
+if __name__ == '__main__':
+    unittest.main()
