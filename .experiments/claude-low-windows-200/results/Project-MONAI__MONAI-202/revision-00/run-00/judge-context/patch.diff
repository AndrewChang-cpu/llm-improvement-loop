+import unittest
+from unittest import mock
+
+import numpy as np
+import torch
+
+from monai.transforms.utils import rescale_array
+from monai.visualize.img2tensorboard import plot_2d_or_3d_image
+
+
+class TestPlot2DOr3DImage(unittest.TestCase):
+
+    def test_2d_image(self):
+        writer = mock.MagicMock()
+        data = np.random.normal(size=(2, 20, 20))
+        plot_2d_or_3d_image(data, 5, writer)
+
+        writer.add_image.assert_called_once()
+        args, kwargs = writer.add_image.call_args
+        self.assertEqual(args[0], 'output_HW')
+        self.assertEqual(args[1].shape, (20, 20))
+        self.assertEqual(args[2], 5)
+        self.assertEqual(kwargs['dataformats'], 'HW')
+        # values are rescaled to [0, 1]
+        self.assertGreaterEqual(args[1].min(), 0.0)
+        self.assertLessEqual(args[1].max(), 1.0)
+
+    def test_rgb_image(self):
+        writer = mock.MagicMock()
+        data = np.random.normal(size=(1, 3, 20, 20))
+        plot_2d_or_3d_image(data, 1, writer, max_channels=3, tag='input_0')
+
+        args, kwargs = writer.add_image.call_args
+        self.assertEqual(args[0], 'input_0_CHW')
+        self.assertEqual(kwargs['dataformats'], 'CHW')
+
+    def test_index_selects_batch_element(self):
+        writer = mock.MagicMock()
+        data = np.stack([np.random.normal(size=(10, 10)) for _ in range(3)])
+        plot_2d_or_3d_image(data, 0, writer, index=2, tag='t')
+        args, _ = writer.add_image.call_args
+        self.assertEqual(args[0], 't_HW')
+        np.testing.assert_allclose(args[1], rescale_array(data[2], 0, 1))
+
+    def test_torch_tensor_input(self):
+        writer = mock.MagicMock()
+        plot_2d_or_3d_image(torch.rand(1, 15, 15), 3, writer)
+        writer.add_image.assert_called_once()
+        self.assertEqual(writer.add_image.call_args[0][1].shape, (15, 15))
+
+    @mock.patch('monai.visualize.img2tensorboard.add_animated_gif')
+    def test_3d_image_as_gif(self, mock_gif):
+        writer = mock.MagicMock()
+        data = np.random.normal(size=(1, 2, 8, 8, 8))
+        plot_2d_or_3d_image(data, 7, writer, max_channels=2, max_frames=4, tag='output')
+
+        self.assertEqual(mock_gif.call_count, 2)
+        tags = [c[0][1] for c in mock_gif.call_args_list]
+        self.assertEqual(tags, ['output_HWD_0', 'output_HWD_1'])
+        for c in mock_gif.call_args_list:
+            self.assertEqual(c[0][0], writer)
+            self.assertEqual(c[0][2].shape, (1, 8, 8, 8))
+            self.assertEqual(c[0][3], 4)  # max_frames
+            self.assertEqual(c[0][5], 7)  # step
+        writer.add_image.assert_not_called()
+
+    def test_invalid_input_type_raises(self):
+        with self.assertRaises(ValueError):
+            plot_2d_or_3d_image([[1, 2], [3, 4]], 0, mock.MagicMock())
+
+
+if __name__ == '__main__':
+    unittest.main()
