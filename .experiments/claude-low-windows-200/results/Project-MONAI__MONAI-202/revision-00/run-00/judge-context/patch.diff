+import os
+import shutil
+import tempfile
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestHandlerSegmentationSaver(unittest.TestCase):
+
+    def setUp(self):
+        self.test_dir = tempfile.mkdtemp()
+
+    def tearDown(self):
+        shutil.rmtree(self.test_dir, ignore_errors=True)
+
+    def test_saved_content(self):
+        output_dir = os.path.join(self.test_dir, 'seg_out')
+
+        def _train_func(engine, batch):
+            # output shape (batch, channel, H, W, D)
+            return torch.ones((2, 1, 4, 5, 6))
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_path=output_dir, output_postfix='seg', output_ext='.nii.gz')
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['case' + str(i) for i in range(2)]}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        for i in range(2):
+            path = os.path.join(output_dir, 'case' + str(i), 'case' + str(i) + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(path))
+            loaded = nib.load(path)
+            # channel-first (1, 4, 5, 6) is written channel-last
+            self.assertEqual(loaded.shape, (4, 5, 6, 1))
+            np.testing.assert_allclose(np.asarray(loaded.dataobj), 1.0)
+
+    def test_affine_from_batch_is_used(self):
+        output_dir = os.path.join(self.test_dir, 'seg_affine')
+        affine = np.diag([2.0, 2.0, 2.0, 1.0])
+
+        def _train_func(engine, batch):
+            return torch.zeros((1, 1, 3, 3, 3))
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_path=output_dir)
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['subj'], 'affine': [affine]}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        path = os.path.join(output_dir, 'subj', 'subj_seg.nii.gz')
+        self.assertTrue(os.path.exists(path))
+        np.testing.assert_allclose(nib.load(path).affine, affine)
+
+
+if __name__ == '__main__':
+    unittest.main()
