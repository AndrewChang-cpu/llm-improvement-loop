+# limitations under the License.
+
+import csv
+import os
+
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Collect per-item predictions and write them to a CSV file.
+    Each row is ``<filename>,<value_1>,<value_2>,...``. This class does not depend on ignite.
+
+    Args:
+        output_dir (str): output CSV file directory.
+        filename (str): name of the CSV file written inside `output_dir`.
+        overwrite (bool): whether to overwrite existing CSV file content. If not overwriting,
+            the existing results are loaded and kept in the prediction dict when `finalize` is called.
+    """
+
+    def __init__(self, output_dir='./', filename='predictions.csv', overwrite=True):
+        self.output_dir = output_dir
+        self.overwrite = overwrite
+        self._prediction_dict = {}
+        self._preds_filepath = os.path.join(output_dir, filename)
+
+    def save(self, data, meta_data=None):
+        """
+        Store the prediction of one item, keyed by its file name.
+
+        Args:
+            data (numpy.ndarray or torch.Tensor): prediction for one item.
+            meta_data (dict): metadata for this item, must contain ``'filename_or_obj'``.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._prediction_dict[meta_data['filename_or_obj']] = np.asarray(data).astype(np.float32)
+
+    def finalize(self):
+        """
+        Write all stored predictions to the CSV file.
+
+        Returns:
+            str: the path of the written CSV file.
+        """
+        if not self.overwrite and os.path.exists(self._preds_filepath):
+            with open(self._preds_filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._prediction_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._preds_filepath, 'w') as f:
+            for k, v in sorted(self._prediction_dict.items()):
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+        return self._preds_filepath
