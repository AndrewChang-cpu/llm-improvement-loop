+import os
+import shutil
+import unittest
+
+import nibabel as nib
+import numpy as np
+
+from monai.data.nifti_saver import NiftiSaver
+
+
+class TestNiftiSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        saver = NiftiSaver(output_dir=default_dir, output_postfix='seg', output_ext='.nii.gz')
+        data = np.random.rand(1, 10, 10, 10).astype(np.float32)  # channel first
+        out = saver.save(data, 'testfile/image.nii.gz', affine=np.eye(4))
+
+        expected = os.path.join(default_dir, 'image', 'image_seg.nii.gz')
+        self.assertEqual(out, expected)
+        self.assertTrue(os.path.exists(expected))
+        loaded = nib.load(expected).get_fdata()
+        np.testing.assert_allclose(loaded, np.moveaxis(data, 0, -1), rtol=1e-5)
+        shutil.rmtree(default_dir)
+
+
+if __name__ == '__main__':
+    unittest.main()
