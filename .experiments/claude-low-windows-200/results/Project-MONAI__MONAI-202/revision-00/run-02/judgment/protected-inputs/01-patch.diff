+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+
+import csv
+import os
+import shutil
+import unittest
+
+import numpy as np
+import torch
+
+from monai.data.csv_saver import CSVSaver
+
+
+class TestCSVSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        saver = CSVSaver(output_dir=default_dir)
+        for i in range(4):
+            saver.save('testfile' + str(i), torch.zeros(3))
+        saver.finalize()
+
+        filepath = os.path.join(default_dir, 'predictions.csv')
+        self.assertTrue(os.path.exists(filepath))
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual(len(rows), 4)
+        for i, row in enumerate(rows):
+            self.assertEqual(row[0], 'testfile' + str(i))
+            np.testing.assert_allclose(np.array(row[1:]).astype(np.float32), 0.0)
+        shutil.rmtree(default_dir)
+
+    def test_no_overwrite_keeps_previous(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        first = CSVSaver(output_dir=default_dir)
+        first.save('old', np.array([1.0, 2.0]))
+        first.finalize()
+
+        second = CSVSaver(output_dir=default_dir, overwrite=False)
+        second.save('new', np.array([3.0, 4.0]))
+        filepath = second.finalize()
+        with open(filepath, 'r') as f:
+            rows = list(csv.reader(f))
+        self.assertEqual([r[0] for r in rows], ['new', 'old'])
+        shutil.rmtree(default_dir)
+
+
+if __name__ == '__main__':
+    unittest.main()
