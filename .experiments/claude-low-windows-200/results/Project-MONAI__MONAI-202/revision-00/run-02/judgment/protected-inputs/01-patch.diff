+# limitations under the License.
+
+import os
+import csv
+import numpy as np
+import torch
+
+
+class CSVSaver:
+    """
+    Collects per-item predictions in memory and writes them to a single CSV file. This class has no
+    dependency on ignite, so it can be used directly or wrapped by an event handler.
+    """
+
+    def __init__(self, output_dir='./', overwrite=True):
+        """
+        Args:
+            output_dir (str): output CSV file directory.
+            overwrite (bool): whether to overwrite existing CSV file content. If not overwriting,
+                previously saved results are loaded into the prediction dict before writing.
+        """
+        self.output_dir = output_dir
+        self.overwrite = overwrite
+        self._prediction_dict = {}
+        self._preds_filepath = os.path.join(output_dir, 'predictions.csv')
+
+    def save(self, filename, data):
+        """
+        Store the prediction for one item.
+
+        Args:
+            filename (str): identifier of the item, written as the first column of the CSV.
+            data (numpy.ndarray or torch.Tensor): the prediction for this item.
+        """
+        if isinstance(data, torch.Tensor):
+            data = data.detach().cpu().numpy()
+        self._prediction_dict[filename] = np.asarray(data).astype(np.float32)
+
+    def finalize(self):
+        """
+        Write all collected predictions to the CSV file, sorted by identifier.
+
+        Returns:
+            str: path of the written CSV file.
+        """
+        if not self.overwrite and os.path.exists(self._preds_filepath):
+            with open(self._preds_filepath, 'r') as f:
+                reader = csv.reader(f)
+                for row in reader:
+                    self._prediction_dict[row[0]] = np.array(row[1:]).astype(np.float32)
+
+        if not os.path.exists(self.output_dir):
+            os.makedirs(self.output_dir)
+        with open(self._preds_filepath, 'w') as f:
+            for k, v in sorted(self._prediction_dict.items()):
+                f.write(k)
+                for result in v.flatten():
+                    f.write("," + str(result))
+                f.write("\n")
+        return self._preds_filepath
