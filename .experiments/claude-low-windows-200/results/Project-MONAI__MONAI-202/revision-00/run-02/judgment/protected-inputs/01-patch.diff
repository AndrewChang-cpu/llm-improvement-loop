+import os
+import shutil
+import unittest
+
+import nibabel as nib
+import numpy as np
+import torch
+from ignite.engine import Engine
+
+from monai.handlers.segmentation_saver import SegmentationSaver
+
+
+class TestSegmentationSaver(unittest.TestCase):
+
+    def test_saved_content(self):
+        default_dir = os.path.join('.', 'tempdir')
+        shutil.rmtree(default_dir, ignore_errors=True)
+
+        def _train_func(engine, batch):
+            return torch.ones((2, 1, 8, 8, 8))
+
+        engine = Engine(_train_func)
+        saver = SegmentationSaver(output_path=default_dir, output_postfix='seg', output_ext='.nii.gz')
+        saver.attach(engine)
+
+        data = [{'filename_or_obj': ['case0.nii.gz', 'case1.nii.gz'], 'affine': np.stack([np.eye(4)] * 2),
+                 'original_affine': np.stack([np.eye(4)] * 2)}]
+        engine.run(data, epoch_length=1, max_epochs=1)
+
+        for name in ['case0', 'case1']:
+            filepath = os.path.join(default_dir, name, name + '_seg.nii.gz')
+            self.assertTrue(os.path.exists(filepath))
+            self.assertEqual(nib.load(filepath).shape, (8, 8, 8, 1))
+        shutil.rmtree(default_dir)
+
+
+if __name__ == '__main__':
+    unittest.main()
